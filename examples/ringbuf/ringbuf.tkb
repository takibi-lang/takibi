// Ring buffer demo. RingBuf struct wraps head/tail with % cap.
//
// GitHub issue #240: `buf` used to be a raw `*i32` field with no
// compiler-enforced relationship to `cap` (an ordinary struct field
// holding a pointer that still supports arithmetic/indexing can hide
// exactly that kind of relationship). Now an owned `[i32; 4]` field,
// so the buffer's own storage genuinely lives inside RingBuf rather
// than being aliased in from elsewhere. `head`/`tail` are only ever
// kept in `0..<cap` by the `% cap` below, not by a type-level proof
// (cap is a runtime field, not a literal the checker can fold), so
// indexing still decays the field to a pointer and uses ordinary
// pointer indexing -- exactly the same trust level the original
// `*i32` field already had, not a new unsafe escape.
struct RingBuf {
    buf:  [i32; 4];
    head: isize;
    tail: isize;
    size: i32;
    cap:  isize;
}

fn rb_push(rb: *RingBuf, val: i32) {
    let buf: *i32 = rb.buf;
    buf[rb.tail] = val;
    rb.tail = (rb.tail + 1) % rb.cap;
    rb.size = rb.size + 1;
}

fn rb_pop(rb: *RingBuf) -> i32 {
    let buf: *i32 = rb.buf;
    let val: i32 = buf[rb.head];
    rb.head = (rb.head + 1) % rb.cap;
    rb.size = rb.size - 1;
    return val;
}

fn test_ringbuf() {
    let mut rb: RingBuf = {{0, 0, 0, 0}, 0, 0, 0, 4};

    rb_push(&rb, 1);
    rb_push(&rb, 2);
    rb_push(&rb, 3);
    rb_push(&rb, 4);

    uart_puts("pop: ");
    uart_print(rb_pop(&rb));
    uart_puts(" ");
    uart_print(rb_pop(&rb));
    uart_puts("\r\n");

    rb_push(&rb, 5);
    rb_push(&rb, 6);

    uart_puts("pop: ");
    uart_print(rb_pop(&rb));
    uart_puts(" ");
    uart_print(rb_pop(&rb));
    uart_puts(" ");
    uart_print(rb_pop(&rb));
    uart_puts(" ");
    uart_print(rb_pop(&rb));
    uart_puts("\r\n");
}
