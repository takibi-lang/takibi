// Coarse-grained three-page process-address-space smoke test on RPi5.
// The RPi5 dynamic window is 0x40000000 rather than RPi3's 0x80000000;
// the lifecycle and all three independent VA read-backs are otherwise the
// same proof as the shared RPi3 example.

use "examples/vm_page_map/vm_page_map_core_rpi5.tkb";

fn app_main() !{unsafe} {
    page_pool_init();
    uart_puts("process_vm_smoke\n");

    let seed: {0..<2 as usize} = 0;
    let inactive = address_space_new(seed);
    let core: usize = 0;
    let (space, active) = address_space_activate(inactive, core);
    let base_va: {0x40000000..<0x40200000 as usize} = 0x40000000;

    match process_address_space_map(space, active, base_va, 3) {
        ProcessMapResult::Failed(failed_inactive) => {
            uart_puts("allocation failed\n");
            address_space_free(failed_inactive);
        }
        ProcessMapResult::Mapped(pair) => {
            let (pas, active) = pair;
            // process_address_space_map has established these three pages;
            // reconstituting their active virtual addresses is the mapping
            // boundary and cannot be proved from an integer alone.
            let ptr0: *u8 = unsafe { base_va as *u8 };
            let ptr1: *u8 = unsafe { (base_va + PAGE_SIZE) as *u8 };
            let ptr2: *u8 = unsafe { (base_va + 2 * PAGE_SIZE) as *u8 };
            *ptr0 = 10;
            *ptr1 = 20;
            *ptr2 = 30;
            uart_puts("page0: "); uart_print(*ptr0);
            uart_puts(" page1: "); uart_print(*ptr1);
            uart_puts(" page2: "); uart_print(*ptr2);
            uart_puts("\n");
            let empty = process_address_space_unmap(pas);
            let inactive2 = address_space_deactivate(active, empty);
            address_space_free(inactive2);
        }
    }
    uart_puts("done\n");
}
