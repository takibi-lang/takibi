// First real-hardware reachability check for RP1's USB host controllers
// (GitHub issue #161's own future-work note in
// examples/common_rpi5/AGENTS.md: "RP1's Ethernet path... is its own
// future subject if pursued" -- USB is the analogous case, needed for
// examples/el0_shell_rpi5, which is blocked on it).
//
// Per the official Raspberry Pi RP1 Peripherals datasheet
// (datasheets.raspberrypi.com/rp1/rp1-peripherals.pdf, Chapter 5): "The
// USB Host subsystem is based on Synopsys IP dwc_usb3, v3.30b. There are
// two identical USB3.0 xHCI Host Controllers conforming to the
// Extensible Host Controller Interface Specification v1.2." This is a
// REAL XHCI controller, not the simpler DWC2 OTG controller RPi5's own
// AGENTS.md previously (before this research) speculated about -- a
// materially bigger driver task than DWC2 would have been. This example
// deliberately does nothing risky yet: it only READS the standard XHCI
// Capability register block (CAPLENGTH/HCIVERSION/HCSPARAMS1-3/
// HCCPARAMS1), the same "prove basic reachability before touching
// anything stateful" step examples/rp1_pcie_smoke itself started from
// for RP1's PCIe link.
//
// Register base addresses (datasheet Table 85, "5.1. Register base
// addresses"): usbhost0 (main XHCI MMIO, AXI3 bus, Atomic Access: N --
// plain reads, no atomic-access aliasing needed) lives at RP1-internal
// address 0x40200000; usbhost1 at 0x40300000. RP1-internal addresses map
// to CPU physical addresses via the SAME offset examples/common_rpi5/
// uart.tkb's own rp1_uart0 (RP1-internal 0x40030000, datasheet Table 22)
// already proved: CPU_PHYS = RP1_INTERNAL + 0x1EC0000000. So usbhost0's
// Capability registers are reachable at CPU physical 0x1F00200000 and
// usbhost1's at 0x1F00300000 -- both already covered by
// examples/common_rpi5/mmu.S's existing L1[124..127] 4GB RP1 outbound
// window (no new MMU/PCIe work needed), and PCIe/RP1 BAR bring-up
// already runs unconditionally for every RPi5 kernel via platform_init
// (examples/common_rpi5/pcie.tkb), the same reason rp1_uart0 already
// works in every other example without an explicit init call here.
//
// Checkpoint instrumentation (same technique as rp1_pcie_smoke, GitHub
// issue #161): a global written immediately before each read so a hang's
// last-reached step is SWD-readable after power-cycle recovery -- RP1's
// own "usbhost0_cfg"/"usbhost1_cfg" register blocks (datasheet Table 85,
// Atomic Access: Y, addresses not yet explored here) may gate clock/
// power/reset state this smoke test does not yet configure, so a hang or
// bus-timeout-pattern (0xFFFFFFFF) read is a real, expected possible
// outcome, not assumed impossible.
let mut usb_smoke_checkpoint: u32 = 0;
let mut usb_smoke_host0_cap0: u32 = 0xAAAAAAAA;
let mut usb_smoke_host0_hcsparams1: u32 = 0xAAAAAAAA;
let mut usb_smoke_host0_hcsparams2: u32 = 0xAAAAAAAA;
let mut usb_smoke_host0_hcsparams3: u32 = 0xAAAAAAAA;
let mut usb_smoke_host0_hccparams1: u32 = 0xAAAAAAAA;
let mut usb_smoke_host1_cap0: u32 = 0xAAAAAAAA;
let mut usb_smoke_host1_hcsparams1: u32 = 0xAAAAAAAA;

fn app_main() {
    uart_puts("rp1_usb_smoke\n");

    usb_smoke_checkpoint = 1;
    // Offset 0x00: CAPLENGTH (bits 7:0) | reserved (bits 15:8) |
    // HCIVERSION (bits 31:16, BCD -- e.g. 0x0110 for xHCI v1.10). Read as
    // one 32-bit word (no *io u16 precedent exists yet in this repo) --
    // the standard way real XHCI drivers read this pair together.
    let host0_cap0_ptr: *io u32 = 0x1F00200000;
    usb_smoke_host0_cap0 = *host0_cap0_ptr;
    usb_smoke_checkpoint = 2;

    let host0_hcsparams1_ptr: *io u32 = 0x1F00200004;
    usb_smoke_host0_hcsparams1 = *host0_hcsparams1_ptr;
    usb_smoke_checkpoint = 3;

    let host0_hcsparams2_ptr: *io u32 = 0x1F00200008;
    usb_smoke_host0_hcsparams2 = *host0_hcsparams2_ptr;
    usb_smoke_checkpoint = 4;

    let host0_hcsparams3_ptr: *io u32 = 0x1F0020000C;
    usb_smoke_host0_hcsparams3 = *host0_hcsparams3_ptr;
    usb_smoke_checkpoint = 5;

    let host0_hccparams1_ptr: *io u32 = 0x1F00200010;
    usb_smoke_host0_hccparams1 = *host0_hccparams1_ptr;
    usb_smoke_checkpoint = 6;

    uart_puts("usbhost0 CAPLENGTH|HCIVERSION: ");
    uart_print_hex(usb_smoke_host0_cap0 as i32);
    uart_puts("\r\nusbhost0 HCSPARAMS1: ");
    uart_print_hex(usb_smoke_host0_hcsparams1 as i32);
    uart_puts("\r\nusbhost0 HCSPARAMS2: ");
    uart_print_hex(usb_smoke_host0_hcsparams2 as i32);
    uart_puts("\r\nusbhost0 HCSPARAMS3: ");
    uart_print_hex(usb_smoke_host0_hcsparams3 as i32);
    uart_puts("\r\nusbhost0 HCCPARAMS1: ");
    uart_print_hex(usb_smoke_host0_hccparams1 as i32);
    uart_puts("\r\n");

    usb_smoke_checkpoint = 7;
    let host1_cap0_ptr: *io u32 = 0x1F00300000;
    usb_smoke_host1_cap0 = *host1_cap0_ptr;
    usb_smoke_checkpoint = 8;

    let host1_hcsparams1_ptr: *io u32 = 0x1F00300004;
    usb_smoke_host1_hcsparams1 = *host1_hcsparams1_ptr;
    usb_smoke_checkpoint = 9;

    uart_puts("usbhost1 CAPLENGTH|HCIVERSION: ");
    uart_print_hex(usb_smoke_host1_cap0 as i32);
    uart_puts("\r\nusbhost1 HCSPARAMS1: ");
    uart_print_hex(usb_smoke_host1_hcsparams1 as i32);
    uart_puts("\r\n");

    usb_smoke_checkpoint = 10;
    uart_puts("done\n");
}
