// Step-by-step real-hardware bisection for GitHub issue #161 (see
// examples/common_rpi5/AGENTS.md's PCIe bring-up section). Confirmed
// hang-free through outbound window setup + PERST deassert + link-up
// poll (checkpoint 12, result 0 = link never came up). Root cause found
// via Linux source: BCM2712 needs a real MDIO-based PHY tuning step
// (pcie2_post_setup_bcm2712) as a PREREQUISITE for link training, not
// optional post-link tuning -- this version adds it between outbound
// window setup and PERST deassert, matching Linux's own call order.
let mut pcie_smoke_checkpoint: u32 = 0;
let mut pcie_smoke_result: u32 = 0xAAAAAAAA;
let mut pcie_smoke_cfg_id: u32 = 0xAAAAAAAA;

fn app_main() {
    pcie_smoke_checkpoint = 1;
    let rescal_ok: bool = pcie_rescal_reset();
    pcie_smoke_checkpoint = 2;
    if (rescal_ok == false) {
        pcie_smoke_result = 0;
        return;
    }

    pcie_smoke_checkpoint = 3;
    pcie2_bridge_reset(true);
    for i: i32 in 0..<400 { }
    pcie2_bridge_reset(false);
    pcie_smoke_checkpoint = 4;

    pcie2_serdes_enable();
    pcie_smoke_checkpoint = 5;

    pcie2_misc_ctrl_setup();
    pcie_smoke_checkpoint = 6;

    pcie2_outbound_window_setup();
    pcie_smoke_checkpoint = 7;

    let post_setup_ok: bool = pcie2_post_setup_bcm2712();
    pcie_smoke_checkpoint = 8;
    if (post_setup_ok == false) {
        pcie_smoke_result = 2; // distinct from "link never came up" (0)
        return;
    }

    pcie2_perst_set(false);
    pcie_smoke_checkpoint = 9;
    for i: i32 in 0..<2000000 { }
    pcie_smoke_checkpoint = 10;

    let mut linked: bool = false;
    for i: i32 in 0..<20 {
        if (pcie2_link_up()) {
            linked = true;
            break;
        }
        for j: i32 in 0..<200000 { }
    }
    pcie_smoke_checkpoint = 11;

    if (linked) {
        pcie_smoke_result = 1;
        pcie_smoke_cfg_id = pcie2_config_read32(0, 0, 0); // bus=0 -- see pcie.tkb's own note
        pcie_smoke_checkpoint = 12;
    } else {
        pcie_smoke_result = 0;
    }
}
