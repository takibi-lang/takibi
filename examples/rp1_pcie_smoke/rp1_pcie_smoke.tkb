// Step-by-step real-hardware bisection for GitHub issue #161 (see
// examples/common_rpi5/AGENTS.md's PCIe bring-up section). Link up, RP1
// identified (vendor 0x1de4/device 0x0001), but Command register showed
// Memory Space Enable clear (0x0000) and BAR0 read back 0xFFFFC000 --
// the classic PCI BAR-size-query pattern (implies a 16KB decode window),
// not a real assigned address. This version assigns BAR0 to PCI address
// 0 (matching pcie2_outbound_window_setup's own PCI-side target) and
// sets the Command register's Memory Space Enable + Bus Master Enable
// bits, then finally tries uart_init()/uart_puts() over rp1_uart0 for
// real.
let mut pcie_smoke_checkpoint: u32 = 0;
let mut pcie_smoke_result: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar0_before: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar0_after: u32 = 0xAAAAAAAA;
let mut pcie_smoke_cmd_after: u32 = 0xAAAAAAAA;
let mut pcie_smoke_fr: u32 = 0xAAAAAAAA;

fn app_main() {
    pcie_smoke_checkpoint = 1;
    let linked: bool = pcie2_init();
    pcie_smoke_checkpoint = 2;
    if (linked == false) {
        pcie_smoke_result = 0;
        return;
    }
    pcie_smoke_result = 1;

    pcie_smoke_bar0_before = pcie2_config_read32(0, 0, 0x10);
    pcie_smoke_checkpoint = 3;

    pcie2_config_write32(0, 0, 0x10, 0);
    pcie_smoke_checkpoint = 4;
    pcie_smoke_bar0_after = pcie2_config_read32(0, 0, 0x10);
    pcie_smoke_checkpoint = 5;

    let cmd_status: u32 = pcie2_config_read32(0, 0, 4);
    pcie2_config_write32(0, 0, 4, (cmd_status & 0xFFFF0000) | 0x0006);
    pcie_smoke_checkpoint = 6;
    pcie_smoke_cmd_after = pcie2_config_read32(0, 0, 4);
    pcie_smoke_checkpoint = 7;

    let fr: *io u32 = 0x1F00030018;
    pcie_smoke_fr = *fr;
    pcie_smoke_checkpoint = 8;

    if (pcie_smoke_fr != 0xDEADDEAD) {
        uart_init();
        uart_puts("rp1 uart0 alive!\r\n");
        pcie_smoke_checkpoint = 9;
    }
}
