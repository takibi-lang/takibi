// Step-by-step real-hardware bisection for GitHub issue #161 (see
// examples/common_rpi5/AGENTS.md's PCIe bring-up section). Final root
// cause: the RC outbound window and endpoint BARs were not enough -- the
// Type-1 root bridge itself also needed bus numbers, a forwarding memory
// window, and Command.MSE/BME. This smoke test records all three RP1 BAR
// assignments and proves BAR1-backed rp1_uart0 access before printing.
let mut pcie_smoke_checkpoint: u32 = 0;
let mut pcie_smoke_result: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar0_after: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar1_before: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar1_after: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar2_after: u32 = 0xAAAAAAAA;
let mut pcie_smoke_cmd_after: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar0_data: u32 = 0xAAAAAAAA;
let mut pcie_smoke_bar2_data: u32 = 0xAAAAAAAA;
let mut pcie_smoke_fr: u32 = 0xAAAAAAAA;

fn app_main() {
    pcie_smoke_checkpoint = 1;
    let linked: bool = pcie2_init();
    pcie_smoke_checkpoint = 2;
    if (linked == false) {
        pcie_smoke_result = 0;
        return;
    }
    pcie_smoke_result = 1;

    pcie_smoke_bar1_before = pcie2_config_read32(1, 0, 0x14);
    pcie_smoke_checkpoint = 3;

    // Stop memory decoding while changing BARs, then reproduce Linux's
    // complete RP1 resource assignment: BAR1 maps the 4MB peripheral
    // aperture at PCI address 0, BAR2 maps the following 64KB aperture,
    // and BAR0 maps the 16KB MSI-X aperture immediately above them.
    let cmd_status: u32 = pcie2_config_read32(1, 0, 4);
    pcie2_config_write32(1, 0, 4, cmd_status & 0xFFFF0000);
    pcie2_config_write32(1, 0, 0x10, 0x00410000);
    pcie2_config_write32(1, 0, 0x14, 0);
    pcie2_config_write32(1, 0, 0x18, 0x00400000);
    pcie_smoke_checkpoint = 4;
    pcie_smoke_bar0_after = pcie2_config_read32(1, 0, 0x10);
    pcie_smoke_bar1_after = pcie2_config_read32(1, 0, 0x14);
    pcie_smoke_bar2_after = pcie2_config_read32(1, 0, 0x18);
    pcie_smoke_checkpoint = 5;

    pcie2_config_write32(1, 0, 4, (cmd_status & 0xFFFF0000) | 0x0006);
    pcie_smoke_checkpoint = 6;
    pcie_smoke_cmd_after = pcie2_config_read32(1, 0, 4);
    pcie_smoke_checkpoint = 7;

    let bar0: *io u32 = 0x1F00410000;
    let bar2: *io u32 = 0x1F00400000;
    pcie_smoke_bar0_data = *bar0;
    pcie_smoke_bar2_data = *bar2;
    let fr: *io u32 = 0x1F00030018;
    pcie_smoke_fr = *fr;
    pcie_smoke_checkpoint = 8;

    if (pcie_smoke_fr != 0xDEADDEAD) {
        uart_init();
        uart_puts("rp1 uart0 alive!\r\n");
        pcie_smoke_checkpoint = 9;
    }
}
