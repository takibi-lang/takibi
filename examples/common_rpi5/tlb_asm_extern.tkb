// Only tlb_invalidate_va is ported -- see tlb_asm.S's header comment for
// why tlb_invalidate_asid_va/tlb_invalidate_all_el2/rpi3_code_range_sync
// are not needed yet.

extern fn tlb_invalidate_va(va: usize);
