// Raspberry Pi 5 (BCM2712) minimal PCIe root-complex bring-up -- GitHub
// issue #161. Goal: bring RP1's PCIe link up and map its register space
// into a fixed CPU physical address, so examples/common_rpi5/uart.tkb's
// rp1_uart0 access (0x1F00030000, currently reading back 0xDEADDEAD --
// see that file's header comment) becomes real hardware instead of an
// unmapped/poisoned PCIe read.
//
// RP1 is attached to BCM2712's THIRD PCIe root complex instance
// (`pcie2` in raspberrypi/linux's bcm2712.dtsi, register base
// 0x10_00120000) -- confirmed by cross-checking that instance's own
// `ranges` property (`<0x02000000 0x00 0x00000000 0x1f 0x00000000 0x0
// 0xfffffffc>`, i.e. CPU physical 0x1F00000000 upward maps to PCI
// address 0) against the already-confirmed real CPU address of
// rp1_uart0 (0x1F00030000 falls inside that window).
//
// This is a DELIBERATELY MINIMAL port of Linux's `pcie-brcmstb.c`
// (`drivers/pci/controller/pcie-brcmstb.c`) bring-up sequence for the
// BCM2712/"bcm7712" config -- enough to reach one already-known register
// block (rp1_uart0), NOT general PCI enumeration (no MSI, no arbitrary
// BAR sizing, no bus scanning beyond bus 1 device 0). Register offsets/
// bit positions below are transcribed from that driver, not guessed;
// see this file's own comments for exactly which function each block
// corresponds to. Two things are DELIBERATELY SKIPPED, both flagged
// UNCONFIRMED for later hardening once link-up itself is proven:
//
// 1. Inbound windows (`set_inbound_win_registers`/RC_BAR1_CONFIG) --
//    these configure how the RC responds to PCIe-initiated (RP1 -> CPU
//    memory) transactions, i.e. real DMA. Not needed for the CPU to read
//    RP1's OWN registers (the only thing Stage 1 of issue #161 needs),
//    and link training itself is a PHY/LTSSM-level negotiation that does
//    not depend on these registers being configured first.
// 2. `PCIE_MISC_HARD_DEBUG`'s exact SERDES_IDDQ bit position -- the
//    driver source available for research did not show this constant's
//    numeric value directly; bit 27 (0x08000000) is used below as the
//    documented-elsewhere standard value across the Broadcom STB PCIe
//    family, NOT independently confirmed for BCM2712 specifically.

// pcie_rescal (examples/common_rpi5/AGENTS.md's own research: BCM2712's
// shared SERDES calibration reset controller, compatible
// "brcm,bcm7216-pcie-sata-rescal", base 0x10_00119500). Linux's
// reset-brcmstb-rescal.c: set bit0 at +0x0 to start calibration, poll
// bit0 at +0x8 until set (done), then clear bit0 at +0x0.
fn pcie_rescal_reset() -> bool {
    let start: *io u32 = 0x1000119500;
    let status: *io u32 = 0x1000119508;

    *start = (*start) | 1;

    let mut done: bool = false;
    for i: i32 in 0..<10000 {
        if ((*status & 1) != 0) {
            done = true;
            break;
        }
    }
    *start = (*start) & ~1;
    return done;
}

// bcm_reset (compatible "brcm,brcmstb-reset", base 0x10_01504318):
// Linux's reset-brcmstb.c banks resets in groups of 32, 0x18 bytes
// apart, with paired SET (+0x00)/CLEAR (+0x04) registers per bank (write
// 1 to SET to assert, write 1 to CLEAR to deassert -- not a
// read-modify-write register). pcie2's own "swinit"/"bridge" reset
// indices (32, 44 per bcm2712.dtsi's `resets = <&bcm_reset 5>, <&bcm_reset
// 42>, <&pcie_rescal>` for pcie0, but pcie2 itself uses indices 32/44 --
// see this file's own bcm2712.dtsi research) both fall in bank 1 (index
// >> 5 == 1), at bits 0 and 12 respectively (index & 0x1f), so both can
// be asserted/deasserted together with one write each.
fn pcie2_bridge_reset(assert_reset: bool) {
    let bank1_set: *io u32 = 0x1001504330;   // bank 1 = base(0x1001504318) + 0x18
    let bank1_clear: *io u32 = 0x1001504334; // bank1_set + 0x04
    let mask: u32 = (1 << 0) | (1 << 12);    // swinit (idx 32) | bridge (idx 44)

    if (assert_reset) {
        *bank1_set = mask;
    } else {
        *bank1_clear = mask;
        for i: i32 in 0..<2000 { } // ~100-200us settle, same as Linux's usleep_range
    }
}

// PCIE_MISC_PCIE_CTRL (pcie2 base 0x10_00120000 + 0x4064). Bit 2
// (PCIE_PERSTB, 0x4): "Perst bit has moved and assert value is 0"
// (brcm_pcie_perst_set_7278's own comment) -- write 0 to ASSERT PERST#,
// write 1 to DEASSERT.
fn pcie2_perst_set(assert_perst: bool) {
    let ctrl: *io u32 = 0x1000124064;
    let mut v: u32 = *ctrl;
    if (assert_perst) {
        v = v & ~(1 << 2);
    } else {
        v = v | (1 << 2);
    }
    *ctrl = v;
}

fn pcie2_link_up() -> bool {
    let status: *io u32 = 0x1000124068; // PCIE_MISC_PCIE_STATUS
    let v: u32 = *status;
    let dl_active: u32 = v & 0x20;   // PCIE_MISC_PCIE_STATUS_PCIE_DL_ACTIVE_MASK
    let phy_linkup: u32 = v & 0x10;  // PCIE_MISC_PCIE_STATUS_PCIE_PHYLINKUP_MASK
    return (dl_active != 0) && (phy_linkup != 0);
}

// Reads/writes a 32-bit value from/to PCIe config space for (bus, devfn)
// at byte offset `where` (must be 4-byte aligned), via pcie2's indirect
// EXT_CFG_INDEX/EXT_CFG_DATA registers (bcm7712 offsets 0x9000/0x8000).
//
// CORRECTED (2026-07-25): an earlier version folded `where` into the
// INDEX register (`(bus<<20)|(devfn<<12)|where`) and always read/wrote
// the same fixed EXT_CFG_DATA address, so every `where` read back
// identically. Real cause, found by re-reading Linux's own
// brcm_pcie_map_bus(): the index only ever encodes bus/devfn (`where`
// forced to 0 there), and `where` is instead added directly to
// EXT_CFG_DATA's own address -- EXT_CFG_DATA is a real windowed region
// (spanning at least one function's 4KB ECAM space), not a single
// register. CONFIRMED on real hardware: before the root bridge's bus
// numbers are assigned, RP1 temporarily answers at bus 0. After
// pcie2_root_bridge_setup() assigns secondary/subordinate bus 1, RP1
// correctly moves to bus 1, matching Linux's normal topology.
fn pcie2_config_addr(bus: u32, devfn: u32, reg_where: u32) -> *io u32 {
    let idx_addr: *io u32 = 0x1000129000; // EXT_CFG_INDEX
    let data_base: usize = 0x1000128000;  // EXT_CFG_DATA

    let idx: u32 = (bus << 20) | (devfn << 12);
    *idx_addr = idx;
    return (data_base + ((reg_where & ~3) as usize)) as *io u32;
}

fn pcie2_config_read32(bus: u32, devfn: u32, reg_where: u32) -> u32 {
    let addr: *io u32 = pcie2_config_addr(bus, devfn, reg_where);
    return *addr;
}

fn pcie2_config_write32(bus: u32, devfn: u32, reg_where: u32, value: u32) {
    let addr: *io u32 = pcie2_config_addr(bus, devfn, reg_where);
    *addr = value;
}

// brcm_pcie_mdio_write, simplified for our ONLY use case (MDIO_PORT0=0,
// MDIO_CMD_WRITE=0): Linux's own brcm_pcie_mdio_form_pkt packs port (bits
// 16-19), regad (bits 0-15), and cmd (bit 20) into one word -- with
// port=0 and cmd=WRITE=0, every one of those terms except regad itself
// is zero, so the packet is just `regad`. Writes the packed address,
// does a dummy readback (Linux's own "flush" of that write), writes
// wrdata with the done-bit (bit 31) preset, then polls that SAME bit
// until hardware clears it (classic "software sets, hardware clears
// when complete" protocol) -- PCIE_RC_DL_MDIO_ADDR/WR_DATA are at pcie2
// base + 0x1100/0x1104. This is a REQUIRED prerequisite for link
// training on BCM2712 (confirmed from Linux's own call ordering:
// brcm_pcie_post_setup_bcm2712 runs during brcm_pcie_setup(), strictly
// BEFORE brcm_pcie_start_link()), not post-link tuning -- discovered
// 2026-07-25 after a real-hardware attempt without it completed every
// other step cleanly but never reported link-up.
fn pcie2_mdio_write(regad: u32, wrdata: u32) -> bool {
    let mdio_addr: *io u32 = 0x1000121100;
    let mdio_wr_data: *io u32 = 0x1000121104;

    *mdio_addr = regad & 0xffff;
    let flush: u32 = *mdio_addr;

    *mdio_wr_data = 0x80000000 | wrdata;

    let mut done: bool = false;
    for i: i32 in 0..<2000 {
        let v: u32 = *mdio_wr_data;
        if ((v & 0x80000000) == 0) {
            done = true;
            break;
        }
    }
    return done;
}

// brcm_pcie_post_setup_bcm2712: BCM2712-specific PHY tuning via MDIO,
// then an L1SS power-management clock-period adjustment
// (PCIE_RC_PL_PHY_CTL_15 @ pcie2 base + 0x184c). Register/value pairs
// transcribed directly from Linux's own `regs[]`/`data[]` arrays.
fn pcie2_post_setup_bcm2712() -> bool {
    if (pcie2_mdio_write(0x1f, 0x1600) == false) { return false; } // SET_ADDR_OFFSET
    if (pcie2_mdio_write(0x16, 0x50b9) == false) { return false; }
    if (pcie2_mdio_write(0x17, 0xbda1) == false) { return false; }
    if (pcie2_mdio_write(0x18, 0x0094) == false) { return false; }
    if (pcie2_mdio_write(0x19, 0x97b4) == false) { return false; }
    if (pcie2_mdio_write(0x1b, 0x5030) == false) { return false; }
    if (pcie2_mdio_write(0x1c, 0x5030) == false) { return false; }
    if (pcie2_mdio_write(0x1e, 0x0007) == false) { return false; }

    for i: i32 in 0..<400 { } // ~100-200us, matches Linux's usleep_range(100, 200)

    let phy_ctl_15: *io u32 = 0x100012184c; // PCIE_RC_PL_PHY_CTL_15
    let mut tmp: u32 = *phy_ctl_15;
    tmp = tmp & ~0xff; // PCIE_RC_PL_PHY_CTL_15_PM_CLK_PERIOD_MASK
    tmp = tmp | 0x12;
    *phy_ctl_15 = tmp;

    return true;
}

// SerDes IDDQ (power-down) must be cleared before the PHY can train --
// UNCONFIRMED bit position, see this file's header comment. Split out
// (2026-07-25) from the former monolithic pcie2_init() after a real
// hardware hang (SWD halt itself started timing out -- recovered only
// by power-cycling) during the very first bring-up attempt, so each
// step can be checkpointed independently over SWD instead of guessing
// which one is unsafe.
fn pcie2_serdes_enable() {
    let hard_debug: *io u32 = 0x1000124304; // PCIE_HARD_DEBUG (bcm7712 offset)
    *hard_debug = (*hard_debug) & ~(1 << 27);
    for i: i32 in 0..<400 { }
}

// MISC_CTRL: enable SCB access + UR-on-bad-config-read + the RCB
// 64-byte/max-payload-size mode bits brcm_pcie_setup() always sets.
// Burst-size field (bits 20-21, PCIE_MISC_MISC_CTRL_MAX_BURST_SIZE_MASK)
// CORRECTED (2026-07-25): comparing live register state against a real
// Linux boot found Linux's own value has bits 17/18/21 additionally set
// (0x260000) beyond what this function was setting -- bit 21 is part of
// the burst-size field, left at its (apparently zero) reset value by an
// earlier version. Bits 17/18 are not otherwise documented in the
// research this port did; included here since they matched Linux's own
// live, working configuration exactly, even though their individual
// purpose isn't independently confirmed.
fn pcie2_misc_ctrl_setup() {
    let misc_ctrl: *io u32 = 0x1000124008; // PCIE_MISC_MISC_CTRL
    let mut mctrl: u32 = *misc_ctrl;
    mctrl = mctrl | (1 << 12); // SCB_ACCESS_EN
    mctrl = mctrl | (1 << 13); // CFG_READ_UR_MODE
    mctrl = mctrl | (1 << 10); // PCIE_RCB_MPS_MODE
    mctrl = mctrl | (1 << 7);  // PCIE_RCB_64B_MODE
    mctrl = mctrl | (1 << 17) | (1 << 18) | (1 << 21); // matches Linux's own live value
    mctrl = mctrl & ~(1 << 20); // burst-size field: force bits[21:20]=0b10 exactly, not whatever bit 20 pre-existed
    *misc_ctrl = mctrl;
}

// Outbound window 0: CPU physical 0x1F00000000 -> PCI address 0
// (brcm_pcie_set_outbound_win, window 0).
//
// SIZE CORRECTED (2026-07-25) after comparing live register state with a
// real, working Linux boot (read over SWD while Linux had RP1 genuinely
// working, via `sudo python3` + `/dev/mem` since the register block
// isn't reachable from this debug port any other way while Linux's MMU
// is on): Linux's own live WIN0_BASE_LIMIT is `0xfff00000`
// (base_mb=0, limit_mb=0xFFF -- the full ~4GB window the devicetree's
// own `ranges` property describes), NOT the deliberately-scoped-down
// 1MB window (base_mb=limit_mb=0) an earlier version of this function
// used. Every other register this function/pcie2_init() touches matched
// Linux's own live values (WIN0_LO/HI both 0, WIN0_BASE_HI=0x1f) --
// this was the one real difference, and strongly suspected to be why a
// direct memory-mapped read of rp1_uart0 kept returning 0xDEADDEAD
// despite the link being up and RP1 correctly enumerated: base_mb ==
// limit_mb most likely encodes a degenerate/zero-sized window on this
// hardware, not an inclusive 1-MB range as originally assumed. Matching
// Linux's own full-size window removes that guess entirely.
fn pcie2_outbound_window_setup() {
    let win0_lo: *io u32 = 0x100012400c;         // PCIE_MISC_CPU_2_PCIE_MEM_WIN0_LO
    let win0_hi: *io u32 = 0x1000124010;         // PCIE_MISC_CPU_2_PCIE_MEM_WIN0_HI
    let win0_base_limit: *io u32 = 0x1000124070; // PCIE_MISC_CPU_2_PCIE_MEM_WIN0_BASE_LIMIT
    let win0_base_hi: *io u32 = 0x1000124080;    // PCIE_MISC_CPU_2_PCIE_MEM_WIN0_BASE_HI
    let win0_limit_hi: *io u32 = 0x1000124084;   // PCIE_MISC_CPU_2_PCIE_MEM_WIN0_LIMIT_HI

    *win0_lo = 0;
    *win0_hi = 0;
    let cpu_addr: usize = 0x1F00000000;
    let win_size: usize = 0x100000000; // 4GB, matching Linux's own live window and the devicetree's `ranges`

    // WIN0_BASE_HI and WIN0_LIMIT_HI are SEPARATE registers for the
    // address bits above 32. WIN0_BASE_LIMIT's own base/limit-in-MB
    // fields only describe the LOW 32 bits. Both upper registers are
    // required: writing BASE_HI alone leaves the reset-value limit below
    // the 0x1F... base, so the resulting outbound window is invalid and
    // every CPU-side access returns PCIe poison (0xDEADDEAD).
    let limit_addr: usize = cpu_addr + win_size - 1;
    *win0_base_hi = (cpu_addr >> 32) as u32;
    *win0_limit_hi = (limit_addr >> 32) as u32;
    let cpu_addr_low32: u32 = (cpu_addr & 0xFFFFFFFF) as u32;
    let cpu_addr_mb: u32 = cpu_addr_low32 >> 20;
    let limit_low32: u32 = (limit_addr & 0xFFFFFFFF) as u32;
    let limit_mb: u32 = limit_low32 >> 20;
    *win0_base_limit = (cpu_addr_mb) | (limit_mb << 20);
}

// Configure pcie2's own Type-1 root-port header. The outbound window
// alone does not make memory TLPs reach RP1: the bridge also needs a
// secondary bus number, a forwarding memory window, and Memory Space
// Enable in its own Command register. Without these, RP1 config space is
// visible but every BAR access returns 0xDEADDEAD.
fn pcie2_root_bridge_setup() {
    let root_base: usize = 0x1000120000;

    // Linux brcm_pcie_setup(): identify the RC as a PCIe-to-PCIe bridge
    // instead of retaining the endpoint-mode default class code.
    let id_val3: *io u32 = 0x100012043C; // PCIE_RC_CFG_PRIV1_ID_VAL3
    *id_val3 = (*id_val3 & 0xFF000000) | 0x00060400;

    // Primary=0, Secondary=1, Subordinate=1, secondary latency=0.
    let bus_numbers: *io u32 = (root_base + 0x18) as *io u32;
    *bus_numbers = 0x00010100;

    // Forward non-prefetchable PCI addresses 0x00000000..0x004FFFFF.
    // The Type-1 fields have 1MB granularity, so this covers RP1 BAR1
    // (4MB), BAR2 (64KB), and BAR0 (16KB) in one window.
    let memory_base_limit: *io u32 = (root_base + 0x20) as *io u32;
    *memory_base_limit = 0x00400000;

    let command_status: *io u32 = (root_base + 0x04) as *io u32;
    *command_status = (*command_status & 0xFFFF0000) | 0x0006;
}

// pcie2_init(): full bring-up sequence for BCM2712's third PCIe RC
// (pcie2), attached to RP1. Returns true once the link is confirmed up
// (PCIE_MISC_PCIE_STATUS's DL_ACTIVE+PHYLINKUP bits) -- does NOT itself
// confirm RP1 responds in config space; call pcie2_config_read32(1, 0, 0)
// afterward for that (a real vendor/device ID, not 0xFFFFFFFF, confirms
// RP1 is actually enumerable before trusting the outbound-window-mapped
// register reads in uart.tkb).
fn pcie2_init() -> bool {
    // 1. SERDES/PCIe/SATA shared calibration reset (must happen before
    //    the bridge itself is taken out of reset, matching Linux's own
    //    brcm_pcie_setup() ordering).
    if (pcie_rescal_reset() == false) {
        return false;
    }

    // 2. Assert then deassert the bridge reset (brcm_pcie_setup's own
    //    sequence). CONFIRMED THE HARD WAY (2026-07-25): Linux's own
    //    brcm_pcie_setup() only asserts PERST# at this exact point
    //    `if (pcie->cfg->soc_base == BCM2711)` -- NOT for BCM2712/bcm7712.
    //    An earlier version of this function called pcie2_perst_set(true)
    //    here unconditionally (mirroring the BCM2711 branch for both
    //    SoCs), and it hung this board's SWD connection solid (halt
    //    itself started timing out, recovered only by power-cycling) --
    //    PCIE_MISC_PCIE_CTRL lives in the SAME AXI register block bridge
    //    reset just asserted, and that block's own register interface is
    //    apparently unresponsive while still held in reset. PERST# is
    //    asserted later instead, in step 6, only once the bridge is
    //    already out of reset and every other PCIE_MISC_* write below
    //    has already succeeded.
    pcie2_bridge_reset(true);
    for i: i32 in 0..<400 { } // ~100-200us, matches Linux's usleep_range(100, 200)
    pcie2_bridge_reset(false);

    // 3. SerDes IDDQ clear.
    pcie2_serdes_enable();

    // 4. MISC_CTRL setup.
    pcie2_misc_ctrl_setup();

    // 5. Outbound window 0 setup.
    pcie2_outbound_window_setup();

    // 5b. BCM2712-specific PHY tuning via MDIO -- a real prerequisite for
    //     link training on this SoC (see pcie2_post_setup_bcm2712's own
    //     header comment), not optional post-link tuning.
    if (pcie2_post_setup_bcm2712() == false) {
        return false;
    }

    // 6. Deassert PERST#, then wait for link training to complete --
    //    same 100ms budget (20 retries of ~5ms) as brcm_pcie_start_link().
    pcie2_perst_set(false);
    for i: i32 in 0..<2000000 { } // rough "config wait" delay before polling

    let mut linked: bool = false;
    for i: i32 in 0..<20 {
        if (pcie2_link_up()) {
            linked = true;
            break;
        }
        for j: i32 in 0..<200000 { } // rough ~5ms
    }
    if (linked) {
        pcie2_root_bridge_setup();
    }
    return linked;
}
