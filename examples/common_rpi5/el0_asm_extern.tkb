// extern fn declarations for examples/common_rpi5/el0_asm.S (GitHub issue
// #67 Stage 2 follow-up, ported from examples/common_rpi3/
// el0_asm_extern.tkb), split into its own file matching
// examples/common_rpi5/tlb_asm_extern.tkb's own reasoning (a duplicate
// `extern fn` declaration is a hard conflict if two files needing it both
// declared it locally).
//
// rpi3_el0_resume_frame has no port here -- see el0_asm.S's header
// comment for why (GitHub issue #158's fork()-specific addition, not
// needed by examples/el0_smoke).

extern fn el0_payload_addr() -> usize;
extern fn el0_payload_len() -> usize;
extern fn rpi5_el0_enter(el0_pc: usize, el0_sp: usize) !{noreturn};
