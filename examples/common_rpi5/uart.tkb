// Raspberry Pi 5 (BCM2712) debug UART HAL -- Stage A (TX/polling only, no
// RX/interrupt support yet, unlike examples/common_rpi3/uart.tkb). Same
// public signatures as every other target's uart.tkb (uart_putc/uart_puts,
// platform_init/platform_shutdown) so application .tkb files stay
// unchanged.
//
// This is BCM2712's own on-die PL011 (device tree label `_uart0`, aliased
// as `uart10`/`serial10` in Linux, physically wired to the Raspberry Pi 5's
// dedicated 3-pin debug connector -- the SAME cable the official Debug
// Probe's SWD connection comes in on) -- NOT one of the four PL011
// instances RP1 exposes on GPIO14/15 (those need RP1's PCIe link up first,
// which is why RPi5 grew this separate always-available debug UART at
// all). Physical base 0x10_7D001000, derived from raspberrypi/linux's
// arch/arm64/boot/dts/broadcom/bcm2712.dtsi (`_uart0`'s `reg = <0x7d001000
// 0x200>` under the `soc` node's `ranges = <0x7c000000 0x10 0x7c000000
// 0x04000000>`) and bcm2712-rpi-5-b.dts's `uart10: &_uart0 { status =
// "okay"; };`. Register layout (DR/FR/IBRD/FBRD/LCRH/CR offsets) is the
// same PL011 as examples/common_rpi3/uart.tkb's UART0 -- only the base
// address and clock differ.
//
// UART clock is a FIXED 9.216 MHz (`clk_uart`, bcm2712.dtsi), not RPi3's
// 48 MHz -- confirmed from the device tree, not assumed: 9216000 / (16 *
// 115200) = 5.000 exactly, an unusually clean divisor that is itself
// evidence Broadcom picked this clock specifically for exact 115200 baud.
// IBRD=5/FBRD=0 below reflects that, not RPi3's IBRD=26/FBRD=3.
//
// UNCONFIRMED, first things to check if no output appears on real
// hardware: (1) whether any GPIO alt-function / pinmux step is needed at
// all -- assumed NOT needed here, since this UART is wired to a dedicated
// debug connector rather than shared/multiplexed GPIO pins the way RPi3's
// UART0/GPIO14-15 are; (2) whether any additional clock-enable/power step
// is needed before the register block responds, beyond what TF-A/the
// EEPROM bootloader already leaves in place.

fn uart_putc(c: u8) {
    let fr: *io u32 = 0x107D001018; // UART0_FR (base 0x10_7D001000 + 0x018)
    while ((*fr & (1 << 5)) != 0) { } // wait while TXFF (TX FIFO full)
    let dr: *io u8 = 0x107D001000; // UART0_DR
    *dr = c;
}

fn uart_puts(s: *u8) {
    while (*s != 0) {
        uart_putc(*s);
        s = s + 1;
    }
}

fn uart_init() {
    let uart_cr: *io u32 = 0x107D001030;
    let uart_ibrd: *io u32 = 0x107D001024;
    let uart_fbrd: *io u32 = 0x107D001028;
    let uart_lcrh: *io u32 = 0x107D00102C;
    let uart_imsc: *io u32 = 0x107D001038;
    let uart_icr: *io u32 = 0x107D001044;
    let uart_ifls: *io u32 = 0x107D001034;

    *uart_cr = 0; // disable UART before reconfiguring it

    // 115200 baud from the fixed 9.216MHz uartclk: divisor = 9216000 /
    // (16*115200) = 5 exactly (see this file's header comment).
    *uart_ibrd = 5;
    *uart_fbrd = 0;

    *uart_lcrh = (3 << 5) | (1 << 4); // 8 bits, no parity, FIFOs enabled, 1 stop bit
    *uart_ifls = 0; // finest-grained FIFO trigger level (same as RPi3)
    *uart_imsc = 0; // mask every interrupt source -- Stage A is polling-only
    *uart_icr = 0x7FF; // clear any latched interrupt state left by TF-A/a previous run

    *uart_cr = (1 << 0) | (1 << 8) | (1 << 9); // UARTEN | TXE | RXE
}

fn platform_init() {
    uart_init();
}

fn platform_shutdown() {
}
