// Raspberry Pi 5 (BCM2712/RP1) debug UART HAL -- Stage A (TX/polling only,
// no RX/interrupt support yet, unlike examples/common_rpi3/uart.tkb). Same
// public signatures as every other target's uart.tkb (uart_putc/uart_puts,
// platform_init/platform_shutdown) so application .tkb files stay
// unchanged.
//
// CORRECTED (2026-07-25) from an initial, wrong assumption: this is RP1's
// own `rp1_uart0` (PCIe-attached companion chip), NOT BCM2712's on-die
// `_uart0`/uart10 this file originally targeted. The device tree's own
// comment on `_uart0` ("The system UART", aliased `uart10`/`serial10`) and
// Raspberry Pi's own forum explanation (RP1's GPIO-routed UARTs "need
// RP1's PCIe link up first, which is why RPi5 grew a separate always-
// available debug UART") both pointed at 0x10_7D001000 as the right
// address for the physical debug connector -- but on a real, actual
// board, live `dmesg` told a different story: with this board's
// config.txt (`enable_uart=1`/`dtparam=uart0=on`, added via raspi-config),
// the kernel command line carries `console=ttyAMA0`, and `1f00030000.serial:
// ttyAMA0 at MMIO 0x1f00030000 ... is a PL011 AXI` is what's ACTUALLY
// wired to the Debug Probe's UART cable and driving the login shell
// reached via it -- confirmed directly (`tty` inside that live shell
// printed `/dev/ttyAMA0`). 0x1f00030000 is RP1's `rp1_uart0` (device tree
// `raspberrypi/linux`'s `arch/arm64/boot/dts/broadcom/rp1.dtsi`,
// `rp1_uart0: serial@30000`, `reg = <0xc0 0x40030000 0x0 0x100>`,
// PCIe-translated to this CPU-side physical address). The on-die
// `_uart0`/uart10 at 0x10_7D001000 is real, separately-addressable
// hardware (confirmed: writes/reads to it succeed and persist) -- it's
// just not what this board's config.txt routes the console to. Register
// layout (DR/FR/IBRD/FBRD/LCRH/CR offsets) is the same standard PL011 as
// examples/common_rpi3/uart.tkb's UART0 and the original `_uart0` guess --
// only the base address and clock differ.
//
// UART clock: RP1's `RP1_CLK_UART` is PLL-derived (not a plain
// device-tree `fixed-clock` the way BCM2712's own `_uart0` clock is), so
// no static frequency can be read from a devicetree source file directly.
// `vcgencmd measure_clock uart` on this real board reported 44,000,244 Hz
// -- within ~0.5% of 44,236,800 Hz (44.2368 MHz), a well-known standard
// UART reference clock chosen historically because it divides evenly for
// nearly every common baud rate (44236800 / (16*115200) = 24.0 exactly).
// IBRD=24/FBRD=0 reflects that nominal value; the ~0.5% delta between the
// measured and nominal frequency is well within ordinary UART receiver
// tolerance. NOTE: OpenOCD's own SWD debug-port memory access cannot read
// RP1's registers directly to double check this empirically (confirmed:
// reads via the raw MEM-AP to this address return all zeros even while
// Linux is actively and correctly driving this exact UART -- RP1's
// PCIe-translated address range is apparently not reachable through the
// debug port's own physical bus-access path, a debug-tooling limitation,
// not a sign the address or hardware state is wrong).
//
// CONFIRMED BROKEN (2026-07-25): a real-hardware read of this address
// (FR, offset 0x18) from our bare-metal payload (MMU off, no OS) returned
// 0xDEADDEAD -- a classic PCIe "read failed / unmapped" poison pattern.
// RP1's PCIe link/BAR window is NOT established by firmware (TF-A/EEPROM)
// before handing off to our EL2 payload; it is Linux's own PCI subsystem
// that enumerates and maps it during a normal OS boot, which our
// bare-metal code never runs. A further real-hardware test (routing
// Linux's own console to `serial10`/BCM2712's on-die `_uart0` at
// 0x10_7D001000 instead, via cmdline.txt) produced NO output at all on
// the same physical cable, while SSH confirmed Linux still booted fully
// -- meaning THIS BOARD'S debug connector is wired to RP1's uart0, not
// BCM2712's uart10, contradicting this file's earlier assumption (and
// Raspberry Pi's own general documentation about why uart10 exists).
// Getting real bare-metal UART output through this connector therefore
// requires implementing RP1 PCIe enumeration (link training, BAR/ATU
// window setup) ourselves -- a substantial separate undertaking, not a
// Stage A "hello world" task. See examples/common_rpi5/AGENTS.md's
// Status section for the decision on how to proceed from here.

fn uart_putc(c: u8) {
    let fr: *io u32 = 0x1F00030018; // UART0_FR (RP1 rp1_uart0, base 0x1F00030000 + 0x018)
    while ((*fr & (1 << 5)) != 0) { } // wait while TXFF (TX FIFO full)
    let dr: *io u8 = 0x1F00030000; // UART0_DR
    *dr = c;
}

fn uart_puts(s: *u8) {
    while (*s != 0) {
        uart_putc(*s);
        s = s + 1;
    }
}

fn uart_init() {
    let uart_cr: *io u32 = 0x1F00030030;
    let uart_ibrd: *io u32 = 0x1F00030024;
    let uart_fbrd: *io u32 = 0x1F00030028;
    let uart_lcrh: *io u32 = 0x1F0003002C;
    let uart_imsc: *io u32 = 0x1F00030038;
    let uart_icr: *io u32 = 0x1F00030044;
    let uart_ifls: *io u32 = 0x1F00030034;

    *uart_cr = 0; // disable UART before reconfiguring it

    // 115200 baud from the ~44.2368MHz uartclk: divisor = 44236800 /
    // (16*115200) = 24 exactly (see this file's header comment).
    *uart_ibrd = 24;
    *uart_fbrd = 0;

    *uart_lcrh = (3 << 5) | (1 << 4); // 8 bits, no parity, FIFOs enabled, 1 stop bit
    *uart_ifls = 0; // finest-grained FIFO trigger level (same as RPi3)
    *uart_imsc = 0; // mask every interrupt source -- Stage A is polling-only
    *uart_icr = 0x7FF; // clear any latched interrupt state left by TF-A/a previous run

    *uart_cr = (1 << 0) | (1 << 8) | (1 << 9); // UARTEN | TXE | RXE
}

fn platform_init() {
    uart_init();
}

fn platform_shutdown() {
}
