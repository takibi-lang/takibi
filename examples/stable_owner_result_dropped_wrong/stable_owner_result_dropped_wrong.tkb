linear view StableDropGuard[lock: addr];
linear view StableDropPermit;

// place_take moves the old linear package out of durable storage. The
// caller must bind, return, or match that result rather than discard it.

struct StableDropSlot {
    private mutex: i32;
    private value: Place(StableDropPermit);
}

private let mut stable_drop_slot: StableDropSlot;

fn stable_drop_lock(m: *i32 @ lock) -> StableDropGuard[lock] {
    return view StableDropGuard[lock];
}

fn drop_replaced_owner() {
    let guard = stable_drop_lock(&stable_drop_slot.mutex);
    place_take(
        guard,
        &stable_drop_slot.mutex,
        stable_drop_slot.value
    );
}
