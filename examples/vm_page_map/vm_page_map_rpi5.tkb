// Dynamic single 4KB page map/unmap demo on RPi5 (GitHub issue #67 Stage
// 2, ported from examples/vm_page_map/vm_page_map.tkb). See
// examples/vm_page_map/vm_page_map_core_rpi5.tkb for the type design and
// examples/common_rpi5/mmu.S's header comment for why this uses
// 0x40000000, not RPi3's 0x80000000.

use "examples/vm_page_map/vm_page_map_core_rpi5.tkb";

fn app_main() {
    page_pool_init();
    uart_puts("vm_page_map\n");

    match page_alloc() {
        PageAllocResult::OutOfMemory => {
            uart_puts("allocation failed\n");
        }
        PageAllocResult::Allocated(page) => {
            uart_puts("allocated page: ");
            uart_print(page_index(page));
            uart_puts("\n");

            let seed: {0..<2 as usize} = 0;
            let inactive = address_space_new(seed);
            let core: usize = 0;
            let (space, active) = address_space_activate(inactive, core);
            let va: {0x40000000..<0x40200000 as usize} = 0x40000000;
            let (space2, pending) = map_page(space, page, va);
            let mapping = tlb_invalidate(space2, pending);

            let bytes = mapping_bytes(mapping);
            bytes[0] = 42;
            bytes[4095] = 99;

            // Read back through the raw virtual address itself, not
            // through mapping_bytes' own page_pool-relative slice -- this
            // is the actual hardware proof that map_page's L3 page
            // descriptor write and tlb_invalidate's TLBI/DSB/ISB sequence
            // produced a real, live translation, not just updated an
            // in-memory data structure. If this printed a different value
            // than the one just written, either the PTE was wrong or the
            // stale TLB entry was never invalidated.
            let va_ptr: *u8 = 0x40000000;
            uart_puts("via VA: ");
            uart_print(*va_ptr);
            uart_puts("\nvia mapping_bytes: ");
            uart_print(bytes[0]);
            uart_puts(" ");
            uart_print(bytes[4095]);
            uart_puts("\n");

            let (space3, freed) = unmap_page(space2, mapping);
            uart_puts("unmapped\n");
            page_free(freed);
            let inactive2 = address_space_deactivate(active, space3);
            address_space_free(inactive2);
        }
    }
    uart_puts("done\n");
}
