// Dynamic single 4KB page map/unmap over one spare 2MB virtual-address
// window on RPi5 (GitHub issue #67 Stage 2, ported from
// examples/vm_page_map/vm_page_map_core.tkb). See
// examples/common_rpi5/mmu.S's header comment for the L1[1]/L2/L3 table
// layout map_page/unmap_page below write into, and
// examples/common_rpi5/tlb_asm.S for the tlbi/dsb/isb sequence
// tlb_invalidate drives.
//
// This is a deliberately smaller module than vm_page_map_core.tkb, which
// has grown well beyond Stage 2's own scope (process address spaces,
// copy-on-write, fork/exec, task migration -- GitHub issues #153/#156/
// #158/#159) to support RPi3 examples that have no RPi5 port yet. Only
// what examples/vm_page_map/vm_page_map_rpi5.tkb itself calls is here:
// the page-pool allocator, and a single-slot AddressSpaceOwner state
// machine covering map_page/tlb_invalidate/mapping_bytes/unmap_page.
//
// The RPi5 port now also tracks two real hardware slots: each root shares
// the identity/MMIO map but owns a separate dynamic L2/L3 chain.  The slot
// field and active token therefore describe the TTBR0_EL2 root actually
// installed on that core, as exercised concurrently by multi_address_space.
//
// PAGE_COUNT here is 512 (one 2MB window's worth), not
// vm_page_map_core.tkb's 1024 -- that doubling was GitHub issue #158's
// dual-slot fork/exec fix, which does not apply to a single-slot design.
//
// GitHub issue #156 follow-up (2026-07-26): added ProcessAddressSpace/
// process_address_space_map/process_address_space_unmap, a coarse-grained
// multi-page owner for examples/el0_elf_load_rpi5's own full port (real
// ELF loading needs a runtime-determined page count, not one fixed page).
// Still deliberately smaller than vm_page_map_core.tkb's own copy: no
// process_address_space_cow_fork/unmap_shared (GitHub issue #158's real
// fork()-specific COW sharing) and no per-slot indices array pair (RPi5
// has one slot, so process_phys_indices is a single flat array, not the
// slot-0/slot-1 pair RPi3's two-root design needs).

use "examples/common_rpi5/tlb_asm_extern.tkb";

const PAGE_SIZE: usize = 4096;
const PAGE_COUNT: usize = 512;

private let mut page_pool: [u8; PAGE_SIZE * PAGE_COUNT] align(4096);
private let mut page_used: [u8; PAGE_COUNT];

const MAX_PROCESS_PAGES: usize = 512;

private let mut process_phys_indices: [usize; MAX_PROCESS_PAGES];

fn process_phys_index_set(i: {0..<MAX_PROCESS_PAGES as usize}, value: usize) {
    process_phys_indices[i] = value;
}

fn process_phys_index_get(i: {0..<MAX_PROCESS_PAGES as usize}) -> usize {
    return process_phys_indices[i];
}

// index stays a plain refined field (no `@ p` tie) so arithmetic on it
// (map_page's physical-address computation, mapping_bytes' offset) keeps
// its provable {0..<PAGE_COUNT} range -- see
// vm_page_map_core.tkb's own PageOwner for the same reasoning.
private linear struct PageOwner[p: usize] {
    private index: {0..<PAGE_COUNT as usize};
    private p_witness: usize @ p;
}

variant PageAllocResult {
    OutOfMemory;
    Allocated(exists p: usize. PageOwner[p]);
}

fn page_owner_new(index: {0..<PAGE_COUNT as usize}, p_witness: usize @ p)
        -> PageOwner[p] {
    let mut owner: PageOwner[p] = { index, p_witness };
    return owner;
}

fn page_pool_init() {
    for i: usize in 0..<PAGE_COUNT {
        page_used[i] = 0;
    }
}

fn page_alloc() -> PageAllocResult {
    for i: usize in 0..<PAGE_COUNT {
        if (page_used[i] == 0) {
            page_used[i] = 1;
            return PageAllocResult::Allocated(page_owner_new(i, i));
        }
    }
    return PageAllocResult::OutOfMemory;
}

fn page_index(owner: borrow PageOwner[p]) -> {0..<PAGE_COUNT as usize} {
    return owner.index;
}

fn page_free(owner: sink PageOwner[p]) {
    page_used[owner.index] = 0;
}

// Address space: a state-parameterized owner (Empty/Occupied), consumed
// and reissued by map_page/unmap_page -- makes mapping a second page
// before unmapping the first a compile error, not a runtime check. See
// this file's header comment for why there is no `slot` field: RPi5 has
// only one translation root.
// Occupied2 is the additive two-live-page state used by two_page_map.  The
// RPi5 dynamic L3 has 512 entries, so this is a type-state restriction only;
// hardware already supports both descriptors simultaneously.
enum SpaceState: u8 { Inactive; Empty; Occupied; Occupied2; }

private linear struct AddressSpaceOwner[asid: usize, state: SpaceState] {
    private tag: usize @ asid;
    private slot: {0..<2 as usize};
}

// Linear proof that address space `asid` is installed in core `core`.
// Activation installs the matching TTBR0_EL2 root and hardware ASID.
private linear struct ActiveAddressSpace[core: usize, asid: usize] {
    private core_tag: usize @ core;
    private asid_tag: usize @ asid;
}

fn address_space_new(seed: {0..<2 as usize} @ asid)
        -> AddressSpaceOwner[asid, SpaceState::Inactive] {
    let mut space: AddressSpaceOwner[asid, SpaceState::Inactive] = { seed, seed };
    return space;
}

extern fn mmu_address_space_activate(slot: usize);

fn address_space_activate(space: sink AddressSpaceOwner[asid, SpaceState::Inactive],
                          core_tag: usize @ core)
        -> (AddressSpaceOwner[asid, SpaceState::Empty],
            ActiveAddressSpace[core, asid]) {
    mmu_address_space_activate(space.slot);
    tlb_invalidate_all_el2();
    let mut empty: AddressSpaceOwner[asid, SpaceState::Empty] =
        { space.tag, space.slot };
    let mut active: ActiveAddressSpace[core, asid] =
        { core_tag, space.tag };
    return (empty, active);
}

fn address_space_switch(active: sink ActiveAddressSpace[core, old_asid],
                        space: borrow AddressSpaceOwner[asid, state])
        -> ActiveAddressSpace[core, asid] {
    mmu_address_space_activate(space.slot);
    tlb_invalidate_all_el2();
    let mut next: ActiveAddressSpace[core, asid] =
        { active.core_tag, space.tag };
    return next;
}

fn address_space_switch_activate(
        active: sink ActiveAddressSpace[core, old_asid],
        space: sink AddressSpaceOwner[asid, SpaceState::Inactive])
        -> (AddressSpaceOwner[asid, SpaceState::Empty],
            ActiveAddressSpace[core, asid]) {
    mmu_address_space_activate(space.slot);
    tlb_invalidate_all_el2();
    let mut empty: AddressSpaceOwner[asid, SpaceState::Empty] =
        { space.tag, space.slot };
    let mut next: ActiveAddressSpace[core, asid] =
        { active.core_tag, space.tag };
    return (empty, next);
}

fn address_space_deactivate(active: sink ActiveAddressSpace[core, asid],
                            space: sink AddressSpaceOwner[asid, SpaceState::Empty])
        -> AddressSpaceOwner[asid, SpaceState::Inactive] {
    mmu_address_space_activate(0);
    tlb_invalidate_all_el2();
    let mut inactive: AddressSpaceOwner[asid, SpaceState::Inactive] =
        { space.tag, space.slot };
    return inactive;
}

fn address_space_deactivate_to(
        active: sink ActiveAddressSpace[core, asid],
        space: sink AddressSpaceOwner[asid, SpaceState::Empty],
        fallback: borrow AddressSpaceOwner[next_asid, next_state])
        -> (AddressSpaceOwner[asid, SpaceState::Inactive],
            ActiveAddressSpace[core, next_asid]) {
    mmu_address_space_activate(fallback.slot);
    tlb_invalidate_all_el2();
    let mut inactive: AddressSpaceOwner[asid, SpaceState::Inactive] =
        { space.tag, space.slot };
    let mut next: ActiveAddressSpace[core, next_asid] =
        { active.core_tag, fallback.tag };
    return (inactive, next);
}

fn address_space_free(space: sink AddressSpaceOwner[asid, SpaceState::Inactive]) {
}

private linear struct TlbInvalidationPending[asid: usize, va: usize, p: usize] {
    private asid_tag: usize @ asid;
    private va_value: usize @ va;
    private page_index: {0..<PAGE_COUNT as usize};
    private p_witness: usize @ p;
    private space_slot: {0..<2 as usize};
}

private linear struct MappingOwner[asid: usize, va: usize, p: usize] {
    private asid_tag: usize @ asid;
    private va_value: usize @ va;
    private page_index: {0..<PAGE_COUNT as usize};
    private p_witness: usize @ p;
    private space_slot: {0..<2 as usize};
}

private linear struct ActiveMappingView[core: usize, asid: usize,
                                        va: usize, p: usize] {
    private core_tag: usize @ core;
    private asid_tag: usize @ asid;
    private va_value: usize @ va;
    private p_witness: usize @ p;
}

// examples/common_rpi5/mmu.S's L1[1] dynamic window: 0x40000000-0x401FFFFF
// (2MB, matching RPi3's own 2MB dynamic window at a different, RPi5-free L1
// index -- see mmu.S's header comment for why index 1 was chosen).
const DYN_VA_BASE: usize = 0x40000000;
const DYN_VA_LIMIT: usize = 0x40200000;

fn dynamic_va_base() -> {DYN_VA_BASE..<DYN_VA_LIMIT as usize} {
    return 0x40000000;
}

// L3 page descriptor flags: bits[1:0] = 0b11 (valid + page) | AttrIndx 1
// (bits 4:2 = 001, Normal Write-Back Cacheable, MAIR_EL2 byte 1 -- same
// index examples/common_rpi5/mmu.S's own RAM L1[0] entry uses) | AF (bit
// 10) | SH=11 Inner Shareable (bits 9:8) = 0x707. Matches
// vm_page_map_core.tkb's PTE_FLAGS_EL2_RW exactly (EL2-only demo, no EL0
// access bit needed).
const PTE_FLAGS_EL2_RW: usize = 0x707;

// Same encoding as PTE_FLAGS_EL2_RW, plus AP[1] (bit 6) set: AP[2:1] = 01
// means "EL1 RW/EL0 RW" under the EL1&0 translation regime a real EL0
// process runs in (examples/el0_smoke, ported from
// vm_page_map_core.tkb's own PTE_FLAGS_EL0_RW). No separate "exec" bit is
// needed -- AArch64 pages are executable by default unless UXN/PXN is
// explicitly set, and neither is set here.
const PTE_FLAGS_EL0_RW: usize = 0x747;

extern fn l3_dynamic_write(index: usize, value: usize);
extern fn l3_address_space_write(slot: usize, index: usize, value: usize);

fn map_page(space: sink AddressSpaceOwner[asid, SpaceState::Empty],
            page: sink PageOwner[p],
            va: {DYN_VA_BASE..<DYN_VA_LIMIT as usize} @ va)
        -> (AddressSpaceOwner[asid, SpaceState::Occupied],
            TlbInvalidationPending[asid, va, p]) {
    let l3_index: usize = (va - DYN_VA_BASE) / PAGE_SIZE;
    let pool_base_ptr: *u8 = page_pool as *u8;
    let pool_base: usize = pool_base_ptr as usize;
    let phys_addr: usize = pool_base + page.index * PAGE_SIZE;
    l3_address_space_write(space.slot, l3_index, phys_addr | PTE_FLAGS_EL2_RW);

    let mut occupied: AddressSpaceOwner[asid, SpaceState::Occupied] =
        { space.tag, space.slot };
    let mut pending: TlbInvalidationPending[asid, va, p] =
        { space.tag, va, page.index, page.p_witness, space.slot };
    return (occupied, pending);
}

// Same as map_page, but the L3 page descriptor grants EL0 access too
// (PTE_FLAGS_EL0_RW instead of PTE_FLAGS_EL2_RW) -- for a page that will
// be executed at EL0 after examples/el0_smoke's rpi5_el1_enter/
// rpi5_el0_enter drop, ported from vm_page_map_core.tkb's own
// map_page_el0_exec.
fn map_page_el0_exec(space: sink AddressSpaceOwner[asid, SpaceState::Empty],
                     page: sink PageOwner[p],
                     va: {DYN_VA_BASE..<DYN_VA_LIMIT as usize} @ va)
        -> (AddressSpaceOwner[asid, SpaceState::Occupied],
            TlbInvalidationPending[asid, va, p]) {
    let l3_index: usize = (va - DYN_VA_BASE) / PAGE_SIZE;
    let pool_base_ptr: *u8 = page_pool as *u8;
    let pool_base: usize = pool_base_ptr as usize;
    let phys_addr: usize = pool_base + page.index * PAGE_SIZE;
    l3_address_space_write(space.slot, l3_index, phys_addr | PTE_FLAGS_EL0_RW);

    let mut occupied: AddressSpaceOwner[asid, SpaceState::Occupied] =
        { space.tag, space.slot };
    let mut pending: TlbInvalidationPending[asid, va, p] =
        { space.tag, va, page.index, page.p_witness, space.slot };
    return (occupied, pending);
}

fn map_second_page(space: sink AddressSpaceOwner[asid, SpaceState::Occupied],
                   page: sink PageOwner[p],
                   va: {DYN_VA_BASE..<DYN_VA_LIMIT as usize} @ va)
        -> (AddressSpaceOwner[asid, SpaceState::Occupied2],
            TlbInvalidationPending[asid, va, p]) {
    let l3_index: usize = (va - DYN_VA_BASE) / PAGE_SIZE;
    let pool_base: usize = (page_pool as *u8) as usize;
    let phys_addr: usize = pool_base + page.index * PAGE_SIZE;
    l3_address_space_write(space.slot, l3_index, phys_addr | PTE_FLAGS_EL2_RW);
    let mut occupied: AddressSpaceOwner[asid, SpaceState::Occupied2] =
        { space.tag, space.slot };
    let mut pending: TlbInvalidationPending[asid, va, p] =
        { space.tag, va, page.index, page.p_witness, space.slot };
    return (occupied, pending);
}

fn tlb_invalidate(space: borrow AddressSpaceOwner[asid, SpaceState::Occupied],
                  pending: sink TlbInvalidationPending[asid, va, p])
        -> MappingOwner[asid, va, p] {
    tlb_invalidate_asid_va(pending.space_slot, pending.va_value);
    let mut mapping: MappingOwner[asid, va, p] =
        { pending.asid_tag, pending.va_value, pending.page_index,
          pending.p_witness, pending.space_slot };
    return mapping;
}

fn tlb_invalidate_second(space: borrow AddressSpaceOwner[asid, SpaceState::Occupied2],
                         pending: sink TlbInvalidationPending[asid, va, p])
        -> MappingOwner[asid, va, p] {
    tlb_invalidate_asid_va(pending.space_slot, pending.va_value);
    let mut mapping: MappingOwner[asid, va, p] =
        { pending.asid_tag, pending.va_value, pending.page_index,
          pending.p_witness, pending.space_slot };
    return mapping;
}

fn unmap_second_page(space: sink AddressSpaceOwner[asid, SpaceState::Occupied2],
                     mapping: sink MappingOwner[asid, va, p])
        -> (AddressSpaceOwner[asid, SpaceState::Occupied], PageOwner[p]) {
    let l3_index: usize = (mapping.va_value - DYN_VA_BASE) / PAGE_SIZE;
    l3_address_space_write(mapping.space_slot, l3_index, 0);
    tlb_invalidate_asid_va(mapping.space_slot, mapping.va_value);
    let mut occupied: AddressSpaceOwner[asid, SpaceState::Occupied] =
        { space.tag, space.slot };
    let mut page: PageOwner[p] = { mapping.page_index, mapping.p_witness };
    return (occupied, page);
}

fn mapping_bytes(mapping: borrow MappingOwner[asid, va, p])
        -> [u8; PAGE_SIZE..] @ p {
    // PAGE_COUNT * PAGE_SIZE = 2097152, so every page start is below
    // 2093057 and every page end is at most 2097152 (the pool's own
    // size). Bare literals below (not the PAGE_SIZE/PAGE_COUNT consts)
    // match vm_page_map_core.tkb's own mapping_bytes -- a const name only
    // reliably narrows in a type position, not in runtime slice-length
    // arithmetic/comparison.
    let offset: {0..<2093057 as usize} = mapping.page_index * PAGE_SIZE;
    let pool = page_pool as [u8; PAGE_SIZE * PAGE_COUNT..];
    let bytes: []u8 = pool[offset..<offset + 4096];
    if (bytes.len >= 4096) {
        return bytes;
    }
    return pool[0..<4096];
}

fn mapping_va_acquire(active: sink ActiveAddressSpace[core, asid],
                      space: borrow AddressSpaceOwner[asid, SpaceState::Occupied],
                      mapping: borrow MappingOwner[asid, va, p])
        -> ActiveMappingView[core, asid, va, p] {
    let mut lease: ActiveMappingView[core, asid, va, p] =
        { active.core_tag, active.asid_tag, mapping.va_value,
          mapping.p_witness };
    return lease;
}

fn mapping_va_bytes(lease: borrow ActiveMappingView[core, asid, va, p])
        -> [u8; PAGE_SIZE..] @ p {
    let va_ptr: *u8 = lease.va_value as *u8;
    return unsafe { va_ptr[0..<4096] };
}

fn mapping_va_release(lease: sink ActiveMappingView[core, asid, va, p])
        -> ActiveAddressSpace[core, asid] {
    let mut active: ActiveAddressSpace[core, asid] =
        { lease.core_tag, lease.asid_tag };
    return active;
}

fn unmap_page(space: sink AddressSpaceOwner[asid, SpaceState::Occupied],
              mapping: sink MappingOwner[asid, va, p])
        -> (AddressSpaceOwner[asid, SpaceState::Empty], PageOwner[p]) {
    let l3_index: usize = (mapping.va_value - DYN_VA_BASE) / PAGE_SIZE;
    l3_address_space_write(mapping.space_slot, l3_index, 0);
    tlb_invalidate_asid_va(mapping.space_slot, mapping.va_value);

    let mut empty: AddressSpaceOwner[asid, SpaceState::Empty] =
        { space.tag, space.slot };
    let mut page: PageOwner[p] = { mapping.page_index, mapping.p_witness };
    return (empty, page);
}

// A coarse-grained process address space (GitHub issue #156, ported from
// vm_page_map_core.tkb's own copy -- see that file's own comment for the
// full rationale on why per-page bookkeeping here is ordinary array
// storage, not a linear owner per page: indexed linear owners cannot be
// stored in an array in this language today). Only ONE linear token is
// exposed to callers, covering the WHOLE address space's lifecycle end
// to end -- forgetting to tear it down is still a compile error.
private linear struct ProcessAddressSpace[asid: usize] {
    private tag: usize @ asid;
    private slot: {0..<2 as usize};
    private page_count: usize;
    private base_va: usize;
}

// Consumes a PageOwner and returns just its physical pool index, WITHOUT
// freeing it (page_used stays 1) -- the caller's own linear obligation to
// eventually free this page transfers to ProcessAddressSpace instead.
fn page_owner_into_index(owner: sink PageOwner[p]) -> {0..<PAGE_COUNT as usize} {
    return owner.index;
}

variant ProcessMapResult {
    Failed(exists asid: usize. AddressSpaceOwner[asid, SpaceState::Inactive]);
    Mapped(exists core: usize. exists asid: usize.
           (ProcessAddressSpace[asid], ActiveAddressSpace[core, asid]));
}

// Maps `page_count` (<= MAX_PROCESS_PAGES) consecutive EL0-accessible
// pages starting at `base_va`, allocating each fresh from the pool. On
// allocation failure partway through, unwinds (unmaps + frees) every
// page mapped so far, deactivates, and returns Failed so a failed call
// never leaks a partially-built address space or strands `active`'s own
// linear obligation.
fn process_address_space_map(
        space: sink AddressSpaceOwner[asid, SpaceState::Empty],
        active: sink ActiveAddressSpace[core, asid],
        base_va: {DYN_VA_BASE..<DYN_VA_LIMIT as usize},
        page_count: {0..<513 as usize}) -> ProcessMapResult { // upper bound = MAX_PROCESS_PAGES + 1 (must be a literal, see MAX_PROCESS_PAGES's own comment)
    let mut mapped: usize = 0;
    let mut ok: i32 = 1;
    let tag: usize @ asid = space.tag;
    let pool_base: usize = (page_pool as *u8) as usize;

    for i: usize in 0..<MAX_PROCESS_PAGES {
        if (i >= page_count) { break; }
        match page_alloc() {
            PageAllocResult::OutOfMemory => {
                ok = 0;
                break;
            }
            PageAllocResult::Allocated(page) => {
                let idx: {0..<PAGE_COUNT as usize} = page_owner_into_index(page);
                let va: usize = base_va + i * PAGE_SIZE;
                let l3_index: usize = (va - DYN_VA_BASE) / PAGE_SIZE;
                let phys_addr: usize = pool_base + idx * PAGE_SIZE;
                l3_address_space_write(space.slot, l3_index, phys_addr | PTE_FLAGS_EL0_RW);
                tlb_invalidate_asid_va(space.slot, va);
                process_phys_index_set(i, idx);
                mapped = mapped + 1;
            }
        }
    }

    if (ok != 0) {
        let mut pas: ProcessAddressSpace[asid] = { tag, space.slot, mapped, base_va };
        return ProcessMapResult::Mapped((pas, active));
    }

    for i: usize in 0..<MAX_PROCESS_PAGES {
        if (i >= mapped) { break; }
        let va: usize = base_va + i * PAGE_SIZE;
        let l3_index: usize = (va - DYN_VA_BASE) / PAGE_SIZE;
        l3_address_space_write(space.slot, l3_index, 0);
        tlb_invalidate_asid_va(space.slot, va);
        let idx: usize = process_phys_index_get(i);
        if (idx < PAGE_COUNT) {
            page_used[idx] = 0;
        }
    }
    let mut empty: AddressSpaceOwner[asid, SpaceState::Empty] = { tag, space.slot };
    let inactive = address_space_deactivate(active, empty);
    return ProcessMapResult::Failed(inactive);
}

// Unmaps and frees every page this ProcessAddressSpace owns, returning
// the now-Empty AddressSpaceOwner so the caller can deactivate/free it
// through the existing (fine-grained-agnostic) machinery above.
fn process_address_space_unmap(
        pas: sink ProcessAddressSpace[asid]) -> AddressSpaceOwner[asid, SpaceState::Empty] {
    for i: usize in 0..<MAX_PROCESS_PAGES {
        if (i >= pas.page_count) { break; }
        let va: usize = pas.base_va + i * PAGE_SIZE;
        let l3_index: usize = (va - DYN_VA_BASE) / PAGE_SIZE;
        l3_address_space_write(pas.slot, l3_index, 0);
        tlb_invalidate_asid_va(pas.slot, va);
        let idx: usize = process_phys_index_get(i);
        if (idx < PAGE_COUNT) {
            page_used[idx] = 0;
        }
    }
    let mut empty: AddressSpaceOwner[asid, SpaceState::Empty] = { pas.tag, pas.slot };
    return empty;
}
