// extern fn declaration for examples/common_rpi3/tlb_asm.S's
// tlb_invalidate_va stub (GitHub issue #67 Stage 2), split into its own
// file matching examples/common_rpi3/timer_asm_extern.tkb's own reasoning
// (a duplicate `extern fn` declaration is a hard conflict if two files
// needing it both declared it locally).

extern fn tlb_invalidate_va(va: usize);
extern fn tlb_invalidate_asid_va(asid: usize, va: usize);
extern fn tlb_invalidate_all_el2();
// GitHub issue #158: D-cache clean + I-cache invalidate for freshly
// loaded EL0 code -- see tlb_asm.S's own rpi3_code_range_sync for why
// this became necessary only once execve() started reloading a process
// image on an already-warm cache.
extern fn rpi3_code_range_sync(va: usize, len: usize);
