// GICv2 register globals, split out of gic.tkb (GitHub issue #79 follow-up)
// so a shared example file that needs ONLY these (irq.tkb/echo.tkb's own
// irq_dispatch, dead code on STM32 but still referencing `gic_cpu_iar`/
// `gic_cpu_eoir` so it type-checks there) can `use` this file WITHOUT also
// pulling in gic.tkb's functions.
//
// Why this split exists: gic.tkb's functions (gic_init, irq_uart_rx_setup,
// etc.) and examples/common_stm32/nvic.tkb's functions define
// irq_uart_rx_setup/irq_uart_rx_unmask under the IDENTICAL name and
// signature -- correct in isolation (each is the real implementation for
// its own target), but examples/irq/irq.tkb and examples/echo/echo.tkb are
// the two shared files that need BOTH nvic.tkb (their real STM32 UART-IRQ
// setup) AND something providing these registers (for the dead-on-STM32
// QEMU-shaped irq_dispatch to type-check) in the SAME STM32 build. Before
// this split, that "something" was full gic.tkb, so both real
// implementations of irq_uart_rx_setup/irq_uart_rx_unmask ended up defined
// in the same compilation -- previously silently accepted (see
// HISTORY.md's issue #79 follow-up for the compiler bug this exposed), now
// a compile error this split is what actually fixes. Every other
// scheduler-pattern shared file (preempt/semaphore/watchdog/condvar/
// msgqueue) uses examples/common_stm32/scheduler.tkb on STM32 instead of
// nvic.tkb, which defines no such colliding names, so they keep `use`ing
// full gic.tkb (its functions are genuinely needed there too, indirectly
// via examples/common_qemu/timer.tkb's own gic_init()/
// gic_enable_timer_ppi() calls on the QEMU side) with no conflict.
//
// GitHub issue #240/#316: these used to be `*io u32` fields on one
// `GicRegs` struct + a single `gic: GicRegs` instance -- moved to
// individual module-level globals when #240's pointer-struct-field
// restriction was extended to `*io T` (no legitimate use here needed a
// paired, unenforced-length pointer field; these seven addresses are
// scattered, unrelated registers, not one offset-consistent block, so
// there was never a `*io Struct` base-pointer-plus-offsets shape to
// preserve). Same pattern every other MMIO driver in this codebase
// already uses.

let gic_distr_ctlr:  *io u32 = unsafe { 0x08000000 as *io u32 }; // GICD_CTLR
let gic_distr_isen0: *io u32 = unsafe { 0x08000100 as *io u32 }; // GICD_ISENABLER0 (SGI/PPI, IRQ 0-31)
let gic_distr_isen1: *io u32 = unsafe { 0x08000104 as *io u32 }; // GICD_ISENABLER1 (SPI,     IRQ 32-63)
let gic_cpu_ctlr:    *io u32 = unsafe { 0x08010000 as *io u32 }; // GICC_CTLR
let gic_cpu_pmr:     *io u32 = unsafe { 0x08010004 as *io u32 }; // GICC_PMR
let gic_cpu_iar:     *io u32 = unsafe { 0x0801000C as *io u32 }; // GICC_IAR
let gic_cpu_eoir:    *io u32 = unsafe { 0x08010010 as *io u32 }; // GICC_EOIR
