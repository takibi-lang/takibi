// Results and copies of values that hold an array (GitHub issues #962 and
// #963). Such a result is returned through a slot the caller provides, and
// a copy of such a value is a block copy. This checks the copy semantics
// survive: each call fills its own slot, a returned value is independent
// of the callee's storage, a variant built from a value that is about to
// be overwritten keeps the old bytes, and a function value returns the
// same way as a direct call. A 520-byte record copied out of a result and
// passed on is the shape whose split copy LLVM turned into a memcpy call,
// which this program, linked without a C library, could not resolve.

struct Named {
    id: usize;
    name: [u8; 6];
}

variant Lookup {
    Found(Named);
    Missing;
}

struct Wide {
    id: usize;
    text: [u8; 512];
}

variant WideLookup {
    Found(Wide);
    Busy;
}

fn wide(id: usize) -> WideLookup {
    if (id == 0) { return WideLookup::Busy; }
    let mut w: Wide;
    w.id = id;
    for i: usize in 0..<512 { w.text[i] = 'A' + ((i % 26) as u8); }
    return WideLookup::Found(w);
}

fn put_wide(w: Wide) {
    uart_putc(w.text[0]);
    uart_putc(w.text[25]);
    uart_putc(w.text[511]);
    uart_puts("\r\n");
}

fn show_wide(id: usize) {
    let w: Wide = match wide(id) {
        WideLookup::Busy => { uart_puts("busy\r\n"); return; }
        WideLookup::Found(found) => { found }
    };
    if (w.id == id) { uart_puts("wide id ok\r\n"); }
    put_wide(w);
}

// GitHub issue #964: a payload bound by `let ... else` and only read is
// read in the caller's result slot rather than copied out of it, also in a
// loop, where the call refills the slot before each iteration's binding.
fn lookup_id(id: usize) -> usize {
    let Lookup::Found(n) = lookup(id) else {
        Lookup::Missing => { return 99; }
    };
    if (n.name[5] != 'a' + (id as u8) + 5) { return 98; }
    return n.id;
}

fn lookup_sum(count: usize) -> usize {
    let mut sum: usize = 0;
    for k: usize in 0..<count {
        let Lookup::Found(n) = lookup(k) else {
            Lookup::Missing => { continue; }
        };
        sum = sum + n.id * 10 + ((n.name[0] - 'a') as usize);
    }
    return sum;
}

// A written local the result only initializes is the result slot; in a
// loop each iteration's call refills it before the local is read again.
fn renamed_sum(count: usize) -> usize {
    let mut sum: usize = 0;
    for k: usize in 0..<count {
        let mut n: Named = named(k, 'a');
        n.name[3] = 'z';
        sum = sum + n.id + ((n.name[3] - n.name[0]) as usize);
    }
    return sum;
}

// A copy into a local read at two places keeps only the bytes between
// them; the written byte past them stays the local's own.
let mut name_table: [Named; 2];
fn table_pick(i: usize) -> usize {
    if (i >= 2) { return 0; }
    let mut n: Named = name_table[i];
    n.name[5] = '?';
    if (n.name[5] != '?') { return 77; }
    return n.id + ((n.name[1] - 'a') as usize);
}

fn put_name(n: Named) {
    for i: usize in 0..<6 {
        uart_putc(n.name[i]);
    }
    uart_puts("\r\n");
}

fn named(id: usize, first: u8) -> Named {
    let mut n: Named;
    n.id = id;
    for i: usize in 0..<6 { n.name[i] = first + (i as u8); }
    return n;
}

fn lookup(id: usize) -> Lookup {
    if (id == 0) { return Lookup::Missing; }
    return Lookup::Found(named(id, 'a' + (id as u8)));
}

// The result passes straight through a second function.
fn lookup_again(id: usize) -> Lookup {
    return lookup(id);
}

fn renamed(n: Named) -> Named {
    let mut m: Named = n;
    m.name[0] = 'R';
    return m;
}

fn report(l: Lookup) {
    match l {
        Lookup::Found(n) => { put_name(n); }
        Lookup::Missing => { uart_puts("missing\r\n"); }
    }
}

fn test_struct_array_result() {
    uart_puts("=== struct array result ===\r\n");
    let mut a: Named = named(1, 'a');
    put_name(a);
    let mut b: Named = renamed(a);
    put_name(b);
    put_name(a);

    // Plain assignment copies the whole value and leaves the source alone.
    a = b;
    b.name[1] = '!';
    put_name(a);
    put_name(b);

    // One call site in a loop: every iteration's result is its own.
    let mut table: [Named; 3];
    for k: usize in 0..<3 {
        table[k] = named(k, 'p' + (k as u8));
    }
    for k: usize in 0..<3 { put_name(table[k]); }

    report(lookup(2));
    report(lookup_again(3));
    report(lookup(0));

    // The variant is built from `a` before `a` is overwritten.
    let mut held: Lookup = Lookup::Found(a);
    a = named(9, 'x');
    report(held);
    put_name(a);

    let f: fn(Named) -> Named = renamed;
    put_name(f(a));

    if (lookup_id(4) == 4 && lookup_id(0) == 99) { uart_puts("bound read ok\r\n"); }
    // k = 1, 2, 3 are found with id k and name[0] = 'a' + k: 11 * 6.
    if (lookup_sum(4) == 66) { uart_puts("loop bound ok\r\n"); }

    // k = 0..3: id k plus 'z' - 'a' = 25 each.
    if (renamed_sum(4) == 106) { uart_puts("written slot ok\r\n"); }
    name_table[0] = named(5, 'a');
    name_table[1] = named(6, 'c');
    if (table_pick(1) == 9 && name_table[1].name[5] == 'h') { uart_puts("short copy ok\r\n"); }

    show_wide(4);
    show_wide(0);
    uart_puts("done\r\n");
}

fn app_main() {
    test_struct_array_result();
}
