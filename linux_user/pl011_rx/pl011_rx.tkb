// The kernel's PL011 receive drain, run against a scripted FIFO.
//
// GitHub issue #868. The RX interrupt took one word and cleared RTIS, so a
// burst below the 1/8 trigger level left bytes in the FIFO waiting on an
// interrupt that need not come. QEMU's PL011 interrupts on every byte (its
// trigger level is fixed at 1), so no QEMU lane can show the stranded bytes;
// this compiles kernel/drivers/serial/pl011_rx.tkb itself and counts what
// ONE call delivers.

// The actual registration/snapshot API is linked too. Sequential checks
// establish replacement semantics and callback re-registration, not IRQ or
// multicore exclusion; existing kernel UART lanes cover real IRQ delivery.
use "kernel/arch/arm64/kernel/platform_uart_common.tkb";
use "linux_user/pl011_rx/platform.tkb";

private let mut fifo: [u32; 64];
private let mut fifo_len: usize;
private let mut fifo_next: usize;
private let mut delivered: [u8; 64];
private let mut delivered_len: usize;
private let mut break_latched: bool;
private let mut break_cleared: bool;

fn uart_rx_ready() -> bool {
    return fifo_next < fifo_len;
}

fn uart_rx_word() -> u32 !{interrupt} {
    let index: usize = fifo_next;
    if (index < 64) {
        fifo_next = index + 1;
        return fifo[index];
    }
    return 0;
}

fn uart_break_flagged() -> bool !{interrupt} {
    return break_latched;
}

fn uart_break_clear() !{interrupt} {
    break_latched = false;
    break_cleared = true;
}

fn diagnostic_trace_record_uart_break(data: usize) !{interrupt, unsafe} {
}

fn record_received(c: u8) !{unsafe} {
    let index: usize = delivered_len;
    if (index < 64) {
        delivered[index] = c;
        delivered_len = index + 1;
    }
}

// Hosted stand-ins for the platform boundary, not for the guarded API.
fn mutex_irq_save() -> usize { return 0; }
fn mutex_irq_restore(flags: usize) { }
fn uart_rx_discard(discarded: u8) !{unsafe} { }

private let mut old_callback_calls: usize;
private let mut new_callback_calls: usize;

fn replacement_received(c: u8) !{unsafe} {
    new_callback_calls = new_callback_calls + 1;
}

fn reregister_received(c: u8) !{unsafe} {
    old_callback_calls = old_callback_calls + 1;
    uart_set_rx_handler(replacement_received);
}

fn registration_checks() !{unsafe} {
    let mut phase = boot_phase_mint();
    uart_rx_handler_reset_boot(phase);
    uart_rx_deliver(0);
    check("initial registration discards input", old_callback_calls == 0 && new_callback_calls == 0);
    uart_set_rx_handler(replacement_received);
    uart_rx_handler_reset_boot(phase);
    uart_rx_deliver(0);
    check("boot reinitialisation restores discard", new_callback_calls == 0);
    boot_phase_end(phase);

    // All following exchanges occur after the boot authority was consumed.
    uart_set_rx_handler(reregister_received);
    let mut old: UartRxHandler = uart_rx_handler_snapshot();
    uart_set_rx_handler(replacement_received);
    let old_handler = old.call;
    old_handler(0);
    check("a replaced snapshot can finish after boot", old_callback_calls == 1);
    uart_rx_deliver(0);
    check("delivery selects the replacement", new_callback_calls == 1);

    uart_set_rx_handler(reregister_received);
    uart_rx_deliver(0);
    check("a callback registers after guard release", old_callback_calls == 2);
    uart_rx_deliver(0);
    check("callback registration selects its successor", new_callback_calls == 2);
    uart_set_rx_handler(uart_rx_discard);
    uart_rx_deliver(0);
    check("postboot discard replaces the handler", old_callback_calls == 2 && new_callback_calls == 2);
    uart_set_rx_handler(record_received);
}

fn check(label: *u8, ok: bool) {
    if (ok) {
        uart_puts("ok     ");
    } else {
        uart_puts("FAILED ");
    }
    uart_puts(label);
    uart_puts("\r\n");
}

private fn load(count: usize) {
    fifo_len = 0;
    fifo_next = 0;
    delivered_len = 0;
    break_latched = false;
    break_cleared = false;
    for i: usize in 0..<64 {
        if (i < count) {
            fifo[i] = (0x41 + i % 26) as u32;
            fifo_len = i + 1;
        }
    }
}

private fn delivered_in_order() -> bool {
    let mut ok: bool = true;
    for i: usize in 0..<64 {
        if (i < delivered_len && delivered[i] != (0x41 + i % 26) as u8) { ok = false; }
    }
    return ok;
}

// Hosted interrupt declaration root: Linux supplies no hardware IRQ state to
// save or restore. Keep the actual drain's interrupt call contract without
// inventing a masking guard across its opaque callback. This fixture checks
// sequential delivery only; the maintained kernel lanes run real IRQ entry.
fn drain_once() -> bool !{interrupt, unsafe} {
    return uart_rx_drain();
}

fn main() !{interrupt, unsafe} {
    registration_checks();
    // Three bytes: below the 1/8 trigger (4 of 32), the burst #868 stranded.
    load(3);
    let first: bool = drain_once();
    check("a 3-byte burst is all delivered by one interrupt",
          first == false && delivered_len == 3 && fifo_next == 3);
    check("the burst arrives in order", delivered_in_order());

    load(1);
    let single: bool = drain_once();
    check("a single byte is delivered", single == false && delivered_len == 1);

    load(0);
    let empty: bool = drain_once();
    check("an empty FIFO delivers nothing", empty == false && delivered_len == 0);

    // A flood larger than the FIFO: one interrupt takes one FIFO's worth and
    // the rest is left for the next, so IRQ-masked time stays bounded.
    load(40);
    let flood: bool = drain_once();
    check("one interrupt reads at most the 32-word FIFO depth",
          flood == false && delivered_len == 32 && fifo_next == 32);
    check("the flood arrives in order", delivered_in_order());

    // A BREAK word (DR.BE) mid-burst ends the drain and enters the debugger.
    load(5);
    fifo[2] = 1 << 10;
    let brk: bool = drain_once();
    check("a BREAK word stops the drain and reports the debugger",
          brk && delivered_len == 2 && fifo_next == 3 && break_cleared);

    // BEMIS latched with the FIFO empty, as the board reports a BREAK.
    load(0);
    break_latched = true;
    let latched: bool = drain_once();
    check("a latched BREAK with an empty FIFO reports the debugger",
          latched && break_cleared && break_latched == false);
}
