// End-to-end exerciser for the real generic Freelist(T, N) (GitHub issue
// #207, generics build order step 7; N is a later const-generics
// follow-up -- see freelist.tkb's own header comment). Two independent
// pools, two different payload types AND two different capacities
// instantiated from the SAME template in one program: a small scalar
// (usize, N=3) and a small struct (Point, N=2), proving genericity works
// across both type and capacity, not just primitives. Coverage mirrors
// freelist_pool.tkb's own established rigor for the non-generic prototype
// this design grew out of: allocate, LIFO-reuse-after-free, the "freeing
// does not clear payload" property, and pool exhaustion.
//
// Every allocation below reads `let a = match freelist_insert(&pool) {
// ... };` with no type annotation at all -- a later issue #207 follow-up
// made LetMatch's own `: ty` optional, inferred from what the (fully
// explicit, no wildcard) arms `Yield`, closing the gap between this and
// the original approved plan's own mockup.
//
// The literal capacity is written exactly once per pool, as a `const` --
// USIZE_POOL_N/POINT_POOL_N -- referenced everywhere else (the pool's own
// type argument, and its data array's size) so a mismatched size becomes
// an ordinary compile-time array-type error instead of something to spot
// by hand across multiple declarations. Freelist redesign follow-up: the
// index/bookkeeping array is now embedded in FreelistCore(N) itself (see
// freelist.tkb) -- only `data` (the payload storage) is still a caller-
// owned array here, for the alignment reasons documented there.

// `use`s kernel/lib/freelist.tkb directly, not a re-prototyped local
// copy: this file's own local freelist.tkb WAS that copy (issue #207's
// design-prototyping stage, per AGENTS.md's linux_user/ charter), but
// kernel/lib/freelist.tkb has since diverged from it (freelist_owner_
// into_parts/freelist_owner_drop, added for kernel/ call sites that
// expose their own owner type -- see that file's own header), so testing
// the local copy stopped being real regression coverage of what kernel/
// actually ships. See linux_user/slotmap/'s own header for the fuller
// story of why this matters (issue #207's real double-free bugs were
// only found via a multi-hour hardware bisection, with no fast test
// exercising the actual library in between).
use "kernel/lib/freelist.tkb";

struct Point {
    x: usize;
    y: usize;
}

const USIZE_POOL_N: usize = 3;
private let mut usize_pool: Freelist(usize, USIZE_POOL_N);
private let mut usize_data_store: [usize; USIZE_POOL_N];

const POINT_POOL_N: usize = 2;
private let mut point_pool: Freelist(Point, POINT_POOL_N);
private let mut point_data_store: [Point; POINT_POOL_N];

// Dedicated single-slot pool for freelist_owner_into_parts()'s own round
// trip -- kept separate from usize_pool/point_pool below so this probe
// cannot perturb their own already-established LIFO/exhaustion assertions.
// Neither Freelist(T, N)'s own public API (freelist_insert/_remove/_ref)
// nor kernel/lib/slotmap.tkb's SlotMap (which extracts index/generation
// via the borrow-mode freelist_owner_index/_generation instead, then
// explicitly freelist_owner_drop()s the original) ever calls into_parts,
// so without this, kernel/lib/freelist.tkb's own addition over the
// original design this file prototyped had zero coverage against the
// real file -- only kernel/mm/page.tkb/kernel/kernel/process.tkb/kernel/
// mm/address_space.tkb/kernel/net/tcp.tkb's own real (SlotMap-wrapping)
// use of it, all only exercised by a full RPi5 hardware boot.
const PARTS_POOL_N: usize = 1;
private let mut parts_pool: FreelistCore(PARTS_POOL_N);

fn app_main() {
    freelist_core_init(&parts_pool);
    let probe = match freelist_core_insert(&parts_pool) {
        FreelistPopResult::Empty => { uart_puts("parts probe alloc failed\n"); return; }
        FreelistPopResult::Popped(o) => { o }
    };
    let probe_index_before: usize = freelist_owner_index(probe);
    let probe_generation_before: usize = freelist_owner_generation(probe);
    let (probe_index, probe_generation) = freelist_owner_into_parts(probe);
    uart_puts("into_parts preserves index: ");
    uart_print(probe_index == probe_index_before);
    uart_puts("\n");
    uart_puts("into_parts preserves generation: ");
    uart_print(probe_generation == probe_generation_before);
    uart_puts("\n");
    // The slot is NOT back on the free list yet -- into_parts only
    // unwraps the linear proof, it does not release (see that function's
    // own doc comment: the paired reconstruction is freelist_owner_new,
    // used here exactly as kernel/mm/page.tkb's page_alloc() does with
    // its own PageOwner).
    uart_puts("pool still full after into_parts (no release): ");
    match freelist_core_insert(&parts_pool) {
        FreelistPopResult::Empty => { uart_puts("true\n"); }
        FreelistPopResult::Popped(o) => {
            uart_puts("false (wrongly had room)\n");
            freelist_core_remove(&parts_pool, o);
        }
    }
    // Reconstruct and release through the normal path, proving the round
    // trip leaves the owner just as usable as the original.
    freelist_core_remove(&parts_pool,
                         freelist_owner_new(probe_index, probe_generation));
    uart_puts("pool free again after releasing the reconstructed owner: ");
    match freelist_core_insert(&parts_pool) {
        FreelistPopResult::Empty => { uart_puts("false (wrongly still full)\n"); }
        FreelistPopResult::Popped(o) => {
            uart_puts("true\n");
            freelist_core_remove(&parts_pool, o);
        }
    }

    freelist_init(&usize_pool, usize_data_store as []usize);

    let a = match freelist_insert(&usize_pool) {
        FreelistPopResult::Empty => { uart_puts("alloc a failed\n"); return; }
        FreelistPopResult::Popped(o) => { o }
    };
    let b = match freelist_insert(&usize_pool) {
        FreelistPopResult::Empty => {
            uart_puts("alloc b failed\n");
            freelist_remove(&usize_pool, a);
            return;
        }
        FreelistPopResult::Popped(o) => { o }
    };
    let c = match freelist_insert(&usize_pool) {
        FreelistPopResult::Empty => {
            uart_puts("alloc c failed\n");
            freelist_remove(&usize_pool, a);
            freelist_remove(&usize_pool, b);
            return;
        }
        FreelistPopResult::Popped(o) => { o }
    };

    uart_puts("usize allocated: ");
    uart_print(freelist_owner_index(a));
    uart_puts(" ");
    uart_print(freelist_owner_index(b));
    uart_puts(" ");
    uart_print(freelist_owner_index(c));
    uart_puts("\n");

    *freelist_ref(&usize_pool, a) = 10;
    *freelist_ref(&usize_pool, b) = 20;
    *freelist_ref(&usize_pool, c) = 30;

    freelist_remove(&usize_pool, a);
    freelist_remove(&usize_pool, b);

    let r1 = match freelist_insert(&usize_pool) {
        FreelistPopResult::Empty => {
            uart_puts("reuse 1 failed\n");
            freelist_remove(&usize_pool, c);
            return;
        }
        FreelistPopResult::Popped(o) => { o }
    };
    let r2 = match freelist_insert(&usize_pool) {
        FreelistPopResult::Empty => {
            uart_puts("reuse 2 failed\n");
            freelist_remove(&usize_pool, r1);
            freelist_remove(&usize_pool, c);
            return;
        }
        FreelistPopResult::Popped(o) => { o }
    };

    uart_puts("reused (LIFO: b's slot, then a's slot): ");
    uart_print(freelist_owner_index(r1));
    uart_puts(" ");
    uart_print(freelist_owner_index(r2));
    uart_puts("\n");

    uart_puts("stale before reset (r1 sees b's old 20, r2 sees a's old 10): ");
    uart_print(*freelist_ref(&usize_pool, r1));
    uart_puts(" ");
    uart_print(*freelist_ref(&usize_pool, r2));
    uart_puts("\n");

    *freelist_ref(&usize_pool, r1) = 100;
    *freelist_ref(&usize_pool, r2) = 200;
    uart_puts("after reset: ");
    uart_print(*freelist_ref(&usize_pool, r1));
    uart_puts(" ");
    uart_print(*freelist_ref(&usize_pool, r2));
    uart_puts("\n");

    match freelist_insert(&usize_pool) {
        FreelistPopResult::Empty => { uart_puts("usize pool exhausted as expected\n"); }
        FreelistPopResult::Popped(o) => {
            uart_puts("unexpected extra usize allocation\n");
            freelist_remove(&usize_pool, o);
        }
    }

    freelist_remove(&usize_pool, r1);
    freelist_remove(&usize_pool, r2);
    freelist_remove(&usize_pool, c);

    // Second instantiation of the same template, a struct payload AND a
    // different capacity (N=2 vs N=3 above) -- proves genericity works
    // beyond primitive scalars and beyond a single fixed size, and that
    // field access through freelist_ref's returned pointer needs no
    // explicit deref (the exact shape a real 4KB-page pool would rely on).
    freelist_init(&point_pool, point_data_store as []Point);

    let p1 = match freelist_insert(&point_pool) {
        FreelistPopResult::Empty => { uart_puts("alloc p1 failed\n"); return; }
        FreelistPopResult::Popped(o) => { o }
    };
    let p2 = match freelist_insert(&point_pool) {
        FreelistPopResult::Empty => {
            uart_puts("alloc p2 failed\n");
            freelist_remove(&point_pool, p1);
            return;
        }
        FreelistPopResult::Popped(o) => { o }
    };

    freelist_ref(&point_pool, p1).x = 1;
    freelist_ref(&point_pool, p1).y = 2;
    freelist_ref(&point_pool, p2).x = 3;
    freelist_ref(&point_pool, p2).y = 4;

    uart_puts("points: ");
    uart_print(freelist_ref(&point_pool, p1).x);
    uart_puts(",");
    uart_print(freelist_ref(&point_pool, p1).y);
    uart_puts(" ");
    uart_print(freelist_ref(&point_pool, p2).x);
    uart_puts(",");
    uart_print(freelist_ref(&point_pool, p2).y);
    uart_puts("\n");

    match freelist_insert(&point_pool) {
        FreelistPopResult::Empty => { uart_puts("point pool exhausted as expected\n"); }
        FreelistPopResult::Popped(o) => {
            uart_puts("unexpected extra point allocation\n");
            freelist_remove(&point_pool, o);
        }
    }

    freelist_remove(&point_pool, p1);
    freelist_remove(&point_pool, p2);

    uart_puts("done\n");
}
