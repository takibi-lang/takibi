// Freelist redesign (follow-up to the const-generics work, GitHub issue
// #207): a long design discussion converged on a specific split of
// responsibility between FreelistCore(N) and Freelist(T, N), driven by
// two verified, concrete facts about this compiler:
//
// 1. A struct's ARRAY-typed field decays to a raw, unchecked pointer the
//    instant it is read via field access (confirmed: lib/type_inf.ml's
//    FieldGet TArray case and lib/llvm_gen.ml's own TypeArray case both
//    strip the array-ness down to a bare element pointer) -- indexing
//    through it is not merely unproven, there is no bounds-check codegen
//    path involved at all, not even a --forbid-trap-visible one. This is
//    a concrete new instance of GitHub issue #15 ("Safe pointer"), which
//    tracks it; not solved here, deliberately deferred.
// 2. `[]T` (a genuine slice) is the only type in this language that both
//    (a) crosses a function/struct boundary and (b) keeps real, checked/
//    elidable indexing -- slices do not decay on field read.
//
// Given those two facts: `index` (the free-list bookkeeping array,
// next_free) has no alignment requirements and no good reason to be a
// caller's problem, so it is embedded directly in FreelistCore(N),
// deliberately accepting point 1's unchecked-indexing risk for it (see
// each function below). `data` (the payload storage) DOES need caller-
// controlled alignment (e.g. a real page pool wants align(4096) on its
// OWN array declaration, which no per-field alignment syntax can express
// on an embedded field) and benefits from point 2's real checking, so it
// stays a caller-owned slice, `[T; N..]` -- a SYMBOLIC slice minimum
// (Ast.TypeSliceSym), so a size-mismatched backing array is still a
// genuine compile-time type error (TSlice subtyping: actual minimum must
// be >= N), unlike an unconstrained `[]T` field, which enforces nothing.
//
// Naming: freelist_core_pop/_push are renamed to freelist_core_insert/
// _remove, matching freelist_insert/freelist_remove's own already-
// established vocabulary (mirrors freelist_init/freelist_core_init's
// existing "same verb, core_ prefix" convention exactly).

variant FreelistPopResult {
    Empty;
    Popped(exists allocation: usize. FreelistOwner[allocation]);
}

private linear struct FreelistOwner[allocation: usize] {
    private index: usize;
    private generation: usize @ allocation;
}

fn freelist_owner_new(index: usize, generation: usize @ allocation)
        -> FreelistOwner[allocation] {
    let mut owner: FreelistOwner[allocation] = { index, generation };
    return owner;
}

fn freelist_owner_index(owner: borrow FreelistOwner[allocation]) -> usize {
    return owner.index;
}

fn freelist_owner_generation(owner: borrow FreelistOwner[allocation]) -> usize {
    return owner.generation;
}

// N is this pool's capacity, embedded directly -- no caller-supplied
// backing array for the bookkeeping index at all.
generic struct FreelistCore(N: usize) {
    next_free: [usize; N];
    free_head: usize;
    next_generation: usize;
}

fn freelist_core_init(core: *FreelistCore(N)) {
    let next_free = core.next_free;
    // GitHub issue #15: next_free is a struct-embedded array field, so
    // this read decays to a raw *usize (see this file's own header
    // comment) -- next_free[i] below is ordinary unchecked pointer
    // arithmetic, not a runtime-checked trap site. Deliberately accepted,
    // not proven safe. Pointer indexing needs an isize offset (unlike
    // checked array/slice indexing, which accepts usize), hence `i:
    // isize` here rather than usize.
    for i: isize in 0..<N {
        next_free[i] = i as usize + 1;
    }
    core.free_head = 0;
    core.next_generation = 1;
}

fn freelist_core_insert(core: *FreelistCore(N)) -> FreelistPopResult {
    let next_free = core.next_free;   // see freelist_core_init's #15 note
    let head: usize = core.free_head;
    if (head >= 0 && head < N) {
        core.free_head = next_free[head as isize];
        let generation: usize = core.next_generation;
        core.next_generation = generation + 1;
        return FreelistPopResult::Popped(freelist_owner_new(head, generation));
    }
    return FreelistPopResult::Empty;
}

fn freelist_core_remove(core: *FreelistCore(N), owner: sink FreelistOwner[allocation]) {
    let next_free = core.next_free;   // see freelist_core_init's #15 note
    // GitHub issue #216: owner.index is only ever produced by
    // freelist_core_insert from this same core's next_free, so it is
    // always in range in practice, but that fact crosses a function-call
    // boundary -- and, now that next_free is raw pointer arithmetic
    // rather than a checked slice access (issue #15), there is no trap
    // site here for --forbid-trap to even report; this is NOT a safety
    // improvement over the earlier slice-based version, it is the
    // checker no longer looking at this code at all.
    next_free[freelist_owner_index(owner) as isize] = core.free_head;
    core.free_head = freelist_owner_index(owner);
}

generic struct Freelist(T: type, N: usize) {
    core: FreelistCore(N);
    data: [T; N..];
}

fn freelist_init(T: type, target: *Freelist(T, N), data_backing: [T; N..]) {
    freelist_core_init(&target.core);
    target.data = data_backing;
}

fn freelist_insert(T: type, target: *Freelist(T, N)) -> FreelistPopResult {
    return freelist_core_insert(&target.core);
}

fn freelist_remove(T: type, target: *Freelist(T, N),
                    owner: sink FreelistOwner[allocation]) {
    freelist_core_remove(&target.core, owner);
}

// Returns a pointer to T tied to owner's slot -- no copy, whatever T's
// size. Field access through the result needs no explicit deref (e.g.
// `freelist_ref(&target, owner).x = 1;`); a whole-T read/write does
// (`*freelist_ref(&target, owner) = v;`), which is the expensive case
// made to visibly look expensive, exactly as intended when this shape
// was designed. `data` is a genuine slice field here (no decay), so the
// `as *T` cast is needed to get a raw pointer for the offset -- this
// whole function is raw pointer arithmetic (issue #15), same as it has
// been since the very first #207 worked example.
fn freelist_ref(T: type, target: *Freelist(T, N),
                owner: borrow FreelistOwner[allocation]) -> *T {
    let data = target.data;
    let index: isize = freelist_owner_index(owner) as isize;
    return (data as *T) + index;
}
