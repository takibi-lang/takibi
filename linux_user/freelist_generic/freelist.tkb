// FreelistCore/FreelistOwner/FreelistPopResult are the non-generic pool
// bookkeeping (GitHub issue #207's approved generics plan, build order
// step 1): next_free/free_head/next_generation never touch a payload
// type, so none of this needs the generics feature at all. Capacity is
// not a parameter of this type at all -- it is simply the length of
// whatever backing slice the caller hands to freelist_core_init, exactly
// matching how every other slice in this language already carries its
// own runtime length (SPEC.md's "Slices" section), so there is no
// separate N to keep in sync with anything.
//
// Freelist(T) below (build order step 7) is a thin GENERIC wrapper over
// this bookkeeping -- only the parts that genuinely vary by T are
// generic; FreelistCore/FreelistOwner/FreelistPopResult stay exactly as
// build order step 1 left them. `use`-concatenation puts everything in
// one compilation unit regardless of file boundaries, and
// lib/monomorphize.ml only ever duplicates `generic struct`/`T: type`
// items -- so keeping the non-generic bookkeeping and the generic
// wrapper in a SINGLE file changes nothing about what ends up duplicated
// in the compiled binary (confirmed empirically: freelist_core_init/
// _pop/_push compile to exactly one copy each no matter how many
// Freelist(T) instantiations exist; only freelist_init/freelist_insert/
// freelist_remove/freelist_ref get one mangled copy per T). This used to
// be two files (freelist_core.tkb / freelist.tkb) purely to de-risk
// build order -- the core bookkeeping was written and verified before
// the generics compiler feature existed at all, not because the
// compiler needed a file boundary to keep it from being duplicated; now
// that generics are proven, one file is simply easier to read.
//
// Freelist(T, N): N is a const-generic value parameter (monomorphized --
// substituted + mangled per concrete int, exactly like T is per concrete
// type), not a runtime slice length. This closed a real, user-found gap:
// a caller's `usize_index_store: [usize; 3]` is ALREADY statically sized
// at its own declaration, but the earlier `Freelist(T)` design (T only,
// data: []T, freelist_init taking a runtime-length data_backing: []T
// argument) threw that static information away at the generic library's
// own API boundary, forcing runtime bounds checks inside the library even
// though every real call site's size was compile-time-known. With N
// const-generic, `data: [T; N]` is a genuine fixed-size array embedded
// directly in the pool's own storage -- freelist_init no longer takes a
// data_backing argument at all, and a caller mismatching N between its
// index/data arrays and the pool's own declared type gets an ordinary
// array-size type error, not a silently-erased runtime check.
//
// FreelistCore/FreelistOwner/FreelistPopResult are intentionally UNCHANGED
// by this: `next_free` stays a runtime-length `[]usize` slice, so
// FreelistCore itself is not parametrized by N at all. Closing issue #216
// (freelist_core_push's owner.index bounds check, which crosses a
// function-call boundary) would need FreelistOwner to ALSO carry N --
// combining const-generic monomorphization with FreelistOwner's own
// existing erased/existential bracket mechanism (allocation) -- which is
// deliberately out of scope here; #216 stays open.

variant FreelistPopResult {
    Empty;
    Popped(exists allocation: usize. FreelistOwner[allocation]);
}

private linear struct FreelistOwner[allocation: usize] {
    private index: usize;
    private generation: usize @ allocation;
}

fn freelist_owner_new(index: usize, generation: usize @ allocation)
        -> FreelistOwner[allocation] {
    let mut owner: FreelistOwner[allocation] = { index, generation };
    return owner;
}

fn freelist_owner_index(owner: borrow FreelistOwner[allocation]) -> usize {
    return owner.index;
}

fn freelist_owner_generation(owner: borrow FreelistOwner[allocation]) -> usize {
    return owner.generation;
}

struct FreelistCore {
    next_free: []usize;
    free_head: usize;
    next_generation: usize;
}

// backing.len becomes this core's capacity for its whole lifetime.
fn freelist_core_init(core: *FreelistCore, backing: []usize) {
    let mut next_free = backing;
    // GitHub issue #215 (fixed): the loop's own bound is textually
    // `next_free.len`, which now proves the index against next_free's
    // runtime length via llvm_gen.ml's slice_index_ctx relational
    // narrowing (the for-loop's own per-iteration i < hi comparison IS
    // the proof) -- no trap site remains here.
    for i: usize in 0..<next_free.len {
        next_free[i] = i + 1;
    }
    core.next_free = next_free;
    core.free_head = 0;
    core.next_generation = 1;
}

fn freelist_core_pop(core: *FreelistCore) -> FreelistPopResult {
    let mut next_free = core.next_free;
    let head: usize = core.free_head;
    if (head >= 0 && head < next_free.len) {
        // GitHub issue #213 (fixed): `head < next_free.len` now proves
        // this index against next_free's runtime length via llvm_gen.ml's
        // slice_index_ctx relational narrowing -- no trap site remains here.
        core.free_head = next_free[head];
        let generation: usize = core.next_generation;
        core.next_generation = generation + 1;
        return FreelistPopResult::Popped(freelist_owner_new(head, generation));
    }
    return FreelistPopResult::Empty;
}

fn freelist_core_push(core: *FreelistCore, owner: sink FreelistOwner[allocation]) {
    let mut next_free = core.next_free;
    // GitHub issue #216: owner.index is only ever produced by
    // freelist_core_pop from this same core's next_free, so it is always
    // in range in practice, but that fact crosses a function-call boundary
    // (a proof the checker does not carry across calls today, unlike the
    // same-scope relational case in freelist_core_pop, fixed by #213).
    // Runtime trap accepted here.
    next_free[owner.index] = core.free_head;
    core.free_head = owner.index;
}

generic struct Freelist(T: type, N: usize) {
    core: FreelistCore;
    data: [T; N];
}

fn freelist_init(T: type, target: *Freelist(T, N), index_backing: []usize) {
    freelist_core_init(&target.core, index_backing);
}

fn freelist_insert(T: type, target: *Freelist(T, N)) -> FreelistPopResult {
    return freelist_core_pop(&target.core);
}

fn freelist_remove(T: type, target: *Freelist(T, N),
                    owner: sink FreelistOwner[allocation]) {
    freelist_core_push(&target.core, owner);
}

// Returns a pointer to T tied to owner's slot -- no copy, whatever T's
// size. Field access through the result needs no explicit deref (e.g.
// `freelist_ref(&target, owner).x = 1;`); a whole-T read/write does
// (`*freelist_ref(&target, owner) = v;`), which is the expensive case
// made to visibly look expensive, exactly as intended when this shape
// was designed. `target.data` already decays to `*T` (array field read),
// so no `as *T` cast is needed here (the earlier []T-slice design needed
// one; embedding a genuine [T; N] array field made it a no-op, dropped).
fn freelist_ref(T: type, target: *Freelist(T, N),
                owner: borrow FreelistOwner[allocation]) -> *T {
    let data = target.data;
    let index: isize = freelist_owner_index(owner) as isize;
    return data + index;
}
