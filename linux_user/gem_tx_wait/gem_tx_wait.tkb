// Execute the driver's actual wait policy against a deterministic clock and
// descriptor oracle. This tests the time budget and wake-and-recheck rule;
// it does not model DMA, cache coherence, or hardware interrupt delivery.
let mut fake_now: i64;
let mut complete_at: i64;
let mut wake_ticks: i64;
let mut waits: usize;
let mut checked_slot: usize;

fn read_cntpct() -> i64 {
    fake_now = fake_now + 1;
    return fake_now;
}

fn read_cntfrq() -> i64 { return 1000000; }

fn gem_tx_slot_done(slot: {0..<2 as usize}) -> bool {
    checked_slot = slot;
    return complete_at >= 0 && fake_now >= complete_at;
}

fn workload_profile_interrupt_wait() !{may_block} {
    waits = waits + 1;
    fake_now = fake_now + wake_ticks;
}

fn reset(done_at: i64, wake_step: i64) {
    fake_now = 0;
    complete_at = done_at;
    wake_ticks = wake_step;
    waits = 0;
    checked_slot = 9;
}

fn check(ok: bool, label: *u8) {
    if (ok == false) {
        uart_puts("FAIL gem-tx-wait: "); uart_puts(label); uart_puts("\r\n");
        linux_exit(1);
    }
}

fn app_main() !{may_block} {
    reset(0, 15000);
    let immediate: bool = gem_tx_wait(0);
    check(immediate && waits == 0 && checked_slot == 0, "already complete");

    reset(100, 100);
    let irq: bool = gem_tx_wait(1);
    check(irq && waits == 1 && checked_slot == 1, "wire latency needs an IRQ, no busy poll");

    reset(500, 50);
    let unrelated: bool = gem_tx_wait(0);
    check(unrelated && waits > 1 && fake_now >= 500, "unrelated wakes recheck completion");

    // More than the old 1000-wake cap must not exhaust a time budget.
    reset(12000, 1);
    let many_wakes: bool = gem_tx_wait(1);
    check(many_wakes && waits > 1000 && fake_now < 14001,
          "frequent wakes cannot shorten the deadline");

    reset(-1, 1000);
    let absent: bool = gem_tx_wait(0);
    check(absent == false && waits == 14 && fake_now >= 14001 && fake_now < 15000,
          "missing completion expires after 14 ms, not 1000 wakes");

    // The periodic wake may follow the deadline: check real completion
    // before declaring failure, without treating the wake itself as proof.
    reset(14001, 14000);
    let boundary: bool = gem_tx_wait(1);
    check(boundary && waits == 1, "completion observed at the deadline wins");

    reset(-1, 14000);
    let boundary_absent: bool = gem_tx_wait(1);
    check(boundary_absent == false && waits == 1, "absent completion at the deadline fails");

    reset(-1, 15000);
    let delayed_wake: bool = gem_tx_wait(0);
    check(delayed_wake == false && waits == 1 && fake_now >= 15001,
          "late periodic wake still reports unconfirmed completion");
    uart_puts("gem-tx-wait: IRQ-only, unrelated wakes, elapsed 14 ms deadline, final completion ok\r\n");
}
