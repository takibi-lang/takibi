// GitHub issue #672: the built-in region (compiled with --regions).
// A region(T)[b, n] is the right to touch n elements of type T, the first
// at static position b. It is never copied: it is split into two adjacent
// regions and merged back. Counts are element counts; no byte sizes appear.
// What must not compile is in test/test_takibi.ml, "built-in region".

struct Node { key: usize; value: usize; }

const NODE_COUNT: usize = 64;

// The axiom: a declared array becomes one region of its own element type
// and length, once.
private let mut region_arena: [Node; NODE_COUNT];

// A count known only at run time.
private let mut region_wanted: usize = 10;

fn test_region() {
    let RegionOf(Node)::Taken(nodes) = region_of(region_arena) else {
        RegionOf(Node)::Gone => { uart_puts("arena: already taken\n"); return; }
    };                                          // region(Node)[b, 64]

    // A split whose point is a constant within the count: proved at
    // compile time, so there is no failure branch to write.
    let (first, rest) = region_split_static(nodes, 3);
                                                // first: region(Node)[b, 3]
                                                // rest:  region(Node)[b + 3, 61]
    region_at(first, 0).key = 7;                // index checked against 3
    region_at(first, 2).key = 9;                // at compile time

    // A split whose point is only known at run time: the region comes back
    // whole when it does not fit. No trap.
    match region_split(rest, region_wanted) {
        RegionSplit(Node)::TooShort(whole) => {
            uart_puts("too many\n");
            region_release(region_merge(first, whole));
        }
        RegionSplit(Node)::Split(parts) => {
            let (taken, left) = parts;          // taken: region(Node)[b + 3, k]
            uart_puts("taken: ");
            uart_print(region_count(taken));
            uart_puts(", keys: ");
            uart_print(region_at(first, 0).key + region_at(first, 2).key);
            uart_puts("\n");
            let back = region_merge(taken, left);   // region(Node)[b + 3, 61]
            let all = region_merge(first, back);    // region(Node)[b, 64]
            uart_puts("arena: ");
            uart_print(region_count(all));
            uart_puts(" nodes whole again\n");
            region_release(all);
        }
    }
}

// A fixed pool: a table holds every slot's permission. Allocating hands a
// slot's region out; giving it back stores it and returns a handle a program
// may keep anywhere; taking by handle hands it out again, unless the slot was
// freed since, which no stored handle can outlive.
private let mut pool_arena: [Node; 4];

fn test_table() {
    let RegionTableOf(Node)::Taken(pool) = region_table_of(pool_arena) else {
        RegionTableOf(Node)::Gone => { uart_puts("pool: already taken\n"); return; }
    };
    match region_alloc(pool) {
        RegionAlloc(Node)::Full => { uart_puts("pool: full\n"); }
        RegionAlloc(Node)::Allocated(slot) => {
            region_slot_at(slot).key = 42;
            let mut handle: RegionHandle(Node) = region_give(pool, slot);
            match region_take(pool, handle) {
                RegionTake(Node)::Stale => { uart_puts("pool: stale\n"); }
                RegionTake(Node)::Taken(again) => {
                    uart_puts("pool: key ");
                    uart_print(region_slot_at(again).key);
                    uart_puts("\n");
                    region_free(pool, again);
                }
            }
            match region_take(pool, handle) {           // freed since
                RegionTake(Node)::Stale => { uart_puts("pool: old handle refused\n"); }
                RegionTake(Node)::Taken(wrong) => {
                    uart_puts("pool: old handle accepted\n");
                    region_free(pool, wrong);
                }
            }
        }
    }
    region_table_keep(pool);
}

// A guarded table: every use of the table is under its lock, taken by
// region_table_lock and given back by region_table_unlock. A slot taken out
// under one lock is the program's until it is given back, under any later
// lock of the same array: the slot outlives the lock, the lock does not have
// to be held while the element is used.
private let mut shared_arena: [Node; 4];

fn test_locked_table() {
    let pool = region_table_lock(shared_arena);
    match region_alloc(pool) {
        RegionAlloc(Node)::Full => {
            uart_puts("shared: full\n");
            region_table_unlock(pool);
        }
        RegionAlloc(Node)::Allocated(slot) => {
            region_table_unlock(pool);              // the lock is released here
            region_slot_at(slot).key = 5;           // the slot is still ours
            let again = region_table_lock(shared_arena);
            let mut handle: RegionHandle(Node) = region_give(again, slot);
            region_table_unlock(again);
            uart_puts("shared: given back under a second lock\n");
        }
    }
}

// A pool that grows: no fixed capacity. It takes chunks as byte regions --
// here from an array standing in for the page allocator -- and gives a chunk
// whose slots are all free back as a byte region.
private let mut connections: RegionPool(Node);
private let mut page_arena: [u8; 2048];

fn test_pool() {
    let RegionOf(u8)::Taken(pages) = region_of(page_arena) else {
        RegionOf(u8)::Gone => { uart_puts("pages: already taken\n"); return; }
    };
    let (first, second) = region_split_static(pages, 1024);
    let pool = region_pool_lock(&connections);
    match region_pool_grow(pool, first) {
        RegionGrow(Node)::Grown => {}
        RegionGrow(Node)::TooSmall(back) => { region_release(back); }
    }
    let mut allocated: usize = 0;
    let mut full: bool = false;
    let mut last: usize = 0;
    while (full == false) {
        match region_alloc(pool) {
            RegionAlloc(Node)::Full => { full = true; }
            RegionAlloc(Node)::Allocated(slot) => {
                allocated = allocated + 1;
                region_slot_at(slot).key = allocated;
                let mut h: RegionHandle(Node) = region_give(pool, slot);
            }
        }
    }
    uart_puts("pool: ");
    uart_print(allocated);
    uart_puts(" slots in one chunk\n");
    match region_pool_grow(pool, second) {             // a second chunk
        RegionGrow(Node)::Grown => {}
        RegionGrow(Node)::TooSmall(back) => { region_release(back); }
    }
    match region_alloc(pool) {
        RegionAlloc(Node)::Full => { uart_puts("pool: still full\n"); }
        RegionAlloc(Node)::Allocated(slot) => {
            uart_puts("pool: grew\n");
            region_free(pool, slot);
        }
    }
    match region_pool_shrink(pool) {                    // the empty chunk
        RegionShrink(Node)::Nothing => { uart_puts("pool: nothing to give back\n"); }
        RegionShrink(Node)::Chunk(bytes) => {
            uart_puts("pool: gave back ");
            uart_print(region_count(bytes));
            uart_puts(" bytes\n");
            region_release(bytes);
        }
    }
    region_pool_unlock(pool);
}

fn app_main() {
    test_region();
    test_table();
    test_locked_table();
    test_pool();
}
