// GitHub issue #672: the built-in region (compiled with --regions).
// A region(T)[b, n] is the right to touch n elements of type T, the first
// at static position b. It is never copied: it is split into two adjacent
// regions and merged back. Counts are element counts; no byte sizes appear.
// What must not compile is in test/test_takibi.ml, "built-in region".

struct Node { key: usize; value: usize; }

const NODE_COUNT: usize = 64;

// The axiom: a declared array becomes one region of its own element type
// and length, once.
private let mut region_arena: [Node; NODE_COUNT];

// A count known only at run time.
private let mut region_wanted: usize = 10;

fn test_region() {
    let RegionOf(Node)::Taken(nodes) = region_of(region_arena) else {
        RegionOf(Node)::Gone => { uart_puts("arena: already taken\n"); return; }
    };                                          // region(Node)[b, 64]

    // A split whose point is a constant within the count: proved at
    // compile time, so there is no failure branch to write.
    let (first, rest) = region_split_static(nodes, 3);
                                                // first: region(Node)[b, 3]
                                                // rest:  region(Node)[b + 3, 61]
    region_at(first, 0).key = 7;                // index checked against 3
    region_at(first, 2).key = 9;                // at compile time

    // A split whose point is only known at run time: the region comes back
    // whole when it does not fit. No trap.
    match region_split(rest, region_wanted) {
        RegionSplit(Node)::TooShort(whole) => {
            uart_puts("too many\n");
            region_release(region_merge(first, whole));
        }
        RegionSplit(Node)::Split(parts) => {
            let (taken, left) = parts;          // taken: region(Node)[b + 3, k]
            uart_puts("taken: ");
            uart_print(region_count(taken));
            uart_puts(", keys: ");
            uart_print(region_at(first, 0).key + region_at(first, 2).key);
            uart_puts("\n");
            let back = region_merge(taken, left);   // region(Node)[b + 3, 61]
            let all = region_merge(first, back);    // region(Node)[b, 64]
            uart_puts("arena: ");
            uart_print(region_count(all));
            uart_puts(" nodes whole again\n");
            region_release(all);
        }
    }
}

// A fixed pool: a table holds every slot's permission. Allocating hands a
// slot's region out; giving it back stores it and returns a handle a program
// may keep anywhere; taking by handle hands it out again, unless the slot was
// freed since, which no stored handle can outlive.
private let mut pool_arena: [Node; 4];

fn test_table() {
    let RegionTableOf(Node)::Taken(pool) = region_table_of(pool_arena) else {
        RegionTableOf(Node)::Gone => { uart_puts("pool: already taken\n"); return; }
    };
    match region_alloc(pool) {
        RegionAlloc(Node)::Full => { uart_puts("pool: full\n"); }
        RegionAlloc(Node)::Allocated(slot) => {
            region_slot_record(slot).key = 42;
            let mut handle: RegionHandle(Node) = region_give(pool, slot);
            match region_take(pool, handle) {
                RegionTake(Node)::Stale => { uart_puts("pool: stale\n"); }
                RegionTake(Node)::Taken(again) => {
                    uart_puts("pool: key ");
                    uart_print(region_slot_record(again).key);
                    uart_puts("\n");
                    region_free(pool, again);
                }
            }
            match region_take(pool, handle) {           // freed since
                RegionTake(Node)::Stale => { uart_puts("pool: old handle refused\n"); }
                RegionTake(Node)::Taken(wrong) => {
                    uart_puts("pool: old handle accepted\n");
                    region_free(pool, wrong);
                }
            }
        }
    }
    region_table_keep(pool);
}

// A guarded table: every use of the table is under its lock, taken by
// region_table_lock and given back by region_table_unlock. A slot taken out
// under one lock is the program's until it is given back, under any later
// lock of the same array: the slot outlives the lock, the lock does not have
// to be held while the element is used.
private let mut shared_arena: [Node; 4];

fn test_locked_table() {
    let pool = region_table_lock(shared_arena);
    match region_alloc(pool) {
        RegionAlloc(Node)::Full => {
            uart_puts("shared: full\n");
            region_table_unlock(pool);
        }
        RegionAlloc(Node)::Allocated(slot) => {
            region_table_unlock(pool);              // the lock is released here
            region_slot_record(slot).key = 5;           // the slot is still ours
            let again = region_table_lock(shared_arena);
            let mut handle: RegionHandle(Node) = region_give(again, slot);
            region_table_unlock(again);
            uart_puts("shared: given back under a second lock\n");
        }
    }
}

// A pool that grows: no fixed capacity. It takes chunks as byte regions --
// here from an array standing in for the page allocator -- and gives a chunk
// whose slots are all free back as a byte region.
private let mut connections: RegionPool(Node);
private let mut page_arena: [u8; 2048];

// Observe the allocator's real headers under the same guard as its callers.
fn print_pool_space(pool: borrow RegionPoolGuard(Node)[identity]) {
    let (chunks, capacity, live, bytes) = region_pool_space_stats(pool);
    uart_puts("space: chunks="); uart_print(chunks);
    uart_puts(" capacity="); uart_print(capacity);
    uart_puts(" nonfree="); uart_print(live);
    uart_puts(" bytes="); uart_print(bytes);
    uart_puts("\n");
}

fn test_pool() {
    let RegionOf(u8)::Taken(pages) = region_of(page_arena) else {
        RegionOf(u8)::Gone => { uart_puts("pages: already taken\n"); return; }
    };
    let (first, second) = region_split_static(pages, 1024);
    let pool = region_pool_lock(&connections);
    print_pool_space(pool);
    match region_pool_grow(pool, first) {
        RegionGrow(Node)::Grown => {}
        RegionGrow(Node)::TooSmall(back) => { region_release(back); }
    }
    let mut allocated: usize = 0;
    let mut full: bool = false;
    let mut last: usize = 0;
    while (full == false) {
        match region_alloc(pool) {
            RegionPoolAlloc(Node)::Exhausted => { full = true; uart_puts("pool: exhausted unexpectedly\n"); }
            RegionPoolAlloc(Node)::Full => { full = true; }
            RegionPoolAlloc(Node)::Allocated(slot) => {
                allocated = allocated + 1;
                region_slot_record(slot).key = allocated;
                let mut h: RegionHandle(Node) = region_give(pool, slot);
            }
        }
    }
    uart_puts("pool: ");
    uart_print(allocated);
    uart_puts(" slots in one chunk\n");
    print_pool_space(pool);
    match region_pool_grow(pool, second) {             // a second chunk
        RegionGrow(Node)::Grown => {}
        RegionGrow(Node)::TooSmall(back) => { region_release(back); }
    }
    print_pool_space(pool);
    match region_alloc(pool) {
        RegionPoolAlloc(Node)::Exhausted => { uart_puts("pool: exhausted unexpectedly\n"); }
        RegionPoolAlloc(Node)::Full => { uart_puts("pool: still full\n"); }
        RegionPoolAlloc(Node)::Allocated(slot) => {
            uart_puts("pool: grew\n");
            region_free(pool, slot);
        }
    }
    match region_pool_shrink(pool) {                    // the empty chunk
        RegionShrink(Node)::Nothing => { uart_puts("pool: nothing to give back\n"); }
        RegionShrink(Node)::Chunk(bytes) => {
            uart_puts("pool: gave back ");
            uart_print(region_count(bytes));
            uart_puts(" bytes\n");
            region_release(bytes);
        }
    }
    print_pool_space(pool);
    region_pool_unlock(pool);
}

// Pins: a Live object reached by handle from several holders at once. It
// is never freed while pinned; retiring it stops new pins, and whoever
// drops the last pin receives the slot to free.
private let mut shared_objects: RegionPool(Node);
private let mut shared_pages: [u8; 1024];

fn test_pins() {
    let RegionOf(u8)::Taken(pages) = region_of(shared_pages) else {
        RegionOf(u8)::Gone => { uart_puts("pins: pages taken\n"); return; }
    };
    let pool = region_pool_lock(&shared_objects);
    match region_pool_grow(pool, pages) {
        RegionGrow(Node)::Grown => {}
        RegionGrow(Node)::TooSmall(back) => { region_release(back); }
    }
    let RegionPoolAlloc(Node)::Allocated(slot) = region_alloc(pool) else {
        RegionPoolAlloc(Node)::Exhausted => { region_pool_unlock(pool); uart_puts("pool: exhausted unexpectedly\n"); return; }
        RegionPoolAlloc(Node)::Full => { region_pool_unlock(pool); return; }
    };
    region_slot_record(slot).key = 9;
    print_pool_space(pool);
    let mut h: RegionHandle(Node) = region_give(pool, slot);
    let RegionPinned(Node)::Pinned(first) = region_pin(pool, h) else {
        RegionPinned(Node)::Stale => { region_pool_unlock(pool); return; }
    };
    let RegionPinned(Node)::Pinned(second) = region_pin(pool, h) else {
        RegionPinned(Node)::Stale => {
            region_pool_unlock(pool);
            match region_unpin(first) {
                RegionUnpin(Node)::Unpinned => {}
                RegionUnpin(Node)::Last(lost) => { region_slot_abandon(lost); }
            }
            return;
        }
    };
    // The two numbers a kernel table keeps name the same slot again.
    let address: usize = region_pin_address(first);
    let generation: usize = region_pin_generation(first);
    let mut again: RegionHandle(Node) = region_handle_from(pool, address, generation);
    match region_pin(pool, again) {
        RegionPinned(Node)::Stale => { uart_puts("pins: by address refused\n"); }
        RegionPinned(Node)::Pinned(third) => {
            uart_puts("pins: by address and generation\n");
            match region_unpin(third) {
                RegionUnpin(Node)::Unpinned => {}
                RegionUnpin(Node)::Last(lost) => { region_slot_abandon(lost); }
            }
        }
    }
    let mut misdated: RegionHandle(Node) = region_handle_from(pool, address, generation + 1);
    match region_pin(pool, misdated) {
        RegionPinned(Node)::Stale => { uart_puts("pins: wrong generation refused\n"); }
        RegionPinned(Node)::Pinned(bad) => {
            uart_puts("pins: wrong generation accepted\n");
            match region_unpin(bad) {
                RegionUnpin(Node)::Unpinned => {}
                RegionUnpin(Node)::Last(lost) => { region_slot_abandon(lost); }
            }
        }
    }
    let mut current: RegionHandle(Node) = region_handle_current(pool, address);
    if (region_handle_generation(current) == generation &&
        region_handle_address(current) == address) {
        uart_puts("pins: current handle matches\n");
    }
    let mut walked: usize = 0;
    let mut cursor: RegionHandle(Node) = region_handle_from(pool, 0, 0);
    let mut walking: bool = true;
    while (walking) {
        match region_pool_next(pool, cursor) {
            RegionNext(Node)::End => { walking = false; }
            RegionNext(Node)::Next(found) => { walked = walked + 1; cursor = found; }
        }
    }
    uart_puts("pins: walk finds ");
    uart_print(walked);
    uart_puts("\n");
    uart_puts("pins: two holders see key ");
    uart_print(region_pin_record(first).key + region_pin_record(second).key - 9);
    uart_puts("\n");
    match region_take(pool, h) {                       // in use: refused
        RegionTake(Node)::Stale => { uart_puts("pins: take refused while pinned\n"); }
        RegionTake(Node)::Taken(wrong) => {
            uart_puts("pins: take accepted while pinned\n");
            region_free(pool, wrong);
        }
    }
    match region_retire(first) {
        RegionRetire(Node)::Retired(early) => {
            uart_puts("pins: retired with a pin left\n");
            region_free(pool, early);
        }
        RegionRetire(Node)::Pending => { uart_puts("pins: retire waits for the other pin\n"); }
    }
    print_pool_space(pool);
    match region_pin(pool, h) {                         // retired: no new pins
        RegionPinned(Node)::Stale => { uart_puts("pins: new pin refused after retire\n"); }
        RegionPinned(Node)::Pinned(late) => {
            uart_puts("pins: new pin accepted after retire\n");
            match region_unpin(late) {
                RegionUnpin(Node)::Unpinned => {}
                RegionUnpin(Node)::Last(lost) => { region_slot_abandon(lost); }
            }
        }
    }
    match region_unpin(second) {
        RegionUnpin(Node)::Unpinned => { uart_puts("pins: last unpin got nothing\n"); }
        RegionUnpin(Node)::Last(freed) => {
            uart_puts("pins: last unpin frees it\n");
            region_free(pool, freed);
        }
    }
    uart_puts("pins: live ");
    uart_print(region_pool_live_count(pool));
    uart_puts("\n");
    print_pool_space(pool);
    match region_pool_shrink(pool) {
        RegionShrink(Node)::Nothing => { uart_puts("space: final shrink missing\n"); }
        RegionShrink(Node)::Chunk(bytes) => { region_release(bytes); }
    }
    print_pool_space(pool);
    region_pool_unlock(pool);
}

// Native allocator lifetime regressions: the same exclusive page is returned
// and reclaimed, never simultaneously owned by two regions or pools.
struct PoolCounterInjection { words: [usize; 3]; }
struct RecyclingPage align(64) { bytes: [u8; 4096]; }
private let mut recycling_page: RecyclingPage;
private let mut recycling_pool: RegionPool(Node);
private let mut exhaustion_pool: RegionPool(Node);

fn test_chunk_regrow() !{unsafe} {
    static_assert(sizeof(RegionPool(Node)) == 24, "one durable generation word per pool");
    static_assert(sizeof(RegionReleaseSlot(Node)[p, k]) == 8, "release ownership adds no word");
    let address: usize = &recycling_page.bytes[0] as usize;
    let guard = region_pool_lock(&recycling_pool);
    let mut previous_address: usize = 0;
    let mut previous_generation: usize = 0;
    for cycle: usize in 0..<4 {
        let RegionBytes::Assumed(bytes) = region_bytes_assume(address, 4096) else {};
        match region_pool_grow(guard, bytes) {
            RegionGrow(Node)::TooSmall(back) => {
                region_release(back); region_pool_unlock(guard);
                uart_puts("regrow: growth failed\n"); return;
            }
            RegionGrow(Node)::Grown => {}
        }
        let RegionPoolAlloc(Node)::Allocated(slot) = region_alloc(guard) else {
            RegionPoolAlloc(Node)::Full => { region_pool_unlock(guard); uart_puts("regrow: full\n"); return; }
            RegionPoolAlloc(Node)::Exhausted => { region_pool_unlock(guard); uart_puts("regrow: exhausted\n"); return; }
        };
        let mut handle: RegionHandle(Node) = region_give(guard, slot);
        let current_address: usize = region_handle_address(handle);
        let current_generation: usize = region_handle_generation(handle);
        if (cycle != 0) {
            let mut old: RegionHandle(Node) = region_handle_from(guard, previous_address, previous_generation);
            match region_take(guard, old) {
                RegionTake(Node)::Stale => {}
                RegionTake(Node)::Taken(wrong) => {
                    region_free(guard, wrong); region_pool_unlock(guard);
                    uart_puts("regrow: old take accepted\n"); return;
                }
            }
            match region_pin(guard, old) {
                RegionPinned(Node)::Stale => {}
                RegionPinned(Node)::Pinned(wrong) => {
                    match region_unpin(wrong) {
                        RegionUnpin(Node)::Unpinned => {}
                        RegionUnpin(Node)::Last(lost) => { region_slot_abandon(lost); }
                    }
                    region_pool_unlock(guard); uart_puts("regrow: old pin accepted\n"); return;
                }
            }
        }
        if (cycle != 0 && (current_generation <= previous_generation ||
                            current_address != previous_address)) {
            region_pool_unlock(guard); uart_puts("regrow: identity mismatch\n"); return;
        }
        let RegionTake(Node)::Taken(current) = region_take(guard, handle) else {
            RegionTake(Node)::Stale => { region_pool_unlock(guard); uart_puts("regrow: current refused\n"); return; }
        };
        region_free(guard, current);
        let RegionShrink(Node)::Chunk(detached) = region_pool_shrink(guard) else {
            RegionShrink(Node)::Nothing => { region_pool_unlock(guard); uart_puts("regrow: shrink failed\n"); return; }
        };
        if (region_bytes_address(detached) != address || region_count(detached) != 4096) {
            region_release(detached); region_pool_unlock(guard);
            uart_puts("regrow: wrong returned page\n"); return;
        }
        region_release(detached);
        previous_address = current_address;
        previous_generation = current_generation;
    }
    if (region_pool_live_count(guard) != 0) {
        region_pool_unlock(guard); uart_puts("regrow: leaked slot\n"); return;
    }
    region_pool_unlock(guard);
    uart_puts("regrow: four incarnations reject old take and pin\n");
}

fn test_generation_exhaustion() !{unsafe} {
    let guard = region_pool_lock(&exhaustion_pool);
    // Test-only fault injection at the compiler's trusted layout boundary.
    // There are no issued handles or owned slots. Narrow the raw cast to this
    // three-word pool (statically sized above) and a checked index, then put
    // the last-issued counter one allocation before its 46-bit limit.
    static_assert(sizeof(RegionPool(Node)) == 24, "generation injection needs three words");
    let metadata: *PoolCounterInjection = (&exhaustion_pool) as *PoolCounterInjection;
    metadata.words[2] = 0x3ffffffffffe;
    match region_alloc(guard) {
        RegionPoolAlloc(Node)::Full => {}
        RegionPoolAlloc(Node)::Exhausted => { region_pool_unlock(guard); uart_puts("exhaustion: full burned a stamp\n"); return; }
        RegionPoolAlloc(Node)::Allocated(wrong) => { region_free(guard, wrong); region_pool_unlock(guard); uart_puts("exhaustion: unexpected slot\n"); return; }
    }
    let address: usize = &recycling_page.bytes[0] as usize;
    let RegionBytes::Assumed(bytes) = region_bytes_assume(address, 4096) else {};
    match region_pool_grow(guard, bytes) {
        RegionGrow(Node)::TooSmall(back) => { region_release(back); region_pool_unlock(guard); uart_puts("exhaustion: growth failed\n"); return; }
        RegionGrow(Node)::Grown => {}
    }
    let RegionPoolAlloc(Node)::Allocated(slot) = region_alloc(guard) else {
        RegionPoolAlloc(Node)::Full => { region_pool_unlock(guard); uart_puts("exhaustion: full early\n"); return; }
        RegionPoolAlloc(Node)::Exhausted => { region_pool_unlock(guard); uart_puts("exhaustion: refused final stamp\n"); return; }
    };
    let mut handle: RegionHandle(Node) = region_give(guard, slot);
    if (region_handle_generation(handle) != 0x3fffffffffff) {
        region_pool_unlock(guard); uart_puts("exhaustion: wrong final stamp\n"); return;
    }
    let RegionPinned(Node)::Pinned(pin) = region_pin(guard, handle) else {
        RegionPinned(Node)::Stale => { region_pool_unlock(guard); uart_puts("exhaustion: final pin refused\n"); return; }
    };
    let RegionRetire(Node)::Retired(dead) = region_retire(pin) else {
        RegionRetire(Node)::Pending => { region_pool_unlock(guard); uart_puts("exhaustion: single pin pending\n"); return; }
    };
    match region_take(guard, handle) {
        RegionTake(Node)::Stale => {}
        RegionTake(Node)::Taken(wrong) => { region_free(guard, wrong); region_slot_abandon(dead); region_pool_unlock(guard); uart_puts("exhaustion: retired handle accepted\n"); return; }
    }
    region_free(guard, dead);
    let RegionShrink(Node)::Chunk(detached) = region_pool_shrink(guard) else {
        RegionShrink(Node)::Nothing => { region_pool_unlock(guard); uart_puts("exhaustion: shrink failed\n"); return; }
    };
    match region_pool_grow(guard, detached) {
        RegionGrow(Node)::TooSmall(back) => { region_release(back); region_pool_unlock(guard); uart_puts("exhaustion: regrow failed\n"); return; }
        RegionGrow(Node)::Grown => {}
    }
    for attempt: usize in 0..<2 {
        match region_alloc(guard) {
            RegionPoolAlloc(Node)::Exhausted => {}
            RegionPoolAlloc(Node)::Full => { region_pool_unlock(guard); uart_puts("exhaustion: reported full\n"); return; }
            RegionPoolAlloc(Node)::Allocated(wrong) => { region_free(guard, wrong); region_pool_unlock(guard); uart_puts("exhaustion: wrapped\n"); return; }
        }
    }
    let RegionShrink(Node)::Chunk(last) = region_pool_shrink(guard) else {
        RegionShrink(Node)::Nothing => { region_pool_unlock(guard); uart_puts("exhaustion: leaked slot\n"); return; }
    };
    region_release(last);
    region_pool_unlock(guard);
    uart_puts("exhaustion: final stamp retires safely and regrow stays exhausted\n");
}

fn app_main() {
    test_region();
    test_table();
    test_locked_table();
    test_pool();
    test_pins();
    test_chunk_regrow();
    test_generation_exhaustion();
}
