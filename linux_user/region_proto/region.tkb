// GitHub issue #637, fundamental-option prototype: memory as linear
// permissions. A `Region[base, len]` is the right to touch `len` bytes at
// `base`. It cannot be copied; it can only be split into two adjacent
// regions and merged back, and a pointer into it is derived from a borrow of
// it, so the pointer dies with the region. The only place a region comes from
// nothing is region_arena_take (the axiom); everything above it -- the
// allocator below included -- is checked by the compiler.

struct Node { key: usize; value: usize; }
const NODE_BYTES: usize = 16;

linear struct Region[base: usize, len: usize] {
    private address: usize;
    private size: usize;
}

private fn region_drop(r: sink Region[b, l]) {}

// The axiom. One arena, handed out once; a second take finds it gone.
private let mut region_arena: [Node; 64];
private let mut region_arena_taken: bool;

must_use variant ArenaTake {
    Gone;
    Taken(exists b: usize. Region[b, 1024]);
}

fn region_arena_take() -> ArenaTake !{unsafe} {
    if (region_arena_taken) { return ArenaTake::Gone; }
    region_arena_taken = true;
    let address: usize = (region_arena as *Node) as usize;
    return ArenaTake::Taken(region_mint(address));
}

private fn region_mint(address: usize @ b) -> Region[b, 1024] {
    let mut r: Region[b, 1024] = { address, 1024 };
    return r;
}

fn region_arena_give(r: sink Region[b, 1024]) { region_drop(r); }

// Split off the first `n` bytes. The arithmetic of the two results is the
// compiler's: their bases and lengths are terms in b, l and k, and only a
// merge whose terms add up again is accepted.
must_use variant RegionSplit[b: usize, l: usize, k: usize] {
    TooShort(Region[b, l]);
    Split((Region[b, k], Region[b + k, l - k]));
}

fn region_split(r: sink Region[b, l], n: usize @ k) -> RegionSplit[b, l, k] {
    if (n > r.size) { return RegionSplit::TooShort(r); }
    let mut head: Region[b, k] = { r.address, n };
    let mut tail: Region[b + k, l - k] = { r.address + n, r.size - n };
    region_drop(r);
    return RegionSplit::Split((head, tail));
}

fn region_merge(head: sink Region[b, k], tail: sink Region[b + k, m])
        -> Region[b, k + m] {
    let mut whole: Region[b, k + m] = { head.address, head.size + tail.size };
    region_drop(head);
    region_drop(tail);
    return whole;
}

// A Node is reached only through a region exactly one Node long, and the
// pointer is tied to the borrow: it cannot outlive the region.
fn region_node(r: borrow Region[b, 16]) -> *Node @ b !{unsafe} {
    return unsafe { r.address as *Node };
}
