use "kernel/lib/byte_slice.tkb";

let mut subject_calls: usize = 0;

fn print_split(value: borrow []const u8, delimiter: u8) {
    match byte_slice_find_first(value, delimiter) {
        ByteSliceFindResult::Absent => { uart_puts("absent"); }
        ByteSliceFindResult::Found(position) => {
            if (position < value.len) {
                let after_start: usize = position + 1;
                if (after_start <= value.len) {
                    let before = value[0..<position];
                    let after = value[after_start..<value.len];
                    uart_print(before.len);
                    uart_puts(":");
                    uart_print(after.len);
                }
            }
        }
    }
}

fn print_retained_split(value: []const u8, delimiter: u8) {
    match byte_slice_split_first(value, delimiter) {
        ByteSliceSplitResult::Absent => { uart_puts("absent"); }
        ByteSliceSplitResult::Found(split) => {
            uart_print(split.before.len);
            uart_puts(":");
            uart_print(split.after.len);
        }
    }
}

fn classify(value: []const u8) -> i32 {
    match value {
        bs"" => { return 0; }
        bs"stat" => { return 1; }
        bs"A\0B" => { return 2; }
        _ => { return 3; }
    }
}

fn one_subject() -> []const u8 {
    subject_calls = subject_calls + 1;
    return bs"cmdline";
}

// Independent generated inputs: each one-byte mutation has a known nonzero
// byte, and slice_eq checks it against a separately initialized zero array.
// The production predicate is called directly, not copied into this fixture.
fn zero_predicate_probe() -> bool {
    let mut subject: [u8; 4096];
    let mut reference: [u8; 4096];
    for position: usize in 0..<4096 {
        subject[position] = 0;
        reference[position] = 0;
    }
    if (byte_slice_is_zero(subject as []const u8) == false ||
        slice_eq(subject as []const u8, reference as []const u8) == false) {
        return false;
    }
    for position: usize in 0..<4096 {
        for value: usize in 1..<256 {
            subject[position] = value as u8;
            if (byte_slice_is_zero(subject as []const u8) ||
                slice_eq(subject as []const u8, reference as []const u8)) {
                return false;
            }
        }
        let after: usize = position + 1;
        if (after <= 4096) {
            if (byte_slice_is_zero(subject[0..<position]) == false ||
                byte_slice_is_zero(subject[0..<after]) ||
                byte_slice_is_zero(subject[position..<4096]) ||
                byte_slice_is_zero(subject[after..<4096]) == false) {
                return false;
            }
        }
        subject[position] = 0;
    }
    for boundary: usize in 0..<4097 {
        if (boundary <= 4096) {
            if (byte_slice_is_zero(subject[0..<boundary]) == false ||
                byte_slice_is_zero(subject[boundary..<4096]) == false) {
                return false;
            }
        }
    }
    return byte_slice_is_zero(bs"");
}

fn app_main() {
    uart_puts("equal=");
    uart_print(slice_eq(bs"proc", bs"proc"));
    uart_puts(" unequal=");
    uart_print(slice_eq(bs"proc", bs"stat"));
    uart_puts(" empty=");
    uart_print(slice_eq(bs"", bs""));

    uart_puts(" split-middle=");
    print_retained_split(bs"proc/7", 0x2F);
    uart_puts(" split-zero=");
    print_retained_split(bs"/proc", 0x2F);
    uart_puts(" split-last=");
    print_retained_split(bs"proc/", 0x2F);
    uart_puts(" split-absent=");
    print_retained_split(bs"proc", 0x2F);

    let mut embedded: [u8; 3] = { 0x41, 0, 0x42 };
    uart_puts(" embedded-nul=");
    uart_print(slice_eq(embedded as []const u8, embedded as []const u8));
    uart_puts(" nul-split=");
    print_split(embedded as []const u8, 0);
    uart_puts(" match=");
    uart_print(classify(bs"stat"));
    uart_puts(":");
    uart_print(classify(bs"status"));
    uart_puts(":");
    uart_print(classify(bs"stay"));
    uart_puts(":");
    uart_print(classify(bs""));
    uart_puts(":");
    uart_print(classify(bs"A\0B"));
    uart_puts(" once=");
    match one_subject() {
        bs"stat" => { uart_puts("stat"); }
        bs"cmdline" => { uart_puts("cmdline"); }
        _ => { uart_puts("other"); }
    }
    uart_puts(":");
    uart_print(subject_calls);
    uart_puts("\nzero predicate exhaustive=");
    uart_print(zero_predicate_probe());
    uart_puts("\n");
}
