// Whole-record reference load/store is executed independently of pool mints.
fn reference_record_copy(source: borrow &LoanRecord) -> LoanRecord { return *source; }
fn reference_record_assign(target: borrow &mut LoanRecord, source: borrow &LoanRecord) {
    *target = *source;
}
fn reference_record_copy_probe() -> usize {
    let mut source: LoanRecord = { 7, 11, { 13, 17 } };
    let mut target: LoanRecord;
    reference_record_assign(&target, &source);
    let mut copied: LoanRecord = reference_record_copy(&target);
    return copied.generation + copied.value + copied.words[0] + copied.words[1];
}

// Exercise addressable nested/array places through mutable references, then
// read them through a shared reference. Rejected writes are compiler tests.
struct ReferencePlaceInner { value: usize; }
struct ReferencePlaceOuter {
    inner: ReferencePlaceInner;
    items: [ReferencePlaceInner; 2];
}
fn reference_place_read(source: borrow &ReferencePlaceOuter) -> usize {
    let inner: &ReferencePlaceInner = &(*source).inner;
    return inner.value + source.items[0].value;
}
fn reference_place_write(target: borrow &mut ReferencePlaceOuter) -> usize {
    let inner: &mut ReferencePlaceInner = &(*target).inner;
    inner.value = 19;
    let item: &mut ReferencePlaceInner = &target.items[0];
    item.value = 23;
    return reference_place_read(target);
}
fn reference_place_probe() -> usize {
    let mut value: ReferencePlaceOuter;
    return reference_place_write(&value);
}

// Execute positive record-loan cases with the compiler's destructive contracts.
// Negative lifetime and alias cases belong to the in-process compiler suite.
fn app_main() {
    uart_println(phase_demo_failure() as u64);
    uart_println(phase_demo_rollback() as u64);
    uart_println(phase_demo_install(false) as u64);
    uart_println(phase_demo_install(true) as u64);
    uart_println(loan_transferred_after_pool_release() as u64);
    uart_println(loan_transferred_through_accessor() as u64);
    loan_fixture_reset();
    let mut live: LoanHandle = loan_fixture_handle(0, 7);
    uart_println(loan_three_paths(live) as u64);
    uart_println(loan_three_paths(loan_fixture_handle(0, 7)) as u64);
    loan_fixture_reset();
    uart_println(loan_owner_without_guard(loan_fixture_handle(0, 7)) as u64);
    uart_println(loan_running_without_guard(loan_fixture_handle(0, 7)) as u64);
    uart_println(loan_copy_before_removal(loan_fixture_handle(0, 7)) as u64);
    loan_fixture_reset();
    uart_println(loan_distinct_records() as u64);
    uart_println(loan_reference_field_index() as u64);
    uart_println(reference_record_copy_probe() as u64);
    uart_println(reference_place_probe() as u64);
}
