// Single-threaded executable controls for the three ProcessRecord authority
// shapes. Guard mints and Running-state selection are trusted fixture code;
// this checks storage/erasure behavior, not kernel synchronization or timing.
struct LoanRecord { generation: usize; value: usize; words: [usize; 2]; }
struct LoanHandle { slot: {0..<2 as usize}; generation: usize; }
linear view LoanRunGuard[lock: addr];
linear struct LoanOwner[g: usize] {
    private slot: {0..<2 as usize}; private generation: usize @ g;
}
linear struct LoanRunning[s: usize] {
    private slot: {0..<2 as usize} @ s; private generation: usize;
}
must_use variant LoanOwnerLookup { Stale; Found(exists g: usize. LoanOwner[g]); }
private let mut loan_records: [LoanRecord; 2];
private let mut loan_lock_word: usize;
fn loan_acquire(word: *usize @ lock) -> LoanRunGuard[lock] { return view LoanRunGuard[lock]; }
fn loan_release(guard: sink LoanRunGuard[lock]) {}
private fn loan_mint_owner(slot: {0..<2 as usize}, generation: usize @ g) -> LoanOwner[g] {
    let mut owner: LoanOwner[g] = { slot, generation }; return owner;
}
private fn loan_mint_running(slot: {0..<2 as usize} @ s, generation: usize) -> LoanRunning[s] {
    let mut running: LoanRunning[s] = { slot, generation }; return running;
}
fn loan_lookup(guard: borrow LoanRunGuard[lock], handle: LoanHandle) -> LoanOwnerLookup {
    if (loan_records[handle.slot].generation != handle.generation) { return LoanOwnerLookup::Stale; }
    return LoanOwnerLookup::Found(loan_mint_owner(handle.slot, handle.generation));
}
fn loan_locked(guard: borrow LoanRunGuard[lock], handle: LoanHandle) -> &mut LoanRecord @ lock {
    return &loan_records[handle.slot];
}
fn loan_owned(owner: borrow LoanOwner[g]) -> &mut LoanRecord @ g { return &loan_records[owner.slot]; }
fn loan_running_record(running: borrow LoanRunning[s]) -> &mut LoanRecord @ s {
    return &loan_records[running.slot];
}
fn loan_remove_slot(guard: borrow LoanRunGuard[lock], slot: {0..<2 as usize}) !{record_mutates_LoanRunGuard} {
    loan_records[slot].generation = 0;
}
fn loan_owner_end(owner: sink LoanOwner[g]) {}
fn loan_running_end(running: sink LoanRunning[s]) {}
fn loan_remove(guard: borrow LoanRunGuard[lock], owner: sink LoanOwner[g]) !{record_mutates_LoanOwner} {
    loan_records[owner.slot].generation = 0;
}

fn loan_fixture_reset() {
    loan_records[0].generation = 7; loan_records[0].value = 40;
    loan_records[1].generation = 8; loan_records[1].value = 80;
}
fn loan_fixture_handle(slot: {0..<2 as usize}, generation: usize) -> LoanHandle {
    let mut handle: LoanHandle = { slot, generation }; return handle;
}
fn loan_three_paths(handle: LoanHandle) -> usize {
    let guard = loan_acquire(&loan_lock_word);
    let LoanOwnerLookup::Found(owner) = loan_lookup(guard, handle) else {
        LoanOwnerLookup::Stale => { loan_release(guard); return 0; }
    };
    let running = loan_mint_running(handle.slot, handle.generation);
    let mut value: usize = 0;
    { let ptr = loan_locked(guard, handle); value = value + ptr.value; }
    { let ptr = loan_owned(owner); value = value + ptr.value; }
    { let ptr = loan_running_record(running); value = value + ptr.value; }
    loan_running_end(running);
    loan_remove(guard, owner); loan_release(guard); return value;
}
fn loan_owner_without_guard(handle: LoanHandle) -> usize {
    let guard = loan_acquire(&loan_lock_word);
    let LoanOwnerLookup::Found(owner) = loan_lookup(guard, handle) else {
        LoanOwnerLookup::Stale => { loan_release(guard); return 0; }
    };
    loan_release(guard);
    let mut value: usize = 0;
    { let ptr = loan_owned(owner); value = ptr.value; }
    loan_owner_end(owner); return value;
}
fn loan_running_without_guard(handle: LoanHandle) -> usize {
    let running = loan_mint_running(handle.slot, handle.generation);
    let mut value: usize = 0;
    { let ptr = loan_running_record(running); value = ptr.value; }
    loan_running_end(running); return value;
}
fn loan_copy_before_removal(handle: LoanHandle) -> usize {
    let guard = loan_acquire(&loan_lock_word);
    let value = loan_locked(guard, handle).value;
    loan_remove_slot(guard, handle.slot); loan_release(guard); return value;
}
fn loan_distinct_records() -> usize {
    let guard = loan_acquire(&loan_lock_word);
    let a = loan_mint_owner(0, 7); let b = loan_mint_owner(1, 8);
    let mut value: usize = 0;
    { let ptr = loan_owned(a); loan_remove(guard, b); value = ptr.value; }
    loan_owner_end(a); loan_release(guard); return value;
}

// Private transfer boundary fixture with independent lifetime authorities.
struct TransferRecord { value: usize; }
linear view PoolLive[g: usize];
linear view Running[g: usize];
private let mut record: TransferRecord;
private inline fn live_new(generation: usize @ g) -> PoolLive[g] { return view PoolLive[g]; }
private inline fn running_new(generation: usize @ g) -> Running[g] { return view Running[g]; }
inline fn live_end(live: sink PoolLive[g]) {}
inline fn running_end(running: sink Running[g]) {}
private inline fn payload(live: borrow PoolLive[g]) -> &mut TransferRecord @ g { return &record; }
private inline fn transfer(source: borrow PoolLive[g], destination: borrow Running[g]) -> &mut TransferRecord @ g !{loan_transfer} {
    return payload(source);
}
fn loan_transferred_after_pool_release() -> usize {
    record.value = 120;
    let live = live_new(1); let running = running_new(1);
    let mut value: usize = 0;
    { let ptr = transfer(live, running); live_end(live); ptr.value = ptr.value + 1; value = ptr.value; }
    running_end(running); return value;
}

// The real caller shape returns the transferred loan after releasing the
// source inside the accessor. Only the existing Running authority survives.
private inline fn transferred_running_record(running: borrow Running[g],
                                              generation: usize @ g)
        -> &mut TransferRecord @ g {
    let live = live_new(generation);
    let ptr = transfer(live, running);
    live_end(live);
    return ptr;
}
fn loan_transferred_through_accessor() -> usize {
    let running = running_new(1);
    let mut value: usize = 0;
    { let ptr = transferred_running_record(running, 1);
      ptr.value = ptr.value + 1; value = ptr.value; }
    running_end(running); return value;
}

// Exercise a reference-return consumer's checked field indexing and raw widening.
fn loan_reference_field_index() -> usize {
    let owner = loan_mint_owner(0, 7);
    let mut value: usize = 0;
    {
        let record = loan_owned(owner);
        record.words[0] = 19; record.words[1] = 23;
        let words = record.words as [usize; 2..];
        let raw = record as *LoanRecord;
        raw.value = words[0] + words[1];
        value = raw.value;
    }
    loan_owner_end(owner);
    return value;
}
