// GitHub issue #372: a slice minted from an array-typed struct FIELD, not
// from a variable binding.
//
// The motivating shape is issue #257's NetFrame: a pooled buffer is only
// ever reached as a `*T` handed back by the pool, so its bytes live in a
// field and there is no variable to name them. Every consumer in
// kernel/net/ takes a slice, so without this the whole pool-of-buffers
// split needs `unsafe` for a length the field's own declaration already
// states.
//
// Type-checking is covered in test/test_takibi.ml; what needs EXECUTING is
// whether the fat value points at the right storage. The three shapes take
// three different paths through llvm_gen's gen_field_access, and the way
// each of them fails is by addressing the containing struct rather than
// the field, or the array's element 0 rather than element i -- both of
// which type-check perfectly and both of which this file would catch as
// wrong bytes.

const FRAME_MAX: usize = 64;
const CONN_MAX: usize = 3;

struct NetFrame {
    len: usize;
    bytes: [u8; FRAME_MAX];
}

struct Conn {
    remote_ip: [u8; 4];
    port: u16;
    frame: NetFrame;
}

// Two separate globals rather than an array of frames: `&pool[0]` is not
// a legal place to take an address of today, and what these stand in for
// -- two slots a pool handed out -- is served either way.
let mut frame_a: NetFrame;
let mut frame_b: NetFrame;
let mut conns: [Conn; CONN_MAX];
let mut solo: Conn;
let mut header: [u8; 4];

// The pool case: this function never sees a binding for the buffer, only
// the pointer. `frame.bytes as []u8` is the whole point of the issue.
fn frame_fill(frame: *NetFrame, first: u8, count: {0..<FRAME_MAX + 1 as usize}) {
    let bytes = frame.bytes as []u8;
    for i: usize in 0..<count {
        if (i < FRAME_MAX) {
            let bi: {0..<FRAME_MAX as usize} = i;
            bytes[bi] = (first as usize + i) as u8;
        }
    }
    frame.len = count;
}

// A subslice of a field slice, at an offset -- what a wire builder does to
// a frame it is writing a header into.
fn frame_write_header(frame: *NetFrame, at: {0..<8 as usize}) -> usize {
    let bytes = frame.bytes as []u8;
    return slice_copy(bytes[at..<at + 4], header as []u8);
}

fn frame_byte(frame: *NetFrame, at: {0..<FRAME_MAX as usize}) -> usize {
    let bytes = frame.bytes as []u8;
    return bytes[at] as usize;
}

fn app_main() {
    uart_puts("slice_from_field\n");

    header[0] = 0x45; header[1] = 0x00; header[2] = 0xDE; header[3] = 0xAD;

    // -- Through a pointer, the pooled-payload shape.
    let p0: *NetFrame = &frame_a;
    let p1: *NetFrame = &frame_b;
    frame_fill(p0, 100, 8);
    frame_fill(p1, 200, 8);

    uart_puts("a frame written through *NetFrame reads back its own bytes ");
    uart_puts("(first, last, len): ");
    uart_print(frame_byte(p0, 0));
    uart_puts(" ");
    uart_print(frame_byte(p0, 7));
    uart_puts(" ");
    uart_print(p0.len);
    uart_puts("\n");

    // The second frame must be untouched by the first. A field slice that
    // addressed the containing array's element 0 would make these equal.
    uart_puts("two pooled frames are distinct storage: ");
    uart_print(frame_byte(p0, 0) == 100 && frame_byte(p1, 0) == 200);
    uart_puts("\n");

    let copied: usize = frame_write_header(p0, 2);
    uart_puts("a subslice of a field slice writes at its offset, not at 0 ");
    uart_puts("(copied, [1], [2], [5], [6]): ");
    uart_print(copied);
    uart_puts(" ");
    uart_print(frame_byte(p0, 1));
    uart_puts(" ");
    uart_print(frame_byte(p0, 2));
    uart_puts(" ");
    uart_print(frame_byte(p0, 5));
    uart_puts(" ");
    uart_print(frame_byte(p0, 6));
    uart_puts("\n");

    // -- An array element's field, and a NESTED struct's field one level
    // down. Both are places; neither has a binding of its own.
    for i: usize in 0..<CONN_MAX {
        if (i < CONN_MAX) {
            let ci: {0..<CONN_MAX as usize} = i;
            let ip = conns[ci].remote_ip as []u8;
            for j: usize in 0..<4 {
                if (j < 4) {
                    let cj: {0..<4 as usize} = j;
                    ip[cj] = (10 * i + j) as u8;
                }
            }
            conns[ci].port = (7 + i) as u16;
        }
    }

    let c2: {0..<CONN_MAX as usize} = 2;
    let ip2 = conns[c2].remote_ip as []u8;
    uart_puts("each array element's field is its own storage ");
    uart_puts("(len, conns[2].remote_ip): ");
    uart_print(ip2.len);
    uart_puts(" ");
    for j: usize in 0..<4 {
        if (j < 4) {
            let cj: {0..<4 as usize} = j;
            uart_print(ip2[cj] as usize);
            uart_puts(" ");
        }
    }
    uart_puts("\n");

    let c0: {0..<CONN_MAX as usize} = 0;
    let ip0 = conns[c0].remote_ip as []u8;
    uart_puts("slice_eq over two element fields separates them: ");
    uart_print(slice_eq(ip0[0..<4], ip2[0..<4]) == false &&
                    slice_eq(ip2[0..<4], ip2[0..<4]));
    uart_puts("\n");

    // A field of a field: the nested NetFrame inside a Conn, still with no
    // binding anywhere along the way.
    let ip_solo = solo.remote_ip as []u8;
    ip_solo[0] = 0; ip_solo[1] = 1; ip_solo[2] = 2; ip_solo[3] = 3;
    solo.port = 7;
    frame_fill(&solo.frame, 1, 4);
    let nested = solo.frame.bytes as []u8;
    uart_puts("a field of a field is a place too (len, [0], [3]): ");
    uart_print(nested.len);
    uart_puts(" ");
    uart_print(nested[0] as usize);
    uart_puts(" ");
    uart_print(nested[3] as usize);
    uart_puts("\n");

    // Writing the nested frame must not have touched the sibling field
    // that sits right before it in the struct.
    uart_puts("a sibling field is undisturbed by the nested write: ");
    uart_print(ip_solo[0] == 0 && ip_solo[1] == 1 && ip_solo[2] == 2 &&
                    ip_solo[3] == 3 && solo.port == 7);
    uart_puts("\n");

    // -- The minimum length is the FIELD's declared length, so a [u8; 4..]
    // parameter is satisfied without a runtime check.
    uart_puts("the slice's minimum is the field's own declared length: ");
    uart_print(needs_four(conns[c2].remote_ip as [u8; 4..]) == 20 + 21 + 22 + 23);
    uart_puts("\n");

    uart_puts("done\n");
}

fn needs_four(ip: [u8; 4..]) -> usize {
    return (ip[0] as usize) + (ip[1] as usize) + (ip[2] as usize) +
           (ip[3] as usize);
}
