// GitHub issue #365: the checking lock backend for linux_user.
//
// intrusive_pool's guard (issue #351) makes forgetting the lock a compile
// error. What it cannot see is the two mistakes that only a RUNNING lock
// reveals, and that a real lock reveals by hanging:
//
//   RE-ENTRANCY   taking the same pool's guard twice on one path. Under a
//                 real spinlock that is a deadlock; under the prototype's
//                 empty body it silently works, so the bug survives right
//                 up to the port.
//   LOCK ORDER    two pools acquired as A-then-B at one call site and
//                 B-then-A at another. Neither site is wrong alone; the
//                 pair is, and it deadlocks only under the interleaving
//                 that hits it. This is what lockdep exists for.
//
// Both are cheap here and expensive later, which is the argument for
// doing it before there is a second pool to get wrong -- nothing today
// holds two pools' guards at once, and the moment something does, the
// order is already whatever it happened to be.
//
// This file is the STAND-IN's lock body, not the library's. Since issue
// #364 the pool names pool_lock_acquire/pool_lock_release without saying
// who supplies them, so a kernel build supplies disable_irq/enable_irq
// and pays none of this. That split is why the checking can be this
// thorough: it costs nothing where it would matter.
//
// WHAT THIS FILE DOES NOT SEE, AND THE ONE ORDER THAT MATTERS TODAY
//
// GitHub issue #462 introduced a lock this checker is blind to: a
// TcpConnection's own TaskMutex, held for as long as a
// TcpConnectionOwner exists. It is not a pool lock, so it carries no tag
// and never reaches the tracking below -- and it is acquired in
// kernel/net/tcp.tkb, which linux_user does not compile.
//
// The order it participates in is one-directional:
//
//   tcp_connection_free() holds the CONNECTION lock and then takes the
//   POOL lock, to remove the slot. Permitted.
//
//   tcp_connection_take() must never be the reverse. It calls
//   intrusive_pool_matches() and tcp_connection_payload() first, and both
//   take the pool lock and RELEASE it before returning, so the connection
//   acquire that follows is sequential rather than nested.
//
// That second half is true by how those two functions are written, not by
// anything that would notice if it changed. What would break it: giving
// either one a signature that returns while still holding the pool lock
// -- a guard-returning shape, the way intrusive_pool_lock itself does.
// That is a visible change to a signature rather than a silent one to a
// body, which is the only reason this is a comment and not a check.
//
// Reported through counters and observers rather than a trap, matching
// how this pool already reports double frees, foreign handles and
// corrupted chains -- and keeping the suite free of trap sites under
// --forbid-trap.

// Enough for far more pools than any exerciser creates; a pool beyond it
// is counted rather than silently skipped, so the checker never quietly
// stops checking.
const POOL_LOCK_MAX_TAGS: usize = 32;

// GitHub issue #399: a pool tag is an OPAQUE identity now, not a small
// consecutive integer, so it cannot be an array index or a bit position.
// This file used it as both -- which is how the change was caught: every
// acquire went untracked the moment tags stopped being 1, 2, 3.
//
// The tag was never specified to be small; this file assumed it because
// it happened to be. So the assumption is removed rather than the
// property restored: tags are registered here on first sight and the
// small dense number is this checker's own.
private let mut pool_lock_tag_of_slot: [usize; POOL_LOCK_MAX_TAGS];
private let mut pool_lock_tag_count: usize = 0;

// The slot this tag is registered under, registering it if new.
// POOL_LOCK_MAX_TAGS means "could not" -- the table is full -- and every
// caller counts that as untracked rather than proceeding.
private fn pool_lock_slot_of(tag: usize) -> usize {
    for i: usize in 0..<POOL_LOCK_MAX_TAGS {
        if (i < pool_lock_tag_count && pool_lock_tag_of_slot[i] == tag) {
            return i;
        }
    }
    let next: usize = pool_lock_tag_count;
    if (next < POOL_LOCK_MAX_TAGS) {
        let slot: {0..<POOL_LOCK_MAX_TAGS as usize} = next;
        pool_lock_tag_of_slot[slot] = tag;
        pool_lock_tag_count = next + 1;
        return next;
    }
    return POOL_LOCK_MAX_TAGS;
}

// Bit b of order_edge[a] means "a was acquired while b was already held".
// A pair with both directions set is the violation.
private let mut pool_lock_order_edge: [usize; POOL_LOCK_MAX_TAGS];
private let mut pool_lock_held: [usize; POOL_LOCK_MAX_TAGS];
private let mut pool_lock_held_depth: usize = 0;
private let mut pool_lock_reentrant: usize = 0;
private let mut pool_lock_order_violations: usize = 0;
// GitHub issue #412: THREE counters, not one, because the three ways this
// checker can fail to track an acquire need three different fixes.
//
// A tag of 0 means a pool whose init never ran, or a caller passing a
// literal -- a bug in the exerciser or in the pool. The table being full
// means POOL_LOCK_MAX_TAGS is too small for the program under test and the
// constant moves. Nesting deeper than the held array means the same about
// the depth. One number cannot say which, and "untracked: 385" was
// exactly that: the summary read as a pass and the cause took a bisect.
private let mut pool_lock_untracked_tag_zero: usize = 0;
private let mut pool_lock_untracked_table_full: usize = 0;
private let mut pool_lock_untracked_too_deep: usize = 0;
private let mut pool_lock_unbalanced: usize = 0;

fn pool_lock_check_reset() {
    for i: usize in 0..<POOL_LOCK_MAX_TAGS {
        pool_lock_order_edge[i] = 0;
        pool_lock_held[i] = 0;
    }
    pool_lock_held_depth = 0;
    pool_lock_reentrant = 0;
    pool_lock_order_violations = 0;
    pool_lock_untracked_tag_zero = 0;
    pool_lock_untracked_table_full = 0;
    pool_lock_untracked_too_deep = 0;
    pool_lock_unbalanced = 0;
    pool_lock_tag_count = 0;
}

// The pool calls this from intrusive_pool_lock. `tag` is the pool's own
// pool_tag, which is unique per pool and assigned at init. `lock` is the
// address of that pool's lock word (issue #445), which this backend does
// not need and takes anyway -- the whole value of a stand-in is that its
// signature is the real one, so a change over there fails here.
// Returns the state a matching release must restore. linux_user has no
// interrupt mask to save, so this is always 0 -- the value exists so the
// SHAPE matches the kernel backend, where it is the DAIF.I bit read
// before masking. A stand-in whose signature differs from the real thing
// is a stand-in that stops catching signature drift.
fn pool_lock_acquire(tag: usize, lock: *Mutex @ id) -> usize !{locks} {
    let slot_value: usize = pool_lock_slot_of(tag);
    if (tag == 0) {
        pool_lock_untracked_tag_zero = pool_lock_untracked_tag_zero + 1;
        return 0;
    }
    if (slot_value >= POOL_LOCK_MAX_TAGS) {
        pool_lock_untracked_table_full = pool_lock_untracked_table_full + 1;
        return 0;
    }
    let slot: {0..<POOL_LOCK_MAX_TAGS as usize} = slot_value;
    let mut depth: usize = pool_lock_held_depth;
    if (depth > POOL_LOCK_MAX_TAGS) { depth = POOL_LOCK_MAX_TAGS; }
    for i: usize in 0..<POOL_LOCK_MAX_TAGS {
        if (i < depth) {
            let other: usize = pool_lock_held[i];
            if (other == slot_value) {
                // Already held by this very path: the acquire a real lock
                // would deadlock on.
                pool_lock_reentrant = pool_lock_reentrant + 1;
            } else if (other < POOL_LOCK_MAX_TAGS) {
                let held_slot: {0..<POOL_LOCK_MAX_TAGS as usize} = other;
                // Have we ever seen the opposite order? Check BEFORE
                // recording this one, or a pair would report against
                // itself.
                if (((pool_lock_order_edge[held_slot] >> slot_value) & 1) == 1) {
                    pool_lock_order_violations = pool_lock_order_violations + 1;
                }
                pool_lock_order_edge[slot] =
                    pool_lock_order_edge[slot] | (1 << other);
            }
        }
    }
    let top: usize = pool_lock_held_depth;
    if (top < POOL_LOCK_MAX_TAGS) {
        let top_slot: {0..<POOL_LOCK_MAX_TAGS as usize} = top;
        pool_lock_held[top_slot] = slot_value;
        pool_lock_held_depth = top + 1;
    } else {
        pool_lock_untracked_too_deep = pool_lock_untracked_too_deep + 1;
    }
    return 0;
}

// Removes `tag` from the held set wherever it is, not only from the top:
// a linear guard is released where its holder chooses, and releasing in a
// different order than acquired is legal even though acquiring in a
// different order is what this file is looking for.
fn pool_lock_release(tag: usize, lock: *Mutex @ id, flags: usize) !{locks} {
    let slot_value: usize = pool_lock_slot_of(tag);
    if (tag == 0 || slot_value >= POOL_LOCK_MAX_TAGS) { return; }
    let mut found: bool = false;
    let mut depth: usize = pool_lock_held_depth;
    if (depth > POOL_LOCK_MAX_TAGS) { depth = POOL_LOCK_MAX_TAGS; }
    for i: usize in 0..<POOL_LOCK_MAX_TAGS {
        if (i < depth && found == false && pool_lock_held[i] == slot_value) {
            found = true;
            // Close the gap so the held set stays a prefix.
            for j: usize in 0..<POOL_LOCK_MAX_TAGS {
                let next: usize = j + 1;
                if (j >= i && next < depth && next < POOL_LOCK_MAX_TAGS) {
                    pool_lock_held[j] = pool_lock_held[next];
                }
            }
            pool_lock_held_depth = depth - 1;
        }
    }
    if (found == false) { pool_lock_unbalanced = pool_lock_unbalanced + 1; }
}

// -- Observers ---------------------------------------------------------

fn pool_lock_reentrant_count() -> usize { return pool_lock_reentrant; }
fn pool_lock_order_violation_count() -> usize { return pool_lock_order_violations; }
fn pool_lock_held_depth_now() -> usize { return pool_lock_held_depth; }
// Acquires the checker could not track. Nonzero means the two counts above
// are answering about less than the whole program, so an exerciser must
// treat it as a FAILURE of the check rather than as a number in a line --
// GitHub issue #412, and pool_lock_check_verdict below is what to print.
fn pool_lock_untracked_count() -> usize {
    return pool_lock_untracked_tag_zero + pool_lock_untracked_table_full +
           pool_lock_untracked_too_deep;
}

fn pool_lock_untracked_tag_zero_count() -> usize {
    return pool_lock_untracked_tag_zero;
}

fn pool_lock_untracked_table_full_count() -> usize {
    return pool_lock_untracked_table_full;
}

fn pool_lock_untracked_too_deep_count() -> usize {
    return pool_lock_untracked_too_deep;
}

// The one line every exerciser that links this checker should print, so
// that "the checker could not check" is a sentence rather than a digit
// somebody has to notice inside a line whose words say everything passed.
//
// GitHub issue #412: when the pool tag stopped being a small consecutive
// integer, all 385 acquires fell into the untracked counter and the
// summary line still read as a pass on the checker's own terms. The
// expected-output diff caught it, by luck of the number being on that line.
// This makes the checker say it, and say WHICH of the three causes, because
// they need different fixes.
fn pool_lock_check_verdict() {
    if (pool_lock_untracked_count() == 0) {
        uart_puts("lock checker: every acquire tracked, so the counts above ");
        uart_puts("are about the whole program\n");
        return;
    }
    uart_puts("lock checker: COULD NOT TRACK ");
    uart_print(pool_lock_untracked_count());
    uart_puts(" acquire(s), so the counts above are about less than the ");
    uart_puts("whole program (tag-zero, table-full, too-deep): ");
    uart_print(pool_lock_untracked_tag_zero_count());
    uart_puts(" ");
    uart_print(pool_lock_untracked_table_full_count());
    uart_puts(" ");
    uart_print(pool_lock_untracked_too_deep_count());
    uart_puts("\n");
}
fn pool_lock_unbalanced_count() -> usize { return pool_lock_unbalanced; }

// GitHub issue #451: the other half of the substitution. kernel/lib/
// mutex.tkb asks the file list for its interrupt mask; this tier has none,
// so these do nothing -- and say so with the real signatures, because a
// stand-in whose shape differs from the real thing stops catching drift.
fn mutex_irq_save() -> usize {
    return 0;
}

fn mutex_irq_restore(flags: usize) {}
