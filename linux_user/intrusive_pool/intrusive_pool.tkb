// End-to-end exerciser for intrusive_pool_core.tkb (design prototype for
// GitHub issue #344). Everything here draws from the same 9-page
// fake_page_provider.tkb that issue #26's growable_pool prototype uses,
// which is also what makes the side-by-side size comparison below fair:
// both pools are asked to hold objects out of the same page supply.
//
// The claim under test is narrow and structural: an IntrusivePool(T)
// declaration names NO capacity -- no N, no MAX_CHUNKS, no
// SLOTS_PER_CHUNK -- and the pool still grows until the page provider
// itself runs out. Everything else here exists to show that removing the
// ceiling did not cost any of the safety properties the existing pools
// have:
//
// - pool_s: sizes and derived layout constants (stride and slots-per-chunk
//   computed from sizeof(T), never supplied by this file), plus the
//   static-footprint comparison against a GrowablePool sized to hold the
//   same number of objects.
// - pool_a: the handle lifecycle -- allocate, write, read back, free,
//   reject a stale handle, reject it again after the slot is REUSED (so
//   the generation, not mere occupancy, is what gates it), and count a
//   genuine double free.
// - pool_a vs pool_b: a handle minted by one pool, offered to another, is
//   rejected as foreign without ever dereferencing it. growable_pool/
//   slotmap cannot see this case at all: one pool's slot index is a
//   perfectly plausible index in another.
// - pool_g: 200 live objects from a pool declared with no capacity, over
//   exactly the two pages that many objects need, then walked back with
//   the iteration cursor a scanning consumer (kernel/net/tcp.tkb's
//   connection lookup) would use in place of `for i in 0..<N`.
// - pool_c: a stray write into a free slot's `next_free` word does not
//   turn into an arbitrary returned pointer -- the alloc-path check
//   (GitHub issue #352) rejects it, counts it, and quarantines the chunk
//   that offered it without taking the pool down with it.
// - pool_x: the only ceiling left is the physical one -- keep inserting
//   until the page provider is empty, and confirm the pool stopped
//   because the PROVIDER ran out, not because the pool did.
//
// - pool_r: growth is not one-way -- fill two chunks, drain them, and
//   watch exactly one page go back to the provider while one empty chunk
//   is deliberately held in reserve, then confirm the next allocation
//   reuses that reserve without asking for a page.
//
// Page budget across the whole run: pool_a 1 + pool_b 1 + pool_g 2 +
// pool_r 2 of which 1 comes back + pool_c 2 of which neither does (the
// quarantined chunk is leaked on purpose -- see intrusive_pool_core.tkb's
// "Current limitations") + pool_x whatever is left, for exactly the
// provider's 9.
use "linux_user/intrusive_pool/intrusive_pool_core.tkb";
use "linux_user/growable_pool/growable_pool_core.tkb";

// 1960 bytes of payload -> a 1968-byte slot -> 2 slots per 4096-byte
// chunk (which is what the 128-byte chunk header leaves room for). Big
// enough that a chunk boundary is crossed after two inserts instead of
// after 248, and a case where "one page per object" would have been the
// naive alternative.
//
// It is also where issue #348's overlay buys nothing: the slot shrank
// from 1976 to 1968 bytes and the count stayed at 2, because 3968/1968
// and 3968/1976 both floor to 2. What costs a slot at this size is the
// 128-byte in-page header (#349's cliff), not the bookkeeping word --
// the two density issues dominate at opposite ends of the size range,
// which is worth knowing before sequencing them.
struct BigPayload {
    tag: usize;
    filler: [u8; 1952];
}

fn app_main() {
    page_allocator_init();
    uart_puts("intrusive_pool\n");

    // -- Derived layout, and the static footprint the ceiling used to cost.
    let mut pool_s: IntrusivePool(usize);
    intrusive_pool_init(&pool_s);
    let mut pool_big: IntrusivePool(BigPayload);
    intrusive_pool_init(&pool_big);

    // GitHub issue #348: ONE bookkeeping word, not two. The free-chain
    // link shares the payload's storage, so an 8-byte payload costs 16
    // bytes per slot rather than 24 -- 248 objects per chunk instead of
    // 165, a 1.50x density gain. (Not 2x: the payload itself does not
    // shrink, and `generation` is deliberately kept for the always-on
    // use-after-free check.)
    uart_puts("slot stride for usize (8-byte payload + 1 bookkeeping word): ");
    uart_print(intrusive_pool_slot_stride(&pool_s));
    uart_puts("\n");
    uart_puts("slots per chunk, derived from sizeof(T) alone: ");
    uart_print(intrusive_pool_slots_per_chunk(&pool_s));
    uart_puts("\n");
    uart_puts("same pool type, 1960-byte payload, same derivation: ");
    uart_print(intrusive_pool_slots_per_chunk(&pool_big));
    uart_puts("\n");

    // A GrowablePool able to hold the same 336 objects must pre-commit
    // FreelistCore(336)'s next_free plus its own occupant_generation --
    // 336 usizes each -- before a single object exists. IntrusivePool(T)
    // has no such array, and its size does not move when the payload type
    // changes either.
    uart_puts("static bytes of bookkeeping for a 336-object pool -- growable: ");
    uart_print(sizeof(GrowablePool(usize, 168, 2, 336)));
    uart_puts(", intrusive: ");
    uart_print(sizeof(IntrusivePool(usize)));
    uart_puts("\n");
    uart_puts("intrusive pool size is the same for a 1960-byte payload: ");
    uart_print_bool(
        sizeof(IntrusivePool(usize)) == sizeof(IntrusivePool(BigPayload)));
    uart_puts("\n");

    uart_puts("pages consumed before the first insert: ");
    uart_print(page_allocator_live_count());
    uart_puts("\n");

    // -- pool_a: the handle lifecycle.
    let mut pool_a: IntrusivePool(usize);
    intrusive_pool_init(&pool_a);
    let a0 = match intrusive_pool_insert(&pool_a) {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_a insert 0 failed\n");
            return;
        }
    };
    let a1 = match intrusive_pool_insert(&pool_a) {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_a insert 1 failed\n");
            intrusive_owner_drop(a0);
            return;
        }
    };
    *intrusive_pool_ref(&pool_a, a0) = 111;
    *intrusive_pool_ref(&pool_a, a1) = 222;
    uart_puts("two live slots hold distinct values: ");
    uart_print_bool(*intrusive_pool_ref(&pool_a, a0) == 111 &&
                    *intrusive_pool_ref(&pool_a, a1) == 222);
    uart_puts("\n");
    uart_puts("one page backs both (live, chunks, pages): ");
    uart_print(intrusive_pool_live_count(&pool_a));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_a));
    uart_puts(" ");
    uart_print(page_allocator_live_count());
    uart_puts("\n");

    let a1_slot: usize = intrusive_owner_slot(a1);
    let a1_generation: usize = intrusive_owner_generation(a1);
    uart_puts("live handle matches before free: ");
    uart_print_bool(intrusive_pool_matches(&pool_a, a1_slot, a1_generation));
    uart_puts("\n");
    intrusive_pool_remove(&pool_a, a1);
    uart_puts("same handle rejected immediately after free: ");
    uart_print_bool(
        intrusive_pool_matches(&pool_a, a1_slot, a1_generation) == false);
    uart_puts("\n");

    // The freed slot is the head of the free chain, so this reinsert gets
    // the SAME address back -- which is exactly the case a bare
    // occupancy flag could not distinguish from the stale handle above.
    let a1b = match intrusive_pool_insert(&pool_a) {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_a reinsert failed\n");
            intrusive_owner_drop(a0);
            return;
        }
    };
    uart_puts("reinsert reused that exact slot address: ");
    uart_print_bool(intrusive_owner_slot(a1b) == a1_slot);
    uart_puts("\n");
    uart_puts("stale handle still rejected after the reuse: ");
    uart_print_bool(
        intrusive_pool_matches(&pool_a, a1_slot, a1_generation) == false);
    uart_puts("\n");

    // A genuine double free, through the one legal way to fabricate a
    // handle (the into_parts/new round trip kernel/net/tcp.tkb's own owner
    // type needs).
    let (a1b_slot, a1b_generation) = intrusive_owner_into_parts(&pool_a, a1b);
    let first =
        intrusive_owner_new(&pool_a, a1b_slot, a1b_generation);
    intrusive_pool_remove(&pool_a, first);
    let again =
        intrusive_owner_new(&pool_a, a1b_slot, a1b_generation);
    let doubles_before: usize = intrusive_pool_double_remove_count(&pool_a);
    intrusive_pool_remove(&pool_a, again);
    uart_puts("double free of an already-freed slot counted, not acted on: ");
    uart_print_bool(
        intrusive_pool_double_remove_count(&pool_a) == doubles_before + 1 &&
        intrusive_pool_live_count(&pool_a) == 1);
    uart_puts("\n");

    // -- Cross-pool free is now a COMPILE error, not a runtime count:
    // `intrusive_pool_remove(&pool_b, a0)` does not compile at all, since
    // a0's type carries the address identity of the pool that minted it
    // (GitHub issues #344/#345 -- test/test_takibi.ml holds that negative
    // case, because a linux_user/ test can only assert on programs that
    // DO compile). What is still detectable only at runtime is the one
    // case the brand cannot cover: a handle correctly branded to THIS
    // pool but carrying an address belonging to another, which takes
    // explicitly naming both pools through the into_parts/new round trip
    // -- an act that is at least grep-visible now, rather than the silent
    // accident it used to be.
    let mut pool_b: IntrusivePool(usize);
    intrusive_pool_init(&pool_b);
    let b0 = match intrusive_pool_insert(&pool_b) {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_b insert 0 failed\n");
            intrusive_owner_drop(a0);
            return;
        }
    };
    let a0_slot: usize = intrusive_owner_slot(a0);
    let a0_generation: usize = intrusive_owner_generation(a0);
    let forged = intrusive_owner_new(&pool_b, a0_slot, a0_generation);
    intrusive_pool_remove(&pool_b, forged);
    uart_puts("an address from another pool, rebranded by hand, is still ");
    uart_puts("rejected without dereferencing it: ");
    uart_print_bool(intrusive_pool_foreign_handle_count(&pool_b) == 1 &&
                    intrusive_pool_live_count(&pool_b) == 1 &&
                    intrusive_pool_matches(&pool_a, a0_slot, a0_generation) &&
                    *intrusive_pool_ref(&pool_a, a0) == 111);
    uart_puts("\n");
    intrusive_pool_remove(&pool_a, a0);
    intrusive_pool_remove(&pool_b, b0);

    // -- pool_g: 200 objects out of a declaration that names no capacity.
    // Owners are deliberately dropped rather than freed, so the
    // allocations stay live and the pool has to keep growing.
    let mut pool_g: IntrusivePool(usize);
    intrusive_pool_init(&pool_g);
    let pages_before_growth: usize = page_allocator_live_count();
    let mut wanted: usize = 0;
    let mut exhausted: bool = false;
    while (wanted < 200 && exhausted == false) {
        match intrusive_pool_insert(&pool_g) {
            IntrusivePoolInsertResult::Allocated(o) => {
                *intrusive_pool_ref(&pool_g, o) = wanted + 1;
                intrusive_owner_drop(o);
                wanted = wanted + 1;
            }
            IntrusivePoolInsertResult::OutOfMemory => { exhausted = true; }
        }
    }
    uart_puts("200 live objects from a pool declared with no capacity ");
    uart_puts("(live, chunks, pages used): ");
    uart_print(intrusive_pool_live_count(&pool_g));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_g));
    uart_puts(" ");
    uart_print(page_allocator_live_count() - pages_before_growth);
    uart_puts("\n");

    // The scan a consumer does in place of `for i in 0..<N`: walk the
    // chunk list, skip free slots, and check every live payload.
    let mut cursor: usize = intrusive_pool_first_slot(&pool_g);
    let mut seen: usize = 0;
    let mut sum: usize = 0;
    while (cursor != 0) {
        if (intrusive_pool_slot_generation(&pool_g, cursor) != 0) {
            seen = seen + 1;
            sum = sum + *intrusive_pool_payload_at(&pool_g, cursor);
        }
        cursor = intrusive_pool_next_slot(&pool_g, cursor);
    }
    uart_puts("cursor walk found every live payload exactly once ");
    uart_puts("(count, checksum): ");
    uart_print(seen);
    uart_puts(" ");
    uart_print(sum);
    uart_puts("\n");

    // -- pool_r: growth is not one-way. Fill two chunks, drain them, and
    // watch exactly one page go back while one empty chunk is held in
    // reserve (GitHub issue #346's hysteresis -- see IntrusivePool's own
    // comment for why one).
    //
    // Owners cannot be kept in an array (an indexed owner may not be
    // stored in one), so the drain reconstructs each live slot's handle
    // through the cursor API and the into_parts/new round trip, restarting
    // the walk after every free -- the freed chunk can vanish underneath a
    // cursor, which is exactly the address-stability change reclaim
    // introduces.
    let mut pool_r: IntrusivePool(BigPayload);
    intrusive_pool_init(&pool_r);
    let pages_before_reclaim: usize = page_allocator_live_count();
    let mut filled: usize = 0;
    let mut fill_failed: bool = false;
    while (filled < 4 && fill_failed == false) {
        match intrusive_pool_insert(&pool_r) {
            IntrusivePoolInsertResult::Allocated(o) => {
                intrusive_pool_ref(&pool_r, o).tag = filled + 1;
                intrusive_owner_drop(o);
                filled = filled + 1;
            }
            IntrusivePoolInsertResult::OutOfMemory => { fill_failed = true; }
        }
    }
    uart_puts("two chunks filled before the drain (live, chunks, pages): ");
    uart_print(intrusive_pool_live_count(&pool_r));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(page_allocator_live_count() - pages_before_reclaim);
    uart_puts("\n");

    let mut draining: bool = true;
    while (draining) {
        let mut cursor: usize = intrusive_pool_first_slot(&pool_r);
        let mut freed_one: bool = false;
        while (cursor != 0 && freed_one == false) {
            let occupant: usize = intrusive_pool_slot_generation(&pool_r, cursor);
            if (occupant != 0) {
                let victim = intrusive_owner_new(&pool_r, cursor, occupant);
                intrusive_pool_remove(&pool_r, victim);
                freed_one = true;
            } else {
                cursor = intrusive_pool_next_slot(&pool_r, cursor);
            }
        }
        if (freed_one == false) { draining = false; }
    }
    uart_puts("draining gave one page back and kept one empty chunk in ");
    uart_puts("reserve (live, chunks, released, pages still held): ");
    uart_print(intrusive_pool_live_count(&pool_r));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(intrusive_pool_released_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(page_allocator_live_count() - pages_before_reclaim);
    uart_puts("\n");

    // The reserved chunk is the whole point of holding one back: this
    // allocation must not touch the page provider at all.
    let pages_before_reuse: usize = page_allocator_live_count();
    match intrusive_pool_insert(&pool_r) {
        IntrusivePoolInsertResult::Allocated(o) => {
            intrusive_owner_drop(o);
            uart_puts("reallocating after the drain reused the reserved ");
            uart_puts("chunk without asking for a page: ");
            uart_print_bool(page_allocator_live_count() == pages_before_reuse &&
                            intrusive_pool_chunk_count(&pool_r) == 1);
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_r reuse failed\n");
            return;
        }
    }

    // -- pool_c: a corrupted free-chain word never becomes a returned
    // pointer (GitHub issue #352). This is the one exposure that involves
    // no handle at all: insert pops `free_head`, which is a pointer read
    // out of a free slot's own memory, so a single stray write into that
    // memory would otherwise steer the next allocation anywhere. An
    // array-indexed pool corrupted the same way yields a wrong INDEX,
    // which its own bounds check catches; the intrusive design is what
    // turns it into a wrong POINTER.
    let mut pool_c: IntrusivePool(usize);
    intrusive_pool_init(&pool_c);
    let c0 = match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c insert 0 failed\n");
            return;
        }
    };
    // Kept live deliberately -- freeing it would push it back onto the
    // very chain this test is about to poison.
    intrusive_owner_drop(c0);

    // Slot #0 is the live one above, so slot #1 is free and is this
    // chunk's free_head. Scribble over its intrusive link, exactly as a
    // stray write into freed memory would.
    let c_slot0: usize = intrusive_pool_first_slot(&pool_c);
    let c_slot1: usize = intrusive_pool_next_slot(&pool_c, c_slot0);
    let poison: usize = 0x4141414141410;
    *intrusive_slot_link_at(&pool_c, c_slot1) = poison;

    // The poisoned slot is itself a perfectly legitimate free slot, so
    // this allocation must still succeed -- it is the one AFTER it that
    // pops the corrupted word.
    let c1 = match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c insert 1 failed\n");
            return;
        }
    };
    uart_puts("the poisoned slot is itself still handed out normally: ");
    uart_print_bool(intrusive_owner_slot(c1) == c_slot1);
    uart_puts("\n");
    intrusive_owner_drop(c1);

    let corrupt_before: usize = intrusive_pool_corrupt_free_chain_count(&pool_c);
    let mut rejected: bool = false;
    let mut returned_poison: bool = false;
    match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => {
            if (intrusive_owner_slot(o) == poison) { returned_poison = true; }
            intrusive_owner_drop(o);
        }
        IntrusivePoolInsertResult::OutOfMemory => { rejected = true; }
    }
    uart_puts("a corrupted next_free is rejected, not returned ");
    uart_puts("(rejected, handed back the poison, counted): ");
    uart_print_bool(rejected);
    uart_puts(" ");
    uart_print_bool(returned_poison);
    uart_puts(" ");
    uart_print(intrusive_pool_corrupt_free_chain_count(&pool_c) - corrupt_before);
    uart_puts("\n");

    // Quarantine, not a dead pool: the poisoned chunk left the partial
    // list, so the next allocation comes from a fresh one.
    let pages_before_recovery: usize = page_allocator_live_count();
    let poisoned_base: usize = intrusive_chunk_base_of(c_slot0);
    match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => {
            let fresh: usize = intrusive_owner_slot(o);
            intrusive_owner_drop(o);
            uart_puts("the pool keeps working from a fresh chunk instead: ");
            uart_print_bool(page_allocator_live_count() == pages_before_recovery + 1 &&
                            intrusive_chunk_base_of(fresh) != poisoned_base);
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c recovery failed\n");
            return;
        }
    }

    // Emptying the poisoned chunk must not rehabilitate it. Freeing a slot
    // back into a chunk is the one path that re-links it onto the partial
    // list, and an emptied chunk is normally either held as the reserve or
    // handed back to the provider -- a quarantined chunk does none of the
    // three, so the corruption stays contained and stays visible.
    let occupant0: usize = intrusive_pool_slot_generation(&pool_c, c_slot0);
    if (occupant0 != 0) {
        intrusive_pool_remove(&pool_c, intrusive_owner_new(&pool_c, c_slot0, occupant0));
    }
    let occupant1: usize = intrusive_pool_slot_generation(&pool_c, c_slot1);
    if (occupant1 != 0) {
        intrusive_pool_remove(&pool_c, intrusive_owner_new(&pool_c, c_slot1, occupant1));
    }
    match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => {
            let after: usize = intrusive_owner_slot(o);
            intrusive_owner_drop(o);
            uart_puts("emptying it neither re-admits it nor returns its page ");
            uart_puts("(allocated elsewhere, chunks, released): ");
            uart_print_bool(intrusive_chunk_base_of(after) != poisoned_base);
            uart_puts(" ");
            uart_print(intrusive_pool_chunk_count(&pool_c));
            uart_puts(" ");
            uart_print(intrusive_pool_released_chunk_count(&pool_c));
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c post-drain insert failed\n");
            return;
        }
    }

    // The quieter half of the same primitive: point the chain at a LIVE
    // slot of the same chunk instead of at garbage. That address is a
    // perfectly well-formed slot, so the arithmetic check alone would pass
    // it, and handing it out would not fault -- it would alias two owners
    // onto one slot. The generation word is what refuses it.
    //
    // Reuses the fresh chunk the recovery above already paid for (it is at
    // pool.chunk_head, so first_slot walks it), which is why this costs no
    // further page. Its slots #0 and #1 are the two live allocations made
    // above, and #2 is its current free_head.
    let live_slot: usize = intrusive_pool_first_slot(&pool_c);
    let live_next: usize = intrusive_pool_next_slot(&pool_c, live_slot);
    let free_head: usize = intrusive_pool_next_slot(&pool_c, live_next);
    uart_puts("the aliasing target really is a live slot in the fresh chunk: ");
    uart_print_bool(intrusive_pool_slot_generation(&pool_c, live_slot) != 0 &&
                    intrusive_chunk_base_of(live_slot) != poisoned_base);
    uart_puts("\n");
    *intrusive_slot_link_at(&pool_c, free_head) = live_slot;

    let alias_before: usize = intrusive_pool_corrupt_free_chain_count(&pool_c);
    let live_generation: usize = intrusive_pool_slot_generation(&pool_c, live_slot);
    match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => { intrusive_owner_drop(o); }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c alias setup insert failed\n");
            return;
        }
    }
    let mut alias_rejected: bool = false;
    let mut aliased: bool = false;
    match intrusive_pool_insert(&pool_c) {
        IntrusivePoolInsertResult::Allocated(o) => {
            if (intrusive_owner_slot(o) == live_slot) { aliased = true; }
            intrusive_owner_drop(o);
        }
        IntrusivePoolInsertResult::OutOfMemory => { alias_rejected = true; }
    }
    uart_puts("a chain pointing at a LIVE slot is refused, and its existing ");
    uart_puts("occupant is untouched (rejected, aliased, counted, occupant kept): ");
    uart_print_bool(alias_rejected);
    uart_puts(" ");
    uart_print_bool(aliased);
    uart_puts(" ");
    uart_print(intrusive_pool_corrupt_free_chain_count(&pool_c) - alias_before);
    uart_puts(" ");
    uart_print_bool(
        intrusive_pool_slot_generation(&pool_c, live_slot) == live_generation);
    uart_puts("\n");

    // -- pool_x: the last remaining ceiling is the page provider's.
    let mut pool_x: IntrusivePool(BigPayload);
    intrusive_pool_init(&pool_x);
    let mut placed: usize = 0;
    let mut hit_provider_limit: bool = false;
    while (hit_provider_limit == false) {
        match intrusive_pool_insert(&pool_x) {
            IntrusivePoolInsertResult::Allocated(o) => {
                intrusive_pool_ref(&pool_x, o).tag = placed + 1;
                intrusive_owner_drop(o);
                placed = placed + 1;
            }
            IntrusivePoolInsertResult::OutOfMemory => { hit_provider_limit = true; }
        }
    }
    uart_puts("1960-byte objects placed before the PROVIDER ran out ");
    uart_puts("(objects, chunks, pages left): ");
    uart_print(placed);
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_x));
    uart_puts(" ");
    uart_print(PAGE_COUNT - page_allocator_live_count());
    uart_puts("\n");

    uart_puts("done\n");
}

fn uart_print_bool(value: bool) {
    if (value) {
        uart_puts("true");
    } else {
        uart_puts("false");
    }
}
