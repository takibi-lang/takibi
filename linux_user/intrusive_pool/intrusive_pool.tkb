// End-to-end exerciser for intrusive_pool_core.tkb (design prototype for
// GitHub issue #344). Everything here draws from the same 9-page
// fake_page_provider.tkb that issue #26's growable_pool prototype uses,
// which is also what makes the side-by-side size comparison below fair:
// both pools are asked to hold objects out of the same page supply.
//
// The claim under test is narrow and structural: an IntrusivePool(T)
// declaration names NO capacity -- no N, no MAX_CHUNKS, no
// SLOTS_PER_CHUNK -- and the pool still grows until the page provider
// itself runs out. Everything else here exists to show that removing the
// ceiling did not cost any of the safety properties the existing pools
// have:
//
// - pool_s: sizes and derived layout constants (stride and slots-per-chunk
//   computed from sizeof(T), never supplied by this file), plus the
//   static-footprint comparison against a GrowablePool sized to hold the
//   same number of objects.
// - pool_a: the handle lifecycle -- allocate, write, read back, free,
//   reject a stale handle, reject it again after the slot is REUSED (so
//   the generation, not mere occupancy, is what gates it), and count a
//   genuine double free.
// - pool_a vs pool_b: a handle minted by one pool, offered to another, is
//   rejected as foreign without ever dereferencing it. growable_pool/
//   slotmap cannot see this case at all: one pool's slot index is a
//   perfectly plausible index in another.
// - pool_g: 200 live objects from a pool declared with no capacity, then
//   walked back with the iteration cursor a scanning consumer
//   (kernel/net/tcp.tkb's connection lookup) would use in place of `for i
//   in 0..<N`. That walk is also where issue #348's liveness view earns
//   its keep: the payload can only be reached through the Live case of
//   intrusive_pool_probe_slot, so "skip the free slots" is a thing the
//   compiler checks rather than a thing the caller remembers.
// - pool_c: a stray write into a free slot's `next_free` word does not
//   turn into an arbitrary returned pointer -- the alloc-path check
//   (GitHub issue #352) rejects it, counts it, and quarantines the chunk
//   that offered it without taking the pool down with it.
// - pool_u: what a freshly allocated payload contains, on a slot's first
//   use and again on its reuse (GitHub issue #356). The contract is that
//   the pool promises nothing and zeroes nothing; this is where that gets
//   teeth rather than staying a sentence in a comment.
// - pool_x: the only ceiling left is the physical one -- keep inserting
//   until the page provider is empty, and confirm the pool stopped
//   because the PROVIDER ran out, not because the pool did.
//
// - pool_r: growth is not one-way -- fill two chunks, drain them, and
//   watch exactly one page go back to the provider while one empty chunk
//   is deliberately held in reserve, then confirm the next allocation
//   reuses that reserve without asking for a page.
//
// Page budget across the whole run: pool_a 1 + pool_b 1 + pool_g 1 +
// pool_r 2 of which 1 comes back + pool_c 2 of which neither does (the
// quarantined chunk is leaked on purpose -- see intrusive_pool_core.tkb's
// "Current limitations") + pool_u 1 + pool_x whatever is left, for
// exactly the provider's 9.
use "linux_user/intrusive_pool/intrusive_pool_core.tkb";
use "kernel/lib/growable_pool.tkb";

// 1960 bytes of payload -> a 1968-byte slot -> 2 slots per page. Big
// enough that a chunk boundary is crossed after two inserts instead of
// after 256, and a case where "one page per object" would have been the
// naive alternative.
//
// It is also the size at which issue #348's overlay bought nothing: the
// slot shrank from 1976 to 1968 bytes and the count stayed at 2, because
// 4096/1968 and 4096/1976 both floor to 2. What used to cost a slot at
// this size was the in-page header, which issue #349 removed -- the two
// density issues dominated at opposite ends of the size range.
struct BigPayload {
    tag: usize;
    filler: [u8; 1952];
}

// GitHub issue #356: three words, so pool_u can tell apart the payload
// region that shares storage with the free-chain link (the first) from
// the region that does not (the rest).
struct UninitProbe {
    a: usize;
    b: usize;
    c: usize;
}

// GitHub issue #349's cliff, at the two sizes where it bites hardest.
// Each is chosen so the SLOT (8 bytes of generation plus the payload)
// lands exactly on a divisor of the page. Those are the strides an
// in-page header punishes worst, because losing 128 bytes off the top
// costs a whole slot rather than a fraction of one. A page-SIZED slot
// used to be poolable when metadata was out of line; with it back in the
// page it is not, and there is no third struct here any more.
struct Stride1024 { filler: [u8; 1016]; }
struct Stride2048 { filler: [u8; 2040]; }

fn app_main() {
    page_allocator_init();
    uart_puts("intrusive_pool\n");

    // GitHub issue #355: every phase below ends by asking its pool
    // whether its own bookkeeping is still coherent -- free-chain lengths
    // against live counts, partial-list membership against "has a free
    // slot", and the per-chunk totals against the pool's own counters.
    // Accumulated rather than printed per phase so the output stays
    // readable, but the count is printed too: a phase that stopped
    // calling it would show up as a smaller number rather than silently
    // checking less.
    let mut probes_ok: bool = true;
    let mut probes_run: usize = 0;

    // -- Derived layout, and the static footprint the ceiling used to cost.
    let mut pool_s: IntrusivePool(usize);
    intrusive_pool_init(&pool_s);
    let mut pool_big: IntrusivePool(BigPayload);
    intrusive_pool_init(&pool_big);

    // GitHub issue #348: ONE bookkeeping word, not two. The free-chain
    // link shares the payload's storage, so an 8-byte payload costs 16
    // bytes per slot rather than 24 -- 248 objects per chunk instead of
    // 165, a 1.50x density gain. (Not 2x: the payload itself does not
    // shrink, and `generation` is deliberately kept for the always-on
    // use-after-free check.)
    uart_puts("slot stride for usize (8-byte payload + 1 bookkeeping word): ");
    uart_print(intrusive_pool_slot_stride(&pool_s));
    uart_puts("\n");
    uart_puts("slots per chunk, derived from sizeof(T) alone: ");
    uart_print(intrusive_pool_slots_per_chunk(&pool_s));
    uart_puts("\n");
    uart_puts("same pool type, 1960-byte payload, same derivation: ");
    uart_print(intrusive_pool_slots_per_chunk(&pool_big));
    uart_puts("\n");

    // GitHub issue #349, and what issue #353 taught it. The chunk header
    // is out of the pool's hands -- the provider says where per-page
    // metadata lives and how much of the page is the owner's -- but this
    // provider puts it in the page's own tail, so the cliff is BACK: a
    // stride that divides the page still loses a slot.
    //
    // That is deliberate. The side-array placement removed the cliff by
    // reserving metadata for every page in the machine, which is 25 MB of
    // BSS on the kernel's 204800 pages whether or not anything is pooled.
    // In-page charges only the pages that are actually chunks, and the
    // kernel pools a handful. Break-even is around 450 MB of pooled
    // memory. So the numbers below are the price, and at the payload
    // sizes the kernel actually pools (16-96 bytes) it is about 3% of
    // slots.
    //
    // No pages are consumed here: slots-per-chunk is a function of
    // sizeof(T) and the provider's constants, which is the same reason it
    // needs no caller-supplied parameter.
    let mut pool_1k: IntrusivePool(Stride1024);
    intrusive_pool_init(&pool_1k);
    let mut pool_2k: IntrusivePool(Stride2048);
    intrusive_pool_init(&pool_2k);
    uart_puts("what the in-page header costs at page-dividing strides ");
    uart_puts("(1024, 2048; 4 and 2 if metadata were out of line): ");
    uart_print(intrusive_pool_slots_per_chunk(&pool_1k));
    uart_puts(" ");
    uart_print(intrusive_pool_slots_per_chunk(&pool_2k));
    uart_puts("\n");

    // A GrowablePool able to hold the same 336 objects must pre-commit
    // FreelistCore(336)'s next_free plus its own occupant_generation --
    // 336 usizes each -- before a single object exists. IntrusivePool(T)
    // has no such array, and its size does not move when the payload type
    // changes either.
    uart_puts("static bytes of bookkeeping for a 336-object pool -- growable: ");
    uart_print(sizeof(GrowablePool(usize, 168, 2, 336)));
    uart_puts(", intrusive: ");
    uart_print(sizeof(IntrusivePool(usize)));
    uart_puts("\n");
    uart_puts("intrusive pool size is the same for a 1960-byte payload: ");
    uart_print_bool(
        sizeof(IntrusivePool(usize)) == sizeof(IntrusivePool(BigPayload)));
    uart_puts("\n");

    uart_puts("pages consumed before the first insert: ");
    uart_print(page_allocator_live_count());
    uart_puts("\n");

    // -- pool_a: the handle lifecycle.
    let mut pool_a: IntrusivePool(usize);
    intrusive_pool_init(&pool_a);
    let g1 = intrusive_pool_lock(&pool_a);
    let r1 = intrusive_pool_insert(&pool_a, g1);
    intrusive_pool_unlock(&pool_a, g1);
    let a0 = match r1 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_a insert 0 failed\n");
            return;
        }
    };
    let g2 = intrusive_pool_lock(&pool_a);
    let r2 = intrusive_pool_insert(&pool_a, g2);
    intrusive_pool_unlock(&pool_a, g2);
    let a1 = match r2 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_a insert 1 failed\n");
            intrusive_owner_drop(a0);
            return;
        }
    };
    *intrusive_pool_ref(&pool_a, a0) = 111;
    *intrusive_pool_ref(&pool_a, a1) = 222;
    uart_puts("two live slots hold distinct values: ");
    uart_print_bool(*intrusive_pool_ref(&pool_a, a0) == 111 &&
                    *intrusive_pool_ref(&pool_a, a1) == 222);
    uart_puts("\n");
    uart_puts("one page backs both (live, chunks, pages): ");
    uart_print(intrusive_pool_live_count(&pool_a));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_a));
    uart_puts(" ");
    uart_print(page_allocator_live_count());
    uart_puts("\n");

    let a1_slot: usize = intrusive_owner_slot(a1);
    let a1_generation: usize = intrusive_owner_generation(a1);
    uart_puts("live handle matches before free: ");
    uart_print_bool(intrusive_pool_matches(&pool_a, a1_slot, a1_generation));
    uart_puts("\n");
    let g3 = intrusive_pool_lock(&pool_a);
    intrusive_pool_remove(&pool_a, g3, a1);
    intrusive_pool_unlock(&pool_a, g3);
    uart_puts("same handle rejected immediately after free: ");
    uart_print_bool(
        intrusive_pool_matches(&pool_a, a1_slot, a1_generation) == false);
    uart_puts("\n");

    // The freed slot is the head of the free chain, so this reinsert gets
    // the SAME address back -- which is exactly the case a bare
    // occupancy flag could not distinguish from the stale handle above.
    let g4 = intrusive_pool_lock(&pool_a);
    let r4 = intrusive_pool_insert(&pool_a, g4);
    intrusive_pool_unlock(&pool_a, g4);
    let a1b = match r4 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_a reinsert failed\n");
            intrusive_owner_drop(a0);
            return;
        }
    };
    uart_puts("reinsert reused that exact slot address: ");
    uart_print_bool(intrusive_owner_slot(a1b) == a1_slot);
    uart_puts("\n");
    uart_puts("stale handle still rejected after the reuse: ");
    uart_print_bool(
        intrusive_pool_matches(&pool_a, a1_slot, a1_generation) == false);
    uart_puts("\n");

    // A genuine double free, through the one legal way to fabricate a
    // handle (the into_parts/new round trip kernel/net/tcp.tkb's own owner
    // type needs).
    let (a1b_slot, a1b_generation) = intrusive_owner_into_parts(&pool_a, a1b);
    let first =
        intrusive_owner_new(&pool_a, a1b_slot, a1b_generation);
    let g5 = intrusive_pool_lock(&pool_a);
    intrusive_pool_remove(&pool_a, g5, first);
    intrusive_pool_unlock(&pool_a, g5);
    let again =
        intrusive_owner_new(&pool_a, a1b_slot, a1b_generation);
    let doubles_before: usize = intrusive_pool_double_remove_count(&pool_a);
    let g6 = intrusive_pool_lock(&pool_a);
    intrusive_pool_remove(&pool_a, g6, again);
    intrusive_pool_unlock(&pool_a, g6);
    uart_puts("double free of an already-freed slot counted, not acted on: ");
    uart_print_bool(
        intrusive_pool_double_remove_count(&pool_a) == doubles_before + 1 &&
        intrusive_pool_live_count(&pool_a) == 1);
    uart_puts("\n");

    // -- Cross-pool free is now a COMPILE error, not a runtime count:
    // `intrusive_pool_remove(&pool_b, a0)` does not compile at all, since
    // a0's type carries the address identity of the pool that minted it
    // (GitHub issues #344/#345 -- test/test_takibi.ml holds that negative
    // case, because a linux_user/ test can only assert on programs that
    // DO compile). What is still detectable only at runtime is the one
    // case the brand cannot cover: a handle correctly branded to THIS
    // pool but carrying an address belonging to another, which takes
    // explicitly naming both pools through the into_parts/new round trip
    // -- an act that is at least grep-visible now, rather than the silent
    // accident it used to be.
    let mut pool_b: IntrusivePool(usize);
    intrusive_pool_init(&pool_b);
    let g7 = intrusive_pool_lock(&pool_b);
    let r7 = intrusive_pool_insert(&pool_b, g7);
    intrusive_pool_unlock(&pool_b, g7);
    let b0 = match r7 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_b insert 0 failed\n");
            intrusive_owner_drop(a0);
            return;
        }
    };
    let a0_slot: usize = intrusive_owner_slot(a0);
    let a0_generation: usize = intrusive_owner_generation(a0);
    let forged = intrusive_owner_new(&pool_b, a0_slot, a0_generation);
    let g8 = intrusive_pool_lock(&pool_b);
    intrusive_pool_remove(&pool_b, g8, forged);
    intrusive_pool_unlock(&pool_b, g8);
    uart_puts("an address from another pool, rebranded by hand, is still ");
    uart_puts("rejected without dereferencing it: ");
    uart_print_bool(intrusive_pool_foreign_handle_count(&pool_b) == 1 &&
                    intrusive_pool_live_count(&pool_b) == 1 &&
                    intrusive_pool_matches(&pool_a, a0_slot, a0_generation) &&
                    *intrusive_pool_ref(&pool_a, a0) == 111);
    uart_puts("\n");
    let g9 = intrusive_pool_lock(&pool_a);
    intrusive_pool_remove(&pool_a, g9, a0);
    intrusive_pool_unlock(&pool_a, g9);
    let g10 = intrusive_pool_lock(&pool_b);
    intrusive_pool_remove(&pool_b, g10, b0);
    intrusive_pool_unlock(&pool_b, g10);

    if (intrusive_pool_probe(&pool_a) == false) { probes_ok = false; }
    probes_run = probes_run + 1;

    if (intrusive_pool_probe(&pool_b) == false) { probes_ok = false; }
    probes_run = probes_run + 1;

    // -- pool_g: 200 objects out of a declaration that names no capacity.
    // Owners are deliberately dropped rather than freed, so the
    // allocations stay live and the pool has to keep growing.
    let mut pool_g: IntrusivePool(usize);
    intrusive_pool_init(&pool_g);
    let pages_before_growth: usize = page_allocator_live_count();
    let mut wanted: usize = 0;
    let mut exhausted: bool = false;
    while (wanted < 200 && exhausted == false) {
        let g11 = intrusive_pool_lock(&pool_g);
        let r11 = intrusive_pool_insert(&pool_g, g11);
        intrusive_pool_unlock(&pool_g, g11);
        match r11 {
            IntrusivePoolInsertResult::Allocated(o) => {
                *intrusive_pool_ref(&pool_g, o) = wanted + 1;
                intrusive_owner_drop(o);
                wanted = wanted + 1;
            }
            IntrusivePoolInsertResult::OutOfMemory => { exhausted = true; }
        }
    }
    uart_puts("200 live objects from a pool declared with no capacity ");
    uart_puts("(live, chunks, pages used): ");
    uart_print(intrusive_pool_live_count(&pool_g));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_g));
    uart_puts(" ");
    uart_print(page_allocator_live_count() - pages_before_growth);
    uart_puts("\n");

    // The scan a consumer does in place of `for i in 0..<N`: walk the
    // chunk list, skip slots with no payload, and check every live one.
    //
    // The `match` is the point (GitHub issue #348). This used to be an
    // `if` on a liveness integer, with reading the payload a separate
    // call the caller was trusted to guard -- and once the payload and
    // the free-chain link share storage, forgetting that guard reads a
    // chain pointer as a T. Now the payload accessor takes a slot_view, the
    // only source of a view is this probe, and the probe only mints one
    // on the branch where it has already established the slot is live.
    // Skipping the check is no longer something a caller can express.
    let mut cursor: usize = intrusive_pool_first_slot(&pool_g);
    let mut seen: usize = 0;
    let mut sum: usize = 0;
    while (cursor != 0) {
        match intrusive_pool_probe_slot(&pool_g, cursor) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                seen = seen + 1;
                sum = sum + *intrusive_pool_payload_of(&pool_g, slot_view);
            }
        }
        cursor = intrusive_pool_next_slot(&pool_g, cursor);
    }
    uart_puts("cursor walk found every live payload exactly once ");
    uart_puts("(count, checksum): ");
    uart_print(seen);
    uart_puts(" ");
    uart_print(sum);
    uart_puts("\n");

    if (intrusive_pool_probe(&pool_g) == false) { probes_ok = false; }
    probes_run = probes_run + 1;

    // -- pool_r: growth is not one-way. Fill two chunks, drain them, and
    // watch exactly one page go back while one empty chunk is held in
    // reserve (GitHub issue #346's hysteresis -- see IntrusivePool's own
    // comment for why one).
    //
    // Owners cannot be kept in an array (an indexed owner may not be
    // stored in one), so the drain reconstructs each live slot's handle
    // through the cursor API and the into_parts/new round trip, restarting
    // the walk after every free -- the freed chunk can vanish underneath a
    // cursor, which is exactly the address-stability change reclaim
    // introduces.
    let mut pool_r: IntrusivePool(BigPayload);
    intrusive_pool_init(&pool_r);
    let pages_before_reclaim: usize = page_allocator_live_count();
    let mut filled: usize = 0;
    let mut fill_failed: bool = false;
    while (filled < 4 && fill_failed == false) {
        let g12 = intrusive_pool_lock(&pool_r);
        let r12 = intrusive_pool_insert(&pool_r, g12);
        intrusive_pool_unlock(&pool_r, g12);
        match r12 {
            IntrusivePoolInsertResult::Allocated(o) => {
                intrusive_pool_ref(&pool_r, o).tag = filled + 1;
                intrusive_owner_drop(o);
                filled = filled + 1;
            }
            IntrusivePoolInsertResult::OutOfMemory => { fill_failed = true; }
        }
    }
    uart_puts("two chunks filled before the drain (live, chunks, pages): ");
    uart_print(intrusive_pool_live_count(&pool_r));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(page_allocator_live_count() - pages_before_reclaim);
    uart_puts("\n");

    // One slot address out of each of the two chunks, taken while both are
    // still live. After the drain exactly one chunk goes back to the
    // provider, and the addresses in it must stop validating the moment it
    // does -- which is the property the whole reclaim design rests on
    // (GitHub issues #346/#353), and since #349 it is the per-page
    // metadata being cleared that enforces it rather than a list the
    // address was removed from.
    let r_a0: usize = intrusive_pool_first_slot(&pool_r);
    let r_a1: usize = intrusive_pool_next_slot(&pool_r, r_a0);
    let r_b0: usize = intrusive_pool_next_slot(&pool_r, r_a1);
    let r_both_valid_before: bool =
        intrusive_pool_slot_is_valid(&pool_r, r_a0) &&
        intrusive_pool_slot_is_valid(&pool_r, r_b0);

    let mut draining: bool = true;
    while (draining) {
        let mut cursor: usize = intrusive_pool_first_slot(&pool_r);
        let mut freed_one: bool = false;
        while (cursor != 0 && freed_one == false) {
            // The other thing a scanning consumer does with what it
            // finds: rebuild the handle. The view carries the occupant
            // stamp the probe read, so this needs no second look at the
            // slot -- and no way to name a generation the pool did not
            // just report.
            match intrusive_pool_probe_slot(&pool_r, cursor) {
                IntrusiveSlotProbe::NoPayload => {
                    cursor = intrusive_pool_next_slot(&pool_r, cursor);
                }
                IntrusiveSlotProbe::Live(slot_view) => {
                    let occupant: usize = intrusive_view_generation(slot_view);
                    intrusive_view_drop(slot_view);
                    let victim = intrusive_owner_new(&pool_r, cursor, occupant);
                    let g13 = intrusive_pool_lock(&pool_r);
                    intrusive_pool_remove(&pool_r, g13, victim);
                    intrusive_pool_unlock(&pool_r, g13);
                    freed_one = true;
                }
            }
        }
        if (freed_one == false) { draining = false; }
    }
    uart_puts("draining gave one page back and kept one empty chunk in ");
    uart_puts("reserve (live, chunks, released, pages still held): ");
    uart_print(intrusive_pool_live_count(&pool_r));
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(intrusive_pool_released_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(page_allocator_live_count() - pages_before_reclaim);
    uart_puts("\n");

    // Both addresses validated before the drain; exactly one chunk went
    // back, so exactly one of them must validate now. A released page's
    // addresses being rejected IMMEDIATELY is what keeps a stale handle
    // into a reclaimed chunk from ever being dereferenced.
    let r_a_valid: bool = intrusive_pool_slot_is_valid(&pool_r, r_a0);
    let r_b_valid: bool = intrusive_pool_slot_is_valid(&pool_r, r_b0);
    uart_puts("the released chunk's addresses stop validating at once, and ");
    uart_puts("the retained one's do not (both before, exactly one after): ");
    uart_print_bool(r_both_valid_before);
    uart_puts(" ");
    uart_print_bool((r_a_valid && r_b_valid == false) ||
                    (r_a_valid == false && r_b_valid));
    uart_puts("\n");

    // The reserved chunk is the whole point of holding one back: this
    // allocation must not touch the page provider at all.
    let pages_before_reuse: usize = page_allocator_live_count();
    let g14 = intrusive_pool_lock(&pool_r);
    let r14 = intrusive_pool_insert(&pool_r, g14);
    intrusive_pool_unlock(&pool_r, g14);
    match r14 {
        IntrusivePoolInsertResult::Allocated(o) => {
            intrusive_owner_drop(o);
            uart_puts("reallocating after the drain reused the reserved ");
            uart_puts("chunk without asking for a page: ");
            uart_print_bool(page_allocator_live_count() == pages_before_reuse &&
                            intrusive_pool_chunk_count(&pool_r) == 1);
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_r reuse failed\n");
            return;
        }
    }

    // GitHub issue #354: reclaim on demand. Everything above is REACTIVE
    // -- a page went back only when a chunk happened to empty through an
    // ordinary free, and the reserve was unreachable by design. Under
    // memory pressure that is the wrong shape: every pool hoards its
    // reserve at exactly the moment memory is scarce.
    //
    // Drain the one live object so the chunk empties (and is retained,
    // since this pool keeps one), then ask for it back explicitly.
    let mut r_final: bool = true;
    while (r_final) {
        let mut cursor: usize = intrusive_pool_first_slot(&pool_r);
        let mut freed: bool = false;
        while (cursor != 0 && freed == false) {
            match intrusive_pool_probe_slot(&pool_r, cursor) {
                IntrusiveSlotProbe::NoPayload => {
                    cursor = intrusive_pool_next_slot(&pool_r, cursor);
                }
                IntrusiveSlotProbe::Live(slot_view) => {
                    let g: usize = intrusive_view_generation(slot_view);
                    intrusive_view_drop(slot_view);
                    let g15 = intrusive_pool_lock(&pool_r);
                    intrusive_pool_remove(&pool_r, g15, intrusive_owner_new(&pool_r, cursor, g));
                    intrusive_pool_unlock(&pool_r, g15);
                    freed = true;
                }
            }
        }
        if (freed == false) { r_final = false; }
    }
    let pages_before_reclaim_call: usize = page_allocator_live_count();
    let held_before: usize = intrusive_pool_empty_chunk_count(&pool_r);
    let g16 = intrusive_pool_lock(&pool_r);
    let r16 = intrusive_pool_reclaim(&pool_r, g16);
    intrusive_pool_unlock(&pool_r, g16);
    let reclaimed: usize = r16;
    uart_puts("reclaim hands back the retained reserve too (held before, ");
    uart_puts("pages returned, chunks left, provider delta): ");
    uart_print(held_before);
    uart_puts(" ");
    uart_print(reclaimed);
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_r));
    uart_puts(" ");
    uart_print(pages_before_reclaim_call - page_allocator_live_count());
    uart_puts("\n");

    // A pool told to retain nothing gives a page back the moment its
    // chunk empties, with no reclaim call at all -- the same mechanism,
    // driven by policy instead of by an explicit ask.
    let mut pool_z: IntrusivePool(usize);
    intrusive_pool_init_retaining(&pool_z, 0);
    let pages_before_z: usize = page_allocator_live_count();
    let g17 = intrusive_pool_lock(&pool_z);
    let r17 = intrusive_pool_insert(&pool_z, g17);
    intrusive_pool_unlock(&pool_z, g17);
    match r17 {
        IntrusivePoolInsertResult::Allocated(o) => {
            let z_grew: bool = page_allocator_live_count() == pages_before_z + 1;
            let g18 = intrusive_pool_lock(&pool_z);
            intrusive_pool_remove(&pool_z, g18, o);
            intrusive_pool_unlock(&pool_z, g18);
            uart_puts("a pool retaining 0 returns its page as soon as the ");
            uart_puts("chunk empties (grew, back to start, chunks, retained): ");
            uart_print_bool(z_grew);
            uart_puts(" ");
            uart_print_bool(page_allocator_live_count() == pages_before_z);
            uart_puts(" ");
            uart_print(intrusive_pool_chunk_count(&pool_z));
            uart_puts(" ");
            uart_print(intrusive_pool_retained_chunks(&pool_z));
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_z insert failed\n");
            return;
        }
    }

    if (intrusive_pool_probe(&pool_r) == false) { probes_ok = false; }
    probes_run = probes_run + 1;

    // -- pool_c: a corrupted free-chain word never becomes a returned
    // pointer (GitHub issue #352). This is the one exposure that involves
    // no handle at all: insert pops `free_head`, which is a pointer read
    // out of a free slot's own memory, so a single stray write into that
    // memory would otherwise steer the next allocation anywhere. An
    // array-indexed pool corrupted the same way yields a wrong INDEX,
    // which its own bounds check catches; the intrusive design is what
    // turns it into a wrong POINTER.
    let mut pool_c: IntrusivePool(usize);
    intrusive_pool_init(&pool_c);
    let g19 = intrusive_pool_lock(&pool_c);
    let r19 = intrusive_pool_insert(&pool_c, g19);
    intrusive_pool_unlock(&pool_c, g19);
    let c0 = match r19 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c insert 0 failed\n");
            return;
        }
    };
    // Kept live deliberately -- freeing it would push it back onto the
    // very chain this test is about to poison.
    intrusive_owner_drop(c0);

    // Slot #0 is the live one above, so slot #1 is free and is this
    // chunk's free_head. Scribble over its intrusive link, exactly as a
    // stray write into freed memory would.
    let c_slot0: usize = intrusive_pool_first_slot(&pool_c);
    let c_slot1: usize = intrusive_pool_next_slot(&pool_c, c_slot0);
    let poison: usize = 0x4141414141410;
    *intrusive_slot_link_at(&pool_c, c_slot1) = poison;

    // The poisoned slot is itself a perfectly legitimate free slot, so
    // this allocation must still succeed -- it is the one AFTER it that
    // pops the corrupted word.
    let g20 = intrusive_pool_lock(&pool_c);
    let r20 = intrusive_pool_insert(&pool_c, g20);
    intrusive_pool_unlock(&pool_c, g20);
    let c1 = match r20 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c insert 1 failed\n");
            return;
        }
    };
    uart_puts("the poisoned slot is itself still handed out normally: ");
    uart_print_bool(intrusive_owner_slot(c1) == c_slot1);
    uart_puts("\n");
    intrusive_owner_drop(c1);

    let corrupt_before: usize = intrusive_pool_corrupt_free_chain_count(&pool_c);
    let mut rejected: bool = false;
    let mut returned_poison: bool = false;
    let g21 = intrusive_pool_lock(&pool_c);
    let r21 = intrusive_pool_insert(&pool_c, g21);
    intrusive_pool_unlock(&pool_c, g21);
    match r21 {
        IntrusivePoolInsertResult::Allocated(o) => {
            if (intrusive_owner_slot(o) == poison) { returned_poison = true; }
            intrusive_owner_drop(o);
        }
        IntrusivePoolInsertResult::OutOfMemory => { rejected = true; }
    }
    uart_puts("a corrupted next_free is rejected, not returned ");
    uart_puts("(rejected, handed back the poison, counted): ");
    uart_print_bool(rejected);
    uart_puts(" ");
    uart_print_bool(returned_poison);
    uart_puts(" ");
    uart_print(intrusive_pool_corrupt_free_chain_count(&pool_c) - corrupt_before);
    uart_puts("\n");

    // Quarantine, not a dead pool: the poisoned chunk left the partial
    // list, so the next allocation comes from a fresh one.
    let pages_before_recovery: usize = page_allocator_live_count();
    let poisoned_base: usize = intrusive_chunk_base_of(c_slot0);
    let g22 = intrusive_pool_lock(&pool_c);
    let r22 = intrusive_pool_insert(&pool_c, g22);
    intrusive_pool_unlock(&pool_c, g22);
    match r22 {
        IntrusivePoolInsertResult::Allocated(o) => {
            let fresh: usize = intrusive_owner_slot(o);
            intrusive_owner_drop(o);
            uart_puts("the pool keeps working from a fresh chunk instead: ");
            uart_print_bool(page_allocator_live_count() == pages_before_recovery + 1 &&
                            intrusive_chunk_base_of(fresh) != poisoned_base);
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c recovery failed\n");
            return;
        }
    }

    // Emptying the poisoned chunk must not rehabilitate it. Freeing a slot
    // back into a chunk is the one path that re-links it onto the partial
    // list, and an emptied chunk is normally either held as the reserve or
    // handed back to the provider -- a quarantined chunk does none of the
    // three, so the corruption stays contained and stays visible.
    match intrusive_pool_probe_slot(&pool_c, c_slot0) {
        IntrusiveSlotProbe::NoPayload => {}
        IntrusiveSlotProbe::Live(slot_view) => {
            let occupant: usize = intrusive_view_generation(slot_view);
            intrusive_view_drop(slot_view);
            let g23 = intrusive_pool_lock(&pool_c);
            intrusive_pool_remove(&pool_c, g23, intrusive_owner_new(&pool_c, c_slot0, occupant));
            intrusive_pool_unlock(&pool_c, g23);
        }
    }
    match intrusive_pool_probe_slot(&pool_c, c_slot1) {
        IntrusiveSlotProbe::NoPayload => {}
        IntrusiveSlotProbe::Live(slot_view) => {
            let occupant: usize = intrusive_view_generation(slot_view);
            intrusive_view_drop(slot_view);
            let g24 = intrusive_pool_lock(&pool_c);
            intrusive_pool_remove(&pool_c, g24, intrusive_owner_new(&pool_c, c_slot1, occupant));
            intrusive_pool_unlock(&pool_c, g24);
        }
    }
    let g25 = intrusive_pool_lock(&pool_c);
    let r25 = intrusive_pool_insert(&pool_c, g25);
    intrusive_pool_unlock(&pool_c, g25);
    match r25 {
        IntrusivePoolInsertResult::Allocated(o) => {
            let after: usize = intrusive_owner_slot(o);
            intrusive_owner_drop(o);
            uart_puts("emptying it neither re-admits it nor returns its page ");
            uart_puts("(allocated elsewhere, chunks, released): ");
            uart_print_bool(intrusive_chunk_base_of(after) != poisoned_base);
            uart_puts(" ");
            uart_print(intrusive_pool_chunk_count(&pool_c));
            uart_puts(" ");
            uart_print(intrusive_pool_released_chunk_count(&pool_c));
            uart_puts("\n");
        }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c post-drain insert failed\n");
            return;
        }
    }

    // The quieter half of the same primitive: point the chain at a LIVE
    // slot of the same chunk instead of at garbage. That address is a
    // perfectly well-formed slot, so the arithmetic check alone would pass
    // it, and handing it out would not fault -- it would alias two owners
    // onto one slot. The generation word is what refuses it.
    //
    // Reuses the fresh chunk the recovery above already paid for (it is at
    // pool.chunk_head, so first_slot walks it), which is why this costs no
    // further page. Its slots #0 and #1 are the two live allocations made
    // above, and #2 is its current free_head.
    let live_slot: usize = intrusive_pool_first_slot(&pool_c);
    let live_next: usize = intrusive_pool_next_slot(&pool_c, live_slot);
    let free_head: usize = intrusive_pool_next_slot(&pool_c, live_next);
    let mut live_generation: usize = 0;
    match intrusive_pool_probe_slot(&pool_c, live_slot) {
        IntrusiveSlotProbe::NoPayload => {}
        IntrusiveSlotProbe::Live(slot_view) => {
            live_generation = intrusive_view_generation(slot_view);
            intrusive_view_drop(slot_view);
        }
    }
    uart_puts("the aliasing target really is a live slot in the fresh chunk: ");
    uart_print_bool(live_generation != 0 &&
                    intrusive_chunk_base_of(live_slot) != poisoned_base);
    uart_puts("\n");
    *intrusive_slot_link_at(&pool_c, free_head) = live_slot;

    let alias_before: usize = intrusive_pool_corrupt_free_chain_count(&pool_c);
    let g26 = intrusive_pool_lock(&pool_c);
    let r26 = intrusive_pool_insert(&pool_c, g26);
    intrusive_pool_unlock(&pool_c, g26);
    match r26 {
        IntrusivePoolInsertResult::Allocated(o) => { intrusive_owner_drop(o); }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_c alias setup insert failed\n");
            return;
        }
    }
    let mut alias_rejected: bool = false;
    let mut aliased: bool = false;
    let g27 = intrusive_pool_lock(&pool_c);
    let r27 = intrusive_pool_insert(&pool_c, g27);
    intrusive_pool_unlock(&pool_c, g27);
    match r27 {
        IntrusivePoolInsertResult::Allocated(o) => {
            if (intrusive_owner_slot(o) == live_slot) { aliased = true; }
            intrusive_owner_drop(o);
        }
        IntrusivePoolInsertResult::OutOfMemory => { alias_rejected = true; }
    }
    uart_puts("a chain pointing at a LIVE slot is refused, and its existing ");
    uart_puts("occupant is untouched (rejected, aliased, counted, occupant kept): ");
    uart_print_bool(alias_rejected);
    uart_puts(" ");
    uart_print_bool(aliased);
    uart_puts(" ");
    uart_print(intrusive_pool_corrupt_free_chain_count(&pool_c) - alias_before);
    uart_puts(" ");
    uart_print_bool(intrusive_pool_matches(&pool_c, live_slot, live_generation));
    uart_puts("\n");

    if (intrusive_pool_probe(&pool_c) == false) { probes_ok = false; }
    probes_run = probes_run + 1;

    // GitHub issue #355's other half: the dump. Formatted here rather
    // than in the core file, which stays free of an output dependency the
    // way kernel/lib/growable_pool.tkb does -- a pool primitive that can
    // only be inspected on a target with a working console is a worse
    // primitive.
    //
    // pool_c is the interesting pool to dump: one quarantined chunk that
    // will never allocate again and one healthy chunk, which is a state
    // no counter reports. Chunk indices rather than addresses, so this
    // says something about the pool instead of about where the binary
    // happened to put its pages.
    let mut dump_cursor: usize = intrusive_pool_first_chunk(&pool_c);
    let mut dump_index: usize = 0;
    while (dump_cursor != 0) {
        uart_puts("pool_c chunk ");
        uart_print(dump_index);
        uart_puts(": live ");
        uart_print(intrusive_chunk_live_count(&pool_c, dump_cursor));
        uart_puts(", free chain ");
        uart_print(intrusive_chunk_free_chain_length(&pool_c, dump_cursor));
        uart_puts(", on partial list ");
        uart_print_bool(intrusive_chunk_on_partial(&pool_c, dump_cursor));
        uart_puts(", quarantined ");
        uart_print_bool(intrusive_chunk_is_quarantined(&pool_c, dump_cursor));
        uart_puts("\n");
        dump_index = dump_index + 1;
        dump_cursor = intrusive_pool_next_chunk(&pool_c, dump_cursor);
    }

    // -- pool_u: what a freshly allocated payload actually contains
    // (GitHub issue #356). Reads the payload BEFORE writing it, which is
    // exactly what the contract forbids -- the point is to see what a
    // caller who breaks the rule would get, on a slot's first use and
    // again on its reuse.
    //
    // A 24-byte payload so the two regions are distinguishable: the first
    // word shares storage with the free-chain link (issue #348), the rest
    // does not.
    let mut pool_u: IntrusivePool(UninitProbe);
    intrusive_pool_init(&pool_u);
    let g28 = intrusive_pool_lock(&pool_u);
    let r28 = intrusive_pool_insert(&pool_u, g28);
    intrusive_pool_unlock(&pool_u, g28);
    let u0 = match r28 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_u insert failed\n");
            return;
        }
    };
    // What the pool itself put there, stated so it does not depend on
    // what the page provider happened to hand over: the first word is the
    // free-chain link this slot was carrying, which for the first slot
    // popped is the address of the second. Nothing else in the payload
    // was written by anyone -- deliberately, which is what the reuse case
    // below makes visible.
    let first_a: usize = intrusive_pool_ref(&pool_u, u0).a;
    let u_slot0: usize = intrusive_pool_first_slot(&pool_u);
    let u_slot1: usize = intrusive_pool_next_slot(&pool_u, u_slot0);
    uart_puts("first use of a slot: the payload's first word is the chain ");
    uart_puts("link it was carrying, not a blank: ");
    uart_print_bool(first_a == u_slot1 && first_a != 0);
    uart_puts("\n");

    let u0_slot: usize = intrusive_owner_slot(u0);
    intrusive_pool_ref(&pool_u, u0).a = 1;
    intrusive_pool_ref(&pool_u, u0).b = 2;
    intrusive_pool_ref(&pool_u, u0).c = 3;
    let g29 = intrusive_pool_lock(&pool_u);
    intrusive_pool_remove(&pool_u, g29, u0);
    intrusive_pool_unlock(&pool_u, g29);
    let g30 = intrusive_pool_lock(&pool_u);
    let r30 = intrusive_pool_insert(&pool_u, g30);
    intrusive_pool_unlock(&pool_u, g30);
    let u1 = match r30 {
        IntrusivePoolInsertResult::Allocated(o) => { o }
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("pool_u reinsert failed\n");
            return;
        }
    };
    uart_puts("reuse of that same slot: previous occupant survives past the ");
    uart_puts("link word (same slot, b == 2, c == 3): ");
    uart_print_bool(intrusive_owner_slot(u1) == u0_slot);
    uart_puts(" ");
    uart_print_bool(intrusive_pool_ref(&pool_u, u1).b == 2);
    uart_puts(" ");
    uart_print_bool(intrusive_pool_ref(&pool_u, u1).c == 3);
    uart_puts("\n");
    intrusive_owner_drop(u1);

    if (intrusive_pool_probe(&pool_u) == false) { probes_ok = false; }
    probes_run = probes_run + 1;

    // GitHub issue #361: validation no longer computes its bounds from
    // anything a stray write can reach. It used to read `slot_stride` and
    // `slot_count` out of the chunk header, so a header corrupted to
    // stride 1 would have made almost every address in the page look
    // slot-aligned -- the check meant to catch stray writes weakened by
    // one. Both are compile-time constants after monomorphization, so
    // they are derived now and simply not stored.
    //
    // Scribbling over every remaining header field except `pool_tag`
    // (which is the ownership question, not the bounds question) must
    // therefore change no answer. pool_u is finished with by this point,
    // so its chunk is free to wreck.
    let u_base: usize = intrusive_chunk_base_of(u0_slot);
    let u_header: *IntrusiveChunkHeader = intrusive_chunk_header_at(u_base);
    u_header.next_chunk = 1;
    u_header.prev_chunk = 1;
    u_header.next_partial = 1;
    u_header.prev_partial = 1;
    u_header.on_partial = 1;
    u_header.free_head = 1;
    u_header.live_count = 0xFFFF;
    uart_puts("a wrecked chunk header cannot widen what validates ");
    uart_puts("(real slot yes, off-by-one no, past the chunk no): ");
    uart_print_bool(intrusive_pool_slot_is_valid(&pool_u, u0_slot));
    uart_puts(" ");
    uart_print_bool(intrusive_pool_slot_is_valid(&pool_u, u0_slot + 1) == false);
    uart_puts(" ");
    uart_print_bool(
        intrusive_pool_slot_is_valid(&pool_u, u_base + PAGE_SIZE) == false);
    uart_puts("\n");

    // GitHub issue #355: and the probe must SAY so, having survived
    // walking the wreckage. A diagnostic that faults on a damaged pool is
    // no diagnostic, since a damaged pool is the only reason to run one --
    // an earlier draft of the probe followed the corrupted next_chunk link
    // above straight into a null dereference.
    uart_puts("the invariant probe reports the wrecked chunk and survives ");
    uart_puts("walking it: ");
    uart_print_bool(intrusive_pool_probe(&pool_u) == false);
    uart_puts("\n");

    // -- pool_x: the last remaining ceiling is the page provider's.
    let mut pool_x: IntrusivePool(BigPayload);
    intrusive_pool_init(&pool_x);
    let mut placed: usize = 0;
    let mut hit_provider_limit: bool = false;
    while (hit_provider_limit == false) {
        let g31 = intrusive_pool_lock(&pool_x);
        let r31 = intrusive_pool_insert(&pool_x, g31);
        intrusive_pool_unlock(&pool_x, g31);
        match r31 {
            IntrusivePoolInsertResult::Allocated(o) => {
                intrusive_pool_ref(&pool_x, o).tag = placed + 1;
                intrusive_owner_drop(o);
                placed = placed + 1;
            }
            IntrusivePoolInsertResult::OutOfMemory => { hit_provider_limit = true; }
        }
    }
    uart_puts("1960-byte objects placed before the PROVIDER ran out ");
    uart_puts("(objects, chunks, pages left): ");
    uart_print(placed);
    uart_puts(" ");
    uart_print(intrusive_pool_chunk_count(&pool_x));
    uart_puts(" ");
    uart_print(PAGE_COUNT - page_allocator_live_count());
    uart_puts("\n");

    if (intrusive_pool_probe(&pool_x) == false) { probes_ok = false; }
    probes_run = probes_run + 1;
    uart_puts("every phase left its pool's own bookkeeping coherent ");
    uart_puts("(all passed, phases checked): ");
    uart_print_bool(probes_ok);
    uart_puts(" ");
    uart_print(probes_run);
    uart_puts("\n");

    // -- GitHub issue #365: what the guard type cannot see.
    //
    // #351 made forgetting the lock a compile error. Two mistakes survive
    // that and only a RUNNING lock reveals them -- by hanging, which is
    // the worst way to learn. The linux_user lock body checks for both;
    // a kernel build supplies a different body and pays nothing.
    //
    // Everything above ran through the same checker, so these counts
    // start from whatever the rest of this file did -- which is the first
    // thing worth asserting.
    uart_puts("every lock above was balanced, singly held and consistently ");
    uart_puts("ordered (reentrant, order violations, unbalanced, still held, ");
    uart_puts("untracked): ");
    uart_print(pool_lock_reentrant_count());
    uart_puts(" ");
    uart_print(pool_lock_order_violation_count());
    uart_puts(" ");
    uart_print(pool_lock_unbalanced_count());
    uart_puts(" ");
    uart_print(pool_lock_held_depth_now());
    uart_puts(" ");
    uart_print(pool_lock_untracked_count());
    uart_puts("\n");

    // Re-entrancy: the same pool's guard twice on one path. A compile
    // error cannot see this -- both acquires are individually correct --
    // and a real spinlock would deadlock here.
    let reentrant_before: usize = pool_lock_reentrant_count();
    let ra = intrusive_pool_lock(&pool_a);
    let rb = intrusive_pool_lock(&pool_a);
    intrusive_pool_unlock(&pool_a, rb);
    intrusive_pool_unlock(&pool_a, ra);
    uart_puts("taking one pool's guard twice on a path is caught: ");
    uart_print_bool(pool_lock_reentrant_count() == reentrant_before + 1);
    uart_puts("\n");

    // Lock ORDER. Neither site below is wrong on its own; the pair is.
    // First establish a-then-b as the order this program uses...
    let order_before: usize = pool_lock_order_violation_count();
    let oa = intrusive_pool_lock(&pool_a);
    let ob = intrusive_pool_lock(&pool_b);
    intrusive_pool_unlock(&pool_b, ob);
    intrusive_pool_unlock(&pool_a, oa);
    // ...then repeat it, which must NOT be reported. A checker that fires
    // on correct code is worse than none.
    let oa2 = intrusive_pool_lock(&pool_a);
    let ob2 = intrusive_pool_lock(&pool_b);
    intrusive_pool_unlock(&pool_b, ob2);
    intrusive_pool_unlock(&pool_a, oa2);
    let consistent_ok: bool =
        pool_lock_order_violation_count() == order_before;
    // ...and only now take them the other way round.
    let ob3 = intrusive_pool_lock(&pool_b);
    let oa3 = intrusive_pool_lock(&pool_a);
    intrusive_pool_unlock(&pool_a, oa3);
    intrusive_pool_unlock(&pool_b, ob3);
    uart_puts("the same two pools in a consistent order are not reported, ");
    uart_puts("the reversed pair is (consistent quiet, reversal caught): ");
    uart_print_bool(consistent_ok);
    uart_puts(" ");
    uart_print_bool(pool_lock_order_violation_count() == order_before + 1);
    uart_puts("\n");

    uart_puts("done\n");
}

// GitHub issue #351: the pool is usable from an interrupt handler, and
// this is here so that stops being a claim in a comment. The lock this
// design calls for masks interrupts rather than sleeping, so it composes
// with `!{interrupt}` -- SPEC.md's rule that an interrupt root's
// reachable call graph must not contain `may_block` is exactly what
// would have rejected a sleeping one, and marking the lock `!{may_block}`
// is the alternative this design deliberately did not take.
//
// The four ways to get the discipline WRONG are compile errors and so
// cannot live here; they are in the commit message and the issue:
// unguarded mutation is a missing argument, another pool's guard is a
// static value mismatch, never releasing is an unconsumed linear value,
// and releasing on only one path is caught at the return.
private let mut irq_reachable_pool: IntrusivePool(usize);

fn irq_reachable_probe() !{interrupt, unsafe} {
    let g = intrusive_pool_lock(&irq_reachable_pool);
    match intrusive_pool_insert(&irq_reachable_pool, g) {
        IntrusivePoolInsertResult::Allocated(o) => { intrusive_owner_drop(o); }
        IntrusivePoolInsertResult::OutOfMemory => {}
    }
    intrusive_pool_unlock(&irq_reachable_pool, g);
}

fn uart_print_bool(value: bool) {
    if (value) {
        uart_puts("true");
    } else {
        uart_puts("false");
    }
}
