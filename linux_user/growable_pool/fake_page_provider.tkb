// Small fixed-page allocator standing in for kernel/mm/page.tkb's real
// physical pages (not available in this host-native environment). Exposes
// exactly the subset of that file's public API its consumers need --
// PageOwner[page]/PageAllocResult/page_alloc/page_allocator_init/
// page_physical_address/page_owner_transfer_index/
// page_transferred_release_physical/page_allocator_live_count, same names
// and shapes -- so growable_pool_core.tkb's own source ports to
// kernel/lib/growable_pool.tkb unchanged except for this file's `use` line
// being swapped for "kernel/mm/page.tkb" (see that file for the real
// implementation this one deliberately mirrors).
use "kernel/lib/slotmap.tkb";
use "kernel/lib/freelist.tkb";

const PAGE_SIZE: usize = 4096;
// GitHub issue #350: a chunk is up to INTRUSIVE_MAX_CHUNK_PAGES (8)
// pages, aligned to its own size, so the arena has to be able to hold
// several of them AND to start on a 32768-byte boundary. Nine pages was
// enough while every chunk was one page; it cannot express the thing this
// stand-in now exists to exercise.
const PAGE_COUNT: usize = 64;

// GitHub issue #349, resized for kernel scale (issue #353): per-page
// storage whose MEANING belongs to whoever currently holds the page --
// `struct page`'s shape -- reserved at the END OF THE PAGE ITSELF rather
// than in a side array indexed by page number.
//
// The side array was the first design and it does not survive contact
// with a real kernel. kernel/mm/page.tkb manages 204800 pages, so a
// 128-byte side entry per page is 25 MB of BSS reserved whether or not
// anything is ever pooled. In-page costs 128 bytes per page that is
// ACTUALLY a chunk, and the kernel's pooled types (ProcessRecord x16,
// TcpConnectionStore x2, ...) come to a handful of pages. Break-even is
// around 115200 chunk pages -- 450 MB of pooled memory -- so the side
// array is right only in a world where nearly every page is a chunk,
// which is exactly the 9-page world this prototype started in and not
// the one it is a prototype OF.
//
// GitHub issue #390: THE RESERVATION IS GONE HERE TOO, because it is gone
// in kernel/mm/page.tkb. This stand-in and the kernel deliberately use the
// same placement -- a prototype exercising a layout the kernel does not
// use is issue #366's drift one level down -- so "no reservation at all"
// has to be mirrored exactly like "the tail of the page" was.
//
// What issue #349 durably bought was never the placement but the
// ABSTRACTION: where a pool's metadata lives is the provider's policy, and
// a provider is free to have none. kernel/lib/intrusive_pool.tkb keeps its
// chunk header inside the chunk since #350 and asks no provider anything.
//
// Aligned to 16 pages rather than 1 (GitHub issue #363). A run's
// alignment can only ever be as strong as the arena it is carved from,
// and this arena is a BSS array rather than real physical memory -- ask
// for a 4-page-aligned run out of a merely page-aligned array and the
// answer is arithmetically impossible, not merely unavailable. A real
// page allocator does not have this problem because page 0 sits at a
// known physical address; a stand-in has to say so out loud.
private let mut fake_pages: [u8; PAGE_SIZE * PAGE_COUNT] align(65536);   // 16 pages

// GitHub issue #363: occupancy is an array INDEXED BY PAGE NUMBER, not a
// free list, and that is the whole point rather than an implementation
// detail.
//
// A free list can only answer "give me some free page". It has no way to
// express "give me page 6", and therefore no way to find `n` free pages
// that happen to be adjacent -- so an allocator built on one cannot
// serve a contiguous request at all. That is not a limitation of this
// stand-in: `kernel/mm/page.tkb` is `FreelistCore(BOOT_PAGE_COUNT)` and
// has exactly the same hole, which is why every DMA buffer in the kernel
// is a static BSS array today.
//
// It is also why real kernels use a buddy allocator here rather than a
// list: bolting "claim this specific index" onto a singly-linked free
// chain costs an O(N) walk per page claimed, and a bitmap scan makes the
// single-page path O(N) instead of O(1). Buddy is the structure that
// makes both O(log N) and hands back naturally-aligned runs for free.
// This prototype scans, because at PAGE_COUNT pages the constant factor
// is irrelevant and the API is what needs proving; the real allocator
// should not.
//
// 0 means free. A nonzero generation is the occupant stamp, kept because
// it is what makes a stale PageOwner detectable -- the same role
// SlotMap's occupant_generation played before this file stopped being
// able to use it.
private let mut fake_page_generation: [usize; PAGE_COUNT];
// Nonzero on every page of a multi-page run, holding that run's length,
// so a page belonging to a run cannot be released as if it were single.
private let mut fake_page_run_length: [usize; PAGE_COUNT];
// GitHub issue #384: who the page was handed to. The real provider keeps
// this in PageMeta; here it is its own array, because this stand-in has
// no PageMeta. What matters is that page_owner_tag_at answers the same
// question with the same values, since kernel/lib/intrusive_pool.tkb
// validates a chunk base through it before dereferencing anything.
private let mut fake_page_owner: [PageOwnerTag; PAGE_COUNT];
private let mut fake_page_next_generation: usize = 1;
private let mut fake_page_live: usize = 0;

linear struct PageOwner[page: usize] {
    private index: {0..<PAGE_COUNT as usize};
    private generation: usize @ page;
}

must_use variant PageAllocResult {
    OutOfMemory;
    Allocated(exists page: usize. PageOwner[page]);
}

fn page_owner_new(index: {0..<PAGE_COUNT as usize},
                  generation: usize @ page) -> PageOwner[page] {
    let mut owner: PageOwner[page] = { index, generation };
    return owner;
}

fn page_allocator_init() {
    for i: usize in 0..<PAGE_COUNT {
        fake_page_generation[i] = 0;
        fake_page_run_length[i] = 0;
        fake_page_owner[i] = PageOwnerTag::Unowned;
    }
    fake_page_next_generation = 1;
    fake_page_live = 0;
}

private fn fake_page_claim(index: {0..<PAGE_COUNT as usize},
                           owner: PageOwnerTag) -> usize {
    let generation: usize = fake_page_next_generation;
    fake_page_next_generation = generation + 1;
    fake_page_generation[index] = generation;
    fake_page_owner[index] = owner;
    fake_page_live = fake_page_live + 1;
    return generation;
}

// GitHub issue #384: the real page.tkb requires every allocation to name
// its owner, so this stand-in requires it too. It does not RECORD the tag
// -- nothing here reports a fault -- but it has to demand the same
// argument, or a kernel/lib file compiled against this provider would
// type-check with a call the real provider rejects. Issue #366's fossil
// is what a stand-in that drifts from its original looks like.
enum PageOwnerTag: u8 {
    Unowned;
    PageTable;
    UserPage;
    PoolChunk;
    KernelStack;
}

fn page_alloc(owner: PageOwnerTag) -> PageAllocResult {
    for i: usize in 0..<PAGE_COUNT {
        if (fake_page_generation[i] == 0) {
            let checked: {0..<PAGE_COUNT as usize} = i;
            let generation: usize = fake_page_claim(checked, owner);
            return PageAllocResult::Allocated(page_owner_new(checked, generation));
        }
    }
    return PageAllocResult::OutOfMemory;
}

fn page_physical_address(owner: borrow PageOwner[page]) -> usize {
    let base: usize = (fake_pages as *u8) as usize;
    return base + owner.index * PAGE_SIZE;
}

// Transfers per-page responsibility to a coarser owner (here,
// growable_pool_core.tkb's own chunk bookkeeping), matching page.tkb's own
// page_owner_transfer_index -- the caller keeps only the index from this
// point on, never the generation.
fn page_owner_transfer_index(owner: sink PageOwner[page])
        -> {0..<PAGE_COUNT as usize} {
    return owner.index;
}

// Returns a page whose per-page ownership was handed off to a coarser
// owner via page_owner_transfer_index (so the caller kept only the
// address, not the PageOwner). Mirrors kernel/mm/page.tkb's own
// page_transferred_release_physical, same name and same
// plain-physical-address argument, so a file prototyped against this
// provider still ports there by swapping one `use` line. Added for
// GitHub issue #346, the first caller that ever gives a page back.
fn page_transferred_release_physical(physical: usize) !{unsafe} {
    let base: usize = (fake_pages as *u8) as usize;
    let pool_bytes: usize = PAGE_SIZE * PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return;
    }
    let index: usize = (physical - base) / PAGE_SIZE;
    // The range check above bounds this, but through a division the
    // checker cannot see it -- so say it, and let the guard narrow the
    // binding for the three indexings below.
    if (index >= PAGE_COUNT) { return; }
    // Already free: a double release, ignored rather than acted on, the
    // same stance slotmap_remove's own double-free path takes.
    if (fake_page_generation[index] == 0) { return; }
    // Part of a contiguous run (issue #363), which must be released as
    // the unit it was allocated as -- releasing one page out of the
    // middle would leave the rest owned by a PageRunOwner that no longer
    // describes reality.
    if (fake_page_run_length[index] != 0) { return; }
    fake_page_generation[index] = 0;
    fake_page_live = fake_page_live - 1;
}

// Mirrors kernel/mm/page.tkb's page_bytes: the page's own storage as a
// length-refined slice branded to the page it came from, so a caller
// cannot pass one page's owner and another page's bytes.
fn page_bytes(owner: borrow PageOwner[page]) -> [u8; PAGE_SIZE..] @ page !{unsafe} {
    let base_address: usize = (fake_pages as *u8) as usize;
    let address: usize = base_address + owner.index * PAGE_SIZE;
    let base: *u8 = unsafe { address as *u8 };
    // Bare literals rather than `PAGE_SIZE as isize`, for the reason
    // page.tkb's own copy gives: a Cast node defeats Const_env's folding
    // and the result decays to an unrefined []u8. Must stay numerically
    // equal to PAGE_SIZE.
    let bytes: [u8; PAGE_SIZE..] = unsafe { base[0..<4096] };
    return bytes;
}

fn page_allocator_live_count() -> usize {
    return fake_page_live;
}

// GitHub issue #384: who holds the page an arbitrary address falls in.
// Same contract as the real provider's: any address, not a page-aligned
// one, and Unowned for anything that is not a live page of this
// allocator's. kernel/lib/intrusive_pool.tkb validates a chunk base
// through this before dereferencing a header inside it, so a stand-in
// that answered loosely would let the prototype pass a check the kernel
// fails.
fn page_owner_tag_at(address: usize) -> PageOwnerTag {
    let base: usize = (fake_pages as *u8) as usize;
    let pool_bytes: usize = PAGE_SIZE * PAGE_COUNT;
    if (address < base || address >= base + pool_bytes) {
        return PageOwnerTag::Unowned;
    }
    let index: usize = (address - base) / PAGE_SIZE;
    if (index >= PAGE_COUNT) { return PageOwnerTag::Unowned; }
    let checked: {0..<PAGE_COUNT as usize} = index;
    if (fake_page_generation[checked] == 0) { return PageOwnerTag::Unowned; }
    return fake_page_owner[checked];
}

// -- Contiguous runs ---------------------------------------------------
// THE DMA BUFFER INVENTORY this replaces, recorded so the next reader
// knows which static arrays are workarounds and which are simply right
// (GitHub issue #363's own acceptance criterion):
//
//   virtio_net rx_queue_mem      8 KB, 2 pages  -- wants this
//   virtio_net tx_queue_mem      8 KB, 2 pages  -- wants this
//   virtio_blk virtio_blk_queue  8 KB, 2 pages  -- wants this
//   usb_xhci   msc_bounce_buf   64 KB, 16 pages -- wants this
//   usb_xhci   scratchpad_buf0/1 4 KB each      -- wants page_alloc(),
//       not contiguity: the COUNT is what should be dynamic, since it
//       comes from HCSPARAMS2 and the driver hardcodes two
//   rp1_gem    descriptors and buffers, <= 2 KB -- static is right, one
//       device, one fixed ring
//   virtio_net tx_ready_buf      1526 B          -- static is right
//
// None of these are converted here; that is per-driver work and is
// deliberately out of this issue's scope. What is in scope is that the
// capability now exists, so "static because the allocator cannot" stops
// being the reason.

// GitHub issue #363. DMA does not want "some pages"; it wants N pages the
// device can walk as one physical range, aligned the way the device
// demands. This kernel already needs four such buffers -- both virtio
// queues at 8 KB, the virtio-blk queue at 8 KB, and usb_xhci's 64 KB
// bounce buffer -- and meets all four with static BSS arrays, because
// page_alloc() hands out one page at a time and nothing else.
//
// `align_pages` is in PAGES and must be a power of two; 1 means "anywhere".
// It also covers the "must not cross a boundary" constraint several
// controllers impose, without a second parameter: a run placed at a
// multiple of its own rounded-up size cannot straddle a boundary of that
// size. Ask for alignment >= the run length and the boundary question
// answers itself.
//
// First fit, which is honest about what it gives: a run IS aligned when
// one was asked for, but unlike a buddy allocator it does not hand back
// naturally-aligned runs for free. That distinction matters to issue
// #350, whose O(1) address-to-chunk step needs chunks aligned to their
// own size -- under this allocator that is something the caller must
// request, not something it inherits.

linear struct PageRunOwner[run: usize] {
    private index: {0..<PAGE_COUNT as usize};
    private count: usize;
    private generation: usize @ run;
}

must_use variant PageRunAllocResult {
    OutOfMemory;
    Allocated(exists run: usize. PageRunOwner[run]);
}

private fn page_run_owner_new(index: {0..<PAGE_COUNT as usize}, count: usize,
                              generation: usize @ run) -> PageRunOwner[run] {
    let mut owner: PageRunOwner[run] = { index, count, generation };
    return owner;
}

// Is a run of `count` pages starting at `start` entirely free?
private fn fake_page_run_is_free(start: usize, count: usize) -> bool {
    if (start + count > PAGE_COUNT) { return false; }
    for i: usize in 0..<PAGE_COUNT {
        if (i >= start && i < start + count) {
            if (fake_page_generation[i] != 0) { return false; }
        }
    }
    return true;
}

// GitHub issue #350: the real provider's name and contract --
// page_alloc_contiguous(count, owner), aligned to `count * PAGE_SIZE`
// when `count` is a power of two, with no separate alignment argument.
// The earlier page_run_alloc(count, align_pages) let a caller ASK for
// alignment; the kernel's does not, because a consumer that has to ask is
// a consumer that can forget, and intrusive_pool's O(1)
// address-to-chunk step depends on the alignment being unconditional.
fn page_alloc_contiguous(count: usize, owner: PageOwnerTag)
        -> PageRunAllocResult {
    return fake_page_run_alloc(count, count, owner);
}

private fn fake_page_run_alloc(count: usize, align_pages: usize,
                               owner: PageOwnerTag) -> PageRunAllocResult {
    if (count == 0 || align_pages == 0 || count > PAGE_COUNT) {
        return PageRunAllocResult::OutOfMemory;
    }
    for start: usize in 0..<PAGE_COUNT {
        if (start % align_pages == 0 && fake_page_run_is_free(start, count)) {
            // One generation for the whole run: the pages are handed out
            // and taken back together, so they share one occupant stamp,
            // and PageRunOwner carries it exactly as PageOwner does.
            let generation: usize = fake_page_next_generation;
            fake_page_next_generation = generation + 1;
            for i: usize in 0..<PAGE_COUNT {
                if (i >= start && i < start + count) {
                    fake_page_generation[i] = generation;
                    fake_page_run_length[i] = count;
                    fake_page_owner[i] = owner;
                }
            }
            fake_page_live = fake_page_live + count;
            let checked: {0..<PAGE_COUNT as usize} = start;
            return PageRunAllocResult::Allocated(
                page_run_owner_new(checked, count, generation));
        }
    }
    return PageRunAllocResult::OutOfMemory;
}

fn page_run_physical_address(owner: borrow PageRunOwner[run]) -> usize {
    let base: usize = (fake_pages as *u8) as usize;
    return base + owner.index * PAGE_SIZE;
}

fn page_run_count(owner: borrow PageRunOwner[run]) -> usize {
    return owner.count;
}

// The run-sized twin of page_owner_transfer_index, same name and shape as
// the real provider's: a holder keeping the run for as long as it lives
// has nothing to do with a linear value it can never give back, and a
// linear value cannot live in an array.
fn page_run_owner_transfer_index(owner: sink PageRunOwner[run])
        -> {0..<PAGE_COUNT as usize} {
    return owner.index;
}

// Releases the whole run, which is the only granularity this owner can
// express -- and page_transferred_release_physical refuses a page that
// belongs to one, so there is no way to take a run apart by halves.
fn page_run_free(owner: sink PageRunOwner[run]) {
    fake_page_run_release(owner.index, owner.count);
}

// Give back a run whose linear owner was consumed at allocation, named by
// base address and page count. The real provider's
// page_run_transferred_release_physical, same name and shape.
fn page_run_transferred_release_physical(physical: usize, count: usize)
        !{unsafe} {
    let base: usize = (fake_pages as *u8) as usize;
    let pool_bytes: usize = PAGE_SIZE * PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return;
    }
    fake_page_run_release((physical - base) / PAGE_SIZE, count);
}

private fn fake_page_run_release(start: usize, count: usize) !{unsafe} {
    for i: usize in 0..<PAGE_COUNT {
        if (i >= start && i < start + count) {
            if (fake_page_generation[i] != 0) {
                fake_page_generation[i] = 0;
                fake_page_run_length[i] = 0;
                fake_page_owner[i] = PageOwnerTag::Unowned;
                fake_page_live = fake_page_live - 1;
            }
        }
    }
}

