// Focused malformed-ELF tests for the common and maintained kernel validators.
// The fixture builds with --forbid-trap and performs no ELF loading.

use "linux_user/common/elf64_validate.tkb";
use "kernel/fs/elf64.tkb";

private let mut image: [u8; 256] align(8);

fn put_u16(offset: usize, value: u16) {
    let p: *u8 = image as *u8;
    p[offset as isize] = value as u8;
    p[(offset + 1) as isize] = (value >> 8) as u8;
}

fn put_u32(offset: usize, value: u32) {
    let p: *u8 = image as *u8;
    for i: usize in 0..<4 {
        p[(offset + i) as isize] = (value >> ((i * 8) as u32)) as u8;
    }
}

fn put_u64(offset: usize, value: u64) {
    let p: *u8 = image as *u8;
    for i: usize in 0..<8 {
        p[(offset + i) as isize] = (value >> ((i * 8) as u64)) as u8;
    }
}

fn valid_image_init() {
    for i: usize in 0..<256 {
        image[i] = 0;
    }
    image[0] = 0x7F;
    image[1] = 0x45;
    image[2] = 0x4C;
    image[3] = 0x46;
    image[4] = 2;
    image[5] = 1;
    image[6] = 1;
    put_u16(16, 3);       // ET_DYN
    put_u16(18, 183);     // EM_AARCH64
    put_u32(20, 1);
    put_u64(24, 0);       // entry
    put_u64(32, 64);      // program-header table
    put_u16(52, 64);
    put_u16(54, 56);
    put_u16(56, 1);

    put_u32(64, 1);       // PT_LOAD
    put_u64(72, 128);     // p_offset
    put_u64(80, 0);       // p_vaddr
    put_u64(96, 16);      // p_filesz
    put_u64(104, 16);     // p_memsz
    put_u64(112, 8);      // p_align
}

fn print_result(label: *u8, expected_valid: bool, image_len: usize) {
    uart_puts(label);
    let result: Elf64Validation = elf64_validate_load(
        image as usize, image_len, 0x40000000);
    match result {
        Elf64Validation::Invalid => {
            if (expected_valid == false) { uart_puts("PASS\n"); }
            else { uart_puts("FAIL\n"); }
        }
        Elf64Validation::Valid(info) => {
            if (expected_valid == true) { uart_puts("PASS\n"); }
            else { uart_puts("FAIL\n"); }
        }
    }
    // Run the same input through the maintained kernel implementation too.
    // Its program-count limit is 16, rather than the common validator's 8;
    // the nine-entry fixture below lacks a complete table in either case.
    uart_puts("kernel ");
    uart_puts(label);
    let bytes = image as []u8;
    if (image_len > bytes.len) { uart_puts("FAIL\n"); return; }
    let checked = bytes[0..<image_len];
    match distro_elf_validate_with_length(checked, image_len) {
        DistroElfResult::Invalid => {
            if (expected_valid == false) { uart_puts("PASS\n"); }
            else { uart_puts("FAIL\n"); }
        }
        DistroElfResult::Valid(plan) => {
            if (expected_valid) { uart_puts("PASS\n"); }
            else { uart_puts("FAIL\n"); }
        }
    }
}

// Execute the production mint's packed record copies and prove that later
// source edits cannot change the returned header values.
fn kernel_header_copy_probe() {
    valid_image_init();
    let mut header: KernelElf64Header =
        kernel_elf_header_copy(image[0..<64]);
    let mut program: KernelElf64ProgramHeader =
        kernel_elf_program_header_copy(image[64..<120]);
    put_u16(16, 0);
    put_u64(96, 99);
    let ok: bool = header.ident[0] == 0x7f && header.object_type == 3 &&
        header.machine == 183 && header.program_offset == 64 &&
        program.segment_type == 1 && program.file_size == 16;
    if (ok) { uart_puts("kernel header copies: PASS\n"); }
    else { uart_puts("kernel header copies: FAIL\n"); }
}

fn app_main() {
    valid_image_init();
    print_result("valid: ", true, 256);

    valid_image_init();
    print_result("truncated header: ", false, 63);

    valid_image_init();
    print_result("empty header: ", false, 0);

    valid_image_init();
    print_result("truncated program header: ", false, 119);

    valid_image_init();
    put_u64(32, 240);
    print_result("phoff outside table: ", false, 256);

    valid_image_init();
    put_u16(54, 55);
    print_result("bad phentsize: ", false, 256);

    valid_image_init();
    put_u16(56, 9);
    print_result("too many phdrs: ", false, 256);

    valid_image_init();
    put_u64(96, 17);
    print_result("filesz over memsz: ", false, 256);

    valid_image_init();
    put_u64(80, 0xFFFFFFFFFFFFFFF8);
    put_u64(104, 16);
    print_result("wrapped segment extent: ", false, 256);

    valid_image_init();
    put_u64(112, 3);
    print_result("non-power-two align: ", false, 256);

    valid_image_init();
    put_u64(80, 1);
    print_result("incongruent alignment: ", false, 256);

    valid_image_init();
    put_u64(112, 0);
    print_result("zero alignment: ", true, 256);

    valid_image_init();
    put_u64(112, 1);
    print_result("unit alignment: ", true, 256);
    kernel_header_copy_probe();
}
