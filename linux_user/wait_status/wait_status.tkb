// GitHub issue #882: the kernel's wait4 status word, against Linux's own.
//
// The kernel used to record a signal's end as exit code 128+signal, a
// shell's $? convention, and wait4 encoded it as an exit: WIFSIGNALED was
// false and WEXITSTATUS was 143 for a SIGTERM-killed child. A kernel
// fixture then accepted that form as "this kernel's" and nothing compared
// it with Linux. Here the host Linux is the reference: a forked child
// kills itself (no timing involved) or exits, and the status word the host
// wait4 returns must equal the one kernel/kernel/wait_status.tkb encodes.
extern fn linux_syscall(nr: usize, a0: usize, a1: usize, a2: usize, a3: usize) -> isize;

const X86_64_NR_GETPID: usize = 39;
const X86_64_NR_FORK: usize = 57;
const X86_64_NR_EXIT: usize = 60;
const X86_64_NR_WAIT4: usize = 61;
const X86_64_NR_KILL: usize = 62;
const X86_64_NR_RT_SIGPROCMASK: usize = 14;
const X86_64_NR_RT_SIGTIMEDWAIT: usize = 128;
const SIGCHLD_SET: usize = 0x10000; // 1 << (SIGCHLD - 1)

// Forks a child that ends by `signal` when it is nonzero, else by exit
// `code`, and returns the host's wait4 status word for it.
fn host_status(signal: usize, code: usize) -> u32 {
    let child: isize = linux_syscall(X86_64_NR_FORK, 0, 0, 0, 0);
    if (child == 0) {
        if (signal != 0) {
            let me: isize = linux_syscall(X86_64_NR_GETPID, 0, 0, 0, 0);
            linux_syscall(X86_64_NR_KILL, me as usize, signal, 0, 0);
        }
        linux_syscall(X86_64_NR_EXIT, code, 0, 0, 0);
    }
    let mut word: u32 = 0xFFFFFFFF;
    let reaped: isize = linux_syscall(X86_64_NR_WAIT4, child as usize,
                                      &word as usize, 0, 0);
    if (reaped != child) { return 0xFFFFFFFF; }
    return word;
}

// GitHub issue #885: the SIGCHLD siginfo the host queues for a child that
// ends by `signal` (nonzero) or exit `code`, taken synchronously with
// SIGCHLD blocked and rt_sigtimedwait, so no handler or timing is
// involved. Returns si_code << 8 | si_status, or all ones when the
// siginfo does not name the child.
fn host_sigchld(signal: usize, code: usize) -> u32 {
    let mut set: usize = SIGCHLD_SET;
    linux_syscall(X86_64_NR_RT_SIGPROCMASK, 0, &set as usize, 0, 8);
    let child: isize = linux_syscall(X86_64_NR_FORK, 0, 0, 0, 0);
    if (child == 0) {
        if (signal != 0) {
            let me: isize = linux_syscall(X86_64_NR_GETPID, 0, 0, 0, 0);
            linux_syscall(X86_64_NR_KILL, me as usize, signal, 0, 0);
        }
        linux_syscall(X86_64_NR_EXIT, code, 0, 0, 0);
    }
    // siginfo: si_signo 0, si_code 2, si_pid 4, si_status 6 (u32 words).
    let mut info: [u32; 32];
    for index: usize in 0..<32 { info[index] = 0; }
    let taken: isize = linux_syscall(X86_64_NR_RT_SIGTIMEDWAIT, &set as usize,
                                     &info as usize, 0, 8);
    let mut word: u32 = 0;
    let reaped: isize = linux_syscall(X86_64_NR_WAIT4, child as usize,
                                      &word as usize, 0, 0);
    if (taken != 17 || reaped != child || info[0] != 17 ||
        info[4] != child as u32) {
        return 0xFFFFFFFF;
    }
    return (info[2] << 8) | info[6];
}

fn compare(label: *u8, host: u32, kernel: u32) {
    uart_puts(label);
    uart_puts(": host ");
    uart_print(host);
    uart_puts(" kernel ");
    uart_print(kernel);
    if (host == kernel) { uart_puts(" ok\n"); } else { uart_puts(" MISMATCH\n"); }
}

fn app_main() {
    // Signals whose default is to terminate without a core dump: the
    // kernel writes no cores, and a host core (SIGSEGV here) would set bit
    // 0x80 according to the host's core_pattern rather than to Linux's
    // encoding.
    compare("SIGHUP", host_status(1, 0),
            syscall_wait_status_word(process_end_signaled(1)));
    compare("SIGKILL", host_status(9, 0),
            syscall_wait_status_word(process_end_signaled(9)));
    compare("SIGUSR1", host_status(10, 0),
            syscall_wait_status_word(process_end_signaled(10)));
    compare("SIGTERM", host_status(15, 0),
            syscall_wait_status_word(process_end_signaled(15)));
    compare("exit 0", host_status(0, 0), syscall_wait_status_word(process_end_exited(0)));
    compare("exit 143", host_status(0, 143), syscall_wait_status_word(process_end_exited(143)));
    // exit_group keeps the code's low byte, as Linux does.
    compare("exit 300", host_status(0, 300),
            syscall_wait_status_word(process_end_exited(300)));
    // GitHub issue #885: the SIGCHLD siginfo for the same ends. The
    // kernel side names the child itself; si_code and si_status are what
    // syscall_signal_frame_write takes from wait_status.tkb.
    compare("SIGCHLD SIGHUP", host_sigchld(1, 0), kernel_sigchld(process_end_signaled(1)));
    compare("SIGCHLD SIGKILL", host_sigchld(9, 0), kernel_sigchld(process_end_signaled(9)));
    compare("SIGCHLD SIGTERM", host_sigchld(15, 0), kernel_sigchld(process_end_signaled(15)));
    compare("SIGCHLD exit 0", host_sigchld(0, 0), kernel_sigchld(process_end_exited(0)));
    compare("SIGCHLD exit 143", host_sigchld(0, 143), kernel_sigchld(process_end_exited(143)));
    compare("SIGCHLD exit 300", host_sigchld(0, 300), kernel_sigchld(process_end_exited(300)));
}

fn kernel_sigchld(end: ProcessEnd) -> u32 {
    return (syscall_sigchld_code(end) << 8) | syscall_sigchld_status(end);
}
