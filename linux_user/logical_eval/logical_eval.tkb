// SPEC's short-circuit rule for `&&` and `||`, pinned by execution.
//
// Count calls rather than inspecting the result: a result alone cannot
// distinguish a skipped operand from an operand that returned a value.
let mut calls: usize = 0;

fn side(value: bool) -> bool {
    calls = calls + 1;
    return value;
}

fn app_main() {
    calls = 0;
    let and_false: bool = side(false) && side(true);
    uart_puts("&& with a false left operand: result=");
    uart_print(and_false);
    uart_puts(" operands evaluated=");
    uart_print(calls);
    uart_puts("\n");

    calls = 0;
    let and_true: bool = side(true) && side(false);
    uart_puts("&& with a true left operand:  result=");
    uart_print(and_true);
    uart_puts(" operands evaluated=");
    uart_print(calls);
    uart_puts("\n");

    calls = 0;
    let or_true: bool = side(true) || side(false);
    uart_puts("|| with a true left operand:  result=");
    uart_print(or_true);
    uart_puts(" operands evaluated=");
    uart_print(calls);
    uart_puts("\n");

    calls = 0;
    let or_false: bool = side(false) || side(true);
    uart_puts("|| with a false left operand: result=");
    uart_print(or_false);
    uart_puts(" operands evaluated=");
    uart_print(calls);
    uart_puts("\n");
}
