// GitHub issue #472: kernel/boot/fdt.tkb's memory reader, run against a
// device-tree blob where a test costs milliseconds instead of a reset and
// an SWD load.
//
// Milestone 1 made the reader preserve every usable `reg` tuple from every
// memory node, and gave it an enumeration API to read them back. That API
// had no caller anywhere and no host-native test: the boot path asks only
// for the count and the total, so a `region_at` that returned the wrong
// extent, or a `verify` that agreed with it, would have looked correct on
// both platforms. This is a caller.
//
// Parsing a blob is byte work, so the verdict here is the verdict the board
// would give, and the board is not needed to get it.
//
// The blob is built by scripts/make_fdt_fixture.py from the values in the
// pinned Raspberry Pi firmware DTB; see that file for each one and for why
// it is generated rather than committed.
//
// Expected output (linux_user/fdt/fdt.expected):
//   how many memory regions the blob describes, the first one's base, the
//     total across all of them, then each region and the refusal past the
//     last, then the map's own self-check
//   then the refusal: a blob whose magic does not match

let fdt_fixture: [u8; 1630] = embed_file("linux_user/build/fdt_fixture.dtb");
let fdt_invalid_memory_fixture: [u8; 1710] =
    embed_file("linux_user/build/fdt_invalid_memory_fixture.dtb");
let fdt_invalid_reservation_fixture: [u8; 1646] =
    embed_file("linux_user/build/fdt_invalid_reservation_fixture.dtb");
let fdt_invalid_tree_reservation_fixture: [u8; 1682] =
    embed_file("linux_user/build/fdt_invalid_tree_reservation_fixture.dtb");
let fdt_invalid_device_fixture: [u8; 1718] =
    embed_file("linux_user/build/fdt_invalid_device_fixture.dtb");
let fdt_invalid_interrupt_fixture: [u8; 1630] =
    embed_file("linux_user/build/fdt_invalid_interrupt_fixture.dtb");
let fdt_missing_interrupt_fixture: [u8; 1595] =
    embed_file("linux_user/build/fdt_missing_interrupt_fixture.dtb");

// The existing printer is 32 bits wide and these are physical addresses on
// a board whose peripherals live above 4 GiB, so print both halves.
fn println_hex64(value: usize) {
    uart_print_hex((value >> 32) as i32);
    uart_puts(" ");
    uart_println_hex((value & 0xFFFFFFFF) as i32);
}

fn report_region(result: FdtMemoryRegionResult) {
    match result {
        FdtMemoryRegionResult::Invalid => {
            uart_puts("region invalid\r\n");
        }
        FdtMemoryRegionResult::OutOfRange => {
            uart_puts("region out of range\r\n");
        }
        FdtMemoryRegionResult::Found(region) => {
            uart_puts("region ");
            uart_print_hex((region.base >> 32) as i32);
            uart_puts(" ");
            uart_print_hex((region.base & 0xFFFFFFFF) as i32);
            uart_puts(" size ");
            uart_print_hex((region.size >> 32) as i32);
            uart_puts(" ");
            uart_println_hex((region.size & 0xFFFFFFFF) as i32);
        }
    }
}

fn report_memory(result: FdtMemoryResult) !{unsafe} {
    match result {
        FdtMemoryResult::Invalid => { uart_puts("memory invalid\r\n"); }
        FdtMemoryResult::NotFound => { uart_puts("memory not found\r\n"); }
        FdtMemoryResult::Found(found) => {
            uart_puts("memory regions ");
            uart_print_hex(fdt_memory_region_count(found) as i32);
            uart_puts("\n");
            uart_puts("memory reservations ");
            uart_println_hex(fdt_memory_reservation_count(found) as i32);
            uart_puts("memory base ");
            println_hex64(fdt_memory_first_base(found));
            uart_puts("memory size ");
            println_hex64(fdt_memory_total_size(found));
            // The enumeration this map exists for. Walking it is what says
            // the count and the total above were not both computed from one
            // region that happened to be the only one anybody asked for.
            for index: usize in 0..<6 {
                report_region(fdt_memory_region_at(found, index));
            }
            uart_puts("memory verifies ");
            if (fdt_memory_map_verify(found)) {
                uart_puts("yes\r\n");
            } else {
                uart_puts("no\r\n");
            }
            uart_puts("blob overlap ");
            if (fdt_blob_overlaps(found, fdt_blob_base(found), 1) &&
                fdt_blob_overlaps(found, fdt_blob_base(found) + 1630, 1) ==
                    false) {
                uart_puts("yes\r\n");
            } else {
                uart_puts("no\r\n");
            }
        }
    }
}

fn report_device(label: *u8, result: FdtDeviceRegionResult) {
    uart_puts(label);
    match result {
        FdtDeviceRegionResult::Invalid => { uart_puts(" invalid\n"); }
        FdtDeviceRegionResult::NotFound => { uart_puts(" not found\n"); }
        FdtDeviceRegionResult::Found(region) => {
            uart_puts(" base ");
            uart_print_hex((region.base >> 32) as i32);
            uart_puts(" ");
            uart_print_hex((region.base & 0xFFFFFFFF) as i32);
            uart_puts("\n");
            uart_puts("size ");
            uart_print_hex((region.size >> 32) as i32);
            uart_puts(" ");
            uart_print_hex((region.size & 0xFFFFFFFF) as i32);
            uart_puts("\n");
        }
    }
}

fn report_interrupt(label: *u8, result: FdtGicInterruptResult) {
    uart_puts(label);
    match result {
        FdtGicInterruptResult::Invalid => { uart_puts(" invalid\n"); }
        FdtGicInterruptResult::NotFound => { uart_puts(" not found\n"); }
        FdtGicInterruptResult::Found(interrupt) => {
            uart_puts(" intid ");
            uart_print_hex(interrupt.intid as i32);
            uart_puts(" flags ");
            uart_print_hex(interrupt.flags as i32);
            uart_puts("\n");
        }
    }
}

fn app_main() !{unsafe} {
    let blob: usize = (fdt_fixture as *u8) as usize;
    report_device("qemu pl011",
                  fdt_find_compatible_reg(blob, bs"arm,pl011"));
    report_device("rpi5 system timer", fdt_find_compatible_reg(
        blob, bs"brcm,bcm2835-system-timer"));
    report_device("missing device",
                  fdt_find_compatible_reg(blob, bs"not,a-device"));
    let invalid_device_blob: usize =
        (fdt_invalid_device_fixture as *u8) as usize;
    report_device("invalid device", fdt_find_compatible_reg(
        invalid_device_blob, bs"arm,pl011"));
    report_interrupt("qemu pl011 interrupt",
                     fdt_find_compatible_gic_interrupt(
                         blob, bs"arm,pl011"));
    report_interrupt("missing interrupt", fdt_find_compatible_gic_interrupt(
        blob, bs"not,a-device"));
    let invalid_interrupt_blob: usize =
        (fdt_invalid_interrupt_fixture as *u8) as usize;
    report_interrupt("invalid interrupt", fdt_find_compatible_gic_interrupt(
        invalid_interrupt_blob, bs"arm,pl011"));
    let missing_interrupt_blob: usize =
        (fdt_missing_interrupt_fixture as *u8) as usize;
    report_interrupt("missing interrupt property",
                     fdt_find_compatible_gic_interrupt(
                         missing_interrupt_blob, bs"arm,pl011"));
    report_memory(fdt_detect_memory(blob));

    let invalid_memory_blob: usize =
        (fdt_invalid_memory_fixture as *u8) as usize;
    report_memory(fdt_detect_memory(invalid_memory_blob));

    let invalid_reservation_blob: usize =
        (fdt_invalid_reservation_fixture as *u8) as usize;
    report_memory(fdt_detect_memory(invalid_reservation_blob));

    let invalid_tree_reservation_blob: usize =
        (fdt_invalid_tree_reservation_fixture as *u8) as usize;
    report_memory(fdt_detect_memory(invalid_tree_reservation_blob));

    // One byte into the header the magic no longer matches, and every
    // reader refuses before it reads anything else.
    report_memory(fdt_detect_memory(blob + 1));
}
