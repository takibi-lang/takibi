fn report_pcie_map(label: *u8, result: FdtPcieAddressMapResult) {
    uart_puts(label);
    match result {
        FdtPcieAddressMapResult::Invalid => { uart_puts(" invalid\n"); }
        FdtPcieAddressMapResult::NotFound => { uart_puts(" not found\n"); }
        FdtPcieAddressMapResult::Found(address_map) => {
            uart_puts(" outbound ");
            uart_print_hex((address_map.outbound_cpu_base >> 32) as i32);
            uart_puts(" ");
            uart_print_hex(
                (address_map.outbound_cpu_base & 0xFFFFFFFF) as i32);
            uart_puts(" dma_offset ");
            uart_print_hex((address_map.dma_pci_offset >> 32) as i32);
            uart_puts(" ");
            uart_print_hex((address_map.dma_pci_offset & 0xFFFFFFFF) as i32);
            uart_puts("\n");
        }
    }
}

fn report_transport(label: *u8, result: FdtMmioTransportResult) {
    uart_puts(label);
    match result {
        FdtMmioTransportResult::Invalid => { uart_puts(" invalid\n"); }
        FdtMmioTransportResult::NotFound => { uart_puts(" not found\n"); }
        FdtMmioTransportResult::Found(transport) => {
            uart_puts(" base ");
            uart_print_hex((transport.base >> 32) as i32);
            uart_puts(" ");
            uart_print_hex((transport.base & 0xFFFFFFFF) as i32);
            uart_puts(" intid ");
            uart_print_hex(transport.interrupt.intid as i32);
            uart_puts(" flags ");
            uart_print_hex(transport.interrupt.flags as i32);
            uart_puts("\n");
        }
    }
}

fn report_psci(label: *u8, result: FdtPsciMethodResult) {
    uart_puts(label);
    match result {
        FdtPsciMethodResult::Invalid => { uart_puts(" invalid\n"); }
        FdtPsciMethodResult::NotFound => { uart_puts(" not found\n"); }
        FdtPsciMethodResult::Hvc => { uart_puts(" hvc\n"); }
        FdtPsciMethodResult::Smc => { uart_puts(" smc\n"); }
    }
}

fn app_main() !{unsafe} {
    let blob: usize = (fdt_fixture as *u8) as usize;
    report_device("qemu pl011",
                  fdt_find_compatible_reg(blob, bs"arm,pl011"));
    report_device("rpi5 system timer", fdt_find_compatible_reg(
        blob, bs"brcm,bcm2835-system-timer"));
    report_device("rpi5 pcie2", fdt_find_compatible_reg(
        blob, bs"brcm,bcm2712-pcie"));
    report_mip("rpi5 mip0", fdt_find_compatible_mip_regions(
        blob, bs"brcm,bcm2712-mip", 0x1000130000));
    report_pcie_map("rpi5 pcie map", fdt_find_pcie_address_map(
        blob, bs"brcm,bcm2712-pcie", 0x1000120000));
    report_device("rpi5 pcie rescal", fdt_find_compatible_reg(
        blob, bs"brcm,bcm7216-pcie-sata-rescal"));
    report_device("rpi5 bcm reset", fdt_find_compatible_reg(
        blob, bs"brcm,brcmstb-reset"));
    report_device("rpi5 rp1 uart", fdt_find_compatible_pcie_reg(
        blob, bs"arm,pl011-axi"));
    report_device("rpi5 rp1 clocks", fdt_find_compatible_pcie_reg(
        blob, bs"raspberrypi,rp1-clocks"));
    report_device("rpi5 rp1 gem", fdt_find_compatible_pcie_reg(
        blob, bs"raspberrypi,rp1-gem"));
    report_device("rpi5 rp1 usb0", fdt_find_compatible_pcie_reg_at(
        blob, bs"snps,dwc3", 0xC040200000));
    report_rp1_gpio("rpi5 rp1 gpio",
        fdt_find_compatible_rp1_gpio_regions(
            blob, bs"raspberrypi,rp1-gpio"));
    let invalid_pcie_ranges_blob: usize =
        (fdt_invalid_pcie_ranges_fixture as *u8) as usize;
    report_device("invalid pcie ranges", fdt_find_compatible_pcie_reg(
        invalid_pcie_ranges_blob, bs"arm,pl011-axi"));
    report_pcie_map("invalid pcie map", fdt_find_pcie_address_map(
        invalid_pcie_ranges_blob, bs"brcm,bcm2712-pcie", 0x1000120000));
    let invalid_pcie_dma_ranges_blob: usize =
        (fdt_invalid_pcie_dma_ranges_fixture as *u8) as usize;
    report_pcie_map("invalid pcie dma map", fdt_find_pcie_address_map(
        invalid_pcie_dma_ranges_blob,
        bs"brcm,bcm2712-pcie", 0x1000120000));
    report_device("missing device",
                  fdt_find_compatible_reg(blob, bs"not,a-device"));
    let invalid_device_blob: usize =
        (fdt_invalid_device_fixture as *u8) as usize;
    report_device("invalid device", fdt_find_compatible_reg(
        invalid_device_blob, bs"arm,pl011"));
    report_mip("invalid mip0", fdt_find_compatible_mip_regions(
        invalid_device_blob, bs"brcm,bcm2712-mip", 0x1000130000));
    report_rp1_gpio("invalid rp1 gpio",
        fdt_find_compatible_rp1_gpio_regions(
            invalid_device_blob, bs"raspberrypi,rp1-gpio"));
    report_device("invalid rp1 usb0", fdt_find_compatible_pcie_reg_at(
        invalid_device_blob, bs"snps,dwc3", 0xC040200000));
    report_interrupt("qemu pl011 interrupt",
                     fdt_find_compatible_gic_interrupt(
                         blob, bs"arm,pl011"));
    report_interrupt("rpi5 generic timer interrupt",
                     fdt_find_armv8_timer_interrupt(blob));
    report_transport("qemu virtio 0",
        fdt_find_compatible_gic_transport_index(
            blob, bs"virtio,mmio", 0));
    report_transport("qemu virtio 1",
        fdt_find_compatible_gic_transport_index(
            blob, bs"virtio,mmio", 1));
    report_transport("qemu virtio 2",
        fdt_find_compatible_gic_transport_index(
            blob, bs"virtio,mmio", 2));
    report_psci("psci default", fdt_find_psci_method(blob));
    let psci_smc_blob: usize =
        (fdt_psci_smc_fixture as *u8) as usize;
    report_psci("psci smc", fdt_find_psci_method(psci_smc_blob));
    report_interrupt("missing interrupt", fdt_find_compatible_gic_interrupt(
        blob, bs"not,a-device"));
    let invalid_interrupt_blob: usize =
        (fdt_invalid_interrupt_fixture as *u8) as usize;
    report_interrupt("invalid interrupt", fdt_find_compatible_gic_interrupt(
        invalid_interrupt_blob, bs"arm,pl011"));
    report_psci("psci malformed",
                fdt_find_psci_method(invalid_device_blob));
    report_interrupt("invalid timer interrupt",
                     fdt_find_armv8_timer_interrupt(invalid_interrupt_blob));
    let missing_interrupt_blob: usize =
        (fdt_missing_interrupt_fixture as *u8) as usize;
    report_interrupt("missing interrupt property",
                     fdt_find_compatible_gic_interrupt(
                         missing_interrupt_blob, bs"arm,pl011"));
    report_interrupt("missing timer interrupt",
                     fdt_find_armv8_timer_interrupt(missing_interrupt_blob));
    report_psci("psci missing",
                fdt_find_psci_method(missing_interrupt_blob));
    report_transport("missing virtio interrupt",
        fdt_find_compatible_gic_transport_index(
            missing_interrupt_blob, bs"virtio,mmio", 0));
    let invalid_virtio_blob: usize =
        (fdt_invalid_virtio_fixture as *u8) as usize;
    report_transport("invalid virtio 1",
        fdt_find_compatible_gic_transport_index(
            invalid_virtio_blob, bs"virtio,mmio", 1));
    report_gic("qemu gic", fdt_find_compatible_gicv2_regions(
        blob, bs"arm,cortex-a15-gic"));
    report_gic("rpi5 gic", fdt_find_compatible_gicv2_regions(
        blob, bs"arm,gic-400"));
    let invalid_gic_blob: usize =
        (fdt_invalid_gic_fixture as *u8) as usize;
    report_psci("psci disabled", fdt_find_psci_method(invalid_gic_blob));
    report_gic("invalid gic", fdt_find_compatible_gicv2_regions(
        invalid_gic_blob, bs"arm,cortex-a15-gic"));
    report_gic("invalid rpi5 gic", fdt_find_compatible_gicv2_regions(
        invalid_gic_blob, bs"arm,gic-400"));
    report_memory(fdt_detect_memory(blob));

    let invalid_memory_blob: usize =
        (fdt_invalid_memory_fixture as *u8) as usize;
    report_memory(fdt_detect_memory(invalid_memory_blob));

    let invalid_reservation_blob: usize =
        (fdt_invalid_reservation_fixture as *u8) as usize;
    report_memory(fdt_detect_memory(invalid_reservation_blob));

    let invalid_tree_reservation_blob: usize =
        (fdt_invalid_tree_reservation_fixture as *u8) as usize;
    report_memory(fdt_detect_memory(invalid_tree_reservation_blob));

    // One byte into the header the magic no longer matches, and every
    // reader refuses before it reads anything else.
    report_memory(fdt_detect_memory(blob + 1));
}
