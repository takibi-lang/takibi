// GitHub issue #257: the three-pool shape for kernel/net/tcp.tkb, checked
// in linux_user before any of the 19 syscall.tkb call sites are touched.
//
// tcp.tkb today keys ~10.7 KB of state off TCP_CONNECTION_MAX = 2. That
// does not fit one intrusive_pool chunk (PAGE_USABLE_BYTES = 3968), so
// `IntrusivePool(TcpConnection)` with everything inlined fails
// intrusive_pool_slots_per_chunk's own static_assert. The migration has
// to split, and this fixture is that split standing up on its own:
//
//   TcpConnection  -- control block, holds handles to the rest
//   NetFrame       -- one MTU; serves the rx buffer, the inetd response,
//                     and every retransmit copy (the mbuf/PCB split)
//   RetxEntry      -- retransmit metadata + a frame handle + the chain
//
// Three things are being checked, none of which were certain when the
// split was written down:
//
//   1. a struct can hold SEVERAL stable owner fields (three here), under
//      one mutex -- stable_owner_fields is keyed by (struct, field), so
//      nothing forbids it, but nothing had done it either;
//   2. the density estimates in the issue survive contact with real
//      sizeof -- they are printed rather than asserted, because being
//      wrong about them is the reason to measure;
//   3. a frame moves from the connection into a retransmit entry as a
//      HANDLE, replacing pending_tcp_record()'s 1514-byte slice_copy.
//
// What this fixture is not: the migration. No TCP logic, no wire format.
// It is the shape, so that finding a hole costs an afternoon here rather
// than a bisect through kernel/net/.
use "kernel/lib/intrusive_pool.tkb";

const MTU: usize = 1514;

struct NetFrame {
    len: usize;
    bytes: [u8; MTU];
}

// A parked handle into some pool. The brand is existentially quantified
// (issue #370): the field knows it holds SOME pool's handle, not this
// one's, so a cross-pool mixup falls to intrusive_pool_slot_is_valid at
// runtime rather than to `static value mismatch` at compile time. Stated
// here because it is the price of the container, not a surprise.
variant FrameLink {
    None;
    Some(exists p: addr. exists a: usize. IntrusiveOwner[p, a]);
}

variant RetxLink {
    End;
    More(exists p: addr. exists a: usize. IntrusiveOwner[p, a]);
}

// pending_tcp_kind/_frame/_frame_length/_expected_ack/_remote_ip/
// _remote_port/_local_port/_sent_at/_retries, one entry instead of nine
// arrays indexed by PENDING_TCP_MAX * TCP_CONNECTION_MAX -- and the chain
// is what removes PENDING_TCP_MAX itself.
struct RetxEntry {
    private mutex: i32;
    private frame: FrameLink;
    private next: RetxLink;
    kind: usize;
    expected_ack: u32;
    sent_at: i64;
    retries: usize;
}

// conn_state/_remote_ip/_remote_mac/_remote_port/_local_port/_snd_nxt/
// _rcv_nxt plus syscall.tkb's connection_open/buffer_length/buffer_offset/
// inetd_response_length. The three link fields are what tcp.tkb spells as
// tcp_connection_store today, except they are per-connection storage that
// no array sizes.
struct TcpConnection {
    private mutex: i32;
    private rx: FrameLink;
    private inetd: FrameLink;
    private retx: RetxLink;
    state: usize;
    remote_port: u16;
    local_port: u16;
    snd_nxt: u32;
    rcv_nxt: u32;
    rx_len: usize;
    rx_off: usize;
    open: bool;
}

private linear view SlotGuard[lock: addr];

private let mut conns: IntrusivePool(TcpConnection);
private let mut frames: IntrusivePool(NetFrame);
private let mut retxs: IntrusivePool(RetxEntry);

fn slot_lock(m: *i32 @ address) -> SlotGuard[address] {
    return view SlotGuard[address];
}
fn slot_unlock(g: sink SlotGuard[address], m: *i32 @ address) {}

// Discharges a link, reporting whether it held anything. The fixture
// leaks the underlying slots on purpose (as pool_container does): what is
// being shown is that the STORAGE has no ceiling.
fn frame_link_occupied(l: FrameLink) -> bool {
    match l {
        FrameLink::None => { return false; }
        FrameLink::Some(o) => { intrusive_owner_drop(o); return true; }
    }
}

fn retx_link_occupied(l: RetxLink) -> bool {
    match l {
        RetxLink::End => { return false; }
        RetxLink::More(o) => { intrusive_owner_drop(o); return true; }
    }
}

// Give a parked frame back. This is where #370's cost is paid in full:
// the handle came out of a stable slot, so its brand is existential, and
// `intrusive_pool_remove` wants one branded to THIS pool. Opening the
// existential mints a fresh identity that will not match, so the only
// route is to take the slot and generation off the handle, discharge it,
// and rebuild a branded owner -- which is exactly the ONE way to produce
// a handle the pool did not mint, and exactly why remove() validates
// before it trusts one. The compile-time check is gone; the runtime
// check that replaces it is intrusive_pool_slot_is_valid, and
// foreign_handle_count is where a mistake surfaces.
fn free_frame(link: FrameLink) -> usize !{unsafe} {
    match link {
        FrameLink::None => { return 0; }
        FrameLink::Some(parked) => {
            let slot: usize = intrusive_owner_slot(parked);
            let generation: usize = intrusive_owner_generation(parked);
            intrusive_owner_drop(parked);
            let branded = intrusive_owner_new(&frames, slot, generation);
            let g = intrusive_pool_lock(&frames);
            let freed: bool =
                intrusive_remove_succeeded(intrusive_pool_remove(&frames, g, branded));
            intrusive_pool_unlock(&frames, g);
            if (freed == false) { return 0; }
            return 1;
        }
    }
}

// GitHub issue #371: which refusal, asked as a yes/no the assertions
// below can print. Local to this file rather than added to the library:
// the library offers intrusive_remove_outcome for "did it work, and what
// would I say about it", and a test wanting one specific arm is a test
// concern. The result is `must_use` and therefore affine, so each of
// these consumes it -- one question per removal, which is all any site
// here needs.
fn removal_was_foreign(result: IntrusivePoolRemoveResult) -> bool {
    match result {
        IntrusivePoolRemoveResult::Removed => { return false; }
        IntrusivePoolRemoveResult::ForeignAddress => { return true; }
        IntrusivePoolRemoveResult::StaleHandle => { return false; }
    }
}

fn removal_was_stale(result: IntrusivePoolRemoveResult) -> bool {
    match result {
        IntrusivePoolRemoveResult::Removed => { return false; }
        IntrusivePoolRemoveResult::ForeignAddress => { return false; }
        IntrusivePoolRemoveResult::StaleHandle => { return true; }
    }
}

// Walk one connection's retransmit chain, returning each entry's frame
// and then the entry. tcp.tkb's pending_tcp_reset_all() over
// PENDING_TCP_MAX fixed slots, with the ceiling taken out.
fn free_retx_chain(head: RetxLink) -> (usize, usize) !{unsafe} {
    let mut link: RetxLink = head;
    let mut entries: usize = 0;
    let mut freed_frames: usize = 0;
    let mut walking: bool = true;
    while (walking) {
        match link {
            RetxLink::End => { walking = false; link = RetxLink::End; }
            RetxLink::More(parked) => {
                let slot: usize = intrusive_owner_slot(parked);
                let generation: usize = intrusive_owner_generation(parked);
                intrusive_owner_drop(parked);
                let branded = intrusive_owner_new(&retxs, slot, generation);
                let e: *RetxEntry = intrusive_pool_ref(&retxs, branded);
                let g1 = slot_lock(&e.mutex);
                let carried: FrameLink =
                    stable_replace(g1, &e.mutex, e.frame, FrameLink::None);
                slot_unlock(g1, &e.mutex);
                freed_frames = freed_frames + free_frame(carried);
                let e2: *RetxEntry = intrusive_pool_ref(&retxs, branded);
                let g2 = slot_lock(&e2.mutex);
                let following: RetxLink =
                    stable_replace(g2, &e2.mutex, e2.next, RetxLink::End);
                slot_unlock(g2, &e2.mutex);
                let g3 = intrusive_pool_lock(&retxs);
                let removed1: bool =
                    intrusive_remove_succeeded(intrusive_pool_remove(&retxs, g3, branded));
                if (removed1 == false) { uart_puts("remove refused\n"); }
                intrusive_pool_unlock(&retxs, g3);
                entries = entries + 1;
                link = following;
            }
        }
    }
    match link {
        RetxLink::End => {}
        RetxLink::More(leftover) => { intrusive_owner_drop(leftover); }
    }
    return (entries, freed_frames);
}

// Splice one more entry onto the head of a connection's retransmit chain.
// PENDING_TCP_MAX is 4 today, so a chain of one would leave the iteration
// that replaces it -- free_retx_chain()'s walk, and the entry-to-entry
// `next` link it follows -- never actually exercised.
fn push_retx(conn: *TcpConnection) -> bool !{unsafe} {
    let fg = intrusive_pool_lock(&frames);
    let fr = intrusive_pool_insert_zeroed(&frames, fg);
    intrusive_pool_unlock(&frames, fg);
    match fr {
        IntrusivePoolInsertResult::OutOfMemory => { return false; }
        IntrusivePoolInsertResult::Allocated(frame_owner) => {
            let rg = intrusive_pool_lock(&retxs);
            let rr = intrusive_pool_insert_zeroed(&retxs, rg);
            intrusive_pool_unlock(&retxs, rg);
            match rr {
                IntrusivePoolInsertResult::OutOfMemory => {
                    intrusive_owner_drop(frame_owner);
                    return false;
                }
                IntrusivePoolInsertResult::Allocated(entry_owner) => {
                    let e: *RetxEntry = intrusive_pool_ref(&retxs, entry_owner);
                    e.mutex = 0;
                    e.kind = 2;
                    e.expected_ack = 2000;
                    e.sent_at = 0;
                    e.retries = 0;
                    let g1 = slot_lock(&e.mutex);
                    let d1: FrameLink = stable_replace(
                        g1, &e.mutex, e.frame, FrameLink::Some(frame_owner));
                    slot_unlock(g1, &e.mutex);
                    if (frame_link_occupied(d1)) {
                        intrusive_owner_drop(entry_owner);
                        return false;
                    }
                    // Splice: entry.next takes the old head, then the
                    // connection points at the entry.
                    let g2 = slot_lock(&conn.mutex);
                    let old_head: RetxLink = stable_replace(
                        g2, &conn.mutex, conn.retx, RetxLink::End);
                    slot_unlock(g2, &conn.mutex);
                    let e2: *RetxEntry = intrusive_pool_ref(&retxs, entry_owner);
                    let g3 = slot_lock(&e2.mutex);
                    let d3: RetxLink =
                        stable_replace(g3, &e2.mutex, e2.next, old_head);
                    slot_unlock(g3, &e2.mutex);
                    if (retx_link_occupied(d3)) {
                        intrusive_owner_drop(entry_owner);
                        return false;
                    }
                    let g4 = slot_lock(&conn.mutex);
                    let d4: RetxLink = stable_replace(
                        g4, &conn.mutex, conn.retx, RetxLink::More(entry_owner));
                    slot_unlock(g4, &conn.mutex);
                    if (retx_link_occupied(d4)) { return false; }
                    return true;
                }
            }
        }
    }
}

fn uart_print_bool(value: bool) {
    if (value) { uart_puts("true"); } else { uart_puts("false"); }
}

fn app_main() !{unsafe} {
    page_allocator_init();
    intrusive_pool_init(&conns);
    intrusive_pool_init(&frames);
    intrusive_pool_init(&retxs);
    uart_puts("tcp_pool_shape\n");

    // -- 2. Density, measured. The issue predicted 45 / 2 / 70 from a
    // byte budget done by hand; these are what the compiler actually
    // lays out.
    uart_puts("slots per chunk (TcpConnection, NetFrame, RetxEntry): ");
    uart_print(intrusive_pool_slots_per_chunk(&conns));
    uart_puts(" ");
    uart_print(intrusive_pool_slots_per_chunk(&frames));
    uart_puts(" ");
    uart_print(intrusive_pool_slots_per_chunk(&retxs));
    uart_puts("\n");

    // -- Build connections until the page provider is out. Each costs a
    // control block, an rx frame, an inetd frame and one retransmit entry
    // carrying its own frame -- the SYN-ACK copy that tcp.tkb keeps in
    // tcp_stream_tx_frame with a hand-rolled retry beside the general
    // queue.
    let mut built: usize = 0;
    let mut stale_slots: usize = 0;
    let mut moved_frames: usize = 0;
    let mut chain_extended: usize = 0;
    let mut going: bool = true;
    while (going) {
        let cg = intrusive_pool_lock(&conns);
        let cr = intrusive_pool_insert_zeroed(&conns, cg);
        intrusive_pool_unlock(&conns, cg);
        match cr {
            IntrusivePoolInsertResult::OutOfMemory => { going = false; }
            IntrusivePoolInsertResult::Allocated(conn_owner) => {
                let conn: *TcpConnection = intrusive_pool_ref(&conns, conn_owner);
                conn.mutex = 0;
                conn.state = 1;
                conn.local_port = 80;
                conn.remote_port = (40000 + built) as u16;
                conn.snd_nxt = 1000;
                conn.rcv_nxt = 1;
                conn.rx_len = 0;
                conn.rx_off = 0;
                conn.open = true;

                // rx buffer: syscall_socket_buffer[slot * 1460 ..]
                let fg = intrusive_pool_lock(&frames);
                let fr = intrusive_pool_insert_zeroed(&frames, fg);
                intrusive_pool_unlock(&frames, fg);
                match fr {
                    IntrusivePoolInsertResult::OutOfMemory => {
                        going = false;
                        intrusive_owner_drop(conn_owner);
                    }
                    IntrusivePoolInsertResult::Allocated(rx_owner) => {
                        let rx: *NetFrame = intrusive_pool_ref(&frames, rx_owner);
                        rx.len = 0;
                        let g1 = slot_lock(&conn.mutex);
                        let d1: FrameLink = stable_replace(
                            g1, &conn.mutex, conn.rx,
                            FrameLink::Some(rx_owner));
                        slot_unlock(g1, &conn.mutex);
                        if (frame_link_occupied(d1)) { stale_slots = stale_slots + 1; }

                        // The transmit frame, then its move into a
                        // retransmit entry -- 3. of the header. tcp.tkb
                        // copies MTU bytes here; this is the same frame,
                        // reached through a handle that changed owner.
                        let tg = intrusive_pool_lock(&frames);
                        let tr = intrusive_pool_insert_zeroed(&frames, tg);
                        intrusive_pool_unlock(&frames, tg);
                        match tr {
                            IntrusivePoolInsertResult::OutOfMemory => { going = false; }
                            IntrusivePoolInsertResult::Allocated(tx_owner) => {
                                let tx: *NetFrame = intrusive_pool_ref(&frames, tx_owner);
                                tx.len = 54;                 // a SYN-ACK
                                tx.bytes[0] = 0x45;
                                let tx_slot: usize = intrusive_owner_slot(tx_owner);

                                let rg = intrusive_pool_lock(&retxs);
                                let rr = intrusive_pool_insert_zeroed(&retxs, rg);
                                intrusive_pool_unlock(&retxs, rg);
                                match rr {
                                    IntrusivePoolInsertResult::OutOfMemory => {
                                        going = false;
                                        intrusive_owner_drop(tx_owner);
                                    }
                                    IntrusivePoolInsertResult::Allocated(retx_owner) => {
                                        let e: *RetxEntry =
                                            intrusive_pool_ref(&retxs, retx_owner);
                                        e.mutex = 0;
                                        e.kind = 1;
                                        e.expected_ack = 1001;
                                        e.sent_at = 0;
                                        e.retries = 0;
                                        let g2 = slot_lock(&e.mutex);
                                        let d2: FrameLink = stable_replace(
                                            g2, &e.mutex, e.frame,
                                            FrameLink::Some(tx_owner));
                                        slot_unlock(g2, &e.mutex);
                                        if (frame_link_occupied(d2)) {
                                            stale_slots = stale_slots + 1;
                                        }
                                        // The frame the connection built is
                                        // the frame the entry now holds: same
                                        // slot address, no bytes copied.
                                        let e2: *RetxEntry =
                                            intrusive_pool_ref(&retxs, retx_owner);
                                        let g3 = slot_lock(&e2.mutex);
                                        let held: FrameLink = stable_replace(
                                            g3, &e2.mutex, e2.frame, FrameLink::None);
                                        slot_unlock(g3, &e2.mutex);
                                        match held {
                                            FrameLink::None => {}
                                            FrameLink::Some(back) => {
                                                if (intrusive_owner_slot(back) == tx_slot) {
                                                    moved_frames = moved_frames + 1;
                                                }
                                                let g4 = slot_lock(&e2.mutex);
                                                let d4: FrameLink = stable_replace(
                                                    g4, &e2.mutex, e2.frame,
                                                    FrameLink::Some(back));
                                                slot_unlock(g4, &e2.mutex);
                                                if (frame_link_occupied(d4)) {
                                                    stale_slots = stale_slots + 1;
                                                }
                                            }
                                        }

                                        let g5 = slot_lock(&conn.mutex);
                                        let d5: RetxLink = stable_replace(
                                            g5, &conn.mutex, conn.retx,
                                            RetxLink::More(retx_owner));
                                        slot_unlock(g5, &conn.mutex);
                                        if (retx_link_occupied(d5)) {
                                            stale_slots = stale_slots + 1;
                                        }
                                        built = built + 1;
                                        // Done on the first connection,
                                        // while capacity is plentiful --
                                        // the loop below runs the page
                                        // provider dry on purpose.
                                        if (built == 1) {
                                            if (push_retx(conn)) {
                                                chain_extended = chain_extended + 1;
                                            }
                                            if (push_retx(conn)) {
                                                chain_extended = chain_extended + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        intrusive_owner_drop(conn_owner);
                    }
                }
            }
        }
    }

    uart_puts("connections built with no N in any declaration, array or ");
    uart_puts("ceiling (connections, pages, conn/frame/retx live): ");
    uart_print(built);
    uart_puts(" ");
    uart_print(page_allocator_live_count());
    uart_puts(" ");
    uart_print(intrusive_pool_live_count(&conns));
    uart_puts(" ");
    uart_print(intrusive_pool_live_count(&frames));
    uart_puts(" ");
    uart_print(intrusive_pool_live_count(&retxs));
    uart_puts("\n");

    // The claim TCP_CONNECTION_MAX = 2 exists to deny.
    uart_puts("one connection carries a retransmit chain longer than one, ");
    uart_puts("so the walk that replaces PENDING_TCP_MAX is exercised: ");
    uart_print_bool(chain_extended == 2);
    uart_puts("\n");

    uart_puts("more live connections than the old ceiling of 2: ");
    uart_print_bool(built > 2);
    uart_puts("\n");

    // 1. of the header: three stable owner fields in one struct, each
    // handed out empty by intrusive_pool_insert_zeroed. Any non-empty
    // displacement means the #369 premise broke again.
    uart_puts("every stable slot was empty when it was handed out: ");
    uart_print_bool(stale_slots == 0);
    uart_puts("\n");

    // 3. of the header: the retransmit entry holds the very frame the
    // connection built, not a copy of it.
    uart_puts("every transmit frame reached its retransmit entry by handle, ");
    uart_puts("not by copy: ");
    uart_print_bool(moved_frames == built);
    uart_puts("\n");

    // -- Teardown. Connections are found by SCANNING the pool, which is
    // what the kernel does with a received segment -- there is no array
    // to walk and no chain kept on the side. The build loop dropped every
    // conn_owner, so nothing here is holding one: the scan mints them
    // back from (slot, generation), the same round trip the fd table will
    // do through transport_slot.
    let mut conns_freed: usize = 0;
    let mut frames_freed: usize = 0;
    let mut retxs_freed: usize = 0;
    // Kept across teardown to build the stale pair below -- the fd table
    // will hold exactly this shape for a connection that has since closed.
    let mut stale_slot: usize = 0;
    let mut stale_generation: usize = 0;
    let mut cursor: usize = intrusive_pool_first_slot(&conns);
    while (cursor != 0) {
        let next_cursor: usize = intrusive_pool_next_slot(&conns, cursor);
        match intrusive_pool_probe_slot(&conns, cursor) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let generation: usize = intrusive_view_generation(slot_view);
                let conn: *TcpConnection =
                    intrusive_pool_payload_of(&conns, slot_view);

                let g1 = slot_lock(&conn.mutex);
                let parked_rx: FrameLink =
                    stable_replace(g1, &conn.mutex, conn.rx, FrameLink::None);
                slot_unlock(g1, &conn.mutex);
                frames_freed = frames_freed + free_frame(parked_rx);

                let g2 = slot_lock(&conn.mutex);
                let parked_inetd: FrameLink =
                    stable_replace(g2, &conn.mutex, conn.inetd, FrameLink::None);
                slot_unlock(g2, &conn.mutex);
                frames_freed = frames_freed + free_frame(parked_inetd);

                let g3 = slot_lock(&conn.mutex);
                let chain: RetxLink =
                    stable_replace(g3, &conn.mutex, conn.retx, RetxLink::End);
                slot_unlock(g3, &conn.mutex);
                let (entries, chain_frames) = free_retx_chain(chain);
                retxs_freed = retxs_freed + entries;
                frames_freed = frames_freed + chain_frames;

                // Overwritten every iteration on purpose, so this ends up
                // holding the LAST connection freed. The chunk free list is
                // LIFO, so that is the slot the next insert hands back --
                // keeping the stale-pair check below on its recycled-slot
                // reading rather than the weaker freed-slot one.
                stale_slot = cursor;
                stale_generation = generation;
                let owner = intrusive_owner_new(&conns, cursor, generation);
                let g4 = intrusive_pool_lock(&conns);
                let removed2: bool =
                    intrusive_remove_succeeded(intrusive_pool_remove(&conns, g4, owner));
                if (removed2 == false) { uart_puts("remove refused\n"); }
                intrusive_pool_unlock(&conns, g4);
                conns_freed = conns_freed + 1;
            }
        }
        cursor = next_cursor;
    }

    uart_puts("teardown by scanning, no array and no side chain ");
    uart_puts("(conns, frames, retx entries freed): ");
    uart_print(conns_freed);
    uart_puts(" ");
    uart_print(frames_freed);
    uart_puts(" ");
    uart_print(retxs_freed);
    uart_puts("\n");

    uart_puts("every pool is empty: ");
    uart_print_bool(intrusive_pool_live_count(&conns) == 0 &&
                    intrusive_pool_live_count(&frames) == 0 &&
                    intrusive_pool_live_count(&retxs) == 0);
    uart_puts("\n");

    // Empty is not the same as given back: issue #346's anti-thrash
    // default retains one empty chunk per pool, so a kernel that opened
    // and closed connections holds three pages, not nine. Printed rather
    // than asserted to zero, because the retention is the design.
    uart_puts("pages still held after teardown, and retained chunks ");
    uart_puts("(pages, conns, frames, retxs): ");
    uart_print(page_allocator_live_count());
    uart_puts(" ");
    uart_print(intrusive_pool_retained_chunks(&conns));
    uart_puts(" ");
    uart_print(intrusive_pool_retained_chunks(&frames));
    uart_puts(" ");
    uart_print(intrusive_pool_retained_chunks(&retxs));
    uart_puts("\n");

    // The check that replaces the brand #370 took away. A frame-pool
    // handle rebuilt against a retx-pool address is exactly the mixup the
    // existential no longer catches at compile time; remove() must refuse
    // it and count it rather than corrupt the free chain.
    //
    // alien_slot must be a REAL address in the other pool, or this proves
    // only that remove() rejects garbage. #346's retained empty chunk is
    // what keeps one addressable after teardown -- asserted, not assumed,
    // because a future retention default of zero would make the whole
    // check pass vacuously via the same counter.
    let alien_slot: usize = intrusive_pool_first_slot(&retxs);
    let before: usize = intrusive_pool_foreign_handle_count(&frames);
    let alien = intrusive_owner_new(&frames, alien_slot, 1);
    let g5 = intrusive_pool_lock(&frames);
    let alien_result = intrusive_pool_remove(&frames, g5, alien);
    intrusive_pool_unlock(&frames, g5);
    // GitHub issue #371: the two halves of this claim are now reported
    // separately, because they were previously one conjunction in which
    // either half could carry the other. That the address is genuinely
    // the OTHER pool's is what makes this a cross-pool test at all (a
    // zero address would be refused too, and by the same counter); that
    // remove() answered ForeignAddress is what says WHY it refused, which
    // no counter delta could.
    uart_puts("the alien address is a real slot of the other pool: ");
    uart_print_bool(alien_slot != 0 &&
                    intrusive_pool_slot_is_valid(&retxs, alien_slot));
    uart_puts("\n");
    uart_puts("a cross-pool handle the erased brand cannot catch is ");
    uart_puts("refused at runtime, as foreign: ");
    uart_print_bool(removal_was_foreign(alien_result) &&
                    intrusive_pool_foreign_handle_count(&frames) == before + 1 &&
                    intrusive_pool_corrupt_free_chain_count(&frames) == 0);
    uart_puts("\n");

    // The use-after-free the migration actually depends on being caught:
    // object_records[].transport_(slot|generation) outlives the connection
    // it names, and after a close the slot is recycled to a NEW occupant.
    // Presenting the old pair must fail, and must fail on the generation
    // rather than on the address, since the address is perfectly valid.
    let refill_g = intrusive_pool_lock(&conns);
    let refill = intrusive_pool_insert_zeroed(&conns, refill_g);
    intrusive_pool_unlock(&conns, refill_g);
    match refill {
        IntrusivePoolInsertResult::OutOfMemory => {
            uart_puts("a stale (slot, generation) pair is refused: no refill\n");
        }
        IntrusivePoolInsertResult::Allocated(fresh) => {
            let recycled: bool = intrusive_owner_slot(fresh) == stale_slot;
            let matched: bool =
                intrusive_pool_matches(&conns, stale_slot, stale_generation);
            let before_stale: usize = intrusive_pool_double_remove_count(&conns);
            let live_before: usize = intrusive_pool_live_count(&conns);
            let stale = intrusive_owner_new(&conns, stale_slot, stale_generation);
            let g6 = intrusive_pool_lock(&conns);
            let stale_result = intrusive_pool_remove(&conns, g6, stale);
            intrusive_pool_unlock(&conns, g6);
            // recycled proves the slot was reused rather than merely
            // freed, which is the stronger of the two readings; it is
            // reported so a weaker run cannot look like the stronger one.
            uart_puts("a stale (slot, generation) pair against a recycled ");
            uart_puts("slot is refused, and the new occupant survives ");
            uart_puts("(recycled, refused): ");
            uart_print_bool(recycled);
            uart_puts(" ");
            // "on the generation rather than on the address" was
            // previously inferred from one counter moving while another
            // did not. removal_was_stale says it (issue #371).
            uart_print_bool(matched == false &&
                            removal_was_stale(stale_result) &&
                            intrusive_pool_double_remove_count(&conns)
                                == before_stale + 1 &&
                            intrusive_pool_foreign_handle_count(&conns) == 0 &&
                            intrusive_pool_live_count(&conns) == live_before);
            uart_puts("\n");
            let g7 = intrusive_pool_lock(&conns);
            let removed3: bool =
                intrusive_remove_succeeded(intrusive_pool_remove(&conns, g7, fresh));
            if (removed3 == false) { uart_puts("remove refused\n"); }
            intrusive_pool_unlock(&conns, g7);
        }
    }

    uart_puts("done\n");
}
