// Execute the actual virtio-net driver with deterministic clock and used-ring
// responses. RAM stands in for MMIO and device-written queue memory; these
// tests do not claim interrupt delivery, DMA ordering or cache evidence.
// The shared used-ring protocol names the block device's erased identity.
// This net-only fixture never attaches or invokes the block reset entry.
let mut virtio_blk_regs: IoHandle(VirtioMmioRegs);
let mut fake_regs: [i32; 128];
let mut fake_now: i64;
let mut done_at: i64;
let mut wake_ticks: i64;
let mut waits: usize;
let mut timeout_logs: usize;
let mut packet: [u8; 1514];

fn virtio_fixture_notify() {}
fn mutex_irq_save() -> usize { return 0; }
fn mutex_irq_restore(flags: usize) {}
// The driver's DDB look names the stop authority (#1164); nothing here calls it.
linear struct MachineStopped[stop: addr] { private owner: usize; }
let mut kernel_world_stop: usize;
fn gic_intid_clear_pending(intid: u32) {}
fn gic_intid_enable(intid: u32) {}
fn gic_intid_target(intid: u32, cpu: u32) {}
fn nic_irq_route(intid: u32) {}
fn workload_profile_note_network_rx(len: usize) {}
fn workload_profile_note_network_tx(len: usize) {}
fn kernel_boot_log(message: *u8) { timeout_logs = timeout_logs + 1; }
fn kernel_invariant_stop() { check(false, "driver stopped on an invariant"); }
fn read_cntpct() -> i64 { fake_now = fake_now + 1; return fake_now; }
fn read_cntfrq() -> i64 { return 1000000; }

fn check(ok: bool, label: *u8) {
    if (ok == false) {
        uart_puts("FAIL virtio-net-tx: "); uart_puts(label); uart_puts("\r\n");
        linux_exit(1);
    }
}

fn tx_used() -> *VirtqUsedRing !{unsafe} {
    return unsafe { atomic_word_load(&virtio_net_used_addr[1]) as *VirtqUsedRing };
}

// GitHub issue #1416: the shadows are the capability's; the fixture reads
// them through the driver copy's readers, and its fake device completes
// against the TX used shadow the test last handed reset_clock.
let mut fixture_tx_seen: VirtioRingIndex = VirtioRingIndex::Zero;

fn shadows(r: borrow NetRxCanAcquire[net]) -> VirtioNetShadows {
    return virtio_net_shadows(r);
}
fn rx_avail(r: borrow NetRxCanAcquire[net]) -> VirtioRingIndex {
    let mut v: VirtioNetShadows = virtio_net_shadows(r); return v.rx_avail_idx;
}
fn tx_avail(r: borrow NetRxCanAcquire[net]) -> VirtioRingIndex {
    let mut v: VirtioNetShadows = virtio_net_shadows(r); return v.tx_avail_idx;
}
fn rx_used(r: borrow NetRxCanAcquire[net]) -> VirtioRingIndex {
    let mut v: VirtioNetShadows = virtio_net_shadows(r); return v.rx_used_seen;
}
fn tx_used_shadow(r: borrow NetRxCanAcquire[net]) -> VirtioRingIndex {
    let mut v: VirtioNetShadows = virtio_net_shadows(r); return v.tx_used_seen;
}
fn packet_rx_avail(p: borrow NetPacket[pb, po, net]) -> VirtioRingIndex {
    let mut v: VirtioNetShadows = virtio_net_packet_shadows(p); return v.rx_avail_idx;
}
fn packet_tx_used(p: borrow NetPacket[pb, po, net]) -> VirtioRingIndex {
    let mut v: VirtioNetShadows = virtio_net_packet_shadows(p); return v.tx_used_seen;
}

fn workload_profile_interrupt_wait() !{may_block} {
    check(task_mutex_is_held(&block_device_lock) == false, "completion wait retained queue guard");
    waits = waits + 1;
    // An old unbounded wait fails quickly rather than hanging the host suite.
    check(waits < 40000, "wait did not return after the elapsed deadline");
    fake_now = fake_now + wake_ticks;
    if (done_at >= 0 && fake_now >= done_at) {
        (*tx_used()).idx = virtio_ring_index_next(fixture_tx_seen);
    }
}

fn reset_clock(completion: i64, step: i64, seen: VirtioRingIndex) {
    fake_now = 0; done_at = completion; wake_ticks = step; waits = 0;
    fixture_tx_seen = seen;
    (*tx_used()).idx = seen;
}

fn expect_completed(seen: VirtioRingIndex) !{may_block} {
    match virtio_net_tx_wait(seen) {
        VirtioNetTxCompletion::Completed => {}
        VirtioNetTxCompletion::Unconfirmed => { check(false, "completion not observed"); }
    }
}

fn expect_unconfirmed(seen: VirtioRingIndex) !{may_block} {
    match virtio_net_tx_wait(seen) {
        VirtioNetTxCompletion::Completed => { check(false, "wake falsely proves completion"); }
        VirtioNetTxCompletion::Unconfirmed => {}
    }
}

fn receive(ready: sink NetRxCanAcquire[net]) -> NetRxAcquire[net] !{unsafe} {
    return receive_id(ready, 0);
}

// The device's used entry naming RX descriptor `id`.
fn receive_id(ready: sink NetRxCanAcquire[net], id: u32) -> NetRxAcquire[net] !{unsafe} {
    let used: *VirtqUsedRing = unsafe { atomic_word_load(&virtio_net_used_addr[0]) as *VirtqUsedRing };
    let seen: VirtioRingIndex = rx_used(ready);
    let slot: {0..<8 as usize} = (((seen as u16) as usize) % 8) as {0..<8 as usize};
    used.ring[slot].id = id;
    used.ring[slot].len = 74;
    used.idx = virtio_ring_index_next(seen);
    atomic_word_store(&virtio_rx_irq_flag, 1);
    return net_rx_acquire(ready);
}

// A real held device guard must cause one-shot RX refusal without
// changing the capability, pending indication or pool ownership. The same
// used entry must drain after release, without another device event.
fn queue_contention_case(ready: sink NetRxCanAcquire[net]) -> NetRxCanAcquire[net] !{unsafe, may_block} {
    let mut before: VirtioNetShadows = virtio_net_shadows(ready);
    let free_before: usize = virtio_pkt_free_index();
    let out_before: usize = virtio_pkt_out_count();
    let mut slots: [usize; 8];
    for i: usize in 0..<8 { slots[i] = virtio_net_rx_slot(ready, i); }
    let guard = block_device_take_unaccounted();
    let ready = match receive(ready) {
        NetRxAcquire::None(cap) => { cap }
        NetRxAcquire::Acquired(frame) => {
            let cap = net_rx_release(frame);
            check(false, "RX progressed while the real guard was held");
            cap
        }
    };
    let mut after: VirtioNetShadows = virtio_net_shadows(ready);
    check(before.rx_used_seen == after.rx_used_seen && before.tx_used_seen == after.tx_used_seen &&
          before.rx_avail_idx == after.rx_avail_idx && before.tx_avail_idx == after.tx_avail_idx,
          "Busy changed queue shadows");
    for i: usize in 0..<8 {
        check(slots[i] == virtio_net_rx_slot(ready, i), "Busy changed descriptor ownership");
    }
    check(free_before == virtio_pkt_free_index() && out_before == virtio_pkt_out_count(),
          "Busy changed packet pool ownership");
    check(atomic_word_load(&virtio_rx_irq_flag) == 1, "Busy lost pending RX indication");
    let waits_before: usize = waits;
    net_rx_wait();
    check(waits == waits_before, "pending RX slept after Busy");
    block_device_give(guard);
    let result = match net_rx_acquire(ready) {
        NetRxAcquire::None(cap) => { check(false, "release did not drain the same entry"); cap }
        NetRxAcquire::Acquired(frame) => {
            let cap = net_rx_release(frame);
            check(rx_used(cap) == virtio_ring_index_next(before.rx_used_seen), "wrong entry drained");
            cap
        }
    };
    return result;
}

// #740: the boundary where the pool is empty at acquire. The fixture takes
// every Free buffer out of the pool, so the acquire's refill finds none and
// descriptor 0 stays empty; the release of the packet refills it.
fn drain_pool_case(ready: sink NetRxCanAcquire[net]) -> NetRxCanAcquire[net] !{unsafe} {
    let a: usize = virtio_pkt_free_index();
    let Place::Full(held_a) = virtio_pkt_take(a) else {
        Place::Empty => { check(false, "no first Free buffer"); return ready; }
    };
    let b: usize = virtio_pkt_free_index();
    let Place::Full(held_b) = virtio_pkt_take(b) else {
        Place::Empty => { check(false, "no second Free buffer"); virtio_pkt_park(a, held_a); return ready; }
    };
    check(virtio_pkt_free_index() == VIRTIO_PKT_NONE, "the fixture emptied the pool");
    let before: VirtioRingIndex = rx_avail(ready);
    let NetRxAcquire::Acquired(packet) = receive(ready) else {
        NetRxAcquire::None(cap) => {
            check(false, "oracle RX frame was refused");
            virtio_pkt_park(a, held_a);
            virtio_pkt_park(b, held_b);
            return cap;
        }
    };
    check(packet_rx_avail(packet) == before, "an empty pool leaves the RX descriptor empty");
    let again = net_rx_release(packet);
    check(rx_avail(again) == virtio_ring_index_next(before),
          "the next release refills the empty RX descriptor");
    virtio_pkt_park(a, held_a);
    virtio_pkt_park(b, held_b);
    return again;
}


// Deferred refill can retry after the existing timer-style wake without
// another device completion. Progress still requires a retry and a free lock.
fn drain_pool_busy_release_case(ready: sink NetRxCanAcquire[net]) -> NetRxCanAcquire[net] !{unsafe, may_block} {
    let a: usize = virtio_pkt_free_index();
    let Place::Full(held_a) = virtio_pkt_take(a) else {
        Place::Empty => { check(false, "no first Free buffer"); return ready; }
    };
    let b: usize = virtio_pkt_free_index();
    let Place::Full(held_b) = virtio_pkt_take(b) else {
        Place::Empty => { check(false, "no second Free buffer"); virtio_pkt_park(a, held_a); return ready; }
    };
    check(virtio_pkt_free_index() == VIRTIO_PKT_NONE, "the fixture emptied the pool");
    let before: VirtioRingIndex = rx_avail(ready);
    let NetRxAcquire::Acquired(packet) = receive(ready) else {
        NetRxAcquire::None(cap) => {
            check(false, "oracle RX frame was refused");
            virtio_pkt_park(a, held_a);
            virtio_pkt_park(b, held_b);
            return cap;
        }
    };
    check(packet_rx_avail(packet) == before, "an empty pool leaves the RX descriptor empty");
    // Successful acquire currently leaves the flag set. Clear it here
    // deliberately to exercise the conservative no-more-device-IRQ case.
    atomic_word_store(&virtio_rx_irq_flag, 0);
    let guard = block_device_take_unaccounted();
    let again = net_rx_release(packet);
    check(rx_avail(again) == before && virtio_net_rx_slot(again, 0) == VIRTIO_PKT_NONE,
          "Busy release changed the empty RX descriptor");
    check(virtio_pkt_free_index() != VIRTIO_PKT_NONE, "release did not return the Free buffer");
    check(atomic_word_load(&virtio_rx_irq_flag) == 0, "release invented an IRQ indication");
    let used_before: VirtioRingIndex = rx_used(again);
    block_device_give(guard);
    done_at = -1;
    wake_ticks = read_cntfrq() / 64;
    let waited_before: usize = waits;
    net_rx_wait();
    check(waits == waited_before + 1 && atomic_word_load(&virtio_rx_irq_flag) == 0,
          "no-IRQ refill retry must return on one timer-style wake");
    let again = match net_rx_acquire(again) {
        NetRxAcquire::None(cap) => { cap }
        NetRxAcquire::Acquired(frame) => {
            let cap = net_rx_release(frame);
            check(false, "refill retry invented another used entry");
            cap
        }
    };
    check(rx_avail(again) == virtio_ring_index_next(before) &&
          virtio_net_rx_slot(again, 0) != VIRTIO_PKT_NONE && rx_used(again) == used_before,
          "timer-style retry did not repost the empty descriptor");
    virtio_pkt_park(a, held_a);
    virtio_pkt_park(b, held_b);
    return again;
}

// #740: the same boundary, refilled by a transmit completion instead of a
// release: the reply's completion (net_tx_complete). net_transmit_ready's
// refill cannot meet an empty descriptor today: the one RX capability it
// needs comes back only by a release or reply, and either refills first.
fn drain_pool_tx_case(ready: sink NetRxCanAcquire[net]) -> NetRxCanAcquire[net] !{unsafe, may_block} {
    let a: usize = virtio_pkt_free_index();
    let Place::Full(held_a) = virtio_pkt_take(a) else {
        Place::Empty => { check(false, "no first Free buffer"); return ready; }
    };
    let b: usize = virtio_pkt_free_index();
    let Place::Full(held_b) = virtio_pkt_take(b) else {
        Place::Empty => { check(false, "no second Free buffer"); virtio_pkt_park(a, held_a); return ready; }
    };
    let before: VirtioRingIndex = rx_avail(ready);
    let NetRxAcquire::Acquired(packet) = receive(ready) else {
        NetRxAcquire::None(cap) => {
            check(false, "oracle RX frame was refused");
            virtio_pkt_park(a, held_a);
            virtio_pkt_park(b, held_b);
            return cap;
        }
    };
    check(packet_rx_avail(packet) == before, "an empty pool leaves the RX descriptor empty before a reply");
    reset_clock(500, 100, packet_tx_used(packet));
    let ready = net_rx_send_reply(net_rx_reply_ready(packet, 64));
    check(rx_avail(ready) == virtio_ring_index_next(before),
          "the reply's TX completion refills the empty RX descriptor");
    virtio_pkt_park(a, held_a);
    virtio_pkt_park(b, held_b);
    return ready;
}

// #740 step 2: a transmitted frame kept for retransmission. The pool has
// ten buffers, eight posted, and VIRTIO_PKT_RESERVE 9 (every descriptor
// full plus one Free buffer for a kernel-built frame), so one frame may be
// kept and a second keep is refused at the reserve and sent as a plain
// transmit. The kept buffer is resent from its slot and stays Kept; its
// off-turn free touches no descriptor.
fn tx_keep_case(ready: sink NetRxCanAcquire[net]) -> NetRxCanAcquire[net] !{unsafe, may_block} {
    check(virtio_pkt_out_count() == 0, "nothing kept before the keep case");
    let slot: usize = net_tx_keep_slot();
    check(slot != NET_KEPT_NONE, "the first keep passes the reserve");
    packet[0] = 7;
    reset_clock(500, 100, tx_used_shadow(ready));
    let tx_before: VirtioRingIndex = tx_avail(ready);
    let ready = match net_transmit_keep(ready, slot, packet as []u8, 60) {
        NetTxKeep::Kept(cap) => { cap }
        NetTxKeep::Sent(cap) => { check(false, "a keep below the reserve was refused"); cap }
    };
    check(tx_avail(ready) == virtio_ring_index_next(tx_before), "the kept frame was transmitted");
    check(virtio_pkt_out_count() == 1, "the kept buffer counts as out");
    // At the reserve: refused, and a stale slot is sent, not kept.
    check(net_tx_keep_slot() == NET_KEPT_NONE, "a second keep is refused at the reserve");
    reset_clock(500, 100, tx_used_shadow(ready));
    let ready = match net_transmit_keep(ready, slot, packet as []u8, 60) {
        NetTxKeep::Kept(cap) => { check(false, "a keep past the reserve was accepted"); cap }
        NetTxKeep::Sent(cap) => { cap }
    };
    check(tx_avail(ready) == virtio_ring_index_next(virtio_ring_index_next(tx_before)),
          "a refused keep still transmits the frame");
    check(virtio_pkt_out_count() == 1, "a refused keep keeps nothing");
    // Resent in place: transmitted again, Kept again in the same slot.
    let mut resent = ready;
    match net_packet_kept_claim(slot) {
        NetKeptClaim::None => { check(false, "the kept frame is not claimable"); }
        NetKeptClaim::Claimed(kept) => {
            reset_clock(500, 100, tx_used_shadow(resent));
            resent = net_packet_kept_resend(resent, kept);
        }
    }
    check(tx_avail(resent) == virtio_ring_index_next(virtio_ring_index_next(
              virtio_ring_index_next(tx_before))), "the resend transmits");
    check(virtio_pkt_out_count() == 1, "the resent buffer is Kept again");
    let rx_before: VirtioRingIndex = rx_avail(resent);
    match net_packet_kept_claim(slot) {
        NetKeptClaim::None => { check(false, "the resent frame is not claimable"); }
        NetKeptClaim::Claimed(kept) => {
            check(virtio_pkt_out_count() == 1, "a claimed buffer's empty slot still counts as out");
            net_packet_free(kept);
        }
    }
    check(rx_avail(resent) == rx_before, "an off-turn free touches no descriptor");
    check(virtio_pkt_out_count() == 0, "the freed buffer is back");
    check(net_tx_keep_slot() != NET_KEPT_NONE, "after the free a keep passes again");
    return resent;
}

fn send_reply(ready: sink NetRxCanAcquire[net]) -> NetRxCanAcquire[net] !{may_block} {
    match receive(ready) {
        NetRxAcquire::Acquired(frame) => {
            return net_rx_send_reply(net_rx_reply_ready(frame, 64));
        }
        NetRxAcquire::None(again) => {
            check(false, "oracle RX frame was refused");
            return again;
        }
    }
}

fn send_timeout_case(ready: sink NetRxCanAcquire[net], reply_timeout: bool)
        -> NetRxCanAcquire[net] !{may_block} {
    if (reply_timeout) {
        return send_reply(ready);
    }
    return net_transmit_ready(ready, packet as []u8, 64);
}

fn virtio_fixture_attach_registers(phase: borrow BootPhase[boot], address: usize) !{unsafe} {
    let RegionBytes::Assumed(registers) = region_bytes_assume(address, 128 * 4) else {};
    match io_handle_attach(&virtio_net_regs, registers) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { check(false, "native fake MMIO window refused"); }
    }
}

fn run_driver_case(reply_timeout: bool) !{may_block} {
    let address: usize = (fake_regs as *u8) as usize;
    check(address > 0 && address < 0x80000000, "native fake MMIO must fit the legacy i32 base");
    let phase = boot_phase_mint();
    virtio_fixture_attach_registers(phase, address);
    // The kernel's boot DTB walk sets these under the boot phase.
    boot_once_set(&virtio_base, phase, address as i32);
    boot_once_set(&virtio_net_gic_intid, phase, 48);
    boot_once_set(&rp1_dma_pci_offset, phase, 0);
    boot_phase_end(phase);
    // A modern transport offering queues of eight.
    fake_regs[1] = 2;
    fake_regs[13] = 8;
    match net_init() {
        NetInitResult::Ready(cap) => { run_initialized_case(cap, reply_timeout); }
        NetInitResult::Failed => { check(false, "fake transport initialization failed"); }
    }
}

fn run_initialized_case(ready: sink NetRxCanAcquire[net], reply_timeout: bool) !{may_block, unsafe} {
    let ready = queue_contention_case(ready);

    let seen0: VirtioRingIndex = tx_used_shadow(ready);
    reset_clock(-1, 100000, seen0);
    (*tx_used()).idx = virtio_ring_index_next(seen0);
    expect_completed(seen0);
    check(waits == 0, "already-complete needs no wake");
    reset_clock(12000, 1, seen0);
    expect_completed(seen0);
    check(waits > 1000 && fake_now < 1000001, "frequent wakes cannot exhaust the time budget");
    reset_clock(-1, 100000, seen0);
    expect_unconfirmed(seen0);
    check(waits == 10 && fake_now >= 1000001 && fake_now < 1100000, "absent completion expires at 1 second");
    reset_clock(1000001, 1000000, seen0);
    expect_completed(seen0);
    check(waits == 1, "completion at the boundary wins");
    reset_clock(-1, 1100000, seen0);
    expect_unconfirmed(seen0);
    check(waits == 1, "late unrelated wake reports expiry");

    packet[0] = 42;
    reset_clock(500, 100, seen0);
    let ready = net_transmit_ready(ready, packet as []u8, 64);
    check(waits > 1 && timeout_logs == 0, "normal standalone send completes after unrelated wakes");
    // #740: the packet the stack holds names no descriptor; acquire has
    // already given descriptor 0 a fresh buffer, so release posts nothing.
    let rx_avail_held: VirtioRingIndex = rx_avail(ready);
    let ready = match receive(ready) {
        NetRxAcquire::None(cap) => { check(false, "oracle RX frame was refused"); cap }
        NetRxAcquire::Acquired(frame) => {
            check(packet_rx_avail(frame) == virtio_ring_index_next(rx_avail_held),
                  "acquire refills the RX descriptor while the stack holds the packet");
            net_rx_release(frame)
        }
    };
    check(rx_avail(ready) == virtio_ring_index_next(rx_avail_held),
          "release of a held packet reposts no descriptor twice");
    let ready = drain_pool_case(ready);
    let ready = drain_pool_busy_release_case(ready);
    let ready = drain_pool_tx_case(ready);
    let ready = tx_keep_case(ready);
    reset_clock(500, 100, tx_used_shadow(ready));
    let ready = send_reply(ready);
    check(waits > 1 && timeout_logs == 0, "normal reply completes and reposts RX");

    reset_clock(-1, 100000, tx_used_shadow(ready));
    let used_before: VirtioRingIndex = tx_used_shadow(ready);
    // A reply's acquire refills its RX descriptor before the transmit
    // (#740: the stack's packet names no descriptor); the unconfirmed
    // completion itself reposts nothing more.
    let mut rx_avail_expected: VirtioRingIndex = rx_avail(ready);
    if (reply_timeout) { rx_avail_expected = virtio_ring_index_next(rx_avail(ready)); }
    let ready = send_timeout_case(ready, reply_timeout);
    check(waits == 10 && timeout_logs == 1, "driver returns and logs once on expiry");
    check(tx_used_shadow(ready) == used_before && rx_avail(ready) == rx_avail_expected,
          "unconfirmed completion neither consumes TX nor reposts RX");
    let tx_avail_before: VirtioRingIndex = tx_avail(ready);
    let notify_before: i32 = fake_regs[20];
    // The unconfirmed buffer is parked Unconfirmed, which has no write
    // access, so its payload is unchanged by construction (#740).
    packet[0] = 99;
    let ready = net_transmit_ready(ready, packet as []u8, 64);
    check(tx_avail(ready) == tx_avail_before &&
          fake_regs[20] == notify_before && timeout_logs == 1,
          "later standalone sends leave descriptor, payload and notification unchanged");
    // Even a late used entry and IRQ cannot revive the disabled queues.
    (*tx_used()).idx = virtio_ring_index_next(tx_used_shadow(ready));
    let late_rx: *VirtqUsedRing = unsafe { atomic_word_load(&virtio_net_used_addr[0]) as *VirtqUsedRing };
    let late_seen: VirtioRingIndex = rx_used(ready);
    let late_slot: {0..<8 as usize} = (((late_seen as u16) as usize) % 8) as {0..<8 as usize};
    late_rx.ring[late_slot].id = 0;
    late_rx.ring[late_slot].len = 74;
    late_rx.idx = virtio_ring_index_next(late_seen);
    atomic_word_store(&virtio_rx_irq_flag, 1);
    let ready = match net_rx_acquire(ready) {
        NetRxAcquire::None(cap) => { cap }
        NetRxAcquire::Acquired(frame) => {
            check(false, "late interrupt revived RX after timeout");
            net_rx_release(frame)
        }
    };
    let wakes_before: usize = waits;
    net_rx_wait();
    check(waits == wakes_before + 1 && timeout_logs == 1,
          "disabled RX wait still yields to periodic deadline checks");
    net_shutdown(ready);
}

// The kernel's address mint (kernel/drivers/dma_address.tkb, which
// virtio_used.tkb uses) names RP1's inbound offset; the kernel defines it in
// rpi5/pcie.tkb, which this fixture does not compile.
// The kernel's BootOnce(usize), set to 0 with the discovery words.
let mut rp1_dma_pci_offset: BootOnce(usize);
// The kernel's stop for a BootOnce read before its write (boot_prologue.tkb).
fn boot_once_unwritten_stop() {
    check(false, "a BootOnce cell read before its boot write");
}
