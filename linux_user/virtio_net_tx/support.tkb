// Execute the actual virtio-net driver with deterministic clock and used-ring
// responses. RAM stands in for MMIO and device-written queue memory; these
// tests do not claim interrupt delivery, DMA ordering or cache evidence.
let mut fake_regs: [i32; 128];
let mut fake_now: i64;
let mut done_at: i64;
let mut wake_ticks: i64;
let mut waits: usize;
let mut timeout_logs: usize;
let mut packet: [u8; 1514];

fn virtio_fixture_notify() {}
fn mutex_irq_save() -> usize { return 0; }
fn mutex_irq_restore(flags: usize) {}
// The driver's DDB look names the stop authority (#1164); nothing here calls it.
linear struct MachineStopped[stop: addr] { private owner: usize; }
let mut kernel_world_stop: usize;
fn gic_intid_clear_pending(intid: u32) {}
fn gic_intid_enable(intid: u32) {}
fn gic_intid_target(intid: u32, cpu: u32) {}
fn nic_irq_route(intid: u32) {}
fn workload_profile_note_network_rx(len: usize) {}
fn workload_profile_note_network_tx(len: usize) {}
fn kernel_boot_log(message: *u8) { timeout_logs = timeout_logs + 1; }
fn kernel_invariant_stop() { check(false, "driver stopped on an invariant"); }
fn read_cntpct() -> i64 { fake_now = fake_now + 1; return fake_now; }
fn read_cntfrq() -> i64 { return 1000000; }

fn check(ok: bool, label: *u8) {
    if (ok == false) {
        uart_puts("FAIL virtio-net-tx: "); uart_puts(label); uart_puts("\r\n");
        linux_exit(1);
    }
}

fn tx_used() -> *VirtqUsedRing !{unsafe} {
    return unsafe { virtio_net_used_addr[1] as *VirtqUsedRing };
}

fn workload_profile_interrupt_wait() !{may_block} {
    waits = waits + 1;
    // An old unbounded wait fails quickly rather than hanging the host suite.
    check(waits < 40000, "wait did not return after the elapsed deadline");
    fake_now = fake_now + wake_ticks;
    if (done_at >= 0 && fake_now >= done_at) {
        (*tx_used()).idx = virtio_ring_index_next(tx_used_seen);
    }
}

fn reset_clock(completion: i64, step: i64) {
    fake_now = 0; done_at = completion; wake_ticks = step; waits = 0;
    (*tx_used()).idx = tx_used_seen;
}

fn expect_completed() !{may_block} {
    match virtio_net_tx_wait() {
        VirtioNetTxCompletion::Completed => {}
        VirtioNetTxCompletion::Unconfirmed => { check(false, "completion not observed"); }
    }
}

fn expect_unconfirmed() !{may_block} {
    match virtio_net_tx_wait() {
        VirtioNetTxCompletion::Completed => { check(false, "wake falsely proves completion"); }
        VirtioNetTxCompletion::Unconfirmed => {}
    }
}

fn receive(ready: sink NetRxCanAcquire) -> NetRxAcquire !{unsafe} {
    return receive_id(ready, 0);
}

// The device's used entry naming RX descriptor `id`.
fn receive_id(ready: sink NetRxCanAcquire, id: u32) -> NetRxAcquire !{unsafe} {
    let used: *VirtqUsedRing = unsafe { virtio_net_used_addr[0] as *VirtqUsedRing };
    let slot: {0..<8 as usize} = (((rx_used_seen as u16) as usize) % 8) as {0..<8 as usize};
    used.ring[slot].id = id;
    used.ring[slot].len = 74;
    used.idx = virtio_ring_index_next(rx_used_seen);
    atomic_word_store(&virtio_rx_irq_flag, 1);
    return net_rx_acquire(ready);
}

// #740: the boundary where the pool is empty at acquire. The fixture takes
// every Free buffer out of the pool, so the acquire's refill finds none and
// descriptor 0 stays empty; the release of the packet refills it.
fn drain_pool_case(ready: sink NetRxCanAcquire) -> NetRxCanAcquire !{unsafe} {
    let a: usize = virtio_pkt_free_index();
    let Place::Full(held_a) = virtio_pkt_take(a) else {
        Place::Empty => { check(false, "no first Free buffer"); return ready; }
    };
    let b: usize = virtio_pkt_free_index();
    let Place::Full(held_b) = virtio_pkt_take(b) else {
        Place::Empty => { check(false, "no second Free buffer"); virtio_pkt_park(a, held_a); return ready; }
    };
    check(virtio_pkt_free_index() == VIRTIO_PKT_NONE, "the fixture emptied the pool");
    let before: VirtioRingIndex = rx_avail_idx;
    let NetRxAcquire::Acquired(packet) = receive(ready) else {
        NetRxAcquire::None(cap) => {
            check(false, "oracle RX frame was refused");
            virtio_pkt_park(a, held_a);
            virtio_pkt_park(b, held_b);
            return cap;
        }
    };
    check(rx_avail_idx == before, "an empty pool leaves the RX descriptor empty");
    let again = net_rx_release(packet);
    check(rx_avail_idx == virtio_ring_index_next(before),
          "the next release refills the empty RX descriptor");
    virtio_pkt_park(a, held_a);
    virtio_pkt_park(b, held_b);
    return again;
}

// #740: the same boundary, refilled by a transmit completion instead of a
// release: the reply's completion (net_tx_complete). net_transmit_ready's
// refill cannot meet an empty descriptor today: the one RX capability it
// needs comes back only by a release or reply, and either refills first.
fn drain_pool_tx_case(ready: sink NetRxCanAcquire) -> NetRxCanAcquire !{unsafe, may_block} {
    let a: usize = virtio_pkt_free_index();
    let Place::Full(held_a) = virtio_pkt_take(a) else {
        Place::Empty => { check(false, "no first Free buffer"); return ready; }
    };
    let b: usize = virtio_pkt_free_index();
    let Place::Full(held_b) = virtio_pkt_take(b) else {
        Place::Empty => { check(false, "no second Free buffer"); virtio_pkt_park(a, held_a); return ready; }
    };
    let before: VirtioRingIndex = rx_avail_idx;
    let NetRxAcquire::Acquired(packet) = receive(ready) else {
        NetRxAcquire::None(cap) => {
            check(false, "oracle RX frame was refused");
            virtio_pkt_park(a, held_a);
            virtio_pkt_park(b, held_b);
            return cap;
        }
    };
    check(rx_avail_idx == before, "an empty pool leaves the RX descriptor empty before a reply");
    reset_clock(500, 100);
    let ready = net_rx_send_reply(net_rx_reply_ready(packet, 64));
    check(rx_avail_idx == virtio_ring_index_next(before),
          "the reply's TX completion refills the empty RX descriptor");
    virtio_pkt_park(a, held_a);
    virtio_pkt_park(b, held_b);
    return ready;
}

// #740 step 2: a transmitted frame kept for retransmission. The pool has
// ten buffers, eight posted, and VIRTIO_PKT_RESERVE 9 (every descriptor
// full plus one Free buffer for a kernel-built frame), so one frame may be
// kept and a second keep is refused at the reserve and sent as a plain
// transmit. The kept buffer is resent from its slot and stays Kept; its
// off-turn free touches no descriptor.
fn tx_keep_case(ready: sink NetRxCanAcquire) -> NetRxCanAcquire !{unsafe, may_block} {
    check(virtio_pkt_out_count() == 0, "nothing kept before the keep case");
    let slot: usize = net_tx_keep_slot();
    check(slot != NET_KEPT_NONE, "the first keep passes the reserve");
    packet[0] = 7;
    reset_clock(500, 100);
    let tx_before: VirtioRingIndex = tx_avail_idx;
    let ready = match net_transmit_keep(ready, slot, packet as []u8, 60) {
        NetTxKeep::Kept(cap) => { cap }
        NetTxKeep::Sent(cap) => { check(false, "a keep below the reserve was refused"); cap }
    };
    check(tx_avail_idx == virtio_ring_index_next(tx_before), "the kept frame was transmitted");
    check(virtio_pkt_out_count() == 1, "the kept buffer counts as out");
    // At the reserve: refused, and a stale slot is sent, not kept.
    check(net_tx_keep_slot() == NET_KEPT_NONE, "a second keep is refused at the reserve");
    reset_clock(500, 100);
    let ready = match net_transmit_keep(ready, slot, packet as []u8, 60) {
        NetTxKeep::Kept(cap) => { check(false, "a keep past the reserve was accepted"); cap }
        NetTxKeep::Sent(cap) => { cap }
    };
    check(tx_avail_idx == virtio_ring_index_next(virtio_ring_index_next(tx_before)),
          "a refused keep still transmits the frame");
    check(virtio_pkt_out_count() == 1, "a refused keep keeps nothing");
    // Resent in place: transmitted again, Kept again in the same slot.
    let mut resent = ready;
    match net_packet_kept_claim(slot) {
        NetKeptClaim::None => { check(false, "the kept frame is not claimable"); }
        NetKeptClaim::Claimed(kept) => {
            reset_clock(500, 100);
            resent = net_packet_kept_resend(resent, kept);
        }
    }
    check(tx_avail_idx == virtio_ring_index_next(virtio_ring_index_next(
              virtio_ring_index_next(tx_before))), "the resend transmits");
    check(virtio_pkt_out_count() == 1, "the resent buffer is Kept again");
    let rx_before: VirtioRingIndex = rx_avail_idx;
    match net_packet_kept_claim(slot) {
        NetKeptClaim::None => { check(false, "the resent frame is not claimable"); }
        NetKeptClaim::Claimed(kept) => {
            check(virtio_pkt_out_count() == 1, "a claimed buffer's empty slot still counts as out");
            net_packet_free(kept);
        }
    }
    check(rx_avail_idx == rx_before, "an off-turn free touches no descriptor");
    check(virtio_pkt_out_count() == 0, "the freed buffer is back");
    check(net_tx_keep_slot() != NET_KEPT_NONE, "after the free a keep passes again");
    return resent;
}

fn send_reply(ready: sink NetRxCanAcquire) -> NetRxCanAcquire !{may_block} {
    match receive(ready) {
        NetRxAcquire::Acquired(frame) => {
            return net_rx_send_reply(net_rx_reply_ready(frame, 64));
        }
        NetRxAcquire::None(again) => {
            check(false, "oracle RX frame was refused");
            return again;
        }
    }
}

fn send_timeout_case(ready: sink NetRxCanAcquire, reply_timeout: bool)
        -> NetRxCanAcquire !{may_block} {
    if (reply_timeout) {
        return send_reply(ready);
    }
    return net_transmit_ready(ready, packet as []u8, 64);
}

fn run_driver_case(reply_timeout: bool) !{may_block} {
    let address: usize = (fake_regs as *u8) as usize;
    check(address > 0 && address < 0x80000000, "native fake MMIO must fit the legacy i32 base");
    let RegionBytes::Assumed(registers) = region_bytes_assume(address, 128 * 4) else {};
    match io_handle_attach(&virtio_net_regs, registers) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { check(false, "native fake MMIO window refused"); }
    }
    virtio_base = address as i32;
    virtio_net_gic_intid = 48;
    // A modern transport offering queues of eight.
    fake_regs[1] = 2;
    fake_regs[13] = 8;
    match net_init() {
        NetInitResult::Ready(cap) => { run_initialized_case(cap, reply_timeout); }
        NetInitResult::Failed => { check(false, "fake transport initialization failed"); }
    }
}

fn run_initialized_case(ready: sink NetRxCanAcquire, reply_timeout: bool) !{may_block, unsafe} {

    reset_clock(-1, 100000);
    (*tx_used()).idx = virtio_ring_index_next(tx_used_seen);
    expect_completed();
    check(waits == 0, "already-complete needs no wake");
    reset_clock(12000, 1);
    expect_completed();
    check(waits > 1000 && fake_now < 1000001, "frequent wakes cannot exhaust the time budget");
    reset_clock(-1, 100000);
    expect_unconfirmed();
    check(waits == 10 && fake_now >= 1000001 && fake_now < 1100000, "absent completion expires at 1 second");
    reset_clock(1000001, 1000000);
    expect_completed();
    check(waits == 1, "completion at the boundary wins");
    reset_clock(-1, 1100000);
    expect_unconfirmed();
    check(waits == 1, "late unrelated wake reports expiry");

    packet[0] = 42;
    reset_clock(500, 100);
    let ready = net_transmit_ready(ready, packet as []u8, 64);
    check(waits > 1 && timeout_logs == 0, "normal standalone send completes after unrelated wakes");
    // #740: the packet the stack holds names no descriptor; acquire has
    // already given descriptor 0 a fresh buffer, so release posts nothing.
    let rx_avail_held: VirtioRingIndex = rx_avail_idx;
    let ready = match receive(ready) {
        NetRxAcquire::None(cap) => { check(false, "oracle RX frame was refused"); cap }
        NetRxAcquire::Acquired(frame) => {
            check(rx_avail_idx == virtio_ring_index_next(rx_avail_held),
                  "acquire refills the RX descriptor while the stack holds the packet");
            net_rx_release(frame)
        }
    };
    check(rx_avail_idx == virtio_ring_index_next(rx_avail_held),
          "release of a held packet reposts no descriptor twice");
    let ready = drain_pool_case(ready);
    let ready = drain_pool_tx_case(ready);
    let ready = tx_keep_case(ready);
    reset_clock(500, 100);
    let ready = send_reply(ready);
    check(waits > 1 && timeout_logs == 0, "normal reply completes and reposts RX");

    reset_clock(-1, 100000);
    let used_before: VirtioRingIndex = tx_used_seen;
    // A reply's acquire refills its RX descriptor before the transmit
    // (#740: the stack's packet names no descriptor); the unconfirmed
    // completion itself reposts nothing more.
    let mut rx_avail_expected: VirtioRingIndex = rx_avail_idx;
    if (reply_timeout) { rx_avail_expected = virtio_ring_index_next(rx_avail_idx); }
    let ready = send_timeout_case(ready, reply_timeout);
    check(waits == 10 && timeout_logs == 1, "driver returns and logs once on expiry");
    check(tx_used_seen == used_before && rx_avail_idx == rx_avail_expected,
          "unconfirmed completion neither consumes TX nor reposts RX");
    let tx_avail_before: VirtioRingIndex = tx_avail_idx;
    let notify_before: i32 = fake_regs[20];
    // The unconfirmed buffer is parked Unconfirmed, which has no write
    // access, so its payload is unchanged by construction (#740).
    packet[0] = 99;
    let ready = net_transmit_ready(ready, packet as []u8, 64);
    check(tx_avail_idx == tx_avail_before &&
          fake_regs[20] == notify_before && timeout_logs == 1,
          "later standalone sends leave descriptor, payload and notification unchanged");
    // Even a late used entry and IRQ cannot revive the disabled queues.
    (*tx_used()).idx = virtio_ring_index_next(tx_used_seen);
    let late_rx: *VirtqUsedRing = unsafe { virtio_net_used_addr[0] as *VirtqUsedRing };
    let late_slot: {0..<8 as usize} = (((rx_used_seen as u16) as usize) % 8) as {0..<8 as usize};
    late_rx.ring[late_slot].id = 0;
    late_rx.ring[late_slot].len = 74;
    late_rx.idx = virtio_ring_index_next(rx_used_seen);
    atomic_word_store(&virtio_rx_irq_flag, 1);
    let ready = match net_rx_acquire(ready) {
        NetRxAcquire::None(cap) => { cap }
        NetRxAcquire::Acquired(frame) => {
            check(false, "late interrupt revived RX after timeout");
            net_rx_release(frame)
        }
    };
    let wakes_before: usize = waits;
    net_rx_wait();
    check(waits == wakes_before + 1 && timeout_logs == 1,
          "disabled RX wait still yields to periodic deadline checks");
    net_shutdown(ready);
}

// The kernel's address mint (kernel/drivers/dma_address.tkb, which
// virtio_used.tkb uses) names RP1's inbound offset; the kernel defines it in
// rpi5/pcie.tkb, which this fixture does not compile.
// The kernel's is a BootOnce(usize) read through boot_once_get; this cell and
// reader stand in for that shape without the boot phase.
struct Rp1DmaOffsetCell { value: usize; }
let mut rp1_dma_pci_offset: Rp1DmaOffsetCell;
fn boot_once_get(cell: &mut Rp1DmaOffsetCell) -> usize { return (*cell).value; }
