// The ring a peer CPU's console output crosses to core 0 in, both ends.
//
// GitHub issue #534. This compiles kernel/printk/peer_console.tkb itself,
// not a copy, and performs the operations its two real callers perform:
// the producer asks for room and publishes a slice, and the consumer peeks
// a record, reads it element by element, and retires it. One thread plays
// both CPUs, so this checks order, capacity and refusal. Whether core 0's
// acquire sees core 1's release is the kernel lanes' question.
//
// The numbers below are the requirement written out -- 64-byte records,
// sixteen to a ring -- not the file's constants.

fn check(label: *u8, ok: bool) {
    if (ok) {
        uart_puts("ok     ");
    } else {
        uart_puts("FAILED ");
    }
    uart_puts(label);
    uart_puts("\r\n");
}

let mut input: [u8; 2048];
let mut output: [u8; 2048];
let mut output_len: usize;
let mut record: PeerConsoleRecord;

// Byte n of the input stream, from a pattern that tells a reordered or
// repeated record from the right one.
fn pattern(n: usize) -> u8 {
    return ((n * 7 + n / 64) % 251) as u8;
}

fn fill_input(first: usize) {
    for i: usize in 0..<2048 { input[i] = pattern(first + i); }
}

// Everything core 0 would move, in the order it would move it.
fn drain(cpu: usize) -> usize {
    let mut records: usize = 0;
    for step: usize in 0..<32 {
        match peer_console_peek(cpu, &record) {
            PeerConsolePeek::Empty => { }
            PeerConsolePeek::Ready(length) => {
                for i: usize in 0..<64 {
                    if (i < length && output_len < 2048) {
                        let at: usize = output_len;
                        if (at < 2048) { output[at] = record.bytes[i]; }
                        output_len = output_len + 1;
                    }
                }
                peer_console_retire(cpu);
                records = records + 1;
            }
        }
    }
    return records;
}

fn output_is(first: usize, length: usize) -> bool {
    if (output_len != length) { return false; }
    for i: usize in 0..<2048 {
        if (i < length && output[i] != pattern(first + i)) { return false; }
    }
    return true;
}

fn publish_bytes(cpu: usize, length: usize) -> usize {
    if (length > 2048) { return 0; }
    return peer_console_publish(cpu, input[0..<length]);
}

fn app_main() {
    check("an empty ring has nothing to peek",
          drain(1) == 0 && output_len == 0);
    check("an empty ring has room for sixteen 64-byte records",
          peer_console_room(1) == 1024);

    fill_input(0);
    check("a short write is taken whole", publish_bytes(1, 10) == 10);
    check("it is one record, with its bytes",
          drain(1) == 1 && output_is(0, 10));

    // Longer than a record: three records, in order, with the stream
    // unbroken across them.
    output_len = 0;
    fill_input(1000);
    check("a 150-byte write is taken whole", publish_bytes(1, 150) == 150);
    check("as three records whose bytes join up",
          drain(1) == 3 && output_is(1000, 150));

    // Forced full, the negative control. Nothing drains, so the ring holds
    // sixteen records and no more, a further write takes nothing, and none
    // of what was taken is overwritten.
    output_len = 0;
    fill_input(0);
    check("a full ring takes sixteen records of a longer write",
          publish_bytes(1, 2000) == 1024);
    check("and then has no room", peer_console_room(1) == 0);
    fill_input(1024);
    check("a write to a full ring takes nothing", publish_bytes(1, 100) == 0);

    // One record out makes room for one record in, and the refused bytes
    // are the caller's to send again.
    check("one record drained after the ring filled",
          drain_one(1) && output_is(0, 64));
    check("frees exactly one record's room", peer_console_room(1) == 64);
    check("which the retried write takes", publish_bytes(1, 100) == 64);
    check("and the stream reads through the wrap with nothing lost or repeated",
          drain(1) == 16 && output_is(0, 1088));

    // Each CPU's ring is its own.
    output_len = 0;
    fill_input(0);
    check("core 0 publishes into its own ring", publish_bytes(0, 5) == 5);
    check("which core 1's drain does not see", drain(1) == 0);
    check("and its own drain does",
          drain(0) == 1 && output_is(0, 5));

    check("a CPU past the maximum has no ring",
          peer_console_room(2) == 0 && publish_bytes(2, 5) == 0 &&
          drain(2) == 0);
}

// One record only, for the step after the ring filled.
fn drain_one(cpu: usize) -> bool {
    match peer_console_peek(cpu, &record) {
        PeerConsolePeek::Empty => { return false; }
        PeerConsolePeek::Ready(length) => {
            for i: usize in 0..<64 {
                if (i < length) {
                    let at: usize = output_len;
                    if (at < 2048) { output[at] = record.bytes[i]; }
                    output_len = output_len + 1;
                }
            }
            peer_console_retire(cpu);
            return true;
        }
    }
}
