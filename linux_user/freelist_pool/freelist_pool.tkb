// Exercises freelist_pool_core.tkb's O(1) free list: allocate three slots,
// free the first two in order (a, then b), then reallocate three times.
// A free list hands back the most-recently-freed slot first (LIFO), so the
// reuse order is b's slot, then a's slot, then the never-yet-used slot --
// the opposite of what page_pool.tkb's lowest-free-index linear scan would
// produce from the same sequence. That divergence is the point: it proves
// this is a genuinely different mechanism, not a renamed copy.
//
// Also demonstrates per-slot content that this caller (not
// freelist_pool_core.tkb) decides: SlotOwner stays index+generation only
// (the "core" never learns what a usize payload even means), and this file
// keeps its own [usize; POOL_COUNT] array plus payload_set/payload_get
// accessors keyed by slot_index(owner) -- the same split page_pool_core.tkb
// already uses between PageOwner (identity/proof) and the separate
// page_pool byte array (content), via page_bytes(owner). The reuse
// sequence below also shows a consequence of that split worth knowing:
// freeing a slot does not clear its content, so a freshly (re)allocated
// owner can observe the previous occupant's stale payload until this file
// explicitly overwrites it -- the free list only guarantees index/
// generation uniqueness, never content freshness.

use "linux_user/freelist_pool/freelist_pool_core.tkb";

private let mut slot_payload: [usize; POOL_COUNT];

fn payload_set(owner: borrow SlotOwner[allocation], value: usize) {
    slot_payload[slot_index(owner)] = value;
}

fn payload_get(owner: borrow SlotOwner[allocation]) -> usize {
    return slot_payload[slot_index(owner)];
}

fn app_main() {
    freelist_pool_init();
    uart_puts("freelist_pool\n");

    let a: exists sa: usize. SlotOwner[sa] = match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("alloc a failed\n");
            return;
        }
        SlotAllocResult::Allocated(o) => { o }
    };
    let b: exists sb: usize. SlotOwner[sb] = match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("alloc b failed\n");
            slot_free(a);
            return;
        }
        SlotAllocResult::Allocated(o) => { o }
    };
    let c: exists sc: usize. SlotOwner[sc] = match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("alloc c failed\n");
            slot_free(a);
            slot_free(b);
            return;
        }
        SlotAllocResult::Allocated(o) => { o }
    };

    uart_puts("allocated: ");
    uart_print(slot_index(a));
    uart_puts(" ");
    uart_print(slot_index(b));
    uart_puts(" ");
    uart_print(slot_index(c));
    uart_puts("\n");

    payload_set(a, 100);
    payload_set(b, 200);
    payload_set(c, 300);
    uart_puts("payloads: ");
    uart_print(payload_get(a));
    uart_puts(" ");
    uart_print(payload_get(b));
    uart_puts(" ");
    uart_print(payload_get(c));
    uart_puts("\n");

    slot_free(a);
    slot_free(b);

    let r1: exists s1: usize. SlotOwner[s1] = match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("reuse 1 failed\n");
            slot_free(c);
            return;
        }
        SlotAllocResult::Allocated(o) => { o }
    };
    let r2: exists s2: usize. SlotOwner[s2] = match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("reuse 2 failed\n");
            slot_free(r1);
            slot_free(c);
            return;
        }
        SlotAllocResult::Allocated(o) => { o }
    };
    let r3: exists s3: usize. SlotOwner[s3] = match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("reuse 3 failed\n");
            slot_free(r1);
            slot_free(r2);
            slot_free(c);
            return;
        }
        SlotAllocResult::Allocated(o) => { o }
    };

    uart_puts("reused (LIFO order: b's slot, then a's slot, ");
    uart_puts("then never-used slot): ");
    uart_print(slot_index(r1));
    uart_puts(" ");
    uart_print(slot_index(r2));
    uart_puts(" ");
    uart_print(slot_index(r3));
    uart_puts("\ngenerations: ");
    uart_print(slot_generation(r1));
    uart_puts(" ");
    uart_print(slot_generation(r2));
    uart_puts(" ");
    uart_print(slot_generation(r3));
    uart_puts("\n");

    uart_puts("stale payloads (r1 sees b's old 200, r2 sees a's old 100, ");
    uart_puts("r3 sees a never-set slot's 0): ");
    uart_print(payload_get(r1));
    uart_puts(" ");
    uart_print(payload_get(r2));
    uart_puts(" ");
    uart_print(payload_get(r3));
    uart_puts("\n");

    payload_set(r1, 111);
    payload_set(r2, 222);
    payload_set(r3, 333);
    uart_puts("payloads after this caller resets them: ");
    uart_print(payload_get(r1));
    uart_puts(" ");
    uart_print(payload_get(r2));
    uart_puts(" ");
    uart_print(payload_get(r3));
    uart_puts("\n");

    match slot_alloc() {
        SlotAllocResult::OutOfMemory => {
            uart_puts("pool exhausted as expected\n");
        }
        SlotAllocResult::Allocated(o) => {
            uart_puts("unexpected extra allocation: ");
            uart_print(slot_index(o));
            uart_puts("\n");
            slot_free(o);
        }
    }

    slot_free(r1);
    slot_free(r2);
    slot_free(r3);
    slot_free(c);
    uart_puts("done\n");
}
