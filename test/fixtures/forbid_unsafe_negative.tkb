// --forbid-unsafe must reject a function whose unsafe effect is reachable,
// even when the boundary is declared with !{unsafe}. The same file builds
// without the flag, so the flag is what rejects it. Moved from the
// historical examples/forbid_unsafe_wrong.

fn raw_byte(p: *u8) -> u8 !{unsafe} {
    let bytes = unsafe { p[0..<1] };
    return bytes[0];
}
