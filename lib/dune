(library
 (name takibi)
 (public_name takibi)
 (modules ast atomic_spec language_words trap_diagnostics target_info const_env generic_scope type_layout publish_registry publish_record local_bindings value_facts types monomorphize declared_type_resolver takibi_core effect_rules type_inf typechecker unused_functions llvm_gen lexer parser use_resolver)
 (libraries menhirLib llvm llvm.analysis llvm.target llvm.all_backends llvm.passbuilder llvm.debuginfo)
 (preprocess
  (pps ppx_deriving.show)))

(menhir
 (modules parser)
 ; GitHub issue #309: --strict turns every menhir warning (including
 ; "N shift/reduce conflicts were arbitrarily resolved") into a hard
 ; build failure instead of scrolling by unnoticed in dune's own output.
 ; Issue #217 introduced 32 such conflicts in one change; menhir's default
 ; resolution happened to be correct in all 32, but nothing forced anyone
 ; to check that before this flag existed.
 (flags --strict))

(rule
 (targets lexer.ml)
 (deps    lexer.mll)
 (action  (run ocamllex -o lexer.ml lexer.mll)))
