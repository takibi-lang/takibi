row base
1 mkdir base -> 0
  base dir
2 mkdir base/d -> 0
  base/d dir
3 write base/d/a hello -> 0
  base/d/a file size=5
4 rename base/d/a base/b -> 0
  base/d/a absent
  base/b file size=5
5 write base/c one -> 0
  base/c file size=3
6 unlink base/c -> 0
  base/c absent
7 rmdir base/d -> 0
  base/d absent
row otrunc
1 mkdir otrunc -> 0
  otrunc dir
2 write otrunc/f 0123456789 -> 0
  otrunc/f file size=10
3 write otrunc/f ab -> 0
  otrunc/f file size=2
row overwrite
1 mkdir overwrite -> 0
  overwrite dir
2 write overwrite/f abcdefgh -> 0
  overwrite/f file size=8
3 write overwrite/src XY -> 0
  overwrite/src file size=2
4 overwrite overwrite/f overwrite/src -> 0
  overwrite/f file size=8
  overwrite/src file size=2
row unlink_indirect
1 mkdir unlink_indirect -> 0
  unlink_indirect dir
2 fill unlink_indirect/f 14 -> 0
  unlink_indirect/f file size=14336
3 unlink unlink_indirect/f -> 0
  unlink_indirect/f absent
row dir_indirect
1 mkdir dir_indirect -> 0
  dir_indirect dir
2 files dir_indirect 52 -> 0 created=52
  dir_indirect dir
row truncate
1 mkdir truncate -> 0
  truncate dir
2 fill truncate/f 14 -> 0
  truncate/f file size=14336
3 truncate truncate/f -> 0
  truncate/f file size=0
row peer
1 mkdir peer -> 0
  peer dir
  held [012345]
  past []
2 peer peer/f -> 0
  peer/f file size=7
row truncate_dind
1 mkdir truncate_dind -> 0
  truncate_dind dir
2 adopt truncate_dind/f -> 0
  truncate_dind/f file size=276480
3 write truncate_dind/f ab -> 0
  truncate_dind/f file size=2
eq done
