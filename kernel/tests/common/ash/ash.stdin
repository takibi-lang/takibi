# The assignment absorbs the first byte that can be lost by the RP1 UART.
x=; /bin/ls
/bin/ls -a
/bin/ls /bin
/bin/ls /many
ps
/etc/script-shebang.sh one two
echo "shebang: status $?"
script-interpreter-argument.sh three
/hello.txt
/etc
/etc/not-a-program
/etc/bad-interpreter.sh
/etc/crlf.sh
/etc/no-newline.sh
/etc/long-shebang.sh
/bin/sh -c 'exec /bin/echo re-exec-ok'
# GitHub issue #538: mkdir and rmdir through mkdirat and unlinkat.
# Each line is one exec, because each BusyBox exec costs about half a second
# of the boot the dmesg validator bounds: nine lines of one command each
# took it from 22.3 s to 27.3 s. mkdir and rmdir carry on past a failing
# argument, so one exec each covers every outcome in order, and each names
# /etc/made/fresh twice: mkdir's second EEXIST is what shows the first made
# it, and rmdir's second ENOENT what shows the first removed it -- which is
# why no `ls` exec is spent confirming either. /etc/made/inner is the boot
# fixture's and stays; /kept stays too, so the lane's e2fsck judges a
# directory made through the syscall.
mkdir /etc/made/fresh /etc/made/fresh /hello.txt/sub /kept
rmdir /etc/made /etc/made/fresh /etc/made/fresh /hello.txt
# Two background jobs at once, and ash's own account of them. /bin/spin is
# one round of the busy loop and then exit: silent, because output that
# interleaved with the prompt would arrive in an order nothing here can
# pin, and long enough that both are still Running when `jobs` asks. That
# listing is the evidence -- two jobs, neither finished -- and it carries no
# pid, so it is the same text on every boot. Two output-less commands leave
# two bare prompts, which is why the line after them carries them.
/bin/spin &
/bin/spin &
jobs
echo two-jobs-ok
echo repl-ok
exit
