# The assignment absorbs the first byte that can be lost by the RP1 UART.
x=; /bin/ls
/bin/ls -a
/bin/ls /bin
/bin/ls /many
ps
/etc/script-shebang.sh one two
echo "shebang: status $?"
script-interpreter-argument.sh three
/hello.txt
/bin/cat /hello.txt
/etc
/etc/not-a-program
/etc/bad-interpreter.sh
/etc/crlf.sh
/etc/no-newline.sh
/etc/long-shebang.sh
# GitHub issue #591: a stock musl binary from the shell, and two copies of
# it whose PT_INTERP names a missing file and a non-musl one.
/bin/taskset -c 0 /bin/echo taskset-ok
/etc/interp-absent
/etc/interp-other
/bin/sh -c 'exec /bin/echo re-exec-ok'
# GitHub issues #538 and #541: mkdir, rmdir and rm through mkdirat and
# unlinkat, one exec each. mkdir and rmdir carry on past a failing argument,
# so one call covers every outcome in order, and each target is named twice:
# the second EEXIST or ENOENT is what shows the first call worked. /etc/made
# and /kept stay, so the lane's e2fsck judges directories made through the
# syscall; /etc/gone is the image's one-link file and /etc/hlink a second
# link to /hello.txt. Each command fits completely in the current 4096-byte
# UART receive ring.
mkdir /etc/made /etc/made/sub /etc/made /hello.txt/x /kept
rmdir /etc/made /etc/made/sub /etc/made/sub /hello.txt
rm /etc/gone /etc/gone /etc/hlink /etc/hlink
# GitHub issues #537 and #542: grow /etc itself through mkdirat,
# enumerate the long names from /etc with ls, remove an entry
# from its new block, then reuse that dead record without shrinking.
# BusyBox stat observes st_size=2048 throughout.
long_name=nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn; for suffix in a b c d e; do mkdir "/etc/$long_name$suffix"; done; /bin/ls -1 /etc; /bin/busybox stat -c %s /etc
rmdir "/etc/${long_name}e"; /bin/ls -1 /etc; /bin/busybox stat -c %s /etc
mkdir "/etc/${long_name}e"; /bin/ls -1 /etc; /bin/busybox stat -c %s /etc
rmdir "/etc/${long_name}e"; for suffix in a b c d; do rmdir "/etc/$long_name$suffix"; done; /bin/busybox stat -c %s /etc; mv /etc/mva /etc/mvc && mv /etc/mvc /etc/mvb && echo mv1
# Leave /etc grown on disk after removing every probe directory.
# GitHub issue #538: mv through renameat. The first line renames within a
# directory and then over an existing file; the second moves a file into
# another directory and renames a directory within its parent. The third
# asks for a name the first line moved away (ENOENT) and a directory move to
# another parent, which the ext2 layer refuses (EPERM). The cat shows the
# chain arrived: /etc/mva's bytes, now under /etc/moved/mvb.
mv /etc/mvb /etc/made && mv /etc/made /etc/moved && echo mv2
mv /etc/mva /kept /etc/moved
/bin/cat /etc/moved/mvb
# GitHub issue #540: close-on-exec across execve. /bin/cloexec
# flags fds 20 and 22, keeps 21, and execs /bin/cloexec-check.
/bin/cloexec
# GitHub issue #9: a ppoll on the terminal beside a runnable process. The
# child of /bin/ppoll-probe waits in ppoll for fd 0 while its parent stays
# runnable, so the wait has to block rather than retry in the kernel. The
# driver types the byte it waits for once the kernel says it blocked.
/bin/ppoll-probe
# GitHub issue #9: the affinity ABI. /bin/affinity reads its default mask,
# narrows itself to CPU 0, and checks what the kernel refuses and what a
# child inherits. It prints only what holds on every platform.
/bin/affinity
# GitHub issue #544: a write six times the console transmit queue. On the
# board the wire cannot keep up, so cat's write fills the queue, returns
# short, and the next one sleeps until the TX interrupt has drained it; the
# boot's `uart tx: ... writers_slept=` line has to be non-zero there. The file
# has no trailing newline, so echo ends the line.
/bin/cat /large.txt && echo
# GitHub issue #543: a line longer than the 63 bytes the kernel's UART
# receive ring used to hold, sent at once. The old ring dropped the rest of a
# line like this one, newline included, and the shell waited for it until the
# lane's budget ran out. echo is a shell builtin, so this costs no exec.
echo uart-rx-ring-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Pin one background child to CPU 0 before the actual BusyBox sleep applet
# runs in the foreground. The kernel records the applet's nanosleep entry on
# the peer before applying the peer-safety table. Ash's normal foreground
# completion reaps sleep; after the verdict, wait reaps the completed guard.
/etc/placement-guard >/dev/null &
placement_guard_pid=$!
/bin/sleep 1 >/dev/null
/etc/placement-report
wait "$placement_guard_pid"
echo two-jobs-ok
echo repl-ok
exit
