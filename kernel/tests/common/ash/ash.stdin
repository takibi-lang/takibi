# The assignment absorbs the first byte that can be lost by the RP1 UART.
x=; /bin/ls
/bin/ls -a
/bin/ls /bin
/bin/ls /many
ps
/etc/script-shebang.sh one two
echo "shebang: status $?"
script-interpreter-argument.sh three
/hello.txt
/etc
/etc/not-a-program
/etc/bad-interpreter.sh
/etc/crlf.sh
/etc/no-newline.sh
/etc/long-shebang.sh
/bin/sh -c 'exec /bin/echo re-exec-ok'
# GitHub issues #538 and #541: mkdir, rmdir and rm through mkdirat and
# unlinkat, one exec each. mkdir and rmdir carry on past a failing argument,
# so one call covers every outcome in order, and each target is named twice:
# the second EEXIST or ENOENT is what shows the first call worked. /etc/made
# and /kept stay, so the lane's e2fsck judges directories made through the
# syscall; /etc/gone is the image's one-link file and /etc/hlink a second
# link to /hello.txt. Every line fits the kernel's 63-byte UART receive ring
# (#543), which drops what does not.
mkdir /etc/made /etc/made/sub /etc/made /hello.txt/x /kept
rmdir /etc/made /etc/made/sub /etc/made/sub /hello.txt
rm /etc/gone /etc/gone /etc/hlink /etc/hlink
# GitHub issue #538: mv through renameat. The first line renames within a
# directory and then over an existing file; the second moves a file into
# another directory and renames a directory within its parent. The third
# asks for a name the first line moved away (ENOENT) and a directory move to
# another parent, which the ext2 layer refuses (EPERM). The cat shows the
# chain arrived: /etc/mva's bytes, now under /etc/moved/mvb.
mv /etc/mva /etc/mvc && mv /etc/mvc /etc/mvb && echo mv1
mv /etc/mvb /etc/made && mv /etc/made /etc/moved && echo mv2
mv /etc/mva /kept /etc/moved
/bin/cat /etc/moved/mvb
# GitHub issue #544: a write six times the console transmit queue. On the
# board the wire cannot keep up, so cat's write fills the queue, returns
# short, and the next one sleeps until the TX interrupt has drained it; the
# boot's `uart tx: ... writers_slept=` line has to be non-zero there. The file
# has no trailing newline, so echo ends the line.
/bin/cat /large.txt && echo
# GitHub issue #543: a line longer than the 63 bytes the kernel's UART
# receive ring used to hold, sent at once. The old ring dropped the rest of a
# line like this one, newline included, and the shell waited for it until the
# lane's budget ran out. echo is a shell builtin, so this costs no exec.
echo uart-rx-ring-0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Two background jobs at once, and ash's own account of them. /bin/spin is
# one round of the busy loop and then exit: silent, because output that
# interleaved with the prompt would arrive in an order nothing here can
# pin, and long enough that both are still Running when `jobs` asks. That
# listing is the evidence -- two jobs, neither finished -- and it carries no
# pid, so it is the same text on every boot. Two output-less commands leave
# two bare prompts, which is why the line after them carries them.
/bin/spin &
/bin/spin &
jobs
echo two-jobs-ok
echo repl-ok
exit
