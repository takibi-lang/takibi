// Shared nominal type for virtio's modulo-2^16 queue indices.

enum VirtioRingIndex: u16 { Zero = 0; _; }

// A modern (Version 2) virtio-mmio transport's registers (virtio 1.x,
// 4.2.2), shared by the net and block drivers. config_word is the start of
// the device-specific configuration: the MAC for net, the capacity for
// block.
io struct VirtioMmioRegs {
    magic: u32 at 0x00;
    version: u32 at 0x04;
    device_id: u32 at 0x08;
    device_features: u32 at 0x10;
    device_features_sel: u32 at 0x14;
    driver_features: u32 at 0x20;
    driver_features_sel: u32 at 0x24;
    queue_sel: i32 at 0x30;
    queue_num_max: u32 at 0x34;
    queue_num: i32 at 0x38;
    queue_ready: u32 at 0x44;
    queue_notify: i32 at 0x50;
    interrupt_status: i32 at 0x60;
    interrupt_ack: i32 at 0x64;
    status: i32 at 0x70;
    queue_desc_low: u32 at 0x80;
    queue_desc_high: u32 at 0x84;
    queue_driver_low: u32 at 0x90;
    queue_driver_high: u32 at 0x94;
    queue_device_low: u32 at 0xa0;
    queue_device_high: u32 at 0xa4;
    config_word: [u32; 2] at 0x100;
}

const VIRTIO_MMIO_VERSION_MODERN: u32 = 2;
const VIRTIO_STATUS_ACKNOWLEDGE: i32 = 1;
const VIRTIO_STATUS_DRIVER: i32 = 2;
const VIRTIO_STATUS_DRIVER_OK: i32 = 4;
const VIRTIO_STATUS_FEATURES_OK: i32 = 8;
const VIRTIO_STATUS_FAILED: i32 = 128;
// VIRTIO_F_VERSION_1 is feature bit 32: bit 0 of the high feature word.
const VIRTIO_F_VERSION_1_HIGH: u32 = 1;

fn virtio_ring_index_zero() -> VirtioRingIndex {
    return VirtioRingIndex::Zero;
}

fn virtio_ring_index_next(index: VirtioRingIndex) -> VirtioRingIndex {
    let raw: u16 = index as u16;
    if (raw == 0xFFFF) { return virtio_ring_index_zero(); }
    return (raw + 1) as VirtioRingIndex;
}
