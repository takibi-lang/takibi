// Raspberry Pi 5 RP1 Ethernet driver. RP1 contains a Cadence GEM_GXL
// connected to the board PHY through RGMII. This first hardware milestone
// deliberately uses one RX and one TX descriptor -- proving PHY, MAC and
// DMA with a single-descriptor ring came first (GitHub issue #177), interrupt
// -driven completion came later (GitHub issue #187: net_rx_wait()/
// net_tx_complete() wait via interrupt_wait(), woken by a real GEM RX/TX
// interrupt or kernel/platform/rpi5/timer_irq.tkb's periodic tick, not by
// continuously polling either ring). TX completion uses the primary queue
// interrupt bank and a 14 ms elapsed-time failure budget.

use "kernel/net/netconfig.tkb";
use "kernel/lib/init_once.tkb";
use "kernel/drivers/net/gem_tx_wait.tkb";
use "kernel/drivers/net/rp1_gem_desc.tkb";
use "kernel/drivers/dma_address.tkb";

const RP1_GEM_BASE: usize = 0x1F00100000;
const RP1_CLOCKS_BASE: usize = 0x1F00018000;
const RP1_GPIO_CTRL_BASE: usize = 0x1F000D0000;
const RP1_GPIO_RIO_BASE: usize = 0x1F000E0000;
const RP1_GPIO_PADS_BASE: usize = 0x1F000F0000;
const RX_BUF_SIZE: usize = 2048;

// Hardware queue 0 uses the primary MACB bank, not GEM's additional-queue
// bank (GitHub issue #733). Named registers exclude undeclared queue banks;
// these hardware offsets and the device-map window remain trusted.
io struct Rp1GemRegs {
    ncr: u32 at 0x00;
    ncfgr: u32 at 0x04;
    nsr: u32 at 0x08;
    ur: u32 at 0x0C;
    dmacfg: u32 at 0x10;
    tsr: u32 at 0x14;
    rbqp: u32 at 0x18;
    tbqp: u32 at 0x1C;
    rsr: u32 at 0x20;
    isr: u32 at 0x24;
    ier: u32 at 0x28;
    idr: u32 at 0x2C;
    imr: u32 at 0x30;
    man: u32 at 0x34;
    rx_cutthrough: u32 at 0x44;
    axi_pipe: u32 at 0x54;
    sa1_bottom: u32 at 0x88;
    sa1_top: u32 at 0x8C;
    tbqph: u32 at 0x4C8;
    rbqph: u32 at 0x4D4;
}

// Attached by the platform device map before the GEM interrupt is enabled.
let mut gem: IoHandle(Rp1GemRegs);

// Only net_rx_acquire can validate a hardware-supplied length and mint this
// owner.  Protocol code can borrow the buffer, then must release it or turn it
// into a reply-ready owner exactly once.
// The stack receives the packet buffer itself, Filled, by move (GitHub
// issue #740): NetPacket is that owner with its length and pool slot.
// net_rx_acquire rearms RX with another Free buffer before it returns, so
// holding a packet does not hold the ring. The frame's bytes are derived
// from it in place; releasing recycles it, replying sends it back out.
private linear struct NetPacket[pb: addr, po: usize] {
    private len: {0..<1515 as i32};
    private index: usize;
    private pkt: GemPkt_Filled[pb, po, 1];
}
private linear struct NetRxReplyReady[pb: addr, po: usize] {
    private len: {0..<1515 as i32};
    private index: usize;
    private pkt: GemPkt_Filled[pb, po, 1];
}
// GitHub issue #707: a submitted frame's buffer stays TxPosted in its pool
// slot until its completion is observed or GEM is halted.
private linear struct NetTxInFlight[pb: addr, po: usize] {
    private slot: {0..<2 as usize};
    private index: usize;
}

private linear view NetRxCanAcquire;
// A transmitted packet kept for retransmission (#740, step 2). Its
// completion parks the buffer Kept in its pool slot instead of Free; the
// stack names the packet by the slot it chose (net_tx_keep_slot) and takes
// this owner out with net_packet_kept_claim, to resend it or free it. Its
// free only returns the buffer to the slot Free; RX is rearmed by the next
// capability holder.
private linear struct NetPacketKept[pb: addr, po: usize] {
    private len: {0..<1515 as i32};
    private index: usize;
    private pkt: GemPkt_Filled[pb, po, 1];
}

variant GemTxClaim { Down; Ready; }
must_use variant NetInitResult { Failed; Ready(NetRxCanAcquire); }
variant NetRxAcquire {
    None(NetRxCanAcquire);
    Acquired(exists pb: addr. exists po: usize. NetPacket[pb, po]);
}
// Kept: the frame was sent from the chosen slot and is parked Kept there.
// Sent: nothing is kept (the reserve, no Free buffer, TX down, or an
// unconfirmed completion); the frame went out as net_transmit_ready sends
// it, and the caller keeps its own copy.
must_use variant NetTxKeep {
    Kept(NetRxCanAcquire);
    Sent(NetRxCanAcquire);
}
variant NetKeptClaim {
    None;
    Claimed(exists pb: addr. exists po: usize. NetPacketKept[pb, po]);
}

// Buffers outside the kept set that keeping must leave: the one RX
// descriptor full plus one Free buffer for a kernel-built frame
// (kernel/models/PacketReserve.tla: D + 1).
const GEM_PKT_RESERVE: usize = 2;
// The slot net_tx_keep_slot names when nothing may be kept.
const NET_KEPT_NONE: usize = 4;
// Each Kept slot's frame length, set by the keeping transmit.
private let mut gem_pkt_kept_len: [{0..<1515 as i32}; 4];

fn net_rx_packet(len: {0..<1515 as i32}, index: usize,
                 pkt: GemPkt_Filled[pb, po, 1]) -> NetPacket[pb, po] {
    workload_profile_note_network_rx(len as usize);
    let mut packet: NetPacket[pb, po] = { len, index, pkt };
    return packet;
}

// The pool slot whose buffer is posted for receive; GEM_PKTS when none is.
private let mut gem_rx_pkt: usize = 4;

// The descriptor rings are protocol owners in rp1_gem_desc.tkb (#740).
private let mut net_init_once: InitOnce;
private let mut rp1_gem_net_ready: bool = false;
// The RX ring's CPU address, recorded when the ring is programmed (#959).
private let mut gem_rx_ring_cpu_address: usize = 0;
let mut gem_tx_next: i32 = 0;
// Set once a TX completion went unconfirmed: gem_halt() has stopped the MAC
// (or failed to), so no later frame is submitted this boot.
private let mut gem_tx_down: bool = false;
let mut rp1_gem_base: usize = RP1_GEM_BASE;
let mut rp1_clocks_base: usize = RP1_CLOCKS_BASE;
let mut rp1_gpio_ctrl_base: usize = RP1_GPIO_CTRL_BASE;
let mut rp1_gpio_rio_base: usize = RP1_GPIO_RIO_BASE;
let mut rp1_gpio_pads_base: usize = RP1_GPIO_PADS_BASE;
let mut rp1_gem_dtb_status: usize;

fn gem_mdio_wait() -> bool {
    for i: i32 in 0..<100000 {
        if ((gem.nsr & (1 << 2)) != 0) { return true; }
    }
    return false;
}

fn gem_mdio_read(reg: u32) -> u32 {
    gem.man = (1 << 30) | (2 << 28) | (1 << 23)
                  | ((reg & 31) << 18) | (2 << 16);
    if (gem_mdio_wait()) { return gem.man & 0xFFFF; }
    return 0xFFFF;
}

fn gem_mdio_write(reg: u32, value: u32) -> bool {
    gem.man = (1 << 30) | (1 << 28) | (1 << 23)
                  | ((reg & 31) << 18) | (2 << 16) | (value & 0xFFFF);
    return gem_mdio_wait();
}

fn gem_phy_reset() !{unsafe} {
    // RPi5 board DTS: PHY reset is RP1 GPIO32, active low, 5 ms.
    // GPIO32 is bank 1 bit 4. Put the pin in GPIO mode, drive low, then
    // release it high before touching MDIO.
    let ctrl: *io u32 = unsafe {
        (rp1_gpio_ctrl_base + 0x4024) as *io u32
    };
    let rio_out_clr: *io u32 = unsafe {
        (rp1_gpio_rio_base + 0x7000) as *io u32
    };
    let rio_out_set: *io u32 = unsafe {
        (rp1_gpio_rio_base + 0x6000) as *io u32
    };
    let rio_oe_set: *io u32 = unsafe {
        (rp1_gpio_rio_base + 0x6004) as *io u32
    };
    let pad: *io u32 = unsafe {
        (rp1_gpio_pads_base + 0x4014) as *io u32
    };
    *rio_out_clr = 1 << 4;
    *rio_oe_set = 1 << 4;
    *pad = (*pad | (1 << 6)) & 0xFFFFFF7F;
    *ctrl = (*ctrl & 0xFFFFFFE0) | 5;
    delay_us(5000);
    *rio_out_set = 1 << 4;
    delay_us(10000);
}

fn gem_wait_link() -> bool {
    // Board DT uses rgmii-id. Mirror the BCM54210E/BCM54213PE Linux PHY
    // setup: enable the PHY's internal RX and TX clock delays.
    if (gem_mdio_write(0x18, 0x7007) == false) { return false; }
    let aux_misc: u32 = gem_mdio_read(0x18);
    if (gem_mdio_write(0x18, aux_misc | 0x8107) == false) { return false; }
    if (gem_mdio_write(0x1C, 3 << 10) == false) { return false; }
    let clk_ctl: u32 = gem_mdio_read(0x1C) & 0x3FF;
    if (gem_mdio_write(0x1C, 0x8000 | (3 << 10) | clk_ctl | (1 << 9)) == false) {
        return false;
    }
    // Restart Clause-22 autonegotiation on the BCM54213PE at address 1.
    if (gem_mdio_write(0, 0x1200) == false) { return false; }
    for i: i32 in 0..<2000000 {
        let bmsr: u32 = gem_mdio_read(1);
        if (bmsr != 0xFFFF && bmsr != 0
                && (bmsr & (1 << 2)) != 0 && (bmsr & (1 << 5)) != 0) {
            return true;
        }
    }
    return false;
}

fn gem_configure_link() {
    // BCM54xx Auxiliary Status Summary, bits 10:8: negotiated HCD.
    let aux: u32 = gem_mdio_read(0x19);
    let mode: u32 = (aux >> 8) & 7;
    // RP1 GEM DCFG1 reports DBWDEF=4, which maps to the 128-bit DBW setting.
    let mut ncfgr: u32 = (3 << 18) | (2 << 21) | (1 << 17); // MDC /64, DBW128, strip FCS
    if (mode == 2 || mode == 5 || mode == 7) { ncfgr = ncfgr | (1 << 1); }
    if (mode == 3 || mode == 5) { ncfgr = ncfgr | 1; }
    if (mode == 6 || mode == 7) { ncfgr = ncfgr | (1 << 10); }
    gem.ncfgr = ncfgr;
}

// The RX ring's owner, which must be Ready: an Armed one here means two
// frames were taken from one descriptor.
private fn gem_rx_ring_ready() -> GemRxRingHeld {
    let Place::Full(held) = gem_rx_ring_take_held() else {
        Place::Empty => {
            kernel_invariant_stop();
            return gem_rx_ring_ready();
        }
    };
    return held;
}

// Post a Free pool buffer for receive and point the RX descriptor at it
// (the buffer's rx edge, then the ring's arm). False when no buffer is
// free: RX then waits until a buffer is recycled or sent, which calls this
// again.
fn gem_rearm_rx() -> bool !{unsafe} {
    if (gem_rx_pkt < GEM_PKTS) { return true; }
    let index: usize = gem_pkt_free_index();
    let Place::Full(held) = gem_pkt_take(index) else {
        Place::Empty => { return false; }
    };
    let GemPktHeld::Free(free) = held else {
        GemPktHeld::RxPosted(p) => { gem_pkt_park(index, GemPktHeld::RxPosted(p)); return false; }
        GemPktHeld::TxPosted(p) => { gem_pkt_park(index, GemPktHeld::TxPosted(p)); return false; }
        GemPktHeld::Unconfirmed(p) => { gem_pkt_park(index, GemPktHeld::Unconfirmed(p)); return false; }
        GemPktHeld::Kept(p) => { gem_pkt_park(index, GemPktHeld::Kept(p)); return false; }
    };
    match GemPkt_gem_pkt_post_rx(free) {
        GemPkt_gem_pkt_post_rx_Result::RxPosted(posted) => {
            gem_pkt_park(index, GemPktHeld::RxPosted(posted));
        }
    }
    let address: usize = gem_pkt_published_address();
    let GemRxRingHeld::Ready(ready) = gem_rx_ring_ready() else {
        GemRxRingHeld::Armed(armed) => {
            gem_rx_ring_park(GemRxRingHeld::Armed(armed));
            kernel_invariant_stop();
            return false;
        }
    };
    // One-descriptor ring: WRAP, ownership bit clear (GEM's).
    let mut desc: GemDesc = { (address as u32) | 2, 0, (address >> 32) as u32, 0 };
    GemRxRing_Ready_write(ready, 0, desc);
    match GemRxRing_gem_rx_ring_arm(ready) {
        GemRxRing_gem_rx_ring_arm_Result::Armed(armed) => {
            gem_rx_ring_park(GemRxRingHeld::Armed(armed));
        }
    }
    // Set only once the new descriptor is written and armed: DDB's
    // lock-free look (kernel_net_rx_frame_pending) trusts the descriptor's
    // ownership bit only while this names a posted buffer (#959).
    gem_rx_pkt = index;
    return true;
}

// A received buffer the stack is done with: Free again, and RX rearmed if
// it was waiting for one.
private fn gem_pkt_recycle_at(index: usize, pkt: GemPkt_Filled[pb, po, 1]) !{unsafe} {
    gem_pkt_park(index, GemPktHeld::Free(GemPkt_gem_pkt_recycle(pkt)));
    gem_rearm_rx();
}

// A ring's bus address, from its Ready owner's span (`addressed`).
private fn gem_rx_ring_bus(r: borrow GemRxRing_Ready[b, o, 4]) -> usize !{unsafe} {
    let mut span: DmaDeviceSpan = GemRxRing_Ready_span(r);
    gem_rx_ring_cpu_address = dma_span_cpu_address(span);
    return rp1_span_bus_address(span);
}
private fn gem_tx_ring_bus(r: borrow GemTxRing_Ready[b, o, 4]) -> usize !{unsafe} {
    let mut span: DmaDeviceSpan = GemTxRing_Ready_span(r);
    return rp1_span_bus_address(span);
}

// Program both descriptor rings: RBQP/TBQP take the rings' addresses and
// both TX descriptors are USED (CPU-owned). The RX descriptor is armed
// around the first pool buffer; the TX ring stays Ready until the first
// TSTART.
private fn gem_rings_program() -> bool !{unsafe} {
    if (gem_rings_claim() == false || gem_pkts_claim() == false) { return false; }
    let GemRxRingHeld::Ready(rx) = gem_rx_ring_ready() else {
        GemRxRingHeld::Armed(armed) => {
            gem_rx_ring_park(GemRxRingHeld::Armed(armed));
            return false;
        }
    };
    // CPU-owned (ownership bit set) until gem_rearm_rx points it at a buffer.
    let mut rx_desc: GemDesc = { 3, 0, 0, 0 };
    GemRxRing_Ready_write(rx, 0, rx_desc);
    let rxd_dma: usize = gem_rx_ring_bus(rx);
    gem.rbqp = rxd_dma as u32;
    gem.rbqph = (rxd_dma >> 32) as u32;
    gem_rx_ring_park(GemRxRingHeld::Ready(rx));
    let Place::Full(tx_held) = gem_tx_ring_take_held() else {
        Place::Empty => { return false; }
    };
    let GemTxRingHeld::Ready(tx) = tx_held else {
        GemTxRingHeld::Sending(sending) => {
            gem_tx_ring_park(GemTxRingHeld::Sending(sending));
            return false;
        }
    };
    let mut first: GemDesc = { 0, 1 << 31, 0, 0 };               // USED
    let mut second: GemDesc = { 0, (1 << 31) | (1 << 30), 0, 0 }; // USED | WRAP
    GemTxRing_Ready_write(tx, 0, first);
    GemTxRing_Ready_write(tx, 1, second);
    let txd_dma: usize = gem_tx_ring_bus(tx);
    gem.tbqp = txd_dma as u32;
    gem.tbqph = (txd_dma >> 32) as u32;
    gem_tx_ring_park(GemTxRingHeld::Ready(tx));
    return gem_rearm_rx();
}

fn gem_halt() -> bool {
    // Cadence's halt sequence sets NCR.THalt before disabling the MAC, then
    // waits for TSR.TGO to report that an in-flight frame has drained.  This
    // matters on an SWD warm reload because RP1 and its DMA engine are not
    // reset along with the CPU cores.
    let ncr: u32 = gem.ncr;
    gem.ncr = ncr | (1 << 10);
    for i: i32 in 0..<1000000 {
        if ((gem.tsr & (1 << 3)) == 0) {
            gem.ncr = 1 << 5; // disable RX/TX and clear statistics
            return true;
        }
    }
    gem.ncr = 1 << 5;
    return false;
}

fn net_init() -> NetInitResult !{unsafe} {
    let init_guard = match init_once_begin(&net_init_once) {
        InitOnceBegin::AlreadyComplete => { return NetInitResult::Failed; }
        InitOnceBegin::Start(guard) => { guard }
    };

    // RP1 bus masters address RAM through PCI [0x10_00000000, ...).
    pcie2_dma_inbound_setup();

    // Keep the firmware-selected parent/divider but explicitly enable the
    // RP1 Ethernet TX clock; unlike clk_sys this branch is not critical.
    let eth_clk_ctrl: *io u32 = unsafe {
        (rp1_clocks_base + 0x64) as *io u32
    };
    *eth_clk_ctrl = *eth_clk_ctrl | (1 << 11);

    // Drain any transmission retained by an earlier SWD-loaded kernel before
    // replacing the descriptor base.  A cold boot completes immediately.
    if (gem_halt() == false) {
        init_once_cancel(&net_init_once, init_guard);
        return NetInitResult::Failed;
    }
    // Enable management port while RX/TX remain stopped, and mask all
    // queue-0 interrupts.
    gem.ncr = 1 << 4;
    gem.idr = 0xFFFFFFFF;
    gem.ur = 1; // RGMII
    gem.ncfgr = (3 << 18) | (2 << 21);
    gem_phy_reset();
    let phy_id1: u32 = gem_mdio_read(2);
    let phy_id2: u32 = gem_mdio_read(3);
    if (phy_id1 == 0 || phy_id1 == 0xFFFF || phy_id2 == 0 || phy_id2 == 0xFFFF) {
        init_once_cancel(&net_init_once, init_guard);
        return NetInitResult::Failed;
    }
    if (gem_wait_link() == false) {
        init_once_cancel(&net_init_once, init_guard);
        return NetInitResult::Failed;
    }
    gem_configure_link();

    // Program specific address 1.
    gem.sa1_bottom = (OUR_MAC[0] as u32) | ((OUR_MAC[1] as u32) << 8)
                  | ((OUR_MAC[2] as u32) << 16) | ((OUR_MAC[3] as u32) << 24);
    gem.sa1_top = (OUR_MAC[4] as u32) | ((OUR_MAC[5] as u32) << 8);

    if (gem_rings_program() == false) {
        init_once_cancel(&net_init_once, init_guard);
        return NetInitResult::Failed;
    }
    // 64-bit addressing, 2048-byte RX buffers, full packet SRAMs.
    gem.dmacfg = (1 << 30) | (32 << 16) | (3 << 8) | (1 << 10) | 16;
    gem.rx_cutthrough = 0; // disable RX partial store-and-forward/cut-through
    gem.axi_pipe = 0x10808; // RP1 DT: 8-deep AR/AW pipelines, AW-to-B fill
    gem.rsr = 0x0F;
    gem.tsr = 0xFFFFFFFF;
    gem.ncr = (1 << 4) | (1 << 3) | (1 << 2); // MPE | TE | RE

    // Queue 0 uses the primary bank, matching RBQP/TBQP above. The
    // additional-queue GEM_IER(0) at 0x600 belongs to hardware queue 1.
    gem.ier = (1 << 1) | (1 << 7); // RCOMP | TCOMP

    rp1_gem_net_ready = true;
    init_once_commit(&net_init_once, init_guard);
    return NetInitResult::Ready(view NetRxCanAcquire);
}

// GitHub issue #959: DDB's lock-free reading of RX pending, under the
// debug stop (#920): no ring owner and no lock. The CPU may hold the
// descriptor line dirty while the ring is Ready, so DDB must not merely
// invalidate it; it cleans and invalidates the line (dc civac, safe
// whichever side owns it, #1095) and then loads the word with acquire
// ordering from the point of coherency, so a clear ownership bit is GEM's
// current answer: No. The bit is trusted only while gem_rx_pkt names the
// posted buffer, which gem_rearm_rx sets after the new descriptor is armed
// and net_rx_acquire clears after the take.
fn kernel_net_rx_frame_pending() -> NetPendingState !{unsafe} {
    if (rp1_gem_net_ready == false) { return NetPendingState::No; }
    if (gem_rx_pkt >= GEM_PKTS) { return NetPendingState::No; }
    if (gem_rx_ring_cpu_address == 0) { return NetPendingState::Unknown; }
    kernel_ddb_dcache_clean_invalidate(gem_rx_ring_cpu_address);
    let word: usize = unsafe { atomic_load_acquire(gem_rx_ring_cpu_address) };
    if ((word & 1) != 0) { return NetPendingState::Yes; }
    return NetPendingState::No;
}

// Queue-0 status can be clear-on-read or W1C (DCFG1.IRQCOR). Read the
// primary ISR and acknowledge only the observed bits. Writing them after a
// clear-on-read is harmless; RP1's level-triggered vector is IACKed by the
// platform dispatcher after this handler returns.
fn gem_irq_handler() !{interrupt} {
    let isr: u32 = gem.isr;
    gem.isr = isr;
    interrupt_notify();
}

fn net_rx_wait() !{may_block} {
    if (gem_rx_ring_poll()) { return; }
    // GitHub issue #187: wakes on a real GEM RX interrupt, or on
    // kernel/platform/rpi5/timer_irq.tkb's periodic ~15ms tick if nothing
    // arrives -- callers (kernel/net/{arp,icmp,tcp}.tkb) keep their own
    // unchanged CNTPCT-based deadline loops, which now get to re-check
    // regularly instead of only after a long busy-spin.
    workload_profile_interrupt_wait();
}

fn net_rx_acquire(ready: sink NetRxCanAcquire) -> NetRxAcquire !{unsafe} {
    if (gem_rx_ring_poll() == false) {
        // No frame, but a buffer freed off-turn rearms RX here.
        gem_rearm_rx();
        return NetRxAcquire::None(view NetRxCanAcquire);
    }
    let len: i32 = gem_rx_ring_finish();
    if (len < 0) { return NetRxAcquire::None(view NetRxCanAcquire); }
    // The ring's completes observation also says GEM has written the
    // buffer it held: that buffer comes back Filled.
    let index: usize = gem_rx_pkt;
    gem_rx_pkt = GEM_PKTS;
    let Place::Full(held) = gem_pkt_take(index) else {
        Place::Empty => { kernel_invariant_stop(); return NetRxAcquire::None(view NetRxCanAcquire); }
    };
    let GemPktHeld::RxPosted(posted) = held else {
        GemPktHeld::Free(p) => { gem_pkt_lost(GemPktHeld::Free(p)); return NetRxAcquire::None(view NetRxCanAcquire); }
        GemPktHeld::TxPosted(p) => { gem_pkt_lost(GemPktHeld::TxPosted(p)); return NetRxAcquire::None(view NetRxCanAcquire); }
        GemPktHeld::Unconfirmed(p) => { gem_pkt_lost(GemPktHeld::Unconfirmed(p)); return NetRxAcquire::None(view NetRxCanAcquire); }
        GemPktHeld::Kept(p) => { gem_pkt_lost(GemPktHeld::Kept(p)); return NetRxAcquire::None(view NetRxCanAcquire); }
    };
    match GemPkt_gem_pkt_received(posted) {
        GemPkt_gem_pkt_received_Outcome::PktEmpty => {
            gem_pkt_park(index, GemPktHeld::RxPosted(posted));
            kernel_invariant_stop();
            return NetRxAcquire::None(view NetRxCanAcquire);
        }
        GemPkt_gem_pkt_received_Outcome::PktReceived(witness) => {
            let filled = GemPkt_gem_pkt_fill(posted, witness);
            if (len >= 0 && len <= 1514) {
                let valid_len: {0..<1515 as i32} = len;
                gem_rearm_rx();
                return NetRxAcquire::Acquired(net_rx_packet(valid_len, index, filled));
            }
            gem_pkt_recycle_at(index, filled);
            return NetRxAcquire::None(view NetRxCanAcquire);
        }
    }
}

// The RX descriptor back to the CPU after a snapshot showed it written: its
// frame length, or -1 when the ring was not Armed with a filled descriptor.
private fn gem_rx_ring_finish() -> i32 {
    let Place::Full(held) = gem_rx_ring_take_held() else {
        Place::Empty => { return -1; }
    };
    let GemRxRingHeld::Armed(armed) = held else {
        GemRxRingHeld::Ready(ready) => {
            gem_rx_ring_park(GemRxRingHeld::Ready(ready));
            return -1;
        }
    };
    match GemRxRing_gem_rx_ring_filled(armed) {
        GemRxRing_gem_rx_ring_filled_Outcome::RxFilled(filled) => {
            let ready = GemRxRing_gem_rx_ring_take(armed, filled);
            let mut desc: GemDesc = GemRxRing_Ready_read(ready, 0);
            gem_rx_ring_park(GemRxRingHeld::Ready(ready));
            return (desc.ctrl & 0x3FFF) as i32;
        }
        GemRxRing_gem_rx_ring_filled_Outcome::RxPending => {
            gem_rx_ring_park(GemRxRingHeld::Armed(armed));
            return -1;
        }
    }
}

fn net_rx_len(packet: borrow NetPacket[pb, po]) -> {0..<1515 as i32} {
    return packet.len;
}

fn net_rx_frame(packet: borrow NetPacket[pb, po]) -> [u8; 1514..] @ pb {
    let bytes = GemPkt_Filled_bytes(packet.pkt, 0);
    return bytes[0..<1514];
}

fn net_rx_release(packet: sink NetPacket[pb, po]) -> NetRxCanAcquire !{unsafe} {
    let index: usize = packet.index;
    gem_pkt_recycle_at(index, packet.pkt);
    return view NetRxCanAcquire;
}

// The Free slot a keeping transmit would use, or NET_KEPT_NONE when
// keeping one more buffer would leave fewer than GEM_PKT_RESERVE outside
// the kept set, or TX is down.
fn net_tx_keep_slot() -> usize {
    if (gem_tx_down) { return NET_KEPT_NONE; }
    if (gem_pkt_out_count() + 1 > GEM_PKTS - GEM_PKT_RESERVE) {
        return NET_KEPT_NONE;
    }
    return gem_pkt_free_index();
}

// Any core, no capability: the Kept packet in `index`, taken out.
fn net_packet_kept_claim(index: usize) -> NetKeptClaim {
    if (index >= GEM_PKTS) { return NetKeptClaim::None; }
    let Place::Full(held) = gem_pkt_take(index) else {
        Place::Empty => { return NetKeptClaim::None; }
    };
    let GemPktHeld::Kept(pkt) = held else {
        GemPktHeld::Free(p) => { gem_pkt_park(index, GemPktHeld::Free(p)); return NetKeptClaim::None; }
        GemPktHeld::RxPosted(p) => { gem_pkt_park(index, GemPktHeld::RxPosted(p)); return NetKeptClaim::None; }
        GemPktHeld::TxPosted(p) => { gem_pkt_park(index, GemPktHeld::TxPosted(p)); return NetKeptClaim::None; }
        GemPktHeld::Unconfirmed(p) => { gem_pkt_park(index, GemPktHeld::Unconfirmed(p)); return NetKeptClaim::None; }
    };
    let len: {0..<1515 as i32} = gem_pkt_kept_len[index];
    return NetKeptClaim::Claimed(net_packet_kept(len, index, pkt));
}

private fn net_packet_kept(len: {0..<1515 as i32}, index: usize,
                           pkt: GemPkt_Filled[pb, po, 1]) -> NetPacketKept[pb, po] {
    let mut kept: NetPacketKept[pb, po] = { len, index, pkt };
    return kept;
}

// Any core, no capability: the buffer goes back to its slot Free. RX is
// not touched.
fn net_packet_free(kept: sink NetPacketKept[pb, po]) {
    let index: usize = kept.index;
    gem_pkt_park(index, GemPktHeld::Free(GemPkt_gem_pkt_recycle(kept.pkt)));
}

// A kept packet retransmitted in place; its completion parks it Kept
// again in its slot (#740). Not sent once TX is down; it stays Kept for
// the caller's eventual free.
fn net_packet_kept_resend(ready: sink NetRxCanAcquire, kept: sink NetPacketKept[pb, po])
        -> NetRxCanAcquire !{may_block, unsafe} {
    let index: usize = kept.index;
    let len: {0..<1515 as i32} = kept.len;
    match gem_tx_claim() {
        GemTxClaim::Down => {
            gem_pkt_park(index, GemPktHeld::Kept(kept.pkt));
            return ready;
        }
        GemTxClaim::Ready => {}
    }
    let slot: {0..<2 as usize} = gem_tx_next_slot();
    match GemPkt_gem_pkt_post_tx(kept.pkt) {
        GemPkt_gem_pkt_post_tx_Result::TxPosted(posted) => {
            gem_pkt_park(index, GemPktHeld::TxPosted(posted));
        }
    }
    gem_tx_describe(slot, len);
    gem_tx_start();
    gem_tx_finish(slot, index, true, len);
    return ready;
}

fn net_rx_reply_ready(frame: sink NetPacket[pb, po], len: i32)
        -> NetRxReplyReady[pb, po] {
    // Keep the reply length inside the private linear owner so the terminal
    // send operation cannot be called with an unrelated bare integer.
    let safe_len: {0..<1515 as i32} = max(min(len, 1514), 0);
    let index: usize = frame.index;
    let pkt = frame.pkt;
    let mut reply: NetRxReplyReady[pb, po] = { safe_len, index, pkt };
    return reply;
}

// Point the next TX descriptor at the buffer just posted for transmit.
private fn gem_tx_next_slot() -> {0..<2 as usize} {
    if (gem_tx_next == 0) { return 0; }
    return 1;
}

private fn gem_tx_describe(slot: {0..<2 as usize}, safe_len: {0..<1515 as i32}) {
    workload_profile_note_network_tx(safe_len as usize);
    let tx_dma: usize = gem_pkt_published_address();
    let mut ctrl: u32 = (safe_len as u32) | (1 << 15); // LAST
    if (slot == 0) {
        gem_tx_next = 1;
    } else {
        ctrl = ctrl | (1 << 30); // WRAP
        gem_tx_next = 0;
    }
    let mut desc: GemDesc = { tx_dma as u32, ctrl, (tx_dma >> 32) as u32, 0 };
    gem_tx_ring_write(slot, desc);
}

// Write one TX descriptor through the Ready ring owner.
private fn gem_tx_ring_write(slot: {0..<2 as usize}, desc: GemDesc) {
    let Place::Full(held) = gem_tx_ring_take_held() else {
        Place::Empty => { kernel_invariant_stop(); return; }
    };
    let GemTxRingHeld::Ready(ready) = held else {
        GemTxRingHeld::Sending(sending) => {
            gem_tx_ring_park(GemTxRingHeld::Sending(sending));
            kernel_invariant_stop();
            return;
        }
    };
    GemTxRing_Ready_write(ready, slot, desc);
    gem_tx_ring_park(GemTxRingHeld::Ready(ready));
}

// Publish the TX ring (the generated clean, then TSTART in its lowering).
private fn gem_tx_start() {
    let Place::Full(held) = gem_tx_ring_take_held() else {
        Place::Empty => { kernel_invariant_stop(); return; }
    };
    let GemTxRingHeld::Ready(ready) = held else {
        GemTxRingHeld::Sending(sending) => {
            gem_tx_ring_park(GemTxRingHeld::Sending(sending));
            kernel_invariant_stop();
            return;
        }
    };
    match GemTxRing_gem_tx_ring_start(ready) {
        GemTxRing_gem_tx_ring_start_Result::Sending(sending) => {
            gem_tx_ring_park(GemTxRingHeld::Sending(sending));
        }
    }
}

// The TX ring back to Ready after a snapshot showed the descriptor USED
// (used == true), or after a confirmed halt (used == false). False when
// neither observation holds; the ring then stays with the device.
private fn gem_tx_ring_settle(used: bool) -> bool {
    let Place::Full(held) = gem_tx_ring_take_held() else {
        Place::Empty => { return false; }
    };
    let GemTxRingHeld::Sending(sending) = held else {
        GemTxRingHeld::Ready(ready) => {
            gem_tx_ring_park(GemTxRingHeld::Ready(ready));
            return false;
        }
    };
    if (used) {
        match GemTxRing_gem_tx_ring_used(sending) {
            GemTxRing_gem_tx_ring_used_Outcome::TxUsed(witness) => {
                gem_tx_ring_park(GemTxRingHeld::Ready(
                    GemTxRing_gem_tx_ring_done(sending, witness)));
                return true;
            }
            GemTxRing_gem_tx_ring_used_Outcome::TxNotUsed => {
                gem_tx_ring_park(GemTxRingHeld::Sending(sending));
                return false;
            }
        }
    }
    match GemTxRing_gem_tx_ring_halted(sending) {
        GemTxRing_gem_tx_ring_halted_Outcome::TxHalted(witness) => {
            gem_tx_ring_park(GemTxRingHeld::Ready(
                GemTxRing_gem_tx_ring_reclaim(sending, witness)));
            return true;
        }
        GemTxRing_gem_tx_ring_halted_Outcome::TxRunning => {
            gem_tx_ring_park(GemTxRingHeld::Sending(sending));
            return false;
        }
    }
}

// The TX buffer in pool slot `index`, which must be TxPosted.
private fn gem_tx_pkt(index: usize) -> GemPktHeld {
    let Place::Full(held) = gem_pkt_take(index) else {
        Place::Empty => {
            kernel_invariant_stop();
            return gem_tx_pkt(index);
        }
    };
    return held;
}

// The deadline expired with the descriptor still GEM's: the frame may still be
// read. Halt GEM; only a confirmed halt returns the buffer to the CPU, and
// either way no later frame is sent this boot.
private fn gem_tx_unconfirmed(index: usize) !{unsafe} {
    kernel_boot_log("rp1 gem: tx completion unconfirmed; halting tx\n");
    gem_tx_down = true;
    let GemPktHeld::TxPosted(posted) = gem_tx_pkt(index) else {
        GemPktHeld::Free(p) => { gem_pkt_lost(GemPktHeld::Free(p)); return; }
        GemPktHeld::RxPosted(p) => { gem_pkt_lost(GemPktHeld::RxPosted(p)); return; }
        GemPktHeld::Unconfirmed(p) => { gem_pkt_lost(GemPktHeld::Unconfirmed(p)); return; }
        GemPktHeld::Kept(p) => { gem_pkt_lost(GemPktHeld::Kept(p)); return; }
    };
    if (gem_halt()) {
        gem_tx_ring_mark_halted();
        if (gem_tx_ring_settle(false) == false) { kernel_invariant_stop(); }
        match GemPkt_gem_pkt_halted(posted) {
            GemPkt_gem_pkt_halted_Outcome::PktHalted(witness) => {
                gem_pkt_park(index, GemPktHeld::Free(GemPkt_gem_pkt_reclaim(posted, witness)));
                gem_rearm_rx();
            }
            GemPkt_gem_pkt_halted_Outcome::PktRunning => {
                gem_pkt_park(index, GemPktHeld::Unconfirmed(GemPkt_gem_pkt_expire(posted)));
            }
        }
    } else {
        kernel_boot_log("rp1 gem: halt unconfirmed; tx buffer stays with the device\n");
        gem_pkt_park(index, GemPktHeld::Unconfirmed(GemPkt_gem_pkt_expire(posted)));
    }
}

// keep (#740): a confirmed buffer is parked Kept, Filled again, for a
// retransmission; true then. A halt's reclaim still returns it Free.
private fn gem_tx_finish(slot: {0..<2 as usize}, index: usize, keep: bool,
                         len: {0..<1515 as i32}) -> bool !{may_block, unsafe} {
    if (gem_tx_wait(slot) && gem_tx_ring_settle(true)) {
        let GemPktHeld::TxPosted(posted) = gem_tx_pkt(index) else {
            GemPktHeld::Free(p) => { gem_pkt_lost(GemPktHeld::Free(p)); return false; }
            GemPktHeld::RxPosted(p) => { gem_pkt_lost(GemPktHeld::RxPosted(p)); return false; }
            GemPktHeld::Unconfirmed(p) => { gem_pkt_lost(GemPktHeld::Unconfirmed(p)); return false; }
            GemPktHeld::Kept(p) => { gem_pkt_lost(GemPktHeld::Kept(p)); return false; }
        };
        match GemPkt_gem_pkt_sent(posted) {
            GemPkt_gem_pkt_sent_Outcome::PktSent(witness) => {
                if (keep && index < GEM_PKTS) {
                    gem_pkt_kept_len[index] = len;
                    gem_pkt_park(index, GemPktHeld::Kept(GemPkt_gem_pkt_kept(posted, witness)));
                    gem_rearm_rx();
                    return true;
                }
                gem_pkt_park(index, GemPktHeld::Free(GemPkt_gem_pkt_done(posted, witness)));
                gem_rearm_rx();
            }
            GemPkt_gem_pkt_sent_Outcome::PktPending => {
                gem_pkt_park(index, GemPktHeld::TxPosted(posted));
                gem_tx_unconfirmed(index);
            }
        }
    } else {
        gem_tx_unconfirmed(index);
    }
    return false;
}

// Whether TX may run: after an unconfirmed completion it never does again.
private fn gem_tx_claim() -> GemTxClaim {
    if (gem_tx_down) { return GemTxClaim::Down; }
    return GemTxClaim::Ready;
}

// The in-place reply: the received buffer goes back out as TX (its tx
// edge, no copy). The peer can send its next packet immediately after
// seeing this reply, so RX is rearmed with another pool buffer before TX
// starts, and an immediate TCP ACK is not lost while this one completes.
fn net_transmit(reply: sink NetRxReplyReady[pb, po])
        -> NetTxInFlight[pb, po] !{unsafe} {
    let slot: {0..<2 as usize} = gem_tx_next_slot();
    let index: usize = reply.index;
    let len: {0..<1515 as i32} = reply.len;
    match GemPkt_gem_pkt_post_tx(reply.pkt) {
        GemPkt_gem_pkt_post_tx_Result::TxPosted(posted) => {
            gem_pkt_park(index, GemPktHeld::TxPosted(posted));
        }
    }
    gem_tx_describe(slot, len);
    gem_rearm_rx();
    gem_tx_start();
    let mut in_flight: NetTxInFlight[pb, po] = { slot, index };
    return in_flight;
}

fn gem_tx_slot_done(slot: {0..<2 as usize}) -> bool {
    return gem_tx_ring_poll(slot);
}

fn net_tx_complete(in_flight: sink NetTxInFlight[pb, po]) -> NetRxCanAcquire
        !{may_block, unsafe} {
    gem_tx_finish(in_flight.slot, in_flight.index, false, 0);
    return view NetRxCanAcquire;
}

fn net_rx_send_reply(reply: sink NetRxReplyReady[pb, po])
        -> NetRxCanAcquire !{may_block, unsafe} {
    match gem_tx_claim() {
        GemTxClaim::Ready => { return net_tx_complete(net_transmit(reply)); }
        GemTxClaim::Down => {
            let index: usize = reply.index;
            gem_pkt_recycle_at(index, reply.pkt);
            return view NetRxCanAcquire;
        }
    }
}

// Transmits a kernel-built frame while preserving the sole armed RX
// capability.  Unlike net_transmit(), no RX descriptor is consumed or
// rearmed: the caller already owns proof that GEM may receive the next frame.
fn net_transmit_ready(ready: sink NetRxCanAcquire,
                      bytes: borrow [u8; 1514..], len: i32)
        -> NetRxCanAcquire !{may_block} {
    let safe_len: {0..<1515 as i32} = max(min(len, 1514), 0);
    match gem_tx_claim() {
        GemTxClaim::Ready => { gem_send_built(gem_pkt_free_index(), false, bytes, safe_len); }
        GemTxClaim::Down => {}
    }
    return view NetRxCanAcquire;
}

// A kernel-built frame sent from `index`, which net_tx_keep_slot named,
// and kept there for retransmission (#740). Sent, from any Free buffer,
// when the slot no longer passes that check.
fn net_transmit_keep(ready: sink NetRxCanAcquire, index: usize,
                     bytes: borrow [u8; 1514..], len: i32)
        -> NetTxKeep !{may_block, unsafe} {
    if (index == NET_KEPT_NONE || net_tx_keep_slot() != index) {
        return NetTxKeep::Sent(net_transmit_ready(ready, bytes, len));
    }
    let safe_len: {0..<1515 as i32} = max(min(len, 1514), 0);
    if (gem_send_built(index, true, bytes, safe_len)) {
        return NetTxKeep::Kept(ready);
    }
    return NetTxKeep::Sent(ready);
}

// A kernel-built frame: written into a Free pool buffer, which is posted
// for transmit from Free (its tx edge). Dropped when no buffer is free.
// True when keep was asked and the completion parked it Kept.
private fn gem_send_built(index: usize, keep: bool, bytes: borrow [u8; 1514..],
                          safe_len: {0..<1515 as i32}) -> bool !{may_block, unsafe} {
    let Place::Full(held) = gem_pkt_take(index) else {
        Place::Empty => { return false; }
    };
    let GemPktHeld::Free(free) = held else {
        GemPktHeld::RxPosted(p) => { gem_pkt_park(index, GemPktHeld::RxPosted(p)); return false; }
        GemPktHeld::TxPosted(p) => { gem_pkt_park(index, GemPktHeld::TxPosted(p)); return false; }
        GemPktHeld::Unconfirmed(p) => { gem_pkt_park(index, GemPktHeld::Unconfirmed(p)); return false; }
        GemPktHeld::Kept(p) => { gem_pkt_park(index, GemPktHeld::Kept(p)); return false; }
    };
    let out = GemPkt_Free_bytes(free, 0);
    slice_copy(out[0..<safe_len as usize], bytes[0..<safe_len as usize]);
    let slot: {0..<2 as usize} = gem_tx_next_slot();
    match GemPkt_gem_pkt_send(free) {
        GemPkt_gem_pkt_send_Result::TxPosted(posted) => {
            gem_pkt_park(index, GemPktHeld::TxPosted(posted));
        }
    }
    gem_tx_describe(slot, safe_len);
    gem_tx_start();
    return gem_tx_finish(slot, index, keep, safe_len) && keep;
}

fn net_read_mac(mac_out: borrow [u8; 6..]) { slice_copy(mac_out, OUR_MAC as []u8); }

fn net_shutdown(ready: sink NetRxCanAcquire) {}
