// QEMU `virt` machine virtio-net driver (GitHub issue #237 M4). The
// vring/MMIO/IRQ engine below is a close port of examples/common_qemu/
// virtio_mmio.tkb (hardware-proven -- net_echo/arp_reply/icmp_echo/
// tcp_echo/http_server/kvs_server all run against it in that tree's own
// QEMU test suite), with boot-DTB transport discovery (a lone
// virtio-net-device is not guaranteed to land on MMIO slot 0) and the same
// dma_publish/dma_consume barrier placement. Since GitHub issue #740 (U2)
// it drives the modern transport (Version 2, VIRTIO_F_VERSION_1 and the
// FEATURES_OK handshake): each queue's descriptor table and avail ring
// share one small array, and its used ring is a region of its own, read
// only through snapshots (kernel/drivers/virtio_used.tkb).
//
// What differs from that file, deliberately: the function/type
// names below match kernel/drivers/net/rp1_gem.tkb's contract exactly
// (net_rx_packet/NetPacket/NetRxReplyReady/NetTxInFlight/
// net_rx_reply_ready/net_transmit(reply)/net_transmit_ready/net_shutdown),
// not examples/common_qemu/virtio_mmio.tkb's own (NetRxCpuOwned, a single
// combined net_transmit(frame, len), no net_transmit_ready at all) --
// kernel/net/{arp,icmp,tcp,socket_capability}.tkb already call the
// rp1_gem.tkb shape (built for RPi5 first), and this driver plugs into
// that existing call surface via the same command-line file-selection
// convention kernel/platform/qemu/uart.tkb already uses, not a `use`
// line any of those files need to change. NetRxCanAcquire is `linear`
// here (not virtio_mmio.tkb's own `affine`) to match rp1_gem.tkb's
// exact declaration, since the SAME kernel/net/ call sites (proven
// against that stricter constraint already) consume this driver's type
// too.
//
// GIC wiring is NOT self-contained the way examples/common_qemu/
// virtio_mmio.tkb's own irq_dispatch is: this kernel's interrupt
// dispatch lives in kernel/platform/qemu/intc.tkb (the same seam
// kernel/platform/rpi5/intc.tkb calls kernel/drivers/net/rp1_gem.tkb's
// gem_irq_handler() from), so this file exposes virtio_net_gic_intid
// (discovered from the boot DTB, unlike RPi5's fixed GIC INTID constants) and
// virtio_net_irq_handler() for that file to call, plus
// virtio_net_gic_enable() for platform_irq_init() to call once net_init()
// has discovered the device's slot.

use "kernel/net/netconfig.tkb";
use "kernel/lib/init_once.tkb";
use "kernel/lib/atomic_word.tkb";
use "kernel/lib/boot_once.tkb";
use "kernel/drivers/virtio_ring.tkb";
use "kernel/drivers/net/virtio_net_tx_wait.tkb";
use "kernel/drivers/net/virtio_net_tx_dma.tkb";
use "kernel/lib/occupancy.tkb";
use "kernel/drivers/block/device_lock.tkb";



const QNUM: isize = 8; // virtqueue depth for both the RX and TX queues

// Names match kernel/drivers/net/rp1_gem.tkb's own declarations exactly
// (field names differ internally -- "index" here vs. rp1_gem's "slot" --
// but nothing outside this file ever names a field, only the type and
// the function API around it).
// The stack receives the packet buffer itself, Filled, by move (GitHub
// issue #740): NetPacket is that owner with its length and pool slot, and
// names no RX descriptor -- net_rx_acquire refills the descriptor from
// another Free buffer before it returns, so holding a packet does not
// hold the ring. The frame's bytes are borrowed from it in place;
// releasing recycles it, replying sends that buffer back out.
// GitHub issue #1416 (decision A): the RX capability carries the ring
// shadows, and every holder carries the device's index `net`, so a packet
// goes back only to the capability of the device it came from and a
// shadow advances only through a `borrow mut` of that device's token.
private linear struct NetPacket[pb: addr, po: usize, net: addr] {
    private len: {0..<1515 as i32};
    private slot: usize;
    private pkt: VirtioPkt_Filled[pb, po, 1];
    private ready: NetRxCanAcquire[net];
}
private linear struct NetRxReplyReady[pb: addr, po: usize, net: addr] {
    private len: {0..<1515 as i32};
    private slot: usize;
    private pkt: VirtioPkt_Filled[pb, po, 1];
    private ready: NetRxCanAcquire[net];
}
private linear struct NetTxInFlight[pb: addr, po: usize, net: addr] {
    private slot: usize;
    private ready: NetRxCanAcquire[net];
}
// The one RX capability of this device, index &virtio_net_ready: the
// guest's shadows of both queues' indices and the pool slot each RX
// descriptor holds, private to this file and reached only by its holder.
private linear struct NetRxCanAcquire[net: addr] {
    private rx_used_seen: VirtioRingIndex;
    private tx_used_seen: VirtioRingIndex;
    private rx_avail_idx: VirtioRingIndex;
    private tx_avail_idx: VirtioRingIndex;
    private rx_desc_pkt: VirtioRxDescSlots;
}
// The pool slot each RX descriptor holds (VIRTIO_PKT_NONE while it holds
// none), one byte each: the pool has 10 slots, and the frame budget (#1081)
// counts every copy of the capability.
struct VirtioRxDescSlots {
    slot: [u8; 8];
}
// A transmitted packet kept for retransmission (#740, step 2). Its
// completion parks the buffer Kept in its pool slot instead of Free and
// returns the capability (a view cannot travel beside another value); the
// stack names the packet by the slot it chose (net_tx_keep_slot) and takes
// this owner out with net_packet_kept_claim, to resend it or free it. Its
// free only returns the buffer to the slot Free; the ring is refilled by
// the next capability holder.
private linear struct NetPacketKept[pb: addr, po: usize] {
    private len: {0..<1515 as i32};
    private slot: usize;
    private pkt: VirtioPkt_Filled[pb, po, 1];
}

must_use variant NetInitResult { Failed; Ready(NetRxCanAcquire[&virtio_net_ready]); }
variant NetRxAcquire[net: addr] {
    None(NetRxCanAcquire[net]);
    Acquired(exists pb: addr. exists po: usize. NetPacket[pb, po, net]);
}
// Kept: the frame was sent from the chosen slot and is parked Kept there.
// Sent: nothing is kept (the reserve, no Free buffer, or an unconfirmed
// completion); the frame went out as net_transmit_ready sends it, and the
// caller keeps its own copy.
must_use variant NetTxKeep[net: addr] {
    Kept(NetRxCanAcquire[net]);
    Sent(NetRxCanAcquire[net]);
}
variant NetKeptClaim {
    None;
    Claimed(exists pb: addr. exists po: usize. NetPacketKept[pb, po]);
}

// Buffers outside the kept set that keeping must leave: every RX
// descriptor full plus one Free buffer for a kernel-built frame
// (kernel/models/PacketReserve.tla: D + 1 is the least that holds; with D
// a refill takes the last Free buffer and net_transmit_ready finds none).
const VIRTIO_PKT_RESERVE: usize = 9;
// The slot net_tx_keep_slot names when nothing may be kept.
const NET_KEPT_NONE: usize = 10;

fn net_rx_packet(len: {0..<1515 as i32}, slot: usize,
                 pkt: VirtioPkt_Filled[pb, po, 1], ready: sink NetRxCanAcquire[net])
        -> NetPacket[pb, po, net] {
    workload_profile_note_network_rx(len as usize);
    let mut packet: NetPacket[pb, po, net] = { len, slot, pkt, ready };
    return packet;
}

struct packed VirtqDesc {
    addr: usize;
    len: u32;
    flags: u16;
    next: u16;
}

struct packed VirtqAvail {
    flags: u16;
    idx: VirtioRingIndex;
    ring: [u16; QNUM];
}

// One queue's descriptor table (8 x 16 bytes) and avail ring (20 bytes),
// padded to the 256 bytes the queue has always taken. The driver writes
// both through checked indexes; the device reads them at the addresses
// virtio_queue_setup programs (#637: no pointer arithmetic).
struct packed VirtqNetQueue {
    desc: [VirtqDesc; QNUM];
    avail: VirtqAvail;
    reserved: [u8; 108];
}

const VIRTQ_DESC_F_WRITE: i32 = 2; // device writes into this buffer (RX only)

const VIRTIO_NET_F_MAC: u32 = 32; // bit 5: device exposes its MAC in Config space

// Discovered from the boot DTB -- see this file's header for why (QEMU does not
// always attach a lone virtio-net-device to slot 0).
// GitHub issue #1159: both discovery words are BootOnce: written by the boot
// DTB walk under the boot phase, read freely after. A transport that was
// never found leaves them unwritten, which virtio_net_base and
// virtio_net_intid read as 0 and -1.
let mut virtio_base: BootOnce(i32);
// The transport's registers, attached by the platform device map when it
// finds the net device; virtio_base stays its discovery record.
let mut virtio_net_regs: IoHandle(VirtioMmioRegs);
// The DTB decoder returns the architectural GIC INTID, including the SPI
// base conversion. -1 means that no active virtio-net transport was found;
// interrupt dispatch guards that sentinel before comparing it with GICC_IAR.
let mut virtio_net_gic_intid: BootOnce(i32);

fn virtio_net_base() -> i32 {
    if (boot_once_is_written(&virtio_base)) { return boot_once_get(&virtio_base); }
    return 0;
}

fn virtio_net_intid() -> i32 {
    if (boot_once_is_written(&virtio_net_gic_intid)) {
        return boot_once_get(&virtio_net_gic_intid);
    }
    return -1;
}
private let mut net_init_once: InitOnce;
// GitHub issue #830: the IRQ handler sets these on whichever core the
// rotating NIC route delivered to, while the capability holder clears and
// reads them on its own core. Release stores and acquire loads order the
// flag against the used ring the device wrote before raising the interrupt.
// Not private: linux_user/virtio_net_tx's support file raises them in place
// of the IRQ handler.
let mut virtio_rx_irq_flag: AtomicWord;
// Initialization sets this latch once. Expiry clears it permanently: the
// InitOnce gate refuses reinitialization and IRQs never change readiness.
// In-place RX bytes may still belong to TX, so neither queue is republished.
private let mut virtio_net_ready: AtomicWord;

const RX_BUF_SIZE: isize = 1536; // 12-byte virtio_net_hdr + max 1514-byte Ethernet frame, rounded up
const RX_BUF_SIZE_USIZE: usize = 1536;
// With VIRTIO_F_VERSION_1 the header always carries num_buffers (virtio
// 1.x, 5.1.6): 12 bytes, not the legacy 10.
const VIRTIO_NET_HDR_LEN: usize = 12;

// The RX (0) and TX (1) queues.
struct VirtioNetQueueStorage {
    private queues: [VirtqNetQueue; 2] guarded_by(block_device_lock);
}
private let mut virtio_net_queues: VirtioNetQueueStorage align(64);
// The used rings' addresses as programmed (RX, TX), for DDB and the native
// fixture's stand-in device.
let mut virtio_net_used_addr: [usize; 2];
// The pool slot whose buffer each RX descriptor holds (VIRTIO_PKT_NONE
// while a descriptor has none).
// (The pool slot of each RX descriptor is the capability's rx_desc_pkt.)

// Packet buffers are the #740 pool in virtio_net_tx_dma.tkb.

// Virtio queue indices are free-running u16 counters. Their nominal domain
// keeps every guest shadow at that width and rejects comparison with a widened
// counter before the required 65535 -> 0 wrap.
// They are the capability's own fields (#1416). DDB, which has no
// capability, reads the RX used shadow from this published copy, stored
// each time the holder advances it.
private let mut virtio_net_rx_used_published: AtomicWord;
// GitHub issue #1440: transmits notified and completions that timed out,
// for the boot log's `net tx wait:` line (the same names as rp1_gem.tkb).
private let mut virtio_net_tx_submissions: AtomicWord;
private let mut virtio_net_tx_timeouts: AtomicWord;

fn net_tx_submission_count() -> usize { return atomic_word_load(&virtio_net_tx_submissions); }
fn net_tx_timeout_count() -> usize { return atomic_word_load(&virtio_net_tx_timeouts); }

fn virtio_net_find() -> bool !{unsafe} {
    return virtio_net_base() != 0 && virtio_net_intid() >= 0;
}

// Called from net_init() after the boot path has selected the transport.
// The GIC-level route is enabled here because virtio-net remains optional;
// platform_irq_init() runs before net_init() decides whether networking is
// available.
//
// Every register below is indexed by the architectural INTID directly:
// GICD_ISENABLER/ICPENDR are one bit per INTID (32 per 4-byte register),
// GICD_ITARGETSR is one byte per INTID.
fn virtio_net_gic_enable() {
    let found: i32 = virtio_net_intid();
    if (found < 0) { return; }
    let intid: u32 = found as u32;
    gic_intid_clear_pending(intid);
    gic_intid_enable(intid);
    // GitHub issue #830: the rotating route (or the boot fixture's pin).
    nic_irq_route(intid);
}

// Called from kernel/platform/qemu/intc.tkb's dispatch when the GIC IAR
// value matches virtio_net_gic_intid -- same relationship
// kernel/platform/rpi5/intc.tkb has with rp1_gem.tkb's gem_irq_handler().
fn virtio_net_irq_handler() !{interrupt} {
    let status: i32 = virtio_net_regs.interrupt_status;
    virtio_net_regs.interrupt_ack = status;
    atomic_word_store(&virtio_rx_irq_flag, 1);
    interrupt_notify();
}

// Reset, acknowledge, and accept `features_low` (as far as offered) plus
// VIRTIO_F_VERSION_1; false when the device does not keep FEATURES_OK.
fn virtio_negotiate(features_low: u32) -> bool {
    virtio_net_regs.status = 0;
    virtio_net_regs.status = VIRTIO_STATUS_ACKNOWLEDGE;
    virtio_net_regs.status = VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER;
    virtio_net_regs.device_features_sel = 0;
    let offered: u32 = virtio_net_regs.device_features;
    virtio_net_regs.driver_features_sel = 0;
    virtio_net_regs.driver_features = features_low & offered;
    virtio_net_regs.driver_features_sel = 1;
    virtio_net_regs.driver_features = VIRTIO_F_VERSION_1_HIGH;
    virtio_net_regs.status = VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER |
                             VIRTIO_STATUS_FEATURES_OK;
    return (virtio_net_regs.status & VIRTIO_STATUS_FEATURES_OK) != 0;
}

// Queue `queue_idx` at its descriptor/avail array and its used ring; false
// when the device offers fewer than QNUM entries or the ring is not Ready.
private fn virtio_queue_setup(guard: borrow BlockDeviceGuard[&block_device_lock], queue: {0..<2 as usize}, used_queue: usize) -> bool !{unsafe} {
    virtio_net_regs.queue_sel = queue as i32;
    if (virtio_net_regs.queue_num_max < QNUM as u32) { return false; }
    virtio_net_regs.queue_num = QNUM as i32;
    let used: usize = virtio_used_go(used_queue);
    if (used == 0) { return false; }
    static_assert(offsetof(VirtioNetQueueStorage, queues) == 0,
                  "queue array must retain its device address");
    static_assert(sizeof(VirtioNetQueueStorage) == 512,
                  "two queues must retain their fixed device extent");
    static_assert(sizeof(VirtqNetQueue) == 256,
                  "queue stride must retain its fixed device extent");
    static_assert(offsetof(VirtqNetQueue, desc) == 0,
                  "descriptor table must start at the queue base");
    static_assert(offsetof(VirtqNetQueue, avail) == 128,
                  "avail ring must follow eight descriptors");
    let desc: usize = (&virtio_net_queues as usize) + queue * sizeof(VirtqNetQueue) + offsetof(VirtqNetQueue, desc);
    let avail: usize = (&virtio_net_queues as usize) + queue * sizeof(VirtqNetQueue) + offsetof(VirtqNetQueue, avail);
    virtio_net_regs.queue_desc_low = (desc & 0xFFFFFFFF) as u32;
    virtio_net_regs.queue_desc_high = (desc >> 32) as u32;
    virtio_net_regs.queue_driver_low = (avail & 0xFFFFFFFF) as u32;
    virtio_net_regs.queue_driver_high = (avail >> 32) as u32;
    virtio_net_regs.queue_device_low = (used & 0xFFFFFFFF) as u32;
    virtio_net_regs.queue_device_high = (used >> 32) as u32;
    virtio_net_regs.queue_ready = 1;
    virtio_net_used_addr[queue] = used;
    return true;
}

fn virtio_driver_ok() {
    virtio_net_regs.status = VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER |
                             VIRTIO_STATUS_FEATURES_OK | VIRTIO_STATUS_DRIVER_OK;
}

fn virtio_notify(queue_idx: i32) {
    virtio_net_regs.queue_notify = queue_idx;
}

fn desc_set(guard: borrow BlockDeviceGuard[&block_device_lock], queue: {0..<2 as usize}, i: {0..<8 as usize}, addr: usize, len: isize, flags: i32) {
    guarded_ref(guard, virtio_net_queues.queues)[queue].desc[i].addr = addr;
    guarded_ref(guard, virtio_net_queues.queues)[queue].desc[i].len = len as u32;
    guarded_ref(guard, virtio_net_queues.queues)[queue].desc[i].flags = flags as u16;
}

fn avail_ring_set(guard: borrow BlockDeviceGuard[&block_device_lock], queue: {0..<2 as usize}, slot: {0..<8 as usize}, desc_idx: {0..<8 as usize}) {
    guarded_ref(guard, virtio_net_queues.queues)[queue].avail.ring[slot] = desc_idx as u16;
}

fn avail_publish(guard: borrow BlockDeviceGuard[&block_device_lock], queue: {0..<2 as usize}, new_idx: VirtioRingIndex) {
    guarded_ref(guard, virtio_net_queues.queues)[queue].avail.idx = new_idx;
    dma_publish();
}

// The used ring of queue `used_queue` (VIRTIO_USED_NET_RX or _TX) from
// one snapshot; None while it is not live.
variant VirtioNetUsed { None; Seen(VirtqUsedRing); }

fn virtio_net_used(used_queue: usize) -> VirtioNetUsed {
    match virtio_used_snapshot(used_queue) {
        VirtioUsedSeen::Unavailable => { return VirtioNetUsed::None; }
        VirtioUsedSeen::Seen(ring) => { return VirtioNetUsed::Seen(ring); }
    }
}

// -- Shared driver API (matches kernel/drivers/net/rp1_gem.tkb) -------------

fn net_init() -> NetInitResult {
    let init_guard = match init_once_begin(&net_init_once) {
        InitOnceBegin::AlreadyComplete => { return NetInitResult::Failed; }
        InitOnceBegin::Start(guard) => { guard }
    };
    if (virtio_net_find() == false) {
        init_once_cancel(&net_init_once, init_guard);
        return NetInitResult::Failed;
    }

    let guard = block_device_take_unaccounted();
    atomic_word_store(&virtio_rx_irq_flag, 0);
    virtio_net_gic_enable();

    if (virtio_net_regs.version != VIRTIO_MMIO_VERSION_MODERN ||
        virtio_pkts_claim() == false ||
        virtio_negotiate(VIRTIO_NET_F_MAC) == false ||
        virtio_queue_setup(guard, 0, VIRTIO_USED_NET_RX) == false ||
        virtio_queue_setup(guard, 1, VIRTIO_USED_NET_TX) == false) {
        virtio_net_regs.status = VIRTIO_STATUS_FAILED;
        block_device_give(guard);
        init_once_cancel(&net_init_once, init_guard);
        return NetInitResult::Failed;
    }
    virtio_driver_ok();
    let mut descs: VirtioRxDescSlots;
    for i: usize in 0..<8 { descs.slot[i] = VIRTIO_PKT_NONE as u8; }
    let mut r: NetRxCanAcquire[&virtio_net_ready] = {
        VirtioRingIndex::Zero, VirtioRingIndex::Zero,
        VirtioRingIndex::Zero, VirtioRingIndex::Zero, descs
    };
    atomic_word_store(&virtio_net_rx_used_published, 0);
    for i: usize in 0..<8 {
        let index: {0..<8 as usize} = i % 8;
        if (virtio_net_rx_post(guard, r, index) == false) {
            block_device_give(guard);
            init_once_cancel(&net_init_once, init_guard);
            net_rx_capability_drop(r);
            return NetInitResult::Failed;
        }
        avail_ring_set(guard, 0, i, i);
    }
    r.rx_avail_idx = (QNUM as u16) as VirtioRingIndex;
    avail_publish(guard, 0, r.rx_avail_idx);
    virtio_notify(0);

    atomic_word_store(&virtio_net_ready, 1);
    block_device_give(guard);
    init_once_commit(&net_init_once, init_guard);
    return NetInitResult::Ready(r);
}

// GitHub issue #959: DDB's lock-free reading of RX pending, under the
// debug stop (#920), which the borrowed MachineStopped makes a compile-time
// requirement (#1164); the raw read itself stays trusted: no ring owner, no lock and no cache maintenance. Once
// the queue is live only the device writes the used ring, and a virtio
// device is the hypervisor writing guest RAM through its own coherent
// caches, so the index loaded with acquire ordering is current. It is
// compared with the driver's shadow as the stopped core left it.
fn kernel_net_rx_frame_pending(stopped: borrow MachineStopped[&kernel_world_stop])
        -> NetPendingState !{unsafe} {
    if (atomic_word_load(&virtio_net_ready) == 0) { return NetPendingState::No; }
    let address: usize = virtio_net_used_addr[0];
    if (address == 0) { return NetPendingState::Unknown; }
    let word: usize = unsafe { atomic_load_acquire(address) };
    let idx: usize = (word >> 16) & 0xFFFF;
    if (idx == (atomic_word_load(&virtio_net_rx_used_published) & 0xFFFF)) {
        return NetPendingState::No;
    }
    return NetPendingState::Yes;
}

// GitHub issue #237 M4: at most ONE interrupt_wait() call, not a retry
// loop -- unlike examples/common_qemu/virtio_mmio.tkb's own net_rx_wait()
// (which this was first copied from), this driver's callers
// (kernel/net/{arp,icmp,tcp}.tkb) run their own CNTPCT-based deadline
// loop around net_rx_wait(), matching kernel/drivers/net/rp1_gem.tkb's
// net_rx_wait() exactly (see that file's own header comment and
// kernel/platform/qemu/timer_irq.tkb's: the periodic timer tick is what
// keeps a genuinely idle wait bounded). A loop here that only returns on
// a REAL virtio RX interrupt would swallow every harmless timer-tick
// wake-up the caller's own deadline check depends on, making the
// caller's bounded wait unbounded again in practice -- found by a real
// QEMU boot hanging well past kernel_arp_reply_once's own 15s deadline
// with no host-side peer attached.
fn net_rx_wait() !{may_block} {
    if (atomic_word_load(&virtio_net_ready) != 0 && atomic_word_load(&virtio_rx_irq_flag) != 0) { return; }
    workload_profile_interrupt_wait();
}

// Busy preserves the pending flag, shadows and pool before any refill.
// The caller retains its capability and retries under its existing deadline.
fn net_rx_acquire(ready: sink NetRxCanAcquire[net]) -> NetRxAcquire[net] {
    let guard = match block_device_try_take() {
        BlockDeviceTry::Busy => { return NetRxAcquire::None(ready); }
        BlockDeviceTry::Taken(taken) => { taken }
    };
    let result = virtio_net_rx_acquire_locked(guard, ready);
    block_device_give(guard);
    return result;
}

private fn virtio_net_rx_acquire_locked(guard: borrow BlockDeviceGuard[&block_device_lock], ready: sink NetRxCanAcquire[net]) -> NetRxAcquire[net] {
    let mut r = ready;
    if (atomic_word_load(&virtio_net_ready) == 0 || atomic_word_load(&virtio_rx_irq_flag) == 0) {
        // No frame, but buffers freed off-turn go back to the ring here.
        virtio_net_rx_refill_locked(guard, r);
        return NetRxAcquire::None(r);
    }
    atomic_word_store(&virtio_rx_irq_flag, 0);
    let VirtioNetUsed::Seen(ring) = virtio_net_used(VIRTIO_USED_NET_RX) else {
        VirtioNetUsed::None => { return NetRxAcquire::None(r); }
    };
    if (r.rx_used_seen == ring.idx) {
        virtio_net_rx_refill_locked(guard, r);
        return NetRxAcquire::None(r);
    }
    atomic_word_store(&virtio_rx_irq_flag, 1); // drain coalesced used-ring entries
    let slot: {0..<8 as usize} = ((r.rx_used_seen as u16) as usize) % 8;
    let index: {0..<8 as usize} = min(ring.ring[slot].id, 7) as usize;
    let frame_total_len: i32 = min(ring.ring[slot].len, 0x7FFFFFFF) as i32;
    let raw_len: i32 = frame_total_len - (VIRTIO_NET_HDR_LEN as i32);
    let safe_len: {0..<1515 as i32} = max(min(raw_len, 1514), 0);
    // The used entry names descriptor `index`: its buffer comes back Filled.
    let pool_slot: usize = r.rx_desc_pkt.slot[index] as usize;
    r.rx_desc_pkt.slot[index] = VIRTIO_PKT_NONE as u8;
    let Place::Full(held) = virtio_pkt_take(pool_slot) else {
        Place::Empty => {
            kernel_invariant_stop();
            return NetRxAcquire::None(r);
        }
    };
    let VirtioPktHeld::RxPosted(held_posted) = held else {
        VirtioPktHeld::Free(p) => { virtio_pkt_lost(VirtioPktHeld::Free(p)); return NetRxAcquire::None(r); }
        VirtioPktHeld::TxPosted(p) => { virtio_pkt_lost(VirtioPktHeld::TxPosted(p)); return NetRxAcquire::None(r); }
        VirtioPktHeld::Unconfirmed(p) => { virtio_pkt_lost(VirtioPktHeld::Unconfirmed(p)); return NetRxAcquire::None(r); }
        VirtioPktHeld::Kept(p) => { virtio_pkt_lost(VirtioPktHeld::Kept(p)); return NetRxAcquire::None(r); }
    };
    let mut posted = held_posted;
    virtio_pkt_note_rx_used(posted, ring.idx, r.rx_used_seen);
    match VirtioPkt_virtio_pkt_received(posted) {
        VirtioPkt_virtio_pkt_received_Outcome::PktEmpty => {
            virtio_pkt_park(pool_slot, VirtioPktHeld::RxPosted(posted));
            kernel_invariant_stop();
            return NetRxAcquire::None(r);
        }
        VirtioPkt_virtio_pkt_received_Outcome::PktReceived(witness) => {
            let filled = VirtioPkt_virtio_pkt_fill(posted, witness);
            // The used entry is consumed and its descriptor goes back to
            // the device with another Free buffer now, not when the stack
            // lets go of this one.
            r.rx_used_seen = virtio_ring_index_next(r.rx_used_seen);
            atomic_word_store(&virtio_net_rx_used_published, (r.rx_used_seen as u16) as usize);
            virtio_net_rx_refill_locked(guard, r);
            return NetRxAcquire::Acquired(net_rx_packet(safe_len, pool_slot, filled, r));
        }
    }
}

// Every RX descriptor without a buffer gets a Free one and goes back on
// the avail ring. A descriptor stays empty while the pool has no Free
// buffer (every one is with the device or held by the stack); the next
// release or transmit completion refills it.
// A busy lock defers queue publication, not pool ownership. Callers retry
// from the existing RX poll/timer path; no extra device IRQ is required.
private fn virtio_net_rx_refill(r: borrow mut NetRxCanAcquire[net]) {
    let guard = match block_device_try_take() {
        BlockDeviceTry::Busy => { return; }
        BlockDeviceTry::Taken(taken) => { taken }
    };
    virtio_net_rx_refill_locked(guard, r);
    block_device_give(guard);
}

private fn virtio_net_rx_refill_locked(guard: borrow BlockDeviceGuard[&block_device_lock], r: borrow mut NetRxCanAcquire[net]) {
    if (atomic_word_load(&virtio_net_ready) == 0) { return; }
    let mut posted: bool = false;
    for i: usize in 0..<8 {
        let index: {0..<8 as usize} = i % 8;
        if (r.rx_desc_pkt.slot[index] as usize == VIRTIO_PKT_NONE && virtio_net_rx_post(guard, r, index)) {
            let rx_slot: {0..<8 as usize} = ((r.rx_avail_idx as u16) as usize) % 8;
            avail_ring_set(guard, 0, rx_slot, index);
            r.rx_avail_idx = virtio_ring_index_next(r.rx_avail_idx);
            posted = true;
        }
    }
    if (posted) {
        avail_publish(guard, 0, r.rx_avail_idx);
        virtio_notify(0);
    }
}

// Post a Free pool buffer to RX descriptor `index` (its rx edge): the
// descriptor takes the address from the RxPosted owner's span. False when
// no buffer is free.
private fn virtio_net_rx_post(guard: borrow BlockDeviceGuard[&block_device_lock], r: borrow mut NetRxCanAcquire[net],
                             index: {0..<8 as usize}) -> bool {
    let pool_slot: usize = virtio_pkt_free_index();
    let Place::Full(held) = virtio_pkt_take(pool_slot) else {
        Place::Empty => { return false; }
    };
    let VirtioPktHeld::Free(free) = held else {
        VirtioPktHeld::RxPosted(p) => { virtio_pkt_park(pool_slot, VirtioPktHeld::RxPosted(p)); return false; }
        VirtioPktHeld::TxPosted(p) => { virtio_pkt_park(pool_slot, VirtioPktHeld::TxPosted(p)); return false; }
        VirtioPktHeld::Unconfirmed(p) => { virtio_pkt_park(pool_slot, VirtioPktHeld::Unconfirmed(p)); return false; }
        VirtioPktHeld::Kept(p) => { virtio_pkt_park(pool_slot, VirtioPktHeld::Kept(p)); return false; }
    };
    let mut address: usize = 0;
    match VirtioPkt_virtio_pkt_post_rx(free) {
        VirtioPkt_virtio_pkt_post_rx_Result::RxPosted(posted) => {
            address = virtio_pkt_rx_address(posted);
            virtio_pkt_park(pool_slot, VirtioPktHeld::RxPosted(posted));
        }
    }
    desc_set(guard, 0, index, address, RX_BUF_SIZE, VIRTQ_DESC_F_WRITE);
    r.rx_desc_pkt.slot[index] = min(pool_slot, VIRTIO_PKT_NONE) as u8;
    return true;
}

fn net_rx_len(packet: borrow NetPacket[pb, po, net]) -> {0..<1515 as i32} {
    return packet.len;
}

fn net_rx_frame(packet: borrow NetPacket[pb, po, net]) -> [u8; 1514..] @ pb {
    let bytes = VirtioPkt_Filled_bytes(packet.pkt, 0);
    return bytes[VIRTIO_NET_HDR_LEN..<VIRTIO_NET_HDR_LEN + 1514];
}

fn net_rx_release(packet: sink NetPacket[pb, po, net]) -> NetRxCanAcquire[net] {
    let slot: usize = packet.slot;
    let pkt = field_take(packet.pkt);
    let mut r = field_take(packet.ready);
    virtio_pkt_park(slot, VirtioPktHeld::Free(VirtioPkt_virtio_pkt_recycle(pkt)));
    virtio_net_rx_refill(r);
    return r;
}

// A capability that will not be handed out (a failed init).
private fn net_rx_capability_drop(r: sink NetRxCanAcquire[net]) {
    let mut descs: VirtioRxDescSlots = r.rx_desc_pkt;
}

// The Free slot a keeping transmit would use, or NET_KEPT_NONE when
// keeping one more buffer would leave fewer than VIRTIO_PKT_RESERVE
// outside the kept set. A slot is out exactly while the stack has its
// buffer: empty (a turn's packet, a claimed one) or parked Kept.
fn net_tx_keep_slot() -> usize {
    if (atomic_word_load(&virtio_net_ready) == 0) { return NET_KEPT_NONE; }
    if (virtio_pkt_out_count() + 1 > VIRTIO_PKTS - VIRTIO_PKT_RESERVE) {
        return NET_KEPT_NONE;
    }
    return virtio_pkt_free_index();
}

// Any core, no capability: the Kept packet in `slot`, taken out.
fn net_packet_kept_claim(slot: usize) -> NetKeptClaim {
    if (slot >= VIRTIO_PKTS) { return NetKeptClaim::None; }
    let Place::Full(held) = virtio_pkt_take(slot) else {
        Place::Empty => { return NetKeptClaim::None; }
    };
    let VirtioPktHeld::Kept(pkt) = held else {
        VirtioPktHeld::Free(p) => { virtio_pkt_park(slot, VirtioPktHeld::Free(p)); return NetKeptClaim::None; }
        VirtioPktHeld::RxPosted(p) => { virtio_pkt_park(slot, VirtioPktHeld::RxPosted(p)); return NetKeptClaim::None; }
        VirtioPktHeld::TxPosted(p) => { virtio_pkt_park(slot, VirtioPktHeld::TxPosted(p)); return NetKeptClaim::None; }
        VirtioPktHeld::Unconfirmed(p) => { virtio_pkt_park(slot, VirtioPktHeld::Unconfirmed(p)); return NetKeptClaim::None; }
    };
    let len: {0..<1515 as i32} = virtio_pkt_kept_len(pkt);
    return NetKeptClaim::Claimed(net_packet_kept(len, slot, pkt));
}

private fn net_packet_kept(len: {0..<1515 as i32}, slot: usize,
                           pkt: VirtioPkt_Filled[pb, po, 1]) -> NetPacketKept[pb, po] {
    let mut kept: NetPacketKept[pb, po] = { len, slot, pkt };
    return kept;
}

// Any core, no capability: the buffer goes back to its slot Free, under
// the slot's lock. The ring is not touched.
fn net_packet_free(kept: sink NetPacketKept[pb, po]) {
    let slot: usize = kept.slot;
    virtio_pkt_park(slot, VirtioPktHeld::Free(VirtioPkt_virtio_pkt_recycle(kept.pkt)));
}

fn net_rx_reply_ready(packet: sink NetPacket[pb, po, net], len: i32)
        -> NetRxReplyReady[pb, po, net] {
    let safe_len: {0..<1515 as i32} = max(min(len, 1514), 0);
    let slot: usize = packet.slot;
    let pkt = field_take(packet.pkt);
    let ready = field_take(packet.ready);
    let mut reply: NetRxReplyReady[pb, po, net] = { safe_len, slot, pkt, ready };
    return reply;
}

// In-place reply: reuses the RX buffer's own leading VIRTIO_NET_HDR_LEN
// bytes as the TX virtio_net_hdr (matches examples/common_qemu/
// virtio_mmio.tkb's own net_transmit -- correct because those bytes were
// written by the device on RX with no offload fields set, i.e. already
// effectively zero, and no offload features are negotiated on TX either).
private fn net_transmit(reply: sink NetRxReplyReady[pb, po, net]) -> NetTxInFlight[pb, po, net] {
    workload_profile_note_network_tx(reply.len as usize);
    let slot: usize = reply.slot;
    let len: {0..<1515 as i32} = reply.len;
    let pkt = field_take(reply.pkt);
    let mut r = field_take(reply.ready);
    // The RX header the device wrote carries num_buffers; a transmitted
    // header is all zero (no offloads are negotiated).
    let header = VirtioPkt_Filled_bytes(pkt, 0);
    for i: usize in 0..<VIRTIO_NET_HDR_LEN { header[i] = 0; }
    let mut address: usize = 0;
    match VirtioPkt_virtio_pkt_post_tx(pkt) {
        VirtioPkt_virtio_pkt_post_tx_Result::TxPosted(posted) => {
            address = virtio_pkt_tx_address(posted);
            virtio_pkt_park(slot, VirtioPktHeld::TxPosted(posted));
        }
    }
    virtio_net_tx_ring(r, address, (len + (VIRTIO_NET_HDR_LEN as i32)) as usize);
    let mut in_flight: NetTxInFlight[pb, po, net] = { slot, r };
    return in_flight;
}

// A used-index observation returns the buffer to the pool. Timeout alone
// does not: the buffer stays Unconfirmed and both queues are disabled.
// keep (#740): a confirmed buffer is parked Kept, Filled again, for a
// retransmission; its length is recorded for the resend.
private fn virtio_net_tx_finish(r: borrow mut NetRxCanAcquire[net], slot: usize,
                                keep: bool, len: {0..<1515 as i32})
        -> bool !{may_block} {
    let completed: bool = match virtio_net_tx_wait(r.tx_used_seen) {
        VirtioNetTxCompletion::Completed => { true }
        VirtioNetTxCompletion::Unconfirmed => { false }
    };
    let Place::Full(held) = virtio_pkt_take(slot) else {
        Place::Empty => { kernel_invariant_stop(); return false; }
    };
    let VirtioPktHeld::TxPosted(held_posted) = held else {
        VirtioPktHeld::Free(p) => { virtio_pkt_lost(VirtioPktHeld::Free(p)); return false; }
        VirtioPktHeld::RxPosted(p) => { virtio_pkt_lost(VirtioPktHeld::RxPosted(p)); return false; }
        VirtioPktHeld::Unconfirmed(p) => { virtio_pkt_lost(VirtioPktHeld::Unconfirmed(p)); return false; }
        VirtioPktHeld::Kept(p) => { virtio_pkt_lost(VirtioPktHeld::Kept(p)); return false; }
    };
    let mut posted = held_posted;
    virtio_pkt_note_tx_shadow(posted, r.tx_used_seen);
    if (completed) {
        match VirtioPkt_virtio_pkt_sent(posted) {
            VirtioPkt_virtio_pkt_sent_Outcome::PktSent(witness) => {
                if (keep && slot < VIRTIO_PKTS) {
                    let mut kept_pkt = VirtioPkt_virtio_pkt_kept(posted, witness);
                    virtio_pkt_note_kept_len(kept_pkt, len);
                    virtio_pkt_park(slot, VirtioPktHeld::Kept(kept_pkt));
                } else {
                    virtio_pkt_park(slot, VirtioPktHeld::Free(VirtioPkt_virtio_pkt_done(posted, witness)));
                }
                dma_consume();
                r.tx_used_seen = virtio_ring_index_next(r.tx_used_seen);
                return true;
            }
            VirtioPkt_virtio_pkt_sent_Outcome::PktPending => {
                virtio_pkt_park(slot, VirtioPktHeld::Unconfirmed(VirtioPkt_virtio_pkt_expire(posted)));
            }
        }
    } else {
        virtio_pkt_park(slot, VirtioPktHeld::Unconfirmed(VirtioPkt_virtio_pkt_expire(posted)));
    }
    atomic_word_store(&virtio_net_ready, 0);
    atomic_word_fetch_add(&virtio_net_tx_timeouts, 1);
    kernel_boot_log("virtio net: tx completion unconfirmed; queues disabled\n");
    return false;
}

// No snapshot (the ring is not live) counts as pending.
// Against the TX used shadow `seen` (the capability's, or the copy a
// TxPosted owner carries for its observation).
fn virtio_net_tx_used_pending(seen: VirtioRingIndex) -> bool {
    let VirtioNetUsed::Seen(ring) = virtio_net_used(VIRTIO_USED_NET_TX) else {
        VirtioNetUsed::None => { return true; }
    };
    return seen == ring.idx;
}

private fn net_tx_complete(in_flight: sink NetTxInFlight[pb, po, net])
        -> NetRxCanAcquire[net] !{may_block} {
    let slot: usize = in_flight.slot;
    let mut r = in_flight.ready;
    virtio_net_tx_finish(r, slot, false, 0);
    virtio_net_rx_refill(r);
    return r;
}

fn net_rx_send_reply(reply: sink NetRxReplyReady[pb, po, net]) -> NetRxCanAcquire[net] !{may_block} {
    if (atomic_word_load(&virtio_net_ready) == 0) {
        let slot: usize = reply.slot;
        let pkt = field_take(reply.pkt);
        let r = field_take(reply.ready);
        virtio_pkt_park(slot, VirtioPktHeld::Free(VirtioPkt_virtio_pkt_recycle(pkt)));
        return r;
    }
    return net_tx_complete(net_transmit(reply));
}

// A kept packet retransmitted in place; its completion parks it Kept
// again in its slot (#740). Not sent when the queues are disabled; it
// stays Kept for the caller's eventual free.
fn net_packet_kept_resend(ready: sink NetRxCanAcquire[net], kept: sink NetPacketKept[pb, po])
        -> NetRxCanAcquire[net] !{may_block} {
    let mut r = ready;
    let slot: usize = kept.slot;
    let len: {0..<1515 as i32} = kept.len;
    if (atomic_word_load(&virtio_net_ready) == 0) {
        virtio_pkt_park(slot, VirtioPktHeld::Kept(kept.pkt));
        return r;
    }
    workload_profile_note_network_tx(len as usize);
    let mut address: usize = 0;
    match VirtioPkt_virtio_pkt_post_tx(kept.pkt) {
        VirtioPkt_virtio_pkt_post_tx_Result::TxPosted(posted) => {
            address = virtio_pkt_tx_address(posted);
            virtio_pkt_park(slot, VirtioPktHeld::TxPosted(posted));
        }
    }
    virtio_net_tx_ring(r, address, (len + (VIRTIO_NET_HDR_LEN as i32)) as usize);
    virtio_net_tx_finish(r, slot, true, len);
    virtio_net_rx_refill(r);
    return r;
}

// Kernel-built frame, no RX buffer to reuse: written into the scratch TX
// buffer through its protocol owner (virtio_net_tx_dma.tkb). Matches
// rp1_gem.tkb's net_transmit_ready() signature and blocking-completion
// behavior (kernel/net/tcp.tkb calls this for segments it builds itself).
fn net_transmit_ready(ready: sink NetRxCanAcquire[net],
                      bytes: borrow [u8; 1514..], len: i32)
        -> NetRxCanAcquire[net] !{may_block} {
    let mut r = ready;
    virtio_net_send_built(r, virtio_pkt_free_index(), false, bytes, len);
    return r;
}

// A kernel-built frame sent from `slot`, which net_tx_keep_slot named, and
// kept there for retransmission (#740). Sent, from any Free buffer, when
// the slot no longer passes that check.
fn net_transmit_keep(ready: sink NetRxCanAcquire[net], slot: usize,
                     bytes: borrow [u8; 1514..], len: i32)
        -> NetTxKeep[net] !{may_block} {
    if (slot == NET_KEPT_NONE || net_tx_keep_slot() != slot) {
        return NetTxKeep::Sent(net_transmit_ready(ready, bytes, len));
    }
    let mut r = ready;
    if (virtio_net_send_built(r, slot, true, bytes, len)) {
        return NetTxKeep::Kept(r);
    }
    return NetTxKeep::Sent(r);
}

// Writes the frame into the Free buffer in `slot` and sends it from Free.
// True when keep was asked and the completion parked it Kept.
private fn virtio_net_send_built(r: borrow mut NetRxCanAcquire[net], slot: usize, keep: bool,
                                 bytes: borrow [u8; 1514..], len: i32)
        -> bool !{may_block} {
    if (atomic_word_load(&virtio_net_ready) == 0) { return false; }
    let safe_len: {0..<1515 as i32} = max(min(len, 1514), 0);
    workload_profile_note_network_tx(safe_len as usize);
    let Place::Full(held) = virtio_pkt_take(slot) else {
        Place::Empty => { return false; }
    };
    let VirtioPktHeld::Free(free) = held else {
        VirtioPktHeld::RxPosted(p) => { virtio_pkt_park(slot, VirtioPktHeld::RxPosted(p)); return false; }
        VirtioPktHeld::TxPosted(p) => { virtio_pkt_park(slot, VirtioPktHeld::TxPosted(p)); return false; }
        VirtioPktHeld::Unconfirmed(p) => { virtio_pkt_park(slot, VirtioPktHeld::Unconfirmed(p)); return false; }
        VirtioPktHeld::Kept(p) => { virtio_pkt_park(slot, VirtioPktHeld::Kept(p)); return false; }
    };
    // The virtio_net_hdr is all zero (no offloads are negotiated).
    let out = VirtioPkt_Free_bytes(free, 0);
    for i: usize in 0..<VIRTIO_NET_HDR_LEN { out[i] = 0; }
    slice_copy(out[VIRTIO_NET_HDR_LEN..<VIRTIO_NET_HDR_LEN + (safe_len as usize)],
               bytes[0..<safe_len as usize]);
    let mut address: usize = 0;
    match VirtioPkt_virtio_pkt_send(free) {
        VirtioPkt_virtio_pkt_send_Result::TxPosted(posted) => {
            address = virtio_pkt_tx_address(posted);
            virtio_pkt_park(slot, VirtioPktHeld::TxPosted(posted));
        }
    }
    virtio_net_tx_ring(r, address, VIRTIO_NET_HDR_LEN + (safe_len as usize));
    let kept: bool = virtio_net_tx_finish(r, slot, keep, safe_len) && keep;
    virtio_net_rx_refill(r);
    return kept;
}

// The doorbell for one transmit: descriptor 0 at the address its TxPosted
// owner's span gave (virtio_pkt_tx_address).
fn virtio_net_tx_ring(r: borrow mut NetRxCanAcquire[net], address: usize, length: usize) {
    let guard = block_device_take_unaccounted();
    desc_set(guard, 1, 0, address, length as isize, 0);
    avail_ring_set(guard, 1, 0, 0);
    r.tx_avail_idx = virtio_ring_index_next(r.tx_avail_idx);
    avail_publish(guard, 1, r.tx_avail_idx);
    atomic_word_fetch_add(&virtio_net_tx_submissions, 1);
    virtio_notify(1);
    block_device_give(guard);
}

// The MAC is the first six configuration bytes, read as two little-endian
// words.
fn net_read_mac(mac_out: borrow [u8; 6..]) {
    let low: u32 = virtio_net_regs.config_word[0];
    let high: u32 = virtio_net_regs.config_word[1];
    mac_out[0] = (low & 0xFF) as u8;
    mac_out[1] = ((low >> 8) & 0xFF) as u8;
    mac_out[2] = ((low >> 16) & 0xFF) as u8;
    mac_out[3] = ((low >> 24) & 0xFF) as u8;
    mac_out[4] = (high & 0xFF) as u8;
    mac_out[5] = ((high >> 8) & 0xFF) as u8;
}

fn net_shutdown(ready: sink NetRxCanAcquire[net]) {
    net_rx_capability_drop(ready);
}

