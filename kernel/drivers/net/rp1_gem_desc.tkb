// GitHub issue #740 slice 3: the RP1 GEM descriptor rings as owners of two
// rx device protocols (#720 option a). Both rings are `rx` because GEM
// writes back into the descriptors it owns: the RX descriptor's ownership
// bit and length, the TX descriptor's USED bit. This file is a
// device-semantics file (kernel/DEVICE_SEMANTICS_FILES); what it trusts:
//   - gem_rx_ring_peek / gem_rx_ring_filled: the RX descriptor's ownership
//     bit (word 0, bit 0) set in a snapshot taken after invalidating its
//     line means GEM has written the frame and length and will not touch
//     the descriptor until the CPU clears the bit (Cadence GEM receive
//     descriptor protocol; RP1 uses one descriptor with WRAP);
//   - gem_tx_ring_peek / gem_tx_ring_used: the submitted TX descriptor's
//     USED bit (word 1, bit 31) set in such a snapshot means GEM has read
//     the frame and stopped at the next descriptor, whose USED bit is set;
//   - gem_tx_ring_halted: gem_halt() confirmed TSR.TGO clear with
//     NCR.THalt set, so GEM reads no TX descriptor;
//   - both Ready states are `addressed`: RBQP and TBQP are programmed from
//     the Ready spans at init. GEM fetches a TX descriptor only after
//     TSTART, which gem_tx_ring_start rings after the generated clean, and
//     never writes an RX descriptor whose ownership bit is set, which holds
//     for the RX ring in Ready (the bit is cleared only just before arming).
// A peek's snapshot only records what it saw; the completes observations
// read that record, so a ring leaves its device state only after a
// snapshot that showed the bit.
//
// The packet buffers are the #740 pool: GEM_PKTS buffers, each the owner
// of a `txrx` protocol (GemPkt). A buffer is posted for receive (rx edge)
// or for transmit (tx edge: an in-place reply from Filled, or a
// kernel-built frame from Free). What this file trusts for them:
//   - gem_pkt_received: the RX ring's own completes observation
//     (gem_rx_ring_filled) returned RxFilled for the descriptor that held
//     this buffer, so GEM has written it;
//   - gem_pkt_sent: the TX ring's gem_tx_ring_used returned TxUsed for the
//     descriptor that held this buffer, so GEM has read it;
//   - gem_pkt_halted: gem_halt() confirmed the TX halt;
//   - a buffer's address reaches a descriptor only from its device state's
//     span (the lowerings below), and GEM reads a TX buffer only after
//     TSTART of a descriptor pointing at it.
//
// Current limitations (2026-10-14):
// - One owner per ring, whole-ring device states, and at most one buffer
//   posted for receive and one for transmit: the driver is synchronous.
// - A buffer whose transmit stays unconfirmed after a failed halt is parked
//   Unconfirmed for the rest of the boot.

use "kernel/lib/mutex.tkb";
use "kernel/lib/task_mutex.tkb";

const GEM_DESC_COUNT: usize = 4;

// One 64-bit-addressing GEM descriptor: address low (with RX ownership and
// WRAP bits), control/status, address high, reserved.
struct GemDesc {
    addr_lo: u32;
    ctrl: u32;
    addr_hi: u32;
    reserved: u32;
}

protocol GemRxRing[inst: usize] retains region(GemDesc)[b, GEM_DESC_COUNT] rx {
    state Ready access write addressed;
    state Armed[req] device;
    init Ready;
    transition gem_rx_ring_arm(Ready) -> Armed[fresh req];
    observe gem_rx_ring_peek(Armed[req]) -> RxDesc snapshot | RxEmpty;
    observe gem_rx_ring_filled(Armed[req]) -> RxFilled[req] completes | RxPending;
    transition gem_rx_ring_take(Armed[req], RxFilled[req]) -> Ready;
    property disjoint;
    model cells 2;
}

protocol GemTxRing[inst: usize] retains region(GemDesc)[b, GEM_DESC_COUNT] rx {
    state Ready access write addressed;
    state Sending[req] device;
    init Ready;
    transition gem_tx_ring_start(Ready) -> Sending[fresh req];
    observe gem_tx_ring_peek(Sending[req]) -> TxDesc snapshot | TxBusy;
    observe gem_tx_ring_used(Sending[req]) -> TxUsed[req] completes | TxNotUsed;
    transition gem_tx_ring_done(Sending[req], TxUsed[req]) -> Ready;
    observe gem_tx_ring_halted(Sending[req]) -> TxHalted[req] quiesces | TxRunning;
    transition gem_tx_ring_reclaim(Sending[req], TxHalted[req]) -> Ready;
    property disjoint;
    model cells 2;
}

private region let mut gem_rx_ring: [GemDesc; 4] align(64);
private region let mut gem_tx_ring: [GemDesc; 4] align(64);

// What the latest snapshots showed, read by the completes observations.
private let mut gem_rx_seen_filled: bool = false;
private let mut gem_tx_seen_used: bool = false;
// Set by gem_tx_ring_mark_halted after gem_halt() confirmed the halt.
private let mut gem_tx_halt_confirmed: bool = false;

fn gem_rx_ring_arm(s: borrow GemRxRing_Armed[b, o, 4, r]) {}
fn gem_rx_ring_peek(s: borrow GemRxRing_Armed[b, o, 4, r], value: GemDesc)
        -> GemRxRing_gem_rx_ring_peek_Raw {
    if ((value.addr_lo & 1) != 0) {
        gem_rx_seen_filled = true;
        return GemRxRing_gem_rx_ring_peek_Raw::RxDesc;
    }
    return GemRxRing_gem_rx_ring_peek_Raw::RxEmpty;
}
fn gem_rx_ring_peek_release(s: borrow GemRxRing_Armed[b, o, 4, r]) {}
fn gem_rx_ring_filled(s: borrow GemRxRing_Armed[b, o, 4, r])
        -> GemRxRing_gem_rx_ring_filled_Raw {
    if (gem_rx_seen_filled) {
        gem_rx_seen_filled = false;
        gem_pkt_rx_seen = true;
        return GemRxRing_gem_rx_ring_filled_Raw::RxFilled;
    }
    return GemRxRing_gem_rx_ring_filled_Raw::RxPending;
}
fn gem_rx_ring_take(s: borrow GemRxRing_Armed[b, o, 4, r]) {}

// TSTART: runs after the generated clean and the state change.
fn gem_tx_ring_start(s: borrow GemTxRing_Sending[b, o, 4, r]) {
    gem_tx_seen_used = false;
    gem.ncr = gem.ncr | (1 << 9);
}
fn gem_tx_ring_peek(s: borrow GemTxRing_Sending[b, o, 4, r], value: GemDesc)
        -> GemTxRing_gem_tx_ring_peek_Raw {
    if ((value.ctrl & (1 << 31)) != 0) {
        gem_tx_seen_used = true;
        return GemTxRing_gem_tx_ring_peek_Raw::TxDesc;
    }
    return GemTxRing_gem_tx_ring_peek_Raw::TxBusy;
}
fn gem_tx_ring_peek_release(s: borrow GemTxRing_Sending[b, o, 4, r]) {}
fn gem_tx_ring_used(s: borrow GemTxRing_Sending[b, o, 4, r])
        -> GemTxRing_gem_tx_ring_used_Raw {
    if (gem_tx_seen_used) {
        gem_pkt_tx_seen = true;
        return GemTxRing_gem_tx_ring_used_Raw::TxUsed;
    }
    return GemTxRing_gem_tx_ring_used_Raw::TxNotUsed;
}
fn gem_tx_ring_done(s: borrow GemTxRing_Sending[b, o, 4, r]) {}
fn gem_tx_ring_halted(s: borrow GemTxRing_Sending[b, o, 4, r])
        -> GemTxRing_gem_tx_ring_halted_Raw {
    if (gem_tx_halt_confirmed) { return GemTxRing_gem_tx_ring_halted_Raw::TxHalted; }
    return GemTxRing_gem_tx_ring_halted_Raw::TxRunning;
}
fn gem_tx_ring_reclaim(s: borrow GemTxRing_Sending[b, o, 4, r]) {}

// Called by rp1_gem.tkb only when gem_halt() returned true.
fn gem_tx_ring_mark_halted() { gem_tx_halt_confirmed = true; }

variant GemRxRingHeld {
    Ready(exists b: addr. exists o: usize. GemRxRing_Ready[b, o, 4]);
    Armed(exists b: addr. exists o: usize. exists r: usize. GemRxRing_Armed[b, o, 4, r]);
}
variant GemTxRingHeld {
    Ready(exists b: addr. exists o: usize. GemTxRing_Ready[b, o, 4]);
    Sending(exists b: addr. exists o: usize. exists r: usize. GemTxRing_Sending[b, o, 4, r]);
}

struct GemRxRingSlot {
    private mutex: TaskMutex;
    private value: Place(GemRxRingHeld);
}
struct GemTxRingSlot {
    private mutex: TaskMutex;
    private value: Place(GemTxRingHeld);
}
private let mut gem_rx_ring_slot: GemRxRingSlot;
private let mut gem_tx_ring_slot: GemTxRingSlot;

private linear struct GemRingGuard[lock: addr] { private held: usize; }

private fn gem_ring_lock(lock: *TaskMutex @ address) -> GemRingGuard[address]
        !{may_block, acquires_lock_30_gem_ring, lock_guard_30_gem_ring} {
    task_mutex_acquire(lock);
    let mut guard: GemRingGuard[address] = { 1 };
    return guard;
}

private fn gem_ring_unlock(guard: sink GemRingGuard[address], lock: *TaskMutex @ address) {
    let held: usize = guard.held;
    task_mutex_release(lock);
}

// A slot never holds two owners, and every taker parks one back.
private fn gem_rx_ring_lost(held: sink GemRxRingHeld) { kernel_invariant_stop(); }
private fn gem_tx_ring_lost(held: sink GemTxRingHeld) { kernel_invariant_stop(); }

fn gem_rx_ring_take_held() -> Place(GemRxRingHeld) {
    let guard = gem_ring_lock(&gem_rx_ring_slot.mutex);
    let taken: Place(GemRxRingHeld) = place_take(
        guard, &gem_rx_ring_slot.mutex, gem_rx_ring_slot.value);
    gem_ring_unlock(guard, &gem_rx_ring_slot.mutex);
    return taken;
}

fn gem_rx_ring_park(held: GemRxRingHeld) {
    let guard = gem_ring_lock(&gem_rx_ring_slot.mutex);
    let previous: Place(GemRxRingHeld) = place_put(
        guard, &gem_rx_ring_slot.mutex, gem_rx_ring_slot.value, held);
    gem_ring_unlock(guard, &gem_rx_ring_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { gem_rx_ring_lost(other); }
    }
}

fn gem_tx_ring_take_held() -> Place(GemTxRingHeld) {
    let guard = gem_ring_lock(&gem_tx_ring_slot.mutex);
    let taken: Place(GemTxRingHeld) = place_take(
        guard, &gem_tx_ring_slot.mutex, gem_tx_ring_slot.value);
    gem_ring_unlock(guard, &gem_tx_ring_slot.mutex);
    return taken;
}

fn gem_tx_ring_park(held: GemTxRingHeld) {
    let guard = gem_ring_lock(&gem_tx_ring_slot.mutex);
    let previous: Place(GemTxRingHeld) = place_put(
        guard, &gem_tx_ring_slot.mutex, gem_tx_ring_slot.value, held);
    gem_ring_unlock(guard, &gem_tx_ring_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { gem_tx_ring_lost(other); }
    }
}

// Both rings, claimed once by net_init, parked Ready.
fn gem_rings_claim() -> bool {
    let RegionOf(GemDesc)::Taken(rx) = region_of(gem_rx_ring) else {
        RegionOf(GemDesc)::Gone => { return false; }
    };
    gem_rx_ring_park(GemRxRingHeld::Ready(GemRxRing_init(rx)));
    let RegionOf(GemDesc)::Taken(tx) = region_of(gem_tx_ring) else {
        RegionOf(GemDesc)::Gone => { return false; }
    };
    gem_tx_ring_park(GemTxRingHeld::Ready(GemTxRing_init(tx)));
    return true;
}

// Whether the armed RX descriptor holds a frame, from one snapshot. The
// owner stays Armed; the record lets gem_rx_ring_filled confirm it.
fn gem_rx_ring_poll() -> bool {
    let Place::Full(held) = gem_rx_ring_take_held() else {
        Place::Empty => { return false; }
    };
    let GemRxRingHeld::Armed(armed) = held else {
        GemRxRingHeld::Ready(ready) => {
            gem_rx_ring_park(GemRxRingHeld::Ready(ready));
            return false;
        }
    };
    let mut filled: bool = false;
    match GemRxRing_gem_rx_ring_peek(armed, 0) {
        GemRxRing_gem_rx_ring_peek_Outcome::RxDesc(entry) => {
            filled = true;
            GemRxRing_RxDesc_release(armed, entry);
        }
        GemRxRing_gem_rx_ring_peek_Outcome::RxEmpty => {}
    }
    gem_rx_ring_park(GemRxRingHeld::Armed(armed));
    return filled;
}

// Whether TX descriptor `slot` was read, from one snapshot.
fn gem_tx_ring_poll(slot: {0..<2 as usize}) -> bool {
    let Place::Full(held) = gem_tx_ring_take_held() else {
        Place::Empty => { return false; }
    };
    let GemTxRingHeld::Sending(sending) = held else {
        GemTxRingHeld::Ready(ready) => {
            gem_tx_ring_park(GemTxRingHeld::Ready(ready));
            return false;
        }
    };
    let mut used: bool = false;
    match GemTxRing_gem_tx_ring_peek(sending, slot) {
        GemTxRing_gem_tx_ring_peek_Outcome::TxDesc(entry) => {
            used = true;
            GemTxRing_TxDesc_release(sending, entry);
        }
        GemTxRing_gem_tx_ring_peek_Outcome::TxBusy => {}
    }
    gem_tx_ring_park(GemTxRingHeld::Sending(sending));
    return used;
}

// ---- The packet-buffer pool (#740) ----

const GEM_PKT_ONE: usize = 1;
const GEM_PKTS: usize = 4;

// One GEM RX buffer's worth (DMACFG's 2048-byte receive buffers).
struct GemPacket {
    bytes: [u8; 2048];
}

protocol GemPkt[inst: usize] retains region(GemPacket)[b, GEM_PKT_ONE] txrx {
    state Free access write;
    state RxPosted[req] device;
    state Filled access write;
    state TxPosted[req] device access read;
    state Unconfirmed[req] device;
    init Free;
    transition gem_pkt_post_rx(Free) rx -> RxPosted[fresh req];
    observe gem_pkt_received(RxPosted[req]) -> PktReceived[req] completes | PktEmpty;
    transition gem_pkt_fill(RxPosted[req], PktReceived[req]) -> Filled;
    transition gem_pkt_post_tx(Filled) tx -> TxPosted[fresh req];
    transition gem_pkt_send(Free) tx -> TxPosted[fresh req];
    observe gem_pkt_sent(TxPosted[req]) -> PktSent[req] completes | PktPending;
    transition gem_pkt_done(TxPosted[req], PktSent[req]) -> Free;
    transition gem_pkt_kept(TxPosted[req], PktSent[req]) -> Filled;
    observe gem_pkt_halted(TxPosted[req]) -> PktHalted[req] quiesces | PktRunning;
    transition gem_pkt_reclaim(TxPosted[req], PktHalted[req]) -> Free;
    transition gem_pkt_expire(TxPosted[req]) -> Unconfirmed[req];
    transition gem_pkt_recycle(Filled) -> Free;
    property disjoint;
    model cells 2;
}

private region let mut gem_pkt_pool: [GemPacket; 4] align(64);

// The bus address the latest publication handed out, for the descriptor.
private let mut gem_pkt_addr: usize = 0;
// Set by the rings' completes observations above, read once here.
private let mut gem_pkt_rx_seen: bool = false;
private let mut gem_pkt_tx_seen: bool = false;

fn gem_pkt_post_rx(s: borrow GemPkt_RxPosted[b, o, 1, r]) !{unsafe} {
    let mut span: DmaDeviceSpan = GemPkt_RxPosted_span(s);
    gem_pkt_addr = gem_span_bus_address(span);
    gem_pkt_rx_seen = false;
}
fn gem_pkt_received(s: borrow GemPkt_RxPosted[b, o, 1, r]) -> GemPkt_gem_pkt_received_Raw {
    if (gem_pkt_rx_seen) {
        gem_pkt_rx_seen = false;
        return GemPkt_gem_pkt_received_Raw::PktReceived;
    }
    return GemPkt_gem_pkt_received_Raw::PktEmpty;
}
fn gem_pkt_fill(s: borrow GemPkt_RxPosted[b, o, 1, r]) {}
fn gem_pkt_post_tx(s: borrow GemPkt_TxPosted[b, o, 1, r]) !{unsafe} { gem_pkt_tx_posted(s); }
fn gem_pkt_send(s: borrow GemPkt_TxPosted[b, o, 1, r]) !{unsafe} { gem_pkt_tx_posted(s); }
private fn gem_pkt_tx_posted(s: borrow GemPkt_TxPosted[b, o, 1, r]) !{unsafe} {
    let mut span: DmaDeviceSpan = GemPkt_TxPosted_span(s);
    gem_pkt_addr = gem_span_bus_address(span);
    gem_pkt_tx_seen = false;
}
fn gem_pkt_sent(s: borrow GemPkt_TxPosted[b, o, 1, r]) -> GemPkt_gem_pkt_sent_Raw {
    if (gem_pkt_tx_seen) {
        gem_pkt_tx_seen = false;
        return GemPkt_gem_pkt_sent_Raw::PktSent;
    }
    return GemPkt_gem_pkt_sent_Raw::PktPending;
}
fn gem_pkt_done(s: borrow GemPkt_TxPosted[b, o, 1, r]) {}
fn gem_pkt_kept(s: borrow GemPkt_TxPosted[b, o, 1, r]) {}
fn gem_pkt_halted(s: borrow GemPkt_TxPosted[b, o, 1, r]) -> GemPkt_gem_pkt_halted_Raw {
    if (gem_tx_halt_confirmed) { return GemPkt_gem_pkt_halted_Raw::PktHalted; }
    return GemPkt_gem_pkt_halted_Raw::PktRunning;
}
fn gem_pkt_reclaim(s: borrow GemPkt_TxPosted[b, o, 1, r]) {}
fn gem_pkt_expire(s: borrow GemPkt_TxPosted[b, o, 1, r]) {}
fn gem_pkt_recycle(s: borrow GemPkt_Filled[b, o, 1]) {}

// The address of the latest publication.
fn gem_pkt_published_address() -> usize { return gem_pkt_addr; }

// A buffer between operations: Free, or with the device. A Filled buffer
// is never parked here; the stack holds it.
variant GemPktHeld {
    Free(exists b: addr. exists o: usize. GemPkt_Free[b, o, 1]);
    RxPosted(exists b: addr. exists o: usize. exists r: usize. GemPkt_RxPosted[b, o, 1, r]);
    TxPosted(exists b: addr. exists o: usize. exists r: usize. GemPkt_TxPosted[b, o, 1, r]);
    Unconfirmed(exists b: addr. exists o: usize. exists r: usize. GemPkt_Unconfirmed[b, o, 1, r]);
    // A transmitted packet kept for retransmission (#740), until claimed.
    Kept(exists b: addr. exists o: usize. GemPkt_Filled[b, o, 1]);
}

struct GemPktSlot {
    private mutex: TaskMutex;
    private value: Place(GemPktHeld);
}
private let mut gem_pkt_slots: [GemPktSlot; 4];

fn gem_pkt_lost(held: sink GemPktHeld) { kernel_invariant_stop(); }

fn gem_pkt_take(i: usize) -> Place(GemPktHeld) {
    if (i >= GEM_PKTS) { return Place::Empty; }
    let guard = gem_ring_lock(&gem_pkt_slots[i].mutex);
    let taken: Place(GemPktHeld) = place_take(
        guard, &gem_pkt_slots[i].mutex, gem_pkt_slots[i].value);
    gem_ring_unlock(guard, &gem_pkt_slots[i].mutex);
    return taken;
}

fn gem_pkt_park(i: usize, held: GemPktHeld) {
    if (i >= GEM_PKTS) {
        gem_pkt_lost(held);
        return;
    }
    let guard = gem_ring_lock(&gem_pkt_slots[i].mutex);
    let previous: Place(GemPktHeld) = place_put(
        guard, &gem_pkt_slots[i].mutex, gem_pkt_slots[i].value, held);
    gem_ring_unlock(guard, &gem_pkt_slots[i].mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { gem_pkt_lost(other); }
    }
}

// The pool, claimed once by net_init: four buffers, all Free.
fn gem_pkts_claim() -> bool {
    let RegionOf(GemPacket)::Taken(pool) = region_of(gem_pkt_pool) else {
        RegionOf(GemPacket)::Gone => { return false; }
    };
    let (p0, rest0) = region_split_static(pool, 1);
    let (p1, rest1) = region_split_static(rest0, 1);
    let (p2, p3) = region_split_static(rest1, 1);
    gem_pkt_park(0, GemPktHeld::Free(GemPkt_init(p0)));
    gem_pkt_park(1, GemPktHeld::Free(GemPkt_init(p1)));
    gem_pkt_park(2, GemPktHeld::Free(GemPkt_init(p2)));
    gem_pkt_park(3, GemPktHeld::Free(GemPkt_init(p3)));
    return true;
}

// How many buffers the stack has: empty slots (the packet of the current
// RX turn, claimed kept packets) and slots parked Kept. Only the RX
// capability's holder scans, one slot lock at a time, while other cores
// may claim or free kept packets. kernel/models/PacketReserveScan.tla
// checks that such interleavings can only make the count high, never
// low, and that the ring keeps a posted descriptor.
fn gem_pkt_out_count() -> usize {
    let mut out: usize = 0;
    for i: usize in 0..<4 {
        match gem_pkt_take(i) {
            Place::Empty => { out = out + 1; }
            Place::Full(held) => {
                match held {
                    GemPktHeld::Kept(p) => { out = out + 1; gem_pkt_park(i, GemPktHeld::Kept(p)); }
                    GemPktHeld::Free(p) => { gem_pkt_park(i, GemPktHeld::Free(p)); }
                    GemPktHeld::RxPosted(p) => { gem_pkt_park(i, GemPktHeld::RxPosted(p)); }
                    GemPktHeld::TxPosted(p) => { gem_pkt_park(i, GemPktHeld::TxPosted(p)); }
                    GemPktHeld::Unconfirmed(p) => { gem_pkt_park(i, GemPktHeld::Unconfirmed(p)); }
                }
            }
        }
    }
    return out;
}

// A slot holding a Free buffer, or GEM_PKTS when none is free.
fn gem_pkt_free_index() -> usize {
    for i: usize in 0..<4 {
        match gem_pkt_take(i) {
            Place::Empty => {}
            Place::Full(held) => {
                match held {
                    GemPktHeld::Free(free) => {
                        gem_pkt_park(i, GemPktHeld::Free(free));
                        return i;
                    }
                    GemPktHeld::RxPosted(p) => { gem_pkt_park(i, GemPktHeld::RxPosted(p)); }
                    GemPktHeld::TxPosted(p) => { gem_pkt_park(i, GemPktHeld::TxPosted(p)); }
                    GemPktHeld::Unconfirmed(p) => { gem_pkt_park(i, GemPktHeld::Unconfirmed(p)); }
                    GemPktHeld::Kept(p) => { gem_pkt_park(i, GemPktHeld::Kept(p)); }
                }
            }
        }
    }
    return GEM_PKTS;
}
