// Bounded terminal echo operations, expanded one byte at a time by TX.
// The RX interrupt is the sole producer; the consumer is any CPU's transmit
// drain. Every push and drain holds the console lock, which masks IRQs;
// an unlocked terminal_echo_pending() is a hint that a locked path rechecks. Compact erasure operations keep a full canonical-line kill
// bounded without making the receive interrupt wait on a paused transmitter.
use "kernel/lib/execution_model.tkb";
use "kernel/drivers/serial/terminal_echo_ring.tkb";
use "kernel/printk/console_lock.tkb";

private region let mut terminal_echo_state: [TerminalEchoState; 1];
struct TerminalEchoStore {
    private state: Place(exists c: addr. exists c__off: usize.
                         region(TerminalEchoState)[c, 1])
                   guarded_by(console_tx_lock);
}
private let mut terminal_echo_store: TerminalEchoStore;

fn terminal_echo_reset(guard: borrow ConsoleGuard[&console_tx_lock]) {
    match place_borrow(guard, terminal_echo_store.state) {
        Place::Empty => {}
        Place::Full(states) => { terminal_echo_state_reset(region_at(states, 0)); }
    }
}

// The first push claims the storage: no boot step has to come first.
private fn terminal_echo_claim(guard: borrow ConsoleGuard[&console_tx_lock]) {
    static_assert(KERNEL_PREEMPTIBLE == 0,
        "terminal echo queue holders keep the console lock without preemption");
    if (place_is_full(guard, terminal_echo_store.state)) { return; }
    let RegionOf(TerminalEchoState)::Taken(claimed) = region_of(terminal_echo_state) else {
        RegionOf(TerminalEchoState)::Gone => { return; }
    };
    match place_put(guard, terminal_echo_store.state, claimed) {
        Place::Empty => {}
        Place::Full(previous) => { region_release(previous); }
    }
}

fn terminal_echo_push(guard: borrow ConsoleGuard[&console_tx_lock],
                      operation: TerminalEchoOperation) -> TerminalEchoPushResult {
    terminal_echo_claim(guard);
    let queued: bool = match place_borrow(guard, terminal_echo_store.state) {
        Place::Empty => { false }
        Place::Full(states) => {
            let mut stored: bool = true;
            match terminal_echo_state_push(region_at(states, 0), operation) {
                TerminalEchoPushResult::Queued => {}
                TerminalEchoPushResult::Full => { stored = false; }
            }
            stored
        }
    };
    if (queued) { return TerminalEchoPushResult::Queued; }
    return TerminalEchoPushResult::Full;
}

fn terminal_echo_read(guard: borrow ConsoleGuard[&console_tx_lock]) -> TerminalEchoReadResult {
    let outcome: (u8, bool) = match place_borrow(guard, terminal_echo_store.state) {
        Place::Empty => { (0, false) }
        Place::Full(states) => { terminal_echo_state_read(region_at(states, 0)) }
    };
    let (byte, found) = outcome;
    if (found == false) { return TerminalEchoReadResult::Empty; }
    return TerminalEchoReadResult::Byte(byte);
}
