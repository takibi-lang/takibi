// The bytes the UART has received that no process has taken yet.
//
// GitHub issue #543. This was a 64-byte ring in kernel/kernel/syscall.tkb,
// which holds 63, and a byte that arrived when it was full was dropped with
// nothing counting it. A 68-byte ash test line lost its newline that way:
// the shell waited for the end of a line that would never come, four QEMU
// lanes ran to their budget, and a person pasting a long command at the
// serial console would have met the same silence.
//
// The capacity is Linux's: n_tty buffers 4096 bytes of input, which is what
// BusyBox and anyone typing at it assume. A byte that still does not fit is
// counted rather than lost without trace, and the count is printed at the
// end of every boot, so a drop is a reported number rather than a stall.
//
// The UART RX interrupt appends and edits the unfinished canonical line;
// syscalls consume committed input and change its canonical interpretation.
// In the kernel the state is reached only through the process-run guard
// (terminal_state.tkb), which orders a byte between CPUs, because a terminal
// reader need not run on the CPU that takes the RX interrupt (GitHub issue
// #547).
//
// Kept free of logging, of locks and of process state, so
// linux_user/uart_rx_ring can compile this file itself and drive it past full:
// the caller hands in the indices and the three byte arrays. The queued-byte
// word stays atomic for DDB, which takes no lock; only a holder writes it.

use "kernel/lib/atomic_word.tkb";
const KERNEL_UART_RX_CAPACITY: usize = 4096;

must_use variant UartRxPushResult { Stored; Dropped; }
must_use variant UartRxReadResult { Byte((u8, bool)); EndFile; }
must_use variant UartRxEditResult { Empty; Erased((u8, usize)); }
struct UartRxLine {
    first: {0..<KERNEL_UART_RX_CAPACITY as usize};
    length: {0..<KERNEL_UART_RX_CAPACITY as usize};
}

struct UartRxState {
    head: usize;
    tail: usize;
    lines: usize;
    canonical: bool;
    line_columns: usize;
}
private let mut kernel_uart_rx_dropped: AtomicWord;
private let mut kernel_uart_rx_queued_word: AtomicWord;

private fn kernel_uart_rx_publish(state: borrow &mut UartRxState) {
    atomic_word_store(&kernel_uart_rx_queued_word, kernel_uart_rx_queued(state));
}

// DDB's reading: it takes no lock, and the world is stopped.
fn kernel_uart_rx_queued_hint() -> usize {
    return atomic_word_load(&kernel_uart_rx_queued_word);
}

// Empties the ring. The drop count is a boot total and survives this.
fn kernel_uart_rx_ring_reset(state: borrow &mut UartRxState) {
    state.head = 0;
    state.tail = 0;
    state.lines = 0;
    state.line_columns = 0;
    kernel_uart_rx_publish(state);
}

fn kernel_uart_rx_pending(state: borrow &mut UartRxState) -> bool {
    if (state.canonical) { return state.lines != 0; }
    return state.tail != state.head;
}

fn kernel_uart_rx_canonical_set(state: borrow &mut UartRxState,
        buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        columns_of: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        enabled: bool) {
    if (state.canonical == enabled) { return; }
    state.canonical = enabled;
    state.lines = 0;
    let tail: usize = state.tail;
    let queued: usize = kernel_uart_rx_queued(state);
    let mut kept: usize = 0;
    for offset: usize in 0..<KERNEL_UART_RX_CAPACITY {
        if (offset < queued) {
            let index: usize = (tail + offset) % KERNEL_UART_RX_CAPACITY;
            if (index < KERNEL_UART_RX_CAPACITY) {
                if (enabled == false) {
                    // EOF is line metadata, not a raw NUL byte. Compact
                    // toward the read side; no unread byte is overwritten.
                    if (marks[index] != 2) {
                        let target: usize = (tail + kept) % KERNEL_UART_RX_CAPACITY;
                        if (target < KERNEL_UART_RX_CAPACITY) {
                            buf[target] = buf[index];
                            marks[target] = 0;
                            columns_of[target] = 0;
                            kept = kept + 1;
                        }
                    }
                } else {
                if (marks[index] == 0 &&
                    buf[index] == 10) {
                    marks[index] = 1;
                }
                if (marks[index] != 0) {
                    state.lines = state.lines + 1;
                }
                }
            }
        }
    }
    if (enabled == false) {
        state.head = (tail + kept) % KERNEL_UART_RX_CAPACITY;
        state.line_columns = 0;
        kernel_uart_rx_publish(state);
    }
}

fn kernel_uart_rx_echo_column(state: borrow &mut UartRxState) -> usize { return state.line_columns; }

fn kernel_uart_rx_queued(state: borrow &mut UartRxState) -> usize {
    let head: usize = state.head;
    let tail: usize = state.tail;
    if (head >= tail) { return head - tail; }
    return KERNEL_UART_RX_CAPACITY - tail + head;
}

private fn kernel_uart_rx_count_drop() -> UartRxPushResult {
    atomic_word_fetch_add(&kernel_uart_rx_dropped, 1);
    return UartRxPushResult::Dropped;
}

fn kernel_uart_rx_push(state: borrow &mut UartRxState,
        buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        columns_of: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        c: u8) -> UartRxPushResult {
    return kernel_uart_rx_terminal_push(state, buf, marks, columns_of, c, 0, 0);
}

// A delimiter commits the preceding bytes. An EOF marker commits them too
// but is consumed without copying a byte into the reader's buffer.
fn kernel_uart_rx_terminal_push(state: borrow &mut UartRxState,
        buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        columns_of: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        c: u8, mark: {0..<3 as u8},
                                columns: {0..<9 as u8}) -> UartRxPushResult {
    // Reserve a slot for the newline or EOF that makes a full canonical
    // line readable, even if its sender ignores input flow control.
    if (state.canonical && mark == 0 &&
        kernel_uart_rx_queued(state) >= KERNEL_UART_RX_CAPACITY - 2) {
        return kernel_uart_rx_count_drop();
    }
    let head: usize = state.head;
    if (head >= KERNEL_UART_RX_CAPACITY) {
        return kernel_uart_rx_count_drop();
    }
    let next: usize = (head + 1) % KERNEL_UART_RX_CAPACITY;
    if (next == state.tail) {
        return kernel_uart_rx_count_drop();
    }
    buf[head] = c;
    marks[head] = mark;
    columns_of[head] = columns;
    if (mark != 0) { state.lines = state.lines + 1; }
    if (mark != 0) { state.line_columns = 0; }
    else { state.line_columns = state.line_columns + (columns as usize); }
    state.head = next;
    kernel_uart_rx_publish(state);
    return UartRxPushResult::Stored;
}

// The caller has asked kernel_uart_rx_pending() first, under the lock.
fn kernel_uart_rx_read(state: borrow &mut UartRxState,
        buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..]) -> UartRxReadResult {
    let tail: usize = state.tail;
    if (tail >= KERNEL_UART_RX_CAPACITY) {
        state.tail = 0;
        return UartRxReadResult::EndFile;
    }
    let c: u8 = buf[tail];
    let mark: u8 = marks[tail];
    if (mark != 0 && state.lines != 0) {
        state.lines = state.lines - 1;
    }
    state.tail = (tail + 1) % KERNEL_UART_RX_CAPACITY;
    kernel_uart_rx_publish(state);
    if (mark == 2) { return UartRxReadResult::EndFile; }
    return UartRxReadResult::Byte((c, state.canonical && mark == 1));
}

// Editing cannot cross a committed line or remove bytes a reader took.
fn kernel_uart_rx_erase(state: borrow &mut UartRxState,
        buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        columns_of: borrow [u8; KERNEL_UART_RX_CAPACITY..]) -> UartRxEditResult {
    let head: usize = state.head;
    if (head == state.tail || head >= KERNEL_UART_RX_CAPACITY) {
        return UartRxEditResult::Empty;
    }
    let last: usize = (head + KERNEL_UART_RX_CAPACITY - 1) % KERNEL_UART_RX_CAPACITY;
    if (last < KERNEL_UART_RX_CAPACITY) {
        if (marks[last] != 0) { return UartRxEditResult::Empty; }
        let value: u8 = buf[last];
        let columns: usize = columns_of[last] as usize;
        buf[last] = 0;
        columns_of[last] = 0;
        if (state.line_columns >= columns) {
            state.line_columns = state.line_columns - columns;
        }
        state.head = last;
        kernel_uart_rx_publish(state);
        return UartRxEditResult::Erased((value, columns));
    }
    return UartRxEditResult::Empty;
}

fn kernel_uart_rx_peek_last(state: borrow &mut UartRxState,
        buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        columns_of: borrow [u8; KERNEL_UART_RX_CAPACITY..]) -> UartRxEditResult {
    let head: usize = state.head;
    if (head == state.tail || head >= KERNEL_UART_RX_CAPACITY) {
        return UartRxEditResult::Empty;
    }
    let last: usize = (head + KERNEL_UART_RX_CAPACITY - 1) % KERNEL_UART_RX_CAPACITY;
    if (last < KERNEL_UART_RX_CAPACITY) {
        if (marks[last] != 0) { return UartRxEditResult::Empty; }
        return UartRxEditResult::Erased((buf[last],
                                         columns_of[last] as usize));
    }
    return UartRxEditResult::Empty;
}

fn kernel_uart_rx_unfinished_length(state: borrow &mut UartRxState,
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..]) -> usize {
    let head: usize = state.head;
    let queued: usize = kernel_uart_rx_queued(state);
    let mut length: usize = 0;
    let mut walking: bool = true;
    for offset: usize in 0..<KERNEL_UART_RX_CAPACITY {
        if (walking && offset < queued) {
            let last: usize = (head + KERNEL_UART_RX_CAPACITY - 1 - offset) %
                              KERNEL_UART_RX_CAPACITY;
            if (last < KERNEL_UART_RX_CAPACITY) {
                if (marks[last] != 0) { walking = false; }
                else { length = length + 1; }
            }
        }
    }
    return length;
}

fn kernel_uart_rx_unfinished_snapshot(state: borrow &mut UartRxState,
        marks: borrow [u8; KERNEL_UART_RX_CAPACITY..]) -> UartRxLine {
    let length: usize = kernel_uart_rx_unfinished_length(state, marks);
    let first: usize = (state.head + KERNEL_UART_RX_CAPACITY - length)
                      % KERNEL_UART_RX_CAPACITY;
    if (first < KERNEL_UART_RX_CAPACITY && length < KERNEL_UART_RX_CAPACITY) {
        let mut line: UartRxLine = { first, length };
        return line;
    }
    let mut empty: UartRxLine = { 0, 0 };
    return empty;
}

fn kernel_uart_rx_unfinished_byte(buf: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        line: UartRxLine, offset: usize) -> UartRxReadResult {
    if (offset >= line.length) { return UartRxReadResult::EndFile; }
    let index: usize = (line.first + offset) % KERNEL_UART_RX_CAPACITY;
    if (index < KERNEL_UART_RX_CAPACITY) {
        return UartRxReadResult::Byte((buf[index], false));
    }
    return UartRxReadResult::EndFile;
}

fn kernel_uart_rx_dropped_count() -> usize {
    return atomic_word_load(&kernel_uart_rx_dropped);
}

// Reprinting starts at a new display column, so tab erasure widths change.
fn kernel_uart_rx_reprint_width(state: borrow &mut UartRxState,
        columns_of: borrow [u8; KERNEL_UART_RX_CAPACITY..],
        line: UartRxLine, offset: usize,
                                width: {0..<9 as u8}) {
    if (offset >= line.length) { return; }
    let index: usize = (line.first + offset) % KERNEL_UART_RX_CAPACITY;
    if (index < KERNEL_UART_RX_CAPACITY) {
        let previous: usize = columns_of[index] as usize;
        if (state.line_columns >= previous) {
            state.line_columns = state.line_columns - previous;
        }
        columns_of[index] = width;
        state.line_columns = state.line_columns + (width as usize);
    }
}
