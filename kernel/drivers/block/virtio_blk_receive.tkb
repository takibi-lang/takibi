// GitHub issue #716: the mint file of the virtio-blk receive allocation.
// dma_finish_owned_rx is accepted only in the file that declares the
// record, so this file is the whole trusted claim that device ownership
// may return to the CPU. It returns ownership after one of two
// observations, and nowhere else:
//   - virtio_blk_receive_settle_used: the device advanced the used ring
//     past the driver's shadow, so it has written the request's data and
//     status (virtio 1.x, 2.7.8);
//   - virtio_blk_receive_settle_reset: the status register read back zero
//     after a reset, so the device no longer touches the queue (virtio
//     1.x, 2.1).
// Every other function here only moves the tokens between the owner slot
// and its callers. Keep anything else out of this file.

use "kernel/lib/mutex.tkb";

// The descriptor still exposes one status byte at offset 1024.
struct dma_fixed VirtioBlkReceive { private bytes: [u8; 1088]; }
private let mut virtio_blk_receive: VirtioBlkReceive align(64);

private linear struct VirtioBlkReceiveGuard[lock: addr] {
    private flags: usize;
}

private fn virtio_blk_receive_lock(lock: *Mutex @ address)
        -> VirtioBlkReceiveGuard[address]
        !{acquires_lock_40_virtio_blk_receive,
          lock_guard_40_virtio_blk_receive} {
    let mut guard: VirtioBlkReceiveGuard[address] = { mutex_acquire(lock) };
    return guard;
}

private fn virtio_blk_receive_unlock(
        guard: sink VirtioBlkReceiveGuard[address],
        lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

fn virtio_blk_receive_take() -> VirtioBlkReceiveAuthority {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkReceive.mutex);
    let previous: VirtioBlkReceiveAuthority = stable_replace(
        guard, &dma_owner_VirtioBlkReceive.mutex,
        dma_owner_VirtioBlkReceive.value,
        VirtioBlkReceiveAuthority::Empty);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkReceive.mutex);
    return previous;
}

private fn virtio_blk_receive_fail_cpu(stale: sink *VirtioBlkReceiveCpu) {
    kernel_syscall_fail_stop(0);
}

fn virtio_blk_receive_fail_device(stale: sink *VirtioBlkReceiveDevice) {
    kernel_syscall_fail_stop(0);
}

fn virtio_blk_receive_put(value: sink VirtioBlkReceiveAuthority) {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkReceive.mutex);
    let previous: VirtioBlkReceiveAuthority = stable_replace(
        guard, &dma_owner_VirtioBlkReceive.mutex,
        dma_owner_VirtioBlkReceive.value, value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkReceive.mutex);
    match previous {
        VirtioBlkReceiveAuthority::Empty => { return; }
        VirtioBlkReceiveAuthority::Cpu(stale) => {
            virtio_blk_receive_fail_cpu(stale);
        }
        VirtioBlkReceiveAuthority::Device(stale) => {
            virtio_blk_receive_fail_device(stale);
        }
    }
}

// The device has not yet published a used entry beyond the driver's shadow.
fn virtio_blk_used_pending() -> bool !{unsafe} {
    let queue: *u8 = virtio_blk_queue as *u8;
    return virtio_blk_used_seen == unsafe { ((queue + (VIRTIO_BLK_PAGE_SIZE as isize))
                                    as *io VirtioBlkUsed) }.idx;
}

fn virtio_blk_reset() -> bool !{unsafe} {
    virtio_blk_ready = false;
    *(virtio_blk_reg(VIRTIO_BLK_STATUS)) = 0;
    // A zero readback is the virtio reset completion point: the device must
    // stop interacting with the queue before it reports that status.
    let reset_start: i64 = read_cntpct();
    let reset_ticks: i64 = read_cntfrq() * VIRTIO_BLK_COMPLETION_SECONDS;
    while (read_cntpct() - reset_start < reset_ticks &&
           *(virtio_blk_reg(VIRTIO_BLK_STATUS)) != 0) {
    }
    if (*(virtio_blk_reg(VIRTIO_BLK_STATUS)) != 0) {
        virtio_blk_disabled = true;
        return false;
    }
    return true;
}

must_use variant VirtioBlkReceiveUsed {
    Observed;
    Pending(*VirtioBlkReceiveDevice);
}

// Observed puts the CPU token back in the owner slot; Pending hands the
// device token back unchanged for the reset path.
fn virtio_blk_receive_settle_used(device: sink *VirtioBlkReceiveDevice)
        -> VirtioBlkReceiveUsed !{unsafe} {
    if (virtio_blk_used_pending()) {
        return VirtioBlkReceiveUsed::Pending(device);
    }
    dma_consume();
    virtio_blk_used_seen = virtio_ring_index_next(virtio_blk_used_seen);
    let restored = dma_finish_owned_rx(device, VirtioBlkReceive);
    virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored));
    return VirtioBlkReceiveUsed::Observed;
}

// A failed reset keeps the device token in the slot, so the range is never
// reused in this boot.
fn virtio_blk_receive_settle_reset(device: sink *VirtioBlkReceiveDevice)
        -> bool !{unsafe} {
    if (virtio_blk_reset() == false) {
        virtio_blk_receive_put(VirtioBlkReceiveAuthority::Device(device));
        return false;
    }
    let restored = dma_finish_owned_rx(device, VirtioBlkReceive);
    virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored));
    return true;
}
