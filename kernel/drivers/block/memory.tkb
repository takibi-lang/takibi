use "kernel/drivers/block/block_cache.tkb";

const KERNEL_BLOCK_SIZE: usize = 1024;
// 64 1 KiB filesystem blocks = 128 USB sectors = 64 KiB. This is the
// largest contiguous rootfs batch validated on the RPi5 device; larger
// 192/256-sector commands stalled during provisioning.
const KERNEL_BLOCK_BATCH: usize = 64;

// The fixture's extent: kernel/build/user/ext2.img's real size, fixed by its
// own build recipe's `truncate -s 2621440`. The USB device exposes exactly
// this much of the medium, and kernel/platform/rpi5/usb_provision.tkb embeds
// the image it writes there.
const KERNEL_EXT2_IMAGE_LEN: usize = 2621440;

struct KernelBlockDevice {
    // 1 = USB Mass Storage, 2 = QEMU virtio-blk. There is no memory backend:
    // 0 was the embedded image, which the board ran every process from while
    // the USB copy sat mounted for a few checks, so it was removed rather
    // than guarded. Nothing can hand ext2_mount the image now.
    // Kept as a private
    // representation byte because the current backend rejects matching an
    // enum stored in a struct field when lowering LLVM IR.
    private backend: u8;
    private length: usize;
}

must_use variant KernelBlockDeviceResult {
    Invalid;
    Ready(KernelBlockDevice);
}

must_use variant BlockIoResult { Invalid; Ok; }

fn usb_mass_storage_block_device() -> KernelBlockDeviceResult {
    match disk_status() {
        DiskIoResult::Err(error) => {
            return KernelBlockDeviceResult::Invalid;
        }

        DiskIoResult::Ok => { }
    }
    // Deliberately expose only the fixture's 2.5 MiB extent. This bounds every
    // destructive write far below the real medium's capacity until
    // partition/device ownership policy exists.
    let mut device: KernelBlockDevice = { 1, KERNEL_EXT2_IMAGE_LEN };
    return KernelBlockDeviceResult::Ready(device);
}

fn virtio_block_device_ext2() -> KernelBlockDeviceResult {
    let sectors: usize = virtio_blk_capacity_sectors();
    if (sectors == 0 || sectors % 2 != 0) {
        return KernelBlockDeviceResult::Invalid;
    }
    let mut device: KernelBlockDevice = { 2, sectors * 512 };
    return KernelBlockDeviceResult::Ready(device);
}

// GitHub issues #281 and #208: what the block layer was actually asked for
// over a boot.
//
// Both propose making ext2's I/O cheaper -- one by coalescing contiguous runs
// into multi-sector transfers, the other by caching blocks -- and neither can
// be ordered against the other without knowing where the reads go. The
// profiler counts `block_read_bytes` already, but only inside the busy-pair
// interval, which does no block I/O at all: the number is 0 on every boot and
// has been for as long as it has existed.
//
// So these are boot totals, printed once at the end beside the console spin
// figure, for the same reason that one is: a number in a diff rather than a
// number in somebody's memory.
// Per core, summed when reported. This file's execution-model exemption reads
// "device state; SPIs are routed to CPU0", which is about interrupt delivery
// -- but block_read is reached from a syscall, and a syscall runs on core 1
// too, so one shared counter would lose increments to a race and understate
// the very diff #208 is to be judged by.
//
// Per-core storage rather than an atomic: scripts/check_lock_discipline.py
// refused the atomic and was right to. A raw intrinsic for a diagnostic
// counter is a trusted-base entry bought to avoid arithmetic, and the
// profiler beside it already counts this way.
private let mut block_read_calls: [usize; KERNEL_MAX_CORES];
private let mut block_write_calls: [usize; KERNEL_MAX_CORES];

private fn block_call_total(counters: borrow [usize; KERNEL_MAX_CORES..])
        -> usize {
    let mut total: usize = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        total = total + counters[cpu];
    }
    return total;
}

private fn block_note_call(counters: borrow [usize; KERNEL_MAX_CORES..]) {
    let raw_cpu: usize = cpu_id();
    if (raw_cpu >= KERNEL_MAX_CORES) { return; }
    let cpu: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    counters[cpu] = counters[cpu] + 1;
}

fn block_read_call_total() -> usize {
    return block_call_total(block_read_calls as []usize);
}
fn block_write_call_total() -> usize {
    return block_call_total(block_write_calls as []usize);
}

// GitHub issue #208: block_read and block_write go through the per-core
// read cache in kernel/drivers/block/block_cache.tkb. `block io: reads=`
// counts what reached a device, so the figure #208 is judged by moves with
// the cache; the hits are counted beside it.
fn block_read(device: KernelBlockDevice, block: usize,
              destination: [u8; KERNEL_BLOCK_SIZE..])
        -> BlockIoResult !{unsafe} {
    if (block >= device.length / KERNEL_BLOCK_SIZE) {
        return BlockIoResult::Invalid;
    }
    let core: usize = cpu_id();
    match block_cache_read(core, device.backend, block, destination) {
        BlockCacheReadResult::Hit => { return BlockIoResult::Ok; }
        BlockCacheReadResult::Miss => { }
    }
    if (block_run_take(core, device, block, destination)) {
        block_cache_fill(core, device.backend, block, destination);
        return BlockIoResult::Ok;
    }
    // A run that was read and then cannot answer -- another core wrote in
    // between and moved the epoch -- falls through to the single read.
    if (block_run_wanted(core, device, block)) {
        if (block_run_read(core, device, block)) {
            if (block_run_take(core, device, block, destination)) {
                block_cache_fill(core, device.backend, block, destination);
                return BlockIoResult::Ok;
            }
        }
    }
    match block_read_device(device, block, destination) {
        BlockIoResult::Invalid => { return BlockIoResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    block_run_note_single(core, device, block);
    block_cache_fill(core, device.backend, block, destination);
    return BlockIoResult::Ok;
}

// GitHub issue #545: read-ahead for sequential device reads.
//
// Every device read used to be one 1 KiB block, which on the USB stick is
// a SCSI command of its own -- two, before this change, one per sector --
// and a command costs about 0.7 ms however little it moves. The board's
// first boot from USB spent some 51 s more than it had from RAM, over
// 37,461 device reads: 1.36 ms a block. Nearly all of them were an exec
// streaming BusyBox a page at a time, block after physically contiguous
// block, while ext2's metadata re-reads already came from the cache.
//
// So a device read that continues where this core's last one ended reads a
// run instead: BLOCK_RUN_BLOCKS blocks in one command on USB, kept per core
// and handed out a block at a time until something else is asked for. A
// read that does not continue the last one still reads one block, so a
// scattered read pays nothing for this. The run belongs to the block
// cache's write epoch: any write on any core, including the provisioning
// writes that go around block_write, retires it the way it retires every
// cached block. QEMU fills the same run sector by sector, which buys it
// nothing but runs the same bookkeeping, and the invalidation, on every
// QEMU lane.
const BLOCK_RUN_BLOCKS: usize = KERNEL_BLOCK_BATCH;

private let mut block_run_data:
    [u8; KERNEL_MAX_CORES * BLOCK_RUN_BLOCKS * KERNEL_BLOCK_SIZE];
private let mut block_run_backend: [u8; KERNEL_MAX_CORES];
private let mut block_run_first: [usize; KERNEL_MAX_CORES];
private let mut block_run_count: [usize; KERNEL_MAX_CORES];
private let mut block_run_epoch: [usize; KERNEL_MAX_CORES];
// The block after this core's last device read, and its backend: a miss
// on that block is a sequential read.
private let mut block_run_next: [usize; KERNEL_MAX_CORES];
private let mut block_run_next_backend: [u8; KERNEL_MAX_CORES];
private let mut block_run_reads: [usize; KERNEL_MAX_CORES];
private let mut block_run_hits: [usize; KERNEL_MAX_CORES];

// Whether this core's run holds (device, block) at the current epoch.
private fn block_run_hit_here(core: usize, device: KernelBlockDevice,
                              block: usize) -> bool {
    if (core >= KERNEL_MAX_CORES) { return false; }
    let here: {0..<KERNEL_MAX_CORES as usize} = core;
    let first: usize = block_run_first[here];
    return block_run_count[here] != 0 &&
           block_run_backend[here] == device.backend &&
           block_run_epoch[here] == block_cache_epoch_now() &&
           block >= first && block - first < block_run_count[here];
}

// Copy (device, block) out of this core's run, if it holds it.
private fn block_run_take(core: usize, device: KernelBlockDevice,
                          block: usize,
                          destination: [u8; KERNEL_BLOCK_SIZE..]) -> bool {
    if (block_run_hit_here(core, device, block) == false) { return false; }
    if (core >= KERNEL_MAX_CORES) { return false; }
    let here: {0..<KERNEL_MAX_CORES as usize} = core;
    let offset: usize = block - block_run_first[here];
    if (offset >= BLOCK_RUN_BLOCKS) { return false; }
    let within: {0..<BLOCK_RUN_BLOCKS as usize} = offset;
    let slot: {0..<KERNEL_MAX_CORES * BLOCK_RUN_BLOCKS as usize} =
        here * BLOCK_RUN_BLOCKS + within;
    let base: usize = slot * KERNEL_BLOCK_SIZE;
    slice_copy(destination[0..<KERNEL_BLOCK_SIZE],
               block_run_data[base..<base + KERNEL_BLOCK_SIZE]);
    block_run_hits[here] = block_run_hits[here] + 1;
    return true;
}

private fn block_run_wanted(core: usize, device: KernelBlockDevice,
                            block: usize) -> bool {
    if (core >= KERNEL_MAX_CORES) { return false; }
    let here: {0..<KERNEL_MAX_CORES as usize} = core;
    return block_run_next[here] == block &&
           block_run_next_backend[here] == device.backend;
}

private fn block_run_note_single(core: usize, device: KernelBlockDevice,
                                 block: usize) {
    if (core >= KERNEL_MAX_CORES) { return; }
    let here: {0..<KERNEL_MAX_CORES as usize} = core;
    block_run_next[here] = block + 1;
    block_run_next_backend[here] = device.backend;
}

// Read the run starting at `first` into this core's buffer. False leaves
// no run behind, and the caller reads the one block it wanted instead.
private fn block_run_read(core: usize, device: KernelBlockDevice,
                          first: usize) -> bool !{unsafe} {
    if (core >= KERNEL_MAX_CORES) { return false; }
    let here: {0..<KERNEL_MAX_CORES as usize} = core;
    let available: usize = block_count(device);
    if (first >= available) { return false; }
    let mut count: usize = available - first;
    if (count > BLOCK_RUN_BLOCKS) { count = BLOCK_RUN_BLOCKS; }
    // The epoch is taken before the device is, so a write that lands while
    // the run is being read retires it.
    block_run_count[here] = 0;
    let epoch: usize = block_cache_epoch_now();
    if (device.backend == 1) {
        let target: *u8 = (block_run_data as *u8) +
            ((here * BLOCK_RUN_BLOCKS * KERNEL_BLOCK_SIZE) as isize);
        match disk_read_sectors((first * 2) as u32, target, count * 2) {
            DiskIoResult::Err(error) => { return false; }
            DiskIoResult::Ok => { }
        }
    } else {
        for offset: usize in 0..<BLOCK_RUN_BLOCKS {
            if (offset < count) {
                // Counted in 512-byte sectors, two to a block, so each
                // half is an index the compiler can bound.
                let low: {0..<KERNEL_MAX_CORES * BLOCK_RUN_BLOCKS * 2 as usize} =
                    (here * BLOCK_RUN_BLOCKS + offset) * 2;
                let high: {0..<KERNEL_MAX_CORES * BLOCK_RUN_BLOCKS * 2 as usize} =
                    (here * BLOCK_RUN_BLOCKS + offset) * 2 + 1;
                let low_base: usize = low * 512;
                let high_base: usize = high * 512;
                let sector: u32 = ((first + offset) * 2) as u32;
                if (virtio_blk_read_sector(
                        sector, block_run_data[low_base..<low_base + 512]) == false ||
                    virtio_blk_read_sector(
                        sector + 1,
                        block_run_data[high_base..<high_base + 512]) == false) {
                    return false;
                }
            }
        }
    }
    for offset: usize in 0..<BLOCK_RUN_BLOCKS {
        if (offset < count) {
            block_note_call(block_read_calls as []usize);
        }
    }
    workload_profile_note_block_read(count * KERNEL_BLOCK_SIZE);
    block_run_backend[here] = device.backend;
    block_run_first[here] = first;
    block_run_epoch[here] = epoch;
    block_run_count[here] = count;
    block_run_next[here] = first + count;
    block_run_next_backend[here] = device.backend;
    block_run_reads[here] = block_run_reads[here] + 1;
    return true;
}

fn block_run_read_total() -> usize {
    return block_call_total(block_run_reads as []usize);
}

fn block_run_hit_total() -> usize {
    return block_call_total(block_run_hits as []usize);
}

fn block_write(device: KernelBlockDevice, block: usize,
               source: [u8; KERNEL_BLOCK_SIZE..])
        -> BlockIoResult !{unsafe} {
    if (block >= device.length / KERNEL_BLOCK_SIZE) {
        return BlockIoResult::Invalid;
    }
    let core: usize = cpu_id();
    match block_write_device(device, block, source) {
        BlockIoResult::Invalid => {
            block_cache_note_write(core, device.backend, block, source, false);
            return BlockIoResult::Invalid;
        }
        BlockIoResult::Ok => {
            block_cache_note_write(core, device.backend, block, source, true);
            return BlockIoResult::Ok;
        }
    }
}

private fn block_read_device(device: KernelBlockDevice, block: usize,
                             destination: [u8; KERNEL_BLOCK_SIZE..])
        -> BlockIoResult !{unsafe} {
    if (block >= device.length / KERNEL_BLOCK_SIZE) {
        return BlockIoResult::Invalid;
    }
    block_note_call(block_read_calls as []usize);
    workload_profile_note_block_read(KERNEL_BLOCK_SIZE);
    if (device.backend == 1) {
        // Both sectors of the block in one READ(10): a command costs the
        // same however few sectors it moves (GitHub issue #545).
        let target: *u8 = destination as *u8;
        match disk_read_sectors((block * 2) as u32, target, 2) {
            DiskIoResult::Err(error) => { return BlockIoResult::Invalid; }
            DiskIoResult::Ok => { return BlockIoResult::Ok; }
        }
    } else {
        let first_sector = destination[0..<512];
        let second_sector = destination[512..<KERNEL_BLOCK_SIZE];
        if (virtio_blk_read_sector((block * 2) as u32, first_sector) == false ||
            virtio_blk_read_sector((block * 2 + 1) as u32, second_sector) == false) {
            return BlockIoResult::Invalid;
        }
        return BlockIoResult::Ok;
    }
}

private fn block_write_device(device: KernelBlockDevice, block: usize,
                              source: [u8; KERNEL_BLOCK_SIZE..])
        -> BlockIoResult !{unsafe} {
    if (block >= device.length / KERNEL_BLOCK_SIZE) {
        return BlockIoResult::Invalid;
    }
    block_note_call(block_write_calls as []usize);
    workload_profile_note_block_write(KERNEL_BLOCK_SIZE);
    if (device.backend == 1) {
        let sector: u32 = (block * 2) as u32;
        let bytes: *u8 = source as *u8;
        match disk_write(sector, bytes) {
            DiskIoResult::Err(error) => { return BlockIoResult::Invalid; }
            DiskIoResult::Ok => { }
        }
        match disk_write(sector + 1, bytes + 512) {
            DiskIoResult::Err(error) => { return BlockIoResult::Invalid; }
            DiskIoResult::Ok => { return BlockIoResult::Ok; }
        }
    } else {
        let first_sector = source[0..<512];
        let second_sector = source[512..<KERNEL_BLOCK_SIZE];
        if (virtio_blk_write_sector((block * 2) as u32, first_sector) == false ||
            virtio_blk_write_sector((block * 2 + 1) as u32, second_sector) == false) {
            return BlockIoResult::Invalid;
        }
        return BlockIoResult::Ok;
    }
}

fn block_count(device: KernelBlockDevice) -> usize {
    return device.length / KERNEL_BLOCK_SIZE;
}

fn block_device_is_virtio(device: KernelBlockDevice) -> bool {
    return device.backend == 2;
}

fn block_device_is_usb(device: KernelBlockDevice) -> bool {
    return device.backend == 1;
}

// GitHub issue #208: the cache keeps one set of slots per core, indexed by
// the cpu_id() block_read and block_write pass it, and one slot holds one
// block. And a core must not enter block_read again before its first call
// returns, which is what a non-preemptible kernel guarantees.
fn block_cache_execution_model_assumption() {
    static_assert(BLOCK_CACHE_CORES == KERNEL_MAX_CORES,
                  "block_cache.tkb keeps one set of slots per core");
    static_assert(BLOCK_CACHE_BYTES == KERNEL_BLOCK_SIZE,
                  "a block cache slot holds exactly one block");
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "per-core cache slots cannot survive preemption into another block_read on the same core");
}
