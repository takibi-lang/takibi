// The block layer's slot pool token (GitHub issue #638), in a file of its
// own so that block_cache.tkb can declare its sets owned_by(BlockSlot.index,
// ...) (GitHub issue #1159) and linux_user/block_cache can hold real slots.
//
// A slot is reached only through a BlockSlot, a linear token:
// block_slot_acquire_from hands out a free slot, and
// block_slot_release consumes the token, so the compiler rejects an
// operation that forgets to release it, releases it twice, or keeps using
// it after the release. block_slot_acquire_from waits for a free one;
// memory.tkb's block_slot_acquire calls it with the current CPU as the hint.
//
// Trusted here, and only here (TRUSTED_BASE.md): no two live BlockSlots
// carry the same index. The compare-exchange over block_slot_words is what
// makes that so; nothing checks it. The index is private, so only this file
// mints a BlockSlot.

use "kernel/lib/atomic_word.tkb";
use "kernel/lib/slot_pool_wait.tkb";

private let mut block_slot_words: [AtomicWord; KERNEL_MAX_CORES];

// `[unit]` is always 0: an owner needs a static parameter, and the slot's
// identity is its private index.
linear struct BlockSlot[unit: usize] {
    private index: {0..<KERNEL_MAX_CORES as usize};
}

// A free slot, trying `hint` first and waiting if every slot is held. A
// hint keeps a CPU's operations on one slot while KERNEL_PREEMPTIBLE is 0
// (memory.tkb); it is not trusted for exclusivity, the compare-exchange is.
fn block_slot_acquire_from(hint: usize) -> BlockSlot[0] !{may_block} {
    let mut index: {0..<KERNEL_MAX_CORES as usize} = 0;
    let mut held: bool = false;
    if (hint < KERNEL_MAX_CORES) {
        let preferred: {0..<KERNEL_MAX_CORES as usize} = hint;
        if (atomic_word_compare_exchange(&block_slot_words[preferred], 0, 1)) {
            index = preferred;
            held = true;
        }
    }
    let mut waited: bool = false;
    while (held == false) {
        for i: usize in 0..<KERNEL_MAX_CORES {
            if (held == false &&
                atomic_word_compare_exchange(&block_slot_words[i], 0, 1)) {
                index = i;
                held = true;
            }
        }
        // Every slot is held: retry. An unmasked spin, so the tick can switch
        // to a holder this core preempted (kernel/CONCURRENCY.md, slot pools).
        if (held == false && waited == false) {
            slot_pool_wait_note(SlotPoolWaitPool::Block);
            waited = true;
        }
    }
    let mut slot: BlockSlot[0] = { index };
    return slot;
}

fn block_slot_release(slot: sink BlockSlot[0]) {
    atomic_word_store(&block_slot_words[slot.index], 0);
}

// The slot's number, for state that is indexed by it but not owned by it:
// atomic counters and the device guard. A number grants no element of an
// owned_by global; only the token does.
fn block_slot_number(slot: borrow BlockSlot[0]) -> {0..<KERNEL_MAX_CORES as usize} {
    return slot.index;
}
