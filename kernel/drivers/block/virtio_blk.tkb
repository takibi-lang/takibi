// QEMU virtio-blk legacy MMIO backend. The transport base is selected from
// the boot DTB before this driver runs. The queue deliberately follows the
// descriptor/avail/used layout used by kernel/drivers/net/virtio_net.tkb.

use "kernel/drivers/virtio_ring.tkb";
use "kernel/lib/mutex.tkb";

const VIRTIO_BLK_GUEST_FEATURES: i32 = 0x20;
const VIRTIO_BLK_GUEST_PAGE_SIZE: i32 = 0x28;
const VIRTIO_BLK_QUEUE_SEL: i32 = 0x30;
const VIRTIO_BLK_QUEUE_NUM: i32 = 0x38;
const VIRTIO_BLK_QUEUE_ALIGN: i32 = 0x3c;
const VIRTIO_BLK_QUEUE_PFN: i32 = 0x40;
const VIRTIO_BLK_QUEUE_NOTIFY: i32 = 0x50;
const VIRTIO_BLK_STATUS: i32 = 0x70;
const VIRTIO_BLK_INTERRUPT_STATUS: i32 = 0x60;
const VIRTIO_BLK_PAGE_SIZE: usize = 4096;
const VIRTIO_QNUM: isize = 8;
const VIRTIO_BLK_DESC_F_NEXT: i32 = 1;
const VIRTIO_BLK_DESC_F_WRITE: i32 = 2;
const VIRTIO_BLK_T_IN: u32 = 0;
const VIRTIO_BLK_T_OUT: u32 = 1;
// GitHub issue #527: this must be elapsed architectural time, not a number of
// guest instructions. QEMU services the queue on a host thread whose progress
// is independent of how quickly the vCPU executes this polling loop.
//
const VIRTIO_BLK_COMPLETION_SECONDS: i64 = 1;

struct packed VirtioBlkDesc {
    addr: usize;
    len: u32;
    flags: u16;
    next: u16;
}
struct packed VirtioBlkAvail {
    flags: u16;
    idx: VirtioRingIndex;
    ring: [u16; VIRTIO_QNUM];
}
struct packed VirtioBlkUsedElem {
    id: u32;
    len: u32;
}
struct packed VirtioBlkUsed {
    flags: u16;
    idx: VirtioRingIndex;
    ring: [VirtioBlkUsedElem; VIRTIO_QNUM];
}
struct packed VirtioBlkRequest {
    request_type: u32;
    reserved: u32;
    sector: u64;
}

let mut virtio_blk_base: i32 = 0;
let mut virtio_blk_ready: bool;
// A reset that never completes leaves the submitted RX ranges device-owned.
// Do not reinitialize the queue or reuse those buffers in that case.
let mut virtio_blk_disabled: bool;
let mut virtio_blk_queue: [u8; 2 * VIRTIO_BLK_PAGE_SIZE] align(4096);
// TX data uses its own scratch block. RX data and the one-byte status occupy
// separate cache lines in one protected allocation. The block-device TaskMutex
// serializes whole commands; the slot's Mutex protects only token exchange.
//
// One request carries a whole 1 KiB block (two sectors), as the USB backend's
// one WRITE(10) per block does (#281). Per sector, a boot made about 440,000
// synchronous requests, and on a loaded host their waits summed past the
// lane's 70 s silence watchdog (2026-10-04).
const VIRTIO_BLK_TRANSFER_BYTES: usize = 1024;
let mut virtio_blk_data_buf: [u8; 1024] align(64);
let mut virtio_blk_request_buf: [u8; 16] align(64);
// The descriptor still exposes one status byte at offset 1024.
struct dma_fixed VirtioBlkReceive { private bytes: [u8; 1088]; }
private let mut virtio_blk_receive: VirtioBlkReceive align(64);

private linear struct VirtioBlkReceiveGuard[lock: addr] {
    private flags: usize;
}

private fn virtio_blk_receive_lock(lock: *Mutex @ address)
        -> VirtioBlkReceiveGuard[address]
        !{acquires_lock_40_virtio_blk_receive,
          lock_guard_40_virtio_blk_receive} {
    let mut guard: VirtioBlkReceiveGuard[address] = { mutex_acquire(lock) };
    return guard;
}

private fn virtio_blk_receive_unlock(
        guard: sink VirtioBlkReceiveGuard[address],
        lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

private fn virtio_blk_receive_take() -> VirtioBlkReceiveAuthority {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkReceive.mutex);
    let previous: VirtioBlkReceiveAuthority = stable_replace(
        guard, &dma_owner_VirtioBlkReceive.mutex,
        dma_owner_VirtioBlkReceive.value,
        VirtioBlkReceiveAuthority::Empty);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkReceive.mutex);
    return previous;
}

private fn virtio_blk_receive_fail_cpu(stale: sink *VirtioBlkReceiveCpu) {
    kernel_syscall_fail_stop(0);
}

private fn virtio_blk_receive_fail_device(stale: sink *VirtioBlkReceiveDevice) {
    kernel_syscall_fail_stop(0);
}

private fn virtio_blk_receive_put(value: sink VirtioBlkReceiveAuthority) {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkReceive.mutex);
    let previous: VirtioBlkReceiveAuthority = stable_replace(
        guard, &dma_owner_VirtioBlkReceive.mutex,
        dma_owner_VirtioBlkReceive.value, value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkReceive.mutex);
    match previous {
        VirtioBlkReceiveAuthority::Empty => { return; }
        VirtioBlkReceiveAuthority::Cpu(stale) => {
            virtio_blk_receive_fail_cpu(stale);
        }
        VirtioBlkReceiveAuthority::Device(stale) => {
            virtio_blk_receive_fail_device(stale);
        }
    }
}
// Virtio's avail/used idx fields are free-running u16 counters. The nominal
// domain keeps the driver shadow at that width and makes comparison with a
// widened counter a type error before the mandatory 65535 -> 0 wrap.
let mut virtio_blk_used_seen: VirtioRingIndex;

// What the queue looked like when a completion wait ran out, for DDB: the
// count, and the first and latest timeout's avail.idx, used.idx, the
// driver's used_seen, the status and interrupt-status registers, and
// whether used.idx had moved by the time the reset began (a completion that
// arrived late rather than never).
struct VirtioBlkTimeoutSnapshot {
    avail: usize;
    used: usize;
    seen: usize;
    status: usize;
    interrupt: usize;
    used_at_reset: usize;
}
let mut virtio_blk_timeouts: usize = 0;
// The slowest completion that did arrive, in counter ticks, and how many
// arrived; a wait that never times out can still be slow enough, per
// request, to silence an ext2 write for a minute.
let mut virtio_blk_completion_max_ticks: usize = 0;
let mut virtio_blk_completions: usize = 0;
let mut virtio_blk_completion_total_ticks: usize = 0;
fn virtio_blk_completion_total() -> usize { return virtio_blk_completion_total_ticks; }
fn virtio_blk_completion_max() -> usize { return virtio_blk_completion_max_ticks; }
fn virtio_blk_completion_count() -> usize { return virtio_blk_completions; }
let mut virtio_blk_timeout_first: VirtioBlkTimeoutSnapshot;
let mut virtio_blk_timeout_last: VirtioBlkTimeoutSnapshot;

fn virtio_blk_timeout_count() -> usize { return virtio_blk_timeouts; }
fn virtio_blk_timeout_first_snapshot() -> VirtioBlkTimeoutSnapshot {
    return virtio_blk_timeout_first;
}
fn virtio_blk_timeout_last_snapshot() -> VirtioBlkTimeoutSnapshot {
    return virtio_blk_timeout_last;
}

// Keep the 16-bit ring-counter boundary independently testable: a normal
// BusyBox rootfs boot crosses it through real block I/O, while this small
// probe makes that coverage explicit even if a future fixture becomes smaller.
fn virtio_blk_index_wrap_probe() -> bool {
    let mut index: VirtioRingIndex = virtio_ring_index_zero();
    for step: usize in 0..<65536 {
        index = virtio_ring_index_next(index);
    }
    let last: VirtioRingIndex = (0xFFFF as u16) as VirtioRingIndex;
    return index == virtio_ring_index_zero() &&
           virtio_ring_index_next(last) == virtio_ring_index_zero();
}

fn virtio_blk_reg(offset: i32) -> *io i32 !{unsafe} {
    return unsafe { (virtio_blk_base + offset) as *io i32 };
}

fn virtio_blk_setup_queue() {
    *(virtio_blk_reg(VIRTIO_BLK_QUEUE_SEL)) = 0;
    *(virtio_blk_reg(VIRTIO_BLK_QUEUE_NUM)) = VIRTIO_QNUM as i32;
    *(virtio_blk_reg(VIRTIO_BLK_QUEUE_ALIGN)) = VIRTIO_BLK_PAGE_SIZE as i32;
    let address: usize = (virtio_blk_queue as *u8) as usize;
    *(virtio_blk_reg(VIRTIO_BLK_QUEUE_PFN)) =
        (address / VIRTIO_BLK_PAGE_SIZE) as i32;
}

fn virtio_blk_reset() -> bool !{unsafe} {
    virtio_blk_ready = false;
    *(virtio_blk_reg(VIRTIO_BLK_STATUS)) = 0;
    // A zero readback is the virtio reset completion point: the device must
    // stop interacting with the queue before it reports that status.
    let reset_start: i64 = read_cntpct();
    let reset_ticks: i64 = read_cntfrq() * VIRTIO_BLK_COMPLETION_SECONDS;
    while (read_cntpct() - reset_start < reset_ticks &&
           *(virtio_blk_reg(VIRTIO_BLK_STATUS)) != 0) {
    }
    if (*(virtio_blk_reg(VIRTIO_BLK_STATUS)) != 0) {
        virtio_blk_disabled = true;
        return false;
    }
    return true;
}

fn virtio_blk_init() -> bool !{unsafe} {
    if (virtio_blk_disabled) { return false; }
    if (virtio_blk_ready) { return true; }
    if (virtio_blk_base == 0) { return false; }
    if (virtio_blk_reset() == false) { return false; }
    // A previous timed-out request may have left ring indices and descriptors
    // behind. Reset returns queue ownership before the next initialization.
    for i: usize in 0..<2 * VIRTIO_BLK_PAGE_SIZE {
        virtio_blk_queue[i] = 0;
    }
    *(virtio_blk_reg(VIRTIO_BLK_STATUS)) = 1;
    *(virtio_blk_reg(VIRTIO_BLK_STATUS)) = 3;
    *(virtio_blk_reg(VIRTIO_BLK_GUEST_FEATURES)) = 0;
    *(virtio_blk_reg(VIRTIO_BLK_GUEST_PAGE_SIZE)) =
        VIRTIO_BLK_PAGE_SIZE as i32;
    virtio_blk_setup_queue();
    *(virtio_blk_reg(VIRTIO_BLK_STATUS)) = 7;
    virtio_blk_used_seen = virtio_ring_index_zero();
    virtio_blk_ready = true;
    return true;
}

private fn virtio_blk_submit_owned(request_type: u32, sector: u32,
                                  buffer: borrow [u8; 1024..],
                                  write: bool,
                                  receive_cpu: sink *VirtioBlkReceiveCpu)
        -> bool !{unsafe} {
    static_assert(sizeof(VirtioBlkReceive) >= 1025,
                  "the protected receive extent covers data and status");
    let sector_buffer = buffer[0..<1024];
    if (write) {
        slice_copy(virtio_blk_data_buf as []u8, sector_buffer);
    }
    let request: *VirtioBlkRequest = virtio_blk_request_buf as *VirtioBlkRequest;
    request.request_type = request_type;
    request.reserved = 0;
    request.sector = sector as u64;
    let receive_view = dma_cpu_slice(receive_cpu, VirtioBlkReceive);
    receive_view[1024] = 0xff;
    let queue: *u8 = virtio_blk_queue as *u8;
    let descs: *VirtioBlkDesc = queue as *VirtioBlkDesc;
    let mut data_flags: i32 = 0;
    if (write == false) { data_flags = VIRTIO_BLK_DESC_F_WRITE; }
    descs[0].addr = (virtio_blk_request_buf as *u8) as usize;
    descs[0].len = sizeof(VirtioBlkRequest) as u32;
    descs[0].flags = VIRTIO_BLK_DESC_F_NEXT as u16;
    descs[0].next = 1;
    dma_prepare_tx(virtio_blk_request_buf as *u8,
                   sizeof(VirtioBlkRequest));
    let receive_device = dma_begin_rx(receive_cpu, VirtioBlkReceive);
    let receive_addr: usize = unsafe {
        dma_device_addr(receive_device, VirtioBlkReceive)
    };
    if (write) {
        descs[1].addr = (virtio_blk_data_buf as *u8) as usize;
    } else {
        descs[1].addr = receive_addr;
    }
    descs[1].len = VIRTIO_BLK_TRANSFER_BYTES as u32;
    descs[1].flags = data_flags as u16 | VIRTIO_BLK_DESC_F_NEXT as u16;
    descs[1].next = 2;
    descs[2].len = 1;
    descs[2].flags = VIRTIO_BLK_DESC_F_WRITE as u16;
    descs[2].next = 0;
    descs[2].addr = receive_addr + VIRTIO_BLK_TRANSFER_BYTES;
    if (write) {
        dma_prepare_tx(virtio_blk_data_buf as *u8, VIRTIO_BLK_TRANSFER_BYTES);
    }
    let avail: *VirtioBlkAvail =
        (queue + VIRTIO_QNUM * (sizeof(VirtioBlkDesc) as isize))
        as *VirtioBlkAvail;
    let slot: isize = ((avail.idx as u16) as isize) % VIRTIO_QNUM;
    let ring: *u16 = (queue + VIRTIO_QNUM *
        (sizeof(VirtioBlkDesc) as isize) +
        (offsetof(VirtioBlkAvail, ring) as isize))
        as *u16;
    ring[slot] = 0;
    avail.idx = virtio_ring_index_next(avail.idx);
    dma_publish();
    *(virtio_blk_reg(VIRTIO_BLK_QUEUE_NOTIFY)) = 0;

    let completion_start: i64 = read_cntpct();
    let completion_ticks: i64 =
        read_cntfrq() * VIRTIO_BLK_COMPLETION_SECONDS;
    while (read_cntpct() - completion_start < completion_ticks &&
           virtio_blk_used_seen == unsafe { ((queue + (VIRTIO_BLK_PAGE_SIZE as isize))
                                    as *io VirtioBlkUsed) }.idx) {
    }
    if (virtio_blk_used_seen == unsafe { ((queue + (VIRTIO_BLK_PAGE_SIZE as isize))
                                 as *io VirtioBlkUsed) }.idx) {
        // No used entry was observed. A completed reset, unlike a timeout
        // alone, justifies returning both receive ranges to the CPU.
        let mut snapshot: VirtioBlkTimeoutSnapshot = {
            (avail.idx as u16) as usize,
            (unsafe { ((queue + (VIRTIO_BLK_PAGE_SIZE as isize))
                       as *io VirtioBlkUsed) }.idx as u16) as usize,
            (virtio_blk_used_seen as u16) as usize,
            *(virtio_blk_reg(VIRTIO_BLK_STATUS)) as usize,
            *(virtio_blk_reg(VIRTIO_BLK_INTERRUPT_STATUS)) as usize,
            0 };
        snapshot.used_at_reset =
            (unsafe { ((queue + (VIRTIO_BLK_PAGE_SIZE as isize))
                       as *io VirtioBlkUsed) }.idx as u16) as usize;
        if (virtio_blk_timeouts == 0) { virtio_blk_timeout_first = snapshot; }
        virtio_blk_timeout_last = snapshot;
        virtio_blk_timeouts = virtio_blk_timeouts + 1;
        if (virtio_blk_reset() == false) {
            virtio_blk_receive_put(
                VirtioBlkReceiveAuthority::Device(receive_device));
            return false;
        }
        let restored_cpu = unsafe {
            dma_finish_owned_rx(receive_device, VirtioBlkReceive)
        };
        virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored_cpu));
        return false;
    }
    let waited: usize = (read_cntpct() - completion_start) as usize;
    if (waited > virtio_blk_completion_max_ticks) {
        virtio_blk_completion_max_ticks = waited;
    }
    virtio_blk_completions = virtio_blk_completions + 1;
    virtio_blk_completion_total_ticks = virtio_blk_completion_total_ticks + waited;
    dma_consume();
    virtio_blk_used_seen = virtio_ring_index_next(virtio_blk_used_seen);
    let restored_cpu = unsafe {
        dma_finish_owned_rx(receive_device, VirtioBlkReceive)
    };
    let restored_view = dma_cpu_slice(restored_cpu, VirtioBlkReceive);
    let status_ok: bool = restored_view[1024] == 0;
    if (status_ok && write == false) {
        slice_copy(sector_buffer, restored_view[0..<1024]);
    }
    virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored_cpu));
    return status_ok;
}

fn virtio_blk_submit(request_type: u32, sector: u32,
                     buffer: borrow [u8; 1024..],
                     write: bool) -> bool !{unsafe} {
    if (virtio_blk_init() == false) { return false; }
    match virtio_blk_receive_take() {
        VirtioBlkReceiveAuthority::Cpu(receive_cpu) => {
            return virtio_blk_submit_owned(request_type, sector, buffer,
                                           write, receive_cpu);
        }
        VirtioBlkReceiveAuthority::Empty => {
            kernel_syscall_fail_stop(0);
        }
        VirtioBlkReceiveAuthority::Device(stale) => {
            virtio_blk_receive_fail_device(stale);
        }
    }
}

// A whole block: `sector` is its first 512-byte sector.
fn virtio_blk_read_block(sector: u32,
                         destination: borrow [u8; 1024..]) -> bool {
    return virtio_blk_submit(VIRTIO_BLK_T_IN, sector, destination, false);
}

fn virtio_blk_write_block(sector: u32,
                          source: borrow [u8; 1024..]) -> bool {
    return virtio_blk_submit(VIRTIO_BLK_T_OUT, sector, source, true);
}

fn virtio_blk_capacity_sectors() -> usize !{unsafe} {
    if (virtio_blk_init() == false) { return 0; }
    let low: *io u32 = unsafe { (virtio_blk_base + 0x100) as *io u32 };
    let high: *io u32 = unsafe { (virtio_blk_base + 0x104) as *io u32 };
    return ((*low as u64) | ((*high as u64) << 32)) as usize;
}
