// QEMU virtio-blk on the modern (Version 2) virtio-mmio transport. The
// transport base is selected from the boot DTB before this driver runs. The
// descriptor table and avail ring share virtio_blk_queue; the used ring is
// its own region, read only through snapshots (kernel/drivers/virtio_used.tkb,
// GitHub issue #740).

use "kernel/drivers/virtio_ring.tkb";
use "kernel/lib/mutex.tkb";
use "kernel/drivers/block/virtio_blk_dma.tkb";

const VIRTIO_QNUM: isize = 8;
const VIRTIO_BLK_DESC_F_NEXT: i32 = 1;
const VIRTIO_BLK_DESC_F_WRITE: i32 = 2;
const VIRTIO_BLK_T_IN: u32 = 0;
const VIRTIO_BLK_T_OUT: u32 = 1;
// GitHub issue #527: this must be elapsed architectural time, not a number of
// guest instructions. QEMU services the queue on a host thread whose progress
// is independent of how quickly the vCPU executes this polling loop.
//
const VIRTIO_BLK_COMPLETION_SECONDS: i64 = 1;

struct packed VirtioBlkDesc {
    addr: usize;
    len: u32;
    flags: u16;
    next: u16;
}
struct packed VirtioBlkAvail {
    flags: u16;
    idx: VirtioRingIndex;
    ring: [u16; VIRTIO_QNUM];
}
// Descriptor table (8 x 16 B) and avail ring (20 B), padded to 256 B and
// written through checked indexes (#1161: no pointer arithmetic).
struct packed VirtioBlkQueue {
    desc: [VirtioBlkDesc; VIRTIO_QNUM];
    avail: VirtioBlkAvail;
    reserved: [u8; 108];
}
struct packed VirtioBlkRequest {
    request_type: u32;
    reserved: u32;
    sector: u64;
}

let mut virtio_blk_base: i32 = 0;
// The transport's registers, attached by the platform device map when it
// finds the block device; virtio_blk_base stays its discovery record.
let mut virtio_blk_regs: IoHandle(VirtioMmioRegs);
let mut virtio_blk_ready: bool;
// A reset that never completes leaves the submitted RX ranges device-owned.
// Do not reinitialize the queue or reuse those buffers in that case.
let mut virtio_blk_disabled: bool;
let mut virtio_blk_queue: VirtioBlkQueue align(64);
// The request header, TX data, and RX data with its one-byte status are
// protected allocations in virtio_blk_dma.tkb (#716, #717). The block-device TaskMutex
// serializes whole commands; the slot's Mutex protects only token exchange.
//
// One request carries a whole 1 KiB block (two sectors), as the USB backend's
// one WRITE(10) per block does (#281). Per sector, a boot made about 440,000
// synchronous requests, and on a loaded host their waits summed past the
// lane's 70 s silence watchdog (2026-10-04).
const VIRTIO_BLK_TRANSFER_BYTES: usize = 1024;
// Virtio's avail/used idx fields are free-running u16 counters. The nominal
// domain keeps the driver shadow at that width and makes comparison with a
// widened counter a type error before the mandatory 65535 -> 0 wrap.
let mut virtio_blk_used_seen: VirtioRingIndex;

// What the queue looked like when a completion wait ran out, for DDB: the
// count, and the first and latest timeout's avail.idx, used.idx, the
// driver's used_seen, the status and interrupt-status registers, and
// whether used.idx had moved by the time the reset began (a completion that
// arrived late rather than never).
struct VirtioBlkTimeoutSnapshot {
    avail: usize;
    used: usize;
    seen: usize;
    status: usize;
    interrupt: usize;
    used_at_reset: usize;
}
let mut virtio_blk_timeouts: usize = 0;
// The slowest completion that did arrive, in counter ticks, and how many
// arrived; a wait that never times out can still be slow enough, per
// request, to silence an ext2 write for a minute.
let mut virtio_blk_completion_max_ticks: usize = 0;
let mut virtio_blk_completions: usize = 0;
let mut virtio_blk_completion_total_ticks: usize = 0;
fn virtio_blk_completion_total() -> usize { return virtio_blk_completion_total_ticks; }
fn virtio_blk_completion_max() -> usize { return virtio_blk_completion_max_ticks; }
fn virtio_blk_completion_count() -> usize { return virtio_blk_completions; }
let mut virtio_blk_timeout_first: VirtioBlkTimeoutSnapshot;
let mut virtio_blk_timeout_last: VirtioBlkTimeoutSnapshot;

fn virtio_blk_timeout_count() -> usize { return virtio_blk_timeouts; }
fn virtio_blk_timeout_first_snapshot() -> VirtioBlkTimeoutSnapshot {
    return virtio_blk_timeout_first;
}
fn virtio_blk_timeout_last_snapshot() -> VirtioBlkTimeoutSnapshot {
    return virtio_blk_timeout_last;
}

// Keep the 16-bit ring-counter boundary independently testable: a normal
// BusyBox rootfs boot crosses it through real block I/O, while this small
// probe makes that coverage explicit even if a future fixture becomes smaller.
fn virtio_blk_index_wrap_probe() -> bool {
    let mut index: VirtioRingIndex = virtio_ring_index_zero();
    for step: usize in 0..<65536 {
        index = virtio_ring_index_next(index);
    }
    let last: VirtioRingIndex = (0xFFFF as u16) as VirtioRingIndex;
    return index == virtio_ring_index_zero() &&
           virtio_ring_index_next(last) == virtio_ring_index_zero();
}

// Queue 0 at its three addresses; false when the device offers fewer than
// VIRTIO_QNUM entries or the used ring is not Ready.
fn virtio_blk_setup_queue() -> bool !{unsafe} {
    virtio_blk_regs.queue_sel = 0;
    if (virtio_blk_regs.queue_num_max < VIRTIO_QNUM as u32) { return false; }
    virtio_blk_regs.queue_num = VIRTIO_QNUM as i32;
    let used: usize = virtio_used_go(VIRTIO_USED_BLK);
    if (used == 0) { return false; }
    let desc: usize = &virtio_blk_queue.desc as usize;
    let avail: usize = &virtio_blk_queue.avail as usize;
    virtio_blk_regs.queue_desc_low = (desc & 0xFFFFFFFF) as u32;
    virtio_blk_regs.queue_desc_high = (desc >> 32) as u32;
    virtio_blk_regs.queue_driver_low = (avail & 0xFFFFFFFF) as u32;
    virtio_blk_regs.queue_driver_high = (avail >> 32) as u32;
    virtio_blk_regs.queue_device_low = (used & 0xFFFFFFFF) as u32;
    virtio_blk_regs.queue_device_high = (used >> 32) as u32;
    virtio_blk_regs.queue_ready = 1;
    return true;
}

fn virtio_blk_init() -> bool !{unsafe} {
    if (virtio_blk_disabled) { return false; }
    if (virtio_blk_ready) { return true; }
    if (virtio_blk_base == 0) { return false; }
    if (virtio_blk_regs.version != VIRTIO_MMIO_VERSION_MODERN) { return false; }
    if (virtio_blk_reset() == false) { return false; }
    if (virtio_blk_used_claim() == false) { return false; }
    // A previous timed-out request may have left ring indices and descriptors
    // behind. Reset returns queue ownership before the next initialization.
    for i: usize in 0..<8 {
        virtio_blk_queue.desc[i].addr = 0;
        virtio_blk_queue.desc[i].len = 0;
        virtio_blk_desc_link(i, 0, 0);
        virtio_blk_queue.avail.ring[i] = 0;
    }
    virtio_blk_queue.avail.flags = 0;
    virtio_blk_queue.avail.idx = virtio_ring_index_zero();
    let base_status: i32 = VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER;
    virtio_blk_regs.status = VIRTIO_STATUS_ACKNOWLEDGE;
    virtio_blk_regs.status = base_status;
    virtio_blk_regs.driver_features_sel = 0;
    virtio_blk_regs.driver_features = 0;
    virtio_blk_regs.driver_features_sel = 1;
    virtio_blk_regs.driver_features = VIRTIO_F_VERSION_1_HIGH;
    virtio_blk_regs.status = base_status | VIRTIO_STATUS_FEATURES_OK;
    if ((virtio_blk_regs.status & VIRTIO_STATUS_FEATURES_OK) == 0 ||
        virtio_blk_setup_queue() == false) {
        virtio_blk_regs.status = VIRTIO_STATUS_FAILED;
        return false;
    }
    virtio_blk_regs.status = base_status | VIRTIO_STATUS_FEATURES_OK |
                             VIRTIO_STATUS_DRIVER_OK;
    virtio_blk_used_seen = virtio_ring_index_zero();
    virtio_blk_ready = true;
    return true;
}

// The only writer of a descriptor's address and length: both
// come from one span, which dma_device_span proved inside its
// allocation (GitHub issue #623).
// A device span's address for a virtio queue register: QEMU virt's DMA
// addresses are physical, with no bus offset. Shared with
// kernel/drivers/virtio_used.tkb, which builds on both targets.
fn virtio_span_address(span: borrow DmaDeviceSpan) -> usize !{unsafe} {
    return unsafe { dma_span_address(span) };
}

private fn virtio_blk_desc_span(index: {0..<8 as usize},
                                   span: borrow DmaDeviceSpan) !{unsafe} {
    virtio_blk_queue.desc[index].addr = virtio_span_address(span);
    virtio_blk_queue.desc[index].len = dma_span_length(span) as u32;
}

private fn virtio_blk_desc_link(index: {0..<8 as usize}, flags: i32,
                                next: u16) {
    virtio_blk_queue.desc[index].flags = flags as u16;
    virtio_blk_queue.desc[index].next = next;
}

// The header's three little-endian fields (virtio 1.x, 5.2.6). The device
// token stays in the owner slot until the request settles.
private fn virtio_blk_submit_header(request_type: u32,
                                    sector: u32) !{unsafe} {
    match virtio_blk_request_take() {
        VirtioBlkRequestTransmitAuthority::Cpu(cpu) => {
            let header = dma_cpu_slice(cpu, VirtioBlkRequestTransmit);
            for i: usize in 0..<4 {
                let sh: u32 = (i * 8) as u32;
                header[i] = ((request_type >> sh) & 0xFF) as u8;
                header[4 + i] = 0;
                header[8 + i] = ((sector >> sh) & 0xFF) as u8;
                header[12 + i] = 0;
            }
            let device = dma_begin_tx(cpu, VirtioBlkRequestTransmit);
            let mut span = dma_device_span(device, VirtioBlkRequestTransmit,
                                           0, 16);
            virtio_blk_desc_span(0, span);
            virtio_blk_desc_link(0, VIRTIO_BLK_DESC_F_NEXT, 1);
            virtio_blk_request_put(
                VirtioBlkRequestTransmitAuthority::Device(device));
        }
        VirtioBlkRequestTransmitAuthority::Device(stale) => {
            virtio_blk_request_fail_device(stale);
        }
    }
}

private fn virtio_blk_submit_write_data(source: borrow [u8; 1024..]) !{unsafe} {
    match virtio_blk_data_take() {
        VirtioBlkDataTransmitAuthority::Cpu(cpu) => {
            slice_copy(dma_cpu_slice(cpu, VirtioBlkDataTransmit),
                       source[0..<1024]);
            let device = dma_begin_tx(cpu, VirtioBlkDataTransmit);
            let mut span = dma_device_span(device, VirtioBlkDataTransmit,
                                           0, VIRTIO_BLK_TRANSFER_BYTES);
            virtio_blk_desc_span(1, span);
            virtio_blk_data_put(VirtioBlkDataTransmitAuthority::Device(device));
        }
        VirtioBlkDataTransmitAuthority::Device(stale) => {
            virtio_blk_data_fail_device(stale);
        }
    }
}

private fn virtio_blk_submit_owned(request_type: u32, sector: u32,
                                  buffer: borrow [u8; 1024..],
                                  write: bool,
                                  receive_cpu: sink *VirtioBlkReceiveCpu)
        -> bool !{unsafe} {
    static_assert(sizeof(VirtioBlkReceive) >= 1025,
                  "the protected receive extent covers data and status");
    let sector_buffer = buffer[0..<1024];
    let receive_view = dma_cpu_slice(receive_cpu, VirtioBlkReceive);
    receive_view[1024] = 0xff;
    let mut data_flags: i32 = 0;
    if (write == false) { data_flags = VIRTIO_BLK_DESC_F_WRITE; }

    virtio_blk_submit_header(request_type, sector);

    let receive_device = dma_begin_rx(receive_cpu, VirtioBlkReceive);
    let mut data_span = dma_device_span(receive_device, VirtioBlkReceive,
                                        0, VIRTIO_BLK_TRANSFER_BYTES);
    let mut status_span = dma_device_span(receive_device, VirtioBlkReceive,
                                          VIRTIO_BLK_TRANSFER_BYTES, 1);
    if (write) {
        virtio_blk_submit_write_data(sector_buffer);
    } else {
        virtio_blk_desc_span(1, data_span);
    }
    virtio_blk_desc_link(1, data_flags | VIRTIO_BLK_DESC_F_NEXT, 2);
    virtio_blk_desc_span(2, status_span);
    virtio_blk_desc_link(2, VIRTIO_BLK_DESC_F_WRITE, 0);
    let avail_idx: VirtioRingIndex = virtio_blk_queue.avail.idx;
    let slot: {0..<8 as usize} = ((avail_idx as u16) as usize) % 8;
    virtio_blk_queue.avail.ring[slot] = 0;
    virtio_blk_queue.avail.idx = virtio_ring_index_next(avail_idx);
    dma_publish();
    virtio_blk_regs.queue_notify = 0;

    let completion_start: i64 = read_cntpct();
    let completion_ticks: i64 =
        read_cntfrq() * VIRTIO_BLK_COMPLETION_SECONDS;
    while (read_cntpct() - completion_start < completion_ticks &&
           virtio_blk_used_pending()) {
    }
    match virtio_blk_receive_settle_used(receive_device) {
        VirtioBlkReceiveUsed::Observed => {}
        VirtioBlkReceiveUsed::Pending(pending_device) => {
            // No used entry was observed. Only a completed reset, not the
            // timeout, returns the receive range to the CPU.
            let mut snapshot: VirtioBlkTimeoutSnapshot = {
                (virtio_blk_queue.avail.idx as u16) as usize,
                virtio_blk_used_index(),
                (virtio_blk_used_seen as u16) as usize,
                virtio_blk_regs.status as usize,
                virtio_blk_regs.interrupt_status as usize,
                0 };
            snapshot.used_at_reset = virtio_blk_used_index();
            if (virtio_blk_timeouts == 0) { virtio_blk_timeout_first = snapshot; }
            virtio_blk_timeout_last = snapshot;
            virtio_blk_timeouts = virtio_blk_timeouts + 1;
            let reset_confirmed: bool =
                virtio_blk_receive_settle_reset(pending_device);
            return false;
        }
    }
    let waited: usize = (read_cntpct() - completion_start) as usize;
    if (waited > virtio_blk_completion_max_ticks) {
        virtio_blk_completion_max_ticks = waited;
    }
    virtio_blk_completions = virtio_blk_completions + 1;
    virtio_blk_completion_total_ticks = virtio_blk_completion_total_ticks + waited;
    match virtio_blk_receive_take() {
        VirtioBlkReceiveAuthority::Cpu(restored_cpu) => {
            let restored_view = dma_cpu_slice(restored_cpu, VirtioBlkReceive);
            let status_ok: bool = restored_view[1024] == 0;
            if (status_ok && write == false) {
                slice_copy(sector_buffer, restored_view[0..<1024]);
            }
            virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored_cpu));
            return status_ok;
        }
        VirtioBlkReceiveAuthority::Device(stale) => {
            virtio_blk_receive_fail_device(stale);
            return false;
        }
    }
}

fn virtio_blk_submit(request_type: u32, sector: u32,
                     buffer: borrow [u8; 1024..],
                     write: bool) -> bool !{unsafe} {
    if (virtio_blk_init() == false) { return false; }
    match virtio_blk_receive_take() {
        VirtioBlkReceiveAuthority::Cpu(receive_cpu) => {
            return virtio_blk_submit_owned(request_type, sector, buffer,
                                           write, receive_cpu);
        }
        VirtioBlkReceiveAuthority::Device(stale) => {
            virtio_blk_receive_fail_device(stale);
        }
    }
}

// A whole block: `sector` is its first 512-byte sector.
fn virtio_blk_read_block(sector: u32,
                         destination: borrow [u8; 1024..]) -> bool {
    return virtio_blk_submit(VIRTIO_BLK_T_IN, sector, destination, false);
}

fn virtio_blk_write_block(sector: u32,
                          source: borrow [u8; 1024..]) -> bool {
    return virtio_blk_submit(VIRTIO_BLK_T_OUT, sector, source, true);
}

fn virtio_blk_capacity_sectors() -> usize !{unsafe} {
    if (virtio_blk_init() == false) { return 0; }
    let low: u32 = virtio_blk_regs.config_word[0];
    let high: u32 = virtio_blk_regs.config_word[1];
    return ((low as u64) | ((high as u64) << 32)) as usize;
}
