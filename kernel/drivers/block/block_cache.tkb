// A small read cache in front of the block devices, one per block slot.
//
// GitHub issue #208. ext2 re-read the same few metadata blocks for every
// kilobyte it returned: ext2_read_file_chunk reads the inode table block to
// validate the inode, ext2_inode_block_pointer reads it again and then the
// single- or double-indirect blocks, and only then the data. Exec streams a
// 1.09 MB BusyBox that way, so a boot read about 140 MiB of 1 KiB blocks from
// a 2.75 MiB filesystem (as it was then), nearly all of it blocks it had just read.
//
// Deliberately small, and write-through:
//
// - Contents are copied in and out. No pointer into a slot leaves this file,
//   so there is nothing that could outlive a slot being reused -- which is
//   what a generational owner would have been for.
// - Every write goes to the device before block_write returns, so there is no
//   dirty data and no question of when to flush it.
// - Least-recently-used replacement. A streamed file touches its metadata on
//   every chunk and each data block once, so the data blocks are what an LRU
//   gives up; round-robin would have evicted the metadata instead.
//
// One set of slots per writer, sized by execution_model.tkb's
// KERNEL_MAX_CORES. The writer was a core until GitHub issue #638; it is now
// a BlockSlot (block_slot.tkb), one per block operation in flight, which the
// caller passes, and each set is owned_by(BlockSlot.index, ...) (GitHub
// issue #1159). Below, "core" means that writer. Sized the way ext2's scratch
// buffers and the block counters already are, so raising the build's core
// maximum resizes this file with no edit here (GitHub issue #9): a
// syscall that reaches the filesystem may run on either core. What one core
// writes reaches the others through write epochs, one per bucket of block
// numbers: a bucket's epoch is the sum of every core's write count for that
// bucket, each count added to atomically by its slot. A slot records its
// block's bucket epoch and is valid only while that is still the epoch, so a
// write retires every core's copies of the blocks in its bucket and leaves
// the rest (GitHub issue #553: one machine-wide epoch made each of a boot's
// 188 metadata writes retire every copy, and ext2 read the same 44 blocks
// about twelve times each).
//
// An epoch is taken BEFORE the device is: a fill records the epoch read
// before its device read, and a write's own copy records the epoch read
// before its device write plus its own count. A write that lands in between
// therefore leaves the copy stale, never current. Taking it afterwards would
// let a peer's write that replaced the block during the read be counted as
// already reflected in the bytes.
//
// Each count is PUBLISHED with release ordering and summed with acquire
// loads (GitHub issue #533). A compiler fence used to stand here, which
// orders only what one core's compiler emits: it left the store of a block's
// bytes free to become visible to another core AFTER the count that retires
// that core's stale copy, so a peer could take a hit on a slot filled before
// a write it could not yet see. Release/acquire is what makes the count the
// later half of that pair on the hardware as well.
//
// Current limitations (2026-11-07):
// - The write counts and hit counts are AtomicWord rows indexed by the
//   slot's number (block_slot_number), not owned_by, because every core's
//   epoch sum reads them. Both are added to by atomic read-modify-writes
//   (the write count by an acq_rel compare-swap loop), so neither depends
//   on having one writer.
//
// Kept free of device access and logging, so linux_user/block_cache can
// compile this file itself and drive two real slots against it.

use "kernel/lib/atomic_word.tkb";
use "kernel/drivers/block/block_slot.tkb";
const BLOCK_CACHE_BYTES: usize = 1024;
const BLOCK_CACHE_SLOTS: usize = 16;
// Distinct blocks written in a boot: 18; distinct single-block reads: 44.
// Two blocks sharing a bucket only cost each other a re-read.
const BLOCK_CACHE_BUCKETS: usize = 64;

must_use variant BlockCacheReadResult { Hit; Miss; }

// A bucket epoch taken for one block. Only block_cache_epoch_of makes one,
// so a fill cannot be handed the read-ahead run's machine-wide sum or a
// bare count instead.
struct BlockCacheEpoch { private value: usize; }

// Each set of BLOCK_CACHE_SLOTS entries is owned by one BlockSlot (GitHub
// issue #1159): an entry is reached only as `g[slot.index * BLOCK_CACHE_SLOTS
// + k]`, k below BLOCK_CACHE_SLOTS, so a holder reaches only its own set.
// One entry's bytes; a struct so an element is sliced as a field.
struct BlockCacheBytes { bytes: [u8; BLOCK_CACHE_BYTES]; }
private let mut block_cache_data:
    [BlockCacheBytes; KERNEL_MAX_CORES * BLOCK_CACHE_SLOTS]
    owned_by(BlockSlot.index, BLOCK_CACHE_SLOTS);
private let mut block_cache_backend: [u8; KERNEL_MAX_CORES * BLOCK_CACHE_SLOTS]
    owned_by(BlockSlot.index, BLOCK_CACHE_SLOTS);
private let mut block_cache_block: [usize; KERNEL_MAX_CORES * BLOCK_CACHE_SLOTS]
    owned_by(BlockSlot.index, BLOCK_CACHE_SLOTS);
private let mut block_cache_valid: [bool; KERNEL_MAX_CORES * BLOCK_CACHE_SLOTS]
    owned_by(BlockSlot.index, BLOCK_CACHE_SLOTS);
private let mut block_cache_epoch: [usize; KERNEL_MAX_CORES * BLOCK_CACHE_SLOTS]
    owned_by(BlockSlot.index, BLOCK_CACHE_SLOTS);
private let mut block_cache_used: [usize; KERNEL_MAX_CORES * BLOCK_CACHE_SLOTS]
    owned_by(BlockSlot.index, BLOCK_CACHE_SLOTS);
private let mut block_cache_tick: [usize; KERNEL_MAX_CORES]
    owned_by(BlockSlot.index, 1);
private let mut block_cache_hits: [AtomicWord; KERNEL_MAX_CORES];
private let mut block_cache_writes:
    [AtomicWord; KERNEL_MAX_CORES * BLOCK_CACHE_BUCKETS];

private fn block_cache_bucket(block: usize) -> {0..<BLOCK_CACHE_BUCKETS as usize} {
    return block % BLOCK_CACHE_BUCKETS;
}

private fn block_cache_bucket_epoch(bucket: {0..<BLOCK_CACHE_BUCKETS as usize})
        -> usize !{unsafe} {
    let mut epoch: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        epoch = epoch + atomic_word_load(
            &block_cache_writes[core * BLOCK_CACHE_BUCKETS + bucket]);
    }
    return epoch;
}

private fn block_cache_write_epoch() -> usize !{unsafe} {
    let mut epoch: usize = 0;
    for index: usize in 0..<KERNEL_MAX_CORES * BLOCK_CACHE_BUCKETS {
        epoch = epoch + atomic_word_load(&block_cache_writes[index]);
    }
    return epoch;
}

private fn block_cache_count_write(slot: borrow BlockSlot[0],
                                   bucket: {0..<BLOCK_CACHE_BUCKETS as usize})
        !{unsafe} {
    let index: {0..<KERNEL_MAX_CORES * BLOCK_CACHE_BUCKETS as usize} =
        block_slot_number(slot) * BLOCK_CACHE_BUCKETS + bucket;
    // A compare-swap loop, not a load and a store: the count stays right
    // whoever else adds to the same row, and acq_rel keeps the release that
    // publishes this core's copy before the count that retires it (#533).
    let mut expected: usize = atomic_word_load(&block_cache_writes[index]);
    let mut counted: bool = false;
    while (counted == false) {
        match atomic_word_compare_swap_acq_rel(&block_cache_writes[index],
                                               expected, expected + 1) {
            CasResult::Swapped => { counted = true; }
            CasResult::Observed(seen) => { expected = seen; }
        }
    }
}

private fn block_cache_touch(slot: borrow BlockSlot[0],
                             k: {0..<BLOCK_CACHE_SLOTS as usize}) {
    let tick: usize = block_cache_tick[slot.index] + 1;
    block_cache_tick[slot.index] = tick;
    block_cache_used[slot.index * BLOCK_CACHE_SLOTS + k] = tick;
}

// The entry of this slot's set that holds (backend, block) at its current
// epoch.
must_use variant BlockCacheSlot {
    Missing;
    Found({0..<BLOCK_CACHE_SLOTS as usize});
}

private fn block_cache_find(slot: borrow BlockSlot[0],
                            backend: u8, block: usize) -> BlockCacheSlot {
    let epoch: usize = block_cache_bucket_epoch(block_cache_bucket(block));
    for k: usize in 0..<BLOCK_CACHE_SLOTS {
        if (block_cache_valid[slot.index * BLOCK_CACHE_SLOTS + k] &&
            block_cache_epoch[slot.index * BLOCK_CACHE_SLOTS + k] == epoch &&
            block_cache_backend[slot.index * BLOCK_CACHE_SLOTS + k] == backend &&
            block_cache_block[slot.index * BLOCK_CACHE_SLOTS + k] == block) {
            return BlockCacheSlot::Found(k);
        }
    }
    return BlockCacheSlot::Missing;
}

// The entry a fill takes: the one already holding the block if there is one,
// else an empty or stale one, else the least recently used.
private fn block_cache_victim(slot: borrow BlockSlot[0],
                              backend: u8, block: usize)
        -> {0..<BLOCK_CACHE_SLOTS as usize} {
    let mut victim: {0..<BLOCK_CACHE_SLOTS as usize} = 0;
    let mut oldest: usize = 0xFFFFFFFFFFFFFFFF;
    for k: usize in 0..<BLOCK_CACHE_SLOTS {
        if (block_cache_valid[slot.index * BLOCK_CACHE_SLOTS + k] == false ||
            block_cache_epoch[slot.index * BLOCK_CACHE_SLOTS + k] !=
                block_cache_bucket_epoch(block_cache_bucket(
                    block_cache_block[slot.index * BLOCK_CACHE_SLOTS + k]))) {
            return k;
        }
        if (block_cache_backend[slot.index * BLOCK_CACHE_SLOTS + k] == backend &&
            block_cache_block[slot.index * BLOCK_CACHE_SLOTS + k] == block) {
            return k;
        }
        if (block_cache_used[slot.index * BLOCK_CACHE_SLOTS + k] < oldest) {
            oldest = block_cache_used[slot.index * BLOCK_CACHE_SLOTS + k];
            victim = k;
        }
    }
    return victim;
}

private fn block_cache_store(slot: borrow BlockSlot[0],
                             backend: u8, block: usize,
                             source: borrow [u8; BLOCK_CACHE_BYTES..],
                             epoch: usize) {
    let k: {0..<BLOCK_CACHE_SLOTS as usize} =
        block_cache_victim(slot, backend, block);
    slice_copy(block_cache_data[slot.index * BLOCK_CACHE_SLOTS + k].bytes as []u8,
               source[0..<BLOCK_CACHE_BYTES]);
    block_cache_backend[slot.index * BLOCK_CACHE_SLOTS + k] = backend;
    block_cache_block[slot.index * BLOCK_CACHE_SLOTS + k] = block;
    block_cache_epoch[slot.index * BLOCK_CACHE_SLOTS + k] = epoch;
    block_cache_valid[slot.index * BLOCK_CACHE_SLOTS + k] = true;
    block_cache_touch(slot, k);
}

// Copy (backend, block) into destination if this slot's set holds it.
fn block_cache_read(slot: borrow BlockSlot[0], backend: u8, block: usize,
                    destination: borrow [u8; BLOCK_CACHE_BYTES..])
        -> BlockCacheReadResult {
    match block_cache_find(slot, backend, block) {
        BlockCacheSlot::Missing => { return BlockCacheReadResult::Miss; }
        BlockCacheSlot::Found(k) => {
            slice_copy(destination[0..<BLOCK_CACHE_BYTES],
                       block_cache_data[slot.index * BLOCK_CACHE_SLOTS + k].bytes as []u8);
            block_cache_touch(slot, k);
            atomic_word_fetch_add(&block_cache_hits[block_slot_number(slot)], 1);
            return BlockCacheReadResult::Hit;
        }
    }
}

// The epoch a copy of (backend, block) will be held to, taken before the
// device read or write that produces the copy.
fn block_cache_epoch_of(backend: u8, block: usize) -> BlockCacheEpoch {
    let mut epoch: BlockCacheEpoch = {
        block_cache_bucket_epoch(block_cache_bucket(block)) };
    return epoch;
}

// After a device read: keep what was read, at the epoch taken before it.
fn block_cache_fill(slot: borrow BlockSlot[0], backend: u8, block: usize,
                    source: borrow [u8; BLOCK_CACHE_BYTES..],
                    epoch: BlockCacheEpoch) {
    block_cache_store(slot, backend, block, source, epoch.value);
}

// After a device write, whatever its outcome: every core's copies of blocks
// in its bucket stop matching. When the write succeeded, this core keeps the
// bytes it wrote, at the epoch taken before the write plus this write alone,
// so any other write to the bucket since then leaves the copy stale.
fn block_cache_note_write(slot: borrow BlockSlot[0], backend: u8, block: usize,
                          source: borrow [u8; BLOCK_CACHE_BYTES..],
                          written: bool, epoch_before: BlockCacheEpoch)
        !{unsafe} {
    block_cache_count_write(slot, block_cache_bucket(block));
    if (written) {
        block_cache_store(slot, backend, block, source,
                          epoch_before.value + 1);
    }
}

// A write that went around block_write -- usb_provision_rootfs's batched
// USB path -- names no block, so it retires every bucket.
fn block_cache_forget_all(slot: borrow BlockSlot[0]) !{unsafe} {
    for bucket: usize in 0..<BLOCK_CACHE_BUCKETS {
        block_cache_count_write(slot, bucket);
    }
}

// The sum of every bucket's epoch, for a copy kept outside this file --
// memory.tkb's read-ahead run (GitHub issue #545) -- to be retired by any
// write at all, as before per-block retirement.
fn block_cache_epoch_now() -> usize {
    return block_cache_write_epoch();
}

fn block_cache_hit_total() -> usize {
    let mut total: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        total = total + atomic_word_load(&block_cache_hits[core]);
    }
    return total;
}
