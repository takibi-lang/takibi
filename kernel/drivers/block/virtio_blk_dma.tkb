// GitHub issues #716 and #717: the mint file of the virtio-blk DMA
// allocations -- the receive allocation, the request header and the
// written data block. dma_finish_owned_rx and dma_finish_owned_tx are
// accepted only in the file that declares the record, so this file is the
// whole trusted claim that device ownership may return to the CPU. It
// returns ownership of every allocation a request submitted after one of
// two observations, and nowhere else:
//   - virtio_blk_receive_settle_used: a snapshot of the used ring
//     (kernel/drivers/virtio_used.tkb) showed its idx past the driver's
//     shadow, so the device has written the request's data and status
//     (virtio 1.x, 2.7.8);
//   - virtio_blk_receive_settle_reset: the status register read back zero
//     after a reset, so the device no longer touches the queue (virtio
//     1.x, 2.1).
// Every other function here only moves the tokens between the owner slots
// and their callers. Keep anything else out of this file.

use "kernel/lib/task_mutex.tkb";
use "kernel/drivers/virtio_used.tkb";
use "kernel/lib/set_once.tkb";

// The used ring's own backing global (modern transport, GitHub issue #740).
private region let mut virtio_blk_used_ring: [VirtqUsedRing; 1] align(64);
// GitHub issue #1159: claimed once per boot, by the SetOnce claim's winner.
private let mut virtio_blk_used_claimed: SetOnce(bool);

// The used ring parked Ready in its slot, once per boot. A later call
// answers what the first one published: false when the region was gone.
fn virtio_blk_used_claim() -> bool {
    match set_once_claim(&virtio_blk_used_claimed) {
        SetOnceBegin::Taken => {
            if (set_once_is_set(&virtio_blk_used_claimed)) {
                return set_once_get(&virtio_blk_used_claimed);
            }
            return false;
        }
        SetOnceBegin::Claimed(claim) => {
            let RegionOf(VirtqUsedRing)::Taken(memory) = region_of(virtio_blk_used_ring) else {
                RegionOf(VirtqUsedRing)::Gone => {
                    set_once_publish(&virtio_blk_used_claimed, claim, false);
                    return false;
                }
            };
            virtio_used_claim(VIRTIO_USED_BLK, memory);
            set_once_publish(&virtio_blk_used_claimed, claim, true);
            return true;
        }
    }
}

// The descriptor still exposes one status byte at offset 1024.
struct dma_fixed VirtioBlkReceive { private bytes: [u8; 1088]; }
private let mut virtio_blk_receive: VirtioBlkReceive align(64);

// GitHub issue #1096: a TaskMutex, rank 30, below the IRQ level; no
// interrupt handler moves the receive authority.
private linear struct VirtioBlkReceiveGuard[lock: addr] {
    private held: usize;
}

private fn virtio_blk_receive_lock(lock: *TaskMutex @ address)
        -> VirtioBlkReceiveGuard[address]
        !{may_block, acquires_lock_30_virtio_blk_receive,
          lock_guard_30_virtio_blk_receive} {
    task_mutex_acquire(lock);
    let mut guard: VirtioBlkReceiveGuard[address] = { 1 };
    return guard;
}

private fn virtio_blk_receive_unlock(
        guard: sink VirtioBlkReceiveGuard[address],
        lock: *TaskMutex @ address) {
    let held: usize = guard.held;
    task_mutex_release(lock);
}

fn virtio_blk_receive_take() -> VirtioBlkReceiveAuthority {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkReceive.mutex);
    let previous: Place(VirtioBlkReceiveAuthority) = place_take(
        guard, &dma_owner_VirtioBlkReceive.mutex, dma_owner_VirtioBlkReceive.value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkReceive.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_invariant_stop();
            return virtio_blk_receive_take();
        }
    };
    return authority;
}

private fn virtio_blk_receive_fail_cpu(stale: sink *VirtioBlkReceiveCpu) {
    kernel_invariant_stop();
}

fn virtio_blk_receive_fail_device(stale: sink *VirtioBlkReceiveDevice) {
    kernel_invariant_stop();
}

fn virtio_blk_receive_put(value: sink VirtioBlkReceiveAuthority) {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkReceive.mutex);
    let previous: Place(VirtioBlkReceiveAuthority) = place_put(
        guard, &dma_owner_VirtioBlkReceive.mutex, dma_owner_VirtioBlkReceive.value, value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkReceive.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        VirtioBlkReceiveAuthority::Cpu(stale) => {
            virtio_blk_receive_fail_cpu(stale);
        }
        VirtioBlkReceiveAuthority::Device(stale) => {
            virtio_blk_receive_fail_device(stale);
        }
    }
}


// The device reads these two. The request header is 16 bytes in a whole
// cache line; the data block is submitted only by writes.
struct dma_fixed VirtioBlkRequestTransmit { private bytes: [u8; 64]; }
private let mut virtio_blk_request_transmit: VirtioBlkRequestTransmit align(64);
struct dma_fixed VirtioBlkDataTransmit { private bytes: [u8; 1024]; }
private let mut virtio_blk_data_transmit: VirtioBlkDataTransmit align(64);

fn virtio_blk_request_take() -> VirtioBlkRequestTransmitAuthority {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkRequestTransmit.mutex);
    let previous: Place(VirtioBlkRequestTransmitAuthority) = place_take(
        guard, &dma_owner_VirtioBlkRequestTransmit.mutex, dma_owner_VirtioBlkRequestTransmit.value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkRequestTransmit.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_invariant_stop();
            return virtio_blk_request_take();
        }
    };
    return authority;
}

private fn virtio_blk_request_fail_cpu(stale: sink *VirtioBlkRequestTransmitCpu) {
    kernel_invariant_stop();
}

fn virtio_blk_request_fail_device(stale: sink *VirtioBlkRequestTransmitDevice) {
    kernel_invariant_stop();
}

fn virtio_blk_request_put(value: sink VirtioBlkRequestTransmitAuthority) {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkRequestTransmit.mutex);
    let previous: Place(VirtioBlkRequestTransmitAuthority) = place_put(
        guard, &dma_owner_VirtioBlkRequestTransmit.mutex, dma_owner_VirtioBlkRequestTransmit.value, value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkRequestTransmit.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        VirtioBlkRequestTransmitAuthority::Cpu(stale) => { virtio_blk_request_fail_cpu(stale); }
        VirtioBlkRequestTransmitAuthority::Device(stale) => { virtio_blk_request_fail_device(stale); }
    }
}


// Called only after an observed completion or a confirmed reset.
private fn virtio_blk_request_settle() {
    match virtio_blk_request_take() {
        VirtioBlkRequestTransmitAuthority::Cpu(cpu) => {
            virtio_blk_request_put(VirtioBlkRequestTransmitAuthority::Cpu(cpu));
        }
        VirtioBlkRequestTransmitAuthority::Device(device) => {
            let restored = dma_finish_owned_tx(device, VirtioBlkRequestTransmit);
            virtio_blk_request_put(VirtioBlkRequestTransmitAuthority::Cpu(restored));
        }
    }
}

fn virtio_blk_data_take() -> VirtioBlkDataTransmitAuthority {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkDataTransmit.mutex);
    let previous: Place(VirtioBlkDataTransmitAuthority) = place_take(
        guard, &dma_owner_VirtioBlkDataTransmit.mutex, dma_owner_VirtioBlkDataTransmit.value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkDataTransmit.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_invariant_stop();
            return virtio_blk_data_take();
        }
    };
    return authority;
}

private fn virtio_blk_data_fail_cpu(stale: sink *VirtioBlkDataTransmitCpu) {
    kernel_invariant_stop();
}

fn virtio_blk_data_fail_device(stale: sink *VirtioBlkDataTransmitDevice) {
    kernel_invariant_stop();
}

fn virtio_blk_data_put(value: sink VirtioBlkDataTransmitAuthority) {
    let guard = virtio_blk_receive_lock(&dma_owner_VirtioBlkDataTransmit.mutex);
    let previous: Place(VirtioBlkDataTransmitAuthority) = place_put(
        guard, &dma_owner_VirtioBlkDataTransmit.mutex, dma_owner_VirtioBlkDataTransmit.value, value);
    virtio_blk_receive_unlock(guard, &dma_owner_VirtioBlkDataTransmit.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        VirtioBlkDataTransmitAuthority::Cpu(stale) => { virtio_blk_data_fail_cpu(stale); }
        VirtioBlkDataTransmitAuthority::Device(stale) => { virtio_blk_data_fail_device(stale); }
    }
}


// Called only after an observed completion or a confirmed reset.
private fn virtio_blk_data_settle() {
    match virtio_blk_data_take() {
        VirtioBlkDataTransmitAuthority::Cpu(cpu) => {
            virtio_blk_data_put(VirtioBlkDataTransmitAuthority::Cpu(cpu));
        }
        VirtioBlkDataTransmitAuthority::Device(device) => {
            let restored = dma_finish_owned_tx(device, VirtioBlkDataTransmit);
            virtio_blk_data_put(VirtioBlkDataTransmitAuthority::Cpu(restored));
        }
    }
}

// The device has not yet published a used entry beyond the driver's shadow.
// No snapshot (the ring is not live) counts as pending.
fn virtio_blk_used_pending(guard: borrow BlockDeviceGuard[&block_device_lock])
        -> bool {
    match virtio_used_snapshot(VIRTIO_USED_BLK) {
        VirtioUsedSeen::Unavailable => { return true; }
        VirtioUsedSeen::Seen(ring) => {
            return virtio_blk_status(guard).used_seen == ring.idx;
        }
    }
}

// The used ring's idx from one snapshot, for the timeout record.
fn virtio_blk_used_index() -> usize {
    match virtio_used_snapshot(VIRTIO_USED_BLK) {
        VirtioUsedSeen::Unavailable => { return 0; }
        VirtioUsedSeen::Seen(ring) => { return (ring.idx as u16) as usize; }
    }
}

fn virtio_blk_reset(guard: borrow BlockDeviceGuard[&block_device_lock])
        -> bool !{unsafe} {
    let mut status: VirtioBlkStatus = virtio_blk_status(guard);
    status.ready = false;
    virtio_blk_status_store(guard, status);
    virtio_blk_regs.status = 0;
    // A zero readback is the virtio reset completion point: the device must
    // stop interacting with the queue before it reports that status.
    let reset_start: i64 = read_cntpct();
    let reset_ticks: i64 = read_cntfrq() * VIRTIO_BLK_COMPLETION_SECONDS;
    while (read_cntpct() - reset_start < reset_ticks &&
           virtio_blk_regs.status != 0) {
    }
    match virtio_used_reclaim_block_after_reset(guard) {
        VirtioUsedResetOutcome::Unconfirmed => {
            status.disabled = true;
            virtio_blk_status_store(guard, status);
            return false;
        }
        VirtioUsedResetOutcome::Confirmed => { return true; }
    }
}

must_use variant VirtioBlkReceiveUsed {
    Observed;
    Pending(*VirtioBlkReceiveDevice);
}

// Observed puts the CPU token back in the owner slot; Pending hands the
// device token back unchanged for the reset path.
fn virtio_blk_receive_settle_used(guard: borrow BlockDeviceGuard[&block_device_lock],
                                  device: sink *VirtioBlkReceiveDevice)
        -> VirtioBlkReceiveUsed !{unsafe} {
    if (virtio_blk_used_pending(guard)) {
        return VirtioBlkReceiveUsed::Pending(device);
    }
    dma_consume();
    let mut status: VirtioBlkStatus = virtio_blk_status(guard);
    status.used_seen = virtio_ring_index_next(status.used_seen);
    virtio_blk_status_store(guard, status);
    let restored = dma_finish_owned_rx(device, VirtioBlkReceive);
    virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored));
    virtio_blk_request_settle();
    virtio_blk_data_settle();
    return VirtioBlkReceiveUsed::Observed;
}

// A failed reset keeps every device token in its slot, so no range is
// reused in this boot.
fn virtio_blk_receive_settle_reset(guard: borrow BlockDeviceGuard[&block_device_lock],
                                   device: sink *VirtioBlkReceiveDevice)
        -> bool !{unsafe} {
    if (virtio_blk_reset(guard) == false) {
        virtio_blk_receive_put(VirtioBlkReceiveAuthority::Device(device));
        return false;
    }
    let restored = dma_finish_owned_rx(device, VirtioBlkReceive);
    virtio_blk_receive_put(VirtioBlkReceiveAuthority::Cpu(restored));
    virtio_blk_request_settle();
    virtio_blk_data_settle();
    return true;
}
