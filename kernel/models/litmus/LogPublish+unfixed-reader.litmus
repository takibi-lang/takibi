AArch64 LogPublish+unfixed-reader
"kernel_log publish: length admits a byte whose word is unseen"
{
0:X1=text; 0:X3=length;
1:X1=text; 1:X3=length;
}
 P0           | P1            ;
 MOV X0,#1    | LDR  X2,[X3]  ;
 STLR X0,[X1] | LDR  X0,[X1]  ;
 MOV X2,#1    |               ;
 STLR X2,[X3] |               ;
exists (1:X2=1 /\ 1:X0=0)
