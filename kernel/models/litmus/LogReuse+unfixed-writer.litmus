AArch64 LogReuse+unfixed-writer
"kernel_log reuse: new slot word seen, old count re-read"
{
0:X1=started; 0:X3=data;
1:X1=started; 1:X3=data;
}
 P0           | P1            ;
 MOV X0,#1    | LDAR X2,[X3]  ;
 STLR X0,[X1] | LDAR X0,[X1]  ;
 MOV X2,#1    |               ;
 STR  X2,[X3] |               ;
exists (1:X2=1 /\ 1:X0=0)
