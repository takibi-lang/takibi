// GitHub issue #720: the shared region-transfer protocol as one Takibi
// declaration. `takibi --emit-tla` generates its TLA+ model; `make
// modelcheck` checks it beside the handwritten SharedRegionTransfer.tla
// whose fixed verdict it must reproduce. RegionTransferEarly_faulty.tkb
// changes one line and must violate Safety; the other handwritten faults are
// compile errors here.
protocol RegionTransfer[inst: usize] retains region(u8)[b, n] {
    state Ready access write;
    state Reserved[req] access write;
    state InFlight[req] device;
    state Unconfirmed[req] device;
    state Halted;
    state Down[req] device;
    init Ready;

    transition reserve(Ready) split -> Reserved[fresh req] | Refused(Ready);
    transition submit(Reserved[req]) requires prepared -> InFlight[req];
    observe completion(InFlight[req]) -> Matching[req] completes | Foreign;
    transition resume(InFlight[req], Matching[req]) -> Ready;
    transition expire(InFlight[req]) -> Unconfirmed[req];
    observe reset(Unconfirmed[req]) -> Confirmed[req] quiesces | ResetFailed[req];
    transition halt(Unconfirmed[req], Confirmed[req]) -> Halted;
    transition down(Unconfirmed[req], ResetFailed[req]) -> Down[req];
    transition restart(Halted) -> Ready;

    property disjoint;
    property prepared_before_read;
    model cells 2;
}
