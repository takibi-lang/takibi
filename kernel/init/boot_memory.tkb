// Applying the boot DTB's memory map, once, for every platform.
//
// It exists as one file for the reason kernel/init/contention_probes.tkb
// does: the sequence below was written twice, byte-identical, in
// kernel/platform/qemu/init.tkb and kernel/platform/rpi5/init.tkb. The two
// platform trees are never compiled together, so a case added to one copy and
// not the other is invisible until a board boots -- GitHub issue #470's
// failure, and #517's finding that the parity check could not see it because
// a block inside main() is not a function.
//
// What stays per-platform is what genuinely differs: QEMU probes the
// discontiguous extent afterwards and RPi5 does not, so this returns and each
// caller continues on its own. What is shared is everything up to and
// including the `memory:` summary line, plus the two halts that answer a DTB
// this kernel cannot boot from.
//
// The halts are the reason this returns nothing. A caller cannot act on a DTB
// with no usable memory, and the boot contract on both platforms is that a
// usable DTB is supplied; there is no outcome to hand back.
use "kernel/printk/log.tkb";
use "kernel/printk/number.tkb";
use "kernel/boot/fdt.tkb";
use "kernel/mm/page.tkb";

fn kernel_boot_memory_apply() !{logs, unsafe} {
    match platform_memory_detect() {
        PlatformMemoryResult::Detected(detected) => {
            match page_allocator_apply_memory(detected) {
                PageAllocatorMemoryResult::Invalid => {
                    kernel_boot_log("memory: usable regions exclude bootstrap page tables; halting\n");
                    while (true) { }
                }
                PageAllocatorMemoryResult::Applied => {}
            }
            let mem_base: usize = fdt_memory_first_base(detected);
            let mem_size: usize = fdt_memory_total_size(detected);
            kernel_boot_log("memory: source=dtb base_bytes=");
            uart_put_udec(mem_base as usize);
            kernel_boot_log(" detected_mib=");
            uart_put_udec((mem_size as usize) / (1024 * 1024));
            kernel_boot_log(" regions=");
            uart_put_udec(fdt_memory_region_count(detected));
            kernel_boot_log(" reservations=");
            uart_put_udec(fdt_memory_reservation_count(detected));
            kernel_boot_log(" allocator_pages=");
            uart_put_udec(page_allocator_total_count());
            kernel_boot_log("\n");
        }
        PlatformMemoryResult::InvalidDtb => {
            kernel_boot_log("memory: invalid boot DTB; halting\n");
            while (true) { }
        }
        PlatformMemoryResult::MissingMemory => {
            kernel_boot_log("memory: boot DTB has no usable /memory; halting\n");
            while (true) { }
        }
    }
}
