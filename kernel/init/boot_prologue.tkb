// What every platform does before it does anything platform-specific.
//
// (Uses kernel/lib/boot_once.tkb: the phase every boot write borrows, #1013.)
//
// GitHub issue #517: these eight steps opened `fn main()` in both
// kernel/platform/qemu/init.tkb and kernel/platform/rpi5/init.tkb,
// byte-identical. The order is load-bearing and none of it is a platform
// decision -- poison the two stacks before anything stands on them, bring the
// platform and the console up, prove the log's bounded-loss signals with a
// destructive probe, re-initialise after it, and only then say the kernel is
// at EL1.
//
// The probe is why kernel_log_init() appears twice. It deliberately overruns
// the ring to make the overwrite and truncation signals fire, so the log has
// to be reset afterwards; running it before the first real line means the
// evidence a boot leaves is never the probe's.
use "kernel/printk/log.tkb";
use "kernel/lib/boot_once.tkb";
use "kernel/arch/arm64/kernel/cache_geometry.tkb";
use "kernel/arch/arm64/kernel/cache_geometry_extern.tkb";
use "kernel/arch/arm64/kernel/user_access_extern.tkb";

fn kernel_boot_prologue(phase: borrow BootPhase[boot]) !{logs, unsafe} {
    // First, before anything has had a chance to go deep: fill the unused
    // part of the boot stack with poison so its high-water mark can be
    // measured at the end of the run, exactly as a process stack's is.
    kernel_boot_stack_arm();
    // Nothing is standing on the IRQ stack yet, so the whole run can be
    // poisoned outright (issue #378).
    kernel_irq_stack_arm();
    platform_init(phase);
    kernel_log_init();
    let log_bounds_ok: bool = kernel_log_bounds_probe();
    kernel_log_init();
    kernel_boot_log("takibi kernel: EL1\n");
    if (log_bounds_ok) {
        kernel_boot_log("kernel log: overwrite+refusal+line split reported\n");
    } else {
        kernel_boot_log("kernel log: bounds probe failed\n");
    }
    // Before any DMA: no driver has been probed yet.
    kernel_cache_geometry_require(0);
    kernel_pan_require(0);
}

// GitHub issue #1032: set PSTATE.PAN on this core, or halt. PAN keeps EL1
// out of user pages except inside a kernel/mm/user_access.tkb window, and
// SCTLR_EL1.SPAN clear (kernel_mmu_activate) sets it again on every
// exception entry. Every core calls it for itself, like the cache check: a
// core without FEAT_PAN (an ARMv8.0 part such as Cortex-A53) would run
// with user memory open to every EL1 access, so it is refused rather than
// run unprotected. Silent on success.
fn kernel_pan_require(core: usize) !{logs, unsafe} {
    if (user_access_pan_enable() != 0) { return; }
    kernel_boot_log("pan: FEAT_PAN absent (ID_AA64MMFR1_EL1.PAN == 0) core=");
    uart_put_udec(core);
    kernel_boot_log("; halting\n");
    while (true) { }
}

// GitHub issue #759: halt this core unless its CTR_EL0 fits DMA_CACHE_LINE
// (see kernel/arch/arm64/kernel/cache_geometry.tkb). Every core calls it --
// core 0 here, each secondary in kernel_secondary_main before it reports
// itself started -- because CTR_EL0 is a per-core register and a
// heterogeneous part may report different lines on different cores. The
// cost is one mrs and a few shifts per core. Silent on success (debugging
// aids log only on failure); the line on failure carries the raw register
// so a board report needs nothing else.
fn kernel_cache_geometry_require(core: usize) !{logs, unsafe} {
    let ctr: usize = cache_geometry_read_ctr_el0();
    match cache_geometry_check(ctr, DMA_CACHE_LINE) {
        CacheGeometryCheck::Fits => { return; }
        CacheGeometryCheck::DminLineTooLarge(bytes) => {
            kernel_boot_log("cache: DminLine exceeds DMA_CACHE_LINE bytes=");
            uart_put_udec(bytes);
        }
        CacheGeometryCheck::WritebackGranuleTooLarge(bytes) => {
            kernel_boot_log("cache: CWG exceeds DMA_CACHE_LINE bytes=");
            uart_put_udec(bytes);
        }
        CacheGeometryCheck::WritebackGranuleUnreported => {
            kernel_boot_log("cache: CWG unreported (architectural 2 KiB) exceeds DMA_CACHE_LINE");
        }
    }
    kernel_boot_log(" limit=");
    uart_put_udec(DMA_CACHE_LINE);
    kernel_boot_log(" core=");
    uart_put_udec(core);
    kernel_boot_log(" ctr_el0=");
    uart_put_hex(ctr);
    kernel_boot_log("; halting\n");
    while (true) { }
}

// GitHub issue #1013: kernel/lib/boot_once.tkb's refusal of a read before
// the boot write. A boot ordering bug, named so the console says which.
// Reached from interrupt handlers too, so it writes through DDB's spinning
// FIFO path rather than the logging queue.
fn boot_once_unwritten_stop() !{unsafe} {
    ddb_puts("boot once: read before its boot write (#1013) phase=" as *u8);
    if (boot_phase_is_ended()) { ddb_puts("ended\n" as *u8); }
    else { ddb_puts("open\n" as *u8); }
    kernel_invariant_stop();
}
