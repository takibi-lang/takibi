// What every platform does before it does anything platform-specific.
//
// GitHub issue #517: these eight steps opened `fn main()` in both
// kernel/platform/qemu/init.tkb and kernel/platform/rpi5/init.tkb,
// byte-identical. The order is load-bearing and none of it is a platform
// decision -- poison the two stacks before anything stands on them, bring the
// platform and the console up, prove the log's bounded-loss signals with a
// destructive probe, re-initialise after it, and only then say the kernel is
// at EL1.
//
// The probe is why kernel_log_init() appears twice. It deliberately overruns
// the ring to make the overwrite and truncation signals fire, so the log has
// to be reset afterwards; running it before the first real line means the
// evidence a boot leaves is never the probe's.
use "kernel/printk/log.tkb";

fn kernel_boot_prologue() !{logs, unsafe} {
    // First, before anything has had a chance to go deep: fill the unused
    // part of the boot stack with poison so its high-water mark can be
    // measured at the end of the run, exactly as a process stack's is.
    kernel_boot_stack_arm();
    // Nothing is standing on the IRQ stack yet, so the whole run can be
    // poisoned outright (issue #378).
    kernel_irq_stack_arm();
    platform_init();
    kernel_log_init();
    let log_bounds_ok: bool = kernel_log_bounds_probe();
    kernel_log_init();
    kernel_boot_log("takibi kernel: EL1\n");
    if (log_bounds_ok) {
        kernel_boot_log("kernel log: overwrite+line truncation reported\n");
    } else {
        kernel_boot_log("kernel log: bounds probe failed\n");
    }
}
