use "kernel/kernel/process.tkb";
use "kernel/kernel/syscall.tkb";
use "kernel/fs/initramfs.tkb";
use "kernel/fs/elf64.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/mm/process_image.tkb";
use "kernel/printk/log.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/platform/rpi5/usb_xhci.tkb";

private let mut ext2_read_fixture: [u8; 32];
private let mut ext2_symlink_fixture: [u8; 64];

must_use variant UsbExt2WriteCheckResult { Invalid; Verified; }
must_use variant UsbExt2ResizeCheckResult { Invalid; Verified; }

fn usb_ext2_equal_size_write_check(mount: Ext2Mount)
        -> UsbExt2WriteCheckResult {
    match ext2_lookup_root(mount, "mutable.txt" as []u8) {
        Ext2LookupResult::Invalid => {
            return UsbExt2WriteCheckResult::Invalid;
        }
        Ext2LookupResult::NotFound => {
            return UsbExt2WriteCheckResult::Invalid;
        }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_write_small_file(
                    mount, inode_number, "usb-ok\n" as []u8) {
                Ext2WriteResult::Invalid => {
                    return UsbExt2WriteCheckResult::Invalid;
                }
                Ext2WriteResult::Written => {
                    match ext2_read_small_file(
                            mount, inode_number,
                            ext2_read_fixture as []u8) {
                        Ext2ReadResult::Invalid => {
                            return UsbExt2WriteCheckResult::Invalid;
                        }
                        Ext2ReadResult::Read(length) => {
                            if (length == 7 &&
                                slice_eq(ext2_read_fixture[0..<7],
                                         "usb-ok\n" as []u8)) {
                                return UsbExt2WriteCheckResult::Verified;
                            }
                        }
                    }
                }
            }
        }
    }
    return UsbExt2WriteCheckResult::Invalid;
}

fn usb_ext2_resize_check(mount: Ext2Mount) -> UsbExt2ResizeCheckResult {
    match ext2_lookup_root(mount, "mutable.txt" as []u8) {
        Ext2LookupResult::Invalid => {
            return UsbExt2ResizeCheckResult::Invalid;
        }
        Ext2LookupResult::NotFound => {
            return UsbExt2ResizeCheckResult::Invalid;
        }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_resize_small_file(
                    mount, inode_number, "tiny\n" as []u8) {
                Ext2ResizeResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ResizeResult::Resized => { }
            }
            match ext2_read_small_file(
                    mount, inode_number, ext2_read_fixture as []u8) {
                Ext2ReadResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ReadResult::Read(short_length) => {
                    if (short_length != 5 ||
                        slice_eq(ext2_read_fixture[0..<5],
                                 "tiny\n" as []u8) == false) {
                        return UsbExt2ResizeCheckResult::Invalid;
                    }
                }
            }
            match ext2_resize_small_file(
                    mount, inode_number, "extended ext2\n" as []u8) {
                Ext2ResizeResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ResizeResult::Resized => { }
            }
            match ext2_read_small_file(
                    mount, inode_number, ext2_read_fixture as []u8) {
                Ext2ReadResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ReadResult::Read(long_length) => {
                    if (long_length == 14 &&
                        slice_eq(ext2_read_fixture[0..<14],
                                 "extended ext2\n" as []u8)) {
                        return UsbExt2ResizeCheckResult::Verified;
                    }
                }
            }
        }
    }
    return UsbExt2ResizeCheckResult::Invalid;
}

fn main() {
    platform_init();
    kernel_boot_log("takibi kernel: EL1\n");
    page_allocator_init();
    match disk_initialize() {
        DiskIoResult::Err(error) => {
            kernel_boot_log("usb msc: initialization failed\n");
        }
        DiskIoResult::Ok => {
            kernel_boot_log("usb msc: ready sector=512\n");
            match memory_block_device_ext2() {
                KernelBlockDeviceResult::Invalid => {
                    kernel_boot_log("usb ext2: source invalid\n");
                }
                KernelBlockDeviceResult::Ready(source_device) => {
                    match usb_mass_storage_block_device() {
                        KernelBlockDeviceResult::Invalid => {
                            kernel_boot_log("usb ext2: device invalid\n");
                        }
                        KernelBlockDeviceResult::Ready(usb_device) => {
                            match block_copy(source_device, usb_device, 1024) {
                                BlockCopyResult::Invalid => {
                                    kernel_boot_log("usb ext2: provision failed\n");
                                }
                                BlockCopyResult::Copied => {
                                    kernel_boot_log("usb ext2: provisioned blocks=1024\n");
                                    match ext2_mount(usb_device) {
                                        Ext2MountResult::Invalid => {
                                            kernel_boot_log("usb ext2: mount failed\n");
                                        }
                                        Ext2MountResult::Mounted(usb_mount) => {
                                            match usb_ext2_equal_size_write_check(
                                                    usb_mount) {
                                                UsbExt2WriteCheckResult::Invalid => {
                                                    kernel_boot_log("usb ext2: file write failed\n");
                                                }
                                                UsbExt2WriteCheckResult::Verified => {
                                                    kernel_boot_log("usb ext2: write /mutable.txt ok\n");
                                                }
                                            }
                                            match usb_ext2_resize_check(usb_mount) {
                                                UsbExt2ResizeCheckResult::Invalid => {
                                                    kernel_boot_log("usb ext2: resize failed\n");
                                                }
                                                UsbExt2ResizeCheckResult::Verified => {
                                                    kernel_boot_log("usb ext2: resize truncate+extend ok\n");
                                                }
                                            }
                                            match ext2_bitmap_roundtrip_check(usb_mount) {
                                                Ext2BitmapProbeResult::Invalid => {
                                                    kernel_boot_log("usb ext2: bitmap update failed\n");
                                                }
                                                Ext2BitmapProbeResult::Verified => {
                                                    kernel_boot_log("usb ext2: block+inode bitmap counts ok\n");
                                                }
                                            }
                                            match ext2_owner_roundtrip_check(usb_mount) {
                                                Ext2BitmapProbeResult::Invalid => {
                                                    kernel_boot_log("usb ext2: owner allocation failed\n");
                                                }
                                                Ext2BitmapProbeResult::Verified => {
                                                    kernel_boot_log("usb ext2: block+inode owners ok\n");
                                                }
                                            }
                                            match ext2_lookup_root(
                                                    usb_mount,
                                                    "hello.txt" as []u8) {
                                                Ext2LookupResult::Invalid => {
                                                    kernel_boot_log("usb ext2: lookup failed\n");
                                                }
                                                Ext2LookupResult::NotFound => {
                                                    kernel_boot_log("usb ext2: hello not found\n");
                                                }
                                                Ext2LookupResult::Found(usb_inode) => {
                                                    match ext2_read_small_file(
                                                            usb_mount, usb_inode,
                                                            ext2_read_fixture as []u8) {
                                                        Ext2ReadResult::Invalid => {
                                                            kernel_boot_log("usb ext2: read failed\n");
                                                        }
                                                        Ext2ReadResult::Read(usb_length) => {
                                                            if (usb_length == 16 &&
                                                                slice_eq(ext2_read_fixture[0..<16],
                                                                         "hello from ext2\n" as []u8)) {
                                                                kernel_boot_log("usb ext2: mounted /hello.txt ok\n");
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    match memory_block_device_ext2() {
        KernelBlockDeviceResult::Invalid => {
            kernel_boot_log("ext2 image: invalid\n");
        }
        KernelBlockDeviceResult::Ready(device) => {
            match ext2_mount(device) {
                Ext2MountResult::Invalid => {
                    kernel_boot_log("ext2 mount: invalid\n");
                }
                Ext2MountResult::Mounted(mount) => {
                    if (ext2_fixture_geometry_is_expected(mount)) {
                        kernel_boot_log("ext2 mount: block=1024 inodes=128 blocks=1024\n");
                    }
                    match ext2_lookup_root(mount, "hello.txt" as []u8) {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 lookup: invalid\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 lookup: not found\n");
                        }
                        Ext2LookupResult::Found(inode_number) => {
                            match ext2_read_small_file(
                                    mount, inode_number,
                                    ext2_read_fixture as []u8) {
                                Ext2ReadResult::Invalid => {
                                    kernel_boot_log("ext2 read: invalid\n");
                                }
                                Ext2ReadResult::Read(length) => {
                                    if (length == 16 &&
                                        slice_eq(ext2_read_fixture[0..<16],
                                                 "hello from ext2\n" as []u8)) {
                                        kernel_boot_log("ext2 read: /hello.txt ok\n");
                                    }
                                }
                            }
                        }
                    }
                    match ext2_lookup_root(mount, "mutable.txt" as []u8) {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 write: invalid lookup\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 write: not found\n");
                        }
                        Ext2LookupResult::Found(mutable_inode) => {
                            match ext2_write_small_file(
                                    mount, mutable_inode, "after!\n" as []u8) {
                                Ext2WriteResult::Invalid => {
                                    kernel_boot_log("ext2 write: invalid\n");
                                }
                                Ext2WriteResult::Written => {
                                    match ext2_read_small_file(
                                            mount, mutable_inode,
                                            ext2_read_fixture as []u8) {
                                        Ext2ReadResult::Invalid => {
                                            kernel_boot_log("ext2 write: reread failed\n");
                                        }
                                        Ext2ReadResult::Read(written_length) => {
                                            if (written_length == 7 &&
                                                slice_eq(ext2_read_fixture[0..<7],
                                                         "after!\n" as []u8)) {
                                                kernel_boot_log("ext2 write: /mutable.txt ok\n");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    match ext2_lookup_root(mount, "latest" as []u8) {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 symlink: invalid lookup\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 symlink: not found\n");
                        }
                        Ext2LookupResult::Found(link_inode) => {
                            match ext2_read_fast_symlink(
                                    mount, link_inode,
                                    ext2_symlink_fixture as []u8) {
                                Ext2SymlinkResult::Invalid => {
                                    kernel_boot_log("ext2 symlink: invalid\n");
                                }
                                Ext2SymlinkResult::Read(target_length) => {
                                    if (target_length == 9 &&
                                        slice_eq(ext2_symlink_fixture[0..<9],
                                                 "hello.txt" as []u8)) {
                                        match ext2_lookup_root(
                                                mount,
                                                ext2_symlink_fixture[0..<9]) {
                                            Ext2LookupResult::Invalid => { }
                                            Ext2LookupResult::NotFound => { }
                                            Ext2LookupResult::Found(target_inode) => {
                                                match ext2_read_small_file(
                                                        mount, target_inode,
                                                        ext2_read_fixture as []u8) {
                                                    Ext2ReadResult::Invalid => { }
                                                    Ext2ReadResult::Read(linked_length) => {
                                                        if (linked_length == 16 &&
                                                            slice_eq(ext2_read_fixture[0..<16],
                                                                     "hello from ext2\n" as []u8)) {
                                                            kernel_boot_log("ext2 symlink: /latest -> hello.txt ok\n");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    match initramfs_busybox() {
        InitramfsFileResult::Invalid => {
            kernel_boot_log("distro image: invalid initramfs\n");
        }
        InitramfsFileResult::File(image) => {
            let (image_address, image_length) = image;
            match distro_elf_validate(image_address, image_length) {
                DistroElfResult::Invalid => {
                    kernel_boot_log("distro image: invalid elf\n");
                }
                DistroElfResult::Valid(plan) => {
                    if (plan.entry == 0x4524 && plan.load_segments == 2 &&
                        plan.extent == 0x122138) {
                        kernel_boot_log("distro image: alpine busybox static-pie\n");
                        kernel_boot_log("distro elf: aarch64 loads=2 extent=0x122138\n");
                        match process_image_map(plan) {
                            ProcessImageMapResult::InvalidImage => {
                                kernel_boot_log("distro map: invalid image\n");
                            }
                            ProcessImageMapResult::OutOfMemory => {
                                kernel_boot_log("distro map: out of memory\n");
                            }
                            ProcessImageMapResult::Mapped(image_pages) => {
                                if (process_image_page_count(image_pages) == 401) {
                                    kernel_boot_log("distro map: pages=401 rx+rw-xn heap+stack=rw+xn\n");
                                }
                                if (process_image_gap_is_unmapped()) {
                                    kernel_boot_log("distro load: file bytes match bss=zero gap=unmapped\n");
                                }
                                if (process_image_entry(image_pages) == 0x40004524 &&
                                    process_image_stack_pointer(image_pages) == 0x401FFE00) {
                                    kernel_boot_log("distro stack: argc=3 argv auxv ready\n");
                                }
                                let (heap_start, heap_limit) =
                                    process_image_heap_range(image_pages);
                                kernel_syscall_process_configure(heap_start, heap_limit);
                                let busybox_status: usize = run_initial_user(
                                    process_image_entry(image_pages),
                                    process_image_stack_pointer(image_pages));
                                if (busybox_status == 0) {
                                    kernel_boot_log("busybox exit: 0\n");
                                } else {
                                    kernel_boot_log("busybox failed\n");
                                }
                                process_image_unmap(image_pages);
                                if (process_image_window_is_clear()) {
                                    kernel_boot_log("distro unmap: clean\n");
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    match initial_process_create() {
        ProcessCreateResult::OutOfMemory => {
            kernel_boot_log("initial process: allocation failed\n");
        }
        ProcessCreateResult::Created(resources) => {
            let (process, text, data, stack) = resources;
            kernel_boot_log("initial process: ready\n");
            match initial_user_load(text) {
                InitialUserLoadResult::TooLarge => {
                    kernel_boot_log("initial user: image too large\n");
                    initial_process_destroy(process, text, data, stack);
                }
                InitialUserLoadResult::Loaded => {
                    let empty = address_space_new();
                    let (text_space, text_mapping) = map_user_text(empty, text);
                    let (data_space, data_mapping) = map_user_data(text_space, data);
                    let (ready_space, stack_mapping) = map_user_stack(data_space, stack);
                    if (user_layout_is_correct()) {
                        kernel_boot_log("vm layout: text=rx data=rw+xn stack=rw+xn\n");
                    }
                    let exit_status: usize =
                        run_initial_user(USER_TEXT_VA, USER_STACK_VA + PAGE_SIZE);
                    if (exit_status == 0) {
                        kernel_boot_log("syscall write errors: ebadf efault\n");
                        kernel_boot_log("syscall exit: 0\n");
                    }
                    let (data_space2, stack2) =
                        unmap_user_stack(ready_space, stack_mapping);
                    let (text_space2, data2) =
                        unmap_user_data(data_space2, data_mapping);
                    let (empty2, text2) =
                        unmap_user_text(text_space2, text_mapping);
                    address_space_free(empty2);
                    initial_process_destroy(process, text2, data2, stack2);
                }
            }
            if (page_allocator_live_count() == 0) {
                kernel_boot_log("resources: pages=0\n");
            }
        }
    }
    while (true) { }
}
