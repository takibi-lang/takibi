// The ext2 fixture every platform runs, and the probes that mutate it.
//
// One body, for two reasons that arrived together (GitHub issue #517).
//
// It was DUPLICATED: 150-odd lines sat in kernel/platform/qemu/init.tkb and
// kernel/platform/rpi5/init.tkb, differing in code by exactly one block. The
// two platform trees are never compiled together, so a fixture step added to
// one and not the other is invisible until a board boots.
//
// And that one block was a COVERAGE GAP. QEMU's mutation probes ran here
// while the board skipped them. Both platforms now run the checks retained
// below: bitmap and owner round trips are kernel-internal, and creating a
// regular file WITH content in one step is no syscall's shape (openat's
// O_CREAT makes an empty file, which the ash fixture's payload exercises).
// File reads and directory growth moved to the shared ash fixture, where
// userspace checks their contents and directory size through Linux syscalls.
// The board provisions its filesystem fresh onto USB on every boot, so these
// kernel-side mutation probes cannot outlive the run that made them.
//
// So the union is what both platforms now run, and `ext2_mutation` became a
// common view rather than a QEMU-only one.
use "kernel/fs/ext2/ext2.tkb";
use "kernel/printk/log.tkb";
use "kernel/arch/arm64/kernel/timer.tkb";

const EXT2_WRITE_FIXTURE_BYTES: usize = 13 * KERNEL_BLOCK_SIZE;
// This fixture runs once in boot on core 0, before userspace or peers can
// reach the rootfs. Its buffers are shared only across its own calls.
private let mut ext2_write_fixture_source: [u8; EXT2_WRITE_FIXTURE_BYTES];
private let mut ext2_write_fixture_readback: [u8; KERNEL_BLOCK_SIZE];
private let mut ext2_write_fixture_bitmap: [u8; KERNEL_BLOCK_SIZE];

private fn ext2_write_fixture_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "stands in for a boot-phase assumption (core 0, before any process exists); review at the preemption flip (GitHub issue #638)");
}

private fn ext2_write_fixture_counts_match(mount: Ext2Mount,
                                           blocks: usize, inodes: usize)
        -> bool {
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (now_blocks, now_inodes) = counts;
            return now_blocks == blocks && now_inodes == inodes;
        }
    }
}

private fn ext2_write_fixture_sectors_match(mount: Ext2Mount,
                                            inode_number: usize,
                                            expected: usize) -> bool {
    match ext2_regular_file_allocated_sectors(mount, inode_number) {
        Ext2CountResult::Invalid => { return false; }
        Ext2CountResult::Counted(sectors) => {
            return sectors == expected;
        }
    }
}

must_use variant Ext2ExhaustionMode { Invalid; Interactive; Integration; }

// Only the finite sysinit image runs user_payload and releases the fillers.
// Interactive images skip sysinit, so they must retain their normal space.
private fn ext2_exhaustion_mode(mount: Ext2Mount) -> Ext2ExhaustionMode {
    let mut inode: usize = 0;
    match ext2_lookup_path(mount, bs"etc/inittab") {
        Ext2LookupResult::Invalid => { return Ext2ExhaustionMode::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2ExhaustionMode::Invalid; }
        Ext2LookupResult::Found(found) => { inode = found; }
    }
    let mut length: usize = 0;
    match ext2_read_small_file(mount, inode,
                               ext2_write_fixture_readback as []u8) {
        Ext2ReadResult::Invalid => { return Ext2ExhaustionMode::Invalid; }
        Ext2ReadResult::Read(found) => { length = found; }
    }
    let marker: []const u8 = bs"::sysinit:/etc/init.sh\n";
    for start: usize in 0..<KERNEL_BLOCK_SIZE {
        let mut line_start: bool = start == 0;
        if (start > 0) {
            line_start = ext2_write_fixture_readback[start - 1] == 0x0A;
        }
        if (line_start) {
            let mut matches: bool = true;
            for byte: usize in 0..<marker.len {
                let index: usize = start + byte;
                if (index < KERNEL_BLOCK_SIZE && index < length) {
                    if (ext2_write_fixture_readback[index] != marker[byte]) {
                        matches = false;
                    }
                } else { matches = false; }
            }
            if (matches) { return Ext2ExhaustionMode::Integration; }
        }
    }
    return Ext2ExhaustionMode::Interactive;
}

// Fillers are ordinary linked files. A one-byte range write fills the gap
// through the production allocator without a volume-sized source buffer.
// EL0 shrinks and removes both after observing ENOSPC; no test syscall or
// unowned bitmap reservation is carried across userspace execution.
private fn ext2_exhaustion_filler(mount: Ext2Mount, name: []const u8,
                                  blocks: usize) -> bool {
    if (blocks == 0 || blocks > EXT2_MAX_SINGLE_FILE_BLOCKS) { return false; }
    match ext2_create_root_file(mount, name, bs"x") {
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::NoSpace => { return false; }
        Ext2CreateResult::Created(linked) => { ext2_linked_file_keep(linked); }
    }
    match ext2_lookup_root(mount, name) {
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
        Ext2LookupResult::Found(inode) => {
            match ext2_write_regular_file_range(
                    mount, inode, (blocks * KERNEL_BLOCK_SIZE - 1) as usize, bs"x") {
                Ext2ResizeResult::Resized => { return true; }
                Ext2ResizeResult::Invalid => { return false; }
                Ext2ResizeResult::NoSpace => { return false; }
                Ext2ResizeResult::Fenced => { return false; }
            }
        }
    }
}

// Leave thirteen real free blocks: the thirteen data blocks can be staged,
// but the fourteenth claim, for the indirect block, must roll them back.
// The original file and the complete bitmap must survive before EL0 runs.
private fn ext2_write_exhaustion_check(mount: Ext2Mount) -> bool {
    ext2_write_fixture_execution_model_assumption();
    let mut free: usize = 0;
    let mut inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inode_count) = counts;
            free = blocks;
            inodes = inode_count;
        }
    }
    // Stay within the maintained single-group fixture, with at most two
    // singly-indirect fillers. Leave room to create the second file.
    if (free < 32 || free > 540 ||
        ext2_fixture_geometry_is_expected(mount) == false) { return false; }
    let mut first: usize = free - 16;
    if (first > EXT2_MAX_SINGLE_FILE_BLOCKS) {
        first = EXT2_MAX_SINGLE_FILE_BLOCKS;
    }
    // A singly-indirect file jumps from twelve allocations to fourteen;
    // thirteen cannot be represented. Shift one block to the second file
    // when the first file would leave that gap in the remaining budget.
    if (free - first == 27) { first = first - 1; }
    if (ext2_exhaustion_filler(mount, bs"enospc-a", first) == false) {
        return false;
    }
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inode_count) = counts;
            free = blocks;
        }
    }
    // Creation uses one block. Replacement stages data (+ one pointer when
    // needed) and returns that old block, so the net allocation is data+ptr.
    if (free <= 13) { return false; }
    let mut second: usize = free - 13;
    if (second > EXT2_MAX_DIRECT_BLOCKS) { second = second - 1; }
    if (ext2_exhaustion_filler(mount, bs"enospc-b", second) == false ||
        ext2_write_fixture_counts_match(mount, 13, inodes - 2) == false) {
        return false;
    }
    let mut inode: usize = 0;
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
        Ext2LookupResult::Found(found) => { inode = found; }
    }
    if (ext2_io_file_is(mount, inode, false, false) == false) { return false; }
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_bitmap as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    match ext2_resize_small_file(mount, inode, ext2_write_fixture_source as []u8) {
        Ext2ResizeResult::NoSpace => { }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Resized => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
    }
    return ext2_io_file_is(mount, inode, false, false) &&
           ext2_io_bitmap_matches(mount) &&
           ext2_write_fixture_counts_match(mount, 13, inodes - 2) &&
           ext2_counters_match_bitmaps(mount);
}

// GitHub issue #698: with one bitmap full, mkdir and create answer NoSpace
// and leave everything as it was -- in particular the block the inode-full
// case claimed before its inode claim failed. After the bitmap is put back,
// the same two names are created and removed again: the control that the
// refusal was the full bitmap and not the name or the directory.
// The saved bitmap lives in a page taken for the fixture's duration, not in
// BSS: a test-only buffer must not cost the production image its page
// reservation (a 1 KiB BSS array moved usable_ram_start by 32 KiB).

private fn ext2_full_names_absent(mount: Ext2Mount) -> bool {
    match ext2_lookup_root(mount, bs"full-dir") {
        Ext2LookupResult::NotFound => { }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::Found(existing) => { return false; }
    }
    match ext2_lookup_root(mount, bs"full-file") {
        Ext2LookupResult::NotFound => { return true; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::Found(existing) => { return false; }
    }
}

private fn ext2_full_refuses(mount: Ext2Mount) -> bool {
    let mut refused: bool = true;
    match ext2_make_directory_in(mount, 2, bs"full-dir") {
        Ext2MkdirResult::NoSpace => { }
        Ext2MkdirResult::Invalid => { refused = false; }
        Ext2MkdirResult::Created(directory) => {
            match ext2_remove_directory_in(mount, 2, directory, bs"full-dir") {
                Ext2RmdirResult::Removed => { }
                Ext2RmdirResult::Invalid => { }
                Ext2RmdirResult::NotEmpty(kept) => { ext2_directory_keep(kept); }
                Ext2RmdirResult::Refused(kept) => { ext2_directory_keep(kept); }
            }
            refused = false;
        }
    }
    match ext2_create_root_file(mount, bs"full-file", bs"x") {
        Ext2CreateResult::NoSpace => { }
        Ext2CreateResult::Invalid => { refused = false; }
        Ext2CreateResult::Created(linked) => {
            match ext2_unlink_root_file(mount, linked, bs"full-file") {
                Ext2UnlinkResult::Invalid => { }
                Ext2UnlinkResult::Unlinked => { }
            }
            refused = false;
        }
    }
    return refused;
}

private fn ext2_full_control(mount: Ext2Mount) -> bool {
    let mut ok: bool = false;
    match ext2_make_directory_in(mount, 2, bs"full-dir") {
        Ext2MkdirResult::NoSpace => { }
        Ext2MkdirResult::Invalid => { }
        Ext2MkdirResult::Created(directory) => {
            match ext2_remove_directory_in(mount, 2, directory, bs"full-dir") {
                Ext2RmdirResult::Removed => { ok = true; }
                Ext2RmdirResult::Invalid => { }
                Ext2RmdirResult::NotEmpty(kept) => { ext2_directory_keep(kept); }
                Ext2RmdirResult::Refused(kept) => { ext2_directory_keep(kept); }
            }
        }
    }
    match ext2_create_root_file(mount, bs"full-file", bs"x") {
        Ext2CreateResult::NoSpace => { return false; }
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::Created(linked) => {
            match ext2_unlink_root_file(mount, linked, bs"full-file") {
                Ext2UnlinkResult::Invalid => { return false; }
                Ext2UnlinkResult::Unlinked => { return ok; }
            }
        }
    }
}

private fn ext2_full_check_one(mount: Ext2Mount, inode_bitmap: bool,
                               blocks: usize, inodes: usize) -> bool {
    match page_alloc(PageOwnerTag::BootFixture) {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(page) => {
            let bytes: [u8; PAGE_SIZE..] = page_bytes(page);
            let ok: bool = ext2_full_check_in(mount, inode_bitmap, blocks,
                    inodes, bytes[0..<KERNEL_BLOCK_SIZE]);
            page_free(page);
            return ok;
        }
    }
}

private fn ext2_full_check_in(mount: Ext2Mount, inode_bitmap: bool,
                              blocks: usize, inodes: usize,
                              saved: borrow [u8; KERNEL_BLOCK_SIZE..]) -> bool {
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_bitmap as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    let mut ok: bool = false;
    match ext2_bitmap_fill(mount, inode_bitmap,
            saved) {
        Ext2BitmapFillResult::Invalid => { return false; }
        Ext2BitmapFillResult::Filled(fill) => {
            let marked: usize = ext2_bitmap_fill_marked(fill);
            let mut full_blocks: usize = blocks;
            let mut full_inodes: usize = inodes - marked;
            if (inode_bitmap == false) {
                full_blocks = blocks - marked;
                full_inodes = inodes;
            }
            // The inode-full case must leave the block bitmap bit for bit
            // as it was; the block-full case cannot claim an inode at all.
            ok = marked > 0 && (full_blocks == 0 || full_inodes == 0) &&
                 ext2_write_fixture_counts_match(mount, full_blocks,
                                                 full_inodes) &&
                 ext2_full_refuses(mount) &&
                 ext2_write_fixture_counts_match(mount, full_blocks,
                                                 full_inodes) &&
                 ext2_full_names_absent(mount) &&
                 ext2_counters_match_bitmaps(mount);
            if (inode_bitmap) { ok = ok && ext2_io_bitmap_matches(mount); }
            match ext2_bitmap_fill_restore(mount, fill,
                    saved) {
                Ext2OwnerReleaseResult::Invalid => { return false; }
                Ext2OwnerReleaseResult::Released => { }
            }
        }
    }
    return ok && ext2_io_bitmap_matches(mount) &&
           ext2_write_fixture_counts_match(mount, blocks, inodes) &&
           ext2_counters_match_bitmaps(mount);
}

fn ext2_full_check(mount: Ext2Mount) -> bool {
    ext2_write_fixture_execution_model_assumption();
    let mut blocks: usize = 0;
    let mut inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (free_blocks, free_inodes) = counts;
            blocks = free_blocks;
            inodes = free_inodes;
        }
    }
    return ext2_full_check_one(mount, false, blocks, inodes) &&
           ext2_full_check_one(mount, true, blocks, inodes) &&
           ext2_full_control(mount) &&
           ext2_write_fixture_counts_match(mount, blocks, inodes) &&
           ext2_counters_match_bitmaps(mount);
}

private fn ext2_write_indirect_check(mount: Ext2Mount) -> bool {
    ext2_write_fixture_execution_model_assumption();
    let mut before_blocks: usize = 0;
    let mut before_inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            before_blocks = blocks;
            before_inodes = inodes;
        }
    }
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_bitmap as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    let mut inode_number: usize = 0;
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
        Ext2LookupResult::Found(found) => { inode_number = found; }
    }
    match ext2_read_small_file(mount, inode_number,
                               ext2_read_fixture as []u8) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != 7 ||
                slice_eq(ext2_read_fixture[0..<7], bs"before\n") == false) {
                return false;
            }
        }
    }
    if (ext2_write_fixture_sectors_match(mount, inode_number, 2) == false) {
        return false;
    }
    for index: usize in 0..<EXT2_WRITE_FIXTURE_BYTES {
        ext2_write_fixture_source[index] =
            ((index * 37 + 11) % 251) as u8;
    }
    // Three blocks are allocated and filled; the fourth claim is refused.
    // The unchanged file and free counts prove that the prefix was rolled
    // back before the inode could name any of it.
    match ext2_replace_regular_file(
            mount, inode_number, ext2_write_fixture_source as []u8, 3) {
        Ext2ResizeResult::Resized => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { }
    }
    if (ext2_write_fixture_counts_match(
            mount, before_blocks, before_inodes) == false) {
        return false;
    }
    if (ext2_write_fixture_sectors_match(mount, inode_number, 2) == false) {
        return false;
    }
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_readback as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    for index: usize in 0..<KERNEL_BLOCK_SIZE {
        if (ext2_write_fixture_bitmap[index] !=
            ext2_write_fixture_readback[index]) {
            return false;
        }
    }
    match ext2_read_small_file(mount, inode_number,
                               ext2_read_fixture as []u8) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != 7 ||
                slice_eq(ext2_read_fixture[0..<7], bs"before\n") == false) {
                return false;
            }
        }
    }
    match ext2_resize_small_file(
            mount, inode_number, ext2_write_fixture_source as []u8) {
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
        Ext2ResizeResult::Resized => { }
    }
    if (ext2_regular_file_size(mount, inode_number) !=
        EXT2_WRITE_FIXTURE_BYTES ||
        ext2_write_fixture_sectors_match(mount, inode_number, 28) == false ||
        ext2_write_fixture_counts_match(
            mount, before_blocks - 13, before_inodes) == false) {
        return false;
    }
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
        Ext2LookupResult::Found(reopened) => {
            if (reopened != inode_number) { return false; }
            for block: usize in 0..<13 {
                match ext2_read_file_chunk(
                        mount, reopened, block * KERNEL_BLOCK_SIZE,
                        ext2_write_fixture_readback as []u8) {
                    Ext2ReadResult::Invalid => { return false; }
                    Ext2ReadResult::Read(length) => {
                        if (length != KERNEL_BLOCK_SIZE) { return false; }
                    }
                }
                for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                    if (ext2_write_fixture_readback[byte] !=
                        ext2_write_fixture_source[
                            block * KERNEL_BLOCK_SIZE + byte]) {
                        return false;
                    }
                }
            }
        }
    }
    match ext2_resize_small_file(mount, inode_number, bs"") {
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
        Ext2ResizeResult::Resized => { }
    }
    if (ext2_regular_file_size(mount, inode_number) != 0 ||
        ext2_write_fixture_sectors_match(mount, inode_number, 0) == false ||
        ext2_write_fixture_counts_match(
            mount, before_blocks + 1, before_inodes) == false) {
        return false;
    }
    match ext2_resize_small_file(
            mount, inode_number, ext2_write_fixture_source as []u8) {
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
        Ext2ResizeResult::Resized => { }
    }
    if (ext2_write_fixture_counts_match(
            mount, before_blocks - 13, before_inodes) == false) {
        return false;
    }
    if (ext2_write_fixture_sectors_match(mount, inode_number, 28) == false) {
        return false;
    }
    match ext2_resize_small_file(mount, inode_number, bs"before\n") {
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
        Ext2ResizeResult::Resized => { }
    }
    return ext2_write_fixture_counts_match(
        mount, before_blocks, before_inodes) &&
        ext2_write_fixture_sectors_match(mount, inode_number, 2);
}

// The ext2 mutation helpers. They were reachable only from the QEMU fixture
// until this file existed; both platforms run them now, and `ext2_mutation`
// is a common view.
fn ext2_create_check(mount: Ext2Mount) -> bool {
    match ext2_create_root_file(
            mount, bs"created.txt", bs"created on ext2\n") {
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::NoSpace => { return false; }
        Ext2CreateResult::Created(linked) => {
            let mut content_ok: bool = false;
            match ext2_lookup_root(mount, bs"created.txt") {
                Ext2LookupResult::Found(inode_number) => {
                    match ext2_read_small_file(
                            mount, inode_number, ext2_read_fixture as []u8) {
                        Ext2ReadResult::Read(length) => {
                            content_ok = length == 16 &&
                                slice_eq(ext2_read_fixture[0..<16],
                                         bs"created on ext2\n");
                        }
                        Ext2ReadResult::Invalid => { }
                    }
                }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::NotFound => { }
            }
            match ext2_unlink_root_file(mount, linked, bs"created.txt") {
                Ext2UnlinkResult::Invalid => { return false; }
                Ext2UnlinkResult::Unlinked => { }
            }
            match ext2_lookup_root(mount, bs"created.txt") {
                Ext2LookupResult::NotFound => { return content_ok; }
                Ext2LookupResult::Invalid => { return false; }
                Ext2LookupResult::Found(existing) => { return false; }
            }
        }
    }
}

// GitHub issue #537: the same round trip, in a directory that is not the
// root. Before this, the kernel could find `/etc/init.sh` and could not
// create a file beside it -- the mutation paths read inode 2 by name while
// lookup next door already walked any directory.
//
// `/etc` is used because the fixture already builds it and BusyBox already
// reads from it, so this asserts against a directory the rest of the boot
// depends on rather than one invented for the test.
fn ext2_create_in_directory_check(mount: Ext2Mount) -> bool {
    let mut directory: usize = 0;
    match ext2_lookup_root(mount, bs"etc") {
        Ext2LookupResult::Found(inode_number) => { directory = inode_number; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    if (directory == 2) { return false; }
    match ext2_create_file_in(mount, directory, bs"nested.txt",
                              bs"created in /etc\n") {
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::NoSpace => { return false; }
        Ext2CreateResult::Created(linked) => {
            let mut content_ok: bool = false;
            match ext2_lookup_directory(mount, directory, bs"nested.txt") {
                Ext2LookupResult::Found(inode_number) => {
                    match ext2_read_small_file(
                            mount, inode_number, ext2_read_fixture as []u8) {
                        Ext2ReadResult::Read(length) => {
                            content_ok = length == 16 &&
                                slice_eq(ext2_read_fixture[0..<16],
                                         bs"created in /etc\n");
                        }
                        Ext2ReadResult::Invalid => { }
                    }
                }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::NotFound => { }
            }
            // The root must not have gained it: a mutation that ignored its
            // directory argument would still pass every check above.
            let mut root_clean: bool = false;
            match ext2_lookup_root(mount, bs"nested.txt") {
                Ext2LookupResult::NotFound => { root_clean = true; }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::Found(existing) => { }
            }
            match ext2_unlink_file_in(mount, directory, linked,
                                      bs"nested.txt") {
                Ext2UnlinkResult::Invalid => { return false; }
                Ext2UnlinkResult::Unlinked => { }
            }
            match ext2_lookup_directory(mount, directory, bs"nested.txt") {
                Ext2LookupResult::NotFound => {
                    return content_ok && root_clean;
                }
                Ext2LookupResult::Invalid => { return false; }
                Ext2LookupResult::Found(existing) => { return false; }
            }
        }
    }
}

// GitHub issue #595: one failed block read or write at every point of a
// regular-file mutation, and a device that keeps failing.
//
// The sweep does not name the four phases (claim, staged data and pointer
// write, inode publication, old-block release). It moves the failure across
// every device write the mutation makes, so each phase is hit at each of its
// own writes, and the classification says what the mutation is allowed to
// have become: rolled back exactly, committed exactly, or -- only when the
// device keeps failing -- fenced. Every verdict is read back through a fresh
// mount: file bytes, i_size, i_blocks, bitmap and both free counts.
must_use variant Ext2IoCase { Broken; Clean; RolledBack; Committed; Fenced; }

const EXT2_IO_SWEEP_LIMIT: usize = 96;
const EXT2_IO_SMALL_BYTES: usize = 2 * KERNEL_BLOCK_SIZE;

private fn ext2_io_blocks(large: bool) -> usize {
    if (large) { return 13; }
    return 2;
}

// The blocks a payload of this size occupies, pointer block included.
private fn ext2_io_sectors(large: bool) -> usize {
    if (large) { return 28; }
    return 4;
}

private fn ext2_io_bitmap_matches(mount: Ext2Mount) -> bool {
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_readback as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    for index: usize in 0..<KERNEL_BLOCK_SIZE {
        if (ext2_write_fixture_readback[index] !=
            ext2_write_fixture_bitmap[index]) {
            return false;
        }
    }
    return true;
}

// The file holds the payload (`payload`) or the fixture's original seven
// bytes, in size, sectors and every byte.
private fn ext2_io_file_is(mount: Ext2Mount, inode: usize, large: bool,
                           payload: bool) -> bool {
    if (payload == false) {
        if (ext2_regular_file_size(mount, inode) != 7 ||
            ext2_write_fixture_sectors_match(mount, inode, 2) == false) {
            return false;
        }
        match ext2_read_small_file(mount, inode, ext2_read_fixture as []u8) {
            Ext2ReadResult::Invalid => { return false; }
            Ext2ReadResult::Read(length) => {
                return length == 7 &&
                       slice_eq(ext2_read_fixture[0..<7], bs"before\n");
            }
        }
    }
    let blocks: usize = ext2_io_blocks(large);
    if (ext2_regular_file_size(mount, inode) != blocks * KERNEL_BLOCK_SIZE ||
        ext2_write_fixture_sectors_match(
            mount, inode, ext2_io_sectors(large)) == false) {
        return false;
    }
    for block: usize in 0..<13 {
        if (block < blocks) {
            match ext2_read_file_chunk(
                    mount, inode, block * KERNEL_BLOCK_SIZE,
                    ext2_write_fixture_readback as []u8) {
                Ext2ReadResult::Invalid => { return false; }
                Ext2ReadResult::Read(length) => {
                    if (length != KERNEL_BLOCK_SIZE) { return false; }
                }
            }
            for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                if (ext2_write_fixture_readback[byte] !=
                    ext2_write_fixture_source[block * KERNEL_BLOCK_SIZE + byte]) {
                    return false;
                }
            }
        }
    }
    return true;
}

// Run the replacement with a failure armed and classify what it left. Every
// check goes through a mount made afresh from the device.
private fn ext2_io_case(mount: Ext2Mount, inode: usize, large: bool,
                        on_write: bool, skip: usize, sticky: bool,
                        base_blocks: usize, base_inodes: usize)
        -> Ext2IoCase {
    let mut outcome: usize = 0;
    // The bitmap as it is now is what a rolled-back call must leave. It is
    // taken per call because a replacement is copy-on-write: a file that went
    // out and came back lives in other blocks than it began in.
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_bitmap as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return Ext2IoCase::Broken; }
        Ext2ReadResult::Read(length) => { }
    }
    block_fault_arm(on_write, skip, sticky);
    if (large) {
        match ext2_replace_regular_file(
                mount, inode, ext2_write_fixture_source as []u8,
                EXT2_MAX_WRITE_ALLOCATIONS) {
            Ext2ResizeResult::Resized => { outcome = 0; }
            Ext2ResizeResult::NoSpace => { outcome = 1; }
            Ext2ResizeResult::Invalid => { outcome = 1; }
            Ext2ResizeResult::Fenced => { outcome = 2; }
        }
    } else {
        match ext2_replace_regular_file(
                mount, inode, ext2_write_fixture_source[0..<EXT2_IO_SMALL_BYTES],
                EXT2_MAX_WRITE_ALLOCATIONS) {
            Ext2ResizeResult::Resized => { outcome = 0; }
            Ext2ResizeResult::NoSpace => { outcome = 1; }
            Ext2ResizeResult::Invalid => { outcome = 1; }
            Ext2ResizeResult::Fenced => { outcome = 2; }
        }
    }
    let injected: usize = block_fault_disarm();
    if (outcome == 2) {
        if (ext2_is_fenced() == false) { return Ext2IoCase::Broken; }
        return Ext2IoCase::Fenced;
    }
    if (ext2_is_fenced()) { return Ext2IoCase::Broken; }
    match ext2_mount(ext2_mount_device(mount)) {
        Ext2MountResult::Invalid => { return Ext2IoCase::Broken; }
        Ext2MountResult::Mounted(fresh) => {
            let blocks: usize = ext2_io_blocks(large);
            if (outcome == 1) {
                // Rolled back: the state before the call, exactly.
                if (injected == 0 ||
                    ext2_io_file_is(fresh, inode, large, false) == false ||
                    ext2_write_fixture_counts_match(
                        fresh, base_blocks, base_inodes) == false ||
                    ext2_io_bitmap_matches(fresh) == false) {
                    return Ext2IoCase::Broken;
                }
                return Ext2IoCase::RolledBack;
            }
            // Committed: the new file, its blocks taken and the old one given
            // back, and the counters agreeing with the bitmap.
            let mut pointer: usize = 0;
            if (large) { pointer = 1; }
            if (ext2_io_file_is(fresh, inode, large, true) == false ||
                ext2_write_fixture_counts_match(
                    fresh, base_blocks - (blocks + pointer) + 1,
                    base_inodes) == false) {
                return Ext2IoCase::Broken;
            }
            if (ext2_counters_match_bitmaps(fresh) == false) {
                return Ext2IoCase::Broken;
            }
            if (injected == 0) { return Ext2IoCase::Clean; }
            return Ext2IoCase::Committed;
        }
    }
}

// Put the fixture file back to its original seven bytes with the device
// healthy, recovering the mount first when it was fenced, and check that the
// bitmap and counters are the ones the fixture started with.
private fn ext2_io_restore(mount: Ext2Mount, inode: usize,
                           base_blocks: usize, base_inodes: usize) -> bool {
    if (ext2_is_fenced()) {
        match ext2_recover(mount) {
            Ext2RecoverResult::Failed => { return false; }
            Ext2RecoverResult::Recovered => { }
        }
    }
    match ext2_resize_small_file(mount, inode, bs"before\n") {
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Fenced => { return false; }
        Ext2ResizeResult::Resized => { }
    }
    return ext2_io_file_is(mount, inode, false, false) &&
           ext2_write_fixture_counts_match(mount, base_blocks, base_inodes) &&
           ext2_counters_match_bitmaps(mount);
}

// Fail one access of the chosen kind at each position from `first` on, until
// a run finishes before reaching the position. False on any broken verdict.
private fn ext2_io_sweep(mount: Ext2Mount, inode: usize, large: bool,
                         on_write: bool, first: usize, last: usize,
                         base_blocks: usize, base_inodes: usize) -> bool {
    let mut done: bool = false;
    for skip: usize in 0..<EXT2_IO_SWEEP_LIMIT {
        if (done == false && skip >= first && skip <= last) {
            match ext2_io_case(mount, inode, large, on_write, skip, false,
                               base_blocks, base_inodes) {
                Ext2IoCase::Broken => { return false; }
                Ext2IoCase::Fenced => { return false; }
                Ext2IoCase::Clean => { done = true; }
                Ext2IoCase::RolledBack => { }
                Ext2IoCase::Committed => { }
            }
            if (ext2_io_restore(mount, inode, base_blocks, base_inodes) == false) {
                return false;
            }
        }
    }
    return true;
}

// A device that keeps failing from write number `skip` on: the mutation must
// end Fenced, refuse the next one with the device healthy again, and leave
// the mount consistent once ext2_recover has run.
private fn ext2_io_fence(mount: Ext2Mount, inode: usize, skip: usize,
                         committed: bool, base_blocks: usize,
                         base_inodes: usize) -> bool {
    match ext2_io_case(mount, inode, false, true, skip, true,
                       base_blocks, base_inodes) {
        Ext2IoCase::Fenced => { }
        Ext2IoCase::Broken => { return false; }
        Ext2IoCase::Clean => { return false; }
        Ext2IoCase::RolledBack => { return false; }
        Ext2IoCase::Committed => { return false; }
    }
    match ext2_replace_regular_file(
            mount, inode, ext2_write_fixture_source[0..<EXT2_IO_SMALL_BYTES],
            EXT2_MAX_WRITE_ALLOCATIONS) {
        Ext2ResizeResult::Fenced => { }
        Ext2ResizeResult::NoSpace => { return false; }
        Ext2ResizeResult::Invalid => { return false; }
        Ext2ResizeResult::Resized => { return false; }
    }
    match ext2_recover(mount) {
        Ext2RecoverResult::Failed => { return false; }
        Ext2RecoverResult::Recovered => { }
    }
    if (ext2_is_fenced()) { return false; }
    // Recovered means the interrupted cleanup finished: what the failure left
    // half done is now either the original file or the committed one.
    if (ext2_io_file_is(mount, inode, false, committed) == false) {
        return false;
    }
    if (ext2_counters_match_bitmaps(mount) == false) { return false; }
    if (committed == false && ext2_io_bitmap_matches(mount) == false) {
        return false;
    }
    return ext2_io_restore(mount, inode, base_blocks, base_inodes);
}

private fn ext2_io_failure_check(mount: Ext2Mount) -> bool {
    ext2_write_fixture_execution_model_assumption();
    let mut base_blocks: usize = 0;
    let mut base_inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            base_blocks = blocks;
            base_inodes = inodes;
        }
    }
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_bitmap as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    let mut inode: usize = 0;
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
        Ext2LookupResult::Found(found) => { inode = found; }
    }
    for index: usize in 0..<EXT2_WRITE_FIXTURE_BYTES {
        ext2_write_fixture_source[index] = ((index * 53 + 7) % 251) as u8;
    }
    if (ext2_io_file_is(mount, inode, false, false) == false) { return false; }
    // Small payload: reference run, then a failed write and a failed read at
    // every position the mutation reaches.
    let small_before: usize = block_write_call_total();
    match ext2_io_case(mount, inode, false, true, 1000000, false,
                       base_blocks, base_inodes) {
        Ext2IoCase::Clean => { }
        Ext2IoCase::Broken => { return false; }
        Ext2IoCase::Fenced => { return false; }
        Ext2IoCase::RolledBack => { return false; }
        Ext2IoCase::Committed => { return false; }
    }
    let small_writes: usize = block_write_call_total() - small_before;
    if (ext2_io_restore(mount, inode, base_blocks, base_inodes) == false) {
        return false;
    }
    if (ext2_io_sweep(mount, inode, false, true, 0, EXT2_IO_SWEEP_LIMIT,
                      base_blocks, base_inodes) == false) {
        return false;
    }
    if (ext2_io_sweep(mount, inode, false, false, 0, EXT2_IO_SWEEP_LIMIT,
                      base_blocks, base_inodes) == false) {
        return false;
    }
    // A device that keeps failing: once early (a staged claim is left to
    // clean up) and once after the inode is published (old space is left).
    if (small_writes < 8 ||
        ext2_io_fence(mount, inode, 6, false, base_blocks, base_inodes) == false ||
        ext2_io_fence(mount, inode, small_writes - 3, true,
                      base_blocks, base_inodes) == false) {
        return false;
    }

    // Large payload: through the pointer block. A case costs a thirteen-block
    // write and a restore, so only the writes the small payload lacks are
    // tried: the pointer block, the inode publication and one release write.
    let large_before: usize = block_write_call_total();
    match ext2_io_case(mount, inode, true, true, 1000000, false,
                       base_blocks, base_inodes) {
        Ext2IoCase::Clean => { }
        Ext2IoCase::Broken => { return false; }
        Ext2IoCase::Fenced => { return false; }
        Ext2IoCase::RolledBack => { return false; }
        Ext2IoCase::Committed => { return false; }
    }
    let large_writes: usize = block_write_call_total() - large_before;
    if (ext2_io_restore(mount, inode, base_blocks, base_inodes) == false ||
        large_writes < 16 || large_writes >= EXT2_IO_SWEEP_LIMIT) {
        return false;
    }
    // The last four writes are the old block's release, the one before them
    // is the inode, and the one before that is the pointer block.
    return ext2_io_sweep(mount, inode, true, true, large_writes - 6,
                         large_writes - 5, base_blocks, base_inodes) &&
           ext2_io_sweep(mount, inode, true, true, large_writes - 3,
                         large_writes - 3, base_blocks, base_inodes);
}

// GitHub issue #1088: O_TRUNC, the last unlink, rename over a file and rmdir
// under a rejected write. Each operation runs with one write failing at
// every position it reaches, and then with every write failing from that
// position on, and must leave either its whole effect or none of it: the
// names, the file's size, the counters agreeing with the bitmaps, and --
// when it did nothing -- the free counts and the block bitmap exactly as
// they were. A sticky failure fences the mount; ext2_recover must then
// finish the rollback (or the recount) on its own.
must_use variant Ext2ReleaseCase { Broken; Clean; RolledBack; Committed; }

const EXT2_RELEASE_OP_TRUNCATE: usize = 0;
const EXT2_RELEASE_OP_UNLINK: usize = 1;
const EXT2_RELEASE_OP_RENAME: usize = 2;
const EXT2_RELEASE_OP_RMDIR: usize = 3;
const EXT2_RELEASE_SWEEP_LIMIT: usize = 64;

// The inodes of release.bin and release.new as the setup made them.
private let mut ext2_release_first: usize;
private let mut ext2_release_second: usize;
// Sticky cases that fenced the mount, so the check knows recover ran.
private let mut ext2_release_fenced: usize;

private fn ext2_release_lookup(mount: Ext2Mount, name: []const u8) -> usize {
    match ext2_lookup_root(mount, name) {
        Ext2LookupResult::Invalid => { return 1; }
        Ext2LookupResult::NotFound => { return 0; }
        Ext2LookupResult::Found(inode) => { return inode; }
    }
}

// A new file of `length` payload bytes, or 0.
private fn ext2_release_file(mount: Ext2Mount, name: []const u8,
                             length: usize) -> usize {
    match ext2_create_empty_file_in(mount, 2, name) {
        Ext2CreateEmptyResult::Invalid => { return 0; }
        Ext2CreateEmptyResult::NoSpace => { return 0; }
        Ext2CreateEmptyResult::Created(inode) => {
            if (length == 0 || length > EXT2_WRITE_FIXTURE_BYTES) { return 0; }
            match ext2_write_regular_file_range(
                    mount, inode, 0, ext2_write_fixture_source[0..<length]) {
                Ext2ResizeResult::Resized => { return inode; }
                Ext2ResizeResult::NoSpace => { return 0; }
                Ext2ResizeResult::Invalid => { return 0; }
                Ext2ResizeResult::Fenced => { return 0; }
            }
        }
    }
}

private fn ext2_release_setup(mount: Ext2Mount, op: usize) -> bool {
    ext2_release_first = 0;
    ext2_release_second = 0;
    if (op == EXT2_RELEASE_OP_RMDIR) {
        match ext2_make_directory_in(mount, 2, bs"release.dir") {
            Ext2MkdirResult::NoSpace => { return false; }
            Ext2MkdirResult::Invalid => { return false; }
            Ext2MkdirResult::Created(directory) => {
                ext2_directory_keep(directory);
                return true;
            }
        }
    }
    ext2_release_first = ext2_release_file(mount, bs"release.bin",
                                           EXT2_WRITE_FIXTURE_BYTES);
    if (ext2_release_first == 0) { return false; }
    if (op == EXT2_RELEASE_OP_RENAME) {
        ext2_release_second = ext2_release_file(mount, bs"release.new",
                                                KERNEL_BLOCK_SIZE);
        if (ext2_release_second == 0) { return false; }
    }
    return true;
}

private fn ext2_release_rmdir(mount: Ext2Mount) -> bool {
    match ext2_claim_directory(mount, 2, bs"release.dir") {
        Ext2ClaimResult::Invalid => { return false; }
        Ext2ClaimResult::NotFound => { return false; }
        Ext2ClaimResult::NotDirectory => { return false; }
        Ext2ClaimResult::Claimed(directory) => {
            match ext2_remove_directory_in(mount, 2, directory,
                                           bs"release.dir") {
                Ext2RmdirResult::Removed => { return true; }
                Ext2RmdirResult::Invalid => { return false; }
                Ext2RmdirResult::NotEmpty(kept) => {
                    ext2_directory_keep(kept);
                    return false;
                }
                Ext2RmdirResult::Refused(kept) => {
                    ext2_directory_keep(kept);
                    return false;
                }
            }
        }
    }
}

private fn ext2_release_run(mount: Ext2Mount, op: usize) -> bool {
    if (op == EXT2_RELEASE_OP_TRUNCATE) {
        match ext2_truncate_regular_file(mount, ext2_release_first) {
            Ext2TruncateResult::Invalid => { return false; }
            Ext2TruncateResult::Truncated => { return true; }
        }
    }
    if (op == EXT2_RELEASE_OP_UNLINK) {
        match ext2_unlink_name(mount, 2, bs"release.bin") {
            Ext2UnlinkNameResult::Unlinked => { return true; }
            Ext2UnlinkNameResult::Invalid => { return false; }
            Ext2UnlinkNameResult::NotFound => { return false; }
            Ext2UnlinkNameResult::IsDirectory => { return false; }
            Ext2UnlinkNameResult::Unsupported => { return false; }
        }
    }
    if (op == EXT2_RELEASE_OP_RENAME) {
        match ext2_rename_in(mount, 2, bs"release.new", 2, bs"release.bin") {
            Ext2RenameResult::Renamed => { return true; }
            Ext2RenameResult::Invalid => { return false; }
            Ext2RenameResult::NoSpace => { return false; }
            Ext2RenameResult::NotFound => { return false; }
            Ext2RenameResult::IsDirectory => { return false; }
            Ext2RenameResult::NotDirectory => { return false; }
            Ext2RenameResult::Unsupported => { return false; }
        }
    }
    return ext2_release_rmdir(mount);
}

// release.bin as the setup wrote it: thirteen blocks through the
// singly-indirect block, and its first block's bytes.
private fn ext2_release_full_file(mount: Ext2Mount, inode: usize) -> bool {
    if (ext2_regular_file_size(mount, inode) != EXT2_WRITE_FIXTURE_BYTES ||
        ext2_write_fixture_sectors_match(mount, inode, 28) == false) {
        return false;
    }
    match ext2_read_file_chunk(mount, inode, 0,
                               ext2_write_fixture_readback as []u8) {
        Ext2ReadResult::Invalid => { return false; }
        Ext2ReadResult::Read(length) => {
            if (length != KERNEL_BLOCK_SIZE) { return false; }
        }
    }
    for byte: usize in 0..<KERNEL_BLOCK_SIZE {
        if (ext2_write_fixture_readback[byte] !=
            ext2_write_fixture_source[byte]) {
            return false;
        }
    }
    return true;
}

// The names and the file as the operation leaves them: done or not done.
private fn ext2_release_names_are(mount: Ext2Mount, op: usize,
                                  done: bool) -> bool {
    if (op == EXT2_RELEASE_OP_RMDIR) {
        let directory: usize = ext2_release_lookup(mount, bs"release.dir");
        if (done) { return directory == 0; }
        return directory > 1;
    }
    let bin: usize = ext2_release_lookup(mount, bs"release.bin");
    if (op == EXT2_RELEASE_OP_TRUNCATE) {
        if (bin != ext2_release_first) { return false; }
        if (done) {
            return ext2_regular_file_size(mount, bin) == 0 &&
                   ext2_write_fixture_sectors_match(mount, bin, 0);
        }
        return ext2_release_full_file(mount, bin);
    }
    if (op == EXT2_RELEASE_OP_UNLINK) {
        if (done) { return bin == 0; }
        return bin == ext2_release_first &&
               ext2_release_full_file(mount, bin);
    }
    let fresh: usize = ext2_release_lookup(mount, bs"release.new");
    if (done) { return bin == ext2_release_second && fresh == 0; }
    return bin == ext2_release_first && fresh == ext2_release_second &&
           ext2_release_full_file(mount, bin);
}

// Back to the state before the setup, with the device healthy.
private fn ext2_release_teardown(mount: Ext2Mount) -> bool {
    if (ext2_release_lookup(mount, bs"release.dir") > 1 &&
        ext2_release_rmdir(mount) == false) {
        return false;
    }
    match ext2_unlink_name(mount, 2, bs"release.bin") {
        Ext2UnlinkNameResult::Unlinked => { }
        Ext2UnlinkNameResult::NotFound => { }
        Ext2UnlinkNameResult::Invalid => { return false; }
        Ext2UnlinkNameResult::IsDirectory => { return false; }
        Ext2UnlinkNameResult::Unsupported => { return false; }
    }
    match ext2_unlink_name(mount, 2, bs"release.new") {
        Ext2UnlinkNameResult::Unlinked => { return true; }
        Ext2UnlinkNameResult::NotFound => { return true; }
        Ext2UnlinkNameResult::Invalid => { return false; }
        Ext2UnlinkNameResult::IsDirectory => { return false; }
        Ext2UnlinkNameResult::Unsupported => { return false; }
    }
}

private fn ext2_release_case(mount: Ext2Mount, op: usize, skip: usize,
                             sticky: bool, base_blocks: usize,
                             base_inodes: usize) -> Ext2ReleaseCase {
    if (ext2_release_setup(mount, op) == false) {
        return Ext2ReleaseCase::Broken;
    }
    let mut before_blocks: usize = 0;
    let mut before_inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return Ext2ReleaseCase::Broken; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            before_blocks = blocks;
            before_inodes = inodes;
        }
    }
    match ext2_block_bitmap_snapshot(
            mount, ext2_write_fixture_bitmap as [u8; KERNEL_BLOCK_SIZE..]) {
        Ext2ReadResult::Invalid => { return Ext2ReleaseCase::Broken; }
        Ext2ReadResult::Read(length) => { }
    }
    // What the operation frees: the file's thirteen blocks and its pointer
    // block, or the directory's one block, and the inode unless O_TRUNC.
    let mut freed_blocks: usize = 14;
    let mut freed_inodes: usize = 1;
    if (op == EXT2_RELEASE_OP_TRUNCATE) { freed_inodes = 0; }
    if (op == EXT2_RELEASE_OP_RMDIR) { freed_blocks = 1; }
    block_fault_arm(true, skip, sticky);
    let done: bool = ext2_release_run(mount, op);
    let injected: usize = block_fault_disarm();
    if (ext2_is_fenced()) {
        ext2_release_fenced = ext2_release_fenced + 1;
        match ext2_recover(mount) {
            Ext2RecoverResult::Failed => { return Ext2ReleaseCase::Broken; }
            Ext2RecoverResult::Recovered => { }
        }
    }
    if (ext2_release_names_are(mount, op, done) == false ||
        ext2_counters_match_bitmaps(mount) == false) {
        return Ext2ReleaseCase::Broken;
    }
    if (done) {
        if (ext2_write_fixture_counts_match(mount, before_blocks + freed_blocks,
                before_inodes + freed_inodes) == false) {
            return Ext2ReleaseCase::Broken;
        }
    } else {
        if (injected == 0 ||
            ext2_write_fixture_counts_match(mount, before_blocks,
                                            before_inodes) == false ||
            ext2_io_bitmap_matches(mount) == false) {
            return Ext2ReleaseCase::Broken;
        }
    }
    if (ext2_release_teardown(mount) == false ||
        ext2_write_fixture_counts_match(mount, base_blocks,
                                        base_inodes) == false) {
        return Ext2ReleaseCase::Broken;
    }
    if (injected == 0) { return Ext2ReleaseCase::Clean; }
    if (done) { return Ext2ReleaseCase::Committed; }
    return Ext2ReleaseCase::RolledBack;
}

// Fail the write at each position from 0 on until a run finishes before
// reaching it. False on a broken verdict, or when no position rolled back.
private fn ext2_release_sweep(mount: Ext2Mount, op: usize, sticky: bool,
                              base_blocks: usize, base_inodes: usize)
        -> bool {
    let mut done: bool = false;
    let mut rolled_back: bool = false;
    for skip: usize in 0..<EXT2_RELEASE_SWEEP_LIMIT {
        if (done == false) {
            match ext2_release_case(mount, op, skip, sticky, base_blocks,
                                    base_inodes) {
                Ext2ReleaseCase::Broken => { return false; }
                Ext2ReleaseCase::Clean => { done = true; }
                Ext2ReleaseCase::RolledBack => { rolled_back = true; }
                Ext2ReleaseCase::Committed => { }
            }
        }
    }
    return done && rolled_back;
}

fn ext2_release_failure_check(mount: Ext2Mount) -> bool {
    let mut base_blocks: usize = 0;
    let mut base_inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            base_blocks = blocks;
            base_inodes = inodes;
        }
    }
    for index: usize in 0..<EXT2_WRITE_FIXTURE_BYTES {
        ext2_write_fixture_source[index] = ((index * 31 + 3) % 251) as u8;
    }
    ext2_release_fenced = 0;
    for op: usize in 0..<4 {
        if (ext2_release_sweep(mount, op, false, base_blocks,
                               base_inodes) == false ||
            ext2_release_sweep(mount, op, true, base_blocks,
                               base_inodes) == false) {
            return false;
        }
    }
    // Every sticky failure before a commit leaves a rollback that cannot
    // land, so recover must have finished at least one per operation.
    return ext2_release_fenced >= 4;
}

fn kernel_ext2_fixture_run(mount: Ext2Mount) !{logs, unsafe} {
    // GitHub issue #249: save the mount for
    // the exec prepare (kernel_exec_resolve_ext2_exec), which runs later, from
    // a syscall-return path outside fn main()'s own scope.
    kernel_boot_mount_configure(mount);
    // This mount is the root filesystem every process runs
    // from. Configure the syscall path from it; otherwise
    // openat(2) observes an unconfigured filesystem and
    // reports EBADF for /etc/init.sh.
    kernel_syscall_ext2_configure(mount);
    if (kernel_syscall_filesystem_configured_probe()) {
        kernel_boot_log("filesystem context: configured root readable\n");
    } else {
        kernel_boot_log("filesystem context: configured failed\n");
    }
    // Which device the root is on, for each platform's storage
    // view to compare: the board's is the USB stick and QEMU's
    // the virtio disk, and a root that drifts to any other
    // device fails that view by name.
    let mut root_device: KernelBlockDevice = ext2_mount_device(mount);
    if (block_device_is_usb(root_device)) {
        kernel_boot_log("rootfs: ext2 on usb\n");
    } else if (block_device_is_virtio(root_device)) {
        kernel_boot_log("rootfs: ext2 on virtio\n");
    } else {
        kernel_boot_log("rootfs: ext2 on an unnamed device\n");
    }
    if (ext2_fixture_geometry_is_expected(mount)) {
        kernel_boot_log("ext2 mount: block=1024 inodes=1024 blocks=6144\n");
    }
    if (ext2_bytes_boundary_probe()) {
        kernel_boot_log("ext2 bytes: end accepted, past and crossing refused\n");
    } else {
        kernel_boot_log("ext2 bytes: boundary check failed\n");
    }
    match ext2_bitmap_roundtrip_check(mount) {
        Ext2BitmapProbeResult::Verified => {
            kernel_boot_log("ext2 bitmap: block+inode counts ok\n");
        }
        Ext2BitmapProbeResult::Invalid => {
            kernel_boot_log("ext2 bitmap: failed\n");
        }
    }
    match ext2_owner_roundtrip_check(mount) {
        Ext2BitmapProbeResult::Verified => {
            kernel_boot_log("ext2 owners: block+inode owners ok\n");
        }
        Ext2BitmapProbeResult::Invalid => {
            kernel_boot_log("ext2 owners: failed\n");
        }
    }
    match ext2_write_allocations_roundtrip_check(mount) {
        Ext2BitmapProbeResult::Verified => {
            kernel_boot_log("ext2 write rollback: two blocks released\n");
        }
        Ext2BitmapProbeResult::Invalid => {
            kernel_boot_log("ext2 write rollback: failed\n");
        }
    }
    if (ext2_create_check(mount)) {
        kernel_boot_log("ext2 create: create+lookup+unlink ok\n");
    } else {
        kernel_boot_log("ext2 create: failed\n");
    }
    if (ext2_create_in_directory_check(mount)) {
        kernel_boot_log("ext2 nested: create+lookup+unlink in /etc ok\n");
    } else {
        kernel_boot_log("ext2 nested: failed\n");
    }
    match ext2_lookup_root(mount, bs"latest") {
        Ext2LookupResult::Invalid => {
            kernel_boot_log("ext2 symlink: invalid lookup\n");
        }
        Ext2LookupResult::NotFound => {
            kernel_boot_log("ext2 symlink: not found\n");
        }
        Ext2LookupResult::Found(link_inode) => {
            match ext2_read_fast_symlink(
                    mount, link_inode,
                    ext2_symlink_fixture as []u8) {
                Ext2SymlinkResult::Invalid => {
                    kernel_boot_log("ext2 symlink: invalid\n");
                }
                Ext2SymlinkResult::Read(target_length) => {
                    if (target_length == 9 &&
                        slice_eq(ext2_symlink_fixture[0..<9],
                                 bs"hello.txt")) {
                        match ext2_lookup_root(
                                mount,
                                ext2_symlink_fixture[0..<9]) {
                            Ext2LookupResult::Invalid => { }
                            Ext2LookupResult::NotFound => { }
                            Ext2LookupResult::Found(_target_inode) => {
                                kernel_boot_log("ext2 symlink: /latest -> hello.txt ok\n");
                            }
                        }
                    }
                }
            }
        }
    }
    if (ext2_write_indirect_check(mount)) {
        kernel_boot_log("ext2 write indirect: rollback+grow+zero+restore ok\n");
    } else {
        kernel_boot_log("ext2 write indirect: failed\n");
    }
    // GitHub issue #595. Last, after every fixture that counts free blocks.
    if (ext2_io_failure_check(mount)) {
        kernel_boot_log("ext2 io failure: every phase rolled back or committed, fence+recover ok\n");
    } else {
        kernel_boot_log("ext2 io failure: failed\n");
    }
    if (ext2_full_check(mount)) {
        kernel_boot_log("ext2 full: block+inode NoSpace for mkdir+create, rolled back, control ok\n");
    } else {
        kernel_boot_log("ext2 full: failed\n");
    }
    // GitHub issue #1088. After the full check, so its counts are untouched.
    if (ext2_release_failure_check(mount)) {
        kernel_boot_log("ext2 release failure: truncate+unlink+rename+rmdir all or nothing, fence+recover ok\n");
    } else {
        kernel_boot_log("ext2 release failure: failed\n");
    }
    match ext2_exhaustion_mode(mount) {
        Ext2ExhaustionMode::Invalid => {
            kernel_boot_log("ext2 exhaustion: invalid inittab\n");
            return;
        }
        Ext2ExhaustionMode::Interactive => { return; }
        Ext2ExhaustionMode::Integration => { }
    }
    let exhaustion_start: usize = read_cntpct() as usize;
    let exhaustion_reads: usize = block_read_call_total();
    let exhaustion_writes: usize = block_write_call_total();
    if (ext2_write_exhaustion_check(mount)) {
        kernel_boot_log("ext2 exhaustion: indirect NoSpace rollback, EL0 fillers ready\n");
    } else {
        kernel_boot_log("ext2 exhaustion: failed\n");
    }
    let exhaustion_ticks: usize = (read_cntpct() as usize) - exhaustion_start;
    kernel_boot_log("ext2 exhaustion cost: ticks=");
    uart_put_udec(exhaustion_ticks);
    kernel_boot_log(" frequency=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log(" reads=");
    uart_put_udec(block_read_call_total() - exhaustion_reads);
    kernel_boot_log(" writes=");
    uart_put_udec(block_write_call_total() - exhaustion_writes);
    kernel_boot_log("\n");

}

// Mounting the fixture image and running it, which both platforms reached the
// same way once the body above stopped being written twice. Extracting the
// body made this identical, and scripts/check_platform_file_parity.py said so
// on the next run -- the check finding the next layer down is what it is for.
fn kernel_ext2_mount_and_run(device: KernelBlockDevice) !{logs, unsafe} {
    match ext2_mount(device) {
        Ext2MountResult::Invalid => {
            kernel_boot_log("ext2 mount: invalid\n");
        }
        Ext2MountResult::Mounted(mount) => {
            kernel_ext2_fixture_run(mount);
        }
    }
}
