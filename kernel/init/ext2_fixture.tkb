// The ext2 fixture every platform runs, and the probes that mutate it.
//
// One body, for two reasons that arrived together (GitHub issue #517).
//
// It was DUPLICATED: 150-odd lines sat in kernel/platform/qemu/init.tkb and
// kernel/platform/rpi5/init.tkb, differing in code by exactly one block. The
// two platform trees are never compiled together, so a fixture step added to
// one and not the other is invisible until a board boots.
//
// And that one block was a COVERAGE GAP. QEMU ran four mutation probes --
// resize, bitmap, owners, create -- that the board never ran; measured 2026-09-08
// against a real capture, zero occurrences of all four. Two of them were gated
// behind helpers named `qemu_ext2_*` that had no `rpi5_` counterpart, and the
// other two are shared functions the board simply never called. Nothing about
// them was platform-specific: they call only shared ext2 operations, and the
// board's filesystem is provisioned fresh on every boot by block_copy() onto
// USB, so a mutation cannot outlive the run that made it. The bitmap and owner
// probes are allocate/release round trips that restore the counts they read.
//
// So the union is what both platforms now run, and `ext2_mutation` became a
// common view rather than a QEMU-only one.
use "kernel/fs/ext2/ext2.tkb";
use "kernel/printk/log.tkb";

// The ext2 mutation helpers. They were reachable only from the QEMU fixture
// until this file existed; both platforms run them now, and `ext2_mutation`
// is a common view.
fn ext2_resize_check(mount: Ext2Mount) -> bool {
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Found(inode_number) => {
            match ext2_resize_small_file(mount, inode_number, bs"tiny\n") {
                Ext2ResizeResult::Invalid => { return false; }
                Ext2ResizeResult::Resized => { }
            }
            match ext2_read_small_file(mount, inode_number,
                                       ext2_read_fixture as []u8) {
                Ext2ReadResult::Read(short_length) => {
                    if (short_length != 5 ||
                        slice_eq(ext2_read_fixture[0..<5], bs"tiny\n") == false) {
                        return false;
                    }
                }
                Ext2ReadResult::Invalid => { return false; }
            }
            match ext2_resize_small_file(
                    mount, inode_number, bs"extended ext2\n") {
                Ext2ResizeResult::Invalid => { return false; }
                Ext2ResizeResult::Resized => { }
            }
            match ext2_read_small_file(mount, inode_number,
                                       ext2_read_fixture as []u8) {
                Ext2ReadResult::Read(long_length) => {
                    return long_length == 14 &&
                           slice_eq(ext2_read_fixture[0..<14],
                                    bs"extended ext2\n");
                }
                Ext2ReadResult::Invalid => { return false; }
            }
        }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
}

fn ext2_create_check(mount: Ext2Mount) -> bool {
    match ext2_create_root_file(
            mount, bs"created.txt", bs"created on ext2\n") {
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::Created(linked) => {
            let mut content_ok: bool = false;
            match ext2_lookup_root(mount, bs"created.txt") {
                Ext2LookupResult::Found(inode_number) => {
                    match ext2_read_small_file(
                            mount, inode_number, ext2_read_fixture as []u8) {
                        Ext2ReadResult::Read(length) => {
                            content_ok = length == 16 &&
                                slice_eq(ext2_read_fixture[0..<16],
                                         bs"created on ext2\n");
                        }
                        Ext2ReadResult::Invalid => { }
                    }
                }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::NotFound => { }
            }
            match ext2_unlink_root_file(mount, linked, bs"created.txt") {
                Ext2UnlinkResult::Invalid => { return false; }
                Ext2UnlinkResult::Unlinked => { }
            }
            match ext2_lookup_root(mount, bs"created.txt") {
                Ext2LookupResult::NotFound => { return content_ok; }
                Ext2LookupResult::Invalid => { return false; }
                Ext2LookupResult::Found(existing) => { return false; }
            }
        }
    }
}

// GitHub issue #537: the same round trip, in a directory that is not the
// root. Before this, the kernel could find `/etc/init.sh` and could not
// create a file beside it -- the mutation paths read inode 2 by name while
// lookup next door already walked any directory.
//
// `/etc` is used because the fixture already builds it and BusyBox already
// reads from it, so this asserts against a directory the rest of the boot
// depends on rather than one invented for the test.
fn ext2_create_in_directory_check(mount: Ext2Mount) -> bool {
    let mut directory: usize = 0;
    match ext2_lookup_root(mount, bs"etc") {
        Ext2LookupResult::Found(inode_number) => { directory = inode_number; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    if (directory == 2) { return false; }
    match ext2_create_file_in(mount, directory, bs"nested.txt",
                              bs"created in /etc\n") {
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::Created(linked) => {
            let mut content_ok: bool = false;
            match ext2_lookup_directory(mount, directory, bs"nested.txt") {
                Ext2LookupResult::Found(inode_number) => {
                    match ext2_read_small_file(
                            mount, inode_number, ext2_read_fixture as []u8) {
                        Ext2ReadResult::Read(length) => {
                            content_ok = length == 16 &&
                                slice_eq(ext2_read_fixture[0..<16],
                                         bs"created in /etc\n");
                        }
                        Ext2ReadResult::Invalid => { }
                    }
                }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::NotFound => { }
            }
            // The root must not have gained it: a mutation that ignored its
            // directory argument would still pass every check above.
            let mut root_clean: bool = false;
            match ext2_lookup_root(mount, bs"nested.txt") {
                Ext2LookupResult::NotFound => { root_clean = true; }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::Found(existing) => { }
            }
            match ext2_unlink_file_in(mount, directory, linked,
                                      bs"nested.txt") {
                Ext2UnlinkResult::Invalid => { return false; }
                Ext2UnlinkResult::Unlinked => { }
            }
            match ext2_lookup_directory(mount, directory, bs"nested.txt") {
                Ext2LookupResult::NotFound => {
                    return content_ok && root_clean;
                }
                Ext2LookupResult::Invalid => { return false; }
                Ext2LookupResult::Found(existing) => { return false; }
            }
        }
    }
}

// GitHub issue #537: a directory forced past one block.
//
// The entries that fill /etc all name one inode, the probe's own file. A
// linear Ext2LinkedFile cannot be held across a loop iteration, so N real
// files cannot be created here and unlinked later; N names for one file can,
// and every one of them is removed before the file itself is. Names are 200
// bytes so the directory fills in a handful of adds, and they are all the
// same length, so once one did not fit, none of the others fits either: the
// add that grows the directory is the first entry of the new block.
//
// What stays behind is the grown block, holding one dead record. ext2 never
// shrinks a directory, and the host's e2fsck reads the lane's disk
// afterwards, so that is the state it is asked to accept.
fn ext2_grow_fill_and_drain(mount: Ext2Mount, directory: usize,
                            target: usize, size_before: usize,
                            live_before: usize) -> bool {
    let mut name: [u8; 200];
    for i: usize in 0..<200 { name[i] = 0x67; }
    let mut added: usize = 0;
    let mut grown: bool = false;
    let mut adding: bool = true;
    for i: usize in 0..<16 {
        if (adding && grown == false) {
            name[199] = (0x61 + i) as u8;
            match ext2_directory_add(mount, directory, target,
                                     name as []u8) {
                Ext2DirectoryResult::Invalid => { adding = false; }
                Ext2DirectoryResult::Updated => {
                    added = added + 1;
                    if (ext2_inode_size(mount, directory) > size_before) {
                        grown = true;
                    }
                }
            }
        }
    }
    let grown_size: usize = ext2_inode_size(mount, directory);
    let mut verdict: bool = adding && grown && added > 1 &&
                            grown_size == size_before + KERNEL_BLOCK_SIZE;
    match ext2_directory_live_entries(mount, directory) {
        Ext2CountResult::Counted(live) => {
            if (live != live_before + 1 + added) { verdict = false; }
        }
        Ext2CountResult::Invalid => { verdict = false; }
    }
    if (verdict) {
        // The entry that forced the growth opens the new block, so it has no
        // predecessor to merge into: removing it leaves a dead record.
        name[199] = (0x61 + added - 1) as u8;
        match ext2_directory_remove(mount, directory, target, name as []u8) {
            Ext2DirectoryResult::Invalid => { verdict = false; }
            Ext2DirectoryResult::Updated => { }
        }
        match ext2_lookup_directory(mount, directory, name as []u8) {
            Ext2LookupResult::NotFound => { }
            Ext2LookupResult::Invalid => { verdict = false; }
            Ext2LookupResult::Found(existing) => { verdict = false; }
        }
        // Adding it back must land in that dead record. Every earlier block
        // is still full, so a second growth here would mean the record was
        // not reused.
        match ext2_directory_add(mount, directory, target, name as []u8) {
            Ext2DirectoryResult::Invalid => { verdict = false; }
            Ext2DirectoryResult::Updated => { }
        }
        if (ext2_inode_size(mount, directory) != grown_size) {
            verdict = false;
        }
        match ext2_lookup_directory(mount, directory, name as []u8) {
            Ext2LookupResult::Found(found) => {
                if (found != target) { verdict = false; }
            }
            Ext2LookupResult::Invalid => { verdict = false; }
            Ext2LookupResult::NotFound => { verdict = false; }
        }
    }
    // Drained whatever the verdict, so a failing probe does not leave names
    // behind for a file it is about to unlink.
    for i: usize in 0..<16 {
        if (i < added) {
            name[199] = (0x61 + i) as u8;
            match ext2_directory_remove(mount, directory, target,
                                        name as []u8) {
                Ext2DirectoryResult::Invalid => { verdict = false; }
                Ext2DirectoryResult::Updated => { }
            }
        }
    }
    return verdict;
}

fn ext2_grow_directory_check(mount: Ext2Mount) -> bool {
    let mut directory: usize = 0;
    match ext2_lookup_root(mount, bs"etc") {
        Ext2LookupResult::Found(inode_number) => { directory = inode_number; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    let size_before: usize = ext2_inode_size(mount, directory);
    let mut live_before: usize = 0;
    match ext2_directory_live_entries(mount, directory) {
        Ext2CountResult::Counted(live) => { live_before = live; }
        Ext2CountResult::Invalid => { return false; }
    }
    if (size_before == 0 || live_before == 0) { return false; }
    match ext2_create_file_in(mount, directory, bs"grow.txt", bs"grown\n") {
        Ext2CreateResult::Invalid => { return false; }
        Ext2CreateResult::Created(linked) => {
            let mut verdict: bool = false;
            match ext2_lookup_directory(mount, directory, bs"grow.txt") {
                Ext2LookupResult::Found(target) => {
                    verdict = ext2_grow_fill_and_drain(
                        mount, directory, target, size_before, live_before);
                }
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::NotFound => { }
            }
            match ext2_unlink_file_in(mount, directory, linked,
                                      bs"grow.txt") {
                Ext2UnlinkResult::Invalid => { return false; }
                Ext2UnlinkResult::Unlinked => { }
            }
            match ext2_directory_live_entries(mount, directory) {
                Ext2CountResult::Counted(live) => {
                    return verdict && live == live_before;
                }
                Ext2CountResult::Invalid => { return false; }
            }
        }
    }
}

// GitHub issue #537: nested directories.
//
// `/etc/made/inner` is made and KEPT. Removing everything the probe made
// would leave the host's e2fsck, which reads the QEMU lane's disk after the
// run, judging only the state removal restored -- never a directory this
// kernel made, its `.`, its `..` or its parent's link count. The removal half
// runs on a third directory beside them.
private fn ext2_rmdir_discard(result: Ext2RmdirResult) {
    match result {
        Ext2RmdirResult::Removed => { }
        Ext2RmdirResult::Invalid => { }
        Ext2RmdirResult::NotEmpty(kept) => { ext2_directory_keep(kept); }
        Ext2RmdirResult::Refused(kept) => { ext2_directory_keep(kept); }
    }
}

private fn ext2_unlink_discard(result: Ext2UnlinkResult) {
    match result {
        Ext2UnlinkResult::Invalid => { }
        Ext2UnlinkResult::Unlinked => { }
    }
}

// rmdir has to refuse a directory that still holds something, hand it back
// rather than spend it, and remove it once it is empty -- returning the
// parent's link count to where it was.
fn ext2_rmdir_round_trip(mount: Ext2Mount, parent: usize) -> bool {
    let links_before: usize = ext2_inode_links(mount, parent);
    match ext2_make_directory_in(mount, parent, bs"gone") {
        Ext2MkdirResult::Invalid => { return false; }
        Ext2MkdirResult::Created(gone) => {
            let gone_inode: usize = ext2_linked_directory_inode(gone);
            let made_ok: bool =
                ext2_inode_links(mount, parent) == links_before + 1;
            match ext2_create_file_in(mount, gone_inode, bs"inside.txt",
                                      bs"inside\n") {
                Ext2CreateResult::Invalid => {
                    ext2_rmdir_discard(ext2_remove_directory_in(
                        mount, parent, gone, bs"gone"));
                    return false;
                }
                Ext2CreateResult::Created(inside) => {
                    match ext2_remove_directory_in(mount, parent, gone,
                                                   bs"gone") {
                        Ext2RmdirResult::NotEmpty(back) => {
                            let mut unlinked: bool = false;
                            match ext2_unlink_file_in(mount, gone_inode,
                                                      inside, bs"inside.txt") {
                                Ext2UnlinkResult::Invalid => { }
                                Ext2UnlinkResult::Unlinked => { unlinked = true; }
                            }
                            let mut removed: bool = false;
                            match ext2_remove_directory_in(mount, parent, back,
                                                           bs"gone") {
                                Ext2RmdirResult::Removed => { removed = true; }
                                Ext2RmdirResult::Invalid => { }
                                Ext2RmdirResult::NotEmpty(kept) => {
                                    ext2_directory_keep(kept);
                                }
                                Ext2RmdirResult::Refused(kept) => {
                                    ext2_directory_keep(kept);
                                }
                            }
                            let mut absent: bool = false;
                            match ext2_lookup_directory(mount, parent,
                                                        bs"gone") {
                                Ext2LookupResult::NotFound => { absent = true; }
                                Ext2LookupResult::Invalid => { }
                                Ext2LookupResult::Found(existing) => { }
                            }
                            return made_ok && unlinked && removed && absent &&
                                   ext2_inode_links(mount, parent) ==
                                       links_before;
                        }
                        Ext2RmdirResult::Refused(back) => {
                            ext2_unlink_discard(ext2_unlink_file_in(
                                mount, gone_inode, inside, bs"inside.txt"));
                            ext2_rmdir_discard(ext2_remove_directory_in(
                                mount, parent, back, bs"gone"));
                            return false;
                        }
                        Ext2RmdirResult::Removed => {
                            ext2_unlink_discard(ext2_unlink_file_in(
                                mount, gone_inode, inside, bs"inside.txt"));
                            return false;
                        }
                        Ext2RmdirResult::Invalid => {
                            ext2_unlink_discard(ext2_unlink_file_in(
                                mount, gone_inode, inside, bs"inside.txt"));
                            return false;
                        }
                    }
                }
            }
        }
    }
}

// Link counts are what `..` costs: /etc gains one for made's `..`, made has
// three (its entry, its `.`, inner's `..`), and inner has two. And `..`
// resolves through each directory's own entry, one level at a time; path
// lookup used to answer the root for every `..`, which these two paths
// would have caught.
fn ext2_nested_directory_shape(mount: Ext2Mount, etc: usize,
                               etc_links: usize, made: usize,
                               inner: usize) -> bool {
    if (ext2_inode_links(mount, etc) != etc_links + 1 ||
        ext2_inode_links(mount, made) != 3 ||
        ext2_inode_links(mount, inner) != 2) {
        return false;
    }
    match ext2_lookup_path(mount, bs"etc/made/inner/..") {
        Ext2LookupResult::Found(resolved) => {
            if (resolved != made) { return false; }
        }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    match ext2_lookup_path(mount, bs"etc/made/inner/../..") {
        Ext2LookupResult::Found(resolved) => {
            if (resolved != etc) { return false; }
        }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    match ext2_directory_live_entries(mount, inner) {
        Ext2CountResult::Counted(live) => { return live == 2; }
        Ext2CountResult::Invalid => { return false; }
    }
}

fn ext2_nested_directory_check(mount: Ext2Mount) -> bool {
    let mut etc: usize = 0;
    match ext2_lookup_root(mount, bs"etc") {
        Ext2LookupResult::Found(inode_number) => { etc = inode_number; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    let etc_links: usize = ext2_inode_links(mount, etc);
    if (etc_links < 2) { return false; }
    match ext2_make_directory_in(mount, etc, bs"made") {
        Ext2MkdirResult::Invalid => { return false; }
        Ext2MkdirResult::Created(made) => {
            let made_inode: usize = ext2_linked_directory_inode(made);
            let mut verdict: bool = false;
            match ext2_make_directory_in(mount, made_inode, bs"inner") {
                Ext2MkdirResult::Invalid => { }
                Ext2MkdirResult::Created(inner) => {
                    let inner_inode: usize = ext2_linked_directory_inode(inner);
                    verdict = ext2_nested_directory_shape(
                                  mount, etc, etc_links, made_inode,
                                  inner_inode) &&
                              ext2_rmdir_round_trip(mount, made_inode);
                    ext2_directory_keep(inner);
                }
            }
            ext2_directory_keep(made);
            return verdict;
        }
    }
}

// GitHub issue #538: unlink by name, the operation BusyBox rm reaches
// through unlinkat. It is exercised here rather than by an rm line in the
// shared ash script because each BusyBox exec costs 0.6 to 1.0 s of the boot
// the dmesg validator bounds, and under cicheck's parallel load the one exec
// rm needed took that boot to 25.2 s against 25. The kernel side is the same
// call either way; what this does not reach is the syscall's own path
// parsing, which mkdirat and rmdir share and the ash script does reach.
//
// The image provides both shapes in /etc, which the ash script never lists:
// /etc/hello-link is a second link to /hello.txt, so removing it must drop one
// link and leave the file; /etc/removable.txt is a last link, so removing it
// must hand one block and one inode back. /etc/made, kept by the check
// before this one, is the directory that must be refused.
fn ext2_unlink_name_check(mount: Ext2Mount) -> bool {
    let mut etc: usize = 0;
    match ext2_lookup_root(mount, bs"etc") {
        Ext2LookupResult::Found(inode_number) => { etc = inode_number; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    let mut hello: usize = 0;
    match ext2_lookup_root(mount, bs"hello.txt") {
        Ext2LookupResult::Found(inode_number) => { hello = inode_number; }
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
    }
    let hello_links: usize = ext2_inode_links(mount, hello);
    if (hello_links < 2) { return false; }
    let mut verdict: bool = true;
    match ext2_unlink_name(mount, etc, bs"hello-link") {
        Ext2UnlinkNameResult::Unlinked => { }
        Ext2UnlinkNameResult::Invalid => { verdict = false; }
        Ext2UnlinkNameResult::NotFound => { verdict = false; }
        Ext2UnlinkNameResult::IsDirectory => { verdict = false; }
        Ext2UnlinkNameResult::Unsupported => { verdict = false; }
    }
    if (ext2_inode_links(mount, hello) != hello_links - 1) { verdict = false; }
    match ext2_lookup_root(mount, bs"hello.txt") {
        Ext2LookupResult::Found(still) => {
            if (still != hello) { verdict = false; }
        }
        Ext2LookupResult::Invalid => { verdict = false; }
        Ext2LookupResult::NotFound => { verdict = false; }
    }
    let mut blocks_before: usize = 0;
    let mut inodes_before: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            blocks_before = blocks;
            inodes_before = inodes;
        }
        Ext2FreeCountsResult::Invalid => { return false; }
    }
    match ext2_unlink_name(mount, etc, bs"removable.txt") {
        Ext2UnlinkNameResult::Unlinked => { }
        Ext2UnlinkNameResult::Invalid => { verdict = false; }
        Ext2UnlinkNameResult::NotFound => { verdict = false; }
        Ext2UnlinkNameResult::IsDirectory => { verdict = false; }
        Ext2UnlinkNameResult::Unsupported => { verdict = false; }
    }
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            if (blocks != blocks_before + 1 || inodes != inodes_before + 1) {
                verdict = false;
            }
        }
        Ext2FreeCountsResult::Invalid => { verdict = false; }
    }
    // The same name again finds nothing: the first call removed it.
    match ext2_unlink_name(mount, etc, bs"removable.txt") {
        Ext2UnlinkNameResult::NotFound => { }
        Ext2UnlinkNameResult::Unlinked => { verdict = false; }
        Ext2UnlinkNameResult::Invalid => { verdict = false; }
        Ext2UnlinkNameResult::IsDirectory => { verdict = false; }
        Ext2UnlinkNameResult::Unsupported => { verdict = false; }
    }
    match ext2_unlink_name(mount, etc, bs"made") {
        Ext2UnlinkNameResult::IsDirectory => { }
        Ext2UnlinkNameResult::Unlinked => { verdict = false; }
        Ext2UnlinkNameResult::Invalid => { verdict = false; }
        Ext2UnlinkNameResult::NotFound => { verdict = false; }
        Ext2UnlinkNameResult::Unsupported => { verdict = false; }
    }
    return verdict;
}

fn kernel_ext2_fixture_run(mount: Ext2Mount) !{logs, unsafe} {
    // GitHub issue #249: save the mount for
    // kernel_exec_resolve_argv0(), which runs later, from
    // a syscall-return path outside fn main()'s own scope.
    saved_ext2_mount = mount;
    ext2_mount_ready = true;
    // The memory-backed fixture is the root filesystem used
    // by the init process below.  Configure the syscall
    // path from this mount even when USB MSC provisioning
    // was unavailable (and also replace the temporary USB
    // mount when it was available); otherwise openat(2)
    // observes syscall_ext2_ready == false and reports
    // EBADF for /etc/init.sh.
    kernel_syscall_ext2_configure(mount);
    if (ext2_fixture_geometry_is_expected(mount)) {
        kernel_boot_log("ext2 mount: block=1024 inodes=1024 blocks=2560\n");
    }
    match ext2_lookup_root(mount, bs"hello.txt") {
        Ext2LookupResult::Invalid => {
            kernel_boot_log("ext2 lookup: invalid\n");
        }
        Ext2LookupResult::NotFound => {
            kernel_boot_log("ext2 lookup: not found\n");
        }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_read_small_file(
                    mount, inode_number,
                    ext2_read_fixture as []u8) {
                Ext2ReadResult::Invalid => {
                    kernel_boot_log("ext2 read: invalid\n");
                }
                Ext2ReadResult::Read(length) => {
                    if (length == 16 &&
                        slice_eq(ext2_read_fixture[0..<16],
                                 bs"hello from ext2\n")) {
                        kernel_boot_log("ext2 read: /hello.txt ok\n");
                    }
                }
            }
        }
    }
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => {
            kernel_boot_log("ext2 write: invalid lookup\n");
        }
        Ext2LookupResult::NotFound => {
            kernel_boot_log("ext2 write: not found\n");
        }
        Ext2LookupResult::Found(mutable_inode) => {
            match ext2_write_small_file(
                    mount, mutable_inode, bs"after!\n") {
                Ext2WriteResult::Invalid => {
                    kernel_boot_log("ext2 write: invalid\n");
                }
                Ext2WriteResult::Written => {
                    match ext2_read_small_file(
                            mount, mutable_inode,
                            ext2_read_fixture as []u8) {
                        Ext2ReadResult::Invalid => {
                            kernel_boot_log("ext2 write: reread failed\n");
                        }
                        Ext2ReadResult::Read(written_length) => {
                            if (written_length == 7 &&
                                slice_eq(ext2_read_fixture[0..<7],
                                         bs"after!\n")) {
                                kernel_boot_log("ext2 write: /mutable.txt ok\n");
                            }
                        }
                    }
                }
            }
        }
    }
    if (ext2_resize_check(mount)) {
        kernel_boot_log("ext2 resize: truncate+extend ok\n");
    } else {
        kernel_boot_log("ext2 resize: failed\n");
    }
    match ext2_bitmap_roundtrip_check(mount) {
        Ext2BitmapProbeResult::Verified => {
            kernel_boot_log("ext2 bitmap: block+inode counts ok\n");
        }
        Ext2BitmapProbeResult::Invalid => {
            kernel_boot_log("ext2 bitmap: failed\n");
        }
    }
    match ext2_owner_roundtrip_check(mount) {
        Ext2BitmapProbeResult::Verified => {
            kernel_boot_log("ext2 owners: block+inode owners ok\n");
        }
        Ext2BitmapProbeResult::Invalid => {
            kernel_boot_log("ext2 owners: failed\n");
        }
    }
    if (ext2_create_check(mount)) {
        kernel_boot_log("ext2 create: create+lookup+unlink ok\n");
    } else {
        kernel_boot_log("ext2 create: failed\n");
    }
    if (ext2_create_in_directory_check(mount)) {
        kernel_boot_log("ext2 nested: create+lookup+unlink in /etc ok\n");
    } else {
        kernel_boot_log("ext2 nested: failed\n");
    }
    if (ext2_grow_directory_check(mount)) {
        kernel_boot_log("ext2 grow: /etc past one block ok\n");
    } else {
        kernel_boot_log("ext2 grow: failed\n");
    }
    if (ext2_nested_directory_check(mount)) {
        kernel_boot_log("ext2 mkdir: /etc/made/inner with .. and rmdir ok\n");
    } else {
        kernel_boot_log("ext2 mkdir: failed\n");
    }
    if (ext2_unlink_name_check(mount)) {
        kernel_boot_log("ext2 unlink: a hard link and a last link in /etc ok\n");
    } else {
        kernel_boot_log("ext2 unlink: failed\n");
    }
    match ext2_lookup_root(mount, bs"latest") {
        Ext2LookupResult::Invalid => {
            kernel_boot_log("ext2 symlink: invalid lookup\n");
        }
        Ext2LookupResult::NotFound => {
            kernel_boot_log("ext2 symlink: not found\n");
        }
        Ext2LookupResult::Found(link_inode) => {
            match ext2_read_fast_symlink(
                    mount, link_inode,
                    ext2_symlink_fixture as []u8) {
                Ext2SymlinkResult::Invalid => {
                    kernel_boot_log("ext2 symlink: invalid\n");
                }
                Ext2SymlinkResult::Read(target_length) => {
                    if (target_length == 9 &&
                        slice_eq(ext2_symlink_fixture[0..<9],
                                 bs"hello.txt")) {
                        match ext2_lookup_root(
                                mount,
                                ext2_symlink_fixture[0..<9]) {
                            Ext2LookupResult::Invalid => { }
                            Ext2LookupResult::NotFound => { }
                            Ext2LookupResult::Found(target_inode) => {
                                match ext2_read_small_file(
                                        mount, target_inode,
                                        ext2_read_fixture as []u8) {
                                    Ext2ReadResult::Invalid => { }
                                    Ext2ReadResult::Read(linked_length) => {
                                        if (linked_length == 16 &&
                                            slice_eq(ext2_read_fixture[0..<16],
                                                     bs"hello from ext2\n")) {
                                            kernel_boot_log("ext2 symlink: /latest -> hello.txt ok\n");
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // GitHub issue #243: /large.txt is 3200 bytes, spanning
    // 4 direct blocks (i_block[0..3]) -- the first fixture
    // read past the single-block cap ext2_read_small_file
    // used to enforce. Content is 3200 repetitions of 'A'
    // (0x41); checking the first byte, the last byte, and
    // the byte straddling the block-3/block-4 boundary
    // (offset 3071, the last byte of the 3rd full block)
    // catches an off-by-one in the per-block chunk/copy
    // arithmetic that checking only the first byte would
    // miss.
    match ext2_lookup_root(mount, bs"large.txt") {
        Ext2LookupResult::Invalid => {
            kernel_boot_log("ext2 multi-block: invalid lookup\n");
        }
        Ext2LookupResult::NotFound => {
            kernel_boot_log("ext2 multi-block: not found\n");
        }
        Ext2LookupResult::Found(large_inode) => {
            match ext2_read_small_file(
                    mount, large_inode,
                    ext2_large_fixture as []u8) {
                Ext2ReadResult::Invalid => {
                    kernel_boot_log("ext2 multi-block: read invalid\n");
                }
                Ext2ReadResult::Read(large_length) => {
                    if (large_length == 3200 &&
                        ext2_large_fixture[0] == 0x41 &&
                        ext2_large_fixture[3071] == 0x41 &&
                        ext2_large_fixture[3199] == 0x41) {
                        kernel_boot_log("ext2 multi-block: /large.txt 3200 bytes ok\n");
                    }
                }
            }
        }
    }
}

// Mounting the fixture image and running it, which both platforms reached the
// same way once the body above stopped being written twice. Extracting the
// body made this identical, and scripts/check_platform_file_parity.py said so
// on the next run -- the check finding the next layer down is what it is for.
fn kernel_ext2_mount_and_run(device: KernelBlockDevice) !{logs, unsafe} {
    match ext2_mount(device) {
        Ext2MountResult::Invalid => {
            kernel_boot_log("ext2 mount: invalid\n");
        }
        Ext2MountResult::Mounted(mount) => {
            kernel_ext2_fixture_run(mount);
        }
    }
}
