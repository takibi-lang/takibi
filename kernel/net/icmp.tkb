use "kernel/drivers/net/rp1_gem.tkb";
use "kernel/net/checksum.tkb";
use "kernel/net/wire.tkb";

// Ipv4Hdr/EthHdr are kernel/net/wire.tkb's shared structs (tcp.tkb needs
// the identical IPv4 wire layout, so it lives there rather than being
// declared twice). IcmpHdr is local to this file. GitHub issue #186:
// IcmpHdr's checksum field is typed `u16be` via the `packed be` sugar
// (ty/code stay `u8`, needing no swap; rest stays a raw 4-byte payload
// whose shape varies by ICMP type, never a single numeric value). IPV4_*
// below only remain for src/dst -- the two IP address fields that stay
// `[u8; 4]` and are still reached via offsetof-derived slicing, same as
// kernel/net/arp.tkb's ArpHdr sha/spa/tha/tpa.
struct packed be IcmpHdr {
    ty: u8;
    code: u8;
    checksum: u16;
    rest: [u8; 4];
}

let IPV4_SRC: usize = offsetof(Ipv4Hdr, src);
let IPV4_DST: usize = offsetof(Ipv4Hdr, dst);

must_use variant KernelIcmpResult {
    TimedOut(NetRxCanAcquire);
    Replied(NetRxCanAcquire);
}

fn icmp_build_echo_reply(ethernet: borrow [u8; 42..],
                         ihl: {20..<21 as u16},
                         icmp: borrow [u8; 8..]) {
    slice_copy(ethernet[0..<6], ethernet[6..<12]);
    slice_copy(ethernet[6..<12], OUR_MAC as []u8);

    let ipv4 = ethernet[14..<34];
    let ip_hdr: *Ipv4Hdr = ipv4 as *Ipv4Hdr;
    slice_copy(ipv4[IPV4_DST..<20], ipv4[IPV4_SRC..<IPV4_DST]);
    slice_copy(ipv4[IPV4_SRC..<IPV4_DST], OUR_IP as []u8);
    ip_hdr.ttl = 64;
    ip_hdr.checksum = 0;
    ip_hdr.checksum = (inet_checksum(ipv4[0..<ihl as usize]) as u16) as u16be;

    let icmp_hdr: *IcmpHdr = icmp as *IcmpHdr;
    icmp_hdr.ty = 0;
    icmp_hdr.checksum = 0;
    icmp_hdr.checksum = (inet_checksum(icmp) as u16) as u16be;
}

// Facts proven once by icmp_parse_ipv4 and threaded through by type
// alone (LetMatch, GitHub issue #183) instead of by staying nested
// inside the `if` that proved them. `icmp_length` is total_length -
// ihl, computed here (not re-derived later) because this is the one
// place `total_length >= ihl` is already known, so the subtraction
// cannot underflow.
struct Ipv4Header {
    ihl: {20..<21 as u16};
    total_length: u16;
    icmp_length: u16;
}

must_use variant Ipv4ParseResult {
    Reject;
    Parsed(Ipv4Header);
}

fn icmp_parse_ipv4(frame: borrow [u8; 1514..], len: i32) -> Ipv4ParseResult {
    if (len >= 42 && len <= 1514) {
        let eth: *EthHdr = frame as *EthHdr;
        if (eth.ethertype == ETHERTYPE_IPV4) {
            let ipv4 = frame[14..<34];
            let ip_hdr: *Ipv4Hdr = ipv4 as *Ipv4Hdr;
            let version: u8 = ip_hdr.version_ihl >> 4;
            let ihl: u16 = (ip_hdr.version_ihl & 0x0F) as u16 * 4;
            if (version == 4 && ihl == 20) {
                let len16: u16 = len as u16;
                let total_length: u16 = ip_hdr.total_len as u16;
                let ipv4_bytes_in_frame: u16 = len16 - 14;
                if (total_length <= ipv4_bytes_in_frame &&
                    total_length >= ihl &&
                    ip_hdr.protocol == 1 &&
                    inet_checksum(ipv4[0..<ihl as usize]) == 0 &&
                    slice_eq(ipv4[IPV4_DST..<20], OUR_IP as []u8)) {
                    let icmp_length: u16 = total_length - ihl;
                    let mut header: Ipv4Header = {ihl, total_length, icmp_length};
                    return Ipv4ParseResult::Parsed(header);
                }
            }
        }
    }
    return Ipv4ParseResult::Reject;
}

must_use variant IcmpEchoParseResult {
    Reject;
    Parsed({8..<1481 as u16});
}

fn icmp_parse_echo_request(frame: borrow [u8; 1514..],
                            icmp_length: u16) -> IcmpEchoParseResult {
    if (icmp_length >= 8 && icmp_length <= 1480) {
        let icmp_length_index: usize = icmp_length as usize;
        let icmp = frame[34..<34 + icmp_length_index];
        let icmp_hdr: *IcmpHdr = icmp as *IcmpHdr;
        if (icmp_hdr.ty == 8 &&
            icmp_hdr.code == 0 &&
            inet_checksum(icmp) == 0) {
            return IcmpEchoParseResult::Parsed(icmp_length);
        }
    }
    return IcmpEchoParseResult::Reject;
}

// Flattens icmp_parse_ipv4 -> icmp_parse_echo_request -> reply-build
// into a straight-line sequence: each LetMatch either yields the next
// proven value (its declared type, e.g. Ipv4Header or the refined
// icmp_length, stays valid for the rest of this function -- unlike
// plain `if` narrowing, which dies at the branch) or returns 0
// ("not a request we reply to") on the Reject arm.
fn icmp_try_build_reply(frame: borrow [u8; 1514..], len: i32) -> i32 {
    let mut header: Ipv4Header = match icmp_parse_ipv4(frame, len) {
        Ipv4ParseResult::Reject => { return 0; }
        Ipv4ParseResult::Parsed(h) => { h }
    };
    let mut icmp_length: {8..<1481 as u16} =
        match icmp_parse_echo_request(frame, header.icmp_length) {
            IcmpEchoParseResult::Reject => { return 0; }
            IcmpEchoParseResult::Parsed(l) => { l }
        };
    let icmp = frame[34..<34 + icmp_length as usize];
    icmp_build_echo_reply(frame, header.ihl, icmp);
    return 14 + header.total_length as i32;
}

fn kernel_icmp_reply_once(ready_in: sink NetRxCanAcquire)
        -> KernelIcmpResult !{may_block} {
    let mut ready = ready_in;
    let start: i64 = read_cntpct();
    let deadline_ticks: i64 = read_cntfrq() * 15;
    while ((read_cntpct() - start) < deadline_ticks) {
        net_rx_wait();
        match net_rx_acquire(ready) {
            NetRxAcquire::None(next) => { ready = next; }
            NetRxAcquire::Acquired(acquired) => {
                let len: i32 = net_rx_len(acquired);
                let frame = net_rx_frame(acquired);
                let reply_length: i32 = icmp_try_build_reply(frame, len);
                if (reply_length != 0) {
                    let completed = net_rx_send_reply(
                        net_rx_reply_ready(acquired, reply_length));
                    return KernelIcmpResult::Replied(completed);
                }
                ready = net_rx_release(acquired);
            }
        }
    }
    return KernelIcmpResult::TimedOut(ready);
}
