// Bounded TCP state machine for the standalone kernel.
// It validates IPv4/TCP checksums and connection identity, implements
// LISTEN -> SYN_RCVD -> ESTABLISHED -> LAST_ACK, reconstructs in-order data,
// acknowledges duplicate/out-of-order data without consuming it twice, retries
// SYN/ACK, data, and FIN on bounded deadlines, and returns to LISTEN after
// close. Data-bearing input currently requires a 20-byte TCP header; SYN
// options are accepted and discarded in replies. Transmit retry state uses a
// bounded four-slot queue, including independent data and FIN retransmission.
// This concrete bound removes the relational payload slice that the broader
// prototype implementation needed to mark unsafe, keeping this path free
// of unsafe blocks and clean under the kernel's --forbid-trap build.
//
// Current limitations (2026-08-20, issues #295 and #257). Keep this list
// current as call sites change; a limitation that goes stale here is
// worse than none.
// - NOT SYNCHRONIZED, single-core only, same as every kernel/lib/-backed
//   pool this file uses (SlotMap for tcp_connection_pool,
//   IntrusivePool for the retransmit queue). The retransmit pool's own
//   mutation is at least IRQ-safe now (kernel/lib/pool_lock.tkb masks
//   DAIF.I), which the nine arrays it replaced were not; excluding a
//   second CPU is still nobody's job here -- see issue #261.
// - THERE IS NO CEILING LEFT. TCP_CONNECTION_MAX and PENDING_TCP_MAX are
//   both gone (issue #257): a connection is a slot in
//   IntrusivePool(TcpConnection), its frames are slots in a NetFrame pool,
//   and its unacknowledged segments are a chain of pooled entries. The
//   only exhaustion left is the page allocator being empty, still logged
//   via kernel_boot_log_resource_exhausted and still reported to callers
//   exactly as a full fixed pool was -- TcpConnectionAllocResult::Full
//   and pending_tcp_record's "not tracked", both unchanged, because the
//   caller's correct response to memory pressure is the same one it had
//   to a hand-picked limit.
// - A CONNECTION'S IDENTITY IS AN ADDRESS. What used to be
//   `{0..<TCP_CONNECTION_MAX as usize}` -- a proof that an index named a
//   real array element -- is intrusive_pool_matches, which proves more:
//   that the address names a live slot of THIS pool whose occupant is
//   still the one the generation names. See kernel/kernel/fd_table.tkb's
//   transport_slot for what that means at the boundary where the pair is
//   stored.
// - THE RECEIVE PATH NOW ALLOCATES. Queuing a segment for retransmission
//   takes a page from kernel/mm/page.tkb when the current chunk is full.
//   That is reached from net_rx_wait() onward -- `!{may_block}` thread
//   context, the one context that touches TCP -- never from an interrupt
//   handler. The retransmit pool retains no empty chunk (retained_chunks
//   = 0, unlike kernel/lib/intrusive_pool.tkb's own default) so that a
//   drained queue holds no page: this kernel checks "no page held at
//   rest" as an invariant, and issue #373 is a live reason not to hold
//   one anyway.
// - This file has the `unsafe` EFFECT now, and no unsafe BLOCKS. Every
//   entry point of kernel/lib/intrusive_pool.tkb that reaches a payload
//   or a chunk header carries it, so anything calling them inherits it.
//   The distinction is worth keeping straight: nothing here elides a
//   check of its own.
// - Exactly one physical RX capability (NetRxCanAcquire,
//   kernel/net/socket_capability.tkb) exists for the whole kernel; every
//   connection's send/receive path borrows and returns it sequentially --
//   there is no real concurrent packet processing across connections.
// - No congestion control or window scaling; retransmission is a fixed,
//   bounded retry count (TCP_RETRY_LIMIT), not RTT-adaptive.
// - This subsystem's retry/retransmit timing has been a recurring source
//   of flaky-test regressions (see git history around GEM/USB interrupt-
//   driven transitions) -- treat any change to retry/deadline logic here
//   as higher-risk than an equivalent change elsewhere, and prefer
//   logging-only fixes over control-flow changes when diagnosing an
//   exhaustion/edge case that isn't the actual bug being fixed.
//
use "kernel/net/checksum.tkb";
use "kernel/net/arp.tkb";
use "kernel/net/wire.tkb";
use "kernel/net/icmp.tkb";
// GitHub issue #257 step 5: kernel/lib/slotmap.tkb and its freelist are
// gone from this file -- a SlotMap(N) is exactly the compile-time ceiling
// this issue set out to remove, and the pool below replaces both the
// allocation and the generation bookkeeping it provided.
// GitHub issue #257: the retransmit queue is a pool now, not an array.
// kernel/lib/intrusive_pool.tkb names its page provider's symbols without
// `use`ing anyone (issue #364), so kernel/mm/page.tkb has to be reached
// FIRST -- the order of these three lines is load-bearing, and getting it
// wrong fails with an unbound constant rather than silently. pool_lock is
// the lock backend that file likewise names without binding.
use "kernel/mm/page.tkb";
use "kernel/lib/pool_lock.tkb";
use "kernel/lib/intrusive_pool.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/mutex.tkb";

let mut our_mac: [u8; 6];

// IPv4/TCP field offsets and byte-order helpers live in kernel/net/wire.tkb.

// TCP_FLAG_*/PROTO_TCP/TCP_ECHO_PORT are wire-VALUE constants compared
// directly against a byte/half-word field, so they take that field's
// natural width (u8/u16) -- unlike the pure offset constants above,
// which are usize (array/slice indexing is usize-only, see CLAUDE.md's
// "Array/Slice Indices Must Be usize" section). ihl/total_len/tcp_len/tcp_hdr_len/
// data_len/data_off below are ALSO u16-based: `len` (net_rx_len()'s
// deliberately-unconstrained i32 device-reported length) is bridged into
// u16 with ONE bridge cast (`as u16`) right after its own range is
// established, and everything downstream inherits u16-based refined
// ranges through ordinary Add/Sub/comparison propagation from there.
// GitHub issue #72: every bridge cast in this file is written as a bare
// `as <base>` -- the target range is inferred from the source's own
// already-proven range rather than restated by hand.
const TCP_ECHO_PORT: u16 = 7;

// Safe upper bound on the echoed payload: 1514 (frame capacity) - 14
// (eth) - 20 (IP) - 20 (TCP, no options in OUR reply) = 1460. Checked
// explicitly in build_data_echo before constructing the reply segment --
// see that function's comment.
const TCP_MAX_PAYLOAD: u16 = 1460;
const TCP_RETRY_LIMIT: usize = 3;

enum ConnState: u8 {
    Listen;
    SynRcvd;
    Established;
    LastAck;
}

enum PendingTcpKind: u8 { None; Data; Fin; }

// GitHub issue #257: the per-connection state that used to be eleven
// parallel [T; TCP_CONNECTION_MAX] arrays, gathered into one struct.  Only
// the storage SHAPE changes with this: the pool, TcpConnectionOwner's
// refined pool_index, and the tcp_connection_store parking lot below are
// all untouched, and TCP_CONNECTION_MAX still sizes the array of these.
// What it buys is the step after it -- a pool hands back a
// *TcpConnection, and once every per-connection field is reached through
// that pointer there is nothing left keyed by a connection INDEX for a
// ceiling to be the size of.
//
// The byte arrays deliberately stay outside: tcp_stream_tx_frame (1514),
// pending_tcp_frame (6056) and syscall.tkb's own six came to 10490 bytes
// per connection, against the 3968 an intrusive_pool chunk holds.  That
// is what forced this issue's control-block/frame/retransmit split rather
// than one payload, and it is why they move separately, into pools of
// their own, rather than being inlined here.  Two of the three are gone
// already: the retransmit queue (step 3b) and the transmit frame (step
// 4a, see NetFrame below).  syscall.tkb's two 1460-byte buffers are step
// 4b, and are all that is left.
struct TcpConnection {
    state: ConnState;
    remote_ip: [u8; 4];
    remote_mac: [u8; 6];
    remote_port: u16;
    local_port: u16;
    snd_nxt: u32;               // next unacknowledged seq
    rcv_nxt: u32;               // next expected seq
    received_length: usize;
    data_segment_counter: usize;
    // GitHub issue #257: the syscall layer's own per-connection state,
    // which was four more [T; TCP_CONNECTION_MAX] arrays (private ones)
    // in kernel/kernel/syscall.tkb until it moved here. They are public
    // fields rather than private ones because their only readers are in
    // that other file -- the privacy they had as file-local globals
    // cannot survive the move, and pretending otherwise with a wall of
    // accessors would buy nothing. connection_open is the fd-visible
    // "this slot is a live socket", distinct from state == Established:
    // close(2) clears it while the TCP machine is still finishing
    // LAST_ACK. socket_buffer_length/_offset are the read(2) cursor into
    // the connection's receive buffer, and are NOT received_length above
    // -- that one is the last segment's payload size as the TCP layer
    // saw it, these two are how much of the buffer userspace has drained.
    // GitHub issue #257 step 5: this connection's own pool address, so
    // that a *TcpConnection is enough to name it -- a retransmit entry
    // records which connection it belongs to, and with no index left there
    // is nothing else to record.
    self_address: usize;
    // Step 4: the pool slot address of this connection's transmit frame,
    // 0 if it has none. The OWNER is `tx` below; this is how the bytes are
    // found, and it is deliberately an erased address rather than a second
    // copy of the handle -- validated by the pool on every use.
    tx_frame: usize;
    // Step 4b, same shape: the receive buffer read(2) drains, and the
    // response buffer inetd-mode write(2) appends to.
    rx_frame: usize;
    inetd_frame: usize;
    connection_open: bool;
    socket_buffer_length: usize;
    socket_buffer_offset: usize;
    inetd_response_length: usize;
    // How many retransmit entries this connection still has on the queue.
    // Counted rather than walked: the chain is stable-owner storage, so
    // even a read-only walk of it has to take and put every link, and
    // kernel_tcp_close_stream polls this in a loop.
    retx_count: usize;
    // Which retransmit entry is the one currently armed for
    // drop-recovery observation, 0 if none -- an entry's pool slot
    // ADDRESS, where issue #180 used a queue slot index (and -1). Same
    // role: pending_tcp_service_once can require the retransmit+ack it
    // observed came from THIS specific entry, not merely "some Data/Fin
    // entry or other", which matters because several can be in flight for
    // one connection at once. A pool slot address is never 0, so 0 is the
    // "none" sentinel that -1 used to be.
    //
    // Same staleness caveat the slot index had, neither better nor worse:
    // an entry is freed when its ack arrives, and its slot can be handed
    // back to a later entry, so a value left armed across that would match
    // the wrong entry. Every injection resets it, and nothing outside the
    // deliberate-drop tests reads it.
    injected_data_entry: usize;
    injected_fin_entry: usize;
    // Step 5: the three frame owners, which step 4 had to keep in a
    // separate private array (ConnectionFrames) because a global holding
    // linear owners must be `private` and tcp_connections was read from
    // kernel/kernel/syscall.tkb. The connection lives in a private pool
    // now, so they come home. Three stable owner fields under one mutex --
    // linux_user/tcp_pool_shape's first claim.
    //
    // Their presence is why every allocation of a TcpConnection must go
    // through intrusive_pool_insert_zeroed: a recycled slot is neither
    // zero nor fresh, and the language's empty state for such a field is
    // an inherited zero tag (issue #369). That is checked, not remembered
    // -- plain insert does not compile for this T.
    private frames_mutex: Mutex;
    private tx: FrameLink;
    private rx: FrameLink;
    private inetd: FrameLink;
}

// Issue #189: TCP connections have dynamic lifetimes. Callers receive a
// linear owner whose static identity is a monotonically increasing
// generation; the runtime slot is only the pool location. Reusing a freed
// slot therefore cannot make a stale (slot, generation) descriptor refer
// to the new stream.
//
// GitHub issue #257: `pool_index` was `{0..<TCP_CONNECTION_MAX as usize}`
// -- a proof that the index named a real array element. There is no array
// and no index now: `slot` is the pool ADDRESS of the connection, and what
// used to be a bounds proof is intrusive_pool_matches, which checks that
// the address lands on a real slot of THIS pool and that the occupant is
// still the one the generation names. Strictly more than the refinement
// proved, since a refinement could not tell a live connection from a
// recycled one -- that was always the generation's job.
linear struct TcpConnectionOwner[connection: usize] {
    private slot: usize;
    private generation: usize @ connection;
}

must_use variant TcpConnectionAllocResult {
    Full;
    Allocated(exists connection: usize. TcpConnectionOwner[connection]);
}

must_use variant TcpConnectionTakeResult {
    Missing;
    Ready(exists connection: usize. TcpConnectionOwner[connection]);
}

// GitHub issue #257: THE PARKING LOT IS GONE.
//
// `tcp_connection_store` was a [TcpConnectionStore; TCP_CONNECTION_MAX] of
// { mutex, TcpConnectionValue } -- somewhere for a linear owner to live
// between syscalls, since a syscall returns to userspace and cannot hold
// one. `tcp_connection_take` pulled the owner out of a stable slot,
// `tcp_connection_put` shoved it back, and TcpConnectionPutResult::Conflict
// described "the slot already had one", which the stable_replace /
// displaced / Ready(incoming) dance existed to handle.
//
// With a pool there is nowhere to park and nothing to conflict with: the
// connection IS the slot, the fd table already holds its (address,
// generation), and an owner is MINTED from that pair on demand and
// discharged when the operation ends. So `take` is a validation,
// `put` is a drop, `Conflict` is unreachable, and TcpConnectionValue,
// TcpConnectionStore, TcpConnectionGuard, tcp_connection_lock/_unlock and
// TcpConnectionPutResult are deleted rather than ported.
private let mut tcp_connection_pool: IntrusivePool(TcpConnection);
private let mut tcp_connection_pool_ready: bool = false;

// Reached only when an address that should name a live connection does
// not. A real struct rather than a null pointer so the impossible case is
// harmless instead of undefined, exactly as tcp_frame_absent_fallback is
// for frames. Private because it holds stable owner storage.
private let mut tcp_connection_absent_fallback: TcpConnection;
let mut tcp_completed_handshakes: usize = 0;
let mut tcp_completed_echoes: usize = 0;
let mut tcp_completed_closes: usize = 0;
let mut tcp_drop_next_syn_ack: bool = false;
let mut tcp_injected_syn_pending: bool = false;
let mut tcp_injected_syn_retransmitted: bool = false;
let mut tcp_injected_syn_accepted: bool = false;
// GitHub issue #180: a single write() (up to TCP_MAX_PAYLOAD) used to be
// the only unit of retransmission tracking (one pending slot).
// Consecutive write()s on one connection -- exactly what
// kernel/arch/arm64/kernel/user_entry.S's EL0 fixture already does (19 +
// 1460 + 1 bytes, three separate write() calls) -- silently overwrote an
// earlier segment's still-unacknowledged retransmission record. #180 fixed
// that with PENDING_TCP_MAX = 4 independent slots per connection, held in
// nine flat [T; PENDING_TCP_MAX * TCP_CONNECTION_MAX] arrays.
//
// GitHub issue #257: there is no PENDING_TCP_MAX now. An in-flight segment
// is a RetxEntry allocated from a pool with no ceiling, and the queue is a
// chain those entries thread among themselves -- so "how many segments may
// be outstanding" stopped being a number anyone picks and became a
// question about how many pages the machine has.
//
// The chain is GLOBAL, not per connection, and each entry names the
// connection it belongs to. Not a design preference: a global holding
// linear owners must be `private` (SPEC's stable-owner storage rule), and
// tcp_connections is read from kernel/kernel/syscall.tkb, so a per-
// connection chain head could not live in it. It is also the better shape
// -- one retransmit queue for the stack is what a real kernel keeps -- and
// it is what makes this step add no array of its own to replace the nine
// it removes. Every walk below filters on conn, so what each
// connection sees is exactly what it saw when the queue was its own.
//
// The 1514-byte frame lives INLINE in the entry rather than in a second
// pool of NetFrames. tcp_pool_shape's three-pool sketch has the frames
// separate so a frame can move from a connection into an entry by handle
// instead of by copy -- worth having, and it needs the connection's own
// transmit frame to be pooled first, which is the step after this one.
// Copying here keeps this commit's behaviour identical to what it
// replaces, and an entry's slot is 2 to a page either way.
variant RetxLink {
    End;
    More(exists p: addr. exists a: usize. IntrusiveOwner[p, a]);
}

// pending_tcp_kind/_frame/_frame_length/_expected_ack/_remote_ip/
// _remote_port/_local_port/_sent_at/_retries, one entry instead of nine
// arrays -- plus `connection`, the pool address of the connection this
// entry belongs to (the arrays encoded that in their index arithmetic,
// and step 5 left no index to encode), and `next`, which is what removes
// the ceiling.
struct RetxEntry {
    private mutex: Mutex;
    private next: RetxLink;
    connection: usize;
    kind: PendingTcpKind;
    frame_length: usize;
    expected_ack: u32;
    remote_ip: [u8; 4];
    remote_port: u16;
    local_port: u16;
    sent_at: i64;
    retries: usize;
    frame: [u8; 1514];
}

// A bare global cannot hold a variant, so the chain head is wrapped the
// same way tcp_connection_store wraps its own: a struct carrying the
// mutex its stable_replace needs.
struct RetxChain {
    private mutex: Mutex;
    private head: RetxLink;
}

// GitHub issue #451: a linear STRUCT, not an erased view any more.
// A view emits nothing, so it could not carry the interrupt state a
// release must restore -- and it did not need to while the lock itself
// emitted nothing either. Now that mutex_acquire really masks and really
// takes, `flags` is the frame slot Linux's own `unsigned long flags`
// occupies, and holding it per-guard is what makes the pair correct
// inside an interrupt handler (DAIF.I already set on entry, so release
// leaves it set) and correct when two nest. Identity is unchanged:
// `[lock: addr]` still makes another container's guard a compile error.
private linear struct RetxGuard[lock: addr] {
    private flags: usize;
}
private let mut tcp_retx_chain: RetxChain;
private let mut tcp_retx_pool: IntrusivePool(RetxEntry);
// See tcp_connection_pool_init: that function is a reset called many
// times, and the pool must be constructed exactly once.
private let mut tcp_retx_pool_ready: bool = false;

let mut tcp_drop_data_segment_index: i32 = -1;
let mut tcp_injected_data_retransmitted: bool = false;
let mut tcp_injected_data_recovery_observed: bool = false;
let mut tcp_drop_next_fin: bool = false;
let mut tcp_injected_fin_retransmitted: bool = false;
let mut tcp_injected_fin_recovery_observed: bool = false;
let mut tcp_advertised_window: u16 = 65535;
let mut tcp_ack_each_stream_segment: bool = false;
let mut tcp_split_request_segments: usize = 0;

must_use variant KernelTcpResult {
    TimedOut(NetRxCanAcquire);
    Verified(NetRxCanAcquire);
}

must_use variant KernelTcpAcceptResult {
    TimedOut(NetRxCanAcquire);
    Accepted(NetRxCanAcquire);
}

must_use variant KernelTcpReceiveResult {
    TimedOut(NetRxCanAcquire);
    Received(NetRxCanAcquire);
}

must_use variant KernelTcpSendResult {
    Invalid(NetRxCanAcquire);
    Sent(NetRxCanAcquire);
}

variant TcpReceiveDisposition {
    Ignore;
    AckOnly;
    Payload(usize);
}

variant TcpRxPlan {
    Release;
    Send(i32);
}

must_use variant KernelTcpCloseResult {
    Closed(NetRxCanAcquire);
}

// GitHub issue #257, step 4a: the transmit frame a connection builds its
// outgoing segment in was `[u8; 1514 * TCP_CONNECTION_MAX]`. It is a
// pooled NetFrame now, so the bytes are not committed at link time and
// their number is not a multiple of a constant anyone picked.
//
// One MTU, and the same struct will serve the two 1460-byte syscall-side
// buffers in step 4b -- there is no reason for three sizes when the
// difference is 54 bytes of header and the pool's slot rounding eats it
// anyway.
struct NetFrame {
    len: usize;
    bytes: [u8; 1514];
}

// A parked handle. The brand is existentially quantified (issue #370):
// the field knows it holds SOME pool's handle, not this pool's, so a
// cross-pool mixup falls to intrusive_pool_slot_is_valid at runtime
// rather than to `static value mismatch` at compile time. Stated here
// because it is the price of the container, not a surprise.
variant FrameLink {
    None;
    Some(exists p: addr. exists a: usize. IntrusiveOwner[p, a]);
}

// GitHub issue #451: a linear STRUCT, not an erased view any more.
// A view emits nothing, so it could not carry the interrupt state a
// release must restore -- and it did not need to while the lock itself
// emitted nothing either. Now that mutex_acquire really masks and really
// takes, `flags` is the frame slot Linux's own `unsigned long flags`
// occupies, and holding it per-guard is what makes the pair correct
// inside an interrupt handler (DAIF.I already set on entry, so release
// leaves it set) and correct when two nest. Identity is unchanged:
// `[lock: addr]` still makes another container's guard a compile error.
private linear struct FrameGuard[lock: addr] {
    private flags: usize;
}
private let mut tcp_frame_pool: IntrusivePool(NetFrame);
private let mut tcp_frame_pool_ready: bool = false;

// Reached only when a frame is missing from a connection that should have
// one -- which the acquire/release pairing below is meant to make
// impossible. A real buffer rather than a null pointer so that the
// impossible case is harmless instead of undefined: the caller writes a
// segment nobody sends, rather than faulting or scribbling on whatever
// address 0 maps to. Every arrival is logged.
private let mut tcp_frame_absent_fallback: [u8; 1514];

fn tcp_frame_lock(m: *Mutex @ address) -> FrameGuard[address] {
    let mut guard: FrameGuard[address] = { mutex_acquire(m) };
    return guard;
}

fn tcp_frame_unlock(guard: sink FrameGuard[address],
                    m: *Mutex @ address) {
    mutex_release(m, guard.flags);
}

// Give a parked frame back. #370's cost in full: the handle came out of a
// stable slot, so its brand is existential, and intrusive_pool_remove
// wants one branded to THIS pool. Opening the existential mints a fresh
// identity that will not match, so the only route is to take the slot and
// generation off the handle, discharge it, and rebuild -- which is
// exactly the one way to produce a handle the pool did not mint, and
// exactly why remove validates before it trusts one.
fn tcp_frame_release_link(link: FrameLink) !{unsafe} {
    match link {
        FrameLink::None => {}
        FrameLink::Some(parked) => {
            let slot: usize = intrusive_owner_slot(parked);
            let generation: usize = intrusive_owner_generation(parked);
            intrusive_owner_drop(parked);
            let branded = intrusive_owner_new(&tcp_frame_pool, slot, generation);
            let guard = intrusive_pool_lock(&tcp_frame_pool);
            tcp_pool_remove_expected(
                intrusive_pool_remove(&tcp_frame_pool, guard, branded),
                "parked frame release" as *u8);
            intrusive_pool_unlock(&tcp_frame_pool, guard);
        }
    }
}

// GitHub issue #371: every intrusive_pool_remove in this file discharges a
// handle this file just minted, or rebuilt from a record it still holds.
// So a refusal is a kernel bug in this file, not a race a caller could
// have caused -- there is nothing to return it to and nothing to do
// differently, but there is everything to be gained by saying it out
// loud. Being quiet about a pool refusing a handle is what the counters
// left behind: a number nobody reads until they are already debugging.
//
// The pool has not touched its free chain by this point, so continuing is
// safe; what is lost is one slot, which the leak shows up as.
private fn tcp_pool_remove_expected(result: IntrusivePoolRemoveResult,
                                    site: *u8) {
    let (ok, reason) = intrusive_remove_outcome(result);
    if (ok) { return; }
    kernel_boot_log("tcp: pool remove at ");
    kernel_boot_log(site);
    kernel_boot_log(" -- ");
    kernel_boot_log(reason);
    kernel_boot_log("\n");
}

// Hands this connection its transmit frame, or returns false having
// changed nothing. Called from tcp_connection_alloc, whose Full result is
// exactly the right thing to report when it fails -- a connection with no
// frame to transmit from is not a connection this stack can serve.
// One frame from the pool, or 0. insert_zeroed is not required (NetFrame
// holds no stable owner storage) but is used anyway: a transmit frame is
// filled header-first and a short segment leaves the tail untouched, so a
// recycled slot would otherwise put a previous connection's bytes on the
// wire past the length the caller meant to send -- and the same argument
// covers a receive buffer read back past its recorded length.
fn tcp_frame_take() -> (FrameLink, usize) !{unsafe} {
    let pool_guard = intrusive_pool_lock(&tcp_frame_pool);
    let inserted = intrusive_pool_insert_zeroed(&tcp_frame_pool, pool_guard);
    intrusive_pool_unlock(&tcp_frame_pool, pool_guard);
    match inserted {
        IntrusivePoolInsertResult::OutOfMemory => {
            kernel_boot_log_resource_exhausted(
                "TCP frame pool (out of pages)" as *u8, 0);
            return (FrameLink::None, 0);
        }
        IntrusivePoolInsertResult::Allocated(owner) => {
            // The address comes back beside the link because a link is
            // linear: reading it out of the parked handle later would mean
            // consuming the handle to look at it.
            let address: usize = intrusive_owner_slot(owner);
            return (FrameLink::Some(owner), address);
        }
    }
}

// Hands this connection its three frames, or returns false having released
// whatever it managed to take. Called from tcp_connection_alloc, whose Full
// result is exactly the right thing to report when it fails -- a connection
// with no frame to transmit from is not one this stack can serve.
fn tcp_connection_frames_acquire(conn: *TcpConnection) -> bool !{unsafe} {
    mutex_init(&conn.frames_mutex);
    let (tx, tx_address) = tcp_frame_take();
    if (tx_address == 0) {
        tcp_frame_release_link(tx);
        return false;
    }
    let (rx, rx_address) = tcp_frame_take();
    if (rx_address == 0) {
        tcp_frame_release_link(rx);
        tcp_frame_release_link(tx);
        return false;
    }
    let (inetd, inetd_address) = tcp_frame_take();
    if (inetd_address == 0) {
        tcp_frame_release_link(inetd);
        tcp_frame_release_link(rx);
        tcp_frame_release_link(tx);
        return false;
    }

    let tx_guard = tcp_frame_lock(&conn.frames_mutex);
    let displaced_tx: FrameLink = stable_replace(
        tx_guard, &conn.frames_mutex, conn.tx, tx);
    tcp_frame_unlock(tx_guard, &conn.frames_mutex);
    tcp_frame_release_displaced(displaced_tx);

    let rx_guard = tcp_frame_lock(&conn.frames_mutex);
    let displaced_rx: FrameLink = stable_replace(
        rx_guard, &conn.frames_mutex, conn.rx, rx);
    tcp_frame_unlock(rx_guard, &conn.frames_mutex);
    tcp_frame_release_displaced(displaced_rx);

    let inetd_guard = tcp_frame_lock(&conn.frames_mutex);
    let displaced_inetd: FrameLink = stable_replace(
        inetd_guard, &conn.frames_mutex, conn.inetd, inetd);
    tcp_frame_unlock(inetd_guard, &conn.frames_mutex);
    tcp_frame_release_displaced(displaced_inetd);

    conn.tx_frame = tx_address;
    conn.rx_frame = rx_address;
    conn.inetd_frame = inetd_address;
    return true;
}

// Acquiring over a frame this connection already had. Release rather than
// leak it, and say so: the acquire/release pairing is supposed to make
// this unreachable.
fn tcp_frame_release_displaced(link: FrameLink) !{unsafe} {
    match link {
        FrameLink::None => {}
        FrameLink::Some(stale) => {
            kernel_boot_log("tcp frames: acquire displaced a live frame\n");
            tcp_frame_release_link(FrameLink::Some(stale));
        }
    }
}

fn tcp_connection_frames_release(conn: *TcpConnection) !{unsafe} {
    let tx_guard = tcp_frame_lock(&conn.frames_mutex);
    let held_tx: FrameLink = stable_replace(
        tx_guard, &conn.frames_mutex, conn.tx, FrameLink::None);
    tcp_frame_unlock(tx_guard, &conn.frames_mutex);
    tcp_frame_release_link(held_tx);

    let rx_guard = tcp_frame_lock(&conn.frames_mutex);
    let held_rx: FrameLink = stable_replace(
        rx_guard, &conn.frames_mutex, conn.rx, FrameLink::None);
    tcp_frame_unlock(rx_guard, &conn.frames_mutex);
    tcp_frame_release_link(held_rx);

    let inetd_guard = tcp_frame_lock(&conn.frames_mutex);
    let held_inetd: FrameLink = stable_replace(
        inetd_guard, &conn.frames_mutex, conn.inetd, FrameLink::None);
    tcp_frame_unlock(inetd_guard, &conn.frames_mutex);
    tcp_frame_release_link(held_inetd);

    conn.tx_frame = 0;
    conn.rx_frame = 0;
    conn.inetd_frame = 0;
}

// The transmit frame as a slice, reached by ADDRESS rather than by taking
// the parked handle out and putting it back. The owner stays parked --
// what it carries is the obligation to free, which nothing here wants to
// borrow; what a caller wants is the bytes, and
// intrusive_pool_probe_slot validates the address and gates the payload
// behind a view it has to spend. So ownership stays linear and access
// stays cheap, without either one pretending to be the other.
fn tcp_frame_slice(address: usize) -> [u8; 1514..] !{unsafe} {
    match intrusive_pool_probe_slot(&tcp_frame_pool, address) {
        IntrusiveSlotProbe::NoPayload => {
            kernel_boot_log("tcp frames: frame missing\n");
            return tcp_frame_absent_fallback as [u8; 1514..];
        }
        IntrusiveSlotProbe::Live(slot_view) => {
            let frame: *NetFrame =
                intrusive_pool_payload_of(&tcp_frame_pool, slot_view);
            return frame.bytes as [u8; 1514..];
        }
    }
}

fn tcp_connection_tx_slice(conn: *TcpConnection) -> [u8; 1514..] !{unsafe} {
    return tcp_frame_slice(conn.tx_frame);
}

// The two syscall-side buffers. 1460 rather than 1514 because that is what
// the callers bound their lengths by; the frame behind them is one MTU, so
// the extra 54 bytes are headroom nobody addresses, not a second size.
fn tcp_connection_rx_slice(conn: *TcpConnection) -> [u8; 1460..] !{unsafe} {
    let frame = tcp_frame_slice(conn.rx_frame);
    return frame[0..<1460];
}

fn tcp_connection_inetd_slice(conn: *TcpConnection) -> [u8; 1460..] !{unsafe} {
    let frame = tcp_frame_slice(conn.inetd_frame);
    return frame[0..<1460];
}

fn tcp_connection_owner_new(slot: usize, generation: usize @ connection)
        -> TcpConnectionOwner[connection] {
    let mut owner: TcpConnectionOwner[connection] = { slot, generation };
    return owner;
}

fn tcp_connection_owner_drop(owner: sink TcpConnectionOwner[connection]) {}

// The connection a pool address names. Validated on every call: the
// address may have come from an fd table entry that outlived the
// connection it describes, and intrusive_pool_probe_slot rejects both a
// bogus address and a live slot whose occupant has moved on.
fn tcp_connection_payload(address: usize) -> *TcpConnection !{unsafe} {
    match intrusive_pool_probe_slot(&tcp_connection_pool, address) {
        IntrusiveSlotProbe::NoPayload => {
            kernel_boot_log("tcp: connection address names no live slot\n");
            return &tcp_connection_absent_fallback;
        }
        IntrusiveSlotProbe::Live(slot_view) => {
            return intrusive_pool_payload_of(&tcp_connection_pool, slot_view);
        }
    }
}

fn tcp_connection_of(owner: borrow TcpConnectionOwner[connection])
        -> *TcpConnection !{unsafe} {
    return tcp_connection_payload(owner.slot);
}

// Despite the name, this is a RESET, not a one-time constructor: it is
// called again on every kernel_syscall_daemon_start() and
// kernel_syscall_process_configure(), which is how a fresh daemon or a
// reconfigured process gets clean connection state.
//
// GitHub issue #257: that matters to the retransmit pool in a way it did
// not matter to anything here before. Re-running intrusive_pool_init on a
// pool that holds pages does not FREE them, it FORGETS them -- chunk_head
// goes to zero, the pool takes a new tag, and every page it was holding is
// still marked live in the page allocator with nobody left who can give it
// back. The `resources` view catches that as a page leak, which is how
// this was found; the arrays it replaced had no such failure mode because
// they were static storage and re-initialising them cost nothing.
//
// So the pool is constructed once and DRAINED afterwards. Draining is the
// operation that actually wanted doing anyway: a daemon restarting has no
// use for the previous one's unacknowledged segments, and
// pending_tcp_reset_all returns their pages properly.
fn tcp_connection_pool_init() !{unsafe} {
    if (tcp_frame_pool_ready == false) {
        // Same once-not-per-reset reasoning as the retransmit pool below,
        // and the same retained_chunks = 0.
        intrusive_pool_init_retaining(&tcp_frame_pool, 0);
        tcp_frame_pool_ready = true;
    }
    if (tcp_retx_pool_ready == false) {
        mutex_init(&tcp_retx_chain.mutex);
        // Retain NOTHING. #346's one-empty-chunk reserve is the right
        // default for a pool in steady churn, and the wrong one here: this
        // kernel checks "no page is held at rest" as an invariant (the
        // `resources` view's pages=0), and a retransmit queue is empty at
        // rest by definition -- every segment is eventually acknowledged
        // or given up on. Holding a page across that shows up as a leak,
        // correctly.
        intrusive_pool_init_retaining(&tcp_retx_pool, 0);
        tcp_retx_pool_ready = true;
    }
    if (tcp_connection_pool_ready == false) {
        intrusive_pool_init_retaining(&tcp_connection_pool, 0);
        tcp_connection_pool_ready = true;
    }
    // Draining IS the reset now. There is no fixed set of connections to
    // put back into Listen: a connection exists only while it is
    // allocated, so a daemon restarting simply has none, and every page
    // its predecessor's connections held goes back.
    tcp_connection_drain_all();
}

// Frees the first live connection, reporting whether it found one. The
// walk restarts on every free rather than carrying a cursor across it:
// with retained_chunks = 0 an emptied chunk goes straight back to the page
// allocator, so an address computed before a free can name a page this
// pool no longer owns (kernel/lib/intrusive_pool.tkb's own header says so,
// and its exerciser restarts for the same reason). O(live^2) over a
// handful of connections, once per reset.
fn tcp_connection_free_first_live() -> bool !{unsafe} {
    let mut cursor: usize = intrusive_pool_first_slot(&tcp_connection_pool);
    while (cursor != 0) {
        match intrusive_pool_probe_slot(&tcp_connection_pool, cursor) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let generation: usize = intrusive_view_generation(slot_view);
                intrusive_view_drop(slot_view);
                tcp_connection_free(
                    tcp_connection_owner_new(cursor, generation));
                return true;
            }
        }
        cursor = intrusive_pool_next_slot(&tcp_connection_pool, cursor);
    }
    return false;
}

// Is the connection at this address open? An fd can outlive the connection
// it names -- close() frees the connection while the descriptor is still
// installed -- so "the address names nothing live" is a NORMAL answer
// here, not a fault, and it is exactly what the caller wants to hear:
// not open. tcp_connection_payload's own missing case is the one that
// should never happen and says so; this one must not borrow its voice.
fn tcp_connection_open_at(address: usize) -> bool !{unsafe} {
    match intrusive_pool_probe_slot(&tcp_connection_pool, address) {
        IntrusiveSlotProbe::NoPayload => { return false; }
        IntrusiveSlotProbe::Live(slot_view) => {
            let conn: *TcpConnection =
                intrusive_pool_payload_of(&tcp_connection_pool, slot_view);
            return conn.connection_open;
        }
    }
}

// Has this connection buffered data userspace has not drained? One probe,
// where the caller would otherwise need two payload lookups joined by
// `&&` -- and `&&` does not short-circuit here, so the second ran even
// when the first said the connection was gone. That was six spurious
// "names no live slot" lines per boot, from a poll on a closed
// connection, which is a normal thing to do.
fn tcp_connection_has_pending_read(address: usize) -> bool !{unsafe} {
    match intrusive_pool_probe_slot(&tcp_connection_pool, address) {
        IntrusiveSlotProbe::NoPayload => { return false; }
        IntrusiveSlotProbe::Live(slot_view) => {
            let conn: *TcpConnection =
                intrusive_pool_payload_of(&tcp_connection_pool, slot_view);
            return conn.connection_open &&
                   conn.socket_buffer_offset < conn.socket_buffer_length;
        }
    }
}

// "Is any connection still open" -- kernel/kernel/syscall.tkb's daemon
// teardown check, which was a loop over TCP_CONNECTION_MAX array slots.
fn tcp_any_connection_open() -> bool !{unsafe} {
    let mut cursor: usize = intrusive_pool_first_slot(&tcp_connection_pool);
    while (cursor != 0) {
        match intrusive_pool_probe_slot(&tcp_connection_pool, cursor) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let conn: *TcpConnection =
                    intrusive_pool_payload_of(&tcp_connection_pool, slot_view);
                if (conn.connection_open) { return true; }
            }
        }
        cursor = intrusive_pool_next_slot(&tcp_connection_pool, cursor);
    }
    return false;
}

fn tcp_connection_drain_all() !{unsafe} {
    let mut draining: bool = true;
    while (draining) {
        draining = tcp_connection_free_first_live();
    }
}

// `Full` no longer means "all TCP_CONNECTION_MAX slots are taken" -- there
// is no such number. It means the page allocator could not supply what
// this connection needs, which is the only way to run out now. Callers
// keep the result they always had: the accept path retries, which is the
// right answer to memory pressure and what dropping a SYN under pressure
// means in TCP.
fn tcp_connection_alloc() -> TcpConnectionAllocResult !{unsafe} {
    let pool_guard = intrusive_pool_lock(&tcp_connection_pool);
    let inserted = intrusive_pool_insert_zeroed(&tcp_connection_pool, pool_guard);
    intrusive_pool_unlock(&tcp_connection_pool, pool_guard);
    match inserted {
        IntrusivePoolInsertResult::OutOfMemory => {
            kernel_boot_log_resource_exhausted(
                "TCP connection pool (out of pages)" as *u8, 0);
            return TcpConnectionAllocResult::Full;
        }
        IntrusivePoolInsertResult::Allocated(pool_owner) => {
            let address: usize = intrusive_owner_slot(pool_owner);
            let generation: usize = intrusive_owner_generation(pool_owner);
            let conn: *TcpConnection =
                intrusive_pool_ref(&tcp_connection_pool, pool_owner);
            conn.self_address = address;
            conn.state = ConnState::Listen;
            conn.local_port = TCP_ECHO_PORT;
            if (tcp_connection_frames_acquire(conn) == false) {
                let undo_guard = intrusive_pool_lock(&tcp_connection_pool);
                tcp_pool_remove_expected(
                    intrusive_pool_remove(&tcp_connection_pool, undo_guard,
                                          pool_owner),
                    "connection alloc undo" as *u8);
                intrusive_pool_unlock(&tcp_connection_pool, undo_guard);
                return TcpConnectionAllocResult::Full;
            }
            // The pool's own handle is discharged here and TcpConnection's
            // is handed out in its place: from now on the obligation to
            // free this slot rides on TcpConnectionOwner, and
            // tcp_connection_free rebuilds the pool handle to discharge
            // it. That round trip is the documented one, and the reason
            // intrusive_pool_remove validates what it is given.
            intrusive_owner_drop(pool_owner);
            return TcpConnectionAllocResult::Allocated(
                tcp_connection_owner_new(address, generation));
        }
    }
}

fn tcp_connection_slot(owner: borrow TcpConnectionOwner[connection]) -> usize {
    return owner.slot;
}

fn tcp_connection_identity(owner: borrow TcpConnectionOwner[connection])
        -> usize {
    return owner.generation;
}

fn tcp_connection_matches(owner: borrow TcpConnectionOwner[connection],
                          slot: usize, generation: usize) -> bool !{unsafe} {
    return owner.slot == slot && owner.generation == generation &&
           intrusive_pool_matches(&tcp_connection_pool, owner.slot, generation);
}

// What used to store the owner in a stable slot and describe the
// impossible duplicate. With no parking lot there is nothing to store and
// nothing to conflict with: an owner that has done its work is simply
// discharged, and the connection stays exactly where it is.
fn tcp_connection_put(owner: sink TcpConnectionOwner[connection]) {
    tcp_connection_owner_drop(owner);
}

// What used to pull an owner out of a stable slot and revalidate the pair
// it was found under. Now it mints one from the pair directly, after the
// same check -- intrusive_pool_matches, which is what the old
// slotmap_matches call inside tcp_connection_matches was.
fn tcp_connection_take(slot_value: usize, generation: usize)
        -> TcpConnectionTakeResult !{unsafe} {
    if (intrusive_pool_matches(&tcp_connection_pool, slot_value, generation)) {
        return TcpConnectionTakeResult::Ready(
            tcp_connection_owner_new(slot_value, generation));
    }
    return TcpConnectionTakeResult::Missing;
}

fn tcp_connection_free(owner: sink TcpConnectionOwner[connection]) !{unsafe} {
    let address: usize = owner.slot;
    let generation: usize = owner.generation;
    tcp_connection_owner_drop(owner);
    // Give back what this connection holds before the slot itself: the
    // retransmit entries name it by address, and the frames are owned in
    // its own stable fields, so both have to go while it is still there
    // to be found.
    pending_tcp_reset_all(address);
    let conn: *TcpConnection = tcp_connection_payload(address);
    conn.state = ConnState::Listen;
    conn.connection_open = false;
    tcp_connection_frames_release(conn);
    let branded = intrusive_owner_new(&tcp_connection_pool, address, generation);
    let guard = intrusive_pool_lock(&tcp_connection_pool);
    tcp_pool_remove_expected(
        intrusive_pool_remove(&tcp_connection_pool, guard, branded),
        "connection free" as *u8);
    intrusive_pool_unlock(&tcp_connection_pool, guard);
}

// GitHub issue #257: what this probe used to prove was that the pool
// reported Full at exactly TCP_CONNECTION_MAX = 2 concurrently held
// connections (issue #295's boundary test). There is no such number to
// reach, so the claim worth testing is the one that number existed to
// deny: that a connection past the old ceiling can be opened at all, that
// each is its own storage, and that closing them gives everything back.
//
// Eight rather than three, and held all at once: three would pass on a
// pool that had merely been bumped to 4, which is the outcome this issue
// exists to rule out. Names each owner explicitly for the same reason the
// old probe did -- there is no transfer-to-usize helper for
// TcpConnectionOwner -- which is also why the count is a literal here
// rather than a loop bound.
fn tcp_connection_pool_probe() -> bool !{unsafe} {
    tcp_connection_pool_init();
    let pages_before: usize = page_allocator_live_count();

    let owner_a: exists a: usize. TcpConnectionOwner[a] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => { return false; }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let owner_b: exists b: usize. TcpConnectionOwner[b] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => { tcp_connection_free(owner_a); return false; }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let owner_c: exists c: usize. TcpConnectionOwner[c] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            tcp_connection_free(owner_a);
            tcp_connection_free(owner_b);
            return false;
        }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let owner_d: exists d: usize. TcpConnectionOwner[d] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            tcp_connection_free(owner_a);
            tcp_connection_free(owner_b);
            tcp_connection_free(owner_c);
            return false;
        }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let owner_e: exists e: usize. TcpConnectionOwner[e] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            tcp_connection_free(owner_a);
            tcp_connection_free(owner_b);
            tcp_connection_free(owner_c);
            tcp_connection_free(owner_d);
            return false;
        }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };

    // Each is its own connection: distinct addresses, and a field written
    // through one is not readable through another.
    let slot_a: usize = tcp_connection_slot(owner_a);
    let slot_e: usize = tcp_connection_slot(owner_e);
    tcp_connection_of(owner_a).local_port = 1111;
    tcp_connection_of(owner_e).local_port = 5555;
    let distinct: bool =
        slot_a != slot_e &&
        tcp_connection_of(owner_a).local_port == 1111 &&
        tcp_connection_of(owner_e).local_port == 5555 &&
        intrusive_pool_live_count(&tcp_connection_pool) == 5;

    // A freed connection's address is refused afterwards, on the
    // generation rather than on the address -- the address is perfectly
    // real, and is exactly what an fd table entry outliving its connection
    // presents.
    let stale_generation: usize = tcp_connection_identity(owner_a);
    tcp_connection_free(owner_a);
    let stale_refused: bool =
        match tcp_connection_take(slot_a, stale_generation) {
            TcpConnectionTakeResult::Missing => { true }
            TcpConnectionTakeResult::Ready(owner) => {
                tcp_connection_put(owner);
                false
            }
        };

    tcp_connection_free(owner_b);
    tcp_connection_free(owner_c);
    tcp_connection_free(owner_d);
    tcp_connection_free(owner_e);

    // Everything back: no connection, no frame, no retransmit entry, and
    // no page any of them stood on.
    let drained: bool =
        intrusive_pool_live_count(&tcp_connection_pool) == 0 &&
        intrusive_pool_live_count(&tcp_frame_pool) == 0 &&
        intrusive_pool_live_count(&tcp_retx_pool) == 0 &&
        page_allocator_live_count() == pages_before &&
        intrusive_pool_probe(&tcp_connection_pool);
    return distinct && stale_refused && drained;
}

fn kernel_tcp_inject_drop_next_syn_ack() {
    tcp_drop_next_syn_ack = true;
    tcp_injected_syn_pending = false;
    tcp_injected_syn_retransmitted = false;
    tcp_injected_syn_accepted = false;
}

fn kernel_tcp_injected_syn_ack_recovered() -> bool {
    return tcp_injected_syn_accepted;
}

// GitHub issue #180: drop the Nth data segment sent on this connection
// (0-based; kernel/arch/arm64/kernel/user_entry.S's EL0 fixture sends
// exactly 3: index 0 = the 19-byte header, 1 = the 1460-byte body, 2 =
// the final byte -- kernel/platform/rpi5/init.tkb arms index 1, a genuine
// mid-large-response drop, not a bookend). Unlike
// kernel_tcp_inject_drop_next_data's old synchronous busy-wait-then-
// unconditional-resend, this only skips the targeted segment's INITIAL
// transmit; its actual retransmission and recovery now go entirely
// through the same real timeout+peer-ack path every other queued
// segment uses (pending_tcp_service_once), so
// kernel_tcp_injected_data_recovered() below only reports true once a
// real peer ACK actually cleared that slot after at least one retry.
// GitHub issue #257: "clear the marker on every connection" was a loop
// over TCP_CONNECTION_MAX array slots. With a pool it is a scan, and it
// visits only connections that actually exist.
fn kernel_tcp_clear_injection_markers() !{unsafe} {
    let mut cursor: usize = intrusive_pool_first_slot(&tcp_connection_pool);
    while (cursor != 0) {
        match intrusive_pool_probe_slot(&tcp_connection_pool, cursor) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let conn: *TcpConnection =
                    intrusive_pool_payload_of(&tcp_connection_pool, slot_view);
                conn.injected_data_entry = 0;
                conn.injected_fin_entry = 0;
            }
        }
        cursor = intrusive_pool_next_slot(&tcp_connection_pool, cursor);
    }
}

fn kernel_tcp_inject_drop_data_segment(index: usize) !{unsafe} {
    tcp_drop_data_segment_index = index as i32;
    kernel_tcp_clear_injection_markers();
    tcp_injected_data_retransmitted = false;
    tcp_injected_data_recovery_observed = false;
}

fn kernel_tcp_injected_data_recovered() -> bool {
    return tcp_injected_data_recovery_observed;
}

fn kernel_tcp_inject_drop_next_fin() !{unsafe} {
    tcp_drop_next_fin = true;
    kernel_tcp_clear_injection_markers();
    tcp_injected_fin_retransmitted = false;
    tcp_injected_fin_recovery_observed = false;
}

fn kernel_tcp_injected_fin_recovered() -> bool {
    return tcp_injected_fin_recovery_observed;
}

fn kernel_tcp_inject_split_request() {
    tcp_advertised_window = 64;
    tcp_ack_each_stream_segment = true;
    tcp_split_request_segments = 0;
}

fn kernel_tcp_split_request_recovered() -> bool {
    return tcp_split_request_segments >= 2;
}

fn kernel_tcp_restore_stream_policy() {
    tcp_advertised_window = 65535;
    tcp_ack_each_stream_segment = false;
}

fn retx_lock(m: *Mutex @ address) -> RetxGuard[address] {
    let mut guard: RetxGuard[address] = { mutex_acquire(m) };
    return guard;
}

fn retx_unlock(guard: sink RetxGuard[address],
                    m: *Mutex @ address) {
    mutex_release(m, guard.flags);
}

// Detach the whole queue. Every walk below is "take the chain, decide
// entry by entry, put back what survives", rather than unlinking a node
// where it stands: unlinking needs the PREVIOUS entry's link held open
// across the step that replaces it, and a link is stable owner storage,
// which can only be swapped, never held.
fn retx_chain_take() -> RetxLink {
    let guard = retx_lock(&tcp_retx_chain.mutex);
    let head: RetxLink = stable_replace(
        guard, &tcp_retx_chain.mutex, tcp_retx_chain.head, RetxLink::End);
    retx_unlock(guard, &tcp_retx_chain.mutex);
    return head;
}

// Install a chain as the queue. The displaced link must be End -- every
// caller took the chain first, and one context touches TCP (see this
// file's header), so nothing can have put one back in between. Returns
// false if that was violated anyway, having CONSUMED the stray rather
// than leaking it; the callers below treat that as the corruption it
// would be.
fn retx_chain_put(link: RetxLink) -> bool {
    let guard = retx_lock(&tcp_retx_chain.mutex);
    let displaced: RetxLink = stable_replace(
        guard, &tcp_retx_chain.mutex, tcp_retx_chain.head, link);
    retx_unlock(guard, &tcp_retx_chain.mutex);
    match displaced {
        RetxLink::End => { return true; }
        RetxLink::More(stray) => { intrusive_owner_drop(stray); return false; }
    }
}

fn retx_entry_take_next(entry: *RetxEntry) -> RetxLink {
    let guard = retx_lock(&entry.mutex);
    let next: RetxLink = stable_replace(
        guard, &entry.mutex, entry.next, RetxLink::End);
    retx_unlock(guard, &entry.mutex);
    return next;
}

fn retx_entry_put_next(entry: *RetxEntry, link: RetxLink) -> bool {
    let guard = retx_lock(&entry.mutex);
    let displaced: RetxLink = stable_replace(
        guard, &entry.mutex, entry.next, link);
    retx_unlock(guard, &entry.mutex);
    match displaced {
        RetxLink::End => { return true; }
        RetxLink::More(stray) => { intrusive_owner_drop(stray); return false; }
    }
}

// Frees one entry, given the (slot, generation) its link carried. Split
// out because it is the same three lines in four places, and because the
// rebranding it does is the one genuinely delicate step in this file.
//
// A parked handle's brand is EXISTENTIAL (GitHub issue #370): the field
// knows it holds some pool's handle, not this pool's, and opening the
// existential mints a fresh identity that will not match. So the only
// route to a handle intrusive_pool_remove will accept is to take the slot
// and generation off the parked one, discharge it, and rebuild -- which
// is exactly the one way to produce a handle the pool did not mint, and
// exactly why remove validates before it trusts one.
fn retx_entry_free(slot: usize, generation: usize) !{unsafe} {
    let branded = intrusive_owner_new(&tcp_retx_pool, slot, generation);
    let guard = intrusive_pool_lock(&tcp_retx_pool);
    tcp_pool_remove_expected(
        intrusive_pool_remove(&tcp_retx_pool, guard, branded),
        "retransmit entry free" as *u8);
    intrusive_pool_unlock(&tcp_retx_pool, guard);
}

// Reverses a detached chain. Every walk below rebuilds by pushing, which
// reverses; this puts the result back the way round it was found, so the
// queue's order is a property of the code rather than of how many times
// it has been serviced. The order it preserves is oldest-first, which is
// the order the nine arrays gave (pending_tcp_record took the lowest free
// slot and pending_tcp_service_once scanned 0 upward) -- and the order
// that retransmits the gap-filling segment first.
fn retx_chain_reverse(link_in: RetxLink) -> RetxLink !{unsafe} {
    let mut link: RetxLink = link_in;
    let mut reversed: RetxLink = RetxLink::End;
    let mut walking: bool = true;
    while (walking) {
        match link {
            RetxLink::End => { walking = false; link = RetxLink::End; }
            RetxLink::More(parked) => {
                let slot: usize = intrusive_owner_slot(parked);
                let generation: usize = intrusive_owner_generation(parked);
                intrusive_owner_drop(parked);
                if (intrusive_pool_matches(&tcp_retx_pool, slot, generation)) {
                    let branded =
                        intrusive_owner_new(&tcp_retx_pool, slot, generation);
                    let entry: *RetxEntry =
                        intrusive_pool_ref(&tcp_retx_pool, branded);
                    let following: RetxLink = retx_entry_take_next(entry);
                    if (retx_entry_put_next(entry, reversed) == false) {
                        kernel_boot_log("tcp retx: chain link was not empty\n");
                    }
                    reversed = RetxLink::More(branded);
                    link = following;
                } else {
                    // The chain named a slot the pool does not recognize.
                    // Nothing further along it can be trusted either, so
                    // stop rather than follow it; the entries beyond are
                    // leaked, which is the bounded outcome.
                    kernel_boot_log("tcp retx: chain names an unknown slot\n");
                    walking = false;
                    link = RetxLink::End;
                }
            }
        }
    }
    match link {
        RetxLink::End => {}
        RetxLink::More(leftover) => { intrusive_owner_drop(leftover); }
    }
    return reversed;
}

// Frees every entry belonging to this connection and leaves the rest of
// the queue alone. Called once per connection from kernel_tcp_accept_once
// (alongside its own state = Listen reset), so a new connection never
// inherits a previous one's outstanding segments.
fn pending_tcp_reset_all(connection_address: usize) !{unsafe} {
    let mut link: RetxLink = retx_chain_take();
    let mut kept: RetxLink = RetxLink::End;
    let mut walking: bool = true;
    while (walking) {
        match link {
            RetxLink::End => { walking = false; link = RetxLink::End; }
            RetxLink::More(parked) => {
                let slot: usize = intrusive_owner_slot(parked);
                let generation: usize = intrusive_owner_generation(parked);
                intrusive_owner_drop(parked);
                if (intrusive_pool_matches(&tcp_retx_pool, slot, generation)) {
                    let branded =
                        intrusive_owner_new(&tcp_retx_pool, slot, generation);
                    let entry: *RetxEntry =
                        intrusive_pool_ref(&tcp_retx_pool, branded);
                    let following: RetxLink = retx_entry_take_next(entry);
                    let mine: bool = entry.connection == connection_address;
                    if (mine) {
                        intrusive_owner_drop(branded);
                        retx_entry_free(slot, generation);
                    } else {
                        if (retx_entry_put_next(entry, kept) == false) {
                            kernel_boot_log("tcp retx: chain link was not empty\n");
                        }
                        kept = RetxLink::More(branded);
                    }
                    link = following;
                } else {
                    kernel_boot_log("tcp retx: chain names an unknown slot\n");
                    walking = false;
                    link = RetxLink::End;
                }
            }
        }
    }
    match link {
        RetxLink::End => {}
        RetxLink::More(leftover) => { intrusive_owner_drop(leftover); }
    }
    if (retx_chain_put(retx_chain_reverse(kept)) == false) {
        kernel_boot_log("tcp retx: queue was not empty on reinstall\n");
    }
    let conn: *TcpConnection = tcp_connection_payload(connection_address);
    conn.retx_count = 0;
    conn.data_segment_counter = 0;
    conn.injected_data_entry = 0;
    conn.injected_fin_entry = 0;
}

// Queues one just-transmitted segment for retransmission and returns the
// entry's pool slot ADDRESS, or 0 if it could not be queued.
//
// GitHub issue #295 gave this a -1 return when PENDING_TCP_MAX was
// exhausted, so that a full queue could not silently clobber another
// segment's still-live record. The ceiling is gone, so the only way to
// get 0 now is the page allocator being empty -- but the contract is
// deliberately unchanged, because it is the callers' contract too: the
// segment is still SENT either way, what 0 means is narrower (this one
// will not be retransmitted automatically if its ACK is lost), and both
// callers still guard their deliberate-drop test injection on getting a
// real entry, since arming that against "not queued" would mean the
// frame is never transmitted at all.
fn pending_tcp_record(conn: *TcpConnection,
                      kind: PendingTcpKind, frame_length: usize)
        -> usize !{unsafe} {
    let pool_guard = intrusive_pool_lock(&tcp_retx_pool);
    // insert_zeroed, not insert: RetxEntry holds a stable owner field
    // (`next`), and a recycled slot is neither zero nor fresh. This is
    // checked, not remembered -- plain insert does not compile for such a
    // T (GitHub issue #369).
    let inserted = intrusive_pool_insert_zeroed(&tcp_retx_pool, pool_guard);
    intrusive_pool_unlock(&tcp_retx_pool, pool_guard);
    match inserted {
        IntrusivePoolInsertResult::OutOfMemory => {
            // capacity=0: there is no capacity to report any more, which
            // is the point of the change. The line still names the
            // resource, which is what an operator reading a boot log
            // needs.
            kernel_boot_log_resource_exhausted(
                "TCP retransmit queue (out of pages)" as *u8, 0);
            return 0;
        }
        IntrusivePoolInsertResult::Allocated(owner) => {
            let entry_address: usize = intrusive_owner_slot(owner);
            let entry: *RetxEntry = intrusive_pool_ref(&tcp_retx_pool, owner);
            // GitHub issue #460: this was `entry.mutex = 0` and it
            // compiled after the field became a Mutex -- assigning an
            // integer to a struct emits a FOUR-BYTE store, so it zeroed
            // half the lock word. Harmless only because insert_zeroed had
            // already zeroed all of it.
            mutex_init(&entry.mutex);
            entry.connection = conn.self_address;
            entry.kind = kind;
            entry.frame_length = frame_length;
            entry.expected_ack = conn.snd_nxt;
            slice_copy(entry.remote_ip as []u8,
                       conn.remote_ip as []u8);
            entry.remote_port = conn.remote_port;
            entry.local_port = conn.local_port;
            entry.sent_at = read_cntpct();
            entry.retries = 0;
            slice_copy(entry.frame as []u8,
                       tcp_connection_tx_slice(conn));

            // Append at the tail, keeping the queue oldest-first: reverse,
            // push, reverse back. Two extra walks of a chain that holds
            // one segment per unacknowledged write, against a retransmit
            // order that then matches what the fixed slots gave.
            let reversed: RetxLink = retx_chain_reverse(retx_chain_take());
            if (retx_entry_put_next(entry, reversed) == false) {
                kernel_boot_log("tcp retx: fresh entry had a link\n");
            }
            if (retx_chain_put(
                    retx_chain_reverse(RetxLink::More(owner))) == false) {
                kernel_boot_log("tcp retx: queue was not empty on reinstall\n");
            }
            conn.retx_count =
                conn.retx_count + 1;
            return entry_address;
        }
    }
}

// GitHub issue #257: what the old pending_tcp_exhaustion_probe proved was
// that the queue reported exhaustion at exactly PENDING_TCP_MAX without
// corrupting an existing slot. There is no PENDING_TCP_MAX to reach any
// more, so the boundary it tested no longer exists -- and the claim worth
// testing in its place is the opposite one: that a connection can hold
// MORE outstanding segments than the old ceiling allowed, that each one
// keeps its own record, and that the queue is still exactly emptied.
//
// Drives the queue directly rather than through real TCP timing, for the
// same reason the old probe did: reaching this through genuine network
// loss and retry would need a materially larger QEMU-peer-driven test.
// GitHub issue #257 step 4a: pending_tcp_record copies the connection's
// transmit frame into each entry, so a connection without one is not a
// state this probe should exercise -- it would take the missing-frame
// fallback and prove nothing about the copy. The frames are acquired here,
// exactly as accept() does, and given back on every exit; the body is a
// separate function purely so that its eight failure returns cannot each
// forget to.
fn pending_tcp_chain_probe() -> bool !{unsafe} {
    let owner_a: exists a: usize. TcpConnectionOwner[a] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => { return false; }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let owner_b: exists b: usize. TcpConnectionOwner[b] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            tcp_connection_free(owner_a);
            return false;
        }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let conn: *TcpConnection = tcp_connection_of(owner_a);
    let other: *TcpConnection = tcp_connection_of(owner_b);
    let ok: bool = pending_tcp_chain_probe_body(conn, other);
    tcp_connection_free(owner_a);
    tcp_connection_free(owner_b);
    // Every frame and every retransmit entry back where it came from.
    return ok && intrusive_pool_live_count(&tcp_frame_pool) == 0 &&
           intrusive_pool_live_count(&tcp_retx_pool) == 0;
}

fn pending_tcp_chain_probe_body(conn: *TcpConnection, other: *TcpConnection)
        -> bool !{unsafe} {
    let live_before: usize = intrusive_pool_live_count(&tcp_retx_pool);

    // One past the old ceiling of 4, plus one belonging to a DIFFERENT
    // connection, interleaved so that reset_all below has to pick its own
    // entries out of a mixed chain rather than truncate a prefix.
    let mut queued: usize = 0;
    for i: usize in 0..<5 {
        if (pending_tcp_record(conn, PendingTcpKind::Data,
                               1000 + i) != 0) {
            queued = queued + 1;
        }
        if (i == 2) {
            if (pending_tcp_record(other, PendingTcpKind::Fin, 9999)
                    == 0) {
                return false;
            }
        }
    }
    if (queued != 5 ||
        conn.retx_count != 5 ||
        other.retx_count != 1 ||
        intrusive_pool_live_count(&tcp_retx_pool) != live_before + 6) {
        return false;
    }

    // Every entry kept its own frame_length -- the record the old
    // fall-back-to-slot-0 bug used to clobber (issue #295) -- and they are
    // in the order they were queued.
    let mut walked: usize = 0;
    let mut lengths_ok: bool = true;
    let mut link: RetxLink = retx_chain_take();
    let mut kept: RetxLink = RetxLink::End;
    let mut walking: bool = true;
    while (walking) {
        match link {
            RetxLink::End => { walking = false; link = RetxLink::End; }
            RetxLink::More(parked) => {
                let slot: usize = intrusive_owner_slot(parked);
                let generation: usize = intrusive_owner_generation(parked);
                intrusive_owner_drop(parked);
                if (intrusive_pool_matches(&tcp_retx_pool, slot, generation)) {
                    let branded =
                        intrusive_owner_new(&tcp_retx_pool, slot, generation);
                    let entry: *RetxEntry =
                        intrusive_pool_ref(&tcp_retx_pool, branded);
                    let following: RetxLink = retx_entry_take_next(entry);
                    if (entry.connection == conn.self_address) {
                        if (entry.frame_length != 1000 + walked) {
                            lengths_ok = false;
                        }
                        walked = walked + 1;
                    }
                    if (retx_entry_put_next(entry, kept) == false) {
                        lengths_ok = false;
                    }
                    kept = RetxLink::More(branded);
                    link = following;
                } else {
                    lengths_ok = false;
                    walking = false;
                    link = RetxLink::End;
                }
            }
        }
    }
    match link {
        RetxLink::End => {}
        RetxLink::More(leftover) => { intrusive_owner_drop(leftover); }
    }
    if (retx_chain_put(retx_chain_reverse(kept)) == false) { return false; }
    if (lengths_ok == false || walked != 5) { return false; }

    // Resetting one connection takes its five and leaves the other's one.
    pending_tcp_reset_all(conn.self_address);
    if (conn.retx_count != 0 ||
        other.retx_count != 1 ||
        intrusive_pool_live_count(&tcp_retx_pool) != live_before + 1) {
        return false;
    }
    pending_tcp_reset_all(other.self_address);
    if (intrusive_pool_live_count(&tcp_retx_pool) != live_before ||
        intrusive_pool_probe(&tcp_retx_pool) == false) {
        return false;
    }
    // Give the pages back rather than leaving this probe's chunks held.
    // #346's anti-thrash default retains one empty chunk per pool, which
    // is the right policy for a queue in steady use and the wrong one for
    // a boot probe that will not queue anything again for a while.
    let reclaim_guard = intrusive_pool_lock(&tcp_retx_pool);
    intrusive_pool_reclaim(&tcp_retx_pool, reclaim_guard);
    intrusive_pool_unlock(&tcp_retx_pool, reclaim_guard);
    return true;
}


// Takes the entry itself rather than a pair of indices into nine arrays:
// what used to need `conn * PENDING_TCP_MAX + slot` -- and a
// refined slot type so every one of those accesses could prove in range
// under --forbid-trap -- is now a struct the caller already has a pointer
// to, and there is no index to bound.
fn pending_tcp_ack_matches(frame: borrow [u8; 1514..], len: i32,
                           entry: *RetxEntry) -> bool {
    if (entry.kind == PendingTcpKind::None || len < 54 || len > 1514) {
        return false;
    }
    let len_n: i32 = len;
    let eth: *EthHdr = frame as *EthHdr;
    if (eth.ethertype != ETHERTYPE_IPV4) { return false; }
    let ip = frame[14..<34];
    let ip_hdr: *Ipv4Hdr = ip as *Ipv4Hdr;
    let ihl: u16 = (ip_hdr.version_ihl & 0x0F) * 4;
    let len16: u16 = len_n as u16;
    let total_len: u16 = ip_hdr.total_len as u16;
    let entry_ip = entry.remote_ip as []u8;
    if ((ip_hdr.version_ihl >> 4) != 4 || ihl != 20 || total_len != 40 ||
        total_len > len16 - 14 || ip_hdr.protocol != PROTO_TCP ||
        inet_checksum(ip) != 0 ||
        slice_eq(ip[IP_SRC..<IP_DST], entry_ip[0..<4]) == false ||
        slice_eq(ip[IP_DST..<20], OUR_IP as []u8) == false) {
        return false;
    }
    let tcp = frame[34..<54];
    let tcp_hdr: *TcpHdr = tcp as *TcpHdr;
    let mut pseudo: [u8; 12];
    slice_copy(pseudo[0..<4], ip[IP_SRC..<IP_DST]);
    slice_copy(pseudo[4..<8], ip[IP_DST..<20]);
    pseudo[8] = 0;
    pseudo[9] = PROTO_TCP;
    write_u16be(pseudo[10..<12], 20);
    return (tcp_hdr.src_port as u16) == entry.remote_port &&
           (tcp_hdr.dst_port as u16) == entry.local_port &&
           (tcp_hdr.flags & TCP_FLAG_ACK) != 0 &&
           (tcp_hdr.ack as u32) >= entry.expected_ack &&
           checksum_fold(checksum_add(
               tcp, checksum_add(pseudo as []u8, 0))) == 0;
}

// One non-blocking net_rx acquire attempt: if a frame is already
// waiting, checks it against every entry this connection still has
// outstanding (a real ACK is cumulative -- one frame can clear several
// older entries at once, exactly what happens here since these are
// same-direction sequential segments), then separately retransmits any
// entry still outstanding past its own retry_ticks deadline (bumping its
// retry count, giving up and freeing it silently at TCP_RETRY_LIMIT --
// same exhaustion behavior this file always had). A frame that matches
// no entry is simply released: TCP's own retry semantics already assume
// any frame can be safely dropped, so an opportunistic caller
// (kernel_tcp_send_received) stealing an unrelated frame here is no
// worse than that frame never having arrived at all.
//
// GitHub issue #257: the queue is one chain for the whole stack now, so
// both passes below skip entries belonging to another connection. That
// keeps what a connection sees identical to when the queue was its own
// four slots -- a deliberate choice, since servicing every connection's
// deadlines from whichever one happens to be running would be a timing
// change on a path with a history of them.
fn pending_tcp_service_once(conn: *TcpConnection,
                            ready_in: sink NetRxCanAcquire,
                             retry_ticks: i64)
        -> NetRxCanAcquire !{may_block, unsafe} {
    let mut ready = ready_in;
    match net_rx_acquire(ready) {
        NetRxAcquire::None(next) => { ready = next; }
        NetRxAcquire::Acquired(acquired) => {
            let len: i32 = net_rx_len(acquired);
            let frame = net_rx_frame(acquired);
            let mut link: RetxLink = retx_chain_take();
            let mut kept: RetxLink = RetxLink::End;
            let mut walking: bool = true;
            while (walking) {
                match link {
                    RetxLink::End => { walking = false; link = RetxLink::End; }
                    RetxLink::More(parked) => {
                        let slot: usize = intrusive_owner_slot(parked);
                        let generation: usize =
                            intrusive_owner_generation(parked);
                        intrusive_owner_drop(parked);
                        if (intrusive_pool_matches(
                                &tcp_retx_pool, slot, generation)) {
                            let branded = intrusive_owner_new(
                                &tcp_retx_pool, slot, generation);
                            let entry: *RetxEntry =
                                intrusive_pool_ref(&tcp_retx_pool, branded);
                            let following: RetxLink =
                                retx_entry_take_next(entry);
                            let mut acked: bool = false;
                            if (entry.connection == conn.self_address &&
                                pending_tcp_ack_matches(frame, len, entry)) {
                                // A real peer ACK, not a synthetic flag
                                // flip: this is what makes
                                // kernel_tcp_injected_data_recovered() /
                                // kernel_tcp_injected_fin_recovered()
                                // genuinely prove recovery, matching the
                                // same rigor
                                // kernel_tcp_injected_syn_ack_recovered()
                                // already had.
                                if (slot == conn.injected_data_entry &&
                                    tcp_injected_data_retransmitted) {
                                    tcp_injected_data_recovery_observed = true;
                                }
                                if (slot == conn.injected_fin_entry &&
                                    tcp_injected_fin_retransmitted) {
                                    tcp_injected_fin_recovery_observed = true;
                                }
                                acked = true;
                            }
                            if (acked) {
                                intrusive_owner_drop(branded);
                                retx_entry_free(slot, generation);
                                conn.retx_count =
                                    retx_count_after_release(conn);
                            } else {
                                if (retx_entry_put_next(entry, kept) == false) {
                                    kernel_boot_log("tcp retx: chain link was not empty\n");
                                }
                                kept = RetxLink::More(branded);
                            }
                            link = following;
                        } else {
                            kernel_boot_log("tcp retx: chain names an unknown slot\n");
                            walking = false;
                            link = RetxLink::End;
                        }
                    }
                }
            }
            match link {
                RetxLink::End => {}
                RetxLink::More(leftover) => { intrusive_owner_drop(leftover); }
            }
            if (retx_chain_put(retx_chain_reverse(kept)) == false) {
                kernel_boot_log("tcp retx: queue was not empty on reinstall\n");
            }
            ready = net_rx_release(acquired);
        }
    }
    let now: i64 = read_cntpct();
    let mut link: RetxLink = retx_chain_take();
    let mut kept: RetxLink = RetxLink::End;
    let mut walking: bool = true;
    while (walking) {
        match link {
            RetxLink::End => { walking = false; link = RetxLink::End; }
            RetxLink::More(parked) => {
                let slot: usize = intrusive_owner_slot(parked);
                let generation: usize = intrusive_owner_generation(parked);
                intrusive_owner_drop(parked);
                if (intrusive_pool_matches(&tcp_retx_pool, slot, generation)) {
                    let branded =
                        intrusive_owner_new(&tcp_retx_pool, slot, generation);
                    let entry: *RetxEntry =
                        intrusive_pool_ref(&tcp_retx_pool, branded);
                    let following: RetxLink = retx_entry_take_next(entry);
                    let mut expired: bool = false;
                    if (entry.connection == conn.self_address &&
                        now - entry.sent_at >= retry_ticks) {
                        if (entry.retries < TCP_RETRY_LIMIT) {
                            let length: usize = entry.frame_length;
                            let frame_bytes = entry.frame as []u8;
                            ready = net_transmit_ready(
                                ready, frame_bytes[0..<1514], length as i32);
                            entry.sent_at = now;
                            entry.retries = entry.retries + 1;
                            if (slot == conn.injected_data_entry) {
                                tcp_injected_data_retransmitted = true;
                            }
                            if (slot == conn.injected_fin_entry) {
                                tcp_injected_fin_retransmitted = true;
                            }
                        } else {
                            // Give up silently on this one segment -- same
                            // per-segment exhaustion behavior this file
                            // always had, just scoped to this entry
                            // instead of the whole queue.
                            expired = true;
                        }
                    }
                    if (expired) {
                        intrusive_owner_drop(branded);
                        retx_entry_free(slot, generation);
                        conn.retx_count =
                            retx_count_after_release(conn);
                    } else {
                        if (retx_entry_put_next(entry, kept) == false) {
                            kernel_boot_log("tcp retx: chain link was not empty\n");
                        }
                        kept = RetxLink::More(branded);
                    }
                    link = following;
                } else {
                    kernel_boot_log("tcp retx: chain names an unknown slot\n");
                    walking = false;
                    link = RetxLink::End;
                }
            }
        }
    }
    match link {
        RetxLink::End => {}
        RetxLink::More(leftover) => { intrusive_owner_drop(leftover); }
    }
    if (retx_chain_put(retx_chain_reverse(kept)) == false) {
        kernel_boot_log("tcp retx: queue was not empty on reinstall\n");
    }
    return ready;
}

// One decrement, guarded. The count is bookkeeping beside the chain
// rather than derived from it, so an underflow would be a real bug in
// this file rather than a harmless miscount -- and usize underflow wraps
// to an enormous number that would make kernel_tcp_close_stream spin to
// its deadline every time.
fn retx_count_after_release(conn: *TcpConnection) -> usize {
    let current: usize = conn.retx_count;
    if (current == 0) {
        kernel_boot_log("tcp retx: released an entry with an empty count\n");
        return 0;
    }
    return current - 1;
}

// True while any segment (Data or Fin) is still outstanding for this
// connection -- the condition kernel_tcp_close_stream's own bounded wait
// drains toward before returning, so close() genuinely waits for its FIN
// (and any Data segment still outstanding when it was called) to be
// acknowledged or give up, instead of returning immediately with
// unfinished business.
//
// A counter rather than a walk: the chain is stable owner storage, so
// even a read-only walk has to take and put every link, and this is
// polled in a loop.
fn pending_tcp_any_active(conn: *TcpConnection) -> bool {
    return conn.retx_count != 0;
}


// Recomputes the TCP checksum over the pseudo-header implied by `ip` and
// the full segment `tcp_seg` (header + data -- ITS OWN LENGTH, read back
// via tcp_seg.len, is what goes in the pseudo-header's length field, so
// this can never disagree with the segment it's actually checksumming).
// Must be called last, after every other TCP field has its final value.
fn fix_tcp_checksum(ip: borrow [u8; 20..], tcp_seg: borrow [u8; 20..]) {
    let tcp_hdr: *TcpHdr = tcp_seg as *TcpHdr;
    tcp_hdr.checksum = 0;
    let mut pseudo: [u8; 12];
    slice_copy(pseudo[0..<4], ip[IP_SRC..<IP_DST]);
    slice_copy(pseudo[4..<8], ip[IP_DST..<20]);
    pseudo[8] = 0 as u8;
    pseudo[9] = PROTO_TCP;
    write_u16be(pseudo[10..<12], tcp_seg.len as i32);
    let sum: i32 = checksum_add(pseudo as []u8, 0);
    tcp_hdr.checksum = (checksum_fold(checksum_add(tcp_seg, sum)) as u16) as u16be;
}

// Rewrites a SYN request into a SYN-ACK reply in place. Only called from
// TCP_LISTEN after the caller has already validated the request (IP/TCP
// checksums, dst port, SYN flag set).
fn build_syn_ack(conn: *TcpConnection,
                 eth: borrow [u8; 54..], ihl: {20..<21 as u16}) {
    slice_copy(eth[0..<6], eth[6..<12]);
    slice_copy(eth[6..<12], our_mac as []u8);

    let ip  = eth[14..<34];
    let tcp = eth[34..<54];
    let ip_hdr:  *Ipv4Hdr = ip as *Ipv4Hdr;
    let tcp_hdr: *TcpHdr  = tcp as *TcpHdr;

    slice_copy(ip[IP_DST..<20],     ip[IP_SRC..<IP_DST]);
    slice_copy(ip[IP_SRC..<IP_DST], OUR_IP as []u8);
    ip_hdr.ttl = 64;
    ip_hdr.total_len = (ihl + 20) as u16be;
    ip_hdr.checksum = 0;
    ip_hdr.checksum = (inet_checksum(ip[0..<ihl as usize]) as u16) as u16be;

    let client_port: u16 = tcp_hdr.src_port as u16;
    tcp_hdr.src_port = conn.local_port as u16be;
    tcp_hdr.dst_port = client_port as u16be;
    tcp_hdr.seq = TCP_INITIAL_SEQ as u32be;
    tcp_hdr.ack = conn.rcv_nxt as u32be;
    tcp_hdr.data_offset = (5 << 4) as u8; // 20-byte header, no options
    tcp_hdr.flags = TCP_FLAG_SYN | TCP_FLAG_ACK;
    tcp_hdr.window = tcp_advertised_window as u16be;
    tcp_hdr.urgent = 0;

    fix_tcp_checksum(ip, tcp);
}

// Rewrites a received data segment into an ACK|PSH reply. The caller only
// admits a 20-byte incoming TCP header and places the response at the fixed
// payload offset before calling this helper.
// Only called from TCP_ESTABLISHED after the caller has already validated
// the request. received_len is nonzero for the legacy echo path, which has
// not advanced rcv_nxt yet; the Linux stream path advances on receive
// and passes zero. Returns true on success.
// if data_len somehow exceeded TCP_MAX_PAYLOAD (never actually happens
// given the caller's own tcp_len bound, but see the explicit check below
// for why this needs to be enforced, not assumed, to construct tcp_seg
// with a proven minimum).
fn build_data_reply(conn: *TcpConnection,
        eth: borrow [u8; 1514..], ihl: {20..<21 as u16},
        tcp_seg: borrow [u8; 20..], response_len: u16,
        received_len: u16) -> bool {
    // Snapshot into an immutable local after an explicit bound check: a
    // PLAIN u16 PARAMETER carries no range at all (unlike a refined local,
    // parameters can't cross a function boundary with a refined type
    // except by exact match -- see http_server.tkb's
    // `ihl: {20..<21 as u16}`
    // comment for why). This mirrors http_server's HTTP_MAX_PAYLOAD
    // pattern: the check both PROVES tcp_seg's minimum (>= 20, needed by
    // fix_tcp_checksum) and fails safe if data_len is ever larger than
    // this responder's single-segment design supports. data_len is u16,
    // so a hi-only condition is enough to narrow (GitHub issue #99).
    if (response_len <= TCP_MAX_PAYLOAD) {
        let n: u16 = response_len;
        slice_copy(eth[0..<6], eth[6..<12]);
        slice_copy(eth[6..<12], our_mac as []u8);

        let ip = eth[14..<34];
        let ip_hdr:  *Ipv4Hdr = ip as *Ipv4Hdr;
        let tcp_hdr: *TcpHdr  = tcp_seg as *TcpHdr;

        slice_copy(ip[IP_DST..<20],     ip[IP_SRC..<IP_DST]);
        slice_copy(ip[IP_SRC..<IP_DST], OUR_IP as []u8);
        ip_hdr.ttl = 64;
        ip_hdr.total_len = (ihl + 20 + n) as u16be;
        ip_hdr.checksum = 0;
        ip_hdr.checksum = (inet_checksum(ip[0..<ihl as usize]) as u16) as u16be;

        let client_port: u16 = tcp_hdr.src_port as u16;
        tcp_hdr.src_port = conn.local_port as u16be;
        tcp_hdr.dst_port = client_port as u16be;
        tcp_hdr.seq = conn.snd_nxt as u32be;
        tcp_hdr.ack = (conn.rcv_nxt +
                       (received_len as u32)) as u32be;
        tcp_hdr.data_offset = (5 << 4) as u8;
        tcp_hdr.flags = TCP_FLAG_ACK | TCP_FLAG_PSH;
        tcp_hdr.window = 65535;
        tcp_hdr.urgent = 0;

        fix_tcp_checksum(ip, tcp_seg);
        return true;
    }
    return false;
}

// Rewrites a received FIN into a combined FIN|ACK reply: ACKs the
// client's FIN (which consumes one sequence number, already folded into
// rcv_nxt by the caller) and sends our own FIN in the same segment.
// Only called from TCP_ESTABLISHED after the caller has already validated
// the request and confirmed seq == rcv_nxt (before incrementing it).
fn build_fin_ack(conn: *TcpConnection,
                 eth: borrow [u8; 54..], ihl: {20..<21 as u16}) {
    slice_copy(eth[0..<6], eth[6..<12]);
    slice_copy(eth[6..<12], our_mac as []u8);

    let ip  = eth[14..<34];
    let tcp = eth[34..<54];
    let ip_hdr:  *Ipv4Hdr = ip as *Ipv4Hdr;
    let tcp_hdr: *TcpHdr  = tcp as *TcpHdr;

    slice_copy(ip[IP_DST..<20],     ip[IP_SRC..<IP_DST]);
    slice_copy(ip[IP_SRC..<IP_DST], OUR_IP as []u8);
    ip_hdr.ttl = 64;
    ip_hdr.total_len = (ihl + 20) as u16be;
    ip_hdr.checksum = 0;
    ip_hdr.checksum = (inet_checksum(ip[0..<ihl as usize]) as u16) as u16be;

    let client_port: u16 = tcp_hdr.src_port as u16;
    tcp_hdr.src_port = conn.local_port as u16be;
    tcp_hdr.dst_port = client_port as u16be;
    tcp_hdr.seq = conn.snd_nxt as u32be;
    tcp_hdr.ack = conn.rcv_nxt as u32be;
    tcp_hdr.data_offset = (5 << 4) as u8;
    tcp_hdr.flags = TCP_FLAG_FIN | TCP_FLAG_ACK;
    tcp_hdr.window = tcp_advertised_window as u16be;
    tcp_hdr.urgent = 0;

    fix_tcp_checksum(ip, tcp);
}

// Rewrites a received data frame into an ACK with no payload.  This releases
// the sole GEM RX capability between non-final stream segments while keeping
// the already-copied bytes in the caller's reconstruction buffer.
fn build_receive_ack(conn: *TcpConnection,
                     eth: borrow [u8; 54..], ihl: {20..<21 as u16}) {
    slice_copy(eth[0..<6], eth[6..<12]);
    slice_copy(eth[6..<12], our_mac as []u8);

    let ip = eth[14..<34];
    let tcp = eth[34..<54];
    let ip_hdr:  *Ipv4Hdr = ip as *Ipv4Hdr;
    let tcp_hdr: *TcpHdr  = tcp as *TcpHdr;
    slice_copy(ip[IP_DST..<20], ip[IP_SRC..<IP_DST]);
    slice_copy(ip[IP_SRC..<IP_DST], OUR_IP as []u8);
    ip_hdr.ttl = 64;
    ip_hdr.total_len = (ihl + 20) as u16be;
    ip_hdr.checksum = 0;
    ip_hdr.checksum = (inet_checksum(ip[0..<ihl as usize]) as u16) as u16be;

    let client_port: u16 = tcp_hdr.src_port as u16;
    tcp_hdr.src_port = conn.local_port as u16be;
    tcp_hdr.dst_port = client_port as u16be;
    tcp_hdr.seq = conn.snd_nxt as u32be;
    tcp_hdr.ack = conn.rcv_nxt as u32be;
    tcp_hdr.data_offset = (5 << 4) as u8;
    tcp_hdr.flags = TCP_FLAG_ACK;
    tcp_hdr.window = tcp_advertised_window as u16be;
    tcp_hdr.urgent = 0;
    fix_tcp_checksum(ip, tcp);
}

// Facts proven once by tcp_parse_segment and threaded through by type
// alone (LetMatch, GitHub issue #183) instead of by staying nested
// inside the if that proved them -- same technique used to flatten
// kernel/net/icmp.tkb's kernel_icmp_reply_once. kernel_tcp_echo_check
// and kernel_tcp_accept_once parse and checksum-validate an inbound
// TCP-over-IPv4 segment addressed to OUR_IP with IDENTICAL thresholds,
// so they share this one parse. kernel_tcp_receive_once keeps its own
// inline parse below: it enforces a tighter total_len lower bound (it
// expects data, not just any segment) and an additional source-IP
// match at parse time, so folding it into this shared shape would
// blur two genuinely different validity conditions into one.
struct TcpSegmentHeader {
    ihl: {20..<21 as u16};
    tcp_len: {20..<1481 as u16};
    tcp_hdr_len: u16;
    src_port: u16;
    dst_port: u16;
    flags: u8;
    seq: u32;
    ack: u32;
}

must_use variant TcpSegmentParseResult {
    Reject;
    Parsed(TcpSegmentHeader);
}

fn tcp_parse_segment(frame: borrow [u8; 1514..], len: i32) -> TcpSegmentParseResult {
    let eth: *EthHdr = frame as *EthHdr;
    if (len >= 54 && len <= 1514 && eth.ethertype == ETHERTYPE_IPV4) {
        let ip = frame[14..<34];
        let ip_hdr: *Ipv4Hdr = ip as *Ipv4Hdr;
        let version: u8 = ip_hdr.version_ihl >> 4;
        let ihl:     u16 = (ip_hdr.version_ihl & 0x0f) * 4;

        if (version == 4 && ihl == 20) {
            let len16: u16 = len as u16;
            let total_len:       u16 = ip_hdr.total_len as u16;
            let ip_len_in_frame: u16 = len16 - 14;

            if (total_len <= ip_len_in_frame && total_len >= ihl &&
                ip_hdr.protocol == PROTO_TCP &&
                inet_checksum(ip[0..<ihl as usize]) == 0 &&
                slice_eq(ip[IP_DST..<20], OUR_IP as []u8)) {
                let tcp:     [u8; 20..] = frame[34..<54];
                let tcp_hdr: *TcpHdr = tcp as *TcpHdr;
                let tcp_len: u16 = total_len - ihl;
                let doff:    u8  = tcp_hdr.data_offset >> 4;

                if (tcp_len >= 20 && tcp_len <= 1480 &&
                    doff >= 5 && doff <= 15) {
                    let tcp_hdr_len: u16 = (doff * 4) as u16;

                    if (tcp_len >= tcp_hdr_len) {
                        let mut pseudo: [u8; 12];
                        slice_copy(pseudo[0..<4], ip[IP_SRC..<IP_DST]);
                        slice_copy(pseudo[4..<8], ip[IP_DST..<20]);
                        pseudo[8] = 0 as u8;
                        pseudo[9] = PROTO_TCP;
                        write_u16be(pseudo[10..<12], tcp_len);
                        let sum: i32 = checksum_add(pseudo as []u8, 0);
                        let tcp_len_idx: usize = tcp_len as usize;
                        let tcp_seg = frame[34..<34 + tcp_len_idx];

                        if (checksum_fold(checksum_add(tcp_seg, sum)) == 0) {
                            let dst_port: u16 = tcp_hdr.dst_port as u16;
                            let src_port: u16 = tcp_hdr.src_port as u16;
                            let flags:    u8  = tcp_hdr.flags;
                            let seq:      u32 = tcp_hdr.seq as u32;
                            let ack:      u32 = tcp_hdr.ack as u32;
                            let mut header: TcpSegmentHeader =
                                {ihl, tcp_len, tcp_hdr_len, src_port, dst_port, flags, seq, ack};
                            return TcpSegmentParseResult::Parsed(header);
                        }
                    }
                }
            }
        }
    }
    return TcpSegmentParseResult::Reject;
}

// GitHub issue #257 step 5: this legacy echo path used to work directly on
// connection slot 0, which existed whether anyone had allocated it or not.
// A connection is an allocation now, so it takes one out and gives it back
// -- the same thing accept() does, and the reason the pool needs no
// special case for "the connection nobody asked for".
fn kernel_tcp_echo_check(ready_in: sink NetRxCanAcquire)
        -> KernelTcpResult !{may_block, unsafe} {
    let mut ready = ready_in;
    let echo_owner: exists e: usize. TcpConnectionOwner[e] =
            match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            return KernelTcpResult::TimedOut(ready);
        }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let conn: *TcpConnection = tcp_connection_of(echo_owner);
    let remote_ip_bytes =
        conn.remote_ip as []u8;
    net_read_mac(our_mac as []u8);
    conn.state = ConnState::Listen;
    conn.local_port = TCP_ECHO_PORT;
    tcp_completed_handshakes = 0;
    tcp_completed_echoes = 0;
    tcp_completed_closes = 0;
    let start: i64 = read_cntpct();
    let deadline_ticks: i64 = read_cntfrq() * 30;
    while ((read_cntpct() - start) < deadline_ticks) {
                net_rx_wait();
                match net_rx_acquire(ready) {
                    NetRxAcquire::None(next) => { ready = next; }
                    NetRxAcquire::Acquired(acquired) => {
                        let len: i32 = net_rx_len(acquired);
                        // The disposition variant replaces the old
                        // should_tx/tx_len integer flag pair: a reply and
                        // its length are now one value, so "flagged but no
                        // length" is unrepresentable.
                        let mut plan: TcpRxPlan = TcpRxPlan::Release;
                        let frame = net_rx_frame(acquired);   // only read when len proves acquisition

                        match tcp_parse_segment(frame, len) {
                            TcpSegmentParseResult::Reject => { }
                            TcpSegmentParseResult::Parsed(header) => {
                                if (header.dst_port == conn.local_port) {
                                    let ip = frame[14..<34];
                                    if (conn.state == ConnState::Listen) {
                                        if ((header.flags & TCP_FLAG_SYN) != 0) {
                                            slice_copy(remote_ip_bytes[0..<4],
                                                ip[IP_SRC..<IP_DST]);
                                            conn.remote_port = header.src_port;
                                            conn.rcv_nxt = header.seq + 1;
                                            conn.snd_nxt = TCP_INITIAL_SEQ + 1;

                                            build_syn_ack(conn, frame, header.ihl);
                                            plan = TcpRxPlan::Send(14 + (header.ihl as i32) + 20);
                                            conn.state = ConnState::SynRcvd;
                                        }
                                    } else {
                                        // SYN_RCVD, ESTABLISHED, or LAST_ACK: only the
                                        // recorded connection's segments matter.
                                        if (slice_eq(ip[IP_SRC..<IP_DST],
                                                remote_ip_bytes[0..<4]) &&
                                            header.src_port == conn.remote_port) {
                                            if ((header.flags & TCP_FLAG_RST) != 0) {
                                                // Abrupt close from the client: drop the
                                                // connection with no reply and free the slot.
                                                conn.state = ConnState::Listen;
                                            } else if (conn.state == ConnState::SynRcvd) {
                                                if ((header.flags & TCP_FLAG_ACK) != 0 &&
                                                    (header.flags & TCP_FLAG_SYN) == 0 &&
                                                    header.ack == conn.snd_nxt &&
                                                    header.seq == conn.rcv_nxt) {
                                                    conn.state = ConnState::Established;
                                                    tcp_completed_handshakes =
                                                        tcp_completed_handshakes + 1;
                                                }
                                            } else if (conn.state == ConnState::Established) {
                                                if ((header.flags & TCP_FLAG_FIN) != 0 &&
                                                    header.seq == conn.rcv_nxt) {
                                                    conn.rcv_nxt =
                                                        conn.rcv_nxt + 1;
                                                    build_fin_ack(conn, frame, header.ihl);
                                                    plan = TcpRxPlan::Send(14 + (header.ihl as i32) + 20);
                                                    conn.snd_nxt =
                                                        conn.snd_nxt + 1;
                                                    conn.state = ConnState::LastAck;
                                                } else {
                                                    // max(.., 0): tcp_len - tcp_hdr_len's raw
                                                    // Sub-derived range has a spuriously negative
                                                    // lower bound (the type system can't see the
                                                    // tcp_len>=tcp_hdr_len guard that makes a
                                                    // genuinely negative result impossible), which
                                                    // would otherwise make data_len look like it
                                                    // could be negative to any code reading its
                                                    // type. Clamping to >=0 here doesn't change
                                                    // observable behavior at all: a malformed
                                                    // packet where the raw subtraction WOULD have
                                                    // been negative clamps to exactly 0, and 0
                                                    // still fails the `data_len > 0` check below
                                                    // exactly like a negative value would have --
                                                    // this only makes data_len's OWN type honestly
                                                    // reflect a fact that was already true, safe
                                                    // improvement in isolation (P4c section).
                                                    // data_len/data_off are u16 (matching tcp_len/
                                                    // tcp_hdr_len's base): both flow into the same
                                                    // `data_off + data_len` addition below, which
                                                    // needs them to share a type regardless of the
                                                    let data_len: u16 = max(header.tcp_len - header.tcp_hdr_len, 0);
                                                    if (data_len > 0 &&
                                                        header.tcp_hdr_len == 20 &&
                                                        (header.flags & TCP_FLAG_ACK) != 0 &&
                                                        header.seq == conn.rcv_nxt) {
                                                        let tcp_len_idx: usize = header.tcp_len as usize;
                                                        let tcp_seg = frame[34..<34 + tcp_len_idx];
                                                        if (build_data_reply(conn, frame, header.ihl, tcp_seg,
                                                                data_len, data_len)) {
                                                            plan = TcpRxPlan::Send(14 + (header.ihl as i32) + 20 + (data_len as i32));
                                                            // rcv_nxt/snd_nxt are u32
                                                            // (sequence numbers), data_len is u16 --
                                                            // the widening cast here is harmless
                                                            // (loses data_len's own refined range,
                                                            // but neither counter is ever used as a
                                                            // slice bound/index, so no proof depends
                                                            // on their refined-ness).
                                                            conn.rcv_nxt =
                                                                conn.rcv_nxt + (data_len as u32);
                                                            conn.snd_nxt =
                                                                conn.snd_nxt + (data_len as u32);
                                                            tcp_completed_echoes =
                                                                tcp_completed_echoes + 1;
                                                        }
                                                    }
                                                }
                                            } else if (conn.state == ConnState::LastAck) {
                                                if ((header.flags & TCP_FLAG_ACK) != 0 &&
                                                    header.ack == conn.snd_nxt) {
                                                    // Close complete; ready for a new client.
                                                    conn.state = ConnState::Listen;
                                                    tcp_completed_closes =
                                                        tcp_completed_closes + 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        match plan {
                            TcpRxPlan::Release => {
                                ready = net_rx_release(acquired);
                            }
                            TcpRxPlan::Send(reply_len) => {
                                ready = net_rx_send_reply(
                                    net_rx_reply_ready(acquired, reply_len));
                            }
                        }
                        if (tcp_completed_handshakes >= 2 &&
                            tcp_completed_echoes >= 1 &&
                            tcp_completed_closes >= 1) {
                            tcp_connection_free(echo_owner);
                            return KernelTcpResult::Verified(ready);
                        }
                    }
                }
    }
    tcp_connection_free(echo_owner);
    return KernelTcpResult::TimedOut(ready);
}

// Blocks for one three-way handshake on the requested listening port. The
// caller owns the returned RX capability in both outcomes; connected stream
// I/O is added separately after accept establishes fd state.
fn kernel_tcp_accept_once(owner: borrow TcpConnectionOwner[connection],
                          ready_in: sink NetRxCanAcquire, port: u16)
        -> KernelTcpAcceptResult !{may_block} {
    let mut ready = ready_in;
    let conn: *TcpConnection = tcp_connection_of(owner);
    let remote_ip_bytes =
        conn.remote_ip as []u8;
    let remote_mac_bytes =
        conn.remote_mac as []u8;
    let stream_frames = tcp_connection_tx_slice(conn);
    conn.state = ConnState::Listen;
    conn.local_port = port;
    // GitHub issue #180: a fresh connection never inherits a stale queue
    // slot from a previous one. kernel_tcp_close_stream now drains its
    // own pending queue synchronously before it ever returns (see that
    // function), so -- unlike before -- this loop no longer needs to
    // opportunistically service leftover pending_tcp state itself.
    pending_tcp_reset_all(conn.self_address);
    let start: i64 = read_cntpct();
    let counter_frequency: i64 = read_cntfrq();
    let deadline_ticks: i64 = counter_frequency * 30;
    // /20 (50ms) gave TCP_RETRY_LIMIT * retry_ticks = 150ms total budget for
    // the injected SYN-ACK-drop recovery check (kernel_tcp_inject_drop_next_
    // syn_ack) -- too tight against scripts/run_kernel_hwtest_rpi5.sh's
    // curl-based httpd probe (--connect-timeout 1s): on one real-hardware
    // run, curl's own attempt didn't complete within that 150ms window, the
    // kernel gave up on the half-open connection and reset to Listen, and a
    // later curl retry then succeeded as a *fresh* connection -- passing the
    // overall test but silently skipping the retransmit-recovery
    // observation (kernel_tcp_injected_syn_ack_recovered() returned false;
    // 5 immediate re-runs afterward did not reproduce it). /5 (200ms) gives
    // 600ms total, comfortably inside curl's 1s budget while still well
    // under deadline_ticks below.
    let retry_ticks: i64 = counter_frequency / 5;
    let mut syn_ack_sent_at: i64 = start;
    let mut syn_ack_retries: usize = 0;
    while ((read_cntpct() - start) < deadline_ticks) {
        net_rx_wait();
        match net_rx_acquire(ready) {
            NetRxAcquire::None(next) => { ready = next; }
            NetRxAcquire::Acquired(acquired) => {
                let len: i32 = net_rx_len(acquired);
                let mut plan: TcpRxPlan = TcpRxPlan::Release;
                let mut accepted: bool = false;
                if (len >= 42) {
                    let arp_frame = net_rx_frame(acquired);
                    if (arp_prepare_reply(arp_frame)) {
                        plan = TcpRxPlan::Send(len);
                    }
                }
                if (len >= 54 && len <= 1514) {
                    let frame = net_rx_frame(acquired);
                    match tcp_parse_segment(frame, len) {
                        TcpSegmentParseResult::Reject => { }
                        TcpSegmentParseResult::Parsed(header) => {
                            let ip = frame[14..<34];
                            if (header.dst_port == port) {
                                if (conn.state == ConnState::Listen &&
                                    (header.flags & TCP_FLAG_SYN) != 0) {
                                    slice_copy(remote_ip_bytes[0..<4],
                                        ip[IP_SRC..<IP_DST]);
                                    slice_copy(remote_mac_bytes[0..<6],
                                        frame[6..<12]);
                                    conn.remote_port = header.src_port;
                                    conn.rcv_nxt = header.seq + 1;
                                    conn.snd_nxt =
                                        TCP_INITIAL_SEQ + 1;
                                    build_syn_ack(conn, frame, header.ihl);
                                    slice_copy(stream_frames[0..<54],
                                               frame[0..<54]);
                                    if (tcp_drop_next_syn_ack) {
                                        tcp_drop_next_syn_ack = false;
                                        tcp_injected_syn_pending = true;
                                        plan = TcpRxPlan::Release;
                                    } else {
                                        tcp_injected_syn_pending = false;
                                        plan = TcpRxPlan::Send(
                                            14 + (header.ihl as i32) + 20);
                                    }
                                    syn_ack_sent_at =
                                        read_cntpct();
                                    syn_ack_retries = 0;
                                    conn.state =
                                        ConnState::SynRcvd;
                                } else if (
                                    conn.state == ConnState::SynRcvd &&
                                    header.src_port == conn.remote_port &&
                                    slice_eq(ip[IP_SRC..<IP_DST],
                                        remote_ip_bytes[0..<4]) &&
                                    (header.flags & TCP_FLAG_RST) != 0) {
                                    conn.state = ConnState::Listen;
                                    tcp_injected_syn_pending = false;
                                } else if (
                                    conn.state == ConnState::SynRcvd &&
                                    header.src_port == conn.remote_port &&
                                    slice_eq(ip[IP_SRC..<IP_DST],
                                        remote_ip_bytes[0..<4]) &&
                                    (header.flags & TCP_FLAG_ACK) != 0 &&
                                    (header.flags & TCP_FLAG_SYN) == 0 &&
                                    header.ack == conn.snd_nxt &&
                                    header.seq == conn.rcv_nxt) {
                                    conn.state =
                                        ConnState::Established;
                                    if (tcp_injected_syn_pending &&
                                        tcp_injected_syn_retransmitted) {
                                        tcp_injected_syn_accepted = true;
                                    }
                                    accepted = true;
                                }
                            }
                        }
                    }
                }
                match plan {
                    TcpRxPlan::Release => {
                        ready = net_rx_release(acquired);
                    }
                    TcpRxPlan::Send(reply_len) => {
                        ready = net_rx_send_reply(
                            net_rx_reply_ready(acquired, reply_len));
                    }
                }
                if (accepted) {
                    return KernelTcpAcceptResult::Accepted(ready);
                }
            }
        }
        let retry_now: i64 = read_cntpct();
        if (conn.state == ConnState::SynRcvd &&
            syn_ack_retries < TCP_RETRY_LIMIT &&
            retry_now - syn_ack_sent_at >= retry_ticks) {
            ready = net_transmit_ready(
                ready, stream_frames[0..<1514], 54);
            syn_ack_sent_at = retry_now;
            syn_ack_retries = syn_ack_retries + 1;
            if (tcp_injected_syn_pending) {
                tcp_injected_syn_retransmitted = true;
            }
        } else if (conn.state == ConnState::SynRcvd &&
                   syn_ack_retries == TCP_RETRY_LIMIT &&
                   retry_now - syn_ack_sent_at >= retry_ticks) {
            // The half-open peer did not acknowledge any bounded attempt.
            // Release the tuple so a later connect() attempt, commonly with
            // a new ephemeral source port, can use the same listener.
            // If this give-up was itself the injected-drop observation
            // window (tcp_injected_syn_pending), re-arm the drop for the
            // *next* SYN instead of letting the observation vanish for the
            // rest of this boot: kernel_tcp_inject_drop_next_syn_ack()
            // only tests the very first SYN this accept_once() call ever
            // sees, so previously any single lost race here (real-hardware
            // network jitter, the retransmitted SYN-ACK itself getting
            // dropped, ...) meant the caller's httpd curl retry loop (up
            // to 20 attempts) could keep completing fresh connections
            // that were never drop-tested, and the "syn-ack drop
            // retransmit ok" milestone would go missing for the whole run
            // even though the overall boot still passed. Re-arming turns
            // this from a single race into "must lose 20 times running"
            // -- see the kernel-tcp-retry-timing memory for the earlier,
            // narrower retry_ticks widening this builds on.
            if (tcp_injected_syn_pending) {
                tcp_drop_next_syn_ack = true;
            }
            conn.state = ConnState::Listen;
            tcp_injected_syn_pending = false;
        }
    }
    return KernelTcpAcceptResult::TimedOut(ready);
}

fn kernel_tcp_receive_once(owner: borrow TcpConnectionOwner[connection],
                           ready_in: sink NetRxCanAcquire,
                           destination: borrow [u8; 1460..])
        -> KernelTcpReceiveResult !{may_block} {
    let mut ready = ready_in;
    let conn: *TcpConnection = tcp_connection_of(owner);
    let remote_ip_bytes =
        conn.remote_ip as []u8;
    let start: i64 = read_cntpct();
    let deadline_ticks: i64 = read_cntfrq() * 30;
    while ((read_cntpct() - start) < deadline_ticks) {
        net_rx_wait();
        match net_rx_acquire(ready) {
            NetRxAcquire::None(next) => { ready = next; }
            NetRxAcquire::Acquired(acquired) => {
                let len: i32 = net_rx_len(acquired);
                let mut disposition: TcpReceiveDisposition =
                    TcpReceiveDisposition::Ignore;
                if (len >= 55 && len <= 1514) {
                    let len_n: i32 = len;
                    let frame = net_rx_frame(acquired);
                    let eth: *EthHdr = frame as *EthHdr;
                    if (eth.ethertype == ETHERTYPE_IPV4) {
                        let ip = frame[14..<34];
                        let ip_hdr: *Ipv4Hdr = ip as *Ipv4Hdr;
                        let ihl: u16 = (ip_hdr.version_ihl & 0x0F) * 4;
                        let len16: u16 = len_n as u16;
                        let total_len: u16 = ip_hdr.total_len as u16;
                        let ip_len_in_frame: u16 = len16 - 14;
                        if ((ip_hdr.version_ihl >> 4) == 4 && ihl == 20 &&
                            total_len <= ip_len_in_frame &&
                            total_len >= 41 && ip_hdr.protocol == PROTO_TCP &&
                            inet_checksum(ip[0..<20]) == 0 &&
                            slice_eq(ip[IP_DST..<20], OUR_IP as []u8) &&
                            slice_eq(ip[IP_SRC..<IP_DST],
                                remote_ip_bytes[0..<4])) {
                            let tcp = frame[34..<54];
                            let tcp_hdr: *TcpHdr = tcp as *TcpHdr;
                            let tcp_len: u16 = total_len - 20;
                            let doff: u8 = tcp_hdr.data_offset >> 4;
                            if (doff == 5 && tcp_len >= 21) {
                                let mut pseudo: [u8; 12];
                                slice_copy(pseudo[0..<4], ip[IP_SRC..<IP_DST]);
                                slice_copy(pseudo[4..<8], ip[IP_DST..<20]);
                                pseudo[8] = 0;
                                pseudo[9] = PROTO_TCP;
                                write_u16be(pseudo[10..<12], tcp_len);
                                let tcp_len_index: usize = tcp_len as usize;
                                let tcp_segment =
                                    frame[34..<34 + tcp_len_index];
                                let source_port: u16 = tcp_hdr.src_port as u16;
                                let destination_port: u16 = tcp_hdr.dst_port as u16;
                                let sequence: u32 = tcp_hdr.seq as u32;
                                if (source_port == conn.remote_port &&
                                    destination_port == conn.local_port &&
                                    (tcp_hdr.flags & TCP_FLAG_ACK) != 0 &&
                                    checksum_fold(checksum_add(
                                        tcp_segment,
                                        checksum_add(pseudo as []u8, 0))) == 0) {
                                    if (sequence != conn.rcv_nxt) {
                                        // Duplicate (sequence behind rcv_nxt) and
                                        // out-of-order (ahead) data both elicit the
                                        // same cumulative ACK. Neither advances the
                                        // stream or reaches userspace.
                                        disposition =
                                            TcpReceiveDisposition::AckOnly;
                                    } else {
                                        let data_length: u16 = tcp_len - 20;
                                        if (data_length >= 1 &&
                                            data_length <= TCP_MAX_PAYLOAD) {
                                            let data_length_index: usize =
                                                data_length as usize;
                                            if (data_length_index <= 1460) {
                                                let mut copy_index: usize = 0;
                                                while (copy_index < data_length_index) {
                                                    let destination_index: usize =
                                                        copy_index;
                                                    let source_index: usize =
                                                        54 as usize + copy_index;
                                                    if (destination_index < 1460 &&
                                                        source_index < 1514) {
                                                        destination[destination_index] =
                                                            frame[source_index];
                                                    }
                                                    copy_index = copy_index + 1;
                                                }
                                                disposition =
                                                    TcpReceiveDisposition::Payload(
                                                        data_length_index);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                match disposition {
                    TcpReceiveDisposition::Ignore => {
                        ready = net_rx_release(acquired);
                    }
                    TcpReceiveDisposition::AckOnly => {
                        build_receive_ack(
                            conn, net_rx_frame(acquired), 20);
                        ready = net_rx_send_reply(
                            net_rx_reply_ready(acquired, 54));
                    }
                    TcpReceiveDisposition::Payload(payload_length) => {
                        conn.rcv_nxt =
                            conn.rcv_nxt + (payload_length as u32);
                        conn.received_length = payload_length;
                        if (tcp_ack_each_stream_segment) {
                            tcp_split_request_segments =
                                tcp_split_request_segments + 1;
                            build_receive_ack(
                                conn, net_rx_frame(acquired), 20);
                            return KernelTcpReceiveResult::Received(
                                net_rx_send_reply(
                                    net_rx_reply_ready(acquired, 54)));
                        }
                        // Delayed ACK: release RX immediately so another
                        // in-order segment can reach the next read, then
                        // piggyback the cumulative ACK on userspace output.
                        return KernelTcpReceiveResult::Received(
                            net_rx_release(acquired));
                    }
                }
            }
        }
    }
    return KernelTcpReceiveResult::TimedOut(ready);
}

fn kernel_tcp_received_length(owner: borrow TcpConnectionOwner[connection])
        -> usize !{unsafe} {
    return tcp_connection_of(owner).received_length;
}

fn kernel_tcp_send_received(owner: borrow TcpConnectionOwner[connection],
                            ready: sink NetRxCanAcquire,
                            source: borrow [u8; 1460..],
                            received_length: usize,
                            payload_length: usize)
        -> KernelTcpSendResult !{may_block} {
    let conn: *TcpConnection = tcp_connection_of(owner);
    let remote_ip_bytes =
        conn.remote_ip as []u8;
    let remote_mac_bytes =
        conn.remote_mac as []u8;
    if (payload_length >= 1 && payload_length <= 1460 &&
        received_length >= 1 && received_length <= 1460) {
        let length: usize = payload_length;
        let frame_bytes = tcp_connection_tx_slice(conn);
        slice_copy(frame_bytes[0..<6],
                   remote_mac_bytes[0..<6]);
        slice_copy(frame_bytes[6..<12], our_mac as []u8);
        let eth_hdr: *EthHdr = frame_bytes as *EthHdr;
        eth_hdr.ethertype = ETHERTYPE_IPV4;
        let ip = frame_bytes[14..<34];
        let ip_hdr: *Ipv4Hdr = ip as *Ipv4Hdr;
        ip_hdr.version_ihl = 0x45;
        ip_hdr.dscp_ecn = 0;
        ip_hdr.total_len = (40 + length as u16) as u16be;
        ip_hdr.ident = 0;
        ip_hdr.flags_frag = 0x4000;
        ip_hdr.ttl = 64;
        ip_hdr.protocol = PROTO_TCP;
        ip_hdr.checksum = 0;
        slice_copy(ip[IP_SRC..<IP_DST], OUR_IP as []u8);
        slice_copy(ip[IP_DST..<20],
                   remote_ip_bytes[0..<4]);
        ip_hdr.checksum = (inet_checksum(ip) as u16) as u16be;
        let tcp = frame_bytes[34..<54];
        let tcp_hdr: *TcpHdr = tcp as *TcpHdr;
        tcp_hdr.src_port = conn.local_port as u16be;
        tcp_hdr.dst_port = conn.remote_port as u16be;
        tcp_hdr.seq = conn.snd_nxt as u32be;
        tcp_hdr.ack = conn.rcv_nxt as u32be;
        tcp_hdr.data_offset = (5 << 4) as u8;
        tcp_hdr.flags = TCP_FLAG_ACK | TCP_FLAG_PSH;
        tcp_hdr.window = 65535;
        tcp_hdr.checksum = 0;
        tcp_hdr.urgent = 0;
        slice_copy(frame_bytes[54..<54 + length], source[0..<length]);
        fix_tcp_checksum(ip, frame_bytes[34..<54 + length]);
        conn.snd_nxt =
            conn.snd_nxt + (length as u32);
        let frame_length: usize = 54 + length;
        // GitHub issue #180: opportunistically retire any already-acked
        // older segment (and retry any overdue one) before queuing this
        // new one -- consecutive write()s no longer clobber each other's
        // retransmission record now that pending_tcp_record finds its own
        // free slot instead of always overwriting slot 0.
        let mut serviced = pending_tcp_service_once(
            conn, ready, read_cntfrq() / 5);
        let this_index: usize = conn.data_segment_counter;
        conn.data_segment_counter =
            conn.data_segment_counter + 1;
        let this_entry: usize = pending_tcp_record(
            conn, PendingTcpKind::Data, frame_length);
        // GitHub issue #295: this_entry == 0 means the segment could not
        // be queued (pending_tcp_record's own doc comment) -- there is
        // nothing to ever retransmit from, so the deliberate-drop test
        // injection below must not arm in that case, or this segment
        // would never be transmitted at all (skipped here, and never
        // retried since nothing tracks it). Fall through to the real send.
        // The condition was `this_slot >= 0` when the sentinel was -1;
        // issue #257 made it an entry address, whose sentinel is 0.
        if (this_entry != 0 &&
                this_index as i32 == tcp_drop_data_segment_index) {
            // Skip only this segment's initial transmit -- it stays
            // queued (pending_tcp_record already ran above), so its
            // first REAL transmission, and the recovery-observed flag,
            // both come from pending_tcp_service_once's real timeout+
            // peer-ack path, the same one every other segment uses.
            tcp_drop_data_segment_index = -1;
            conn.injected_data_entry = this_entry;
            return KernelTcpSendResult::Sent(serviced);
        }
        return KernelTcpSendResult::Sent(net_transmit_ready(
            serviced, frame_bytes, frame_length as i32));
    }
    return KernelTcpSendResult::Invalid(ready);
}

// GitHub issue #180: used to defer sending FIN entirely (setting
// pending_tcp_want_fin and returning immediately) whenever a Data
// segment was still outstanding, because the old single pending slot
// could not track a Data segment and a FIN segment at the same time --
// recording the FIN would have clobbered the Data segment's own
// retransmission record. With independent slots that limitation is
// gone: FIN is queued and sent immediately below like any other segment,
// and this function now waits (bounded) for every slot -- any Data
// segment still outstanding when close() was called, plus the FIN this
// call just queued -- to be acknowledged or give up, instead of
// returning with unfinished business for some later caller to notice.
fn kernel_tcp_close_stream(owner: borrow TcpConnectionOwner[connection],
                           ready_in: sink NetRxCanAcquire)
        -> KernelTcpCloseResult !{may_block} {
    let mut ready = ready_in;
    let conn: *TcpConnection = tcp_connection_of(owner);
    let remote_ip_bytes =
        conn.remote_ip as []u8;
    let remote_mac_bytes =
        conn.remote_mac as []u8;
    let frame = tcp_connection_tx_slice(conn);
    slice_copy(frame[0..<6],
               remote_mac_bytes[0..<6]);
    slice_copy(frame[6..<12], our_mac as []u8);
    let eth_hdr: *EthHdr = frame as *EthHdr;
    eth_hdr.ethertype = ETHERTYPE_IPV4;
    let ip = frame[14..<34];
    let ip_hdr: *Ipv4Hdr = ip as *Ipv4Hdr;
    ip_hdr.version_ihl = 0x45;
    ip_hdr.dscp_ecn = 0;
    ip_hdr.total_len = 40;
    ip_hdr.ident = 0;
    ip_hdr.flags_frag = 0x4000;
    ip_hdr.ttl = 64;
    ip_hdr.protocol = PROTO_TCP;
    ip_hdr.checksum = 0;
    slice_copy(ip[IP_SRC..<IP_DST], OUR_IP as []u8);
    slice_copy(ip[IP_DST..<20],
               remote_ip_bytes[0..<4]);
    ip_hdr.checksum = (inet_checksum(ip) as u16) as u16be;
    let tcp = frame[34..<54];
    let tcp_hdr: *TcpHdr = tcp as *TcpHdr;
    tcp_hdr.src_port = conn.local_port as u16be;
    tcp_hdr.dst_port = conn.remote_port as u16be;
    tcp_hdr.seq = conn.snd_nxt as u32be;
    tcp_hdr.ack = conn.rcv_nxt as u32be;
    tcp_hdr.data_offset = (5 << 4) as u8;
    tcp_hdr.flags = TCP_FLAG_FIN | TCP_FLAG_ACK;
    tcp_hdr.window = 65535;
    tcp_hdr.checksum = 0;
    tcp_hdr.urgent = 0;
    fix_tcp_checksum(ip, tcp);
    conn.snd_nxt = conn.snd_nxt + 1;
    let fin_entry: usize = pending_tcp_record(
        conn, PendingTcpKind::Fin, 54);
    // GitHub issue #295: same reasoning as the Data-segment send site --
    // fin_entry == 0 means nothing tracks this FIN, so the deliberate-drop
    // injection must not arm (that would skip the only transmission this
    // FIN would ever get). Falls through to the real send instead.
    if (tcp_drop_next_fin && fin_entry != 0) {
        tcp_drop_next_fin = false;
        conn.injected_fin_entry = fin_entry;
    } else {
        ready = net_transmit_ready(ready, frame, 54);
    }
    let start: i64 = read_cntpct();
    let counter_frequency: i64 = read_cntfrq();
    let deadline_ticks: i64 = counter_frequency * 5;
    let retry_ticks: i64 = counter_frequency / 5;
    while (pending_tcp_any_active(conn) &&
           (read_cntpct() - start) < deadline_ticks) {
        net_rx_wait();
        ready = pending_tcp_service_once(conn, ready, retry_ticks);
    }
    return KernelTcpCloseResult::Closed(ready);
}

// GitHub issue #453, and this file is the worst case behind it.
//
// RetxEntry has eleven fields and its guard covers one of them. The other
// ten -- including a 1514-byte frame handed to the NIC -- are ordinary
// public storage written by tcp_retransmit_scan with no guard held.
// TcpConnection is the same shape with 4 private fields and 20 public.
// That is safe today only because there is no second kernel context to
// interleave with, which is exactly what both numbers below say.
//
// GitHub issue #452 is the fix: group the protected fields and reach them
// only through a guard-derived accessor. Until then, this assertion is
// what makes removing either leg fail here rather than in production.
fn tcp_execution_model_assumption() {
    static_assert(KERNEL_ACTIVE_CORES == 1 && KERNEL_PREEMPTIBLE == 0,
                  "RetxEntry's guard covers one field of eleven, including the 1514-byte frame the NIC reads -- see issue #452");
}
