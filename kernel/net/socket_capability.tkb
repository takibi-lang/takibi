// GitHub issue #237 (QEMU port): no longer `use`s kernel/drivers/net/
// rp1_gem.tkb directly -- NetRxCanAcquire and net_shutdown() come from
// whichever kernel/drivers/net/{rp1_gem,virtio_net}.tkb is on this
// build's compile line (same file-selection convention as
// kernel/platform/*/uart.tkb), since both platforms' drivers define the
// identical name. Only one may ever be listed per build: both define the
// same top-level names, so listing both together is a compile error by
// design.

// Current limitations (2026-09-07): there is exactly one NetRxCanAcquire
// capability for the whole kernel: no multi-NIC support, and every
// network-facing syscall path serializes through this single store. The
// store's Mutex provides cross-core exclusion, while the indexed linear guard
// makes access without holding that particular mutex a compile error. Driver
// initialization remains CPU0-owned by each platform's interrupt routing; it
// is not state owned by this store.
//
use "kernel/lib/execution_model.tkb";
use "kernel/lib/mutex.tkb";

variant NetworkCapabilityValue {
    Empty;
    Ready(NetRxCanAcquire);
}

struct NetworkCapabilityStore {
    private mutex: Mutex;
    private value: NetworkCapabilityValue;
}

private let mut network_capability_store: NetworkCapabilityStore;
// GitHub issue #451: a linear STRUCT, not an erased view any more.
// A view emits nothing, so it could not carry the interrupt state a
// release must restore -- and it did not need to while the lock itself
// emitted nothing either. Now that mutex_acquire really masks and really
// takes, `flags` is the frame slot Linux's own `unsigned long flags`
// occupies, and holding it per-guard is what makes the pair correct
// inside an interrupt handler (DAIF.I already set on entry, so release
// leaves it set) and correct when two nest. Identity is unchanged:
// `[lock: addr]` still makes another container's guard a compile error.
private linear struct NetworkCapabilityGuard[lock: addr] {
    private flags: usize;
}

must_use variant NetworkCapabilityInstallResult {
    Installed;
    AlreadyInstalled(NetRxCanAcquire);
}

must_use variant NetworkCapabilityTakeResult {
    Empty;
    Ready(NetRxCanAcquire);
}

must_use variant NetworkCapabilityPutResult { Stored; Conflict; }

fn network_capability_lock(lock: *Mutex @ address)
        -> NetworkCapabilityGuard[address]
        !{acquires_lock_40_network_capability,
          lock_guard_40_network_capability} {
    let mut guard: NetworkCapabilityGuard[address] = { mutex_acquire(lock) };
    return guard;
}

fn network_capability_unlock(guard: sink NetworkCapabilityGuard[address],
        lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

fn network_capability_install(ready: sink NetRxCanAcquire)
        -> NetworkCapabilityInstallResult {
    let guard = network_capability_lock(&network_capability_store.mutex);
    let previous: NetworkCapabilityValue = stable_replace(
        guard, &network_capability_store.mutex,
        network_capability_store.value,
        NetworkCapabilityValue::Ready(ready));
    match previous {
        NetworkCapabilityValue::Empty => {
            network_capability_unlock(
                guard, &network_capability_store.mutex);
            return NetworkCapabilityInstallResult::Installed;
        }
        NetworkCapabilityValue::Ready(stale) => {
            let displaced: NetworkCapabilityValue = stable_replace(
                guard, &network_capability_store.mutex,
                network_capability_store.value,
                NetworkCapabilityValue::Ready(stale));
            network_capability_unlock(
                guard, &network_capability_store.mutex);
            match displaced {
                NetworkCapabilityValue::Empty => {
                    return NetworkCapabilityInstallResult::Installed;
                }
                NetworkCapabilityValue::Ready(incoming) => {
                    return NetworkCapabilityInstallResult::AlreadyInstalled(
                        incoming);
                }
            }
        }
    }
}

fn network_capability_take() -> NetworkCapabilityTakeResult {
    let guard = network_capability_lock(&network_capability_store.mutex);
    let previous: NetworkCapabilityValue = stable_replace(
        guard, &network_capability_store.mutex,
        network_capability_store.value, NetworkCapabilityValue::Empty);
    network_capability_unlock(guard, &network_capability_store.mutex);
    match previous {
        NetworkCapabilityValue::Empty => {
            return NetworkCapabilityTakeResult::Empty;
        }
        NetworkCapabilityValue::Ready(ready) => {
            return NetworkCapabilityTakeResult::Ready(ready);
        }
    }
}

fn network_capability_put(ready: sink NetRxCanAcquire)
        -> NetworkCapabilityPutResult {
    match network_capability_install(ready) {
        NetworkCapabilityInstallResult::Installed => {
            return NetworkCapabilityPutResult::Stored;
        }
        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
            net_shutdown(incoming);
            return NetworkCapabilityPutResult::Conflict;
        }
    }
}

// This store does not depend on KERNEL_ACTIVE_CORES. Its three public
// operations take network_capability_store.mutex before moving the capability;
// the net_init() flags that mint the initial driver capability live in the
// platform-selected drivers and remain CPU0-owned by device interrupt routing.
