// GitHub issue #237 (QEMU port): no longer `use`s kernel/drivers/net/
// rp1_gem.tkb directly -- NetRxCanAcquire and net_shutdown() come from
// whichever kernel/drivers/net/{rp1_gem,virtio_net}.tkb is on this
// build's compile line (same file-selection convention as
// kernel/platform/*/uart.tkb), since both platforms' drivers define the
// identical name. Only one may ever be listed per build: both define the
// same top-level names, so listing both together is a compile error by
// design.

// Current limitations (2026-09-07): there is exactly one NetRxCanAcquire
// capability for the whole kernel: no multi-NIC support, and every
// network-facing syscall path serializes through this single store, as do
// the two non-syscall holders (2026-10-24, GitHub issue #846): the return
// to EL0 and the idle loop, which take it only without waiting. The
// store's Mutex provides cross-core exclusion, while the indexed linear guard
// makes access without holding that particular mutex a compile error. Driver
// initialization remains CPU0-owned by each platform's interrupt routing; it
// is not state owned by this store.
//
use "kernel/lib/execution_model.tkb";
use "kernel/lib/mutex.tkb";

struct NetworkCapabilityStore {
    private mutex: Mutex;
    private value: Place(NetRxCanAcquire);
    // GitHub issue #828: set, under `mutex`, the first time a capability is
    // installed, and never cleared. Once set, an empty store means a holder
    // is between take and put, which network_capability_take_waiting waits
    // out; while clear, no capability exists anywhere.
    private installed_once: bool;
}

private let mut network_capability_store: NetworkCapabilityStore;
// GitHub issue #451: a linear STRUCT, not an erased view any more.
// A view emits nothing, so it could not carry the interrupt state a
// release must restore -- and it did not need to while the lock itself
// emitted nothing either. Now that mutex_acquire really masks and really
// takes, `flags` is the frame slot Linux's own `unsigned long flags`
// occupies, and holding it per-guard is what makes the pair correct
// inside an interrupt handler (DAIF.I already set on entry, so release
// leaves it set) and correct when two nest. Identity is unchanged:
// `[lock: addr]` still makes another container's guard a compile error.
private linear struct NetworkCapabilityGuard[lock: addr] {
    private flags: usize;
}

must_use variant NetworkCapabilityInstallResult {
    Installed;
    AlreadyInstalled(NetRxCanAcquire);
}

must_use variant NetworkCapabilityTakeResult {
    Empty;
    Ready(NetRxCanAcquire);
}

must_use variant NetworkCapabilityPutResult { Stored; Conflict; }

fn network_capability_lock(lock: *Mutex @ address)
        -> NetworkCapabilityGuard[address]
        !{acquires_lock_40_network_capability,
          lock_guard_40_network_capability} {
    let mut guard: NetworkCapabilityGuard[address] = { mutex_acquire(lock) };
    return guard;
}

fn network_capability_unlock(guard: sink NetworkCapabilityGuard[address],
        lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

// GitHub issue #920: DDB runs under the debug stop and takes no lock; one
// attempt instead, with its own release.
must_use variant NetworkCapabilityTry[lock: addr] {
    Busy;
    Taken(NetworkCapabilityGuard[lock]);
}

private fn network_capability_try_lock(lock: *Mutex @ address)
        -> NetworkCapabilityTry[address] !{unsafe} {
    match mutex_try_acquire(lock) {
        MutexTry::Busy => { return NetworkCapabilityTry::Busy; }
        MutexTry::Taken(flags) => {
            let mut guard: NetworkCapabilityGuard[address] = { flags };
            return NetworkCapabilityTry::Taken(guard);
        }
    }
}

private fn network_capability_try_unlock(
        guard: sink NetworkCapabilityGuard[address], lock: *Mutex @ address)
        !{unsafe} {
    mutex_try_release(lock, guard.flags);
}

fn network_capability_install(ready: sink NetRxCanAcquire)
        -> NetworkCapabilityInstallResult {
    let guard = network_capability_lock(&network_capability_store.mutex);
    let previous: Place(NetRxCanAcquire) = place_put(
        guard, &network_capability_store.mutex,
        network_capability_store.value, ready);
    match previous {
        Place::Empty => {
            network_capability_store.installed_once = true;
            network_capability_unlock(
                guard, &network_capability_store.mutex);
            return NetworkCapabilityInstallResult::Installed;
        }
        Place::Full(stale) => {
            let displaced: Place(NetRxCanAcquire) = place_put(
                guard, &network_capability_store.mutex,
                network_capability_store.value, stale);
            network_capability_unlock(
                guard, &network_capability_store.mutex);
            match displaced {
                Place::Empty => {
                    return NetworkCapabilityInstallResult::Installed;
                }
                Place::Full(incoming) => {
                    return NetworkCapabilityInstallResult::AlreadyInstalled(
                        incoming);
                }
            }
        }
    }
}

fn network_capability_take() -> NetworkCapabilityTakeResult {
    let guard = network_capability_lock(&network_capability_store.mutex);
    let previous: Place(NetRxCanAcquire) = place_take(
        guard, &network_capability_store.mutex,
        network_capability_store.value);
    network_capability_unlock(guard, &network_capability_store.mutex);
    match previous {
        Place::Empty => {
            return NetworkCapabilityTakeResult::Empty;
        }
        Place::Full(ready) => {
            return NetworkCapabilityTakeResult::Ready(ready);
        }
    }
}

must_use variant NetworkCapabilityWaitResult {
    NeverInstalled;
    Ready(NetRxCanAcquire);
}

// GitHub issue #828: the capability, waiting for a holder to put it back.
// Every holder is a syscall between its take and its put on another CPU,
// or (GitHub issue #846) the stack-wide retransmit pass, which the return
// to EL0 and the idle loop run only when network_capability_take finds the
// capability free -- they never wait for it -- and which never waits on a
// connection lock while it holds it. None holds it while blocked (see
// kernel/net/tcp.tkb's header), none from an interrupt handler, and the
// caller holds no lock that a holder waits for, so the wait is bounded by
// one such section. NeverInstalled means no capability
// was ever minted (network bring-up failed or found no device), so nothing
// can be holding one either. Nothing here names a CPU (#830).
fn network_capability_take_waiting() -> NetworkCapabilityWaitResult {
    while (true) {
        let guard = network_capability_lock(&network_capability_store.mutex);
        let installed: bool = network_capability_store.installed_once;
        let previous: Place(NetRxCanAcquire) = place_take(
            guard, &network_capability_store.mutex,
            network_capability_store.value);
        network_capability_unlock(guard, &network_capability_store.mutex);
        match previous {
            Place::Full(ready) => {
                return NetworkCapabilityWaitResult::Ready(ready);
            }
            Place::Empty => {
                if (installed == false) {
                    return NetworkCapabilityWaitResult::NeverInstalled;
                }
            }
        }
    }
    return NetworkCapabilityWaitResult::NeverInstalled;
}

fn network_capability_put(ready: sink NetRxCanAcquire)
        -> NetworkCapabilityPutResult {
    match network_capability_install(ready) {
        NetworkCapabilityInstallResult::Installed => {
            return NetworkCapabilityPutResult::Stored;
        }
        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
            net_shutdown(incoming);
            return NetworkCapabilityPutResult::Conflict;
        }
    }
}

// GitHub issue #876: whether the one RX capability is in the store, for DDB.
// A NetRx read that finds the store Empty returns NetWait before its 30 s
// receive bound is checked, so a capability that was never put back stalls
// every network reader forever while each still looks like an ordinary
// `Blocked net-rx`. DDB calls this with every other core stopped: a held
// mutex then means a holder was stopped between take and put (Unknown, the
// lock is not taken), and otherwise the lock is free and taking it is a
// bounded, uncontended section. Since #920 that is one try-lock, not a look
// then a take: a core the debug stop holds may own the lock. The capability is put straight back; the
// Conflict arm cannot run while this core holds the mutex it just found the
// store Empty under, and shuts the duplicate down as
// network_capability_put does rather than leak a linear value.
fn network_capability_ddb_stored() -> NetPendingState !{unsafe} {
    let NetworkCapabilityTry::Taken(guard) =
        network_capability_try_lock(&network_capability_store.mutex) else {
        NetworkCapabilityTry::Busy => { return NetPendingState::Unknown; }
    };
    let previous: Place(NetRxCanAcquire) = place_take(
        guard, &network_capability_store.mutex,
        network_capability_store.value);
    match previous {
        Place::Empty => {
            network_capability_try_unlock(guard, &network_capability_store.mutex);
            return NetPendingState::No;
        }
        Place::Full(ready) => {
            let displaced: Place(NetRxCanAcquire) = place_put(
                guard, &network_capability_store.mutex,
                network_capability_store.value, ready);
            network_capability_try_unlock(guard, &network_capability_store.mutex);
            match displaced {
                Place::Empty => { return NetPendingState::Yes; }
                Place::Full(duplicate) => {
                    net_shutdown(duplicate);
                    return NetPendingState::Unknown;
                }
            }
        }
    }
}

// This store does not depend on KERNEL_ACTIVE_CORES. Its three public
// operations take network_capability_store.mutex before moving the capability;
// the net_init() flags that mint the initial driver capability live in the
// platform-selected drivers and remain CPU0-owned by device interrupt routing.
