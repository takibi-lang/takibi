// GitHub issue #237 (QEMU port): see kernel/net/socket_capability.tkb's
// own header comment for why this no longer `use`s kernel/drivers/net/
// rp1_gem.tkb directly.
use "kernel/net/wire.tkb";

// Current limitations (2026-08-13, issue #295): NOT SYNCHRONIZED,
// single-core only. No ARP cache/table -- every reply is generated
// synchronously against the single request just parsed, not stored for
// later reuse. Only the kernel's own fixed OUR_MAC/OUR_IP
// (kernel/net/netconfig.tkb) is ever a valid target address; there is no
// support for a second local address or VLAN/subinterface.
//
// GitHub issue #186: ArpHdr's multi-byte NUMERIC fields (htype/ptype/oper)
// are typed `u16be` via the `packed be` sugar, so field access through a
// *ArpHdr pointer performs the required byte-swap directly -- no more
// arp_read_u16be/arp_write_u16be calls for those fields. sha/spa/tha/tpa
// stay `[u8; N]` (MAC/IP addresses, compared/copied byte-wise, never
// treated as a swapped numeric value) and are still reached via
// offsetof-derived slicing, same as before.
struct packed be ArpHdr {
    htype: u16;
    ptype: u16;
    hlen: u8;
    plen: u8;
    oper: u16;
    sha: [u8; 6];
    spa: [u8; 4];
    tha: [u8; 6];
    tpa: [u8; 4];
}

let ARP_SHA: usize = offsetof(ArpHdr, sha);
let ARP_SPA: usize = offsetof(ArpHdr, spa);
let ARP_THA: usize = offsetof(ArpHdr, tha);
let ARP_TPA: usize = offsetof(ArpHdr, tpa);

must_use variant KernelArpResult {
    TimedOut(NetRxCanAcquire);
    Replied(NetRxCanAcquire);
}

// Validate and rewrite one ARP request in place. The caller retains the RX
// frame owner and chooses whether to transmit or release it, allowing TCP
// listen loops to service neighbor discovery without a separate wait phase.
fn arp_prepare_reply(frame: borrow [u8; 42..]) -> bool {
    let eth: *EthHdr = frame as *EthHdr;
    if (eth.ethertype == ETHERTYPE_ARP) {
        let arp = frame[14..<42];
        let hdr: *ArpHdr = arp as *ArpHdr;
        if (hdr.htype == 1 && hdr.ptype == ETHERTYPE_IPV4 &&
            hdr.hlen == 6 && hdr.plen == 4 &&
            hdr.oper == 1 &&
            slice_eq(arp[ARP_TPA..<28], OUR_IP as []u8)) {
            slice_copy(frame[0..<6], frame[6..<12]);
            slice_copy(frame[6..<12], OUR_MAC as []u8);
            slice_copy(arp[ARP_THA..<ARP_TPA], arp[ARP_SHA..<ARP_SPA]);
            slice_copy(arp[ARP_TPA..<28], arp[ARP_SPA..<ARP_THA]);
            slice_copy(arp[ARP_SHA..<ARP_SPA], OUR_MAC as []u8);
            slice_copy(arp[ARP_SPA..<ARP_THA], OUR_IP as []u8);
            hdr.oper = 2;
            return true;
        }
    }
    return false;
}

// Own the RX readiness capability until one valid request is replied to.
// The bounded wait keeps a missing host-side integration peer from hanging
// the remainder of the one-boot kernel test indefinitely.
fn kernel_arp_reply_once(ready_in: sink NetRxCanAcquire)
        -> KernelArpResult !{may_block} {
    let mut ready = ready_in;
    let start: i64 = read_cntpct();
    let deadline_ticks: i64 = read_cntfrq() * 15;
    while ((read_cntpct() - start) < deadline_ticks) {
        net_rx_wait();
        match net_rx_acquire(ready) {
            NetRxAcquire::None(next) => { ready = next; }
            NetRxAcquire::Acquired(acquired) => {
                let len: i32 = net_rx_len(acquired);
                let mut reply: bool = false;
                if (len >= 42) {
                    let frame = net_rx_frame(acquired);
                    reply = arp_prepare_reply(frame);
                }
                if (reply) {
                    let completed = net_rx_send_reply(
                        net_rx_reply_ready(acquired, len));
                    return KernelArpResult::Replied(completed);
                }
                ready = net_rx_release(acquired);
            }
        }
    }
    return KernelArpResult::TimedOut(ready);
}
