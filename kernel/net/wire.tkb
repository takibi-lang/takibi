// Single source of truth for the IPv4/TCP wire layout: offsetof(...)
// is verified against each struct's actual (packed) layout instead of
// being a hand-maintained literal. Fields stay `[u8; N]` rather than
// native u16/u32 -- these are big-endian on the wire and this target
// is little-endian, so a native multi-byte load would silently
// byte-reverse the value (see read_u16be/write_u16be below, which is
// why those still exist instead of direct field access). Shared with
// kernel/net/icmp.tkb, which `use`s this file for Ipv4Hdr rather than
// declaring its own copy -- see that file's IPV4_* consts.
struct packed Ipv4Hdr {
    version_ihl: u8;
    dscp_ecn: u8;
    total_len: [u8; 2];
    ident: [u8; 2];
    flags_frag: [u8; 2];
    ttl: u8;
    protocol: u8;
    checksum: [u8; 2];
    src: [u8; 4];
    dst: [u8; 4];
}

struct packed TcpHdr {
    src_port: [u8; 2];
    dst_port: [u8; 2];
    seq: [u8; 4];
    ack: [u8; 4];
    data_offset: u8;
    flags: u8;
    window: [u8; 2];
    checksum: [u8; 2];
    urgent: [u8; 2];
}

let IP_TOTAL_LEN: usize = offsetof(Ipv4Hdr, total_len);
let IP_TTL:       usize = offsetof(Ipv4Hdr, ttl);
let IP_PROTOCOL:  usize = offsetof(Ipv4Hdr, protocol);
let IP_CHECKSUM:  usize = offsetof(Ipv4Hdr, checksum);
let IP_SRC:       usize = offsetof(Ipv4Hdr, src);
let IP_DST:       usize = offsetof(Ipv4Hdr, dst);

let TCP_SRC_PORT:    usize = offsetof(TcpHdr, src_port);
let TCP_DST_PORT:    usize = offsetof(TcpHdr, dst_port);
let TCP_SEQ:         usize = offsetof(TcpHdr, seq);
let TCP_ACK:         usize = offsetof(TcpHdr, ack);
let TCP_DATA_OFFSET: usize = offsetof(TcpHdr, data_offset);
let TCP_FLAGS:       usize = offsetof(TcpHdr, flags);
let TCP_WINDOW:      usize = offsetof(TcpHdr, window);
let TCP_CHECKSUM:    usize = offsetof(TcpHdr, checksum);
let TCP_URGENT:      usize = offsetof(TcpHdr, urgent);

const TCP_FLAG_FIN: u8 = 0x01;
const TCP_FLAG_SYN: u8 = 0x02;
const TCP_FLAG_RST: u8 = 0x04;
const TCP_FLAG_PSH: u8 = 0x08;
const TCP_FLAG_ACK: u8 = 0x10;
const PROTO_TCP: u8 = 6;
const TCP_INITIAL_SEQ: u32 = 0x00001000;

fn read_u16be(bytes: borrow [u8; 2..]) -> i32 {
    return ((bytes[0] as i32) << 8) | (bytes[1] as i32);
}

fn write_u16be(bytes: borrow [u8; 2..], value: i32) {
    bytes[0] = (value >> 8) as u8;
    bytes[1] = value as u8;
}

fn read_u32be(bytes: borrow [u8; 4..]) -> i32 {
    return ((bytes[0] as i32) << 24) | ((bytes[1] as i32) << 16) |
           ((bytes[2] as i32) << 8) | (bytes[3] as i32);
}

fn write_u32be(bytes: borrow [u8; 4..], value: i32) {
    bytes[0] = (value >> 24) as u8;
    bytes[1] = (value >> 16) as u8;
    bytes[2] = (value >> 8) as u8;
    bytes[3] = value as u8;
}
