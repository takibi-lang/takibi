// Single source of truth for the Ethernet/IPv4/TCP wire layout.
//
// Current limitations (2026-08-13, issue #295): none of substance -- this
// file only defines wire-format structs and byte-offset constants, with
// no shared mutable state and nothing to synchronize.
//
// GitHub issue #186 (CLOSED): EthHdr/Ipv4Hdr/TcpHdr's multi-byte NUMERIC
// fields are typed `u16be`/`u32be` via the `packed be` sugar, so accessing
// them through a *EthHdr/*Ipv4Hdr/*TcpHdr pointer performs the required
// byte-swap directly -- kernel/net/arp.tkb, icmp.tkb, and tcp.tkb all use
// this now. MAC/IP address fields (dst/src on EthHdr and Ipv4Hdr) stay
// `[u8; N]`: they are compared/copied byte-wise, never treated as a
// swapped numeric value, so a `u16be`/`u32be` type adds nothing for them
// (the `packed be` sugar already leaves array-typed fields untouched).
//
// offsetof(...) constants and read_u16be/write_u16be/read_u32be/
// write_u32be below remain in use for two things that stay pure
// byte-offset/byte-slice operations even after the tcp.tkb migration:
// tcp.tkb's IPv4-pseudo-header checksum scratch buffer (`pseudo:
// [u8;12]`, never a real wire struct, so there is no field to type) and
// arp.tkb/icmp.tkb's leftover IP-address-field offsets. Neither read nor
// write_u16be/u32be ever names a field's type, so both are unaffected by
// struct field type changes: offsetof computes an identical byte offset
// whether a field is `[u8; 2]` or `u16be` (same size).
struct packed be EthHdr {
    dst: [u8; 6];
    src: [u8; 6];
    ethertype: u16;
}

struct packed be Ipv4Hdr {
    version_ihl: u8;
    dscp_ecn: u8;
    total_len: u16;
    ident: u16;
    flags_frag: u16;
    ttl: u8;
    protocol: u8;
    checksum: u16;
    src: [u8; 4];
    dst: [u8; 4];
}

struct packed be TcpHdr {
    src_port: u16;
    dst_port: u16;
    seq: u32;
    ack: u32;
    data_offset: u8;
    flags: u8;
    window: u16;
    checksum: u16;
    urgent: u16;
}

const ETHERTYPE_ARP:  u16be = 0x0806;
const ETHERTYPE_IPV4: u16be = 0x0800;

let IP_TOTAL_LEN: usize = offsetof(Ipv4Hdr, total_len);
let IP_TTL:       usize = offsetof(Ipv4Hdr, ttl);
let IP_PROTOCOL:  usize = offsetof(Ipv4Hdr, protocol);
let IP_CHECKSUM:  usize = offsetof(Ipv4Hdr, checksum);
let IP_SRC:       usize = offsetof(Ipv4Hdr, src);
let IP_DST:       usize = offsetof(Ipv4Hdr, dst);

let TCP_SRC_PORT:    usize = offsetof(TcpHdr, src_port);
let TCP_DST_PORT:    usize = offsetof(TcpHdr, dst_port);
let TCP_SEQ:         usize = offsetof(TcpHdr, seq);
let TCP_ACK:         usize = offsetof(TcpHdr, ack);
let TCP_DATA_OFFSET: usize = offsetof(TcpHdr, data_offset);
let TCP_FLAGS:       usize = offsetof(TcpHdr, flags);
let TCP_WINDOW:      usize = offsetof(TcpHdr, window);
let TCP_CHECKSUM:    usize = offsetof(TcpHdr, checksum);
let TCP_URGENT:      usize = offsetof(TcpHdr, urgent);

const TCP_FLAG_FIN: u8 = 0x01;
const TCP_FLAG_SYN: u8 = 0x02;
const TCP_FLAG_RST: u8 = 0x04;
const TCP_FLAG_PSH: u8 = 0x08;
const TCP_FLAG_ACK: u8 = 0x10;
const PROTO_TCP: u8 = 6;
const TCP_INITIAL_SEQ: u32 = 0x00001000;

fn read_u16be(bytes: borrow [u8; 2..]) -> i32 {
    return ((bytes[0] as i32) << 8) | (bytes[1] as i32);
}

fn write_u16be(bytes: borrow [u8; 2..], value: i32) {
    bytes[0] = (value >> 8) as u8;
    bytes[1] = value as u8;
}

fn read_u32be(bytes: borrow [u8; 4..]) -> i32 {
    return ((bytes[0] as i32) << 24) | ((bytes[1] as i32) << 16) |
           ((bytes[2] as i32) << 8) | (bytes[3] as i32);
}

fn write_u32be(bytes: borrow [u8; 4..], value: i32) {
    bytes[0] = (value >> 24) as u8;
    bytes[1] = (value >> 16) as u8;
    bytes[2] = (value >> 8) as u8;
    bytes[3] = value as u8;
}
