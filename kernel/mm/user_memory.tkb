use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";

// One L1 slot of user VA: address_space.tkb lazily allocates an L3 table for
// each populated L2 branch. The literal stays here because top-level const
// initializers cannot multiply another file's identifier.
const USER_RANGE_WINDOW: usize = 0x40000000;

// Isolates AP/UXN/PXN/AF/nG attribute bits from the physical address in a
// live PTE.

// GitHub issue #258: there is no longer a hardcoded L3 index for the
// boot-time probes' own throwaway pages. `USER_PROBE_L3_INDEX = 500`
// (this file) and `SYSCALL_SUBSET_PROBE_L3_INDEX = 503`
// (kernel/kernel/syscall.tkb) used to pick fixed pages and then each
// separately guard against having picked an occupied one -- with the
// deconfliction between them done BY HAND, recorded only in a prose
// comment in syscall.tkb ("outside issue #174's own probe's L3 indices
// 500-502"). Both indices sat inside process_image.tkb's own
// stack-growth region (pages 448..510) inside the old first L3 branch
// (mmu.tkb: `user_pte_*` is always root 0, and process images run on
// root 0 too), so nothing but that hand-maintained comment kept them
// apart.
//
// user_va_find_free_run below replaces both: the live page table is
// already the authoritative record of which virtual pages are taken, so
// a run of free pages is found by reading it rather than by picking a
// constant and hoping -- the same "derive it from the real structure
// instead of keeping a second, hand-maintained one" move issue #253
// made for kernel/mm/process_image.tkb's per-root page lists. This
// needs no new bookkeeping table and no new compile-time ceiling.
must_use variant UserVaRunResult { None; Found(usize); }

// Lowest run of `count` consecutive unmapped pages in the user window, or
// None. This runs only from boot probes, never on a hot path.
fn user_va_find_free_run(count: usize) -> UserVaRunResult {
    if (count == 0 || count > USER_SPACE_PAGE_COUNT) {
        return UserVaRunResult::None;
    }
    let mut first: usize = 0;
    while (first + count <= USER_SPACE_PAGE_COUNT) {
        let mut free_run: bool = true;
        let mut offset: usize = 0;
        while (offset < count) {
            if (user_pte_read(first + offset) != 0) {
                // Restart past the occupant, not at first + 1: every start
                // in between would re-scan the same occupied page.
                first = first + offset + 1;
                free_run = false;
                break;
            }
            offset = offset + 1;
        }
        if (free_run) { return UserVaRunResult::Found(first); }
    }
    return UserVaRunResult::None;
}

enum UserAccessMode: u8 { Read; Write; }

// GitHub issue #199: two mode-distinct types instead of one UserRange
// carrying a runtime-only mode. Before this split, nothing stopped a
// UserRange checked with UserAccessMode::Read from being passed to
// copy_to_user (a write), or vice versa -- the wrong-direction call still
// faulted safely (at the hardware/page-table level, via this kernel's
// EL0 fail-stop path), but only by accident of the underlying page
// permissions, not because the type system caught the mistake. Each
// struct's private fields mean only this file's own constructors
// (user_range_check_read/user_range_check_write) can produce one, same
// discipline as the original single UserRange -- a syscall body still
// cannot manufacture a *u8 out of a raw integer without going through
// validation first, and now cannot use a read-validated range as if it
// were write-validated either.
struct UserReadRange {
    private root: AddressSpaceRoot;
    private address: usize;
    private length: usize;
}

struct UserWriteRange {
    private root: AddressSpaceRoot;
    private address: usize;
    private length: usize;
}

must_use variant UserReadRangeResult { Fault; Ok(UserReadRange); }
must_use variant UserWriteRangeResult { Fault; Ok(UserWriteRange); }

fn user_page_writable(pte: usize) -> bool {
    return address_space_pte_is_writable(pte);
}

fn user_page_readable(pte: usize) -> bool {
    if (pte == 0) { return false; }
    let masked: usize = pte & USER_PTE_PERMISSION_MASK;
    return masked == USER_RW_XN_FLAGS || masked == USER_TEXT_RX_FLAGS ||
           masked == USER_RODATA_R_FLAGS;
}

fn user_page_allows(pte: usize, mode: UserAccessMode) -> bool {
    if (mode == UserAccessMode::Write) { return user_page_writable(pte); }
    return user_page_readable(pte);
}

// 0 = not present, 1 = text (RX), 2 = rodata (R), 3 = data/heap/stack (RW+XN).
// `root` is the address-space slot to check against -- GitHub issue #263:
// this used to always read root 0 via user_pte_read regardless of which
// process's buffer was actually being validated.
fn user_page_class_at(root: AddressSpaceRoot, index: usize) -> usize {
    let pte: usize = address_space_pte_read(address_space_root_slot(root), index);
    if (pte == 0) { return 0; }
    let masked: usize = pte & USER_PTE_PERMISSION_MASK;
    if (masked == USER_TEXT_RX_FLAGS) { return 1; }
    if (masked == USER_RODATA_R_FLAGS) { return 2; }
    if (masked == USER_RW_XN_FLAGS) { return 3; }
    return 0;
}

fn user_range_l3_span(address: usize, length: usize) -> (bool, usize, usize) {
    if (address < USER_TEXT_VA || address >= USER_TEXT_VA + USER_RANGE_WINDOW ||
        length == 0 || length > USER_RANGE_WINDOW ||
        address - USER_TEXT_VA > USER_RANGE_WINDOW - length) {
        return (false, 0, 0);
    }
    let first: usize = (address - USER_TEXT_VA) / PAGE_SIZE;
    let last: usize = (address - USER_TEXT_VA + length - 1) / PAGE_SIZE;
    return (true, first, last);
}

// GitHub issue #199: shared span-validation logic, factored out of the
// old single user_range_check so user_range_check_read/_write below stay
// thin type-specific wrappers rather than duplicating this walk. Not
// itself part of the public API -- neither UserReadRange nor
// UserWriteRange can be constructed from this, only from the two typed
// constructors below.
fn user_range_span_ok(root: AddressSpaceRoot, address: usize, length: usize,
                      mode: UserAccessMode) -> bool {
    if (length == 0) { return true; }
    let (span_ok, first, last) = user_range_l3_span(address, length);
    if (span_ok == false) { return false; }
    let mut index: usize = first;
    while (index <= last) {
        let pte: usize = address_space_pte_read(address_space_root_slot(root), index);
        if (index >= USER_SPACE_PAGE_COUNT ||
            (user_page_allows(pte, mode) == false &&
             (mode != UserAccessMode::Write ||
              address_space_pte_is_cow(pte) == false))) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

// `root` is the address-space slot the buffer actually belongs to (the
// caller's currently-active root, normally `kernel_process_current_root()`
// -- GitHub issue #263: this used to always validate against root 0's page
// table regardless of which process issued the syscall).
fn user_range_check_read(root: AddressSpaceRoot, address: usize, length: usize)
        -> UserReadRangeResult {
    if (user_range_span_ok(root, address, length, UserAccessMode::Read) == false) {
        return UserReadRangeResult::Fault;
    }
    let mut range: UserReadRange = { root, address, length };
    return UserReadRangeResult::Ok(range);
}

fn user_range_check_write(root: AddressSpaceRoot, address: usize, length: usize)
        -> UserWriteRangeResult {
    if (user_range_span_ok(root, address, length, UserAccessMode::Write) == false) {
        return UserWriteRangeResult::Fault;
    }
    let mut range: UserWriteRange = { root, address, length };
    return UserWriteRangeResult::Ok(range);
}

fn user_read_range_length(range: UserReadRange) -> usize { return range.length; }
fn user_write_range_length(range: UserWriteRange) -> usize { return range.length; }

// GitHub issue #199 follow-up: a write-validated range's underlying page
// is always also readable on this architecture -- a writable user
// mapping's AP bits already imply read access (USER_RW_XN_FLAGS is the
// one class both user_page_writable and user_page_readable accept), and
// the other path user_range_check_write's permission check accepts (a
// not-yet-resolved COW page) is read-only until the write that triggers
// its copy, so it is trivially readable too. Downgrading costs nothing
// and re-validates nothing. Kept as an explicit, named conversion (not
// an implicit coercion) so a call site reading through a write-validated
// range -- e.g. ppoll's pollfd array, read for fd/events and written for
// revents in the same syscall -- says so visibly, rather than the type
// system silently accepting either range kind anywhere a read is
// needed: issue #199's whole point was making a mismatched DIRECTION a
// compile error, not making the read/write distinction disappear again.
fn user_write_range_as_read(range: UserWriteRange) -> UserReadRange {
    let mut read_range: UserReadRange = { range.root, range.address, range.length };
    return read_range;
}

// Only ever needed by the write side: a read never modifies a COW page,
// so only user_write_*/copy_to_user*/user_zero_fill call this.
fn user_range_resolve_cow(range: UserWriteRange) -> bool !{unsafe} {
    if (range.length == 0) { return true; }
    let (span_ok, first, last) =
        user_range_l3_span(range.address, range.length);
    if (span_ok == false) { return false; }
    let mut index: usize = first;
    while (index <= last) {
        let pte: usize = address_space_pte_read(
            address_space_root_slot(range.root), index);
        if (address_space_pte_is_cow(pte) &&
            address_space_resolve_cow(
                address_space_root_slot(range.root), index) == false) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn copy_from_user(range: UserReadRange, destination: []u8) -> bool !{unsafe} {
    if (destination.len > range.length) { return false; }
    let source_base: *u8 = unsafe { range.address as *u8 };
    let source_view = unsafe { source_base[0..<range.length as isize] };
    let copied: usize = slice_copy(destination, source_view);
    return copied == destination.len;
}

fn copy_to_user(range: UserWriteRange, source: []u8) -> bool !{unsafe} {
    if (source.len > range.length) { return false; }
    if (user_range_resolve_cow(range) == false) { return false; }
    let destination_base: *u8 = unsafe { range.address as *u8 };
    let destination_view =
        unsafe { destination_base[0..<range.length as isize] };
    let copied: usize = slice_copy(destination_view, source);
    return copied == source.len;
}

// Raw-pointer-count variants of copy_from_user/copy_to_user for kernel-side
// destinations/sources whose own offset isn't a compile-time-provable slice
// bound (e.g. a per-connection cursor into a shared buffer) -- the pattern
// this codebase already uses raw pointer arithmetic for on the kernel side.
// The user-facing half is still only ever reached through UserReadRange/UserWriteRange.
fn copy_from_user_raw(range: UserReadRange, destination: *u8, length: usize)
        -> bool !{unsafe} {
    if (length > range.length) { return false; }
    let source_base: *u8 = unsafe { range.address as *u8 };
    let mut index: usize = 0;
    while (index < length) {
        let source_byte: *u8 = source_base + (index as isize);
        let destination_byte: *u8 = destination + (index as isize);
        *destination_byte = *source_byte;
        index = index + 1;
    }
    return true;
}

fn copy_to_user_raw(range: UserWriteRange, source: *u8, length: usize)
        -> bool !{unsafe} {
    if (length > range.length) { return false; }
    if (user_range_resolve_cow(range) == false) { return false; }
    let destination_base: *u8 = unsafe { range.address as *u8 };
    let mut index: usize = 0;
    while (index < length) {
        let source_byte: *u8 = source + (index as isize);
        let destination_byte: *u8 = destination_base + (index as isize);
        *destination_byte = *source_byte;
        index = index + 1;
    }
    return true;
}

fn user_read_byte(range: UserReadRange, offset: usize) -> u8 !{unsafe} {
    let source_byte: *u8 = unsafe { (range.address + offset) as *u8 };
    return *source_byte;
}

fn user_write_byte(range: UserWriteRange, offset: usize, value: u8) -> bool !{unsafe} {
    if (offset >= range.length) { return false; }
    if (user_range_resolve_cow(range) == false) { return false; }
    let field: *u8 = unsafe { (range.address + offset) as *u8 };
    *field = value;
    return true;
}

fn user_write_u32(range: UserWriteRange, offset: usize, value: u32)
        -> bool !{unsafe} {
    if (offset + 4 > range.length || offset + 4 < offset) { return false; }
    if (user_range_resolve_cow(range) == false) { return false; }
    let field: *u32 = unsafe { (range.address + offset) as *u32 };
    *field = value;
    return true;
}

fn user_write_u64(range: UserWriteRange, offset: usize, value: u64)
        -> bool !{unsafe} {
    if (offset + 8 > range.length || offset + 8 < offset) { return false; }
    if (user_range_resolve_cow(range) == false) { return false; }
    let field: *u64 = unsafe { (range.address + offset) as *u64 };
    *field = value;
    return true;
}

// Issue #196: read counterparts of user_write_u32/user_write_u64, needed
// to parse user-supplied iovec/pollfd array elements (iov_base/iov_len,
// fd) without ever dereferencing a raw user pointer directly. Bounds
// checked the same way as the write side; the bool result distinguishes
// "out of range" from a genuine value of 0.
fn user_read_u32(range: UserReadRange, offset: usize) -> (bool, u32) !{unsafe} {
    if (offset + 4 > range.length || offset + 4 < offset) { return (false, 0); }
    let field: *u32 = unsafe { (range.address + offset) as *u32 };
    return (true, *field);
}

fn user_read_u64(range: UserReadRange, offset: usize) -> (bool, u64) !{unsafe} {
    if (offset + 8 > range.length || offset + 8 < offset) { return (false, 0); }
    let field: *u64 = unsafe { (range.address + offset) as *u64 };
    return (true, *field);
}

// A 2-byte write, little-endian, via two already-proven-safe byte writes
// rather than a new *u16 helper -- ppoll's pollfd.revents field is the
// only current caller and only ever needs small (<256) bit-flag values,
// so this avoids introducing a signed/u16 read-write pair for one use.
fn user_write_u16(range: UserWriteRange, offset: usize, value: usize)
        -> bool !{unsafe} {
    if (offset + 2 > range.length || offset + 2 < offset) { return false; }
    let low: bool = user_write_byte(range, offset, (value & 0xFF) as u8);
    let high: bool = user_write_byte(range, offset + 1, ((value >> 8) & 0xFF) as u8);
    return low && high;
}

fn user_zero_fill(range: UserWriteRange) -> bool !{unsafe} {
    if (user_range_resolve_cow(range) == false) { return false; }
    let base: *u8 = unsafe { range.address as *u8 };
    let mut index: usize = 0;
    while (index < range.length) {
        let byte: *u8 = base + (index as isize);
        *byte = 0;
        index = index + 1;
    }
    return true;
}

// Rewrites [first_l3, last_l3] in place, preserving each page's physical
// frame and replacing only the attribute bits. Used by mprotect and rodata
// segment mapping alike. `root` per user_range_check's own note above
// (GitHub issue #263).
fn user_range_reprotect(root: AddressSpaceRoot, first_l3: usize, last_l3: usize,
                        new_flags: usize) {
    let mut index: usize = first_l3;
    while (index <= last_l3) {
        let root_slot: usize = address_space_root_slot(root);
        let old_pte: usize = address_space_pte_read(root_slot, index);
        let phys: usize = old_pte & USER_PAGE_PHYS_MASK;
        match address_space_pte_write(root_slot, index, phys | new_flags) {
            AddressSpacePteWriteResult::Invalid => { return; }
            AddressSpacePteWriteResult::OutOfMemory => { return; }
            AddressSpacePteWriteResult::Written => {
                address_space_tlb_invalidate(
                    root_slot, USER_TEXT_VA + index * PAGE_SIZE);
            }
        }
        index = index + 1;
    }
}

// Boot-time negative-test coverage for issue #174: overflow, cross-page,
// wrong-permission-write, and mprotect-style downgrade/upgrade. Claims a
// run of three consecutive free pages (GitHub issue #258 --
// user_va_find_free_run above, no longer a hardcoded index): the first
// and third hold its two throwaway pages, the middle one is deliberately
// left unmapped for the cross-page case. Independent of whatever process
// is or isn't loaded elsewhere in the boot sequence, and now genuinely so
// rather than by hand-picked constant. Both pages are freed before
// returning.
fn user_memory_boundary_probe() -> bool {
    let base: usize = match user_va_find_free_run(3) {
        UserVaRunResult::None => { return false; }
        UserVaRunResult::Found(index) => { index }
    };
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(data_page) => {
            match page_alloc(PageOwnerTag::UserPage) {
                PageAllocResult::OutOfMemory => {
                    page_free(data_page);
                    return false;
                }
                PageAllocResult::Allocated(text_page) => {
                    let ok: bool = user_memory_boundary_probe_run(
                        base, data_page, text_page);
                    return ok;
                }
            }
        }
    }
}

fn user_memory_boundary_probe_run(base: usize,
                                  data_page: sink PageOwner[data],
                                  text_page: sink PageOwner[text]) -> bool {
    let mut root: AddressSpaceRoot = address_space_boot_root();
    match address_space_map_page(0, base, data_page, USER_RW_XN_FLAGS) {
        AddressSpacePteWriteResult::Invalid => {
            page_free(text_page);
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            page_free(text_page);
            return false;
        }
        AddressSpacePteWriteResult::Written => {}
    }
    match address_space_map_page(0, base + 2, text_page, USER_TEXT_RX_FLAGS) {
        AddressSpacePteWriteResult::Invalid => {
            user_pte_clear(base);
            user_tlb_invalidate(USER_TEXT_VA + base * PAGE_SIZE);
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            user_pte_clear(base);
            user_tlb_invalidate(USER_TEXT_VA + base * PAGE_SIZE);
            return false;
        }
        AddressSpacePteWriteResult::Written => {}
    }
    let data_va: usize = USER_TEXT_VA + base * PAGE_SIZE;
    let text_va: usize = USER_TEXT_VA + (base + 2) * PAGE_SIZE;

    let mut ok: bool = true;

    // This probe runs at boot, before any process is scheduled, and always
    // maps its two throwaway pages into root 0 via user_pte_write above --
    // so every check below is explicitly against root 0, not derived from
    // kernel_process_current_root() (unlike the real syscall call sites in
    // kernel/kernel/syscall.tkb, GitHub issue #263).

    // Overflow: address near usize::MAX with a nonzero length must never
    // wrap around into an apparently-valid range.
    match user_range_check_read(root, 0xFFFFFFFFFFFFFFF0, 32) {
        UserReadRangeResult::Fault => {}
        UserReadRangeResult::Ok(bad) => { ok = false; }
    }

    // Cross-page: a range spanning the mapped data page and the deliberately
    // unmapped page right after it must fault as a whole.
    match user_range_check_read(root, data_va, PAGE_SIZE + 1) {
        UserReadRangeResult::Fault => {}
        UserReadRangeResult::Ok(bad) => { ok = false; }
    }

    // Wrong permission: Text-RX must reject Write while still allowing Read.
    match user_range_check_read(root, text_va, 8) {
        UserReadRangeResult::Fault => { ok = false; }
        UserReadRangeResult::Ok(readable) => {}
    }
    match user_range_check_write(root, text_va, 8) {
        UserWriteRangeResult::Fault => {}
        UserWriteRangeResult::Ok(bad) => { ok = false; }
    }

    // mprotect-style downgrade/upgrade on the data page.
    match user_range_check_write(root, data_va, 8) {
        UserWriteRangeResult::Fault => { ok = false; }
        UserWriteRangeResult::Ok(writable) => {}
    }
    user_range_reprotect(root, base, base,
                         USER_RODATA_R_FLAGS);
    match user_range_check_write(root, data_va, 8) {
        UserWriteRangeResult::Fault => {}
        UserWriteRangeResult::Ok(bad) => { ok = false; }
    }
    match user_range_check_read(root, data_va, 8) {
        UserReadRangeResult::Fault => { ok = false; }
        UserReadRangeResult::Ok(still_readable) => {}
    }
    user_range_reprotect(root, base, base,
                         USER_RW_XN_FLAGS);
    match user_range_check_write(root, data_va, 8) {
        UserWriteRangeResult::Fault => { ok = false; }
        UserWriteRangeResult::Ok(writable_again) => {}
    }

    user_pte_clear(base);
    user_tlb_invalidate(data_va);
    user_pte_clear(base + 2);
    user_tlb_invalidate(text_va);
    return ok;
}

// Regression coverage for GitHub issue #263: user_range_check/
// user_page_class_at used to always validate against root/slot 0's page
// table regardless of which root value was actually meant, since neither
// took a root parameter at all. Uses two temporary production address-space
// records, mapped with DIFFERENT permissions at the SAME L3 index, and root
// 0 deliberately left unmapped at that same index throughout (root 0 is not
// itself under test here, only used as the "wrong answer" a regression to
// the old always-root-0 behavior would produce). If
// user_range_check/user_page_class_at ever again ignore the root they are
// given, both checks below observe root 0's empty PTE instead of their
// own root's real mapping and fail identically, regardless of the two
// roots' genuinely different content.
fn user_memory_root_isolation_probe() -> bool !{unsafe} {
    let index: usize = match user_va_find_free_run(1) {
        UserVaRunResult::None => { return false; }
        UserVaRunResult::Found(found) => { found }
    };
    // GitHub issue #392: two roots of this probe's own. They used to be
    // the bare slots 14 and 15 -- the top of a table that no longer has a
    // top. A root is a live process's record now, so the probe allocates
    // two processes and uses theirs.
    let root_a: usize = scheduled_process_probe_slot_acquire();
    let root_b: usize = scheduled_process_probe_slot_acquire();
    if (root_a == 0 || root_b == 0 ||
        address_space_is_live(root_a) || address_space_is_live(root_b)) {
        scheduled_process_probe_slot_release(root_b);
        scheduled_process_probe_slot_release(root_a);
        return false;
    }
    let mut roots_ok: bool = true;
    match address_space_ensure_root(root_a) {
        AddressSpaceEnsureResult::Ok => {}
        AddressSpaceEnsureResult::SlotOutOfRange => { roots_ok = false; }
        AddressSpaceEnsureResult::OutOfMemory => { roots_ok = false; }
    }
    if (roots_ok) {
        match address_space_ensure_root(root_b) {
            AddressSpaceEnsureResult::Ok => {}
            AddressSpaceEnsureResult::SlotOutOfRange => { roots_ok = false; }
            AddressSpaceEnsureResult::OutOfMemory => { roots_ok = false; }
        }
    }
    if (roots_ok == false) {
        address_space_release_root(root_b);
        address_space_release_root(root_a);
        scheduled_process_probe_slot_release(root_b);
        scheduled_process_probe_slot_release(root_a);
        return false;
    }
    let va: usize = USER_TEXT_VA + index * PAGE_SIZE;
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            address_space_release_root(root_b);
            address_space_release_root(root_a);
            scheduled_process_probe_slot_release(root_b);
            scheduled_process_probe_slot_release(root_a);
            return false;
        }
        PageAllocResult::Allocated(page_a) => {
            match page_alloc(PageOwnerTag::UserPage) {
                PageAllocResult::OutOfMemory => {
                    page_free(page_a);
                    address_space_release_root(root_b);
                    address_space_release_root(root_a);
                    scheduled_process_probe_slot_release(root_b);
                    scheduled_process_probe_slot_release(root_a);
                    return false;
                }
                PageAllocResult::Allocated(page_b) => {
                    let ok: bool = user_memory_root_isolation_probe_run(
                        root_a, root_b, index, va, page_a, page_b);
                    address_space_release_root(root_b);
                    address_space_release_root(root_a);
                    scheduled_process_probe_slot_release(root_b);
                    scheduled_process_probe_slot_release(root_a);
                    return ok;
                }
            }
        }
    }
}

fn user_memory_root_isolation_probe_run(root_a: usize, root_b: usize,
                                        index: usize, va: usize,
                                        page_a: sink PageOwner[a],
                                        page_b: sink PageOwner[b]) -> bool {
    let mut checked_root_a: AddressSpaceRoot =
        address_space_root_for_slot(root_a);
    let mut checked_root_b: AddressSpaceRoot =
        address_space_root_for_slot(root_b);
    // root_a: writable (RW+XN). root_b: read-only (rodata-R). root 0: left
    // unmapped (0) at this same index the whole time.
    match address_space_map_page(root_a, index, page_a, USER_RW_XN_FLAGS) {
        AddressSpacePteWriteResult::Invalid => {
            page_free(page_b);
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            page_free(page_b);
            return false;
        }
        AddressSpacePteWriteResult::Written => {}
    }
    match address_space_map_page(root_b, index, page_b, USER_RODATA_R_FLAGS) {
        AddressSpacePteWriteResult::Invalid => {
            address_space_pte_clear(root_a, index);
            address_space_tlb_invalidate(root_a, va);
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            address_space_pte_clear(root_a, index);
            address_space_tlb_invalidate(root_a, va);
            return false;
        }
        AddressSpacePteWriteResult::Written => {}
    }

    let mut ok: bool = true;
    match user_range_check_write(checked_root_a, va, 8) {
        UserWriteRangeResult::Fault => { ok = false; }
        UserWriteRangeResult::Ok(writable) => {}
    }
    match user_range_check_write(checked_root_b, va, 8) {
        UserWriteRangeResult::Fault => {}
        UserWriteRangeResult::Ok(bad) => { ok = false; }
    }
    match user_range_check_read(checked_root_b, va, 8) {
        UserReadRangeResult::Fault => { ok = false; }
        UserReadRangeResult::Ok(readable) => {}
    }
    if (user_page_class_at(checked_root_a, index) != 3) { ok = false; }
    if (user_page_class_at(checked_root_b, index) != 2) { ok = false; }

    address_space_pte_clear(root_a, index);
    address_space_tlb_invalidate(root_a, va);
    address_space_pte_clear(root_b, index);
    address_space_tlb_invalidate(root_b, va);
    return ok;
}
