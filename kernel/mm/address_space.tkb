use "kernel/mm/page.tkb";
use "kernel/arch/arm64/mm/mmu_extern.tkb";

const USER_TEXT_VA: usize = 0x40000000;
const USER_DATA_VA: usize = 0x40001000;
const USER_STACK_VA: usize = 0x40002000;

// nG is required once ASIDs distinguish the two roots: a global translation
// would ignore the ASID and defeat same-VA isolation.
const USER_TEXT_RX_FLAGS: usize = 0x0020000000000FC7;
const USER_RW_XN_FLAGS: usize = 0x0060000000000F47;

const PROCESS_ADDRESS_SPACE_MAX: usize = 2;

linear struct ProcessAddressSpaceOwner[space: usize] {
    private slot: {0..<PROCESS_ADDRESS_SPACE_MAX as usize};
    private generation: usize @ space;
    private asid: usize;
}

linear struct ActiveProcessAddressSpace[space: usize] {
    private slot: {0..<PROCESS_ADDRESS_SPACE_MAX as usize};
    private generation: usize @ space;
}

private linear view AddressSpaceCpuOwner;

linear struct ProcessSpaceMappingOwner[space: usize, page: usize] {
    private space_generation: usize @ space;
    private page_index: {0..<BOOT_PAGE_COUNT as usize};
    private page_witness: usize @ page;
    private slot: {0..<PROCESS_ADDRESS_SPACE_MAX as usize};
}

must_use variant ProcessAddressSpaceAllocResult {
    Full;
    Allocated(exists space: usize. ProcessAddressSpaceOwner[space]);
}

private let mut process_address_space_used: [u8; PROCESS_ADDRESS_SPACE_MAX];
private let mut process_address_space_generation:
    [usize; PROCESS_ADDRESS_SPACE_MAX];
private let mut process_address_space_next_generation: usize = 1;

fn process_address_space_pool_init() {
    for slot: usize in 0..<PROCESS_ADDRESS_SPACE_MAX {
        process_address_space_used[slot] = 0;
        process_address_space_generation[slot] = 0;
        address_space_clear_root(slot);
    }
    address_space_activate_root(0);
}

fn process_address_space_owner_new(
        slot: {0..<PROCESS_ADDRESS_SPACE_MAX as usize},
        generation: usize @ space) -> ProcessAddressSpaceOwner[space] {
    let mut owner: ProcessAddressSpaceOwner[space] = {
        slot, generation, slot + 1
    };
    return owner;
}

fn process_address_space_alloc() -> ProcessAddressSpaceAllocResult {
    for slot: usize in 0..<PROCESS_ADDRESS_SPACE_MAX {
        if (process_address_space_used[slot] == 0) {
            let generation: usize = process_address_space_next_generation;
            process_address_space_next_generation = generation + 1;
            process_address_space_used[slot] = 1;
            process_address_space_generation[slot] = generation;
            address_space_clear_root(slot);
            return ProcessAddressSpaceAllocResult::Allocated(
                process_address_space_owner_new(slot, generation));
        }
    }
    return ProcessAddressSpaceAllocResult::Full;
}

fn process_address_space_map_rw(
        space: borrow ProcessAddressSpaceOwner[address_space],
        page: sink PageOwner[page])
        -> ProcessSpaceMappingOwner[address_space, page] {
    let physical: usize = page_physical_address(page);
    let (page_index, page_witness) = page_owner_into_parts(page);
    address_space_pte_write(space.slot, 0, physical | USER_RW_XN_FLAGS);
    address_space_tlb_invalidate(space.slot, USER_TEXT_VA);
    let mut mapping: ProcessSpaceMappingOwner[address_space, page] = {
        space.generation, page_index, page_witness, space.slot
    };
    return mapping;
}

fn process_address_space_unmap_rw(
        space: borrow ProcessAddressSpaceOwner[address_space],
        mapping: sink ProcessSpaceMappingOwner[address_space, page])
        -> PageOwner[page] {
    address_space_pte_write(space.slot, 0, 0);
    address_space_tlb_invalidate(space.slot, USER_TEXT_VA);
    return page_owner_from_parts(
        mapping.page_index, mapping.page_witness);
}

fn process_address_space_cpu_new() -> AddressSpaceCpuOwner {
    return view AddressSpaceCpuOwner;
}

fn process_address_space_activate(
        cpu: sink AddressSpaceCpuOwner,
        space: borrow ProcessAddressSpaceOwner[address_space])
        -> ActiveProcessAddressSpace[address_space] {
    address_space_activate_root(space.slot);
    let mut active: ActiveProcessAddressSpace[address_space] = {
        space.slot, space.generation
    };
    return active;
}

fn process_address_space_switch(
        active: sink ActiveProcessAddressSpace[old_space],
        next: borrow ProcessAddressSpaceOwner[next_space])
        -> ActiveProcessAddressSpace[next_space] {
    address_space_activate_root(next.slot);
    let mut switched: ActiveProcessAddressSpace[next_space] = {
        next.slot, next.generation
    };
    return switched;
}

fn process_address_space_release_cpu(
        active: sink ActiveProcessAddressSpace[address_space])
        -> AddressSpaceCpuOwner {
    address_space_activate_root(0);
    return view AddressSpaceCpuOwner;
}

fn process_address_space_cpu_drop(cpu: sink AddressSpaceCpuOwner) {}

fn process_address_space_write_probe(
        active: borrow ActiveProcessAddressSpace[address_space],
        space: borrow ProcessAddressSpaceOwner[address_space],
        mapping: borrow ProcessSpaceMappingOwner[address_space, page],
        value: u8) {
    let address: *u8 = USER_TEXT_VA as *u8;
    *address = value;
}

fn process_address_space_read_probe(
        active: borrow ActiveProcessAddressSpace[address_space],
        space: borrow ProcessAddressSpaceOwner[address_space],
        mapping: borrow ProcessSpaceMappingOwner[address_space, page]) -> u8 {
    let address: *u8 = USER_TEXT_VA as *u8;
    return *address;
}

fn process_address_space_free(
        space: sink ProcessAddressSpaceOwner[address_space]) {
    address_space_clear_root(space.slot);
    process_address_space_used[space.slot] = 0;
    process_address_space_generation[space.slot] = 0;
}

fn process_address_space_probe_pages(
        space0: ProcessAddressSpaceOwner[space0_id],
        space1: ProcessAddressSpaceOwner[space1_id],
        page0: PageOwner[page0_id], page1: PageOwner[page1_id]) -> bool {
    let mapping0 = process_address_space_map_rw(space0, page0);
    let mapping1 = process_address_space_map_rw(space1, page1);
    let cpu = process_address_space_cpu_new();
    let active0 = process_address_space_activate(cpu, space0);
    process_address_space_write_probe(active0, space0, mapping0, 11);
    let active1 = process_address_space_switch(active0, space1);
    process_address_space_write_probe(active1, space1, mapping1, 22);
    let second: u8 = process_address_space_read_probe(
        active1, space1, mapping1);
    let active0_back = process_address_space_switch(active1, space0);
    let first: u8 = process_address_space_read_probe(
        active0_back, space0, mapping0);
    let cpu_back = process_address_space_release_cpu(active0_back);
    process_address_space_cpu_drop(cpu_back);
    let page1_back = process_address_space_unmap_rw(space1, mapping1);
    let page0_back = process_address_space_unmap_rw(space0, mapping0);
    page_free(page1_back);
    page_free(page0_back);
    process_address_space_free(space1);
    process_address_space_free(space0);
    return first == 11 && second == 22;
}

fn process_address_space_probe() -> bool {
    process_address_space_pool_init();
    match process_address_space_alloc() {
        ProcessAddressSpaceAllocResult::Full => { return false; }
        ProcessAddressSpaceAllocResult::Allocated(space0) => {
            match process_address_space_alloc() {
                ProcessAddressSpaceAllocResult::Full => {
                    process_address_space_free(space0);
                    return false;
                }
                ProcessAddressSpaceAllocResult::Allocated(space1) => {
                    match page_alloc() {
                        PageAllocResult::OutOfMemory => {
                            process_address_space_free(space1);
                            process_address_space_free(space0);
                            return false;
                        }
                        PageAllocResult::Allocated(page0) => {
                            match page_alloc() {
                                PageAllocResult::OutOfMemory => {
                                    page_free(page0);
                                    process_address_space_free(space1);
                                    process_address_space_free(space0);
                                    return false;
                                }
                                PageAllocResult::Allocated(page1) => {
                                    return process_address_space_probe_pages(
                                        space0, space1, page0, page1);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

enum AddressSpaceState: u8 { Empty; Text; TextData; Ready; }
enum MappingRole: u8 { TextRx; DataRwXn; StackRwXn; }

linear struct AddressSpaceOwner[state: AddressSpaceState] {
    private asid: usize;
}

linear struct MappingOwner[page: usize, role: MappingRole] {
    private page_index: {0..<BOOT_PAGE_COUNT as usize};
    private page_witness: usize @ page;
    private va: usize;
}

fn address_space_new() -> AddressSpaceOwner[AddressSpaceState::Empty] {
    let mut space: AddressSpaceOwner[AddressSpaceState::Empty] = { 0 };
    return space;
}

fn map_user_text(space: sink AddressSpaceOwner[AddressSpaceState::Empty],
                 page: sink PageOwner[page])
        -> (AddressSpaceOwner[AddressSpaceState::Text],
            MappingOwner[page, MappingRole::TextRx]) {
    let phys: usize = page_physical_address(page);
    let (index, witness) = page_owner_into_parts(page);
    user_pte_write(0, phys | USER_TEXT_RX_FLAGS);
    user_tlb_invalidate(USER_TEXT_VA);
    let mut next: AddressSpaceOwner[AddressSpaceState::Text] = { space.asid };
    let mut mapping: MappingOwner[page, MappingRole::TextRx] =
        { index, witness, USER_TEXT_VA };
    return (next, mapping);
}

fn map_user_data(space: sink AddressSpaceOwner[AddressSpaceState::Text],
                 page: sink PageOwner[page])
        -> (AddressSpaceOwner[AddressSpaceState::TextData],
            MappingOwner[page, MappingRole::DataRwXn]) {
    let phys: usize = page_physical_address(page);
    let (index, witness) = page_owner_into_parts(page);
    user_pte_write(1, phys | USER_RW_XN_FLAGS);
    user_tlb_invalidate(USER_DATA_VA);
    let mut next: AddressSpaceOwner[AddressSpaceState::TextData] = { space.asid };
    let mut mapping: MappingOwner[page, MappingRole::DataRwXn] =
        { index, witness, USER_DATA_VA };
    return (next, mapping);
}

fn map_user_stack(space: sink AddressSpaceOwner[AddressSpaceState::TextData],
                  page: sink PageOwner[page])
        -> (AddressSpaceOwner[AddressSpaceState::Ready],
            MappingOwner[page, MappingRole::StackRwXn]) {
    let phys: usize = page_physical_address(page);
    let (index, witness) = page_owner_into_parts(page);
    user_pte_write(2, phys | USER_RW_XN_FLAGS);
    user_tlb_invalidate(USER_STACK_VA);
    let mut next: AddressSpaceOwner[AddressSpaceState::Ready] = { space.asid };
    let mut mapping: MappingOwner[page, MappingRole::StackRwXn] =
        { index, witness, USER_STACK_VA };
    return (next, mapping);
}

fn unmap_user_stack(space: sink AddressSpaceOwner[AddressSpaceState::Ready],
                    mapping: sink MappingOwner[page, MappingRole::StackRwXn])
        -> (AddressSpaceOwner[AddressSpaceState::TextData], PageOwner[page]) {
    user_pte_write(2, 0);
    user_tlb_invalidate(mapping.va);
    let mut next: AddressSpaceOwner[AddressSpaceState::TextData] = { space.asid };
    let page = page_owner_from_parts(mapping.page_index, mapping.page_witness);
    return (next, page);
}

fn unmap_user_data(space: sink AddressSpaceOwner[AddressSpaceState::TextData],
                   mapping: sink MappingOwner[page, MappingRole::DataRwXn])
        -> (AddressSpaceOwner[AddressSpaceState::Text], PageOwner[page]) {
    user_pte_write(1, 0);
    user_tlb_invalidate(mapping.va);
    let mut next: AddressSpaceOwner[AddressSpaceState::Text] = { space.asid };
    let page = page_owner_from_parts(mapping.page_index, mapping.page_witness);
    return (next, page);
}

fn unmap_user_text(space: sink AddressSpaceOwner[AddressSpaceState::Text],
                   mapping: sink MappingOwner[page, MappingRole::TextRx])
        -> (AddressSpaceOwner[AddressSpaceState::Empty], PageOwner[page]) {
    user_pte_write(0, 0);
    user_tlb_invalidate(mapping.va);
    let mut next: AddressSpaceOwner[AddressSpaceState::Empty] = { space.asid };
    let page = page_owner_from_parts(mapping.page_index, mapping.page_witness);
    return (next, page);
}

fn address_space_free(space: sink AddressSpaceOwner[AddressSpaceState::Empty]) {
}

fn user_layout_is_correct() -> bool {
    let text: usize = user_pte_read(0);
    let data: usize = user_pte_read(1);
    let stack: usize = user_pte_read(2);
    let permission_mask: usize = 0xFFE0000000000FFF;
    return (text & permission_mask) == USER_TEXT_RX_FLAGS &&
           (data & permission_mask) == USER_RW_XN_FLAGS &&
           (stack & permission_mask) == USER_RW_XN_FLAGS;
}
