use "kernel/mm/page.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/intrusive_pool.tkb";
use "kernel/arch/arm64/mm/mmu.tkb";
use "kernel/arch/arm64/mm/asid.tkb";

// USER_TEXT_VA occupies one L1 slot. Its fixed per-root L2 page has 512
// branches, each lazily backed by one 512-entry L3 page, so this first
// multi-level slice covers the complete 1 GiB L1 slot.
const USER_L2_BRANCH_COUNT: usize = 512;
const USER_L3_PAGE_COUNT: usize = 512;
const USER_SPACE_PAGE_COUNT: usize = 262144;


// nG is required once ASIDs distinguish roots: a global translation would
// match regardless of the ASID and defeat same-VA isolation.
const USER_TEXT_RX_FLAGS: usize = 0x0020000000000FC7;
const USER_RW_XN_FLAGS: usize = 0x0060000000000F47;
const USER_RODATA_R_FLAGS: usize = 0x0060000000000FC7;
// Excludes USER_COW_BIT: COW pages are still readable user mappings even
// though their software marker must make them non-writable.
const USER_PTE_PERMISSION_MASK: usize = 0xFF60000000000FFF;
const USER_PAGE_PHYS_MASK: usize = 0x0000FFFFFFFFF000;
// Bits 58:55 are ignored by the AArch64 stage-1 translation hardware and
// available to software. COW is meaningful only with a read-only user PTE.
const USER_COW_BIT: usize = 0x0080000000000000;

// PTE mutation is serialized by process ownership today: a process is never
// scheduled on two cores at once, and clone/exec/reap mutate only roots which
// their caller owns. That software-writer exclusion is distinct from the
// hardware page-table walker, which takes no kernel lock. Every last-level
// mutation therefore goes through mmu_pte_update, whose completed
// break-before-make sequence is also the point after which an unmapped
// physical page may be released.

// A per-process pool record's handle as it is stored in the process record:
// its pool address and generation, read as one pair under an authority
// (GitHub issue #693 step 5). Defined here rather than in
// kernel/kernel/process.tkb because AddressSpaceRoot holds one and this
// file is parsed first.
struct ProcessPoolHandleWords {
    address: usize;
    generation: usize;
}

// Capability naming one live address-space root. Its slot is private so
// users of the PTE and UserRange APIs cannot substitute a bare integer
// (especially the bootstrap root 0) for the calling process's root.
//
// GitHub issue #693 step 5: it also carries the handle of the root's
// backing, read once where the root was made, so the slot and its handle
// cannot be paired wrongly and no access below reads the process record
// again. Made by address_space_root_mint from an authority over the record
// (kernel/kernel/process.tkb: the run lock, an owner, the running evidence,
// or the diagnostic peek), by the backing's publisher, or by
// address_space_boot_root for root 0, whose backing is a static.
struct AddressSpaceRoot {
    private slot: usize;
    private backing: ProcessPoolHandleWords;
}

struct AddressSpaceBacking {
    live: bool;
    l1_physical: usize;
    l2_physical: usize;
    // GitHub issue #402: the ASID and the generation it was handed out in.
    // Both, because a number alone cannot say whether it is still this
    // root's -- an ASID rollover hands every number out again, and what
    // separates "mine" from "somebody else's now" is the stamp. 0/0 is a
    // root that has never been activated and therefore never needed one.
    asid: usize;
    asid_generation: usize;
}

// GitHub issue #392: pooled, not an array keyed by process slot. The
// handle -- the backing's pool address and generation -- lives in
// ProcessRecord. GitHub issue #672 layer 3: the pool is the built-in
// region_pool, and a backing is read and written as a value copy under a
// pin (address_space_backing_read/_write), so no pointer to it outlives
// the access and none is handed out.
private let mut address_space_backing_pool: RegionPool(AddressSpaceBacking);

// One page per chunk: a backing is five words.
const ADDRESS_SPACE_BACKING_CHUNK_PAGES: usize = 1;

// A backing that is missing (allocation failed, or the handle is stale) has
// nowhere to be reported from the thirty-odd accesses, so it is COUNTED.
// Printed at the end of the boot suite; 0 on a healthy kernel.
private let mut address_space_backing_missing_count:
    [usize; KERNEL_MAX_CORES];
// GitHub issue #479: WHICH ADDRESS SPACE IS ACTIVE is a property of a
// core, not of the kernel. Each core has its own TTBR0_EL1 and can be
// running a different process, so two cores have two answers -- and one
// global held one.
//
// An array indexed by cpu_id(), sized by KERNEL_MAX_CORES, exactly as
// execution_state is. A no-op while one core runs kernel code: cpu_id()
// answers 0 and the index adds nothing. Not a lock, because the problem
// was never contention -- it was that the state had the wrong shape.
//
// What it would have cost: address_space_activate_root writes it and
// address_space_release_root reads it to decide whether the root being
// freed is the one on the CPU. On two cores that read would answer about
// the OTHER core's root, so a release could leave this core running on a
// root it had just torn down, or skip switching a core off one it had.
//
// It still answers only for the releasing core. No other core can hold the
// root by then: a process is released only after it is reaped, and a core
// gives up an exiting process's root before the process can be reaped --
// through its successor's activation, or, going idle, by activating root 0
// in kernel_process_stack_idle_complete under the run lock.
private let mut address_space_active_slot: [usize; KERNEL_MAX_CORES];

private fn address_space_active_slot_here() -> usize {
    let base: *usize = address_space_active_slot;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return *base; }
    return *(base + (core as isize));
}

private fn address_space_set_active_slot_here(slot: usize) {
    let base: *usize = address_space_active_slot;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { *base = slot; return; }
    *(base + (core as isize)) = slot;
}

// GitHub issue #406: how many address spaces exist right now. Root 0's
// backing is a static rather than a pool allocation -- it is created with
// the MMU off, before any allocator -- so it is counted separately and not
// forgotten.
//
// This is the number a physical page's mapping refcount is bounded by: a
// page can be mapped into an address space at most once, so it cannot be
// mapped into more address spaces than exist.
fn address_space_live_count() -> usize !{unsafe} {
    let guard = address_space_backing_pool_lock(&address_space_backing_pool);
    let live: usize = region_pool_live_count(guard);
    address_space_backing_pool_unlock(guard);
    return live + 1;
}

// GitHub issue #406: one MORE live address space, for a probe that needs
// the mapping bound to move. Plain usizes in and out so
// kernel/mm/page.tkb -- parsed before this file, and the home of the probe
// because it needs the allocator's own metadata -- can call it: a function
// resolves regardless of file order, a type does not.
fn address_space_probe_root_acquire() -> usize !{unsafe} {
    let slot: usize = scheduled_process_probe_slot_acquire();
    if (slot == 0) { return 0; }
    match address_space_ensure_root(slot) {
        AddressSpaceEnsureResult::Ok => { return slot; }
        AddressSpaceEnsureResult::SlotOutOfRange => {
            scheduled_process_probe_slot_release(slot);
            return 0;
        }
        AddressSpaceEnsureResult::OutOfMemory => {
            scheduled_process_probe_slot_release(slot);
            return 0;
        }
    }
}

fn address_space_probe_root_release(slot: usize) !{unsafe} {
    if (slot == 0) { return; }
    address_space_release_root(scheduled_process_address_space_root_lookup(slot));
    scheduled_process_probe_slot_release(slot);
}

fn address_space_backing_missing_uses() -> usize {
    let mut total: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        total = total + address_space_backing_missing_count[core];
    }
    return total;
}

private fn address_space_backing_missing_note() {
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) {
        address_space_backing_missing_count[0] =
            address_space_backing_missing_count[0] + 1;
        return;
    }
    address_space_backing_missing_count[core] =
        address_space_backing_missing_count[core] + 1;
}

// GitHub issue #492 counted lookups that named a backing slot with the
// previous occupant's generation. A pin is refused for those and nothing is
// read through them, so there is nothing left to count.
fn address_space_backing_recycled_handle_count() -> usize { return 0; }

// The built-in pool starts empty from .bss and needs no construction. Kept
// for its callers' ordering before secondary startup.
fn address_space_backing_pool_init_before_secondary() {}

private fn address_space_backing_pool_lock(
        pool: *RegionPool(AddressSpaceBacking) @ backings)
        -> RegionPoolGuard(AddressSpaceBacking)[backings] !{unsafe} {
    let flags: usize = mutex_irq_save();
    return region_pool_lock_saving(pool, flags);
}

private fn address_space_backing_pool_unlock(
        guard: sink RegionPoolGuard(AddressSpaceBacking)[backings]) {
    mutex_irq_restore(region_pool_unlock_saved(guard));
}

private fn address_space_backing_return_empty(
        guard: borrow RegionPoolGuard(AddressSpaceBacking)[backings]) !{unsafe} {
    let mut more: bool = true;
    while (more) {
        match region_pool_shrink(guard) {
            RegionShrink(AddressSpaceBacking)::Nothing => { more = false; }
            RegionShrink(AddressSpaceBacking)::Chunk(bytes) => {
                let address: usize = region_bytes_address(bytes);
                region_release(bytes);
                page_run_transferred_release_physical(
                    address, ADDRESS_SPACE_BACKING_CHUNK_PAGES);
            }
        }
    }
}

private fn address_space_backing_slot_free(
        slot: sink RegionReleaseSlot(AddressSpaceBacking)[p, k]) !{unsafe} {
    let guard = address_space_backing_pool_lock(&address_space_backing_pool);
    match region_slot_adopt(guard, slot) {
        RegionReleaseAdopt(AddressSpaceBacking)::Foreign(stray) => {
            // Counted, not logged: a last unpin can land here from the
            // IRQ-reachable context-switch reads, which may not log.
            address_space_backing_missing_note();
            region_slot_abandon(stray);
        }
        RegionReleaseAdopt(AddressSpaceBacking)::Adopted(mine) => {
            region_free(guard, mine);
            address_space_backing_return_empty(guard);
        }
    }
    address_space_backing_pool_unlock(guard);
}

private fn address_space_backing_unpin(
        pin: sink RegionPin(AddressSpaceBacking)[p, k]) !{unsafe} {
    match region_unpin(pin) {
        RegionUnpin(AddressSpaceBacking)::Unpinned => {}
        RegionUnpin(AddressSpaceBacking)::Last(slot) => {
            address_space_backing_slot_free(slot);
        }
    }
}

// A pin on the backing a process slot's handle names, or Stale.
private fn address_space_backing_pin(
        pool: *RegionPool(AddressSpaceBacking) @ backings, root: AddressSpaceRoot)
        -> RegionPinned(AddressSpaceBacking)[backings] !{unsafe} {
    let guard = address_space_backing_pool_lock(pool);
    let mut handle: RegionHandle(AddressSpaceBacking) =
        region_handle_from(guard, root.backing.address, root.backing.generation);
    let pinned = region_pin(guard, handle);
    address_space_backing_pool_unlock(guard);
    return pinned;
}

// GitHub issue #414: gives a slot's backing record back to the pool. The
// handle is cleared first, so nothing pins it again by this slot; then the
// backing is retired, and whoever gives up the last pin frees it.
//
// Root 0 is exempt: its backing is a static, not a pool allocation, for
// the MMU-off reason stated below.
fn address_space_backing_release(root: AddressSpaceRoot) !{unsafe} {
    let slot: usize = root.slot;
    if (slot == 0) { return; }
    if (root.backing.address == 0) { return; }
    let pinned = address_space_backing_pin(&address_space_backing_pool, root);
    scheduled_process_set_address_space_backing(slot, 0, 0);
    match pinned {
        RegionPinned(AddressSpaceBacking)::Stale => {
            kernel_boot_log("address spaces: releasing a stale backing handle\n");
        }
        RegionPinned(AddressSpaceBacking)::Pinned(pin) => {
            match region_retire(pin) {
                RegionRetire(AddressSpaceBacking)::Pending => {}
                RegionRetire(AddressSpaceBacking)::Retired(backing) => {
                    address_space_backing_slot_free(backing);
                }
            }
        }
    }
}

// Acquired on demand rather than only at process creation: a slot here is
// not always a live scheduler slot, exactly as issue #392's image-record
// stage found. Idempotent. Ready carries evidence with the handle that is
// now published, which the caller's root may predate.
// Successful validation/publication carries the exact root and its value
// copy. A bare AddressSpaceRoot can name an absent backing and is not write
// evidence. Process ownership still prevents release between this snapshot
// and a write; each write revalidates the saved handle under a fresh pin.
affine struct AddressSpaceBackingExists[slot: usize] {
    private slot: usize @ slot;
    private target: AddressSpaceRoot;
    private value: AddressSpaceBacking;
}

must_use variant AddressSpaceBackingReady {
    Missing;
    Ready(exists slot: usize. AddressSpaceBackingExists[slot]);
}

private fn address_space_backing_exists(slot: usize @ identity,
                                        root: AddressSpaceRoot,
                                        value: AddressSpaceBacking)
        -> AddressSpaceBackingReady {
    let mut evidence: AddressSpaceBackingExists[identity] = { slot, root, value };
    return AddressSpaceBackingReady::Ready(evidence);
}

private fn address_space_backing_ensure(root: AddressSpaceRoot)
        -> AddressSpaceBackingReady !{unsafe} {
    // Lookup success and allocation success return the same write evidence.
    // Root 0's permanent static backing never needs allocation.
    match address_space_backing_read_checked(root) {
        AddressSpaceBackingReady::Ready(evidence) => {
            return AddressSpaceBackingReady::Ready(evidence);
        }
        AddressSpaceBackingReady::Missing => {}
    }
    let guard = address_space_backing_pool_lock(&address_space_backing_pool);
    match region_alloc(guard) {
        RegionPoolAlloc(AddressSpaceBacking)::Allocated(fresh) => {
            address_space_backing_pool_unlock(guard);
            return address_space_backing_publish(
                &address_space_backing_pool, root.slot, fresh);
        }
        RegionPoolAlloc(AddressSpaceBacking)::Exhausted => { address_space_backing_pool_unlock(guard); return AddressSpaceBackingReady::Missing; }
        RegionPoolAlloc(AddressSpaceBacking)::Full => {}
    }
    if (address_space_backing_grow(guard)) {
        match region_alloc(guard) {
            RegionPoolAlloc(AddressSpaceBacking)::Allocated(fresh) => {
                address_space_backing_pool_unlock(guard);
                return address_space_backing_publish(
                    &address_space_backing_pool, root.slot, fresh);
            }
            RegionPoolAlloc(AddressSpaceBacking)::Exhausted => { address_space_backing_pool_unlock(guard); return AddressSpaceBackingReady::Missing; }
            RegionPoolAlloc(AddressSpaceBacking)::Full => {}
        }
    }
    address_space_backing_pool_unlock(guard);
    return AddressSpaceBackingReady::Missing;
}

// A fresh backing, zeroed and made Live; its handle goes into the process
// record, and the root returned names it -- the publisher is the one
// place that knows the new handle without reading it back.
private fn address_space_backing_publish(
        pool: *RegionPool(AddressSpaceBacking) @ backings, slot: usize,
        fresh: sink RegionSlot(AddressSpaceBacking)[backings, k])
        -> AddressSpaceBackingReady !{unsafe} {
    region_slot_zero(fresh);
    let guard = address_space_backing_pool_lock(pool);
    let mut handle: RegionHandle(AddressSpaceBacking) = region_give(guard, fresh);
    address_space_backing_pool_unlock(guard);
    let mut words: ProcessPoolHandleWords = {
        region_handle_address(handle), region_handle_generation(handle) };
    scheduled_process_set_address_space_backing(
        slot, words.address, words.generation);
    let mut empty: AddressSpaceBacking = { false, 0, 0, 0, 0 };
    return address_space_backing_exists(
        slot, address_space_root_mint(slot, words), empty);
}

private fn address_space_backing_grow(
        guard: borrow RegionPoolGuard(AddressSpaceBacking)[backings]) -> bool !{unsafe} {
    match page_alloc_contiguous(ADDRESS_SPACE_BACKING_CHUNK_PAGES,
                                PageOwnerTag::PoolChunk) {
        PageRunAllocResult::OutOfMemory => { return false; }
        PageRunAllocResult::Allocated(run_owner) => {
            let base: usize = page_run_physical_address(run_owner);
            let _run_index: usize =
                page_run_owner_transfer_index(run_owner) as usize;
            let RegionBytes::Assumed(chunk) = region_bytes_assume(
                base, ADDRESS_SPACE_BACKING_CHUNK_PAGES * PAGE_SIZE) else {};
            match region_pool_grow(guard, chunk) {
                RegionGrow(AddressSpaceBacking)::Grown => { return true; }
                RegionGrow(AddressSpaceBacking)::TooSmall(back) => {
                    region_release(back);
                    page_run_transferred_release_physical(
                        base, ADDRESS_SPACE_BACKING_CHUNK_PAGES);
                    return false;
                }
            }
        }
    }
}

// Root 0's backing is a plain static, NOT a pool slot.
//
// kernel_mmu_init creates root 0 with the MMU still OFF -- entry.S calls
// it before main() -- and that window cannot take the stores pooled
// storage needs. This file already carries the reason a few lines down:
// "Rewriting this aggregate while the MMU is off permits LLVM to use an
// unaligned 128-bit store on RPi5, which faults before the bootstrap root
// exists." Allocating a page, carving a chunk and zeroing a payload is a
// great deal more of exactly that, and it cost one hardware boot with
// zero UART output to rediscover.
//
// It is not a wart on the pooling: root 0 is the permanent bootstrap root
// everywhere else in this kernel too -- never released, named as a bare 0
// by a dozen call sites. Being the one backing that exists before the
// allocator does is the same fact, one layer down.
private let mut address_space_backing_root0: AddressSpaceBacking;

// A root's backing. It no longer allocates on a miss: the root carries the
// handle it was made with, so a backing allocated here would be published
// to the record while the caller's root kept naming none, and the next
// access would allocate another (#693 step 5). Allocation is
// address_space_ensure_root's, explicitly.
private fn address_space_backing_read(root: AddressSpaceRoot) -> AddressSpaceBacking !{unsafe} {
    return address_space_backing_read_existing(root);
}

// A slot's backing, as a value copy made under a pin. Never allocates: a
// missing backing is an invariant failure on the IRQ-reachable
// context-switch paths, which must not grow the pool. It reads as not live
// and is counted.
private fn address_space_backing_read_existing(root: AddressSpaceRoot)
        -> AddressSpaceBacking !{unsafe} {
    match address_space_backing_read_checked(root) {
        AddressSpaceBackingReady::Missing => {
            address_space_backing_missing_note();
            let mut empty: AddressSpaceBacking = { false, 0, 0, 0, 0 };
            return empty;
        }
        AddressSpaceBackingReady::Ready(evidence) => { return evidence.value; }
    }
}

// A successful lookup supplies write evidence without allocating. Activation
// and release use this path, so a missing backing cannot grow in IRQ context.
private fn address_space_backing_read_checked(root: AddressSpaceRoot)
        -> AddressSpaceBackingReady !{unsafe} {
    let slot: usize = root.slot;
    let mut value: AddressSpaceBacking = { false, 0, 0, 0, 0 };
    if (slot == 0) {
        value.live = address_space_backing_root0.live;
        value.l1_physical = address_space_backing_root0.l1_physical;
        value.l2_physical = address_space_backing_root0.l2_physical;
        value.asid = address_space_backing_root0.asid;
        value.asid_generation = address_space_backing_root0.asid_generation;
        return address_space_backing_exists(slot, root, value);
    }
    match address_space_backing_pin(&address_space_backing_pool, root) {
        RegionPinned(AddressSpaceBacking)::Stale => {
            return AddressSpaceBackingReady::Missing;
        }
        RegionPinned(AddressSpaceBacking)::Pinned(pin) => {
            let backing: *AddressSpaceBacking = region_pin_at(pin);
            value.live = backing.live;
            value.l1_physical = backing.l1_physical;
            value.l2_physical = backing.l2_physical;
            value.asid = backing.asid;
            value.asid_generation = backing.asid_generation;
            address_space_backing_unpin(pin);
            return address_space_backing_exists(slot, root, value);
        }
    }
}

// Writes a whole backing back. Writers are serialized by process ownership
// (this file's header), so a read, a change and this write are not raced by
// another writer of the same backing. Never allocates: a backing that is
// written was validated by a checked read or published by ensure first.
private fn address_space_backing_write(
        evidence: borrow AddressSpaceBackingExists[slot], value: AddressSpaceBacking)
        !{unsafe} {
    let mut root: AddressSpaceRoot = evidence.target;
    let slot: usize = evidence.slot;
    if (slot == 0) {
        address_space_backing_root0.live = value.live;
        address_space_backing_root0.l1_physical = value.l1_physical;
        address_space_backing_root0.l2_physical = value.l2_physical;
        address_space_backing_root0.asid = value.asid;
        address_space_backing_root0.asid_generation = value.asid_generation;
        return;
    }
    match address_space_backing_pin(&address_space_backing_pool, root) {
        RegionPinned(AddressSpaceBacking)::Stale => {
            address_space_backing_missing_note();
        }
        RegionPinned(AddressSpaceBacking)::Pinned(pin) => {
            let backing: *AddressSpaceBacking = region_pin_at(pin);
            backing.live = value.live;
            backing.l1_physical = value.l1_physical;
            backing.l2_physical = value.l2_physical;
            backing.asid = value.asid;
            backing.asid_generation = value.asid_generation;
            address_space_backing_unpin(pin);
        }
    }
}

fn address_space_is_live(root: AddressSpaceRoot) -> bool {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot)) {
        let checked: usize = slot;
        return address_space_backing_read(root).live;
    }
    return false;
}

// Process lifecycle code obtains this after selecting a scheduled process.
// Boot-only probes use address_space_boot_root() explicitly instead.
// The mint: a root from a slot and the backing handle read for it under an
// authority. Its callers are listed by scripts/check_address_space_root_mints.py.
fn address_space_root_mint(slot: usize, backing: ProcessPoolHandleWords)
        -> AddressSpaceRoot {
    let mut root: AddressSpaceRoot = { slot, backing };
    return root;
}

// Root 0's backing is the static below, never the pool, so it needs no
// handle and no authority.
fn address_space_boot_root() -> AddressSpaceRoot {
    let mut none: ProcessPoolHandleWords = { 0, 0 };
    return address_space_root_mint(0, none);
}

fn address_space_root_slot(root: AddressSpaceRoot) -> usize {
    return root.slot;
}

fn address_space_l1_physical(root: AddressSpaceRoot) -> usize {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot)) {
        let checked: usize = slot;
        if (address_space_backing_read(root).live) {
            return address_space_backing_read(root).l1_physical;
        }
    }
    return 0;
}

fn address_space_l2_physical(root: AddressSpaceRoot) -> usize {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot)) {
        let checked: usize = slot;
        if (address_space_backing_read(root).live) {
            return address_space_backing_read(root).l2_physical;
        }
    }
    return 0;
}

fn address_space_asid(root: AddressSpaceRoot) -> usize {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot)) {
        let checked: usize = slot;
        if (address_space_backing_read(root).live) {
            return address_space_backing_read(root).asid;
        }
    }
    return 0;
}

struct AddressSpaceDiagnosticSnapshot {
    live: bool;
    l1_physical: usize;
    l2_physical: usize;
    asid: usize;
}

// IRQ/DDB diagnostics must never turn a missing backing into an allocation.
// Observe only the lookup-only path used by interrupt context switches and
// return a value copy that owns no pool reference.
fn address_space_diagnostic_snapshot(root: AddressSpaceRoot)
        -> AddressSpaceDiagnosticSnapshot !{unsafe} {
    let slot: usize = root.slot;
    let mut backing: AddressSpaceBacking = address_space_backing_read_existing(root);
    let mut snapshot: AddressSpaceDiagnosticSnapshot = { false, 0, 0, 0 };
    if (backing.live) {
        snapshot.live = true;
        snapshot.l1_physical = backing.l1_physical;
        snapshot.l2_physical = backing.l2_physical;
        snapshot.asid = backing.asid;
    }
    return snapshot;
}

// GitHub issue #402: no ASID is taken here. A root is created without one
// and is given one at its first activation, which is the lifetime Linux
// gives an mm -- and, more to the point, the only moment at which handing
// out a number is safe once numbers are recycled by rollover. See
// asid_assign's own comment for what assigning at creation time would
// alias.
fn address_space_record_backing(
        evidence: borrow AddressSpaceBackingExists[slot],
        l1: sink PageOwner[l1_page], l2: sink PageOwner[l2_page]) {
    let slot: usize = evidence.slot;
    let l1_physical: usize = page_physical_address(l1);
    let l2_physical: usize = page_physical_address(l2);

    // Build before dropping the fine-grained owners into this coarser
    // record. mmu_init_root has no allocation or fallible operation.
    mmu_init_root(l1_physical, l2_physical);
    let mut recorded: AddressSpaceBacking = { true, l1_physical, l2_physical, 0, 0 };
    address_space_backing_write(evidence, recorded);
    page_owner_transfer_index(l1);
    page_owner_transfer_index(l2);
}

// GitHub issue #295: address_space_allocate_root/_ensure_root used to return
// a bare bool, collapsing three unrelated failure causes into one signal --
// this pool's own slot-range check, kernel/mm/page.tkb's global physical
// page allocator (shared by every other subsystem, not specific to address
// spaces), and kernel/arch/arm64/mm/asid.tkb's separate, equally-sized ASID
// pool. A caller such as scheduled_process_alloc could not tell "the process
// table is genuinely full" from "the kernel is out of physical memory" --
// exactly the kind of misdiagnosis issue #295 was filed over.
// GitHub issue #402 removed AsidExhausted: there is no such failure any
// more. An ASID is not allocated here at all, and when one is taken (at
// activation) it cannot fail -- the allocator rolls over instead of
// refusing. A variant nothing can return is worse than no variant, because
// every caller keeps an arm that says something untrue about this kernel.
must_use variant AddressSpaceAllocateResult {
    OutOfMemory;
    Ok;
}

// Allocate one complete root atomically from the caller's perspective. Any
// partial page allocation is returned before reporting failure, so a failed
// process-slot allocation cannot leave an unreachable table or ASID live.
fn address_space_allocate_root(evidence: borrow AddressSpaceBackingExists[slot])
        -> AddressSpaceAllocateResult {
    let slot: usize = evidence.slot;
    // The backing record exists already: address_space_ensure_root made it
    // and passes evidence naming it. Since #672 the record's pool grows
    // through page_alloc_contiguous, so that step can genuinely run out,
    // and it says so there rather than building tables into a record that
    // does not exist.
    match page_alloc(PageOwnerTag::PageTable) {
        PageAllocResult::OutOfMemory => {
            return AddressSpaceAllocateResult::OutOfMemory;
        }
        PageAllocResult::Allocated(l1) => {
            match page_alloc(PageOwnerTag::PageTable) {
                PageAllocResult::OutOfMemory => {
                    page_free(l1);
                    return AddressSpaceAllocateResult::OutOfMemory;
                }
                PageAllocResult::Allocated(l2) => {
                    address_space_record_backing(evidence, l1, l2);
                    return AddressSpaceAllocateResult::Ok;
                }
            }
        }
    }
}

// Root 0 is constructed before the MMU is enabled. Keep its complete write
// path separate from the pooled nonzero-slot path so the checker can prove
// that bootstrap never reaches intrusive-pool growth.
// GitHub issue #479: the boot variants, because this runs with the MMU off
// and the locked entry points are `!{requires_mmu}` -- the lock is built
// from exclusives, which AArch64 does not support on Device-typed memory.
// Nothing to exclude here anyway: PSCI has not been asked to start a second
// core yet.
private fn address_space_allocate_boot_root()
        -> AddressSpaceAllocateResult !{mmu_off} {
    match page_alloc_boot(PageOwnerTag::PageTable) {
        PageAllocResult::OutOfMemory => {
            return AddressSpaceAllocateResult::OutOfMemory;
        }
        PageAllocResult::Allocated(l1) => {
            match page_alloc_boot(PageOwnerTag::PageTable) {
                PageAllocResult::OutOfMemory => {
                    page_free_boot(l1);
                    return AddressSpaceAllocateResult::OutOfMemory;
                }
                PageAllocResult::Allocated(l2) => {
                    let l1_physical: usize = page_physical_address(l1);
                    let l2_physical: usize = page_physical_address(l2);
                    // Root 0 is the one root that takes its ASID eagerly:
                    // kernel_mmu_activate needs a number for the very
                    // first TTBR0_EL1 write, and there is nothing running
                    // yet for a rollover to alias -- the counter is at 1.
                    let (numeric_asid, generation) = asid_assign_boot();
                    mmu_init_root(l1_physical, l2_physical);
                    address_space_backing_root0.l1_physical = l1_physical;
                    address_space_backing_root0.l2_physical = l2_physical;
                    address_space_backing_root0.asid = numeric_asid;
                    address_space_backing_root0.asid_generation = generation;
                    address_space_backing_root0.live = true;
                    page_owner_transfer_index(l1);
                    page_owner_transfer_index(l2);
                    return AddressSpaceAllocateResult::Ok;
                }
            }
        }
    }
}

must_use variant AddressSpaceEnsureResult {
    SlotOutOfRange;
    OutOfMemory;
    Ok;
}

private fn address_space_ensure_boot_root() -> AddressSpaceEnsureResult {
    if (address_space_backing_root0.live) {
        return AddressSpaceEnsureResult::Ok;
    }
    match address_space_allocate_boot_root() {
        AddressSpaceAllocateResult::OutOfMemory => {
            return AddressSpaceEnsureResult::OutOfMemory;
        }
        AddressSpaceAllocateResult::Ok => { return AddressSpaceEnsureResult::Ok; }
    }
}

// Idempotent because root 0 is first made real before any ProcessHandle
// exists, then adopted by the initial scheduler slot. Every nonzero slot is
// made real by scheduled_process_alloc and released when that slot is reaped.
fn address_space_ensure_root(slot: usize) -> AddressSpaceEnsureResult {
    if (scheduled_process_slot_valid(slot) == false) {
        return AddressSpaceEnsureResult::SlotOutOfRange;
    }
    let evidence = match address_space_backing_ensure(
            scheduled_process_address_space_root_lookup(slot)) {
        AddressSpaceBackingReady::Missing => {
            return AddressSpaceEnsureResult::OutOfMemory;
        }
        AddressSpaceBackingReady::Ready(ready) => { ready }
    };
    if (evidence.value.live) {
        return AddressSpaceEnsureResult::Ok;
    }
    match address_space_allocate_root(evidence) {
        AddressSpaceAllocateResult::OutOfMemory => {
            return AddressSpaceEnsureResult::OutOfMemory;
        }
        AddressSpaceAllocateResult::Ok => { return AddressSpaceEnsureResult::Ok; }
    }
}

// GitHub issue #402: the one moment a non-bootstrap root may take an ASID.
// It is the moment it is about to run, and the moment the root that was running
// stops -- which is what makes handing out a recycled number safe. A root
// whose stamp is still the current generation keeps the number it has;
// one that never had a number, or whose generation was left behind by a
// rollover, is given a fresh one here.
// GitHub issue #479: root 0 keeps the ASID it took before the MMU came on.
// ASID 1 is permanently reserved by asid.tkb, so rollover never makes that
// number available to another root and these shared fields never need a
// cross-core write. Every other backing remains protected by its pool guard.
private fn address_space_refresh_asid(
        evidence: borrow AddressSpaceBackingExists[slot], backing: *AddressSpaceBacking) {
    let slot: usize = evidence.slot;
    if (slot == 0) { return; }
    if (asid_generation_is_current(backing.asid_generation)) { return; }
    let (value, generation) = asid_assign();
    backing.asid = value;
    backing.asid_generation = generation;
    address_space_backing_write(evidence, *backing);
}

// The half of activation that may discover global ASID work. A scheduler can
// reserve a Ready target under its run lock, release that lock, and call this
// without having changed TTBR0 or the recorded current process. Prepared is
// linear so every successful preparation must end in the matching commit.
linear struct AddressSpaceActivationPrepared[root: usize] {
    private root: usize @ root;
    private target: AddressSpaceRoot;
}

must_use variant AddressSpaceActivationPrepareResult {
    Invalid;
    RolloverNeeded;
    Prepared(exists root: usize. AddressSpaceActivationPrepared[root]);
}

private fn address_space_activation_prepared_new(root: usize @ identity,
                                                target: AddressSpaceRoot)
        -> AddressSpaceActivationPrepared[identity] {
    let mut prepared: AddressSpaceActivationPrepared[identity] = { root, target };
    return prepared;
}

fn address_space_prepare_activation(root: AddressSpaceRoot)
        -> AddressSpaceActivationPrepareResult {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot) == false) {
        return AddressSpaceActivationPrepareResult::Invalid;
    }
    let checked: usize = slot;
    let evidence = match address_space_backing_read_checked(root) {
        AddressSpaceBackingReady::Missing => {
            address_space_backing_missing_note();
            return AddressSpaceActivationPrepareResult::Invalid;
        }
        AddressSpaceBackingReady::Ready(value) => { value }
    };
    let mut backing: AddressSpaceBacking = evidence.value;
    if (backing.live == false) {
        return AddressSpaceActivationPrepareResult::Invalid;
    }
    if (checked != 0 &&
            asid_generation_is_current(backing.asid_generation) == false) {
        match asid_assign_attempt() {
            AsidAssignAttempt::RolloverNeeded => {
                return AddressSpaceActivationPrepareResult::RolloverNeeded;
            }
            AsidAssignAttempt::Assigned(assignment) => {
                let (value, generation) = assignment;
                backing.asid = value;
                backing.asid_generation = generation;
                address_space_backing_write(evidence, backing);
            }
        }
    }
    return AddressSpaceActivationPrepareResult::Prepared(
        address_space_activation_prepared_new(checked, root));
}

must_use variant AddressSpaceActivationCommitResult {
    Invalid;
    Activated(AddressSpaceRoot);
}

fn address_space_commit_activation(
        prepared: sink AddressSpaceActivationPrepared[root])
        -> AddressSpaceActivationCommitResult {
    let slot: usize = prepared.root;
    let mut root: AddressSpaceRoot = prepared.target;
    if (scheduled_process_slot_valid(slot) == false) {
        return AddressSpaceActivationCommitResult::Invalid;
    }
    let checked: usize = slot;
    let mut backing: AddressSpaceBacking = address_space_backing_read_existing(root);
    if (backing.live == false) {
        return AddressSpaceActivationCommitResult::Invalid;
    }
    if (checked != 0 &&
            asid_generation_is_current(backing.asid_generation) == false) {
        return AddressSpaceActivationCommitResult::Invalid;
    }
    mmu_activate_root(backing.l1_physical, backing.asid);
    address_space_set_active_slot_here(checked);
    return AddressSpaceActivationCommitResult::Activated(root);
}

fn address_space_cancel_activation(
        prepared: sink AddressSpaceActivationPrepared[root]) {}

fn address_space_activate_root(root: AddressSpaceRoot) {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot)) {
        let checked: usize = slot;
        match address_space_backing_read_checked(root) {
            AddressSpaceBackingReady::Missing => { address_space_backing_missing_note(); }
            AddressSpaceBackingReady::Ready(evidence) => {
                let mut backing: AddressSpaceBacking = evidence.value;
                if (backing.live) {
                    address_space_refresh_asid(evidence, &backing);
                    mmu_activate_root(backing.l1_physical, backing.asid);
                    address_space_set_active_slot_here(checked);
                    return;
                }
            }
        }
    }
    // Root 0 is permanently retained as the bootstrap/fallback root, so an
    // invalid or already-released slot never reaches TTBR0_EL1.
    let fallback: usize = 0;
    let mut fallback_backing: AddressSpaceBacking = address_space_backing_read_existing(address_space_boot_root());
    mmu_activate_root(fallback_backing.l1_physical, fallback_backing.asid);
    address_space_set_active_slot_here(0);
}

must_use variant AddressSpacePteWriteResult {
    Invalid;
    OutOfMemory;
    Written;
}

fn address_space_l3_physical_for_branch(root: AddressSpaceRoot, branch: usize) -> usize {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot) == false || branch >= USER_L2_BRANCH_COUNT) {
        return 0;
    }
    let checked: usize = slot;
    if (address_space_backing_read(root).live == false) { return 0; }
    return mmu_user_l3_physical(address_space_backing_read(root).l2_physical,
                                branch);
}

fn address_space_l3_physical_for_index(root: AddressSpaceRoot, index: usize) -> usize {
    let slot: usize = root.slot;
    if (index >= USER_SPACE_PAGE_COUNT) { return 0; }
    return address_space_l3_physical_for_branch(root,
                                                index / USER_L3_PAGE_COUNT);
}

// This function is intentionally the only owner of lazy L3-table
// allocation. A caller keeps its PageOwner until Written is returned, so an
// L3-allocation failure cannot silently discard a mapped user page.
fn address_space_pte_write(root: AddressSpaceRoot, index: usize, value: usize)
        -> AddressSpacePteWriteResult {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot) == false || index >= USER_SPACE_PAGE_COUNT) {
        return AddressSpacePteWriteResult::Invalid;
    }
    let checked: usize = slot;
    if (address_space_backing_read(root).live == false) {
        return AddressSpacePteWriteResult::Invalid;
    }
    let branch: usize = index / USER_L3_PAGE_COUNT;
    let entry: usize = index % USER_L3_PAGE_COUNT;
    let l2_physical: usize = address_space_backing_read(root).l2_physical;
    let mut l3_physical: usize =
        mmu_user_l3_physical(l2_physical, branch);
    if (l3_physical == 0) {
        // Clearing a never-populated branch is already complete and must
        // not spend a physical page merely to hold an all-zero table.
        if (value == 0) { return AddressSpacePteWriteResult::Written; }
        match page_alloc(PageOwnerTag::PageTable) {
            PageAllocResult::OutOfMemory => {
                return AddressSpacePteWriteResult::OutOfMemory;
            }
            PageAllocResult::Allocated(l3) => {
                l3_physical = page_physical_address(l3);
                mmu_user_l3_install(l2_physical, branch, l3_physical);
                page_owner_transfer_index(l3);
            }
        }
    }
    mmu_pte_update(l3_physical, entry, value,
                   address_space_backing_read(root).asid,
                   USER_TEXT_VA + index * PAGE_SIZE);
    return AddressSpacePteWriteResult::Written;
}

// Clearing does not allocate. Kept separate from address_space_pte_write so
// teardown never needs to ignore an allocation-result variant.
fn address_space_pte_clear(root: AddressSpaceRoot, index: usize) {
    let slot: usize = root.slot;
    let l3_physical: usize = address_space_l3_physical_for_index(root, index);
    if (l3_physical != 0) {
        let entry: usize = index % USER_L3_PAGE_COUNT;
        let pte: usize = mmu_pte_read(l3_physical, entry);
        if (pte != 0) {
            mmu_pte_update(l3_physical, entry, 0,
                           address_space_asid(root),
                           USER_TEXT_VA + index * PAGE_SIZE);
            page_mapping_release_physical(pte & USER_PAGE_PHYS_MASK);
        }
    }
}

fn address_space_pte_read(root: AddressSpaceRoot, index: usize) -> usize {
    let slot: usize = root.slot;
    let l3_physical: usize = address_space_l3_physical_for_index(root, index);
    if (l3_physical != 0) {
        return mmu_pte_read(l3_physical, index % USER_L3_PAGE_COUNT);
    }
    return 0;
}

// GitHub issue #384: the physical page behind a user virtual address in
// `slot`'s address space, or 0 if the address is not in the user window or
// is not mapped.
//
// A fail-stop report has a faulting address and an ELR, and both are user
// VAs when the fault came from EL0. Printing who owns the PHYSICAL page
// behind them is the question issue #373 spent a day answering by hand --
// a process's text page that is simultaneously a kernel stack shows up
// here as one line.
fn address_space_user_physical(root: AddressSpaceRoot, va: usize) -> usize {
    let slot: usize = root.slot;
    if (va < USER_TEXT_VA) { return 0; }
    let offset: usize = va - USER_TEXT_VA;
    let index: usize = offset / PAGE_SIZE;
    if (index >= USER_SPACE_PAGE_COUNT) { return 0; }
    let pte: usize = address_space_pte_read(root, index);
    if (pte == 0) { return 0; }
    return pte & USER_PAGE_PHYS_MASK;
}

fn address_space_pte_is_cow(pte: usize) -> bool {
    return (pte & USER_COW_BIT) != 0;
}

fn address_space_pte_is_writable(pte: usize) -> bool {
    return pte != 0 &&
           (pte & USER_PTE_PERMISSION_MASK) == USER_RW_XN_FLAGS;
}

fn address_space_pte_cow_value(pte: usize) -> usize {
    return (pte & USER_PAGE_PHYS_MASK) | USER_RODATA_R_FLAGS | USER_COW_BIT;
}

// Installs the first mapping of a freshly allocated page. PageOwner stays
// linear until the fallible lazy-L3 allocation has succeeded; after that
// point page.tkb records one runtime mapping reference for the PTE.
fn address_space_map_page(root: AddressSpaceRoot, index: usize,
                          page: sink PageOwner[page_id],
                          flags: usize) -> AddressSpacePteWriteResult {
    let slot: usize = root.slot;
    let physical: usize = page_physical_address(page);
    match address_space_pte_write(root, index, physical | flags) {
        AddressSpacePteWriteResult::Invalid => {
            page_free(page);
            return AddressSpacePteWriteResult::Invalid;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            page_free(page);
            return AddressSpacePteWriteResult::OutOfMemory;
        }
        AddressSpacePteWriteResult::Written => {
            page_mapping_install(page);
            return AddressSpacePteWriteResult::Written;
        }
    }
}

// Resolves one write-protected COW PTE for this root. The new mapping is
// completely installed before the old reference is released, preserving the
// source bytes and making an allocation failure leave the shared PTE intact.
fn address_space_resolve_cow(root: AddressSpaceRoot, index: usize) -> bool !{unsafe} {
    let slot: usize = root.slot;
    let old_pte: usize = address_space_pte_read(root, index);
    if (address_space_pte_is_cow(old_pte) == false) { return false; }
    let old_physical: usize = old_pte & USER_PAGE_PHYS_MASK;
    // A sibling root may already have unmapped or resolved its COW view.
    // Once this is the sole mapping again, restoring write permission needs
    // neither a new page nor a copy, and cannot turn memory pressure into a
    // fault for data the process already owns exclusively.
    if (page_mapping_refcount_physical(old_physical) == 1) {
        match address_space_pte_write(
                root, index, old_physical | USER_RW_XN_FLAGS) {
            AddressSpacePteWriteResult::Invalid => { return false; }
            AddressSpacePteWriteResult::OutOfMemory => { return false; }
            AddressSpacePteWriteResult::Written => {
                return true;
            }
        }
    }
    match page_alloc(PageOwnerTag::PageTable) {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(page) => {
            if (page_copy_mapped_physical(old_physical, page) == false) {
                page_free(page);
                return false;
            }
            let new_physical: usize = page_physical_address(page);
            match address_space_pte_write(
                    root, index, new_physical | USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    page_free(page);
                    return false;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    page_free(page);
                    return false;
                }
                AddressSpacePteWriteResult::Written => {
                    page_mapping_install(page);
                    page_mapping_release_physical(old_physical);
                    return true;
                }
            }
        }
    }
}

// Each mapped user page transferred its PageOwner when it was installed.
// Walk the L2 branches rather than retaining a parallel page-index list:
// the actual table is the ownership record and each populated branch also
// owns one dynamic L3 page. This handles clone rollback, image cleanup, and
// root destruction without a USER_SPACE_PAGE_COUNT-sized shadow array.
fn address_space_release_user_mappings(root: AddressSpaceRoot) {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot) == false) { return; }
    let checked: usize = slot;
    if (address_space_backing_read(root).live == false) { return; }
    let l2_physical: usize = address_space_backing_read(root).l2_physical;
    for branch: usize in 0..<USER_L2_BRANCH_COUNT {
        let l3_physical: usize = mmu_user_l3_physical(l2_physical, branch);
        if (l3_physical != 0) {
            for entry: usize in 0..<USER_L3_PAGE_COUNT {
                let pte: usize = mmu_pte_read(l3_physical, entry);
                if (pte != 0) {
                    mmu_pte_update(
                        l3_physical, entry, 0,
                        address_space_backing_read(root).asid,
                        USER_TEXT_VA +
                            (branch * USER_L3_PAGE_COUNT + entry) * PAGE_SIZE);
                    page_mapping_release_physical(pte & USER_PAGE_PHYS_MASK);
                }
            }
            mmu_clear_user_table(l3_physical);
            mmu_user_l3_remove(l2_physical, branch);
            page_transferred_release_physical(l3_physical);
        }
    }
    let asid: usize = address_space_backing_read(root).asid;
    if (asid != 0) { mmu_tlb_invalidate_asid(asid); }
}

fn address_space_clear_root(root: AddressSpaceRoot) {
    let slot: usize = root.slot;
    address_space_release_user_mappings(root);
}

// GitHub issue #392: ask about a root's whole user window one BRANCH at a
// time. Every page of an absent L3 branch is absent, so reading 262144
// PTEs to find that out reads 511 of every 512 for nothing -- and each of
// those reads now validates the process record and the address-space
// backing against their pools, where an array cost one compare.
//
// This is what a 262144-iteration scan cost after pooling, measured: 6.6
// million address_space_pte_read calls before the boot suite's first
// listen(), 22.7 million validated record lookups underneath them, and
// 10.7 seconds of wall clock -- enough to push the host network peer past
// its own 15-second handshake budget, which reads as a network bug and is
// not one. The scan was always this wasteful; pooling only made it
// visible.
fn address_space_user_window_is_clear(root: AddressSpaceRoot) -> bool !{unsafe} {
    let slot: usize = root.slot;
    if (scheduled_process_slot_valid(slot) == false) { return true; }
    if (address_space_backing_read(root).live == false) { return true; }
    let l2_physical: usize = address_space_backing_read(root).l2_physical;
    for branch: usize in 0..<USER_L2_BRANCH_COUNT {
        let l3_physical: usize = mmu_user_l3_physical(l2_physical, branch);
        if (l3_physical != 0) {
            for entry: usize in 0..<USER_L3_PAGE_COUNT {
                if (mmu_pte_read(l3_physical, entry) != 0) { return false; }
            }
        }
    }
    return true;
}

fn address_space_l3_branch_physical(root: AddressSpaceRoot, branch: usize) -> usize {
    let slot: usize = root.slot;
    return address_space_l3_physical_for_branch(root, branch);
}

// Root 0 is the early-boot TTBR0_EL1 fallback and is deliberately retained
// across scheduler resets. All other fixed backing pages and their ASID are
// released only after the boundary has switched away from that root.
fn address_space_release_root(root: AddressSpaceRoot) {
    let slot: usize = root.slot;
    if (slot == 0 || scheduled_process_slot_valid(slot) == false) { return; }
    let checked: usize = slot;
    let evidence = match address_space_backing_read_checked(root) {
        AddressSpaceBackingReady::Missing => {
            address_space_backing_missing_note();
            return;
        }
        AddressSpaceBackingReady::Ready(value) => { value }
    };
    if (evidence.value.live == false) { return; }
    if (address_space_active_slot_here() == checked) {
        address_space_activate_root(address_space_boot_root());
    }
    let l1_physical: usize = evidence.value.l1_physical;
    let l2_physical: usize = evidence.value.l2_physical;
    let asid: usize = evidence.value.asid;
    address_space_release_user_mappings(root);
    let mut cleared: AddressSpaceBacking = { false, 0, 0, 0,
        evidence.value.asid_generation };
    address_space_backing_write(evidence, cleared);
    page_transferred_release_physical(l2_physical);
    page_transferred_release_physical(l1_physical);
    // GitHub issue #402: nothing gives an ASID back any more. The number
    // this root held is simply abandoned; it becomes assignable again at
    // the next rollover, which is also the moment every TLB entry tagged
    // with it disappears. Invalidating it here is still worth doing and
    // still happens, in address_space_release_user_mappings above.
}

// Called from entry.S before main(). It owns the exact early-boot sequence:
// initialise page/ASID allocation, create permanent root 0, then enable the
// MMU from root 0's resolved physical L1 and ASID.
fn kernel_mmu_init() !{mmu_off} {
    page_allocator_init();
    asid_init();
    // entry.S cleared .bss before entering this function. Rewriting this
    // aggregate while the MMU is off permits LLVM to use an unaligned
    // 128-bit store on RPi5, which faults before the bootstrap root exists.
    match address_space_ensure_boot_root() {
        AddressSpaceEnsureResult::SlotOutOfRange => {}
        AddressSpaceEnsureResult::OutOfMemory => {}
        AddressSpaceEnsureResult::Ok => {}
    }
    kernel_mmu_activate(address_space_backing_root0.l1_physical,
                        address_space_backing_root0.asid);
}

fn kernel_mmu_init_secondary() !{mmu_off} {
    kernel_mmu_activate(address_space_backing_root0.l1_physical,
                        address_space_backing_root0.asid);
}

// Root-0 compatibility helper used by boot-only probes. The production
// root-qualified operations above are the common path.
fn user_pte_clear(index: usize) {
    address_space_pte_clear(address_space_boot_root(), index);
}

fn user_pte_read(index: usize) -> usize {
    return address_space_pte_read(address_space_boot_root(), index);
}

fn process_address_space_probe_map(
        root: AddressSpaceRoot, index: usize, page: sink PageOwner[page_id]) -> bool {
    match address_space_map_page(root, index, page, USER_RW_XN_FLAGS) {
        AddressSpacePteWriteResult::Invalid => {
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            return false;
        }
        AddressSpacePteWriteResult::Written => {
            return true;
        }
    }
}

// Maps the 511 pages below the former one-L3 ceiling. Together with the
// caller's page 511 and page 512 mappings, this makes root 1 contain 513
// user pages and proves the old 512-page limit is gone without a shadow list.
fn process_address_space_probe_fill_first_branch(root: AddressSpaceRoot) -> bool {
    for index: usize in 0..<511 {
        match page_alloc(PageOwnerTag::PageTable) {
            PageAllocResult::OutOfMemory => { return false; }
            PageAllocResult::Allocated(page) => {
                if (process_address_space_probe_map(root, index, page) == false) {
                    return false;
                }
            }
        }
    }
    return true;
}

// Exercises production ownership with two temporary roots. Root 1 maps
// pages 511 and 512, on opposite sides of the former one-L3/2-MiB boundary;
// it also maps pages 0 through 510, producing 513 mapped user pages. Root 2
// maps the same low VA to a different page. The final root releases prove
// that the L3 pages and transferred user pages are all reclaimed by a table
// walk rather than by a fixed 512-entry shadow list.
fn process_address_space_probe() -> bool !{unsafe} {
    // GitHub issue #392: two roots of this probe's own. They used to be
    // the bare numbers 1 and 2, which named real roots only while any
    // index below the process ceiling was one. A root is a live process's
    // record now, so the probe allocates two processes and uses theirs.
    let root_a: usize = scheduled_process_probe_slot_acquire();
    let root_b: usize = scheduled_process_probe_slot_acquire();
    let mut root_a_root: AddressSpaceRoot = scheduled_process_address_space_root_lookup(root_a);
    let mut root_b_root: AddressSpaceRoot = scheduled_process_address_space_root_lookup(root_b);
    if (root_a == 0 || root_b == 0) {
        scheduled_process_probe_slot_release(root_b);
        scheduled_process_probe_slot_release(root_a);
        return false;
    }
    if (address_space_is_live(root_a_root) || address_space_is_live(root_b_root)) {
        scheduled_process_probe_slot_release(root_b);
        scheduled_process_probe_slot_release(root_a);
        return false;
    }
    let before: usize = page_allocator_live_count();
    let mut roots_ok: bool = true;
    match address_space_ensure_root(root_a) {
        AddressSpaceEnsureResult::Ok => {}
        AddressSpaceEnsureResult::SlotOutOfRange => { roots_ok = false; }
        AddressSpaceEnsureResult::OutOfMemory => { roots_ok = false; }
    }
    if (roots_ok) {
        match address_space_ensure_root(root_b) {
            AddressSpaceEnsureResult::Ok => {}
            AddressSpaceEnsureResult::SlotOutOfRange => { roots_ok = false; }
            AddressSpaceEnsureResult::OutOfMemory => { roots_ok = false; }
        }
    }
    if (roots_ok == false) {
        address_space_release_root(root_b_root);
        address_space_release_root(root_a_root);
        scheduled_process_probe_slot_release(root_b);
        scheduled_process_probe_slot_release(root_a);
        return false;
    }
    // GitHub issue #402: a freshly created root has NO ASID -- it takes one
    // at its first activation, which is the only moment handing out a
    // recycled number is safe. So the assertion moved: no number before,
    // distinct nonzero numbers after, and the root that was running gets
    // its own back when the probe puts it back on the CPU.
    let restore: usize = address_space_active_slot_here();
    let unassigned_ok: bool =
        address_space_asid(root_a_root) == 0 && address_space_asid(root_b_root) == 0;
    address_space_activate_root(root_a_root);
    address_space_activate_root(root_b_root);
    address_space_activate_root(scheduled_process_address_space_root_lookup(restore));
    let backing_ok: bool =
        unassigned_ok &&
        address_space_l1_physical(root_a_root) != 0 &&
        address_space_l2_physical(root_a_root) != 0 &&
        address_space_l1_physical(root_b_root) != 0 &&
        address_space_l2_physical(root_b_root) != 0 &&
        address_space_asid(root_a_root) != 0 &&
        address_space_asid(root_b_root) != 0 &&
        address_space_asid(root_a_root) != address_space_asid(root_b_root);
    if (backing_ok == false || page_allocator_live_count() != before + 4) {
       if (backing_ok) { kernel_boot_log("1"); } else { kernel_boot_log("0"); }
        kernel_boot_log(" before=");
        uart_put_udec(before);
        kernel_boot_log(" now=");
        uart_put_udec(page_allocator_live_count());
        kernel_boot_log("\n");
        address_space_release_root(root_b_root);
        address_space_release_root(root_a_root);
        scheduled_process_probe_slot_release(root_b);
        scheduled_process_probe_slot_release(root_a);
        return false;
    }
    match page_alloc(PageOwnerTag::PageTable) {
        PageAllocResult::OutOfMemory => {
            address_space_release_root(root_b_root);
            address_space_release_root(root_a_root);
            scheduled_process_probe_slot_release(root_b);
            scheduled_process_probe_slot_release(root_a);
            return false;
        }
        PageAllocResult::Allocated(page1) => {
            match page_alloc(PageOwnerTag::PageTable) {
                PageAllocResult::OutOfMemory => {
                    page_free(page1);
                    address_space_release_root(root_b_root);
                    address_space_release_root(root_a_root);
                    scheduled_process_probe_slot_release(root_b);
                    scheduled_process_probe_slot_release(root_a);
                    return false;
                }
                PageAllocResult::Allocated(page2) => {
                    match page_alloc(PageOwnerTag::PageTable) {
                        PageAllocResult::OutOfMemory => {
                            page_free(page2);
                            page_free(page1);
                            address_space_release_root(root_b_root);
                            address_space_release_root(root_a_root);
                            scheduled_process_probe_slot_release(root_b);
                            scheduled_process_probe_slot_release(root_a);
                            return false;
                        }
                        PageAllocResult::Allocated(page3) => {
                            let first_ok: bool =
                                process_address_space_probe_map(root_a_root, 511, page1);
                            let second_ok: bool =
                                process_address_space_probe_map(root_a_root, 512, page2);
                            let third_ok: bool =
                                process_address_space_probe_map(root_b_root, 511, page3);
                            let filled_first_branch: bool =
                                first_ok && second_ok && third_ok &&
                                process_address_space_probe_fill_first_branch(root_a_root);
                            // This probe deliberately dereferences two EL0
                            // virtual addresses after installing its test
                            // mappings.  The page-table setup above is the
                            // evidence; turning those calculated VAs into
                            // pointers is the explicit trust boundary.
                            let low_address: *u8 = unsafe {
                                (USER_TEXT_VA + 511 * PAGE_SIZE) as *u8
                            };
                            let high_address: *u8 = unsafe {
                                (USER_TEXT_VA + 512 * PAGE_SIZE) as *u8
                            };
                            let mut mapped_ok: bool =
                                filled_first_branch &&
                                address_space_l3_branch_physical(root_a_root, 0) != 0 &&
                                address_space_l3_branch_physical(root_a_root, 1) != 0 &&
                                address_space_l3_branch_physical(root_a_root, 0) !=
                                address_space_l3_branch_physical(root_a_root, 1) &&
                                address_space_l3_branch_physical(root_b_root, 0) != 0 &&
                                page_allocator_live_count() == before + 521;
                            if (mapped_ok == false) {
                               if (filled_first_branch) { kernel_boot_log("1"); }
                                else { kernel_boot_log("0"); }
                                kernel_boot_log("\n");
                            }
                            if (mapped_ok) {
                                address_space_activate_root(root_a_root);
                                *low_address = 11;
                                *high_address = 12;
                                address_space_activate_root(root_b_root);
                                *low_address = 22;
                                let second_low: u8 = *low_address;
                                let second_high_absent: bool =
                                    address_space_pte_read(root_b_root, 512) == 0;
                                address_space_activate_root(root_a_root);
                                let first_low: u8 = *low_address;
                                let first_high: u8 = *high_address;
                                address_space_activate_root(address_space_boot_root());
                                mapped_ok = second_low == 22 &&
                                    first_low == 11 && first_high == 12 &&
                                    second_high_absent;
                            }
                            address_space_release_root(root_b_root);
                            address_space_release_root(root_a_root);
                            let clean: bool = mapped_ok &&
                                address_space_is_live(root_a_root) == false &&
                                address_space_is_live(root_b_root) == false &&
                                page_allocator_live_count() == before;
                            if (clean == false) {
                               if (mapped_ok) { kernel_boot_log("1"); }
                                else { kernel_boot_log("0"); }
                                kernel_boot_log(" before=");
                                uart_put_udec(before);
                                kernel_boot_log(" now=");
                                uart_put_udec(page_allocator_live_count());
                                kernel_boot_log("\n");
                            }
                            scheduled_process_probe_slot_release(root_b);
                            scheduled_process_probe_slot_release(root_a);
                            return clean;
                        }
                    }
                }
            }
        }
    }
}

// GitHub issue #402 boundary test. It proves the OPPOSITE of what
// asid_pool_probe proved: there is no ASID exhaustion left to be refused
// at. It drives the REAL allocator past its last number -- 65535 of them
// on both targets, which is why this is a counter loop rather than a
// fixture that would have to create that many address spaces -- and checks
// that the generation advances exactly once, dynamic numbering restarts at
// 2 because ASID 1 remains reserved for root 0,
// every stamp from before the rollover goes stale, and no assignment ever
// fails.
//
// It lives here rather than in kernel/arch/arm64/mm/asid.tkb because of
// its last step, which is not tidiness: if a non-bootstrap root is running,
// rollover leaves its stamp behind and makes its number assignable. Every
// production rollover happens inside a switch and therefore ends with the
// incoming root taking a current number by construction; a probe that rolls
// over from outside a switch has to put the running root back on the CPU
// itself. Root 0 instead keeps reserved ASID 1. Activation is this file's to do.
const ASID_ROLLOVER_STOP_SPINS: usize = 10000000;

fn address_space_asid_rollover_probe() -> bool {
    let bits: usize = asid_width_bits();
    if (bits != 8 && bits != 16) { return false; }
    let last: usize = asid_highest_value();
    if (last != (1 << bits) - 1) { return false; }
    let generation_before: usize = asid_current_generation();
    let rollovers_before: usize = asid_rollover_count_value();
    if (asid_generation_is_current(generation_before) == false) { return false; }
    if (asid_generation_is_current(0)) { return false; }

    let mut previous: usize = 0;
    let mut ok: bool = true;
    let mut rolled: bool = false;
    let mut steps: usize = 0;
    // One full generation of assignments is enough to cross the edge from
    // wherever boot left the counter, whatever that was.
    while (steps <= last + 1 && rolled == false) {
        match asid_assign_attempt() {
            AsidAssignAttempt::Assigned(assignment) => {
                let (value, generation) = assignment;
                if (value == 0 || value > last) { ok = false; }
                if (generation == generation_before) {
                    if (value <= previous) { ok = false; }
                } else {
                    if (generation != generation_before + 1) { ok = false; }
                    if (value != 2) { ok = false; }
                    rolled = true;
                }
                previous = value;
            }
            AsidAssignAttempt::RolloverNeeded => {
                // Core 1 is already online here. Use the production stop
                // controller with its full participant set so this exercises real
                // SGIs and acknowledgements on both QEMU and RPi5.
                match world_stop_machine_begin(ASID_ROLLOVER_STOP_SPINS) {
                    MachineStopResult::Busy => { ok = false; }
                    MachineStopResult::Partial(partial) => {
                        world_stop_partial_release(
                            partial, &kernel_world_stop);
                        ok = false;
                    }
                    MachineStopResult::Complete(stopped) => {
                        if (asid_rollover_stopped(stopped) == false) {
                            ok = false;
                        }
                        machine_stop_release(stopped, &kernel_world_stop);
                    }
                }
            }
        }
        steps = steps + 1;
    }
    if (rolled == false) { ok = false; }
    if (asid_rollover_count_value() != rollovers_before + 1) { ok = false; }
    // A stamp from before is exactly what makes a live address space ask
    // for a new number instead of trusting the one it holds.
    if (asid_generation_is_current(generation_before)) { ok = false; }

    let active_before: usize = address_space_active_slot_here();
    match address_space_prepare_activation(scheduled_process_address_space_root_lookup(active_before)) {
        AddressSpaceActivationPrepareResult::Invalid => { ok = false; }
        AddressSpaceActivationPrepareResult::RolloverNeeded => { ok = false; }
        AddressSpaceActivationPrepareResult::Prepared(prepared) => {
            match address_space_commit_activation(prepared) {
                AddressSpaceActivationCommitResult::Invalid => { ok = false; }
                AddressSpaceActivationCommitResult::Activated(root) => {
                    if (address_space_root_slot(root) != active_before) { ok = false; }
                }
            }
        }
    }
    let active: usize = address_space_active_slot_here();
    let mut running: AddressSpaceBacking = address_space_backing_read_existing(scheduled_process_address_space_root_lookup(active));
    if (active != 0 &&
        asid_generation_is_current(running.asid_generation) == false) {
        ok = false;
    }
    if (running.asid == 0 || running.asid > last) { ok = false; }
    let mut bootstrap: AddressSpaceBacking = address_space_backing_read_existing(address_space_boot_root());
    if (bootstrap.asid != 1 || bootstrap.asid_generation != 1) { ok = false; }
    return ok;
}

// GitHub issue #479. Re-derived as each shared scalar moved to its real axis.
//
// address_space_active_slot USED to be the interesting one: it records
// which address space is active, which is a property of a core rather than
// of the kernel, and it was a single global. That is fixed -- it is an
// array indexed by cpu_id() now, the same shape execution_state got --
// because the problem was never contention, it was that the state had the
// wrong shape, and a lock would not have helped.
//
// The backing pool's mutation is guard-required by typing, and its ready flag
// is settled on core 0 before PSCI publishes core 1. Missing-record fallback
// storage and counts are per-core, so an invariant failure on one CPU cannot
// overwrite another CPU's evidence.
//
// Root 0's static backing is also immutable after MMU-off boot. ASID 1 is
// permanently reserved for it, and rollover invalidates every core before
// reusing dynamic ASIDs from 2 onward. Concurrent fallback activation therefore
// reads one permanent page-table/ASID tuple and writes only per-core state.
// Consequently this file no longer requires a KERNEL_ACTIVE_CORES assertion.

// Samples allocator metadata while holding only this pool allocation guard.
fn address_space_pool_space_stats() -> (usize, usize, usize, usize) !{unsafe} {
    let guard = address_space_backing_pool_lock(&address_space_backing_pool);
    let sample = region_pool_space_stats(guard);
    address_space_backing_pool_unlock(guard);
    return sample;
}
