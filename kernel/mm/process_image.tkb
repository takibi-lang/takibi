use "kernel/mm/page.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/intrusive_pool.tkb";
use "kernel/kernel/process.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/fs/elf64.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/lib/mutex.tkb";


// User-page ownership is recorded only in the page tables. Address-space
// cleanup walks populated L2 branches and their L3 PTEs, so neither image
// mappings nor clone rollback needs an enormous per-page shadow array.
private let mut process_image_zero_page: [u8; PAGE_SIZE];
// Streaming ELF source selected only for the ext2-backed map entry point.
// The metadata window still contains the ELF header/program table; file
// bytes for PT_LOAD pages are fetched one filesystem block at a time.
private let mut process_image_ext2_active: bool;
private let mut process_image_ext2_mount: Ext2Mount;
private let mut process_image_ext2_inode: usize;
private let mut process_image_ext2_length: usize;
private let mut process_image_ext2_block: [u8; KERNEL_BLOCK_SIZE];
// A dynamic ELF pair changes backing files between the application's and
// interpreter's PT_LOAD passes. These fields carry that second source only
// for the synchronous pair mapper below.
private let mut process_image_pair_ext2_active: bool;
private let mut process_image_pair_ext2_mount: Ext2Mount;
private let mut process_image_pair_ext2_inode: usize;
private let mut process_image_pair_ext2_length: usize;

fn process_image_ext2_source(mount: Ext2Mount, inode: usize,
                             length: usize) {
    process_image_ext2_mount = mount;
    process_image_ext2_inode = inode;
    process_image_ext2_length = length;
    process_image_ext2_active = true;
}

fn process_image_ext2_source_clear() {
    process_image_ext2_active = false;
    process_image_ext2_inode = 0;
    process_image_ext2_length = 0;
}

fn process_image_pair_ext2_source(mount: Ext2Mount, inode: usize,
                                  length: usize) {
    process_image_pair_ext2_mount = mount;
    process_image_pair_ext2_inode = inode;
    process_image_pair_ext2_length = length;
    process_image_pair_ext2_active = true;
}

fn process_image_pair_ext2_source_clear() {
    process_image_pair_ext2_active = false;
    process_image_pair_ext2_inode = 0;
    process_image_pair_ext2_length = 0;
}
// GitHub issue #448: how many pages the LAST reap gave back, which is a
// report about an event rather than about a process, so it stays here.
// What used to sit beside it -- the source root, the destination root, and
// the running page count of "the clone in flight" -- moved into the
// destination's own ProcessImageRecord, because there is no longer one
// clone in flight. See ProcessCloneVm* below for what that ceiling cost.
private let mut clone_last_reaped_count: usize;
// GitHub issues #258 and #264: one persistent record per address-space
// root, replacing the prior ProcessLayout table plus the separate flattened
// growth-page array. Its scalar fields are ProcessLayout's former fields,
// kept flat so their existing direct accesses stay simple; the growth-page
// list is now attached to the same root it describes.
//
// The layout is now per-process DATA, set once when an image is mapped
// and read everywhere else -- which is what lets two processes differ
// (the static-PIE and dynamic/musl paths already wanted different stack
// floors, 448 vs 504, and expressed that as two separate global
// constants each consulted from its own set of sites). GitHub issue #254
// needs exactly this: a process whose address space is bigger than one
// L3 table gets a different `stack_top_page`, with no constant to chase.
//
// Same "one managed thing, one struct" rule as kernel/mm/page.tkb's
// PageMeta (issue #253): a future per-address-space field belongs here,
// not in another root-indexed global.
struct ProcessImageRecord {
    // Live state.
    active_page_count: usize;
    stack_lowest_l3: usize;      // current downward extent of the stack
    stack_growth_active: bool;
    // Layout proper.
    stack_top_page: usize;       // highest page; the initial stack page
    stack_low_page: usize;       // lowest page the stack may ever occupy
    heap_page_count: usize;
    // GitHub issue #392: the exec image installed against this root, as
    // the two facts the reap path actually asks of it. It was a parked
    // linear ProcessImagePages in an array keyed by root -- see
    // process_image_exec_install for what that array was and why the
    // parking lot is gone rather than pooled.
    exec_image_installed: bool;
    exec_image_page_count: usize;
    // GitHub issue #448: the fork that produced this root, while it is
    // still outstanding -- the pages copied into it are the parent's,
    // shared copy-on-write, and stay owed back until this process execs
    // (replacing them) or exits (releasing them).
    //
    // This was a global singleton: one `linear view` parked in a
    // mutex-guarded store, plus a source root, a destination root and a
    // page count beside it. That is an N=1 ceiling, and a second fork
    // taken before the first child had exec'd got -EAGAIN. BusyBox init
    // forks its `respawn` entries back to back, so a `/etc/inittab` with
    // more than one of them failed at the second entry with "can't fork"
    // -- and init never retries an entry whose fork failed, so that entry
    // was simply gone for the life of the boot.
    //
    // Per-record for the same reason exec_image_installed above is: the
    // thing owed back belongs to one process, so it is described by that
    // process's own record rather than by a global that can only ever
    // describe one of them.
    //
    // What that costs, stated plainly: the singleton could be a LINEAR
    // owner, and linearity is what made "reaped exactly once" a compile
    // error to get wrong. A flag is not that. The trade is not a
    // preference -- an erased `linear view` cannot be tied to a runtime
    // address, so there is no way to mint one proof per record and have
    // the checker know which record it belongs to; the same wall the
    // slot-overlay investigation hit. exec_image_installed above made the
    // same trade for the same reason, and the detector that replaces the
    // proof is also the same: the end-of-boot accounting fails if a page
    // or a pooled record does not come back.
    clone_vm_outstanding: bool;
    clone_vm_source_root: usize;
    clone_vm_page_count: usize;
}

// GitHub issue #392: pooled, not an array keyed by process slot. See
// kernel/kernel/fd_table.tkb's own note -- an array keyed by a slot cannot
// outlive the slot, and the slot is the ceiling being removed. The handle
// lives in ProcessRecord (image_record / image_record_generation).
private let mut process_image_pool: IntrusivePool(ProcessImageRecord);
private let mut process_image_pool_ready: bool = false;

// Reached only when a record is needed and the page allocator cannot
// provide one. Every other "this root has no record yet" is handled by
// allocating one -- see process_image_record_at, which preserves exactly
// what the array provided: a record exists for any root anyone names.
// Genuine exhaustion has nowhere to be reported from sixty-odd field
// accesses, so it lands here and is COUNTED, and the count is printed at
// the end of the boot suite. That is the difference between a fallback
// and a silent one.
private let mut process_image_record_missing: ProcessImageRecord;
private let mut process_image_record_missing_count: usize = 0;

fn process_image_record_missing_uses() -> usize {
    return process_image_record_missing_count;
}

// GitHub issue #392: how many root records the pool is holding. A
// create-and-reap cycle must give every one of them back, and
// scheduled_process_table_probe asserts exactly that -- the detector for
// this release path, built in with it rather than after the first leak.
fn process_image_record_live_count() -> usize !{unsafe} {
    process_image_pool_init();
    return intrusive_pool_live_count(&process_image_pool);
}

private fn process_image_pool_init() {
    if (process_image_pool_ready) { return; }
    process_image_pool_ready = true;
    intrusive_pool_init(&process_image_pool);
}

// The record for a root, allocating one if this root has none.
//
// Allocating here rather than only at process creation is what keeps the
// array's own contract: a root that anyone names has a record, whether or
// not a scheduler slot was ever allocated for it. Probes name roots
// directly (with a slot from scheduled_process_probe_slot_acquire), and
// the clone paths name a
// destination root before it is anybody's process -- 1648 such accesses on
// one boot, which is what a fallback would have been quietly absorbing.
//
// scheduled_process_alloc still ensures one up front, so ordinary process
// creation reports exhaustion where it can roll back rather than in the
// middle of mapping an image.
private fn process_image_record_at(root: usize) -> *ProcessImageRecord !{unsafe} {
    if (process_image_record_ensure(root) == false) {
        process_image_record_missing_count =
            process_image_record_missing_count + 1;
        return &process_image_record_missing;
    }
    let mut address: IntrusiveSlotAddress = scheduled_process_image_record(root);
    let generation: usize = scheduled_process_image_record_generation(root);
    if (intrusive_slot_address_is_none(address)) {
        process_image_record_missing_count =
            process_image_record_missing_count + 1;
        return &process_image_record_missing;
    }
    let owner = intrusive_owner_new(&process_image_pool, address, generation);
        // GitHub issue #488: this RETURNS the pointer, so it cannot
        // hold the proof for the pointer's life. The unproven form
        // names that and counts it in the trusted base; removing it
        // means migrating this accessor's callers to hold the view
        // themselves.
    let record: *ProcessImageRecord =
        intrusive_pool_ref_unproven(&process_image_pool, owner);
    intrusive_owner_drop(owner);
    return record;
}

// The state a root's record starts in, written down rather than left as
// whatever insert_zeroed produced (issue #392). Zero is not the fresh
// value of stack_lowest_l3: the stack grows DOWNWARD from the top page,
// so "nothing grown yet" is the top page, not 0. It is only unread today
// because stack_growth_active gates it, which is an argument the next
// reader should not have to reconstruct.
private fn process_image_record_reset(record: borrow *ProcessImageRecord) {
    record.active_page_count = 0;
    record.stack_growth_active = false;
    record.stack_lowest_l3 = process_stack_top_page();
    record.stack_top_page = process_stack_top_page();
    record.stack_low_page = PROCESS_STACK_LOW_STATIC;
    record.heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;
    record.exec_image_installed = false;
    record.exec_image_page_count = 0;
}

// Acquired by scheduled_process_alloc for every process, by
// kernel_syscall_process_configure for the bootstrap, and on demand by
// process_image_record_at for any other root a caller names. Idempotent.
//
// Released by scheduled_process_reap and scheduled_process_table_clear,
// beside the fd context and the address-space root, EXCEPT for root 0 --
// the permanent bootstrap root, whose record is set up once during boot
// and read on every later stack fault, exactly the exemption
// address_space_release_root already makes one layer down.
//
// It did not always release. The array this replaced kept a root's record
// for the life of the kernel, so a lifetime change had to be made
// deliberately rather than smuggled in alongside a storage change -- and
// it is observable: an earlier attempt without the root-0 exemption cost
// one boot to find, via the "shell stack: demand-grown" evidence line
// going missing. It has to release now, because what bounded the number
// of live records was the process table's size.
fn process_image_record_ensure(root: usize) -> bool !{unsafe} {
    process_image_pool_init();
    let mut address: IntrusiveSlotAddress = scheduled_process_image_record(root);
    let generation: usize = scheduled_process_image_record_generation(root);
    if (intrusive_slot_address_is_none(address) == false && intrusive_pool_matches(
            &process_image_pool, address, generation)) {
        return true;
    }
    let guard = intrusive_pool_lock(&process_image_pool);
    let result = intrusive_pool_insert_zeroed(&process_image_pool, guard);
    intrusive_pool_unlock(&process_image_pool, guard);
    match result {
        IntrusivePoolInsertResult::OutOfMemory => { return false; }
        IntrusivePoolInsertResult::Allocated(owner) => {
            let mut slot: IntrusiveSlotAddress = intrusive_owner_slot(owner);
            let stamp: usize = intrusive_owner_generation(owner);
            let record: *ProcessImageRecord =
                intrusive_pool_ref(&process_image_pool, owner);
            process_image_record_reset(record);
            intrusive_owner_drop(owner);
            scheduled_process_set_image_record(root, slot, stamp);
            return true;
        }
    }
}

// GitHub issue #392: gives a root's record back. Root 0 keeps its record
// for the life of the kernel -- see process_image_record_ensure's own note
// for why that is the bootstrap root's exemption and not a leak.
fn process_image_record_release(root: usize) !{unsafe} {
    if (root == 0) { return; }
    let mut address: IntrusiveSlotAddress = scheduled_process_image_record(root);
    if (intrusive_slot_address_is_none(address)) { return; }
    // Read the generation BEFORE clearing the handle, or the owner
    // rebuilt below names the right slot with the wrong occupant and the
    // pool correctly refuses it.
    let generation: usize = scheduled_process_image_record_generation(root);
    scheduled_process_set_image_record(root, intrusive_slot_address_none(), 0);
    let owner = intrusive_owner_new(&process_image_pool, address, generation);
    let guard = intrusive_pool_lock(&process_image_pool);
    let (ok, reason) = intrusive_remove_outcome(
        intrusive_pool_remove(&process_image_pool, guard, owner));
    intrusive_pool_unlock(&process_image_pool, guard);
    if (ok == false) {
        kernel_boot_log("process image: releasing a root record -- ");
        kernel_boot_log(reason);
        kernel_boot_log("\n");
    }
}

// GitHub issue #479: which root an image operation is aimed at, set when
// one begins and cleared when it ends -- so it is PER-OPERATION state, and
// on two cores that means per-core. A single global held one answer for
// two concurrent operations, and each would overwrite the other's target
// between the set and the read.
//
// This variable has already produced a real fault on one core. Issue
// #437's RPi5-only failure was it left at 0 on wait4's fast path, aiming
// the COW handler at PID 1's live image -- and that took a hardware bisect
// to find, with only one writer. Two writers would reach the same class of
// wrong root without needing the fast path's help.
//
// An array indexed by cpu_id(), sized by KERNEL_MAX_CORES, the same shape
// execution_state and address_space_active_slot have. Not a lock: the
// state is not shared, it is per-core state that was stored as though it
// were global, and making two cores agree on it would be agreeing on the
// wrong thing.
private let mut process_image_target_root: [usize; KERNEL_MAX_CORES];
// Root 0 is a real target, so zero-initialization cannot also mean that no
// image operation has selected a target. Keep that state separately and
// make teardown open the result before it can touch any mappings.
private let mut process_image_target_root_set: [bool; KERNEL_MAX_CORES];

private fn process_image_target_root_here() -> usize {
    let base: *usize = process_image_target_root;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return *base; }
    return *(base + (core as isize));
}

private fn process_image_set_target_root_here(root: usize) {
    let base: *usize = process_image_target_root;
    let set_base: *bool = process_image_target_root_set;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) {
        *base = root;
        *set_base = true;
        return;
    }
    *(base + (core as isize)) = root;
    *(set_base + (core as isize)) = true;
}

private fn process_image_clear_target_root_here() {
    let base: *usize = process_image_target_root;
    let set_base: *bool = process_image_target_root_set;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) {
        *base = 0;
        *set_base = false;
        return;
    }
    *(base + (core as isize)) = 0;
    *(set_base + (core as isize)) = false;
}

private fn process_image_target_root_is_set_here() -> bool {
    let base: *bool = process_image_target_root_set;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return *base; }
    return *(base + (core as isize));
}

// GitHub issue #392: a root is a process slot, and a process slot is a
// pool address now, so there is no range to narrow it into. The question
// the refinement stood in for -- does this name a real root -- is asked of
// scheduled_process_slot_valid, which answers about a LIVE process rather
// than about an index being in bounds. Root 0 is the bootstrap and always
// valid.
private let mut process_image_root_fallback_count: usize = 0;

// A target that was never set, or a target root that no longer names a live
// process. Readers retain the old root-0 fallback because their many call
// sites cannot act on a miss; teardown opens ProcessImageTargetRootResult
// and does nothing. Both paths count the miss rather than hiding it.
fn process_image_root_fallback_uses() -> usize {
    return process_image_root_fallback_count;
}

// GitHub issue #492: lookups that named an image slot with the previous
// occupant's generation.
fn process_image_recycled_handle_count() -> usize !{unsafe} {
    if (process_image_pool_ready == false) { return 0; }
    return intrusive_pool_recycled_handle_count(&process_image_pool);
}

must_use variant ProcessImageTargetRootResult {
    Missing;
    Ready(usize);
}

private fn process_image_target_root_result()
        -> ProcessImageTargetRootResult !{unsafe} {
    if (process_image_target_root_is_set_here() &&
        scheduled_process_slot_valid(process_image_target_root_here())) {
        return ProcessImageTargetRootResult::Ready(
            process_image_target_root_here());
    }
    process_image_root_fallback_count =
        process_image_root_fallback_count + 1;
    return ProcessImageTargetRootResult::Missing;
}

fn process_image_root_index() -> usize !{unsafe} {
    match process_image_target_root_result() {
        ProcessImageTargetRootResult::Missing => { return 0; }
        ProcessImageTargetRootResult::Ready(root) => { return root; }
    }
}

fn process_image_pte_read(index: usize) -> usize {
    return address_space_pte_read(process_image_target_root_here(), index);
}

fn process_image_pte_write(index: usize, value: usize)
        -> AddressSpacePteWriteResult {
    return address_space_pte_write(process_image_target_root_here(), index, value);
}

fn process_image_pte_clear(index: usize) {
    address_space_pte_clear(process_image_target_root_here(), index);
}

fn process_image_pte_invalidate(index: usize) {
    address_space_tlb_invalidate(process_image_target_root_here(),
                                 USER_TEXT_VA + index * PAGE_SIZE);
}

// Do not transfer PageOwner until the lazy-L3 allocation and PTE write have
// both succeeded. This is the mapping-side half of address_space.tkb's OOM
// contract; the failure arm returns the still-owned physical page directly.
fn process_image_install_page(page: sink PageOwner[page_id],
                              index: usize, flags: usize) -> bool {
    match address_space_map_page(
            process_image_target_root_here(), index, page, flags) {
        AddressSpacePteWriteResult::Invalid => {
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            return false;
        }
        AddressSpacePteWriteResult::Written => {
            return true;
        }
    }
}

must_use variant ProcessCloneVmResult { OutOfMemory; Copied; }
must_use variant ProcessCloneVmReapResult { Missing; Reaped; }

// GitHub issue #258 step 2: `process_stack_top_page() = 511` is gone -- the
// initial stack always sits on the address space's own last page, so it is
// derived rather than stored or restated. (A `const` cannot do this: a
// top-level const initializer may not do arithmetic on another file's
// identifier, and USER_SPACE_PAGE_COUNT lives in address_space.tkb.)
fn process_stack_top_page() -> usize {
    return USER_SPACE_PAGE_COUNT - 1;
}

// Seeds for ProcessImageRecord.stack_low_page -- the lowest page the stack may
// ever occupy, and the ONLY part of the layout that genuinely differs
// between the two loader paths. These are now defaults consulted once
// each, where an image is mapped, rather than global constants consulted
// as decision points from a dozen scattered sites; every reader goes
// through process_image_record_at(root).stack_low_page.
//
// Static path: 256 KiB is a bounded virtual reservation, not an eager
// allocation. It leaves the static BusyBox heap (ending at page 419)
// below the reservation. The unmapped page immediately below it is the
// guard page; #198 only maps pages in this interval after an EL0
// translation fault.
const PROCESS_STACK_LOW_STATIC: usize = 448;
// Dynamic/musl path: a smaller reservation, since that image's own heap
// reaches higher.
const PROCESS_STACK_LOW_DYNAMIC: usize = 504;
// BYTES, not pages: how much room at the very top of the initial stack
// page is reserved for the argv/envp/auxv block. Unrelated to the address
// space's own page count despite both having been 512 (see
// kernel/mm/address_space.tkb's USER_SPACE_PAGE_COUNT comment -- issue
// #253 briefly conflated the two by reusing this name as a table bound;
// issue #258 separated them again).
const PROCESS_STACK_LAYOUT_BYTES: usize = 512;
const PROCESS_STACK_WORDS: usize = PROCESS_STACK_LAYOUT_BYTES / 8;
// Seed for ProcessImageRecord.heap_page_count (see PROCESS_STACK_LOW_*
// above): consulted only where an image is mapped, never as a
// decision point elsewhere.
const PROCESS_HEAP_PAGES_DEFAULT: usize = 128;
const USER_SPACE_BYTES: usize = 0x40000000;
const PROCESS_DYNAMIC_STACK_INITIAL_PAGES: usize = 8;
const AT_PHDR: usize = 3;
const AT_PHENT: usize = 4;
const AT_PHNUM: usize = 5;
const AT_PAGESZ: usize = 6;
const AT_BASE: usize = 7;
const AT_ENTRY: usize = 9;
const AT_SECURE: usize = 23;
const AT_RANDOM: usize = 25;
const AT_UID: usize = 11;
const AT_EUID: usize = 12;
const AT_GID: usize = 13;
const AT_EGID: usize = 14;
const AT_EXECFN: usize = 31;

// The userspace ABI is little-endian AArch64. Keep the stack as the byte
// slice carried by PageOwner and encode words explicitly; this avoids
// discarding the page view's bounds/ownership evidence by minting a u64*.
fn process_stack_store_word(stack: borrow [u8; PROCESS_STACK_LAYOUT_BYTES..],
                            index: {0..<PROCESS_STACK_WORDS as usize},
                            value: u64) {
    let offset: usize = index * 8;
    stack[offset] = value as u8;
    stack[offset + 1] = (value >> 8) as u8;
    stack[offset + 2] = (value >> 16) as u8;
    stack[offset + 3] = (value >> 24) as u8;
    stack[offset + 4] = (value >> 32) as u8;
    stack[offset + 5] = (value >> 40) as u8;
    stack[offset + 6] = (value >> 48) as u8;
    stack[offset + 7] = (value >> 56) as u8;
}

fn process_stack_load_word(stack: borrow [u8; PROCESS_STACK_LAYOUT_BYTES..],
                           index: {0..<PROCESS_STACK_WORDS as usize}) -> u64 {
    let offset: usize = index * 8;
    return (stack[offset] as u64) |
           ((stack[offset + 1] as u64) << 8) |
           ((stack[offset + 2] as u64) << 16) |
           ((stack[offset + 3] as u64) << 24) |
           ((stack[offset + 4] as u64) << 32) |
           ((stack[offset + 5] as u64) << 40) |
           ((stack[offset + 6] as u64) << 48) |
           ((stack[offset + 7] as u64) << 56);
}

// Give back everything a clone into `dest` had taken, and leave that
// root describing no clone. Safe to call on a root whose clone never got
// far enough to be recorded: the fields it clears are already clear.
fn process_clone_vm_rollback(dest: usize) {
    address_space_release_user_mappings(dest);
    if (scheduled_process_slot_valid(dest)) {
        let root: usize =
            process_image_narrow_root(dest);
        process_image_record_at(root).active_page_count = 0;
        process_image_record_at(root).stack_growth_active = false;
        process_image_record_at(root).stack_lowest_l3 = process_stack_top_page();
        process_image_record_at(root).clone_vm_outstanding = false;
        process_image_record_at(root).clone_vm_page_count = 0;
    }
}

// GitHub issue #245: dest_root is the caller's choice, not a fixed "root
// 1" -- process.tkb's kernel_process_clone_begin() allocates the child's
// process-table slot first and passes that slot's index straight through,
// so root index == ProcessHandle.pool_index holds everywhere. The source
// is always process_image_target_root (whichever root is currently
// active), not a fixed "root 0" -- a process running on any root can
// fork, not just the one on root 0.
fn process_image_narrow_root(value: usize) -> usize !{unsafe} {
    if (scheduled_process_slot_valid(value)) { return value; }
    return 0;
}

fn process_image_clone_vm_begin(dest_root: usize) -> ProcessCloneVmResult !{unsafe} {
    if (scheduled_process_slot_valid(dest_root) == false ||
        dest_root == process_image_target_root_here() ||
        address_space_is_live(dest_root) == false) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    let dest: usize =
        process_image_narrow_root(dest_root);
    let source: usize = process_image_target_root_here();
    // GitHub issue #448: a clone already owed back on this root would be
    // leaked by overwriting its bookkeeping. It cannot happen (a root
    // belongs to one process, and that process cannot fork into itself),
    // and refusing says so rather than assuming it.
    if (process_image_record_at(dest).clone_vm_outstanding) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    process_image_record_at(dest).clone_vm_source_root = source;
    process_image_record_at(dest).clone_vm_page_count = 0;
    let mut clone_page_count: usize = 0;
    address_space_clear_root(dest_root);
    // Reset the destination root's demand-stack metadata before rebuilding
    // it below, the same way process_image_map_current() resets its own
    // root's before mapping a fresh image -- otherwise a reaped child's
    // stale counts would leak into the next fork.
    process_image_record_at(dest).stack_growth_active = false;
    process_image_record_at(dest).active_page_count = 0;
    process_image_record_at(dest).stack_lowest_l3 = process_stack_top_page();
    // GitHub issue #258 step 2: a child inherits the parent's layout, not a
    // global constant -- which is the whole point of the layout being data.
    let clone_src: usize =
        process_image_narrow_root(source);
    process_image_record_at(dest).stack_top_page = process_stack_top_page();
    process_image_record_at(dest).stack_low_page =
        process_image_record_at(clone_src).stack_low_page;
    process_image_record_at(dest).heap_page_count =
        process_image_record_at(clone_src).heap_page_count;
    // Tracks the lowest growth-region L3 index actually copied below, so the
    // child's watermark reflects its real page table rather than being
    // inherited verbatim from the parent's own
    // process_image_record_at(source).stack_lowest_l3 bookkeeping, which only
    // describes the parent's own demand-grown pages, not the child's.
    let mut clone_stack_lowest_l3: usize = process_stack_top_page();
    // GitHub issue #392: one BRANCH at a time. A branch with no L3 table
    // has no present PTEs, so the old flat 0..<USER_SPACE_PAGE_COUNT walk
    // asked 511 of every 512 questions for nothing -- 262144 validated
    // reads per fork, and forks are what this kernel does most. Same
    // answer, same order (l3_index still ascends), ~200x less of it.
    for branch: usize in 0..<USER_L2_BRANCH_COUNT {
      if (address_space_l3_branch_physical(source, branch) == 0) {
        continue;
      }
      for entry: usize in 0..<USER_L3_PAGE_COUNT {
        let l3_index: usize = branch * USER_L3_PAGE_COUNT + entry;
        let parent_pte: usize = address_space_pte_read(source, l3_index);
        if (parent_pte != 0) {
            let parent_physical: usize = parent_pte & USER_PAGE_PHYS_MASK;
            match page_mapping_retain_physical(parent_physical,
                                               address_space_live_count()) {
                PageMappingRetainResult::Retained => {}
                PageMappingRetainResult::NotMapped => {
                    process_clone_vm_rollback(dest_root);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                PageMappingRetainResult::RefCeilingReached => {
                    // Issue #406: not exhaustion. A page mapped into more
                    // address spaces than exist says the count no longer
                    // matches reality, and this is the one real mapping
                    // path, so this is where it is recorded. The clone is
                    // still rolled back: refusing is what keeps a broken
                    // invariant from becoming a broken address space.
                    page_mapping_ref_bound_break();
                    process_clone_vm_rollback(dest_root);
                    return ProcessCloneVmResult::OutOfMemory;
                }
            }
            let mut child_pte: usize = parent_pte;
            if (address_space_pte_is_writable(parent_pte)) {
                child_pte = address_space_pte_cow_value(parent_pte);
            }
            match address_space_pte_write(dest_root, l3_index, child_pte) {
                AddressSpacePteWriteResult::Invalid => {
                    page_mapping_release_physical(parent_physical);
                    process_clone_vm_rollback(dest_root);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    page_mapping_release_physical(parent_physical);
                    process_clone_vm_rollback(dest_root);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                AddressSpacePteWriteResult::Written => {
                    address_space_tlb_invalidate(
                        dest_root, USER_TEXT_VA + l3_index * PAGE_SIZE);
                    if (address_space_pte_is_writable(parent_pte)) {
                        match address_space_pte_write(
                                source, l3_index,
                                address_space_pte_cow_value(parent_pte)) {
                            AddressSpacePteWriteResult::Invalid => {
                                process_clone_vm_rollback(dest_root);
                                return ProcessCloneVmResult::OutOfMemory;
                            }
                            AddressSpacePteWriteResult::OutOfMemory => {
                                process_clone_vm_rollback(dest_root);
                                return ProcessCloneVmResult::OutOfMemory;
                            }
                            AddressSpacePteWriteResult::Written => {
                                address_space_tlb_invalidate(
                                    source, USER_TEXT_VA + l3_index * PAGE_SIZE);
                            }
                        }
                    }
                    clone_page_count = clone_page_count + 1;
                    if (l3_index >=
                            process_image_record_at(clone_src).stack_low_page &&
                        l3_index < process_stack_top_page() &&
                        l3_index < clone_stack_lowest_l3) {
                        clone_stack_lowest_l3 = l3_index;
                    }
                }
            }
        }
      }
    }
    if (clone_page_count == 0) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    // The copy loop above mirrors every present parent PTE (including any
    // stack pages the parent had already demand-faulted in) into the
    // destination root, so the child gets its own demand-stack watermark
    // derived from what was actually copied. Without this, a forked child
    // fail-stops the instant it grows its stack past whatever was already
    // mapped at fork time (issue #219).
    process_image_record_at(dest).active_page_count = clone_page_count;
    process_image_record_at(dest).stack_growth_active = true;
    process_image_record_at(dest).stack_lowest_l3 = clone_stack_lowest_l3;
    process_image_record_at(dest).clone_vm_page_count = clone_page_count;
    process_image_record_at(dest).clone_vm_outstanding = true;
    return ProcessCloneVmResult::Copied;
}

// GitHub issue #245: replaces the old activate_parent()/activate_child()
// pair, which hardcoded root 0 ("parent") and root 1 ("child") as global
// roles. Callers now track their own parent/child root relationships
// (process.tkb's per-slot ProcessHandle.pool_index) and pass the explicit
// root they mean, since with more than one live clone in the tree "the
// child" and "the parent" are relative to whoever is switching, not fixed
// numbers.
fn process_image_activate_root(root: usize) {
    if (scheduled_process_slot_valid(root) == false) { return; }
    process_image_set_target_root_here(root);
    address_space_activate_root(root);
    kernel_process_trace_address_space_activate(root);
}

// Give the parent's copy-on-write pages back and put the parent's root
// into TTBR0 again. `dest_root` is the root the clone was made INTO -- the
// caller's own, at every one of the three call sites, since a clone is
// reaped by the process that received it (when it execs, when it exits, or
// when the rest of the clone failed under it).
//
// GitHub issue #448: this used to take no argument and read the one clone
// the kernel could have in flight out of a global. Naming the root is what
// lets two of them be outstanding at once.
fn process_image_clone_vm_reap(dest_root: usize) -> ProcessCloneVmReapResult {
    if (scheduled_process_slot_valid(dest_root) == false) {
        return ProcessCloneVmReapResult::Missing;
    }
    let dest: usize = process_image_narrow_root(dest_root);
    if (process_image_record_at(dest).clone_vm_outstanding == false) {
        return ProcessCloneVmReapResult::Missing;
    }
    let count: usize = process_image_record_at(dest).clone_vm_page_count;
    let source: usize = process_image_record_at(dest).clone_vm_source_root;
    process_clone_vm_rollback(dest_root);
    process_image_activate_root(source);
    clone_last_reaped_count = count;
    return ProcessCloneVmReapResult::Reaped;
}

fn process_image_clone_vm_reaped_pages() -> usize {
    return clone_last_reaped_count;
}

// GitHub issue #219 verification: process_image_clone_vm_begin() must
// initialize root 1's demand-stack metadata so process_image_handle_data_
// abort() can grow the child's stack past whatever was mapped at fork
// time, instead of fail-stopping. Exercises the real clone_vm_begin/
// handle_data_abort/clone_vm_reap sequence directly against a synthetic
// single-page root-0 image (bypassing the ELF loader, which nothing here
// depends on), because neither real EL0 process that forks in this kernel
// can exercise it: the tiny fixed-layout initial bootstrap process has a
// whole address space smaller than one growth-region page (never meant to
// support stack growth at all), and the pinned Alpine BusyBox binary's
// recursion depth is not something this test controls.
fn process_image_clone_growth_probe() -> bool !{unsafe} {
    process_image_set_target_root_here(0);
    // GitHub issue #392: the child root is a live process's record now,
    // not the bare number 1 -- see
    // scheduled_process_probe_slot_acquire for why a probe has to be a
    // process to have a root of its own.
    let child_root: usize = scheduled_process_probe_slot_acquire();
    if (child_root == 0) { return false; }
    if (address_space_is_live(child_root)) {
        scheduled_process_probe_slot_release(child_root);
        return false;
    }
    match address_space_ensure_root(child_root) {
        AddressSpaceEnsureResult::Ok => {}
        AddressSpaceEnsureResult::SlotOutOfRange => {
            scheduled_process_probe_slot_release(child_root);
            return false;
        }
        AddressSpaceEnsureResult::OutOfMemory => {
            scheduled_process_probe_slot_release(child_root);
            return false;
        }
    }
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            address_space_release_root(child_root);
            scheduled_process_probe_slot_release(child_root);
            return false;
        }
        PageAllocResult::Allocated(stack_page) => {
            match address_space_map_page(
                    0, process_stack_top_page(), stack_page, USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    address_space_release_root(child_root);
                    scheduled_process_probe_slot_release(child_root);
                    return false;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    address_space_release_root(child_root);
                    scheduled_process_probe_slot_release(child_root);
                    return false;
                }
                AddressSpacePteWriteResult::Written => {
                }
            }
        }
    }
    // Mirrors exactly the metadata process_image_map_current() sets after
    // mapping a fresh image's single top stack page: growth enabled, one
    // page active, nothing yet grown below the top.
    process_image_record_at(0).stack_growth_active = true;
    process_image_record_at(0).active_page_count = 1;
    process_image_record_at(0).stack_lowest_l3 = process_stack_top_page();
    process_image_record_at(0).stack_top_page = process_stack_top_page();
    process_image_record_at(0).stack_low_page = PROCESS_STACK_LOW_STATIC;
    process_image_record_at(0).heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;

    let mut ok: bool = true;
    // GitHub issue #438: unset is distinct from selecting the real root 0.
    // Exercise the actual teardown helper while root 0 has both a mapping
    // and live demand-stack metadata. A miss must be counted and must not
    // turn into cleanup of the bootstrap address space. Restore the count
    // afterwards so this deliberate negative control does not masquerade
    // as a fault in the healthy-boot evidence.
    let fallback_before: usize = process_image_root_fallback_count;
    process_image_clear_target_root_here();
    process_image_unmap_pages(1);
    if (process_image_root_fallback_count != fallback_before + 1 ||
        address_space_pte_read(0, process_stack_top_page()) == 0 ||
        process_image_record_at(0).stack_growth_active == false ||
        process_image_record_at(0).active_page_count != 1 ||
        process_image_record_at(0).stack_lowest_l3 != process_stack_top_page()) {
        ok = false;
    }
    process_image_root_fallback_count = fallback_before;
    process_image_set_target_root_here(0);
    let mut cow_parent_physical: usize = 0;
    match process_image_clone_vm_begin(child_root) {
        ProcessCloneVmResult::OutOfMemory => { ok = false; }
        ProcessCloneVmResult::Copied => {}
    }

    if (ok) {
        process_image_activate_root(child_root);
        // fork must initially share the parent's top stack page, with both
        // PTEs marked COW. A simulated EL0 write-permission fault then gives
        // only root 1 a private writable page while root 0 retains the
        // original shared frame.
        let top_page: usize = process_stack_top_page();
        let parent_before: usize = address_space_pte_read(0, top_page);
        let child_before: usize = address_space_pte_read(child_root, top_page);
        if ((parent_before & USER_PAGE_PHYS_MASK) !=
                    (child_before & USER_PAGE_PHYS_MASK) ||
            address_space_pte_is_cow(parent_before) == false ||
            address_space_pte_is_cow(child_before) == false) {
            ok = false;
        }
        cow_parent_physical = parent_before & USER_PAGE_PHYS_MASK;
        // EC=0x24, WnR=1, DFSC=0x0f: EL0 write permission fault on the
        // child's present COW PTE.
        let cow_esr: usize = 0x9000004F;
        let cow_fault: usize = USER_TEXT_VA + top_page * PAGE_SIZE;
        if (ok && (process_image_handle_data_abort(cow_esr, cow_fault) == false ||
            address_space_pte_is_cow(address_space_pte_read(child_root, top_page)) ||
            address_space_pte_is_writable(address_space_pte_read(child_root, top_page)) == false ||
            (address_space_pte_read(0, top_page) & USER_PAGE_PHYS_MASK) ==
                (address_space_pte_read(child_root, top_page) & USER_PAGE_PHYS_MASK))) {
            ok = false;
        }
        // EC=0x24 (data abort from a lower EL), DFSC=0x07 (translation
        // fault, level 3) for a missing PTE in the already-populated top
        // L3 branch.
        let l3_esr: usize = 0x90000007;
        let first_page: usize = process_stack_top_page() - 11;
        let first_fault: usize = USER_TEXT_VA + first_page * PAGE_SIZE;
        if (process_image_handle_data_abort(l3_esr, first_fault) == false ||
            address_space_pte_read(child_root, first_page) == 0) {
            ok = false;
        }
        // Crossing into branch 510 finds no L3 descriptor at all, producing
        // DFSC=0x06 (translation fault, level 2). The handler must create
        // that L3 page and map the gap in one call.
        let l2_esr: usize = 0x90000006;
        let second_page: usize = process_stack_top_page() - 512;
        let second_fault: usize = USER_TEXT_VA + second_page * PAGE_SIZE;
        if (ok && (process_image_handle_data_abort(l2_esr, second_fault) == false ||
            address_space_pte_read(child_root, second_page) == 0 ||
            address_space_pte_read(child_root, second_page + 1) == 0 ||
            address_space_pte_read(child_root, first_page - 1) == 0)) {
            ok = false;
        }
        process_image_activate_root(0);
    }

    match process_image_clone_vm_reap(child_root) {
        ProcessCloneVmReapResult::Missing => {}
        ProcessCloneVmReapResult::Reaped => {}
    }
    // Once the child mapping is reaped, the parent owns its original COW
    // page alone. Resolving it must restore write permission in place rather
    // than allocate another page under memory pressure.
    let parent_after_reap: usize =
        address_space_pte_read(0, process_stack_top_page());
    if (ok && (page_mapping_refcount_physical(cow_parent_physical) != 1 ||
        address_space_pte_is_cow(parent_after_reap) == false ||
        address_space_resolve_cow(0, process_stack_top_page()) == false ||
        address_space_pte_is_writable(
            address_space_pte_read(0, process_stack_top_page())) == false ||
        (address_space_pte_read(0, process_stack_top_page()) &
            USER_PAGE_PHYS_MASK) != cow_parent_physical)) {
        ok = false;
    }
    address_space_pte_clear(0, process_stack_top_page());
    address_space_tlb_invalidate(
        0, USER_TEXT_VA + process_stack_top_page() * PAGE_SIZE);
    process_image_record_at(0).stack_growth_active = false;
    process_image_record_at(0).active_page_count = 0;
    process_image_record_at(0).stack_lowest_l3 = process_stack_top_page();
    address_space_release_root(child_root);
    scheduled_process_probe_slot_release(child_root);
    return ok;
}

linear struct ProcessImagePages[image: usize] {
    private image: usize @ image;
    private count: usize;
    private entry: usize;
    private stack_pointer: usize;
    private heap_start: usize;
    private heap_limit: usize;
}

must_use variant ProcessImageMapResult {
    InvalidImage;
    OutOfMemory;
    Mapped(exists image: usize. ProcessImagePages[image]);
}

must_use variant ProcessImagePageLoadResult { Invalid; Loaded; }
must_use variant ProcessImageStackResult { Invalid; Ready; }
must_use variant ProcessImageSegmentsResult {
    Invalid;
    OutOfMemory;
    Mapped(usize);
}
must_use variant ProcessImagePairProbeResult {
    Invalid;
    Ready(exists image: usize. ProcessImagePages[image]);
}

// GitHub issue #392: THE PARKING LOT IS GONE, for the same reason and in
// the same shape as issue #257's on tcp.tkb.
//
// `process_image_exec_stores` was a [ProcessImageExecStore;
// KERNEL_PROCESS_MAX] of { mutex, ProcessImageExecValue } -- somewhere for
// a linear ProcessImagePages to live between the execve that mapped it and
// the exit that unmaps it, since neither end can hold a linear value across
// a return to userspace. It could not be one global store (a shell can exec
// and then fork another command, so the outer shell's image must stay owned
// while its child installs a distinct one), so it was one store per root,
// keyed by an index -- the key that stops existing when the process table
// becomes a pool.
//
// The root's own record is already the per-root, pooled home for exactly
// this, so the two facts the reap path asks of a parked image live there.
// What is deliberately given up: the parked value was linear, so the type
// system proved an installed image is unmapped exactly once. A bool proves
// nothing; process_image_exec_reap's own take-then-clear is what makes it
// once. That is the same trade issue #257 made, and the reason it is
// acceptable is the same -- the owner is still linear for the whole
// map-and-install operation, which is where an image can actually be
// duplicated or dropped.
fn process_image_pages_discard(pages: sink ProcessImagePages[image]) {}

// Whether this root still owns an image a previous execve installed. The
// only caller that can answer anything with it is the exec path itself: a
// process that execs twice has to release the first image before the second
// one is mapped over the same window, and by the time install runs the old
// image's page-table entries have already been overwritten.
fn process_image_exec_image_installed(root: usize) -> bool !{unsafe} {
    if (scheduled_process_slot_valid(root) == false) { return false; }
    return process_image_record_at(root).exec_image_installed;
}

must_use variant ProcessImageExecInstallResult { Installed; AlreadyInstalled; }

fn process_image_exec_install(
        pages: sink ProcessImagePages[image]) -> ProcessImageExecInstallResult {
    let root: usize =
        process_image_root_index();
    if (process_image_record_at(root).exec_image_installed) {
        // Unchanged: the INCOMING image is the one unmapped, and the
        // already-installed one is left alone.
        process_image_unmap(pages);
        return ProcessImageExecInstallResult::AlreadyInstalled;
    }
    process_image_record_at(root).exec_image_page_count =
        process_image_page_count(pages);
    process_image_record_at(root).exec_image_installed = true;
    process_image_pages_discard(pages);
    return ProcessImageExecInstallResult::Installed;
}

// GitHub issue #209: an applet used to be launched by the kernel itself,
// which then unmapped the image and checked process_image_window_is_clear()
// on the spot. Applets are children of the init script now, so their images
// are torn down here instead -- and process_image_unmap() clears this
// module's target on its way out, so a caller can no longer inspect the
// root that was just emptied. Counting both reaps and clean reaps here
// keeps that VM-hygiene assertion, and does it for every applet at once
// rather than one hand-written check per kernel-side launch.
private let mut process_image_exec_reap_count: usize;
private let mut process_image_exec_reap_clean_count: usize;
private let mut process_image_exec_reap_stack_growth_count: usize;

fn process_image_root_window_is_clear(
        root: usize) -> bool !{unsafe} {
    return address_space_user_window_is_clear(root);
}

fn process_image_exec_reap_evidence() -> (usize, usize, usize) {
    return (process_image_exec_reap_count,
            process_image_exec_reap_clean_count,
            process_image_exec_reap_stack_growth_count);
}

// GitHub issue #392: split in two, because the two halves belong to two
// different moments once a root's record dies with its process.
//
// The TEARDOWN half is about the child's own image, and now runs from
// scheduled_process_reap -- immediately after address_space_release_root,
// so the window-is-clear evidence still measures a fully torn-down root,
// and before process_image_record_release, which is what makes it the last
// moment the installed flag and page count still exist.
//
// It clears the target on EVERY path, installed or not. Leaving it
// pointing at the dead child's root is not a tidiness question: the next
// EL0 COW permission fault resolves against process_image_root_index(),
// and against the wrong root it cannot resolve at all. That was one
// fail-stop in the busybox fixture, found the first time this release was
// wired in.
fn process_image_exec_teardown(root_index: usize) {
    process_image_set_target_root_here(root_index);
    match process_image_target_root_result() {
        ProcessImageTargetRootResult::Missing => {
            process_image_clear_target_root_here();
            return;
        }
        ProcessImageTargetRootResult::Ready(root) => {
            // Take before acting, so an image is reaped once even though what
            // says it exists is now a bool rather than a linear value.
            let installed: bool =
                process_image_record_at(root).exec_image_installed;
            let count: usize =
                process_image_record_at(root).exec_image_page_count;
            process_image_record_at(root).exec_image_installed = false;
            process_image_record_at(root).exec_image_page_count = 0;
            if (installed) {
                let reaped_root: usize =
                    process_image_root_index();
                if (process_image_stack_grew_pages(count)) {
                    process_image_exec_reap_stack_growth_count =
                        process_image_exec_reap_stack_growth_count + 1;
                }
                process_image_unmap_pages(count);
                process_image_exec_reap_count =
                    process_image_exec_reap_count + 1;
                if (process_image_root_window_is_clear(reaped_root)) {
                    process_image_exec_reap_clean_count =
                        process_image_exec_reap_clean_count + 1;
                }
            }
        }
    }
    process_image_clear_target_root_here();
}

// The RESUME half stays where it was, at the parent's return, because that
// is the only moment "current" means the parent.
//
// process_image_unmap clears the later page-table target; it leaves TTBR0
// on the root it just emptied. The parent is resumed straight
// after this, so activate its root here exactly as process_image_clone_vm_
// reap does for the plain fork/exit path -- otherwise the parent returns to
// EL0 against the unmapped child root and faults on its own first
// instruction. GitHub issue #245: this runs from
// kernel_syscall_clone_parent_return(), reached only via
// kernel_process_child_exit()'s own return value -- by construction that
// has already switched execution_current_handle back to the parent, so
// kernel_process_current_root() is already correct here, not a fixed
// root 0.
fn process_image_exec_resume_root() {
    process_image_activate_root(
        address_space_root_slot(kernel_process_current_root()));
}

// A flat, NUL-terminated argv blob is deliberately used instead of an array
// of `[]u8` owners: it is plain immutable data, so one builder can consume
// literal argv values now and a script/path-derived argv later without an
// ownership transfer per element. `argc` names exactly how many strings the
// blob contains.
fn process_image_prepare_stack(page: borrow PageOwner[page],
                               plan: DistroElfLoadPlan,
                               argv: []u8,
                               argc: usize)
        -> ProcessImageStackResult !{unsafe} {
    if (argc < 1 || argc > 32) { return ProcessImageStackResult::Invalid; }
    let argument_count: {1..<33 as usize} = argc;
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }
    let stack = bytes[PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES..<PAGE_SIZE];

    let virtual_base: usize = USER_TEXT_VA +
                              process_stack_top_page() * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    // argc, argv[], argv terminator, envp terminator, then eight auxv
    // key/value pairs and AT_NULL. The random bytes immediately follow.
    let auxv_start: usize = argument_count + 3;
    let random_offset: usize = (auxv_start + 18) * 8;
    let mut string_offset: usize = random_offset + 16;
    if (string_offset > PROCESS_STACK_LAYOUT_BYTES) {
        return ProcessImageStackResult::Invalid;
    }
    let random_address: usize = virtual_base + random_offset;
    process_stack_store_word(stack, 0, argument_count as u64);

    let mut arg: usize = 0;
    process_stack_store_word(stack, 1,
                             (virtual_base + string_offset) as u64);
    // `for byte in argv` is the slice-safe iterator form: argv may later be
    // runtime data, but no unproved index is introduced while scanning it.
    for byte in argv {
        if (arg >= argument_count) { break; }
        let write_offset: usize = string_offset;
        if (write_offset < stack.len) {
            stack[write_offset] = byte;
        } else {
            return ProcessImageStackResult::Invalid;
        }
        string_offset = string_offset + 1;
        if (byte == 0) {
            arg = arg + 1;
            if (arg < argument_count) {
                process_stack_store_word(
                    stack, arg + 1, (virtual_base + string_offset) as u64);
            }
        }
    }
    if (arg != argument_count) { return ProcessImageStackResult::Invalid; }
    process_stack_store_word(stack, argument_count + 1, 0);
    process_stack_store_word(stack, argument_count + 2, 0);

    // The static PIE has no interpreter (AT_BASE=0). The ELF header and
    // program table are in the first PT_LOAD, so AT_PHDR is directly based
    // on the process load address.
    process_stack_store_word(stack, auxv_start, AT_PAGESZ as u64);
    process_stack_store_word(stack, auxv_start + 1, PAGE_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 2, AT_PHDR as u64);
    process_stack_store_word(stack, auxv_start + 3,
                             (USER_TEXT_VA + plan.program_offset) as u64);
    process_stack_store_word(stack, auxv_start + 4, AT_PHENT as u64);
    process_stack_store_word(stack, auxv_start + 5,
                             ELF_PROGRAM_HEADER_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 6, AT_PHNUM as u64);
    process_stack_store_word(stack, auxv_start + 7,
                             plan.program_count as u64);
    process_stack_store_word(stack, auxv_start + 8, AT_BASE as u64);
    process_stack_store_word(stack, auxv_start + 9, 0);
    process_stack_store_word(stack, auxv_start + 10, AT_ENTRY as u64);
    process_stack_store_word(stack, auxv_start + 11,
                             (USER_TEXT_VA + plan.entry) as u64);
    process_stack_store_word(stack, auxv_start + 12, AT_RANDOM as u64);
    process_stack_store_word(stack, auxv_start + 13, random_address as u64);
    process_stack_store_word(stack, auxv_start + 14, AT_SECURE as u64);
    process_stack_store_word(stack, auxv_start + 15, 0);
    process_stack_store_word(stack, auxv_start + 16, 0);
    process_stack_store_word(stack, auxv_start + 17, 0);
    for i: usize in 0..<16 {
        let random_index: usize = random_offset + i;
        if (random_index < stack.len) {
            stack[random_index] = (0xA5 ^ i) as u8;
        } else {
            return ProcessImageStackResult::Invalid;
        }
    }

    if (process_stack_load_word(stack, 0) != argument_count as u64 ||
        process_stack_load_word(stack, argument_count + 1) != 0 ||
        process_stack_load_word(stack, argument_count + 2) != 0 ||
        process_stack_load_word(stack, auxv_start + 1) != PAGE_SIZE as u64 ||
        process_stack_load_word(stack, auxv_start + 3) !=
            (USER_TEXT_VA + plan.program_offset) as u64 ||
        process_stack_load_word(stack, auxv_start + 11) !=
            (USER_TEXT_VA + plan.entry) as u64 ||
        process_stack_load_word(stack, auxv_start + 17) != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_dynamic_prepare_stack(page: borrow PageOwner[page],
                                 application: DistroElfLoadPlan,
                                 interpreter_bias: usize,
                                 argv: []u8,
                                 argc: usize)
        -> ProcessImageStackResult !{unsafe} {
    if (argc < 1 || argc > 32) { return ProcessImageStackResult::Invalid; }
    let argument_count: {1..<33 as usize} = argc;
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }
    let stack = bytes[PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES..<PAGE_SIZE];

    let virtual_base: usize = USER_TEXT_VA +
                              process_stack_top_page() * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let auxv_start: usize = argument_count + 3;
    let random_offset: usize = (auxv_start + 28) * 8;
    let mut string_offset: usize = random_offset + 16;
    if (string_offset > PROCESS_STACK_LAYOUT_BYTES) {
        return ProcessImageStackResult::Invalid;
    }
    let random_address: usize = virtual_base + random_offset;
    process_stack_store_word(stack, 0, argument_count as u64);
    let mut arg: usize = 0;
    let execfn_address: usize = virtual_base + string_offset;
    process_stack_store_word(stack, 1, execfn_address as u64);
    for byte in argv {
        if (arg >= argument_count) { break; }
        let write_offset: usize = string_offset;
        if (write_offset < stack.len) {
            stack[write_offset] = byte;
        } else {
            return ProcessImageStackResult::Invalid;
        }
        string_offset = string_offset + 1;
        if (byte == 0) {
            arg = arg + 1;
            if (arg < argument_count) {
                process_stack_store_word(
                    stack, arg + 1, (virtual_base + string_offset) as u64);
            }
        }
    }
    if (arg != argument_count) { return ProcessImageStackResult::Invalid; }
    process_stack_store_word(stack, argument_count + 1, 0);
    process_stack_store_word(stack, argument_count + 2, 0);
    process_stack_store_word(stack, auxv_start, AT_PAGESZ as u64);
    process_stack_store_word(stack, auxv_start + 1, PAGE_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 2, AT_PHDR as u64);
    process_stack_store_word(
        stack, auxv_start + 3,
        (USER_TEXT_VA + application.program_offset) as u64);
    process_stack_store_word(stack, auxv_start + 4, AT_PHENT as u64);
    process_stack_store_word(stack, auxv_start + 5,
                             ELF_PROGRAM_HEADER_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 6, AT_PHNUM as u64);
    process_stack_store_word(stack, auxv_start + 7,
                             application.program_count as u64);
    process_stack_store_word(stack, auxv_start + 8, AT_BASE as u64);
    process_stack_store_word(stack, auxv_start + 9,
                             (USER_TEXT_VA + interpreter_bias) as u64);
    process_stack_store_word(stack, auxv_start + 10, AT_ENTRY as u64);
    process_stack_store_word(stack, auxv_start + 11,
                             (USER_TEXT_VA + application.entry) as u64);
    process_stack_store_word(stack, auxv_start + 12, AT_RANDOM as u64);
    process_stack_store_word(stack, auxv_start + 13, random_address as u64);
    process_stack_store_word(stack, auxv_start + 14, AT_SECURE as u64);
    process_stack_store_word(stack, auxv_start + 15, 0);
    process_stack_store_word(stack, auxv_start + 16, AT_UID as u64);
    process_stack_store_word(stack, auxv_start + 17, 0);
    process_stack_store_word(stack, auxv_start + 18, AT_EUID as u64);
    process_stack_store_word(stack, auxv_start + 19, 0);
    process_stack_store_word(stack, auxv_start + 20, AT_GID as u64);
    process_stack_store_word(stack, auxv_start + 21, 0);
    process_stack_store_word(stack, auxv_start + 22, AT_EGID as u64);
    process_stack_store_word(stack, auxv_start + 23, 0);
    process_stack_store_word(stack, auxv_start + 24, AT_EXECFN as u64);
    process_stack_store_word(stack, auxv_start + 25, execfn_address as u64);
    process_stack_store_word(stack, auxv_start + 26, 0);
    process_stack_store_word(stack, auxv_start + 27, 0);
    for i: usize in 0..<16 {
        let random_index: usize = random_offset + i;
        if (random_index < stack.len) {
            stack[random_index] = (0x5A ^ i) as u8;
        } else {
            return ProcessImageStackResult::Invalid;
        }
    }

    if (process_stack_load_word(stack, 0) != argument_count as u64 ||
        process_stack_load_word(stack, argument_count + 1) != 0 ||
        process_stack_load_word(stack, argument_count + 2) != 0 ||
        process_stack_load_word(stack, auxv_start + 3) !=
            (USER_TEXT_VA + application.program_offset) as u64 ||
        process_stack_load_word(stack, auxv_start + 9) !=
            (USER_TEXT_VA + interpreter_bias) as u64 ||
        process_stack_load_word(stack, auxv_start + 11) !=
            (USER_TEXT_VA + application.entry) as u64 ||
        process_stack_load_word(stack, auxv_start + 27) != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_image_load_page(page: borrow PageOwner[page],
                           plan: DistroElfLoadPlan,
                           header: *KernelElf64ProgramHeader,
                           load_bias: usize,
                           l3_index: usize)
        -> ProcessImagePageLoadResult !{unsafe} {
    if (process_image_ext2_active) {
        return process_image_load_page_ext2(
            page, plan, header, load_bias, l3_index);
    }
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let page_start: usize = l3_index * PAGE_SIZE;
    let page_end: usize = page_start + PAGE_SIZE;
    let segment_start: usize =
        (header.virtual_address as usize) + load_bias;
    let file_size: usize = header.file_size as usize;
    let file_end: usize = segment_start + file_size;
    let mut copy_start: usize = page_start;
    if (copy_start < segment_start) { copy_start = segment_start; }
    let mut copy_end: usize = page_end;
    if (copy_end > file_end) { copy_end = file_end; }
    if (copy_start >= copy_end) {
        if (slice_eq(bytes, process_image_zero_page as []u8)) {
            return ProcessImagePageLoadResult::Loaded;
        }
        return ProcessImagePageLoadResult::Invalid;
    }

    let destination_offset: usize = copy_start - page_start;
    let source_offset: usize = (header.offset as usize) +
                               (copy_start - segment_start);
    let copy_length: usize = copy_end - copy_start;
    let source = plan.image;
    if (destination_offset > PAGE_SIZE ||
        copy_length > PAGE_SIZE - destination_offset ||
        source_offset > plan.image_length ||
        copy_length > plan.image_length - source_offset ||
        source_offset > source.len ||
        copy_length > source.len - source_offset) {
        return ProcessImagePageLoadResult::Invalid;
    }

    let destination_tail = bytes[destination_offset..<PAGE_SIZE];
    let source_tail = source[source_offset..<source.len];
    if (copy_length > destination_tail.len) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let destination = destination_tail[0..<copy_length];
    if (copy_length > source_tail.len) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let file_bytes = source_tail[0..<copy_length];
    slice_copy(destination, file_bytes);
    if (slice_eq(destination, file_bytes) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }

    // Every byte outside the file-backed overlap must still be zero. Dynamic
    // endpoints reuse the same checked-slice evidence as the copy views.
    let zeros = process_image_zero_page as []u8;
    let suffix_start: usize = destination_offset + copy_length;
    if (suffix_start > PAGE_SIZE) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let prefix = bytes[0..<destination_offset];
    let zero_prefix = zeros[0..<destination_offset];
    let suffix = bytes[suffix_start..<PAGE_SIZE];
    let zero_suffix = zeros[suffix_start..<PAGE_SIZE];
    if (slice_eq(prefix, zero_prefix) == false ||
        slice_eq(suffix, zero_suffix) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }
    return ProcessImagePageLoadResult::Loaded;
}

// Ext2-backed counterpart to process_image_load_page(). It deliberately
// reads at most one filesystem block per ext2_read_file_chunk() call; the
// ELF itself never has to fit in a kernel scratch buffer.
fn process_image_load_page_ext2(page: borrow PageOwner[page],
                                plan: DistroElfLoadPlan,
                                header: *KernelElf64ProgramHeader,
                                load_bias: usize,
                                l3_index: usize)
        -> ProcessImagePageLoadResult !{unsafe} {
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }
    let page_start: usize = l3_index * PAGE_SIZE;
    let page_end: usize = page_start + PAGE_SIZE;
    let segment_start: usize = (header.virtual_address as usize) + load_bias;
    let file_size: usize = header.file_size as usize;
    let file_end: usize = segment_start + file_size;
    let mut copy_start: usize = page_start;
    if (copy_start < segment_start) { copy_start = segment_start; }
    let mut copy_end: usize = page_end;
    if (copy_end > file_end) { copy_end = file_end; }
    if (copy_start >= copy_end) {
        if (slice_eq(bytes, process_image_zero_page as []u8)) {
            return ProcessImagePageLoadResult::Loaded;
        }
        return ProcessImagePageLoadResult::Invalid;
    }
    if (copy_start < copy_end) {
        let mut destination_offset: usize = copy_start - page_start;
        let mut source_offset: usize = (header.offset as usize) +
                                       (copy_start - segment_start);
        let mut remaining: usize = copy_end - copy_start;
        while (remaining != 0) {
            if (source_offset >= process_image_ext2_length) {
                return ProcessImagePageLoadResult::Invalid;
            }
            match ext2_read_file_chunk(
                    process_image_ext2_mount, process_image_ext2_inode,
                    source_offset, process_image_ext2_block as []u8) {
                Ext2ReadResult::Invalid => {
                    return ProcessImagePageLoadResult::Invalid;
                }
                Ext2ReadResult::Read(read_length) => {
                    if (read_length == 0) {
                        return ProcessImagePageLoadResult::Invalid;
                    }
                    let mut take: usize = read_length;
                    if (take > remaining) { take = remaining; }
                    let block_bytes = process_image_ext2_block as []u8;
                    let destination_start: usize = destination_offset;
                    if (take > block_bytes.len ||
                        destination_start > bytes.len) {
                        return ProcessImagePageLoadResult::Invalid;
                    }
                    let source = block_bytes[0..<take];
                    let destination_tail =
                        bytes[destination_start..<bytes.len];
                    if (take > destination_tail.len) {
                        return ProcessImagePageLoadResult::Invalid;
                    }
                    let destination = destination_tail[0..<take];
                    slice_copy(destination, source);
                    destination_offset = destination_offset + take;
                    source_offset = source_offset + take;
                    remaining = remaining - take;
                }
            }
        }
    }
    let zeros = process_image_zero_page as []u8;
    let prefix_end: usize = copy_start - page_start;
    let suffix_start: usize = copy_end - page_start;
    if (prefix_end > PAGE_SIZE || suffix_start > PAGE_SIZE) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let prefix = bytes[0..<prefix_end];
    let zero_prefix = zeros[0..<prefix_end];
    let suffix = bytes[suffix_start..<PAGE_SIZE];
    let zero_suffix = zeros[suffix_start..<PAGE_SIZE];
    if (slice_eq(prefix, zero_prefix) == false ||
        slice_eq(suffix, zero_suffix) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }
    return ProcessImagePageLoadResult::Loaded;
}

// Address-space cleanup walks the actual L2/L3 tree, releasing every
// transferred user page and every dynamic L3 table page. It needs no
// per-image page-index list and scales with populated branches.
private fn process_image_cleanup_root(root: usize) {
    address_space_release_user_mappings(root);
    process_image_record_at(root).active_page_count = 0;
    process_image_record_at(root).stack_growth_active = false;
    process_image_record_at(root).stack_lowest_l3 = process_stack_top_page();
}

fn process_image_cleanup() {
    match process_image_target_root_result() {
        ProcessImageTargetRootResult::Missing => { return; }
        ProcessImageTargetRootResult::Ready(root) => {
            process_image_cleanup_root(root);
        }
    }
}

// Called directly from el0_sync_entry for a lower-EL data-abort translation
// fault. It accepts only an address inside the reserved, downward-growing
// stack and maps every missing page down to that address. Mapping the whole
// gap handles an ABI that subtracts a large stack frame before its first
// store, while the guard page below the reservation remains unmapped.
fn process_image_handle_data_abort(esr: usize, fault_address: usize) -> bool {
    let root: usize = process_image_root_index();
    let exception_class: usize = (esr >> 26) & 0x3F;
    let fault_status: usize = esr & 0x3F;
    // A COW write is a level-3 permission fault (0x0f). It must be handled
    // before translation-fault stack growth: both refer to an EL0 data abort,
    // but only the COW PTE already names a present shared physical page.
    if (exception_class == 0x24 && fault_status == 0x0F &&
        (esr & (1 << 6)) != 0) {
        if (fault_address < USER_TEXT_VA ||
            fault_address >= USER_TEXT_VA + USER_SPACE_PAGE_COUNT * PAGE_SIZE) {
            return false;
        }
        let index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
        return address_space_resolve_cow(process_image_target_root_here(), index);
    }
    // A missing PTE inside an existing L3 is a level-3 translation fault
    // (0x07). A stack expansion into an unpopulated lazy-L3 branch faults
    // one level earlier (0x06); both are valid only after the range checks
    // below prove this is the current process's reserved stack.
    if (process_image_record_at(root).stack_growth_active == false ||
        exception_class != 0x24 ||
        (fault_status != 0x06 && fault_status != 0x07)) {
        return false;
    }
    let stack_start: usize = USER_TEXT_VA +
        process_image_record_at(root).stack_low_page * PAGE_SIZE;
    let stack_top: usize = USER_TEXT_VA + process_stack_top_page() * PAGE_SIZE;
    if (fault_address < stack_start || fault_address >= stack_top) {
        return false;
    }
    let fault_index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
    if (fault_index < process_image_record_at(root).stack_low_page ||
        fault_index >= process_image_record_at(root).stack_lowest_l3) {
        return false;
    }
    for l3_index: usize in
            fault_index..<process_image_record_at(root).stack_lowest_l3 {
        if (process_image_record_at(root).active_page_count >= USER_SPACE_PAGE_COUNT ||
            process_image_pte_read(l3_index) != 0) {
            return false;
        }
        match page_alloc(PageOwnerTag::UserPage) {
            PageAllocResult::OutOfMemory => { return false; }
            PageAllocResult::Allocated(stack_page) => {
                let bytes = page_bytes(stack_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                if (process_image_install_page(
                        stack_page, l3_index, USER_RW_XN_FLAGS) == false) {
                    return false;
                }
                process_image_record_at(root).active_page_count =
                    process_image_record_at(root).active_page_count + 1;
            }
        }
    }
    process_image_record_at(root).stack_lowest_l3 = fault_index;
    return true;
}

// GitHub issue #392: the page count is all either of these ever needed of
// the owner, so each has a half that takes the count on its own -- which
// is what process_image_exec_reap calls, now that what it reaps is a
// record field rather than a parked linear value.
fn process_image_unmap_pages(count: usize) {
    match process_image_target_root_result() {
        ProcessImageTargetRootResult::Missing => {
            process_image_clear_target_root_here();
            return;
        }
        ProcessImageTargetRootResult::Ready(root) => {
            if (process_image_record_at(root).stack_growth_active ||
                process_image_record_at(root).active_page_count > count) {
                process_image_record_at(root).stack_growth_active = false;
                process_image_record_at(root).active_page_count = 0;
                process_image_record_at(root).stack_lowest_l3 =
                    process_stack_top_page();
            }
            process_image_cleanup_root(root);
        }
    }
    process_image_clear_target_root_here();
}

fn process_image_unmap(pages: sink ProcessImagePages[image]) {
    let count: usize = pages.count;
    process_image_pages_discard(pages);
    process_image_unmap_pages(count);
}

fn process_image_map_segments(plan: DistroElfLoadPlan,
                              load_bias: usize,
                              already_mapped: usize)
        -> ProcessImageSegmentsResult {
    if (plan.extent > USER_SPACE_BYTES ||
        load_bias > USER_SPACE_BYTES - plan.extent) {
        process_image_cleanup();
        return ProcessImageSegmentsResult::OutOfMemory;
    }
    let mut mapped: usize = already_mapped;
    let image = plan.image;
    if (plan.program_offset > image.len) {
        process_image_cleanup();
        return ProcessImageSegmentsResult::Invalid;
    }
    for segment_index: usize in 0..<plan.program_count {
        let header_offset: usize = plan.program_offset +
                                   segment_index * ELF_PROGRAM_HEADER_SIZE;
        if (header_offset > image.len) {
            process_image_cleanup();
            return ProcessImageSegmentsResult::Invalid;
        }
        let header_tail = image[header_offset..<image.len];
        if (header_tail.len < sizeof(KernelElf64ProgramHeader)) {
            process_image_cleanup();
            return ProcessImageSegmentsResult::Invalid;
        }
        let header_bytes =
            header_tail[0..<sizeof(KernelElf64ProgramHeader)];
        let header: *KernelElf64ProgramHeader =
            header_bytes as *KernelElf64ProgramHeader;
        if (header.segment_type == ELF_PT_LOAD) {
            // PF_R=4 (rodata), PF_R|PF_X=5 (text), PF_R|PF_W=6 (data). A
            // writable+executable combination is never accepted.
            if (header.flags != 4 && header.flags != 5 && header.flags != 6) {
                process_image_cleanup();
                return ProcessImageSegmentsResult::Invalid;
            }
            let virtual_address: usize =
                (header.virtual_address as usize) + load_bias;
            let memory_size: usize = header.memory_size as usize;
            let first_page: usize = virtual_address / PAGE_SIZE;
            let last_byte: usize = virtual_address + memory_size;
            let last_page: usize = (last_byte + 4095) / PAGE_SIZE;
            if (last_page > USER_SPACE_PAGE_COUNT) {
                process_image_cleanup();
                return ProcessImageSegmentsResult::OutOfMemory;
            }
            for l3_index: usize in first_page..<last_page {
                if (process_image_pte_read(l3_index) != 0) {
                    process_image_cleanup();
                    return ProcessImageSegmentsResult::Invalid;
                }
                match page_alloc(PageOwnerTag::UserPage) {
                    PageAllocResult::OutOfMemory => {
                        process_image_cleanup();
                        return ProcessImageSegmentsResult::OutOfMemory;
                    }
                    PageAllocResult::Allocated(page) => {
                        match process_image_load_page(
                                page, plan, header, load_bias, l3_index) {
                            ProcessImagePageLoadResult::Invalid => {
                                page_free(page);
                                process_image_cleanup();
                                return ProcessImageSegmentsResult::Invalid;
                            }
                            ProcessImagePageLoadResult::Loaded => {
                                let mut flags: usize = USER_RW_XN_FLAGS;
                                if (header.flags == 5) {
                                    flags = USER_TEXT_RX_FLAGS;
                                    user_code_sync(page_physical_address(page),
                                                   PAGE_SIZE);
                                }
                                if (header.flags == 4) {
                                    flags = USER_RODATA_R_FLAGS;
                                }
                                if (process_image_install_page(
                                        page, l3_index, flags) == false) {
                                    process_image_cleanup();
                                    return ProcessImageSegmentsResult::OutOfMemory;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
            }
        }
    }
    }
    return ProcessImageSegmentsResult::Mapped(mapped);
}

fn process_image_pair_probe(primary: DistroElfLoadPlan,
                            interpreter: DistroElfLoadPlan,
                            interpreter_bias: usize,
                            argv: []u8,
                            argc: usize)
        -> ProcessImagePairProbeResult {
    // GitHub issue #258 step 2: this path's own layout, seeded before any
    // consumer reads it. Its stack floor is higher than the static path's
    // (this image's heap reaches further up) -- that difference used to be
    // two separate global constants, and is now just two seeds.
    let root: usize = process_image_root_index();
    process_image_record_at(root).stack_top_page = process_stack_top_page();
    process_image_record_at(root).stack_low_page = PROCESS_STACK_LOW_DYNAMIC;
    process_image_record_at(root).heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;
    match process_image_map_segments(primary, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::Mapped(primary_count) => {
            if (process_image_pair_ext2_active) {
                process_image_ext2_source(
                    process_image_pair_ext2_mount,
                    process_image_pair_ext2_inode,
                    process_image_pair_ext2_length);
            }
            match process_image_map_segments(
                    interpreter, interpreter_bias, primary_count) {
                ProcessImageSegmentsResult::Invalid => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::OutOfMemory => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::Mapped(total) => {
                    let combined_extent: usize =
                        interpreter_bias + interpreter.extent;
                    let heap_first_page: usize =
                        (combined_extent + PAGE_SIZE - 1) / PAGE_SIZE;
                    let heap_last_page: usize =
                        heap_first_page +
                        process_image_record_at(root).heap_page_count;
                    if (total != 195 ||
                        heap_last_page >=
                        process_image_record_at(root).stack_low_page) {
                        process_image_cleanup();
                        return ProcessImagePairProbeResult::Invalid;
                    }
                    let mut mapped: usize = total;
                    for l3_index: usize in heap_first_page..<heap_last_page {
                        if (process_image_pte_read(l3_index) != 0) {
                            process_image_cleanup();
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc(PageOwnerTag::UserPage) {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup();
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(heap_page) => {
                                let bytes = page_bytes(heap_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                if (process_image_install_page(
                                        heap_page, l3_index,
                                        USER_RW_XN_FLAGS) == false) {
                                    process_image_cleanup();
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                    // musl and BusyBox httpd use more than one page while
                    // parsing a request. Keep eight pages immediately below
                    // the top mapped; the much larger reservation below
                    // remains demand-faulted rather than eagerly consuming
                    // every page in the 1 GiB address-space slot.
                    for l3_index: usize in
                            process_stack_top_page() -
                            (PROCESS_DYNAMIC_STACK_INITIAL_PAGES - 1)..<
                            process_stack_top_page() {
                        if (process_image_pte_read(l3_index) != 0) {
                            process_image_cleanup();
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc(PageOwnerTag::UserPage) {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup();
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(stack_page) => {
                                let bytes = page_bytes(stack_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                if (process_image_install_page(
                                        stack_page, l3_index,
                                        USER_RW_XN_FLAGS) == false) {
                                    process_image_cleanup();
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                    match page_alloc(PageOwnerTag::UserPage) {
                        PageAllocResult::OutOfMemory => {
                            process_image_cleanup();
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        PageAllocResult::Allocated(stack) => {
                            match process_dynamic_prepare_stack(
                                    stack, primary, interpreter_bias,
                                    argv, argc) {
                                ProcessImageStackResult::Invalid => {
                                    page_free(stack);
                                    process_image_cleanup();
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                ProcessImageStackResult::Ready => {
                                        if (process_image_install_page(
                                                stack, process_stack_top_page(),
                                                USER_RW_XN_FLAGS) == false) {
                                            process_image_cleanup();
                                            return ProcessImagePairProbeResult::Invalid;
                                        }
                                        mapped = mapped + 1;
                                }
                            }
                        }
                    }
                    if (mapped == 331) {
                        let image: usize @ 1 = 1;
                        let entry: usize = USER_TEXT_VA + interpreter_bias +
                                           interpreter.entry;
                        let stack_pointer: usize = USER_TEXT_VA +
                            process_stack_top_page() * PAGE_SIZE + PAGE_SIZE -
                            PROCESS_STACK_LAYOUT_BYTES;
                        let heap_start: usize =
                            USER_TEXT_VA + heap_first_page * PAGE_SIZE;
                        let heap_limit: usize =
                            USER_TEXT_VA + heap_last_page * PAGE_SIZE;
                        let mut pages: ProcessImagePages[1] = {
                            image, mapped, entry, stack_pointer,
                            heap_start, heap_limit
                        };
                        process_image_record_at(root).active_page_count = mapped;
                        process_image_record_at(root).stack_growth_active = true;
                        return ProcessImagePairProbeResult::Ready(pages);
                    }
                    process_image_cleanup();
                    return ProcessImagePairProbeResult::Invalid;
                }
            }
        }
    }
}

// Dynamic ELF exec needs the same root-scoped mapping path as static ELF
// exec. The pair mapper deliberately preserves process_image_pair_probe's
// stack/heap layout and only selects the child root before it runs.
fn process_image_pair_map_in_root(primary: DistroElfLoadPlan,
                                  interpreter: DistroElfLoadPlan,
                                  interpreter_bias: usize,
                                  argv: []u8,
                                  argc: usize,
                                  root: usize)
        -> ProcessImagePairProbeResult {
    if (scheduled_process_slot_valid(root) == false ||
        address_space_is_live(root) == false) {
        return ProcessImagePairProbeResult::Invalid;
    }
    process_image_set_target_root_here(root);
    return process_image_pair_probe(
        primary, interpreter, interpreter_bias, argv, argc);
}

// Map a dynamic application/interpreter pair whose two backing files both
// reside on ext2. Metadata plans retain their separate header windows while
// PT_LOAD bytes switch from primary_inode to interpreter_inode between the
// two segment passes.
fn process_image_pair_map_ext2_in_root(
        primary: DistroElfLoadPlan,
        primary_mount: Ext2Mount,
        primary_inode: usize,
        primary_length: usize,
        interpreter: DistroElfLoadPlan,
        interpreter_mount: Ext2Mount,
        interpreter_inode: usize,
        interpreter_length: usize,
        interpreter_bias: usize,
        argv: []u8,
        argc: usize,
        root: usize) -> ProcessImagePairProbeResult {
    if (scheduled_process_slot_valid(root) == false ||
        address_space_is_live(root) == false) {
        return ProcessImagePairProbeResult::Invalid;
    }
    process_image_set_target_root_here(root);
    process_image_ext2_source(
        primary_mount, primary_inode, primary_length);
    process_image_pair_ext2_source(
        interpreter_mount, interpreter_inode, interpreter_length);
    let result = process_image_pair_probe(
        primary, interpreter, interpreter_bias, argv, argc);
    process_image_pair_ext2_source_clear();
    process_image_ext2_source_clear();
    return result;
}

fn process_image_map_current(plan: DistroElfLoadPlan,
                             argv: []u8,
                             argc: usize) -> ProcessImageMapResult {
    let root: usize = process_image_root_index();
    process_image_record_at(root).stack_growth_active = false;
    process_image_record_at(root).active_page_count = 0;
    process_image_record_at(root).stack_lowest_l3 = process_stack_top_page();
    process_image_record_at(root).stack_top_page = process_stack_top_page();
    process_image_record_at(root).stack_low_page = PROCESS_STACK_LOW_STATIC;
    process_image_record_at(root).heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;
    if (plan.extent > USER_SPACE_BYTES) {
        return ProcessImageMapResult::OutOfMemory;
    }
    let mut mapped: usize = 0;
    match process_image_map_segments(plan, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImageMapResult::InvalidImage;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImageMapResult::OutOfMemory;
        }
        ProcessImageSegmentsResult::Mapped(count) => { mapped = count; }
    }
    let heap_first_page: usize = (plan.extent + PAGE_SIZE - 1) / PAGE_SIZE;
    let heap_last_page: usize =
        heap_first_page + process_image_record_at(root).heap_page_count;
    if (heap_last_page >= process_image_record_at(root).stack_low_page) {
        process_image_cleanup();
        return ProcessImageMapResult::OutOfMemory;
    }
    for l3_index: usize in heap_first_page..<heap_last_page {
        if (process_image_pte_read(l3_index) != 0) {
            process_image_cleanup();
            return ProcessImageMapResult::InvalidImage;
        }
        match page_alloc(PageOwnerTag::UserPage) {
            PageAllocResult::OutOfMemory => {
                process_image_cleanup();
                return ProcessImageMapResult::OutOfMemory;
            }
            PageAllocResult::Allocated(heap_page) => {
                let bytes = page_bytes(heap_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                if (process_image_install_page(
                        heap_page, l3_index, USER_RW_XN_FLAGS) == false) {
                    process_image_cleanup();
                    return ProcessImageMapResult::OutOfMemory;
                }
                mapped = mapped + 1;
            }
        }
    }
    if (process_image_pte_read(process_stack_top_page()) != 0) {
        process_image_cleanup();
        return ProcessImageMapResult::InvalidImage;
    }
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            process_image_cleanup();
            return ProcessImageMapResult::OutOfMemory;
        }
        PageAllocResult::Allocated(stack) => {
            match process_image_prepare_stack(stack, plan, argv, argc) {
                ProcessImageStackResult::Invalid => {
                    page_free(stack);
                    process_image_cleanup();
                    return ProcessImageMapResult::InvalidImage;
                }
                ProcessImageStackResult::Ready => {
                        if (process_image_install_page(
                                stack, process_stack_top_page(),
                                USER_RW_XN_FLAGS) == false) {
                            process_image_cleanup();
                            return ProcessImageMapResult::OutOfMemory;
                        }
                        mapped = mapped + 1;
                }
            }
        }
    }
    let image: usize @ 0 = 0;
    let entry: usize = USER_TEXT_VA + plan.entry;
    let stack_pointer: usize = USER_TEXT_VA +
                               process_stack_top_page() * PAGE_SIZE +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let heap_start: usize = USER_TEXT_VA + heap_first_page * PAGE_SIZE;
    let heap_limit: usize = USER_TEXT_VA + heap_last_page * PAGE_SIZE;
    let mut pages: ProcessImagePages[0] = {
        image, mapped, entry, stack_pointer, heap_start, heap_limit
    };
    process_image_record_at(root).active_page_count = mapped;
    process_image_record_at(root).stack_growth_active = true;
    return ProcessImageMapResult::Mapped(pages);
}

fn process_image_map(plan: DistroElfLoadPlan,
                     argv: []u8,
                     argc: usize) -> ProcessImageMapResult {
    process_image_set_target_root_here(0);
    return process_image_map_current(plan, argv, argc);
}

// Map a validated ELF whose bytes live in an ext2 regular file. `plan` must
// point at a metadata window containing the ELF header and program table;
// PT_LOAD contents are fetched through ext2_read_file_chunk() while pages
// are being built.
fn process_image_map_ext2(plan: DistroElfLoadPlan,
                          mount: Ext2Mount,
                          inode: usize,
                          file_length: usize,
                          argv: []u8,
                          argc: usize) -> ProcessImageMapResult {
    process_image_set_target_root_here(0);
    process_image_ext2_source(mount, inode, file_length);
    let result = process_image_map_current(plan, argv, argc);
    process_image_ext2_source_clear();
    return result;
}

fn process_image_map_ext2_in_root(plan: DistroElfLoadPlan,
                                  mount: Ext2Mount,
                                  inode: usize,
                                  file_length: usize,
                                  argv: []u8,
                                  argc: usize,
                                  root: usize) -> ProcessImageMapResult {
    if (scheduled_process_slot_valid(root) == false ||
        address_space_is_live(root) == false) {
        return ProcessImageMapResult::InvalidImage;
    }
    process_image_set_target_root_here(root);
    process_image_ext2_source(mount, inode, file_length);
    let result = process_image_map_current(plan, argv, argc);
    process_image_ext2_source_clear();
    return result;
}

fn process_image_map_in_root(plan: DistroElfLoadPlan,
                             argv: []u8,
                             argc: usize,
                             root: usize) -> ProcessImageMapResult {
    if (scheduled_process_slot_valid(root) == false ||
        address_space_is_live(root) == false) {
        return ProcessImageMapResult::InvalidImage;
    }
    process_image_set_target_root_here(root);
    return process_image_map_current(plan, argv, argc);
}

fn process_image_page_count(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.count;
}

fn process_image_entry(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.entry;
}

fn process_image_stack_pointer(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.stack_pointer;
}

fn process_image_stack_grew_pages(count: usize) -> bool {
    let root: usize = process_image_root_index();
    return process_image_record_at(root).stack_growth_active &&
           process_image_record_at(root).active_page_count > count;
}

fn process_image_active_page_count(root: usize) -> usize !{unsafe} {
    if (scheduled_process_slot_valid(root) == false) { return 0; }
    return process_image_record_at(root).active_page_count;
}

fn process_image_stack_grew(pages: borrow ProcessImagePages[image]) -> bool {
    return process_image_stack_grew_pages(pages.count);
}

fn process_image_heap_range(pages: borrow ProcessImagePages[image])
        -> (usize, usize) {
    return (pages.heap_start, pages.heap_limit);
}

fn process_image_window_is_clear() -> bool !{unsafe} {
    return address_space_user_window_is_clear(process_image_root_index());
}

fn process_image_gap_is_unmapped() -> bool {
    // Alpine BusyBox's first PT_LOAD ends at page 266 and its second starts at
    // page 285. Keeping this gap absent is part of the current fixture's VM
    // contract; it must not become zero-filled executable memory by accident.
    for i: usize in 266..<285 {
        if (process_image_pte_read(i) != 0) { return false; }
    }
    return true;
}

// GitHub issue #479. Twenty globals, and they fall into three kinds.
//
// ONE WAS THE WRONG SHAPE and is fixed. process_image_target_root plus its
// explicit set flag name
// the root an image operation is aimed at, set by one call and read by
// another -- per-OPERATION state living in a global, which on two cores
// means one answer held for two concurrent operations. It is an array
// indexed by cpu_id() now, the same treatment execution_state and
// address_space_active_slot got.
//
// It had already produced a real fault with only one writer: issue #437's
// RPi5-only failure was this variable left at 0 on wait4's fast path,
// aiming the COW handler at PID 1's live image, and that took a hardware
// bisect to find.
//
// SIX ARE SHARED STAGING for an exec's ext2 source
// (process_image_ext2_active/_mount/_inode/_length/_block and the _pair_
// set beside them). Two cores exec'ing at once would each stage over the
// other, and the result is a process started from another process's file --
// which does not fault, it runs.
//
// The rest are the pool (mutation guard-required by typing), its ready
// flag, the missing-record fallback, and counters.
fn process_image_execution_model_assumption() {
    static_assert(KERNEL_ACTIVE_CORES == 1,
                  "the ext2 exec staging is shared: two cores exec'ing at once each stage over the other");
}
