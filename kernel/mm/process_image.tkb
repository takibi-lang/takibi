use "kernel/mm/page.tkb";
use "kernel/kernel/pool_lock_wait.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/kernel/process.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/fs/elf64.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/lib/mutex.tkb";
use "kernel/lib/atomic_word.tkb";
use "kernel/kernel/cpu_authority.tkb";


// User-page ownership is recorded only in the page tables. Address-space
// cleanup walks populated L2 branches and their L3 PTEs, so neither image
// mappings nor clone rollback needs an enormous per-page shadow array.
private let mut process_image_zero_page: [u8; PAGE_SIZE];
// Streaming ELF source selected only for the ext2-backed map entry point.
// The metadata window still contains the ELF header/program table; file
// bytes for PT_LOAD pages are fetched one filesystem block at a time.
// A dynamic ELF pair changes backing files between the application's and
// interpreter's PT_LOAD passes. These fields carry that second source only
// for the synchronous pair mapper below.
struct ProcessImageExt2Source {
    mount: Ext2Mount;
    inode: usize;
    length: usize;
}
variant ProcessImageSourceState { Absent; Ext2(ProcessImageExt2Source); }


private fn process_image_cpu_index() -> {0..<KERNEL_MAX_CORES as usize} {
    let core: usize = cpu_id();
    if (core < KERNEL_MAX_CORES) { return core; }
    return 0;
}

// GitHub issue #638: the ext2 exec staging -- the file the PT_LOAD bytes come
// from, the interpreter's file for a dynamic pair, and the one-block read
// buffer -- is held across ext2 reads, which wait for the device (may_block).
// It lives in a pool of KERNEL_MAX_CORES slots, one per exec in flight, not
// one per CPU, reached only through a ProcessImageSlot, a linear token:
// process_image_slot_acquire hands out a free slot and
// process_image_slot_release consumes the token, so the compiler rejects an
// exec that forgets to release it, releases it twice, or keeps using it
// after the release. Static storage, as ext2's and the block layer's pools
// (DECISIONS.md 2026-10-17).
//
// Trusted here, and only here (TRUSTED_BASE.md): process_image_slot_acquire
// returns a slot no other live ProcessImageSlot names. Its compare-exchange
// over process_image_slot_words is what makes that so; nothing checks it.
//
// Only the three ext2 map entry points acquire, and no function in this file
// calls one of them, so an exec holds one slot at a time
// (scripts/check_slot_pool_entries.py). An exec holds its ProcessImageSlot
// while ext2 takes an Ext2Slot and the block layer a BlockSlot, never the
// reverse, so the pools cannot wait on each other.
struct ProcessImageStaging {
    private source: ProcessImageSourceState;
    private pair_source: ProcessImageSourceState;
    block: [u8; KERNEL_BLOCK_SIZE];
}
private let mut process_image_staging: [ProcessImageStaging; KERNEL_MAX_CORES];
private let mut process_image_slot_words: [AtomicWord; KERNEL_MAX_CORES];

// `[unit]` is always 0: an owner needs a static parameter, and the slot's
// identity is its private index, which only this file reads.
linear struct ProcessImageSlot[unit: usize] {
    private index: {0..<KERNEL_MAX_CORES as usize};
}

// A free slot, waiting for one if every slot is held. The compare-exchange
// is an acquire, pairing with the release store in
// process_image_slot_release, so the previous holder's last writes happen
// before this holder's first read. A new holder starts with both sources
// Absent.
private fn process_image_slot_acquire() -> ProcessImageSlot[0] !{may_block} {
    preempt_assert_blockable();
    let mut index: {0..<KERNEL_MAX_CORES as usize} = 0;
    let mut held: bool = false;
    while (held == false) {
        for i: usize in 0..<KERNEL_MAX_CORES {
            if (held == false &&
                atomic_word_compare_exchange(&process_image_slot_words[i], 0, 1)) {
                index = i;
                held = true;
            }
        }
    }
    process_image_staging[index].source = ProcessImageSourceState::Absent;
    process_image_staging[index].pair_source = ProcessImageSourceState::Absent;
    let mut slot: ProcessImageSlot[0] = { index };
    return slot;
}

private fn process_image_slot_release(slot: sink ProcessImageSlot[0]) {
    process_image_staging[slot.index].source = ProcessImageSourceState::Absent;
    process_image_staging[slot.index].pair_source = ProcessImageSourceState::Absent;
    atomic_word_store(&process_image_slot_words[slot.index], 0);
}

private fn process_image_set_source(slot: borrow ProcessImageSlot[0],
                                    mount: Ext2Mount, inode: usize,
                                    length: usize) {
    let mut source: ProcessImageExt2Source = { mount, inode, length };
    process_image_staging[slot.index].source = ProcessImageSourceState::Ext2(source);
}

private fn process_image_set_pair_source(slot: borrow ProcessImageSlot[0],
                                         mount: Ext2Mount, inode: usize,
                                         length: usize) {
    let mut source: ProcessImageExt2Source = { mount, inode, length };
    process_image_staging[slot.index].pair_source = ProcessImageSourceState::Ext2(source);
}
// GitHub issue #448: the source root, the destination root, and the running
// page count of "the clone in flight" live in the destination's own
// ProcessImageRecord, because there is no longer one clone in flight. See
// ProcessCloneVm* below for what that ceiling cost.

// GitHub issues #258 and #264: one persistent record per address-space
// root, replacing the prior ProcessLayout table plus the separate flattened
// growth-page array. Its scalar fields are ProcessLayout's former fields,
// kept flat so their existing direct accesses stay simple; the growth-page
// list is now attached to the same root it describes.
//
// The layout is now per-process DATA, set once when an image is mapped
// and read everywhere else -- which is what lets two processes differ
// (the static-PIE and dynamic/musl paths already wanted different stack
// floors, 448 vs 504, and expressed that as two separate global
// constants each consulted from its own set of sites). GitHub issue #254
// needs exactly this: a process whose address space is bigger than one
// L3 table gets a different `stack_top_page`, with no constant to chase.
//
// Same "one managed thing, one struct" rule as kernel/mm/page.tkb's
// PageMeta (issue #253): a future per-address-space field belongs here,
// not in another root-indexed global.
struct ProcessImageRecord {
    // Live state.
    active_page_count: usize;
    stack_lowest_l3: usize;      // current downward extent of the stack
    stack_growth_active: bool;
    // Layout proper.
    stack_top_page: usize;       // highest page; the initial stack page
    stack_low_page: usize;       // lowest page the stack may ever occupy
    heap_page_count: usize;
    // GitHub issue #392: the exec image installed against this root, as
    // the two facts the reap path actually asks of it. It was a parked
    // linear ProcessImagePages in an array keyed by root -- see
    // process_image_exec_install for what that array was and why the
    // parking lot is gone rather than pooled.
    exec_image_installed: bool;
    exec_image_page_count: usize;
    // GitHub issue #448: the fork that produced this root, while it is
    // still outstanding -- the pages copied into it are the parent's,
    // shared copy-on-write, and stay owed back until this process execs
    // (replacing them) or exits (releasing them).
    //
    // This was a global singleton: one `linear view` parked in a
    // mutex-guarded store, plus a source root, a destination root and a
    // page count beside it. That is an N=1 ceiling, and a second fork
    // taken before the first child had exec'd got -EAGAIN. BusyBox init
    // forks its `respawn` entries back to back, so a `/etc/inittab` with
    // more than one of them failed at the second entry with "can't fork"
    // -- and init never retries an entry whose fork failed, so that entry
    // was simply gone for the life of the boot.
    //
    // Per-record for the same reason exec_image_installed above is: the
    // thing owed back belongs to one process, so it is described by that
    // process's own record rather than by a global that can only ever
    // describe one of them.
    //
    // What that costs, stated plainly: the singleton could be a LINEAR
    // owner, and linearity is what made "reaped exactly once" a compile
    // error to get wrong. A flag is not that. The trade is not a
    // preference -- that migration did not retain a parked linear owner
    // inside the pooled record. The erased indexed view used for synchronous
    // writes below proves record existence, not an obligation surviving
    // exec or exit. exec_image_installed above made the same trade, and the
    // detector is also the same: end-of-boot accounting fails if a page or
    // a pooled record does not come back.
    clone_vm_outstanding: bool;
    clone_vm_source_root: usize;
    clone_vm_page_count: usize;
    // GitHub issue #1151: the (address, generation) of this root's mmap
    // region bitmap, or 0 while no mmap has taken a page. A reference, not
    // the 512 bytes themselves: this record is copied by value on every
    // read (#1103/#1108).
    mmap_bitmap: usize;
    mmap_bitmap_generation: usize;
}

// GitHub issue #392: pooled, not an array keyed by process slot. See
// kernel/kernel/fd_table.tkb's own note -- an array keyed by a slot cannot
// outlive the slot, and the slot is the ceiling being removed. The handle
// lives in ProcessRecord (image_record / image_record_generation).
//
// GitHub issue #672 layer 3: the pool is the built-in region_pool, and no
// pointer to a record is handed out. A record is read as a value copy under
// a pin (process_image_record_read) and written one field at a time under a
// pin (process_image_set_*), which is the granularity every caller already
// had: each access looked the record up again.
private let mut process_image_pool: RegionPool(ProcessImageRecord);

// One page per chunk: a record is a dozen words.
const PROCESS_IMAGE_CHUNK_PAGES: usize = 1;

// Reached only when a record is needed and the page allocator cannot
// provide one (or a handle is stale). Genuine exhaustion has nowhere to be
// reported from sixty-odd field accesses, so it is COUNTED, and the count
// is printed at the end of the boot suite; a missing record reads as all
// zero and its writes are dropped.
private let mut process_image_record_missing_count:
    [usize; KERNEL_MAX_CORES];

private fn process_image_record_missing_note() {
    let core = process_image_cpu_index();
    process_image_record_missing_count[core] = process_image_record_missing_count[core] + 1;
}

fn process_image_record_missing_uses() -> usize {
    let mut total: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        total = total + process_image_record_missing_count[core];
    }
    return total;
}

private fn process_image_pool_lock(pool: *RegionPool(ProcessImageRecord) @ images)
        -> RegionPoolGuard(ProcessImageRecord)[images] !{unsafe, acquires_lock_39_process_image_pool, single_instance_lock, may_block,
          lock_guard_39_process_image_pool} {
    if (region_pool_lock_contended_hint(pool)) { pool_lock_wait_contended(PoolLockWaitPool::ProcessImage); }
    return region_pool_lock(pool);
}

private fn process_image_pool_unlock(
        guard: sink RegionPoolGuard(ProcessImageRecord)[images]) {
    region_pool_unlock(guard);
}

// The initiator retains the allocator guard across a complete stop. The
// diagnostic path must refuse it without waiting for this same CPU.
fn process_image_stopped_pool_busy_probe() -> bool !{unsafe} {
    let guard = process_image_pool_lock(&process_image_pool);
    let mut refused: bool = false;
    match world_stop_machine_begin_holding_probe(DDB_WORLD_STOP_SPINS) {
        MachineStopResult::Busy => {}
        MachineStopResult::Partial(partial) => { machine_stop_partial_release(partial, &kernel_world_stop); }
        MachineStopResult::Complete(stopped) => {
            let mut words: ProcessPoolHandleWords = { 0, 0 };
            match process_image_inspect_stopped(stopped, &process_image_pool, words) {
                RegionInspectionProbe(ProcessImageRecord)::Busy => { refused = true; }
                RegionInspectionProbe(ProcessImageRecord)::Stale => {}
                RegionInspectionProbe(ProcessImageRecord)::Inspected(inspected) => { region_inspection_drop(inspected); }
            }
            machine_stop_release(stopped, &kernel_world_stop);
        }
    }
    process_image_pool_unlock(guard);
    return refused;
}

// GitHub issue #392: how many root records the pool is holding. A
// create-and-reap cycle must give every one of them back, and
// scheduled_process_table_probe asserts exactly that -- the detector for
// this release path, built in with it rather than after the first leak.
fn process_image_record_live_count() -> usize !{unsafe} {
    let guard = process_image_pool_lock(&process_image_pool);
    let live: usize = region_pool_live_count(guard);
    process_image_pool_unlock(guard);
    return live;
}

// The built-in pool starts empty from .bss and needs no construction. Kept
// for its callers' ordering before secondary startup.
fn process_image_pool_init_before_secondary() {}

private fn process_image_pool_return_empty(
        guard: borrow RegionPoolGuard(ProcessImageRecord)[images]) !{unsafe} {
    let mut more: bool = true;
    while (more) {
        match region_pool_shrink(guard) {
            RegionShrink(ProcessImageRecord)::Nothing => { more = false; }
            RegionShrink(ProcessImageRecord)::Chunk(bytes) => {
                let address: usize = region_bytes_address(bytes);
                region_release(bytes);
                page_run_transferred_release_physical(
                    address, PROCESS_IMAGE_CHUNK_PAGES);
            }
        }
    }
}

private fn process_image_record_slot_free(
        slot: sink RegionReleaseSlot(ProcessImageRecord)[p, k]) !{unsafe} {
    let guard = process_image_pool_lock(&process_image_pool);
    match region_slot_adopt(guard, slot) {
        RegionReleaseAdopt(ProcessImageRecord)::Foreign(stray) => {
            process_image_record_missing_note();
            region_slot_abandon(stray);
        }
        RegionReleaseAdopt(ProcessImageRecord)::Adopted(mine) => {
            region_free(guard, mine);
            process_image_pool_return_empty(guard);
        }
    }
    process_image_pool_unlock(guard);
}

private fn process_image_record_unpin(
        pin: sink RegionPin(ProcessImageRecord)[p, k]) !{unsafe} {
    match region_unpin(pin) {
        RegionUnpin(ProcessImageRecord)::Unpinned => {}
        RegionUnpin(ProcessImageRecord)::Last(slot) => {
            process_image_record_slot_free(slot);
        }
    }
}

// A pin on the record a root's handle names, or Stale. As fd_context_pin:
// the root form reads the handle under the run lock, the words form takes
// one its caller read under its own authority.
private fn process_image_record_pin(
        pool: *RegionPool(ProcessImageRecord) @ images, root: usize)
        -> RegionPinned(ProcessImageRecord)[images] !{unsafe} {
    return process_image_record_pin_words(pool,
        process_image_record_handle_of_root(root));
}

// GitHub issue #831: root 0's image record handle. Root 0 is the kernel's
// own address space, and no process record names it any more (the boot
// thread runs on it the way Linux's kernel threads run on init_mm), so its
// handle is kept here, as its backing is kept in address_space.tkb. Written
// once, by the first ensure during boot, and never released.
private let mut process_image_root0_record: ProcessPoolHandleWords;

// The handle of a root's image record: root 0's own, or the one the record
// of the process whose root it is holds.
private fn process_image_record_handle_of_root(root: usize)
        -> ProcessPoolHandleWords !{unsafe} {
    if (root == 0) { return process_image_root0_record; }
    return scheduled_process_image_record_handle(root);
}

private fn process_image_record_pin_words(
        pool: *RegionPool(ProcessImageRecord) @ images,
        words: ProcessPoolHandleWords)
        -> RegionPinned(ProcessImageRecord)[images] !{unsafe} {
    let guard = process_image_pool_lock(pool);
    let mut handle: RegionHandle(ProcessImageRecord) =
        region_handle_from(guard, words.address, words.generation);
    let pinned = region_pin(guard, handle);
    process_image_pool_unlock(guard);
    return pinned;
}

// The same, allocating a record first if this root has none.
//
// Allocating on access rather than only at process creation is what keeps
// the array's own contract: a root that anyone names has a record, whether
// or not a scheduler slot was ever allocated for it. Probes name roots
// directly, and the clone paths name a destination root before it is
// anybody's process. scheduled_process_alloc still ensures one up front,
// so ordinary process creation reports exhaustion where it can roll back.
private fn process_image_record_pin_ensured(
        pool: *RegionPool(ProcessImageRecord) @ images, root: usize)
        -> RegionPinned(ProcessImageRecord)[images] !{unsafe} {
    match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => {
            let mut absent: ProcessPoolHandleWords = { 0, 0 };
            return process_image_record_pin_words(pool, absent);
        }
        ProcessImageRecordReady::Ready(evidence) => {
            return process_image_record_pin(pool, root);
        }
    }
}

// A root's record as a value copy; all zero when it is missing (counted).
fn process_image_record_read(root: usize) -> ProcessImageRecord !{unsafe} {
    return process_image_record_value(
        process_image_record_pin_ensured(&process_image_pool, root), true);
}

// The copy itself, from a pin however it was obtained; a missing record is
// counted only when the caller asked for one to exist.
private fn process_image_record_value(
        pinned: sink RegionPinned(ProcessImageRecord)[images],
        note_missing: bool) -> ProcessImageRecord !{unsafe} {
    let mut value: ProcessImageRecord = {
        0, 0, false, 0, 0, 0, false, 0, false, 0, 0, 0, 0
    };
    match pinned {
        RegionPinned(ProcessImageRecord)::Stale => {
            if (note_missing) { process_image_record_missing_note(); }
        }
        RegionPinned(ProcessImageRecord)::Pinned(pin) => {
            let record: &mut ProcessImageRecord = region_pin_record(pin);
            value = process_image_record_copy(record);
            process_image_record_unpin(pin);
        }
    }
    return value;
}

// Both pinned and stopped inspection copy through this payload boundary.
private fn process_image_record_copy(record: borrow &mut ProcessImageRecord)
        -> ProcessImageRecord {
    let mut value: ProcessImageRecord;
    value.active_page_count = record.active_page_count;
    value.stack_lowest_l3 = record.stack_lowest_l3;
    value.stack_growth_active = record.stack_growth_active;
    value.stack_top_page = record.stack_top_page;
    value.stack_low_page = record.stack_low_page;
    value.heap_page_count = record.heap_page_count;
    value.exec_image_installed = record.exec_image_installed;
    value.exec_image_page_count = record.exec_image_page_count;
    value.clone_vm_outstanding = record.clone_vm_outstanding;
    value.clone_vm_source_root = record.clone_vm_source_root;
    value.clone_vm_page_count = record.clone_vm_page_count;
    value.mmap_bitmap = record.mmap_bitmap;
    value.mmap_bitmap_generation = record.mmap_bitmap_generation;
    return value;
}

must_use variant ProcessImageDiagnosticCount {
    Busy;
    Stale;
    Ready(usize);
}

private fn process_image_inspect_stopped(
        stopped: borrow MachineStopped[&kernel_world_stop],
        pool: *RegionPool(ProcessImageRecord) @ images, words: ProcessPoolHandleWords)
        -> RegionInspectionProbe(ProcessImageRecord)[images, &kernel_world_stop]
        !{unsafe, irq_masking_guard} {
    return region_pool_inspect_unproven__ProcessImageRecord(pool, &kernel_world_stop,
        words.address, words.generation);
}

fn process_image_active_page_count_stopped(
        stopped: borrow MachineStopped[&kernel_world_stop],
        words: ProcessPoolHandleWords) -> ProcessImageDiagnosticCount !{unsafe} {
    if (words.address == 0) { return ProcessImageDiagnosticCount::Ready(0); }
    match process_image_inspect_stopped(stopped, &process_image_pool, words) {
        RegionInspectionProbe(ProcessImageRecord)::Busy => { return ProcessImageDiagnosticCount::Busy; }
        RegionInspectionProbe(ProcessImageRecord)::Stale => { return ProcessImageDiagnosticCount::Stale; }
        RegionInspectionProbe(ProcessImageRecord)::Inspected(inspected) => {
            let mut value: ProcessImageRecord = process_image_record_copy(region_inspection_record(inspected));
            region_inspection_drop(inspected);
            return ProcessImageDiagnosticCount::Ready(value.active_page_count);
        }
    }
}

// One field of the ensured root's record, written under a fresh pin. The
// erased evidence prevents unensured calls; a stale pin still detects a
// violation of process ownership's lifetime contract (and is counted).
fn process_image_set_active_page_count(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity], value: usize) !{unsafe} {
    process_image_set_active_page_count_pinned(
        process_image_record_pin(&process_image_pool, root), value);
}

private fn process_image_set_active_page_count_pinned(
        pinned: sink RegionPinned(ProcessImageRecord)[images],
        value: usize) !{unsafe} {
    let RegionPinned(ProcessImageRecord)::Pinned(pin) = pinned else {
        RegionPinned(ProcessImageRecord)::Stale => {
            process_image_record_missing_note();
            return;
        }
    };
    let record: &mut ProcessImageRecord = region_pin_record(pin);
    record.active_page_count = value;
    process_image_record_unpin(pin);
}

fn process_image_set_stack_lowest_l3(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity], value: usize) !{unsafe} {
    process_image_set_stack_lowest_l3_pinned(
        process_image_record_pin(&process_image_pool, root), value);
