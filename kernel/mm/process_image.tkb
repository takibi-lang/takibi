private fn process_image_set_exec_image_page_count_pinned(
        pinned: sink RegionPinned(ProcessImageRecord)[images],
        value: usize) !{unsafe} {
    let RegionPinned(ProcessImageRecord)::Pinned(pin) = pinned else {
        RegionPinned(ProcessImageRecord)::Stale => {
            process_image_record_missing_note();
            return;
        }
    };
    let record: &mut ProcessImageRecord = region_pin_record(pin);
    record.exec_image_page_count = value;
    process_image_record_unpin(pin);
}

fn process_image_set_clone_vm_outstanding(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity], value: bool) !{unsafe} {
    let RegionPinned(ProcessImageRecord)::Pinned(pin) =
            process_image_record_pin(&process_image_pool, root) else {
        RegionPinned(ProcessImageRecord)::Stale => {
            process_image_record_missing_note();
            return;
        }
    };
    let record: &mut ProcessImageRecord = region_pin_record(pin);
    record.clone_vm_outstanding = value;
    process_image_record_unpin(pin);
}

fn process_image_set_clone_vm_source_root(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity], value: usize) !{unsafe} {
    let RegionPinned(ProcessImageRecord)::Pinned(pin) =
            process_image_record_pin(&process_image_pool, root) else {
        RegionPinned(ProcessImageRecord)::Stale => {
            process_image_record_missing_note();
            return;
        }
    };
    let record: &mut ProcessImageRecord = region_pin_record(pin);
    record.clone_vm_source_root = value;
    process_image_record_unpin(pin);
}

fn process_image_set_clone_vm_page_count(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity], value: usize) !{unsafe} {
    let RegionPinned(ProcessImageRecord)::Pinned(pin) =
            process_image_record_pin(&process_image_pool, root) else {
        RegionPinned(ProcessImageRecord)::Stale => {
            process_image_record_missing_note();
            return;
        }
    };
    let record: &mut ProcessImageRecord = region_pin_record(pin);
    record.clone_vm_page_count = value;
    process_image_record_unpin(pin);
}

// The state a root's record starts in, written down rather than left as
// whatever zeroing produced (issue #392). Zero is not the fresh value of
// stack_lowest_l3: the stack grows DOWNWARD from the top page, so "nothing
// grown yet" is the top page, not 0.
private fn process_image_record_reset(record: borrow &mut ProcessImageRecord) {
    record.active_page_count = 0;
    record.stack_growth_active = false;
    record.stack_lowest_l3 = process_stack_top_page();
    record.stack_top_page = process_stack_top_page();
    record.stack_low_page = PROCESS_STACK_LOW;
    record.heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;
    record.exec_image_installed = false;
    record.exec_image_page_count = 0;
}

// Acquired by scheduled_process_alloc for every process, by
// kernel_syscall_process_configure for root 0 (the boot thread's, #831), and
// on demand by any access to a root that has none. Idempotent.
//
// Released by scheduled_process_reap_teardown and scheduled_process_table_clear,
// beside the fd context and the address-space root, EXCEPT for root 0 --
// the kernel's own root, whose record is set up once during boot, exactly
// the exemption address_space_release_root already makes one layer down.
// Minted only after successful publication or validation. Process ownership
// prevents release while a caller borrows this erased write authority.
private affine view ProcessImageRecordExists[root: usize];

must_use variant ProcessImageRecordReady[root: usize] {
    Missing;
    Ready(ProcessImageRecordExists[root]);
}

fn process_image_record_ensure(root: usize @ identity)
        -> ProcessImageRecordReady[identity] !{unsafe} {
    if (address_space_root_key_valid(root) == false) {
        return ProcessImageRecordReady::Missing;
    }
    match process_image_record_pin(&process_image_pool, root) {
        RegionPinned(ProcessImageRecord)::Pinned(pin) => {
            process_image_record_unpin(pin);
            return ProcessImageRecordReady::Ready(view ProcessImageRecordExists[identity]);
        }
        RegionPinned(ProcessImageRecord)::Stale => {}
    }
    let guard = process_image_pool_lock(&process_image_pool);
    match region_alloc(guard) {
        RegionPoolAlloc(ProcessImageRecord)::Allocated(fresh) => {
            process_image_pool_unlock(guard);
            return process_image_record_publish(&process_image_pool, root, fresh);
        }
        RegionPoolAlloc(ProcessImageRecord)::Exhausted => { process_image_pool_unlock(guard); return ProcessImageRecordReady::Missing; }
        RegionPoolAlloc(ProcessImageRecord)::Full => {}
    }
    if (process_image_pool_grow(guard)) {
        match region_alloc(guard) {
            RegionPoolAlloc(ProcessImageRecord)::Allocated(fresh) => {
                process_image_pool_unlock(guard);
                return process_image_record_publish(&process_image_pool, root, fresh);
            }
            RegionPoolAlloc(ProcessImageRecord)::Exhausted => { process_image_pool_unlock(guard); return ProcessImageRecordReady::Missing; }
            RegionPoolAlloc(ProcessImageRecord)::Full => {}
        }
    }
    process_image_pool_unlock(guard);
    return ProcessImageRecordReady::Missing;
}

private fn process_image_record_publish(
        pool: *RegionPool(ProcessImageRecord) @ images, root: usize @ identity,
        fresh: sink RegionSlot(ProcessImageRecord)[images, k]) -> ProcessImageRecordReady[identity] !{unsafe} {
    region_slot_zero(fresh);
    process_image_record_reset(region_slot_record(fresh));
    let guard = process_image_pool_lock(pool);
    let mut handle: RegionHandle(ProcessImageRecord) = region_give(guard, fresh);
    process_image_pool_unlock(guard);
    if (root == 0) {
        process_image_root0_record.address = region_handle_address(handle);
        process_image_root0_record.generation = region_handle_generation(handle);
    } else {
        scheduled_process_set_image_record(
            root, region_handle_address(handle), region_handle_generation(handle));
    }
    return ProcessImageRecordReady::Ready(view ProcessImageRecordExists[identity]);
}

private fn process_image_pool_grow(
        guard: borrow RegionPoolGuard(ProcessImageRecord)[images]) -> bool !{unsafe} {
    match page_alloc_contiguous(PROCESS_IMAGE_CHUNK_PAGES, PageOwnerTag::PoolChunk) {
        PageRunAllocResult::OutOfMemory => { return false; }
        PageRunAllocResult::Allocated(run_owner) => {
            let base: usize = page_run_physical_address(run_owner);
            let RegionBytes::Assumed(chunk) =
                page_run_into_region(run_owner) else {};
            match region_pool_grow(guard, chunk) {
                RegionGrow(ProcessImageRecord)::Grown => { return true; }
                RegionGrow(ProcessImageRecord)::TooSmall(back) => {
                    region_release(back);
                    page_run_transferred_release_physical(
                        base, PROCESS_IMAGE_CHUNK_PAGES);
                    return false;
                }
            }
        }
    }
}

// GitHub issue #392: gives a root's record back. Root 0 keeps its record
// for the life of the kernel -- see process_image_record_ensure's own note
// for why that is root 0's exemption and not a leak. The handle
// is cleared first, then the record is retired; the last pin frees it.
fn process_image_record_release(root: usize) !{unsafe} {
    if (root == 0) { return; }
    process_image_record_release_words(root,
        scheduled_process_image_record_handle(root));
}

// The same, with the handle read under the caller's authority (the reap's
// owner).
fn process_image_record_release_words(root: usize,
                                      words: ProcessPoolHandleWords) !{unsafe} {
    if (root == 0) { return; }
    if (words.address == 0) { return; }
    let pinned = process_image_record_pin_words(&process_image_pool, words);
    scheduled_process_set_image_record(root, 0, 0);
    match pinned {
        RegionPinned(ProcessImageRecord)::Stale => {
            kernel_boot_log("process image: releasing a stale root record handle\n");
        }
        RegionPinned(ProcessImageRecord)::Pinned(pin) => {
            // GitHub issue #1151: the root's mmap bitmap goes with it.
            let image_record: &mut ProcessImageRecord = region_pin_record(pin);
            let mut bitmap: ProcessPoolHandleWords = {
                image_record.mmap_bitmap, image_record.mmap_bitmap_generation
            };
            image_record.mmap_bitmap = 0;
            image_record.mmap_bitmap_generation = 0;
            mmap_region_free_words(bitmap);
            match region_retire(pin) {
                RegionRetire(ProcessImageRecord)::Pending => {}
                RegionRetire(ProcessImageRecord)::Retired(record) => {
                    process_image_record_slot_free(record);
                }
            }
        }
    }
}

// GitHub issue #479 made the root an image operation is aimed at per-CPU
// state, set by one call and read by another. GitHub issue #981 removed it:
// every reader takes the root as a parameter from a caller that holds it --
// a map operation its target, a fault the current process's root, an image
// its ProcessImagePages -- so no operation can read a root another left
// behind (#437's stale root 0 on wait4's fast path was exactly that).

// GitHub issue #392: a root is a process slot, and a process slot is a
// pool address now, so there is no range to narrow it into. The question
// the refinement stood in for -- does this name a real root -- is asked of
// address_space_root_slot_valid, which answers about a LIVE process rather
// than about an index being in bounds. Root 0 is the kernel's own root and
// always valid.
// GitHub issue #410: a root that was chosen and no longer names a live
// process is the #270 hazard -- a teardown resolving through root 0, which
// was BusyBox init's live image until #831, so it unmapped PID 1. Counted
// and gated on zero. (The "no target chosen" half went with the per-CPU
// target, #981.)
private let mut process_image_root_stale_count:
    [usize; KERNEL_MAX_CORES];

private fn process_image_root_counter_total(counts: borrow [usize; KERNEL_MAX_CORES..]) -> usize {
    let mut total: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        total = total + counts[core];
    }
    return total;
}

// A target that was chosen and whose root has since stopped naming a live
// process. This one is gated on zero, and it is the one issue #270 hit.
fn process_image_root_stale_fallback_uses() -> usize {
    return process_image_root_counter_total(process_image_root_stale_count as []usize);
}

// GitHub issue #492 counted lookups that named an image slot with the
// previous occupant's generation. A pin is refused for those and nothing is
// read through them, so there is nothing left to count.
fn process_image_recycled_handle_count() -> usize { return 0; }

// A live process-image root is a domain value, not an arbitrary usize. A
// non-exhaustive enum retains the full usize representation while requiring
// an explicit cast at every domain boundary. Root 0 remains valid; absence is
// represented only by ProcessImageTargetRootResult::Missing.
struct ProcessImageRoot {
    private root: AddressSpaceRoot;
}

private fn process_image_root(root: AddressSpaceRoot) -> ProcessImageRoot {
    let mut wrapped: ProcessImageRoot = { root };
    return wrapped;
}

fn process_image_root_index(root: ProcessImageRoot) -> usize {
    return root_slot_word(address_space_root_slot(root.root));
}

fn process_image_root_space(root: ProcessImageRoot) -> AddressSpaceRoot {
    return root.root;
}

must_use variant ProcessImageTargetRootResult {
    Missing;
    Ready(ProcessImageRoot);
}

// GitHub issue #516: a root that no longer names a live process is refused,
// and counted (process_image_root_stale_fallback_uses), rather than read.
fn process_image_root_checked(root: AddressSpaceRoot)
        -> ProcessImageTargetRootResult !{unsafe} {
    if (address_space_root_slot_valid(address_space_root_slot(
            root)) == false) {
        let stale_count_core = process_image_cpu_index();
        process_image_root_stale_count[stale_count_core] = process_image_root_stale_count[stale_count_core] + 1;
        return ProcessImageTargetRootResult::Missing;
    }
    return ProcessImageTargetRootResult::Ready(
        process_image_root(root));
}

private fn process_image_pte_read(target: AddressSpaceRoot, index: usize) -> usize {
    return address_space_pte_read(target, index);
}

// Do not transfer PageOwner until the lazy-L3 allocation and PTE write have
// both succeeded. This is the mapping-side half of address_space.tkb's OOM
// contract; the failure arm returns the still-owned physical page directly.
private fn process_image_install_page(target: AddressSpaceRoot,
                              page: sink PageOwner[page_id],
                              index: usize, flags: usize) -> bool {
    match address_space_map_page(
            target, index, page, flags) {
        AddressSpacePteWriteResult::Invalid => {
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            return false;
        }
        AddressSpacePteWriteResult::Written => {
            return true;
        }
    }
}

must_use variant ProcessCloneVmResult { OutOfMemory; Copied; }
must_use variant ProcessCloneVmReapResult { Missing; Reaped; }

// GitHub issue #258 step 2: `process_stack_top_page() = 511` is gone -- the
// initial stack always sits on the address space's own last page, so it is
// derived rather than stored or restated. (A `const` cannot do this: a
// top-level const initializer may not do arithmetic on another file's
// identifier, and USER_SPACE_PAGE_COUNT lives in address_space.tkb.)
fn process_stack_top_page() -> usize {
    return USER_SPACE_PAGE_COUNT - 1;
}

// The user window's fixed layout, in pages from USER_TEXT_VA (GitHub issue
// #1151, maintainer option (A)): the image and its brk heap from page 0 up,
// then a gap, the mmap region at MMAP_REGION_FIRST_PAGE, one unmapped guard
// page, and the stack from PROCESS_STACK_LOW up to the window's last page.
// Nothing above the heap is mapped until it is touched: the region's pages
// on the fault of a page an mmap holds, the stack's on the fault of a page
// inside its reservation (#198).
//
// The mmap region: 4096 pages (16 MiB) at a fixed base three quarters into
// the window, above the largest image pair DISTRO_ELF_SPAN_MAX admits and
// its heap. Its pages are taken and given back one bit each in a per-root
// bitmap (MmapRegionBitmap, below); brk never reaches it.
const MMAP_REGION_FIRST_PAGE: usize = 196608;
const MMAP_REGION_PAGES: usize = 4096;
// The lowest page the stack may ever occupy, one guard page above the mmap
// region: MMAP_REGION_FIRST_PAGE + MMAP_REGION_PAGES + 1 (asserted below).
// The same for every image -- the static and dynamic paths used to differ
// here (448 and 504) only because their heaps ended at different pages,
// which a floor above every heap no longer cares about. Seeds
// ProcessImageRecord.stack_low_page, which every reader goes through.
const PROCESS_STACK_LOW: usize = 200705;

fn process_layout_assumption() {
    static_assert(PROCESS_STACK_LOW == MMAP_REGION_FIRST_PAGE + MMAP_REGION_PAGES + 1,
                  "#1151: the stack floor sits one guard page above the mmap region");
    static_assert((2 * DISTRO_ELF_SPAN_MAX + 0x10000) / PAGE_SIZE +
                  PROCESS_HEAP_PAGES_DEFAULT <= MMAP_REGION_FIRST_PAGE,
                  "#1041/#1151: two images of the largest span and the heap end below the mmap region");
    static_assert(PROCESS_STACK_LOW + PROCESS_DYNAMIC_STACK_INITIAL_PAGES <
                  USER_SPACE_PAGE_COUNT - 1,
                  "#1151: the initial stack pages fit above the stack floor");
    static_assert(MMAP_REGION_PAGES == MMAP_REGION_WORDS * 64,
                  "#1151: the mmap bitmap has one bit per region page");
}
// BYTES, not pages: how much room at the very top of the initial stack
// page is reserved for the argv/envp/auxv block. Unrelated to the address
// space's own page count despite both having been 512 (see
// kernel/mm/address_space.tkb's USER_SPACE_PAGE_COUNT comment -- issue
// #253 briefly conflated the two by reusing this name as a table bound;
// issue #258 separated them again).
// GitHub issue #1039: execve admits at most PROCESS_EXEC_ARGC_MAX strings
// totalling PROCESS_EXEC_ARGV_BYTES (NULs included), and the layout below
// is derived from those two limits, so every argv execve admits fits in
// both builders' stack blocks. Before, the layout was a separate 512 that
// left the strings only 512 minus the header, and an admitted argv
// fail-stopped the kernel after execve's point of no return.
const PROCESS_EXEC_ARGV_BYTES: usize = 512;
const PROCESS_EXEC_ARGC_MAX: usize = 15;
// Words before the auxv vector: argc and the two NULL terminators (argv[]
// itself is counted per argument).
const PROCESS_STACK_HEAD_WORDS: usize = 3;
// auxv words, AT_NULL included: static image, dynamic image.
const PROCESS_STACK_AUXV_WORDS_STATIC: usize = 18;
const PROCESS_STACK_AUXV_WORDS_DYNAMIC: usize = 28;
const PROCESS_STACK_RANDOM_BYTES: usize = 16;
const PROCESS_STACK_LAYOUT_BYTES: usize =
    (PROCESS_EXEC_ARGC_MAX + PROCESS_STACK_HEAD_WORDS +
     PROCESS_STACK_AUXV_WORDS_DYNAMIC) * 8 +
    PROCESS_STACK_RANDOM_BYTES + PROCESS_EXEC_ARGV_BYTES;
const PROCESS_STACK_WORDS: usize = PROCESS_STACK_LAYOUT_BYTES / 8;
// Seed for ProcessImageRecord.heap_page_count (see PROCESS_STACK_LOW_*
// above): consulted only where an image is mapped, never as a
// decision point elsewhere.
const PROCESS_HEAP_PAGES_DEFAULT: usize = 128;
const USER_SPACE_BYTES: usize = 0x40000000;
const PROCESS_DYNAMIC_STACK_INITIAL_PAGES: usize = 8;
const AT_PHDR: usize = 3;
const AT_PHENT: usize = 4;
const AT_PHNUM: usize = 5;
const AT_PAGESZ: usize = 6;
const AT_BASE: usize = 7;
const AT_ENTRY: usize = 9;
const AT_SECURE: usize = 23;
const AT_RANDOM: usize = 25;
const AT_UID: usize = 11;
const AT_EUID: usize = 12;
const AT_GID: usize = 13;
const AT_EGID: usize = 14;
const AT_EXECFN: usize = 31;

// The userspace ABI is little-endian AArch64. Keep the stack as the byte
// slice carried by PageOwner and encode words explicitly; this avoids
// discarding the page view's bounds/ownership evidence by minting a u64*.
fn process_stack_store_word(stack: borrow [u8; PROCESS_STACK_LAYOUT_BYTES..],
                            index: {0..<PROCESS_STACK_WORDS as usize},
                            value: u64) {
    let offset: usize = index * 8;
    stack[offset] = value as u8;
    stack[offset + 1] = (value >> 8) as u8;
    stack[offset + 2] = (value >> 16) as u8;
    stack[offset + 3] = (value >> 24) as u8;
    stack[offset + 4] = (value >> 32) as u8;
    stack[offset + 5] = (value >> 40) as u8;
    stack[offset + 6] = (value >> 48) as u8;
    stack[offset + 7] = (value >> 56) as u8;
}

fn process_stack_load_word(stack: borrow [u8; PROCESS_STACK_LAYOUT_BYTES..],
                           index: {0..<PROCESS_STACK_WORDS as usize}) -> u64 {
    let offset: usize = index * 8;
    return (stack[offset] as u64) |
           ((stack[offset + 1] as u64) << 8) |
           ((stack[offset + 2] as u64) << 16) |
           ((stack[offset + 3] as u64) << 24) |
           ((stack[offset + 4] as u64) << 32) |
           ((stack[offset + 5] as u64) << 40) |
           ((stack[offset + 6] as u64) << 48) |
           ((stack[offset + 7] as u64) << 56);
}

// Give back everything a clone into `dest` had taken, and leave that
// root describing no clone. Safe to call on a root whose clone never got
// far enough to be recorded: the fields it clears are already clear.
fn process_clone_vm_rollback(dest_space: AddressSpaceRoot) {
    let dest: usize = root_slot_word(address_space_root_slot(dest_space));
    address_space_release_user_mappings(dest_space);
    if (address_space_root_key_valid(dest)) {
        let root: usize =
            process_image_narrow_root(dest);
        let evidence = match process_image_record_ensure(root) {
            ProcessImageRecordReady::Missing => {
                process_image_record_missing_note();
                return;
            }
            ProcessImageRecordReady::Ready(ready) => { ready }
        };
        process_image_set_active_page_count(root, evidence, 0);
        process_image_set_stack_growth_active(root, evidence, false);
        process_image_set_stack_lowest_l3(root, evidence, process_stack_top_page());
        process_image_set_clone_vm_outstanding(root, evidence, false);
        process_image_set_clone_vm_page_count(root, evidence, 0);
        // GitHub issue #1151: its region's pages went with the mappings.
        mmap_region_clear(root, evidence);
    }
}

// GitHub issue #245: dest_root is the caller's choice, not a fixed "root
// 1" -- process.tkb's kernel_process_clone_begin() allocates the child's
// process-table slot first and passes that slot's index straight through,
// so root index == ProcessHandle.pool_index holds everywhere. The source
// is the caller's current root (GitHub issue #981: a parameter), not a fixed "root 0" -- a process running on any root can
// fork, not just the one on root 0.
fn process_image_narrow_root(value: usize) -> usize !{unsafe} {
    if (address_space_root_key_valid(value)) { return value; }
    return 0;
}

fn process_image_clone_vm_begin(source_space: AddressSpaceRoot,
                                dest_space: AddressSpaceRoot) -> ProcessCloneVmResult !{unsafe} {
    let dest_root: usize = root_slot_word(address_space_root_slot(dest_space));
    if (address_space_root_key_valid(dest_root) == false ||
        dest_root == root_slot_word(address_space_root_slot(source_space)) ||
        address_space_is_live(dest_space) == false) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    let dest: usize =
        process_image_narrow_root(dest_root);
    let source: usize = root_slot_word(address_space_root_slot(source_space));
    // GitHub issue #448: a clone already owed back on this root would be
    // leaked by overwriting its bookkeeping. It cannot happen (a root
    // belongs to one process, and that process cannot fork into itself),
    // and refusing says so rather than assuming it.
    if (process_image_record_read(dest).clone_vm_outstanding) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    let evidence = match process_image_record_ensure(dest) {
        ProcessImageRecordReady::Missing => { return ProcessCloneVmResult::OutOfMemory; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    process_image_set_clone_vm_source_root(dest, evidence, source);
    process_image_set_clone_vm_page_count(dest, evidence, 0);
    let mut clone_page_count: usize = 0;
    address_space_clear_root(dest_space);
    // Reset the destination root's demand-stack metadata before rebuilding
    // it below, the same way process_image_map_current() resets its own
    // root's before mapping a fresh image -- otherwise a reaped child's
    // stale counts would leak into the next fork.
    process_image_set_stack_growth_active(dest, evidence, false);
    process_image_set_active_page_count(dest, evidence, 0);
    process_image_set_stack_lowest_l3(dest, evidence, process_stack_top_page());
    // GitHub issue #258 step 2: a child inherits the parent's layout, not a
    // global constant -- which is the whole point of the layout being data.
    let clone_src: usize =
        process_image_narrow_root(source);
    process_image_set_stack_top_page(dest, evidence, process_stack_top_page());
    process_image_set_stack_low_page(dest, evidence,
        process_image_record_read(clone_src).stack_low_page);
    process_image_set_heap_page_count(dest, evidence,
        process_image_record_read(clone_src).heap_page_count);
    // GitHub issue #1151: the child holds the parent's mmap pages.
    if (mmap_region_clone(clone_src, dest, evidence) == false) {
        process_clone_vm_rollback(dest_space);
        return ProcessCloneVmResult::OutOfMemory;
    }
    // Tracks the lowest growth-region L3 index actually copied below, so the
    // child's watermark reflects its real page table rather than being
    // inherited verbatim from the parent's own
    // process_image_record_read(source).stack_lowest_l3 bookkeeping, which only
    // describes the parent's own demand-grown pages, not the child's.
    let mut clone_stack_lowest_l3: usize = process_stack_top_page();
    // GitHub issue #392: one BRANCH at a time. A branch with no L3 table
    // has no present PTEs, so the old flat 0..<USER_SPACE_PAGE_COUNT walk
    // asked 511 of every 512 questions for nothing -- 262144 validated
    // reads per fork, and forks are what this kernel does most. Same
    // answer, same order (l3_index still ascends), ~200x less of it.
    for branch: usize in 0..<USER_L2_BRANCH_COUNT {
      if (address_space_l3_branch_physical(source_space, branch) == 0) {
        continue;
      }
      for entry: usize in 0..<USER_L3_PAGE_COUNT {
        let l3_index: usize = branch * USER_L3_PAGE_COUNT + entry;
        let parent_pte: usize = address_space_pte_read(source_space, l3_index);
        if (parent_pte != 0) {
            let parent_physical: usize = parent_pte & USER_PAGE_PHYS_MASK;
            match page_mapping_retain_physical(parent_physical,
                                               address_space_live_count()) {
                PageMappingRetainResult::Retained => {}
                PageMappingRetainResult::NotMapped => {
                    process_clone_vm_rollback(dest_space);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                PageMappingRetainResult::RefCeilingReached => {
                    // Issue #406: not exhaustion. A page mapped into more
                    // address spaces than exist says the count no longer
                    // matches reality, and this is the one real mapping
                    // path, so this is where it is recorded. The clone is
                    // still rolled back: refusing is what keeps a broken
                    // invariant from becoming a broken address space.
                    page_mapping_ref_bound_break();
                    process_clone_vm_rollback(dest_space);
                    return ProcessCloneVmResult::OutOfMemory;
                }
            }
            // GitHub issue #1147: a shared mapping's page stays writable in
            // both, the same physical page; only private pages go COW.
            let cow: bool = address_space_pte_is_writable(parent_pte) &&
                            address_space_pte_is_shared(parent_pte) == false;
            let mut child_pte: usize = parent_pte;
            if (cow) {
                child_pte = address_space_pte_cow_value(parent_pte);
            }
            match address_space_pte_write(dest_space, l3_index, child_pte) {
                AddressSpacePteWriteResult::Invalid => {
                    page_mapping_release_physical(parent_physical);
                    process_clone_vm_rollback(dest_space);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    page_mapping_release_physical(parent_physical);
                    process_clone_vm_rollback(dest_space);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                AddressSpacePteWriteResult::Written => {
                    if (cow) {
                        match address_space_pte_write(
                                source_space, l3_index,
                                address_space_pte_cow_value(parent_pte)) {
                            AddressSpacePteWriteResult::Invalid => {
                                process_clone_vm_rollback(dest_space);
                                return ProcessCloneVmResult::OutOfMemory;
                            }
                            AddressSpacePteWriteResult::OutOfMemory => {
                                process_clone_vm_rollback(dest_space);
                                return ProcessCloneVmResult::OutOfMemory;
                            }
                            AddressSpacePteWriteResult::Written => {
                            }
                        }
                    }
                    clone_page_count = clone_page_count + 1;
                    if (l3_index >=
                            process_image_record_read(clone_src).stack_low_page &&
                        l3_index < process_stack_top_page() &&
                        l3_index < clone_stack_lowest_l3) {
                        clone_stack_lowest_l3 = l3_index;
                    }
                }
            }
        }
      }
    }
    if (clone_page_count == 0) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    // The copy loop above mirrors every present parent PTE (including any
    // stack pages the parent had already demand-faulted in) into the
    // destination root, so the child gets its own demand-stack watermark
    // derived from what was actually copied. Without this, a forked child
    // fail-stops the instant it grows its stack past whatever was already
    // mapped at fork time (issue #219).
    process_image_set_active_page_count(dest, evidence, clone_page_count);
    process_image_set_stack_growth_active(dest, evidence, true);
    process_image_set_stack_lowest_l3(dest, evidence, clone_stack_lowest_l3);
    process_image_set_clone_vm_page_count(dest, evidence, clone_page_count);
    process_image_set_clone_vm_outstanding(dest, evidence, true);
    return ProcessCloneVmResult::Copied;
}

// GitHub issue #245: replaces the old activate_parent()/activate_child()
// pair, which hardcoded root 0 ("parent") and root 1 ("child") as global
// roles. Callers now track their own parent/child root relationships
// (process.tkb's per-slot ProcessHandle.pool_index) and pass the explicit
// root they mean, since with more than one live clone in the tree "the
// child" and "the parent" are relative to whoever is switching, not fixed
// numbers.
fn process_image_activate_root(target: AddressSpaceRoot) {
    let root: usize = root_slot_word(address_space_root_slot(target));
    if (address_space_root_key_valid(root) == false) { return; }
    // Root 0 owns permanent ASID 1 and never participates in rollover. Every
    // dynamic root uses the stopped preparation boundary, including exec and
    // boot-fixture callers outside the scheduler handoff paths.
    if (root == 0) {
        address_space_activate_root(target);
        kernel_process_trace_address_space_activate(root);
        return;
    }
    kernel_process_activate_stable_root(target);
}

// Split activation for scheduler handoffs that may need an ASID rollover.
// Preparation does not change TTBR0; commit changes it only after the caller has revalidated its reserved process.
fn process_image_prepare_activation(root: AddressSpaceRoot)
        -> AddressSpaceActivationPrepareResult {
    return address_space_prepare_activation(root);
}

fn process_image_commit_activation(
        prepared: sink AddressSpaceActivationPrepared[root]) -> bool {
    match address_space_commit_activation(prepared) {
        AddressSpaceActivationCommitResult::Invalid => { return false; }
        AddressSpaceActivationCommitResult::Activated(target) => {
            kernel_process_trace_address_space_activate(
                root_slot_word(address_space_root_slot(target)));
            return true;
        }
    }
}

fn process_image_cancel_activation(
        prepared: sink AddressSpaceActivationPrepared[root]) {
    address_space_cancel_activation(prepared);
}

// Give the parent's copy-on-write pages back and put the parent's root
// into TTBR0 again. `dest_root` is the root the clone was made INTO -- the
// caller's own, at every one of the three call sites, since a clone is
// reaped by the process that received it (when it execs, when it exits, or
// when the rest of the clone failed under it).
//
// GitHub issue #448: this used to take no argument and read the one clone
// the kernel could have in flight out of a global. Naming the root is what
// lets two of them be outstanding at once.
fn process_image_clone_vm_reap(dest_space: AddressSpaceRoot) -> ProcessCloneVmReapResult !{unsafe} {
    let dest_root: usize = root_slot_word(address_space_root_slot(dest_space));
    if (address_space_root_key_valid(dest_root) == false) {
        return ProcessCloneVmReapResult::Missing;
    }
    let dest: usize = process_image_narrow_root(dest_root);
    if (process_image_record_read(dest).clone_vm_outstanding == false) {
        return ProcessCloneVmReapResult::Missing;
    }
    let source: usize = process_image_record_read(dest).clone_vm_source_root;
    // The caller remains the logical current process throughout this
    // non-preemptible EL1 span. Activate the retained source before releasing
    // mappings from a destination that may still be installed in TTBR0.
    kernel_process_activate_stable_root(
        address_space_root_of_key(source));
    process_clone_vm_rollback(dest_space);
    return ProcessCloneVmReapResult::Reaped;
}

// GitHub issue #219 verification: process_image_clone_vm_begin() must
// initialize root 1's demand-stack metadata so process_image_handle_data_
// abort() can grow the child's stack past whatever was mapped at fork
// time, instead of fail-stopping. Exercises the real clone_vm_begin/
// handle_data_abort/clone_vm_reap sequence directly against a synthetic
// single-page root-0 image (bypassing the ELF loader, which nothing here
// depends on), because neither real EL0 process that forks in this kernel
// can exercise it: the tiny fixed-layout initial bootstrap process has a
// whole address space smaller than one growth-region page (never meant to
// support stack growth at all), and the pinned Alpine BusyBox binary's
// recursion depth is not something this test controls.
fn process_image_clone_growth_probe() -> bool !{unsafe} {
    let evidence = match process_image_record_ensure(0) {
        ProcessImageRecordReady::Missing => { return false; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    // GitHub issue #392: the child root is a live process's record now,
    // not the bare number 1 -- see
    // scheduled_process_probe_slot_acquire for why a probe has to be a
    // process to have a root of its own.
    let mut child_root_slot: ProcessSlot = scheduled_process_probe_slot_acquire();
    let child_root: usize = process_slot_address(child_root_slot);
    let mut child_root_root: AddressSpaceRoot = scheduled_process_address_space_root_lookup(child_root_slot);
    if (child_root == 0) { return false; }
    if (address_space_is_live(child_root_root)) {
        scheduled_process_probe_slot_release(child_root_slot);
        return false;
    }
    match address_space_ensure_root(child_root_slot) {
        AddressSpaceEnsureResult::Ok => {}
        AddressSpaceEnsureResult::SlotOutOfRange => {
            scheduled_process_probe_slot_release(child_root_slot);
            return false;
        }
        AddressSpaceEnsureResult::OutOfMemory => {
            scheduled_process_probe_slot_release(child_root_slot);
            return false;
        }
    }
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            address_space_release_root(child_root_root);
            scheduled_process_probe_slot_release(child_root_slot);
            return false;
        }
        PageAllocResult::Allocated(stack_page) => {
            match address_space_map_page(
                    address_space_boot_root(), process_stack_top_page(), stack_page, USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    address_space_release_root(child_root_root);
                    scheduled_process_probe_slot_release(child_root_slot);
                    return false;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    address_space_release_root(child_root_root);
                    scheduled_process_probe_slot_release(child_root_slot);
                    return false;
                }
                AddressSpacePteWriteResult::Written => {
                }
            }
        }
    }
    // Mirrors exactly the metadata process_image_map_current() sets after
    // mapping a fresh image's single top stack page: growth enabled, one
    // page active, nothing yet grown below the top.
    process_image_set_stack_growth_active(0, evidence, true);
    process_image_set_active_page_count(0, evidence, 1);
    process_image_set_stack_lowest_l3(0, evidence, process_stack_top_page());
    process_image_set_stack_top_page(0, evidence, process_stack_top_page());
    process_image_set_stack_low_page(0, evidence, PROCESS_STACK_LOW);
    process_image_set_heap_page_count(0, evidence, PROCESS_HEAP_PAGES_DEFAULT);

    let mut ok: bool = true;
    let mut cow_parent_physical: usize = 0;
    match process_image_clone_vm_begin(address_space_boot_root(), child_root_root) {
        ProcessCloneVmResult::OutOfMemory => { ok = false; }
        ProcessCloneVmResult::Copied => {}
    }

    if (ok) {
        process_image_activate_root(child_root_root);
        // fork must initially share the parent's top stack page, with both
        // PTEs marked COW. A simulated EL0 write-permission fault then gives
        // only root 1 a private writable page while root 0 retains the
        // original shared frame.
        let top_page: usize = process_stack_top_page();
        let parent_before: usize = address_space_pte_read(address_space_boot_root(), top_page);
        let child_before: usize = address_space_pte_read(child_root_root, top_page);
        if ((parent_before & USER_PAGE_PHYS_MASK) !=
                    (child_before & USER_PAGE_PHYS_MASK) ||
            address_space_pte_is_cow(parent_before) == false ||
            address_space_pte_is_cow(child_before) == false) {
            ok = false;
        }
        cow_parent_physical = parent_before & USER_PAGE_PHYS_MASK;
        // EC=0x24, WnR=1, DFSC=0x0f: EL0 write permission fault on the
        // child's present COW PTE.
        let cow_esr: usize = 0x9000004F;
        let cow_fault: usize = USER_TEXT_VA + top_page * PAGE_SIZE;
        if (ok && (process_image_handle_data_abort(child_root_root, cow_esr, cow_fault) == false ||
            address_space_pte_is_cow(address_space_pte_read(child_root_root, top_page)) ||
            address_space_pte_is_writable(address_space_pte_read(child_root_root, top_page)) == false ||
            (address_space_pte_read(address_space_boot_root(), top_page) & USER_PAGE_PHYS_MASK) ==
                (address_space_pte_read(child_root_root, top_page) & USER_PAGE_PHYS_MASK))) {
            ok = false;
        }
        // EC=0x24 (data abort from a lower EL), DFSC=0x07 (translation
        // fault, level 3) for a missing PTE in the already-populated top
        // L3 branch.
        let l3_esr: usize = 0x90000007;
        let first_page: usize = process_stack_top_page() - 11;
        let first_fault: usize = USER_TEXT_VA + first_page * PAGE_SIZE;
        if (process_image_handle_data_abort(child_root_root, l3_esr, first_fault) == false ||
            address_space_pte_read(child_root_root, first_page) == 0) {
            ok = false;
        }
        // Crossing into branch 510 finds no L3 descriptor at all, producing
        // DFSC=0x06 (translation fault, level 2). The handler must create
        // that L3 page and map the gap in one call.
        let l2_esr: usize = 0x90000006;
        let second_page: usize = process_stack_top_page() - 512;
        let second_fault: usize = USER_TEXT_VA + second_page * PAGE_SIZE;
        if (ok && (process_image_handle_data_abort(child_root_root, l2_esr, second_fault) == false ||
            address_space_pte_read(child_root_root, second_page) == 0 ||
            address_space_pte_read(child_root_root, second_page + 1) == 0 ||
            address_space_pte_read(child_root_root, first_page - 1) == 0)) {
            ok = false;
        }
        process_image_activate_root(address_space_boot_root());
    }

    match process_image_clone_vm_reap(child_root_root) {
        ProcessCloneVmReapResult::Missing => {}
        ProcessCloneVmReapResult::Reaped => {}
    }
    // Once the child mapping is reaped, the parent owns its original COW
    // page alone. Resolving it must restore write permission in place rather
    // than allocate another page under memory pressure.
    let parent_after_reap: usize =
        address_space_pte_read(address_space_boot_root(), process_stack_top_page());
    if (ok && (page_mapping_refcount_physical(cow_parent_physical) != 1 ||
        address_space_pte_is_cow(parent_after_reap) == false ||
        address_space_resolve_cow(address_space_boot_root(), process_stack_top_page()) == false ||
        address_space_pte_is_writable(
            address_space_pte_read(address_space_boot_root(), process_stack_top_page())) == false ||
        (address_space_pte_read(address_space_boot_root(), process_stack_top_page()) &
            USER_PAGE_PHYS_MASK) != cow_parent_physical)) {
        ok = false;
    }
    address_space_pte_clear(address_space_boot_root(), process_stack_top_page());
    process_image_set_stack_growth_active(0, evidence, false);
    process_image_set_active_page_count(0, evidence, 0);
    process_image_set_stack_lowest_l3(0, evidence, process_stack_top_page());
    address_space_release_root(child_root_root);
    scheduled_process_probe_slot_release(child_root_slot);
    return ok;
}

linear struct ProcessImagePages[image: usize] {
    private image: usize @ image;
    // The root these pages were mapped into (#981): install and unmap act
    // on it, not on a root some other operation left selected.
    private root: AddressSpaceRoot;
    private count: usize;
    private entry: usize;
    private stack_pointer: usize;
    private heap_start: usize;
    private heap_limit: usize;
}

must_use variant ProcessImageMapResult {
    InvalidImage;
    OutOfMemory;
    Mapped(exists image: usize. ProcessImagePages[image]);
}

must_use variant ProcessImagePageLoadResult { Invalid; Loaded; }
must_use variant ProcessImageStackResult { Invalid; Ready; }
must_use variant ProcessImageSegmentsResult {
    Invalid;
    OutOfMemory;
    Mapped(usize);
}
must_use variant ProcessImagePairProbeResult {
    Invalid;
    Ready(exists image: usize. ProcessImagePages[image]);
}

// GitHub issue #392: THE PARKING LOT IS GONE, for the same reason and in
// the same shape as issue #257's on tcp.tkb.
//
// `process_image_exec_stores` was a [ProcessImageExecStore;
// KERNEL_PROCESS_MAX] of { mutex, ProcessImageExecValue } -- somewhere for
// a linear ProcessImagePages to live between the execve that mapped it and
// the exit that unmaps it, since neither end can hold a linear value across
// a return to userspace. It could not be one global store (a shell can exec
// and then fork another command, so the outer shell's image must stay owned
// while its child installs a distinct one), so it was one store per root,
// keyed by an index -- the key that stops existing when the process table
// becomes a pool.
//
// The root's own record is already the per-root, pooled home for exactly
// this, so the two facts the reap path asks of a parked image live there.
// What is deliberately given up: the parked value was linear, so the type
// system proved an installed image is unmapped exactly once. A bool proves
// nothing; process_image_exec_reap's own take-then-clear is what makes it
// once. That is the same trade issue #257 made, and the reason it is
// acceptable is the same -- the owner is still linear for the whole
// map-and-install operation, which is where an image can actually be
// duplicated or dropped.
fn process_image_pages_discard(pages: sink ProcessImagePages[image]) {}

// Whether this root still owns an image a previous execve installed. The
// only caller that can answer anything with it is the exec path itself: a
// process that execs twice has to release the first image before the second
// one is mapped over the same window, and by the time install runs the old
// image's page-table entries have already been overwritten.
fn process_image_exec_image_installed(root: usize) -> bool !{unsafe} {
    if (address_space_root_key_valid(root) == false) { return false; }
    return process_image_record_read(root).exec_image_installed;
}

// GitHub issue #516: NoTarget is the third outcome. Installing with no target
// chosen used to consult ROOT 0's `exec_image_installed` flag and then write
// ROOT 0's page count -- PID 1's live image, decided by a fallback rather
// than by a caller. Since #981 the root comes with the pages, so NoTarget
// means that root has stopped naming a live process.
must_use variant ProcessImageExecInstallResult {
    Installed;
    AlreadyInstalled;
    NoTarget;
    OutOfMemory;
}

fn process_image_exec_install(
        pages: sink ProcessImagePages[image]) -> ProcessImageExecInstallResult {
    let root: usize = match process_image_root_checked(pages.root) {
        ProcessImageTargetRootResult::Missing => {
            // The incoming image is this function's to dispose of on every
            // path that does not install it, exactly as AlreadyInstalled
            // below already does -- and `pages` being linear is what makes
            // that a compile error to forget rather than a leak to find.
            process_image_unmap(pages);
            return ProcessImageExecInstallResult::NoTarget;
        }
        ProcessImageTargetRootResult::Ready(target) => {
            process_image_root_index(target)
        }
    };
    if (process_image_record_read(root).exec_image_installed) {
        // Unchanged: the INCOMING image is the one unmapped, and the
        // already-installed one is left alone.
        process_image_unmap(pages);
        return ProcessImageExecInstallResult::AlreadyInstalled;
    }
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { process_image_unmap(pages); return ProcessImageExecInstallResult::OutOfMemory; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    process_image_set_exec_image_page_count(root, evidence,
        process_image_page_count(pages));
    process_image_set_exec_image_installed(root, evidence, true);
    process_image_pages_discard(pages);
    return ProcessImageExecInstallResult::Installed;
}

// GitHub issue #209: an applet used to be launched by the kernel itself,
// which then unmapped the image and checked process_image_window_is_clear()
// on the spot. Applets are children of the init script now, so their images
// are torn down here instead. Counting both reaps and clean reaps here
// keeps that VM-hygiene assertion, and does it for every applet at once
// rather than one hand-written check per kernel-side launch.
private let mut process_image_exec_reap_count: usize;
private let mut process_image_exec_reap_clean_count: usize;
private let mut process_image_exec_reap_stack_growth_count: usize;

fn process_image_root_window_is_clear(
        root: AddressSpaceRoot) -> bool !{unsafe} {
    return address_space_user_window_is_clear(root);
}

fn process_image_exec_reap_evidence() -> (usize, usize, usize) {
    return (process_image_exec_reap_count,
            process_image_exec_reap_clean_count,
            process_image_exec_reap_stack_growth_count);
}

// GitHub issue #392: split in two, because the two halves belong to two
// different moments once a root's record dies with its process.
//
// The TEARDOWN half is about the child's own image, and now runs from
// scheduled_process_reap_teardown -- immediately after address_space_release_root,
// so the window-is-clear evidence still measures a fully torn-down root,
// and before process_image_record_release, which is what makes it the last
// moment the installed flag and page count still exist.
//
// It clears the target on EVERY path, installed or not. Leaving it
// pointing at the dead child's root is not a tidiness question: the next
// EL0 COW permission fault resolves against whatever the target names, and
// against the wrong root it cannot resolve at all. That was one fail-stop in
// the busybox fixture, found the first time this release was wired in. Since
// GitHub issue #516 a CLEARED target refuses the fault outright instead of
// resolving it against root 0, which is the better of the two failures: it
// names the fault rather than PID 1's next write.
fn process_image_exec_teardown(target: AddressSpaceRoot,
                               words: ProcessPoolHandleWords) !{unsafe} {
    match process_image_root_checked(target) {
        ProcessImageTargetRootResult::Missing => {
            return;
        }
        ProcessImageTargetRootResult::Ready(root) => {
            let root_index: usize = process_image_root_index(root);
            // GitHub issue #693 step 5: the record is reached by the handle
            // the reaper read through its owner, never by the root's slot:
            // the reap runs both with and without the run guard, so a
            // self-locking read here would be rejected (#694).
            let mut before: ProcessImageRecord = process_image_record_value(
                process_image_record_pin_words(&process_image_pool, words), true);
            // Take before acting, so an image is reaped once even though what
            // says it exists is now a bool rather than a linear value.
            let installed: bool = before.exec_image_installed;
            let count: usize = before.exec_image_page_count;
            process_image_set_exec_image_installed_pinned(
                process_image_record_pin_words(&process_image_pool, words), false);
            process_image_set_exec_image_page_count_pinned(
                process_image_record_pin_words(&process_image_pool, words), 0);
            if (installed) {
                if (before.stack_growth_active && before.active_page_count > count) {
                    process_image_exec_reap_stack_growth_count =
                        process_image_exec_reap_stack_growth_count + 1;
                }
                // process_image_unmap_pages for this root, whose resets
                // process_image_cleanup_root repeats unconditionally.
                address_space_release_user_mappings(target);
                process_image_set_active_page_count_pinned(
                    process_image_record_pin_words(&process_image_pool, words), 0);
                process_image_set_stack_growth_active_pinned(
                    process_image_record_pin_words(&process_image_pool, words), false);
                process_image_set_stack_lowest_l3_pinned(
                    process_image_record_pin_words(&process_image_pool, words),
                    process_stack_top_page());
                process_image_exec_reap_count =
                    process_image_exec_reap_count + 1;
                if (process_image_root_window_is_clear(target)) {
                    process_image_exec_reap_clean_count =
                        process_image_exec_reap_clean_count + 1;
                }
            }
        }
    }
}

// The RESUME half stays where it was, at the parent's return, because that
// is the only moment "current" means the parent.
//
// process_image_unmap clears the later page-table target; it leaves TTBR0
// on the root it just emptied. The parent is resumed straight
// after this, so activate its root here exactly as process_image_clone_vm_
// reap does for the plain fork/exit path -- otherwise the parent returns to
// EL0 against the unmapped child root and faults on its own first
// instruction. GitHub issue #245: this runs from
// kernel_syscall_clone_parent_return(), reached only via
// kernel_process_child_exit()'s own return value -- by construction that
// has already switched execution_current_handle back to the parent, so
// kernel_process_current_root() is already correct here, not a fixed
// root 0.
fn process_image_exec_resume_root() {
    let ProcessRunningHere::Running(current_authority) = process_running_here() else {};
    kernel_process_activate_stable_root(kernel_process_current_root(current_authority));
    process_current_end(current_authority);
}

// A flat, NUL-terminated argv blob is deliberately used instead of an array
// of `[]u8` owners: it is plain immutable data, so one builder can consume
// literal argv values now and a script/path-derived argv later without an
// ownership transfer per element. `argc` names exactly how many strings the
// blob contains.
fn process_image_prepare_stack(page: borrow PageOwner[page],
                               plan: DistroElfLoadPlan,
                               argv: borrow []const u8,
                               argc: usize)
        -> ProcessImageStackResult !{unsafe} {
    static_assert((PROCESS_EXEC_ARGC_MAX + PROCESS_STACK_HEAD_WORDS +
                   PROCESS_STACK_AUXV_WORDS_STATIC) * 8 +
                  PROCESS_STACK_RANDOM_BYTES + PROCESS_EXEC_ARGV_BYTES <=
                  PROCESS_STACK_LAYOUT_BYTES,
                  "#1039: every argv execve admits fits the static stack block");
    static_assert((PROCESS_EXEC_ARGC_MAX + PROCESS_STACK_HEAD_WORDS +
                   PROCESS_STACK_AUXV_WORDS_DYNAMIC) * 8 +
                  PROCESS_STACK_RANDOM_BYTES + PROCESS_EXEC_ARGV_BYTES <=
                  PROCESS_STACK_LAYOUT_BYTES,
                  "#1039: every argv execve admits fits the dynamic stack block");
    if (argc < 1 || argc > PROCESS_EXEC_ARGC_MAX) {
        return ProcessImageStackResult::Invalid;
    }
    let argument_count: {1..<16 as usize} = argc;
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }
    let stack = bytes[PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES..<PAGE_SIZE];

    let virtual_base: usize = USER_TEXT_VA +
                              process_stack_top_page() * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    // argc, argv[], argv terminator, envp terminator, then eight auxv
    // key/value pairs and AT_NULL. The random bytes immediately follow.
    let auxv_start: usize = argument_count + PROCESS_STACK_HEAD_WORDS;
    let random_offset: usize = (auxv_start + PROCESS_STACK_AUXV_WORDS_STATIC) * 8;
    let mut string_offset: usize = random_offset + PROCESS_STACK_RANDOM_BYTES;
    if (string_offset > PROCESS_STACK_LAYOUT_BYTES) {
        return ProcessImageStackResult::Invalid;
    }
    let random_address: usize = virtual_base + random_offset;
    process_stack_store_word(stack, 0, argument_count as u64);

    let mut arg: usize = 0;
    process_stack_store_word(stack, 1,
                             (virtual_base + string_offset) as u64);
    // `for byte in argv` is the slice-safe iterator form: argv may later be
    // runtime data, but no unproved index is introduced while scanning it.
    for byte in argv {
        if (arg >= argument_count) { break; }
        let write_offset: usize = string_offset;
        if (write_offset < stack.len) {
            stack[write_offset] = byte;
        } else {
            return ProcessImageStackResult::Invalid;
        }
        string_offset = string_offset + 1;
        if (byte == 0) {
            arg = arg + 1;
            if (arg < argument_count) {
                process_stack_store_word(
                    stack, arg + 1, (virtual_base + string_offset) as u64);
            }
        }
    }
    if (arg != argument_count) { return ProcessImageStackResult::Invalid; }
    process_stack_store_word(stack, argument_count + 1, 0);
    process_stack_store_word(stack, argument_count + 2, 0);

    // The static PIE has no interpreter (AT_BASE=0). The ELF header and
    // program table are in the first PT_LOAD, so AT_PHDR is directly based
    // on the process load address.
    process_stack_store_word(stack, auxv_start, AT_PAGESZ as u64);
    process_stack_store_word(stack, auxv_start + 1, PAGE_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 2, AT_PHDR as u64);
    process_stack_store_word(stack, auxv_start + 3,
                             (USER_TEXT_VA + plan.program_offset) as u64);
    process_stack_store_word(stack, auxv_start + 4, AT_PHENT as u64);
    process_stack_store_word(stack, auxv_start + 5,
                             ELF_PROGRAM_HEADER_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 6, AT_PHNUM as u64);
    process_stack_store_word(stack, auxv_start + 7,
                             plan.program_count as u64);
    process_stack_store_word(stack, auxv_start + 8, AT_BASE as u64);
    process_stack_store_word(stack, auxv_start + 9, 0);
    process_stack_store_word(stack, auxv_start + 10, AT_ENTRY as u64);
    process_stack_store_word(stack, auxv_start + 11,
                             (USER_TEXT_VA + plan.entry) as u64);
    process_stack_store_word(stack, auxv_start + 12, AT_RANDOM as u64);
    process_stack_store_word(stack, auxv_start + 13, random_address as u64);
    process_stack_store_word(stack, auxv_start + 14, AT_SECURE as u64);
    process_stack_store_word(stack, auxv_start + 15, 0);
    process_stack_store_word(stack, auxv_start + 16, 0);
    process_stack_store_word(stack, auxv_start + 17, 0);
    for i: usize in 0..<16 {
        let random_index: usize = random_offset + i;
        if (random_index < stack.len) {
            stack[random_index] = (0xA5 ^ i) as u8;
        } else {
            return ProcessImageStackResult::Invalid;
        }
    }

    if (process_stack_load_word(stack, 0) != argument_count as u64 ||
        process_stack_load_word(stack, argument_count + 1) != 0 ||
        process_stack_load_word(stack, argument_count + 2) != 0 ||
        process_stack_load_word(stack, auxv_start + 1) != PAGE_SIZE as u64 ||
        process_stack_load_word(stack, auxv_start + 3) !=
            (USER_TEXT_VA + plan.program_offset) as u64 ||
        process_stack_load_word(stack, auxv_start + 11) !=
            (USER_TEXT_VA + plan.entry) as u64 ||
        process_stack_load_word(stack, auxv_start + 17) != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_dynamic_prepare_stack(page: borrow PageOwner[page],
                                 application: DistroElfLoadPlan,
                                 interpreter_bias: usize,
                                 argv: borrow []const u8,
                                 argc: usize)
        -> ProcessImageStackResult !{unsafe} {
    static_assert((PROCESS_EXEC_ARGC_MAX + PROCESS_STACK_HEAD_WORDS +
                   PROCESS_STACK_AUXV_WORDS_STATIC) * 8 +
                  PROCESS_STACK_RANDOM_BYTES + PROCESS_EXEC_ARGV_BYTES <=
                  PROCESS_STACK_LAYOUT_BYTES,
                  "#1039: every argv execve admits fits the static stack block");
    static_assert((PROCESS_EXEC_ARGC_MAX + PROCESS_STACK_HEAD_WORDS +
                   PROCESS_STACK_AUXV_WORDS_DYNAMIC) * 8 +
                  PROCESS_STACK_RANDOM_BYTES + PROCESS_EXEC_ARGV_BYTES <=
                  PROCESS_STACK_LAYOUT_BYTES,
                  "#1039: every argv execve admits fits the dynamic stack block");
    if (argc < 1 || argc > PROCESS_EXEC_ARGC_MAX) {
        return ProcessImageStackResult::Invalid;
    }
    let argument_count: {1..<16 as usize} = argc;
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }
    let stack = bytes[PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES..<PAGE_SIZE];

    let virtual_base: usize = USER_TEXT_VA +
                              process_stack_top_page() * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let auxv_start: usize = argument_count + PROCESS_STACK_HEAD_WORDS;
    let random_offset: usize = (auxv_start + PROCESS_STACK_AUXV_WORDS_DYNAMIC) * 8;
    let mut string_offset: usize = random_offset + PROCESS_STACK_RANDOM_BYTES;
    if (string_offset > PROCESS_STACK_LAYOUT_BYTES) {
        return ProcessImageStackResult::Invalid;
    }
    let random_address: usize = virtual_base + random_offset;
    process_stack_store_word(stack, 0, argument_count as u64);
    let mut arg: usize = 0;
    let execfn_address: usize = virtual_base + string_offset;
    process_stack_store_word(stack, 1, execfn_address as u64);
    for byte in argv {
        if (arg >= argument_count) { break; }
        let write_offset: usize = string_offset;
        if (write_offset < stack.len) {
            stack[write_offset] = byte;
        } else {
            return ProcessImageStackResult::Invalid;
        }
        string_offset = string_offset + 1;
        if (byte == 0) {
            arg = arg + 1;
            if (arg < argument_count) {
                process_stack_store_word(
                    stack, arg + 1, (virtual_base + string_offset) as u64);
            }
        }
    }
    if (arg != argument_count) { return ProcessImageStackResult::Invalid; }
    process_stack_store_word(stack, argument_count + 1, 0);
    process_stack_store_word(stack, argument_count + 2, 0);
    process_stack_store_word(stack, auxv_start, AT_PAGESZ as u64);
    process_stack_store_word(stack, auxv_start + 1, PAGE_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 2, AT_PHDR as u64);
    process_stack_store_word(
        stack, auxv_start + 3,
        (USER_TEXT_VA + application.program_offset) as u64);
    process_stack_store_word(stack, auxv_start + 4, AT_PHENT as u64);
    process_stack_store_word(stack, auxv_start + 5,
                             ELF_PROGRAM_HEADER_SIZE as u64);
    process_stack_store_word(stack, auxv_start + 6, AT_PHNUM as u64);
    process_stack_store_word(stack, auxv_start + 7,
                             application.program_count as u64);
    process_stack_store_word(stack, auxv_start + 8, AT_BASE as u64);
    process_stack_store_word(stack, auxv_start + 9,
                             (USER_TEXT_VA + interpreter_bias) as u64);
    process_stack_store_word(stack, auxv_start + 10, AT_ENTRY as u64);
    process_stack_store_word(stack, auxv_start + 11,
                             (USER_TEXT_VA + application.entry) as u64);
    process_stack_store_word(stack, auxv_start + 12, AT_RANDOM as u64);
    process_stack_store_word(stack, auxv_start + 13, random_address as u64);
    process_stack_store_word(stack, auxv_start + 14, AT_SECURE as u64);
    process_stack_store_word(stack, auxv_start + 15, 0);
    process_stack_store_word(stack, auxv_start + 16, AT_UID as u64);
    process_stack_store_word(stack, auxv_start + 17, 0);
    process_stack_store_word(stack, auxv_start + 18, AT_EUID as u64);
    process_stack_store_word(stack, auxv_start + 19, 0);
    process_stack_store_word(stack, auxv_start + 20, AT_GID as u64);
    process_stack_store_word(stack, auxv_start + 21, 0);
    process_stack_store_word(stack, auxv_start + 22, AT_EGID as u64);
    process_stack_store_word(stack, auxv_start + 23, 0);
    process_stack_store_word(stack, auxv_start + 24, AT_EXECFN as u64);
    process_stack_store_word(stack, auxv_start + 25, execfn_address as u64);
    process_stack_store_word(stack, auxv_start + 26, 0);
    process_stack_store_word(stack, auxv_start + 27, 0);
    for i: usize in 0..<16 {
        let random_index: usize = random_offset + i;
        if (random_index < stack.len) {
            stack[random_index] = (0x5A ^ i) as u8;
        } else {
            return ProcessImageStackResult::Invalid;
        }
    }

    if (process_stack_load_word(stack, 0) != argument_count as u64 ||
        process_stack_load_word(stack, argument_count + 1) != 0 ||
        process_stack_load_word(stack, argument_count + 2) != 0 ||
        process_stack_load_word(stack, auxv_start + 3) !=
            (USER_TEXT_VA + application.program_offset) as u64 ||
        process_stack_load_word(stack, auxv_start + 9) !=
            (USER_TEXT_VA + interpreter_bias) as u64 ||
        process_stack_load_word(stack, auxv_start + 11) !=
            (USER_TEXT_VA + application.entry) as u64 ||
        process_stack_load_word(stack, auxv_start + 27) != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

private fn process_image_load_page(slot: borrow ProcessImageSlot[0],
                           page: borrow PageOwner[page],
                           plan: DistroElfLoadPlan,
                           header: DistroElfSegment,
                           load_bias: usize,
                           l3_index: usize)
        -> ProcessImagePageLoadResult !{unsafe} {
    match process_image_staging[slot.index].source {
        ProcessImageSourceState::Absent => {}
        ProcessImageSourceState::Ext2(source) => {
            return process_image_load_page_ext2(
                slot, page, plan, header, load_bias, l3_index);
        }
    }
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let page_start: usize = l3_index * PAGE_SIZE;
    let page_end: usize = page_start + PAGE_SIZE;
    let segment_start: usize = (header.virtual_address as usize) + load_bias;
    let file_size: usize = header.file_size;
    let file_end: usize = segment_start + file_size;
    let mut copy_start: usize = page_start;
    if (copy_start < segment_start) { copy_start = segment_start; }
    let mut copy_end: usize = page_end;
    if (copy_end > file_end) { copy_end = file_end; }
    if (copy_start >= copy_end) {
        if (slice_eq(bytes, process_image_zero_page as []u8)) {
            return ProcessImagePageLoadResult::Loaded;
        }
        return ProcessImagePageLoadResult::Invalid;
    }

    let destination_offset: usize = copy_start - page_start;
    let source_offset: usize = header.offset +
                               (copy_start - segment_start);
    let copy_length: usize = copy_end - copy_start;
    let source = plan.image;
    if (destination_offset > PAGE_SIZE ||
        copy_length > PAGE_SIZE - destination_offset ||
        source_offset > plan.image_length ||
        copy_length > plan.image_length - source_offset ||
        source_offset > source.len ||
        copy_length > source.len - source_offset) {
        return ProcessImagePageLoadResult::Invalid;
    }

    let destination_tail = bytes[destination_offset..<PAGE_SIZE];
    let source_tail = source[source_offset..<source.len];
    if (copy_length > destination_tail.len) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let destination = destination_tail[0..<copy_length];
    if (copy_length > source_tail.len) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let file_bytes = source_tail[0..<copy_length];
    slice_copy(destination, file_bytes);
    if (slice_eq(destination, file_bytes) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }

    // Every byte outside the file-backed overlap must still be zero. Dynamic
    // endpoints reuse the same checked-slice evidence as the copy views.
    let zeros = process_image_zero_page as []u8;
    let suffix_start: usize = destination_offset + copy_length;
    if (suffix_start > PAGE_SIZE) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let prefix = bytes[0..<destination_offset];
    let zero_prefix = zeros[0..<destination_offset];
    let suffix = bytes[suffix_start..<PAGE_SIZE];
    let zero_suffix = zeros[suffix_start..<PAGE_SIZE];
    if (slice_eq(prefix, zero_prefix) == false ||
        slice_eq(suffix, zero_suffix) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }
    return ProcessImagePageLoadResult::Loaded;
}

// Ext2-backed counterpart to process_image_load_page(). It deliberately
// reads at most one filesystem block per ext2_read_file_chunk() call; the
// ELF itself never has to fit in a kernel scratch buffer.
private fn process_image_load_page_ext2(slot: borrow ProcessImageSlot[0],
                                page: borrow PageOwner[page],
                                plan: DistroElfLoadPlan,
                                header: DistroElfSegment,
                                load_bias: usize,
                                l3_index: usize)
        -> ProcessImagePageLoadResult !{unsafe} {
    let context: &mut ProcessImageStaging = &process_image_staging[slot.index];
    let source: ProcessImageExt2Source = match context.source {
        ProcessImageSourceState::Absent => {
            return ProcessImagePageLoadResult::Invalid;
        }
        ProcessImageSourceState::Ext2(selected) => { selected }
    };
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }
    let page_start: usize = l3_index * PAGE_SIZE;
    let page_end: usize = page_start + PAGE_SIZE;
    let segment_start: usize = (header.virtual_address as usize) + load_bias;
    let file_size: usize = header.file_size;
    let file_end: usize = segment_start + file_size;
    let mut copy_start: usize = page_start;
    if (copy_start < segment_start) { copy_start = segment_start; }
    let mut copy_end: usize = page_end;
    if (copy_end > file_end) { copy_end = file_end; }
    if (copy_start >= copy_end) {
        if (slice_eq(bytes, process_image_zero_page as []u8)) {
            return ProcessImagePageLoadResult::Loaded;
        }
        return ProcessImagePageLoadResult::Invalid;
    }
    if (copy_start < copy_end) {
        let mut destination_offset: usize = copy_start - page_start;
        let mut source_offset: usize = header.offset +
                                       (copy_start - segment_start);
        let mut remaining: usize = copy_end - copy_start;
        while (remaining != 0) {
            if (source_offset >= source.length) {
                return ProcessImagePageLoadResult::Invalid;
            }
            match ext2_read_file_chunk(
                    source.mount, source.inode,
                    source_offset, context.block as []u8) {
                Ext2ReadResult::Invalid => {
                    return ProcessImagePageLoadResult::Invalid;
                }
                Ext2ReadResult::Read(read_length) => {
                    if (read_length == 0) {
                        return ProcessImagePageLoadResult::Invalid;
                    }
                    let mut take: usize = read_length;
                    if (take > remaining) { take = remaining; }
                    let block_bytes = context.block as []u8;
                    let destination_start: usize = destination_offset;
                    if (take > block_bytes.len ||
                        destination_start > bytes.len) {
                        return ProcessImagePageLoadResult::Invalid;
                    }
                    let source = block_bytes[0..<take];
                    let destination_tail =
                        bytes[destination_start..<bytes.len];
                    if (take > destination_tail.len) {
                        return ProcessImagePageLoadResult::Invalid;
                    }
                    let destination = destination_tail[0..<take];
                    slice_copy(destination, source);
                    destination_offset = destination_offset + take;
                    source_offset = source_offset + take;
                    remaining = remaining - take;
                }
            }
        }
    }
    let zeros = process_image_zero_page as []u8;
    let prefix_end: usize = copy_start - page_start;
    let suffix_start: usize = copy_end - page_start;
    if (prefix_end > PAGE_SIZE || suffix_start > PAGE_SIZE) {
        return ProcessImagePageLoadResult::Invalid;
    }
    let prefix = bytes[0..<prefix_end];
    let zero_prefix = zeros[0..<prefix_end];
    let suffix = bytes[suffix_start..<PAGE_SIZE];
    let zero_suffix = zeros[suffix_start..<PAGE_SIZE];
    if (slice_eq(prefix, zero_prefix) == false ||
        slice_eq(suffix, zero_suffix) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }
    return ProcessImagePageLoadResult::Loaded;
}

// Address-space cleanup walks the actual L2/L3 tree, releasing every
// transferred user page and every dynamic L3 table page. It needs no
// per-image page-index list and scales with populated branches.
private fn process_image_cleanup_root(target: AddressSpaceRoot) {
    let root: usize = root_slot_word(address_space_root_slot(target));
    address_space_release_user_mappings(target);
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { process_image_record_missing_note(); return; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    process_image_set_active_page_count(root, evidence, 0);
    process_image_set_stack_growth_active(root, evidence, false);
    process_image_set_stack_lowest_l3(root, evidence, process_stack_top_page());
}


// Called directly from el0_sync_entry for a lower-EL data-abort translation
// fault. It accepts only an address inside the reserved, downward-growing
// stack and maps every missing page down to that address. Mapping the whole
// gap handles an ABI that subtracts a large stack frame before its first
// store, while the guard page below the reservation remains unmapped.
fn process_image_handle_data_abort(target: AddressSpaceRoot, esr: usize,
                                   fault_address: usize) -> bool {
    // GitHub issue #516: refuse the fault when no target is chosen, rather
    // than resolving it against root 0. kernel/kernel/process.tkb's reaper
    // comment is what this is: a reaper that returned to EL0 with the COW
    // handler aimed at root 0 -- PID 1's live image -- and fail-stopped on
    // its next write. Returning false here fail-stops on the FAULT instead,
    // which names the right thing.
    let root: usize = match process_image_root_checked(target) {
        ProcessImageTargetRootResult::Missing => { return false; }
        ProcessImageTargetRootResult::Ready(checked) => {
            process_image_root_index(checked)
        }
    };
    let exception_class: usize = (esr >> 26) & 0x3F;
    let fault_status: usize = esr & 0x3F;
    // A COW write is a level-3 permission fault (0x0f). It must be handled
    // before translation-fault stack growth: both refer to an EL0 data abort,
    // but only the COW PTE already names a present shared physical page.
    if (exception_class == 0x24 && fault_status == 0x0F &&
        (esr & (1 << 6)) != 0) {
        if (fault_address < USER_TEXT_VA ||
            fault_address >= USER_TEXT_VA + USER_SPACE_PAGE_COUNT * PAGE_SIZE) {
            return false;
        }
        let index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
        return address_space_resolve_cow(target, index);
    }
    // GitHub issue #1151: the first touch of a page an mmap holds maps it.
    if (exception_class == 0x24 &&
        (fault_status == 0x06 || fault_status == 0x07) &&
        fault_address >= USER_TEXT_VA &&
        mmap_region_contains((fault_address - USER_TEXT_VA) / PAGE_SIZE)) {
        return mmap_region_fault_in(
            target, (fault_address - USER_TEXT_VA) / PAGE_SIZE);
    }
    // A missing PTE inside an existing L3 is a level-3 translation fault
    // (0x07). A stack expansion into an unpopulated lazy-L3 branch faults
    // one level earlier (0x06); both are valid only after the range checks
    // below prove this is the current process's reserved stack.
    if (process_image_record_read(root).stack_growth_active == false ||
        exception_class != 0x24 ||
        (fault_status != 0x06 && fault_status != 0x07)) {
        return false;
    }
    let stack_start: usize = USER_TEXT_VA +
        process_image_record_read(root).stack_low_page * PAGE_SIZE;
    let stack_top: usize = USER_TEXT_VA + process_stack_top_page() * PAGE_SIZE;
    if (fault_address < stack_start || fault_address >= stack_top) {
        return false;
    }
    let fault_index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
    if (fault_index < process_image_record_read(root).stack_low_page ||
        fault_index >= process_image_record_read(root).stack_lowest_l3) {
        return false;
    }
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { return false; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    for l3_index: usize in
            fault_index..<process_image_record_read(root).stack_lowest_l3 {
        if (process_image_record_read(root).active_page_count >= USER_SPACE_PAGE_COUNT ||
            process_image_pte_read(target, l3_index) != 0) {
            return false;
        }
        match page_alloc(PageOwnerTag::UserPage) {
            PageAllocResult::OutOfMemory => { return false; }
            PageAllocResult::Allocated(stack_page) => {
                let bytes = page_bytes(stack_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                if (process_image_install_page(target,
                        stack_page, l3_index, USER_RW_XN_FLAGS) == false) {
                    return false;
                }
                process_image_set_active_page_count(root, evidence,
        process_image_record_read(root).active_page_count + 1);
            }
        }
    }
    process_image_set_stack_lowest_l3(root, evidence, fault_index);
    return true;
}

// GitHub issue #392: the page count is all either of these ever needed of
// the owner, so each has a half that takes the count on its own -- which
// is what process_image_exec_reap calls, now that what it reaps is a
// record field rather than a parked linear value.
private fn process_image_unmap_pages(target: AddressSpaceRoot, count: usize) {
    match process_image_root_checked(target) {
        ProcessImageTargetRootResult::Missing => {
            return;
        }
        ProcessImageTargetRootResult::Ready(root) => {
            let root_index: usize = process_image_root_index(root);
            let evidence = match process_image_record_ensure(root_index) {
                ProcessImageRecordReady::Missing => {
                    process_image_cleanup_root(process_image_root_space(root));
                    return;
                }
                ProcessImageRecordReady::Ready(ready) => { ready }
            };
            if (process_image_record_read(root_index).stack_growth_active ||
                process_image_record_read(root_index).active_page_count > count) {
                process_image_set_stack_growth_active(root_index, evidence, false);
                process_image_set_active_page_count(root_index, evidence, 0);
                process_image_set_stack_lowest_l3(root_index, evidence,
        process_stack_top_page());
            }
            process_image_cleanup_root(process_image_root_space(root));
        }
    }
}

fn process_image_unmap(pages: sink ProcessImagePages[image]) {
    let count: usize = pages.count;
    let mut target: AddressSpaceRoot = pages.root;
    process_image_pages_discard(pages);
    process_image_unmap_pages(target, count);
}

private fn process_image_map_segments(slot: borrow ProcessImageSlot[0],
                              target: AddressSpaceRoot,
                              plan: DistroElfLoadPlan,
                              load_bias: usize,
                              already_mapped: usize)
        -> ProcessImageSegmentsResult {
    if (plan.extent > USER_SPACE_BYTES ||
        load_bias > USER_SPACE_BYTES - plan.extent) {
        process_image_cleanup_root(target);
        return ProcessImageSegmentsResult::OutOfMemory;
    }
    let mut mapped: usize = already_mapped;
    // GitHub issue #1081: the mapper takes its segments from
    // distro_elf_plan_segment, which judges each program header with the
    // validator's own distro_elf_load_accept, so it has no ELF acceptance
    // rule of its own to disagree with. Refused there means the metadata
    // window changed after validation. What else it can refuse is the
    // address space (an occupied page: the validator proved a plan's spans
    // disjoint and process_image_pair_probe proves the two plans' biased
    // spans disjoint, so only a non-fresh target reaches it) and its
    // sources (page allocation, the image read).
    for segment_index: usize in 0..<16 {
        match distro_elf_plan_segment(plan, segment_index) {
          DistroElfPlanSegment::Refused => {
            process_image_cleanup_root(target);
            return ProcessImageSegmentsResult::Invalid;
          }
          DistroElfPlanSegment::NotLoad => {}
          DistroElfPlanSegment::Load(header) => {
            let (span_first, span_last) = distro_elf_segment_pages(header);
            let first_page: usize = span_first + load_bias / PAGE_SIZE;
            let last_page: usize = span_last + load_bias / PAGE_SIZE;
            if (load_bias % PAGE_SIZE != 0 ||
                last_page > USER_SPACE_PAGE_COUNT) {
                process_image_cleanup_root(target);
                return ProcessImageSegmentsResult::OutOfMemory;
            }
            for l3_index: usize in first_page..<last_page {
                if (process_image_pte_read(target, l3_index) != 0) {
                    process_image_cleanup_root(target);
                    return ProcessImageSegmentsResult::Invalid;
                }
                match page_alloc(PageOwnerTag::UserPage) {
                    PageAllocResult::OutOfMemory => {
                        process_image_cleanup_root(target);
                        return ProcessImageSegmentsResult::OutOfMemory;
                    }
                    PageAllocResult::Allocated(page) => {
                        match process_image_load_page(
                                slot, page, plan, header, load_bias, l3_index) {
                            ProcessImagePageLoadResult::Invalid => {
                                page_free(page);
                                process_image_cleanup_root(target);
                                return ProcessImageSegmentsResult::Invalid;
                            }
                            ProcessImagePageLoadResult::Loaded => {
                                let mut flags: usize = USER_RW_XN_FLAGS;
                                match header.access {
                                    DistroElfAccess::ReadExecute => {
                                        flags = USER_TEXT_RX_FLAGS;
                                        user_code_sync(
                                            page_physical_address(page),
                                            PAGE_SIZE);
                                    }
                                    DistroElfAccess::Read => {
                                        flags = USER_RODATA_R_FLAGS;
                                    }
                                    DistroElfAccess::ReadWrite => {}
                                }
                                if (process_image_install_page(target,
                                        page, l3_index, flags) == false) {
                                    process_image_cleanup_root(target);
                                    return ProcessImageSegmentsResult::OutOfMemory;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                }
            }
            }
        }
    }
    return ProcessImageSegmentsResult::Mapped(mapped);
}

private fn process_image_pair_probe(slot: borrow ProcessImageSlot[0],
                            target: AddressSpaceRoot,
                            primary: DistroElfLoadPlan,
                            interpreter: DistroElfLoadPlan,
                            interpreter_bias: usize,
                            argv: borrow []const u8,
                            argc: usize)
        -> ProcessImagePairProbeResult {
    // GitHub issue #258 step 2: this path's own layout, seeded before any
    // consumer reads it. Its stack floor is higher than the static path's
    // (this image's heap reaches further up) -- that difference used to be
    // two separate global constants, and is now just two seeds.
    // GitHub issue #516: no target root is a refusal, not root 0. Seeding a
    // layout into root 0 here would write the kernel root's image record
    // (PID 1's, before #831).
    let root: usize = match process_image_root_checked(target) {
        ProcessImageTargetRootResult::Missing => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageTargetRootResult::Ready(checked) => {
            process_image_root_index(checked)
        }
    };
    // GitHub issue #591: the caller chooses the bias per primary now, so the
    // two images not overlapping is checked here rather than assumed.
    if (interpreter_bias < primary.extent) {
        return ProcessImagePairProbeResult::Invalid;
    }
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { return ProcessImagePairProbeResult::Invalid; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    process_image_set_stack_top_page(root, evidence, process_stack_top_page());
    process_image_set_stack_low_page(root, evidence, PROCESS_STACK_LOW);
    process_image_set_heap_page_count(root, evidence, PROCESS_HEAP_PAGES_DEFAULT);
    match process_image_map_segments(slot, target, primary, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::Mapped(primary_count) => {
            match process_image_staging[slot.index].pair_source {
                ProcessImageSourceState::Absent => {}
                ProcessImageSourceState::Ext2(source) => {
                    process_image_set_source(
                        slot, source.mount, source.inode, source.length);
                }
            }
            match process_image_map_segments(
                    slot, target, interpreter, interpreter_bias, primary_count) {
                ProcessImageSegmentsResult::Invalid => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::OutOfMemory => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::Mapped(total) => {
                    let combined_extent: usize =
                        interpreter_bias + interpreter.extent;
                    let heap_first_page: usize =
                        (combined_extent + PAGE_SIZE - 1) / PAGE_SIZE;
                    let heap_last_page: usize =
                        heap_first_page +
                        process_image_record_read(root).heap_page_count;
                    // GitHub issue #1151: as the static path's region.
                    mmap_region_clear(root, evidence);
                    // The exact page counts that used to be asserted here
                    // were busybox-extras + musl's; any musl binary maps
                    // through this path since #591, so the layout is what
                    // is checked, and the boot's httpd_loader view keeps
                    // the measured numbers for that pair.
                    if (heap_last_page > MMAP_REGION_FIRST_PAGE ||
                        process_image_record_read(root).stack_low_page >=
                            process_stack_top_page() -
                            PROCESS_DYNAMIC_STACK_INITIAL_PAGES) {
                        process_image_cleanup_root(target);
                        return ProcessImagePairProbeResult::Invalid;
                    }
                    let mut mapped: usize = total;
                    for l3_index: usize in heap_first_page..<heap_last_page {
                        if (process_image_pte_read(target, l3_index) != 0) {
                            process_image_cleanup_root(target);
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc(PageOwnerTag::UserPage) {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup_root(target);
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(heap_page) => {
                                let bytes = page_bytes(heap_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                if (process_image_install_page(target,
                                        heap_page, l3_index,
                                        USER_RW_XN_FLAGS) == false) {
                                    process_image_cleanup_root(target);
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                    // musl and BusyBox httpd use more than one page while
                    // parsing a request. Keep eight pages immediately below
                    // the top mapped; the much larger reservation below
                    // remains demand-faulted rather than eagerly consuming
                    // every page in the 1 GiB address-space slot.
                    for l3_index: usize in
                            process_stack_top_page() -
                            (PROCESS_DYNAMIC_STACK_INITIAL_PAGES - 1)..<
                            process_stack_top_page() {
                        if (process_image_pte_read(target, l3_index) != 0) {
                            process_image_cleanup_root(target);
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc(PageOwnerTag::UserPage) {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup_root(target);
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(stack_page) => {
                                let bytes = page_bytes(stack_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                if (process_image_install_page(target,
                                        stack_page, l3_index,
                                        USER_RW_XN_FLAGS) == false) {
                                    process_image_cleanup_root(target);
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                    match page_alloc(PageOwnerTag::UserPage) {
                        PageAllocResult::OutOfMemory => {
                            process_image_cleanup_root(target);
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        PageAllocResult::Allocated(stack) => {
                            match process_dynamic_prepare_stack(
                                    stack, primary, interpreter_bias,
                                    argv, argc) {
                                ProcessImageStackResult::Invalid => {
                                    page_free(stack);
                                    process_image_cleanup_root(target);
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                ProcessImageStackResult::Ready => {
                                        if (process_image_install_page(target,
                                                stack, process_stack_top_page(),
                                                USER_RW_XN_FLAGS) == false) {
                                            process_image_cleanup_root(target);
                                            return ProcessImagePairProbeResult::Invalid;
                                        }
                                        mapped = mapped + 1;
                                }
                            }
                        }
                    }
                    if (mapped == total +
                            process_image_record_read(root).heap_page_count +
                            PROCESS_DYNAMIC_STACK_INITIAL_PAGES) {
                        let image: usize @ 1 = 1;
                        let entry: usize = USER_TEXT_VA + interpreter_bias +
                                           interpreter.entry;
                        let stack_pointer: usize = USER_TEXT_VA +
                            process_stack_top_page() * PAGE_SIZE + PAGE_SIZE -
                            PROCESS_STACK_LAYOUT_BYTES;
                        let heap_start: usize =
                            USER_TEXT_VA + heap_first_page * PAGE_SIZE;
                        let heap_limit: usize =
                            USER_TEXT_VA + heap_last_page * PAGE_SIZE;
                        let mut pages: ProcessImagePages[1] = {
                            image, target, mapped, entry, stack_pointer,
                            heap_start, heap_limit
                        };
                        process_image_set_active_page_count(root, evidence, mapped);
                        process_image_set_stack_growth_active(root, evidence, true);
                        return ProcessImagePairProbeResult::Ready(pages);
                    }
                    process_image_cleanup_root(target);
                    return ProcessImagePairProbeResult::Invalid;
                }
            }
        }
    }
}

// Map a dynamic application/interpreter pair whose two backing files both
// reside on ext2. Metadata plans retain their separate header windows while
// PT_LOAD bytes switch from primary_inode to interpreter_inode between the
// two segment passes.
fn process_image_pair_map_ext2_in_root(
        primary: DistroElfLoadPlan,
        primary_mount: Ext2Mount,
        primary_inode: usize,
        primary_length: usize,
        interpreter: DistroElfLoadPlan,
        interpreter_mount: Ext2Mount,
        interpreter_inode: usize,
        interpreter_length: usize,
        interpreter_bias: usize,
        argv: borrow []const u8,
        argc: usize,
        target: AddressSpaceRoot) -> ProcessImagePairProbeResult {
    let root: usize = root_slot_word(address_space_root_slot(target));
    if (address_space_root_key_valid(root) == false ||
        address_space_is_live(target) == false) {
        return ProcessImagePairProbeResult::Invalid;
    }
    let slot: ProcessImageSlot[0] = process_image_slot_acquire();
    process_image_set_source(
        slot, primary_mount, primary_inode, primary_length);
    process_image_set_pair_source(
        slot, interpreter_mount, interpreter_inode, interpreter_length);
    let result = process_image_pair_probe(
        slot, target, primary, interpreter, interpreter_bias, argv, argc);
    process_image_slot_release(slot);
    return result;
}

private fn process_image_map_current(slot: borrow ProcessImageSlot[0],
                             target: AddressSpaceRoot,
                             plan: DistroElfLoadPlan,
                             argv: borrow []const u8,
                             argc: usize) -> ProcessImageMapResult {
    // GitHub issue #516: the same refusal, through this function's own
    // "cannot map" case.
    let root: usize = match process_image_root_checked(target) {
        ProcessImageTargetRootResult::Missing => {
            return ProcessImageMapResult::InvalidImage;
        }
        ProcessImageTargetRootResult::Ready(checked) => {
            process_image_root_index(checked)
        }
    };
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { return ProcessImageMapResult::OutOfMemory; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    process_image_set_stack_growth_active(root, evidence, false);
    process_image_set_active_page_count(root, evidence, 0);
    process_image_set_stack_lowest_l3(root, evidence, process_stack_top_page());
    process_image_set_stack_top_page(root, evidence, process_stack_top_page());
    process_image_set_stack_low_page(root, evidence, PROCESS_STACK_LOW);
    process_image_set_heap_page_count(root, evidence, PROCESS_HEAP_PAGES_DEFAULT);
    if (plan.extent > USER_SPACE_BYTES) {
        return ProcessImageMapResult::OutOfMemory;
    }
    let mut mapped: usize = 0;
    match process_image_map_segments(slot, target, plan, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImageMapResult::InvalidImage;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImageMapResult::OutOfMemory;
        }
        ProcessImageSegmentsResult::Mapped(count) => { mapped = count; }
    }
    let heap_first_page: usize = (plan.extent + PAGE_SIZE - 1) / PAGE_SIZE;
    let heap_last_page: usize =
        heap_first_page + process_image_record_read(root).heap_page_count;
    // GitHub issue #1151: a fresh image has no mmap; the old image's region
    // pages went with its root's mappings. The heap ends below the region
    // (process_layout_assumption for the largest image DISTRO_ELF_SPAN_MAX
    // admits; checked here as well, since a refusal costs one compare).
    mmap_region_clear(root, evidence);
    if (heap_last_page > MMAP_REGION_FIRST_PAGE ||
        process_image_record_read(root).stack_low_page >=
            process_stack_top_page()) {
        process_image_cleanup_root(target);
        return ProcessImageMapResult::OutOfMemory;
    }
    for l3_index: usize in heap_first_page..<heap_last_page {
        if (process_image_pte_read(target, l3_index) != 0) {
            process_image_cleanup_root(target);
            return ProcessImageMapResult::InvalidImage;
        }
        match page_alloc(PageOwnerTag::UserPage) {
            PageAllocResult::OutOfMemory => {
                process_image_cleanup_root(target);
                return ProcessImageMapResult::OutOfMemory;
            }
            PageAllocResult::Allocated(heap_page) => {
                let bytes = page_bytes(heap_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                if (process_image_install_page(target,
                        heap_page, l3_index, USER_RW_XN_FLAGS) == false) {
                    process_image_cleanup_root(target);
                    return ProcessImageMapResult::OutOfMemory;
                }
                mapped = mapped + 1;
            }
        }
    }
    if (process_image_pte_read(target, process_stack_top_page()) != 0) {
        process_image_cleanup_root(target);
        return ProcessImageMapResult::InvalidImage;
    }
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            process_image_cleanup_root(target);
            return ProcessImageMapResult::OutOfMemory;
        }
        PageAllocResult::Allocated(stack) => {
            match process_image_prepare_stack(stack, plan, argv, argc) {
                ProcessImageStackResult::Invalid => {
                    page_free(stack);
                    process_image_cleanup_root(target);
                    return ProcessImageMapResult::InvalidImage;
                }
                ProcessImageStackResult::Ready => {
                        if (process_image_install_page(target,
                                stack, process_stack_top_page(),
                                USER_RW_XN_FLAGS) == false) {
                            process_image_cleanup_root(target);
                            return ProcessImageMapResult::OutOfMemory;
                        }
                        mapped = mapped + 1;
                }
            }
        }
    }
    let image: usize @ 0 = 0;
    let entry: usize = USER_TEXT_VA + plan.entry;
    let stack_pointer: usize = USER_TEXT_VA +
                               process_stack_top_page() * PAGE_SIZE +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let heap_start: usize = USER_TEXT_VA + heap_first_page * PAGE_SIZE;
    let heap_limit: usize = USER_TEXT_VA + heap_last_page * PAGE_SIZE;
    let mut pages: ProcessImagePages[0] = {
        image, target, mapped, entry, stack_pointer, heap_start, heap_limit
    };
    process_image_set_active_page_count(root, evidence, mapped);
    process_image_set_stack_growth_active(root, evidence, true);
    return ProcessImageMapResult::Mapped(pages);
}

// Map a validated ELF whose bytes live in an ext2 regular file. `plan` must
// point at a metadata window containing the ELF header and program table;
// PT_LOAD contents are fetched through ext2_read_file_chunk() while pages
// are being built.
fn process_image_map_ext2(plan: DistroElfLoadPlan,
                          mount: Ext2Mount,
                          inode: usize,
                          file_length: usize,
                          argv: borrow []const u8,
                          argc: usize) -> ProcessImageMapResult {
    let mut target: AddressSpaceRoot = address_space_boot_root();
    let slot: ProcessImageSlot[0] = process_image_slot_acquire();
    process_image_set_source(slot, mount, inode, file_length);
    let result = process_image_map_current(slot, target, plan, argv, argc);
    process_image_slot_release(slot);
    return result;
}

fn process_image_map_ext2_in_root(plan: DistroElfLoadPlan,
                                  mount: Ext2Mount,
                                  inode: usize,
                                  file_length: usize,
                                  argv: borrow []const u8,
                                  argc: usize,
                                  target: AddressSpaceRoot) -> ProcessImageMapResult {
    let root: usize = root_slot_word(address_space_root_slot(target));
    if (address_space_root_key_valid(root) == false ||
        address_space_is_live(target) == false) {
        return ProcessImageMapResult::InvalidImage;
    }
    let slot: ProcessImageSlot[0] = process_image_slot_acquire();
    process_image_set_source(slot, mount, inode, file_length);
    let result = process_image_map_current(slot, target, plan, argv, argc);
    process_image_slot_release(slot);
    return result;
}

// GitHub issue #1079: how many pages an exec's map can allocate, so execve
// can reserve them (page_reserve) before the old image is torn down. Every
// page the static and pair mappers allocate is a page of one of these
// spans -- each PT_LOAD span, the heap, the eager stack -- plus at most one
// lazily allocated L3 table per 2 MiB branch a span touches (a branch two
// spans share is counted twice, which only over-reserves). The argv page
// is reserved by execve itself (#700), and the image record exists before
// the exec (clone_vm_begin or an earlier exec made it). Every PT_LOAD page
// is reserved: .bss is still allocated eagerly (#1084).
private fn process_image_span_bound(first: usize, last: usize) -> usize {
    if (last <= first || last > USER_SPACE_PAGE_COUNT) { return 0; }
    let tables: usize = (last - 1) / USER_L3_PAGE_COUNT -
                        first / USER_L3_PAGE_COUNT + 1;
    return (last - first) + tables;
}

private fn process_image_segments_bound(plan: DistroElfLoadPlan,
                                        load_bias: usize) -> usize {
    let mut total: usize = 0;
    if (load_bias % PAGE_SIZE != 0 || load_bias > USER_SPACE_BYTES) {
        return 0;
    }
    let bias_pages: usize = load_bias / PAGE_SIZE;
    for segment_index: usize in 0..<16 {
        match distro_elf_plan_segment(plan, segment_index) {
            DistroElfPlanSegment::Refused => {}
            DistroElfPlanSegment::NotLoad => {}
            DistroElfPlanSegment::Load(header) => {
                let (span_first, span_last) = distro_elf_segment_pages(header);
                if (span_last <= USER_SPACE_PAGE_COUNT &&
                    bias_pages <= USER_SPACE_PAGE_COUNT - span_last) {
                    total = total + process_image_span_bound(
                        span_first + bias_pages, span_last + bias_pages);
                }
            }
        }
    }
    return total;
}

private fn process_image_heap_bound(extent: usize) -> usize {
    if (extent > USER_SPACE_BYTES) { return 0; }
    let heap_first_page: usize = (extent + PAGE_SIZE - 1) / PAGE_SIZE;
    return process_image_span_bound(heap_first_page,
        heap_first_page + PROCESS_HEAP_PAGES_DEFAULT);
}

fn process_image_exec_bound_static(plan: DistroElfLoadPlan) -> usize {
    return process_image_segments_bound(plan, 0) +
           process_image_heap_bound(plan.extent) +
           process_image_span_bound(process_stack_top_page(),
                                    process_stack_top_page() + 1);
}

fn process_image_exec_bound_pair(primary: DistroElfLoadPlan,
                                 interpreter: DistroElfLoadPlan,
                                 interpreter_bias: usize) -> usize {
    if (interpreter_bias > USER_SPACE_BYTES ||
        interpreter.extent > USER_SPACE_BYTES - interpreter_bias) {
        return 0;
    }
    return process_image_segments_bound(primary, 0) +
           process_image_segments_bound(interpreter, interpreter_bias) +
           process_image_heap_bound(interpreter_bias + interpreter.extent) +
           process_image_span_bound(
               process_stack_top_page() -
                   (PROCESS_DYNAMIC_STACK_INITIAL_PAGES - 1),
               process_stack_top_page() + 1);
}

fn process_image_page_count(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.count;
}

fn process_image_entry(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.entry;
}

fn process_image_stack_pointer(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.stack_pointer;
}

// GitHub issue #516: takes the root rather than deriving one. Its only
// caller already holds a proven target from its own
// ProcessImageTargetRootResult, so deriving a second answer here could only
// ever agree with it or silently disagree.
// A root's resident page count, for a diagnostic that already read the handle (procfs under the
// run guard, the monitor with every other CPU stopped). It does not allocate
// a missing record: a report answers 0 rather than changing what it reports.
fn process_image_active_page_count_words(words: ProcessPoolHandleWords)
        -> usize !{unsafe} {
    return process_image_record_value(
        process_image_record_pin_words(&process_image_pool, words),
        false).active_page_count;
}

fn process_image_heap_range(pages: borrow ProcessImagePages[image])
        -> (usize, usize) {
    return (pages.heap_start, pages.heap_limit);
}

fn process_image_gap_is_unmapped(pages: borrow ProcessImagePages[image]) -> bool {
    let mut target: AddressSpaceRoot = pages.root;
    // Alpine BusyBox's first PT_LOAD ends at page 266 and its second starts at
    // page 285. Keeping this gap absent is part of the current fixture's VM
    // contract; it must not become zero-filled executable memory by accident.
    for i: usize in 266..<285 {
        if (process_image_pte_read(target, i) != 0) { return false; }
    }
    return true;
}

// GitHub issue #479. Twenty globals, and they fall into three kinds.
//
// ONE WAS THE WRONG SHAPE and is gone. process_image_target_root named the
// root an image operation is aimed at, set by one call and read by another
// -- per-OPERATION state living in a global. #479 made it per-CPU; #981 made
// it a parameter of every reader, so no per-CPU or global copy remains.
//
// It had already produced a real fault with only one writer: issue #437's
// RPi5-only failure was this variable left at 0 on wait4's fast path,
// aiming the COW handler at PID 1's live image, and that took a hardware
// bisect to find.
//
// The ext2 exec staging is not per-core: it is a slot of the
// ProcessImageSlot pool above, so it would survive preemption as it is.
//
// The missing-record fallback and its count are per-core, so one core cannot
// overwrite another core's failure record.
//
// The stale-root fallback count is per-core too, summed for the boot
// diagnostic.
//
// The pool initializer is shared but not concurrent: secondary-core startup
// calls process_image_pool_init_before_secondary() before PSCI can make core 1
// visible. Every per-operation and diagnostic scalar above is per-core.
// Within one core those operation records still assume a kernel path runs to
// completion before another process can overwrite the same slot.
fn process_image_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "process_image's per-CPU fallback counters are a read-modify-write of this CPU's element; before KERNEL_PREEMPTIBLE is 1 they must be per_cpu stores or atomic (GitHub issue #638)");
}

// Samples allocator metadata while holding only this pool allocation guard.
fn process_image_pool_space_stats() -> (usize, usize, usize, usize) !{unsafe} {
    let guard = process_image_pool_lock(&process_image_pool);
    let sample = region_pool_space_stats(guard);
    process_image_pool_unlock(guard);
    return sample;
}

// GitHub issue #1151: the mmap region's bitmap, one bit per region page
// (bit k of word k / 64 is page MMAP_REGION_FIRST_PAGE + k), set while an
// mmap holds the page. A held page with no PTE has not been touched yet and
// reads as zero; the fault, or a syscall's user range, maps it then
// (mmap_region_fault_in). munmap clears the bit and the PTE.
//
// Current limitations (2026-10-28). Keep this list current as call sites
// change.
// - ONE WRITER PER ROOT, NOT A LOCK. A root's bitmap is changed only by the
//   process running on it (mmap, munmap, its own faults), by fork into a
//   not-yet-runnable child (mmap_region_clone), and by exec and reap of
//   that process. There are no CLONE_VM threads, so no two cores ever work
//   on one root's bitmap; a thread that shared a root would need a lock
//   here first.
// - PROT IS NOT RECORDED. A held, untouched page faults in read-write, as
//   every mapping here did before (mmap ignores PROT_NONE and PROT_READ,
//   and mprotect only downgrades a present page; it populates the range
//   first).
// - A SHARED MAPPING IS POPULATED AT MMAP. Its pages must exist before a
//   fork so that both roots map the same physical page; a page first
//   touched after the fork would be private to each.
const MMAP_REGION_WORDS: usize = 64;
struct MmapRegionBitmap {
    word: [usize; MMAP_REGION_WORDS];
}
private let mut mmap_region_pool: RegionPool(MmapRegionBitmap);
// Eight 512-byte bitmaps to a page.
const MMAP_REGION_CHUNK_PAGES: usize = 1;

private fn mmap_region_pool_lock(pool: *RegionPool(MmapRegionBitmap) @ bitmaps)
        -> RegionPoolGuard(MmapRegionBitmap)[bitmaps] !{unsafe, acquires_lock_39_mmap_region_pool, single_instance_lock, may_block,
          lock_guard_39_mmap_region_pool} {
    if (region_pool_lock_contended_hint(pool)) { pool_lock_wait_contended(PoolLockWaitPool::MmapRegion); }
    return region_pool_lock(pool);
}

private fn mmap_region_pool_unlock(
        guard: sink RegionPoolGuard(MmapRegionBitmap)[bitmaps]) {
    region_pool_unlock(guard);
}

// Gives every empty chunk back: a bitmap lives as long as one image that
// mmaps, and the boot's end-of-run accounting checks nothing is held.
private fn mmap_region_pool_return_empty(
        guard: borrow RegionPoolGuard(MmapRegionBitmap)[bitmaps]) !{unsafe} {
    let mut more: bool = true;
    while (more) {
        match region_pool_shrink(guard) {
            RegionShrink(MmapRegionBitmap)::Nothing => { more = false; }
            RegionShrink(MmapRegionBitmap)::Chunk(bytes) => {
                let address: usize = region_bytes_address(bytes);
                region_release(bytes);
                page_run_transferred_release_physical(
                    address, MMAP_REGION_CHUNK_PAGES);
            }
        }
    }
}

private fn mmap_region_slot_free(
        slot: sink RegionReleaseSlot(MmapRegionBitmap)[p, k]) !{unsafe} {
    let guard = mmap_region_pool_lock(&mmap_region_pool);
    match region_slot_adopt(guard, slot) {
        RegionReleaseAdopt(MmapRegionBitmap)::Foreign(stray) => {
            process_image_record_missing_note();
            region_slot_abandon(stray);
        }
        RegionReleaseAdopt(MmapRegionBitmap)::Adopted(mine) => {
            region_free(guard, mine);
            mmap_region_pool_return_empty(guard);
        }
    }
    mmap_region_pool_unlock(guard);
}

private fn mmap_region_unpin(pin: sink RegionPin(MmapRegionBitmap)[p, k]) !{unsafe} {
    match region_unpin(pin) {
        RegionUnpin(MmapRegionBitmap)::Unpinned => {}
        RegionUnpin(MmapRegionBitmap)::Last(slot) => { mmap_region_slot_free(slot); }
    }
}

private fn mmap_region_pin_words(pool: *RegionPool(MmapRegionBitmap) @ bitmaps,
                                 words: ProcessPoolHandleWords)
        -> RegionPinned(MmapRegionBitmap)[bitmaps] !{unsafe} {
    let guard = mmap_region_pool_lock(pool);
    let mut handle: RegionHandle(MmapRegionBitmap) =
        region_handle_from(guard, words.address, words.generation);
    let pinned = region_pin(guard, handle);
    mmap_region_pool_unlock(guard);
    return pinned;
}

private fn mmap_region_pool_grow(
        guard: borrow RegionPoolGuard(MmapRegionBitmap)[bitmaps]) -> bool !{unsafe} {
    match page_alloc_contiguous(MMAP_REGION_CHUNK_PAGES, PageOwnerTag::PoolChunk) {
        PageRunAllocResult::OutOfMemory => { return false; }
        PageRunAllocResult::Allocated(run_owner) => {
            let base: usize = page_run_physical_address(run_owner);
            let RegionBytes::Assumed(chunk) =
                page_run_into_region(run_owner) else {};
            match region_pool_grow(guard, chunk) {
                RegionGrow(MmapRegionBitmap)::Grown => { return true; }
                RegionGrow(MmapRegionBitmap)::TooSmall(back) => {
                    region_release(back);
                    page_run_transferred_release_physical(
                        base, MMAP_REGION_CHUNK_PAGES);
                    return false;
                }
            }
        }
    }
}

// A fresh, all-clear bitmap's (address, generation), or (0, 0) when the page
// allocator has nothing for a chunk.
private fn mmap_region_alloc() -> ProcessPoolHandleWords !{unsafe} {
    let mut words: ProcessPoolHandleWords = { 0, 0 };
    let guard = mmap_region_pool_lock(&mmap_region_pool);
    let mut grown: bool = true;
    match region_alloc(guard) {
        RegionPoolAlloc(MmapRegionBitmap)::Allocated(fresh) => {
            region_slot_zero(fresh);
            let mut handle: RegionHandle(MmapRegionBitmap) = region_give(guard, fresh);
            words.address = region_handle_address(handle);
            words.generation = region_handle_generation(handle);
            mmap_region_pool_unlock(guard);
            return words;
        }
        RegionPoolAlloc(MmapRegionBitmap)::Exhausted => { grown = false; }
        RegionPoolAlloc(MmapRegionBitmap)::Full => {}
    }
    if (grown && mmap_region_pool_grow(guard)) {
        match region_alloc(guard) {
            RegionPoolAlloc(MmapRegionBitmap)::Allocated(fresh) => {
                region_slot_zero(fresh);
                let mut handle: RegionHandle(MmapRegionBitmap) = region_give(guard, fresh);
                words.address = region_handle_address(handle);
                words.generation = region_handle_generation(handle);
            }
            RegionPoolAlloc(MmapRegionBitmap)::Exhausted => {}
            RegionPoolAlloc(MmapRegionBitmap)::Full => {}
        }
    }
    mmap_region_pool_unlock(guard);
    return words;
}

// Retires the bitmap `words` names; the last pin frees it.
private fn mmap_region_free_words(words: ProcessPoolHandleWords) !{unsafe} {
    if (words.address == 0) { return; }
    match mmap_region_pin_words(&mmap_region_pool, words) {
        RegionPinned(MmapRegionBitmap)::Stale => { process_image_record_missing_note(); }
        RegionPinned(MmapRegionBitmap)::Pinned(pin) => {
            match region_retire(pin) {
                RegionRetire(MmapRegionBitmap)::Pending => {}
                RegionRetire(MmapRegionBitmap)::Retired(slot) => {
                    mmap_region_slot_free(slot);
                }
            }
        }
    }
}

fn process_image_set_mmap_bitmap(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity],
        value: ProcessPoolHandleWords) !{unsafe} {
    let RegionPinned(ProcessImageRecord)::Pinned(pin) =
            process_image_record_pin(&process_image_pool, root) else {
        RegionPinned(ProcessImageRecord)::Stale => {
            process_image_record_missing_note();
            return;
        }
    };
    let record: &mut ProcessImageRecord = region_pin_record(pin);
    record.mmap_bitmap = value.address;
    record.mmap_bitmap_generation = value.generation;
    process_image_record_unpin(pin);
}

private fn mmap_region_words_of(root: usize) -> ProcessPoolHandleWords !{unsafe} {
    let mut value: ProcessImageRecord = process_image_record_read(root);
    let mut words: ProcessPoolHandleWords = {
        value.mmap_bitmap, value.mmap_bitmap_generation
    };
    return words;
}

inline fn mmap_region_contains(page: usize) -> bool {
    return page >= MMAP_REGION_FIRST_PAGE &&
           page < MMAP_REGION_FIRST_PAGE + MMAP_REGION_PAGES;
}

private fn mmap_bitmap_held(bitmap: borrow &mut MmapRegionBitmap, offset: usize) -> bool {
    let at: usize = offset / 64;
    if (at < MMAP_REGION_WORDS) {
        return ((bitmap.word[at] >> (offset % 64)) & 1) == 1;
    }
    return false;
}

private fn mmap_bitmap_set(bitmap: borrow &mut MmapRegionBitmap, offset: usize,
                           held: bool) {
    let at: usize = offset / 64;
    if (at < MMAP_REGION_WORDS) {
        let bit: usize = 1 << (offset % 64);
        if (held) { bitmap.word[at] = bitmap.word[at] | bit; }
        else { bitmap.word[at] = bitmap.word[at] & ~bit; }
    }
}

// The root's bitmap, allocated by the first mmap that needs one.
private fn mmap_region_words_ensured(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity])
        -> ProcessPoolHandleWords !{unsafe} {
    let mut words: ProcessPoolHandleWords = mmap_region_words_of(root);
    if (words.address != 0) { return words; }
    let mut fresh: ProcessPoolHandleWords = mmap_region_alloc();
    if (fresh.address != 0) { process_image_set_mmap_bitmap(root, evidence, fresh); }
    return fresh;
}

must_use variant MmapRegionTake {
    Full;
    // The first page of the run, an index into the user window.
    Taken(usize);
}

// Takes `pages` contiguous free region pages, as high as they fit (Linux
// maps top-down too). The pages hold no PTE: munmap and exec cleared them.
fn mmap_region_take(root: usize @ identity, pages: usize) -> MmapRegionTake !{unsafe} {
    if (pages == 0 || pages > MMAP_REGION_PAGES) { return MmapRegionTake::Full; }
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { return MmapRegionTake::Full; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    let mut words: ProcessPoolHandleWords = mmap_region_words_ensured(root, evidence);
    if (words.address == 0) { return MmapRegionTake::Full; }
    let RegionPinned(MmapRegionBitmap)::Pinned(pin) =
            mmap_region_pin_words(&mmap_region_pool, words) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return MmapRegionTake::Full; }
    };
    let bitmap: &mut MmapRegionBitmap = region_pin_record(pin);
    // `run` free pages end at `offset + run`, counting down from the top.
    let mut run: usize = 0;
    let mut offset: usize = MMAP_REGION_PAGES;
    while (offset > 0) {
        offset = offset - 1;
        if (mmap_bitmap_held(bitmap, offset)) {
            run = 0;
        } else {
            run = run + 1;
            if (run == pages) {
                for k: usize in 0..<MMAP_REGION_PAGES {
                    if (k >= offset && k < offset + pages) {
                        mmap_bitmap_set(bitmap, k, true);
                    }
                }
                mmap_region_unpin(pin);
                return MmapRegionTake::Taken(MMAP_REGION_FIRST_PAGE + offset);
            }
        }
    }
    mmap_region_unpin(pin);
    return MmapRegionTake::Full;
}

// MAP_FIXED inside the region: the pages [first, first + pages) become
// held, whatever held them before (the caller cleared their PTEs, as
// Linux's MAP_FIXED unmaps what it replaces). False when the range leaves
// the region or no bitmap can be had.
fn mmap_region_take_fixed(root: usize @ identity, first: usize, pages: usize) -> bool !{unsafe} {
    if (pages == 0 || mmap_region_contains(first) == false ||
        pages > MMAP_REGION_FIRST_PAGE + MMAP_REGION_PAGES - first) {
        return false;
    }
    let evidence = match process_image_record_ensure(root) {
        ProcessImageRecordReady::Missing => { return false; }
        ProcessImageRecordReady::Ready(ready) => { ready }
    };
    let mut words: ProcessPoolHandleWords = mmap_region_words_ensured(root, evidence);
    if (words.address == 0) { return false; }
    let RegionPinned(MmapRegionBitmap)::Pinned(pin) =
            mmap_region_pin_words(&mmap_region_pool, words) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return false; }
    };
    let bitmap: &mut MmapRegionBitmap = region_pin_record(pin);
    let offset: usize = first - MMAP_REGION_FIRST_PAGE;
    for k: usize in 0..<MMAP_REGION_PAGES {
        if (k >= offset && k < offset + pages) { mmap_bitmap_set(bitmap, k, true); }
    }
    mmap_region_unpin(pin);
    return true;
}

// Whether an mmap holds region page `page` of this root.
fn mmap_region_holds(root: usize, page: usize) -> bool !{unsafe} {
    if (mmap_region_contains(page) == false) { return false; }
    let mut words: ProcessPoolHandleWords = mmap_region_words_of(root);
    if (words.address == 0) { return false; }
    let RegionPinned(MmapRegionBitmap)::Pinned(pin) =
            mmap_region_pin_words(&mmap_region_pool, words) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return false; }
    };
    let bitmap: &mut MmapRegionBitmap = region_pin_record(pin);
    let held: bool = mmap_bitmap_held(bitmap, page - MMAP_REGION_FIRST_PAGE);
    mmap_region_unpin(pin);
    return held;
}

// munmap of region pages [first, last]: each held page's PTE goes (its
// reference to the physical page with it, so a shared page is freed by its
// last holder), then its bit. A page outside the region is not this
// function's.
fn mmap_region_unmap(target: AddressSpaceRoot, first: usize, last: usize) !{unsafe} {
    let root: usize = root_slot_word(address_space_root_slot(target));
    let mut words: ProcessPoolHandleWords = mmap_region_words_of(root);
    if (words.address == 0) { return; }
    let RegionPinned(MmapRegionBitmap)::Pinned(pin) =
            mmap_region_pin_words(&mmap_region_pool, words) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return; }
    };
    let bitmap: &mut MmapRegionBitmap = region_pin_record(pin);
    for k: usize in 0..<MMAP_REGION_PAGES {
        let page: usize = MMAP_REGION_FIRST_PAGE + k;
        if (page >= first && page <= last && mmap_bitmap_held(bitmap, k)) {
            address_space_pte_clear(target, page);
            mmap_bitmap_set(bitmap, k, false);
        }
    }
    mmap_region_unpin(pin);
}

// The root's whole region given up: exec (the old image's PTEs went with
// its mappings) and the record's release.
fn mmap_region_clear(root: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity]) !{unsafe} {
    let mut words: ProcessPoolHandleWords = mmap_region_words_of(root);
    if (words.address == 0) { return; }
    let mut absent: ProcessPoolHandleWords = { 0, 0 };
    process_image_set_mmap_bitmap(root, evidence, absent);
    mmap_region_free_words(words);
}

// fork: the child holds what the parent holds. Its PTEs are the clone's
// copies; an untouched page is untouched in both and faults in privately in
// each, as a private mapping should. False when no bitmap can be had.
fn mmap_region_clone(source: usize, dest: usize @ identity,
        evidence: borrow ProcessImageRecordExists[identity]) -> bool !{unsafe} {
    mmap_region_clear(dest, evidence);
    let mut from: ProcessPoolHandleWords = mmap_region_words_of(source);
    if (from.address == 0) { return true; }
    let mut to: ProcessPoolHandleWords = mmap_region_alloc();
    if (to.address == 0) { return false; }
    process_image_set_mmap_bitmap(dest, evidence, to);
    let RegionPinned(MmapRegionBitmap)::Pinned(from_pin) =
            mmap_region_pin_words(&mmap_region_pool, from) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return false; }
    };
    let RegionPinned(MmapRegionBitmap)::Pinned(to_pin) =
            mmap_region_pin_words(&mmap_region_pool, to) else {
        RegionPinned(MmapRegionBitmap)::Stale => {
            mmap_region_unpin(from_pin);
            return false;
        }
    };
    let source_bitmap: &mut MmapRegionBitmap = region_pin_record(from_pin);
    let dest_bitmap: &mut MmapRegionBitmap = region_pin_record(to_pin);
    for w: usize in 0..<MMAP_REGION_WORDS {
        dest_bitmap.word[w] = source_bitmap.word[w];
    }
    mmap_region_unpin(to_pin);
    mmap_region_unpin(from_pin);
    return true;
}

// Maps a zeroed page read-write at region page `page`, which an mmap holds
// and which has no PTE. False otherwise, or when there is no page.
private fn mmap_region_page_in(target: AddressSpaceRoot,
        bitmap: borrow &mut MmapRegionBitmap, page: usize) -> bool {
    if (mmap_region_contains(page) == false ||
        mmap_bitmap_held(bitmap, page - MMAP_REGION_FIRST_PAGE) == false ||
        process_image_pte_read(target, page) != 0) {
        return false;
    }
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(fresh) => {
            let bytes = page_bytes(fresh);
            for i: usize in 0..<4096 { bytes[i] = 0; }
            return process_image_install_page(target, fresh, page, USER_RW_XN_FLAGS);
        }
    }
}

// The EL0 translation fault of region page `page`. False (a SIGSEGV for
// the caller to deliver) when no mmap holds the page.
fn mmap_region_fault_in(target: AddressSpaceRoot, page: usize) -> bool !{unsafe} {
    let root: usize = root_slot_word(address_space_root_slot(target));
    let mut words: ProcessPoolHandleWords = mmap_region_words_of(root);
    if (words.address == 0) { return false; }
    let RegionPinned(MmapRegionBitmap)::Pinned(pin) =
            mmap_region_pin_words(&mmap_region_pool, words) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return false; }
    };
    let bitmap: &mut MmapRegionBitmap = region_pin_record(pin);
    let mapped: bool = mmap_region_page_in(target, bitmap, page);
    mmap_region_unpin(pin);
    return mapped;
}

// Maps every held, untouched region page of the user range [address,
// address + length), as the EL0 faults would have: a syscall's user range
// check, mprotect, a shared mmap and MADV_POPULATE_* call it before they
// read the PTEs. False when a page could not be had; a range that misses
// the region costs two compares.
fn mmap_region_populate(target: AddressSpaceRoot, address: usize,
                        length: usize) -> bool !{unsafe} {
    if (length == 0 || address < USER_TEXT_VA) { return true; }
    let (span_ok, first, last) = user_range_l3_span(address, length);
    if (span_ok == false || last < MMAP_REGION_FIRST_PAGE ||
        first >= MMAP_REGION_FIRST_PAGE + MMAP_REGION_PAGES) {
        return true;
    }
    let root: usize = root_slot_word(address_space_root_slot(target));
    let mut words: ProcessPoolHandleWords = mmap_region_words_of(root);
    if (words.address == 0) { return true; }
    let RegionPinned(MmapRegionBitmap)::Pinned(pin) =
            mmap_region_pin_words(&mmap_region_pool, words) else {
        RegionPinned(MmapRegionBitmap)::Stale => { return false; }
    };
    let bitmap: &mut MmapRegionBitmap = region_pin_record(pin);
    let mut complete: bool = true;
    for k: usize in 0..<MMAP_REGION_PAGES {
        let page: usize = MMAP_REGION_FIRST_PAGE + k;
        if (complete && page >= first && page <= last &&
            mmap_bitmap_held(bitmap, k) &&
            process_image_pte_read(target, page) == 0) {
            complete = mmap_region_page_in(target, bitmap, page);
        }
    }
    mmap_region_unpin(pin);
    return complete;
}

fn mmap_region_pool_space_stats() -> (usize, usize, usize, usize) !{unsafe} {
    let guard = mmap_region_pool_lock(&mmap_region_pool);
    let sample = region_pool_space_stats(guard);
    mmap_region_pool_unlock(guard);
    return sample;
}

// GitHub issue #1151: the boot suite's end-of-run page accounting. The
// region pages `target` has mapped with the L3 tables that map them, and the
// pages the bitmap pool holds.
fn mmap_region_resident_pages(target: AddressSpaceRoot) -> usize {
    let mut count: usize = 0;
    for branch: usize in 0..<USER_L2_BRANCH_COUNT {
        if (branch >= MMAP_REGION_FIRST_PAGE / USER_L3_PAGE_COUNT &&
            branch < (MMAP_REGION_FIRST_PAGE + MMAP_REGION_PAGES) / USER_L3_PAGE_COUNT &&
            address_space_l3_branch_physical(target, branch) != 0) {
            count = count + 1;
        }
    }
    for k: usize in 0..<MMAP_REGION_PAGES {
        if (process_image_pte_read(target, MMAP_REGION_FIRST_PAGE + k) != 0) {
            count = count + 1;
        }
    }
    return count;
}

fn mmap_region_pool_pages() -> usize !{unsafe} {
    let (chunks, capacity, live, bytes) = mmap_region_pool_space_stats();
    return bytes / PAGE_SIZE;
}
