use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/fs/elf64.tkb";

// GitHub issue #246: must match kernel/kernel/process.tkb's
// KERNEL_PROCESS_MAX -- root index == that file's ProcessHandle.pool_index
// throughout this file, so every scheduled process gets its own page-table
// root. Kept as an independent literal (not derived from the other file's
// constant) because top-level const initializers here cannot reference
// another file's identifier in an arithmetic expression -- same reason
// kernel/fs/ext2/ext2.tkb's EXT2_MAX_FILE_SIZE stayed a literal. A generous
// compile-time ceiling, not a razor-thin one (see process.tkb's own header
// comment on KERNEL_PROCESS_MAX). Every array below is bookkeeping
// (small counters/flags, not indices into page.tkb's shared pool -- see
// GitHub issue #253's 2026-08-09 comment for why per-root page ownership
// moved off a dedicated array), not a dedicated physical resource of its
// own -- unlike process.tkb's kernel stacks or address_space.tkb's actual
// page-table backing, so this stays a plain eagerly-sized array rather than
// a growable_pool.tkb shadow pool; the real per-root physical cost lives in
// address_space.tkb.
const PROCESS_IMAGE_ROOT_MAX: usize = 16;

// User-page ownership is recorded only in the page tables. Address-space
// cleanup walks populated L2 branches and their L3 PTEs, so neither image
// mappings nor clone rollback needs an enormous per-page shadow array.
private let mut process_image_zero_page: [u8; PAGE_SIZE];
private let mut clone_page_count: usize;
private let mut clone_last_reaped_count: usize;
// GitHub issue #245: the clone in flight (if any) copies from whichever
// root was active when process_image_clone_vm_begin() was called into an
// explicitly chosen destination root -- both stashed here since
// process_image_clone_vm_reap() (and the rollback/growth-release helpers
// it calls) take no parameters of their own, matching process_clone_vm_
// store's own single-in-flight-clone design.
private let mut clone_source_root: usize;
private let mut clone_dest_root: usize;
// GitHub issues #258 and #264: one persistent record per address-space
// root, replacing the prior ProcessLayout table plus the separate flattened
// growth-page array. Its scalar fields are ProcessLayout's former fields,
// kept flat so their existing direct accesses stay simple; the growth-page
// list is now attached to the same root it describes.
//
// The layout is now per-process DATA, set once when an image is mapped
// and read everywhere else -- which is what lets two processes differ
// (the static-PIE and dynamic/musl paths already wanted different stack
// floors, 448 vs 504, and expressed that as two separate global
// constants each consulted from its own set of sites). GitHub issue #254
// needs exactly this: a process whose address space is bigger than one
// L3 table gets a different `stack_top_page`, with no constant to chase.
//
// Same "one managed thing, one struct" rule as kernel/mm/page.tkb's
// PageMeta (issue #253): a future per-address-space field belongs here,
// not in another root-indexed global.
struct ProcessImageRecord {
    // Live state.
    active_page_count: usize;
    stack_lowest_l3: usize;      // current downward extent of the stack
    stack_growth_active: bool;
    // Layout proper.
    stack_top_page: usize;       // highest page; the initial stack page
    stack_low_page: usize;       // lowest page the stack may ever occupy
    heap_page_count: usize;
}

private let mut process_image_record:
    [ProcessImageRecord; PROCESS_IMAGE_ROOT_MAX];
private let mut process_image_target_root: usize = 0;

fn process_image_root_index() -> {0..<PROCESS_IMAGE_ROOT_MAX as usize} {
    if (process_image_target_root < PROCESS_IMAGE_ROOT_MAX) {
        let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_target_root;
        return root;
    }
    return 0;
}

fn process_image_pte_read(index: usize) -> usize {
    return address_space_pte_read(process_image_target_root, index);
}

fn process_image_pte_write(index: usize, value: usize)
        -> AddressSpacePteWriteResult {
    return address_space_pte_write(process_image_target_root, index, value);
}

fn process_image_pte_clear(index: usize) {
    address_space_pte_clear(process_image_target_root, index);
}

fn process_image_pte_invalidate(index: usize) {
    address_space_tlb_invalidate(process_image_target_root,
                                 USER_TEXT_VA + index * PAGE_SIZE);
}

// Do not transfer PageOwner until the lazy-L3 allocation and PTE write have
// both succeeded. This is the mapping-side half of address_space.tkb's OOM
// contract; the failure arm returns the still-owned physical page directly.
fn process_image_install_page(page: sink PageOwner[page_id],
                              index: usize, flags: usize) -> bool {
    match address_space_map_page(
            process_image_target_root, index, page, flags) {
        AddressSpacePteWriteResult::Invalid => {
            return false;
        }
        AddressSpacePteWriteResult::OutOfMemory => {
            return false;
        }
        AddressSpacePteWriteResult::Written => {
            return true;
        }
    }
}

private linear view ProcessCloneVmOwner;
variant ProcessCloneVmValue {
    Empty;
    Ready(ProcessCloneVmOwner);
}
struct ProcessCloneVmStore {
    private mutex: i32;
    private value: ProcessCloneVmValue;
}
private let mut process_clone_vm_store: ProcessCloneVmStore;
private linear view ProcessCloneVmGuard[lock: addr];

must_use variant ProcessCloneVmResult { OutOfMemory; Copied; }
must_use variant ProcessCloneVmReapResult { Missing; Reaped; }

// GitHub issue #258 step 2: `process_stack_top_page() = 511` is gone -- the
// initial stack always sits on the address space's own last page, so it is
// derived rather than stored or restated. (A `const` cannot do this: a
// top-level const initializer may not do arithmetic on another file's
// identifier, and USER_SPACE_PAGE_COUNT lives in address_space.tkb.)
fn process_stack_top_page() -> usize {
    return USER_SPACE_PAGE_COUNT - 1;
}

// Seeds for ProcessImageRecord.stack_low_page -- the lowest page the stack may
// ever occupy, and the ONLY part of the layout that genuinely differs
// between the two loader paths. These are now defaults consulted once
// each, where an image is mapped, rather than global constants consulted
// as decision points from a dozen scattered sites; every reader goes
// through process_image_record[root].stack_low_page.
//
// Static path: 256 KiB is a bounded virtual reservation, not an eager
// allocation. It leaves the static BusyBox heap (ending at page 419)
// below the reservation. The unmapped page immediately below it is the
// guard page; #198 only maps pages in this interval after an EL0
// translation fault.
const PROCESS_STACK_LOW_STATIC: usize = 448;
// Dynamic/musl path: a smaller reservation, since that image's own heap
// reaches higher.
const PROCESS_STACK_LOW_DYNAMIC: usize = 504;
// BYTES, not pages: how much room at the very top of the initial stack
// page is reserved for the argv/envp/auxv block. Unrelated to the address
// space's own page count despite both having been 512 (see
// kernel/mm/address_space.tkb's USER_SPACE_PAGE_COUNT comment -- issue
// #253 briefly conflated the two by reusing this name as a table bound;
// issue #258 separated them again).
const PROCESS_STACK_LAYOUT_BYTES: usize = 512;
// Seed for ProcessImageRecord.heap_page_count (see PROCESS_STACK_LOW_*
// above): consulted only where an image is mapped, never as a
// decision point elsewhere.
const PROCESS_HEAP_PAGES_DEFAULT: usize = 128;
const USER_SPACE_BYTES: usize = 0x40000000;
const PROCESS_DYNAMIC_STACK_INITIAL_PAGES: usize = 8;
const AT_PHDR: usize = 3;
const AT_PHENT: usize = 4;
const AT_PHNUM: usize = 5;
const AT_PAGESZ: usize = 6;
const AT_BASE: usize = 7;
const AT_ENTRY: usize = 9;
const AT_SECURE: usize = 23;
const AT_RANDOM: usize = 25;
const AT_UID: usize = 11;
const AT_EUID: usize = 12;
const AT_GID: usize = 13;
const AT_EGID: usize = 14;
const AT_EXECFN: usize = 31;

fn process_clone_vm_lock(lock: *i32 @ address)
        -> ProcessCloneVmGuard[address] {
    return view ProcessCloneVmGuard[address];
}

fn process_clone_vm_unlock(guard: sink ProcessCloneVmGuard[address],
                           lock: *i32 @ address) {}

fn process_clone_vm_owner_drop(owner: sink ProcessCloneVmOwner) {}

fn process_clone_vm_install(owner: sink ProcessCloneVmOwner) -> bool {
    let guard = process_clone_vm_lock(&process_clone_vm_store.mutex);
    let previous: ProcessCloneVmValue = stable_replace(
        guard, &process_clone_vm_store.mutex,
        process_clone_vm_store.value, ProcessCloneVmValue::Ready(owner));
    match previous {
        ProcessCloneVmValue::Empty => {
            process_clone_vm_unlock(
                guard, &process_clone_vm_store.mutex);
            return true;
        }
        ProcessCloneVmValue::Ready(stale) => {
            let displaced: ProcessCloneVmValue = stable_replace(
                guard, &process_clone_vm_store.mutex,
                process_clone_vm_store.value,
                ProcessCloneVmValue::Ready(stale));
            process_clone_vm_unlock(
                guard, &process_clone_vm_store.mutex);
            match displaced {
                ProcessCloneVmValue::Empty => { return false; }
                ProcessCloneVmValue::Ready(incoming) => {
                    // This branch is unreachable in the single-child model;
                    // consume the incoming proof after rolling its pages back.
                    process_clone_vm_owner_drop(incoming);
                    return false;
                }
            }
        }
    }
}

fn process_clone_vm_take() -> ProcessCloneVmValue {
    let guard = process_clone_vm_lock(&process_clone_vm_store.mutex);
    let previous: ProcessCloneVmValue = stable_replace(
        guard, &process_clone_vm_store.mutex,
        process_clone_vm_store.value, ProcessCloneVmValue::Empty);
    process_clone_vm_unlock(guard, &process_clone_vm_store.mutex);
    return previous;
}

fn process_clone_vm_rollback() {
    let dest: usize = clone_dest_root;
    address_space_release_user_mappings(dest);
    if (dest < PROCESS_IMAGE_ROOT_MAX) {
        let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} =
            process_image_narrow_root(dest);
        process_image_record[root].active_page_count = 0;
        process_image_record[root].stack_growth_active = false;
        process_image_record[root].stack_lowest_l3 = process_stack_top_page();
    }
    clone_page_count = 0;
}

// GitHub issue #245: dest_root is the caller's choice, not a fixed "root
// 1" -- process.tkb's kernel_process_clone_begin() allocates the child's
// process-table slot first and passes that slot's index straight through,
// so root index == ProcessHandle.pool_index holds everywhere. The source
// is always process_image_target_root (whichever root is currently
// active), not a fixed "root 0" -- a process running on any root can
// fork, not just the one on root 0.
fn process_image_narrow_root(value: usize) -> {0..<PROCESS_IMAGE_ROOT_MAX as usize} {
    if (value < PROCESS_IMAGE_ROOT_MAX) {
        let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = value;
        return root;
    }
    return 0;
}

fn process_image_clone_vm_begin(dest_root: usize) -> ProcessCloneVmResult !{unsafe} {
    if (dest_root >= PROCESS_IMAGE_ROOT_MAX ||
        dest_root == process_image_target_root ||
        address_space_is_live(dest_root) == false) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    let dest: {0..<PROCESS_IMAGE_ROOT_MAX as usize} =
        process_image_narrow_root(dest_root);
    let source: usize = process_image_target_root;
    clone_source_root = source;
    clone_dest_root = dest_root;
    clone_page_count = 0;
    address_space_clear_root(dest_root);
    // Reset the destination root's demand-stack metadata before rebuilding
    // it below, the same way process_image_map_current() resets its own
    // root's before mapping a fresh image -- otherwise a reaped child's
    // stale counts would leak into the next fork.
    process_image_record[dest].stack_growth_active = false;
    process_image_record[dest].active_page_count = 0;
    process_image_record[dest].stack_lowest_l3 = process_stack_top_page();
    // GitHub issue #258 step 2: a child inherits the parent's layout, not a
    // global constant -- which is the whole point of the layout being data.
    let clone_src: {0..<PROCESS_IMAGE_ROOT_MAX as usize} =
        process_image_narrow_root(source);
    process_image_record[dest].stack_top_page = process_stack_top_page();
    process_image_record[dest].stack_low_page =
        process_image_record[clone_src].stack_low_page;
    process_image_record[dest].heap_page_count =
        process_image_record[clone_src].heap_page_count;
    // Tracks the lowest growth-region L3 index actually copied below, so the
    // child's watermark reflects its real page table rather than being
    // inherited verbatim from the parent's own
    // process_image_record[source].stack_lowest_l3 bookkeeping, which only
    // describes the parent's own demand-grown pages, not the child's.
    let mut clone_stack_lowest_l3: usize = process_stack_top_page();
    for l3_index: usize in 0..<USER_SPACE_PAGE_COUNT {
        let parent_pte: usize = address_space_pte_read(source, l3_index);
        if (parent_pte != 0) {
            let parent_physical: usize = parent_pte & USER_PAGE_PHYS_MASK;
            if (page_mapping_retain_physical(parent_physical) == false) {
                process_clone_vm_rollback();
                return ProcessCloneVmResult::OutOfMemory;
            }
            let mut child_pte: usize = parent_pte;
            if (address_space_pte_is_writable(parent_pte)) {
                child_pte = address_space_pte_cow_value(parent_pte);
            }
            match address_space_pte_write(dest_root, l3_index, child_pte) {
                AddressSpacePteWriteResult::Invalid => {
                    page_mapping_release_physical(parent_physical);
                    process_clone_vm_rollback();
                    return ProcessCloneVmResult::OutOfMemory;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    page_mapping_release_physical(parent_physical);
                    process_clone_vm_rollback();
                    return ProcessCloneVmResult::OutOfMemory;
                }
                AddressSpacePteWriteResult::Written => {
                    address_space_tlb_invalidate(
                        dest_root, USER_TEXT_VA + l3_index * PAGE_SIZE);
                    if (address_space_pte_is_writable(parent_pte)) {
                        match address_space_pte_write(
                                source, l3_index,
                                address_space_pte_cow_value(parent_pte)) {
                            AddressSpacePteWriteResult::Invalid => {
                                process_clone_vm_rollback();
                                return ProcessCloneVmResult::OutOfMemory;
                            }
                            AddressSpacePteWriteResult::OutOfMemory => {
                                process_clone_vm_rollback();
                                return ProcessCloneVmResult::OutOfMemory;
                            }
                            AddressSpacePteWriteResult::Written => {
                                address_space_tlb_invalidate(
                                    source, USER_TEXT_VA + l3_index * PAGE_SIZE);
                            }
                        }
                    }
                    clone_page_count = clone_page_count + 1;
                    if (l3_index >=
                            process_image_record[clone_src].stack_low_page &&
                        l3_index < process_stack_top_page() &&
                        l3_index < clone_stack_lowest_l3) {
                        clone_stack_lowest_l3 = l3_index;
                    }
                }
            }
        }
    }
    if (clone_page_count == 0) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    // The copy loop above mirrors every present parent PTE (including any
    // stack pages the parent had already demand-faulted in) into the
    // destination root, so the child gets its own demand-stack watermark
    // derived from what was actually copied. Without this, a forked child
    // fail-stops the instant it grows its stack past whatever was already
    // mapped at fork time (issue #219).
    process_image_record[dest].active_page_count = clone_page_count;
    process_image_record[dest].stack_growth_active = true;
    process_image_record[dest].stack_lowest_l3 = clone_stack_lowest_l3;
    if (process_clone_vm_install(view ProcessCloneVmOwner) == false) {
        process_clone_vm_rollback();
        return ProcessCloneVmResult::OutOfMemory;
    }
    return ProcessCloneVmResult::Copied;
}

// GitHub issue #245: replaces the old activate_parent()/activate_child()
// pair, which hardcoded root 0 ("parent") and root 1 ("child") as global
// roles. Callers now track their own parent/child root relationships
// (process.tkb's per-slot ProcessHandle.pool_index) and pass the explicit
// root they mean, since with more than one live clone in the tree "the
// child" and "the parent" are relative to whoever is switching, not fixed
// numbers.
fn process_image_activate_root(root: usize) {
    if (root >= PROCESS_IMAGE_ROOT_MAX) { return; }
    process_image_target_root = root;
    address_space_activate_root(root);
}

fn process_image_clone_vm_reap() -> ProcessCloneVmReapResult {
    match process_clone_vm_take() {
        ProcessCloneVmValue::Empty => {
            return ProcessCloneVmReapResult::Missing;
        }
        ProcessCloneVmValue::Ready(owner) => {
            let count: usize = clone_page_count;
            let source: usize = clone_source_root;
            process_clone_vm_rollback();
            process_image_activate_root(source);
            process_clone_vm_owner_drop(owner);
            clone_last_reaped_count = count;
            return ProcessCloneVmReapResult::Reaped;
        }
    }
}

fn process_image_clone_vm_reaped_pages() -> usize {
    return clone_last_reaped_count;
}

// GitHub issue #219 verification: process_image_clone_vm_begin() must
// initialize root 1's demand-stack metadata so process_image_handle_data_
// abort() can grow the child's stack past whatever was mapped at fork
// time, instead of fail-stopping. Exercises the real clone_vm_begin/
// handle_data_abort/clone_vm_reap sequence directly against a synthetic
// single-page root-0 image (bypassing the ELF loader, which nothing here
// depends on), because neither real EL0 process that forks in this kernel
// can exercise it: the tiny fixed-layout initial bootstrap process has a
// whole address space smaller than one growth-region page (never meant to
// support stack growth at all), and the pinned Alpine BusyBox binary's
// recursion depth is not something this test controls.
fn process_image_clone_growth_probe() -> bool !{unsafe} {
    process_image_target_root = 0;
    if (address_space_is_live(1)) { return false; }
    if (address_space_ensure_root(1) == false) { return false; }
    match page_alloc() {
        PageAllocResult::OutOfMemory => {
            address_space_release_root(1);
            return false;
        }
        PageAllocResult::Allocated(stack_page) => {
            match address_space_map_page(
                    0, process_stack_top_page(), stack_page, USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    address_space_release_root(1);
                    return false;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    address_space_release_root(1);
                    return false;
                }
                AddressSpacePteWriteResult::Written => {
                }
            }
        }
    }
    // Mirrors exactly the metadata process_image_map_current() sets after
    // mapping a fresh image's single top stack page: growth enabled, one
    // page active, nothing yet grown below the top.
    process_image_record[0].stack_growth_active = true;
    process_image_record[0].active_page_count = 1;
    process_image_record[0].stack_lowest_l3 = process_stack_top_page();
    process_image_record[0].stack_top_page = process_stack_top_page();
    process_image_record[0].stack_low_page = PROCESS_STACK_LOW_STATIC;
    process_image_record[0].heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;

    let mut ok: bool = true;
    let mut cow_parent_physical: usize = 0;
    match process_image_clone_vm_begin(1) {
        ProcessCloneVmResult::OutOfMemory => { ok = false; }
        ProcessCloneVmResult::Copied => {}
    }

    if (ok) {
        process_image_activate_root(1);
        // fork must initially share the parent's top stack page, with both
        // PTEs marked COW. A simulated EL0 write-permission fault then gives
        // only root 1 a private writable page while root 0 retains the
        // original shared frame.
        let top_page: usize = process_stack_top_page();
        let parent_before: usize = address_space_pte_read(0, top_page);
        let child_before: usize = address_space_pte_read(1, top_page);
        if ((parent_before & USER_PAGE_PHYS_MASK) !=
                    (child_before & USER_PAGE_PHYS_MASK) ||
            address_space_pte_is_cow(parent_before) == false ||
            address_space_pte_is_cow(child_before) == false) {
            ok = false;
        }
        cow_parent_physical = parent_before & USER_PAGE_PHYS_MASK;
        // EC=0x24, WnR=1, DFSC=0x0f: EL0 write permission fault on the
        // child's present COW PTE.
        let cow_esr: usize = 0x9000004F;
        let cow_fault: usize = USER_TEXT_VA + top_page * PAGE_SIZE;
        if (ok && (process_image_handle_data_abort(cow_esr, cow_fault) == false ||
            address_space_pte_is_cow(address_space_pte_read(1, top_page)) ||
            address_space_pte_is_writable(address_space_pte_read(1, top_page)) == false ||
            (address_space_pte_read(0, top_page) & USER_PAGE_PHYS_MASK) ==
                (address_space_pte_read(1, top_page) & USER_PAGE_PHYS_MASK))) {
            ok = false;
        }
        // EC=0x24 (data abort from a lower EL), DFSC=0x07 (translation
        // fault, level 3) for a missing PTE in the already-populated top
        // L3 branch.
        let l3_esr: usize = 0x90000007;
        let first_page: usize = process_stack_top_page() - 11;
        let first_fault: usize = USER_TEXT_VA + first_page * PAGE_SIZE;
        if (process_image_handle_data_abort(l3_esr, first_fault) == false ||
            address_space_pte_read(1, first_page) == 0) {
            ok = false;
        }
        // Crossing into branch 510 finds no L3 descriptor at all, producing
        // DFSC=0x06 (translation fault, level 2). The handler must create
        // that L3 page and map the gap in one call.
        let l2_esr: usize = 0x90000006;
        let second_page: usize = process_stack_top_page() - 512;
        let second_fault: usize = USER_TEXT_VA + second_page * PAGE_SIZE;
        if (ok && (process_image_handle_data_abort(l2_esr, second_fault) == false ||
            address_space_pte_read(1, second_page) == 0 ||
            address_space_pte_read(1, second_page + 1) == 0 ||
            address_space_pte_read(1, first_page - 1) == 0)) {
            ok = false;
        }
        process_image_activate_root(0);
    }

    match process_image_clone_vm_reap() {
        ProcessCloneVmReapResult::Missing => {}
        ProcessCloneVmReapResult::Reaped => {}
    }
    // Once the child mapping is reaped, the parent owns its original COW
    // page alone. Resolving it must restore write permission in place rather
    // than allocate another page under memory pressure.
    let parent_after_reap: usize =
        address_space_pte_read(0, process_stack_top_page());
    if (ok && (page_mapping_refcount_physical(cow_parent_physical) != 1 ||
        address_space_pte_is_cow(parent_after_reap) == false ||
        address_space_resolve_cow(0, process_stack_top_page()) == false ||
        address_space_pte_is_writable(
            address_space_pte_read(0, process_stack_top_page())) == false ||
        (address_space_pte_read(0, process_stack_top_page()) &
            USER_PAGE_PHYS_MASK) != cow_parent_physical)) {
        ok = false;
    }
    address_space_pte_clear(0, process_stack_top_page());
    address_space_tlb_invalidate(
        0, USER_TEXT_VA + process_stack_top_page() * PAGE_SIZE);
    process_image_record[0].stack_growth_active = false;
    process_image_record[0].active_page_count = 0;
    process_image_record[0].stack_lowest_l3 = process_stack_top_page();
    address_space_release_root(1);
    return ok;
}

linear struct ProcessImagePages[image: usize] {
    private image: usize @ image;
    private count: usize;
    private entry: usize;
    private stack_pointer: usize;
    private heap_start: usize;
    private heap_limit: usize;
}

must_use variant ProcessImageMapResult {
    InvalidImage;
    OutOfMemory;
    Mapped(exists image: usize. ProcessImagePages[image]);
}

must_use variant ProcessImagePageLoadResult { Invalid; Loaded; }
must_use variant ProcessImageStackResult { Invalid; Ready; }
must_use variant ProcessImageSegmentsResult {
    Invalid;
    OutOfMemory;
    Mapped(usize);
}
must_use variant ProcessImagePairProbeResult {
    Invalid;
    Ready(exists image: usize. ProcessImagePages[image]);
}

private linear view ProcessImageExecGuard[lock: addr];
private linear view ProcessImageExecOwner;
variant ProcessImageExecValue {
    Empty;
    Ready(exists image: usize. ProcessImagePages[image]);
}
struct ProcessImageExecStore {
    private mutex: i32;
    private value: ProcessImageExecValue;
}
private let mut process_image_exec_store: ProcessImageExecStore;

fn process_image_exec_lock(lock: *i32 @ address)
        -> ProcessImageExecGuard[address] {
    return view ProcessImageExecGuard[address];
}

fn process_image_exec_unlock(guard: sink ProcessImageExecGuard[address],
                              lock: *i32 @ address) {}

fn process_image_exec_install(
        pages: sink ProcessImagePages[image]) -> bool {
    let guard = process_image_exec_lock(&process_image_exec_store.mutex);
    let previous: ProcessImageExecValue = stable_replace(
        guard, &process_image_exec_store.mutex,
        process_image_exec_store.value,
        ProcessImageExecValue::Ready(pages));
    match previous {
        ProcessImageExecValue::Empty => {
            process_image_exec_unlock(guard, &process_image_exec_store.mutex);
            return true;
        }
        ProcessImageExecValue::Ready(stale) => {
            let displaced: ProcessImageExecValue = stable_replace(
                guard, &process_image_exec_store.mutex,
                process_image_exec_store.value,
                ProcessImageExecValue::Ready(stale));
            process_image_exec_unlock(guard, &process_image_exec_store.mutex);
            match displaced {
                ProcessImageExecValue::Empty => {}
                ProcessImageExecValue::Ready(incoming) => {
                    process_image_unmap(incoming);
                }
            }
            return false;
        }
    }
}

fn process_image_exec_reap() {
    let guard = process_image_exec_lock(&process_image_exec_store.mutex);
    let previous: ProcessImageExecValue = stable_replace(
        guard, &process_image_exec_store.mutex,
        process_image_exec_store.value, ProcessImageExecValue::Empty);
    process_image_exec_unlock(guard, &process_image_exec_store.mutex);
    match previous {
        ProcessImageExecValue::Empty => {}
        ProcessImageExecValue::Ready(pages) => {
            process_image_unmap(pages);
            // process_image_unmap only retargets later page-table writes at
            // root 0; it leaves TTBR0 on the root it just emptied. The
            // parent is resumed straight after this reap, so activate its
            // root here exactly as process_image_clone_vm_reap does for
            // the plain fork/exit path -- otherwise the parent returns to
            // EL0 against the unmapped child root and faults on its own
            // first instruction. GitHub issue #245: this runs from
            // kernel_syscall_clone_parent_return(), reached only via
            // kernel_process_child_exit()'s own return value -- by
            // construction that has already switched execution_current_
            // handle back to the parent, so kernel_process_current_root()
            // is already correct here, not a fixed root 0.
            process_image_activate_root(kernel_process_current_root());
        }
    }
}

// A flat, NUL-terminated argv blob is deliberately used instead of an array
// of `[]u8` owners: it is plain immutable data, so one builder can consume
// literal argv values now and a script/path-derived argv later without an
// ownership transfer per element. `argc` names exactly how many strings the
// blob contains.
fn process_image_prepare_stack(page: borrow PageOwner[page],
                               plan: DistroElfLoadPlan,
                               argv: []u8,
                               argc: usize)
        -> ProcessImageStackResult !{unsafe} {
    if (argc == 0 || argc > 32) { return ProcessImageStackResult::Invalid; }
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let physical_base: usize = page_physical_address(page) +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let virtual_base: usize = USER_TEXT_VA +
                              process_stack_top_page() * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    // argc, argv[], argv terminator, envp terminator, then eight auxv
    // key/value pairs and AT_NULL. The random bytes immediately follow.
    let auxv_start: usize = argc + 3;
    let random_offset: usize = (auxv_start + 18) * 8;
    let mut string_offset: usize = random_offset + 16;
    if (string_offset > PROCESS_STACK_LAYOUT_BYTES) {
        return ProcessImageStackResult::Invalid;
    }
    let random_address: usize = virtual_base + random_offset;
    let words: *u64 = physical_base as *u64;
    words[0] = argc as u64;

    let mut arg: usize = 0;
    words[1 as isize] = (virtual_base + string_offset) as u64;
    // `for byte in argv` is the slice-safe iterator form: argv may later be
    // runtime data, but no unproved index is introduced while scanning it.
    for byte in argv {
        if (arg >= argc) { break; }
        if (string_offset >= PROCESS_STACK_LAYOUT_BYTES) {
            return ProcessImageStackResult::Invalid;
        }
        let tail: *u8 = (physical_base + string_offset) as *u8;
        tail[0 as isize] = byte;
        string_offset = string_offset + 1;
        if (byte == 0) {
            arg = arg + 1;
            if (arg < argc) {
                words[(arg + 1) as isize] =
                    (virtual_base + string_offset) as u64;
            }
        }
    }
    if (arg != argc) { return ProcessImageStackResult::Invalid; }
    words[(argc + 1) as isize] = 0;
    words[(argc + 2) as isize] = 0;

    // The static PIE has no interpreter (AT_BASE=0). The ELF header and
    // program table are in the first PT_LOAD, so AT_PHDR is directly based
    // on the process load address.
    words[auxv_start as isize] = AT_PAGESZ as u64;
    words[(auxv_start + 1) as isize] = PAGE_SIZE as u64;
    words[(auxv_start + 2) as isize] = AT_PHDR as u64;
    words[(auxv_start + 3) as isize] =
        (USER_TEXT_VA + plan.program_offset) as u64;
    words[(auxv_start + 4) as isize] = AT_PHENT as u64;
    words[(auxv_start + 5) as isize] = ELF_PROGRAM_HEADER_SIZE as u64;
    words[(auxv_start + 6) as isize] = AT_PHNUM as u64;
    words[(auxv_start + 7) as isize] = plan.program_count as u64;
    words[(auxv_start + 8) as isize] = AT_BASE as u64;
    words[(auxv_start + 9) as isize] = 0;
    words[(auxv_start + 10) as isize] = AT_ENTRY as u64;
    words[(auxv_start + 11) as isize] = (USER_TEXT_VA + plan.entry) as u64;
    words[(auxv_start + 12) as isize] = AT_RANDOM as u64;
    words[(auxv_start + 13) as isize] = random_address as u64;
    words[(auxv_start + 14) as isize] = AT_SECURE as u64;
    words[(auxv_start + 15) as isize] = 0;
    words[(auxv_start + 16) as isize] = 0;
    words[(auxv_start + 17) as isize] = 0;
    let random: *u8 = (physical_base + random_offset) as *u8;
    for i: usize in 0..<16 { random[i as isize] = (0xA5 ^ i) as u8; }

    if (words[0 as isize] != argc as u64 ||
        words[(argc + 1) as isize] != 0 ||
        words[(argc + 2) as isize] != 0 ||
        words[(auxv_start + 1) as isize] != PAGE_SIZE as u64 ||
        words[(auxv_start + 3) as isize] !=
            (USER_TEXT_VA + plan.program_offset) as u64 ||
        words[(auxv_start + 11) as isize] !=
            (USER_TEXT_VA + plan.entry) as u64 ||
        words[(auxv_start + 17) as isize] != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_dynamic_prepare_stack(page: borrow PageOwner[page],
                                 application: DistroElfLoadPlan,
                                 interpreter_bias: usize)
        -> ProcessImageStackResult !{unsafe} {
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let physical_base: usize = page_physical_address(page) +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let virtual_base: usize = USER_TEXT_VA +
                              process_stack_top_page() * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let random_address: usize = virtual_base + 304;
    let argv0_address: usize = virtual_base + 320;
    let words: *u64 = physical_base as *u64;

    // Persistent foreground daemon: HTTPd creates/listens/accepts itself.
    // argv={"busybox-httpd","httpd","-f","-p","8080","-h","/"}
    words[0] = 7;
    words[1] = argv0_address as u64;
    words[2] = (virtual_base + 336) as u64;
    words[3] = (virtual_base + 344) as u64;
    words[4] = (virtual_base + 352) as u64;
    words[5] = (virtual_base + 360) as u64;
    words[6] = (virtual_base + 368) as u64;
    words[7] = (virtual_base + 376) as u64;
    words[8] = 0;
    words[9] = 0;

    words[10] = AT_PAGESZ as u64; words[11] = PAGE_SIZE as u64;
    words[12] = AT_PHDR as u64;
    words[13] = (USER_TEXT_VA + application.program_offset) as u64;
    words[14] = AT_PHENT as u64;
    words[15] = ELF_PROGRAM_HEADER_SIZE as u64;
    words[16] = AT_PHNUM as u64; words[17] = application.program_count as u64;
    words[18] = AT_BASE as u64;
    words[19] = (USER_TEXT_VA + interpreter_bias) as u64;
    words[20] = AT_ENTRY as u64;
    words[21] = (USER_TEXT_VA + application.entry) as u64;
    words[22] = AT_RANDOM as u64; words[23] = random_address as u64;
    words[24] = AT_SECURE as u64; words[25] = 0;
    words[26] = AT_UID as u64; words[27] = 0;
    words[28] = AT_EUID as u64; words[29] = 0;
    words[30] = AT_GID as u64; words[31] = 0;
    words[32] = AT_EGID as u64; words[33] = 0;
    words[34] = AT_EXECFN as u64; words[35] = argv0_address as u64;
    words[36] = 0; words[37] = 0;

    let tail: *u8 = (physical_base + 304) as *u8;
    for i: usize in 0..<16 { tail[i as isize] = (0x5A ^ i) as u8; }
    slice_copy(unsafe { tail[16 as isize..<30 as isize] },
               "busybox-httpd\0" as []u8);
    slice_copy(unsafe { tail[32 as isize..<38 as isize] }, "httpd\0" as []u8);
    slice_copy(unsafe { tail[40 as isize..<43 as isize] }, "-f\0" as []u8);
    slice_copy(unsafe { tail[48 as isize..<51 as isize] }, "-p\0" as []u8);
    slice_copy(unsafe { tail[56 as isize..<61 as isize] }, "8080\0" as []u8);
    slice_copy(unsafe { tail[64 as isize..<67 as isize] }, "-h\0" as []u8);
    slice_copy(unsafe { tail[72 as isize..<74 as isize] }, "/\0" as []u8);

    if (words[0] != 7 || words[8] != 0 || words[9] != 0 ||
        words[13] != (USER_TEXT_VA + application.program_offset) as u64 ||
        words[19] != (USER_TEXT_VA + interpreter_bias) as u64 ||
        words[21] != (USER_TEXT_VA + application.entry) as u64 ||
        words[35] != argv0_address as u64 || words[36] != 0 ||
        tail[29] != 0 || tail[37] != 0 || tail[73] != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_image_load_page(page: borrow PageOwner[page],
                           plan: DistroElfLoadPlan,
                           header: *KernelElf64ProgramHeader,
                           load_bias: usize,
                           l3_index: usize)
        -> ProcessImagePageLoadResult !{unsafe} {
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let page_start: usize = l3_index * PAGE_SIZE;
    let page_end: usize = page_start + PAGE_SIZE;
    let segment_start: usize =
        (header.virtual_address as usize) + load_bias;
    let file_size: usize = header.file_size as usize;
    let file_end: usize = segment_start + file_size;
    let mut copy_start: usize = page_start;
    if (copy_start < segment_start) { copy_start = segment_start; }
    let mut copy_end: usize = page_end;
    if (copy_end > file_end) { copy_end = file_end; }
    if (copy_start >= copy_end) {
        if (slice_eq(bytes, process_image_zero_page as []u8)) {
            return ProcessImagePageLoadResult::Loaded;
        }
        return ProcessImagePageLoadResult::Invalid;
    }

    let destination_offset: usize = copy_start - page_start;
    let source_offset: usize = (header.offset as usize) +
                               (copy_start - segment_start);
    let copy_length: usize = copy_end - copy_start;
    if (destination_offset > PAGE_SIZE || copy_length > PAGE_SIZE - destination_offset ||
        source_offset > plan.image_length ||
        copy_length > plan.image_length - source_offset) {
        return ProcessImagePageLoadResult::Invalid;
    }

    // Both ranges are explicitly bounded above. Their endpoints are related
    // runtime values, which the current refinement checker cannot carry into
    // slice syntax; unsafe is confined to constructing these checked views.
    let source: *u8 = plan.image_address as *u8;
    let destination = unsafe {
        bytes[destination_offset..<destination_offset + copy_length]
    };
    let file_bytes = unsafe {
        source[source_offset as isize..<(source_offset + copy_length) as isize]
    };
    slice_copy(destination, file_bytes);
    if (slice_eq(destination, file_bytes) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }

    // Every byte outside the file-backed overlap must still be zero. Dynamic
    // slice endpoints have the same explicit proof above and the same narrow
    // checker limitation as the copy views.
    let zeros = process_image_zero_page as []u8;
    let prefix = unsafe { bytes[0..<destination_offset] };
    let zero_prefix = unsafe { zeros[0..<destination_offset] };
    let suffix_start: usize = destination_offset + copy_length;
    let suffix = unsafe { bytes[suffix_start..<PAGE_SIZE] };
    let zero_suffix = unsafe { zeros[suffix_start..<PAGE_SIZE] };
    if (slice_eq(prefix, zero_prefix) == false ||
        slice_eq(suffix, zero_suffix) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }
    return ProcessImagePageLoadResult::Loaded;
}

// Address-space cleanup walks the actual L2/L3 tree, releasing every
// transferred user page and every dynamic L3 table page. It needs no
// per-image page-index list and scales with populated branches.
fn process_image_cleanup() {
    let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_root_index();
    address_space_release_user_mappings(root);
    process_image_record[root].active_page_count = 0;
    process_image_record[root].stack_growth_active = false;
    process_image_record[root].stack_lowest_l3 = process_stack_top_page();
}

// Called directly from el0_sync_entry for a lower-EL data-abort translation
// fault. It accepts only an address inside the reserved, downward-growing
// stack and maps every missing page down to that address. Mapping the whole
// gap handles an ABI that subtracts a large stack frame before its first
// store, while the guard page below the reservation remains unmapped.
fn process_image_handle_data_abort(esr: usize, fault_address: usize) -> bool {
    let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_root_index();
    let exception_class: usize = (esr >> 26) & 0x3F;
    let fault_status: usize = esr & 0x3F;
    // A COW write is a level-3 permission fault (0x0f). It must be handled
    // before translation-fault stack growth: both refer to an EL0 data abort,
    // but only the COW PTE already names a present shared physical page.
    if (exception_class == 0x24 && fault_status == 0x0F &&
        (esr & (1 << 6)) != 0) {
        if (fault_address < USER_TEXT_VA ||
            fault_address >= USER_TEXT_VA + USER_SPACE_PAGE_COUNT * PAGE_SIZE) {
            return false;
        }
        let index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
        return address_space_resolve_cow(process_image_target_root, index);
    }
    // A missing PTE inside an existing L3 is a level-3 translation fault
    // (0x07). A stack expansion into an unpopulated lazy-L3 branch faults
    // one level earlier (0x06); both are valid only after the range checks
    // below prove this is the current process's reserved stack.
    if (process_image_record[root].stack_growth_active == false ||
        exception_class != 0x24 ||
        (fault_status != 0x06 && fault_status != 0x07)) {
        return false;
    }
    let stack_start: usize = USER_TEXT_VA +
        process_image_record[root].stack_low_page * PAGE_SIZE;
    let stack_top: usize = USER_TEXT_VA + process_stack_top_page() * PAGE_SIZE;
    if (fault_address < stack_start || fault_address >= stack_top) {
        return false;
    }
    let fault_index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
    if (fault_index < process_image_record[root].stack_low_page ||
        fault_index >= process_image_record[root].stack_lowest_l3) {
        return false;
    }
    for l3_index: usize in
            fault_index..<process_image_record[root].stack_lowest_l3 {
        if (process_image_record[root].active_page_count >= USER_SPACE_PAGE_COUNT ||
            process_image_pte_read(l3_index) != 0) {
            return false;
        }
        match page_alloc() {
            PageAllocResult::OutOfMemory => { return false; }
            PageAllocResult::Allocated(stack_page) => {
                let bytes = page_bytes(stack_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                if (process_image_install_page(
                        stack_page, l3_index, USER_RW_XN_FLAGS) == false) {
                    return false;
                }
                process_image_record[root].active_page_count =
                    process_image_record[root].active_page_count + 1;
            }
        }
    }
    process_image_record[root].stack_lowest_l3 = fault_index;
    return true;
}

fn process_image_unmap(pages: sink ProcessImagePages[image]) {
    let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_root_index();
    if (process_image_record[root].stack_growth_active ||
        process_image_record[root].active_page_count > pages.count) {
        process_image_record[root].stack_growth_active = false;
        process_image_record[root].active_page_count = 0;
        process_image_record[root].stack_lowest_l3 = process_stack_top_page();
    }
    process_image_cleanup();
    process_image_target_root = 0;
}

fn process_image_map_segments(plan: DistroElfLoadPlan,
                              load_bias: usize,
                              already_mapped: usize)
        -> ProcessImageSegmentsResult {
    if (plan.extent > USER_SPACE_BYTES ||
        load_bias > USER_SPACE_BYTES - plan.extent) {
        process_image_cleanup();
        return ProcessImageSegmentsResult::OutOfMemory;
    }
    let mut mapped: usize = already_mapped;
    for segment_index: usize in 0..<plan.program_count {
        let header_address: usize = plan.image_address + plan.program_offset +
                                    segment_index * ELF_PROGRAM_HEADER_SIZE;
        let header: *KernelElf64ProgramHeader =
            header_address as *KernelElf64ProgramHeader;
        if (header.segment_type == ELF_PT_LOAD) {
            // PF_R=4 (rodata), PF_R|PF_X=5 (text), PF_R|PF_W=6 (data). A
            // writable+executable combination is never accepted.
            if (header.flags != 4 && header.flags != 5 && header.flags != 6) {
                process_image_cleanup();
                return ProcessImageSegmentsResult::Invalid;
            }
            let virtual_address: usize =
                (header.virtual_address as usize) + load_bias;
            let memory_size: usize = header.memory_size as usize;
            let first_page: usize = virtual_address / PAGE_SIZE;
            let last_byte: usize = virtual_address + memory_size;
            let last_page: usize = (last_byte + 4095) / PAGE_SIZE;
            if (last_page > USER_SPACE_PAGE_COUNT) {
                process_image_cleanup();
                return ProcessImageSegmentsResult::OutOfMemory;
            }
            for l3_index: usize in first_page..<last_page {
                if (process_image_pte_read(l3_index) != 0) {
                    process_image_cleanup();
                    return ProcessImageSegmentsResult::Invalid;
                }
                match page_alloc() {
                    PageAllocResult::OutOfMemory => {
                        process_image_cleanup();
                        return ProcessImageSegmentsResult::OutOfMemory;
                    }
                    PageAllocResult::Allocated(page) => {
                        match process_image_load_page(
                                page, plan, header, load_bias, l3_index) {
                            ProcessImagePageLoadResult::Invalid => {
                                page_free(page);
                                process_image_cleanup();
                                return ProcessImageSegmentsResult::Invalid;
                            }
                            ProcessImagePageLoadResult::Loaded => {
                                let mut flags: usize = USER_RW_XN_FLAGS;
                                if (header.flags == 5) {
                                    flags = USER_TEXT_RX_FLAGS;
                                    user_code_sync(page_physical_address(page),
                                                   PAGE_SIZE);
                                }
                                if (header.flags == 4) {
                                    flags = USER_RODATA_R_FLAGS;
                                }
                                if (process_image_install_page(
                                        page, l3_index, flags) == false) {
                                    process_image_cleanup();
                                    return ProcessImageSegmentsResult::OutOfMemory;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
            }
        }
    }
    }
    return ProcessImageSegmentsResult::Mapped(mapped);
}

fn process_image_pair_probe(primary: DistroElfLoadPlan,
                            interpreter: DistroElfLoadPlan,
                            interpreter_bias: usize)
        -> ProcessImagePairProbeResult {
    // GitHub issue #258 step 2: this path's own layout, seeded before any
    // consumer reads it. Its stack floor is higher than the static path's
    // (this image's heap reaches further up) -- that difference used to be
    // two separate global constants, and is now just two seeds.
    let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_root_index();
    process_image_record[root].stack_top_page = process_stack_top_page();
    process_image_record[root].stack_low_page = PROCESS_STACK_LOW_DYNAMIC;
    process_image_record[root].heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;
    match process_image_map_segments(primary, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::Mapped(primary_count) => {
            match process_image_map_segments(
                    interpreter, interpreter_bias, primary_count) {
                ProcessImageSegmentsResult::Invalid => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::OutOfMemory => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::Mapped(total) => {
                    let combined_extent: usize =
                        interpreter_bias + interpreter.extent;
                    let heap_first_page: usize =
                        (combined_extent + PAGE_SIZE - 1) / PAGE_SIZE;
                    let heap_last_page: usize =
                        heap_first_page +
                        process_image_record[root].heap_page_count;
                    if (total != 195 ||
                        heap_last_page >=
                        process_image_record[root].stack_low_page) {
                        process_image_cleanup();
                        return ProcessImagePairProbeResult::Invalid;
                    }
                    let mut mapped: usize = total;
                    for l3_index: usize in heap_first_page..<heap_last_page {
                        if (process_image_pte_read(l3_index) != 0) {
                            process_image_cleanup();
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc() {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup();
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(heap_page) => {
                                let bytes = page_bytes(heap_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                if (process_image_install_page(
                                        heap_page, l3_index,
                                        USER_RW_XN_FLAGS) == false) {
                                    process_image_cleanup();
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                    // musl and BusyBox httpd use more than one page while
                    // parsing a request. Keep eight pages immediately below
                    // the top mapped; the much larger reservation below
                    // remains demand-faulted rather than eagerly consuming
                    // every page in the 1 GiB address-space slot.
                    for l3_index: usize in
                            process_stack_top_page() -
                            (PROCESS_DYNAMIC_STACK_INITIAL_PAGES - 1)..<
                            process_stack_top_page() {
                        if (process_image_pte_read(l3_index) != 0) {
                            process_image_cleanup();
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc() {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup();
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(stack_page) => {
                                let bytes = page_bytes(stack_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                if (process_image_install_page(
                                        stack_page, l3_index,
                                        USER_RW_XN_FLAGS) == false) {
                                    process_image_cleanup();
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                mapped = mapped + 1;
                            }
                        }
                    }
                    match page_alloc() {
                        PageAllocResult::OutOfMemory => {
                            process_image_cleanup();
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        PageAllocResult::Allocated(stack) => {
                            match process_dynamic_prepare_stack(
                                    stack, primary, interpreter_bias) {
                                ProcessImageStackResult::Invalid => {
                                    page_free(stack);
                                    process_image_cleanup();
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                ProcessImageStackResult::Ready => {
                                        if (process_image_install_page(
                                                stack, process_stack_top_page(),
                                                USER_RW_XN_FLAGS) == false) {
                                            process_image_cleanup();
                                            return ProcessImagePairProbeResult::Invalid;
                                        }
                                        mapped = mapped + 1;
                                }
                            }
                        }
                    }
                    if (mapped == 331) {
                        let image: usize @ 1 = 1;
                        let entry: usize = USER_TEXT_VA + interpreter_bias +
                                           interpreter.entry;
                        let stack_pointer: usize = USER_TEXT_VA +
                            process_stack_top_page() * PAGE_SIZE + PAGE_SIZE -
                            PROCESS_STACK_LAYOUT_BYTES;
                        let heap_start: usize =
                            USER_TEXT_VA + heap_first_page * PAGE_SIZE;
                        let heap_limit: usize =
                            USER_TEXT_VA + heap_last_page * PAGE_SIZE;
                        let mut pages: ProcessImagePages[1] = {
                            image, mapped, entry, stack_pointer,
                            heap_start, heap_limit
                        };
                        return ProcessImagePairProbeResult::Ready(pages);
                    }
                    process_image_cleanup();
                    return ProcessImagePairProbeResult::Invalid;
                }
            }
        }
    }
}

fn process_image_map_current(plan: DistroElfLoadPlan,
                             argv: []u8,
                             argc: usize) -> ProcessImageMapResult {
    let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_root_index();
    process_image_record[root].stack_growth_active = false;
    process_image_record[root].active_page_count = 0;
    process_image_record[root].stack_lowest_l3 = process_stack_top_page();
    process_image_record[root].stack_top_page = process_stack_top_page();
    process_image_record[root].stack_low_page = PROCESS_STACK_LOW_STATIC;
    process_image_record[root].heap_page_count = PROCESS_HEAP_PAGES_DEFAULT;
    if (plan.extent > USER_SPACE_BYTES) {
        return ProcessImageMapResult::OutOfMemory;
    }
    let mut mapped: usize = 0;
    match process_image_map_segments(plan, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImageMapResult::InvalidImage;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImageMapResult::OutOfMemory;
        }
        ProcessImageSegmentsResult::Mapped(count) => { mapped = count; }
    }
    let heap_first_page: usize = (plan.extent + PAGE_SIZE - 1) / PAGE_SIZE;
    let heap_last_page: usize =
        heap_first_page + process_image_record[root].heap_page_count;
    if (heap_last_page >= process_image_record[root].stack_low_page) {
        process_image_cleanup();
        return ProcessImageMapResult::OutOfMemory;
    }
    for l3_index: usize in heap_first_page..<heap_last_page {
        if (process_image_pte_read(l3_index) != 0) {
            process_image_cleanup();
            return ProcessImageMapResult::InvalidImage;
        }
        match page_alloc() {
            PageAllocResult::OutOfMemory => {
                process_image_cleanup();
                return ProcessImageMapResult::OutOfMemory;
            }
            PageAllocResult::Allocated(heap_page) => {
                let bytes = page_bytes(heap_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                if (process_image_install_page(
                        heap_page, l3_index, USER_RW_XN_FLAGS) == false) {
                    process_image_cleanup();
                    return ProcessImageMapResult::OutOfMemory;
                }
                mapped = mapped + 1;
            }
        }
    }
    if (process_image_pte_read(process_stack_top_page()) != 0) {
        process_image_cleanup();
        return ProcessImageMapResult::InvalidImage;
    }
    match page_alloc() {
        PageAllocResult::OutOfMemory => {
            process_image_cleanup();
            return ProcessImageMapResult::OutOfMemory;
        }
        PageAllocResult::Allocated(stack) => {
            match process_image_prepare_stack(stack, plan, argv, argc) {
                ProcessImageStackResult::Invalid => {
                    page_free(stack);
                    process_image_cleanup();
                    return ProcessImageMapResult::InvalidImage;
                }
                ProcessImageStackResult::Ready => {
                        if (process_image_install_page(
                                stack, process_stack_top_page(),
                                USER_RW_XN_FLAGS) == false) {
                            process_image_cleanup();
                            return ProcessImageMapResult::OutOfMemory;
                        }
                        mapped = mapped + 1;
                }
            }
        }
    }
    let image: usize @ 0 = 0;
    let entry: usize = USER_TEXT_VA + plan.entry;
    let stack_pointer: usize = USER_TEXT_VA +
                               process_stack_top_page() * PAGE_SIZE +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_BYTES;
    let heap_start: usize = USER_TEXT_VA + heap_first_page * PAGE_SIZE;
    let heap_limit: usize = USER_TEXT_VA + heap_last_page * PAGE_SIZE;
    let mut pages: ProcessImagePages[0] = {
        image, mapped, entry, stack_pointer, heap_start, heap_limit
    };
    process_image_record[root].active_page_count = mapped;
    process_image_record[root].stack_growth_active = true;
    return ProcessImageMapResult::Mapped(pages);
}

fn process_image_map(plan: DistroElfLoadPlan,
                     argv: []u8,
                     argc: usize) -> ProcessImageMapResult {
    process_image_target_root = 0;
    return process_image_map_current(plan, argv, argc);
}

fn process_image_map_in_root(plan: DistroElfLoadPlan,
                             argv: []u8,
                             argc: usize,
                             root: usize) -> ProcessImageMapResult {
    if (root >= PROCESS_IMAGE_ROOT_MAX ||
        address_space_is_live(root) == false) {
        return ProcessImageMapResult::InvalidImage;
    }
    process_image_target_root = root;
    return process_image_map_current(plan, argv, argc);
}

fn process_image_page_count(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.count;
}

fn process_image_entry(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.entry;
}

fn process_image_stack_pointer(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.stack_pointer;
}

fn process_image_stack_grew(pages: borrow ProcessImagePages[image]) -> bool {
    let root: {0..<PROCESS_IMAGE_ROOT_MAX as usize} = process_image_root_index();
    return process_image_record[root].stack_growth_active &&
           process_image_record[root].active_page_count > pages.count;
}

fn process_image_heap_range(pages: borrow ProcessImagePages[image])
        -> (usize, usize) {
    return (pages.heap_start, pages.heap_limit);
}

fn process_image_window_is_clear() -> bool {
    for i: usize in 0..<USER_SPACE_PAGE_COUNT {
        if (process_image_pte_read(i) != 0) { return false; }
    }
    return true;
}

fn process_image_gap_is_unmapped() -> bool {
    // Alpine BusyBox's first PT_LOAD ends at page 266 and its second starts at
    // page 285. Keeping this gap absent is part of the current fixture's VM
    // contract; it must not become zero-filled executable memory by accident.
    for i: usize in 266..<285 {
        if (process_image_pte_read(i) != 0) { return false; }
    }
    return true;
}
