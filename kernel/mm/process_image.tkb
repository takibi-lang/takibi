use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/fs/elf64.tkb";

private let mut image_page_indices: [usize; BOOT_PAGE_COUNT];
private let mut image_l3_indices: [usize; BOOT_PAGE_COUNT];
private let mut process_image_zero_page: [u8; PAGE_SIZE];
private let mut clone_page_indices: [usize; 512];
private let mut clone_l3_indices: [usize; 512];
private let mut clone_page_count: usize;
private let mut clone_last_reaped_count: usize;
// The active static-PIE image is the only process-image user of root 0.
// Its initial mappings are recorded at map time; pages faulted into its
// reserved stack are appended here so process_image_unmap releases them too.
private let mut process_image_active_page_count: usize;
private let mut process_image_stack_lowest_l3: usize;
private let mut process_image_stack_growth_active: bool;

private linear view ProcessCloneVmOwner;
variant ProcessCloneVmValue {
    Empty;
    Ready(ProcessCloneVmOwner);
}
struct ProcessCloneVmStore {
    private mutex: i32;
    private value: ProcessCloneVmValue;
}
private let mut process_clone_vm_store: ProcessCloneVmStore;
private linear view ProcessCloneVmGuard[lock: addr];

must_use variant ProcessCloneVmResult { OutOfMemory; Copied; }
must_use variant ProcessCloneVmReapResult { Missing; Reaped; }

const PROCESS_STACK_L3_INDEX: usize = 511;
const PROCESS_DYNAMIC_STACK_FIRST_L3_INDEX: usize = 504;
// 256 KiB is a bounded virtual reservation, not an eager allocation. It
// leaves the static BusyBox heap (ending at page 419) below the reservation.
// The unmapped page immediately below it is the guard page; #198 only maps
// pages in this interval after an EL0 translation fault.
const PROCESS_STACK_GROWTH_FIRST_L3_INDEX: usize = 448;
const PROCESS_STACK_LAYOUT_SIZE: usize = 512;
const PROCESS_HEAP_PAGE_COUNT: usize = 128;
const AT_PHDR: usize = 3;
const AT_PHENT: usize = 4;
const AT_PHNUM: usize = 5;
const AT_PAGESZ: usize = 6;
const AT_BASE: usize = 7;
const AT_ENTRY: usize = 9;
const AT_SECURE: usize = 23;
const AT_RANDOM: usize = 25;
const AT_UID: usize = 11;
const AT_EUID: usize = 12;
const AT_GID: usize = 13;
const AT_EGID: usize = 14;
const AT_EXECFN: usize = 31;

fn process_clone_vm_lock(lock: *i32 @ address)
        -> ProcessCloneVmGuard[address] {
    return view ProcessCloneVmGuard[address];
}

fn process_clone_vm_unlock(guard: sink ProcessCloneVmGuard[address],
                           lock: *i32 @ address) {}

fn process_clone_vm_owner_drop(owner: sink ProcessCloneVmOwner) {}

fn process_clone_vm_install(owner: sink ProcessCloneVmOwner) -> bool {
    let guard = process_clone_vm_lock(&process_clone_vm_store.mutex);
    let previous: ProcessCloneVmValue = stable_replace(
        guard, &process_clone_vm_store.mutex,
        process_clone_vm_store.value, ProcessCloneVmValue::Ready(owner));
    match previous {
        ProcessCloneVmValue::Empty => {
            process_clone_vm_unlock(
                guard, &process_clone_vm_store.mutex);
            return true;
        }
        ProcessCloneVmValue::Ready(stale) => {
            let displaced: ProcessCloneVmValue = stable_replace(
                guard, &process_clone_vm_store.mutex,
                process_clone_vm_store.value,
                ProcessCloneVmValue::Ready(stale));
            process_clone_vm_unlock(
                guard, &process_clone_vm_store.mutex);
            match displaced {
                ProcessCloneVmValue::Empty => { return false; }
                ProcessCloneVmValue::Ready(incoming) => {
                    // This branch is unreachable in the single-child model;
                    // consume the incoming proof after rolling its pages back.
                    process_clone_vm_owner_drop(incoming);
                    return false;
                }
            }
        }
    }
}

fn process_clone_vm_take() -> ProcessCloneVmValue {
    let guard = process_clone_vm_lock(&process_clone_vm_store.mutex);
    let previous: ProcessCloneVmValue = stable_replace(
        guard, &process_clone_vm_store.mutex,
        process_clone_vm_store.value, ProcessCloneVmValue::Empty);
    process_clone_vm_unlock(guard, &process_clone_vm_store.mutex);
    return previous;
}

fn process_clone_vm_rollback(count: usize) {
    for i: usize in 0..<count {
        if (i < 512) {
            let l3_index: usize = clone_l3_indices[i];
            let child_page: usize = clone_page_indices[i];
            if (l3_index < 512 && child_page < BOOT_PAGE_COUNT) {
                address_space_pte_write(1, l3_index, 0);
                address_space_tlb_invalidate(
                    1, USER_TEXT_VA + l3_index * PAGE_SIZE);
                page_transferred_release(child_page);
            }
        }
    }
    clone_page_count = 0;
}

fn process_image_clone_vm_begin() -> ProcessCloneVmResult !{unsafe} {
    clone_page_count = 0;
    address_space_clear_root(1);
    for l3_index: usize in 0..<512 {
        let parent_pte: usize = address_space_pte_read(0, l3_index);
        if (parent_pte != 0) {
            match page_alloc() {
                PageAllocResult::OutOfMemory => {
                    process_clone_vm_rollback(clone_page_count);
                    return ProcessCloneVmResult::OutOfMemory;
                }
                PageAllocResult::Allocated(child_page) => {
                    let parent_physical: usize =
                        parent_pte & 0x000000FFFFFFF000;
                    let slot_value: usize = clone_page_count;
                    if (slot_value >= 0 && slot_value < 512) {
                        let slot: {0..<512 as usize} = slot_value;
                        if (page_copy_mapped_physical(
                                parent_physical, child_page) == false) {
                            page_free(child_page);
                            process_clone_vm_rollback(clone_page_count);
                            return ProcessCloneVmResult::OutOfMemory;
                        }
                        clone_l3_indices[slot] = l3_index;
                        let child_physical: usize =
                            page_physical_address(child_page);
                        let child_pte: usize = child_physical |
                            (parent_pte & 0xFFFFFF0000000FFF);
                        address_space_pte_write(1, l3_index, child_pte);
                        address_space_tlb_invalidate(
                            1, USER_TEXT_VA + l3_index * PAGE_SIZE);
                        clone_page_indices[slot] =
                            page_owner_transfer_index(child_page);
                        clone_page_count = clone_page_count + 1;
                    } else {
                        page_free(child_page);
                        process_clone_vm_rollback(clone_page_count);
                        return ProcessCloneVmResult::OutOfMemory;
                    }
                }
            }
        }
    }
    if (clone_page_count == 0) {
        return ProcessCloneVmResult::OutOfMemory;
    }
    if (process_clone_vm_install(view ProcessCloneVmOwner) == false) {
        process_clone_vm_rollback(clone_page_count);
        return ProcessCloneVmResult::OutOfMemory;
    }
    return ProcessCloneVmResult::Copied;
}

fn process_image_activate_parent() {
    address_space_activate_root(0);
}

fn process_image_activate_child() {
    address_space_activate_root(1);
}

fn process_image_clone_vm_reap() -> ProcessCloneVmReapResult {
    match process_clone_vm_take() {
        ProcessCloneVmValue::Empty => {
            return ProcessCloneVmReapResult::Missing;
        }
        ProcessCloneVmValue::Ready(owner) => {
            let count: usize = clone_page_count;
            process_clone_vm_rollback(count);
            process_image_activate_parent();
            process_clone_vm_owner_drop(owner);
            clone_last_reaped_count = count;
            return ProcessCloneVmReapResult::Reaped;
        }
    }
}

fn process_image_clone_vm_reaped_pages() -> usize {
    return clone_last_reaped_count;
}

linear struct ProcessImagePages[image: usize] {
    private image: usize @ image;
    private count: usize;
    private entry: usize;
    private stack_pointer: usize;
    private heap_start: usize;
    private heap_limit: usize;
}

fn process_image_record(slot: usize,
                        page_index: {0..<BOOT_PAGE_COUNT as usize},
                        l3_index: usize) {
    if (slot < BOOT_PAGE_COUNT) {
        image_page_indices[slot] = page_index;
        image_l3_indices[slot] = l3_index;
    }
}

must_use variant ProcessImageMapResult {
    InvalidImage;
    OutOfMemory;
    Mapped(exists image: usize. ProcessImagePages[image]);
}

must_use variant ProcessImagePageLoadResult { Invalid; Loaded; }
must_use variant ProcessImageStackResult { Invalid; Ready; }
must_use variant ProcessImageSegmentsResult {
    Invalid;
    OutOfMemory;
    Mapped(usize);
}
must_use variant ProcessImagePairProbeResult {
    Invalid;
    Ready(exists image: usize. ProcessImagePages[image]);
}

// A flat, NUL-terminated argv blob is deliberately used instead of an array
// of `[]u8` owners: it is plain immutable data, so one builder can consume
// literal argv values now and a script/path-derived argv later without an
// ownership transfer per element. `argc` names exactly how many strings the
// blob contains.
fn process_image_prepare_stack(page: borrow PageOwner[page],
                               plan: DistroElfLoadPlan,
                               argv: []u8,
                               argc: usize)
        -> ProcessImageStackResult !{unsafe} {
    if (argc == 0 || argc > 32) { return ProcessImageStackResult::Invalid; }
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let physical_base: usize = page_physical_address(page) +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_SIZE;
    let virtual_base: usize = USER_TEXT_VA +
                              PROCESS_STACK_L3_INDEX * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_SIZE;
    // argc, argv[], argv terminator, envp terminator, then eight auxv
    // key/value pairs and AT_NULL. The random bytes immediately follow.
    let auxv_start: usize = argc + 3;
    let random_offset: usize = (auxv_start + 18) * 8;
    let mut string_offset: usize = random_offset + 16;
    if (string_offset > PROCESS_STACK_LAYOUT_SIZE) {
        return ProcessImageStackResult::Invalid;
    }
    let random_address: usize = virtual_base + random_offset;
    let words: *u64 = physical_base as *u64;
    words[0] = argc as u64;

    let mut arg: usize = 0;
    words[1 as isize] = (virtual_base + string_offset) as u64;
    // `for byte in argv` is the slice-safe iterator form: argv may later be
    // runtime data, but no unproved index is introduced while scanning it.
    for byte in argv {
        if (arg >= argc || string_offset >= PROCESS_STACK_LAYOUT_SIZE) {
            return ProcessImageStackResult::Invalid;
        }
        let tail: *u8 = (physical_base + string_offset) as *u8;
        tail[0 as isize] = byte;
        string_offset = string_offset + 1;
        if (byte == 0) {
            arg = arg + 1;
            if (arg < argc) {
                words[(arg + 1) as isize] =
                    (virtual_base + string_offset) as u64;
            }
        }
    }
    if (arg != argc) { return ProcessImageStackResult::Invalid; }
    words[(argc + 1) as isize] = 0;
    words[(argc + 2) as isize] = 0;

    // The static PIE has no interpreter (AT_BASE=0). The ELF header and
    // program table are in the first PT_LOAD, so AT_PHDR is directly based
    // on the process load address.
    words[auxv_start as isize] = AT_PAGESZ as u64;
    words[(auxv_start + 1) as isize] = PAGE_SIZE as u64;
    words[(auxv_start + 2) as isize] = AT_PHDR as u64;
    words[(auxv_start + 3) as isize] =
        (USER_TEXT_VA + plan.program_offset) as u64;
    words[(auxv_start + 4) as isize] = AT_PHENT as u64;
    words[(auxv_start + 5) as isize] = ELF_PROGRAM_HEADER_SIZE as u64;
    words[(auxv_start + 6) as isize] = AT_PHNUM as u64;
    words[(auxv_start + 7) as isize] = plan.program_count as u64;
    words[(auxv_start + 8) as isize] = AT_BASE as u64;
    words[(auxv_start + 9) as isize] = 0;
    words[(auxv_start + 10) as isize] = AT_ENTRY as u64;
    words[(auxv_start + 11) as isize] = (USER_TEXT_VA + plan.entry) as u64;
    words[(auxv_start + 12) as isize] = AT_RANDOM as u64;
    words[(auxv_start + 13) as isize] = random_address as u64;
    words[(auxv_start + 14) as isize] = AT_SECURE as u64;
    words[(auxv_start + 15) as isize] = 0;
    words[(auxv_start + 16) as isize] = 0;
    words[(auxv_start + 17) as isize] = 0;
    let random: *u8 = (physical_base + random_offset) as *u8;
    for i: usize in 0..<16 { random[i as isize] = (0xA5 ^ i) as u8; }

    if (words[0 as isize] != argc as u64 ||
        words[(argc + 1) as isize] != 0 ||
        words[(argc + 2) as isize] != 0 ||
        words[(auxv_start + 1) as isize] != PAGE_SIZE as u64 ||
        words[(auxv_start + 3) as isize] !=
            (USER_TEXT_VA + plan.program_offset) as u64 ||
        words[(auxv_start + 11) as isize] !=
            (USER_TEXT_VA + plan.entry) as u64 ||
        words[(auxv_start + 17) as isize] != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_dynamic_prepare_stack(page: borrow PageOwner[page],
                                 application: DistroElfLoadPlan,
                                 interpreter_bias: usize)
        -> ProcessImageStackResult !{unsafe} {
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let physical_base: usize = page_physical_address(page) +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_SIZE;
    let virtual_base: usize = USER_TEXT_VA +
                              PROCESS_STACK_L3_INDEX * PAGE_SIZE +
                              PAGE_SIZE - PROCESS_STACK_LAYOUT_SIZE;
    let random_address: usize = virtual_base + 304;
    let argv0_address: usize = virtual_base + 320;
    let words: *u64 = physical_base as *u64;

    // Persistent foreground daemon: HTTPd creates/listens/accepts itself.
    // argv={"busybox-httpd","httpd","-f","-p","8080","-h","/"}
    words[0] = 7;
    words[1] = argv0_address as u64;
    words[2] = (virtual_base + 336) as u64;
    words[3] = (virtual_base + 344) as u64;
    words[4] = (virtual_base + 352) as u64;
    words[5] = (virtual_base + 360) as u64;
    words[6] = (virtual_base + 368) as u64;
    words[7] = (virtual_base + 376) as u64;
    words[8] = 0;
    words[9] = 0;

    words[10] = AT_PAGESZ as u64; words[11] = PAGE_SIZE as u64;
    words[12] = AT_PHDR as u64;
    words[13] = (USER_TEXT_VA + application.program_offset) as u64;
    words[14] = AT_PHENT as u64;
    words[15] = ELF_PROGRAM_HEADER_SIZE as u64;
    words[16] = AT_PHNUM as u64; words[17] = application.program_count as u64;
    words[18] = AT_BASE as u64;
    words[19] = (USER_TEXT_VA + interpreter_bias) as u64;
    words[20] = AT_ENTRY as u64;
    words[21] = (USER_TEXT_VA + application.entry) as u64;
    words[22] = AT_RANDOM as u64; words[23] = random_address as u64;
    words[24] = AT_SECURE as u64; words[25] = 0;
    words[26] = AT_UID as u64; words[27] = 0;
    words[28] = AT_EUID as u64; words[29] = 0;
    words[30] = AT_GID as u64; words[31] = 0;
    words[32] = AT_EGID as u64; words[33] = 0;
    words[34] = AT_EXECFN as u64; words[35] = argv0_address as u64;
    words[36] = 0; words[37] = 0;

    let tail: *u8 = (physical_base + 304) as *u8;
    for i: usize in 0..<16 { tail[i as isize] = (0x5A ^ i) as u8; }
    slice_copy(unsafe { tail[16 as isize..<30 as isize] },
               "busybox-httpd\0" as []u8);
    slice_copy(unsafe { tail[32 as isize..<38 as isize] }, "httpd\0" as []u8);
    slice_copy(unsafe { tail[40 as isize..<43 as isize] }, "-f\0" as []u8);
    slice_copy(unsafe { tail[48 as isize..<51 as isize] }, "-p\0" as []u8);
    slice_copy(unsafe { tail[56 as isize..<61 as isize] }, "8080\0" as []u8);
    slice_copy(unsafe { tail[64 as isize..<67 as isize] }, "-h\0" as []u8);
    slice_copy(unsafe { tail[72 as isize..<74 as isize] }, "/\0" as []u8);

    if (words[0] != 7 || words[8] != 0 || words[9] != 0 ||
        words[13] != (USER_TEXT_VA + application.program_offset) as u64 ||
        words[19] != (USER_TEXT_VA + interpreter_bias) as u64 ||
        words[21] != (USER_TEXT_VA + application.entry) as u64 ||
        words[35] != argv0_address as u64 || words[36] != 0 ||
        tail[29] != 0 || tail[37] != 0 || tail[73] != 0) {
        return ProcessImageStackResult::Invalid;
    }
    return ProcessImageStackResult::Ready;
}

fn process_image_load_page(page: borrow PageOwner[page],
                           plan: DistroElfLoadPlan,
                           header: *KernelElf64ProgramHeader,
                           load_bias: usize,
                           l3_index: usize)
        -> ProcessImagePageLoadResult !{unsafe} {
    let bytes = page_bytes(page);
    for i: usize in 0..<4096 { bytes[i] = 0; }

    let page_start: usize = l3_index * PAGE_SIZE;
    let page_end: usize = page_start + PAGE_SIZE;
    let segment_start: usize =
        (header.virtual_address as usize) + load_bias;
    let file_size: usize = header.file_size as usize;
    let file_end: usize = segment_start + file_size;
    let mut copy_start: usize = page_start;
    if (copy_start < segment_start) { copy_start = segment_start; }
    let mut copy_end: usize = page_end;
    if (copy_end > file_end) { copy_end = file_end; }
    if (copy_start >= copy_end) {
        if (slice_eq(bytes, process_image_zero_page as []u8)) {
            return ProcessImagePageLoadResult::Loaded;
        }
        return ProcessImagePageLoadResult::Invalid;
    }

    let destination_offset: usize = copy_start - page_start;
    let source_offset: usize = (header.offset as usize) +
                               (copy_start - segment_start);
    let copy_length: usize = copy_end - copy_start;
    if (destination_offset > PAGE_SIZE || copy_length > PAGE_SIZE - destination_offset ||
        source_offset > plan.image_length ||
        copy_length > plan.image_length - source_offset) {
        return ProcessImagePageLoadResult::Invalid;
    }

    // Both ranges are explicitly bounded above. Their endpoints are related
    // runtime values, which the current refinement checker cannot carry into
    // slice syntax; unsafe is confined to constructing these checked views.
    let source: *u8 = plan.image_address as *u8;
    let destination = unsafe {
        bytes[destination_offset..<destination_offset + copy_length]
    };
    let file_bytes = unsafe {
        source[source_offset as isize..<(source_offset + copy_length) as isize]
    };
    slice_copy(destination, file_bytes);
    if (slice_eq(destination, file_bytes) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }

    // Every byte outside the file-backed overlap must still be zero. Dynamic
    // slice endpoints have the same explicit proof above and the same narrow
    // checker limitation as the copy views.
    let zeros = process_image_zero_page as []u8;
    let prefix = unsafe { bytes[0..<destination_offset] };
    let zero_prefix = unsafe { zeros[0..<destination_offset] };
    let suffix_start: usize = destination_offset + copy_length;
    let suffix = unsafe { bytes[suffix_start..<PAGE_SIZE] };
    let zero_suffix = unsafe { zeros[suffix_start..<PAGE_SIZE] };
    if (slice_eq(prefix, zero_prefix) == false ||
        slice_eq(suffix, zero_suffix) == false) {
        return ProcessImagePageLoadResult::Invalid;
    }
    return ProcessImagePageLoadResult::Loaded;
}

fn process_image_cleanup(count: usize) {
    for i: usize in 0..<count {
        if (i < BOOT_PAGE_COUNT) {
            let l3_index: usize = image_l3_indices[i];
            let page_index: usize = image_page_indices[i];
            if (l3_index < 512 && page_index < BOOT_PAGE_COUNT) {
                user_pte_write(l3_index, 0);
                user_tlb_invalidate(USER_TEXT_VA + l3_index * PAGE_SIZE);
                page_transferred_release(page_index);
            }
        }
    }
}

// Called directly from el0_sync_entry for a lower-EL data-abort translation
// fault. It accepts only an address inside the reserved, downward-growing
// stack and maps every missing page down to that address. Mapping the whole
// gap handles an ABI that subtracts a large stack frame before its first
// store, while the guard page below the reservation remains unmapped.
fn process_image_handle_data_abort(esr: usize, fault_address: usize) -> bool {
    let exception_class: usize = (esr >> 26) & 0x3F;
    let fault_status: usize = esr & 0x3F;
    if (process_image_stack_growth_active == false ||
        exception_class != 0x24 || fault_status != 0x07) {
        return false;
    }
    let stack_start: usize = USER_TEXT_VA +
        PROCESS_STACK_GROWTH_FIRST_L3_INDEX * PAGE_SIZE;
    let stack_top: usize = USER_TEXT_VA + PROCESS_STACK_L3_INDEX * PAGE_SIZE;
    if (fault_address < stack_start || fault_address >= stack_top) {
        return false;
    }
    let fault_index: usize = (fault_address - USER_TEXT_VA) / PAGE_SIZE;
    if (fault_index < PROCESS_STACK_GROWTH_FIRST_L3_INDEX ||
        fault_index >= process_image_stack_lowest_l3) {
        return false;
    }
    for l3_index: usize in fault_index..<process_image_stack_lowest_l3 {
        if (process_image_active_page_count >= BOOT_PAGE_COUNT ||
            user_pte_read(l3_index) != 0) {
            return false;
        }
        match page_alloc() {
            PageAllocResult::OutOfMemory => { return false; }
            PageAllocResult::Allocated(stack_page) => {
                let bytes = page_bytes(stack_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                let phys: usize = page_physical_address(stack_page);
                user_pte_write(l3_index, phys | USER_RW_XN_FLAGS);
                user_tlb_invalidate(USER_TEXT_VA + l3_index * PAGE_SIZE);
                let page_index = page_owner_transfer_index(stack_page);
                process_image_record(
                    process_image_active_page_count, page_index, l3_index);
                process_image_active_page_count =
                    process_image_active_page_count + 1;
            }
        }
    }
    process_image_stack_lowest_l3 = fault_index;
    return true;
}

fn process_image_unmap(pages: sink ProcessImagePages[image]) {
    let mut count: usize = pages.count;
    if (process_image_stack_growth_active) {
        count = process_image_active_page_count;
        process_image_stack_growth_active = false;
        process_image_active_page_count = 0;
        process_image_stack_lowest_l3 = PROCESS_STACK_L3_INDEX;
    }
    process_image_cleanup(count);
}

fn process_image_map_segments(plan: DistroElfLoadPlan,
                              load_bias: usize,
                              already_mapped: usize)
        -> ProcessImageSegmentsResult {
    if (plan.extent > 0x200000 || load_bias > 0x200000 - plan.extent) {
        process_image_cleanup(already_mapped);
        return ProcessImageSegmentsResult::OutOfMemory;
    }
    let mut mapped: usize = already_mapped;
    for segment_index: usize in 0..<plan.program_count {
        let header_address: usize = plan.image_address + plan.program_offset +
                                    segment_index * ELF_PROGRAM_HEADER_SIZE;
        let header: *KernelElf64ProgramHeader =
            header_address as *KernelElf64ProgramHeader;
        if (header.segment_type == ELF_PT_LOAD) {
            // PF_R=4 (rodata), PF_R|PF_X=5 (text), PF_R|PF_W=6 (data). A
            // writable+executable combination is never accepted.
            if (header.flags != 4 && header.flags != 5 && header.flags != 6) {
                process_image_cleanup(mapped);
                return ProcessImageSegmentsResult::Invalid;
            }
            let virtual_address: usize =
                (header.virtual_address as usize) + load_bias;
            let memory_size: usize = header.memory_size as usize;
            let first_page: usize = virtual_address / PAGE_SIZE;
            let last_byte: usize = virtual_address + memory_size;
            let last_page: usize = (last_byte + 4095) / PAGE_SIZE;
            if (last_page > 512) {
                process_image_cleanup(mapped);
                return ProcessImageSegmentsResult::OutOfMemory;
            }
            for l3_index: usize in first_page..<last_page {
                if (user_pte_read(l3_index) != 0) {
                    process_image_cleanup(mapped);
                    return ProcessImageSegmentsResult::Invalid;
                }
                match page_alloc() {
                    PageAllocResult::OutOfMemory => {
                        process_image_cleanup(mapped);
                        return ProcessImageSegmentsResult::OutOfMemory;
                    }
                    PageAllocResult::Allocated(page) => {
                        if (mapped >= 0 && mapped < 512) {
                            match process_image_load_page(
                                    page, plan, header, load_bias, l3_index) {
                                ProcessImagePageLoadResult::Invalid => {
                                    page_free(page);
                                    process_image_cleanup(mapped);
                                    return ProcessImageSegmentsResult::Invalid;
                                }
                                ProcessImagePageLoadResult::Loaded => {
                                    let phys: usize = page_physical_address(page);
                                    let mut flags: usize = USER_RW_XN_FLAGS;
                                    if (header.flags == 5) {
                                        flags = USER_TEXT_RX_FLAGS;
                                        user_code_sync(phys, PAGE_SIZE);
                                    }
                                    if (header.flags == 4) {
                                        flags = USER_RODATA_R_FLAGS;
                                    }
                                    user_pte_write(l3_index, phys | flags);
                                    user_tlb_invalidate(
                                        USER_TEXT_VA + l3_index * PAGE_SIZE);
                                    let page_index =
                                        page_owner_transfer_index(page);
                                    process_image_record(
                                        mapped, page_index, l3_index);
                                    mapped = mapped + 1;
                                }
                            }
                        } else {
                            page_free(page);
                            process_image_cleanup(mapped);
                            return ProcessImageSegmentsResult::OutOfMemory;
                        }
                    }
                }
            }
        }
    }
    return ProcessImageSegmentsResult::Mapped(mapped);
}

fn process_image_pair_probe(primary: DistroElfLoadPlan,
                            interpreter: DistroElfLoadPlan,
                            interpreter_bias: usize)
        -> ProcessImagePairProbeResult {
    match process_image_map_segments(primary, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImagePairProbeResult::Invalid;
        }
        ProcessImageSegmentsResult::Mapped(primary_count) => {
            match process_image_map_segments(
                    interpreter, interpreter_bias, primary_count) {
                ProcessImageSegmentsResult::Invalid => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::OutOfMemory => {
                    return ProcessImagePairProbeResult::Invalid;
                }
                ProcessImageSegmentsResult::Mapped(total) => {
                    let combined_extent: usize =
                        interpreter_bias + interpreter.extent;
                    let heap_first_page: usize =
                        (combined_extent + PAGE_SIZE - 1) / PAGE_SIZE;
                    let heap_last_page: usize =
                        heap_first_page + PROCESS_HEAP_PAGE_COUNT;
                    if (total != 195 ||
                        heap_last_page >= PROCESS_DYNAMIC_STACK_FIRST_L3_INDEX) {
                        process_image_cleanup(total);
                        return ProcessImagePairProbeResult::Invalid;
                    }
                    let mut mapped: usize = total;
                    for l3_index: usize in heap_first_page..<heap_last_page {
                        if (user_pte_read(l3_index) != 0) {
                            process_image_cleanup(mapped);
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc() {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup(mapped);
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(heap_page) => {
                                let bytes = page_bytes(heap_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                let phys: usize = page_physical_address(heap_page);
                                user_pte_write(
                                    l3_index, phys | USER_RW_XN_FLAGS);
                                user_tlb_invalidate(
                                    USER_TEXT_VA + l3_index * PAGE_SIZE);
                                if (mapped >= 512) {
                                    page_free(heap_page);
                                    process_image_cleanup(mapped);
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                let page_index =
                                    page_owner_transfer_index(heap_page);
                                process_image_record(
                                    mapped, page_index, l3_index);
                                mapped = mapped + 1;
                            }
                        }
                    }
                    // musl and BusyBox httpd use more than one page while
                    // parsing a request. Keep the argument/auxv layout in the
                    // top page and map a small contiguous stack below it.
                    for l3_index: usize in PROCESS_DYNAMIC_STACK_FIRST_L3_INDEX..<PROCESS_STACK_L3_INDEX {
                        if (user_pte_read(l3_index) != 0) {
                            process_image_cleanup(mapped);
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        match page_alloc() {
                            PageAllocResult::OutOfMemory => {
                                process_image_cleanup(mapped);
                                return ProcessImagePairProbeResult::Invalid;
                            }
                            PageAllocResult::Allocated(stack_page) => {
                                let bytes = page_bytes(stack_page);
                                for i: usize in 0..<4096 { bytes[i] = 0; }
                                let phys: usize = page_physical_address(stack_page);
                                user_pte_write(l3_index, phys | USER_RW_XN_FLAGS);
                                user_tlb_invalidate(USER_TEXT_VA + l3_index * PAGE_SIZE);
                                if (mapped >= 512) {
                                    page_free(stack_page);
                                    process_image_cleanup(mapped);
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                let page_index = page_owner_transfer_index(stack_page);
                                process_image_record(mapped, page_index, l3_index);
                                mapped = mapped + 1;
                            }
                        }
                    }
                    match page_alloc() {
                        PageAllocResult::OutOfMemory => {
                            process_image_cleanup(mapped);
                            return ProcessImagePairProbeResult::Invalid;
                        }
                        PageAllocResult::Allocated(stack) => {
                            match process_dynamic_prepare_stack(
                                    stack, primary, interpreter_bias) {
                                ProcessImageStackResult::Invalid => {
                                    page_free(stack);
                                    process_image_cleanup(mapped);
                                    return ProcessImagePairProbeResult::Invalid;
                                }
                                ProcessImageStackResult::Ready => {
                                    let phys: usize = page_physical_address(stack);
                                    user_pte_write(
                                        PROCESS_STACK_L3_INDEX,
                                        phys | USER_RW_XN_FLAGS);
                                    user_tlb_invalidate(
                                        USER_TEXT_VA +
                                        PROCESS_STACK_L3_INDEX * PAGE_SIZE);
                                    if (mapped >= 512) {
                                        user_pte_write(PROCESS_STACK_L3_INDEX, 0);
                                        page_free(stack);
                                        process_image_cleanup(mapped);
                                        return ProcessImagePairProbeResult::Invalid;
                                    }
                                    let page_index =
                                        page_owner_transfer_index(stack);
                                    process_image_record(
                                        mapped, page_index,
                                        PROCESS_STACK_L3_INDEX);
                                    mapped = mapped + 1;
                                }
                            }
                        }
                    }
                    if (mapped == 331) {
                        let image: usize @ 1 = 1;
                        let entry: usize = USER_TEXT_VA + interpreter_bias +
                                           interpreter.entry;
                        let stack_pointer: usize = USER_TEXT_VA +
                            PROCESS_STACK_L3_INDEX * PAGE_SIZE + PAGE_SIZE -
                            PROCESS_STACK_LAYOUT_SIZE;
                        let heap_start: usize =
                            USER_TEXT_VA + heap_first_page * PAGE_SIZE;
                        let heap_limit: usize =
                            USER_TEXT_VA + heap_last_page * PAGE_SIZE;
                        let mut pages: ProcessImagePages[1] = {
                            image, mapped, entry, stack_pointer,
                            heap_start, heap_limit
                        };
                        return ProcessImagePairProbeResult::Ready(pages);
                    }
                    process_image_cleanup(mapped);
                    return ProcessImagePairProbeResult::Invalid;
                }
            }
        }
    }
}

fn process_image_map(plan: DistroElfLoadPlan,
                     argv: []u8,
                     argc: usize) -> ProcessImageMapResult {
    process_image_stack_growth_active = false;
    process_image_active_page_count = 0;
    process_image_stack_lowest_l3 = PROCESS_STACK_L3_INDEX;
    if (plan.extent > 0x200000) {
        return ProcessImageMapResult::OutOfMemory;
    }
    let mut mapped: usize = 0;
    match process_image_map_segments(plan, 0, 0) {
        ProcessImageSegmentsResult::Invalid => {
            return ProcessImageMapResult::InvalidImage;
        }
        ProcessImageSegmentsResult::OutOfMemory => {
            return ProcessImageMapResult::OutOfMemory;
        }
        ProcessImageSegmentsResult::Mapped(count) => { mapped = count; }
    }
    let heap_first_page: usize = (plan.extent + PAGE_SIZE - 1) / PAGE_SIZE;
    let heap_last_page: usize = heap_first_page + PROCESS_HEAP_PAGE_COUNT;
    if (heap_last_page >= PROCESS_STACK_GROWTH_FIRST_L3_INDEX) {
        process_image_cleanup(mapped);
        return ProcessImageMapResult::OutOfMemory;
    }
    for l3_index: usize in heap_first_page..<heap_last_page {
        if (user_pte_read(l3_index) != 0) {
            process_image_cleanup(mapped);
            return ProcessImageMapResult::InvalidImage;
        }
        match page_alloc() {
            PageAllocResult::OutOfMemory => {
                process_image_cleanup(mapped);
                return ProcessImageMapResult::OutOfMemory;
            }
            PageAllocResult::Allocated(heap_page) => {
                let bytes = page_bytes(heap_page);
                for i: usize in 0..<4096 { bytes[i] = 0; }
                let phys: usize = page_physical_address(heap_page);
                user_pte_write(l3_index, phys | USER_RW_XN_FLAGS);
                user_tlb_invalidate(USER_TEXT_VA + l3_index * PAGE_SIZE);
                let page_index = page_owner_transfer_index(heap_page);
                process_image_record(mapped, page_index, l3_index);
                mapped = mapped + 1;
            }
        }
    }
    if (user_pte_read(PROCESS_STACK_L3_INDEX) != 0) {
        process_image_cleanup(mapped);
        return ProcessImageMapResult::InvalidImage;
    }
    match page_alloc() {
        PageAllocResult::OutOfMemory => {
            process_image_cleanup(mapped);
            return ProcessImageMapResult::OutOfMemory;
        }
        PageAllocResult::Allocated(stack) => {
            match process_image_prepare_stack(stack, plan, argv, argc) {
                ProcessImageStackResult::Invalid => {
                    page_free(stack);
                    process_image_cleanup(mapped);
                    return ProcessImageMapResult::InvalidImage;
                }
                ProcessImageStackResult::Ready => {
                    let phys: usize = page_physical_address(stack);
                    user_pte_write(PROCESS_STACK_L3_INDEX,
                                   phys | USER_RW_XN_FLAGS);
                    user_tlb_invalidate(USER_TEXT_VA +
                                        PROCESS_STACK_L3_INDEX * PAGE_SIZE);
                    let page_index = page_owner_transfer_index(stack);
                    process_image_record(mapped, page_index,
                                         PROCESS_STACK_L3_INDEX);
                    mapped = mapped + 1;
                }
            }
        }
    }
    let image: usize @ 0 = 0;
    let entry: usize = USER_TEXT_VA + plan.entry;
    let stack_pointer: usize = USER_TEXT_VA +
                               PROCESS_STACK_L3_INDEX * PAGE_SIZE +
                               PAGE_SIZE - PROCESS_STACK_LAYOUT_SIZE;
    let heap_start: usize = USER_TEXT_VA + heap_first_page * PAGE_SIZE;
    let heap_limit: usize = USER_TEXT_VA + heap_last_page * PAGE_SIZE;
    let mut pages: ProcessImagePages[0] = {
        image, mapped, entry, stack_pointer, heap_start, heap_limit
    };
    process_image_active_page_count = mapped;
    process_image_stack_growth_active = true;
    return ProcessImageMapResult::Mapped(pages);
}

fn process_image_page_count(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.count;
}

fn process_image_entry(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.entry;
}

fn process_image_stack_pointer(pages: borrow ProcessImagePages[image]) -> usize {
    return pages.stack_pointer;
}

fn process_image_stack_grew(pages: borrow ProcessImagePages[image]) -> bool {
    return process_image_stack_growth_active &&
           process_image_active_page_count > pages.count;
}

fn process_image_heap_range(pages: borrow ProcessImagePages[image])
        -> (usize, usize) {
    return (pages.heap_start, pages.heap_limit);
}

fn process_image_window_is_clear() -> bool {
    for i: usize in 0..<512 {
        if (user_pte_read(i) != 0) { return false; }
    }
    return true;
}

fn process_image_gap_is_unmapped() -> bool {
    // Alpine BusyBox's first PT_LOAD ends at page 266 and its second starts at
    // page 285. Keeping this gap absent is part of the current fixture's VM
    // contract; it must not become zero-filled executable memory by accident.
    for i: usize in 266..<285 {
        if (user_pte_read(i) != 0) { return false; }
    }
    return true;
}
