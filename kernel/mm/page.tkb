// Bootstrap page allocator, backed by real physical RAM directly (GitHub
// issue #251) rather than a kernel-owned shadow byte array. The previous
// design's compile-time page-content array duplicated every
// managed page's CONTENT inside the kernel's own .bss -- unlike Linux's
// `struct page`/`mem_map` or NetBSD's `vm_page`, which are pure metadata
// (tens of bytes per page) addressing real physical RAM directly, not a
// second, kernel-owned copy of it. That made the page count's true cost
// PAGE_SIZE (4096) bytes per page, capping any real-RAM-sized value well
// below what real hardware has. Real pages now live at `usable_ram_start`
// (kernel/arch/arm64/boot/link.ld's own symbol for the first PAGE_SIZE-
// aligned physical address past every other statically-laid-out kernel
// region). After DTB validation, logical indices resolve through runtime
// extent descriptors rather than assuming one contiguous window. PageMeta
// storage is sized from that discovered inventory and reserved from RAM,
// on the order of tens of bytes per page rather than 4096. See HISTORY.md's
// 2026-08-08 issue #251 entry
// for the real-kernel comparison this was modeled on, and its 2026-08-09
// issue #253 entry for PageMeta's own design.
//
// `page_bytes()` (and everything reached through it) now needs `!{unsafe}`
// as an honest consequence: proving a slice is in-bounds without a runtime
// check requires the compiler to see a real, compile-time-sized backing
// array, which real physical RAM accessed via a linker symbol is not --
// same tradeoff HISTORY.md's 2026-07-28 "Unsafe memory reasoning becomes
// an auditable effect" entry already established elsewhere in this
// kernel. `page_physical_address`/`page_transferred_release_physical`
// stay effect-free: pure address arithmetic and comparison, no
// dereference.
//
// BOOTSTRAP_PAGE_COUNT exists only before the DTB-backed allocator can be
// reached. page_allocator_apply_memory preserves those occupied page tables,
// creates runtime-sized metadata and extent descriptors from the normalized
// DTB regions, and excludes the live DTB and metadata storage themselves.
//
// Slot allocation itself (issue #207, the most acute of that issue's five
// call sites: a 1024-entry scan on every single page allocation) is O(1)
// via kernel/lib/freelist.tkb's FreelistCore(N), not a hand-rolled scan.
//
// GitHub issue #253 (2026-08-09): this file used kernel/lib/slotmap.tkb's
// SlotMap(N) wrapper until then, but its per-slot generation array was
// wasteful here. FreelistCore(N) is the right primitive for this large pool;
// page-specific metadata belongs in PageMeta rather than in a generic pool
// wrapper shared with unrelated owners.
//
// GitHub issue #256 (2026-08-10): PageOwner's generation remains necessary
// as the linear owner's type witness and as the FreelistOwner identity.
// PageMeta does not need to retain that value: the only metadata operation
// is distinguishing occupied from free so integer-based release paths can
// detect a double release. Keeping that state as a bool preserves the
// diagnostic invariant while removing 7 bytes/page of avoidable metadata.
use "kernel/lib/freelist.tkb";
use "kernel/lib/pool_lock.tkb";
use "kernel/lib/execution_model.tkb";

const PAGE_SIZE: usize = 4096;
must_use variant CheckedUsize {
    Value(usize);
    Overflow;
}
// Only the page tables needed to reach the DTB-backed allocator come from
// this compile-time pool. It is not the runtime allocator's capacity.
const BOOTSTRAP_PAGE_COUNT: usize = 2048;

extern symbol usable_ram_start;
extern symbol kernel_image_start;

// DDB's kernel-virtual reader is intentionally limited to the identity-
// mapped ordinary-memory span owned by this image and its page allocator.
// Device blocks may also be mapped in TTBR0, but reading them can acknowledge
// or clear hardware state and is not an inspection-only operation.
fn page_ddb_kernel_address_readable(address: usize, count: usize) -> bool {
    if (count == 0 || address < kernel_image_start ||
            address > 0xFFFFFFFFFFFFFFFF - count) {
        return false;
    }
    let end: usize = address + count;
    if (end <= usable_ram_start) { return true; }
    if (boot_page_pool.runtime_applied == false) {
        let bootstrap_end: usize =
            usable_ram_start + PAGE_SIZE * BOOTSTRAP_PAGE_COUNT;
        return address < bootstrap_end && count <= bootstrap_end - address;
    }
    let first: PageIndexResult = page_index_for_physical(address);
    match first {
        PageIndexResult::NotManaged => { return false; }
        PageIndexResult::Found(first_index) => {
            let last: PageIndexResult = page_index_for_physical(end - 1);
            match last {
                PageIndexResult::NotManaged => { return false; }
                PageIndexResult::Found(last_index) => {
                    if (last_index < first_index) { return false; }
                    let first_page: usize =
                        address - address % PAGE_SIZE;
                    let last_address: usize = end - 1;
                    let last_page: usize =
                        last_address - last_address % PAGE_SIZE;
                    return last_index - first_index ==
                           (last_page - first_page) / PAGE_SIZE;
                }
            }
        }
    }
}

// Physical inspection has the same ordinary-RAM boundary. The current kernel
// maps this span identically, but keeping the physical predicate separate
// prevents the debugger interface from treating that mapping choice as the
// meaning of an `xp` address.
fn page_ddb_physical_address_readable(address: usize, count: usize) -> bool {
    return page_ddb_kernel_address_readable(address, count);
}

// GitHub issue #353: per-page storage whose MEANING belongs to whoever
// currently holds the page -- `struct page`'s shape -- reserved at the
// END OF THE PAGE ITSELF.
//
// kernel/lib/ pool primitives need somewhere to keep per-chunk
// bookkeeping that is not a side array sized by the number of chunks
// (issue #344's whole premise). The prototype in linux_user/ first put
// this in an array indexed by page number, and that does not survive
// here: 128 bytes per page across a large memory inventory is substantial
// reserved whether or not anything is ever pooled. In-page charges only
// the pages that are actually chunks, and this kernel's pooled types
// come to a handful. Break-even is around 115200 chunk pages -- 450 MB
// of pooled memory -- so a side array is right only where nearly every
// page is a chunk.
//
// GitHub issue #390: THE IN-PAGE RESERVATION IS GONE. PAGE_META_BYTES,
// PAGE_USABLE_BYTES, page_meta_at and page_meta_clear are deleted, and a
// page is 4096 bytes of payload again -- substantial space that
// was withheld from every consumer for one that no longer exists.
//
// It was reserved for exactly one: kernel/lib/intrusive_pool.tkb kept its
// chunk header there (#349). Issue #350 moved that header INTO the chunk,
// because a multi-page run has no per-page metadata region by construction
// (#377 made a run entirely payload precisely so no pool could read a
// kernel stack's frames as a chunk header).
//
// Two facts settled it rather than one. The first is that no code under
// kernel/ named page_meta_at, PAGE_META_BYTES or PAGE_USABLE_BYTES any
// more. The second is worse: intrusive_pool sizes a chunk as
// `pages * PAGE_SIZE` and puts its header at the chunk's far END, so for a
// one-page chunk the pool's header and this file's "reserved" region were
// LITERALLY THE SAME 128 BYTES. The reservation was not merely unused, it
// was contradicted -- and only harmlessly because nobody read this file's
// version of them.
//
// What the deleted scrub was for, and what answers it now: page_meta_clear
// zeroed those 128 bytes on every path back to the free list so a stale
// `pool_tag` could not be read out of a page a pool had finished with
// (#383, which is #373's forged-chunk-header hazard by a different
// author). That is answered one layer up and does not depend on this: a
// pool asks page_owner_tag_at -- the SIDE array (#384) -- before reading
// any chunk header at all, and a freed page reads Unowned, so a forged
// header cannot be reached to be believed. Pool slots are separately
// scrubbed on release by intrusive_pool itself (#356). Nothing here was a
// disclosure control: it only ever cleared 128 bytes of 4096.
// This file's struct-page equivalent. The occupancy bit is needed because
// page_transferred_release() and page_transferred_release_physical() accept
// plain integers after linear ownership has been intentionally erased. Add
// future per-page fields (reference counts, COW/shared flags, and similar)
// here, not as a new parallel array.
// GitHub issue #384: WHO this page was handed to.
//
// Issue #373's diagnosis started from recognizing a byte pattern -- kernel
// addresses repeating on a 16-byte stride, which had to be READ as
// `stp x29, x30` frames and therefore as a kernel stack. That guess
// happened to be right and took several rounds to confirm. With a tag the
// first question is a lookup instead: this physical page was handed to
// the kernel-stack allocator, and it is also mapped as a process's text.
//
// A `u8`, not a `usize`, and it costs nothing: PageMeta's `usize` field
// forces 8-byte alignment, so bytes 2..7 were padding already
// (`--emit-struct-layout PageMeta`), so it adds zero bytes per page.
enum PageOwnerTag: u8 {
    // A free page, or one never handed out. Never passed to page_alloc:
    // every allocation names a real owner, which is what makes a page
    // reading as Unowned while occupied a detectable invariant break
    // rather than an ordinary state.
    Unowned;
    // A metadata slot whose physical page is outside the usable DTB map.
    // It is never linked into the free list and therefore never handed out.
    Unavailable;
    // kernel/mm/address_space.tkb's L1/L2/L3 tables.
    PageTable;
    // Mapped into a process's address space: image, heap, stack, COW.
    UserPage;
    // A kernel/lib pool's chunk.
    PoolChunk;
    // A process's kernel stack run (kernel/kernel/process.tkb).
    KernelStack;
    // Runtime-sized PageMeta storage reserved from discovered RAM.
    AllocatorMetadata;
}

struct PageMeta {
    occupied: bool;
    // GitHub issue #390: `in_run` went with the metadata region. It
    // existed so page_meta_at could answer 0 for a run's pages -- a run
    // is entirely payload (#377) -- and page_meta_at was its only reader.
    // What a run's pages are FOR is still answerable, from `owner`: every
    // page of a kernel stack run carries PageOwnerTag::KernelStack.
    owner: PageOwnerTag;
    map_refcount: usize;
    next_free: usize;
    physical: usize;
}

struct PageExtent {
    start: usize;
    end: usize;
    first_index: usize;
}

// GitHub issue #253 follow-up (2026-08-09): wraps FreelistCore(N), the
// PageMeta array, and the double-free counter in one top-level struct/global
// -- exactly SlotMap(N)'s own shape, applied non-generically here since this
// file's only ever going to have one pool.
struct BootPagePool align(16) {
    core: FreelistCore(BOOTSTRAP_PAGE_COUNT);
    meta: [PageMeta; BOOTSTRAP_PAGE_COUNT];
    runtime_meta_base: usize;
    runtime_page_count: usize;
    runtime_extent_base: usize;
    runtime_extent_count: usize;
    runtime_free_head: usize;
    runtime_next_generation: usize;
    runtime_applied: bool;
    double_remove_count: usize;
    // GitHub issue #380: runs get their own identity counter. The list's
    // own next_generation belongs to popping the head, and a run is not
    // popped -- it is chosen by position and unlinked.
    run_generation: usize;
}

// GitHub issue #479. Everything below this line is shared mutable
// state reached from every page fault and every process creation, and
// until this field existed it had no lock and no assertion -- it was
// not even one of the ten sites raising KERNEL_ACTIVE_CORES reports,
// which is what made it worth finding.
//
// A Mutex, masking interrupts, rather than a TaskMutex. Not because
// the mask is needed here -- the effect checker proves the allocator
// is unreachable from interrupt context, transitively and by name
// ("interrupt function 'platform_el0_irq_dispatch' may allocate via
// ... -> page_alloc") -- but because of the NESTING.
// intrusive_pool_grow_one_chunk calls page_alloc_contiguous while
// holding the pool's own Mutex, so interrupts are already masked when
// this lock is taken from there. Taking a may_block TaskMutex under a
// mask is the shape that hangs; Mutex's acquire records "already
// masked" and its release restores what it found.
//
// The lock order is therefore POOL then PAGE, and it is one-way:
// page.tkb's only outward call is from a test probe
// (page_mapping_ref_ceiling_probe), so nothing takes page-then-pool.
//
// A separate global rather than a field of BootPagePool, and that is not a
// style choice. BootPagePool is `align(16)` and page_allocator_init runs
// with the MMU OFF; putting an 8-byte field at its front shifted every
// array behind it to 8-mod-16, and LLVM is then free to emit a 128-bit
// store at an address it may not use. This file's own kernel_mmu_init
// comment names that hazard, and RPi5 demonstrated it by booting to
// exactly zero bytes of UART while every QEMU lane stayed green.
private let mut page_allocator_lock: Mutex;
private let mut boot_page_pool: BootPagePool;
must_use variant PageIndexResult {
    NotManaged;
    Found(usize);
}

must_use variant PagePhysicalResult {
    NotManaged;
    Found(usize);
}

private fn page_capacity() -> usize {
    if (boot_page_pool.runtime_applied) {
        return boot_page_pool.runtime_page_count;
    }
    return BOOTSTRAP_PAGE_COUNT;
}

private fn page_meta_at_index(index: usize) -> *PageMeta !{unsafe} {
    if (boot_page_pool.runtime_applied) {
        return unsafe {
            (boot_page_pool.runtime_meta_base as *PageMeta) +
                (index as isize)
        };
    }
    return (boot_page_pool.meta as *PageMeta) + (index as isize);
}

private fn page_extent_at_index(index: usize) -> *PageExtent !{unsafe} {
    return unsafe {
        (boot_page_pool.runtime_extent_base as *PageExtent) +
            (index as isize)
    };
}

private fn page_region_aligned_start(region: PhysicalMemoryRegion) -> usize {
    let mut start: usize = region.base;
    if (start < usable_ram_start) { start = usable_ram_start; }
    if (start % PAGE_SIZE != 0) {
        let padding: usize = PAGE_SIZE - start % PAGE_SIZE;
        if (start > 0xFFFFFFFFFFFFFFFF - padding) {
            return 0xFFFFFFFFFFFFFFFF;
        }
        start = start + padding;
    }
    return start;
}

private fn page_region_aligned_end(region: PhysicalMemoryRegion) -> usize {
    return (region.base + region.size) -
           (region.base + region.size) % PAGE_SIZE;
}

private fn page_index_for_physical(physical: usize) -> PageIndexResult
        !{unsafe} {
    if (boot_page_pool.runtime_applied == false) {
        if (physical < usable_ram_start) {
            return PageIndexResult::NotManaged;
        }
        let offset: usize = physical - usable_ram_start;
        let index: usize = offset / PAGE_SIZE;
        if (index < BOOTSTRAP_PAGE_COUNT) {
            return PageIndexResult::Found(index);
        }
        return PageIndexResult::NotManaged;
    }
    let page_address: usize = physical - physical % PAGE_SIZE;
    let mut extent_index: usize = 0;
    while (extent_index < boot_page_pool.runtime_extent_count) {
        let extent: *PageExtent = page_extent_at_index(extent_index);
        if (page_address >= (*extent).start &&
            page_address < (*extent).end) {
            return PageIndexResult::Found(
                (*extent).first_index +
                (page_address - (*extent).start) / PAGE_SIZE);
        }
        extent_index = extent_index + 1;
    }
    return PageIndexResult::NotManaged;
}

private fn page_physical_for_index(wanted: usize) -> PagePhysicalResult
        !{unsafe} {
    if (boot_page_pool.runtime_applied == false) {
        if (wanted < BOOTSTRAP_PAGE_COUNT) {
            return PagePhysicalResult::Found(
                usable_ram_start + wanted * PAGE_SIZE);
        }
        return PagePhysicalResult::NotManaged;
    }
    if (wanted < page_capacity()) {
        let meta: *PageMeta = page_meta_at_index(wanted);
        return PagePhysicalResult::Found((*meta).physical);
    }
    return PagePhysicalResult::NotManaged;
}

private fn page_runtime_freelist_rebuild() !{unsafe} {
    let capacity: usize = page_capacity();
    boot_page_pool.runtime_free_head = capacity;
    let mut index: usize = capacity;
    while (index > 0) {
        index = index - 1;
        let meta: *PageMeta = page_meta_at_index(index);
        if ((*meta).occupied == false &&
            (*meta).owner == PageOwnerTag::Unowned) {
            (*meta).next_free = boot_page_pool.runtime_free_head;
            boot_page_pool.runtime_free_head = index;
        }
    }
}

private fn page_freelist_push(index: usize, generation: usize) !{unsafe} {
    if (boot_page_pool.runtime_applied == false) {
        freelist_core_remove(&boot_page_pool.core,
                             freelist_owner_new(index, generation));
        return;
    }
    let meta: *PageMeta = page_meta_at_index(index);
    (*meta).next_free = boot_page_pool.runtime_free_head;
    boot_page_pool.runtime_free_head = index;
}

linear struct PageOwner[page: usize] {
    private index: usize;
    private physical: usize;
    private generation: usize @ page;
}

must_use variant PageAllocResult {
    OutOfMemory;
    Allocated(exists page: usize. PageOwner[page]);
}

fn page_owner_new(index: usize, physical: usize,
                  generation: usize @ page) -> PageOwner[page] {
    let mut owner: PageOwner[page] = { index, physical, generation };
    return owner;
}

// GitHub issue #380: a run of `count` CONTIGUOUS pages, aligned to
// `count * PAGE_SIZE` when `count` is a power of two.
//
// One linear owner for the whole run rather than `count` PageOwners: the
// point of a run is that its pages are not independently disposable, and
// handing back N separate owners would say the opposite. Alignment is not
// a bonus -- it is what lets a consumer test a pointer's membership with
// one masked compare instead of a range check, which is how Linux's arm64
// kernel-stack overflow check costs a single bit test.
linear struct PageRunOwner[run: usize] {
    private first: usize;
    private physical: usize;
    private count: usize;
    private generation: usize @ run;
}

must_use variant PageRunAllocResult {
    OutOfMemory;
    Allocated(exists run: usize. PageRunOwner[run]);
}

// Reconstituting an owner after a deliberate transfer-to-address boundary is
// unsafe: the caller, not the type system, proves that the address still names
// one live run of this size and that no other owner exists.  Keep the address
// validation fallible even at that trust boundary.
must_use variant PageRunReclaimResult {
    Invalid;
    Reclaimed(exists run: usize. PageRunOwner[run]);
}

fn page_run_owner_new(first: usize, physical: usize, count: usize,
                      generation: usize @ run) -> PageRunOwner[run] {
    let mut owner: PageRunOwner[run] = {
        first, physical, count, generation
    };
    return owner;
}

fn page_run_physical_address(owner: borrow PageRunOwner[run]) -> usize {
    return owner.physical;
}

fn page_run_count(owner: borrow PageRunOwner[run]) -> usize {
    return owner.count;
}

// The run's first page index, after its linear owner has been consumed.
// The run-sized twin of page_owner_transfer_index, and for the same
// reason: a holder that keeps a run for the lifetime of the kernel has
// nothing to do with a linear value it can never give back, and a linear
// value cannot be stored in an array anyway. The pages stay occupied,
// which is exactly what the holder wants.
fn page_run_owner_transfer_index(owner: sink PageRunOwner[run])
        -> usize {
    return owner.first;
}

// Is every page of an aligned candidate run free? `first` is a multiple
// of `count`, so `first + k` cannot wrap past the pool while
// `first + count <= page_capacity()`, which the caller checks.
private fn page_run_is_free(first: usize, count: usize) -> bool {
    let capacity: usize = page_capacity();
    let mut expected_physical: usize = 0;
    for k: usize in 0..<count {
        let index: usize = first + k;
        if (index >= capacity) { return false; }
        let meta: *PageMeta = page_meta_at_index(index);
        if ((*meta).owner == PageOwnerTag::Unavailable ||
            (*meta).occupied) { return false; }
        match page_physical_for_index(index) {
            PagePhysicalResult::NotManaged => { return false; }
            PagePhysicalResult::Found(physical) => {
                if (k != 0 && physical != expected_physical) {
                    return false;
                }
                expected_physical = physical + PAGE_SIZE;
            }
        }
    }
    return true;
}

// Scans for the first aligned run of free pages, marks it occupied, and
// takes those pages off the free list in one pass.
//
// A linear scan rather than a buddy allocator, deliberately: #350's own
// non-goals rule out a general buddy unless it turns out to be the
// smaller change, and the caller today is process creation -- rare, and
// already doing far more expensive work.
// GitHub issue #479: one acquire for the whole run search and claim. A run
// is only contiguous if nothing takes a page out of the middle of it
// between the scan and the claim.
fn page_alloc_contiguous(count: usize, owner: PageOwnerTag)
        -> PageRunAllocResult !{allocates, requires_mmu, unsafe} {
    let flags: usize = page_lock();
    let result: PageRunAllocResult =
        page_alloc_contiguous_locked(count, owner);
    page_unlock(flags);
    return result;
}

private fn page_alloc_contiguous_locked(count: usize, owner: PageOwnerTag)
        -> PageRunAllocResult !{allocates, requires_mmu, unsafe} {
    if (count < 1) { return PageRunAllocResult::OutOfMemory; }
    if (owner == PageOwnerTag::Unowned ||
        owner == PageOwnerTag::Unavailable) {
        return PageRunAllocResult::OutOfMemory;
    }
    let alignment: usize = match checked_mul_usize(count, PAGE_SIZE) {
        CheckedUsize::Overflow => { return PageRunAllocResult::OutOfMemory; }
        CheckedUsize::Value(value) => { value }
    };
    if (alignment < 1) { return PageRunAllocResult::OutOfMemory; }
    // The alignment that matters is the ADDRESS's, and page INDEX zero is
    // not at an aligned address: both linker scripts only promise
    // `ALIGN(4096)` for usable_ram_start, and on QEMU it lands at
    // 0x40903000 -- page-aligned and not 16K-aligned. Choosing candidates
    // at multiples of `count` therefore produces runs that are contiguous
    // and NOT aligned, which is the half of this that consumers actually
    // need. Skew the choice by where the pool itself starts.
    let capacity: usize = page_capacity();
    let mut candidate: usize = 0;
    while (candidate < capacity) {
        let physical_result: PagePhysicalResult =
            page_physical_for_index(candidate);
        let mut physical: usize = 0;
        let mut physical_found: bool = false;
        match physical_result {
            PagePhysicalResult::NotManaged => {}
            PagePhysicalResult::Found(found) => {
                physical = found;
                physical_found = true;
            }
        }
        let mut candidate_aligned: bool = false;
        if (physical_found && alignment != 0) {
            candidate_aligned = physical % alignment == 0;
        }
        if (candidate_aligned && count <= capacity - candidate &&
            page_run_is_free(candidate, count)) {
            for k: usize in 0..<count {
                let index: usize = candidate + k;
                if (index < capacity) {
                    let meta: *PageMeta = page_meta_at_index(index);
                    (*meta).occupied = true;
                    (*meta).owner = owner;
                    (*meta).map_refcount = 0;
                }
            }
            let mut unlinked: usize = count;
            if (boot_page_pool.runtime_applied) {
                page_runtime_freelist_rebuild();
            } else {
                unlinked = freelist_core_unlink_range(
                    &boot_page_pool.core, candidate, count);
            }
            if (unlinked != count) {
                // The scan said every page was free and the list says
                // otherwise: an invariant break, not a resource limit.
                //
                // QUARANTINE rather than hand the run out or try to undo
                // it. `count - unlinked` pages are now occupied AND still
                // on the free list, and there is no way to tell WHICH --
                // so pushing them back on free would put a page on the
                // list twice, which is a page handed to two owners, which
                // is precisely the aliasing that issue #373 cost this
                // project a day of bisecting. Leaving them occupied leaks
                // at most `count` pages per event, and a leak is bounded
                // and diagnosable where a double hand-out is neither.
                //
                // Same trade kernel/lib/intrusive_pool.tkb makes for a
                // corrupt free chain (issue #352): quarantine the storage,
                // count the event, never reuse it.
                kernel_boot_log_resource_exhausted(
                    "page run (free list disagreed with occupancy; run quarantined)" as *u8,
                    count);
                return PageRunAllocResult::OutOfMemory;
            }
            let generation: usize = boot_page_pool.run_generation;
            boot_page_pool.run_generation = generation + 1;
            return PageRunAllocResult::Allocated(
                page_run_owner_new(candidate, physical, count, generation));
        }
        candidate = candidate + 1;
    }
    return PageRunAllocResult::OutOfMemory;
}

fn page_run_free(owner: sink PageRunOwner[run]) !{unsafe} {
    let flags: usize = page_lock();
    page_run_free_locked(owner);
    page_unlock(flags);
}

private fn page_run_free_locked(owner: sink PageRunOwner[run]) !{unsafe} {
    page_run_release_indices(owner.first, owner.count);
}

// Give back a run whose linear owner was consumed at allocation, named by
// its base ADDRESS and page count. The run-sized twin of
// page_transferred_release_physical, and for the same reason: a holder
// that erased the owner to keep the run in an array still has to be able
// to hand it back. `count` is the holder's, not the allocator's -- a run
// is not recorded as a unit anywhere, so a caller passing the wrong count
// releases the wrong pages, exactly as the single-page entry point trusts
// the caller's address.
fn page_run_transferred_release_physical(physical: usize, count: usize)
        !{unsafe} {
    if (physical % PAGE_SIZE != 0) {
        return;
    }
    match page_index_for_physical(physical) {
        PageIndexResult::NotManaged => {}
        PageIndexResult::Found(index) => {
            page_run_release_indices(index, count);
        }
    }
}

fn page_run_reclaim_transferred_physical(physical: usize, count: usize)
        -> PageRunReclaimResult !{unsafe} {
    if (physical % PAGE_SIZE != 0) {
        return PageRunReclaimResult::Invalid;
    }
    match page_index_for_physical(physical) {
        PageIndexResult::NotManaged => {
            return PageRunReclaimResult::Invalid;
        }
        PageIndexResult::Found(index) => {
            if (count == 0 || index >= page_capacity() ||
                count > page_capacity() - index) {
                return PageRunReclaimResult::Invalid;
            }
            return PageRunReclaimResult::Reclaimed(
                page_run_owner_new(index, physical, count, 0));
        }
    }
}

private fn page_run_release_indices(first: usize, count: usize) !{unsafe} {
    let capacity: usize = page_capacity();
    for k: usize in 0..<count {
        let index: usize = first + k;
        if (index < capacity) {
            let meta: *PageMeta = page_meta_at_index(index);
            if ((*meta).occupied == false) {
                boot_page_pool.double_remove_count =
                    boot_page_pool.double_remove_count + 1;
            } else {
                (*meta).occupied = false;
                (*meta).owner = PageOwnerTag::Unowned;
                (*meta).map_refcount = 0;
                page_freelist_push(index, 0);
            }
        }
    }
}

// GitHub issue #479. The allocator's lock is a Mutex and Mutex is not
// recursive, so the entry points below split into two layers: a public one
// that takes the lock and a private `_locked` one that does the work. Two
// of them are called both directly and from another entry point
// (page_transferred_release from page_mapping_release_physical and from
// page_transferred_release_physical), and locking those without the split
// would deadlock on the second acquire.
//
// This assertion names the OTHER number, not the core count, and that is
// the point of having two. The lock excludes a second core. What it does
// not survive is a holder losing the CPU: a preempted holder whose
// successor allocates would spin on a lock its own core holds, on one core
// or on eight. KERNEL_PREEMPTIBLE == 0 is why that cannot happen, and this
// is the site that says so.
fn page_allocator_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "a preempted holder of the page-allocator lock deadlocks its own core's next allocation");
}

private fn page_lock() -> usize !{unsafe} {
    return pool_lock_acquire(0, &page_allocator_lock);
}

private fn page_unlock(flags: usize) !{unsafe} {
    pool_lock_release(0, &page_allocator_lock, flags);
}

fn page_allocator_init() {
    // No mutex_init for page_allocator_lock: a global Mutex is free from
    // .bss (kernel/lib/mutex.tkb). Uniform with every other global lock in
    // this kernel, because a rule that holds for some of them invites the
    // next one to be initialised behind a lazy flag.
    freelist_core_init(&boot_page_pool.core);
    for i: usize in 0..<BOOTSTRAP_PAGE_COUNT {
        boot_page_pool.meta[i].occupied = false;
        boot_page_pool.meta[i].owner = PageOwnerTag::Unowned;
        boot_page_pool.meta[i].map_refcount = 0;
        boot_page_pool.meta[i].next_free = i + 1;
        boot_page_pool.meta[i].physical =
            usable_ram_start + i * PAGE_SIZE;
    }
    boot_page_pool.runtime_meta_base = 0;
    boot_page_pool.runtime_page_count = 0;
    boot_page_pool.runtime_extent_base = 0;
    boot_page_pool.runtime_extent_count = 0;
    boot_page_pool.runtime_free_head = 0;
    boot_page_pool.runtime_next_generation = 1;
    boot_page_pool.runtime_applied = false;
    boot_page_pool.double_remove_count = 0;
    boot_page_pool.run_generation = 1;
}

must_use variant PageAllocatorMemoryResult {
    Invalid;
    Applied;
}

fn page_allocator_apply_memory(memory: FdtMemoryMap)
        -> PageAllocatorMemoryResult !{unsafe} {
    let region_count: usize = fdt_memory_region_count(memory);
    let mut total_pages: usize = 0;
    let mut region_index: usize = 0;
    while (region_index < region_count) {
        match fdt_memory_region_at(memory, region_index) {
            FdtMemoryRegionResult::Invalid => {
                return PageAllocatorMemoryResult::Invalid;
            }
            FdtMemoryRegionResult::OutOfRange => {
                return PageAllocatorMemoryResult::Invalid;
            }
            FdtMemoryRegionResult::Found(region) => {
                let start: usize = page_region_aligned_start(region);
                let end: usize = page_region_aligned_end(region);
                if (start < end) {
                    let pages: usize = (end - start) / PAGE_SIZE;
                    if (total_pages > 0xFFFFFFFFFFFFFFFF - pages) {
                        return PageAllocatorMemoryResult::Invalid;
                    }
                    total_pages = total_pages + pages;
                }
            }
        }
        region_index = region_index + 1;
    }
    if (total_pages == 0 ||
        total_pages > 0xFFFFFFFFFFFFFFFF / sizeof(PageMeta)) {
        return PageAllocatorMemoryResult::Invalid;
    }

    let metadata_bytes: usize = total_pages * sizeof(PageMeta);
    if (region_count > 0xFFFFFFFFFFFFFFFF / sizeof(PageExtent)) {
        return PageAllocatorMemoryResult::Invalid;
    }
    let extent_bytes: usize = region_count * sizeof(PageExtent);
    if (metadata_bytes > 0xFFFFFFFFFFFFFFFF - extent_bytes) {
        return PageAllocatorMemoryResult::Invalid;
    }
    let metadata_payload_bytes: usize = metadata_bytes + extent_bytes;
    if (metadata_payload_bytes >
        0xFFFFFFFFFFFFFFFF - (PAGE_SIZE - 1)) {
        return PageAllocatorMemoryResult::Invalid;
    }
    let metadata_pages: usize =
        (metadata_payload_bytes + PAGE_SIZE - 1) / PAGE_SIZE;
    if (metadata_pages == 0 ||
        metadata_pages > 0xFFFFFFFFFFFFFFFF / PAGE_SIZE) {
        return PageAllocatorMemoryResult::Invalid;
    }
    let metadata_span: usize = metadata_pages * PAGE_SIZE;

    // Put the runtime-sized metadata at the high end of the first extent
    // that can hold it without overwriting the live DTB or bootstrap tables.
    let mut metadata_base: usize = 0;
    let mut metadata_found: bool = false;
    region_index = 0;
    while (region_index < region_count && metadata_found == false) {
        match fdt_memory_region_at(memory, region_index) {
            FdtMemoryRegionResult::Invalid => {
                return PageAllocatorMemoryResult::Invalid;
            }
            FdtMemoryRegionResult::OutOfRange => {
                return PageAllocatorMemoryResult::Invalid;
            }
            FdtMemoryRegionResult::Found(region) => {
                let start: usize = page_region_aligned_start(region);
                let end: usize = page_region_aligned_end(region);
                if (start < end && metadata_span <= end - start) {
                    let candidate: usize = end - metadata_span;
                    let mut overlaps_bootstrap: bool = false;
                    for i: usize in 0..<BOOTSTRAP_PAGE_COUNT {
                        if (boot_page_pool.meta[i].occupied) {
                            let address: usize =
                                usable_ram_start + i * PAGE_SIZE;
                            if (address >= candidate && address < end) {
                                overlaps_bootstrap = true;
                            }
                        }
                    }
                    if (overlaps_bootstrap == false &&
                        fdt_blob_overlaps(memory, candidate,
                                          metadata_span) == false) {
                        metadata_base = candidate;
                        metadata_found = true;
                    }
                }
            }
        }
        region_index = region_index + 1;
    }
    if (metadata_found == false) {
        return PageAllocatorMemoryResult::Invalid;
    }

    boot_page_pool.runtime_meta_base = metadata_base;
    boot_page_pool.runtime_page_count = total_pages;
    boot_page_pool.runtime_extent_base = metadata_base + metadata_bytes;
    boot_page_pool.runtime_extent_count = 0;
    boot_page_pool.runtime_free_head = total_pages;
    boot_page_pool.runtime_next_generation = 1;
    boot_page_pool.runtime_applied = true;

    let mut index: usize = 0;
    region_index = 0;
    while (region_index < region_count) {
        match fdt_memory_region_at(memory, region_index) {
            FdtMemoryRegionResult::Invalid => {
                return PageAllocatorMemoryResult::Invalid;
            }
            FdtMemoryRegionResult::OutOfRange => {
                return PageAllocatorMemoryResult::Invalid;
            }
            FdtMemoryRegionResult::Found(region) => {
                let start: usize = page_region_aligned_start(region);
                let end: usize = page_region_aligned_end(region);
                let mut physical: usize = start;
                if (start < end) {
                    let extent: *PageExtent = page_extent_at_index(
                        boot_page_pool.runtime_extent_count);
                    (*extent).start = start;
                    (*extent).end = end;
                    (*extent).first_index = index;
                    boot_page_pool.runtime_extent_count =
                        boot_page_pool.runtime_extent_count + 1;
                }
                while (physical < end) {
                    if (index >= total_pages) {
                        return PageAllocatorMemoryResult::Invalid;
                    }
                    let meta: *PageMeta = page_meta_at_index(index);
                    (*meta).occupied = false;
                    (*meta).owner = PageOwnerTag::Unowned;
                    (*meta).map_refcount = 0;
                    (*meta).next_free = total_pages;
                    (*meta).physical = physical;
                    if (fdt_blob_overlaps(memory, physical, PAGE_SIZE)) {
                        (*meta).owner = PageOwnerTag::Unavailable;
                    } else if (physical >= metadata_base &&
                               physical < metadata_base + metadata_span) {
                        (*meta).occupied = true;
                        (*meta).owner = PageOwnerTag::AllocatorMetadata;
                    }
                    index = index + 1;
                    physical = physical + PAGE_SIZE;
                }
            }
        }
        region_index = region_index + 1;
    }
    if (index != total_pages) {
        return PageAllocatorMemoryResult::Invalid;
    }

    let mut bootstrap_remaining: usize = 0;
    for i: usize in 0..<BOOTSTRAP_PAGE_COUNT {
        if (boot_page_pool.meta[i].occupied) {
            bootstrap_remaining = bootstrap_remaining + 1;
            let physical: usize = usable_ram_start + i * PAGE_SIZE;
            match page_index_for_physical(physical) {
                PageIndexResult::NotManaged => {
                    return PageAllocatorMemoryResult::Invalid;
                }
                PageIndexResult::Found(runtime_index) => {
                    let meta: *PageMeta = page_meta_at_index(runtime_index);
                    if ((*meta).owner != PageOwnerTag::Unowned) {
                        return PageAllocatorMemoryResult::Invalid;
                    }
                    (*meta).occupied = true;
                    (*meta).owner = boot_page_pool.meta[i].owner;
                    (*meta).map_refcount = boot_page_pool.meta[i].map_refcount;
                    bootstrap_remaining = bootstrap_remaining - 1;
                }
            }
        }
    }
    if (bootstrap_remaining != 0) {
        return PageAllocatorMemoryResult::Invalid;
    }
    page_runtime_freelist_rebuild();
    return PageAllocatorMemoryResult::Applied;
}

// GitHub issue #380's acceptance criteria, as a boot probe: a run is
// contiguous and aligned, its pages are genuinely withheld from
// page_alloc() while it is live, and giving it back restores the pool
// exactly.
fn page_run_probe() -> bool !{unsafe} {
    let pages_before: usize = page_allocator_live_count();
    let doubles_before: usize = page_allocator_double_free_count();
    let count: usize = 4;

    let run: exists r: usize. PageRunOwner[r] =
            match page_alloc_contiguous(count, PageOwnerTag::KernelStack) {
        PageRunAllocResult::OutOfMemory => { return false; }
        PageRunAllocResult::Allocated(owner) => { owner }
    };
    let base: usize = page_run_physical_address(run);
    // Aligned to the whole run, which is what makes a masked membership
    // test possible, and contiguous by construction of the scan.
    let aligned: bool = base % (count * PAGE_SIZE) == 0;
    let counted: bool = page_run_count(run) == count &&
                        page_allocator_live_count() == pages_before + count;
    // GitHub issue #377: no page of a live run has an owner-metadata
    // region, so the whole run is payload and no pool can read a byte of
    // it as a chunk header. Checked on EVERY page, not just the first:
    // the reservation is what a consumer's contiguity claim rests on, and
    // a run whose interior pages still answered would be exactly the
    // forged-chunk-header hazard, one page further in.
    // GitHub issue #384: the tag is the allocation's, so every page of a
    // run carries it -- a fault anywhere inside a multi-page stack has to
    // answer the same way as a fault at its base.
    let mut tagged: bool = true;
    for k: usize in 0..<count {
        if (page_owner_tag_at(base + k * PAGE_SIZE) !=
            PageOwnerTag::KernelStack) { tagged = false; }
    }
    // GitHub issue #390: the run is payload to its LAST BYTE, checked by
    // writing there rather than by asking whether a metadata region
    // exists -- there are none now, so the old question answers itself
    // and proves nothing. This one still fails if a page of a run is ever
    // reserved again: the write is at PAGE_SIZE - 8, which is inside what
    // the reservation used to claim.
    let mut payload_only: bool = true;
    for k: usize in 0..<count {
        let tail: *u8 =
            unsafe { (base + (k + 1) * PAGE_SIZE - 8) as *u8 };
        for i: isize in 0..<8 { tail[i] = 0xC3; }
    }
    for k: usize in 0..<count {
        let tail: *u8 =
            unsafe { (base + (k + 1) * PAGE_SIZE - 8) as *u8 };
        for i: isize in 0..<8 {
            if (tail[i] != 0xC3) { payload_only = false; }
        }
    }

    // Every page of the run must be withheld: allocate singles until one
    // would have to come from inside the run, and check none does. Four
    // singles is enough to catch the list handing back a page it has
    // already given away, without draining the pool.
    let mut overlap: bool = false;
    let mut singles: usize = 0;
    let mut probe_a = page_alloc(PageOwnerTag::UserPage);
    let mut probe_b = page_alloc(PageOwnerTag::UserPage);
    match probe_a {
        PageAllocResult::OutOfMemory => {}
        PageAllocResult::Allocated(owner) => {
            let at: usize = page_physical_address(owner);
            if (at >= base && at < base + count * PAGE_SIZE) { overlap = true; }
            // A single page carries its own caller's tag, not the run's.
            if (page_owner_tag_at(at) != PageOwnerTag::UserPage) {
                tagged = false;
            }
            singles = singles + 1;
            page_free(owner);
            if (page_owner_tag_at(at) != PageOwnerTag::Unowned) {
                tagged = false;
            }
        }
    }
    match probe_b {
        PageAllocResult::OutOfMemory => {}
        PageAllocResult::Allocated(owner) => {
            let at: usize = page_physical_address(owner);
            if (at >= base && at < base + count * PAGE_SIZE) { overlap = true; }
            singles = singles + 1;
            page_free(owner);
        }
    }

    page_run_free(run);
    let restored: bool =
        page_allocator_live_count() == pages_before &&
        page_allocator_double_free_count() == doubles_before;
    // ...and giving the run back restores the metadata regions, so a page
    // that was once part of a run can still become an ordinary pooled
    // chunk later.
    // ...and a freed page reports no owner, so a stale tag cannot outlive
    // the allocation that set it and mislead the next report.
    for k: usize in 0..<count {
        if (page_owner_tag_at(base + k * PAGE_SIZE) !=
            PageOwnerTag::Unowned) { tagged = false; }
    }
    // GitHub issue #390: there is no metadata region to restore or scrub
    // any more, so what stood here is gone rather than reworded. What it
    // was defending -- a stale `pool_tag` read out of a page a pool had
    // finished with -- is answered by the owner tag checked just above:
    // a freed page reads Unowned, so no pool will look at its bytes at
    // all. See this file's header for the fuller argument.
    let meta_restored: bool = true;

    // And the pool still works afterwards: a run that unlinked pages and
    // pushed them back must leave the list usable.
    let mut reusable: bool = false;
    match page_alloc_contiguous(count, PageOwnerTag::KernelStack) {
        PageRunAllocResult::OutOfMemory => {}
        PageRunAllocResult::Allocated(again) => {
            reusable = page_run_physical_address(again) % (count * PAGE_SIZE) == 0;
            page_run_free(again);
        }
    }
    return aligned && counted && tagged && payload_only && overlap == false &&
           singles == 2 && restored && meta_restored && reusable &&
           page_allocator_live_count() == pages_before;
}

// `owner` is a required argument, not a field a caller may remember to set
// afterwards (issue #384). page_alloc cannot see its caller, and a tag that
// can be forgotten degrades to Unowned exactly where a new subsystem is
// least understood -- which is when the tag is worth the most. Making it a
// parameter puts the question to the compiler instead.
// GitHub issue #479: ONE acquire covers the pop AND the three meta writes
// that follow it. That sequence is the reason the lock is here rather than
// inside freelist_core_insert -- a lock around the pop alone would hand two
// cores different indices and then let them interleave the metadata for
// them, which the free-list probe cannot see and a page-owner audit would.
// The bootstrap entry point, for the window before the MMU is on.
//
// It does NOT take the lock, and cannot: with the MMU off every access is
// Device-typed, and AArch64 does not support exclusives there -- which is
// what the lock is built from. Real hardware faults; QEMU does not enforce
// it, so this was found as a board that produced no output at all while
// every QEMU lane stayed green.
//
// Not taking it is also correct rather than merely forced. This runs from
// kernel_mmu_init, before main(), before PSCI has been asked to start
// anything: there is one context in the machine and no second core exists
// to exclude. The lock would have nothing to do.
//
// What keeps the two apart is not this comment. spin_lock is
// `!{requires_mmu}` and kernel_mmu_init is `!{mmu_off}`, so reaching the
// locked entry point from the boot window is a compile error naming the
// whole path -- which is how this bug was converted from a silent
// hardware-only failure into a build failure.
fn page_alloc_boot(owner: PageOwnerTag) -> PageAllocResult
        !{allocates, mmu_off} {
    if (owner == PageOwnerTag::Unowned ||
        owner == PageOwnerTag::Unavailable) {
        return PageAllocResult::OutOfMemory;
    }
    return page_alloc_locked(owner);
}

fn page_free_boot(owner: sink PageOwner[page]) !{mmu_off, unsafe} {
    page_free_locked(owner);
}

fn page_alloc(owner: PageOwnerTag) -> PageAllocResult !{allocates} {
    if (owner == PageOwnerTag::Unowned ||
        owner == PageOwnerTag::Unavailable) {
        return PageAllocResult::OutOfMemory;
    }
    let flags: usize = page_lock();
    let result: PageAllocResult = page_alloc_locked(owner);
    page_unlock(flags);
    return result;
}

private fn page_alloc_locked(owner: PageOwnerTag) -> PageAllocResult
        !{allocates} {
    if (boot_page_pool.runtime_applied == false) {
        match freelist_core_insert(&boot_page_pool.core) {
            FreelistPopResult::Empty => {
                return PageAllocResult::OutOfMemory;
            }
            FreelistPopResult::Popped(slot) => {
                let (index, generation) = freelist_owner_into_parts(slot);
                if (index < BOOTSTRAP_PAGE_COUNT) {
                    boot_page_pool.meta[index].occupied = true;
                    boot_page_pool.meta[index].owner = owner;
                    boot_page_pool.meta[index].map_refcount = 0;
                    return PageAllocResult::Allocated(page_owner_new(
                        index, usable_ram_start + index * PAGE_SIZE,
                        generation));
                }
                return PageAllocResult::OutOfMemory;
            }
        }
    }
    let index: usize = boot_page_pool.runtime_free_head;
    if (index >= page_capacity()) { return PageAllocResult::OutOfMemory; }
    let meta: *PageMeta = page_meta_at_index(index);
    boot_page_pool.runtime_free_head = (*meta).next_free;
    let generation: usize = boot_page_pool.runtime_next_generation;
    boot_page_pool.runtime_next_generation = generation + 1;
    (*meta).occupied = true;
    (*meta).owner = owner;
    (*meta).map_refcount = 0;
    match page_physical_for_index(index) {
        PagePhysicalResult::NotManaged => {
            return PageAllocResult::OutOfMemory;
        }
        PagePhysicalResult::Found(physical) => {
            return PageAllocResult::Allocated(
                page_owner_new(index, physical, generation));
        }
    }
}

// Releasing a slot that is ALREADY free is a double free -- same reasoning
// as kernel/lib/slotmap.tkb's own slotmap_remove (this function's direct
// ancestor): a free list is not idempotent, so this counts the event at
// its source instead of silently corrupting the chain a second time.
fn page_free(owner: sink PageOwner[page]) !{unsafe} {
    let flags: usize = page_lock();
    page_free_locked(owner);
    page_unlock(flags);
}

private fn page_free_locked(owner: sink PageOwner[page]) !{unsafe} {
    let index: usize = owner.index;
    if (index >= page_capacity()) { return; }
    let meta: *PageMeta = page_meta_at_index(index);
    if ((*meta).occupied == false) {
        boot_page_pool.double_remove_count = boot_page_pool.double_remove_count + 1;
        return;
    }
    (*meta).occupied = false;
    (*meta).owner = PageOwnerTag::Unowned;
    (*meta).map_refcount = 0;
    page_freelist_push(index, owner.generation);
}

fn page_physical_address(owner: borrow PageOwner[page]) -> usize {
    return owner.physical;
}

fn page_identity(owner: borrow PageOwner[page]) -> usize @ page {
    return owner.generation;
}

fn page_bytes(owner: borrow PageOwner[page]) -> [u8; PAGE_SIZE..] @ page !{unsafe} {
    let address: usize = owner.physical;
    let base: *u8 = unsafe { address as *u8 };
    // Bare integer literals, not `PAGE_SIZE as isize`: Const_env.bound_value
    // (lib/const_env.ml) only folds a bare IntLit or a bare Var naming a
    // registered const, not an arbitrary expression -- a Cast node defeats
    // it, which is what made this an unrefined []u8 on the first attempt.
    // Must stay numerically equal to PAGE_SIZE (4096).
    let bytes: [u8; PAGE_SIZE..] = unsafe { base[0..<4096] };
    return bytes;
}

// Copy one page already transferred into a coarse mapping owner. The source
// physical address comes from a present user PTE and is accepted only when it
// names this allocator's pool exactly; the destination retains its PageOwner.
fn page_copy_mapped_physical(source_physical: usize,
                             destination: borrow PageOwner[page])
        -> bool !{unsafe} {
    if (source_physical % PAGE_SIZE != 0) {
        return false;
    }
    match page_index_for_physical(source_physical) {
        PageIndexResult::NotManaged => { return false; }
        PageIndexResult::Found(_source_index) => {}
    }
    let source_base: *u8 = unsafe { source_physical as *u8 };
    let source = unsafe {
        source_base[0 as isize..<PAGE_SIZE as isize]
    };
    slice_copy(page_bytes(destination), source);
    return true;
}

// Transfers per-page responsibility into a coarser linear owner such as a
// whole process image. Only such an owner may later call the paired release.
fn page_owner_transfer_index(owner: sink PageOwner[page])
        -> usize {
    return owner.index;
}

// A user PTE owns one mapping reference rather than a PageOwner. The first
// successful mapping consumes the linear allocator owner; later COW mappings
// retain by physical address after validating that this is still a mapped
// page from this allocator.
fn page_mapping_install(owner: sink PageOwner[page]) !{unsafe} {
    let flags: usize = page_lock();
    page_mapping_install_locked(owner);
    page_unlock(flags);
}

private fn page_mapping_install_locked(owner: sink PageOwner[page]) !{unsafe} {
    let index: usize = owner.index;
    let meta: *PageMeta = page_meta_at_index(index);
    (*meta).map_refcount = 1;
    page_owner_transfer_index(owner);
}

// GitHub issue #295: `occupied == false`/`current == 0` mean the caller
// asked to retain a mapping for a physical page this allocator does not
// consider live -- an internal invariant violation (a real kernel bug, if
// ever hit), not a resource limit. `current >= limit` was the ceiling and
// is an invariant break since issue #406 made the bound the number of
// address spaces that exist. Both used to collapse into one
// `bool false`, so the one caller (process_image.tkb's clone path) could
// not tell "this hit a documented ceiling" from "page metadata is
// corrupted" -- exactly the kind of misdiagnosis this issue is about, even
// though the ceiling itself is not expected to be hit by any real workload.
must_use variant PageMappingRetainResult {
    NotMapped;
    RefCeilingReached;
    Retained;
}

// GitHub issue #406: a page's mapping refcount is bounded by how many
// ADDRESS SPACES exist, because a page is mapped into an address space at
// most once. Exceeding that is not a resource limit -- it says the count no
// longer matches reality -- so it is named as an invariant break and
// counted, and the caller still refuses the operation and rolls back. A
// fail-stop is a one-line change once this has run long enough to be
// trusted.
private let mut page_mapping_ref_bound_breaks: usize = 0;

fn page_mapping_ref_bound_breaks_count() -> usize {
    return page_mapping_ref_bound_breaks;
}

// Recorded by the CALLER, not here: page_mapping_ref_ceiling_probe drives
// the same comparison deliberately, and a probe proving the boundary works
// is not the invariant breaking. Only a real mapping path can say that,
// and there is exactly one (kernel/mm/process_image.tkb's COW clone).
fn page_mapping_ref_bound_break() {
    page_mapping_ref_bound_breaks = page_mapping_ref_bound_breaks + 1;
    kernel_boot_log("page allocator: INVARIANT BREAK -- a physical page is mapped into more address spaces than exist\n");
}

// `limit` is the caller's own count of how many address spaces exist -- see
// page_mapping_ref_bound_break above, and kernel/mm/address_space.tkb's
// address_space_live_count, which is what every caller passes. Taken as a
// parameter rather than read here because how many address spaces there
// are is not this file's business, the same shape issue #401 gave
// refcount_pool_retain.
fn page_mapping_retain_physical(physical: usize, limit: usize)
        -> PageMappingRetainResult !{unsafe} {
    let flags: usize = page_lock();
    let result: PageMappingRetainResult =
        page_mapping_retain_physical_locked(physical, limit);
    page_unlock(flags);
    return result;
}

private fn page_mapping_retain_physical_locked(physical: usize, limit: usize)
        -> PageMappingRetainResult !{unsafe} {
    if (physical % PAGE_SIZE != 0) {
        return PageMappingRetainResult::NotMapped;
    }
    match page_index_for_physical(physical) {
        PageIndexResult::NotManaged => {
            return PageMappingRetainResult::NotMapped;
        }
        PageIndexResult::Found(index) => {
            let meta: *PageMeta = page_meta_at_index(index);
            let current: usize = (*meta).map_refcount;
            if ((*meta).occupied == false || current == 0) {
                return PageMappingRetainResult::NotMapped;
            }
            if (current >= limit) {
                return PageMappingRetainResult::RefCeilingReached;
            }
            (*meta).map_refcount = current + 1;
            return PageMappingRetainResult::Retained;
        }
    }
}

// GitHub issue #295 boundary test, reworked by issue #406. It used to
// place a page's refcount at and one below a fixed PAGE_MAP_REF_MAX -- written
// directly into boot_page_pool.meta, because 4.2 million real retains is
// not a boot-time probe -- and check the comparison fired at exactly the
// constant. With the bound COMPUTED from how many address spaces exist,
// the thing worth proving is that it TRACKS.
//
// Still writes the metadata directly: the point is the boundary itself,
// and placing a count just below it is the only way to reach a boundary
// without performing every mapping that would legitimately get there.
fn page_mapping_ref_ceiling_probe() -> bool !{unsafe} {
    // GitHub issue #414: this probe needs at least TWO address spaces to
    // have a below-the-ceiling case at all. With one, `bound - 1` is 0,
    // and a page with no mappings answers NotMapped rather than "one
    // below the ceiling" -- so the middle phase cannot run.
    //
    // It used to get the second one for free, from address-space backing
    // records that were never released: the count read 35 where the
    // number of live address spaces was 1. That leak is fixed, and this
    // probe now acquires the address space it depends on instead of
    // inheriting one that should not have existed. The dependency was
    // invisible while the leak paid for it, which is the argument for
    // measuring a pool against a baseline rather than trusting that
    // nothing is holding anything.
    let floor_root: usize = address_space_probe_root_acquire();
    if (floor_root == 0) { return false; }
    let bound: usize = address_space_live_count();
    if (bound < 2) {
        address_space_probe_root_release(floor_root);
        return false;
    }
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            address_space_probe_root_release(floor_root);
            return false;
        }
        PageAllocResult::Allocated(owner) => {
            let physical: usize = page_physical_address(owner);
            let index: usize = owner.index;
            let meta: *PageMeta = page_meta_at_index(index);

            // At the bound: refused, and the count is not touched.
            (*meta).map_refcount = bound;
            let mut ceiling_ok: bool = false;
            match page_mapping_retain_physical(physical, bound) {
                PageMappingRetainResult::RefCeilingReached => {
                    ceiling_ok = true;
                }
                PageMappingRetainResult::NotMapped => {}
                PageMappingRetainResult::Retained => {}
            }
            if (ceiling_ok == false ||
                    (*meta).map_refcount != bound) {
                page_free(owner);
                address_space_probe_root_release(floor_root);
                return false;
            }

            // One below: allowed, and lands exactly on the bound.
            (*meta).map_refcount = bound - 1;
            let mut below_ceiling_ok: bool = false;
            match page_mapping_retain_physical(physical, bound) {
                PageMappingRetainResult::Retained => { below_ceiling_ok = true; }
                PageMappingRetainResult::NotMapped => {}
                PageMappingRetainResult::RefCeilingReached => {}
            }
            if (below_ceiling_ok == false ||
                    (*meta).map_refcount != bound) {
                page_free(owner);
                address_space_probe_root_release(floor_root);
                return false;
            }

            // ...and one more address space means the same retain that was
            // just refused is allowed. This is the half a fixed ceiling
            // could not have: the bound moved because the world did.
            let extra: usize = address_space_probe_root_acquire();
            let grown: usize = address_space_live_count();
            let mut tracks_ok: bool =
                extra != 0 && grown == bound + 1;
            if (tracks_ok) {
                match page_mapping_retain_physical(physical, grown) {
                    PageMappingRetainResult::Retained => {}
                    PageMappingRetainResult::NotMapped => { tracks_ok = false; }
                    PageMappingRetainResult::RefCeilingReached => {
                        tracks_ok = false;
                    }
                }
            }
            address_space_probe_root_release(extra);
            address_space_probe_root_release(floor_root);

            page_free(owner);
            return tracks_ok;
        }
    }
}

fn page_mapping_refcount_physical(physical: usize) -> usize !{unsafe} {
    if (physical % PAGE_SIZE != 0) {
        return 0;
    }
    match page_index_for_physical(physical) {
        PageIndexResult::NotManaged => { return 0; }
        PageIndexResult::Found(index) => {
            let meta: *PageMeta = page_meta_at_index(index);
            if ((*meta).occupied) { return (*meta).map_refcount; }
        }
    }
    return 0;
}

fn page_mapping_release_physical(physical: usize) !{unsafe} {
    if (physical % PAGE_SIZE != 0) {
        return;
    }
    // GitHub issue #479: ONE acquire covers the refcount decrement AND the
    // release it may trigger. Locking them separately would let another
    // core see map_refcount reach 0 and free the page underneath this one.
    let flags: usize = page_lock();
    match page_index_for_physical(physical) {
        PageIndexResult::NotManaged => { page_unlock(flags); return; }
        PageIndexResult::Found(index) => {
            let meta: *PageMeta = page_meta_at_index(index);
            let current: usize = (*meta).map_refcount;
            if ((*meta).occupied == false || current == 0) {
                boot_page_pool.double_remove_count =
                    boot_page_pool.double_remove_count + 1;
                page_unlock(flags);
                return;
            }
            let next: usize = current - 1;
            (*meta).map_refcount = next;
            if (next == 0) { page_transferred_release_locked(index); }
        }
    }
    page_unlock(flags);
}

// Generation-agnostic: the double-free check below only reads the occupancy
// bit. The coarser owner that called page_owner_transfer_index only kept the
// index, so a fabricated generation is still used for the free-list link.
// GitHub issue #479: the shared body. Callers that already hold the lock
// use this; page_transferred_release below is the entry point that takes
// it. Two other entry points call THIS, which is why the split exists.
private fn page_transferred_release_locked(index: usize) !{unsafe} {
    if (index >= page_capacity()) { return; }
    let meta: *PageMeta = page_meta_at_index(index);
    if ((*meta).occupied == false) {
        boot_page_pool.double_remove_count = boot_page_pool.double_remove_count + 1;
        return;
    }
    (*meta).occupied = false;
    (*meta).owner = PageOwnerTag::Unowned;
    (*meta).map_refcount = 0;
    page_freelist_push(index, 0);
}

fn page_transferred_release(index: usize) !{unsafe} {
    let flags: usize = page_lock();
    page_transferred_release_locked(index);
    page_unlock(flags);
}

fn page_transferred_release_physical(physical: usize) !{unsafe} {
    if (physical % PAGE_SIZE != 0) {
        return;
    }
    let flags: usize = page_lock();
    match page_index_for_physical(physical) {
        PageIndexResult::NotManaged => {}
        PageIndexResult::Found(index) => {
            page_transferred_release_locked(index);
        }
    }
    page_unlock(flags);
}

// Who holds the page an arbitrary address falls in, or Unowned if the
// address is not one of this allocator's pages at all.
//
// Takes any address, not a page-aligned one: the caller of this is
// holding a faulting address or a stack pointer, and requiring it to round
// first would put the arithmetic at the call site, where getting it wrong
// is a wrong answer rather than a compile error.
fn page_owner_tag_at(address: usize) -> PageOwnerTag !{unsafe} {
    match page_index_for_physical(address) {
        PageIndexResult::NotManaged => { return PageOwnerTag::Unowned; }
        PageIndexResult::Found(index) => {
            let meta: *PageMeta = page_meta_at_index(index);
            if ((*meta).owner == PageOwnerTag::Unavailable ||
                (*meta).occupied == false) {
                return PageOwnerTag::Unowned;
            }
            return (*meta).owner;
        }
    }
}

// The tag as a phrase a fail-stop report can print. Distinguishes "not one
// of ours" from "ours and free" from "ours and occupied but tagged
// Unowned" -- the last being an invariant break, since every allocation
// names an owner, and worth saying out loud rather than rendering as the
// same word.
fn page_owner_description(address: usize) -> *u8 !{unsafe} {
    let base: usize = usable_ram_start;
    // Zero is worth its own answer rather than falling into "outside":
    // it is what an exception class with no faulting address reports, and
    // it is also what a null dereference reports, and those two readings
    // are the reader's next question.
    if (address == 0) { return "address zero" as *u8; }
    // Below the pool is the statically laid-out kernel: image sections and
    // the three linker-provided stacks. Saying so beats "not one of ours",
    // because the reader's next question ("then what IS it") has an answer
    // this file already holds half of. kernel/MEMORY_MAP.md has the other
    // half, down to which stack and which half of its run.
    if (address < base) {
        return "in the kernel image or a linker-provided stack, below usable_ram_start" as *u8;
    }
    let mut index: usize = 0;
    match page_index_for_physical(address) {
        PageIndexResult::NotManaged => {
            return "outside this allocator's pages entirely" as *u8;
        }
        PageIndexResult::Found(found) => { index = found; }
    }
    let meta: *PageMeta = page_meta_at_index(index);
    if ((*meta).owner == PageOwnerTag::Unavailable) {
        return "outside the usable DTB memory map" as *u8;
    }
    if ((*meta).occupied == false) { return "a free page" as *u8; }
    let owner: PageOwnerTag = (*meta).owner;
    if (owner == PageOwnerTag::PageTable) { return "a page table" as *u8; }
    if (owner == PageOwnerTag::UserPage) {
        return "mapped into a process address space" as *u8;
    }
    if (owner == PageOwnerTag::PoolChunk) { return "a pool chunk" as *u8; }
    if (owner == PageOwnerTag::KernelStack) {
        return "part of a kernel stack run" as *u8;
    }
    if (owner == PageOwnerTag::AllocatorMetadata) {
        return "physical page allocator metadata" as *u8;
    }
    return "occupied but UNTAGGED (invariant break)" as *u8;
}

// GitHub issue #391: the totals this allocator was built over, as
// functions rather than as the constants themselves. A consumer in
// another file (kernel/kernel/fd_table.tkb derives Linux's
// files_stat.max_files from the memory that exists) can then ask without
// depending on parse order, which a const in a refined bound would.
fn page_allocator_total_count() -> usize !{unsafe} {
    let mut available: usize = 0;
    let capacity: usize = page_capacity();
    let mut i: usize = 0;
    while (i < capacity) {
        let meta: *PageMeta = page_meta_at_index(i);
        if ((*meta).owner != PageOwnerTag::Unavailable) {
            available = available + 1;
        }
        i = i + 1;
    }
    return available;
}

fn page_allocator_page_bytes() -> usize {
    return PAGE_SIZE;
}

fn page_allocator_live_count() -> usize !{unsafe} {
    let mut live: usize = 0;
    let capacity: usize = page_capacity();
    let mut i: usize = 0;
    while (i < capacity) {
        let meta: *PageMeta = page_meta_at_index(i);
        if ((*meta).occupied) { live = live + 1; }
        i = i + 1;
    }
    return live;
}

// Number of times a page was released that was already free. Must stay 0:
// the old scan-based allocator made such a double free silently
// idempotent, so this was the first place kernel/ could observe one at
// all (see kernel/lib/freelist.tkb's own header for why a free list is
// not idempotent the way that scan was).
fn page_allocator_double_free_count() -> usize {
    return boot_page_pool.double_remove_count;
}
