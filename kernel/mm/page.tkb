// Bootstrap page allocator, backed by real physical RAM directly (GitHub
// issue #251) rather than a kernel-owned shadow byte array. The previous
// design's `boot_pages: [u8; PAGE_SIZE * BOOT_PAGE_COUNT]` duplicated every
// managed page's CONTENT inside the kernel's own .bss -- unlike Linux's
// `struct page`/`mem_map` or NetBSD's `vm_page`, which are pure metadata
// (tens of bytes per page) addressing real physical RAM directly, not a
// second, kernel-owned copy of it. That made BOOT_PAGE_COUNT's true cost
// PAGE_SIZE (4096) bytes per page, capping any real-RAM-sized value well
// below what real hardware has. Real pages now live at `usable_ram_start`
// (kernel/arch/arm64/boot/link.ld's own symbol for the first PAGE_SIZE-
// aligned physical address past every other statically-laid-out kernel
// region) plus `index * PAGE_SIZE`, accessed directly -- the only
// remaining BOOT_PAGE_COUNT-sized cost is metadata (this file's own
// PageMeta below, as of GitHub issue #253), on the order of tens of
// bytes per page, not 4096. See HISTORY.md's 2026-08-08 issue #251 entry
// for the real-kernel comparison this was modeled on, and its 2026-08-09
// issue #253 entry for PageMeta's own design.
//
// `page_bytes()` (and everything reached through it) now needs `!{unsafe}`
// as an honest consequence: proving a slice is in-bounds without a runtime
// check requires the compiler to see a real, compile-time-sized backing
// array, which real physical RAM accessed via a linker symbol is not --
// same tradeoff HISTORY.md's 2026-07-28 "Unsafe memory reasoning becomes
// an auditable effect" entry already established elsewhere in this
// kernel. `page_physical_address`/`page_transferred_release_physical`
// stay effect-free: pure address arithmetic and comparison, no
// dereference.
//
// This RPi5 unit's own real detected RAM is ~1020 MiB (HISTORY.md's
// 2026-08-08 issue #247 entry) -- BOOT_PAGE_COUNT is chosen with generous
// headroom below that, not maxed out, since this is the first hardware
// verification of this redesign.
//
// Slot allocation itself (issue #207, the most acute of that issue's five
// call sites: a 1024-entry scan on every single page allocation) is O(1)
// via kernel/lib/freelist.tkb's FreelistCore(N), not a hand-rolled scan.
//
// GitHub issue #253 (2026-08-09): this file used kernel/lib/slotmap.tkb's
// SlotMap(N) wrapper until then, but its per-slot generation array was
// wasteful here. FreelistCore(N) is the right primitive for this large pool;
// page-specific metadata belongs in PageMeta rather than in a generic pool
// wrapper shared with unrelated owners.
//
// GitHub issue #256 (2026-08-10): PageOwner's generation remains necessary
// as the linear owner's type witness and as the FreelistOwner identity.
// PageMeta does not need to retain that value: the only metadata operation
// is distinguishing occupied from free so integer-based release paths can
// detect a double release. Keeping that state as a bool preserves the
// diagnostic invariant while removing 7 bytes/page of avoidable metadata.
use "kernel/lib/freelist.tkb";

const PAGE_SIZE: usize = 4096;
// At most ADDRESS_SPACE_MAX (16) roots can each hold every page in the
// 262144-page user window. This is the real upper bound for one physical
// page's user mappings, so retain rejects overflow instead of wrapping.
const PAGE_MAP_REF_MAX: usize = 4194304;
// 204800 pages * 4096 bytes = 800 MiB of real physical page content,
// starting at usable_ram_start -- comfortably under this board's ~1020 MiB
// real total even after adding usable_ram_start's own offset (kernel
// image plus this file's and process_image.tkb's now-much-smaller
// metadata arrays) and a real hardware safety margin.
const BOOT_PAGE_COUNT: usize = 204800;

extern symbol usable_ram_start;

// GitHub issue #353: per-page storage whose MEANING belongs to whoever
// currently holds the page -- `struct page`'s shape -- reserved at the
// END OF THE PAGE ITSELF.
//
// kernel/lib/ pool primitives need somewhere to keep per-chunk
// bookkeeping that is not a side array sized by the number of chunks
// (issue #344's whole premise). The prototype in linux_user/ first put
// this in an array indexed by page number, and that does not survive
// here: 128 bytes per page across BOOT_PAGE_COUNT is 25 MB of BSS
// reserved whether or not anything is ever pooled. In-page charges only
// the pages that are actually chunks, and this kernel's pooled types
// come to a handful. Break-even is around 115200 chunk pages -- 450 MB
// of pooled memory -- so a side array is right only where nearly every
// page is a chunk.
//
// The cost of in-page is that an owner loses PAGE_META_BYTES of every
// page it holds, so a payload whose stride divides the page loses a
// whole slot rather than a fraction of one. At the sizes this kernel
// pools (ProcessRecord 96, TcpConnectionStore 32, ...) that is about 3%.
//
// Nothing in PageMeta changes: an owner asks page_meta_at where its
// metadata is, which is arithmetic, and reads its own tag from there,
// which is one load. That is exactly what this issue asked for, and it
// costs no bytes at all.
const PAGE_META_BYTES: usize = 128;

// What an owner may use for its own data. The metadata sits above it.
const PAGE_USABLE_BYTES: usize = PAGE_SIZE - PAGE_META_BYTES;

// The address of this page's owner metadata, or 0 if `physical` is not
// one of this allocator's page-aligned pages.
//
// Returning 0 rather than trapping is what lets a consumer use this as
// its own validation step on an address of unknown provenance: the range
// check here dereferences nothing, so a caller that gets 0 knows the
// address is not one of ours without ever having touched it. The read
// that follows is then at a computed offset into a page this allocator
// has already confirmed it owns -- not through an address the caller
// supplied, which is the distinction that makes the in-page placement as
// safe as a side array would have been.
fn page_meta_at(physical: usize) -> usize {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return 0;
    }
    return physical + PAGE_USABLE_BYTES;
}

// Clears one page's owner metadata. The allocator owns this storage, so
// it is the allocator that must not leave a freed page describing itself
// as something an owner still holds -- a pool's "is this chunk mine?"
// test is exactly a read of that region.
private fn page_meta_clear(physical: usize) !{unsafe} {
    let meta: usize = page_meta_at(physical);
    if (meta == 0) { return; }
    let bytes: *u8 = unsafe { meta as *u8 };
    let count: isize = PAGE_META_BYTES as isize;
    for i: isize in 0..<count {
        bytes[i] = 0;
    }
}

// This file's struct-page equivalent. The occupancy bit is needed because
// page_transferred_release() and page_transferred_release_physical() accept
// plain integers after linear ownership has been intentionally erased. Add
// future per-page fields (reference counts, COW/shared flags, and similar)
// here, not as a new parallel array.
struct PageMeta {
    occupied: bool;
    map_refcount: usize;
}

// GitHub issue #253 follow-up (2026-08-09): wraps FreelistCore(N), the
// PageMeta array, and the double-free counter in one top-level struct/global
// -- exactly SlotMap(N)'s own shape, applied non-generically here since this
// file's only ever going to have one pool.
struct BootPagePool {
    core: FreelistCore(BOOT_PAGE_COUNT);
    meta: [PageMeta; BOOT_PAGE_COUNT];
    double_remove_count: usize;
}

private let mut boot_page_pool: BootPagePool;

linear struct PageOwner[page: usize] {
    private index: {0..<BOOT_PAGE_COUNT as usize};
    private generation: usize @ page;
}

must_use variant PageAllocResult {
    OutOfMemory;
    Allocated(exists page: usize. PageOwner[page]);
}

fn page_owner_new(index: {0..<BOOT_PAGE_COUNT as usize},
                  generation: usize @ page) -> PageOwner[page] {
    let mut owner: PageOwner[page] = { index, generation };
    return owner;
}

fn page_allocator_init() {
    // GitHub issue #259 (2026-08-16): a nested-field address
    // (&boot_page_pool.core) now infers the generic call's N directly, no
    // intermediate binding needed.
    freelist_core_init(&boot_page_pool.core);
    // GitHub issue #217 (2026-08-15): boot_page_pool.meta[i] indexes the
    // struct-embedded array field directly and is checked/proven by the
    // for-loop counter's own {0..<BOOT_PAGE_COUNT} type -- no more
    // manual `let`/raw-pointer-arithmetic workaround (issue #15) needed.
    for i: usize in 0..<BOOT_PAGE_COUNT {
        boot_page_pool.meta[i].occupied = false;
        boot_page_pool.meta[i].map_refcount = 0;
    }
    boot_page_pool.double_remove_count = 0;
}

fn page_alloc() -> PageAllocResult {
    match freelist_core_insert(&boot_page_pool.core) {
        FreelistPopResult::Empty => { return PageAllocResult::OutOfMemory; }
        FreelistPopResult::Popped(slot) => {
            let (index, generation) = freelist_owner_into_parts(slot);
            if (index < BOOT_PAGE_COUNT) {
                let checked: {0..<BOOT_PAGE_COUNT as usize} = index;
                // GitHub issue #217: checked indexing, see page_allocator_init's own comment.
                boot_page_pool.meta[checked].occupied = true;
                boot_page_pool.meta[checked].map_refcount = 0;
                return PageAllocResult::Allocated(
                    page_owner_new(checked, generation));
            }
            return PageAllocResult::OutOfMemory;
        }
    }
}

// Releasing a slot that is ALREADY free is a double free -- same reasoning
// as kernel/lib/slotmap.tkb's own slotmap_remove (this function's direct
// ancestor): a free list is not idempotent, so this counts the event at
// its source instead of silently corrupting the chain a second time.
fn page_free(owner: sink PageOwner[page]) {
    let index: {0..<BOOT_PAGE_COUNT as usize} = owner.index;
    // GitHub issue #217: checked indexing, see page_allocator_init's own comment.
    if (boot_page_pool.meta[index].occupied == false) {
        boot_page_pool.double_remove_count = boot_page_pool.double_remove_count + 1;
        freelist_owner_drop(freelist_owner_new(index, owner.generation));
        return;
    }
    boot_page_pool.meta[index].occupied = false;
    boot_page_pool.meta[index].map_refcount = 0;
    freelist_core_remove(&boot_page_pool.core,
                         freelist_owner_new(index, owner.generation));
}

fn page_physical_address(owner: borrow PageOwner[page]) -> usize {
    let base: usize = usable_ram_start;
    return base + owner.index * PAGE_SIZE;
}

fn page_identity(owner: borrow PageOwner[page]) -> usize @ page {
    return owner.generation;
}

fn page_owner_into_parts(owner: sink PageOwner[page])
        -> ({0..<BOOT_PAGE_COUNT as usize}, usize @ page) {
    return (owner.index, owner.generation);
}

fn page_owner_from_parts(index: {0..<BOOT_PAGE_COUNT as usize},
                         generation: usize @ page) -> PageOwner[page] {
    return page_owner_new(index, generation);
}

fn page_bytes(owner: borrow PageOwner[page]) -> [u8; PAGE_SIZE..] @ page !{unsafe} {
    let address: usize = usable_ram_start + owner.index * PAGE_SIZE;
    let base: *u8 = unsafe { address as *u8 };
    // Bare integer literals, not `PAGE_SIZE as isize`: Const_env.bound_value
    // (lib/const_env.ml) only folds a bare IntLit or a bare Var naming a
    // registered const, not an arbitrary expression -- a Cast node defeats
    // it, which is what made this an unrefined []u8 on the first attempt.
    // Must stay numerically equal to PAGE_SIZE (4096).
    let bytes: [u8; PAGE_SIZE..] = unsafe { base[0..<4096] };
    return bytes;
}

// Copy one page already transferred into a coarse mapping owner. The source
// physical address comes from a present user PTE and is accepted only when it
// names this allocator's pool exactly; the destination retains its PageOwner.
fn page_copy_mapped_physical(source_physical: usize,
                             destination: borrow PageOwner[page])
        -> bool !{unsafe} {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (source_physical < base || source_physical >= base + pool_bytes ||
        (source_physical - base) % PAGE_SIZE != 0) {
        return false;
    }
    let source_offset: usize = source_physical - base;
    if (source_offset > pool_bytes - PAGE_SIZE) { return false; }
    let source_base: *u8 = unsafe { source_physical as *u8 };
    let source = unsafe {
        source_base[0 as isize..<PAGE_SIZE as isize]
    };
    slice_copy(page_bytes(destination), source);
    return true;
}

// Transfers per-page responsibility into a coarser linear owner such as a
// whole process image. Only such an owner may later call the paired release.
fn page_owner_transfer_index(owner: sink PageOwner[page])
        -> {0..<BOOT_PAGE_COUNT as usize} {
    return owner.index;
}

// A user PTE owns one mapping reference rather than a PageOwner. The first
// successful mapping consumes the linear allocator owner; later COW mappings
// retain by physical address after validating that this is still a mapped
// page from this allocator.
fn page_mapping_install(owner: sink PageOwner[page]) {
    let index: {0..<BOOT_PAGE_COUNT as usize} = owner.index;
    boot_page_pool.meta[index].map_refcount = 1;  // GitHub issue #217: checked indexing
    page_owner_transfer_index(owner);
}

// GitHub issue #295: `occupied == false`/`current == 0` mean the caller
// asked to retain a mapping for a physical page this allocator does not
// consider live -- an internal invariant violation (a real kernel bug, if
// ever hit), not a resource limit. `current >= PAGE_MAP_REF_MAX` is the
// actual ceiling (ADDRESS_SPACE_MAX * USER_SPACE_PAGE_COUNT, practically
// unreachable by any real fork/COW fan-out). Both used to collapse into one
// `bool false`, so the one caller (process_image.tkb's clone path) could
// not tell "this hit a documented ceiling" from "page metadata is
// corrupted" -- exactly the kind of misdiagnosis this issue is about, even
// though the ceiling itself is not expected to be hit by any real workload.
must_use variant PageMappingRetainResult {
    NotMapped;
    RefCeilingReached;
    Retained;
}

fn page_mapping_retain_physical(physical: usize) -> PageMappingRetainResult {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return PageMappingRetainResult::NotMapped;
    }
    let index: usize = (physical - base) / PAGE_SIZE;
    if (index < BOOT_PAGE_COUNT) {
        let checked: {0..<BOOT_PAGE_COUNT as usize} = index;
        // GitHub issue #217: checked indexing, see page_allocator_init's own comment.
        let current: usize = boot_page_pool.meta[checked].map_refcount;
        if (boot_page_pool.meta[checked].occupied == false || current == 0) {
            return PageMappingRetainResult::NotMapped;
        }
        if (current >= PAGE_MAP_REF_MAX) {
            return PageMappingRetainResult::RefCeilingReached;
        }
        boot_page_pool.meta[checked].map_refcount = current + 1;
        return PageMappingRetainResult::Retained;
    }
    return PageMappingRetainResult::NotMapped;
}

// GitHub issue #295 boundary test: PAGE_MAP_REF_MAX (4194304) is too large
// to reach by actually looping page_mapping_retain_physical that many
// times in a boot-time probe, but the issue's own design constraints still
// require a reviewed-and-kept static bound's "limit and exhaustion
// behavior" to be "explicit and covered by tests." Since this probe lives
// in the same file as the pool, it writes boot_page_pool.meta's own
// map_refcount field directly to place a real, allocator-owned page one
// below and exactly at the ceiling, proving the boundary check itself
// (not the increment loop, which the SHARED_OBJECT_MAX_REFS-equivalent
// probe already exercises via genuine repeated retains) fires at exactly
// PAGE_MAP_REF_MAX and not one off in either direction.
fn page_mapping_ref_ceiling_probe() -> bool {
    match page_alloc() {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(owner) => {
            let physical: usize = page_physical_address(owner);
            let index: {0..<BOOT_PAGE_COUNT as usize} = owner.index;
            // GitHub issue #217: checked indexing, see page_allocator_init's own comment.

            boot_page_pool.meta[index].map_refcount = PAGE_MAP_REF_MAX;
            let mut ceiling_ok: bool = false;
            match page_mapping_retain_physical(physical) {
                PageMappingRetainResult::RefCeilingReached => {
                    ceiling_ok = true;
                }
                PageMappingRetainResult::NotMapped => {}
                PageMappingRetainResult::Retained => {}
            }
            if (ceiling_ok == false ||
                    boot_page_pool.meta[index].map_refcount != PAGE_MAP_REF_MAX) {
                page_free(owner);
                return false;
            }

            boot_page_pool.meta[index].map_refcount = PAGE_MAP_REF_MAX - 1;
            let mut below_ceiling_ok: bool = false;
            match page_mapping_retain_physical(physical) {
                PageMappingRetainResult::Retained => { below_ceiling_ok = true; }
                PageMappingRetainResult::NotMapped => {}
                PageMappingRetainResult::RefCeilingReached => {}
            }
            if (below_ceiling_ok == false ||
                    boot_page_pool.meta[index].map_refcount != PAGE_MAP_REF_MAX) {
                page_free(owner);
                return false;
            }

            page_free(owner);
            return true;
        }
    }
}

fn page_mapping_refcount_physical(physical: usize) -> usize {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return 0;
    }
    let index: usize = (physical - base) / PAGE_SIZE;
    if (index < BOOT_PAGE_COUNT) {
        let checked: {0..<BOOT_PAGE_COUNT as usize} = index;
        // GitHub issue #217: checked indexing, see page_allocator_init's own comment.
        if (boot_page_pool.meta[checked].occupied) {
            return boot_page_pool.meta[checked].map_refcount;
        }
    }
    return 0;
}

fn page_mapping_release_physical(physical: usize) {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return;
    }
    let index: usize = (physical - base) / PAGE_SIZE;
    if (index < BOOT_PAGE_COUNT) {
        let checked: {0..<BOOT_PAGE_COUNT as usize} = index;
        // GitHub issue #217: checked indexing, see page_allocator_init's own comment.
        let current: usize = boot_page_pool.meta[checked].map_refcount;
        if (boot_page_pool.meta[checked].occupied == false || current == 0) {
            boot_page_pool.double_remove_count =
                boot_page_pool.double_remove_count + 1;
            return;
        }
        let next: usize = current - 1;
        boot_page_pool.meta[checked].map_refcount = next;
        if (next == 0) {
            page_transferred_release(checked);
        }
    }
}

// Generation-agnostic: the double-free check below only reads the occupancy
// bit. The coarser owner that called page_owner_transfer_index only kept the
// index, so a fabricated generation is still used for the free-list link.
fn page_transferred_release(index: {0..<BOOT_PAGE_COUNT as usize}) {
    // GitHub issue #217: checked indexing, see page_allocator_init's own comment.
    if (boot_page_pool.meta[index].occupied == false) {
        boot_page_pool.double_remove_count = boot_page_pool.double_remove_count + 1;
        freelist_owner_drop(freelist_owner_new(index, 0));
        return;
    }
    boot_page_pool.meta[index].occupied = false;
    boot_page_pool.meta[index].map_refcount = 0;
    freelist_core_remove(&boot_page_pool.core, freelist_owner_new(index, 0));
}

fn page_transferred_release_physical(physical: usize) !{unsafe} {
    // Owner metadata is scoped to the current owner (issue #353), so it
    // goes back to zero before the page does. Without this, the next
    // owner of this page would inherit a region still claiming to belong
    // to the last one.
    page_meta_clear(physical);
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return;
    }
    let index: usize = (physical - base) / PAGE_SIZE;
    if (index < BOOT_PAGE_COUNT) {
        let checked: {0..<BOOT_PAGE_COUNT as usize} = index;
        page_transferred_release(checked);
    }
}

fn page_allocator_live_count() -> usize {
    let mut live: usize = 0;
    for i: usize in 0..<BOOT_PAGE_COUNT {  // GitHub issue #217: checked indexing
        if (boot_page_pool.meta[i].occupied) { live = live + 1; }
    }
    return live;
}

// Number of times a page was released that was already free. Must stay 0:
// the old scan-based allocator made such a double free silently
// idempotent, so this was the first place kernel/ could observe one at
// all (see kernel/lib/freelist.tkb's own header for why a free list is
// not idempotent the way that scan was).
fn page_allocator_double_free_count() -> usize {
    return boot_page_pool.double_remove_count;
}
