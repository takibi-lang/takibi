// Bootstrap page allocator, backed by real physical RAM directly (GitHub
// issue #251) rather than a kernel-owned shadow byte array. The previous
// design's `boot_pages: [u8; PAGE_SIZE * BOOT_PAGE_COUNT]` duplicated every
// managed page's CONTENT inside the kernel's own .bss -- unlike Linux's
// `struct page`/`mem_map` or NetBSD's `vm_page`, which are pure metadata
// (tens of bytes per page) addressing real physical RAM directly, not a
// second, kernel-owned copy of it. That made BOOT_PAGE_COUNT's true cost
// PAGE_SIZE (4096) bytes per page, capping any real-RAM-sized value well
// below what real hardware has. Real pages now live at `usable_ram_start`
// (kernel/arch/arm64/boot/link.ld's own symbol for the first PAGE_SIZE-
// aligned physical address past every other statically-laid-out kernel
// region) plus `index * PAGE_SIZE`, accessed directly -- the only
// remaining BOOT_PAGE_COUNT-sized cost is metadata (SlotMap's own
// bookkeeping here, plus kernel/mm/process_image.tkb's two
// PROCESS_IMAGE_ROOT_MAX-scaled index arrays), on the order of a few
// hundred bytes per page, not 4096. See HISTORY.md's 2026-08-08 issue
// #251 entry for the real-kernel comparison this was modeled on.
//
// `page_bytes()` (and everything reached through it) now needs `!{unsafe}`
// as an honest consequence: proving a slice is in-bounds without a runtime
// check requires the compiler to see a real, compile-time-sized backing
// array, which real physical RAM accessed via a linker symbol is not --
// same tradeoff HISTORY.md's 2026-07-28 "Unsafe memory reasoning becomes
// an auditable effect" entry already established elsewhere in this
// kernel. `page_physical_address`/`page_transferred_release_physical`
// stay effect-free: pure address arithmetic and comparison, no
// dereference.
//
// This RPi5 unit's own real detected RAM is ~1020 MiB (HISTORY.md's
// 2026-08-08 issue #247 entry) -- BOOT_PAGE_COUNT is chosen with generous
// headroom below that, not maxed out, since this is the first hardware
// verification of this redesign.
//
// Slot allocation itself (issue #207, the most acute of that issue's five
// call sites: a 1024-entry scan on every single page allocation) is O(1)
// via kernel/lib/slotmap.tkb's SlotMap(N), not a hand-rolled scan -- see
// that file's header for the design (SlotMap is the recommended default
// even here, where nothing needs its generation-revalidation capability,
// for one consistent collection primitive across kernel/). PageOwner[page]
// stays this file's own public type (unchanged ABI/API for every
// downstream caller); only its internal slot bookkeeping is now delegated.
use "kernel/lib/slotmap.tkb";
use "kernel/lib/freelist.tkb";

const PAGE_SIZE: usize = 4096;
// 204800 pages * 4096 bytes = 800 MiB of real physical page content,
// starting at usable_ram_start -- comfortably under this board's ~1020 MiB
// real total even after adding usable_ram_start's own offset (kernel
// image plus this file's and process_image.tkb's now-much-smaller
// metadata arrays) and a real hardware safety margin.
const BOOT_PAGE_COUNT: usize = 204800;

extern symbol usable_ram_start;

private let mut boot_page_pool: SlotMap(BOOT_PAGE_COUNT);

linear struct PageOwner[page: usize] {
    private index: {0..<BOOT_PAGE_COUNT as usize};
    private generation: usize @ page;
}

must_use variant PageAllocResult {
    OutOfMemory;
    Allocated(exists page: usize. PageOwner[page]);
}

fn page_owner_new(index: {0..<BOOT_PAGE_COUNT as usize},
                  generation: usize @ page) -> PageOwner[page] {
    let mut owner: PageOwner[page] = { index, generation };
    return owner;
}

fn page_allocator_init() {
    slotmap_init(&boot_page_pool);
}

fn page_alloc() -> PageAllocResult {
    match slotmap_insert(&boot_page_pool) {
        FreelistPopResult::Empty => { return PageAllocResult::OutOfMemory; }
        FreelistPopResult::Popped(slot) => {
            let (index, generation) = freelist_owner_into_parts(slot);
            if (index < BOOT_PAGE_COUNT) {
                let checked: {0..<BOOT_PAGE_COUNT as usize} = index;
                return PageAllocResult::Allocated(
                    page_owner_new(checked, generation));
            }
            return PageAllocResult::OutOfMemory;
        }
    }
}

fn page_free(owner: sink PageOwner[page]) {
    slotmap_remove(&boot_page_pool,
                   freelist_owner_new(owner.index, owner.generation));
}

fn page_physical_address(owner: borrow PageOwner[page]) -> usize {
    let base: usize = usable_ram_start;
    return base + owner.index * PAGE_SIZE;
}

fn page_identity(owner: borrow PageOwner[page]) -> usize @ page {
    return owner.generation;
}

fn page_owner_into_parts(owner: sink PageOwner[page])
        -> ({0..<BOOT_PAGE_COUNT as usize}, usize @ page) {
    return (owner.index, owner.generation);
}

fn page_owner_from_parts(index: {0..<BOOT_PAGE_COUNT as usize},
                         generation: usize @ page) -> PageOwner[page] {
    return page_owner_new(index, generation);
}

fn page_bytes(owner: borrow PageOwner[page]) -> [u8; PAGE_SIZE..] @ page !{unsafe} {
    let address: usize = usable_ram_start + owner.index * PAGE_SIZE;
    let base: *u8 = address as *u8;
    // Bare integer literals, not `PAGE_SIZE as isize`: Const_env.bound_value
    // (lib/const_env.ml) only folds a bare IntLit or a bare Var naming a
    // registered const, not an arbitrary expression -- a Cast node defeats
    // it, which is what made this an unrefined []u8 on the first attempt.
    // Must stay numerically equal to PAGE_SIZE (4096).
    let bytes: [u8; PAGE_SIZE..] = unsafe { base[0..<4096] };
    return bytes;
}

// Copy one page already transferred into a coarse mapping owner. The source
// physical address comes from a present user PTE and is accepted only when it
// names this allocator's pool exactly; the destination retains its PageOwner.
fn page_copy_mapped_physical(source_physical: usize,
                             destination: borrow PageOwner[page])
        -> bool !{unsafe} {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (source_physical < base || source_physical >= base + pool_bytes ||
        (source_physical - base) % PAGE_SIZE != 0) {
        return false;
    }
    let source_offset: usize = source_physical - base;
    if (source_offset > pool_bytes - PAGE_SIZE) { return false; }
    let source_base: *u8 = source_physical as *u8;
    let source = unsafe {
        source_base[0 as isize..<PAGE_SIZE as isize]
    };
    slice_copy(page_bytes(destination), source);
    return true;
}

// Transfers per-page responsibility into a coarser linear owner such as a
// whole process image. Only such an owner may later call the paired release.
fn page_owner_transfer_index(owner: sink PageOwner[page])
        -> {0..<BOOT_PAGE_COUNT as usize} {
    return owner.index;
}

// Generation-agnostic: slotmap_remove() only reads the owner's index (see
// kernel/lib/slotmap.tkb), so a fabricated 0 is exactly as sound here as
// the real generation would be -- this matches the un-tracked-generation
// release this function has always offered (the coarser owner that called
// page_owner_transfer_index only ever kept the index, never the
// generation).
fn page_transferred_release(index: {0..<BOOT_PAGE_COUNT as usize}) {
    slotmap_remove(&boot_page_pool, freelist_owner_new(index, 0));
}

fn page_transferred_release_physical(physical: usize) {
    let base: usize = usable_ram_start;
    let pool_bytes: usize = PAGE_SIZE * BOOT_PAGE_COUNT;
    if (physical < base || physical >= base + pool_bytes ||
        (physical - base) % PAGE_SIZE != 0) {
        return;
    }
    let index: usize = (physical - base) / PAGE_SIZE;
    if (index < BOOT_PAGE_COUNT) {
        slotmap_remove(&boot_page_pool, freelist_owner_new(index, 0));
    }
}

fn page_allocator_live_count() -> usize {
    return slotmap_live_count(&boot_page_pool);
}

fn page_allocator_reclaim_all() {
    slotmap_init(&boot_page_pool);
}

// Number of times a page was released that was already free (see
// kernel/lib/slotmap.tkb's slotmap_remove). Must stay 0: the old
// scan-based allocator made such a double free silently idempotent, so
// this is the first time kernel/ can observe one at all.
fn page_allocator_double_free_count() -> usize {
    return slotmap_double_remove_count(&boot_page_pool);
}

