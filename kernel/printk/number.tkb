// Numbers on the console: how a usize becomes characters, in one place.
//
// Decimal, not hex, for the values these print: every UART-visible number in
// this kernel (syscall numbers, pids, byte counts, tick counts) is read
// against SYSCALLS.md's own decimal numbering, so hex would need a mental
// translation step every time.
//
// Its own file, and not part of kernel/printk/log.tkb's ring, because this
// needs nothing but uart_putc -- which is what lets linux_user/number
// compile this exact code host-native and check what it prints. The bug
// below was invisible for as long as it did not have a test that could run
// anywhere.
//
// What is deliberately NOT here: kernel/arch/arm64/kernel/
// exception_evidence.tkb's ddb_put_udec and ddb_put_hex. They look like
// copies of these and are not -- they write through uart_debug_putc, the
// interrupt-safe direct path a debugger uses when the ordinary log may not
// be usable. Same job, different sink, and merging them would give the
// debugger a dependency on the thing it exists to inspect.
//
// GitHub issue #470: this used to be a copy per platform, and the copies had
// drifted. QEMU's carried ten place values; RPi5's carried five, so every
// number of six digits or more printed as its low five -- 54000000 came out
// as `0`, and 843750 as `43750`. Nothing said so; a diagnostic that lies by
// truncation reads exactly like a diagnostic. That cost this issue two
// instrumented hardware boots and an investigation into a generic timer
// that turned out to be working correctly the whole time.
//
// Twenty places, so every usize prints. `uart_putc` stays per-platform
// because it is the device; how a number becomes characters is not.
private let mut kernel_decimal_places: [usize; 20] = {
    10000000000000000000, 1000000000000000000, 100000000000000000,
    10000000000000000, 1000000000000000, 100000000000000,
    10000000000000, 1000000000000, 100000000000, 10000000000,
    1000000000, 100000000, 10000000, 1000000, 100000,
    10000, 1000, 100, 10, 1
};

fn uart_put_udec(value: usize) {
    let mut leading: bool = true;
    for i: usize in 0..<20 {
        let place: usize = kernel_decimal_places[i];
        // Unreachable -- the table above has no zero -- but it is what
        // proves the divide below to --forbid-trap, and a table typo would
        // stop the print rather than trap.
        if (place == 0) { return; }
        let digit: usize = (value / place) % 10;
        if (digit != 0 || leading == false || place == 1) {
            uart_putc((digit as u8) + 48);
            leading = false;
        }
    }
}

// Hexadecimal, always the full 64 bits. The `0x` belongs to the caller --
// see kernel/printk/log.tkb's uart_put_hex, which adds it through the log
// ring so a fragment starts where it always did.
//
// GitHub issue #470 follow-up: this body was two functions --
// `kernel_process_trace_put_hex` in kernel/kernel/process.tkb and
// `crash_snapshot_put_hex` in exception_evidence.tkb -- byte-for-byte
// identical, same sink, in different files. They had not drifted. The
// decimal one above had not drifted either, until the reason it was narrow
// expired.
fn uart_put_hex_digits(value: usize) {
    let mut shift: usize = 60;
    while (true) {
        let digit: usize = (value >> shift) & 0xF;
        if (digit < 10) { uart_putc((digit as u8) + 48); }
        else { uart_putc((digit as u8) + 87); }
        if (shift == 0) { return; }
        shift = shift - 4;
    }
}
