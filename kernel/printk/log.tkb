// Stable operator-visible boot and status messages. Userspace test output uses
// the Linux write syscall; temporary kernel UART diagnostics do not belong in
// this interface.
fn kernel_boot_log(message: *u8) {
    uart_puts(message);
}

// A dispatched syscall whose computed SyscallAction encodes to action 0
// matches no branch in kernel/arch/arm64/kernel/user_entry.S's fixed
// dispatch table and falls through to a silent kernel_syscall_fail_stop --
// found the hard way in the #241/#244/#245 three-level process tree work,
// where the only way to find the root cause was reading user_entry.S by
// hand and cross-referencing a hardware UART transcript that never once
// mentioned the failing syscall. This line is the fix: printed right
// before that fail-stop, so the next occurrence names its own syscall
// number instead of requiring another cold read of the dispatch table.
fn kernel_boot_log_syscall_unreachable(number: usize) {
    uart_puts("syscall dispatch: unreachable action, syscall=" as *u8);
    uart_put_udec(number);
    uart_puts("\n" as *u8);
}

// GitHub issue #295: a fixed-capacity pool returning "full" at its call site
// otherwise looks identical to any other rejection (bad argument, timeout,
// EBADF) once it crosses the syscall boundary -- the interactive BusyBox
// HTTPd milestone's shared-object/descriptor exhaustion was visible only as
// an opaque shell/child startup failure until this file was hand-traced.
// Every pool-exhaustion branch this issue addresses logs through here so the
// resource name and its configured capacity always reach the operator, same
// as kernel_boot_log_syscall_unreachable does for an unreachable dispatch.
fn kernel_boot_log_resource_exhausted(resource: *u8, capacity: usize) {
    uart_puts("resource exhausted: " as *u8);
    uart_puts(resource);
    uart_puts(" capacity=" as *u8);
    uart_put_udec(capacity);
    uart_puts("\n" as *u8);
}
