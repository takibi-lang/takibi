// Operator-visible kernel text log. Ordinary kernel_boot_log() output is
// still written synchronously to UART, while logical lines are retained with
// the monotonic time at which their first byte was emitted. Userspace writes
// and the direct crash/DDB UART paths do not enter this ring.
//
// Core 0 remains the only retained-log and UART-queue writer. Other cores
// publish complete bounded lines for core 0 to copy and emit; interrupt-safe
// classified events remain kernel/diagnostic/event.tkb's job. A peer's
// userspace output takes the same route through its own channel,
// kernel/printk/peer_console.tkb, and never enters the retained log.
use "kernel/lib/execution_model.tkb";
use "kernel/printk/number.tkb";
use "kernel/printk/peer_console.tkb";
use "kernel/drivers/serial/terminal.tkb";
use "kernel/drivers/serial/terminal_echo.tkb";

const KERNEL_LOG_RECORD_COUNT: usize = 256;
const KERNEL_LOG_TEXT_MAX: usize = 160;
const KERNEL_LOG_TEXT_BYTES: usize = 40960;
const KERNEL_LOG_SNAPSHOT_CAPACITY: usize = 65536;

// GitHub issue #612: the retained ring is read on any CPU, by syslog(2), with
// no lock (kernel/models/LogReader.tla). Core 0 stays its only writer. The
// protocol, in ARMv8 terms:
//
// - kernel_log_started counts the records core 0 has begun; record s lives
//   in slot s % KERNEL_LOG_RECORD_COUNT. Beginning one, core 0 publishes the
//   new count FIRST, with release, and only then writes the slot. Every
//   store it makes to a slot after that is itself a release store -- the
//   stamp, the tick, the core, the length, each word of text -- so a reader
//   that sees any of them also sees the count that says the slot was reused.
// - A reader acquire-loads the count, then per record the slot's stamp
//   (which must name that record), its length and every field, each with
//   acquire, so the loads stay in that order and before the count is loaded
//   again. If that second count says the slot has been reused since, the
//   record is dropped and counted lost rather than returned.
//
// Text is kept in words so that each store can be a release: the atomic
// intrinsics are word-sized. Only core 0 stores a word, so the byte's
// read-modify-write needs no exclusion.
const KERNEL_LOG_TEXT_WORDS: usize = 5120;
// The truncated mark travels in the length word, so one release publishes
// both and a reader cannot see one without the other.
const KERNEL_LOG_LENGTH_TRUNCATED: usize = 0x100000000;
const KERNEL_LOG_LENGTH_MASK: usize = 0xFFFFFFFF;
private let mut kernel_log_text: [usize; KERNEL_LOG_TEXT_WORDS];
private let mut kernel_log_ticks: [usize; KERNEL_LOG_RECORD_COUNT];
private let mut kernel_log_lengths: [usize; KERNEL_LOG_RECORD_COUNT];
// Record number + 1 of the record a slot holds; 0 for none yet.
private let mut kernel_log_stamps: [usize; KERNEL_LOG_RECORD_COUNT];
private let mut kernel_log_started: usize;
// GitHub issue #465: which core's line this is, and when THAT core emitted it.
//
// A peer's line reaches the ring through core 0's drain, so without these two
// it is recorded as core 0's, timestamped at the moment core 0 got round to
// it. Both are wrong in the direction that matters: a retained log exists to
// attribute concurrency failures, and one that cannot say which core wrote a
// line is least useful exactly when two are interleaving.
//
// The ring keeps its own order as the machine-wide sequence, because core 0
// is its only writer -- that is what makes a sequence unnecessary here and a
// CPU column necessary. The order is therefore arrival-at-core-0, and a peer
// record's tick can be EARLIER than the record before it. That relationship
// is the one #465 asks to be stated rather than inferred.
private let mut kernel_log_cpu: [usize; KERNEL_LOG_RECORD_COUNT];
private let mut kernel_log_deferred_cpu: usize;
private let mut kernel_log_deferred_tick: i64;
private let mut kernel_log_deferred: bool;
private let mut kernel_log_oldest: usize;
private let mut kernel_log_count: usize;
private let mut kernel_log_overwritten: usize;
private let mut kernel_log_capture_enabled: bool;
private let mut kernel_log_active: bool;
private let mut kernel_log_active_slot: usize;
private let mut kernel_log_boot_tick: i64;
private let mut kernel_log_frequency: i64;
// One snapshot per CPU: syslog(2) builds it and copies it out in one
// syscall, which since #612 may run on any CPU.
struct KernelLogSnapshot {
    length: usize;
    bytes: [u8; KERNEL_LOG_SNAPSHOT_CAPACITY];
}
private let mut kernel_log_snapshots: [KernelLogSnapshot; KERNEL_MAX_CORES];

private fn kernel_log_snapshot_here() -> *KernelLogSnapshot {
    let base: *KernelLogSnapshot = kernel_log_snapshots;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

// The word stores and loads the protocol above is made of.
private fn kernel_log_publish(word: *usize, value: usize) !{unsafe} {
    unsafe { atomic_store_release(word as usize, value); }
}

private fn kernel_log_observe(word: *usize) -> usize !{unsafe} {
    return unsafe { atomic_load_acquire(word as usize) };
}
// Peer capture lasts through every numeric/string fragment until the fragment
// that completes the line returns (kernel_log_end_fragment);
// DDB writes directly to the device and terminal crash reporting explicitly
// enters emergency mode before using the ordinary formatting helpers.
const KERNEL_LOG_PEER_LINE_BYTES: usize = 192;
const KERNEL_LOG_PEER_RECORDS: usize = 8;
// One run of KERNEL_LOG_PEER_RECORDS per core the build reserves, and
// KERNEL_LOG_PEER_LINE_BYTES of text per slot. Literal, because an array
// bound cannot be a product expression; kernel_log_peer_publish asserts
// both products. At sixteen, cores 2 and 3 computed a slot past the end
// and their lines were dropped with nothing saying so.
const KERNEL_LOG_PEER_SLOTS: usize = 32;
const KERNEL_LOG_PEER_TEXT_BYTES: usize = 6144;
struct KernelLogCoreState {
    suppressed: bool;
    emergency: bool;
    peer_length: usize;
    peer_truncated: bool;
    peer_sequence: usize;
    peer_line: [u8; KERNEL_LOG_PEER_LINE_BYTES];
}
private let mut kernel_log_core_state: [KernelLogCoreState; KERNEL_MAX_CORES];
private let mut kernel_log_peer_published: [usize; KERNEL_LOG_PEER_SLOTS];
private let mut kernel_log_peer_latest: [usize; KERNEL_MAX_CORES];
private let mut kernel_log_peer_lengths: [usize; KERNEL_LOG_PEER_SLOTS];
private let mut kernel_log_peer_truncated: [bool; KERNEL_LOG_PEER_SLOTS];
// GitHub issue #465: when the PEER emitted this line, not when core 0
// drained it. The two differ by however long core 0 took to come back.
private let mut kernel_log_peer_ticks: [i64; KERNEL_LOG_PEER_SLOTS];
private let mut kernel_log_peer_text: [u8; KERNEL_LOG_PEER_TEXT_BYTES];
private let mut kernel_log_peer_consumed: [usize; KERNEL_MAX_CORES];

private fn kernel_log_core_here() -> *KernelLogCoreState {
    let base: *KernelLogCoreState = kernel_log_core_state;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

fn kernel_log_init() {
    kernel_log_core_here().suppressed = false;
    kernel_log_core_here().emergency = false;
    kernel_log_core_here().peer_length = 0;
    kernel_log_core_here().peer_truncated = false;
    kernel_log_core_here().peer_sequence = 0;
    kernel_log_oldest = 0;
    kernel_log_count = 0;
    kernel_log_overwritten = 0;
    kernel_log_capture_enabled = false;
    kernel_log_active = false;
    kernel_log_active_slot = 0;
    kernel_log_boot_tick = read_cntpct();
    kernel_log_frequency = read_cntfrq();
    // A reset, not a reuse: every stamp goes back to none, and the count to
    // zero. Core 0 only, before any reader can run (boot, and the bounds
    // probe that ends by calling this).
    for slot: usize in 0..<KERNEL_LOG_RECORD_COUNT {
        kernel_log_stamps[slot] = 0;
    }
    kernel_log_started = 0;
}

private fn kernel_log_start_line() {
    let mut slot: usize = 0;
    if (kernel_log_count < KERNEL_LOG_RECORD_COUNT) {
        slot = (kernel_log_oldest + kernel_log_count) % KERNEL_LOG_RECORD_COUNT;
        kernel_log_count = kernel_log_count + 1;
    } else {
        slot = kernel_log_oldest;
        kernel_log_oldest = (kernel_log_oldest + 1) % KERNEL_LOG_RECORD_COUNT;
        kernel_log_overwritten = kernel_log_overwritten + 1;
    }
    if (slot < KERNEL_LOG_RECORD_COUNT) {
        let safe_slot: {0..<KERNEL_LOG_RECORD_COUNT as usize} = slot;
        // #612: the count first, so the stores below never precede it.
        let record: usize = kernel_log_started;
        kernel_log_publish(&kernel_log_started, record + 1);
        // A drained peer line carries its own core and its own tick; anything
        // else is this core writing now.
        let mut line_cpu: usize = cpu_id();
        let mut line_tick: i64 = read_cntpct() - kernel_log_boot_tick;
        if (kernel_log_deferred) {
            line_cpu = kernel_log_deferred_cpu;
            line_tick = kernel_log_deferred_tick;
        }
        kernel_log_publish(&kernel_log_cpu[safe_slot], line_cpu);
        kernel_log_publish(&kernel_log_ticks[safe_slot], line_tick as usize);
        kernel_log_publish(&kernel_log_lengths[safe_slot], 0);
        kernel_log_publish(&kernel_log_stamps[safe_slot], record + 1);
        kernel_log_active_slot = slot;
        kernel_log_active = true;
    }
}

// Keeping the active flag set across a fragment without '\n' captures
// uart_put_udec/uart_put_hex output between fragments in the same line.
fn kernel_log_begin_fragment() {
    if (kernel_log_core_here().emergency) { return; }
    // The current record arrays and UART line assembly have one writer.
    // Admitting secondary-core ordinary text would create silent retained-log
    // corruption and split physical UART lines.
    if (cpu_id() != 0) {
        kernel_log_core_here().suppressed = true;
        return;
    }
    kernel_log_capture_enabled = true;
}

// A peer's fragment ends here. Suppression lasts until the line is complete,
// so a line built from several fragments (a label, uart_put_udec digits, then
// "\n") is still one record. Only a fragment that leaves no partial line
// behind lets the peer's later direct bytes through again.
fn kernel_log_end_fragment() {
    if (kernel_log_core_here().emergency) { return; }
    if (cpu_id() == 0) { return; }
    if (kernel_log_core_here().peer_length == 0) {
        kernel_log_core_here().suppressed = false;
    }
}

private fn kernel_log_peer_publish() !{unsafe} {
    static_assert(KERNEL_LOG_PEER_SLOTS ==
                  KERNEL_MAX_CORES * KERNEL_LOG_PEER_RECORDS,
                  "one run of peer records per core the build reserves");
    static_assert(KERNEL_LOG_PEER_TEXT_BYTES ==
                  KERNEL_LOG_PEER_SLOTS * KERNEL_LOG_PEER_LINE_BYTES,
                  "one line of text per peer record slot");
    let cpu: usize = cpu_id();
    if (cpu == 0 || cpu >= KERNEL_MAX_CORES) { return; }
    let sequence: usize = kernel_log_core_here().peer_sequence + 1;
    kernel_log_core_here().peer_sequence = sequence;
    let slot: usize = cpu * KERNEL_LOG_PEER_RECORDS +
        ((sequence - 1) % KERNEL_LOG_PEER_RECORDS);
    if (slot >= KERNEL_LOG_PEER_SLOTS) { return; }
    let safe_slot: {0..<KERNEL_LOG_PEER_SLOTS as usize} = slot;
    let published: *usize = kernel_log_peer_published;
    unsafe { atomic_store_release((published + (slot as isize)) as usize, 0); }
    let length: usize = kernel_log_core_here().peer_length;
    kernel_log_peer_lengths[safe_slot] = length;
    kernel_log_peer_truncated[safe_slot] = kernel_log_core_here().peer_truncated;
    kernel_log_peer_ticks[safe_slot] = read_cntpct() - kernel_log_boot_tick;
    for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
        if (index < length) {
            let offset: usize = slot * KERNEL_LOG_PEER_LINE_BYTES + index;
            if (offset < KERNEL_LOG_PEER_TEXT_BYTES) {
                let safe_offset: {0..<KERNEL_LOG_PEER_TEXT_BYTES as usize} = offset;
                kernel_log_peer_text[safe_offset] = kernel_log_core_here().peer_line[index];
            }
        }
    }
    let latest: *usize = kernel_log_peer_latest;
    unsafe {
        atomic_store_release((published + (slot as isize)) as usize, sequence);
        atomic_store_release((latest + (cpu as isize)) as usize, sequence);
    }
    kernel_log_core_here().peer_length = 0;
    kernel_log_core_here().peer_truncated = false;
}

// GitHub issue #454: what the console costs its callers, in the units the
// caller pays. `uart_putc` spins on PL011 TXFF, so once the 16-entry FIFO is
// full a byte costs its whole transmission time -- 86.8us at RPi5's 115207
// baud -- in the calling process's own time, and a 180-character line is a
// whole 15.625ms scheduler tick.
//
// That much is arithmetic. What the issue could not say is the SHARE: "some
// unknown fraction of boot time is this loop". So the loop times itself. Two
// counter reads per byte against a wait that is three orders of magnitude
// longer is not a measurement that changes what it measures.
//
// Counted here rather than in the two platform drivers so both report one
// number through one path. Secondary-core ordinary lines are suppressed, so
// these counters retain their original meaning: core 0's console cost.
private let mut kernel_log_tx_spin_ticks: usize = 0;
private let mut kernel_log_tx_bytes: usize = 0;
// Bytes that had to WAIT, which is no longer every byte: once the queue is
// live a caller usually returns without touching the FIFO at all, and the
// share that still spins is what says whether the queue is big enough.
private let mut kernel_log_tx_spun: usize = 0;

fn kernel_log_note_tx_byte() {
    if (cpu_id() != 0) { return; }
    kernel_log_tx_bytes = kernel_log_tx_bytes + 1;
}

fn kernel_log_note_tx_spin(ticks: i64) {
    if (cpu_id() != 0) { return; }
    kernel_log_tx_spun = kernel_log_tx_spun + 1;
    if (ticks > 0) {
        kernel_log_tx_spin_ticks = kernel_log_tx_spin_ticks + (ticks as usize);
    }
}

fn kernel_log_tx_spin_ticks_total() -> usize {
    return kernel_log_tx_spin_ticks;
}

fn kernel_log_tx_byte_total() -> usize {
    return kernel_log_tx_bytes;
}

fn kernel_log_tx_spun_total() -> usize {
    return kernel_log_tx_spun;
}

// GitHub issue #454: the transmit queue, and the switch that decides whether
// a caller queues or spins.
//
// Measured before it existed: 2519 ms of an RPi5 boot spent inside
// `uart_putc`'s TXFF wait, 78.9us per byte against the wire's own 86.8us --
// the 16-entry FIFO absorbs a burst once and is full for the rest of a line,
// so a caller waits out very nearly the whole transmission of every byte.
//
// SIZE, from the shape of the output rather than a pick. The producer is far
// faster than the wire but is not continuously ahead of it: the boot moves
// 31919 bytes over about 20 s, which is 14% of what the wire could carry in
// that time. What costs is the BURST -- a line up to 180 characters arrives
// with no gaps, and everything past the FIFO's 16 waits. A queue that holds
// the largest burst removes the common case; one that tries to hold the
// dmesg replay, ~90 lines back to back, would have to be as large as the
// replay and would still fill. 512 bytes is a little under three
// maximum-length lines, and what it does not absorb is the case where the
// producer is genuinely wire-bound and ought to wait.
//
// OVERFLOW: drain by polling until there is room, never write past the
// queue. Writing the overflowing byte straight to the FIFO would put it
// ahead of everything already queued, which is the one failure a queue makes
// easy and the one this kernel cannot have -- every view compares text.
const KERNEL_LOG_TX_QUEUE_BYTES: usize = 512;
private let mut kernel_log_tx_queue: [u8; KERNEL_LOG_TX_QUEUE_BYTES];
private let mut kernel_log_tx_terminal: [bool; KERNEL_LOG_TX_QUEUE_BYTES];
private let mut kernel_log_terminal_column: usize;
private let mut kernel_log_tx_head: usize = 0;
private let mut kernel_log_tx_tail: usize = 0;
private let mut kernel_log_tx_count: usize = 0;
// GitHub issue #611: the last byte core 0 put on the wire, from any stream
// -- kernel log text, a user write, a drained peer console record -- and
// whether a kernel log line is about to start after one that did not end.
// A shell on a peer wrote `... job control turned off` and its newline in
// two records, core 0 started `profile: begin` between them, and the host
// parser, which reads lines, never saw the record. So a kernel line always
// starts at the beginning of a wire line: core 0 sends one newline of its
// own first when the wire is mid-line. The retained log never sees it.
private let mut kernel_log_wire_last: u8 = 10;
private let mut kernel_log_wire_break_due: bool = false;

// False until the platform has armed its TX interrupt. Early boot runs before
// platform_irq_init(), so a byte queued then would never be drained; DDB and
// the crash console must not depend on interrupts at all. Both therefore
// spin, deliberately, and this says which regime is in effect rather than
// letting anything infer it.
private let mut kernel_log_tx_live: bool = false;

fn kernel_log_tx_is_live() -> bool {
    return kernel_log_tx_live;
}

fn kernel_log_tx_activate() {
    kernel_log_tx_live = true;
}

// Put the console back the way it was before the queue existed: everything
// already queued goes out, and every byte after this one spins.
//
// GitHub issue #454 asked for "a flush point before anything that must be on
// the wire before it proceeds". A single flush is not enough for a TERMINAL
// path. The crash console runs under disable_irq() and then blocks on input
// after each `ddb> `, so a byte still in the queue has nothing left to drain
// it -- the prompt would sit there and the console would look hung. Turning
// the queue off at entry is one statement instead of a flush before every
// write, and it makes the acceptance condition literal: DDB and the crash
// console emit byte-identical output through exactly the path they used
// before this change.
//
// It used to be one-way for the rest of the boot, DDB's `continue` included,
// and for the debugger that was a defect rather than a decision: GitHub issue
// #531. The crash console never returns, so one-way is right there. DDB does
// return -- kernel_ddb_enter is reached only from the two IRQ dispatchers on a
// serial BREAK, so `continue` resumes a kernel that was healthy all along --
// and everything logged after it paid 78.9 us/byte again, turning a
// `console tx spin=81 ms` boot into a 2519 ms one after a single BREAK.
//
// The fix is not `kernel_log_tx_activate()` on the way out: the resume must
// put back the value the stand-down FOUND. platform_irq_init() and
// kernel_log_tx_activate() are adjacent but not atomic, so a BREAK between
// them enters with the queue not yet live, and enabling it there would queue
// bytes that nothing drains -- there is no armed TX interrupt yet. Same rule
// as mutex_irq_restore against enable_irq, and getting that one wrong is what
// removed DDB from RPi5 in the first place.
//
// So the found state is the return value, and it is the only argument the
// resume takes. There is no kernel_log_tx_resume() that reads no saved state,
// which is what "by construction" means here: the shape
// scripts/check_irq_restore_sites.py has to look for lexically in the
// interrupt case is, for this flag, the only shape that type-checks.
//
// NotConsoleOwner is the third answer, and it is not "it was spinning". Core
// 0 owns this flag and this queue; a peer stands nothing down, so a peer must
// put nothing back. Reporting a peer's finding as WasLive would let its
// resume write core 0's flag back to true after core 0 had deliberately
// stood the queue down -- the queue would come back under a terminal path
// with interrupts masked and nothing left to drain it.
must_use variant KernelLogTxStandDown {
    WasLive;
    WasSpinning;
    NotConsoleOwner;
}

fn kernel_log_tx_stand_down() -> KernelLogTxStandDown !{unsafe} {
    if (cpu_id() != 0) { return KernelLogTxStandDown::NotConsoleOwner; }
    let was_live: bool = kernel_log_tx_live;
    uart_tx_flush();
    kernel_log_tx_live = false;
    if (was_live) {
        return KernelLogTxStandDown::WasLive;
    }
    return KernelLogTxStandDown::WasSpinning;
}

// Put back what was found, and nothing else. Re-arming the TX interrupt is
// not this function's business: uart_tx_flush() disabled it, and the next
// queued byte enables it again in uart_putc, so the flag is the whole of the
// state a stand-down took away.
//
// must_use on the token is what makes a terminal path say so out loud: the
// crash console has to match its stand-down and decide, rather than dropping
// it, and a path that DOES return cannot forget.
fn kernel_log_tx_resume(previous: KernelLogTxStandDown) {
    match previous {
        KernelLogTxStandDown::WasLive => { kernel_log_tx_live = true; }
        KernelLogTxStandDown::WasSpinning => { }
        KernelLogTxStandDown::NotConsoleOwner => { }
    }
}

fn kernel_log_tx_pending() -> bool {
    return kernel_log_tx_count != 0;
}

fn kernel_log_tx_full() -> bool {
    return kernel_log_tx_count >= KERNEL_LOG_TX_QUEUE_BYTES;
}

// Callers mask interrupts around these two: the drain runs from the TX
// handler, so producer and consumer share the count. Masking rather than
// locking is the sanctioned channel here -- kernel/lib/diagnostic_ring.tkb's
// header explains why a console that can block on a lock is a console that
// cannot report the deadlock it is in.
fn kernel_log_tx_push(value: u8) -> bool {
    if (kernel_log_tx_count >= KERNEL_LOG_TX_QUEUE_BYTES) { return false; }
    let slot: usize = kernel_log_tx_tail;
    if (slot >= KERNEL_LOG_TX_QUEUE_BYTES) { return false; }
    let safe_slot: {0..<KERNEL_LOG_TX_QUEUE_BYTES as usize} = slot;
    kernel_log_tx_queue[safe_slot] = value;
    kernel_log_tx_terminal[safe_slot] = false;
    kernel_log_terminal_column_byte(value);
    kernel_log_wire_last = value;
    kernel_log_tx_tail = slot + 1;
    if (kernel_log_tx_tail >= KERNEL_LOG_TX_QUEUE_BYTES) {
        kernel_log_tx_tail = 0;
    }
    kernel_log_tx_count = kernel_log_tx_count + 1;
    return true;
}

// Tags keep a signal flush from discarding queued kernel diagnostics.
private fn kernel_log_tx_push_terminal(value: u8) -> bool {
    let slot: usize = kernel_log_tx_tail;
    if (kernel_log_tx_push(value) == false) { return false; }
    if (slot < KERNEL_LOG_TX_QUEUE_BYTES) { kernel_log_tx_terminal[slot] = true; }
    return true;
}

private fn kernel_log_terminal_column_byte(value: u8) {
    if (value == 13) { kernel_log_terminal_column = 0; }
    else if (value == 8) {
        if (kernel_log_terminal_column != 0) {
            kernel_log_terminal_column = kernel_log_terminal_column - 1;
        }
    } else if (value == 9) {
        kernel_log_terminal_column = (kernel_log_terminal_column + 8) & ~7;
    } else if (value >= 32 && value != 127) {
        kernel_log_terminal_column = (kernel_log_terminal_column + 1) % 65536;
    }
}

fn uart_terminal_column() -> usize { return kernel_log_terminal_column; }

// CPU 0, IRQs masked. Input signals flush terminal output, while kernel
// records survive. A peer publishes whole records with release ordering;
// retiring the currently visible prefix cannot remove a future publication.
fn uart_terminal_flush_output() {
    terminal_echo_reset();
    let count: usize = kernel_log_tx_count;
    let head: usize = kernel_log_tx_head;
    let mut kept: usize = 0;
    for offset: usize in 0..<KERNEL_LOG_TX_QUEUE_BYTES {
        if (offset < count) {
            let source: usize = (head + offset) % KERNEL_LOG_TX_QUEUE_BYTES;
            if (source < KERNEL_LOG_TX_QUEUE_BYTES &&
                kernel_log_tx_terminal[source] == false) {
                let target: usize = (head + kept) % KERNEL_LOG_TX_QUEUE_BYTES;
                if (target < KERNEL_LOG_TX_QUEUE_BYTES) {
                    kernel_log_tx_queue[target] = kernel_log_tx_queue[source];
                    kernel_log_tx_terminal[target] = false;
                    kept = kept + 1;
                }
            }
        }
    }
    kernel_log_tx_count = kept;
    kernel_log_tx_tail = (head + kept) % KERNEL_LOG_TX_QUEUE_BYTES;
    let mut record: PeerConsoleRecord;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        for step: usize in 0..<PEER_CONSOLE_RECORDS {
            match peer_console_peek(cpu, &record) {
                PeerConsolePeek::Empty => { }
                PeerConsolePeek::Ready(length) => { peer_console_retire(cpu); }
            }
        }
    }
}

must_use variant KernelLogTxByte { Empty; Byte(u8); }

fn kernel_log_tx_pop() -> KernelLogTxByte {
    if (kernel_log_tx_count == 0) { return KernelLogTxByte::Empty; }
    let slot: usize = kernel_log_tx_head;
    if (slot >= KERNEL_LOG_TX_QUEUE_BYTES) { return KernelLogTxByte::Empty; }
    let safe_slot: {0..<KERNEL_LOG_TX_QUEUE_BYTES as usize} = slot;
    let value: u8 = kernel_log_tx_queue[safe_slot];
    kernel_log_tx_head = slot + 1;
    if (kernel_log_tx_head >= KERNEL_LOG_TX_QUEUE_BYTES) {
        kernel_log_tx_head = 0;
    }
    kernel_log_tx_count = kernel_log_tx_count - 1;
    return KernelLogTxByte::Byte(value);
}

// GitHub issue #454, and issue #470's rule about where a body belongs. What
// follows is the console's transmit POLICY -- queue or spin, when to drain,
// when to flush -- and none of it is platform-specific. The platform supplies
// four MMIO primitives that genuinely differ by base address
// (uart_tx_fifo_full, uart_tx_store, uart_tx_irq_enable, uart_tx_irq_disable);
// everything built on them lives here, where both platforms read one copy.
// scripts/check_platform_file_parity.py refused the first version of this
// change for exactly that reason, naming all four bodies.
// Wait out the FIFO and write. This is what every byte cost before the queue
// existed, and it is still the whole story for early boot, for DDB, and for a
// queue that has filled.
private fn uart_tx_spin_store(c: u8) !{unsafe} {
    let spin_from: i64 = read_cntpct();
    while (uart_tx_fifo_full()) { }
    kernel_log_note_tx_spin(read_cntpct() - spin_from);
    uart_tx_store(c);
    if (cpu_id() == 0) { kernel_log_wire_last = c; }
}

// Only CPU 0 sends UART input-flow requests. Readers on other CPUs publish
// their desired state atomically; coalescing to the latest state cannot leave
// the sender stopped after the receive ring became empty.
private let mut kernel_log_terminal_input_stopped: bool;

fn kernel_log_terminal_flow_poll() !{unsafe} {
    let flags: usize = mutex_irq_save();
    let wanted: bool = terminal_input_flow_requested();
    if (wanted != kernel_log_terminal_input_stopped) {
        kernel_log_terminal_input_stopped = wanted;
        let mut control: u8 = terminal_control_byte(8);
        if (wanted) { control = terminal_control_byte(9); }
        if (control != 0) { uart_wire_byte(control); }
    }
    mutex_irq_restore(flags);
}

// Echo operations are bounded and never spin in the receive interrupt.
// The caller is CPU 0 with IRQs masked, including the RX handler itself.
fn uart_terminal_echo(operation: TerminalEchoOperation) {
    match terminal_echo_push(operation) {
        TerminalEchoPushResult::Queued => {
            match operation {
                TerminalEchoOperation::Byte(value) => {
                    kernel_log_terminal_column_byte(value);
                }
                TerminalEchoOperation::Control(value) => {
                    kernel_log_terminal_column_byte(94);
                    kernel_log_terminal_column_byte(value);
                }
                TerminalEchoOperation::Erase(columns) => {
                    if (kernel_log_terminal_column >= columns) {
                        kernel_log_terminal_column = kernel_log_terminal_column - columns;
                    } else { kernel_log_terminal_column = 0; }
                }
                TerminalEchoOperation::Newline => { kernel_log_terminal_column = 0; }
            }
        }
        TerminalEchoPushResult::Full => { }
    }
}

fn uart_terminal_output_pending() -> bool {
    return kernel_log_tx_pending() || terminal_echo_pending();
}

fn uart_terminal_resume_output() !{unsafe} {
    let flags: usize = mutex_irq_save();
    if (terminal_output_paused() == false) {
        uart_tx_drain_into_fifo();
        if (uart_terminal_output_pending()) { uart_tx_irq_enable(); }
    }
    mutex_irq_restore(flags);
}

// Move queued bytes into the FIFO while both have room. Runs from the TX
// interrupt as well as from the poll-drain paths, so it carries neither
// `logs` nor `locks`: the effect system rejects `locks` on an `!{interrupt}`
// function, and a console that could block on one could not report the
// deadlock it is in.
fn uart_tx_drain_into_fifo() !{unsafe} {
    if (terminal_output_paused()) { return; }
    uart_tx_drain_into_fifo_force();
}

// Fatal/DDB flushes must remain available even after a user sent XOFF.
private fn uart_tx_drain_into_fifo_force() !{unsafe} {
    while (uart_terminal_output_pending() && uart_tx_fifo_full() == false) {
        match kernel_log_tx_pop() {
            KernelLogTxByte::Empty => {
                match terminal_echo_read() {
                    TerminalEchoReadResult::Empty => { return; }
                    TerminalEchoReadResult::Byte(value) => { uart_tx_store(value); }
                }
            }
            KernelLogTxByte::Byte(value) => { uart_tx_store(value); }
        }
    }
}

fn uart_putc(c: u8) !{logs, unsafe} {
    if (kernel_log_capture_uart_byte(c) == false) { return; }
    // The IRQ-owned TX queue is still core-0-only. A peer's direct byte
    // must not mutate it; ordinary peer log fragments are suppressed above.
    if (cpu_id() != 0) {
        uart_tx_spin_store(c);
        return;
    }
    if (kernel_log_wire_break_due) {
        kernel_log_wire_break_due = false;
        uart_wire_byte(10);
    }
    uart_wire_byte(c);
}

// One byte from core 0 onto the wire, queued or spun; uart_putc without
// the retained log's capture.
private fn uart_wire_byte(c: u8) !{logs, unsafe} {
    kernel_log_note_tx_byte();
    // The paused queue belongs to terminal writes. Kernel diagnostics and
    // terminal flow-control bytes remain usable without draining that queue.
    if (terminal_output_paused()) {
        kernel_log_terminal_column_byte(c);
        uart_tx_spin_store(c);
        return;
    }
    if (kernel_log_tx_is_live() == false) {
        kernel_log_terminal_column_byte(c);
        uart_tx_spin_store(c);
        return;
    }
    // A full queue is drained by POLLING, never bypassed. Writing this byte
    // straight to the FIFO would put it ahead of everything already queued,
    // and every view in this kernel compares text.
    // Restore the state FOUND, never enable unconditionally. kernel_boot_log
    // is reached from paths that already hold IRQs masked, and a console that
    // unmasked them underneath its caller would be a far worse defect than the
    // spinning this replaces -- the same reasoning mutex_irq_save/_restore
    // carries in kernel/lib/pool_lock.tkb.
    let irq_flags: usize = mutex_irq_save();
    while (kernel_log_tx_full()) {
        mutex_irq_restore(irq_flags);
        while (uart_tx_fifo_full()) { }
        disable_irq();
        uart_tx_drain_into_fifo();
    }
    let queued: bool = kernel_log_tx_push(c);
    uart_tx_drain_into_fifo();
    let still_pending: bool = uart_terminal_output_pending();
    mutex_irq_restore(irq_flags);
    if (queued == false) {
        uart_tx_spin_store(c);
        return;
    }
    if (still_pending) { uart_tx_irq_enable(); }
}

// GitHub issue #544: userspace output through the same queue, in chunks,
// and a writer that sleeps rather than spins.
//
// A user write queues only while the queue is at or below its low-water
// mark, half the queue, and then takes as much as there is room for. Above
// the mark it takes nothing, and the syscall layer puts the writer to sleep
// until the TX interrupt has drained the queue back down. That is BSD's
// high/low water rule; without the gap a writer would come back every time
// the FIFO freed a byte, and spin in userspace instead of in the kernel.
//
// Kernel log text keeps its own rule: it polls when the queue is full. The
// kernel cannot sleep at an arbitrary logging call, and one queue keeps the
// order on the wire exactly what the calls made it -- which every view
// compares. Terminal echo has a bounded operation queue of its own; writers
// wait until it drains so a reply cannot overtake the input being echoed.
const KERNEL_LOG_TX_WRITER_LOW_WATER: usize = 256;

// DDB captures these before the console queue is stood down and flushed.
fn kernel_log_tx_queue_count() -> usize {
    return kernel_log_tx_count;
}

fn kernel_log_tx_writer_low_water() -> usize {
    return KERNEL_LOG_TX_WRITER_LOW_WATER;
}

// Every write that found no room waited, and those that had something else
// to run slept. The waits are the deterministic count: on the board a
// write larger than the queue must wait. Whether it sleeps depends on
// whether another process happened to be ready at that moment.
private let mut uart_user_write_waits: usize = 0;
private let mut uart_user_write_sleeps: usize = 0;

// Bytes a user write may queue now; zero means wait. On a peer the answer is
// the room in its console ring (GitHub issue #534). Before core 0's queue is
// live there is no queue to wait on and the bytes spin as they always have,
// so the answer is the most one call takes.
fn uart_user_write_room() -> usize {
    if (terminal_output_paused()) { return 0; }
    if (cpu_id() == 0 && terminal_echo_pending()) { return 0; }
    let cpu: usize = cpu_id();
    if (cpu != 0) { return peer_console_room(cpu); }
    if (kernel_log_tx_is_live() == false) {
        return KERNEL_LOG_TX_QUEUE_BYTES;
    }
    let irq_flags: usize = mutex_irq_save();
    let count: usize = kernel_log_tx_count;
    mutex_irq_restore(irq_flags);
    if (count > KERNEL_LOG_TX_WRITER_LOW_WATER) { return 0; }
    if (count >= KERNEL_LOG_TX_QUEUE_BYTES) { return 0; }
    return KERNEL_LOG_TX_QUEUE_BYTES - count;
}

// Whether the TX interrupt should wake sleeping writers.
fn kernel_log_tx_writer_room() -> bool {
    return terminal_output_paused() == false && terminal_echo_pending() == false &&
           kernel_log_tx_count <= KERNEL_LOG_TX_WRITER_LOW_WATER;
}

// GitHub issue #657: how long a peer's console record waits before core 0
// moves it to the transmit queue. A peer's output reaches the wire only when
// core 0 drains its ring (a syscall entry, a timer interrupt from EL0, or a
// wake of core 0's idle loop), so a record can be reordered against core 0's
// own output by however long that takes. The characters that once seemed to
// go missing from an echo were records waiting here. This is the number that
// says so directly the next time it looks like that.
//
// The producer stamps the slots it is about to fill BEFORE it publishes them,
// and core 0 reads a slot's stamp only after it has seen the record, so the
// publication's ordering covers the plain array. Core 0 alone writes the
// statistics.
private let mut kernel_log_peer_stamp:
    [usize; KERNEL_MAX_CORES * PEER_CONSOLE_RECORDS];
private let mut kernel_log_peer_drained: usize;
private let mut kernel_log_peer_late: usize;
private let mut kernel_log_peer_worst_ticks: usize;
private let mut kernel_log_peer_worst_cpu: usize;
private let mut kernel_log_peer_worst_length: usize;
private let mut kernel_log_peer_worst_first: [u8; 8];

private fn kernel_log_peer_stamp_slot(cpu: {0..<KERNEL_MAX_CORES as usize},
                                      index: usize)
        -> {0..<KERNEL_MAX_CORES * PEER_CONSOLE_RECORDS as usize} {
    let within: {0..<PEER_CONSOLE_RECORDS as usize} =
        index % PEER_CONSOLE_RECORDS;
    return cpu * PEER_CONSOLE_RECORDS + within;
}

private fn kernel_log_peer_stamp_records(cpu: usize, length: usize) !{unsafe} {
    if (cpu >= KERNEL_MAX_CORES) { return; }
    let here: {0..<KERNEL_MAX_CORES as usize} = cpu;
    let now: usize = read_cntpct() as usize;
    let first: usize = peer_console_published_count(cpu);
    let mut records: usize = (length + PEER_CONSOLE_RECORD_BYTES - 1) /
                             PEER_CONSOLE_RECORD_BYTES;
    let room: usize = peer_console_room(cpu) / PEER_CONSOLE_RECORD_BYTES;
    if (records > room) { records = room; }
    for step: usize in 0..<PEER_CONSOLE_RECORDS {
        if (step < records) {
            kernel_log_peer_stamp[kernel_log_peer_stamp_slot(here, first + step)] = now;
        }
    }
}

// Core 0, just before it retires the record it moved: count it and answer how
// long it waited. The caller keeps the worst one's bytes, from its own copy of
// the record, so this takes no pointer to it.
private fn kernel_log_peer_note_drained(cpu: usize) -> usize !{unsafe} {
    if (cpu >= KERNEL_MAX_CORES) { return 0; }
    let here: {0..<KERNEL_MAX_CORES as usize} = cpu;
    let index: usize = peer_console_consumed_count(cpu);
    let stamp: usize = kernel_log_peer_stamp[kernel_log_peer_stamp_slot(here, index)];
    let now: usize = read_cntpct() as usize;
    kernel_log_peer_drained = kernel_log_peer_drained + 1;
    if (now < stamp) { return 0; }
    let waited: usize = now - stamp;
    // Late is about 30 ms: many times a normal wait, which ends at core 0's
    // next syscall, timer interrupt or idle wake.
    if (waited > ((read_cntfrq() >> 5) as usize)) {
        kernel_log_peer_late = kernel_log_peer_late + 1;
    }
    return waited;
}

// Printed once, near the end of the boot. `worst` names the record that
// waited longest, by its CPU, its length and its first bytes as numbers.
fn kernel_log_peer_console_report() !{logs, unsafe} {
    kernel_boot_log("console: peer records drained=");
    uart_put_udec(kernel_log_peer_drained);
    kernel_boot_log(" late=");
    uart_put_udec(kernel_log_peer_late);
    kernel_boot_log(" worst_ticks=");
    uart_put_udec(kernel_log_peer_worst_ticks);
    kernel_boot_log(" tickfreq=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log("\n");
    if (kernel_log_peer_late != 0) {
        kernel_boot_log("console: peer worst record cpu=");
        uart_put_udec(kernel_log_peer_worst_cpu);
        kernel_boot_log(" length=");
        uart_put_udec(kernel_log_peer_worst_length);
        kernel_boot_log(" first bytes=");
        for i: usize in 0..<8 {
            uart_put_udec(kernel_log_peer_worst_first[i] as usize);
            kernel_boot_log(" ");
        }
        kernel_boot_log("\n");
    }
}

// Queue what fits of a user write and return how many bytes that was. Each
// byte gets the bookkeeping uart_putc gives it, in the same order, and a byte
// is only counted once it is certain to be queued, so the one a full queue
// turns away is counted when the retried write takes it.
fn uart_user_write(bytes: borrow []u8) -> usize !{logs, unsafe} {
    if (terminal_output_paused()) { return 0; }
    if (cpu_id() == 0 && terminal_echo_pending()) { return 0; }
    // GitHub issue #534: a peer never touches the PL011 or core 0's queue.
    // What it hands over is published whole records, and the count is only
    // what the ring took.
    let cpu: usize = cpu_id();
    if (cpu != 0) {
        kernel_log_peer_stamp_records(cpu, bytes.len);
        return peer_console_publish(cpu, bytes);
    }
    if (kernel_log_tx_is_live() == false) {
        let mut spun: usize = 0;
        for index: usize in 0..<KERNEL_LOG_TX_QUEUE_BYTES {
            if (index < bytes.len) {
                uart_putc(bytes[index]);
                spun = spun + 1;
            }
        }
        return spun;
    }
    let irq_flags: usize = mutex_irq_save();
    let mut taken: usize = 0;
    let mut room: bool = true;
    for index: usize in 0..<KERNEL_LOG_TX_QUEUE_BYTES {
        if (room) {
            if (index < bytes.len) {
                if (kernel_log_tx_full()) {
                    room = false;
                } else {
                    let value: u8 = bytes[index];
                    if (kernel_log_capture_uart_byte(value)) {
                        kernel_log_note_tx_byte();
                        if (kernel_log_tx_push_terminal(value) == false) { room = false; }
                    }
                    if (room) { taken = taken + 1; }
                }
            }
        }
    }
    uart_tx_drain_into_fifo();
    let still_pending: bool = uart_terminal_output_pending();
    mutex_irq_restore(irq_flags);
    if (still_pending) { uart_tx_irq_enable(); }
    return taken;
}

fn uart_user_write_note_wait() {
    if (cpu_id() != 0) { return; }
    uart_user_write_waits = uart_user_write_waits + 1;
}

fn uart_user_write_wait_total() -> usize {
    return uart_user_write_waits;
}

fn uart_user_write_note_sleep() {
    if (cpu_id() != 0) { return; }
    uart_user_write_sleeps = uart_user_write_sleeps + 1;
}

fn uart_user_write_sleep_total() -> usize {
    return uart_user_write_sleeps;
}

// Everything queued reaches the wire before this returns. Called before the
// paths that must not depend on interrupts -- DDB entry, the crash console,
// a halt -- because those write through uart_debug_putc, and a byte they emit
// while the queue still holds earlier output would arrive out of order.
fn uart_tx_flush() !{unsafe} {
    let irq_flags: usize = mutex_irq_save();
    while (uart_terminal_output_pending()) {
        while (uart_tx_fifo_full()) { }
        uart_tx_drain_into_fifo_force();
    }
    uart_tx_irq_disable();
    mutex_irq_restore(irq_flags);
}

fn kernel_log_capture_uart_byte(value: u8) -> bool {
    if (kernel_log_core_here().emergency) { return true; }
    if (kernel_log_core_here().suppressed) {
        let length: usize = kernel_log_core_here().peer_length;
        if (length < KERNEL_LOG_PEER_LINE_BYTES) {
            let safe_length: {0..<KERNEL_LOG_PEER_LINE_BYTES as usize} = length;
            kernel_log_core_here().peer_line[safe_length] = value;
            kernel_log_core_here().peer_length = length + 1;
        } else { kernel_log_core_here().peer_truncated = true; }
        // A newline ends the record, not the fragment. The rest of the same
        // kernel_boot_log string stays suppressed until the fragment returns
        // (kernel_log_end_fragment). Lifting it here sent the tail of
        // "\nworkload: ..." straight to the UART, while core 0 drained the
        // lone newline record into the middle of it.
        if (value == 10) {
            kernel_log_peer_publish();
        }
        return false;
    }
    // A peer's direct UART byte is not part of core 0's partially assembled
    // retained line, even if the core-0 capture flag happens to be set.
    if (cpu_id() != 0) { return true; }
    if (kernel_log_capture_enabled == false) { return true; }
    if (kernel_log_active == false) {
        if (value == 10) {
            kernel_log_capture_enabled = false;
            return true;
        }
        kernel_log_start_line();
        if (kernel_log_wire_last != 10) { kernel_log_wire_break_due = true; }
    }
    if (kernel_log_active == false) { return true; }
    let slot: usize = kernel_log_active_slot;
    if (slot >= KERNEL_LOG_RECORD_COUNT) {
        kernel_log_active = false;
        return true;
    }
    let safe_slot: {0..<KERNEL_LOG_RECORD_COUNT as usize} = slot;
    // #612: the byte's word, then the length that admits it, each a release
    // store; the truncated mark rides in the length.
    let stored: usize = kernel_log_lengths[safe_slot];
    let length: usize = stored & KERNEL_LOG_LENGTH_MASK;
    if (length < KERNEL_LOG_TEXT_MAX) {
        let offset: usize = slot * KERNEL_LOG_TEXT_MAX + length;
        let word_index: usize = offset / 8;
        if (word_index < KERNEL_LOG_TEXT_WORDS) {
            let safe_word: {0..<KERNEL_LOG_TEXT_WORDS as usize} = word_index;
            let shift: usize = (offset % 8) * 8;
            let word: usize = (kernel_log_text[safe_word] &
                               ~(0xFF << shift)) |
                              ((value as usize) << shift);
            kernel_log_publish(&kernel_log_text[safe_word], word);
            kernel_log_publish(&kernel_log_lengths[safe_slot], stored + 1);
        }
    } else if ((stored & KERNEL_LOG_LENGTH_TRUNCATED) == 0) {
        kernel_log_publish(&kernel_log_lengths[safe_slot],
                           stored | KERNEL_LOG_LENGTH_TRUNCATED);
    }
    if (value == 10) {
        kernel_log_active = false;
        kernel_log_capture_enabled = false;
    }
    return true;
}

// GitHub issue #465: a peer that writes a retained line, on request.
//
// No maintained boot path had a secondary core emitting ordinary log text, so
// the publication Territory A built and the attribution added here were both
// unobservable -- the whole facility could stop working and every lane would
// stay green.
//
// So this runs on every boot rather than behind a switch, for the same reason
// the two-core contention probes do: evidence nobody turns on is evidence
// nobody has. It costs five lines.
//
// Bounded on purpose. It emits KERNEL_LOG_PEER_PROBE_LINES numbered lines and
// then stops, so the count in the retained log is a fact a view can compare
// rather than a stream whose length depends on how long the boot took.
//
// The shared `dmesg` view enumerates cpu1's five lines by name. A third core
// would add five more and fail that view, which is the intended outcome: the
// view is where somebody decides what a four-core boot's retained log should
// look like, and failing there is cheaper than discovering it later.
const KERNEL_LOG_PEER_PROBE_LINES: usize = 5;
private let mut kernel_log_peer_probe_emitted: [usize; KERNEL_MAX_CORES];

// Not an interrupt function, and the effect checker is what settled that: an
// !{interrupt} version was rejected for reaching kernel_boot_log, which is
// the same rule that keeps a handler out of the ordinary console. So this
// runs in the secondary's ordinary loop, which is also the only context where
// kernel_log_peer_publish is reachable at all.
fn kernel_log_peer_probe_step() !{logs, unsafe} {
    let raw_cpu: usize = cpu_id();
    if (raw_cpu == 0 || raw_cpu >= KERNEL_MAX_CORES) { return; }
    let core: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    let emitted: usize = kernel_log_peer_probe_emitted[core];
    if (emitted >= KERNEL_LOG_PEER_PROBE_LINES) {
        kernel_log_peer_console_probe_step(core);
        return;
    }
    kernel_log_peer_probe_emitted[core] = emitted + 1;
    // GitHub issue #9: the last line starts with a newline inside the same
    // fragment, the shape of the busy pair's migration line. Its text used
    // to escape the record and reach the UART raw, so it never got into the
    // retained log this view reads.
    if (emitted + 1 == KERNEL_LOG_PEER_PROBE_LINES) {
        kernel_boot_log("\npeer log probe: line=");
    } else {
        kernel_boot_log("peer log probe: line=");
    }
    uart_put_udec(emitted + 1);
    kernel_boot_log("\n");
}

// GitHub issue #534: the same argument for a peer's userspace output. No
// maintained workload runs a writing process on a peer yet, because this
// channel is what has to exist first, so without this nothing would send a
// byte through it. Four one-record lines, through uart_user_write itself --
// the function a peer's write(2) reaches -- and a line is sent again on the
// next pass if the ring had no room for it. The shared `peer_console` view
// compares them on both lanes.
const KERNEL_LOG_PEER_CONSOLE_PROBE_LINES: usize = 4;
private let mut kernel_log_peer_console_probe_sent: [usize; KERNEL_MAX_CORES];

private fn kernel_log_peer_console_probe_step(
        core: {0..<KERNEL_MAX_CORES as usize}) !{logs, unsafe} {
    let sent: usize = kernel_log_peer_console_probe_sent[core];
    if (sent >= KERNEL_LOG_PEER_CONSOLE_PROBE_LINES) { return; }
    let mut line = bs"peer console probe: record=1 of 4\n";
    if (sent == 1) { line = bs"peer console probe: record=2 of 4\n"; }
    if (sent == 2) { line = bs"peer console probe: record=3 of 4\n"; }
    if (sent == 3) { line = bs"peer console probe: record=4 of 4\n"; }
    if (uart_user_write(line) == line.len) {
        kernel_log_peer_console_probe_sent[core] = sent + 1;
    }
}

// GitHub issue #534: move each peer's published console records into the
// transmit queue, a whole record at a time. Core 0 only, from two places
// that cannot be in the middle of one of its own lines: syscall entry,
// through kernel_log_peer_drain below, and a timer interrupt taken from
// EL0, through each platform's dispatcher -- the second so that a core 0
// computing in EL0 without a syscall still drains.
//
// A record goes in only when the queue has room for all of it, with
// interrupts masked, so it reaches the wire unbroken and the TX interrupt
// cannot run in between. One that does not fit stays published and the
// next drain takes it. Emergency and DDB paths never wait for any of this:
// with the queue stood down nothing is moved, and whatever is published
// stays there until the queue is live again.
//
// No `logs`, no `locks`: the interrupt dispatcher calls it.
fn kernel_log_peer_console_drain() {
    if (cpu_id() != 0 || terminal_output_paused() || terminal_echo_pending()) { return; }
    if (kernel_log_core_here().emergency || kernel_log_tx_is_live() == false) {
        return;
    }
    let mut record: PeerConsoleRecord;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        let mut draining: bool = true;
        for step: usize in 0..<PEER_CONSOLE_RECORDS {
            if (draining) {
                if (peer_console_ddb_held(cpu)) { draining = false; }
            }
            if (draining) {
                let irq_flags: usize = mutex_irq_save();
                match peer_console_peek(cpu, &record) {
                    PeerConsolePeek::Empty => { draining = false; }
                    PeerConsolePeek::Ready(length) => {
                        let count: usize = kernel_log_tx_count;
                        if (count > KERNEL_LOG_TX_QUEUE_BYTES ||
                            KERNEL_LOG_TX_QUEUE_BYTES - count < length) {
                            draining = false;
                        } else {
                            for i: usize in 0..<PEER_CONSOLE_RECORD_BYTES {
                                if (i < length) {
                                    kernel_log_note_tx_byte();
                                    let pushed: bool =
                                        kernel_log_tx_push_terminal(record.bytes[i]);
                                }
                            }
                            uart_tx_drain_into_fifo();
                            let still_pending: bool = uart_terminal_output_pending();
                            if (still_pending) { uart_tx_irq_enable(); }
                            let waited: usize = kernel_log_peer_note_drained(cpu);
                            if (waited > kernel_log_peer_worst_ticks) {
                                kernel_log_peer_worst_ticks = waited;
                                kernel_log_peer_worst_cpu = cpu;
                                kernel_log_peer_worst_length = length;
                                for first: usize in 0..<8 {
                                    if (first < length) {
                                        kernel_log_peer_worst_first[first] =
                                            record.bytes[first];
                                    } else { kernel_log_peer_worst_first[first] = 0; }
                                }
                            }
                            peer_console_retire(cpu);
                        }
                    }
                }
                mutex_irq_restore(irq_flags);
            }
        }
    }
}

fn kernel_log_peer_drain() !{unsafe} {
    if (cpu_id() != 0) { return; }
    kernel_log_terminal_flow_poll();
    kernel_log_peer_console_drain();
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        let mut expected: usize = kernel_log_peer_consumed[cpu] + 1;
        let latest_words: *usize = kernel_log_peer_latest;
        let latest: usize = unsafe {
            atomic_load_acquire((latest_words + (cpu as isize)) as usize)
        };
        if (latest >= expected + KERNEL_LOG_PEER_RECORDS) {
            expected = latest - KERNEL_LOG_PEER_RECORDS + 1;
            kernel_boot_log("kernel log: peer records overwritten\n");
        }
        let mut remaining: usize = KERNEL_LOG_PEER_RECORDS;
        while (expected <= latest && remaining != 0) {
            remaining = remaining - 1;
            let slot: usize = cpu * KERNEL_LOG_PEER_RECORDS +
                ((expected - 1) % KERNEL_LOG_PEER_RECORDS);
            if (slot >= KERNEL_LOG_PEER_SLOTS) { return; }
            let safe_slot: {0..<KERNEL_LOG_PEER_SLOTS as usize} = slot;
            let published: *usize = kernel_log_peer_published;
            let first: usize = unsafe {
                atomic_load_acquire((published + (slot as isize)) as usize)
            };
            if (first != expected) { return; }
            let length: usize = kernel_log_peer_lengths[safe_slot];
            let truncated: bool = kernel_log_peer_truncated[safe_slot];
            let peer_tick: i64 = kernel_log_peer_ticks[safe_slot];
            let mut copy: [u8; KERNEL_LOG_PEER_LINE_BYTES];
            for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
                if (index < length) {
                    let offset: usize = slot * KERNEL_LOG_PEER_LINE_BYTES + index;
                    if (offset < KERNEL_LOG_PEER_TEXT_BYTES) {
                        let safe_offset: {0..<KERNEL_LOG_PEER_TEXT_BYTES as usize} = offset;
                        copy[index] = kernel_log_peer_text[safe_offset];
                    }
                }
            }
            let second: usize = unsafe {
                atomic_load_acquire((published + (slot as isize)) as usize)
            };
            if (second != expected) { return; }
            // Attribute the record to the core that WROTE it, with the tick
            // that core took. Cleared straight after the line so nothing
            // afterwards inherits a peer's identity.
            kernel_log_deferred_cpu = cpu;
            kernel_log_deferred_tick = peer_tick;
            kernel_log_deferred = true;
            kernel_log_begin_fragment();
            for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
                if (index < length) { uart_putc(copy[index]); }
            }
            if (truncated) {
                kernel_boot_log("... [peer line truncated]\n");
            }
            kernel_log_deferred = false;
            kernel_log_peer_consumed[cpu] = expected;
            expected = expected + 1;
        }
    }
}

// Terminal exception paths must remain visible on every CPU and must not
// depend on ordinary line assembly. This bypass lasts until the next boot.
fn kernel_log_enter_emergency() {
    kernel_log_core_here().emergency = true;
    kernel_log_core_here().suppressed = false;
    // Terminal stack guards can park without entering crash_console_run.
    // Flush the owner queue here so neither their last line nor its prompt
    // depends on an interrupt after the terminal path masks IRQs. A peer
    // never touches this core-0 queue and already uses polling UART output.
    //
    // Terminal on purpose, so the token is matched and dropped rather than
    // discarded: GitHub issue #531 made that a decision the compiler asks
    // for, which is what stops a path that DOES return from forgetting.
    match kernel_log_tx_stand_down() {
        KernelLogTxStandDown::WasLive => { }
        KernelLogTxStandDown::WasSpinning => { }
        KernelLogTxStandDown::NotConsoleOwner => { }
    }
}

private fn kernel_log_snapshot_push(value: u8) {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    let length: usize = snapshot.length;
    if (length < KERNEL_LOG_SNAPSHOT_CAPACITY) {
        let safe_length:
            {0..<KERNEL_LOG_SNAPSHOT_CAPACITY as usize} = length;
        snapshot.bytes[safe_length] = value;
        snapshot.length = length + 1;
    }
}

private fn kernel_log_snapshot_text(text: *u8) {
    while (*text != 0) {
        kernel_log_snapshot_push(*text);
        text = text + 1;
    }
}

private fn kernel_log_snapshot_decimal6(value: usize) {
    let mut place_values: [usize; 6] =
        { 100000, 10000, 1000, 100, 10, 1 };
    for position: usize in 0..<6 {
        let divisor: usize = place_values[position];
        if (divisor != 0) {
            let digit: usize = (value / divisor) % 10;
            kernel_log_snapshot_push((digit + 48) as u8);
        }
    }
}

private fn kernel_log_snapshot_timestamp(ticks: i64) {
    let mut seconds: usize = 0;
    let mut micros: usize = 0;
    if (ticks >= 0 && kernel_log_frequency > 0) {
        let tick_count: usize = ticks as usize;
        let frequency: usize = kernel_log_frequency as usize;
        if (frequency == 0) { return; }
        seconds = tick_count / frequency;
        let remainder: usize = tick_count % frequency;
        match checked_mul_usize(remainder, 1000000) {
            CheckedUsize::Overflow => { micros = 0; }
            CheckedUsize::Value(scaled) => { micros = scaled / frequency; }
        }
    }
    kernel_log_snapshot_push(91);
    kernel_log_snapshot_decimal6(seconds % 1000000);
    kernel_log_snapshot_push(46);
    kernel_log_snapshot_decimal6(micros);
    kernel_log_snapshot_push(93);
    kernel_log_snapshot_push(32);
}

// What copying one record came to.
enum KernelLogRecordCopy { Kept; Lost; }

// Record `record` into this CPU's snapshot, or nothing, by the protocol at
// the top of this file. `second_check` false is the negative control's
// reader, which trusts whatever it copied; `overwrite_mid_copy` has core 0's
// own ring overwrite the slot after the first text byte is copied, which is
// what makes that control deterministic. Both are false for syslog(2).
private fn kernel_log_snapshot_record(record: usize, second_check: bool,
                                      overwrite_mid_copy: bool)
        -> KernelLogRecordCopy !{unsafe} {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    let mark: usize = snapshot.length;
    let slot: usize = record % KERNEL_LOG_RECORD_COUNT;
    let safe_slot: {0..<KERNEL_LOG_RECORD_COUNT as usize} = slot;
    // Not yet stamped with this record -- still being begun, or already
    // replaced -- and there is nothing of it to copy.
    if (kernel_log_observe(&kernel_log_stamps[safe_slot]) != record + 1) {
        return KernelLogRecordCopy::Lost;
    }
    let stored: usize = kernel_log_observe(&kernel_log_lengths[safe_slot]);
    let line_cpu: usize = kernel_log_observe(&kernel_log_cpu[safe_slot]);
    let line_tick: usize = kernel_log_observe(&kernel_log_ticks[safe_slot]);
    kernel_log_snapshot_timestamp(line_tick as i64);
    // GitHub issue #465: a core column, printed only for a core that is not
    // the console owner. Every line a single-core boot retains is core 0's,
    // so its dmesg is byte-identical to what it was -- and a peer's line is
    // the one that could not previously be told from core 0's at all.
    if (line_cpu != 0) {
        kernel_log_snapshot_text("cpu" as *u8);
        kernel_log_snapshot_push(((line_cpu % 10) + 48) as u8);
        kernel_log_snapshot_push(32);
    }
    let length: usize = stored & KERNEL_LOG_LENGTH_MASK;
    for byte_index: usize in 0..<KERNEL_LOG_TEXT_MAX {
        if (byte_index < length) {
            let offset: usize = slot * KERNEL_LOG_TEXT_MAX + byte_index;
            let word_index: usize = offset / 8;
            if (word_index < KERNEL_LOG_TEXT_WORDS) {
                let safe_word: {0..<KERNEL_LOG_TEXT_WORDS as usize} =
                    word_index;
                let word: usize =
                    kernel_log_observe(&kernel_log_text[safe_word]);
                kernel_log_snapshot_push(
                    ((word >> ((offset % 8) * 8)) & 0xFF) as u8);
            }
            if (byte_index == 0 && overwrite_mid_copy) {
                kernel_log_overwrite_slot_for_probe(record);
            }
        }
    }
    if ((stored & KERNEL_LOG_LENGTH_TRUNCATED) != 0) {
        kernel_log_snapshot_text("... [line truncated]\n" as *u8);
    }
    // The slot was reused if core 0 has since begun the record that takes
    // it over: record + KERNEL_LOG_RECORD_COUNT.
    if (second_check &&
        kernel_log_observe(&kernel_log_started) >
            record + KERNEL_LOG_RECORD_COUNT) {
        snapshot.length = mark;
        return KernelLogRecordCopy::Lost;
    }
    return KernelLogRecordCopy::Kept;
}

// A partial final line is included. Long lines, records the ring had already
// overwritten, and records overwritten while this copied them are each
// reported explicitly instead of being presented as complete history.
fn kernel_log_snapshot_build() -> usize !{unsafe} {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    snapshot.length = 0;
    let end: usize = kernel_log_observe(&kernel_log_started);
    let mut begin: usize = 0;
    if (end > KERNEL_LOG_RECORD_COUNT) {
        begin = end - KERNEL_LOG_RECORD_COUNT;
    }
    if (begin != 0) {
        kernel_log_snapshot_text("<4>kernel log: overwritten records=" as *u8);
        kernel_log_snapshot_decimal6(begin % 1000000);
        kernel_log_snapshot_push(10);
    }
    let mut lost: usize = 0;
    for index: usize in 0..<KERNEL_LOG_RECORD_COUNT {
        if (begin + index < end) {
            match kernel_log_snapshot_record(begin + index, true, false) {
                KernelLogRecordCopy::Kept => {}
                KernelLogRecordCopy::Lost => { lost = lost + 1; }
            }
        }
    }
    if (lost != 0) {
        kernel_log_snapshot_text(
            "<4>kernel log: records overwritten while read=" as *u8);
        kernel_log_snapshot_decimal6(lost % 1000000);
        kernel_log_snapshot_push(10);
    }
    return snapshot.length;
}

fn kernel_log_snapshot_capacity() -> usize {
    return KERNEL_LOG_SNAPSHOT_CAPACITY;
}

fn kernel_log_snapshot_copy(offset: usize, destination: []u8) -> usize {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    let snapshot_length: usize = snapshot.length;
    if (offset >= snapshot_length) { return 0; }
    let mut amount: usize = destination.len;
    if (amount > snapshot_length - offset) {
        amount = snapshot_length - offset;
    }
    let mut index: usize = 0;
    while (index < amount) {
        let source_index: usize = match checked_add_usize(offset, index) {
            CheckedUsize::Overflow => { return index; }
            CheckedUsize::Value(value) => { value }
        };
        if (source_index < KERNEL_LOG_SNAPSHOT_CAPACITY &&
            index < destination.len) {
            let safe_source:
                {0..<KERNEL_LOG_SNAPSHOT_CAPACITY as usize} = source_index;
            destination[index] = snapshot.bytes[safe_source];
        }
        index = index + 1;
    }
    return amount;
}

// One retained record "<byte><byte>\n", written the way core 0 writes any.
private fn kernel_log_probe_record(byte: u8) {
    kernel_log_begin_fragment();
    let first: bool = kernel_log_capture_uart_byte(byte);
    let second: bool = kernel_log_capture_uart_byte(byte);
    let newline: bool = kernel_log_capture_uart_byte(10);
}

// The negative control's writer: core 0 begins records until `record`'s
// slot has been taken over, each "bb\n", as a writer on another CPU would
// during a peer's copy.
private fn kernel_log_overwrite_slot_for_probe(record: usize) {
    for step: usize in 0..<KERNEL_LOG_RECORD_COUNT {
        if (kernel_log_started <= record + KERNEL_LOG_RECORD_COUNT) {
            kernel_log_probe_record(98);
        }
    }
}

// GitHub issue #612's negative control, deterministic because the overwrite
// is injected between a record's first and second text byte. The checked
// reader must drop the record and leave nothing of it in the snapshot; the
// reader that skips the second count must return it torn -- 'a' then 'b' --
// which is what the check exists to catch.
private fn kernel_log_torn_read_probe() -> bool !{unsafe} {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    kernel_log_probe_record(97);
    snapshot.length = 0;
    let checked_record: usize = kernel_log_started - 1;
    match kernel_log_snapshot_record(checked_record, true, true) {
        KernelLogRecordCopy::Kept => { return false; }
        KernelLogRecordCopy::Lost => {}
    }
    if (snapshot.length != 0) { return false; }
    kernel_log_probe_record(97);
    let unchecked_record: usize = kernel_log_started - 1;
    match kernel_log_snapshot_record(unchecked_record, false, true) {
        KernelLogRecordCopy::Lost => { return false; }
        KernelLogRecordCopy::Kept => {}
    }
    // "[000000.000000] " then the text.
    return snapshot.length >= 18 && snapshot.bytes[16] == 97 &&
        snapshot.bytes[17] == 98;
}

// Destructive boot-time probe, followed immediately by kernel_log_init(). It
// exercises both bounded-loss signals without emitting 257 UART lines, and
// #612's torn-read control.
fn kernel_log_bounds_probe() -> bool {
    for record: usize in 0..<257 {
        kernel_log_begin_fragment();
        kernel_log_capture_uart_byte(120);
        kernel_log_capture_uart_byte(10);
    }
    if (kernel_log_overwritten != 1 ||
        kernel_log_count != KERNEL_LOG_RECORD_COUNT) {
        return false;
    }
    let snapshot_length: usize = kernel_log_snapshot_build();
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    if (snapshot_length < 3 || snapshot.bytes[0] != 60 ||
        snapshot.bytes[1] != 52 || snapshot.bytes[2] != 62) {
        return false;
    }
    if (kernel_log_torn_read_probe() == false) { return false; }
    kernel_log_begin_fragment();
    for byte_index: usize in 0..<161 {
        kernel_log_capture_uart_byte(121);
    }
    let slot: usize = kernel_log_active_slot;
    if (slot >= 256) { return false; }
    let safe_slot: {0..<256 as usize} = slot;
    if ((kernel_log_lengths[safe_slot] & KERNEL_LOG_LENGTH_TRUNCATED) == 0) {
        return false;
    }
    // A fatal report must bypass even an unfinished suppressed line, and
    // must leave the retained partial line untouched. init resets this mode
    // immediately after the destructive boot probe.
    let retained_length: usize = kernel_log_lengths[safe_slot];
    kernel_log_core_here().suppressed = true;
    // Arrange the live-queue case without emitting artificial bytes. A
    // terminal writer must leave polling selected even without the later
    // crash-console entry; stack-guard fail-stop has no such continuation.
    kernel_log_tx_activate();
    kernel_log_enter_emergency();
    kernel_log_begin_fragment();
    let visible: bool = kernel_log_capture_uart_byte(122);
    return visible && kernel_log_core_here().suppressed == false &&
        kernel_log_tx_is_live() == false &&
        kernel_log_lengths[safe_slot] == retained_length;
}

// Hexadecimal with its `0x`, through the log ring.
//
// GitHub issue #470 follow-up: the digits are kernel/printk/number.tkb's,
// where a host test can reach them; the prefix is here because it goes
// through kernel_boot_log, which begins a log fragment. Emitting it with
// two uart_putc calls instead would print the same characters and record a
// different line structure.
fn uart_put_hex(value: usize) {
    kernel_boot_log("0x");
    uart_put_hex_digits(value);
}

// Same reasoning as uart_put_hex above, for strings: uart_putc IS the
// device and stays per-platform, but walking a NUL-terminated string is
// not, and this body was byte-identical in kernel/platform/qemu/uart.tkb
// and kernel/platform/rpi5/uart.tkb. That is the shape issue #470 was
// made of -- two copies of platform-independent code in platform files,
// free to drift, with only one of them read on any given boot.
fn uart_puts(s: *u8) {
    while (*s != 0) {
        uart_putc(*s);
        s = s + 1;
    }
}

fn kernel_boot_log(message: *u8) {
    kernel_log_begin_fragment();
    uart_puts(message);
    kernel_log_end_fragment();
}

fn kernel_boot_log_syscall_unreachable(number: usize) {
    kernel_boot_log("syscall dispatch: unreachable action, syscall=" as *u8);
    uart_put_udec(number);
    kernel_boot_log("\n" as *u8);
}

fn kernel_boot_log_resource_exhausted(resource: *u8, capacity: usize) {
    kernel_boot_log("resource exhausted: " as *u8);
    uart_puts(resource);
    kernel_boot_log(" capacity=" as *u8);
    uart_put_udec(capacity);
    kernel_boot_log("\n" as *u8);
}

// Ordinary retained kernel text remains a core-0 stream. Other cores divert
// a kernel_boot_log logical line at uart_putc into a peer record until the
// fragment that completes it returns, so fragments cannot split core 0's
// view-sensitive text. The suppression bit is per-core;
// direct userspace UART and the lock-free crash/DDB reporters remain live.
// Re-entry on one core would still alias that core's line state.
fn kernel_log_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "per-core kernel-log line state cannot survive preemption into another writer");
}

// Encode within the available room before publishing. CPU 0 masks IRQs
// across the room query and enqueue; a peer has one non-preemptible producer
// and its consumer can only increase the available space. Thus a CR/LF pair
// is admitted together, and a short write always counts whole input bytes.
fn uart_terminal_write_chunk(bytes: borrow []u8, convert: bool) -> usize {
    if (convert == false) { return uart_user_write(bytes); }
    let flags: usize = mutex_irq_save();
    let room: usize = uart_user_write_room();
    let mut encoded: [u8; 512];
    let mut accepted: usize = 0;
    match terminal_encode_onlcr(bytes, encoded as [u8; 512..], room) {
        TerminalEncodeResult::NoRoom => { }
        TerminalEncodeResult::Encoded(counts) => {
            let length: usize = counts.output_bytes;
            if (length <= 512) {
                let count: usize = uart_user_write(encoded[0..<length]);
                if (count == length) { accepted = counts.input_bytes; }
            }
        }
    }
    mutex_irq_restore(flags);
    return accepted;
}
