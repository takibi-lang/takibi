// Operator-visible kernel text log. Ordinary kernel_boot_log() output is
// still written synchronously to UART, while logical lines are retained with
// the monotonic time at which their first byte was emitted. Userspace writes
// and the direct crash/DDB UART paths do not enter this ring.
//
// Core 0 remains the only retained-log writer. Other cores publish complete
// bounded kernel lines for core 0 to copy and emit; interrupt-safe classified
// events remain kernel/diagnostic/event.tkb's job. Userspace terminal output
// on every CPU appends to one UART queue under the console lock and never
// enters the retained log.
use "kernel/lib/atomic_word.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/printk/number.tkb";
use "kernel/drivers/serial/terminal.tkb";
use "kernel/drivers/serial/terminal_echo.tkb";
use "kernel/printk/console_lock.tkb";

// GitHub issue #613 (docs/LOG_RING_DESIGN.md, option B): the retained ring is
// fixed slots with one state word each, written through a reservation token
// and read on any CPU with no lock. kernel/models/LogRing.tla is the
// protocol; kernel/models/litmus/LogRing*.litmus are the AArch64 orderings
// it relies on, tied to this code by kernel/models/litmus/emitted_map.txt.
//
// - Sequence s lives in slot s % KERNEL_LOG_SLOT_COUNT. A slot's state word
//   is (seq, cpu, span, state): state Free (never used), Reserved, Committed
//   or Discarded; span is the record's slot count in its first slot and 0,
//   the continuation mark, in the others; cpu is the reserving core.
// - A record of k <= KERNEL_LOG_RECORD_SLOTS slots is reserved with ONE
//   compare-swap on kernel_log_head (h -> h + k), then each slot h + i is
//   claimed by a compare-swap from its previous occupant (h + i - N,
//   Committed or Discarded; Free on the first turn round) to (h + i,
//   Reserved). A previous occupant still Reserved -- a stalled writer -- is
//   not waited for: the reservation is Refused, its slots already claimed
//   are Discarded, its sequences are counted in kernel_log_discarded, and no
//   token exists.
// - The token's holder writes the text, then commits each slot by a release
//   compare-swap (seq, Reserved) -> (seq, Committed), continuations first and
//   the first slot last. Commit and discard consume the token, so a record
//   written after its commit, or reserved and never finished, does not
//   compile.
// - A reader acquire-loads a slot word, requires (seq, Committed), copies
//   with acquire loads, and loads the word again; anything else is in
//   flight, discarded or overwritten, and is reported by sequence count,
//   never returned.
//
// Every compare-swap is acq_rel (CASAL on the RPi5): the claim's acquire
// orders the text stores after it, the commit's release orders them before
// it. The text stores themselves stay release stores (STLR) although the
// claim's acquire already orders them (LogRingRecheck+plain-text): an
// AtomicWord has no plain store, and the text must stay AtomicWord because
// the reader's loads of it must be acquires (LogRingRecheck+unfixed-reader).
//
// Core 0 is still the only writer (#613 slice 4). It stages a line in
// kernel_log_line and reserves when the line ends, so a partial line is never
// visible and no stack buffer holds one. A line longer than the stage is
// split into continuation records, each marked in its metadata, never
// truncated.
const KERNEL_LOG_SLOT_COUNT: usize = 256;
const KERNEL_LOG_SLOT_BYTES: usize = 160;
const KERNEL_LOG_SLOT_WORDS: usize = 20;
const KERNEL_LOG_TEXT_WORDS: usize = 5120;
// The most slots one record spans: 1/64 of the ring, so one long line cannot
// overwrite more than a sliver of the history.
const KERNEL_LOG_RECORD_SLOTS: usize = 4;
const KERNEL_LOG_LINE_BYTES: usize = 640;
const KERNEL_LOG_SNAPSHOT_CAPACITY: usize = 65536;

// The state word: seq << 16 | cpu << 8 | span << 4 | state.
const KERNEL_LOG_STATE_FREE: usize = 0;
const KERNEL_LOG_STATE_RESERVED: usize = 1;
const KERNEL_LOG_STATE_COMMITTED: usize = 2;
const KERNEL_LOG_STATE_DISCARDED: usize = 3;
const KERNEL_LOG_STATE_MASK: usize = 3;
const KERNEL_LOG_SPAN_SHIFT: usize = 4;
const KERNEL_LOG_SPAN_MASK: usize = 15;
const KERNEL_LOG_CPU_SHIFT: usize = 8;
const KERNEL_LOG_CPU_MASK: usize = 255;
const KERNEL_LOG_SEQ_SHIFT: usize = 16;
// The first slot's metadata word: length | cpu << 16 | CONTINUED.
const KERNEL_LOG_META_LENGTH_MASK: usize = 0xFFFF;
const KERNEL_LOG_META_CPU_SHIFT: usize = 16;
// This record continues the previous record's line.
const KERNEL_LOG_META_CONTINUED: usize = 0x1000000;

private let mut kernel_log_text: [AtomicWord; KERNEL_LOG_TEXT_WORDS];
private let mut kernel_log_slots: [AtomicWord; KERNEL_LOG_SLOT_COUNT];
private let mut kernel_log_ticks: [AtomicWord; KERNEL_LOG_SLOT_COUNT];
private let mut kernel_log_meta: [AtomicWord; KERNEL_LOG_SLOT_COUNT];
// The next sequence to reserve.
private let mut kernel_log_head: AtomicWord;
// Sequences a writer gave up (refused or discarded): the writer's report of
// a loss, which readers print rather than infer.
private let mut kernel_log_discarded: AtomicWord;
// Commits that found their slot taken. Zero unless the protocol is broken
// (LogRing.tla's CommitLost); counted so it is not silent.
private let mut kernel_log_commit_lost: AtomicWord;

// Core 0's line being assembled, and when and on which core it began.
private let mut kernel_log_line: [u8; KERNEL_LOG_LINE_BYTES];
private let mut kernel_log_line_length: usize;
private let mut kernel_log_line_tick: i64;
private let mut kernel_log_line_cpu: usize;
private let mut kernel_log_line_continued: bool;
// GitHub issue #465: which core's line this is, and when THAT core emitted it.
//
// A peer's line reaches the ring through core 0's drain, so without these two
// it is recorded as core 0's, timestamped at the moment core 0 got round to
// it. Both are wrong in the direction that matters: a retained log exists to
// attribute concurrency failures, and one that cannot say which core wrote a
// line is least useful exactly when two are interleaving. Until peers write
// the ring themselves (#613 slice 5), the order is arrival-at-core-0, and a
// peer record's tick can be EARLIER than the record before it.
private let mut kernel_log_deferred_cpu: usize;
private let mut kernel_log_deferred_tick: i64;
private let mut kernel_log_deferred: bool;
private let mut kernel_log_capture_enabled: bool;
private let mut kernel_log_active: bool;
private let mut kernel_log_boot_tick: i64;
private let mut kernel_log_frequency: i64;
// One snapshot per CPU: syslog(2) builds it and copies it out in one
// syscall, which since #612 may run on any CPU.
struct KernelLogSnapshot {
    length: usize;
    bytes: [u8; KERNEL_LOG_SNAPSHOT_CAPACITY];
}
private let mut kernel_log_snapshots: [KernelLogSnapshot; KERNEL_MAX_CORES];

private fn kernel_log_snapshot_here() -> *KernelLogSnapshot {
    let base: *KernelLogSnapshot = kernel_log_snapshots;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

// The word stores and loads the protocol above is made of.
private fn kernel_log_publish(word: *AtomicWord, value: usize) !{unsafe} {
    atomic_word_store(word, value);
}

private fn kernel_log_observe(word: *AtomicWord) -> usize !{unsafe} {
    return atomic_word_load(word);
}

// Every compare-swap of the ring, acq_rel. Raw because an AtomicWord's own
// compare-swap is acquire only, and a commit must release
// (LogRingCommit+unfixed-writer); scripts/check_lock_discipline.py lists
// this file for it.
private fn kernel_log_cas(word: *AtomicWord, expected: usize, desired: usize)
        -> CasResult !{unsafe} {
    return unsafe { atomic_compare_swap_acq_rel(word as usize, expected, desired) };
}

private fn kernel_log_word(seq: usize, cpu: usize, span: usize, state: usize)
        -> usize {
    return (seq << KERNEL_LOG_SEQ_SHIFT) |
        ((cpu & KERNEL_LOG_CPU_MASK) << KERNEL_LOG_CPU_SHIFT) |
        ((span & KERNEL_LOG_SPAN_MASK) << KERNEL_LOG_SPAN_SHIFT) | state;
}

private fn kernel_log_word_seq(word: usize) -> usize {
    return word >> KERNEL_LOG_SEQ_SHIFT;
}

private fn kernel_log_word_cpu(word: usize) -> usize {
    return (word >> KERNEL_LOG_CPU_SHIFT) & KERNEL_LOG_CPU_MASK;
}

private fn kernel_log_word_span(word: usize) -> usize {
    return (word >> KERNEL_LOG_SPAN_SHIFT) & KERNEL_LOG_SPAN_MASK;
}

private fn kernel_log_word_state(word: usize) -> usize {
    return word & KERNEL_LOG_STATE_MASK;
}

private fn kernel_log_slot_of(seq: usize) -> {0..<KERNEL_LOG_SLOT_COUNT as usize} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = seq % KERNEL_LOG_SLOT_COUNT;
    return slot;
}

// The reservation token (LogRing.tla's Held). Only this file constructs one,
// in kernel_log_reserve; kernel_log_commit and kernel_log_discard consume it.
// `[unit]` is always 0: an owner needs a static parameter, and the record's
// identity is its private first sequence.
linear struct LogReservation[unit: usize] {
    private seq: usize;
    private span: usize;
    private cpu: usize;
}

must_use variant KernelLogReserve {
    Reserved(LogReservation[0]);
    Refused;
}

// The slot of sequence `seq` may be taken: it was never used, or its
// occupant is finished (Committed or Discarded) and older. Older, not exactly
// seq - N: a refused claim leaves its slot holding an earlier turn's record,
// and requiring seq - N would refuse every later turn of that slot for ever
// (LogRing.tla NoNeedlessRefusal, variant `exactprev`). A slot's sequence only
// grows, so a writer that was overtaken finds a newer one and is refused.
private fn kernel_log_previous_done(current: usize, seq: usize) -> bool {
    let state: usize = kernel_log_word_state(current);
    if (state == KERNEL_LOG_STATE_FREE) { return current == 0; }
    if (state != KERNEL_LOG_STATE_COMMITTED &&
        state != KERNEL_LOG_STATE_DISCARDED) {
        return false;
    }
    return kernel_log_word_seq(current) < seq;
}

// LogRing.tla Claim and Refuse, for one slot: compare-swap the observed
// previous occupant to (seq, Reserved). The observed value is what decides;
// a failed swap is a refusal and never a reason to wait.
private fn kernel_log_claim(seq: usize, cpu: usize, span: usize) -> bool !{unsafe} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
    let current: usize = kernel_log_observe(&kernel_log_slots[slot]);
    if (kernel_log_previous_done(current, seq) == false) { return false; }
    match kernel_log_cas(&kernel_log_slots[slot], current,
                         kernel_log_word(seq, cpu, span,
                                         KERNEL_LOG_STATE_RESERVED)) {
        CasResult::Swapped => { return true; }
        CasResult::Observed(_) => { return false; }
    }
}

// Reserved -> Discarded for the first `claimed` slots of a record this writer
// holds. Nobody else changes a Reserved slot, so each swap succeeds; one that
// does not is counted as a lost commit.
private fn kernel_log_discard_slots(first: usize, cpu: usize, span: usize,
                                    claimed: usize) !{unsafe} {
    for index: usize in 0..<KERNEL_LOG_RECORD_SLOTS {
        if (index < claimed) {
            let seq: usize = first + index;
            let mut mark: usize = 0;
            if (index == 0) { mark = span; }
            let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
            match kernel_log_cas(&kernel_log_slots[slot],
                                 kernel_log_word(seq, cpu, mark,
                                                 KERNEL_LOG_STATE_RESERVED),
                                 kernel_log_word(seq, cpu, mark,
                                                 KERNEL_LOG_STATE_DISCARDED)) {
                CasResult::Swapped => { }
                CasResult::Observed(_) => {
                    atomic_word_fetch_add(&kernel_log_commit_lost, 1);
                }
            }
        }
    }
}

// LogRing.tla Reserve, then Claim or Refuse for each slot. One compare-swap
// on the head takes `span` sequences; another writer moving the head first is
// retried from the value that swap observed.
private fn kernel_log_reserve(span: usize) -> KernelLogReserve !{unsafe} {
    if (span == 0 || span > KERNEL_LOG_RECORD_SLOTS) {
        return KernelLogReserve::Refused;
    }
    let cpu: usize = cpu_id();
    let mut first: usize = kernel_log_observe(&kernel_log_head);
    let mut reserved: bool = false;
    while (reserved == false) {
        match kernel_log_cas(&kernel_log_head, first, first + span) {
            CasResult::Swapped => { reserved = true; }
            CasResult::Observed(now) => { first = now; }
        }
    }
    let mut claimed: usize = 0;
    let mut refused: bool = false;
    for index: usize in 0..<KERNEL_LOG_RECORD_SLOTS {
        if (index < span && refused == false) {
            let mut mark: usize = 0;
            if (index == 0) { mark = span; }
            if (kernel_log_claim(first + index, cpu, mark)) {
                claimed = index + 1;
            } else {
                refused = true;
            }
        }
    }
    if (refused) {
        kernel_log_discard_slots(first, cpu, span, claimed);
        atomic_word_fetch_add(&kernel_log_discarded, span);
        return KernelLogReserve::Refused;
    }
    let mut token: LogReservation[0] = { first, span, cpu };
    return KernelLogReserve::Reserved(token);
}

// LogRing.tla Write: core 0's staged line into the reserved slots, then the
// first slot's tick and metadata. Each store is a release (see the top of
// this file); nothing here is visible until kernel_log_commit.
private fn kernel_log_write(token: borrow LogReservation[0]) !{unsafe} {
    let length: usize = kernel_log_line_length;
    for index: usize in 0..<KERNEL_LOG_RECORD_SLOTS {
        if (index < token.span) {
            let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} =
                kernel_log_slot_of(token.seq + index);
            for word: usize in 0..<KERNEL_LOG_SLOT_WORDS {
                let mut value: usize = 0;
                for byte: usize in 0..<8 {
                    let offset: usize = index * KERNEL_LOG_SLOT_BYTES + word * 8 + byte;
                    if (offset < length && offset < KERNEL_LOG_LINE_BYTES) {
                        let safe_offset: {0..<KERNEL_LOG_LINE_BYTES as usize} = offset;
                        value = value |
                            ((kernel_log_line[safe_offset] as usize) << (byte * 8));
                    }
                }
                let word_index: usize = slot * KERNEL_LOG_SLOT_WORDS + word;
                if (word_index < KERNEL_LOG_TEXT_WORDS) {
                    let safe_word: {0..<KERNEL_LOG_TEXT_WORDS as usize} = word_index;
                    kernel_log_publish(&kernel_log_text[safe_word], value);
                }
            }
        }
    }
    let first: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(token.seq);
    let mut meta: usize = (length & KERNEL_LOG_META_LENGTH_MASK) |
        ((kernel_log_line_cpu & KERNEL_LOG_CPU_MASK) << KERNEL_LOG_META_CPU_SHIFT);
    if (kernel_log_line_continued) { meta = meta | KERNEL_LOG_META_CONTINUED; }
    kernel_log_publish(&kernel_log_ticks[first], kernel_log_line_tick as usize);
    kernel_log_publish(&kernel_log_meta[first], meta);
}

// LogRing.tla Commit (and CommitLost): release compare-swap each slot from
// Reserved to Committed, continuations first and the first slot last, so a
// reader that finds the first slot Committed finds every continuation so.
private fn kernel_log_commit(token: sink LogReservation[0]) !{unsafe} {
    for step: usize in 0..<KERNEL_LOG_RECORD_SLOTS {
        if (step < token.span) {
            let index: usize = token.span - 1 - step;
            let seq: usize = token.seq + index;
            let mut mark: usize = 0;
            if (index == 0) { mark = token.span; }
            let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
            match kernel_log_cas(&kernel_log_slots[slot],
                                 kernel_log_word(seq, token.cpu, mark,
                                                 KERNEL_LOG_STATE_RESERVED),
                                 kernel_log_word(seq, token.cpu, mark,
                                                 KERNEL_LOG_STATE_COMMITTED)) {
                CasResult::Swapped => { }
                CasResult::Observed(_) => {
                    atomic_word_fetch_add(&kernel_log_commit_lost, 1);
                }
            }
        }
    }
}

// Give a reservation up: its slots become Discarded and its sequences are
// counted with the refused ones, so a reader skips them as reported.
private fn kernel_log_discard(token: sink LogReservation[0]) !{unsafe} {
    kernel_log_discard_slots(token.seq, token.cpu, token.span, token.span);
    atomic_word_fetch_add(&kernel_log_discarded, token.span);
}

// The staged line becomes one record. A refusal is already counted.
private fn kernel_log_retain_line() !{unsafe} {
    let length: usize = kernel_log_line_length;
    if (length == 0) { return; }
    let span: usize = (length + KERNEL_LOG_SLOT_BYTES - 1) / KERNEL_LOG_SLOT_BYTES;
    match kernel_log_reserve(span) {
        KernelLogReserve::Reserved(token) => {
            kernel_log_write(token);
            kernel_log_commit(token);
        }
        KernelLogReserve::Refused => { }
    }
    kernel_log_line_length = 0;
}
// Peer capture lasts through every numeric/string fragment until the fragment
// that completes the line returns (kernel_log_end_fragment);
// DDB writes directly to the device and terminal crash reporting explicitly
// enters emergency mode before using the ordinary formatting helpers.
const KERNEL_LOG_PEER_LINE_BYTES: usize = 192;
const KERNEL_LOG_PEER_RECORDS: usize = 8;
// One run of KERNEL_LOG_PEER_RECORDS per core the build reserves, and
// KERNEL_LOG_PEER_LINE_BYTES of text per slot. Literal, because an array
// bound cannot be a product expression; kernel_log_peer_publish asserts
// both products. At sixteen, cores 2 and 3 computed a slot past the end
// and their lines were dropped with nothing saying so.
const KERNEL_LOG_PEER_SLOTS: usize = 32;
const KERNEL_LOG_PEER_TEXT_BYTES: usize = 6144;
struct KernelLogCoreState {
    suppressed: bool;
    emergency: bool;
    peer_length: usize;
    peer_truncated: bool;
    peer_sequence: usize;
    peer_line: [u8; KERNEL_LOG_PEER_LINE_BYTES];
}
private let mut kernel_log_core_state: [KernelLogCoreState; KERNEL_MAX_CORES];
private let mut kernel_log_peer_published:
    [AtomicWord; KERNEL_LOG_PEER_SLOTS];
private let mut kernel_log_peer_latest: [AtomicWord; KERNEL_MAX_CORES];
private let mut kernel_log_peer_lengths: [usize; KERNEL_LOG_PEER_SLOTS];
private let mut kernel_log_peer_truncated: [bool; KERNEL_LOG_PEER_SLOTS];
// GitHub issue #465: when the PEER emitted this line, not when core 0
// drained it. The two differ by however long core 0 took to come back.
private let mut kernel_log_peer_ticks: [i64; KERNEL_LOG_PEER_SLOTS];
private let mut kernel_log_peer_text: [u8; KERNEL_LOG_PEER_TEXT_BYTES];
private let mut kernel_log_peer_consumed: [usize; KERNEL_MAX_CORES];

private fn kernel_log_core_here() -> *KernelLogCoreState {
    let base: *KernelLogCoreState = kernel_log_core_state;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

fn kernel_log_init() {
    kernel_log_core_here().suppressed = false;
    kernel_log_core_here().emergency = false;
    kernel_log_core_here().peer_length = 0;
    kernel_log_core_here().peer_truncated = false;
    kernel_log_core_here().peer_sequence = 0;
    kernel_log_capture_enabled = false;
    kernel_log_active = false;
    kernel_log_line_length = 0;
    kernel_log_line_continued = false;
    kernel_log_boot_tick = read_cntpct();
    kernel_log_frequency = read_cntfrq();
    // A reset, not a reuse: every slot goes back to Free and every count to
    // zero. Core 0 only, before any reader can run (boot, and the bounds
    // probe that ends by calling this).
    for slot: usize in 0..<KERNEL_LOG_SLOT_COUNT {
        kernel_log_publish(&kernel_log_slots[slot], 0);
    }
    kernel_log_publish(&kernel_log_discarded, 0);
    kernel_log_publish(&kernel_log_commit_lost, 0);
    kernel_log_publish(&kernel_log_head, 0);
}

// A line begins: staged on core 0 until its newline. A drained peer line
// carries its own core and its own tick; anything else is this core now.
private fn kernel_log_start_line() {
    let mut line_cpu: usize = cpu_id();
    let mut line_tick: i64 = read_cntpct() - kernel_log_boot_tick;
    if (kernel_log_deferred) {
        line_cpu = kernel_log_deferred_cpu;
        line_tick = kernel_log_deferred_tick;
    }
    kernel_log_line_cpu = line_cpu;
    kernel_log_line_tick = line_tick;
    kernel_log_line_length = 0;
    kernel_log_line_continued = false;
    kernel_log_active = true;
}

// Keeping the active flag set across a fragment without '\n' captures
// uart_put_udec/uart_put_hex output between fragments in the same line.
fn kernel_log_begin_fragment() {
    if (kernel_log_core_is_emergency()) { return; }
    // The current record arrays and UART line assembly have one writer.
    // Admitting secondary-core ordinary text would create silent retained-log
    // corruption and split physical UART lines.
    if (cpu_id() != 0) {
        kernel_log_core_here().suppressed = true;
        return;
    }
    kernel_log_capture_enabled = true;
}

// A peer's fragment ends here. Suppression lasts until the line is complete,
// so a line built from several fragments (a label, uart_put_udec digits, then
// "\n") is still one record. Only a fragment that leaves no partial line
// behind lets the peer's later direct bytes through again.
fn kernel_log_end_fragment() {
    if (kernel_log_core_is_emergency()) { return; }
    if (cpu_id() == 0) { return; }
    if (kernel_log_core_here().peer_length == 0) {
        kernel_log_core_here().suppressed = false;
    }
}

private fn kernel_log_peer_publish() !{unsafe} {
    static_assert(KERNEL_LOG_PEER_SLOTS ==
                  KERNEL_MAX_CORES * KERNEL_LOG_PEER_RECORDS,
                  "one run of peer records per core the build reserves");
    static_assert(KERNEL_LOG_PEER_TEXT_BYTES ==
                  KERNEL_LOG_PEER_SLOTS * KERNEL_LOG_PEER_LINE_BYTES,
                  "one line of text per peer record slot");
    let cpu: usize = cpu_id();
    if (cpu == 0 || cpu >= KERNEL_MAX_CORES) { return; }
    let sequence: usize = kernel_log_core_here().peer_sequence + 1;
    kernel_log_core_here().peer_sequence = sequence;
    let slot: usize = cpu * KERNEL_LOG_PEER_RECORDS +
        ((sequence - 1) % KERNEL_LOG_PEER_RECORDS);
    if (slot >= KERNEL_LOG_PEER_SLOTS) { return; }
    let safe_slot: {0..<KERNEL_LOG_PEER_SLOTS as usize} = slot;
    kernel_log_publish(&kernel_log_peer_published[safe_slot], 0);
    let length: usize = kernel_log_core_here().peer_length;
    kernel_log_peer_lengths[safe_slot] = length;
    kernel_log_peer_truncated[safe_slot] = kernel_log_core_here().peer_truncated;
    kernel_log_peer_ticks[safe_slot] = read_cntpct() - kernel_log_boot_tick;
    for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
        if (index < length) {
            let offset: usize = slot * KERNEL_LOG_PEER_LINE_BYTES + index;
            if (offset < KERNEL_LOG_PEER_TEXT_BYTES) {
                let safe_offset: {0..<KERNEL_LOG_PEER_TEXT_BYTES as usize} = offset;
                kernel_log_peer_text[safe_offset] = kernel_log_core_here().peer_line[index];
            }
        }
    }
    let safe_cpu: {0..<KERNEL_MAX_CORES as usize} = cpu;
    kernel_log_publish(&kernel_log_peer_published[safe_slot], sequence);
    kernel_log_publish(&kernel_log_peer_latest[safe_cpu], sequence);
    kernel_log_core_here().peer_length = 0;
    kernel_log_core_here().peer_truncated = false;
}

// GitHub issue #454: what the console costs its callers, in the units the
// caller pays. `uart_putc` spins on PL011 TXFF, so once the 16-entry FIFO is
// full a byte costs its whole transmission time -- 86.8us at RPi5's 115207
// baud -- in the calling process's own time, and a 180-character line is a
// whole 15.625ms scheduler tick.
//
// That much is arithmetic. What the issue could not say is the SHARE: "some
// unknown fraction of boot time is this loop". So the loop times itself. Two
// counter reads per byte against a wait that is three orders of magnitude
// longer is not a measurement that changes what it measures.
//
// Counted here rather than in the two platform drivers so both report one
// number through one path. Secondary-core ordinary lines are suppressed, so
// these counters retain their original meaning: core 0's console cost.
private let mut kernel_log_tx_spin_ticks: usize = 0;
private let mut kernel_log_tx_bytes: usize = 0;
// Bytes that had to WAIT, which is no longer every byte: once the queue is
// live a caller usually returns without touching the FIFO at all, and the
// share that still spins is what says whether the queue is big enough.
private let mut kernel_log_tx_spun: usize = 0;

fn kernel_log_note_tx_byte() {
    if (cpu_id() != 0) { return; }
    kernel_log_tx_bytes = kernel_log_tx_bytes + 1;
}

fn kernel_log_note_tx_spin(ticks: i64) {
    if (cpu_id() != 0) { return; }
    kernel_log_tx_spun = kernel_log_tx_spun + 1;
    if (ticks > 0) {
        kernel_log_tx_spin_ticks = kernel_log_tx_spin_ticks + (ticks as usize);
    }
}

fn kernel_log_tx_spin_ticks_total() -> usize {
    return kernel_log_tx_spin_ticks;
}

fn kernel_log_tx_byte_total() -> usize {
    return kernel_log_tx_bytes;
}

fn kernel_log_tx_spun_total() -> usize {
    return kernel_log_tx_spun;
}

// GitHub issue #454: the transmit queue, and the switch that decides whether
// a caller queues or spins.
//
// Measured before it existed: 2519 ms of an RPi5 boot spent inside
// `uart_putc`'s TXFF wait, 78.9us per byte against the wire's own 86.8us --
// the 16-entry FIFO absorbs a burst once and is full for the rest of a line,
// so a caller waits out very nearly the whole transmission of every byte.
//
// SIZE, from the shape of the output rather than a pick. The producer is far
// faster than the wire but is not continuously ahead of it: the boot moves
// 31919 bytes over about 20 s, which is 14% of what the wire could carry in
// that time. What costs is the BURST -- a line up to 180 characters arrives
// with no gaps, and everything past the FIFO's 16 waits. A queue that holds
// the largest burst removes the common case; one that tries to hold the
// dmesg replay, ~90 lines back to back, would have to be as large as the
// replay and would still fill. 512 bytes is a little under three
// maximum-length lines, and what it does not absorb is the case where the
// producer is genuinely wire-bound and ought to wait.
//
// OVERFLOW: drain by polling until there is room, never write past the
// queue. Writing the overflowing byte straight to the FIFO would put it
// ahead of everything already queued, which is the one failure a queue makes
// easy and the one this kernel cannot have -- every view compares text.
const KERNEL_LOG_TX_QUEUE_BYTES: usize = 512;
private let mut kernel_log_tx_queue: [u8; KERNEL_LOG_TX_QUEUE_BYTES];
private let mut kernel_log_tx_terminal: [bool; KERNEL_LOG_TX_QUEUE_BYTES];
private let mut kernel_log_terminal_column: usize;
private let mut kernel_log_tx_head: usize = 0;
private let mut kernel_log_tx_tail: usize = 0;
private let mut kernel_log_tx_count: usize = 0;
// GitHub issue #611: the last byte core 0 put on the wire, from any stream
// -- kernel log text, a user write, a drained peer console record -- and
// whether a kernel log line is about to start after one that did not end.
// A shell on a peer wrote `... job control turned off` and its newline in
// two records, core 0 started `profile: begin` between them, and the host
// parser, which reads lines, never saw the record. So a kernel line always
// starts at the beginning of a wire line: core 0 sends one newline of its
// own first when the wire is mid-line. The retained log never sees it.
private let mut kernel_log_wire_last: u8 = 10;
private let mut kernel_log_wire_break_due: bool = false;

// False until the platform has armed its TX interrupt. Early boot runs before
// platform_irq_init(), so a byte queued then would never be drained; DDB and
// the crash console must not depend on interrupts at all. Both therefore
// spin, deliberately, and this says which regime is in effect rather than
// letting anything infer it.
private let mut kernel_log_tx_live: bool = false;

fn kernel_log_tx_is_live() -> bool {
    return kernel_log_tx_live;
}

fn kernel_log_tx_activate() {
    kernel_log_tx_live = true;
}

// Put the console back the way it was before the queue existed: everything
// already queued goes out, and every byte after this one spins.
//
// GitHub issue #454 asked for "a flush point before anything that must be on
// the wire before it proceeds". A single flush is not enough for a TERMINAL
// path. The crash console runs under disable_irq() and then blocks on input
// after each `ddb> `, so a byte still in the queue has nothing left to drain
// it -- the prompt would sit there and the console would look hung. Turning
// the queue off at entry is one statement instead of a flush before every
// write, and it makes the acceptance condition literal: DDB and the crash
// console emit byte-identical output through exactly the path they used
// before this change.
//
// It used to be one-way for the rest of the boot, DDB's `continue` included,
// and for the debugger that was a defect rather than a decision: GitHub issue
// #531. The crash console never returns, so one-way is right there. DDB does
// return -- kernel_ddb_enter is reached only from the two IRQ dispatchers on a
// serial BREAK, so `continue` resumes a kernel that was healthy all along --
// and everything logged after it paid 78.9 us/byte again, turning a
// `console tx spin=81 ms` boot into a 2519 ms one after a single BREAK.
//
// The fix is not `kernel_log_tx_activate()` on the way out: the resume must
// put back the value the stand-down FOUND. platform_irq_init() and
// kernel_log_tx_activate() are adjacent but not atomic, so a BREAK between
// them enters with the queue not yet live, and enabling it there would queue
// bytes that nothing drains -- there is no armed TX interrupt yet. Same rule
// as mutex_irq_restore against enable_irq, and getting that one wrong is what
// removed DDB from RPi5 in the first place.
//
// So the found state is the return value, and it is the only argument the
// resume takes. There is no kernel_log_tx_resume() that reads no saved state,
// which is what "by construction" means here: the shape
// scripts/check_irq_restore_sites.py has to look for lexically in the
// interrupt case is, for this flag, the only shape that type-checks.
//
// NotConsoleOwner is the third answer, and it is not "it was spinning". Core
// 0 owns this flag and this queue; a peer stands nothing down, so a peer must
// put nothing back. Reporting a peer's finding as WasLive would let its
// resume write core 0's flag back to true after core 0 had deliberately
// stood the queue down -- the queue would come back under a terminal path
// with interrupts masked and nothing left to drain it.
must_use variant KernelLogTxStandDown {
    WasLive;
    WasSpinning;
    NotConsoleOwner;
}

fn kernel_log_tx_stand_down() -> KernelLogTxStandDown !{unsafe} {
    if (cpu_id() != 0) { return KernelLogTxStandDown::NotConsoleOwner; }
    let was_live: bool = kernel_log_tx_live;
    uart_tx_flush();
    kernel_log_tx_live = false;
    if (was_live) {
        return KernelLogTxStandDown::WasLive;
    }
    return KernelLogTxStandDown::WasSpinning;
}

// Put back what was found, and nothing else. Re-arming the TX interrupt is
// not this function's business: uart_tx_flush() disabled it, and the next
// queued byte enables it again in uart_putc, so the flag is the whole of the
// state a stand-down took away.
//
// must_use on the token is what makes a terminal path say so out loud: the
// crash console has to match its stand-down and decide, rather than dropping
// it, and a path that DOES return cannot forget.
fn kernel_log_tx_resume(previous: KernelLogTxStandDown) {
    match previous {
        KernelLogTxStandDown::WasLive => { kernel_log_tx_live = true; }
        KernelLogTxStandDown::WasSpinning => { }
        KernelLogTxStandDown::NotConsoleOwner => { }
    }
}

private fn kernel_log_tx_pending(guard: borrow ConsoleGuard[console_tx_lock]) -> bool {
    return kernel_log_tx_count != 0;
}

private fn kernel_log_tx_full(guard: borrow ConsoleGuard[console_tx_lock]) -> bool {
    return kernel_log_tx_count >= KERNEL_LOG_TX_QUEUE_BYTES;
}

// Under the console lock (GitHub issue #663): the drain runs from the TX
// handler on core 0 and producers run on any CPU, so producer and consumer
// share the count. The guard parameter is what makes a call without the lock
// unwritable. The lock masks interrupts, as the bare mask it replaces did.
private fn kernel_log_tx_push(guard: borrow ConsoleGuard[console_tx_lock],
                              value: u8) -> bool {
    if (kernel_log_tx_count >= KERNEL_LOG_TX_QUEUE_BYTES) { return false; }
    let slot: usize = kernel_log_tx_tail;
    if (slot >= KERNEL_LOG_TX_QUEUE_BYTES) { return false; }
    let safe_slot: {0..<KERNEL_LOG_TX_QUEUE_BYTES as usize} = slot;
    kernel_log_tx_queue[safe_slot] = value;
    kernel_log_tx_terminal[safe_slot] = false;
    kernel_log_terminal_column_byte(guard, value);
    kernel_log_wire_last = value;
    kernel_log_tx_tail = slot + 1;
    if (kernel_log_tx_tail >= KERNEL_LOG_TX_QUEUE_BYTES) {
        kernel_log_tx_tail = 0;
    }
    kernel_log_tx_count = kernel_log_tx_count + 1;
    return true;
}

// Tags keep a signal flush from discarding queued kernel diagnostics.
private fn kernel_log_tx_push_terminal(
        guard: borrow ConsoleGuard[console_tx_lock], value: u8) -> bool {
    let slot: usize = kernel_log_tx_tail;
    if (kernel_log_tx_push(guard, value) == false) { return false; }
    if (slot < KERNEL_LOG_TX_QUEUE_BYTES) { kernel_log_tx_terminal[slot] = true; }
    return true;
}

private fn kernel_log_terminal_column_byte(
        guard: borrow ConsoleGuard[console_tx_lock], value: u8) {
    if (value == 13) { kernel_log_terminal_column = 0; }
    else if (value == 8) {
        if (kernel_log_terminal_column != 0) {
            kernel_log_terminal_column = kernel_log_terminal_column - 1;
        }
    } else if (value == 9) {
        kernel_log_terminal_column = (kernel_log_terminal_column + 8) & ~7;
    } else if (value >= 32 && value != 127) {
        kernel_log_terminal_column = (kernel_log_terminal_column + 1) % 65536;
    }
}

fn uart_terminal_column() -> usize {
    let guard = console_lock();
    let column: usize = kernel_log_terminal_column;
    console_unlock(guard);
    return column;
}

// CPU 0, IRQs masked. Input signals flush terminal output, while kernel
// records survive. All terminal producers share this queue and guard.
fn uart_terminal_flush_output() {
    let guard = console_lock();
    terminal_echo_reset();
    let count: usize = kernel_log_tx_count;
    let head: usize = kernel_log_tx_head;
    let mut kept: usize = 0;
    for offset: usize in 0..<KERNEL_LOG_TX_QUEUE_BYTES {
        if (offset < count) {
            let source: usize = (head + offset) % KERNEL_LOG_TX_QUEUE_BYTES;
            if (source < KERNEL_LOG_TX_QUEUE_BYTES &&
                kernel_log_tx_terminal[source] == false) {
                let target: usize = (head + kept) % KERNEL_LOG_TX_QUEUE_BYTES;
                if (target < KERNEL_LOG_TX_QUEUE_BYTES) {
                    kernel_log_tx_queue[target] = kernel_log_tx_queue[source];
                    kernel_log_tx_terminal[target] = false;
                    kept = kept + 1;
                }
            }
        }
    }
    kernel_log_tx_count = kept;
    kernel_log_tx_tail = (head + kept) % KERNEL_LOG_TX_QUEUE_BYTES;
    console_unlock(guard);
}

must_use variant KernelLogTxByte { Empty; Byte(u8); }

private fn kernel_log_tx_pop(guard: borrow ConsoleGuard[console_tx_lock])
        -> KernelLogTxByte {
    if (kernel_log_tx_count == 0) { return KernelLogTxByte::Empty; }
    let slot: usize = kernel_log_tx_head;
    if (slot >= KERNEL_LOG_TX_QUEUE_BYTES) { return KernelLogTxByte::Empty; }
    let safe_slot: {0..<KERNEL_LOG_TX_QUEUE_BYTES as usize} = slot;
    let value: u8 = kernel_log_tx_queue[safe_slot];
    kernel_log_tx_head = slot + 1;
    if (kernel_log_tx_head >= KERNEL_LOG_TX_QUEUE_BYTES) {
        kernel_log_tx_head = 0;
    }
    kernel_log_tx_count = kernel_log_tx_count - 1;
    return KernelLogTxByte::Byte(value);
}

// GitHub issue #454, and issue #470's rule about where a body belongs. What
// follows is the console's transmit POLICY -- queue or spin, when to drain,
// when to flush -- and none of it is platform-specific. The platform supplies
// four MMIO primitives that genuinely differ by base address
// (uart_tx_fifo_full, uart_tx_store, uart_tx_irq_enable, uart_tx_irq_disable);
// everything built on them lives here, where both platforms read one copy.
// scripts/check_platform_file_parity.py refused the first version of this
// change for exactly that reason, naming all four bodies.
// Wait out the FIFO and write. This is what every byte cost before the queue
// existed, and it is still the whole story for early boot, for DDB, and for a
// queue that has filled.
private fn uart_tx_spin_store(c: u8) !{unsafe} {
    let spin_from: i64 = read_cntpct();
    while (uart_tx_fifo_full()) { }
    kernel_log_note_tx_spin(read_cntpct() - spin_from);
    uart_tx_store(c);
    if (cpu_id() == 0) {
        let guard = console_lock();
        kernel_log_wire_last = c;
        console_unlock(guard);
    }
}

// Only CPU 0 sends UART input-flow requests. Readers on other CPUs publish
// their desired state atomically; coalescing to the latest state cannot leave
// the sender stopped after the receive ring became empty.
private let mut kernel_log_terminal_input_stopped: bool;

fn kernel_log_terminal_flow_poll() !{logs, unsafe} {
    // The decision and the byte it sends are one section, so two callers
    // cannot each send a STOP. uart_wire_byte takes the console lock itself,
    // so the decision is made under a hold of its own and the byte follows;
    // a second caller in between finds the flag already updated and sends
    // nothing.
    let guard = console_lock();
    let wanted: bool = terminal_input_flow_requested();
    let mut control: u8 = 0;
    if (wanted != kernel_log_terminal_input_stopped) {
        kernel_log_terminal_input_stopped = wanted;
        control = terminal_control_byte(8);
        if (wanted) { control = terminal_control_byte(9); }
    }
    console_unlock(guard);
    if (control != 0) { uart_wire_byte(control); }
}

// Echo operations are bounded and never spin in the receive interrupt.
// The caller is CPU 0 with IRQs masked, including the RX handler itself.
fn uart_terminal_echo(operation: TerminalEchoOperation) {
    let guard = console_lock();
    match terminal_echo_push(operation) {
        TerminalEchoPushResult::Queued => {
            match operation {
                TerminalEchoOperation::Byte(value) => {
                    kernel_log_terminal_column_byte(guard, value);
                }
                TerminalEchoOperation::Control(value) => {
                    kernel_log_terminal_column_byte(guard, 94);
                    kernel_log_terminal_column_byte(guard, value);
                }
                TerminalEchoOperation::Erase(columns) => {
                    if (kernel_log_terminal_column >= columns) {
                        kernel_log_terminal_column = kernel_log_terminal_column - columns;
                    } else { kernel_log_terminal_column = 0; }
                }
                TerminalEchoOperation::Newline => { kernel_log_terminal_column = 0; }
            }
        }
        TerminalEchoPushResult::Full => { }
    }
    console_unlock(guard);
}

fn uart_terminal_output_pending() -> bool {
    let guard = console_lock();
    let pending: bool = uart_terminal_output_pending_locked(guard);
    console_unlock(guard);
    return pending;
}

private fn uart_terminal_output_pending_locked(
        guard: borrow ConsoleGuard[console_tx_lock]) -> bool {
    return kernel_log_tx_pending(guard) || terminal_echo_pending();
}

fn uart_terminal_resume_output() !{unsafe} {
    let guard = console_lock();
    if (terminal_output_paused() == false) {
        uart_tx_drain_into_fifo(guard);
        if (uart_terminal_output_pending_locked(guard)) { uart_tx_irq_enable(); }
    }
    console_unlock(guard);
}

// Move queued bytes into the FIFO while both have room. Runs from the TX
// interrupt as well as from the poll-drain paths, so it carries neither
// `logs` nor `locks`: the effect system rejects `locks` on an `!{interrupt}`
// function, and a console that could block on one could not report the
// deadlock it is in.
private fn uart_tx_drain_into_fifo(
        guard: borrow ConsoleGuard[console_tx_lock]) !{unsafe} {
    if (terminal_output_paused()) { return; }
    uart_tx_drain_into_fifo_force(guard);
}

// The transmit interrupt's whole service: drain under the console lock, and
// turn the interrupt off when there is nothing more to send. The lock is let go
// BEFORE the caller (uart_irq_service) takes the run lock to wake a sleeping
// writer -- never across it (kernel/models/ConsoleTx.tla, NESTED).
fn uart_tx_service() !{unsafe} {
    let guard = console_lock();
    uart_tx_drain_into_fifo(guard);
    if (terminal_output_paused() || uart_terminal_output_pending_locked(guard) == false) {
        uart_tx_irq_disable();
    }
    console_unlock(guard);
}

// Fatal/DDB flushes must remain available even after a user sent XOFF.
private fn uart_tx_drain_into_fifo_force(
        guard: borrow ConsoleGuard[console_tx_lock]) !{unsafe} {
    while (uart_terminal_output_pending_locked(guard) && uart_tx_fifo_full() == false) {
        match kernel_log_tx_pop(guard) {
            KernelLogTxByte::Empty => {
                match terminal_echo_read() {
                    TerminalEchoReadResult::Empty => { return; }
                    TerminalEchoReadResult::Byte(value) => { uart_tx_store(value); }
                }
            }
            KernelLogTxByte::Byte(value) => { uart_tx_store(value); }
        }
    }
}

fn uart_putc(c: u8) !{logs, unsafe} {
    if (kernel_log_core_is_emergency()) {
        uart_debug_putc(c);
        return;
    }
    if (kernel_log_capture_uart_byte(c) == false) { return; }
    // A bare peer kernel byte is outside ordinary terminal writes. Complete
    // peer kernel fragments are suppressed and published separately above.
    if (cpu_id() != 0) {
        uart_tx_spin_store(c);
        return;
    }
    let guard = console_lock();
    let break_due: bool = kernel_log_wire_break_due;
    kernel_log_wire_break_due = false;
    console_unlock(guard);
    if (break_due) { uart_wire_byte(10); }
    uart_wire_byte(c);
}

// The column the terminal is at after a byte the console sent without queuing
// it: under the console lock, like every other writer of that word.
private fn kernel_log_column_note(value: u8) {
    let guard = console_lock();
    kernel_log_terminal_column_byte(guard, value);
    console_unlock(guard);
}

// One byte from core 0 onto the wire, queued or spun; uart_putc without
// the retained log's capture.
private fn uart_wire_byte(c: u8) !{logs, unsafe} {
    kernel_log_note_tx_byte();
    // The paused queue belongs to terminal writes. Kernel diagnostics and
    // terminal flow-control bytes remain usable without draining that queue.
    if (terminal_output_paused()) {
        kernel_log_column_note(c);
        uart_tx_spin_store(c);
        return;
    }
    if (kernel_log_tx_is_live() == false) {
        kernel_log_column_note(c);
        uart_tx_spin_store(c);
        return;
    }
    // A full queue is drained by POLLING, never bypassed. Writing this byte
    // straight to the FIFO would put it ahead of everything already queued,
    // and every view in this kernel compares text. The lock is let go while
    // the FIFO is waited out, so the transmit interrupt, which takes it, can
    // make room; the lock's own mask is restored to the state it FOUND, never
    // enabled unconditionally, because kernel_boot_log is reached from paths
    // that already hold IRQs masked.
    let mut queued: bool = false;
    let mut done: bool = false;
    while (done == false) {
        let guard = console_lock();
        if (kernel_log_tx_full(guard)) {
            console_unlock(guard);
            while (uart_tx_fifo_full()) { }
            let drain = console_lock();
            uart_tx_drain_into_fifo(drain);
            console_unlock(drain);
        } else {
            queued = kernel_log_tx_push(guard, c);
            uart_tx_drain_into_fifo(guard);
            let still_pending: bool = uart_terminal_output_pending_locked(guard);
            if (queued && still_pending) { uart_tx_irq_enable(); }
            console_unlock(guard);
            done = true;
        }
    }
    if (queued == false) {
        uart_tx_spin_store(c);
    }
}

// GitHub issue #544: userspace output through the same queue, in chunks,
// and a writer that sleeps rather than spins.
//
// A user write queues only while the queue is at or below its low-water
// mark, half the queue, and then takes as much as there is room for. Above
// the mark it takes nothing, and the syscall layer puts the writer to sleep
// until the TX interrupt has drained the queue back down. That is BSD's
// high/low water rule; without the gap a writer would come back every time
// the FIFO freed a byte, and spin in userspace instead of in the kernel.
//
// Kernel log text keeps its own rule: it polls when the queue is full. The
// kernel cannot sleep at an arbitrary logging call, and one queue keeps the
// order on the wire exactly what the calls made it -- which every view
// compares. Terminal echo has a bounded operation queue of its own; writers
// wait until it drains so a reply cannot overtake the input being echoed.
const KERNEL_LOG_TX_WRITER_LOW_WATER: usize = 256;

// DDB captures these before the console queue is stood down and flushed.
fn kernel_log_tx_queue_count() -> usize {
    return kernel_log_tx_count;
}

fn kernel_log_tx_writer_low_water() -> usize {
    return KERNEL_LOG_TX_WRITER_LOW_WATER;
}

// Every write that found no room waited, and those that had something else
// to run slept. The waits are the deterministic count: on the board a
// write larger than the queue must wait. Whether it sleeps depends on
// whether another process happened to be ready at that moment.
private let mut uart_user_write_waits: usize = 0;
private let mut uart_user_write_sleeps: usize = 0;

// Bytes a user write may queue now on any CPU; zero means wait. Before the
// shared queue is live there is no queue to wait on and the bytes spin as they always have,
// so the answer is the most one call takes.
private fn uart_user_write_room_locked(
        guard: borrow ConsoleGuard[console_tx_lock]) -> usize {
    if (terminal_output_paused()) { return 0; }
    if (terminal_echo_pending()) { return 0; }
    if (kernel_log_tx_is_live() == false) {
        return KERNEL_LOG_TX_QUEUE_BYTES;
    }
    let count: usize = kernel_log_tx_count;
    if (count > KERNEL_LOG_TX_WRITER_LOW_WATER) { return 0; }
    if (count >= KERNEL_LOG_TX_QUEUE_BYTES) { return 0; }
    return KERNEL_LOG_TX_QUEUE_BYTES - count;
}

fn uart_user_write_room() -> usize {
    let guard = console_lock();
    let room: usize = uart_user_write_room_locked(guard);
    console_unlock(guard);
    return room;
}

// Whether the TX interrupt should wake sleeping writers.
fn kernel_log_tx_writer_room() -> bool {
    let guard = console_lock();
    let room: bool = terminal_output_paused() == false && terminal_echo_pending() == false &&
           kernel_log_tx_count <= KERNEL_LOG_TX_WRITER_LOW_WATER;
    console_unlock(guard);
    return room;
}

// Core 0 accounts for completed peer diagnostic records using their
// publication ticks. Terminal chunks no longer have a separate drain ring.
private let mut kernel_log_peer_drained: usize;
private let mut kernel_log_peer_late: usize;
private let mut kernel_log_peer_worst_ticks: usize;
private let mut kernel_log_peer_worst_cpu: usize;
private let mut kernel_log_peer_worst_length: usize;
private let mut kernel_log_peer_worst_first: [u8; 8];

// Printed once, near the end of the boot. `worst` names the diagnostic record that
// waited longest, by its CPU, its length and its first bytes as numbers.
fn kernel_log_peer_console_report() !{logs, unsafe} {
    kernel_boot_log("console: peer records drained=");
    uart_put_udec(kernel_log_peer_drained);
    kernel_boot_log(" late=");
    uart_put_udec(kernel_log_peer_late);
    kernel_boot_log(" worst_ticks=");
    uart_put_udec(kernel_log_peer_worst_ticks);
    kernel_boot_log(" tickfreq=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log("\n");
    if (kernel_log_peer_late != 0) {
        kernel_boot_log("console: peer worst record cpu=");
        uart_put_udec(kernel_log_peer_worst_cpu);
        kernel_boot_log(" length=");
        uart_put_udec(kernel_log_peer_worst_length);
        kernel_boot_log(" first bytes=");
        for i: usize in 0..<8 {
            uart_put_udec(kernel_log_peer_worst_first[i] as usize);
            kernel_boot_log(" ");
        }
        kernel_boot_log("\n");
    }
}

// Under the console lock. Returns how many bytes were taken and whether the
// queue still holds something, so the caller can arm the transmit interrupt
// while the guard still serializes the IRQ mask. Before the queue is live,
// the caller spins byte by byte through uart_putc, which takes the lock itself.
private fn uart_user_write_locked(
        guard: borrow ConsoleGuard[console_tx_lock], bytes: borrow []const u8)
        -> (usize, bool) !{unsafe} {
    if (terminal_output_paused()) { return (0, false); }
    if (terminal_echo_pending()) { return (0, false); }
    let mut taken: usize = 0;
    let mut room: bool = true;
    for index: usize in 0..<KERNEL_LOG_TX_QUEUE_BYTES {
        if (room) {
            if (index < bytes.len) {
                if (kernel_log_tx_full(guard)) {
                    room = false;
                } else {
                    let value: u8 = bytes[index];
                    if (kernel_log_capture_uart_byte_locked(guard, value)) {
                        kernel_log_note_tx_byte();
                        if (kernel_log_tx_push_terminal(guard, value) == false) { room = false; }
                    }
                    if (room) { taken = taken + 1; }
                }
            }
        }
    }
    uart_tx_drain_into_fifo(guard);
    return (taken, uart_terminal_output_pending_locked(guard));
}

// Queue what fits of a user write and return how many bytes that was. Each
// byte gets the bookkeeping uart_putc gives it, in the same order, and a byte
// is only counted once it is certain to be queued, so the one a full queue
// turns away is counted when the retried write takes it.
fn uart_user_write(bytes: borrow []const u8) -> usize !{logs, unsafe} {
    if (terminal_output_paused()) { return 0; }
    if (terminal_echo_pending()) { return 0; }
    if (kernel_log_tx_is_live() == false) {
        let mut spun: usize = 0;
        for index: usize in 0..<KERNEL_LOG_TX_QUEUE_BYTES {
            if (index < bytes.len) {
                uart_putc(bytes[index]);
                spun = spun + 1;
            }
        }
        return spun;
    }
    let guard = console_lock();
    let (taken, still_pending) = uart_user_write_locked(guard, bytes);
    if (still_pending) { uart_tx_irq_enable(); }
    console_unlock(guard);
    return taken;
}

fn uart_user_write_note_wait() {
    let guard = console_lock();
    uart_user_write_waits = uart_user_write_waits + 1;
    console_unlock(guard);
}

fn uart_user_write_wait_total() -> usize {
    let guard = console_lock();
    let total: usize = uart_user_write_waits;
    console_unlock(guard);
    return total;
}

fn uart_user_write_note_sleep() {
    let guard = console_lock();
    uart_user_write_sleeps = uart_user_write_sleeps + 1;
    console_unlock(guard);
}

fn uart_user_write_sleep_total() -> usize {
    let guard = console_lock();
    let total: usize = uart_user_write_sleeps;
    console_unlock(guard);
    return total;
}

// Everything queued reaches the wire before this returns. Called before the
// paths that must not depend on interrupts -- DDB entry, the crash console,
// a halt -- because those write through uart_debug_putc, and a byte they emit
// while the queue still holds earlier output would arrive out of order.
fn uart_tx_flush() !{unsafe} {
    let guard = console_lock();
    while (uart_terminal_output_pending_locked(guard)) {
        while (uart_tx_fifo_full()) { }
        uart_tx_drain_into_fifo_force(guard);
    }
    uart_tx_irq_disable();
    console_unlock(guard);
}

fn kernel_log_capture_uart_byte(value: u8) -> bool {
    // Per-core publication and emergency reporters do not wait for a lock.
    if (kernel_log_capture_is_unshared()) {
        return kernel_log_capture_unshared_byte(value);
    }
    let guard = console_lock();
    let visible: bool = kernel_log_capture_uart_byte_locked(guard, value);
    console_unlock(guard);
    return visible;
}

private fn kernel_log_capture_uart_byte_locked(
        guard: borrow ConsoleGuard[console_tx_lock], value: u8) -> bool {
    if (kernel_log_capture_is_unshared()) {
        return kernel_log_capture_unshared_byte(value);
    }
    if (kernel_log_capture_enabled == false) { return true; }
    if (kernel_log_active == false) {
        if (value == 10) {
            kernel_log_capture_enabled = false;
            return true;
        }
        kernel_log_start_line();
        if (kernel_log_wire_last != 10) { kernel_log_wire_break_due = true; }
    }
    return kernel_log_capture_retained_byte(value);
}

// Read-only per-core mode queries share the one checked selection of the
// current core. Writes remain at the explicit fragment and emergency sites.
private fn kernel_log_core_is_emergency() -> bool {
    return kernel_log_core_here().emergency;
}

private fn kernel_log_core_is_suppressed() -> bool {
    return kernel_log_core_here().suppressed;
}

private fn kernel_log_capture_is_unshared() -> bool {
    return cpu_id() != 0 || kernel_log_core_is_emergency() ||
           kernel_log_core_is_suppressed();
}

private fn kernel_log_capture_unshared_byte(value: u8) -> bool {
    if (kernel_log_core_is_emergency()) { return true; }
    if (kernel_log_core_is_suppressed()) {
        let length: usize = kernel_log_core_here().peer_length;
        if (length < KERNEL_LOG_PEER_LINE_BYTES) {
            let safe_length: {0..<KERNEL_LOG_PEER_LINE_BYTES as usize} = length;
            kernel_log_core_here().peer_line[safe_length] = value;
            kernel_log_core_here().peer_length = length + 1;
        } else { kernel_log_core_here().peer_truncated = true; }
        // A newline ends the record, not the fragment. The rest of the same
        // kernel_boot_log string stays suppressed until the fragment returns
        // (kernel_log_end_fragment). Lifting it here sent the tail of
        // "\nworkload: ..." straight to the UART, while core 0 drained the
        // lone newline record into the middle of it.
        if (value == 10) {
            kernel_log_peer_publish();
        }
        return false;
    }
    // A peer's direct UART byte is not part of core 0's partially assembled
    // retained line, even if the core-0 capture flag happens to be set.
    return true;
}

// Core 0's line is staged here and becomes a record at its newline
// (kernel_log_retain_line). Only the wire boundary decision above needs the
// console guard; the ring's own protocol is independent of terminal writers.
// A line that fills the stage is retained as it stands and continues in the
// next record, marked as a continuation, so nothing is truncated.
private fn kernel_log_capture_retained_byte(value: u8) -> bool {
    if (kernel_log_active == false) { return true; }
    if (kernel_log_line_length >= KERNEL_LOG_LINE_BYTES) {
        kernel_log_retain_line();
        kernel_log_line_continued = true;
    }
    let length: usize = kernel_log_line_length;
    if (length < KERNEL_LOG_LINE_BYTES) {
        let safe_length: {0..<KERNEL_LOG_LINE_BYTES as usize} = length;
        kernel_log_line[safe_length] = value;
        kernel_log_line_length = length + 1;
    }
    if (value == 10) {
        kernel_log_retain_line();
        kernel_log_active = false;
        kernel_log_capture_enabled = false;
    }
    return true;
}

// GitHub issue #465: a peer that writes a retained line, on request.
//
// No maintained boot path had a secondary core emitting ordinary log text, so
// the publication Territory A built and the attribution added here were both
// unobservable -- the whole facility could stop working and every lane would
// stay green.
//
// So this runs on every boot rather than behind a switch, for the same reason
// the two-core contention probes do: evidence nobody turns on is evidence
// nobody has. It costs five lines.
//
// Bounded on purpose. It emits KERNEL_LOG_PEER_PROBE_LINES numbered lines and
// then stops, so the count in the retained log is a fact a view can compare
// rather than a stream whose length depends on how long the boot took.
//
// The shared `dmesg` view enumerates cpu1's five lines by name. A third core
// would add five more and fail that view, which is the intended outcome: the
// view is where somebody decides what a four-core boot's retained log should
// look like, and failing there is cheaper than discovering it later.
const KERNEL_LOG_PEER_PROBE_LINES: usize = 5;
private let mut kernel_log_peer_probe_emitted: [usize; KERNEL_MAX_CORES];

// Not an interrupt function, and the effect checker is what settled that: an
// !{interrupt} version was rejected for reaching kernel_boot_log, which is
// the same rule that keeps a handler out of the ordinary console. So this
// runs in the secondary's ordinary loop, which is also the only context where
// kernel_log_peer_publish is reachable at all.
fn kernel_log_peer_probe_step() !{logs, unsafe} {
    let raw_cpu: usize = cpu_id();
    if (raw_cpu == 0 || raw_cpu >= KERNEL_MAX_CORES) { return; }
    let core: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    let emitted: usize = kernel_log_peer_probe_emitted[core];
    if (emitted >= KERNEL_LOG_PEER_PROBE_LINES) {
        kernel_log_peer_console_probe_step(core);
        return;
    }
    kernel_log_peer_probe_emitted[core] = emitted + 1;
    // GitHub issue #9: the last line starts with a newline inside the same
    // fragment, the shape of the busy pair's migration line. Its text used
    // to escape the record and reach the UART raw, so it never got into the
    // retained log this view reads.
    if (emitted + 1 == KERNEL_LOG_PEER_PROBE_LINES) {
        kernel_boot_log("\npeer log probe: line=");
    } else {
        kernel_boot_log("peer log probe: line=");
    }
    uart_put_udec(emitted + 1);
    kernel_boot_log("\n");
}

// Four terminal records through the same bounded write entry as write(2).
// Shared-queue admission is immediate, so init starts this only after SMP
// bring-up and waits for the complete prefix before its next log line.
// Ordinary kernel diagnostic fragments use their separate publication path.
const KERNEL_LOG_PEER_CONSOLE_PROBE_LINES: usize = 4;
private let mut kernel_log_peer_console_probe_sent: [usize; KERNEL_MAX_CORES];
private let mut kernel_log_peer_console_probe_armed: AtomicWord;
private let mut kernel_log_peer_console_probe_done: AtomicWord;

fn kernel_log_peer_console_probe() -> bool {
    atomic_word_store(&kernel_log_peer_console_probe_armed, 1);
    let start: i64 = read_cntpct();
    let window: i64 = read_cntfrq() >> 1;
    while (read_cntpct() - start < window) {
        if (atomic_word_load(&kernel_log_peer_console_probe_done) ==
                KERNEL_LOG_PEER_CONSOLE_PROBE_LINES) {
            atomic_word_store(&kernel_log_peer_console_probe_armed, 0);
            return true;
        }
    }
    atomic_word_store(&kernel_log_peer_console_probe_armed, 0);
    return false;
}

private fn kernel_log_peer_console_probe_step(
        core: {0..<KERNEL_MAX_CORES as usize}) !{logs, unsafe} {
    if (atomic_word_load(&kernel_log_peer_console_probe_armed) == 0) { return; }
    let sent: usize = kernel_log_peer_console_probe_sent[core];
    if (sent >= KERNEL_LOG_PEER_CONSOLE_PROBE_LINES) { return; }
    let mut line = bs"peer console probe: record=1 of 4\n";
    if (sent == 1) { line = bs"peer console probe: record=2 of 4\n"; }
    if (sent == 2) { line = bs"peer console probe: record=3 of 4\n"; }
    if (sent == 3) { line = bs"peer console probe: record=4 of 4\n"; }
    if (uart_user_write(line) == line.len) {
        kernel_log_peer_console_probe_sent[core] = sent + 1;
        atomic_word_store(&kernel_log_peer_console_probe_done, sent + 1);
    }
}

// GitHub issue #534: move each peer's published console records into the
// transmit queue, a whole record at a time. Core 0 only, from two places
// that cannot be in the middle of one of its own lines: syscall entry,
// through kernel_log_peer_drain below, and a timer interrupt taken from
// EL0, through each platform's dispatcher -- the second so that a core 0
// computing in EL0 without a syscall still drains.
//
// A record goes in only when the queue has room for all of it, with
// interrupts masked, so it reaches the wire unbroken and the TX interrupt
// cannot run in between. One that does not fit stays published and the
// next drain takes it. Emergency and DDB paths never wait for any of this:
// with the queue stood down nothing is moved, and whatever is published
// stays there until the queue is live again.
//
// No `logs`, no `locks`: the interrupt dispatcher calls it.
// A complete peer diagnostic shares the terminal queue as one admission.
// Reserve room before retaining or enqueuing any byte, then keep the guard
// through the whole record and truncation suffix. This is the same ordering
// boundary as a bounded terminal chunk, not one hold per diagnostic byte.
private fn kernel_log_peer_record_emit(
        bytes: borrow [u8; KERNEL_LOG_PEER_LINE_BYTES..],
        length: {0..<KERNEL_LOG_PEER_LINE_BYTES + 1 as usize}, truncated: bool) {
    static_assert(KERNEL_LOG_PEER_LINE_BYTES + 28 <= KERNEL_LOG_TX_QUEUE_BYTES,
                  "a peer diagnostic and suffix must fit in one queue hold");
    let suffix = bs"... [peer line truncated]\n";
    let mut required: usize = length + 2;
    if (truncated) { required = required + suffix.len; }
    while (kernel_log_tx_is_live() && terminal_output_paused() == false) {
        let guard = console_lock();
        let count: usize = kernel_log_tx_count;
        if (count <= KERNEL_LOG_TX_QUEUE_BYTES &&
            KERNEL_LOG_TX_QUEUE_BYTES - count >= required) {
            for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
                if (index < length) {
                    kernel_log_peer_record_byte_locked(guard, bytes[index]);
                }
            }
            if (truncated) {
                kernel_log_begin_fragment();
                for index: usize in 0..<26 {
                    kernel_log_peer_record_byte_locked(guard, suffix[index]);
                }
            }
            uart_tx_drain_into_fifo(guard);
            if (uart_terminal_output_pending_locked(guard)) { uart_tx_irq_enable(); }
            console_unlock(guard);
            return;
        }
        console_unlock(guard);
        // Do not hold the console lock while waiting for physical room.
        while (uart_tx_fifo_full()) { }
        let drain = console_lock();
        uart_tx_drain_into_fifo(drain);
        console_unlock(drain);
    }
    // Polling/emergency reporting remains independent of ordinary queue
    // admission. Paused terminal writers cannot append in this mode.
    for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
        if (index < length) { uart_putc(bytes[index]); }
    }
    if (truncated) { kernel_boot_log("... [peer line truncated]\n"); }
}

private fn kernel_log_peer_record_byte_locked(
        guard: borrow ConsoleGuard[console_tx_lock], value: u8) {
    if (kernel_log_capture_uart_byte_locked(guard, value)) {
        if (kernel_log_wire_break_due) {
            kernel_log_wire_break_due = false;
            kernel_log_note_tx_byte();
            let prefix: bool = kernel_log_tx_push(guard, 10);
        }
        kernel_log_note_tx_byte();
        let queued: bool = kernel_log_tx_push(guard, value);
    }
}

fn kernel_log_peer_drain() !{unsafe} {
    if (cpu_id() != 0) { return; }
    kernel_log_terminal_flow_poll();
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        let mut expected: usize = kernel_log_peer_consumed[cpu] + 1;
        let latest: usize = kernel_log_observe(&kernel_log_peer_latest[cpu]);
        if (latest >= expected + KERNEL_LOG_PEER_RECORDS) {
            expected = latest - KERNEL_LOG_PEER_RECORDS + 1;
            kernel_boot_log("kernel log: peer records overwritten\n");
        }
        let mut remaining: usize = KERNEL_LOG_PEER_RECORDS;
        while (expected <= latest && remaining != 0) {
            remaining = remaining - 1;
            let slot: usize = cpu * KERNEL_LOG_PEER_RECORDS +
                ((expected - 1) % KERNEL_LOG_PEER_RECORDS);
            if (slot >= KERNEL_LOG_PEER_SLOTS) { return; }
            let safe_slot: {0..<KERNEL_LOG_PEER_SLOTS as usize} = slot;
            let first: usize =
                kernel_log_observe(&kernel_log_peer_published[safe_slot]);
            if (first != expected) { return; }
            let length: usize = kernel_log_peer_lengths[safe_slot];
            let truncated: bool = kernel_log_peer_truncated[safe_slot];
            let peer_tick: i64 = kernel_log_peer_ticks[safe_slot];
            let mut copy: [u8; KERNEL_LOG_PEER_LINE_BYTES];
            for index: usize in 0..<KERNEL_LOG_PEER_LINE_BYTES {
                if (index < length) {
                    let offset: usize = slot * KERNEL_LOG_PEER_LINE_BYTES + index;
                    if (offset < KERNEL_LOG_PEER_TEXT_BYTES) {
                        let safe_offset: {0..<KERNEL_LOG_PEER_TEXT_BYTES as usize} = offset;
                        copy[index] = kernel_log_peer_text[safe_offset];
                    }
                }
            }
            let second: usize =
                kernel_log_observe(&kernel_log_peer_published[safe_slot]);
            if (second != expected) { return; }
            // Attribute the record to the core that WROTE it, with the tick
            // that core took. Cleared straight after the line so nothing
            // afterwards inherits a peer's identity.
            kernel_log_deferred_cpu = cpu;
            kernel_log_deferred_tick = peer_tick;
            kernel_log_deferred = true;
            kernel_log_begin_fragment();
            if (length <= KERNEL_LOG_PEER_LINE_BYTES) {
                kernel_log_peer_record_emit(copy as [u8; KERNEL_LOG_PEER_LINE_BYTES..],
                                            length, truncated);
            } else { return; }
            kernel_log_deferred = false;
            kernel_log_peer_drained = kernel_log_peer_drained + 1;
            let now: i64 = read_cntpct();
            if (now >= peer_tick) {
                let waited: usize = (now - peer_tick) as usize;
                if (waited > (read_cntfrq() >> 5) as usize) {
                    kernel_log_peer_late = kernel_log_peer_late + 1;
                }
                if (waited > kernel_log_peer_worst_ticks) {
                    kernel_log_peer_worst_ticks = waited;
                    kernel_log_peer_worst_cpu = cpu;
                    kernel_log_peer_worst_length = length;
                    for first: usize in 0..<8 {
                        if (first < length) { kernel_log_peer_worst_first[first] = copy[first]; }
                        else { kernel_log_peer_worst_first[first] = 0; }
                    }
                }
            }
            kernel_log_peer_consumed[cpu] = expected;
            expected = expected + 1;
        }
    }
}

// Terminal exception paths must remain visible on every CPU and must not
// depend on ordinary line assembly. This bypass lasts until the next boot.
fn kernel_log_enter_emergency() {
    kernel_log_core_here().emergency = true;
    kernel_log_core_here().suppressed = false;
    // Terminal stack guards can park without entering crash_console_run.
    // Flush the owner queue here so neither their last line nor its prompt
    // depends on an interrupt after the terminal path masks IRQs. A peer
    // never touches this core-0 queue and already uses polling UART output.
    //
    // Terminal on purpose, so the token is matched and dropped rather than
    // discarded: GitHub issue #531 made that a decision the compiler asks
    // for, which is what stops a path that DOES return from forgetting.
    match kernel_log_tx_stand_down() {
        KernelLogTxStandDown::WasLive => { }
        KernelLogTxStandDown::WasSpinning => { }
        KernelLogTxStandDown::NotConsoleOwner => { }
    }
}

private fn kernel_log_snapshot_push(value: u8) {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    let length: usize = snapshot.length;
    if (length < KERNEL_LOG_SNAPSHOT_CAPACITY) {
        let safe_length:
            {0..<KERNEL_LOG_SNAPSHOT_CAPACITY as usize} = length;
        snapshot.bytes[safe_length] = value;
        snapshot.length = length + 1;
    }
}

private fn kernel_log_snapshot_text(text: *u8) {
    while (*text != 0) {
        kernel_log_snapshot_push(*text);
        text = text + 1;
    }
}

private fn kernel_log_snapshot_decimal6(value: usize) {
    let mut place_values: [usize; 6] =
        { 100000, 10000, 1000, 100, 10, 1 };
    for position: usize in 0..<6 {
        let divisor: usize = place_values[position];
        if (divisor != 0) {
            let digit: usize = (value / divisor) % 10;
            kernel_log_snapshot_push((digit + 48) as u8);
        }
    }
}

private fn kernel_log_snapshot_timestamp(ticks: i64) {
    let mut seconds: usize = 0;
    let mut micros: usize = 0;
    if (ticks >= 0 && kernel_log_frequency > 0) {
        let tick_count: usize = ticks as usize;
        let frequency: usize = kernel_log_frequency as usize;
        if (frequency == 0) { return; }
        seconds = tick_count / frequency;
        let remainder: usize = tick_count % frequency;
        match checked_mul_usize(remainder, 1000000) {
            CheckedUsize::Overflow => { micros = 0; }
            CheckedUsize::Value(scaled) => { micros = scaled / frequency; }
        }
    }
    kernel_log_snapshot_push(91);
    kernel_log_snapshot_decimal6(seconds % 1000000);
    kernel_log_snapshot_push(46);
    kernel_log_snapshot_decimal6(micros);
    kernel_log_snapshot_push(93);
    kernel_log_snapshot_push(32);
}

// What one acquire load of a slot word says about sequence `seq`. Only
// Readable carries anything, and what it carries is Unvalidated: the word
// that was seen, which the copy must find again afterwards before anything
// copied under it is kept (kernel_log_still).
struct KernelLogUnvalidated {
    private seq: usize;
    private word: usize;
}

must_use variant KernelLogSlotView {
    Readable(KernelLogUnvalidated);
    // Reserved, or reserved by the head and not yet claimed.
    InFlight;
    // Given up by its writer, which counted it in kernel_log_discarded.
    Discarded;
    // Committed as a continuation: the head of its record was overwritten.
    Continuation;
    // The slot holds another sequence: overwritten, or never claimed.
    Gone;
}

// LogRing.tla ReadHead's load: the first slot of sequence `seq`.
private fn kernel_log_slot_view(seq: usize) -> KernelLogSlotView !{unsafe} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
    let word: usize = kernel_log_observe(&kernel_log_slots[slot]);
    let state: usize = kernel_log_word_state(word);
    if (state == KERNEL_LOG_STATE_FREE) { return KernelLogSlotView::InFlight; }
    if (kernel_log_word_seq(word) != seq) { return KernelLogSlotView::Gone; }
    if (state == KERNEL_LOG_STATE_RESERVED) { return KernelLogSlotView::InFlight; }
    if (state == KERNEL_LOG_STATE_DISCARDED) { return KernelLogSlotView::Discarded; }
    if (kernel_log_word_span(word) == 0) { return KernelLogSlotView::Continuation; }
    let mut seen: KernelLogUnvalidated = { seq, word };
    return KernelLogSlotView::Readable(seen);
}

// LogRing.tla HeadCheck's re-load: the first slot still holds what was seen.
private fn kernel_log_still(seen: KernelLogUnvalidated) -> bool !{unsafe} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seen.seq);
    return kernel_log_observe(&kernel_log_slots[slot]) == seen.word;
}

private fn kernel_log_seen_span(seen: KernelLogUnvalidated) -> usize {
    return kernel_log_word_span(seen.word);
}

private fn kernel_log_seen_cpu(seen: KernelLogUnvalidated) -> usize {
    return kernel_log_word_cpu(seen.word);
}

// What copying one record came to: kept, lost (in flight or overwritten
// while read, counted by the reader), or skipped (already reported: given up
// by its writer, or a continuation of a record overwritten before it).
must_use variant KernelLogRecordCopy {
    Kept(usize);
    Lost(usize);
    Skipped(usize);
}

// Copy the first `count` bytes of slot `slot` into this CPU's snapshot.
private fn kernel_log_copy_slot_text(slot: {0..<KERNEL_LOG_SLOT_COUNT as usize},
                                     count: usize, record: usize,
                                     overwrite_mid_copy: bool) !{unsafe} {
    for byte_index: usize in 0..<KERNEL_LOG_SLOT_BYTES {
        if (byte_index < count) {
            let word_index: usize = slot * KERNEL_LOG_SLOT_WORDS + byte_index / 8;
            if (word_index < KERNEL_LOG_TEXT_WORDS) {
                let safe_word: {0..<KERNEL_LOG_TEXT_WORDS as usize} = word_index;
                let word: usize = kernel_log_observe(&kernel_log_text[safe_word]);
                kernel_log_snapshot_push(((word >> ((byte_index % 8) * 8)) & 0xFF) as u8);
            }
            if (byte_index == 0 && overwrite_mid_copy) {
                kernel_log_overwrite_slot_for_probe(record);
            }
        }
    }
}

// Record `seq` into this CPU's snapshot, or nothing, by the protocol at the
// top of this file (LogRing.tla ReadHead .. ContCheck, generalised from two
// slots to KERNEL_LOG_RECORD_SLOTS). `end` is the head the reader started
// from. `second_check` false is the negative control's reader, which trusts
// whatever it copied; `overwrite_mid_copy` has core 0 overwrite the slot
// after the first text byte is copied, which makes that control
// deterministic. Both are false for syslog(2).
private fn kernel_log_snapshot_record(seq: usize, end: usize, second_check: bool,
                                      overwrite_mid_copy: bool)
        -> KernelLogRecordCopy !{unsafe} {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    let mark: usize = snapshot.length;
    let seen: KernelLogUnvalidated = match kernel_log_slot_view(seq) {
        KernelLogSlotView::Readable(observed) => { observed }
        KernelLogSlotView::InFlight => { return KernelLogRecordCopy::Lost(1); }
        KernelLogSlotView::Gone => { return KernelLogRecordCopy::Lost(1); }
        KernelLogSlotView::Discarded => { return KernelLogRecordCopy::Skipped(1); }
        KernelLogSlotView::Continuation => { return KernelLogRecordCopy::Skipped(1); }
    };
    let span: usize = kernel_log_seen_span(seen);
    if (span > KERNEL_LOG_RECORD_SLOTS || seq + span > end) {
        return KernelLogRecordCopy::Lost(1);
    }
    let first: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
    let meta: usize = kernel_log_observe(&kernel_log_meta[first]);
    let line_tick: usize = kernel_log_observe(&kernel_log_ticks[first]);
    let length: usize = meta & KERNEL_LOG_META_LENGTH_MASK;
    let line_cpu: usize = (meta >> KERNEL_LOG_META_CPU_SHIFT) & KERNEL_LOG_CPU_MASK;
    // A continuation of a long line carries on the line before it, so it
    // prints no prefix of its own.
    if ((meta & KERNEL_LOG_META_CONTINUED) == 0) {
        kernel_log_snapshot_timestamp(line_tick as i64);
        // GitHub issue #465: a core column, printed only for a core that is
        // not the console owner. Every line a single-core boot retains is
        // core 0's, so its dmesg is unchanged -- and a peer's line is the one
        // that could not previously be told from core 0's at all.
        if (line_cpu != 0) {
            kernel_log_snapshot_text("cpu" as *u8);
            kernel_log_snapshot_push(((line_cpu % 10) + 48) as u8);
            kernel_log_snapshot_push(32);
        }
    }
    // Cleared by the first slot found changed; what was copied is then
    // taken back out of the snapshot, all of it.
    let mut intact: bool = true;
    for index: usize in 0..<KERNEL_LOG_RECORD_SLOTS {
        if (index < span && intact) {
            let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq + index);
            let expected: usize = kernel_log_word(seq + index, kernel_log_seen_cpu(seen),
                                                  0, KERNEL_LOG_STATE_COMMITTED);
            // ContCopy's load: the continuation names this record.
            if (index != 0 &&
                kernel_log_observe(&kernel_log_slots[slot]) != expected) {
                intact = false;
            } else {
                let from: usize = index * KERNEL_LOG_SLOT_BYTES;
                let mut to: usize = from + KERNEL_LOG_SLOT_BYTES;
                if (to > length) { to = length; }
                if (from < to) {
                    kernel_log_copy_slot_text(slot, to - from, seq,
                                              overwrite_mid_copy && index == 0);
                }
                // HeadCheck / ContCheck: the word is still what it was.
                if (second_check) {
                    if (index == 0) {
                        intact = kernel_log_still(seen);
                    } else {
                        intact = kernel_log_observe(&kernel_log_slots[slot]) == expected;
                    }
                }
            }
        }
    }
    if (intact == false) {
        snapshot.length = mark;
        return KernelLogRecordCopy::Lost(span);
    }
    return KernelLogRecordCopy::Kept(span);
}

// A partial final line is not included: it is still core 0's staged line.
// Records the ring had already overwritten, records in flight or overwritten
// while this copied them, and records their writers gave up are each
// reported explicitly instead of being presented as complete history.
fn kernel_log_snapshot_build() -> usize !{unsafe} {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    snapshot.length = 0;
    let end: usize = kernel_log_observe(&kernel_log_head);
    let mut begin: usize = 0;
    if (end > KERNEL_LOG_SLOT_COUNT) {
        begin = end - KERNEL_LOG_SLOT_COUNT;
    }
    if (begin != 0) {
        kernel_log_snapshot_text("<4>kernel log: overwritten records=" as *u8);
        kernel_log_snapshot_decimal6(begin % 1000000);
        kernel_log_snapshot_push(10);
    }
    let mut lost: usize = 0;
    let mut seq: usize = begin;
    for step: usize in 0..<KERNEL_LOG_SLOT_COUNT {
        if (seq < end) {
            match kernel_log_snapshot_record(seq, end, true, false) {
                KernelLogRecordCopy::Kept(span) => { seq = seq + span; }
                KernelLogRecordCopy::Lost(count) => {
                    lost = lost + count;
                    seq = seq + count;
                }
                KernelLogRecordCopy::Skipped(count) => { seq = seq + count; }
            }
        }
    }
    let discarded: usize = kernel_log_observe(&kernel_log_discarded);
    if (discarded != 0) {
        kernel_log_snapshot_text("<4>kernel log: discarded records=" as *u8);
        kernel_log_snapshot_decimal6(discarded % 1000000);
        kernel_log_snapshot_push(10);
    }
    if (lost != 0) {
        kernel_log_snapshot_text(
            "<4>kernel log: records in flight or overwritten while read=" as *u8);
        kernel_log_snapshot_decimal6(lost % 1000000);
        kernel_log_snapshot_push(10);
    }
    return snapshot.length;
}

fn kernel_log_snapshot_capacity() -> usize {
    return KERNEL_LOG_SNAPSHOT_CAPACITY;
}

fn kernel_log_snapshot_copy(offset: usize, destination: []u8) -> usize {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    let snapshot_length: usize = snapshot.length;
    if (offset >= snapshot_length) { return 0; }
    let mut amount: usize = destination.len;
    if (amount > snapshot_length - offset) {
        amount = snapshot_length - offset;
    }
    let mut index: usize = 0;
    while (index < amount) {
        let source_index: usize = match checked_add_usize(offset, index) {
            CheckedUsize::Overflow => { return index; }
            CheckedUsize::Value(value) => { value }
        };
        if (source_index < KERNEL_LOG_SNAPSHOT_CAPACITY &&
            index < destination.len) {
            let safe_source:
                {0..<KERNEL_LOG_SNAPSHOT_CAPACITY as usize} = source_index;
            destination[index] = snapshot.bytes[safe_source];
        }
        index = index + 1;
    }
    return amount;
}

// GitHub issue #613: the debugger's raw view of the ring. The world is
// stopped, so a slot is read once and trusted (no re-check); a Reserved slot
// is shown as in flight rather than skipped, because a writer stopped
// holding one is exactly what a postmortem wants to see.
must_use variant KernelLogRawSlot {
    // The record's span, core and length.
    Committed((usize, usize, usize));
    // The reserving core.
    InFlight(usize);
    Discarded;
    Continuation;
    // Another sequence, or never used.
    Absent;
}

fn kernel_log_raw_head() -> usize !{unsafe} {
    return kernel_log_observe(&kernel_log_head);
}

fn kernel_log_raw_discarded() -> usize !{unsafe} {
    return kernel_log_observe(&kernel_log_discarded);
}

fn kernel_log_raw_slot_count() -> usize {
    return KERNEL_LOG_SLOT_COUNT;
}

// One slot word, classified for sequence `seq`. Pure, so the debugger's
// test-only command classifies a planted word through the same code.
fn kernel_log_raw_classify(word: usize, seq: usize, length: usize) -> KernelLogRawSlot {
    let state: usize = kernel_log_word_state(word);
    if (state == KERNEL_LOG_STATE_FREE || kernel_log_word_seq(word) != seq) {
        return KernelLogRawSlot::Absent;
    }
    if (state == KERNEL_LOG_STATE_RESERVED) {
        return KernelLogRawSlot::InFlight(kernel_log_word_cpu(word));
    }
    if (state == KERNEL_LOG_STATE_DISCARDED) { return KernelLogRawSlot::Discarded; }
    let span: usize = kernel_log_word_span(word);
    if (span == 0) { return KernelLogRawSlot::Continuation; }
    return KernelLogRawSlot::Committed((span, kernel_log_word_cpu(word), length));
}

// The word a reservation of one slot by `cpu` writes, for that command.
fn kernel_log_raw_reserved_word(seq: usize, cpu: usize) -> usize {
    return kernel_log_word(seq, cpu, 1, KERNEL_LOG_STATE_RESERVED);
}

fn kernel_log_raw_slot(seq: usize) -> KernelLogRawSlot !{unsafe} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
    let length: usize = kernel_log_observe(&kernel_log_meta[slot]) &
        KERNEL_LOG_META_LENGTH_MASK;
    return kernel_log_raw_classify(kernel_log_observe(&kernel_log_slots[slot]),
                                   seq, length);
}

// Byte `index` of the record that begins at `seq`; 0 past the slots.
fn kernel_log_raw_text_byte(seq: usize, index: usize) -> u8 !{unsafe} {
    if (index >= KERNEL_LOG_LINE_BYTES) { return 0; }
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} =
        kernel_log_slot_of(seq + index / KERNEL_LOG_SLOT_BYTES);
    let offset: usize = index % KERNEL_LOG_SLOT_BYTES;
    let word_index: usize = slot * KERNEL_LOG_SLOT_WORDS + offset / 8;
    if (word_index >= KERNEL_LOG_TEXT_WORDS) { return 0; }
    let safe_word: {0..<KERNEL_LOG_TEXT_WORDS as usize} = word_index;
    let word: usize = kernel_log_observe(&kernel_log_text[safe_word]);
    return ((word >> ((offset % 8) * 8)) & 0xFF) as u8;
}

// One retained record "<byte><byte>\n", written the way core 0 writes any.
private fn kernel_log_probe_record(byte: u8) {
    kernel_log_begin_fragment();
    let first: bool = kernel_log_capture_uart_byte(byte);
    let second: bool = kernel_log_capture_uart_byte(byte);
    let newline: bool = kernel_log_capture_uart_byte(10);
}

// The negative control's writer: core 0 retains records until `record`'s
// slot has been taken over, each "bb\n", as a writer on another CPU would
// during a peer's copy.
private fn kernel_log_overwrite_slot_for_probe(record: usize) !{unsafe} {
    for step: usize in 0..<KERNEL_LOG_SLOT_COUNT {
        if (kernel_log_observe(&kernel_log_head) <=
            record + KERNEL_LOG_SLOT_COUNT) {
            kernel_log_probe_record(98);
        }
    }
}

// GitHub issue #612's negative control, on the #613 ring, deterministic
// because the overwrite is injected between a record's first and second text
// byte. The checked reader must drop the record and leave nothing of it in
// the snapshot; the reader that skips the re-check must return it torn --
// 'a' then 'b' -- which is what the check exists to catch.
private fn kernel_log_torn_read_probe() -> bool !{unsafe} {
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    kernel_log_probe_record(97);
    snapshot.length = 0;
    let checked_end: usize = kernel_log_observe(&kernel_log_head);
    match kernel_log_snapshot_record(checked_end - 1, checked_end, true, true) {
        KernelLogRecordCopy::Kept(_) => { return false; }
        KernelLogRecordCopy::Lost(_) => {}
        KernelLogRecordCopy::Skipped(_) => { return false; }
    }
    if (snapshot.length != 0) { return false; }
    kernel_log_probe_record(97);
    let unchecked_end: usize = kernel_log_observe(&kernel_log_head);
    match kernel_log_snapshot_record(unchecked_end - 1, unchecked_end, false, true) {
        KernelLogRecordCopy::Lost(_) => { return false; }
        KernelLogRecordCopy::Skipped(_) => { return false; }
        KernelLogRecordCopy::Kept(_) => {}
    }
    // "[000000.000000] " then the text.
    return snapshot.length >= 18 && snapshot.bytes[16] == 97 &&
        snapshot.bytes[17] == 98;
}

// The span and metadata of the record that begins at `seq`, for the probe.
private fn kernel_log_probe_span(seq: usize) -> usize !{unsafe} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
    return kernel_log_word_span(kernel_log_observe(&kernel_log_slots[slot]));
}

private fn kernel_log_probe_meta(seq: usize) -> usize !{unsafe} {
    let slot: {0..<KERNEL_LOG_SLOT_COUNT as usize} = kernel_log_slot_of(seq);
    return kernel_log_observe(&kernel_log_meta[slot]);
}

// One line of `count` copies of `byte` and its newline.
private fn kernel_log_probe_line(byte: u8, count: usize) {
    kernel_log_begin_fragment();
    for index: usize in 0..<1024 {
        if (index < count) {
            let kept: bool = kernel_log_capture_uart_byte(byte);
        }
    }
    let newline: bool = kernel_log_capture_uart_byte(10);
}

// Destructive boot-time probe, followed immediately by kernel_log_init(). It
// exercises every loss signal without emitting UART lines: a reservation held
// across a whole turn of the ring makes the claim that comes round to its
// slot Refused and counted rather than waited for; the overwrite count; #612's
// torn-read control; a line longer than a slot spanning several, and one
// longer than the stage split into a continuation record; and a fatal report
// bypassing a partial line, which stays staged and invisible.
fn kernel_log_bounds_probe() -> bool !{unsafe} {
    static_assert(KERNEL_LOG_TEXT_WORDS ==
                  KERNEL_LOG_SLOT_COUNT * KERNEL_LOG_SLOT_WORDS,
                  "one run of text words per slot");
    static_assert(KERNEL_LOG_SLOT_BYTES == KERNEL_LOG_SLOT_WORDS * 8,
                  "a slot's text is whole words");
    static_assert(KERNEL_LOG_LINE_BYTES ==
                  KERNEL_LOG_RECORD_SLOTS * KERNEL_LOG_SLOT_BYTES,
                  "the stage holds the largest record");
    static_assert(KERNEL_LOG_RECORD_SLOTS <= KERNEL_LOG_SPAN_MASK,
                  "a span fits its field in the state word");
    match kernel_log_reserve(1) {
        KernelLogReserve::Reserved(held) => {
            for record: usize in 0..<KERNEL_LOG_SLOT_COUNT {
                kernel_log_probe_record(120);
            }
            kernel_log_discard(held);
        }
        KernelLogReserve::Refused => { return false; }
    }
    kernel_log_probe_record(120);
    if (kernel_log_observe(&kernel_log_head) != KERNEL_LOG_SLOT_COUNT + 2 ||
        kernel_log_observe(&kernel_log_discarded) != 2 ||
        kernel_log_observe(&kernel_log_commit_lost) != 0) {
        return false;
    }
    let snapshot_length: usize = kernel_log_snapshot_build();
    let snapshot: *KernelLogSnapshot = kernel_log_snapshot_here();
    if (snapshot_length < 3 || snapshot.bytes[0] != 60 ||
        snapshot.bytes[1] != 52 || snapshot.bytes[2] != 62) {
        return false;
    }
    if (kernel_log_torn_read_probe() == false) { return false; }
    let wide: usize = kernel_log_observe(&kernel_log_head);
    kernel_log_probe_line(121, KERNEL_LOG_SLOT_BYTES);
    let long: usize = kernel_log_observe(&kernel_log_head);
    kernel_log_probe_line(122, KERNEL_LOG_LINE_BYTES + 60);
    let after: usize = kernel_log_observe(&kernel_log_head);
    if (long != wide + 2 || kernel_log_probe_span(wide) != 2 ||
        after != long + KERNEL_LOG_RECORD_SLOTS + 1 ||
        kernel_log_probe_span(long) != KERNEL_LOG_RECORD_SLOTS ||
        (kernel_log_probe_meta(long) & KERNEL_LOG_META_CONTINUED) != 0 ||
        kernel_log_probe_span(after - 1) != 1 ||
        (kernel_log_probe_meta(after - 1) & KERNEL_LOG_META_CONTINUED) == 0 ||
        (kernel_log_probe_meta(after - 1) & KERNEL_LOG_META_LENGTH_MASK) != 61) {
        return false;
    }
    // A fatal report must bypass even an unfinished suppressed line, and
    // must leave the staged partial line untouched and unretained. init
    // resets this mode immediately after the destructive boot probe.
    kernel_log_begin_fragment();
    for byte_index: usize in 0..<3 {
        kernel_log_capture_uart_byte(119);
    }
    let staged: usize = kernel_log_line_length;
    let head: usize = kernel_log_observe(&kernel_log_head);
    kernel_log_core_here().suppressed = true;
    // Arrange the live-queue case without emitting artificial bytes. A
    // terminal writer must leave polling selected even without the later
    // crash-console entry; stack-guard fail-stop has no such continuation.
    kernel_log_tx_activate();
    kernel_log_enter_emergency();
    kernel_log_begin_fragment();
    let visible: bool = kernel_log_capture_uart_byte(122);
    return visible && kernel_log_core_here().suppressed == false &&
        kernel_log_tx_is_live() == false && staged == 3 &&
        kernel_log_line_length == staged &&
        kernel_log_observe(&kernel_log_head) == head;
}

// Hexadecimal with its `0x`, through the log ring.
//
// GitHub issue #470 follow-up: the digits are kernel/printk/number.tkb's,
// where a host test can reach them; the prefix is here because it goes
// through kernel_boot_log, which begins a log fragment. Emitting it with
// two uart_putc calls instead would print the same characters and record a
// different line structure.
fn uart_put_hex(value: usize) {
    kernel_boot_log("0x");
    uart_put_hex_digits(value);
}

// Same reasoning as uart_put_hex above, for strings: uart_putc IS the
// device and stays per-platform, but walking a NUL-terminated string is
// not, and this body was byte-identical in kernel/platform/qemu/uart.tkb
// and kernel/platform/rpi5/uart.tkb. That is the shape issue #470 was
// made of -- two copies of platform-independent code in platform files,
// free to drift, with only one of them read on any given boot.
fn uart_puts(s: *u8) {
    while (*s != 0) {
        uart_putc(*s);
        s = s + 1;
    }
}

fn kernel_boot_log(message: *u8) {
    kernel_log_begin_fragment();
    uart_puts(message);
    kernel_log_end_fragment();
}

fn kernel_boot_log_syscall_unreachable(number: usize) {
    kernel_boot_log("syscall dispatch: unreachable action, syscall=" as *u8);
    uart_put_udec(number);
    kernel_boot_log("\n" as *u8);
}

fn kernel_boot_log_resource_exhausted(resource: *u8, capacity: usize) {
    kernel_boot_log("resource exhausted: " as *u8);
    uart_puts(resource);
    kernel_boot_log(" capacity=" as *u8);
    uart_put_udec(capacity);
    kernel_boot_log("\n" as *u8);
}

// Ordinary retained kernel text remains a core-0 stream. Other cores divert
// a kernel_boot_log logical line at uart_putc into a peer record until the
// fragment that completes it returns, so fragments cannot split core 0's
// view-sensitive text. The suppression bit is per-core;
// direct userspace UART and the lock-free crash/DDB reporters remain live.
// Re-entry on one core would still alias that core's line state.
fn kernel_log_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "per-core kernel-log line state cannot survive preemption into another writer");
}

// Encode within the available room before publishing. Every CPU holds the
// console guard across the room query, encoding, enqueue and FIFO drain.
// Thus a CR/LF pair is admitted together, and a short write counts whole
// input bytes.
fn uart_terminal_write_chunk(bytes: borrow []const u8, convert: bool) -> usize {
    if (convert == false) { return uart_user_write(bytes); }
    let mut encoded: [u8; 512];
    let mut accepted: usize = 0;
    if (kernel_log_tx_is_live() == false) {
        // Before the queue is live the bytes spin one at a time through
        // uart_putc, which takes the console lock itself; hold only the mask.
        let flags: usize = mutex_irq_save();
        match terminal_encode_onlcr(bytes, encoded as [u8; 512..],
                                    KERNEL_LOG_TX_QUEUE_BYTES) {
            TerminalEncodeResult::NoRoom => { }
            TerminalEncodeResult::Encoded(counts) => {
                let length: usize = counts.output_bytes;
                if (length <= 512) {
                    let count: usize = uart_user_write(encoded[0..<length]);
                    if (count == length) { accepted = counts.input_bytes; }
                }
            }
        }
        mutex_irq_restore(flags);
        return accepted;
    }
    // Room, encoding and the write are one hold: nothing can take the room
    // between the measurement and the use of it.
    let guard = console_lock();
    let room: usize = uart_user_write_room_locked(guard);
    let mut pending: bool = false;
    match terminal_encode_onlcr(bytes, encoded as [u8; 512..], room) {
        TerminalEncodeResult::NoRoom => { }
        TerminalEncodeResult::Encoded(counts) => {
            let length: usize = counts.output_bytes;
            if (length <= 512) {
                let (count, more) = uart_user_write_locked(guard, encoded[0..<length]);
                pending = more;
                if (count == length) { accepted = counts.input_bytes; }
            }
        }
    }
    if (pending) { uart_tx_irq_enable(); }
    console_unlock(guard);
    return accepted;
}

// Snapshot first, then print: reporters must not recursively acquire console.
fn kernel_console_measure_report() !{logs} {
    let mut sample: ConsoleLockMeasurement = console_measure_end();
    if (sample.acquisitions > 0 && sample.contended <= sample.acquisitions &&
        sample.acquire_max <= sample.acquire_ticks &&
        sample.hold_max <= sample.hold_ticks && sample.hold_max > 0 &&
        (sample.cpus & 3) == 3) {
        kernel_boot_log("console lock measurement: both CPUs and consistent counters ok\n");
    } else {
        kernel_boot_log("console lock measurement: inconsistent counters\n");
    }
    kernel_boot_log("console lock: acquisitions="); uart_put_udec(sample.acquisitions);
    kernel_boot_log(" contended="); uart_put_udec(sample.contended);
    kernel_boot_log(" acquire_ticks="); uart_put_udec(sample.acquire_ticks);
    kernel_boot_log(" acquire_max="); uart_put_udec(sample.acquire_max);
    kernel_boot_log(" hold_ticks="); uart_put_udec(sample.hold_ticks);
    kernel_boot_log(" hold_max="); uart_put_udec(sample.hold_max);
    kernel_boot_log(" cpus="); uart_put_udec(sample.cpus);
    kernel_boot_log(" tickfreq="); uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log("\n");
}
