// The kernel log ring (kernel/printk/log.tkb) as it actually ran, for
// scripts/validate_log_ring_trace.py to check against kernel/models/LogRing.tla
// through LogRingTrace.tla (GitHub issue #656, maintainer option A).
//
// Every serialization point of the ring records one event while a window is
// open: the head compare-swap that reserved, each slot compare-swap (claim,
// commit, a failed one that refused or lost its commit), the load that
// refused without a swap, the end of a slot's text stores, and each of the
// reader's slot-word loads and copies. Each event carries the slot word it
// observed and two system-counter reads, one before and one after its atomic
// access, each fenced by DSB ISH and ISB so the access lies between them. The
// system counter is one per system, so an event whose interval ends before
// another's begins happened first; TLC tries only the interleavings that
// agree with that, which is what makes a reader stream next to the writers
// checkable at all (#656: without it, 3 CPUs x 5 records and one read did not
// finish in 180 s).
//
// Events go to one static buffer per CPU, and a recorder takes its event's
// slot with one fetch_add on the buffer of the CPU it runs on, so two recorders
// on one CPU (or one moved off it mid-event) never fill the same event, and no
// word of the protocol under test is shared with the recording. Outside a
// window every site pays one acquire load of the window flag.
//
// One window, opened and closed by log_storm_trace_probe. The one traced
// reader carries its state on its stack; only sequences at or past the
// opening head are recorded, beginning with that reader's BEGIN event.
// Reader events carry a bounded logical ordinal in unused tag bits.
// Reporting merges by this ordinal, never CPU or timestamp, while writers
// retain their per-CPU order. This does not admit concurrent traced readers.
//
// Current limitations (2026-11-01):
// - A writer that read the flag just before the close may store one more
//   event after the report has counted its buffer; the report then misses
//   it. The probe closes only after every writer said it was done, so only a
//   writer that timed out of the round can do this.
// - THE VALIDATOR TAKES A BUFFER AS ONE WRITER'S PROGRAM ORDER. That holds for
//   the storm's one writer per CPU. A writer preempted mid-record, or moved to
//   another CPU, would break it; the validator then refuses the window rather
//   than passing it. Nothing else logs inside the window today.
// - kernel_log_discard (a token given up whole) is not a LogRing.tla action
//   and records nothing; only the bounds probe at boot calls it, never inside
//   a window.
// - A CPU's buffer holds LOG_RING_TRACE_EVENTS events; more are reported lost
//   and the validator refuses the window.

use "kernel/lib/atomic_word.tkb";
use "kernel/lib/execution_model.tkb";

const LOG_RING_TRACE_EVENTS: usize = 256;
const LOG_RING_TRACE_READER_EVENTS: usize = 1024;

// Event kinds (the low 4 bits of an event's tag). Writer kinds are below
// LOG_RING_TRACE_BEGIN; the reader's are it and above.
const LOG_RING_TRACE_RESERVE: usize = 1;
const LOG_RING_TRACE_CLAIM: usize = 2;
const LOG_RING_TRACE_REFUSE: usize = 3;
const LOG_RING_TRACE_COMMITLOST: usize = 4;
const LOG_RING_TRACE_WRITE: usize = 5;
const LOG_RING_TRACE_COMMIT: usize = 6;
const LOG_RING_TRACE_BEGIN: usize = 7;
const LOG_RING_TRACE_HEAD: usize = 8;
const LOG_RING_TRACE_COPY: usize = 9;
const LOG_RING_TRACE_CHECK: usize = 10;
const LOG_RING_TRACE_CCOPY: usize = 11;
const LOG_RING_TRACE_CCHECK: usize = 12;
// Reader outcomes: head copy|lost|skip, check kept|lost|cont, ccopy
// copy|lost, ccheck kept|lost.
const LOG_RING_TRACE_OUT_GO: usize = 0;
const LOG_RING_TRACE_OUT_LOST: usize = 1;
const LOG_RING_TRACE_OUT_OTHER: usize = 2;

// tag: kind | k << 4 | i << 8 | out << 12 | reader ordinal << 16 | delta << 32.
// first: the record's first sequence (reader: the sequence; begin: FIRST).
// word: the slot word observed (begin: END). t0: the counter before.
struct LogRingTraceEvent {
    tag: AtomicWord;
    first: AtomicWord;
    word: AtomicWord;
    t0: AtomicWord;
}

// `claimed`: the events ever claimed since the window opened, so at most
// LOG_RING_TRACE_EVENTS are stored and the rest are lost.
struct LogRingTraceCpu {
    claimed: AtomicWord;
    events: [LogRingTraceEvent; LOG_RING_TRACE_EVENTS];
}

// One read's standing with the trace, on the reader's own stack: whether this
// read is the traced one, and whether its begin has been recorded. It follows
// the read and not a CPU, so a reader that moves stays traced and a second
// reader on its CPU is not.
struct LogRingTraceReader {
    traced: bool;
    begun: bool;
    ordinal: usize;
}

private let mut log_ring_trace_active: AtomicWord;
private let mut log_ring_trace_cpus: [LogRingTraceCpu; KERNEL_MAX_CORES];
// The head the window opened at; the reader records from there.
private let mut log_ring_trace_from: AtomicWord;

// The system counter, after every earlier memory access has completed and
// before any later one starts. Never 0, which means "not recording".
private fn log_ring_trace_stamp() -> usize {
    dsb_ish();
    isb();
    let now: usize = mrs_cntpct_el0();
    isb();
    if (now == 0) { return 1; }
    return now;
}

// Before an atomic access: the counter when a window is open, else 0.
fn log_ring_trace_t0() -> usize {
    if (atomic_word_load(&log_ring_trace_active) == 0) { return 0; }
    return log_ring_trace_stamp();
}

private fn log_ring_trace_store(t0: usize, kind: usize, first: usize, k: usize,
                                i: usize, out: usize, word: usize, ordinal: usize) {
    let t1: usize = log_ring_trace_stamp();
    let raw: usize = cpu_id();
    if (raw >= KERNEL_MAX_CORES) { return; }
    let cpu: {0..<KERNEL_MAX_CORES as usize} = raw;
    log_ring_trace_store_at(cpu, t0, t1, kind, first, k, i, out, word, ordinal);
}

// Atomic event storage needs a bounded slot, not authority to execute on it.
// The explicit slot also lets the closed-window probe exercise migration.
private fn log_ring_trace_store_at(cpu: {0..<KERNEL_MAX_CORES as usize},
        t0: usize, t1: usize, kind: usize, first: usize, k: usize,
        i: usize, out: usize, word: usize, ordinal: usize) {
    static_assert(LOG_RING_TRACE_READER_EVENTS <= 65536);
    if (ordinal >= LOG_RING_TRACE_READER_EVENTS) {
        // Saturated reader ordinals never wrap into apparently valid order.
        // Force the existing lost-event header/refusal even on an empty CPU.
        atomic_word_fetch_add(&log_ring_trace_cpus[cpu].claimed, LOG_RING_TRACE_EVENTS + 1);
        return;
    }
    let stored: usize = atomic_word_fetch_add(&log_ring_trace_cpus[cpu].claimed, 1);
    if (stored >= LOG_RING_TRACE_EVENTS) { return; }
    let slot: {0..<LOG_RING_TRACE_EVENTS as usize} = stored;
    // A wider interval than the truth is sound; a narrower one is not.
    let mut delta: usize = 0xFFFFFFFF;
    if (t1 >= t0 && t1 - t0 < 0xFFFFFFFF) { delta = t1 - t0; }
    atomic_word_store(&log_ring_trace_cpus[cpu].events[slot].tag,
        (kind & 15) | ((k & 15) << 4) | ((i & 15) << 8) | ((out & 15) << 12) |
        ((ordinal & 0xFFFF) << 16) | (delta << 32));
    atomic_word_store(&log_ring_trace_cpus[cpu].events[slot].first, first);
    atomic_word_store(&log_ring_trace_cpus[cpu].events[slot].word, word);
    atomic_word_store(&log_ring_trace_cpus[cpu].events[slot].t0, t0);
}

// After a writer's atomic access that began at `t0` (0: no window then).
fn log_ring_trace_writer(t0: usize, kind: usize, first: usize, k: usize,
                         i: usize, word: usize) {
    if (t0 == 0) { return; }
    log_ring_trace_store(t0, kind, first, k, i, 0, word, 0);
}

// After a reader's access to sequence `seq` that began at `t0`. `end` is the
// head the read started from.
fn log_ring_trace_reader(reader: borrow &mut LogRingTraceReader, t0: usize, kind: usize,
                         seq: usize, word: usize, out: usize, end: usize) {
    if (t0 == 0) { return; }
    if (reader.traced == false || seq < atomic_word_load(&log_ring_trace_from)) { return; }
    if (reader.begun == false) {
        reader.begun = true;
        let begin_order: usize = log_ring_trace_reader_order(reader);
        log_ring_trace_store(t0, LOG_RING_TRACE_BEGIN, seq, 0, 0, 0, end, begin_order);
    }
    let order: usize = log_ring_trace_reader_order(reader);
    log_ring_trace_store(t0, kind, seq, 0, 0, out, word, order);
}

// At most 1024 events can survive in all CPU buffers. Saturate rather
// than wrap; subsequent attempts force the existing loss refusal.
private fn log_ring_trace_reader_order(reader: borrow &mut LogRingTraceReader) -> usize {
    static_assert(KERNEL_MAX_CORES * LOG_RING_TRACE_EVENTS <= LOG_RING_TRACE_READER_EVENTS);
    let order: usize = reader.ordinal;
    if (order < LOG_RING_TRACE_READER_EVENTS) { reader.ordinal = order + 1; }
    return order;
}

must_use variant LogRingTracePosition {
    Missing;
    Found((usize, usize));
}

// Closed-window lookup: explicit reader order, not an inference from stamps.
// Reporting is bounded by 1024 x 4 x 256 tag loads, outside the hot path.
private fn log_ring_trace_reader_position(order: usize) -> LogRingTracePosition {
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        let count: usize = atomic_word_load(&log_ring_trace_cpus[cpu].claimed);
        for slot: usize in 0..<LOG_RING_TRACE_EVENTS {
            if (slot < count) {
                let tag: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].tag);
                if ((tag & 15) >= LOG_RING_TRACE_BEGIN && ((tag >> 16) & 0xFFFF) == order) {
                    return LogRingTracePosition::Found((cpu, slot));
                }
            }
        }
    }
    return LogRingTracePosition::Missing;
}

must_use variant LogRingTraceOrderProbe { Passed; Failed; }

// Before arming any writers. Exercise the production store and report lookup
// with one reader placed on CPU 1, then 0, then 1. No scheduling assumption
// or timestamp is used. The real window resets this scratch afterwards.
fn log_ring_trace_order_probe() -> LogRingTraceOrderProbe {
    static_assert(KERNEL_MAX_CORES >= 2);
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        atomic_word_store(&log_ring_trace_cpus[cpu].claimed, 0);
    }
    let mut reader: LogRingTraceReader = { true, false, 0 };
    let begin: usize = log_ring_trace_reader_order(&reader);
    log_ring_trace_store_at(1, 1, 2, LOG_RING_TRACE_BEGIN, 8, 0, 0, 0, 9, begin);
    let head: usize = log_ring_trace_reader_order(&reader);
    log_ring_trace_store_at(0, 3, 4, LOG_RING_TRACE_HEAD, 8, 0, 0, 0, 0x80012, head);
    let copy: usize = log_ring_trace_reader_order(&reader);
    log_ring_trace_store_at(1, 5, 6, LOG_RING_TRACE_COPY, 8, 0, 0, 0, 0, copy);
    // Negative old-order witness: CPU-grouped output starts with HEAD(1),
    // before BEGIN(0), which the unchanged parser must refuse.
    let old_first: usize = atomic_word_load(&log_ring_trace_cpus[0].events[0].tag);
    if (((old_first >> 16) & 0xFFFF) != 1) { return LogRingTraceOrderProbe::Failed; }
    for order: usize in 0..<3 {
        match log_ring_trace_reader_position(order) {
            LogRingTracePosition::Missing => { return LogRingTraceOrderProbe::Failed; }
            LogRingTracePosition::Found(position) => {
                let (cpu, slot) = position;
                let mut wanted_cpu: usize = 1;
                if (order == 1) { wanted_cpu = 0; }
                let mut wanted_slot: usize = 0;
                if (order == 2) { wanted_slot = 1; }
                if (cpu != wanted_cpu || slot != wanted_slot) { return LogRingTraceOrderProbe::Failed; }
            }
        }
    }
    // Traverse the real emission path: 0,1,2 encodes as 0x012. Reverting
    // that traversal to CPU groups yields 1,0,2 (0x102), not this digest.
    if (log_ring_trace_report_events(false) != 0x012) { return LogRingTraceOrderProbe::Failed; }
    // Exhaustion is reported as loss rather than recycling an ordinal.
    reader.ordinal = LOG_RING_TRACE_READER_EVENTS;
    let exhausted: usize = log_ring_trace_reader_order(&reader);
    log_ring_trace_store_at(0, 7, 8, LOG_RING_TRACE_CHECK, 8, 0, 0, 0, 0x80012, exhausted);
    if (reader.ordinal != LOG_RING_TRACE_READER_EVENTS ||
        atomic_word_load(&log_ring_trace_cpus[0].claimed) <= LOG_RING_TRACE_EVENTS) {
        return LogRingTraceOrderProbe::Failed;
    }
    return LogRingTraceOrderProbe::Passed;
}

// Core 0, with no other CPU writing a buffer: forget the last window and
// open the next at `head`, the head this caller just read.
fn log_ring_trace_open(head: usize) {
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        atomic_word_store(&log_ring_trace_cpus[cpu].claimed, 0);
    }
    atomic_word_store(&log_ring_trace_from, head);
    atomic_word_store(&log_ring_trace_active, 1);
}

fn log_ring_trace_close() {
    atomic_word_store(&log_ring_trace_active, 0);
}

private fn log_ring_trace_put(value: usize) {
    kernel_boot_log(" ");
    uart_put_udec(value);
}

private fn log_ring_trace_out(kind: usize, out: usize) {
    if (out == LOG_RING_TRACE_OUT_LOST) { kernel_boot_log(" lost"); return; }
    if (out == LOG_RING_TRACE_OUT_OTHER) {
        if (kind == LOG_RING_TRACE_HEAD) { kernel_boot_log(" skip"); }
        else { kernel_boot_log(" cont"); }
        return;
    }
    if (kind == LOG_RING_TRACE_HEAD || kind == LOG_RING_TRACE_CCOPY) {
        kernel_boot_log(" copy");
    } else {
        kernel_boot_log(" kept");
    }
}

private fn log_ring_trace_line(cpu: {0..<KERNEL_MAX_CORES as usize},
                               slot: {0..<LOG_RING_TRACE_EVENTS as usize}) {
    let tag: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].tag);
    let first: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].first);
    let word: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].word);
    let t0: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].t0);
    let kind: usize = tag & 15;
    let k: usize = (tag >> 4) & 15;
    let i: usize = (tag >> 8) & 15;
    let out: usize = (tag >> 12) & 15;
    kernel_boot_log("log-ring-trace: ");
    if (kind < LOG_RING_TRACE_BEGIN) {
        kernel_boot_log("w");
        uart_put_udec(cpu);
        if (kind == LOG_RING_TRACE_RESERVE) { kernel_boot_log(" reserve"); }
        else if (kind == LOG_RING_TRACE_CLAIM) { kernel_boot_log(" claim"); }
        else if (kind == LOG_RING_TRACE_REFUSE) { kernel_boot_log(" refuse"); }
        else if (kind == LOG_RING_TRACE_COMMITLOST) { kernel_boot_log(" commitlost"); }
        else if (kind == LOG_RING_TRACE_WRITE) { kernel_boot_log(" write"); }
        else { kernel_boot_log(" commit"); }
        log_ring_trace_put(first);
        log_ring_trace_put(k);
        if (kind != LOG_RING_TRACE_RESERVE) { log_ring_trace_put(i); }
        if (kind == LOG_RING_TRACE_CLAIM || kind == LOG_RING_TRACE_REFUSE ||
            kind == LOG_RING_TRACE_COMMITLOST) {
            log_ring_trace_put(word);
        }
    } else if (kind == LOG_RING_TRACE_BEGIN) {
        kernel_boot_log("r begin");
        log_ring_trace_put(first);
        log_ring_trace_put(word);
        kernel_boot_log("\n");
        return;
    } else {
        if (kind == LOG_RING_TRACE_HEAD) { kernel_boot_log("r head"); }
        else if (kind == LOG_RING_TRACE_COPY) { kernel_boot_log("r copy"); }
        else if (kind == LOG_RING_TRACE_CHECK) { kernel_boot_log("r check"); }
        else if (kind == LOG_RING_TRACE_CCOPY) { kernel_boot_log("r ccopy"); }
        else { kernel_boot_log("r ccheck"); }
        log_ring_trace_put(first);
        if (kind != LOG_RING_TRACE_COPY) {
            log_ring_trace_put(word);
            log_ring_trace_out(kind, out);
        }
    }
    kernel_boot_log(" @");
    uart_put_udec(t0);
    kernel_boot_log("+");
    uart_put_udec(tag >> 32);
    kernel_boot_log("\n");
}

// After log_ring_trace_close, from a context that may print. Writers retain
// CPU buffer order; reader events follow their explicit logical ordinal.
// scripts/validate_log_ring_trace.py is the only reader.
fn log_ring_trace_report() {
    let mut stored: usize = 0;
    let mut lost: usize = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        let count: usize = atomic_word_load(&log_ring_trace_cpus[cpu].claimed);
        if (count > LOG_RING_TRACE_EVENTS) {
            stored = stored + LOG_RING_TRACE_EVENTS;
            lost = lost + count - LOG_RING_TRACE_EVENTS;
        } else {
            stored = stored + count;
        }
    }
    kernel_boot_log("log-ring-trace: begin cpus=");
    uart_put_udec(KERNEL_MAX_CORES);
    kernel_boot_log(" slots=");
    uart_put_udec(kernel_log_raw_slot_count());
    kernel_boot_log(" head=");
    uart_put_udec(atomic_word_load(&log_ring_trace_from));
    kernel_boot_log(" stored=");
    uart_put_udec(stored);
    kernel_boot_log(" lost=");
    uart_put_udec(lost);
    kernel_boot_log("\n");
    log_ring_trace_report_events(true);
    kernel_boot_log("log-ring-trace: end\n");
}

// The actual report traversal, also exercised without printing before the
// window. Its reader-order digest is a fixture observation, not a protocol
// proof or a substitute for the unchanged external trace validator.
private fn log_ring_trace_report_events(print: bool) -> usize {
    let mut digest: usize = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        let count: usize = atomic_word_load(&log_ring_trace_cpus[cpu].claimed);
        for slot: usize in 0..<LOG_RING_TRACE_EVENTS {
            if (slot < count) {
                let tag: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].tag);
                if ((tag & 15) < LOG_RING_TRACE_BEGIN && print) { log_ring_trace_line(cpu, slot); }
            }
        }
    }
    let mut order: usize = 0;
    while (order < LOG_RING_TRACE_READER_EVENTS) {
        match log_ring_trace_reader_position(order) {
            // A hole after a lost event is already a refused window. Stop
            // rather than manufacturing a stream from its surviving suffix.
            LogRingTracePosition::Missing => { order = LOG_RING_TRACE_READER_EVENTS; }
            LogRingTracePosition::Found(position) => {
                let (cpu, slot) = position;
                if (cpu < KERNEL_MAX_CORES && slot < LOG_RING_TRACE_EVENTS) {
                    let tag: usize = atomic_word_load(&log_ring_trace_cpus[cpu].events[slot].tag);
                    digest = (digest << 4) ^ ((tag >> 16) & 0xFFFF);
                    if (print) { log_ring_trace_line(cpu, slot); }
                }
                order = order + 1;
            }
        }
    }
    return digest;
}
