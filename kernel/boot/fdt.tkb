// Minimal, bounded Flattened Device Tree reader for early kernel boot.
//
// The input is an untrusted physical boot boundary: firmware, QEMU, or a
// debugger-assisted loader supplies its address.  Every offset and length is
// checked against the blob's totalsize before a byte is read.  Raw pointers
// are deliberate here because no Takibi array owns firmware-provided memory.
//
// FdtMemoryMap is a view over the validated blob rather than a fixed-capacity
// array. region_at() repeatedly rescans the structure block while sweeping its
// finite interval endpoints. This deliberately trades early-boot CPU time for
// sorted, overlap-free output without replacing the DTB's own finite size with
// an arbitrary MAX_MEMORY_REGIONS resource ceiling before an allocator exists.

const FDT_MAGIC: usize = 0xd00dfeed;
const FDT_HEADER_SIZE: usize = 40;
const FDT_MAX_SIZE: usize = 1024 * 1024;

const FDT_BEGIN_NODE: usize = 1;
const FDT_END_NODE: usize = 2;
const FDT_PROP: usize = 3;
const FDT_NOP: usize = 4;
const FDT_END: usize = 9;

struct PhysicalMemoryRegion {
    base: usize;
    size: usize;
}

struct FdtMemoryMap {
    private dtb: usize;
    private raw_region_count: usize;
    private reservation_count: usize;
    private tree_reservation_count: usize;
}

must_use variant FdtMemoryResult {
    Invalid;
    NotFound;
    Found(FdtMemoryMap);
}

must_use variant FdtMemoryRegionResult {
    Invalid;
    OutOfRange;
    Found(PhysicalMemoryRegion);
}

struct FdtDeviceRegion {
    base: usize;
    size: usize;
    private dtb: usize;
    private reg_offset: usize;
    private reg_length: usize;
    private address_cells: usize;
    private size_cells: usize;
    private direct_root_child: bool;
    private interrupt_parent: usize;
    private interrupts_offset: usize;
    private interrupts_length: usize;
}

struct FdtGicV2Regions {
    distributor: FdtDeviceRegion;
    cpu_interface: FdtDeviceRegion;
}

struct FdtGicInterrupt {
    intid: usize;
    flags: usize;
}

// Deliberately narrow device lookup for the drivers being migrated from
// constants. It accepts a root child (QEMU virt's PL011), one simple-bus
// translation (an RPi5 SoC-direct device), or the concrete
// root/axi/PCIe/RP1/device path used by the current RPi5 UART. It is not a
// general path, phandle, or recursively translated device-tree framework.
must_use variant FdtDeviceRegionResult {
    Invalid;
    NotFound;
    Found(FdtDeviceRegion);
}

must_use variant FdtGicInterruptResult {
    Invalid;
    NotFound;
    Found(FdtGicInterrupt);
}

must_use variant FdtGicV2RegionsResult {
    Invalid;
    NotFound;
    Found(FdtGicV2Regions);
}

struct FdtScanMemory {
    first_base: usize;
    total_size: usize;
    region_count: usize;
    wanted_base: usize;
    wanted_size: usize;
    wanted_found: bool;
}

// Internal result used across the one unsafe boundary below. The public
// result remains must_use; this duplicate shape avoids hiding a must-use
// call syntactically inside an unsafe expression.
variant FdtScanResult {
    Invalid;
    NotFound;
    Found(FdtScanMemory);
}

struct FdtReservationScan {
    count: usize;
    wanted_base: usize;
    wanted_size: usize;
    wanted_found: bool;
}

variant FdtReservationScanResult {
    Invalid;
    Found(FdtReservationScan);
}

struct FdtInterruptControllerScan {
    interrupt_cells: usize;
}

variant FdtInterruptControllerScanResult {
    Invalid;
    NotFound;
    Found(FdtInterruptControllerScan);
}

private fn fdt_range_valid(total: usize, offset: usize, length: usize)
        -> bool {
    return offset <= total && length <= total - offset;
}

private fn fdt_read_u8(base: usize, total: usize, offset: usize) -> usize
        !{unsafe} {
    if (fdt_range_valid(total, offset, 1) == false ||
        base > 0xFFFFFFFFFFFFFFFF - offset) { return 0; }
    let p: *u8 = unsafe { (base + offset) as *u8 };
    return *p as usize;
}

private fn fdt_read_be32(base: usize, total: usize, offset: usize) -> usize
        !{unsafe} {
    if (fdt_range_valid(total, offset, 4) == false) { return 0; }
    return (fdt_read_u8(base, total, offset) << 24) |
           (fdt_read_u8(base, total, offset + 1) << 16) |
           (fdt_read_u8(base, total, offset + 2) << 8) |
           fdt_read_u8(base, total, offset + 3);
}

private fn fdt_read_be64(base: usize, total: usize, offset: usize) -> usize
        !{unsafe} {
    if (fdt_range_valid(total, offset, 8) == false) { return 0; }
    return (fdt_read_be32(base, total, offset) << 32) |
           fdt_read_be32(base, total, offset + 4);
}

private fn fdt_scan_reservations(base: usize, total: usize, wanted: usize)
        -> FdtReservationScanResult !{unsafe} {
    let offset: usize = fdt_read_be32(base, total, 16);
    if ((offset & 7) != 0 || offset < FDT_HEADER_SIZE || offset > total) {
        return FdtReservationScanResult::Invalid;
    }
    let mut cursor: usize = offset;
    let mut count: usize = 0;
    let mut wanted_base: usize = 0;
    let mut wanted_size: usize = 0;
    let mut wanted_found: bool = false;
    while (fdt_range_valid(total, cursor, 16)) {
        let address: usize = fdt_read_be64(base, total, cursor);
        let size: usize = fdt_read_be64(base, total, cursor + 8);
        if (address == 0 && size == 0) {
            let mut scan: FdtReservationScan = {
                count, wanted_base, wanted_size, wanted_found
            };
            return FdtReservationScanResult::Found(scan);
        }
        if (size == 0 || address > 0xFFFFFFFFFFFFFFFF - size ||
            count == 0xFFFFFFFFFFFFFFFF) {
            return FdtReservationScanResult::Invalid;
        }
        if (count == wanted) {
            wanted_base = address;
            wanted_size = size;
            wanted_found = true;
        }
        count = count + 1;
        cursor = cursor + 16;
    }
    return FdtReservationScanResult::Invalid;
}

private fn fdt_align4(value: usize) -> usize {
    if (value > 0xFFFFFFFFFFFFFFFC) { return 0; }
    return (value + 3) & 0xFFFFFFFFFFFFFFFC;
}

private fn fdt_string_is(base: usize, total: usize, offset: usize,
                         expected: []u8) -> bool !{unsafe} {
    if (offset > total || expected.len >= total - offset) { return false; }
    for i: usize in 0..<expected.len {
        if (fdt_read_u8(base, total, offset + i) != expected[i] as usize) {
            return false;
        }
    }
    return fdt_read_u8(base, total, offset + expected.len) == 0;
}

private fn fdt_string_list_contains(base: usize, total: usize, offset: usize,
                                    length: usize, wanted: []u8)
        -> bool !{unsafe} {
    if (fdt_range_valid(total, offset, length) == false) { return false; }
    let end: usize = offset + length;
    let mut item: usize = offset;
    while (item < end) {
        let mut item_end: usize = item;
        while (item_end < end && fdt_read_u8(base, total, item_end) != 0) {
            item_end = item_end + 1;
        }
        if (item_end >= end) { return false; }
        if (item_end - item == wanted.len &&
            fdt_string_is(base, item_end + 1, item, wanted)) {
            return true;
        }
        item = item_end + 1;
    }
    return false;
}

private fn fdt_node_is_memory(base: usize, total: usize, offset: usize)
        -> bool !{unsafe} {
    let name: [u8; 6..] = bs"memory";
    if (fdt_range_valid(total, offset, 7) == false) { return false; }
    for i: usize in 0..<6 {
        if (fdt_read_u8(base, total, offset + i) != name[i] as usize) {
            return false;
        }
    }
    let suffix: usize = fdt_read_u8(base, total, offset + 6);
    return suffix == 0 || suffix == '@' as usize;
}

private fn fdt_node_is_reserved_memory(base: usize, total: usize,
                                       offset: usize) -> bool !{unsafe} {
    let name: [u8; 15..] = bs"reserved-memory";
    if (fdt_range_valid(total, offset, 16) == false) { return false; }
    for i: usize in 0..<15 {
        if (fdt_read_u8(base, total, offset + i) != name[i] as usize) {
            return false;
        }
    }
    let suffix: usize = fdt_read_u8(base, total, offset + 15);
    return suffix == 0 || suffix == '@' as usize;
}

private fn fdt_cells_value(base: usize, total: usize, offset: usize,
                           cells: usize) -> usize !{unsafe} {
    if (cells == 1) { return fdt_read_be32(base, total, offset); }
    if (cells == 2) {
        let high: usize = fdt_read_be32(base, total, offset);
        let low: usize = fdt_read_be32(base, total, offset + 4);
        return (high << 32) | low;
    }
    return 0;
}

private fn fdt_reg_length_valid(length: usize, address_cells: usize,
                                size_cells: usize) -> bool {
    if (address_cells == 1 && size_cells == 1) {
        return length >= 8 && length % 8 == 0;
    }
    if ((address_cells == 1 && size_cells == 2) ||
        (address_cells == 2 && size_cells == 1)) {
        return length >= 12 && length % 12 == 0;
    }
    if (address_cells == 2 && size_cells == 2) {
        return length >= 16 && length % 16 == 0;
    }
    return false;
}

private fn fdt_ranges_length_valid(length: usize, child_cells: usize,
                                   parent_cells: usize, size_cells: usize)
        -> bool {
    let cells: usize = child_cells + parent_cells + size_cells;
    if (cells == 3) { return length >= 12 && length % 12 == 0; }
    if (cells == 4) { return length >= 16 && length % 16 == 0; }
    if (cells == 5) { return length >= 20 && length % 20 == 0; }
    if (cells == 6) { return length >= 24 && length % 24 == 0; }
    return false;
}

private fn fdt_scan_memory(base: usize, wanted: usize)
        -> FdtScanResult !{unsafe} {
    // A zero physical address is valid: QEMU virt places its generated FDT
    // there.  Validate content, never use the address as an absence sentinel.
    let header_total: usize = FDT_HEADER_SIZE;
    if (fdt_read_be32(base, header_total, 0) != FDT_MAGIC) {
        return FdtScanResult::Invalid;
    }
    let total: usize = fdt_read_be32(base, header_total, 4);
    if (total < FDT_HEADER_SIZE || total > FDT_MAX_SIZE) {
        return FdtScanResult::Invalid;
    }

    let struct_offset: usize = fdt_read_be32(base, total, 8);
    let strings_offset: usize = fdt_read_be32(base, total, 12);
    let strings_size: usize = fdt_read_be32(base, total, 32);
    let struct_size: usize = fdt_read_be32(base, total, 36);
    let version: usize = fdt_read_be32(base, total, 20);
    let last_compatible_version: usize = fdt_read_be32(base, total, 24);
    if (fdt_range_valid(total, struct_offset, struct_size) == false ||
        fdt_range_valid(total, strings_offset, strings_size) == false ||
        (struct_offset & 3) != 0 || version < 17 ||
        last_compatible_version > 17) {
        return FdtScanResult::Invalid;
    }

    let struct_end: usize = struct_offset + struct_size;
    let strings_end: usize = strings_offset + strings_size;
    let mut cursor: usize = struct_offset;
    let mut depth: usize = 0;
    let mut address_cells: usize = 2;
    let mut size_cells: usize = 1;
    let mut memory_depth: usize = 0;
    let mut memory_type: bool = false;
    let mut memory_enabled: bool = true;
    let mut candidate_valid: bool = false;
    let mut candidate_invalid: bool = false;
    let mut candidate_offset: usize = 0;
    let mut candidate_length: usize = 0;
    let mut first_base: usize = 0;
    let mut total_size: usize = 0;
    let mut region_count: usize = 0;
    let mut wanted_base: usize = 0;
    let mut wanted_size: usize = 0;
    let mut wanted_found: bool = false;

    while (cursor < struct_end) {
        if (fdt_range_valid(struct_end, cursor, 4) == false) {
            return FdtScanResult::Invalid;
        }
        let token: usize = fdt_read_be32(base, total, cursor);
        cursor = cursor + 4;
        if (token == FDT_BEGIN_NODE) {
            let name_offset: usize = cursor;
            let mut name_end: usize = cursor;
            while (name_end < struct_end &&
                   fdt_read_u8(base, total, name_end) != 0) {
                name_end = name_end + 1;
            }
            if (name_end >= struct_end) { return FdtScanResult::Invalid; }
            depth = depth + 1;
            if (depth == 2 && fdt_node_is_memory(base, total, name_offset)) {
                memory_depth = depth;
                memory_type = false;
                memory_enabled = true;
                candidate_valid = false;
                candidate_invalid = false;
                candidate_offset = 0;
                candidate_length = 0;
            }
            cursor = fdt_align4(name_end + 1);
            if (cursor == 0 || cursor > struct_end) {
                return FdtScanResult::Invalid;
            }
        } else if (token == FDT_END_NODE) {
            if (depth == 0) { return FdtScanResult::Invalid; }
            if (memory_depth == depth) {
                if (memory_enabled && candidate_invalid) {
                    return FdtScanResult::Invalid;
                }
                if (memory_enabled && memory_type && candidate_valid) {
                    let tuple_bytes: usize =
                        (address_cells + size_cells) * 4;
                    let mut relative: usize = 0;
                    while (relative <= candidate_length - tuple_bytes) {
                        let region_base: usize = fdt_cells_value(
                            base, total, candidate_offset + relative,
                            address_cells);
                        let region_size: usize = fdt_cells_value(
                            base, total,
                            candidate_offset + relative + address_cells * 4,
                            size_cells);
                        if (region_size != 0) {
                            if (region_base > 0xFFFFFFFFFFFFFFFF - region_size ||
                                total_size > 0xFFFFFFFFFFFFFFFF - region_size ||
                                region_count == 0xFFFFFFFFFFFFFFFF) {
                                return FdtScanResult::Invalid;
                            }
                            if (region_count == 0) { first_base = region_base; }
                            if (region_count == wanted) {
                                wanted_base = region_base;
                                wanted_size = region_size;
                                wanted_found = true;
                            }
                            total_size = total_size + region_size;
                            region_count = region_count + 1;
                        }
                        relative = relative + tuple_bytes;
                    }
                }
                memory_depth = 0;
            }
            depth = depth - 1;
        } else if (token == FDT_PROP) {
            if (fdt_range_valid(struct_end, cursor, 8) == false) {
                return FdtScanResult::Invalid;
            }
            let length: usize = fdt_read_be32(base, total, cursor);
            let name_relative: usize = fdt_read_be32(base, total, cursor + 4);
            cursor = cursor + 8;
            if (name_relative >= strings_size ||
                fdt_range_valid(struct_end, cursor, length) == false) {
                return FdtScanResult::Invalid;
            }
            let prop_name: usize = strings_offset + name_relative;
            if (prop_name >= strings_end) { return FdtScanResult::Invalid; }
            if (depth == 1 && length == 4 &&
                fdt_string_is(base, strings_end, prop_name,
                              bs"#address-cells")) {
                address_cells = fdt_read_be32(base, total, cursor);
            } else if (depth == 1 && length == 4 &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"#size-cells")) {
                size_cells = fdt_read_be32(base, total, cursor);
            } else if (memory_depth == depth &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"device_type")) {
                memory_type = length >= 7 &&
                    fdt_string_is(base, cursor + length, cursor, bs"memory");
            } else if (memory_depth == depth &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"status")) {
                memory_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            } else if (memory_depth == depth &&
                       fdt_string_is(base, strings_end, prop_name, bs"reg")) {
                if ((address_cells == 1 || address_cells == 2) &&
                    (size_cells == 1 || size_cells == 2)) {
                    let tuple_bytes: usize = (address_cells + size_cells) * 4;
                    if (fdt_reg_length_valid(
                            length, address_cells, size_cells)) {
                        candidate_offset = cursor;
                        candidate_length = length;
                        candidate_valid = true;
                    } else {
                        candidate_invalid = true;
                    }
                }
            }
            let next: usize = fdt_align4(cursor + length);
            if (next == 0 || next > struct_end) {
                return FdtScanResult::Invalid;
            }
            cursor = next;
        } else if (token == FDT_NOP) {
        } else if (token == FDT_END) {
            if (depth != 0) { return FdtScanResult::Invalid; }
            if (region_count == 0) { return FdtScanResult::NotFound; }
            let mut memory: FdtScanMemory = {
                first_base, total_size, region_count,
                wanted_base, wanted_size, wanted_found
            };
            return FdtScanResult::Found(memory);
        } else {
            return FdtScanResult::Invalid;
        }
    }
    return FdtScanResult::Invalid;
}

private fn fdt_scan_tree_reservations(base: usize, wanted: usize)
        -> FdtReservationScanResult !{unsafe} {
    if (fdt_read_be32(base, FDT_HEADER_SIZE, 0) != FDT_MAGIC) {
        return FdtReservationScanResult::Invalid;
    }
    let total: usize = fdt_read_be32(base, FDT_HEADER_SIZE, 4);
    if (total < FDT_HEADER_SIZE || total > FDT_MAX_SIZE) {
        return FdtReservationScanResult::Invalid;
    }
    let struct_offset: usize = fdt_read_be32(base, total, 8);
    let strings_offset: usize = fdt_read_be32(base, total, 12);
    let strings_size: usize = fdt_read_be32(base, total, 32);
    let struct_size: usize = fdt_read_be32(base, total, 36);
    if (fdt_range_valid(total, struct_offset, struct_size) == false ||
        fdt_range_valid(total, strings_offset, strings_size) == false) {
        return FdtReservationScanResult::Invalid;
    }
    let struct_end: usize = struct_offset + struct_size;
    let strings_end: usize = strings_offset + strings_size;
    let mut cursor: usize = struct_offset;
    let mut depth: usize = 0;
    let mut root_address_cells: usize = 2;
    let mut root_size_cells: usize = 1;
    let mut reserved_depth: usize = 0;
    let mut address_cells: usize = 2;
    let mut size_cells: usize = 1;
    let mut child_depth: usize = 0;
    let mut child_enabled: bool = true;
    let mut candidate_valid: bool = false;
    let mut candidate_invalid: bool = false;
    let mut candidate_offset: usize = 0;
    let mut candidate_length: usize = 0;
    let mut count: usize = 0;
    let mut wanted_base: usize = 0;
    let mut wanted_size: usize = 0;
    let mut wanted_found: bool = false;
    while (cursor < struct_end) {
        if (fdt_range_valid(struct_end, cursor, 4) == false) {
            return FdtReservationScanResult::Invalid;
        }
        let token: usize = fdt_read_be32(base, total, cursor);
        cursor = cursor + 4;
        if (token == FDT_BEGIN_NODE) {
            let name_offset: usize = cursor;
            let mut name_end: usize = cursor;
            while (name_end < struct_end &&
                   fdt_read_u8(base, total, name_end) != 0) {
                name_end = name_end + 1;
            }
            if (name_end >= struct_end) {
                return FdtReservationScanResult::Invalid;
            }
            depth = depth + 1;
            if (depth == 2 && fdt_node_is_reserved_memory(
                    base, total, name_offset)) {
                reserved_depth = depth;
                address_cells = root_address_cells;
                size_cells = root_size_cells;
            } else if (reserved_depth != 0 &&
                       depth == reserved_depth + 1) {
                child_depth = depth;
                child_enabled = true;
                candidate_valid = false;
                candidate_invalid = false;
            }
            cursor = fdt_align4(name_end + 1);
            if (cursor == 0 || cursor > struct_end) {
                return FdtReservationScanResult::Invalid;
            }
        } else if (token == FDT_END_NODE) {
            if (depth == 0) { return FdtReservationScanResult::Invalid; }
            if (child_depth == depth) {
                if (child_enabled && candidate_invalid) {
                    return FdtReservationScanResult::Invalid;
                }
                if (child_enabled && candidate_valid) {
                    let tuple_bytes: usize =
                        (address_cells + size_cells) * 4;
                    let mut relative: usize = 0;
                    while (relative <= candidate_length - tuple_bytes) {
                        let address: usize = fdt_cells_value(
                            base, total, candidate_offset + relative,
                            address_cells);
                        let size: usize = fdt_cells_value(
                            base, total,
                            candidate_offset + relative + address_cells * 4,
                            size_cells);
                        if (size == 0 ||
                            address > 0xFFFFFFFFFFFFFFFF - size ||
                            count == 0xFFFFFFFFFFFFFFFF) {
                            return FdtReservationScanResult::Invalid;
                        }
                        if (count == wanted) {
                            wanted_base = address;
                            wanted_size = size;
                            wanted_found = true;
                        }
                        count = count + 1;
                        relative = relative + tuple_bytes;
                    }
                }
                child_depth = 0;
            }
            if (reserved_depth == depth) { reserved_depth = 0; }
            depth = depth - 1;
        } else if (token == FDT_PROP) {
            if (fdt_range_valid(struct_end, cursor, 8) == false) {
                return FdtReservationScanResult::Invalid;
            }
            let length: usize = fdt_read_be32(base, total, cursor);
            let name_relative: usize = fdt_read_be32(base, total, cursor + 4);
            cursor = cursor + 8;
            if (name_relative >= strings_size ||
                fdt_range_valid(struct_end, cursor, length) == false) {
                return FdtReservationScanResult::Invalid;
            }
            let prop_name: usize = strings_offset + name_relative;
            if (prop_name >= strings_end) {
                return FdtReservationScanResult::Invalid;
            }
            if (depth == 1 && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#address-cells")) {
                root_address_cells = fdt_read_be32(base, total, cursor);
            } else if (depth == 1 && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#size-cells")) {
                root_size_cells = fdt_read_be32(base, total, cursor);
            } else if (reserved_depth == depth && length == 4 &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"#address-cells")) {
                address_cells = fdt_read_be32(base, total, cursor);
            } else if (reserved_depth == depth && length == 4 &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"#size-cells")) {
                size_cells = fdt_read_be32(base, total, cursor);
            } else if (child_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"status")) {
                child_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            } else if (child_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"reg")) {
                if (fdt_reg_length_valid(
                        length, address_cells, size_cells)) {
                    candidate_offset = cursor;
                    candidate_length = length;
                    candidate_valid = true;
                } else {
                    candidate_invalid = true;
                }
            }
            let next: usize = fdt_align4(cursor + length);
            if (next == 0 || next > struct_end) {
                return FdtReservationScanResult::Invalid;
            }
            cursor = next;
        } else if (token == FDT_NOP) {
        } else if (token == FDT_END) {
            if (depth != 0) { return FdtReservationScanResult::Invalid; }
            let mut scan: FdtReservationScan = {
                count, wanted_base, wanted_size, wanted_found
            };
            return FdtReservationScanResult::Found(scan);
        } else {
            return FdtReservationScanResult::Invalid;
        }
    }
    return FdtReservationScanResult::Invalid;
}

private fn fdt_find_compatible_reg_bounded(
        base: usize, compatible: []u8, pcie_nested_only: bool)
        -> FdtDeviceRegionResult !{unsafe} {
    if (fdt_read_be32(base, FDT_HEADER_SIZE, 0) != FDT_MAGIC) {
        return FdtDeviceRegionResult::Invalid;
    }
    let total: usize = fdt_read_be32(base, FDT_HEADER_SIZE, 4);
    if (total < FDT_HEADER_SIZE || total > FDT_MAX_SIZE) {
        return FdtDeviceRegionResult::Invalid;
    }
    let struct_offset: usize = fdt_read_be32(base, total, 8);
    let strings_offset: usize = fdt_read_be32(base, total, 12);
    let strings_size: usize = fdt_read_be32(base, total, 32);
    let struct_size: usize = fdt_read_be32(base, total, 36);
    if (fdt_range_valid(total, struct_offset, struct_size) == false ||
        fdt_range_valid(total, strings_offset, strings_size) == false ||
        (struct_offset & 3) != 0) {
        return FdtDeviceRegionResult::Invalid;
    }

    let struct_end: usize = struct_offset + struct_size;
    let strings_end: usize = strings_offset + strings_size;
    let mut cursor: usize = struct_offset;
    let mut depth: usize = 0;
    let mut root_address_cells: usize = 2;
    let mut root_size_cells: usize = 1;
    let mut root_interrupt_parent: usize = 0;

    // The sole supported translated shape is root -> bus -> device. Keep the
    // bus properties as offsets and decode ranges only when the child closes:
    // property order is unspecified, and the Pi 5 blob puts ranges first.
    let mut bus_depth: usize = 0;
    let mut bus_address_cells: usize = 2;
    let mut bus_size_cells: usize = 1;
    let mut bus_ranges_seen: bool = false;
    let mut bus_ranges_offset: usize = 0;
    let mut bus_ranges_length: usize = 0;

    let mut candidate_depth: usize = 0;
    let mut candidate_enabled: bool = true;
    let mut candidate_compatible: bool = false;
    let mut candidate_reg_seen: bool = false;
    let mut candidate_reg_offset: usize = 0;
    let mut candidate_reg_length: usize = 0;
    let mut candidate_interrupt_parent: usize = 0;
    let mut candidate_interrupts_offset: usize = 0;
    let mut candidate_interrupts_length: usize = 0;

    // The other bounded shape is root -> axi -> PCIe -> RP1 -> device.
    // PCI child addresses have a leading flags cell, so this remains a
    // separate concrete path rather than pretending ordinary 64-bit bus
    // addresses and PCI addresses are interchangeable.
    let mut pcie_depth: usize = 0;
    let mut pcie_enabled: bool = true;
    let mut pcie_compatible: bool = false;
    let mut pcie_address_cells: usize = 0;
    let mut pcie_size_cells: usize = 0;
    let mut pcie_ranges_seen: bool = false;
    let mut pcie_ranges_offset: usize = 0;
    let mut pcie_ranges_length: usize = 0;
    let mut rp1_depth: usize = 0;
    let mut rp1_enabled: bool = true;
    let mut rp1_compatible: bool = false;
    let mut rp1_address_cells: usize = 0;
    let mut rp1_size_cells: usize = 0;
    let mut rp1_ranges_seen: bool = false;
    let mut rp1_ranges_offset: usize = 0;
    let mut rp1_ranges_length: usize = 0;
    let mut nested_depth: usize = 0;
    let mut nested_enabled: bool = true;
    let mut nested_compatible: bool = false;
    let mut nested_reg_seen: bool = false;
    let mut nested_reg_offset: usize = 0;
    let mut nested_reg_length: usize = 0;

    while (cursor < struct_end) {
        if (fdt_range_valid(struct_end, cursor, 4) == false) {
            return FdtDeviceRegionResult::Invalid;
        }
        let token: usize = fdt_read_be32(base, total, cursor);
        cursor = cursor + 4;
        if (token == FDT_BEGIN_NODE) {
            let mut name_end: usize = cursor;
            while (name_end < struct_end &&
                   fdt_read_u8(base, total, name_end) != 0) {
                name_end = name_end + 1;
            }
            if (name_end >= struct_end) {
                return FdtDeviceRegionResult::Invalid;
            }
            depth = depth + 1;
            if (depth == 2) {
                bus_depth = depth;
                bus_address_cells = root_address_cells;
                bus_size_cells = root_size_cells;
                bus_ranges_seen = false;
                bus_ranges_offset = 0;
                bus_ranges_length = 0;
                candidate_depth = depth;
                candidate_enabled = true;
                candidate_compatible = false;
                candidate_reg_seen = false;
                candidate_interrupt_parent = root_interrupt_parent;
                candidate_interrupts_offset = 0;
                candidate_interrupts_length = 0;
            } else if (depth == 3 && bus_depth == 2 &&
                       (candidate_depth == 0 ||
                        candidate_compatible == false)) {
                candidate_depth = depth;
                candidate_enabled = true;
                candidate_compatible = false;
                candidate_reg_seen = false;
                candidate_interrupt_parent = root_interrupt_parent;
                candidate_interrupts_offset = 0;
                candidate_interrupts_length = 0;
            }
            if (depth == 3 && bus_depth == 2) {
                pcie_depth = depth;
                pcie_enabled = true;
                pcie_compatible = false;
                pcie_address_cells = 0;
                pcie_size_cells = 0;
                pcie_ranges_seen = false;
                pcie_ranges_offset = 0;
                pcie_ranges_length = 0;
            } else if (depth == 4 && pcie_depth == 3) {
                rp1_depth = depth;
                rp1_enabled = true;
                rp1_compatible = false;
                rp1_address_cells = 0;
                rp1_size_cells = 0;
                rp1_ranges_seen = false;
                rp1_ranges_offset = 0;
                rp1_ranges_length = 0;
            } else if (depth == 5 && rp1_depth == 4) {
                nested_depth = depth;
                nested_enabled = true;
                nested_compatible = false;
                nested_reg_seen = false;
                nested_reg_offset = 0;
                nested_reg_length = 0;
            }
            cursor = fdt_align4(name_end + 1);
            if (cursor == 0 || cursor > struct_end) {
                return FdtDeviceRegionResult::Invalid;
            }
        } else if (token == FDT_END_NODE) {
            if (depth == 0) { return FdtDeviceRegionResult::Invalid; }
            if (nested_depth == depth) {
                if (nested_enabled && nested_compatible) {
                    if (pcie_enabled == false || pcie_compatible == false ||
                        pcie_address_cells != 3 || pcie_size_cells != 2 ||
                        pcie_ranges_seen == false ||
                        rp1_enabled == false || rp1_compatible == false ||
                        rp1_address_cells != 2 || rp1_size_cells != 2 ||
                        rp1_ranges_seen == false ||
                        nested_reg_seen == false || nested_reg_length < 16 ||
                        nested_reg_length % 16 != 0 ||
                        rp1_ranges_length < 28 ||
                        rp1_ranges_length % 28 != 0 ||
                        pcie_ranges_length < 28 ||
                        pcie_ranges_length % 28 != 0) {
                        return FdtDeviceRegionResult::Invalid;
                    }
                    let device_base: usize = fdt_cells_value(
                        base, total, nested_reg_offset, 2);
                    let device_size: usize = fdt_cells_value(
                        base, total, nested_reg_offset + 8, 2);
                    if (device_size == 0 || device_base >
                            0xFFFFFFFFFFFFFFFF - device_size) {
                        return FdtDeviceRegionResult::Invalid;
                    }

                    let mut pci_found: bool = false;
                    let mut pci_base: usize = 0;
                    let mut rp1_relative: usize = 0;
                    while (rp1_relative <= rp1_ranges_length - 28) {
                        let child_base: usize = fdt_cells_value(
                            base, total,
                            rp1_ranges_offset + rp1_relative, 2);
                        let pci_space: usize = fdt_read_be32(
                            base, total,
                            rp1_ranges_offset + rp1_relative + 8);
                        let parent_base: usize = fdt_cells_value(
                            base, total,
                            rp1_ranges_offset + rp1_relative + 12, 2);
                        let range_size: usize = fdt_cells_value(
                            base, total,
                            rp1_ranges_offset + rp1_relative + 20, 2);
                        if (range_size == 0 || child_base >
                                0xFFFFFFFFFFFFFFFF - range_size ||
                            parent_base >
                                0xFFFFFFFFFFFFFFFF - range_size) {
                            return FdtDeviceRegionResult::Invalid;
                        }
                        if (pci_space == 0x02000000 &&
                            device_base >= child_base &&
                            device_base - child_base < range_size &&
                            device_size <= range_size -
                                (device_base - child_base)) {
                            pci_base = parent_base +
                                (device_base - child_base);
                            pci_found = true;
                        }
                        rp1_relative = rp1_relative + 28;
                    }
                    if (pci_found == false) {
                        return FdtDeviceRegionResult::Invalid;
                    }

                    let mut physical_found: bool = false;
                    let mut physical_base: usize = 0;
                    let mut pcie_relative: usize = 0;
                    while (pcie_relative <= pcie_ranges_length - 28) {
                        let pci_space: usize = fdt_read_be32(
                            base, total,
                            pcie_ranges_offset + pcie_relative);
                        let child_base: usize = fdt_cells_value(
                            base, total,
                            pcie_ranges_offset + pcie_relative + 4, 2);
                        let parent_base: usize = fdt_cells_value(
                            base, total,
                            pcie_ranges_offset + pcie_relative + 12, 2);
                        let range_size: usize = fdt_cells_value(
                            base, total,
                            pcie_ranges_offset + pcie_relative + 20, 2);
                        if (range_size == 0 || child_base >
                                0xFFFFFFFFFFFFFFFF - range_size ||
                            parent_base >
                                0xFFFFFFFFFFFFFFFF - range_size) {
                            return FdtDeviceRegionResult::Invalid;
                        }
                        if (pci_space == 0x02000000 &&
                            pci_base >= child_base &&
                            pci_base - child_base < range_size &&
                            device_size <= range_size -
                                (pci_base - child_base)) {
                            physical_base = parent_base +
                                (pci_base - child_base);
                            physical_found = true;
                        }
                        pcie_relative = pcie_relative + 28;
                    }
                    if (physical_found == false) {
                        return FdtDeviceRegionResult::Invalid;
                    }
                    let mut region: FdtDeviceRegion = {
                        physical_base, device_size,
                        base, nested_reg_offset, nested_reg_length, 2, 2,
                        false, 0, 0, 0
                    };
                    return FdtDeviceRegionResult::Found(region);
                }
                nested_depth = 0;
            }
            if (candidate_depth == depth) {
                if (candidate_enabled && candidate_compatible &&
                    pcie_nested_only == false) {
                    let mut address_cells: usize = bus_address_cells;
                    let mut size_cells: usize = bus_size_cells;
                    if (depth == 2) {
                        address_cells = root_address_cells;
                        size_cells = root_size_cells;
                    }
                    if (candidate_reg_seen == false ||
                        fdt_reg_length_valid(candidate_reg_length,
                                             address_cells, size_cells) ==
                            false) {
                        return FdtDeviceRegionResult::Invalid;
                    }
                    let child_base: usize = fdt_cells_value(
                        base, total, candidate_reg_offset, address_cells);
                    let child_size: usize = fdt_cells_value(
                        base, total,
                        candidate_reg_offset + address_cells * 4,
                        size_cells);
                    if (child_size == 0 ||
                        child_base > 0xFFFFFFFFFFFFFFFF - child_size) {
                        return FdtDeviceRegionResult::Invalid;
                    }
                    if (depth == 2) {
                        let mut region: FdtDeviceRegion = {
                            child_base, child_size,
                            base, candidate_reg_offset,
                            candidate_reg_length, address_cells, size_cells,
                            true,
                            candidate_interrupt_parent,
                            candidate_interrupts_offset,
                            candidate_interrupts_length
                        };
                        return FdtDeviceRegionResult::Found(region);
                    }
                    if (bus_ranges_seen == false) {
                        return FdtDeviceRegionResult::Invalid;
                    }
                    // Empty ranges means the parent and child address spaces
                    // are identical. This is common on simple buses.
                    if (bus_ranges_length == 0) {
                        let mut region: FdtDeviceRegion = {
                            child_base, child_size,
                            base, candidate_reg_offset,
                            candidate_reg_length, address_cells, size_cells,
                            false,
                            candidate_interrupt_parent,
                            candidate_interrupts_offset,
                            candidate_interrupts_length
                        };
                        return FdtDeviceRegionResult::Found(region);
                    }
                    let tuple_cells: usize = bus_address_cells +
                        root_address_cells + bus_size_cells;
                    if (fdt_ranges_length_valid(
                            bus_ranges_length, bus_address_cells,
                            root_address_cells, bus_size_cells) == false) {
                        return FdtDeviceRegionResult::Invalid;
                    }
                    let mut relative: usize = 0;
                    while (relative <= bus_ranges_length - tuple_cells * 4) {
                        let child_bus_base: usize = fdt_cells_value(
                            base, total, bus_ranges_offset + relative,
                            bus_address_cells);
                        let parent_base: usize = fdt_cells_value(
                            base, total,
                            bus_ranges_offset + relative +
                                bus_address_cells * 4,
                            root_address_cells);
                        let range_size: usize = fdt_cells_value(
                            base, total,
                            bus_ranges_offset + relative +
                                (bus_address_cells + root_address_cells) * 4,
                            bus_size_cells);
                        if (range_size == 0 ||
                            child_bus_base >
                                0xFFFFFFFFFFFFFFFF - range_size ||
                            parent_base > 0xFFFFFFFFFFFFFFFF - range_size) {
                            return FdtDeviceRegionResult::Invalid;
                        }
                        if (child_base >= child_bus_base &&
                            child_base - child_bus_base < range_size &&
                            child_size <= range_size -
                                (child_base - child_bus_base)) {
                            let translated: usize = parent_base +
                                (child_base - child_bus_base);
                            let mut region: FdtDeviceRegion = {
                                translated, child_size,
                                base, candidate_reg_offset,
                                candidate_reg_length, address_cells,
                                size_cells, false,
                                candidate_interrupt_parent,
                                candidate_interrupts_offset,
                                candidate_interrupts_length
                            };
                            return FdtDeviceRegionResult::Found(region);
                        }
                        relative = relative + tuple_cells * 4;
                    }
                    return FdtDeviceRegionResult::Invalid;
                }
                candidate_depth = 0;
            }
            if (bus_depth == depth) { bus_depth = 0; }
            if (rp1_depth == depth) { rp1_depth = 0; }
            if (pcie_depth == depth) { pcie_depth = 0; }
            depth = depth - 1;
        } else if (token == FDT_PROP) {
            if (fdt_range_valid(struct_end, cursor, 8) == false) {
                return FdtDeviceRegionResult::Invalid;
            }
            let length: usize = fdt_read_be32(base, total, cursor);
            let name_relative: usize = fdt_read_be32(base, total, cursor + 4);
            cursor = cursor + 8;
            if (name_relative >= strings_size ||
                fdt_range_valid(struct_end, cursor, length) == false) {
                return FdtDeviceRegionResult::Invalid;
            }
            let prop_name: usize = strings_offset + name_relative;
            if (prop_name >= strings_end) {
                return FdtDeviceRegionResult::Invalid;
            }
            if (depth == 1 && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#address-cells")) {
                root_address_cells = fdt_read_be32(base, total, cursor);
            } else if (depth == 1 && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#size-cells")) {
                root_size_cells = fdt_read_be32(base, total, cursor);
            } else if (depth == 1 && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"interrupt-parent")) {
                root_interrupt_parent = fdt_read_be32(base, total, cursor);
            } else if (bus_depth == depth && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#address-cells")) {
                bus_address_cells = fdt_read_be32(base, total, cursor);
            } else if (bus_depth == depth && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#size-cells")) {
                bus_size_cells = fdt_read_be32(base, total, cursor);
            } else if (bus_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"ranges")) {
                bus_ranges_seen = true;
                bus_ranges_offset = cursor;
                bus_ranges_length = length;
            }
            if (candidate_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"compatible")) {
                candidate_compatible = fdt_string_list_contains(
                    base, total, cursor, length, compatible);
            } else if (candidate_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"status")) {
                candidate_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            } else if (candidate_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"reg")) {
                candidate_reg_seen = true;
                candidate_reg_offset = cursor;
                candidate_reg_length = length;
            } else if (candidate_depth == depth && length == 4 &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"interrupt-parent")) {
                candidate_interrupt_parent =
                    fdt_read_be32(base, total, cursor);
            } else if (candidate_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"interrupts")) {
                candidate_interrupts_offset = cursor;
                candidate_interrupts_length = length;
            }
            if (pcie_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"compatible")) {
                pcie_compatible = fdt_string_list_contains(
                    base, total, cursor, length, bs"brcm,bcm2712-pcie");
            } else if (pcie_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"status")) {
                pcie_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            } else if (pcie_depth == depth && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#address-cells")) {
                pcie_address_cells = fdt_read_be32(base, total, cursor);
            } else if (pcie_depth == depth && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#size-cells")) {
                pcie_size_cells = fdt_read_be32(base, total, cursor);
            } else if (pcie_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"ranges")) {
                pcie_ranges_seen = true;
                pcie_ranges_offset = cursor;
                pcie_ranges_length = length;
            }
            if (rp1_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"compatible")) {
                rp1_compatible = fdt_string_list_contains(
                    base, total, cursor, length, bs"simple-bus");
            } else if (rp1_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"status")) {
                rp1_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            } else if (rp1_depth == depth && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#address-cells")) {
                rp1_address_cells = fdt_read_be32(base, total, cursor);
            } else if (rp1_depth == depth && length == 4 && fdt_string_is(
                    base, strings_end, prop_name, bs"#size-cells")) {
                rp1_size_cells = fdt_read_be32(base, total, cursor);
            } else if (rp1_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"ranges")) {
                rp1_ranges_seen = true;
                rp1_ranges_offset = cursor;
                rp1_ranges_length = length;
            }
            if (nested_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"compatible")) {
                nested_compatible = fdt_string_list_contains(
                    base, total, cursor, length, compatible);
            } else if (nested_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"status")) {
                nested_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            } else if (nested_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"reg")) {
                nested_reg_seen = true;
                nested_reg_offset = cursor;
                nested_reg_length = length;
            }
            let next: usize = fdt_align4(cursor + length);
            if (next == 0 || next > struct_end) {
                return FdtDeviceRegionResult::Invalid;
            }
            cursor = next;
        } else if (token == FDT_NOP) {
        } else if (token == FDT_END) {
            if (depth != 0) { return FdtDeviceRegionResult::Invalid; }
            return FdtDeviceRegionResult::NotFound;
        } else {
            return FdtDeviceRegionResult::Invalid;
        }
    }
    return FdtDeviceRegionResult::Invalid;
}

fn fdt_find_compatible_reg(base: usize, compatible: []u8)
        -> FdtDeviceRegionResult !{unsafe} {
    return fdt_find_compatible_reg_bounded(base, compatible, false);
}

// Some RP1 devices have no RP1-specific compatible string. In particular,
// both BCM2712's on-die UART and RP1 UART0 contain "arm,pl011-axi". This
// entry point selects only the concrete PCIe/RP1 nesting above instead of
// letting structure order choose between two different devices.
fn fdt_find_compatible_pcie_reg(base: usize, compatible: []u8)
        -> FdtDeviceRegionResult !{unsafe} {
    return fdt_find_compatible_reg_bounded(base, compatible, true);
}

fn fdt_find_compatible_gicv2_regions(base: usize, compatible: []u8)
        -> FdtGicV2RegionsResult !{unsafe} {
    match fdt_find_compatible_reg(base, compatible) {
        FdtDeviceRegionResult::Invalid => {
            return FdtGicV2RegionsResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            return FdtGicV2RegionsResult::NotFound;
        }
        FdtDeviceRegionResult::Found(first) => {
            let total: usize = fdt_read_be32(
                first.dtb, FDT_HEADER_SIZE, 4);
            let mut distributor_base: usize = 0;
            let mut distributor_size: usize = 0;
            let mut cpu_base: usize = 0;
            let mut cpu_size: usize = 0;
            let mut tuple_length: usize = 0;
            if (first.direct_root_child && first.address_cells == 2 &&
                first.size_cells == 2 && first.reg_length == 32) {
                distributor_base = fdt_cells_value(
                    first.dtb, total, first.reg_offset, 2);
                distributor_size = fdt_cells_value(
                    first.dtb, total, first.reg_offset + 8, 2);
                cpu_base = fdt_cells_value(
                    first.dtb, total, first.reg_offset + 16, 2);
                cpu_size = fdt_cells_value(
                    first.dtb, total, first.reg_offset + 24, 2);
                tuple_length = 16;
            } else if (first.direct_root_child == false &&
                       first.address_cells == 1 && first.size_cells == 1 &&
                       first.reg_length == 32) {
                let distributor_child: usize = fdt_cells_value(
                    first.dtb, total, first.reg_offset, 1);
                let cpu_child: usize = fdt_cells_value(
                    first.dtb, total, first.reg_offset + 8, 1);
                distributor_size = fdt_cells_value(
                    first.dtb, total, first.reg_offset + 4, 1);
                cpu_size = fdt_cells_value(
                    first.dtb, total, first.reg_offset + 12, 1);
                if (first.base < distributor_child ||
                    cpu_child > 0xFFFFFFFFFFFFFFFF -
                        (first.base - distributor_child)) {
                    return FdtGicV2RegionsResult::Invalid;
                }
                distributor_base = first.base;
                cpu_base = cpu_child + (first.base - distributor_child);
                tuple_length = 8;
            } else {
                return FdtGicV2RegionsResult::Invalid;
            }
            if (distributor_size == 0 || cpu_size == 0 ||
                distributor_base >
                    0xFFFFFFFFFFFFFFFF - distributor_size ||
                cpu_base > 0xFFFFFFFFFFFFFFFF - cpu_size ||
                first.base != distributor_base ||
                first.size != distributor_size) {
                return FdtGicV2RegionsResult::Invalid;
            }
            let mut distributor: FdtDeviceRegion = {
                distributor_base, distributor_size,
                first.dtb, first.reg_offset, tuple_length,
                first.address_cells, first.size_cells,
                first.direct_root_child,
                0, 0, 0
            };
            let mut cpu_interface: FdtDeviceRegion = {
                cpu_base, cpu_size,
                first.dtb, first.reg_offset + tuple_length, tuple_length,
                first.address_cells, first.size_cells,
                first.direct_root_child,
                0, 0, 0
            };
            let mut regions: FdtGicV2Regions = {
                distributor, cpu_interface
            };
            return FdtGicV2RegionsResult::Found(regions);
        }
    }
}

private fn fdt_find_interrupt_controller(base: usize, wanted_phandle: usize)
        -> FdtInterruptControllerScanResult !{unsafe} {
    if (wanted_phandle == 0 || wanted_phandle == 0xFFFFFFFF ||
        fdt_read_be32(base, FDT_HEADER_SIZE, 0) != FDT_MAGIC) {
        return FdtInterruptControllerScanResult::Invalid;
    }
    let total: usize = fdt_read_be32(base, FDT_HEADER_SIZE, 4);
    if (total < FDT_HEADER_SIZE || total > FDT_MAX_SIZE) {
        return FdtInterruptControllerScanResult::Invalid;
    }
    let struct_offset: usize = fdt_read_be32(base, total, 8);
    let strings_offset: usize = fdt_read_be32(base, total, 12);
    let strings_size: usize = fdt_read_be32(base, total, 32);
    let struct_size: usize = fdt_read_be32(base, total, 36);
    if (fdt_range_valid(total, struct_offset, struct_size) == false ||
        fdt_range_valid(total, strings_offset, strings_size) == false) {
        return FdtInterruptControllerScanResult::Invalid;
    }
    let struct_end: usize = struct_offset + struct_size;
    let strings_end: usize = strings_offset + strings_size;
    let mut cursor: usize = struct_offset;
    let mut depth: usize = 0;
    let mut candidate_depth: usize = 0;
    let mut candidate_phandle: usize = 0;
    let mut candidate_controller: bool = false;
    let mut candidate_cells: usize = 0;
    let mut candidate_enabled: bool = true;
    while (cursor < struct_end) {
        if (fdt_range_valid(struct_end, cursor, 4) == false) {
            return FdtInterruptControllerScanResult::Invalid;
        }
        let token: usize = fdt_read_be32(base, total, cursor);
        cursor = cursor + 4;
        if (token == FDT_BEGIN_NODE) {
            // A node's properties precede all child nodes. Resolve a matching
            // controller before a child reuses the single bounded candidate
            // slot (QEMU's GICv2 node contains a v2m child).
            if (candidate_depth == depth &&
                candidate_phandle == wanted_phandle) {
                if (candidate_enabled == false) {
                    return FdtInterruptControllerScanResult::NotFound;
                }
                if (candidate_controller == false || candidate_cells == 0) {
                    return FdtInterruptControllerScanResult::Invalid;
                }
                let mut found: FdtInterruptControllerScan = {
                    candidate_cells
                };
                return FdtInterruptControllerScanResult::Found(found);
            }
            let mut name_end: usize = cursor;
            while (name_end < struct_end &&
                   fdt_read_u8(base, total, name_end) != 0) {
                name_end = name_end + 1;
            }
            if (name_end >= struct_end) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            depth = depth + 1;
            candidate_depth = depth;
            candidate_phandle = 0;
            candidate_controller = false;
            candidate_cells = 0;
            candidate_enabled = true;
            cursor = fdt_align4(name_end + 1);
            if (cursor == 0 || cursor > struct_end) {
                return FdtInterruptControllerScanResult::Invalid;
            }
        } else if (token == FDT_END_NODE) {
            if (depth == 0) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            if (candidate_depth == depth &&
                candidate_phandle == wanted_phandle) {
                if (candidate_enabled == false) {
                    return FdtInterruptControllerScanResult::NotFound;
                }
                if (candidate_controller == false || candidate_cells == 0) {
                    return FdtInterruptControllerScanResult::Invalid;
                }
                let mut found: FdtInterruptControllerScan = {
                    candidate_cells
                };
                return FdtInterruptControllerScanResult::Found(found);
            }
            candidate_depth = 0;
            depth = depth - 1;
        } else if (token == FDT_PROP) {
            if (fdt_range_valid(struct_end, cursor, 8) == false) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            let length: usize = fdt_read_be32(base, total, cursor);
            let name_relative: usize = fdt_read_be32(base, total, cursor + 4);
            cursor = cursor + 8;
            if (name_relative >= strings_size ||
                fdt_range_valid(struct_end, cursor, length) == false) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            let prop_name: usize = strings_offset + name_relative;
            if (prop_name >= strings_end) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            if (candidate_depth == depth && length == 4 &&
                (fdt_string_is(base, strings_end, prop_name, bs"phandle") ||
                 fdt_string_is(base, strings_end, prop_name,
                               bs"linux,phandle"))) {
                candidate_phandle = fdt_read_be32(base, total, cursor);
            } else if (candidate_depth == depth && length == 0 &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"interrupt-controller")) {
                candidate_controller = true;
            } else if (candidate_depth == depth && length == 4 &&
                       fdt_string_is(base, strings_end, prop_name,
                                     bs"#interrupt-cells")) {
                candidate_cells = fdt_read_be32(base, total, cursor);
            } else if (candidate_depth == depth && fdt_string_is(
                    base, strings_end, prop_name, bs"status")) {
                candidate_enabled = fdt_string_is(
                    base, cursor + length, cursor, bs"okay") ||
                    fdt_string_is(base, cursor + length, cursor, bs"ok");
            }
            let next: usize = fdt_align4(cursor + length);
            if (next == 0 || next > struct_end) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            cursor = next;
        } else if (token == FDT_NOP) {
        } else if (token == FDT_END) {
            if (depth != 0) {
                return FdtInterruptControllerScanResult::Invalid;
            }
            return FdtInterruptControllerScanResult::NotFound;
        } else {
            return FdtInterruptControllerScanResult::Invalid;
        }
    }
    return FdtInterruptControllerScanResult::Invalid;
}

fn fdt_find_compatible_gic_interrupt(base: usize, compatible: []u8)
        -> FdtGicInterruptResult !{unsafe} {
    match fdt_find_compatible_reg(base, compatible) {
        FdtDeviceRegionResult::Invalid => {
            return FdtGicInterruptResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            return FdtGicInterruptResult::NotFound;
        }
        FdtDeviceRegionResult::Found(device) => {
            if (device.interrupt_parent == 0 ||
                device.interrupts_length == 0) {
                return FdtGicInterruptResult::NotFound;
            }
            let controller_result: FdtInterruptControllerScanResult =
                fdt_find_interrupt_controller(base, device.interrupt_parent);
            match controller_result {
                FdtInterruptControllerScanResult::Invalid => {
                    return FdtGicInterruptResult::Invalid;
                }
                FdtInterruptControllerScanResult::NotFound => {
                    return FdtGicInterruptResult::NotFound;
                }
                FdtInterruptControllerScanResult::Found(controller) => {
                    // Current consumers use the standard GIC binding's
                    // three-cell <type number flags> form and exactly one
                    // interrupt. Type 0 is SPI, whose architectural INTID
                    // starts at 32.
                    if (controller.interrupt_cells != 3 ||
                        device.interrupts_length != 12) {
                        return FdtGicInterruptResult::Invalid;
                    }
                    let irq_type: usize = fdt_read_be32(
                        base, fdt_read_be32(base, FDT_HEADER_SIZE, 4),
                        device.interrupts_offset);
                    let number: usize = fdt_read_be32(
                        base, fdt_read_be32(base, FDT_HEADER_SIZE, 4),
                        device.interrupts_offset + 4);
                    let flags: usize = fdt_read_be32(
                        base, fdt_read_be32(base, FDT_HEADER_SIZE, 4),
                        device.interrupts_offset + 8);
                    if (irq_type != 0 || number > 987 ||
                        (flags != 1 && flags != 2 && flags != 4 &&
                         flags != 8)) {
                        return FdtGicInterruptResult::Invalid;
                    }
                    let mut found: FdtGicInterrupt = {
                        number + 32, flags
                    };
                    return FdtGicInterruptResult::Found(found);
                }
            }
        }
    }
}

fn fdt_detect_memory(base: usize) -> FdtMemoryResult !{unsafe} {
    let scanned: FdtScanResult = fdt_scan_memory(base, 0);
    match scanned {
        FdtScanResult::Invalid => { return FdtMemoryResult::Invalid; }
        FdtScanResult::NotFound => { return FdtMemoryResult::NotFound; }
        FdtScanResult::Found(scanned_memory) => {
            let total: usize = fdt_read_be32(base, FDT_HEADER_SIZE, 4);
            let reserved: FdtReservationScanResult =
                fdt_scan_reservations(base, total, 0);
            match reserved {
                FdtReservationScanResult::Invalid => {
                    return FdtMemoryResult::Invalid;
                }
                FdtReservationScanResult::Found(reservations) => {
                    let tree_result: FdtReservationScanResult =
                        fdt_scan_tree_reservations(base, 0);
                    match tree_result {
                        FdtReservationScanResult::Invalid => {
                            return FdtMemoryResult::Invalid;
                        }
                        FdtReservationScanResult::Found(tree) => {
                            let mut memory: FdtMemoryMap = {
                                base, scanned_memory.region_count,
                                reservations.count, tree.count
                            };
                            return FdtMemoryResult::Found(memory);
                        }
                    }
                }
            }
        }
    }
}

private fn fdt_memory_raw_region_at(map: FdtMemoryMap, index: usize)
        -> FdtMemoryRegionResult !{unsafe} {
    if (index >= map.raw_region_count) {
        return FdtMemoryRegionResult::OutOfRange;
    }
    let scanned: FdtScanResult = fdt_scan_memory(map.dtb, index);
    match scanned {
        FdtScanResult::Invalid => {
            return FdtMemoryRegionResult::Invalid;
        }
        FdtScanResult::NotFound => {
            return FdtMemoryRegionResult::Invalid;
        }
        FdtScanResult::Found(memory) => {
            if (memory.region_count != map.raw_region_count ||
                memory.wanted_found == false) {
                return FdtMemoryRegionResult::Invalid;
            }
            let mut region: PhysicalMemoryRegion = {
                memory.wanted_base, memory.wanted_size
            };
            return FdtMemoryRegionResult::Found(region);
        }
    }
}

private fn fdt_memory_header_reservation_at(map: FdtMemoryMap, index: usize)
        -> FdtMemoryRegionResult !{unsafe} {
    if (index >= map.reservation_count) {
        return FdtMemoryRegionResult::OutOfRange;
    }
    let total: usize = fdt_read_be32(map.dtb, FDT_HEADER_SIZE, 4);
    let scanned: FdtReservationScanResult =
        fdt_scan_reservations(map.dtb, total, index);
    match scanned {
        FdtReservationScanResult::Invalid => {
            return FdtMemoryRegionResult::Invalid;
        }
        FdtReservationScanResult::Found(reservations) => {
            if (reservations.count != map.reservation_count ||
                reservations.wanted_found == false) {
                return FdtMemoryRegionResult::Invalid;
            }
            let mut region: PhysicalMemoryRegion = {
                reservations.wanted_base, reservations.wanted_size
            };
            return FdtMemoryRegionResult::Found(region);
        }
    }
}

private fn fdt_memory_tree_reservation_at(map: FdtMemoryMap, index: usize)
        -> FdtMemoryRegionResult !{unsafe} {
    if (index >= map.tree_reservation_count) {
        return FdtMemoryRegionResult::OutOfRange;
    }
    let scanned: FdtReservationScanResult =
        fdt_scan_tree_reservations(map.dtb, index);
    match scanned {
        FdtReservationScanResult::Invalid => {
            return FdtMemoryRegionResult::Invalid;
        }
        FdtReservationScanResult::Found(reservations) => {
            if (reservations.count != map.tree_reservation_count ||
                reservations.wanted_found == false) {
                return FdtMemoryRegionResult::Invalid;
            }
            let mut region: PhysicalMemoryRegion = {
                reservations.wanted_base, reservations.wanted_size
            };
            return FdtMemoryRegionResult::Found(region);
        }
    }
}

private fn fdt_memory_any_reservation_at(map: FdtMemoryMap, index: usize)
        -> FdtMemoryRegionResult !{unsafe} {
    if (index < map.reservation_count) {
        return fdt_memory_header_reservation_at(map, index);
    }
    return fdt_memory_tree_reservation_at(
        map, index - map.reservation_count);
}

fn fdt_memory_region_at(map: FdtMemoryMap, wanted: usize)
        -> FdtMemoryRegionResult !{unsafe} {
    if (map.reservation_count >
        0xFFFFFFFFFFFFFFFF - map.tree_reservation_count) {
        return FdtMemoryRegionResult::Invalid;
    }
    let reservation_count: usize =
        map.reservation_count + map.tree_reservation_count;
    if (map.raw_region_count >
        0x7FFFFFFFFFFFFFFF - reservation_count) {
        return FdtMemoryRegionResult::Invalid;
    }
    let boundary_limit: usize =
        (map.raw_region_count + reservation_count) * 2;

    // Start at the lowest RAM base. Reservations below all RAM cannot make
    // usable memory, so they do not need to seed the sweep.
    let mut cursor: usize = 0;
    let mut cursor_found: bool = false;
    let mut raw_index: usize = 0;
    while (raw_index < map.raw_region_count) {
        let raw_result: FdtMemoryRegionResult =
            fdt_memory_raw_region_at(map, raw_index);
        match raw_result {
            FdtMemoryRegionResult::Invalid => {
                return FdtMemoryRegionResult::Invalid;
            }
            FdtMemoryRegionResult::OutOfRange => {
                return FdtMemoryRegionResult::Invalid;
            }
            FdtMemoryRegionResult::Found(raw) => {
                if (cursor_found == false || raw.base < cursor) {
                    cursor = raw.base;
                    cursor_found = true;
                }
            }
        }
        raw_index = raw_index + 1;
    }
    if (cursor_found == false) { return FdtMemoryRegionResult::Invalid; }

    let mut boundary_steps: usize = 0;
    let mut usable_index: usize = 0;
    let mut region_open: bool = false;
    let mut region_base: usize = 0;
    while (boundary_steps <= boundary_limit) {
        let mut next: usize = 0;
        let mut next_found: bool = false;
        let mut in_memory: bool = false;
        raw_index = 0;
        while (raw_index < map.raw_region_count) {
            let raw_result: FdtMemoryRegionResult =
                fdt_memory_raw_region_at(map, raw_index);
            match raw_result {
                FdtMemoryRegionResult::Invalid => {
                    return FdtMemoryRegionResult::Invalid;
                }
                FdtMemoryRegionResult::OutOfRange => {
                    return FdtMemoryRegionResult::Invalid;
                }
                FdtMemoryRegionResult::Found(raw) => {
                    let raw_end: usize = raw.base + raw.size;
                    if (raw.base <= cursor && cursor < raw_end) {
                        in_memory = true;
                    }
                    if (raw.base > cursor &&
                        (next_found == false || raw.base < next)) {
                        next = raw.base;
                        next_found = true;
                    }
                    if (raw_end > cursor &&
                        (next_found == false || raw_end < next)) {
                        next = raw_end;
                        next_found = true;
                    }
                }
            }
            raw_index = raw_index + 1;
        }

        let mut in_reservation: bool = false;
        let mut reservation_index: usize = 0;
        while (reservation_index < reservation_count) {
            let reserved_result: FdtMemoryRegionResult =
                fdt_memory_any_reservation_at(map, reservation_index);
            match reserved_result {
                FdtMemoryRegionResult::Invalid => {
                    return FdtMemoryRegionResult::Invalid;
                }
                FdtMemoryRegionResult::OutOfRange => {
                    return FdtMemoryRegionResult::Invalid;
                }
                FdtMemoryRegionResult::Found(reserved) => {
                    let reserved_end: usize = reserved.base + reserved.size;
                    if (reserved.base <= cursor && cursor < reserved_end) {
                        in_reservation = true;
                    }
                    if (reserved.base > cursor &&
                        (next_found == false || reserved.base < next)) {
                        next = reserved.base;
                        next_found = true;
                    }
                    if (reserved_end > cursor &&
                        (next_found == false || reserved_end < next)) {
                        next = reserved_end;
                        next_found = true;
                    }
                }
            }
            reservation_index = reservation_index + 1;
        }

        let usable: bool = in_memory && in_reservation == false;
        if (usable && region_open == false) {
            region_base = cursor;
            region_open = true;
        } else if (usable == false && region_open) {
            if (usable_index == wanted) {
                let mut region: PhysicalMemoryRegion = {
                    region_base, cursor - region_base
                };
                return FdtMemoryRegionResult::Found(region);
            }
            usable_index = usable_index + 1;
            region_open = false;
        }

        if (next_found == false) {
            if (region_open) {
                if (usable_index == wanted) {
                    let mut region: PhysicalMemoryRegion = {
                        region_base, cursor - region_base
                    };
                    return FdtMemoryRegionResult::Found(region);
                }
                usable_index = usable_index + 1;
            }
            return FdtMemoryRegionResult::OutOfRange;
        }
        cursor = next;
        boundary_steps = boundary_steps + 1;
    }
    return FdtMemoryRegionResult::Invalid;
}

fn fdt_memory_region_count(map: FdtMemoryMap) -> usize !{unsafe} {
    let mut count: usize = 0;
    while (count != 0xFFFFFFFFFFFFFFFF) {
        let result: FdtMemoryRegionResult = fdt_memory_region_at(map, count);
        match result {
            FdtMemoryRegionResult::Invalid => { return 0; }
            FdtMemoryRegionResult::OutOfRange => { return count; }
            FdtMemoryRegionResult::Found(region) => {
                if (region.size == 0) { return 0; }
                count = count + 1;
            }
        }
    }
    return 0;
}

fn fdt_memory_reservation_count(map: FdtMemoryMap) -> usize {
    if (map.reservation_count >
        0xFFFFFFFFFFFFFFFF - map.tree_reservation_count) { return 0; }
    return map.reservation_count + map.tree_reservation_count;
}

fn fdt_blob_base(map: FdtMemoryMap) -> usize {
    return map.dtb;
}

fn fdt_blob_size(map: FdtMemoryMap) -> usize !{unsafe} {
    return fdt_read_be32(map.dtb, FDT_HEADER_SIZE, 4);
}

fn fdt_blob_overlaps(map: FdtMemoryMap, base: usize, size: usize)
        -> bool !{unsafe} {
    let blob_size: usize = fdt_blob_size(map);
    if (size == 0 || blob_size == 0 ||
        base > 0xFFFFFFFFFFFFFFFF - size ||
        map.dtb > 0xFFFFFFFFFFFFFFFF - blob_size) {
        return false;
    }
    return base < map.dtb + blob_size && map.dtb < base + size;
}

fn fdt_memory_first_base(map: FdtMemoryMap) -> usize !{unsafe} {
    let result: FdtMemoryRegionResult = fdt_memory_region_at(map, 0);
    match result {
        FdtMemoryRegionResult::Invalid => { return 0; }
        FdtMemoryRegionResult::OutOfRange => { return 0; }
        FdtMemoryRegionResult::Found(region) => { return region.base; }
    }
}

fn fdt_memory_total_size(map: FdtMemoryMap) -> usize !{unsafe} {
    let mut index: usize = 0;
    let mut total: usize = 0;
    while (index != 0xFFFFFFFFFFFFFFFF) {
        let result: FdtMemoryRegionResult = fdt_memory_region_at(map, index);
        match result {
            FdtMemoryRegionResult::Invalid => { return 0; }
            FdtMemoryRegionResult::OutOfRange => { return total; }
            FdtMemoryRegionResult::Found(region) => {
                if (total > 0xFFFFFFFFFFFFFFFF - region.size) { return 0; }
                total = total + region.size;
                index = index + 1;
            }
        }
    }
    return 0;
}

fn fdt_memory_map_verify(map: FdtMemoryMap) -> bool !{unsafe} {
    if (map.raw_region_count == 0) { return false; }
    let count: usize = fdt_memory_region_count(map);
    return count != 0 && fdt_memory_total_size(map) != 0;
}
