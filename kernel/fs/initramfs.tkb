// GitHub issue #230: the initramfs blob is now a real compile-time file
// embed instead of kernel/user/initramfs.S's `.incbin` plus an `extern
// symbol start`/`end` pair. KERNEL_INITRAMFS_LEN is the current real size
// of kernel/build/user/initramfs.cpio (busybox-static + busybox-httpd +
// the musl loader, packed as a cpio "newc" archive) -- embed_file's own
// compile-time check (lib/type_inf.ml) rejects the build outright if this
// ever drifts from the file's real size instead of silently using a stale
// value the way the old runtime `end - start` subtraction never could
// detect either way. Update this constant (a real compile error will say
// the correct value) if the pinned busybox/httpd/musl-loader downloads
// this archive is built from ever change size.
const KERNEL_INITRAMFS_LEN: usize = 1973248;
let kernel_initramfs: [u8; KERNEL_INITRAMFS_LEN] =
    embed_file("kernel/build/user/initramfs.cpio");

// Single source of truth for the cpio "newc" ASCII-hex header layout:
// sizeof(...)/offsetof(...) are verified against CpioNewcHeader's
// actual (packed) layout instead of being hand-maintained literals.
// Every field is 8 ASCII hex digits (parsed via cpio_hex8 below) except
// the 6-byte magic; fields the kernel never reads (ino/mode/uid/gid/
// nlink/mtime/devmajor/devminor/rdevmajor/rdevminor/check) are still
// declared, both to make the on-disk layout self-documenting and
// because packed-struct offsets are only provably correct when every
// preceding field is accounted for.
struct packed CpioNewcHeader {
    magic:      [u8; 6];
    ino:        [u8; 8];
    mode:       [u8; 8];
    uid:        [u8; 8];
    gid:        [u8; 8];
    nlink:      [u8; 8];
    mtime:      [u8; 8];
    filesize:   [u8; 8];
    devmajor:   [u8; 8];
    devminor:   [u8; 8];
    rdevmajor:  [u8; 8];
    rdevminor:  [u8; 8];
    namesize:   [u8; 8];
    check:      [u8; 8];
}

let CPIO_NEWC_HEADER_SIZE: usize = sizeof(CpioNewcHeader);
let CPIO_FILESIZE_OFFSET:  usize = offsetof(CpioNewcHeader, filesize);
let CPIO_NAMESIZE_OFFSET:  usize = offsetof(CpioNewcHeader, namesize);

must_use variant CpioNumberResult { Invalid; Value(usize); }

// File((usize, []u8)) keeps the raw base address alongside the slice:
// downstream (kernel/mm/process_image.tkb) still needs a plain address
// to actually copy bytes into a fresh process image, and the compiler
// will not let an address derived FROM a `borrow []u8` parameter escape
// into a returned/stored struct (an address is authority-derived once
// it comes from a borrow -- "keep the derived value in a directly
// tracked local binding" -- so distro_elf_validate cannot manufacture
// one from its own `image` parameter). Handing over the ORIGINAL,
// never-borrowed address here, before it ever becomes a `borrow`
// parameter anywhere, sidesteps that without weakening it: the address
// was never the actual safety question (see the length one below).
must_use variant InitramfsFileResult {
    Invalid;
    File((usize, []u8));
}

must_use variant InitramfsEntryResult {
    Invalid;
    Entry((usize, usize, usize, usize));
}

// The one place a cpio entry's (address, length) -- both derived from
// ASCII-hex fields inside the initramfs blob, not from any type-checked
// allocation -- gets turned into a slice that the rest of the kernel
// (distro_elf_validate and onward) can trust and index without further
// manual bounds arithmetic. Every InitramfsFileResult::File is built
// through this one function, so this is the whole review surface for
// "is the initramfs file length assumption correct" -- not repeated at
// each of initramfs_busybox/httpd/musl_loader's three call sites.
fn initramfs_file_bytes(address: usize, length: usize) -> []u8 !{unsafe} {
    let p: *u8 = address as *u8;
    return unsafe { p[0..<length as isize] };
}

fn cpio_hex_digit(value: u8) -> usize {
    if (value >= 0x30 && value <= 0x39) { return (value - 0x30) as usize; }
    if (value >= 0x41 && value <= 0x46) { return (value - 0x41 + 10) as usize; }
    return 16;
}

fn cpio_hex8(base: *u8, offset: usize) -> CpioNumberResult {
    let mut result: usize = 0;
    for i: usize in 0..<8 {
        let digit: usize = cpio_hex_digit(base[(offset + i) as isize]);
        if (digit >= 16) { return CpioNumberResult::Invalid; }
        result = (result << 4) | digit;
    }
    return CpioNumberResult::Value(result);
}

fn initramfs_entry(target: usize) -> InitramfsEntryResult {
    let address: usize = (kernel_initramfs as *u8) as usize;
    let length: usize = KERNEL_INITRAMFS_LEN;
    let mut offset: usize = 0;
    let mut ordinal: usize = 0;
    let bytes: *u8 = address as *u8;
    while (offset <= length && CPIO_NEWC_HEADER_SIZE <= length - offset) {
        let header: *u8 = (address + offset) as *u8;
        if (header[0] != 0x30 || header[1] != 0x37 || header[2] != 0x30 ||
            header[3] != 0x37 || header[4] != 0x30 || header[5] != 0x31) {
            return InitramfsEntryResult::Invalid;
        }
        let mut file_size: usize = 0;
        match cpio_hex8(header, CPIO_FILESIZE_OFFSET) {
            CpioNumberResult::Invalid => {
                return InitramfsEntryResult::Invalid;
            }
            CpioNumberResult::Value(value) => { file_size = value; }
        }
        let mut name_size: usize = 0;
        match cpio_hex8(header, CPIO_NAMESIZE_OFFSET) {
            CpioNumberResult::Invalid => {
                return InitramfsEntryResult::Invalid;
            }
            CpioNumberResult::Value(value) => { name_size = value; }
        }
        if (name_size == 0 || name_size > length - offset - CPIO_NEWC_HEADER_SIZE) {
            return InitramfsEntryResult::Invalid;
        }
        let name_offset: usize = offset + CPIO_NEWC_HEADER_SIZE;
        if (name_offset > 0xFFFFFFFFFFFFFFFC - name_size) {
            return InitramfsEntryResult::Invalid;
        }
        let data_offset: usize = (name_offset + name_size + 3) &
                                 0xFFFFFFFFFFFFFFFC;
        if (data_offset > length || file_size > length - data_offset) {
            return InitramfsEntryResult::Invalid;
        }
        if (ordinal == target) {
            return InitramfsEntryResult::Entry(
                (address + name_offset, name_size,
                 address + data_offset, file_size));
        }
        if (data_offset > 0xFFFFFFFFFFFFFFFC - file_size) {
            return InitramfsEntryResult::Invalid;
        }
        offset = (data_offset + file_size + 3) & 0xFFFFFFFFFFFFFFFC;
        ordinal = ordinal + 1;
    }
    return InitramfsEntryResult::Invalid;
}

fn initramfs_busybox() -> InitramfsFileResult {
    match initramfs_entry(0) {
        InitramfsEntryResult::Invalid => {
            return InitramfsFileResult::Invalid;
        }
        InitramfsEntryResult::Entry(entry) => {
            let (name_address, name_size, file_address, file_size) = entry;
            let name: *u8 = name_address as *u8;
            if (name_size == 15 &&
                name[0] == 0x62 && name[1] == 0x75 && name[2] == 0x73 &&
                name[3] == 0x79 && name[4] == 0x62 && name[5] == 0x6F &&
                name[6] == 0x78 && name[7] == 0x2D && name[8] == 0x73 &&
                name[9] == 0x74 && name[10] == 0x61 && name[11] == 0x74 &&
                name[12] == 0x69 && name[13] == 0x63 && name[14] == 0) {
                return InitramfsFileResult::File(
                    (file_address, initramfs_file_bytes(file_address, file_size)));
            }
            return InitramfsFileResult::Invalid;
        }
    }
}

fn initramfs_httpd() -> InitramfsFileResult {
    match initramfs_entry(1) {
        InitramfsEntryResult::Invalid => { return InitramfsFileResult::Invalid; }
        InitramfsEntryResult::Entry(entry) => {
            let (name_address, name_size, file_address, file_size) = entry;
            let name: *u8 = name_address as *u8;
            if (name_size == 14 && name[0] == 0x62 && name[1] == 0x75 &&
                name[2] == 0x73 && name[3] == 0x79 && name[4] == 0x62 &&
                name[5] == 0x6F && name[6] == 0x78 && name[7] == 0x2D &&
                name[8] == 0x68 && name[9] == 0x74 && name[10] == 0x74 &&
                name[11] == 0x70 && name[12] == 0x64 && name[13] == 0) {
                return InitramfsFileResult::File(
                    (file_address, initramfs_file_bytes(file_address, file_size)));
            }
            return InitramfsFileResult::Invalid;
        }
    }
}

fn initramfs_musl_loader() -> InitramfsFileResult {
    match initramfs_entry(2) {
        InitramfsEntryResult::Invalid => { return InitramfsFileResult::Invalid; }
        InitramfsEntryResult::Entry(entry) => {
            let (name_address, name_size, file_address, file_size) = entry;
            let name: *u8 = name_address as *u8;
            if (name_size == 21 && name[0] == 0x6C && name[1] == 0x64 &&
                name[2] == 0x2D && name[3] == 0x6D && name[4] == 0x75 &&
                name[5] == 0x73 && name[6] == 0x6C && name[7] == 0x2D &&
                name[8] == 0x61 && name[9] == 0x61 && name[10] == 0x72 &&
                name[11] == 0x63 && name[12] == 0x68 && name[13] == 0x36 &&
                name[14] == 0x34 && name[15] == 0x2E && name[16] == 0x73 &&
                name[17] == 0x6F && name[18] == 0x2E && name[19] == 0x31 &&
                name[20] == 0) {
                return InitramfsFileResult::File(
                    (file_address, initramfs_file_bytes(file_address, file_size)));
            }
            return InitramfsFileResult::Invalid;
        }
    }
}
