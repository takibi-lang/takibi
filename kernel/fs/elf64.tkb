const ELF_ET_DYN: u16 = 3;
const ELF_EM_AARCH64: u16 = 183;
const ELF_PT_LOAD: u32 = 1;

struct packed KernelElf64Header {
    ident: [u8; 16];
    object_type: u16;
    machine: u16;
    version: u32;
    entry: u64;
    program_offset: u64;
    section_offset: u64;
    flags: u32;
    header_size: u16;
    program_entry_size: u16;
    program_count: u16;
    section_entry_size: u16;
    section_count: u16;
    section_names: u16;
}

struct packed KernelElf64ProgramHeader {
    segment_type: u32;
    flags: u32;
    offset: u64;
    virtual_address: u64;
    physical_address: u64;
    file_size: u64;
    memory_size: u64;
    alignment: u64;
}

// sizeof(...) instead of hand-maintained literals (64/56) that used to
// duplicate the two packed structs' own actual sizes.
let ELF_HEADER_SIZE: usize = sizeof(KernelElf64Header);
let ELF_PROGRAM_HEADER_SIZE: usize = sizeof(KernelElf64ProgramHeader);

struct DistroElfLoadPlan {
    image_address: usize;
    image_length: usize;
    program_offset: usize;
    program_count: usize;
    entry: usize;
    extent: usize;
    load_segments: usize;
}

must_use variant DistroElfResult { Invalid; Valid(DistroElfLoadPlan); }

// EI_MAG0..EI_MAG3 ("\x7FELF"), EI_CLASS(2=ELFCLASS64), EI_DATA(1=little
// endian), EI_VERSION(1=EV_CURRENT).
let mut ELF_IDENT_MAGIC: [u8; 7] = {0x7F, 0x45, 0x4C, 0x46, 2, 1, 1};

// image's length is the one fact this whole function -- and every
// length/offset arithmetic check inside it -- ultimately trusts. Taking
// a slice (rather than the previous `address: usize, length: usize`)
// means that trust is established once, at whatever site the caller
// turned a raw parsed byte count into `image` (an unsafe slice
// construction there, same as kernel/fs/ext2/ext2.tkb's own pattern)
// -- not re-asserted implicitly by this function's own body. Reading
// `image.len` back out here is ordinary, checked slice access.
//
// `address` stays a separate plain parameter (not derived from
// `image`) because the compiler will not let a pointer/address derived
// FROM a `borrow` parameter escape into a returned struct
// (DistroElfLoadPlan.image_address, still consumed as a raw address by
// kernel/mm/process_image.tkb) -- "authority-derived value ... cannot
// be stored in a struct value". That's not a loophole being dodged:
// the address was never the thing this change was making safe. The caller
// pairs it with the same checked metadata window supplied as `image`.
fn distro_elf_validate_with_length(address: usize, image: borrow []u8,
                                   logical_length: usize) -> DistroElfResult !{unsafe} {
    // `image.len >= 7` is redundant with `>= ELF_HEADER_SIZE` (always
    // 64) at runtime, but ELF_HEADER_SIZE is a `let` (sizeof-derived,
    // not a const literal), so the type checker cannot fold it into a
    // provable bound for the image[0..<7] ident slice below; the
    // literal conjunct is what actually narrows. The same gap means the
    // slice-to-struct-pointer cast just below cannot see this branch's
    // own `>= ELF_HEADER_SIZE` check either (GitHub issue #218 follow-up:
    // that cast now requires a compile-time-provable minimum length,
    // and a `let`-bound size is not one) -- `unsafe` marks that the
    // runtime check on this exact line is what actually vouches for it.
    if (image.len >= ELF_HEADER_SIZE && image.len >= 7) {
        // `image` contains the ELF header and program table. A streaming
        // source may keep the rest of the file on ext2, so its logical file
        // length can be larger than this metadata window.
        let length: usize = logical_length;
        let header: *KernelElf64Header = unsafe { image as *KernelElf64Header };
        if (slice_eq(image[0..<7], ELF_IDENT_MAGIC as []u8) == false) {
            return DistroElfResult::Invalid;
        }
        if (header.object_type != ELF_ET_DYN || header.machine != ELF_EM_AARCH64 ||
            header.version != 1 || header.header_size as usize != ELF_HEADER_SIZE ||
            header.program_entry_size as usize != ELF_PROGRAM_HEADER_SIZE) {
            return DistroElfResult::Invalid;
        }

        let program_offset: usize = header.program_offset as usize;
        let program_count: usize = header.program_count as usize;
        if (program_count == 0 || program_count > 16 || program_offset > length) {
            return DistroElfResult::Invalid;
        }
        let table_size: usize = program_count * ELF_PROGRAM_HEADER_SIZE;
        if (table_size > length - program_offset) { return DistroElfResult::Invalid; }

        let mut maximum: usize = 0;
        let mut load_count: usize = 0;
        for i: usize in 0..<program_count {
            let item_address: usize = address + program_offset + i * ELF_PROGRAM_HEADER_SIZE;
            let item: *KernelElf64ProgramHeader =
                unsafe { item_address as *KernelElf64ProgramHeader };
            if (item.segment_type == ELF_PT_LOAD) {
                let offset: usize = item.offset as usize;
                let file_size: usize = item.file_size as usize;
                let virtual_address: usize = item.virtual_address as usize;
                let memory_size: usize = item.memory_size as usize;
                if (file_size > memory_size || offset > length ||
                    file_size > length - offset ||
                    memory_size > 0xFFFFFFFFFFFFFFFF - virtual_address) {
                    return DistroElfResult::Invalid;
                }
                let end_address: usize = virtual_address + memory_size;
                if (end_address > maximum) { maximum = end_address; }
                load_count = load_count + 1;
            }
        }
        let entry: usize = header.entry as usize;
        if (load_count == 0 || entry >= maximum || maximum > 0x1FFFFF) {
            return DistroElfResult::Invalid;
        }
        let mut plan: DistroElfLoadPlan = {
            address, length, program_offset, program_count,
            entry, maximum, load_count
        };
        return DistroElfResult::Valid(plan);
    }
    return DistroElfResult::Invalid;
}

fn distro_elf_validate(address: usize, image: borrow []u8) -> DistroElfResult {
    return distro_elf_validate_with_length(address, image, image.len);
}
