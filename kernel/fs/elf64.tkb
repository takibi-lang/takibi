const ELF_ET_DYN: u16 = 3;
const ELF_EM_AARCH64: u16 = 183;
const ELF_PT_LOAD: u32 = 1;
const ELF_PT_INTERP: u32 = 3;

struct packed KernelElf64Header {
    ident: [u8; 16];
    object_type: u16;
    machine: u16;
    version: u32;
    entry: u64;
    program_offset: u64;
    section_offset: u64;
    flags: u32;
    header_size: u16;
    program_entry_size: u16;
    program_count: u16;
    section_entry_size: u16;
    section_count: u16;
    section_names: u16;
}

struct packed KernelElf64ProgramHeader {
    segment_type: u32;
    flags: u32;
    offset: u64;
    virtual_address: u64;
    physical_address: u64;
    file_size: u64;
    memory_size: u64;
    alignment: u64;
}

// Packed ELF headers are read only here, through checked header overlays
// (#637) over a span the caller proves complete. Return independent
// values, never the overlay references.
fn kernel_elf_header_copy(bytes: borrow [u8; sizeof(KernelElf64Header)..])
        -> KernelElf64Header {
    let header: &KernelElf64Header = bytes as &KernelElf64Header;
    return *header;
}

fn kernel_elf_program_header_copy(
        bytes: borrow [u8; sizeof(KernelElf64ProgramHeader)..])
        -> KernelElf64ProgramHeader {
    let header: &KernelElf64ProgramHeader = bytes as &KernelElf64ProgramHeader;
    return *header;
}

// sizeof(...) instead of hand-maintained literals (64/56) that used to
// duplicate the two packed structs' own actual sizes.
let ELF_HEADER_SIZE: usize = sizeof(KernelElf64Header);
let ELF_PROGRAM_HEADER_SIZE: usize = sizeof(KernelElf64ProgramHeader);

struct DistroElfLoadPlan {
    image: []u8;
    image_length: usize;
    program_offset: usize;
    program_count: usize;
    entry: usize;
    extent: usize;
    load_segments: usize;
    // GitHub issue #591: the PT_INTERP string's file offset and length,
    // including its NUL. Zero length means a static image.
    interpreter_offset: usize;
    interpreter_length: usize;
}

must_use variant DistroElfResult { Invalid; Valid(DistroElfLoadPlan); }

// EI_MAG0..EI_MAG3 ("\x7FELF"), EI_CLASS(2=ELFCLASS64), EI_DATA(1=little
// endian), EI_VERSION(1=EV_CURRENT).
let mut ELF_IDENT_MAGIC: [u8; 7] = {0x7F, 0x45, 0x4C, 0x46, 2, 1, 1};

// A PT_LOAD's page span as process_image_map_segments maps it: from the
// page holding p_vaddr to the page after p_vaddr + p_memsz.
private fn distro_elf_load_page_span(item: KernelElf64ProgramHeader)
        -> (usize, usize) {
    let first: usize = (item.virtual_address as usize) / 4096;
    let last: usize =
        ((item.virtual_address as usize) + (item.memory_size as usize) +
         4095) / 4096;
    return (first, last);
}

// GitHub issue #1058: no two PT_LOAD segments may share a page. The mapper
// refuses a page that is already mapped, and it does so after execve's point
// of no return, where a refusal can only stop the kernel; an image whose
// segments overlap is refused here instead, while execve can still answer
// ENOEXEC. Called once every header has passed the checks above, so each
// span ends below the 2 MiB extent and the sums cannot wrap.
private fn distro_elf_load_pages_disjoint(image: []u8, program_offset: usize,
                                          program_count: usize) -> bool {
    for i: usize in 0..<program_count {
        let i_offset: usize = program_offset + i * ELF_PROGRAM_HEADER_SIZE;
        if (i_offset > image.len) { return false; }
        let i_tail = image[i_offset..<image.len];
        if (i_tail.len < sizeof(KernelElf64ProgramHeader)) { return false; }
        let mut i_item: KernelElf64ProgramHeader = kernel_elf_program_header_copy(
            i_tail[0..<sizeof(KernelElf64ProgramHeader)]);
        if (i_item.segment_type == ELF_PT_LOAD) {
            let (i_first, i_last) = distro_elf_load_page_span(i_item);
            for j: usize in 0..<i {
                let j_offset: usize =
                    program_offset + j * ELF_PROGRAM_HEADER_SIZE;
                if (j_offset > image.len) { return false; }
                let j_tail = image[j_offset..<image.len];
                if (j_tail.len < sizeof(KernelElf64ProgramHeader)) {
                    return false;
                }
                let mut j_item: KernelElf64ProgramHeader =
                    kernel_elf_program_header_copy(
                        j_tail[0..<sizeof(KernelElf64ProgramHeader)]);
                if (j_item.segment_type == ELF_PT_LOAD) {
                    let (j_first, j_last) = distro_elf_load_page_span(j_item);
                    if (i_first < j_last && j_first < i_last) {
                        return false;
                    }
                }
            }
        }
    }
    return true;
}

// The slice parameter is intentionally retaining rather than `borrow`:
// a successful plan carries this exact checked metadata view to the mapper.
// Stack- or owner-derived slices therefore cannot enter this API, while the
// kernel's persistent global metadata windows can safely outlive the plan.
fn distro_elf_validate_with_length(image: []u8,
                                   logical_length: usize) -> DistroElfResult {
    let header_end: usize = sizeof(KernelElf64Header);
    if (header_end <= image.len) {
        // `image` contains the ELF header and program table. A streaming
        // source may keep the rest of the file on ext2, so its logical file
        // length can be larger than this metadata window.
        let length: usize = logical_length;
        let header_bytes = image[0..<header_end];
        let mut header: KernelElf64Header = kernel_elf_header_copy(header_bytes);
        if (slice_eq(header_bytes[0..<7], ELF_IDENT_MAGIC as []u8) == false) {
            return DistroElfResult::Invalid;
        }
        if (header.object_type != ELF_ET_DYN || header.machine != ELF_EM_AARCH64 ||
            header.version != 1 || header.header_size as usize != ELF_HEADER_SIZE ||
            header.program_entry_size as usize != ELF_PROGRAM_HEADER_SIZE) {
            return DistroElfResult::Invalid;
        }

        let program_offset: usize = header.program_offset as usize;
        let program_count: usize = header.program_count as usize;
        if (program_count == 0 || program_count > 16 || program_offset > length) {
            return DistroElfResult::Invalid;
        }
        let table_size: usize = program_count * ELF_PROGRAM_HEADER_SIZE;
        if (table_size > length - program_offset) { return DistroElfResult::Invalid; }
        if (program_offset > image.len) { return DistroElfResult::Invalid; }

        let mut maximum: usize = 0;
        let mut load_count: usize = 0;
        let mut interpreter_offset: usize = 0;
        let mut interpreter_length: usize = 0;
        for i: usize in 0..<program_count {
            let item_offset: usize = program_offset + i * ELF_PROGRAM_HEADER_SIZE;
            if (item_offset > image.len) { return DistroElfResult::Invalid; }
            let item_tail = image[item_offset..<image.len];
            if (item_tail.len < sizeof(KernelElf64ProgramHeader)) {
                return DistroElfResult::Invalid;
            }
            let item_bytes = item_tail[0..<sizeof(KernelElf64ProgramHeader)];
            let mut item: KernelElf64ProgramHeader =
                kernel_elf_program_header_copy(item_bytes);
            if (item.segment_type == ELF_PT_LOAD) {
                // GitHub issue #1058: the mapper accepts only these three
                // permission sets (PF_R, PF_R|PF_X, PF_R|PF_W) and fails
                // after the old image is gone, so they are refused here,
                // before execve's point of no return.
                if (item.flags != 4 && item.flags != 5 && item.flags != 6) {
                    return DistroElfResult::Invalid;
                }
                let offset: usize = item.offset as usize;
                let file_size: usize = item.file_size as usize;
                let virtual_address: usize = item.virtual_address as usize;
                let memory_size: usize = item.memory_size as usize;
                let alignment: usize = item.alignment as usize;
                if (file_size > memory_size || offset > length ||
                    file_size > length - offset ||
                    memory_size > 0xFFFFFFFFFFFFFFFF - virtual_address) {
                    return DistroElfResult::Invalid;
                }
                // ELF permits 0/1 (no requirement); otherwise the file and
                // virtual offsets must agree modulo a power-of-two alignment.
                if (alignment > 1) {
                    let mask: usize = alignment - 1;
                    if ((alignment & mask) != 0 ||
                        (virtual_address & mask) != (offset & mask)) {
                        return DistroElfResult::Invalid;
                    }
                }
                let end_address: usize = virtual_address + memory_size;
                if (end_address > maximum) { maximum = end_address; }
                load_count = load_count + 1;
            }
            if (item.segment_type == ELF_PT_INTERP) {
                let offset: usize = item.offset as usize;
                let file_size: usize = item.file_size as usize;
                if (interpreter_length != 0 || file_size == 0 ||
                    offset > length || file_size > length - offset) {
                    return DistroElfResult::Invalid;
                }
                interpreter_offset = offset;
                interpreter_length = file_size;
            }
        }
        let entry: usize = header.entry as usize;
        if (load_count == 0 || entry >= maximum || maximum > 0x1FFFFF) {
            return DistroElfResult::Invalid;
        }
        if (distro_elf_load_pages_disjoint(image, program_offset,
                program_count) == false) {
            return DistroElfResult::Invalid;
        }
        let mut plan: DistroElfLoadPlan = {
            image, length, program_offset, program_count,
            entry, maximum, load_count,
            interpreter_offset, interpreter_length
        };
        return DistroElfResult::Valid(plan);
    }
    return DistroElfResult::Invalid;
}
