const ELF_ET_DYN: u16 = 3;
const ELF_EM_AARCH64: u16 = 183;
const ELF_PT_LOAD: u32 = 1;
const ELF_PT_INTERP: u32 = 3;
// GitHub issue #1041: the largest PT_LOAD span execve maps, 256 MiB, a
// quarter of the 1 GiB user space, so a dynamic pair of two such images, the
// heap end below the mmap region (process_layout_assumption). It was
// 2 MiB, one L3 table, a leftover of the address space before #254; static
// stress-ng spans 8 MiB. Every PT_LOAD page is still allocated at exec, so
// a span near this bound is refused by the page allocator (ENOMEM) first.
const DISTRO_ELF_SPAN_MAX: usize = 0x10000000;

struct packed KernelElf64Header {
    ident: [u8; 16];
    object_type: u16;
    machine: u16;
    version: u32;
    entry: u64;
    program_offset: u64;
    section_offset: u64;
    flags: u32;
    header_size: u16;
    program_entry_size: u16;
    program_count: u16;
    section_entry_size: u16;
    section_count: u16;
    section_names: u16;
}

struct packed KernelElf64ProgramHeader {
    segment_type: u32;
    flags: u32;
    offset: u64;
    virtual_address: u64;
    physical_address: u64;
    file_size: u64;
    memory_size: u64;
    alignment: u64;
}

// Packed ELF headers are read only here, through checked header overlays
// (#637) over a span the caller proves complete. Return independent
// values, never the overlay references.
fn kernel_elf_header_copy(bytes: borrow [u8; sizeof(KernelElf64Header)..])
        -> KernelElf64Header {
    let header: &KernelElf64Header = bytes as &KernelElf64Header;
    return *header;
}

fn kernel_elf_program_header_copy(
        bytes: borrow [u8; sizeof(KernelElf64ProgramHeader)..])
        -> KernelElf64ProgramHeader {
    let header: &KernelElf64ProgramHeader = bytes as &KernelElf64ProgramHeader;
    return *header;
}

// sizeof(...) instead of hand-maintained literals (64/56) that used to
// duplicate the two packed structs' own actual sizes.
let ELF_HEADER_SIZE: usize = sizeof(KernelElf64Header);
let ELF_PROGRAM_HEADER_SIZE: usize = sizeof(KernelElf64ProgramHeader);

// GitHub issue #1081: a PT_LOAD's permission set, closed to the three the
// mapper installs. There is no case for any other p_flags value, so the
// mapper has nothing to refuse: distro_elf_load_accept is the only place an
// ELF's permission bits are judged.
variant DistroElfAccess { Read; ReadExecute; ReadWrite; }

// GitHub issue #1081: one PT_LOAD as distro_elf_load_accept accepted it.
// Only that function produces one from program-header bytes; the validator
// and the mapper both obtain their segments through it, so an acceptance
// rule is written once. distro_elf_segment_pages gives the page span the
// validator proved disjoint from every other segment's.
struct DistroElfSegment {
    offset: usize;
    file_size: usize;
    virtual_address: usize;
    memory_size: usize;
    access: DistroElfAccess;
}

// GitHub issue #1081: the plan stays small on purpose. It is copied by
// value along the exec path, and every copy is a stack temporary: a first
// version that carried the 16 accepted segments inline (+520 B a copy)
// overflowed the 16 KiB boot stack in the debug images. The segments are
// therefore decoded on demand from the plan's metadata window, through the
// same accept function the validator ran.
struct DistroElfLoadPlan {
    image: []u8;
    image_length: usize;
    program_offset: usize;
    program_count: usize;
    entry: usize;
    extent: usize;
    load_segments: usize;
    // GitHub issue #591: the PT_INTERP string's file offset and length,
    // including its NUL. Zero length means a static image.
    interpreter_offset: usize;
    interpreter_length: usize;
}

must_use variant DistroElfResult { Invalid; Valid(DistroElfLoadPlan); }

must_use variant DistroElfLoadAccept { Refused; Accepted(DistroElfSegment); }

// GitHub issue #1081: what program-header slot `index` of a plan holds.
// Refused is reachable only if the plan's metadata window no longer holds
// the bytes the validator accepted; a slot that is not PT_LOAD is NotLoad.
must_use variant DistroElfPlanSegment {
    Refused;
    NotLoad;
    Load(DistroElfSegment);
}

// EI_MAG0..EI_MAG3 ("\x7FELF"), EI_CLASS(2=ELFCLASS64), EI_DATA(1=little
// endian), EI_VERSION(1=EV_CURRENT).
let ELF_IDENT_MAGIC: [u8; 7] = {0x7F, 0x45, 0x4C, 0x46, 2, 1, 1};

// A PT_LOAD's page span as process_image_map_segments maps it: from the
// page holding p_vaddr to the page after p_vaddr + p_memsz. The one
// definition both the validator's disjointness check and the mapper use.
// Accepted segments end at or below DISTRO_ELF_SPAN_MAX, so the sum cannot
// wrap.
fn distro_elf_segment_pages(segment: DistroElfSegment) -> (usize, usize) {
    let start: usize = segment.virtual_address;
    let end: usize = start + segment.memory_size;
    return (start / 4096, (end + 4095) / 4096);
}

// GitHub issue #1081: every per-segment PT_LOAD rule, in one place. The
// validator calls it while it accepts an image and the mapper calls it
// (through distro_elf_plan_segment) for each segment it maps, so the mapper
// cannot refuse a segment the validator accepted.
private fn distro_elf_load_accept(item: KernelElf64ProgramHeader,
                                  length: usize) -> DistroElfLoadAccept {
    // GitHub issue #1058: the mapper installs only these three permission
    // sets (PF_R, PF_R|PF_X, PF_R|PF_W); any other is refused here, before
    // execve's point of no return.
    let mut access: DistroElfAccess = DistroElfAccess::Read;
    if (item.flags == 5) {
        access = DistroElfAccess::ReadExecute;
    } else if (item.flags == 6) {
        access = DistroElfAccess::ReadWrite;
    } else if (item.flags != 4) {
        return DistroElfLoadAccept::Refused;
    }
    let offset: usize = item.offset as usize;
    let file_size: usize = item.file_size as usize;
    let virtual_address: usize = item.virtual_address as usize;
    let memory_size: usize = item.memory_size as usize;
    let alignment: usize = item.alignment as usize;
    if (file_size > memory_size || offset > length ||
        file_size > length - offset ||
        memory_size > 0xFFFFFFFFFFFFFFFF - virtual_address) {
        return DistroElfLoadAccept::Refused;
    }
    // ELF permits 0/1 (no requirement); otherwise the file and virtual
    // offsets must agree modulo a power-of-two alignment.
    if (alignment > 1) {
        let mask: usize = alignment - 1;
        if ((alignment & mask) != 0 ||
            (virtual_address & mask) != (offset & mask)) {
            return DistroElfLoadAccept::Refused;
        }
    }
    // The image extent bound, DISTRO_ELF_SPAN_MAX (#1041), applied per
    // segment so that every accepted segment's page span is small; the
    // validator applies it to the maximum again, which this implies.
    if (virtual_address + memory_size > DISTRO_ELF_SPAN_MAX) {
        return DistroElfLoadAccept::Refused;
    }
    let mut segment: DistroElfSegment = {
        offset, file_size, virtual_address, memory_size, access
    };
    return DistroElfLoadAccept::Accepted(segment);
}

// GitHub issue #1081: program-header slot `index` of a plan, decoded and
// judged by distro_elf_load_accept. Slots at or past program_count are
// NotLoad.
fn distro_elf_plan_segment(plan: DistroElfLoadPlan,
                           index: usize) -> DistroElfPlanSegment {
    if (index >= plan.program_count || index >= 16) {
        return DistroElfPlanSegment::NotLoad;
    }
    let image = plan.image;
    let offset: usize = plan.program_offset + index * ELF_PROGRAM_HEADER_SIZE;
    if (offset > image.len) { return DistroElfPlanSegment::Refused; }
    let tail = image[offset..<image.len];
    if (tail.len < sizeof(KernelElf64ProgramHeader)) {
        return DistroElfPlanSegment::Refused;
    }
    let mut item: KernelElf64ProgramHeader = kernel_elf_program_header_copy(
        tail[0..<sizeof(KernelElf64ProgramHeader)]);
    if (item.segment_type != ELF_PT_LOAD) {
        return DistroElfPlanSegment::NotLoad;
    }
    match distro_elf_load_accept(item, plan.image_length) {
        DistroElfLoadAccept::Refused => { return DistroElfPlanSegment::Refused; }
        DistroElfLoadAccept::Accepted(segment) => {
            return DistroElfPlanSegment::Load(segment);
        }
    }
}

// GitHub issue #1058: no two PT_LOAD segments may share a page. The mapper
// refuses a page that is already mapped, and it does so after execve's point
// of no return, where a refusal can only stop the kernel; an image whose
// segments overlap is refused here instead, while execve can still answer
// ENOEXEC. GitHub issue #1081: decided over the segments
// distro_elf_plan_segment yields, the same ones the mapper maps.
private fn distro_elf_load_pages_disjoint(plan: DistroElfLoadPlan) -> bool {
    for i: usize in 0..<16 {
        match distro_elf_plan_segment(plan, i) {
            DistroElfPlanSegment::Refused => { return false; }
            DistroElfPlanSegment::NotLoad => {}
            DistroElfPlanSegment::Load(i_segment) => {
                let (i_first, i_last) = distro_elf_segment_pages(i_segment);
                for j: usize in 0..<16 {
                    if (j < i) {
                        match distro_elf_plan_segment(plan, j) {
                            DistroElfPlanSegment::Refused => { return false; }
                            DistroElfPlanSegment::NotLoad => {}
                            DistroElfPlanSegment::Load(j_segment) => {
                                let (j_first, j_last) =
                                    distro_elf_segment_pages(j_segment);
                                if (i_first < j_last && j_first < i_last) {
                                    return false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return true;
}

// The slice parameter is intentionally retaining rather than `borrow`:
// a successful plan carries this exact checked metadata view to the mapper.
// Stack- or owner-derived slices therefore cannot enter this API, while the
// kernel's persistent global metadata windows can safely outlive the plan.
fn distro_elf_validate_with_length(image: []u8,
                                   logical_length: usize) -> DistroElfResult {
    let header_end: usize = sizeof(KernelElf64Header);
    if (header_end <= image.len) {
        // `image` contains the ELF header and program table. A streaming
        // source may keep the rest of the file on ext2, so its logical file
        // length can be larger than this metadata window.
        let length: usize = logical_length;
        let header_bytes = image[0..<header_end];
        let mut header: KernelElf64Header = kernel_elf_header_copy(header_bytes);
        if (slice_eq(header_bytes[0..<7], ELF_IDENT_MAGIC as []u8) == false) {
            return DistroElfResult::Invalid;
        }
        if (header.object_type != ELF_ET_DYN || header.machine != ELF_EM_AARCH64 ||
            header.version != 1 || header.header_size as usize != ELF_HEADER_SIZE ||
            header.program_entry_size as usize != ELF_PROGRAM_HEADER_SIZE) {
            return DistroElfResult::Invalid;
        }

        let program_offset: usize = header.program_offset as usize;
        let program_count: usize = header.program_count as usize;
        if (program_count == 0 || program_count > 16 || program_offset > length) {
            return DistroElfResult::Invalid;
        }
        let table_size: usize = program_count * ELF_PROGRAM_HEADER_SIZE;
        if (table_size > length - program_offset) { return DistroElfResult::Invalid; }
        if (program_offset > image.len) { return DistroElfResult::Invalid; }

        let mut maximum: usize = 0;
        let mut load_count: usize = 0;
        let mut interpreter_offset: usize = 0;
        let mut interpreter_length: usize = 0;
        for i: usize in 0..<program_count {
            let item_offset: usize = program_offset + i * ELF_PROGRAM_HEADER_SIZE;
            if (item_offset > image.len) { return DistroElfResult::Invalid; }
            let item_tail = image[item_offset..<image.len];
            if (item_tail.len < sizeof(KernelElf64ProgramHeader)) {
                return DistroElfResult::Invalid;
            }
            let item_bytes = item_tail[0..<sizeof(KernelElf64ProgramHeader)];
            let mut item: KernelElf64ProgramHeader =
                kernel_elf_program_header_copy(item_bytes);
            if (item.segment_type == ELF_PT_LOAD) {
                match distro_elf_load_accept(item, length) {
                    DistroElfLoadAccept::Refused => {
                        return DistroElfResult::Invalid;
                    }
                    DistroElfLoadAccept::Accepted(segment) => {
                        let end_address: usize =
                            segment.virtual_address + segment.memory_size;
                        if (end_address > maximum) { maximum = end_address; }
                        load_count = load_count + 1;
                    }
                }
            }
            if (item.segment_type == ELF_PT_INTERP) {
                let offset: usize = item.offset as usize;
                let file_size: usize = item.file_size as usize;
                if (interpreter_length != 0 || file_size == 0 ||
                    offset > length || file_size > length - offset) {
                    return DistroElfResult::Invalid;
                }
                interpreter_offset = offset;
                interpreter_length = file_size;
            }
        }
        let entry: usize = header.entry as usize;
        if (load_count == 0 || entry >= maximum || maximum > DISTRO_ELF_SPAN_MAX) {
            return DistroElfResult::Invalid;
        }
        let mut plan: DistroElfLoadPlan = {
            image, length, program_offset, program_count,
            entry, maximum, load_count,
            interpreter_offset, interpreter_length
        };
        if (distro_elf_load_pages_disjoint(plan) == false) {
            return DistroElfResult::Invalid;
        }
        return DistroElfResult::Valid(plan);
    }
    return DistroElfResult::Invalid;
}
