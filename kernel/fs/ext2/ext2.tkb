use "kernel/drivers/block/memory.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/byte_slice.tkb";

const EXT2_SUPERBLOCK_BLOCK: usize = 1;
const EXT2_MAGIC: u16 = 0xEF53;
// i_block[0..11] are direct pointers; i_block[12] and i_block[13] are
// singly/doubly indirect. Regular-file capacity is derived from geometry.
const EXT2_MAX_DIRECT_BLOCKS: usize = 12;

fn ext2_pointer_count() -> usize { return KERNEL_BLOCK_SIZE / 4; }
fn ext2_direct_file_size() -> usize {
    return EXT2_MAX_DIRECT_BLOCKS * KERNEL_BLOCK_SIZE;
}
fn ext2_max_regular_file_size() -> usize {
    let pointers: usize = ext2_pointer_count();
    return (EXT2_MAX_DIRECT_BLOCKS + pointers + pointers * pointers) *
           KERNEL_BLOCK_SIZE;
}

// One invocation-local pair per core. Kernel code is non-preemptible, so one
// core cannot enter a second ext2 operation before its current operation
// returns; different cores must not parse each other's block-I/O results.
struct Ext2Scratch {
    metadata: [u8; KERNEL_BLOCK_SIZE];
    file: [u8; KERNEL_BLOCK_SIZE];
}

private let mut ext2_scratch: [Ext2Scratch; KERNEL_MAX_CORES];

private fn ext2_scratch_here() -> *Ext2Scratch {
    let base: *Ext2Scratch = ext2_scratch;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

struct Ext2Mount {
    private device: KernelBlockDevice;
    private inode_count: usize;
    private filesystem_blocks: usize;
    private inodes_per_group: usize;
    private inode_size: usize;
    private inode_table_block: usize;
    private block_bitmap_block: usize;
    private inode_bitmap_block: usize;
}

must_use variant Ext2MountResult { Invalid; Mounted(Ext2Mount); }
must_use variant Ext2InodeResult { Invalid; Inode(Ext2Inode); }
must_use variant Ext2LookupResult { Invalid; NotFound; Found(usize); }
must_use variant Ext2ReadResult { Invalid; Read(usize); }
must_use variant Ext2WriteResult { Invalid; Written; }
must_use variant Ext2ResizeResult { Invalid; Resized; }
must_use variant Ext2SymlinkResult { Invalid; Read(usize); }
must_use variant Ext2CounterResult { Invalid; Updated; }
must_use variant Ext2BitmapClaimResult { Invalid; Claimed(usize); }
must_use variant Ext2BitmapReleaseResult { Invalid; Released; }
must_use variant Ext2BitmapProbeResult { Invalid; Verified; }
must_use variant Ext2FreeCountsResult {
    Invalid;
    Counts((usize, usize));
}

struct Ext2Inode {
    private mode: usize;
    private links: usize;
    private size: usize;
    private direct_block0: usize;
    private table_block: usize;
    private table_offset: usize;
}

linear struct Ext2BlockOwner[block: usize] {
    private bitmap_index: usize;
    private block_number: usize;
    private witness: usize @ block;
}

linear struct Ext2InodeOwner[inode: usize] {
    private bitmap_index: usize;
    private inode_number: usize;
    private witness: usize @ inode;
}

must_use variant Ext2BlockAllocResult {
    Failed;
    Allocated(exists block: usize. Ext2BlockOwner[block]);
}

must_use variant Ext2InodeAllocResult {
    Failed;
    Allocated(exists inode: usize. Ext2InodeOwner[inode]);
}

must_use variant Ext2OwnerReleaseResult { Invalid; Released; }
must_use variant Ext2DirectoryResult { Invalid; Updated; }

linear struct Ext2LinkedFile[inode: usize, block: usize] {
    private inode_bitmap_index: usize;
    private block_bitmap_index: usize;
    private inode_number: usize @ inode;
    private block_number: usize @ block;
}

must_use variant Ext2CreateResult {
    Invalid;
    Created(exists inode: usize. exists block: usize.
            Ext2LinkedFile[inode, block]);
}

must_use variant Ext2UnlinkResult { Invalid; Unlinked; }
must_use variant Ext2CountResult { Invalid; Counted(usize); }

// A directory made by ext2_make_directory_in. It is a distinct type from
// Ext2LinkedFile on purpose: removing a directory also returns the parent's
// link count and the group's directory count, so handing one to the regular
// file unlink would leave both wrong -- and that is now a type error.
linear struct Ext2LinkedDirectory[inode: usize, block: usize] {
    private inode_bitmap_index: usize;
    private block_bitmap_index: usize;
    private inode_number: usize @ inode;
    private block_number: usize @ block;
}

must_use variant Ext2MkdirResult {
    Invalid;
    Created(exists inode: usize. exists block: usize.
            Ext2LinkedDirectory[inode, block]);
}

// NotEmpty and Refused hand the directory back: it is still linked, so its
// owner is still owed to somebody. Invalid means removal started and could
// not finish, and the owner was spent trying.
must_use variant Ext2RmdirResult {
    Invalid;
    Removed;
    NotEmpty(exists inode: usize. exists block: usize.
             Ext2LinkedDirectory[inode, block]);
    Refused(exists inode: usize. exists block: usize.
            Ext2LinkedDirectory[inode, block]);
}

must_use variant Ext2RmdirStep { Refused; NotEmpty; Unlinked; }

must_use variant Ext2UnlinkNameResult {
    Invalid;
    NotFound;
    IsDirectory;
    Unsupported;
    Unlinked;
}

must_use variant Ext2ClaimResult {
    Invalid;
    NotFound;
    NotDirectory;
    Claimed(exists inode: usize. exists block: usize.
            Ext2LinkedDirectory[inode, block]);
}

fn ext2_u16(bytes: borrow *u8, offset: usize) -> u16 {
    if (offset > KERNEL_BLOCK_SIZE - 2) { return 0; }
    return (bytes[offset as isize] as u16) |
           ((bytes[(offset + 1) as isize] as u16) << 8);
}

fn ext2_u32(bytes: borrow *u8, offset: usize) -> u32 {
    if (offset > KERNEL_BLOCK_SIZE - 4) { return 0; }
    return (bytes[offset as isize] as u32) |
           ((bytes[(offset + 1) as isize] as u32) << 8) |
           ((bytes[(offset + 2) as isize] as u32) << 16) |
           ((bytes[(offset + 3) as isize] as u32) << 24);
}

fn ext2_put_u32(bytes: borrow *u8, offset: usize, value: u32) -> bool {
    if (offset > KERNEL_BLOCK_SIZE - 4) { return false; }
    bytes[offset as isize] = (value & 0xFF) as u8;
    bytes[(offset + 1) as isize] = ((value >> 8) & 0xFF) as u8;
    bytes[(offset + 2) as isize] = ((value >> 16) & 0xFF) as u8;
    bytes[(offset + 3) as isize] = ((value >> 24) & 0xFF) as u8;
    return true;
}

fn ext2_put_u16(bytes: borrow *u8, offset: usize, value: u16) -> bool {
    if (offset > KERNEL_BLOCK_SIZE - 2) { return false; }
    bytes[offset as isize] = (value & 0xFF) as u8;
    bytes[(offset + 1) as isize] = ((value >> 8) & 0xFF) as u8;
    return true;
}

fn ext2_mount(device: KernelBlockDevice) -> Ext2MountResult {
    match block_read(device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2MountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let superblock: *u8 = ext2_scratch_here().metadata as *u8;
    let inode_count: usize = ext2_u32(superblock, 0) as usize;
    let filesystem_blocks: usize = ext2_u32(superblock, 4) as usize;
    let first_data_block: usize = ext2_u32(superblock, 20) as usize;
    let log_block_size: usize = ext2_u32(superblock, 24) as usize;
    let blocks_per_group: usize = ext2_u32(superblock, 32) as usize;
    let inodes_per_group: usize = ext2_u32(superblock, 40) as usize;
    let magic: u16 = ext2_u16(superblock, 56);
    let revision: usize = ext2_u32(superblock, 76) as usize;
    let inode_size: usize = ext2_u16(superblock, 88) as usize;
    let feature_compat: usize = ext2_u32(superblock, 92) as usize;
    let feature_incompat: usize = ext2_u32(superblock, 96) as usize;
    let feature_ro_compat: usize = ext2_u32(superblock, 100) as usize;

    if (magic != EXT2_MAGIC || inode_count == 0 ||
        filesystem_blocks == 0 || filesystem_blocks > block_count(device) ||
        first_data_block != 1 || log_block_size != 0 ||
        blocks_per_group == 0 || inodes_per_group == 0 ||
        revision != 1 || inode_size != 128 ||
        feature_compat != 0 || feature_incompat != 0 ||
        feature_ro_compat != 0) {
        return Ext2MountResult::Invalid;
    }
    match block_read(device, 2, ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2MountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_table_block: usize =
        ext2_u32(ext2_scratch_here().metadata as *u8, 8) as usize;
    let block_bitmap_block: usize =
        ext2_u32(ext2_scratch_here().metadata as *u8, 0) as usize;
    let inode_bitmap_block: usize =
        ext2_u32(ext2_scratch_here().metadata as *u8, 4) as usize;
    if (inode_table_block == 0 || inode_table_block >= filesystem_blocks ||
        block_bitmap_block == 0 || block_bitmap_block >= filesystem_blocks ||
        inode_bitmap_block == 0 || inode_bitmap_block >= filesystem_blocks) {
        return Ext2MountResult::Invalid;
    }
    let mut mount: Ext2Mount = {
        device, inode_count, filesystem_blocks, inodes_per_group, inode_size,
        inode_table_block, block_bitmap_block, inode_bitmap_block
    };
    return Ext2MountResult::Mounted(mount);
}

fn ext2_fixture_geometry_is_expected(mount: Ext2Mount) -> bool {
    return mount.inode_count == 1024 && mount.filesystem_blocks == 2560 &&
           mount.inodes_per_group == 1024 && mount.inode_size == 128;
}

fn ext2_read_inode(mount: Ext2Mount, inode_number: usize)
        -> Ext2InodeResult {
    if (inode_number == 0 || inode_number > mount.inode_count ||
        inode_number > mount.inodes_per_group) {
        return Ext2InodeResult::Invalid;
    }
    let inode_index: usize = inode_number - 1;
    let byte_offset: usize = inode_index * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        offset > KERNEL_BLOCK_SIZE - 128) {
        return Ext2InodeResult::Invalid;
    }
    match block_read(mount.device, table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2InodeResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_bytes: *u8 =
        (ext2_scratch_here().metadata as *u8) + (offset as isize);
    let mode: usize = ext2_u16(inode_bytes, 0) as usize;
    let links: usize = ext2_u16(inode_bytes, 26) as usize;
    let size: usize = ext2_u32(inode_bytes, 4) as usize;
    let direct_block0: usize = ext2_u32(inode_bytes, 40) as usize;
    let indirect_block: usize = ext2_u32(inode_bytes, 88) as usize;
    let double_indirect_block: usize = ext2_u32(inode_bytes, 92) as usize;
    let file_type: usize = mode & 0xF000;
    // Regular files and directories may span their direct block pointers.
    // Symlinks retain the inline fast-symlink limit.
    let mut max_size: usize = KERNEL_BLOCK_SIZE;
    if (file_type == 0x8000) { max_size = ext2_max_regular_file_size(); }
    if (file_type == 0x4000) { max_size = ext2_direct_file_size(); }
    if (mode == 0 || size > max_size ||
        (file_type != 0x8000 && file_type != 0x4000 && file_type != 0xA000) ||
        ((file_type == 0x8000 || file_type == 0x4000) &&
         (direct_block0 == 0 || direct_block0 >= mount.filesystem_blocks)) ||
        (file_type == 0x8000 && size > ext2_direct_file_size() &&
         (indirect_block == 0 || indirect_block >= mount.filesystem_blocks)) ||
        (file_type == 0x8000 &&
         size > ext2_direct_file_size() +
               ext2_pointer_count() * KERNEL_BLOCK_SIZE &&
         (double_indirect_block == 0 ||
          double_indirect_block >= mount.filesystem_blocks)) ||
        (file_type == 0xA000 && size > 60)) {
        return Ext2InodeResult::Invalid;
    }
    let mut inode: Ext2Inode = {
        mode, links, size, direct_block0, table_block, offset
    };
    return Ext2InodeResult::Inode(inode);
}

fn ext2_name_matches(entry_name: borrow []u8, name: borrow []u8) -> bool {
    if (entry_name.len != name.len || entry_name.len > 255) { return false; }
    return slice_eq(entry_name, name);
}

fn ext2_lookup_directory(mount: Ext2Mount, directory_inode: usize,
                         name: borrow []u8) -> Ext2LookupResult !{unsafe} {
    if (name.len == 0 || name.len > 255) {
        return Ext2LookupResult::Invalid;
    }
    match ext2_read_inode(mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2LookupResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if ((directory.mode & 0xF000) != 0x4000 ||
                directory.size < 8 || directory.size > ext2_direct_file_size()) {
                return Ext2LookupResult::Invalid;
            }
            let mut cursor: usize = 0;
            while (cursor < directory.size) {
                if (cursor > directory.size - 8) {
                    return Ext2LookupResult::Invalid;
                }
                let block_offset: usize = cursor % KERNEL_BLOCK_SIZE;
                if (block_offset == 0) {
                    match block_read(mount.device,
                                     ext2_inode_block_pointer(
                                         mount, directory,
                                         cursor / KERNEL_BLOCK_SIZE),
                                     ext2_scratch_here().file as []u8) {
                        BlockIoResult::Invalid => {
                            return Ext2LookupResult::Invalid;
                        }
                        BlockIoResult::Ok => { }
                    }
                }
                let entry: *u8 = (ext2_scratch_here().file as *u8) +
                                 (block_offset as isize);
                let inode_number: usize = ext2_u32(entry, 0) as usize;
                let record_length: usize = ext2_u16(entry, 4) as usize;
                let name_length: usize = entry[6] as usize;
                if (record_length < 8 || record_length > directory.size - cursor ||
                    record_length > KERNEL_BLOCK_SIZE - block_offset ||
                    name_length > record_length - 8) {
                    return Ext2LookupResult::Invalid;
                }
                let file_bytes = ext2_scratch_here().file as []u8;
                if (block_offset > file_bytes.len) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_tail =
                    file_bytes[block_offset..<file_bytes.len];
                if (record_length > entry_tail.len) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_bytes = entry_tail[0..<record_length];
                if (entry_bytes.len < 8) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_payload = entry_bytes[8..<entry_bytes.len];
                if (name_length > entry_payload.len) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_name = entry_payload[0..<name_length];
                if (inode_number != 0 &&
                    ext2_name_matches(entry_name, name)) {
                    return Ext2LookupResult::Found(inode_number);
                }
                cursor = cursor + record_length;
            }
        }
    }
    return Ext2LookupResult::NotFound;
}

fn ext2_lookup_root(mount: Ext2Mount, name: []u8)
        -> Ext2LookupResult !{unsafe} {
    return ext2_lookup_directory(mount, 2, name);
}

fn ext2_lookup_path_from(mount: Ext2Mount, start_inode: usize, name: []u8)
        -> Ext2LookupResult !{unsafe} {
    if (name.len == 0 || name.len > 255) {
        return Ext2LookupResult::Invalid;
    }
    if (name.len == 1) {
        if (name[0] == 0x2E) {
            return Ext2LookupResult::Found(start_inode);
        }
    }
    let mut current_inode: usize = start_inode;
    let mut cursor: usize = 0;
    while (cursor < name.len) {
        let component_start: usize = cursor;
        if (component_start > name.len) {
            return Ext2LookupResult::Invalid;
        }
        let name_tail = name[component_start..<name.len];
        let mut component_length: usize = name_tail.len;
        match byte_slice_find_first(name_tail, 0x2F) {
            ByteSliceFindResult::Absent => {}
            ByteSliceFindResult::Found(position) => {
                component_length = position;
            }
        }
        if (component_length == 0) {
            return Ext2LookupResult::Invalid;
        }
        if (component_length > name_tail.len) {
            return Ext2LookupResult::Invalid;
        }
        let component = name_tail[0..<component_length];
        cursor = component_start + component_length;
        if (component.len == 1) {
            if (component[0] == 0x2E) {
                if (cursor < name.len) { cursor = cursor + 1; }
                continue;
            }
        }
        // `..` is not special-cased: every ext2 directory carries its own
        // `..` entry naming its parent, and the root's names the root. This
        // used to answer the root for every `..`, which was right only while
        // no directory was nested deeper than one level (GitHub issue #537).
        match ext2_lookup_directory(mount, current_inode, component) {
            Ext2LookupResult::Invalid => { return Ext2LookupResult::Invalid; }
            Ext2LookupResult::NotFound => { return Ext2LookupResult::NotFound; }
            Ext2LookupResult::Found(inode) => { current_inode = inode; }
        }
        if (cursor < name.len) {
            cursor = cursor + 1;
            if (cursor == name.len) {
                return Ext2LookupResult::Invalid;
            }
        }
    }
    return Ext2LookupResult::Found(current_inode);
}

fn ext2_lookup_path(mount: Ext2Mount, name: []u8)
        -> Ext2LookupResult !{unsafe} {
    return ext2_lookup_path_from(mount, 2, name);
}

// Resolve a regular file's i_block[index]. The inode table is re-read on
// every call rather than trusting a copy held here; since GitHub issue #208
// the block layer's cache answers those re-reads, so they cost a copy rather
// than a device round trip. Direct entries
// reside at byte 40; i_block[12] at byte 88 names a singly-indirect block
// of 256 little-endian u32 entries. Returns 0 (never a valid data block)
// for an out-of-range index or any failed metadata read.
fn ext2_inode_block_pointer(mount: Ext2Mount, inode: Ext2Inode,
                            index: usize) -> usize {
    let pointers: usize = ext2_pointer_count();
    if (pointers == 0) { return 0; }
    if (index >= EXT2_MAX_DIRECT_BLOCKS + pointers + pointers * pointers) {
        return 0;
    }
    match block_read(mount.device, inode.table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return 0; }
        BlockIoResult::Ok => { }
    }
    let inode_pointer: *u8 =
        (ext2_scratch_here().metadata as *u8) + (inode.table_offset as isize);
    if (index < EXT2_MAX_DIRECT_BLOCKS) {
        return ext2_u32(inode_pointer, 40 + index * 4) as usize;
    }
    let single_index: usize = index - EXT2_MAX_DIRECT_BLOCKS;
    let indirect_block: usize = ext2_u32(inode_pointer, 88) as usize;
    if (single_index < pointers) {
        if (indirect_block == 0 || indirect_block >= mount.filesystem_blocks) {
            return 0;
        }
        match block_read(mount.device, indirect_block,
                         ext2_scratch_here().file as []u8) {
            BlockIoResult::Invalid => { return 0; }
            BlockIoResult::Ok => { }
        }
        return ext2_u32(ext2_scratch_here().file as *u8,
                        single_index * 4) as usize;
    }
    let double_block: usize = ext2_u32(inode_pointer, 92) as usize;
    if (double_block == 0 || double_block >= mount.filesystem_blocks) {
        return 0;
    }
    let double_index: usize = single_index - pointers;
    match block_read(mount.device, double_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return 0; }
        BlockIoResult::Ok => { }
    }
    let second_level: usize = ext2_u32(
        ext2_scratch_here().metadata as *u8, (double_index / pointers) * 4) as usize;
    if (second_level == 0 || second_level >= mount.filesystem_blocks) {
        return 0;
    }
    match block_read(mount.device, second_level,
                     ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return 0; }
        BlockIoResult::Ok => { }
    }
    let resolved: usize = ext2_u32(ext2_scratch_here().file as *u8,
                    (double_index % pointers) * 4) as usize;
    return resolved;
}

fn ext2_read_small_file(mount: Ext2Mount, inode_number: usize,
                        destination: []u8)
        -> Ext2ReadResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000 ||
                inode.size > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            let block_count: usize =
                (inode.size + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
            let mut copied: usize = 0;
            for block_index: usize in 0..<block_count {
                let block_number: usize =
                    ext2_inode_block_pointer(mount, inode, block_index);
                if (block_number == 0 ||
                    block_number >= mount.filesystem_blocks) {
                    return Ext2ReadResult::Invalid;
                }
                match block_read(mount.device, block_number,
                                 ext2_scratch_here().file as []u8) {
                    BlockIoResult::Invalid => { return Ext2ReadResult::Invalid; }
                    BlockIoResult::Ok => { }
                }
                let mut chunk: usize = KERNEL_BLOCK_SIZE;
                if (inode.size - copied < chunk) { chunk = inode.size - copied; }
                let file_bytes = ext2_scratch_here().file as []u8;
                if (chunk > file_bytes.len) {
                    return Ext2ReadResult::Invalid;
                }
                let source = file_bytes[0..<chunk];
                let destination_start: usize = copied;
                if (destination_start > destination.len) {
                    return Ext2ReadResult::Invalid;
                }
                let target =
                    destination[destination_start..<destination.len];
                if (source.len > target.len) {
                    return Ext2ReadResult::Invalid;
                }
                slice_copy(target, source);
                copied = copied + chunk;
            }
            return Ext2ReadResult::Read(inode.size);
        }
    }
}

// Read at most one filesystem block at `offset` into `destination`. This is
// deliberately separate from ext2_read_small_file(): syscall read paths must
// not need a kernel buffer as large as the whole file. Callers repeat this
// operation and copy each bounded block into the user buffer, like a VFS
// page-cache/buffer-cache read path does on larger kernels.
// The USB backend supports bounded multi-sector transfers, but this API
// intentionally remains one-block-at-a-time: a larger read would need to
// prove contiguous physical ext2 block pointers and retain a correspondingly
// large scratch buffer. The current ext2 write paths likewise update single
// metadata/data blocks, so they do not yet have a safe contiguous range to
// coalesce.
//
// The supported range is derived from the 12 direct pointers and the
// single- and double-indirect pointer fanout of this filesystem's block size.
// Triple-indirect traversal remains outside the present rootfs requirement.
fn ext2_read_file_chunk(mount: Ext2Mount, inode_number: usize,
                        offset: usize, destination: []u8)
        -> Ext2ReadResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000 ||
                inode.size > ext2_max_regular_file_size()) {
                return Ext2ReadResult::Invalid;
            }
            if (offset >= inode.size || destination.len == 0) {
                return Ext2ReadResult::Read(0);
            }
            let block_index: usize = offset / KERNEL_BLOCK_SIZE;
            let block_offset: usize = offset % KERNEL_BLOCK_SIZE;
            let block_number: usize =
                ext2_inode_block_pointer(mount, inode, block_index);
            if (block_number == 0 || block_number >= mount.filesystem_blocks) {
                return Ext2ReadResult::Invalid;
            }
            match block_read(mount.device, block_number,
                             ext2_scratch_here().file as []u8) {
                BlockIoResult::Invalid => { return Ext2ReadResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let mut chunk: usize = destination.len;
            if (chunk > KERNEL_BLOCK_SIZE - block_offset) {
                chunk = KERNEL_BLOCK_SIZE - block_offset;
            }
            if (chunk > inode.size - offset) {
                chunk = inode.size - offset;
            }
            let file_bytes = ext2_scratch_here().file as []u8;
            if (block_offset > file_bytes.len) {
                return Ext2ReadResult::Invalid;
            }
            let source_tail = file_bytes[block_offset..<file_bytes.len];
            if (chunk > source_tail.len) {
                return Ext2ReadResult::Invalid;
            }
            let source = source_tail[0..<chunk];
            if (chunk > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            slice_copy(destination, source);
            return Ext2ReadResult::Read(chunk);
        }
    }
}

fn ext2_read_directory_chunk(mount: Ext2Mount, inode_number: usize,
                             offset: usize, destination: []u8)
        -> Ext2ReadResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x4000 ||
                inode.size > ext2_direct_file_size()) {
                return Ext2ReadResult::Invalid;
            }
            if (offset >= inode.size || destination.len == 0) {
                return Ext2ReadResult::Read(0);
            }
            let block_index: usize = offset / KERNEL_BLOCK_SIZE;
            let block_offset: usize = offset % KERNEL_BLOCK_SIZE;
            let block_number: usize =
                ext2_inode_block_pointer(mount, inode, block_index);
            if (block_number == 0 || block_number >= mount.filesystem_blocks) {
                return Ext2ReadResult::Invalid;
            }
            match block_read(mount.device, block_number,
                             ext2_scratch_here().file as []u8) {
                BlockIoResult::Invalid => { return Ext2ReadResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let mut chunk: usize = destination.len;
            if (chunk > KERNEL_BLOCK_SIZE - block_offset) {
                chunk = KERNEL_BLOCK_SIZE - block_offset;
            }
            if (chunk > inode.size - offset) {
                chunk = inode.size - offset;
            }
            let file_bytes = ext2_scratch_here().file as []u8;
            if (block_offset > file_bytes.len) {
                return Ext2ReadResult::Invalid;
            }
            let source_tail = file_bytes[block_offset..<file_bytes.len];
            if (chunk > source_tail.len) {
                return Ext2ReadResult::Invalid;
            }
            let source = source_tail[0..<chunk];
            if (chunk > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            slice_copy(destination, source);
            return Ext2ReadResult::Read(chunk);
        }
    }
}

fn ext2_inode_is_symlink(mount: Ext2Mount, inode_number: usize) -> bool {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return false; }
        Ext2InodeResult::Inode(inode) => {
            return (inode.mode & 0xF000) == 0xA000;
        }
    }
}

fn ext2_regular_file_size(mount: Ext2Mount, inode_number: usize) -> usize {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000) { return 0; }
            return inode.size;
        }
    }
}

fn ext2_inode_mode(mount: Ext2Mount, inode_number: usize) -> usize {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => { return inode.mode; }
    }
}

fn ext2_inode_size(mount: Ext2Mount, inode_number: usize) -> usize {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => { return inode.size; }
    }
}

fn ext2_write_small_file(mount: Ext2Mount, inode_number: usize,
                         source: []u8)
        -> Ext2WriteResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2WriteResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            // This first mutation contract overwrites one already allocated
            // direct block without changing i_size. Allocation and truncate
            // become necessary only when a real caller requests them.
            if ((inode.mode & 0xF000) != 0x8000 ||
                source.len != inode.size || source.len > KERNEL_BLOCK_SIZE) {
                return Ext2WriteResult::Invalid;
            }
            for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch_here().file[i] = 0; }
            let file_bytes = ext2_scratch_here().file as []u8;
            slice_copy(file_bytes, source);
            match block_write(mount.device, inode.direct_block0,
                              ext2_scratch_here().file as []u8) {
                BlockIoResult::Invalid => { return Ext2WriteResult::Invalid; }
                BlockIoResult::Ok => { return Ext2WriteResult::Written; }
            }
        }
    }
}

fn ext2_resize_small_file(mount: Ext2Mount, inode_number: usize,
                          source: []u8)
        -> Ext2ResizeResult !{unsafe} {
    if (source.len == 0 || source.len > KERNEL_BLOCK_SIZE) {
        return Ext2ResizeResult::Invalid;
    }
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ResizeResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000) {
                return Ext2ResizeResult::Invalid;
            }

            // Publish data first. Until the inode table write succeeds, the
            // old i_size remains the only visible extent.
            for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch_here().file[i] = 0; }
            let file_bytes = ext2_scratch_here().file as []u8;
            slice_copy(file_bytes, source);
            match block_write(mount.device, inode.direct_block0,
                              ext2_scratch_here().file as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { }
            }

            match block_read(mount.device, inode.table_block,
                             ext2_scratch_here().metadata as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let inode_pointer: *u8 =
                (ext2_scratch_here().metadata as *u8) + (inode.table_offset as isize);
            if (ext2_put_u32(inode_pointer, 4, source.len as u32) == false) {
                return Ext2ResizeResult::Invalid;
            }
            match block_write(mount.device, inode.table_block,
                              ext2_scratch_here().metadata as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { return Ext2ResizeResult::Resized; }
            }
        }
    }
}

fn ext2_read_fast_symlink(mount: Ext2Mount, inode_number: usize,
                          destination: []u8)
        -> Ext2SymlinkResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2SymlinkResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0xA000 || inode.size > 60 ||
                inode.size > destination.len) {
                return Ext2SymlinkResult::Invalid;
            }
            match block_read(mount.device, inode.table_block,
                             ext2_scratch_here().metadata as []u8) {
                BlockIoResult::Invalid => { return Ext2SymlinkResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let metadata = ext2_scratch_here().metadata as []u8;
            let table_offset: usize = inode.table_offset;
            if (table_offset > metadata.len) {
                return Ext2SymlinkResult::Invalid;
            }
            let inode_tail =
                metadata[table_offset..<metadata.len];
            if (inode_tail.len < 40) {
                return Ext2SymlinkResult::Invalid;
            }
            let inline_target = inode_tail[40..<inode_tail.len];
            let symlink_size: usize = inode.size;
            if (symlink_size > inline_target.len) {
                return Ext2SymlinkResult::Invalid;
            }
            let source = inline_target[0..<symlink_size];
            if (symlink_size > destination.len) {
                return Ext2SymlinkResult::Invalid;
            }
            slice_copy(destination, source);
            return Ext2SymlinkResult::Read(inode.size);
        }
    }
}

fn ext2_update_free_counts(mount: Ext2Mount, inode_counter: bool,
                           allocate: bool) -> Ext2CounterResult {
    match block_read(mount.device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match block_read(mount.device, 2, ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut super_offset: usize = 12;
    let mut group_offset: usize = 12;
    if (inode_counter) {
        super_offset = 16;
        group_offset = 14;
    }
    let super_bytes: *u8 = ext2_scratch_here().metadata as *u8;
    let group_bytes: *u8 = ext2_scratch_here().file as *u8;
    let super_count: u32 = ext2_u32(super_bytes, super_offset);
    let group_count: u16 = ext2_u16(group_bytes, group_offset);
    let mut next_super: u32 = super_count;
    let mut next_group: u16 = group_count;
    if (allocate) {
        if (super_count == 0 || group_count == 0) {
            return Ext2CounterResult::Invalid;
        }
        next_super = super_count - 1;
        next_group = group_count - 1;
    } else {
        if (super_count == 0xFFFFFFFF || group_count == 0xFFFF) {
            return Ext2CounterResult::Invalid;
        }
        next_super = super_count + 1;
        next_group = group_count + 1;
    }
    if (ext2_put_u32(super_bytes, super_offset, next_super) == false ||
        ext2_put_u16(group_bytes, group_offset, next_group) == false) {
        return Ext2CounterResult::Invalid;
    }
    match block_write(mount.device, EXT2_SUPERBLOCK_BLOCK,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match block_write(mount.device, 2, ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { return Ext2CounterResult::Updated; }
    }
}

fn ext2_free_counts(mount: Ext2Mount) -> Ext2FreeCountsResult {
    match block_read(mount.device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2FreeCountsResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let free_blocks: usize =
        ext2_u32(ext2_scratch_here().metadata as *u8, 12) as usize;
    let free_inodes: usize =
        ext2_u32(ext2_scratch_here().metadata as *u8, 16) as usize;
    match block_read(mount.device, 2, ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2FreeCountsResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let group_free_blocks: usize =
        ext2_u16(ext2_scratch_here().file as *u8, 12) as usize;
    let group_free_inodes: usize =
        ext2_u16(ext2_scratch_here().file as *u8, 14) as usize;
    if (free_blocks != group_free_blocks || free_inodes != group_free_inodes) {
        return Ext2FreeCountsResult::Invalid;
    }
    return Ext2FreeCountsResult::Counts((free_blocks, free_inodes));
}

fn ext2_bitmap_claim(mount: Ext2Mount, inode_bitmap: bool,
                     first_index: usize, item_count: usize)
        -> Ext2BitmapClaimResult {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    if (inode_bitmap) { bitmap_block = mount.inode_bitmap_block; }
    if (item_count == 0 || item_count > KERNEL_BLOCK_SIZE * 8 ||
        first_index >= item_count) {
        return Ext2BitmapClaimResult::Invalid;
    }
    match block_read(mount.device, bitmap_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapClaimResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let bitmap: *u8 = ext2_scratch_here().metadata as *u8;
    let mut index: usize = first_index;
    while (index < item_count) {
        let byte_index: usize = index / 8;
        let bit_index: usize = index % 8;
        let value: u8 = bitmap[byte_index as isize];
        let mask: u8 = (1 << (bit_index as u8)) as u8;
        if ((value & mask) == 0) {
            bitmap[byte_index as isize] = value | mask;
            match block_write(mount.device, bitmap_block,
                              ext2_scratch_here().metadata as []u8) {
                BlockIoResult::Invalid => {
                    return Ext2BitmapClaimResult::Invalid;
                }
                BlockIoResult::Ok => { }
            }
            match ext2_update_free_counts(mount, inode_bitmap, true) {
                Ext2CounterResult::Invalid => {
                    return Ext2BitmapClaimResult::Invalid;
                }
                Ext2CounterResult::Updated => {
                    return Ext2BitmapClaimResult::Claimed(index);
                }
            }
        }
        index = index + 1;
    }
    return Ext2BitmapClaimResult::Invalid;
}

fn ext2_bitmap_release(mount: Ext2Mount, inode_bitmap: bool,
                       index: usize) -> Ext2BitmapReleaseResult {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    let mut item_count: usize = mount.filesystem_blocks - 1;
    if (inode_bitmap) {
        bitmap_block = mount.inode_bitmap_block;
        item_count = mount.inode_count;
    }
    if (index >= item_count) { return Ext2BitmapReleaseResult::Invalid; }
    match block_read(mount.device, bitmap_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let bitmap: *u8 = ext2_scratch_here().metadata as *u8;
    let byte_index: usize = index / 8;
    let bit_index: usize = index % 8;
    let value: u8 = bitmap[byte_index as isize];
    let mask: u8 = (1 << (bit_index as u8)) as u8;
    if ((value & mask) == 0) { return Ext2BitmapReleaseResult::Invalid; }
    bitmap[byte_index as isize] = value & (mask ^ 0xFF);
    match block_write(mount.device, bitmap_block,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_update_free_counts(mount, inode_bitmap, false) {
        Ext2CounterResult::Invalid => { return Ext2BitmapReleaseResult::Invalid; }
        Ext2CounterResult::Updated => {
            return Ext2BitmapReleaseResult::Released;
        }
    }
}

fn ext2_bitmap_roundtrip_check(mount: Ext2Mount)
        -> Ext2BitmapProbeResult {
    let mut before_blocks: usize = 0;
    let mut before_inodes: usize = 0;
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            before_blocks = blocks;
            before_inodes = inodes;
        }
    }
    let mut block_index: usize = 0;
    match ext2_bitmap_claim(
            mount, false, mount.inode_table_block + 16,
            mount.filesystem_blocks - 1) {
        Ext2BitmapClaimResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapClaimResult::Claimed(index) => { block_index = index; }
    }
    let mut inode_index: usize = 0;
    match ext2_bitmap_claim(mount, true, 11, mount.inode_count) {
        Ext2BitmapClaimResult::Invalid => {
            match ext2_bitmap_release(mount, false, block_index) {
                Ext2BitmapReleaseResult::Invalid => { }
                Ext2BitmapReleaseResult::Released => { }
            }
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapClaimResult::Claimed(index) => { inode_index = index; }
    }
    match ext2_free_counts(mount) {
        Ext2FreeCountsResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            if (blocks + 1 != before_blocks || inodes + 1 != before_inodes) {
                return Ext2BitmapProbeResult::Invalid;
            }
        }
    }
    match ext2_bitmap_release(mount, true, inode_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => { }
    }
    match ext2_bitmap_release(mount, false, block_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => {
            match ext2_free_counts(mount) {
                Ext2FreeCountsResult::Invalid => {
                    return Ext2BitmapProbeResult::Invalid;
                }
                Ext2FreeCountsResult::Counts(counts) => {
                    let (blocks, inodes) = counts;
                    if (blocks == before_blocks && inodes == before_inodes) {
                        return Ext2BitmapProbeResult::Verified;
                    }
                }
            }
            return Ext2BitmapProbeResult::Invalid;
        }
    }
}

fn ext2_block_owner_new(bitmap_index: usize,
                        block_number: usize,
                        witness: usize @ block) -> Ext2BlockOwner[block] {
    let mut owner: Ext2BlockOwner[block] = {
        bitmap_index, block_number, witness
    };
    return owner;
}

fn ext2_inode_owner_new(bitmap_index: usize,
                        inode_number: usize,
                        witness: usize @ inode) -> Ext2InodeOwner[inode] {
    let mut owner: Ext2InodeOwner[inode] = {
        bitmap_index, inode_number, witness
    };
    return owner;
}

fn ext2_allocate_block(mount: Ext2Mount) -> Ext2BlockAllocResult {
    let inode_table_bytes: usize = mount.inode_count * mount.inode_size;
    let inode_table_blocks: usize =
        (inode_table_bytes + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
    let first_block: usize = mount.inode_table_block + inode_table_blocks;
    if (first_block == 0 || first_block >= mount.filesystem_blocks) {
        return Ext2BlockAllocResult::Failed;
    }
    // Bitmap index zero represents filesystem block one for a 1 KiB ext2
    // volume. This mount contract already requires first_data_block == 1.
    match ext2_bitmap_claim(
            mount, false, first_block - 1, mount.filesystem_blocks - 1) {
        Ext2BitmapClaimResult::Invalid => {
            return Ext2BlockAllocResult::Failed;
        }
        Ext2BitmapClaimResult::Claimed(bitmap_index) => {
            let block_number: usize = bitmap_index + 1;
            for i: usize in 0..<KERNEL_BLOCK_SIZE {
                ext2_scratch_here().file[i] = 0;
            }
            match block_write(mount.device, block_number,
                              ext2_scratch_here().file as []u8) {
                BlockIoResult::Invalid => {
                    match ext2_bitmap_release(mount, false, bitmap_index) {
                        Ext2BitmapReleaseResult::Invalid => { }
                        Ext2BitmapReleaseResult::Released => { }
                    }
                    return Ext2BlockAllocResult::Failed;
                }
                BlockIoResult::Ok => {
                    return Ext2BlockAllocResult::Allocated(
                        ext2_block_owner_new(
                            bitmap_index, block_number, block_number));
                }
            }
        }
    }
}

fn ext2_allocate_inode(mount: Ext2Mount) -> Ext2InodeAllocResult {
    // Inodes 1..10 are ext2 reserved in revision 1. Bitmap index 10 is
    // therefore the first allocatable inode (inode number 11).
    match ext2_bitmap_claim(mount, true, 10, mount.inode_count) {
        Ext2BitmapClaimResult::Invalid => {
            return Ext2InodeAllocResult::Failed;
        }
        Ext2BitmapClaimResult::Claimed(bitmap_index) => {
            let inode_number: usize = bitmap_index + 1;
            let byte_offset: usize = bitmap_index * mount.inode_size;
            let table_block: usize = mount.inode_table_block +
                                     byte_offset / KERNEL_BLOCK_SIZE;
            let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
            if (table_block >= mount.filesystem_blocks ||
                table_offset > KERNEL_BLOCK_SIZE - 128) {
                match ext2_bitmap_release(mount, true, bitmap_index) {
                    Ext2BitmapReleaseResult::Invalid => { }
                    Ext2BitmapReleaseResult::Released => { }
                }
                return Ext2InodeAllocResult::Failed;
            }
            match block_read(mount.device, table_block,
                             ext2_scratch_here().metadata as []u8) {
                BlockIoResult::Invalid => {
                    match ext2_bitmap_release(mount, true, bitmap_index) {
                        Ext2BitmapReleaseResult::Invalid => { }
                        Ext2BitmapReleaseResult::Released => { }
                    }
                    return Ext2InodeAllocResult::Failed;
                }
                BlockIoResult::Ok => { }
            }
            let inode_pointer: *u8 =
                (ext2_scratch_here().metadata as *u8) + (table_offset as isize);
            for i: isize in 0..<128 { inode_pointer[i] = 0; }
            match block_write(mount.device, table_block,
                              ext2_scratch_here().metadata as []u8) {
                BlockIoResult::Invalid => {
                    match ext2_bitmap_release(mount, true, bitmap_index) {
                        Ext2BitmapReleaseResult::Invalid => { }
                        Ext2BitmapReleaseResult::Released => { }
                    }
                    return Ext2InodeAllocResult::Failed;
                }
                BlockIoResult::Ok => {
                    return Ext2InodeAllocResult::Allocated(
                        ext2_inode_owner_new(
                            bitmap_index, inode_number, inode_number));
                }
            }
        }
    }
}

fn ext2_block_number(owner: borrow Ext2BlockOwner[block]) -> usize @ block {
    return owner.witness;
}

fn ext2_inode_number(owner: borrow Ext2InodeOwner[inode]) -> usize @ inode {
    return owner.witness;
}

fn ext2_release_block(mount: Ext2Mount,
                      owner: sink Ext2BlockOwner[block])
        -> Ext2OwnerReleaseResult {
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch_here().file[i] = 0; }
    match block_write(mount.device, owner.block_number,
                      ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_bitmap_release(mount, false, owner.bitmap_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2OwnerReleaseResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => {
            return Ext2OwnerReleaseResult::Released;
        }
    }
}

fn ext2_release_inode(mount: Ext2Mount,
                      owner: sink Ext2InodeOwner[inode])
        -> Ext2OwnerReleaseResult {
    let byte_offset: usize = owner.bitmap_index * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        table_offset > KERNEL_BLOCK_SIZE - 128) {
        return Ext2OwnerReleaseResult::Invalid;
    }
    match block_read(mount.device, table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_pointer: *u8 =
        (ext2_scratch_here().metadata as *u8) + (table_offset as isize);
    for i: isize in 0..<128 { inode_pointer[i] = 0; }
    match block_write(mount.device, table_block,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_bitmap_release(mount, true, owner.bitmap_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2OwnerReleaseResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => {
            return Ext2OwnerReleaseResult::Released;
        }
    }
}

fn ext2_owner_roundtrip_check(mount: Ext2Mount) -> Ext2BitmapProbeResult {
    match ext2_allocate_block(mount) {
        Ext2BlockAllocResult::Failed => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BlockAllocResult::Allocated(block_owner) => {
            let block_number: usize = ext2_block_number(block_owner);
            if (block_number == 0) {
                match ext2_release_block(mount, block_owner) {
                    Ext2OwnerReleaseResult::Invalid => { }
                    Ext2OwnerReleaseResult::Released => { }
                }
                return Ext2BitmapProbeResult::Invalid;
            }
            match ext2_allocate_inode(mount) {
                Ext2InodeAllocResult::Failed => {
                    match ext2_release_block(mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => { }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    return Ext2BitmapProbeResult::Invalid;
                }
                Ext2InodeAllocResult::Allocated(inode_owner) => {
                    let inode_number: usize = ext2_inode_number(inode_owner);
                    if (inode_number == 0) {
                        match ext2_release_inode(mount, inode_owner) {
                            Ext2OwnerReleaseResult::Invalid => { }
                            Ext2OwnerReleaseResult::Released => { }
                        }
                        match ext2_release_block(mount, block_owner) {
                            Ext2OwnerReleaseResult::Invalid => { }
                            Ext2OwnerReleaseResult::Released => { }
                        }
                        return Ext2BitmapProbeResult::Invalid;
                    }
                    match ext2_release_inode(mount, inode_owner) {
                        Ext2OwnerReleaseResult::Invalid => {
                            match ext2_release_block(mount, block_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            return Ext2BitmapProbeResult::Invalid;
                        }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    match ext2_release_block(mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => {
                            return Ext2BitmapProbeResult::Invalid;
                        }
                        Ext2OwnerReleaseResult::Released => {
                            return Ext2BitmapProbeResult::Verified;
                        }
                    }
                }
            }
        }
    }
}

// GitHub issue #537: the directory is a parameter, and its blocks are walked.
//
// Both of these used to read inode 2 by name and refuse a directory larger
// than one block, while `ext2_lookup_directory` next door already walked any
// directory across any number of blocks. So the kernel could find
// `/etc/init.sh` and could not create a file beside it.
//
// An ext2 directory entry never spans a block: each block is self-contained
// and its record lengths sum to exactly the block size. That is what makes
// this a per-block scan rather than a flat one over `size`, and it is why the
// modified block is the only one written back.
//
// Bounded by the direct blocks. When no block has room the directory grows by
// one, up to twelve; a directory past 12 KiB is refused rather than
// half-handled.
private fn ext2_directory_block_count(directory: Ext2Inode) -> usize {
    return directory.size / KERNEL_BLOCK_SIZE;
}

private fn ext2_directory_block_at(mount: Ext2Mount, directory: Ext2Inode,
                                   index: usize) -> usize {
    let block: usize = ext2_inode_block_pointer(mount, directory, index);
    if (block == 0 || block >= mount.filesystem_blocks) { return 0; }
    return block;
}

// A directory this code will mutate: a real directory, block-sized, and
// within the direct blocks.
private fn ext2_directory_mutable(directory: Ext2Inode) -> bool {
    return (directory.mode & 0xF000) == 0x4000 &&
           directory.size >= KERNEL_BLOCK_SIZE &&
           directory.size <= ext2_direct_file_size() &&
           directory.size % KERNEL_BLOCK_SIZE == 0;
}

// The allocation obligation ends here because the block is now named by a
// directory's i_block and its bitmap bit stays set: there is nothing left to
// release, and the directory, not this owner, is what holds it.
private fn ext2_block_owner_linked(owner: sink Ext2BlockOwner[block]) {}

// GitHub issue #537: the block a full directory grows into. It holds exactly
// one entry, the new one, whose record spans the whole block -- the shape
// ext2 requires of every block, whose record lengths sum to the block size.
//
// The block is written before the inode. Until the inode write lands, the old
// i_size is the only visible extent and the new block is merely allocated,
// which is the same order ext2_resize_small_file publishes in.
private fn ext2_directory_grow_publish(mount: Ext2Mount, directory: Ext2Inode,
                                       blocks: usize, block: usize,
                                       inode_number: usize, name: borrow []u8)
        -> Ext2DirectoryResult !{unsafe} {
    if (blocks >= EXT2_MAX_DIRECT_BLOCKS || name.len == 0 || name.len > 255) {
        return Ext2DirectoryResult::Invalid;
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch_here().file[i] = 0; }
    let base: *u8 = ext2_scratch_here().file as *u8;
    if (ext2_put_u32(base, 0, inode_number as u32) == false ||
        ext2_put_u16(base, 4, KERNEL_BLOCK_SIZE as u16) == false) {
        return Ext2DirectoryResult::Invalid;
    }
    base[6] = name.len as u8;
    base[7] = 0;
    let data = ext2_scratch_here().file as []u8;
    if (data.len < 8) { return Ext2DirectoryResult::Invalid; }
    let name_target = data[8..<data.len];
    if (name.len > name_target.len) { return Ext2DirectoryResult::Invalid; }
    slice_copy(name_target, name);
    match block_write(mount.device, block, ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }

    match block_read(mount.device, directory.table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_pointer: *u8 =
        (ext2_scratch_here().metadata as *u8) + (directory.table_offset as isize);
    let pointer_offset: usize = 40 + blocks * 4;
    let sectors: u32 = ext2_u32(inode_pointer, 28);
    // The slot past the last block must be empty, and the size on disk must
    // still be the one this walk was sized from: anything else means the
    // inode is not the directory that was just read.
    if (ext2_u32(inode_pointer, pointer_offset) != 0 ||
        ext2_u32(inode_pointer, 4) as usize != directory.size ||
        sectors > 0xFFFFFFFF - 2) {
        return Ext2DirectoryResult::Invalid;
    }
    // i_blocks counts 512-byte sectors, so one 1 KiB block is two.
    if (ext2_put_u32(inode_pointer, 4,
                     (directory.size + KERNEL_BLOCK_SIZE) as u32) == false ||
        ext2_put_u32(inode_pointer, 28, sectors + 2) == false ||
        ext2_put_u32(inode_pointer, pointer_offset, block as u32) == false) {
        return Ext2DirectoryResult::Invalid;
    }
    match block_write(mount.device, directory.table_block,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { return Ext2DirectoryResult::Updated; }
    }
}

// Every block was walked and none had room.
//
// Past twelve blocks, or on a volume with no free block, this still answers
// Invalid, and the caller cannot tell that from a malformed directory:
// Ext2DirectoryResult has two cases. mkdirat therefore answers EIO where
// Linux would answer ENOSPC; the case is worth adding with the first lane
// that fills a directory or a volume, since nothing exercises either.
private fn ext2_directory_grow(mount: Ext2Mount, directory: Ext2Inode,
                               blocks: usize, inode_number: usize,
                               name: borrow []u8) -> Ext2DirectoryResult !{unsafe} {
    if (blocks >= EXT2_MAX_DIRECT_BLOCKS) {
        return Ext2DirectoryResult::Invalid;
    }
    match ext2_allocate_block(mount) {
        Ext2BlockAllocResult::Failed => { return Ext2DirectoryResult::Invalid; }
        Ext2BlockAllocResult::Allocated(owner) => {
            match ext2_directory_grow_publish(mount, directory, blocks,
                                              owner.block_number,
                                              inode_number, name) {
                Ext2DirectoryResult::Invalid => {
                    match ext2_release_block(mount, owner) {
                        Ext2OwnerReleaseResult::Invalid => { }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    return Ext2DirectoryResult::Invalid;
                }
                Ext2DirectoryResult::Updated => {
                    ext2_block_owner_linked(owner);
                    return Ext2DirectoryResult::Updated;
                }
            }
        }
    }
}

fn ext2_directory_add(mount: Ext2Mount, directory_inode: usize,
                      inode_number: usize,
                      name: borrow []u8) -> Ext2DirectoryResult !{unsafe} {
    if (name.len == 0 || name.len > 255 || inode_number == 0 ||
        directory_inode == 0) {
        return Ext2DirectoryResult::Invalid;
    }
    match ext2_read_inode(mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if (ext2_directory_mutable(directory) == false) {
                return Ext2DirectoryResult::Invalid;
            }
            let needed: usize = (8 + name.len + 3) & 0xFFFFFFFFFFFFFFFC;
            let blocks: usize = ext2_directory_block_count(directory);
            for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                if (index >= blocks) { break; }
                let block: usize =
                    ext2_directory_block_at(mount, directory, index);
                if (block == 0) { return Ext2DirectoryResult::Invalid; }
                match block_read(mount.device, block,
                                 ext2_scratch_here().file as []u8) {
                    BlockIoResult::Invalid => {
                        return Ext2DirectoryResult::Invalid;
                    }
                    BlockIoResult::Ok => { }
                }
                let base: *u8 = ext2_scratch_here().file as *u8;
                let mut cursor: usize = 0;
                while (cursor < KERNEL_BLOCK_SIZE) {
                    if (cursor > KERNEL_BLOCK_SIZE - 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry: *u8 = base + (cursor as isize);
                    let entry_inode: usize = ext2_u32(entry, 0) as usize;
                    let record_length: usize = ext2_u16(entry, 4) as usize;
                    let name_length: usize = entry[6] as usize;
                    let mut actual: usize =
                        (8 + name_length + 3) & 0xFFFFFFFFFFFFFFFC;
                    if (record_length < 8 ||
                        record_length > KERNEL_BLOCK_SIZE - cursor ||
                        name_length > record_length - 8 ||
                        actual > record_length) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    // A dead record -- inode zero, left behind when the first
                    // entry of a block was removed -- holds no name, so the
                    // whole record is free and the new entry takes its place
                    // rather than splitting after a name that is not there.
                    if (entry_inode == 0) { actual = 0; }
                    if (record_length - actual >= needed) {
                        let new_offset: usize = cursor + actual;
                        let new_length: usize = record_length - actual;
                        let new_entry: *u8 = base + (new_offset as isize);
                        if ((actual != 0 &&
                             ext2_put_u16(entry, 4, actual as u16) == false) ||
                            ext2_put_u32(new_entry, 0, inode_number as u32) == false ||
                            ext2_put_u16(new_entry, 4, new_length as u16) == false) {
                            return Ext2DirectoryResult::Invalid;
                        }
                        new_entry[6] = name.len as u8;
                        new_entry[7] = 0;
                        let data = ext2_scratch_here().file as []u8;
                        if (new_offset > data.len) {
                            return Ext2DirectoryResult::Invalid;
                        }
                        let new_entry_bytes = data[new_offset..<data.len];
                        if (new_entry_bytes.len < 8) {
                            return Ext2DirectoryResult::Invalid;
                        }
                        let name_target =
                            new_entry_bytes[8..<new_entry_bytes.len];
                        if (name.len > name_target.len) {
                            return Ext2DirectoryResult::Invalid;
                        }
                        slice_copy(name_target, name);
                        match block_write(mount.device, block,
                                          ext2_scratch_here().file as []u8) {
                            BlockIoResult::Invalid => {
                                return Ext2DirectoryResult::Invalid;
                            }
                            BlockIoResult::Ok => {
                                return Ext2DirectoryResult::Updated;
                            }
                        }
                    }
                    cursor = cursor + record_length;
                }
            }
            return ext2_directory_grow(mount, directory, blocks,
                                       inode_number, name);
        }
    }
}

fn ext2_directory_remove(mount: Ext2Mount, directory_inode: usize,
                         inode_number: usize,
                         name: borrow []u8) -> Ext2DirectoryResult !{unsafe} {
    if (name.len == 0 || name.len > 255 || inode_number == 0 ||
        directory_inode == 0) {
        return Ext2DirectoryResult::Invalid;
    }
    match ext2_read_inode(mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if (ext2_directory_mutable(directory) == false) {
                return Ext2DirectoryResult::Invalid;
            }
            let blocks: usize = ext2_directory_block_count(directory);
            for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                if (index >= blocks) { break; }
                let block: usize =
                    ext2_directory_block_at(mount, directory, index);
                if (block == 0) { return Ext2DirectoryResult::Invalid; }
                match block_read(mount.device, block,
                                 ext2_scratch_here().file as []u8) {
                    BlockIoResult::Invalid => {
                        return Ext2DirectoryResult::Invalid;
                    }
                    BlockIoResult::Ok => { }
                }
                let base: *u8 = ext2_scratch_here().file as *u8;
                let mut cursor: usize = 0;
                let mut previous: usize = 0;
                let mut has_previous: bool = false;
                while (cursor < KERNEL_BLOCK_SIZE) {
                    if (cursor > KERNEL_BLOCK_SIZE - 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry: *u8 = base + (cursor as isize);
                    let entry_inode: usize = ext2_u32(entry, 0) as usize;
                    let record_length: usize = ext2_u16(entry, 4) as usize;
                    let name_length: usize = entry[6] as usize;
                    if (record_length < 8 ||
                        record_length > KERNEL_BLOCK_SIZE - cursor ||
                        name_length > record_length - 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let data = ext2_scratch_here().file as []u8;
                    // Bound to an immutable let before comparing: narrowing
                    // is immutable-only, and `cursor` is the loop's own
                    // mutable position.
                    let entry_start: usize = cursor;
                    if (entry_start > data.len) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_tail = data[entry_start..<data.len];
                    if (record_length > entry_tail.len) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_bytes = entry_tail[0..<record_length];
                    if (entry_bytes.len < 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_payload = entry_bytes[8..<entry_bytes.len];
                    if (name_length > entry_payload.len) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_name = entry_payload[0..<name_length];
                    if (entry_inode == inode_number &&
                        ext2_name_matches(entry_name, name)) {
                        // The first entry of a block has no predecessor to
                        // absorb it, so it stays as a dead record -- inode
                        // zero, record length kept -- which lookup and
                        // getdents64 already skip and ext2_directory_add
                        // reuses. That is what Linux's ext2 does. Block 0
                        // opens with `.`, which is never removed by name.
                        if (has_previous == false) {
                            if (index == 0 ||
                                ext2_put_u32(entry, 0, 0) == false) {
                                return Ext2DirectoryResult::Invalid;
                            }
                            match block_write(mount.device, block,
                                              ext2_scratch_here().file as []u8) {
                                BlockIoResult::Invalid => {
                                    return Ext2DirectoryResult::Invalid;
                                }
                                BlockIoResult::Ok => {
                                    return Ext2DirectoryResult::Updated;
                                }
                            }
                        }
                        let previous_entry: *u8 = base + (previous as isize);
                        let previous_length: usize =
                            ext2_u16(previous_entry, 4) as usize;
                        if (previous_length > 0xFFFF - record_length ||
                            ext2_put_u16(previous_entry, 4,
                                         (previous_length + record_length) as u16) == false) {
                            return Ext2DirectoryResult::Invalid;
                        }
                        match block_write(mount.device, block,
                                          ext2_scratch_here().file as []u8) {
                            BlockIoResult::Invalid => {
                                return Ext2DirectoryResult::Invalid;
                            }
                            BlockIoResult::Ok => {
                                return Ext2DirectoryResult::Updated;
                            }
                        }
                    }
                    previous = cursor;
                    has_previous = true;
                    cursor = cursor + record_length;
                }
            }
        }
    }
    return Ext2DirectoryResult::Invalid;
}

// The live entries of a directory, across every block it occupies, with dead
// records skipped. It is the fixture's measure of "enumerated completely":
// a walk that stopped at the first block would undercount a grown directory.
fn ext2_directory_live_entries(mount: Ext2Mount, directory_inode: usize)
        -> Ext2CountResult !{unsafe} {
    match ext2_read_inode(mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2CountResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if (ext2_directory_mutable(directory) == false) {
                return Ext2CountResult::Invalid;
            }
            let blocks: usize = ext2_directory_block_count(directory);
            let mut live: usize = 0;
            for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                if (index >= blocks) { break; }
                let block: usize =
                    ext2_directory_block_at(mount, directory, index);
                if (block == 0) { return Ext2CountResult::Invalid; }
                match block_read(mount.device, block,
                                 ext2_scratch_here().file as []u8) {
                    BlockIoResult::Invalid => {
                        return Ext2CountResult::Invalid;
                    }
                    BlockIoResult::Ok => { }
                }
                let base: *u8 = ext2_scratch_here().file as *u8;
                let mut cursor: usize = 0;
                while (cursor < KERNEL_BLOCK_SIZE) {
                    if (cursor > KERNEL_BLOCK_SIZE - 8) {
                        return Ext2CountResult::Invalid;
                    }
                    let entry: *u8 = base + (cursor as isize);
                    let record_length: usize = ext2_u16(entry, 4) as usize;
                    let name_length: usize = entry[6] as usize;
                    if (record_length < 8 ||
                        record_length > KERNEL_BLOCK_SIZE - cursor ||
                        name_length > record_length - 8) {
                        return Ext2CountResult::Invalid;
                    }
                    if (ext2_u32(entry, 0) != 0) { live = live + 1; }
                    cursor = cursor + record_length;
                }
            }
            return Ext2CountResult::Counted(live);
        }
    }
}

fn ext2_initialize_regular_inode(mount: Ext2Mount,
                                 inode_owner: borrow Ext2InodeOwner[inode],
                                 block_owner: borrow Ext2BlockOwner[block],
                                 content: []u8)
        -> Ext2DirectoryResult !{unsafe} {
    if (content.len == 0 || content.len > KERNEL_BLOCK_SIZE) {
        return Ext2DirectoryResult::Invalid;
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch_here().file[i] = 0; }
    let data = ext2_scratch_here().file as []u8;
    slice_copy(data, content);
    match block_write(mount.device, block_owner.block_number,
                      ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }

    let byte_offset: usize = inode_owner.bitmap_index * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    match block_read(mount.device, table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_pointer: *u8 =
        (ext2_scratch_here().metadata as *u8) + (table_offset as isize);
    for i: isize in 0..<128 { inode_pointer[i] = 0; }
    if (ext2_put_u16(inode_pointer, 0, 0x81A4) == false ||
        ext2_put_u32(inode_pointer, 4, content.len as u32) == false ||
        ext2_put_u16(inode_pointer, 26, 1) == false ||
        ext2_put_u32(inode_pointer, 28, 2) == false ||
        ext2_put_u32(inode_pointer, 40,
                     block_owner.block_number as u32) == false) {
        return Ext2DirectoryResult::Invalid;
    }
    match block_write(mount.device, table_block,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { return Ext2DirectoryResult::Updated; }
    }
}

fn ext2_linked_file_new(block_owner: sink Ext2BlockOwner[block],
                         inode_owner: sink Ext2InodeOwner[inode])
        -> Ext2LinkedFile[inode, block] {
    let mut linked: Ext2LinkedFile[inode, block] = {
        inode_owner.bitmap_index, block_owner.bitmap_index,
        inode_owner.witness, block_owner.witness
    };
    return linked;
}

// GitHub issue #537: create in any directory the mount can reach. The root
// form below is this one with the root named, kept because most callers mean
// the root and should not have to say 2.
// The root, named once. EXT2_ROOT_INODE is 2 by the on-disk format, not by
// this kernel's choice.
const EXT2_ROOT_INODE: usize = 2;

fn ext2_create_root_file(mount: Ext2Mount, name: []u8, content: []u8)
        -> Ext2CreateResult {
    return ext2_create_file_in(mount, EXT2_ROOT_INODE, name, content);
}

fn ext2_unlink_root_file(mount: Ext2Mount,
                         linked: sink Ext2LinkedFile[inode, block],
                         name: []u8) -> Ext2UnlinkResult {
    return ext2_unlink_file_in(mount, EXT2_ROOT_INODE, linked, name);
}

fn ext2_create_file_in(mount: Ext2Mount, directory_inode: usize,
                       name: []u8, content: []u8) -> Ext2CreateResult {
    match ext2_lookup_directory(mount, directory_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2CreateResult::Invalid; }
        Ext2LookupResult::Found(existing) => { return Ext2CreateResult::Invalid; }
        Ext2LookupResult::NotFound => { }
    }
    match ext2_allocate_block(mount) {
        Ext2BlockAllocResult::Failed => { return Ext2CreateResult::Invalid; }
        Ext2BlockAllocResult::Allocated(block_owner) => {
            match ext2_allocate_inode(mount) {
                Ext2InodeAllocResult::Failed => {
                    match ext2_release_block(mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => { }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    return Ext2CreateResult::Invalid;
                }
                Ext2InodeAllocResult::Allocated(inode_owner) => {
                    match ext2_initialize_regular_inode(
                            mount, inode_owner, block_owner, content) {
                        Ext2DirectoryResult::Invalid => {
                            match ext2_release_inode(mount, inode_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            match ext2_release_block(mount, block_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            return Ext2CreateResult::Invalid;
                        }
                        Ext2DirectoryResult::Updated => { }
                    }
                    match ext2_directory_add(
                            mount, directory_inode,
                            inode_owner.inode_number, name) {
                        Ext2DirectoryResult::Invalid => {
                            match ext2_release_inode(mount, inode_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            match ext2_release_block(mount, block_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            return Ext2CreateResult::Invalid;
                        }
                        Ext2DirectoryResult::Updated => {
                            return Ext2CreateResult::Created(
                                ext2_linked_file_new(block_owner, inode_owner));
                        }
                    }
                }
            }
        }
    }
}

fn ext2_unlink_file_in(mount: Ext2Mount, directory_inode: usize,
                       linked: sink Ext2LinkedFile[inode, block],
                       name: []u8) -> Ext2UnlinkResult {
    let inode_number: usize = linked.inode_number;
    let inode_owner = ext2_inode_owner_new(
        linked.inode_bitmap_index, inode_number, linked.inode_number);
    let block_owner = ext2_block_owner_new(
        linked.block_bitmap_index, linked.block_number, linked.block_number);
    let mut directory_ok: bool = false;
    match ext2_directory_remove(mount, directory_inode, inode_number, name) {
        Ext2DirectoryResult::Invalid => { }
        Ext2DirectoryResult::Updated => { directory_ok = true; }
    }
    let mut inode_ok: bool = false;
    match ext2_release_inode(mount, inode_owner) {
        Ext2OwnerReleaseResult::Invalid => { }
        Ext2OwnerReleaseResult::Released => { inode_ok = true; }
    }
    let mut block_ok: bool = false;
    match ext2_release_block(mount, block_owner) {
        Ext2OwnerReleaseResult::Invalid => { }
        Ext2OwnerReleaseResult::Released => { block_ok = true; }
    }
    if (directory_ok && inode_ok && block_ok) {
        return Ext2UnlinkResult::Unlinked;
    }
    return Ext2UnlinkResult::Invalid;
}

// GitHub issue #537: nested directories.
//
// A new directory's block holds `.` naming itself and `..` naming its
// parent, and the second record spans the rest of the block. Its inode
// starts with two links -- the parent's entry and its own `.` -- and the
// parent gains one, for the new directory's `..`. The group descriptor's
// used-directories count moves with them; e2fsck's pass 5 compares it.
private fn ext2_initialize_directory(mount: Ext2Mount, inode_number: usize,
                                     block: usize, parent_inode: usize)
        -> Ext2DirectoryResult !{unsafe} {
    if (inode_number == 0 || parent_inode == 0 ||
        inode_number > mount.inode_count) {
        return Ext2DirectoryResult::Invalid;
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch_here().file[i] = 0; }
    let base: *u8 = ext2_scratch_here().file as *u8;
    let parent_entry: *u8 = base + 12;
    if (ext2_put_u32(base, 0, inode_number as u32) == false ||
        ext2_put_u16(base, 4, 12) == false ||
        ext2_put_u32(parent_entry, 0, parent_inode as u32) == false ||
        ext2_put_u16(parent_entry, 4,
                     (KERNEL_BLOCK_SIZE - 12) as u16) == false) {
        return Ext2DirectoryResult::Invalid;
    }
    base[6] = 1;
    base[8] = 0x2E;
    parent_entry[6] = 2;
    parent_entry[8] = 0x2E;
    parent_entry[9] = 0x2E;
    match block_write(mount.device, block, ext2_scratch_here().file as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }

    let byte_offset: usize = (inode_number - 1) * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        table_offset > KERNEL_BLOCK_SIZE - 128) {
        return Ext2DirectoryResult::Invalid;
    }
    match block_read(mount.device, table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_pointer: *u8 =
        (ext2_scratch_here().metadata as *u8) + (table_offset as isize);
    for i: isize in 0..<128 { inode_pointer[i] = 0; }
    if (ext2_put_u16(inode_pointer, 0, 0x41ED) == false ||
        ext2_put_u32(inode_pointer, 4, KERNEL_BLOCK_SIZE as u32) == false ||
        ext2_put_u16(inode_pointer, 26, 2) == false ||
        ext2_put_u32(inode_pointer, 28, 2) == false ||
        ext2_put_u32(inode_pointer, 40, block as u32) == false) {
        return Ext2DirectoryResult::Invalid;
    }
    match block_write(mount.device, table_block,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { return Ext2DirectoryResult::Updated; }
    }
}

private fn ext2_write_inode_links(mount: Ext2Mount, parent: Ext2Inode,
                                  links: usize) -> Ext2DirectoryResult {
    match block_read(mount.device, parent.table_block,
                     ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_pointer: *u8 =
        (ext2_scratch_here().metadata as *u8) + (parent.table_offset as isize);
    if (ext2_put_u16(inode_pointer, 26, links as u16) == false) {
        return Ext2DirectoryResult::Invalid;
    }
    match block_write(mount.device, parent.table_block,
                      ext2_scratch_here().metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        BlockIoResult::Ok => { return Ext2DirectoryResult::Updated; }
    }
}

// The parent's link count and the group's used-directories count, both by
// one, in that order. If the second write fails the first is put back, so a
// failure leaves neither moved.
private fn ext2_adjust_parent_links(mount: Ext2Mount, parent_inode: usize,
                                    increment: bool) -> Ext2DirectoryResult {
    match ext2_read_inode(mount, parent_inode) {
        Ext2InodeResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        Ext2InodeResult::Inode(parent) => {
            // 32000 is ext2's own EXT2_LINK_MAX; a directory's own `.` and
            // its entry in its parent mean it never has fewer than two.
            if ((parent.mode & 0xF000) != 0x4000 ||
                (increment && parent.links >= 32000) ||
                (increment == false && parent.links <= 2)) {
                return Ext2DirectoryResult::Invalid;
            }
            let mut links: usize = parent.links - 1;
            if (increment) { links = parent.links + 1; }
            match ext2_write_inode_links(mount, parent, links) {
                Ext2DirectoryResult::Invalid => {
                    return Ext2DirectoryResult::Invalid;
                }
                Ext2DirectoryResult::Updated => { }
            }
            let mut counted: bool = false;
            match block_read(mount.device, 2,
                             ext2_scratch_here().file as []u8) {
                BlockIoResult::Invalid => { }
                BlockIoResult::Ok => {
                    let group: *u8 = ext2_scratch_here().file as *u8;
                    let used: usize = ext2_u16(group, 16) as usize;
                    if ((increment && used < 0xFFFF) ||
                        (increment == false && used > 0)) {
                        let mut next: usize = used - 1;
                        if (increment) { next = used + 1; }
                        if (ext2_put_u16(group, 16, next as u16)) {
                            match block_write(mount.device, 2,
                                              ext2_scratch_here().file as []u8) {
                                BlockIoResult::Invalid => { }
                                BlockIoResult::Ok => { counted = true; }
                            }
                        }
                    }
                }
            }
            if (counted) { return Ext2DirectoryResult::Updated; }
            match ext2_write_inode_links(mount, parent, parent.links) {
                Ext2DirectoryResult::Invalid => { }
                Ext2DirectoryResult::Updated => { }
            }
            return Ext2DirectoryResult::Invalid;
        }
    }
}

private fn ext2_link_new_directory(mount: Ext2Mount, parent_inode: usize,
                                   inode_number: usize, block: usize,
                                   name: borrow []u8)
        -> Ext2DirectoryResult !{unsafe} {
    match ext2_initialize_directory(mount, inode_number, block, parent_inode) {
        Ext2DirectoryResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        Ext2DirectoryResult::Updated => { }
    }
    match ext2_directory_add(mount, parent_inode, inode_number, name) {
        Ext2DirectoryResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        Ext2DirectoryResult::Updated => { }
    }
    match ext2_adjust_parent_links(mount, parent_inode, true) {
        Ext2DirectoryResult::Updated => { return Ext2DirectoryResult::Updated; }
        Ext2DirectoryResult::Invalid => {
            match ext2_directory_remove(mount, parent_inode, inode_number,
                                        name) {
                Ext2DirectoryResult::Invalid => { }
                Ext2DirectoryResult::Updated => { }
            }
            return Ext2DirectoryResult::Invalid;
        }
    }
}

private fn ext2_linked_directory_new(block_owner: sink Ext2BlockOwner[block],
                                     inode_owner: sink Ext2InodeOwner[inode])
        -> Ext2LinkedDirectory[inode, block] {
    let mut linked: Ext2LinkedDirectory[inode, block] = {
        inode_owner.bitmap_index, block_owner.bitmap_index,
        inode_owner.witness, block_owner.witness
    };
    return linked;
}

fn ext2_linked_directory_inode(linked: borrow Ext2LinkedDirectory[inode, block])
        -> usize @ inode {
    return linked.inode_number;
}

// A directory that stays. The tree names its inode and block from here on,
// so the obligation ends without a release -- the directory counterpart of a
// file that is never unlinked.
fn ext2_directory_keep(linked: sink Ext2LinkedDirectory[inode, block]) {}

fn ext2_inode_links(mount: Ext2Mount, inode_number: usize) -> usize {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => { return inode.links; }
    }
}

fn ext2_make_directory_in(mount: Ext2Mount, parent_inode: usize,
                          name: borrow []u8) -> Ext2MkdirResult {
    match ext2_lookup_directory(mount, parent_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2MkdirResult::Invalid; }
        Ext2LookupResult::Found(existing) => { return Ext2MkdirResult::Invalid; }
        Ext2LookupResult::NotFound => { }
    }
    match ext2_allocate_block(mount) {
        Ext2BlockAllocResult::Failed => { return Ext2MkdirResult::Invalid; }
        Ext2BlockAllocResult::Allocated(block_owner) => {
            match ext2_allocate_inode(mount) {
                Ext2InodeAllocResult::Failed => {
                    match ext2_release_block(mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => { }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    return Ext2MkdirResult::Invalid;
                }
                Ext2InodeAllocResult::Allocated(inode_owner) => {
                    match ext2_link_new_directory(
                            mount, parent_inode, inode_owner.inode_number,
                            block_owner.block_number, name) {
                        Ext2DirectoryResult::Invalid => {
                            match ext2_release_inode(mount, inode_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            match ext2_release_block(mount, block_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            return Ext2MkdirResult::Invalid;
                        }
                        Ext2DirectoryResult::Updated => {
                            return Ext2MkdirResult::Created(
                                ext2_linked_directory_new(block_owner,
                                                          inode_owner));
                        }
                    }
                }
            }
        }
    }
}

// Everything short of releasing: the directory must be the one-block
// directory this owner made, it must hold nothing but `.` and `..`, and its
// entry must come out of the parent. Nothing is written before the last of
// those, so Refused and NotEmpty leave the tree exactly as it was.
private fn ext2_rmdir_unlink_entry(mount: Ext2Mount, parent_inode: usize,
                                   inode_number: usize, block_number: usize,
                                   name: borrow []u8)
        -> Ext2RmdirStep !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2RmdirStep::Refused; }
        Ext2InodeResult::Inode(directory) => {
            if ((directory.mode & 0xF000) != 0x4000 ||
                directory.size != KERNEL_BLOCK_SIZE ||
                directory.direct_block0 != block_number) {
                return Ext2RmdirStep::Refused;
            }
        }
    }
    match ext2_directory_live_entries(mount, inode_number) {
        Ext2CountResult::Invalid => { return Ext2RmdirStep::Refused; }
        Ext2CountResult::Counted(live) => {
            if (live != 2) { return Ext2RmdirStep::NotEmpty; }
        }
    }
    match ext2_directory_remove(mount, parent_inode, inode_number, name) {
        Ext2DirectoryResult::Invalid => { return Ext2RmdirStep::Refused; }
        Ext2DirectoryResult::Updated => { return Ext2RmdirStep::Unlinked; }
    }
}

// The directory is unreachable once its entry is gone, so from here on
// releasing is the only way forward, and every step is attempted even when
// an earlier one failed.
private fn ext2_rmdir_release(mount: Ext2Mount, parent_inode: usize,
                              linked: sink Ext2LinkedDirectory[inode, block])
        -> Ext2RmdirResult {
    let inode_owner = ext2_inode_owner_new(
        linked.inode_bitmap_index, linked.inode_number, linked.inode_number);
    let block_owner = ext2_block_owner_new(
        linked.block_bitmap_index, linked.block_number, linked.block_number);
    let mut links_ok: bool = false;
    match ext2_adjust_parent_links(mount, parent_inode, false) {
        Ext2DirectoryResult::Invalid => { }
        Ext2DirectoryResult::Updated => { links_ok = true; }
    }
    let mut inode_ok: bool = false;
    match ext2_release_inode(mount, inode_owner) {
        Ext2OwnerReleaseResult::Invalid => { }
        Ext2OwnerReleaseResult::Released => { inode_ok = true; }
    }
    let mut block_ok: bool = false;
    match ext2_release_block(mount, block_owner) {
        Ext2OwnerReleaseResult::Invalid => { }
        Ext2OwnerReleaseResult::Released => { block_ok = true; }
    }
    if (links_ok && inode_ok && block_ok) { return Ext2RmdirResult::Removed; }
    return Ext2RmdirResult::Invalid;
}

private fn ext2_linked_directory_mint(inode_bitmap_index: usize,
                                      block_bitmap_index: usize,
                                      inode_number: usize @ inode,
                                      block_number: usize @ block)
        -> Ext2LinkedDirectory[inode, block] {
    let mut linked: Ext2LinkedDirectory[inode, block] = {
        inode_bitmap_index, block_bitmap_index, inode_number, block_number
    };
    return linked;
}

// GitHub issue #538: the owner of a directory made earlier and kept.
// ext2_directory_keep ended that directory's obligation when it was made, so
// a later rmdir has nothing to hand in; this mints the owner again from the
// tree -- the entry in the parent and the inode it names. `.` and `..` are
// refused here rather than only by the caller: minting an owner for `..`
// would hand a removal the parent's own parent.
//
// Minting from the tree is sound only while one core at a time reaches ext2
// mutation: two claims of the same entry would be two owners of one block.
// kernel/CONCURRENCY.md's admission rule is what holds that today -- every
// process that reaches the filesystem is admitted to core 0 only -- and it is
// a claim about admission that nothing here can check.
fn ext2_claim_directory(mount: Ext2Mount, parent_inode: usize,
                        name: borrow []u8) -> Ext2ClaimResult !{unsafe} {
    if (name.len == 0) { return Ext2ClaimResult::Invalid; }
    if (name.len == 1) {
        if (name[0] == 0x2E) { return Ext2ClaimResult::Invalid; }
    }
    if (name.len == 2) {
        if (name[0] == 0x2E && name[1] == 0x2E) {
            return Ext2ClaimResult::Invalid;
        }
    }
    match ext2_lookup_directory(mount, parent_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2ClaimResult::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2ClaimResult::NotFound; }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_read_inode(mount, inode_number) {
                Ext2InodeResult::Invalid => { return Ext2ClaimResult::Invalid; }
                Ext2InodeResult::Inode(directory) => {
                    if ((directory.mode & 0xF000) != 0x4000) {
                        return Ext2ClaimResult::NotDirectory;
                    }
                    let block_number: usize = directory.direct_block0;
                    if (inode_number < 2 || block_number < 2) {
                        return Ext2ClaimResult::Invalid;
                    }
                    return Ext2ClaimResult::Claimed(ext2_linked_directory_mint(
                        inode_number - 1, block_number - 1,
                        inode_number, block_number));
                }
            }
        }
    }
}

// GitHub issue #538: unlink by name, for a file the syscall layer reaches.
// Such a file has no owner to hand in -- it came from the image or from a
// call that ended its owner -- so the owners of its blocks and inode are
// minted from the tree here, under the same one-core-at-a-time claim
// ext2_claim_directory states.
//
// A file with more than one link loses the entry and one link, which is what
// removing a BusyBox applet name is. The last link releases the data blocks
// and the inode. Their pointers are read before anything is written, because
// once the inode is released they read as zero.
//
// A symlink, or the last link of a file reaching an indirect block, is
// Unsupported: releasing those is more code than any caller asks for yet.
fn ext2_unlink_name(mount: Ext2Mount, parent_inode: usize,
                    name: borrow []u8) -> Ext2UnlinkNameResult !{unsafe} {
    if (name.len == 0) { return Ext2UnlinkNameResult::Invalid; }
    if (name.len == 1) {
        if (name[0] == 0x2E) { return Ext2UnlinkNameResult::IsDirectory; }
    }
    if (name.len == 2) {
        if (name[0] == 0x2E && name[1] == 0x2E) {
            return Ext2UnlinkNameResult::IsDirectory;
        }
    }
    let mut inode_number: usize = 0;
    match ext2_lookup_directory(mount, parent_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2UnlinkNameResult::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2UnlinkNameResult::NotFound; }
        Ext2LookupResult::Found(found) => { inode_number = found; }
    }
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2UnlinkNameResult::Invalid; }
        Ext2InodeResult::Inode(file) => {
            if ((file.mode & 0xF000) == 0x4000) {
                return Ext2UnlinkNameResult::IsDirectory;
            }
            if ((file.mode & 0xF000) != 0x8000) {
                return Ext2UnlinkNameResult::Unsupported;
            }
            if (file.links == 0 || inode_number < 2) {
                return Ext2UnlinkNameResult::Invalid;
            }
            // A file that keeps another link keeps its blocks, so its size
            // is no reason to refuse -- removing a BusyBox applet name is a
            // 1 MiB file losing one of its links.
            if (file.links > 1) {
                match ext2_directory_remove(mount, parent_inode, inode_number,
                                            name) {
                    Ext2DirectoryResult::Invalid => {
                        return Ext2UnlinkNameResult::Invalid;
                    }
                    Ext2DirectoryResult::Updated => { }
                }
                match ext2_write_inode_links(mount, file, file.links - 1) {
                    Ext2DirectoryResult::Invalid => {
                        return Ext2UnlinkNameResult::Invalid;
                    }
                    Ext2DirectoryResult::Updated => {
                        return Ext2UnlinkNameResult::Unlinked;
                    }
                }
            }
            if (file.size > ext2_direct_file_size()) {
                return Ext2UnlinkNameResult::Unsupported;
            }
            let blocks: usize =
                (file.size + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
            let mut pointers: [usize; EXT2_MAX_DIRECT_BLOCKS];
            for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                pointers[index] = 0;
                if (index < blocks) {
                    let block: usize =
                        ext2_inode_block_pointer(mount, file, index);
                    if (block < 2 || block >= mount.filesystem_blocks) {
                        return Ext2UnlinkNameResult::Invalid;
                    }
                    pointers[index] = block;
                }
            }
            match ext2_directory_remove(mount, parent_inode, inode_number,
                                        name) {
                Ext2DirectoryResult::Invalid => {
                    return Ext2UnlinkNameResult::Invalid;
                }
                Ext2DirectoryResult::Updated => { }
            }
            // The entry is gone and it was the last one, so releasing is the
            // only way forward: every step is attempted.
            let mut released: bool = true;
            for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                if (index < blocks) {
                    let block: usize = pointers[index];
                    match ext2_release_block(
                            mount, ext2_block_owner_new(block - 1, block,
                                                        block)) {
                        Ext2OwnerReleaseResult::Invalid => { released = false; }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                }
            }
            match ext2_release_inode(
                    mount, ext2_inode_owner_new(inode_number - 1, inode_number,
                                                inode_number)) {
                Ext2OwnerReleaseResult::Invalid => { released = false; }
                Ext2OwnerReleaseResult::Released => { }
            }
            if (released) { return Ext2UnlinkNameResult::Unlinked; }
            return Ext2UnlinkNameResult::Invalid;
        }
    }
}

fn ext2_remove_directory_in(mount: Ext2Mount, parent_inode: usize,
                            linked: sink Ext2LinkedDirectory[inode, block],
                            name: borrow []u8) -> Ext2RmdirResult {
    match ext2_rmdir_unlink_entry(mount, parent_inode, linked.inode_number,
                                  linked.block_number, name) {
        Ext2RmdirStep::Refused => { return Ext2RmdirResult::Refused(linked); }
        Ext2RmdirStep::NotEmpty => { return Ext2RmdirResult::NotEmpty(linked); }
        Ext2RmdirStep::Unlinked => {
            return ext2_rmdir_release(mount, parent_inode, linked);
        }
    }
}

// The two block-sized buffers are per-core, so independent cores neither
// serialize slow block I/O nor parse each other's results. One core still
// relies on non-preemptible kernel execution: re-entering ext2 before the
// current operation returns would overwrite that core's own staging blocks.
fn ext2_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "per-core ext2 scratch cannot survive kernel preemption into another ext2 operation");
}
