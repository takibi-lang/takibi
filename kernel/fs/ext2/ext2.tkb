use "kernel/drivers/block/memory.tkb";

const EXT2_SUPERBLOCK_BLOCK: usize = 1;
const EXT2_MAGIC: u16 = 0xEF53;

private let mut ext2_metadata_block: [u8; KERNEL_BLOCK_SIZE];
private let mut ext2_file_block: [u8; KERNEL_BLOCK_SIZE];

struct Ext2Mount {
    private device: KernelBlockDevice;
    private inode_count: usize;
    private filesystem_blocks: usize;
    private inodes_per_group: usize;
    private inode_size: usize;
    private inode_table_block: usize;
}

must_use variant Ext2MountResult { Invalid; Mounted(Ext2Mount); }
must_use variant Ext2InodeResult { Invalid; Inode(Ext2Inode); }
must_use variant Ext2LookupResult { Invalid; NotFound; Found(usize); }
must_use variant Ext2ReadResult { Invalid; Read(usize); }
must_use variant Ext2WriteResult { Invalid; Written; }
must_use variant Ext2ResizeResult { Invalid; Resized; }
must_use variant Ext2SymlinkResult { Invalid; Read(usize); }

struct Ext2Inode {
    private mode: usize;
    private size: usize;
    private direct_block0: usize;
    private table_block: usize;
    private table_offset: usize;
}

fn ext2_u16(bytes: borrow *u8, offset: usize) -> u16 {
    if (offset > KERNEL_BLOCK_SIZE - 2) { return 0; }
    return (bytes[offset as isize] as u16) |
           ((bytes[(offset + 1) as isize] as u16) << 8);
}

fn ext2_u32(bytes: borrow *u8, offset: usize) -> u32 {
    if (offset > KERNEL_BLOCK_SIZE - 4) { return 0; }
    return (bytes[offset as isize] as u32) |
           ((bytes[(offset + 1) as isize] as u32) << 8) |
           ((bytes[(offset + 2) as isize] as u32) << 16) |
           ((bytes[(offset + 3) as isize] as u32) << 24);
}

fn ext2_put_u32(bytes: borrow *u8, offset: usize, value: u32) -> bool {
    if (offset > KERNEL_BLOCK_SIZE - 4) { return false; }
    bytes[offset as isize] = (value & 0xFF) as u8;
    bytes[(offset + 1) as isize] = ((value >> 8) & 0xFF) as u8;
    bytes[(offset + 2) as isize] = ((value >> 16) & 0xFF) as u8;
    bytes[(offset + 3) as isize] = ((value >> 24) & 0xFF) as u8;
    return true;
}

fn ext2_mount(device: KernelBlockDevice) -> Ext2MountResult {
    match block_read(device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_metadata_block as []u8) {
        BlockIoResult::Invalid => { return Ext2MountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let superblock: *u8 = ext2_metadata_block as *u8;
    let inode_count: usize = ext2_u32(superblock, 0) as usize;
    let filesystem_blocks: usize = ext2_u32(superblock, 4) as usize;
    let first_data_block: usize = ext2_u32(superblock, 20) as usize;
    let log_block_size: usize = ext2_u32(superblock, 24) as usize;
    let blocks_per_group: usize = ext2_u32(superblock, 32) as usize;
    let inodes_per_group: usize = ext2_u32(superblock, 40) as usize;
    let magic: u16 = ext2_u16(superblock, 56);
    let revision: usize = ext2_u32(superblock, 76) as usize;
    let inode_size: usize = ext2_u16(superblock, 88) as usize;
    let feature_compat: usize = ext2_u32(superblock, 92) as usize;
    let feature_incompat: usize = ext2_u32(superblock, 96) as usize;
    let feature_ro_compat: usize = ext2_u32(superblock, 100) as usize;

    if (magic != EXT2_MAGIC || inode_count == 0 ||
        filesystem_blocks == 0 || filesystem_blocks > block_count(device) ||
        first_data_block != 1 || log_block_size != 0 ||
        blocks_per_group == 0 || inodes_per_group == 0 ||
        revision != 1 || inode_size != 128 ||
        feature_compat != 0 || feature_incompat != 0 ||
        feature_ro_compat != 0) {
        return Ext2MountResult::Invalid;
    }
    match block_read(device, 2, ext2_metadata_block as []u8) {
        BlockIoResult::Invalid => { return Ext2MountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_table_block: usize =
        ext2_u32(ext2_metadata_block as *u8, 8) as usize;
    if (inode_table_block == 0 || inode_table_block >= filesystem_blocks) {
        return Ext2MountResult::Invalid;
    }
    let mut mount: Ext2Mount = {
        device, inode_count, filesystem_blocks, inodes_per_group, inode_size,
        inode_table_block
    };
    return Ext2MountResult::Mounted(mount);
}

fn ext2_fixture_geometry_is_expected(mount: Ext2Mount) -> bool {
    return mount.inode_count == 128 && mount.filesystem_blocks == 1024 &&
           mount.inodes_per_group == 128 && mount.inode_size == 128;
}

fn ext2_read_inode(mount: Ext2Mount, inode_number: usize)
        -> Ext2InodeResult {
    if (inode_number == 0 || inode_number > mount.inode_count ||
        inode_number > mount.inodes_per_group) {
        return Ext2InodeResult::Invalid;
    }
    let inode_index: usize = inode_number - 1;
    let byte_offset: usize = inode_index * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        offset > KERNEL_BLOCK_SIZE - 128) {
        return Ext2InodeResult::Invalid;
    }
    match block_read(mount.device, table_block,
                     ext2_metadata_block as []u8) {
        BlockIoResult::Invalid => { return Ext2InodeResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_bytes: *u8 =
        (ext2_metadata_block as *u8) + (offset as isize);
    let mode: usize = ext2_u16(inode_bytes, 0) as usize;
    let size: usize = ext2_u32(inode_bytes, 4) as usize;
    let direct_block0: usize = ext2_u32(inode_bytes, 40) as usize;
    let file_type: usize = mode & 0xF000;
    if (mode == 0 || size > KERNEL_BLOCK_SIZE ||
        (file_type != 0x8000 && file_type != 0x4000 && file_type != 0xA000) ||
        ((file_type == 0x8000 || file_type == 0x4000) &&
         (direct_block0 == 0 || direct_block0 >= mount.filesystem_blocks)) ||
        (file_type == 0xA000 && size > 60)) {
        return Ext2InodeResult::Invalid;
    }
    let mut inode: Ext2Inode = {
        mode, size, direct_block0, table_block, offset
    };
    return Ext2InodeResult::Inode(inode);
}

fn ext2_name_matches(entry: borrow *u8, entry_length: usize,
                     name: []u8) -> bool !{unsafe} {
    if (entry_length != name.len || entry_length > 255) { return false; }
    let entry_name = unsafe { entry[0..<entry_length as isize] };
    return slice_eq(entry_name, name);
}

fn ext2_lookup_root(mount: Ext2Mount, name: []u8)
        -> Ext2LookupResult !{unsafe} {
    if (name.len == 0 || name.len > 255) {
        return Ext2LookupResult::Invalid;
    }
    match ext2_read_inode(mount, 2) {
        Ext2InodeResult::Invalid => { return Ext2LookupResult::Invalid; }
        Ext2InodeResult::Inode(root) => {
            if ((root.mode & 0xF000) != 0x4000 || root.size < 8) {
                return Ext2LookupResult::Invalid;
            }
            match block_read(mount.device, root.direct_block0,
                             ext2_file_block as []u8) {
                BlockIoResult::Invalid => { return Ext2LookupResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let base: *u8 = ext2_file_block as *u8;
            let mut cursor: usize = 0;
            while (cursor < root.size) {
                if (cursor > root.size - 8) {
                    return Ext2LookupResult::Invalid;
                }
                let entry: *u8 = base + (cursor as isize);
                let inode_number: usize = ext2_u32(entry, 0) as usize;
                let record_length: usize = ext2_u16(entry, 4) as usize;
                let name_length: usize = entry[6] as usize;
                if (record_length < 8 || record_length > root.size - cursor ||
                    name_length > record_length - 8) {
                    return Ext2LookupResult::Invalid;
                }
                if (inode_number != 0 &&
                    ext2_name_matches(entry + 8, name_length, name)) {
                    return Ext2LookupResult::Found(inode_number);
                }
                cursor = cursor + record_length;
            }
        }
    }
    return Ext2LookupResult::NotFound;
}

fn ext2_read_small_file(mount: Ext2Mount, inode_number: usize,
                        destination: []u8)
        -> Ext2ReadResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000 ||
                inode.size > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            match block_read(mount.device, inode.direct_block0,
                             ext2_file_block as []u8) {
                BlockIoResult::Invalid => { return Ext2ReadResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let source_pointer: *u8 = ext2_file_block as *u8;
            let source = unsafe { source_pointer[0..<inode.size as isize] };
            let target = unsafe { destination[0..<inode.size] };
            slice_copy(target, source);
            return Ext2ReadResult::Read(inode.size);
        }
    }
}

fn ext2_write_small_file(mount: Ext2Mount, inode_number: usize,
                         source: []u8)
        -> Ext2WriteResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2WriteResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            // This first mutation contract overwrites one already allocated
            // direct block without changing i_size. Allocation and truncate
            // become necessary only when a real caller requests them.
            if ((inode.mode & 0xF000) != 0x8000 ||
                source.len != inode.size) {
                return Ext2WriteResult::Invalid;
            }
            for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_file_block[i] = 0; }
            let file_bytes = ext2_file_block as []u8;
            let target = unsafe { file_bytes[0..<inode.size] };
            slice_copy(target, source);
            match block_write(mount.device, inode.direct_block0,
                              ext2_file_block as []u8) {
                BlockIoResult::Invalid => { return Ext2WriteResult::Invalid; }
                BlockIoResult::Ok => { return Ext2WriteResult::Written; }
            }
        }
    }
}

fn ext2_resize_small_file(mount: Ext2Mount, inode_number: usize,
                          source: []u8)
        -> Ext2ResizeResult !{unsafe} {
    if (source.len == 0 || source.len > KERNEL_BLOCK_SIZE) {
        return Ext2ResizeResult::Invalid;
    }
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ResizeResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000) {
                return Ext2ResizeResult::Invalid;
            }

            // Publish data first. Until the inode table write succeeds, the
            // old i_size remains the only visible extent.
            for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_file_block[i] = 0; }
            let file_bytes = ext2_file_block as []u8;
            let target = unsafe { file_bytes[0..<source.len] };
            slice_copy(target, source);
            match block_write(mount.device, inode.direct_block0,
                              ext2_file_block as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { }
            }

            match block_read(mount.device, inode.table_block,
                             ext2_metadata_block as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let inode_pointer: *u8 =
                (ext2_metadata_block as *u8) + (inode.table_offset as isize);
            if (ext2_put_u32(inode_pointer, 4, source.len as u32) == false) {
                return Ext2ResizeResult::Invalid;
            }
            match block_write(mount.device, inode.table_block,
                              ext2_metadata_block as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { return Ext2ResizeResult::Resized; }
            }
        }
    }
}

fn ext2_read_fast_symlink(mount: Ext2Mount, inode_number: usize,
                          destination: []u8)
        -> Ext2SymlinkResult !{unsafe} {
    match ext2_read_inode(mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2SymlinkResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0xA000 || inode.size > 60 ||
                inode.size > destination.len) {
                return Ext2SymlinkResult::Invalid;
            }
            match block_read(mount.device, inode.table_block,
                             ext2_metadata_block as []u8) {
                BlockIoResult::Invalid => { return Ext2SymlinkResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let inode_pointer: *u8 =
                (ext2_metadata_block as *u8) + (inode.table_offset as isize);
            let inline_target: *u8 = inode_pointer + 40;
            let source = unsafe { inline_target[0..<inode.size as isize] };
            let target = unsafe { destination[0..<inode.size] };
            slice_copy(target, source);
            return Ext2SymlinkResult::Read(inode.size);
        }
    }
}
