use "kernel/drivers/block/memory.tkb";
use "kernel/fs/ext2/mutation_lock.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/byte_slice.tkb";
use "kernel/lib/atomic_word.tkb";
use "kernel/kernel/cpu_authority.tkb";

const EXT2_SUPERBLOCK_BLOCK: usize = 1;
const EXT2_MAGIC: u16 = 0xEF53;
// i_block[0..11] are direct pointers; i_block[12] and i_block[13] are
// singly/doubly indirect. Regular-file capacity is derived from geometry.
const EXT2_MAX_DIRECT_BLOCKS: usize = 12;
const EXT2_MAX_SINGLE_FILE_BLOCKS: usize =
    EXT2_MAX_DIRECT_BLOCKS + KERNEL_BLOCK_SIZE / 4;
const EXT2_MAX_WRITE_ALLOCATIONS: usize =
    EXT2_MAX_SINGLE_FILE_BLOCKS + 1;

fn ext2_pointer_count() -> usize { return KERNEL_BLOCK_SIZE / 4; }
fn ext2_direct_file_size() -> usize {
    return EXT2_MAX_DIRECT_BLOCKS * KERNEL_BLOCK_SIZE;
}
// GitHub issue #968: a directory grows through the direct blocks and then
// the singly-indirect block, which is 268 blocks (268 KiB) at 1 KiB blocks.
// Past that Linux would go on into the doubly-indirect block; this answers
// ENOSPC there instead.
fn ext2_max_directory_size() -> usize {
    return EXT2_MAX_SINGLE_FILE_BLOCKS * KERNEL_BLOCK_SIZE;
}
fn ext2_max_regular_file_size() -> usize {
    let pointers: usize = ext2_pointer_count();
    return (EXT2_MAX_DIRECT_BLOCKS + pointers + pointers * pointers) *
           KERNEL_BLOCK_SIZE;
}

// GitHub issue #638 option C: the scratch an ext2 operation holds, from its
// entry to its exit, across block I/O that may block. It is a pool of
// KERNEL_MAX_CORES slots, not per-CPU storage: an operation may sleep (or,
// once the kernel is preemptible, be preempted), and another operation on
// the same CPU must not find its buffers. A slot is reached only through an
// Ext2Slot, a linear token: ext2_slot_acquire hands out a free slot and
// ext2_slot_release consumes the token, so the compiler rejects an
// operation that forgets to release it, releases it twice, or keeps using
// it after the release. Static storage, not the kernel stack: two blocks
// plus the write rows per operation would be a large stack frame, and .bss
// is bounded at link time while stack use is not (DECISIONS.md).
//
// Trusted here, and only here (TRUSTED_BASE.md): ext2_slot_acquire returns a
// slot no other live Ext2Slot names. Its compare-exchange over
// ext2_slot_words is what makes that so; nothing checks it.
//
// Only the public entry points acquire, and no function in this file calls
// one of them, so an operation holds one slot at a time and the pool cannot
// run dry with every holder waiting for a second slot.
// scripts/check_slot_pool_entries.py enforces that.
//
// Current limitations (2026-10-17):
// - The pool has KERNEL_MAX_CORES slots. While KERNEL_PREEMPTIBLE is 0 and
//   block I/O waits by spinning, at most one operation per CPU is inside
//   ext2, so acquire never waits. Once an operation can sleep inside ext2,
//   a later one waits in ext2_slot_acquire for a release.
struct Ext2Scratch {
    metadata: [u8; KERNEL_BLOCK_SIZE];
    file: [u8; KERNEL_BLOCK_SIZE];
}

private let mut ext2_scratch: [Ext2Scratch; KERNEL_MAX_CORES];
private let mut ext2_write_blocks:
    [usize; KERNEL_MAX_CORES * EXT2_MAX_WRITE_ALLOCATIONS];
// 0 free, 1 held: one word per slot.
private let mut ext2_slot_words: [AtomicWord; KERNEL_MAX_CORES];

// `[unit]` is always 0: an owner needs a static parameter, and the slot's
// identity is its private index, which only this file reads.
linear struct Ext2Slot[unit: usize] {
    private index: {0..<KERNEL_MAX_CORES as usize};
}

// A free slot, waiting for one if every slot is held. The compare-exchange
// is an acquire, pairing with the release store in ext2_slot_release, so
// the previous holder's last scratch writes happen before this holder's
// first read.
private fn ext2_slot_acquire() -> Ext2Slot[0] !{may_block} {
    preempt_assert_blockable();
    let mut index: {0..<KERNEL_MAX_CORES as usize} = 0;
    let mut held: bool = false;
    while (held == false) {
        for i: usize in 0..<KERNEL_MAX_CORES {
            if (held == false &&
                atomic_word_compare_exchange(&ext2_slot_words[i], 0, 1)) {
                index = i;
                held = true;
            }
        }
    }
    let mut slot: Ext2Slot[0] = { index };
    return slot;
}

private fn ext2_slot_release(slot: sink Ext2Slot[0]) {
    atomic_word_store(&ext2_slot_words[slot.index], 0);
}

// A position in this operation's scratch: which buffer, and a byte offset into
// it. It replaces the raw *u8 into the buffers (#637 stage 3); every byte
// access goes through ext2_byte/ext2_set_byte, which bound the whole
// position (base plus offset) by the buffer, not only the offset.
struct Ext2Bytes {
    private in_file: bool;
    private base: usize;
}

private fn ext2_metadata() -> Ext2Bytes {
    let mut b: Ext2Bytes = { false, 0 };
    return b;
}

private fn ext2_file() -> Ext2Bytes {
    let mut b: Ext2Bytes = { true, 0 };
    return b;
}

// The position `offset` bytes past `b`. An offset past the buffer is kept
// as is: every access through the result is refused rather than wrapped.
private fn ext2_at(b: Ext2Bytes, offset: usize) -> Ext2Bytes {
    let mut moved: Ext2Bytes = { b.in_file, KERNEL_BLOCK_SIZE };
    if (offset < KERNEL_BLOCK_SIZE && b.base < KERNEL_BLOCK_SIZE) {
        moved.base = b.base + offset;
    }
    return moved;
}

// The byte at `offset` past `b`, or 0 outside the buffer.
private fn ext2_byte(slot: borrow Ext2Slot[0], b: Ext2Bytes,
        offset: usize) -> u8 {
    if (offset >= KERNEL_BLOCK_SIZE || b.base >= KERNEL_BLOCK_SIZE) { return 0; }
    let i: usize = b.base + offset;
    if (i < KERNEL_BLOCK_SIZE) {
        if (b.in_file) { return ext2_scratch[slot.index].file[i]; }
        return ext2_scratch[slot.index].metadata[i];
    }
    return 0;
}

// Stores the byte at `offset` past `b`; false outside the buffer.
private fn ext2_set_byte(slot: borrow Ext2Slot[0], b: Ext2Bytes, offset: usize,
                         value: u8) -> bool {
    if (offset >= KERNEL_BLOCK_SIZE || b.base >= KERNEL_BLOCK_SIZE) { return false; }
    let i: usize = b.base + offset;
    if (i < KERNEL_BLOCK_SIZE) {
        if (b.in_file) { ext2_scratch[slot.index].file[i] = value; }
        else { ext2_scratch[slot.index].metadata[i] = value; }
        return true;
    }
    return false;
}

// Whether `width` bytes at `offset` past `b` lie inside the buffer.
private fn ext2_fits(b: Ext2Bytes, offset: usize, width: usize) -> bool {
    return b.base < KERNEL_BLOCK_SIZE && offset < KERNEL_BLOCK_SIZE &&
           b.base + offset <= KERNEL_BLOCK_SIZE - width;
}

struct Ext2Mount {
    private device: KernelBlockDevice;
    private inode_count: usize;
    private filesystem_blocks: usize;
    private inodes_per_group: usize;
    private inode_size: usize;
    private inode_table_block: usize;
    private block_bitmap_block: usize;
    private inode_bitmap_block: usize;
}

must_use variant Ext2MountResult { Invalid; Mounted(Ext2Mount); }

// Total on-disk block count, including metadata, for exhaustion diagnostics.
fn ext2_block_capacity(mount: Ext2Mount) -> usize {
    return mount.filesystem_blocks;
}

// The device a mount reads, so the boot can say which one the root is on.
fn ext2_mount_device(mount: Ext2Mount) -> KernelBlockDevice {
    return mount.device;
}
must_use variant Ext2InodeResult { Invalid; Inode(Ext2Inode); }
must_use variant Ext2LookupResult { Invalid; NotFound; Found(usize); }
must_use variant Ext2ReadResult { Invalid; Read(usize); }
// NoSpace: allocation exhausted the block bitmap and rollback completed.
// Invalid: the mutation did not happen, and the repair writes that put the
// bitmaps and counters back all completed. Resized: it happened.
// Fenced: it could not be rolled back or finished and the counters could not
// be made to agree with the bitmaps, so the mount refuses every further write
// until ext2_recover establishes consistency (GitHub issue #595).
must_use variant Ext2ResizeResult { Invalid; NoSpace; Resized; Fenced; }
must_use variant Ext2RecoverResult { Failed; Recovered; }
must_use variant Ext2SymlinkResult { Invalid; Read(usize); }
must_use variant Ext2CounterResult { Invalid; Updated; }
must_use variant Ext2BitmapClaimResult { Invalid; Full; Claimed(usize); }
must_use variant Ext2BitmapReleaseResult { Invalid; Released; }
must_use variant Ext2BitmapProbeResult { Invalid; Verified; }
must_use variant Ext2FreeCountsResult {
    Invalid;
    Counts((usize, usize));
}

struct Ext2Inode {
    private mode: usize;
    private links: usize;
    private size: usize;
    private direct_block0: usize;
    private table_block: usize;
    private table_offset: usize;
}

linear struct Ext2BlockOwner[block: usize] {
    private bitmap_index: usize;
    private block_number: usize;
    private witness: usize @ block;
}

linear struct Ext2InodeOwner[inode: usize] {
    private bitmap_index: usize;
    private inode_number: usize;
    private witness: usize @ inode;
}

must_use variant Ext2BlockAllocResult {
    Failed;
    NoSpace;
    Allocated(exists block: usize. Ext2BlockOwner[block]);
}

// NoSpace: the inode bitmap had no clear bit; nothing was written.
must_use variant Ext2InodeAllocResult {
    Failed;
    NoSpace;
    Allocated(exists inode: usize. Ext2InodeOwner[inode]);
}

must_use variant Ext2OwnerReleaseResult { Invalid; Released; }
must_use variant Ext2DirectoryResult { Invalid; Updated; }
// What adding a name can answer (GitHub issue #698). NoSpace: the directory
// had to grow and could not -- either the block bitmap had no clear bit, or
// the directory already holds EXT2_MAX_DIRECT_BLOCKS blocks, the
// representational limit of this implementation (Linux would chain an
// indirect block). Neither writes anything.
must_use variant Ext2DirectoryAddResult { Invalid; NoSpace; Updated; }

// A write keeps every new data block (and, when needed, the indirect block)
// here until its inode has been published. One linear obligation owns the
// runtime-sized prefix; its plain block numbers are never owners by themselves.
private linear struct Ext2WriteAllocations[unit: usize] {
    private count: usize;
}

must_use variant Ext2WriteRecordResult {
    Full(Ext2WriteAllocations[0]);
    Recorded(Ext2WriteAllocations[0]);
}

must_use variant Ext2WriteFinishResult { Invalid; Finished; }

linear struct Ext2LinkedFile[inode: usize, block: usize] {
    private inode_bitmap_index: usize;
    private block_bitmap_index: usize;
    private inode_number: usize @ inode;
    private block_number: usize @ block;
}

// NoSpace (GitHub issue #698): a block, an inode or room in the directory
// could not be had. Everything claimed on the way was released and the
// directory is unchanged.
must_use variant Ext2CreateResult {
    Invalid;
    NoSpace;
    Created(exists inode: usize. exists block: usize.
            Ext2LinkedFile[inode, block]);
}

must_use variant Ext2UnlinkResult { Invalid; Unlinked; }
must_use variant Ext2CountResult { Invalid; Counted(usize); }

// A directory made by ext2_make_directory_in. It is a distinct type from
// Ext2LinkedFile on purpose: removing a directory also returns the parent's
// link count and the group's directory count, so handing one to the regular
// file unlink would leave both wrong -- and that is now a type error.
linear struct Ext2LinkedDirectory[inode: usize, block: usize] {
    private inode_bitmap_index: usize;
    private block_bitmap_index: usize;
    private inode_number: usize @ inode;
    private block_number: usize @ block;
}

// NoSpace: as for Ext2CreateResult; the parent's links and the group's
// directory count are unchanged as well.
must_use variant Ext2MkdirResult {
    Invalid;
    NoSpace;
    Created(exists inode: usize. exists block: usize.
            Ext2LinkedDirectory[inode, block]);
}

// NotEmpty and Refused hand the directory back: it is still linked, so its
// owner is still owed to somebody. Invalid means removal started and could
// not finish, and the owner was spent trying.
must_use variant Ext2RmdirResult {
    Invalid;
    Removed;
    NotEmpty(exists inode: usize. exists block: usize.
             Ext2LinkedDirectory[inode, block]);
    Refused(exists inode: usize. exists block: usize.
            Ext2LinkedDirectory[inode, block]);
}

must_use variant Ext2RmdirStep { Refused; NotEmpty; Empty(Ext2Inode); }

must_use variant Ext2UnlinkNameResult {
    Invalid;
    NotFound;
    IsDirectory;
    Unsupported;
    Unlinked;
}

must_use variant Ext2RenameResult {
    Invalid;
    NoSpace;
    NotFound;
    IsDirectory;
    NotDirectory;
    Unsupported;
    Renamed;
}

must_use variant Ext2ClaimResult {
    Invalid;
    NotFound;
    NotDirectory;
    Claimed(exists inode: usize. exists block: usize.
            Ext2LinkedDirectory[inode, block]);
}

// Boundary probe for the boot fixture (#637 ext2 audit item 3). A field
// ending exactly at the buffer's end is accepted; one byte further is
// refused; and an interior base whose offset crosses the end is refused.
// The pre-#637 check bounded only the offset past an interior pointer
// (`offset > KERNEL_BLOCK_SIZE - width`); with that check this probe fails
// (verified once by mutation, recorded on #637), so it guards against a
// regression to that form.
fn ext2_bytes_boundary_probe() -> bool {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: bool = ext2_bytes_boundary_probe_with(slot);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_bytes_boundary_probe_with(slot: borrow Ext2Slot[0]) -> bool {
    let end: usize = KERNEL_BLOCK_SIZE;
    let mut whole: Ext2Bytes = ext2_file();
    let mut interior: Ext2Bytes = ext2_at(ext2_file(), end - 2);
    let at_end: bool = ext2_fits(whole, end - 4, 4);
    let one_past: bool = ext2_fits(whole, end - 3, 4);
    let crossing: bool = ext2_fits(interior, 0, 4);
    let byte_past: u8 = ext2_byte(slot, interior, 2);
    let store_past: bool = ext2_set_byte(slot, interior, 2, 0x5A);
    return at_end && one_past == false && crossing == false &&
           byte_past == 0 &&
           store_past == false && ext2_u32(slot, interior, 0) == 0;
}

fn ext2_u16(slot: borrow Ext2Slot[0], bytes: Ext2Bytes, offset: usize) -> u16 {
    if (ext2_fits(bytes, offset, 2) == false) { return 0; }
    return (ext2_byte(slot, bytes, offset) as u16) |
           ((ext2_byte(slot, bytes, offset + 1) as u16) << 8);
}

fn ext2_u32(slot: borrow Ext2Slot[0], bytes: Ext2Bytes, offset: usize) -> u32 {
    if (ext2_fits(bytes, offset, 4) == false) { return 0; }
    return (ext2_byte(slot, bytes, offset) as u32) |
           ((ext2_byte(slot, bytes, offset + 1) as u32) << 8) |
           ((ext2_byte(slot, bytes, offset + 2) as u32) << 16) |
           ((ext2_byte(slot, bytes, offset + 3) as u32) << 24);
}

fn ext2_put_u32(slot: borrow Ext2Slot[0], bytes: Ext2Bytes, offset: usize,
        value: u32) -> bool {
    if (ext2_fits(bytes, offset, 4) == false) { return false; }
    return ext2_set_byte(slot, bytes, offset, (value & 0xFF) as u8) &&
           ext2_set_byte(slot, bytes, offset + 1,
                   ((value >> 8) & 0xFF) as u8) &&
           ext2_set_byte(slot, bytes, offset + 2,
                   ((value >> 16) & 0xFF) as u8) &&
           ext2_set_byte(slot, bytes, offset + 3, ((value >> 24) & 0xFF) as u8);
}

fn ext2_put_u16(slot: borrow Ext2Slot[0], bytes: Ext2Bytes, offset: usize,
        value: u16) -> bool {
    if (ext2_fits(bytes, offset, 2) == false) { return false; }
    return ext2_set_byte(slot, bytes, offset, (value & 0xFF) as u8) &&
           ext2_set_byte(slot, bytes, offset + 1, ((value >> 8) & 0xFF) as u8);
}

// Little-endian fields of a directory entry already copied into a slice
// (the getdents path); 0 when the field does not fit.
fn ext2_slice_u16(bytes: borrow []const u8, offset: usize) -> u16 {
    // One width check proves both reads (#798, path facts).
    if (offset >= bytes.len || bytes.len - offset < 2) { return 0; }
    return (bytes[offset] as u16) | ((bytes[offset + 1] as u16) << 8);
}

fn ext2_slice_u32(bytes: borrow []const u8, offset: usize) -> u32 {
    // One width check proves all four reads (#798, path facts).
    if (offset >= bytes.len || bytes.len - offset < 4) { return 0; }
    return (bytes[offset] as u32) | ((bytes[offset + 1] as u32) << 8) |
           ((bytes[offset + 2] as u32) << 16) | ((bytes[offset + 3] as u32) << 24);
}

fn ext2_mount(device: KernelBlockDevice) -> Ext2MountResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2MountResult = ext2_mount_with(slot, device);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_mount_with(slot: borrow Ext2Slot[0],
        device: KernelBlockDevice) -> Ext2MountResult {
    match block_read(device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2MountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut superblock: Ext2Bytes = ext2_metadata();
    let inode_count: usize = ext2_u32(slot, superblock, 0) as usize;
    let filesystem_blocks: usize = ext2_u32(slot, superblock, 4) as usize;
    let first_data_block: usize = ext2_u32(slot, superblock, 20) as usize;
    let log_block_size: usize = ext2_u32(slot, superblock, 24) as usize;
    let blocks_per_group: usize = ext2_u32(slot, superblock, 32) as usize;
    let inodes_per_group: usize = ext2_u32(slot, superblock, 40) as usize;
    let magic: u16 = ext2_u16(slot, superblock, 56);
    let revision: usize = ext2_u32(slot, superblock, 76) as usize;
    let inode_size: usize = ext2_u16(slot, superblock, 88) as usize;
    let feature_compat: usize = ext2_u32(slot, superblock, 92) as usize;
    let feature_incompat: usize = ext2_u32(slot, superblock, 96) as usize;
    let feature_ro_compat: usize = ext2_u32(slot, superblock, 100) as usize;

    if (magic != EXT2_MAGIC || inode_count == 0 ||
        filesystem_blocks == 0 || filesystem_blocks > block_count(device) ||
        first_data_block != 1 || log_block_size != 0 ||
        blocks_per_group == 0 || inodes_per_group == 0 ||
        revision != 1 || inode_size != 128 ||
        feature_compat != 0 || feature_incompat != 0 ||
        feature_ro_compat != 0) {
        return Ext2MountResult::Invalid;
    }
    match block_read(device, 2, ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2MountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let inode_table_block: usize =
        ext2_u32(slot, ext2_metadata(), 8) as usize;
    let block_bitmap_block: usize =
        ext2_u32(slot, ext2_metadata(), 0) as usize;
    let inode_bitmap_block: usize =
        ext2_u32(slot, ext2_metadata(), 4) as usize;
    if (inode_table_block == 0 || inode_table_block >= filesystem_blocks ||
        block_bitmap_block == 0 || block_bitmap_block >= filesystem_blocks ||
        inode_bitmap_block == 0 || inode_bitmap_block >= filesystem_blocks) {
        return Ext2MountResult::Invalid;
    }
    let mut mount: Ext2Mount = {
        device, inode_count, filesystem_blocks, inodes_per_group, inode_size,
        inode_table_block, block_bitmap_block, inode_bitmap_block
    };
    return Ext2MountResult::Mounted(mount);
}

fn ext2_fixture_geometry_is_expected(mount: Ext2Mount) -> bool {
    return mount.inode_count == 1024 && mount.filesystem_blocks == 6144 &&
           mount.inodes_per_group == 1024 && mount.inode_size == 128;
}

fn ext2_read_inode(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_number: usize)
        -> Ext2InodeResult {
    if (inode_number == 0 || inode_number > mount.inode_count ||
        inode_number > mount.inodes_per_group) {
        return Ext2InodeResult::Invalid;
    }
    let inode_index: usize = inode_number - 1;
    let byte_offset: usize = inode_index * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        offset > KERNEL_BLOCK_SIZE - 128) {
        return Ext2InodeResult::Invalid;
    }
    match block_read(mount.device, table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2InodeResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut inode_bytes: Ext2Bytes =
        ext2_at(ext2_metadata(), offset);
    let mode: usize = ext2_u16(slot, inode_bytes, 0) as usize;
    let links: usize = ext2_u16(slot, inode_bytes, 26) as usize;
    let size: usize = ext2_u32(slot, inode_bytes, 4) as usize;
    let direct_block0: usize = ext2_u32(slot, inode_bytes, 40) as usize;
    let indirect_block: usize = ext2_u32(slot, inode_bytes, 88) as usize;
    let double_indirect_block: usize = ext2_u32(slot, inode_bytes, 92) as usize;
    let file_type: usize = mode & 0xF000;
    // Regular files and directories may span their direct block pointers.
    // Symlinks retain the inline fast-symlink limit.
    let mut max_size: usize = KERNEL_BLOCK_SIZE;
    if (file_type == 0x8000) { max_size = ext2_max_regular_file_size(); }
    if (file_type == 0x4000) { max_size = ext2_max_directory_size(); }
    if (mode == 0 || size > max_size ||
        (file_type != 0x8000 && file_type != 0x4000 && file_type != 0xA000) ||
        (file_type == 0x4000 &&
         (direct_block0 == 0 || direct_block0 >= mount.filesystem_blocks)) ||
        (file_type == 0x4000 && size > ext2_direct_file_size() &&
         (indirect_block == 0 || indirect_block >= mount.filesystem_blocks)) ||
        // A regular file may be sparse (#1087): any pointer may be a hole,
        // and a pointer that is not one must name a block.
        (file_type == 0x8000 &&
         (direct_block0 >= mount.filesystem_blocks ||
          indirect_block >= mount.filesystem_blocks ||
          double_indirect_block >= mount.filesystem_blocks)) ||
        (file_type == 0xA000 && size > 60)) {
        return Ext2InodeResult::Invalid;
    }
    let mut inode: Ext2Inode = {
        mode, links, size, direct_block0, table_block, offset
    };
    return Ext2InodeResult::Inode(inode);
}

fn ext2_name_matches(entry_name: borrow []const u8, name: borrow []const u8) -> bool {
    if (entry_name.len != name.len || entry_name.len > 255) { return false; }
    return slice_eq(entry_name, name);
}

fn ext2_lookup_directory(mount: Ext2Mount, directory_inode: usize,
                         name: borrow []const u8) -> Ext2LookupResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2LookupResult = ext2_lookup_directory_with(slot, mount,
            directory_inode, name);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_lookup_directory_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, directory_inode: usize,
                         name: borrow []const u8) -> Ext2LookupResult !{unsafe} {
    if (name.len == 0 || name.len > 255) {
        return Ext2LookupResult::Invalid;
    }
    match ext2_read_inode(slot, mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2LookupResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if ((directory.mode & 0xF000) != 0x4000 ||
                directory.size < 8 || directory.size > ext2_max_directory_size()) {
                return Ext2LookupResult::Invalid;
            }
            let mut cursor: usize = 0;
            while (cursor < directory.size) {
                if (cursor > directory.size - 8) {
                    return Ext2LookupResult::Invalid;
                }
                let block_offset: usize = cursor % KERNEL_BLOCK_SIZE;
                if (block_offset == 0) {
                    match block_read(mount.device,
                                     ext2_inode_block_pointer(slot, 
                                         mount, directory,
                                         cursor / KERNEL_BLOCK_SIZE),
                                     ext2_scratch[slot.index].file as []u8) {
                        BlockIoResult::Invalid => {
                            return Ext2LookupResult::Invalid;
                        }
                        BlockIoResult::Ok => { }
                    }
                }
                let mut entry: Ext2Bytes = ext2_at(ext2_file(), block_offset);
                let inode_number: usize = ext2_u32(slot, entry, 0) as usize;
                let record_length: usize = ext2_u16(slot, entry, 4) as usize;
                let name_length: usize = ext2_byte(slot, entry, 6) as usize;
                if (record_length < 8 || record_length > directory.size - cursor ||
                    record_length > KERNEL_BLOCK_SIZE - block_offset ||
                    name_length > record_length - 8) {
                    return Ext2LookupResult::Invalid;
                }
                let file_bytes = ext2_scratch[slot.index].file as []u8;
                if (block_offset > file_bytes.len) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_tail =
                    file_bytes[block_offset..<file_bytes.len];
                if (record_length > entry_tail.len) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_bytes = entry_tail[0..<record_length];
                if (entry_bytes.len < 8) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_payload = entry_bytes[8..<entry_bytes.len];
                if (name_length > entry_payload.len) {
                    return Ext2LookupResult::Invalid;
                }
                let entry_name = entry_payload[0..<name_length];
                if (inode_number != 0 &&
                    ext2_name_matches(entry_name, name)) {
                    return Ext2LookupResult::Found(inode_number);
                }
                cursor = cursor + record_length;
            }
        }
    }
    return Ext2LookupResult::NotFound;
}

fn ext2_lookup_root(mount: Ext2Mount, name: []const u8)
        -> Ext2LookupResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2LookupResult = ext2_lookup_root_with(slot, mount, name);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_lookup_root_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        name: []const u8)
        -> Ext2LookupResult !{unsafe} {
    return ext2_lookup_directory_with(slot, mount, 2, name);
}

fn ext2_lookup_path_from(mount: Ext2Mount, start_inode: usize, name: borrow []const u8)
        -> Ext2LookupResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2LookupResult = ext2_lookup_path_from_with(slot, mount,
            start_inode, name);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_lookup_path_from_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, start_inode: usize, name: borrow []const u8)
        -> Ext2LookupResult !{unsafe} {
    if (name.len == 0 || name.len > 255) {
        return Ext2LookupResult::Invalid;
    }
    if (name.len == 1) {
        if (name[0] == 0x2E) {
            return Ext2LookupResult::Found(start_inode);
        }
    }
    let mut current_inode: usize = start_inode;
    let mut cursor: usize = 0;
    while (cursor < name.len) {
        let component_start: usize = cursor;
        if (component_start > name.len) {
            return Ext2LookupResult::Invalid;
        }
        let name_tail = name[component_start..<name.len];
        let mut component_length: usize = name_tail.len;
        match byte_slice_find_first(name_tail, 0x2F) {
            ByteSliceFindResult::Absent => {}
            ByteSliceFindResult::Found(position) => {
                component_length = position;
            }
        }
        if (component_length == 0) {
            return Ext2LookupResult::Invalid;
        }
        if (component_length > name_tail.len) {
            return Ext2LookupResult::Invalid;
        }
        let component = name_tail[0..<component_length];
        cursor = component_start + component_length;
        if (component.len == 1) {
            if (component[0] == 0x2E) {
                if (cursor < name.len) { cursor = cursor + 1; }
                continue;
            }
        }
        // `..` is not special-cased: every ext2 directory carries its own
        // `..` entry naming its parent, and the root's names the root. This
        // used to answer the root for every `..`, which was right only while
        // no directory was nested deeper than one level (GitHub issue #537).
        match ext2_lookup_directory_with(slot, mount, current_inode,
                component) {
            Ext2LookupResult::Invalid => { return Ext2LookupResult::Invalid; }
            Ext2LookupResult::NotFound => { return Ext2LookupResult::NotFound; }
            Ext2LookupResult::Found(inode) => { current_inode = inode; }
        }
        if (cursor < name.len) {
            cursor = cursor + 1;
            if (cursor == name.len) {
                return Ext2LookupResult::Invalid;
            }
        }
    }
    return Ext2LookupResult::Found(current_inode);
}

fn ext2_lookup_path(mount: Ext2Mount, name: borrow []const u8)
        -> Ext2LookupResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2LookupResult = ext2_lookup_path_with(slot, mount, name);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_lookup_path_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        name: borrow []const u8)
        -> Ext2LookupResult !{unsafe} {
    return ext2_lookup_path_from_with(slot, mount, 2, name);
}

// GitHub issue #1087: a pointer of 0 is a hole, which reads as zeros, and
// is told apart from a failed read or an out-of-range pointer.
must_use variant Ext2PointerResult { Invalid; Hole; Block(usize); }

private fn ext2_pointer_entry(mount: Ext2Mount, block: usize)
        -> Ext2PointerResult {
    if (block == 0) { return Ext2PointerResult::Hole; }
    if (block < 2 || block >= mount.filesystem_blocks) {
        return Ext2PointerResult::Invalid;
    }
    return Ext2PointerResult::Block(block);
}

// Resolve a regular file's i_block[index]. The inode table is re-read on
// every call rather than trusting a copy held here; since GitHub issue #208
// the block layer's cache answers those re-reads, so they cost a copy rather
// than a device round trip. Direct entries
// reside at byte 40; i_block[12] at byte 88 names a singly-indirect block
// of 256 little-endian u32 entries. Invalid for an out-of-range index or
// pointer, or any failed metadata read; Hole for a pointer of 0 at any
// level.
fn ext2_file_block_lookup(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode: Ext2Inode, index: usize) -> Ext2PointerResult {
    let pointers: usize = ext2_pointer_count();
    if (pointers == 0) { return Ext2PointerResult::Invalid; }
    if (index >= EXT2_MAX_DIRECT_BLOCKS + pointers + pointers * pointers) {
        return Ext2PointerResult::Invalid;
    }
    match block_read(mount.device, inode.table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2PointerResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut inode_pointer: Ext2Bytes =
        ext2_at(ext2_metadata(), inode.table_offset);
    if (index < EXT2_MAX_DIRECT_BLOCKS) {
        return ext2_pointer_entry(mount,
                ext2_u32(slot, inode_pointer, 40 + index * 4) as usize);
    }
    let single_index: usize = index - EXT2_MAX_DIRECT_BLOCKS;
    let indirect_block: usize = ext2_u32(slot, inode_pointer, 88) as usize;
    if (single_index < pointers) {
        if (indirect_block == 0) { return Ext2PointerResult::Hole; }
        if (indirect_block < 2 || indirect_block >= mount.filesystem_blocks) {
            return Ext2PointerResult::Invalid;
        }
        match block_read(mount.device, indirect_block,
                         ext2_scratch[slot.index].file as []u8) {
            BlockIoResult::Invalid => { return Ext2PointerResult::Invalid; }
            BlockIoResult::Ok => { }
        }
        return ext2_pointer_entry(mount, ext2_u32(slot, ext2_file(),
                        single_index * 4) as usize);
    }
    let double_block: usize = ext2_u32(slot, inode_pointer, 92) as usize;
    if (double_block == 0) { return Ext2PointerResult::Hole; }
    if (double_block < 2 || double_block >= mount.filesystem_blocks) {
        return Ext2PointerResult::Invalid;
    }
    let double_index: usize = single_index - pointers;
    match block_read(mount.device, double_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2PointerResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let second_level: usize = ext2_u32(slot, 
        ext2_metadata(), (double_index / pointers) * 4) as usize;
    if (second_level == 0) { return Ext2PointerResult::Hole; }
    if (second_level < 2 || second_level >= mount.filesystem_blocks) {
        return Ext2PointerResult::Invalid;
    }
    match block_read(mount.device, second_level,
                     ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return Ext2PointerResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    return ext2_pointer_entry(mount, ext2_u32(slot, ext2_file(),
                    (double_index % pointers) * 4) as usize);
}

// The block i_block[index] names, 0 for a hole or a failed read: the
// directory walks, which have no holes, treat both as a bad directory.
fn ext2_inode_block_pointer(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode: Ext2Inode, index: usize) -> usize {
    match ext2_file_block_lookup(slot, mount, inode, index) {
        Ext2PointerResult::Invalid => { return 0; }
        Ext2PointerResult::Hole => { return 0; }
        Ext2PointerResult::Block(block) => { return block; }
    }
}

// Regular file block BLOCK_INDEX into the file buffer: its bytes, or
// zeros for a hole (#1087). False on a bad pointer or a failed read.
private fn ext2_file_block_fill(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode: Ext2Inode, block_index: usize) -> bool !{unsafe} {
    match ext2_file_block_lookup(slot, mount, inode, block_index) {
        Ext2PointerResult::Invalid => { return false; }
        Ext2PointerResult::Hole => {
            for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                ext2_scratch[slot.index].file[byte] = 0;
            }
            return true;
        }
        Ext2PointerResult::Block(block) => {
            match block_read(mount.device, block,
                             ext2_scratch[slot.index].file as []u8) {
                BlockIoResult::Invalid => { return false; }
                BlockIoResult::Ok => { return true; }
            }
        }
    }
}

fn ext2_read_small_file(mount: Ext2Mount, inode_number: usize,
                        destination: []u8)
        -> Ext2ReadResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ReadResult = ext2_read_small_file_with(slot, mount,
            inode_number, destination);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_read_small_file_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                        destination: []u8)
        -> Ext2ReadResult !{unsafe} {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000 ||
                inode.size > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            let block_count: usize =
                (inode.size + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
            let mut copied: usize = 0;
            for block_index: usize in 0..<block_count {
                if (ext2_file_block_fill(slot, mount, inode, block_index) ==
                        false) {
                    return Ext2ReadResult::Invalid;
                }
                let mut chunk: usize = KERNEL_BLOCK_SIZE;
                if (inode.size - copied < chunk) { chunk = inode.size - copied; }
                let file_bytes = ext2_scratch[slot.index].file as []u8;
                if (chunk > file_bytes.len) {
                    return Ext2ReadResult::Invalid;
                }
                let source = file_bytes[0..<chunk];
                let destination_start: usize = copied;
                if (destination_start > destination.len) {
                    return Ext2ReadResult::Invalid;
                }
                let target =
                    destination[destination_start..<destination.len];
                if (source.len > target.len) {
                    return Ext2ReadResult::Invalid;
                }
                slice_copy(target, source);
                copied = copied + chunk;
            }
            return Ext2ReadResult::Read(inode.size);
        }
    }
}

// Read at most one filesystem block at `offset` into `destination`. This is
// deliberately separate from ext2_read_small_file(): syscall read paths must
// not need a kernel buffer as large as the whole file. Callers repeat this
// operation and copy each bounded block into the user buffer, like a VFS
// page-cache/buffer-cache read path does on larger kernels.
// The USB backend supports bounded multi-sector transfers, but this API
// intentionally remains one-block-at-a-time: a larger read would need to
// prove contiguous physical ext2 block pointers and retain a correspondingly
// large scratch buffer. The ext2 write paths publish one inode after staging
// data and pointer blocks; their allocations are not generally contiguous,
// so there is no safe block-device range to coalesce.
//
// The supported range is derived from the 12 direct pointers and the
// single- and double-indirect pointer fanout of this filesystem's block size.
// Triple-indirect traversal remains outside the present rootfs requirement.
fn ext2_read_file_chunk(mount: Ext2Mount, inode_number: usize,
                        offset: usize, destination: borrow uninit []u8)
        -> Ext2ReadResult !{unsafe}
        ensures match result { Ext2ReadResult::Read(n) => init(destination[0..<n]),
                               Ext2ReadResult::Invalid => true } {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ReadResult = ext2_read_file_chunk_with(slot, mount,
            inode_number, offset, destination);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_read_file_chunk_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                        offset: usize, destination: borrow uninit []u8)
        -> Ext2ReadResult !{unsafe}
        ensures match result { Ext2ReadResult::Read(n) => init(destination[0..<n]),
                               Ext2ReadResult::Invalid => true } {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000 ||
                inode.size > ext2_max_regular_file_size()) {
                return Ext2ReadResult::Invalid;
            }
            if (offset >= inode.size || destination.len == 0) {
                return Ext2ReadResult::Read(0);
            }
            let block_index: usize = offset / KERNEL_BLOCK_SIZE;
            let block_offset: usize = offset % KERNEL_BLOCK_SIZE;
            if (ext2_file_block_fill(slot, mount, inode, block_index) ==
                    false) {
                return Ext2ReadResult::Invalid;
            }
            let mut chunk: usize = destination.len;
            if (chunk > KERNEL_BLOCK_SIZE - block_offset) {
                chunk = KERNEL_BLOCK_SIZE - block_offset;
            }
            if (chunk > inode.size - offset) {
                chunk = inode.size - offset;
            }
            let file_bytes = ext2_scratch[slot.index].file as []u8;
            if (block_offset > file_bytes.len) {
                return Ext2ReadResult::Invalid;
            }
            let source_tail = file_bytes[block_offset..<file_bytes.len];
            if (chunk > source_tail.len) {
                return Ext2ReadResult::Invalid;
            }
            let source = source_tail[0..<chunk];
            if (chunk > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            // GitHub issue #975: the copied count, which the checks above
            // make equal to chunk, is what the ensures clause names.
            let copied: usize = slice_copy(destination, source);
            return Ext2ReadResult::Read(copied);
        }
    }
}

fn ext2_read_directory_chunk(mount: Ext2Mount, inode_number: usize,
                             offset: usize, destination: borrow uninit []u8)
        -> Ext2ReadResult !{unsafe}
        ensures match result { Ext2ReadResult::Read(n) => init(destination[0..<n]),
                               Ext2ReadResult::Invalid => true } {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ReadResult = ext2_read_directory_chunk_with(slot, mount,
            inode_number, offset, destination);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_read_directory_chunk_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                             offset: usize, destination: borrow uninit []u8)
        -> Ext2ReadResult !{unsafe}
        ensures match result { Ext2ReadResult::Read(n) => init(destination[0..<n]),
                               Ext2ReadResult::Invalid => true } {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ReadResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x4000 ||
                inode.size > ext2_max_directory_size()) {
                return Ext2ReadResult::Invalid;
            }
            if (offset >= inode.size || destination.len == 0) {
                return Ext2ReadResult::Read(0);
            }
            let block_index: usize = offset / KERNEL_BLOCK_SIZE;
            let block_offset: usize = offset % KERNEL_BLOCK_SIZE;
            let block_number: usize =
                ext2_inode_block_pointer(slot, mount, inode, block_index);
            if (block_number == 0 || block_number >= mount.filesystem_blocks) {
                return Ext2ReadResult::Invalid;
            }
            match block_read(mount.device, block_number,
                             ext2_scratch[slot.index].file as []u8) {
                BlockIoResult::Invalid => { return Ext2ReadResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let mut chunk: usize = destination.len;
            if (chunk > KERNEL_BLOCK_SIZE - block_offset) {
                chunk = KERNEL_BLOCK_SIZE - block_offset;
            }
            if (chunk > inode.size - offset) {
                chunk = inode.size - offset;
            }
            let file_bytes = ext2_scratch[slot.index].file as []u8;
            if (block_offset > file_bytes.len) {
                return Ext2ReadResult::Invalid;
            }
            let source_tail = file_bytes[block_offset..<file_bytes.len];
            if (chunk > source_tail.len) {
                return Ext2ReadResult::Invalid;
            }
            let source = source_tail[0..<chunk];
            if (chunk > destination.len) {
                return Ext2ReadResult::Invalid;
            }
            // GitHub issue #975: the copied count, which the checks above
            // make equal to chunk, is what the ensures clause names.
            let copied: usize = slice_copy(destination, source);
            return Ext2ReadResult::Read(copied);
        }
    }
}

fn ext2_inode_is_symlink(mount: Ext2Mount, inode_number: usize) -> bool {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: bool = ext2_inode_is_symlink_with(slot, mount, inode_number);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_inode_is_symlink_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize) -> bool {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return false; }
        Ext2InodeResult::Inode(inode) => {
            return (inode.mode & 0xF000) == 0xA000;
        }
    }
}

fn ext2_regular_file_size(mount: Ext2Mount, inode_number: usize) -> usize {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: usize = ext2_regular_file_size_with(slot, mount, inode_number);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_regular_file_size_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize) -> usize {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000) { return 0; }
            return inode.size;
        }
    }
}

fn ext2_inode_mode(mount: Ext2Mount, inode_number: usize) -> usize {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: usize = ext2_inode_mode_with(slot, mount, inode_number);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_inode_mode_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_number: usize) -> usize {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => { return inode.mode; }
    }
}

fn ext2_inode_size(mount: Ext2Mount, inode_number: usize) -> usize {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: usize = ext2_inode_size_with(slot, mount, inode_number);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_inode_size_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_number: usize) -> usize {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return 0; }
        Ext2InodeResult::Inode(inode) => { return inode.size; }
    }
}

fn ext2_regular_file_allocated_sectors(mount: Ext2Mount,
                                       inode_number: usize)
        -> Ext2CountResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2CountResult = ext2_regular_file_allocated_sectors_with(slot, mount, inode_number);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_regular_file_allocated_sectors_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount,
                                       inode_number: usize)
        -> Ext2CountResult {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2CountResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000) {
                return Ext2CountResult::Invalid;
            }
            match block_read(mount.device, inode.table_block,
                             ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => { return Ext2CountResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let mut inode_bytes: Ext2Bytes =
                ext2_at(ext2_metadata(), inode.table_offset);
            return Ext2CountResult::Counted(
                ext2_u32(slot, inode_bytes, 28) as usize);
        }
    }
}

fn ext2_resize_small_file(mount: Ext2Mount, inode_number: usize,
                          source: []const u8)
        -> Ext2ResizeResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ResizeResult = ext2_resize_small_file_with(slot, mount,
            inode_number, source);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_resize_small_file_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                          source: []const u8)
        -> Ext2ResizeResult !{unsafe} {
    return ext2_replace_regular_file_with(slot, mount, inode_number, source,
                                     EXT2_MAX_WRITE_ALLOCATIONS);
}

fn ext2_read_fast_symlink(mount: Ext2Mount, inode_number: usize,
                          destination: []u8)
        -> Ext2SymlinkResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2SymlinkResult = ext2_read_fast_symlink_with(slot, mount,
            inode_number, destination);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_read_fast_symlink_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                          destination: []u8)
        -> Ext2SymlinkResult !{unsafe} {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2SymlinkResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0xA000 || inode.size > 60 ||
                inode.size > destination.len) {
                return Ext2SymlinkResult::Invalid;
            }
            match block_read(mount.device, inode.table_block,
                             ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => { return Ext2SymlinkResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let metadata = ext2_scratch[slot.index].metadata as []u8;
            let table_offset: usize = inode.table_offset;
            if (table_offset > metadata.len) {
                return Ext2SymlinkResult::Invalid;
            }
            let inode_tail =
                metadata[table_offset..<metadata.len];
            if (inode_tail.len < 40) {
                return Ext2SymlinkResult::Invalid;
            }
            let inline_target = inode_tail[40..<inode_tail.len];
            let symlink_size: usize = inode.size;
            if (symlink_size > inline_target.len) {
                return Ext2SymlinkResult::Invalid;
            }
            let source = inline_target[0..<symlink_size];
            if (symlink_size > destination.len) {
                return Ext2SymlinkResult::Invalid;
            }
            slice_copy(destination, source);
            return Ext2SymlinkResult::Read(inode.size);
        }
    }
}

fn ext2_update_free_counts(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_counter: bool,
                           allocate: bool) -> Ext2CounterResult {
    match block_read(mount.device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match block_read(mount.device, 2, ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut super_offset: usize = 12;
    let mut group_offset: usize = 12;
    if (inode_counter) {
        super_offset = 16;
        group_offset = 14;
    }
    let mut super_bytes: Ext2Bytes = ext2_metadata();
    let mut group_bytes: Ext2Bytes = ext2_file();
    let super_count: u32 = ext2_u32(slot, super_bytes, super_offset);
    let group_count: u16 = ext2_u16(slot, group_bytes, group_offset);
    let mut next_super: u32 = super_count;
    let mut next_group: u16 = group_count;
    if (allocate) {
        if (super_count == 0 || group_count == 0) {
            return Ext2CounterResult::Invalid;
        }
        next_super = super_count - 1;
        next_group = group_count - 1;
    } else {
        if (super_count == 0xFFFFFFFF || group_count == 0xFFFF) {
            return Ext2CounterResult::Invalid;
        }
        next_super = super_count + 1;
        next_group = group_count + 1;
    }
    if (ext2_put_u32(slot, super_bytes, super_offset, next_super) == false ||
        ext2_put_u16(slot, group_bytes, group_offset, next_group) == false) {
        return Ext2CounterResult::Invalid;
    }
    match ext2_block_write(mount, EXT2_SUPERBLOCK_BLOCK,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_block_write(mount, 2, ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return Ext2CounterResult::Invalid; }
        BlockIoResult::Ok => { return Ext2CounterResult::Updated; }
    }
}

// GitHub issue #1147: statfs(2)'s ext2 numbers, as Linux's ext2_statfs
// computes them without minixdf: the blocks less the metadata overhead,
// the free blocks, those less the root-reserved ones, the inodes, the free
// inodes, and the fsid folded from s_uuid.
struct Ext2Statfs {
    blocks: usize;
    free_blocks: usize;
    available_blocks: usize;
    inodes: usize;
    free_inodes: usize;
    fsid: usize;
}

must_use variant Ext2StatfsResult { Invalid; Counts(Ext2Statfs); }

fn ext2_statfs(mount: Ext2Mount) -> Ext2StatfsResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2StatfsResult = ext2_statfs_with(slot, mount);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_statfs_with(slot: borrow Ext2Slot[0], mount: Ext2Mount)
        -> Ext2StatfsResult {
    match block_read(mount.device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2StatfsResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut superblock: Ext2Bytes = ext2_metadata();
    let blocks: usize = ext2_u32(slot, superblock, 4) as usize;
    let reserved: usize = ext2_u32(slot, superblock, 8) as usize;
    let free_blocks: usize = ext2_u32(slot, superblock, 12) as usize;
    let free_inodes: usize = ext2_u32(slot, superblock, 16) as usize;
    let first_data_block: usize = ext2_u32(slot, superblock, 20) as usize;
    let blocks_per_group: usize = ext2_u32(slot, superblock, 32) as usize;
    let mut fsid: usize = 0;
    for word: usize in 0..<2 {
        let low: usize = ext2_u32(slot, superblock, 104 + word * 8) as usize;
        let high: usize = ext2_u32(slot, superblock, 108 + word * 8) as usize;
        fsid = fsid ^ (low | (high << 32));
    }
    if (blocks_per_group == 0 || blocks <= first_data_block) {
        return Ext2StatfsResult::Invalid;
    }
    // Every group holds a superblock copy and the descriptor blocks (the
    // mount accepts no sparse_super), two bitmaps and its inode table.
    let groups: usize = (blocks - first_data_block + blocks_per_group - 1) /
                        blocks_per_group;
    let descriptor_blocks: usize = (groups * 32 + KERNEL_BLOCK_SIZE - 1) /
                                   KERNEL_BLOCK_SIZE;
    let table_blocks: usize = (mount.inodes_per_group * mount.inode_size +
                               KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
    let overhead: usize = first_data_block +
                          groups * (1 + descriptor_blocks + 2 + table_blocks);
    if (overhead > blocks) { return Ext2StatfsResult::Invalid; }
    let mut available: usize = 0;
    if (free_blocks > reserved) { available = free_blocks - reserved; }
    let mut counts: Ext2Statfs = {
        blocks - overhead, free_blocks, available, mount.inode_count,
        free_inodes, fsid
    };
    return Ext2StatfsResult::Counts(counts);
}

fn ext2_free_counts(mount: Ext2Mount) -> Ext2FreeCountsResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2FreeCountsResult = ext2_free_counts_with(slot, mount);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_free_counts_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> Ext2FreeCountsResult {
    match block_read(mount.device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2FreeCountsResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let free_blocks: usize =
        ext2_u32(slot, ext2_metadata(), 12) as usize;
    let free_inodes: usize =
        ext2_u32(slot, ext2_metadata(), 16) as usize;
    match block_read(mount.device, 2, ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return Ext2FreeCountsResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let group_free_blocks: usize =
        ext2_u16(slot, ext2_file(), 12) as usize;
    let group_free_inodes: usize =
        ext2_u16(slot, ext2_file(), 14) as usize;
    if (free_blocks != group_free_blocks || free_inodes != group_free_inodes) {
        return Ext2FreeCountsResult::Invalid;
    }
    return Ext2FreeCountsResult::Counts((free_blocks, free_inodes));
}

fn ext2_block_bitmap_snapshot(mount: Ext2Mount,
                              destination: [u8; KERNEL_BLOCK_SIZE..])
        -> Ext2ReadResult {
    match block_read(mount.device, mount.block_bitmap_block, destination) {
        BlockIoResult::Invalid => { return Ext2ReadResult::Invalid; }
        BlockIoResult::Ok => { return Ext2ReadResult::Read(KERNEL_BLOCK_SIZE); }
    }
}

// GitHub issue #595: what a block-device failure in the middle of a mutation
// is allowed to leave behind.
//
// Current limitations (2026-09-30):
// - A FAILED WRITE IS TAKEN TO LEAVE THE BLOCK AS IT WAS. A torn sector or
//   a power loss is a different failure with a different contract; this is
//   the recoverable, rejected-write case.
// - THE BITMAPS ARE THE TRUTH FOR WHAT IS ALLOCATED, AND THE COUNTERS ARE
//   DERIVED FROM THEM. Every repair clears bits it knows this operation set
//   and then recounts both counters from the bitmaps, which is idempotent
//   and needs no memory of how far a half-finished update got.
// - A FENCED MOUNT HOLDS LEAKED BLOCKS UNTIL ext2_recover. When repair
//   itself fails, the blocks the operation had claimed or was releasing stay
//   marked allocated with no inode naming them. They are remembered (at most
//   one operation's worth, since a fenced mount refuses the next) and
//   ext2_recover clears them and recounts. A leak from before a reboot is not
//   remembered: nothing here scans the inode table for unreferenced blocks.
// - THE FENCE IS ONE KERNEL-WIDE WORD, because the kernel mounts one
//   filesystem. It is read and written by the ext2 mutators, which callers
//   serialize under ext2_mutation_lock (the boot fixture runs alone on core 0).
private let mut ext2_fenced: bool;
const EXT2_FENCE_PENDING_MAX: usize =
    EXT2_MAX_WRITE_ALLOCATIONS + EXT2_MAX_SINGLE_FILE_BLOCKS + 2;
private let mut ext2_fence_pending: [usize; EXT2_FENCE_PENDING_MAX];
private let mut ext2_fence_pending_count: usize;

private fn ext2_fence_pending_add(block: usize) {
    let count: usize = ext2_fence_pending_count;
    if (count < EXT2_FENCE_PENDING_MAX) {
        ext2_fence_pending[count] = block;
        ext2_fence_pending_count = count + 1;
    }
}

fn ext2_is_fenced() -> bool { return ext2_fenced; }

// Every mutating write goes through here, so a fenced mount refuses all of
// them -- create, unlink, mkdir and rename included, which report their
// ordinary failure. Repair uses the raw block_write.
private fn ext2_block_write(mount: Ext2Mount, block: usize,
                            source: [u8; KERNEL_BLOCK_SIZE..])
        -> BlockIoResult !{unsafe} {
    if (ext2_fenced) { return BlockIoResult::Invalid; }
    return block_write(mount.device, block, source);
}

// Clear one bitmap bit whether or not it is set. True when the bit is clear
// on the device afterwards.
private fn ext2_bitmap_force_clear(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_bitmap: bool,
                                   index: usize) -> bool !{unsafe} {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    let mut item_count: usize = mount.filesystem_blocks - 1;
    if (inode_bitmap) {
        bitmap_block = mount.inode_bitmap_block;
        item_count = mount.inode_count;
    }
    if (index >= item_count) { return false; }
    match block_read(mount.device, bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    let mut bitmap: Ext2Bytes = ext2_metadata();
    let byte_index: usize = index / 8;
    let bit_index: usize = index % 8;
    let value: u8 = ext2_byte(slot, bitmap, byte_index);
    let mask: u8 = (1 << (bit_index as u8)) as u8;
    if ((value & mask) == 0) { return true; }
    ext2_set_byte(slot, bitmap, byte_index, value & (mask ^ 0xFF));
    match block_write(mount.device, bitmap_block,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { return true; }
    }
}

private fn ext2_count_free(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_bitmap: bool)
        -> Ext2CountResult !{unsafe} {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    let mut item_count: usize = mount.filesystem_blocks - 1;
    if (inode_bitmap) {
        bitmap_block = mount.inode_bitmap_block;
        item_count = mount.inode_count;
    }
    match block_read(mount.device, bitmap_block,
                     ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return Ext2CountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut bitmap: Ext2Bytes = ext2_file();
    let mut free: usize = 0;
    for byte_index: usize in 0..<KERNEL_BLOCK_SIZE {
        for bit_index: usize in 0..<8 {
            if (byte_index * 8 + bit_index < item_count) {
                let mask: u8 = (1 << (bit_index as u8)) as u8;
                if ((ext2_byte(slot, bitmap, byte_index) & mask) == 0) {
                    free = free + 1;
                }
            }
        }
    }
    return Ext2CountResult::Counted(free);
}

// Rewrite the superblock's and the group descriptor's free counts from the
// bitmaps. True when both writes completed.
private fn ext2_recount(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> bool !{unsafe} {
    let free_blocks: usize = match ext2_count_free(slot, mount, false) {
        Ext2CountResult::Invalid => { return false; }
        Ext2CountResult::Counted(count) => { count }
    };
    let free_inodes: usize = match ext2_count_free(slot, mount, true) {
        Ext2CountResult::Invalid => { return false; }
        Ext2CountResult::Counted(count) => { count }
    };
    if (free_blocks > 0xFFFF || free_inodes > 0xFFFF) { return false; }
    match block_read(mount.device, EXT2_SUPERBLOCK_BLOCK,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    match block_read(mount.device, 2, ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    if (ext2_put_u32(slot, ext2_metadata(), 12,
                     free_blocks as u32) == false ||
        ext2_put_u32(slot, ext2_metadata(), 16,
                     free_inodes as u32) == false ||
        ext2_put_u16(slot, ext2_file(), 12,
                     free_blocks as u16) == false ||
        ext2_put_u16(slot, ext2_file(), 14,
                     free_inodes as u16) == false) {
        return false;
    }
    match block_write(mount.device, EXT2_SUPERBLOCK_BLOCK,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    match block_write(mount.device, 2, ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { return true; }
    }
}

// The invariant a repair restores: both counters equal the number of clear
// bits in their bitmaps.
fn ext2_counters_match_bitmaps(mount: Ext2Mount) -> bool !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: bool = ext2_counters_match_bitmaps_with(slot, mount);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_counters_match_bitmaps_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> bool !{unsafe} {
    let free_blocks: usize = match ext2_count_free(slot, mount, false) {
        Ext2CountResult::Invalid => { return false; }
        Ext2CountResult::Counted(count) => { count }
    };
    let free_inodes: usize = match ext2_count_free(slot, mount, true) {
        Ext2CountResult::Invalid => { return false; }
        Ext2CountResult::Counted(count) => { count }
    };
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => { return false; }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            return blocks == free_blocks && inodes == free_inodes;
        }
    }
}

// GitHub issue #698: block or inode exhaustion for the boot fixture. Every
// create here costs a block and an inode, and the fixture image has far more
// free inodes than free blocks, so no sequence of ordinary creates empties
// the inode bitmap while blocks remain; and nothing reachable from the boot
// fixture creates a file without a block. Fill sets every clear bit of one
// bitmap at once and recounts; the linear token is what makes the caller put
// the saved bitmap back. Nothing names the marked items, so the token must
// not outlive the boot fixture: e2fsck would report every one of them.
linear struct Ext2BitmapFill[unit: usize] {
    private inode_bitmap: bool;
    private marked: usize;
}
must_use variant Ext2BitmapFillResult { Invalid; Filled(Ext2BitmapFill[0]); }

fn ext2_bitmap_fill(mount: Ext2Mount, inode_bitmap: bool,
                    saved: borrow [u8; KERNEL_BLOCK_SIZE..])
        -> Ext2BitmapFillResult !{unsafe} {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    let mut item_count: usize = mount.filesystem_blocks - 1;
    if (inode_bitmap) {
        bitmap_block = mount.inode_bitmap_block;
        item_count = mount.inode_count;
    }
    if (item_count > KERNEL_BLOCK_SIZE * 8) {
        return Ext2BitmapFillResult::Invalid;
    }
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    match block_read(mount.device, bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => {
            ext2_slot_release(slot);
            return Ext2BitmapFillResult::Invalid;
        }
        BlockIoResult::Ok => { }
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE {
        saved[i] = ext2_scratch[slot.index].metadata[i];
    }
    let mut bitmap: Ext2Bytes = ext2_metadata();
    let mut marked: usize = 0;
    for index: usize in 0..<item_count {
        let value: u8 = ext2_byte(slot, bitmap, index / 8);
        let mask: u8 = (1 << ((index % 8) as u8)) as u8;
        if ((value & mask) == 0) {
            ext2_set_byte(slot, bitmap, index / 8, value | mask);
            marked = marked + 1;
        }
    }
    let mut ok: bool = false;
    match ext2_block_write(mount, bitmap_block,
                           ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { }
        BlockIoResult::Ok => { ok = ext2_recount(slot, mount); }
    }
    let mut fill: Ext2BitmapFill[0] = { inode_bitmap, marked };
    if (ok) {
        ext2_slot_release(slot);
        return Ext2BitmapFillResult::Filled(fill);
    }
    match ext2_bitmap_fill_restore_with(slot, mount, fill, saved) {
        Ext2OwnerReleaseResult::Invalid => { }
        Ext2OwnerReleaseResult::Released => { }
    }
    ext2_slot_release(slot);
    return Ext2BitmapFillResult::Invalid;
}

fn ext2_bitmap_fill_marked(fill: borrow Ext2BitmapFill[0]) -> usize {
    return fill.marked;
}

// Puts the saved bitmap back with the raw write, as a repair does, so a
// fence raised meanwhile cannot strand the marked items.
fn ext2_bitmap_fill_restore(mount: Ext2Mount, fill: sink Ext2BitmapFill[0],
                            saved: borrow [u8; KERNEL_BLOCK_SIZE..])
        -> Ext2OwnerReleaseResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2OwnerReleaseResult =
        ext2_bitmap_fill_restore_with(slot, mount, fill, saved);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_bitmap_fill_restore_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, fill: sink Ext2BitmapFill[0],
        saved: borrow [u8; KERNEL_BLOCK_SIZE..])
        -> Ext2OwnerReleaseResult !{unsafe} {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    if (fill.inode_bitmap) { bitmap_block = mount.inode_bitmap_block; }
    for i: usize in 0..<KERNEL_BLOCK_SIZE {
        ext2_scratch[slot.index].metadata[i] = saved[i];
    }
    match block_write(mount.device, bitmap_block,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    if (ext2_recount(slot, mount)) { return Ext2OwnerReleaseResult::Released; }
    return Ext2OwnerReleaseResult::Invalid;
}

// Give back one claim that will never be handed out. Fences the mount when
// the bit or the counters cannot be made right.
private fn ext2_settle_claim(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_bitmap: bool,
                             index: usize) !{unsafe} {
    if (ext2_bitmap_force_clear(slot, mount, inode_bitmap, index) == false ||
        ext2_recount(slot, mount) == false) {
        ext2_fenced = true;
        if (inode_bitmap == false) { ext2_fence_pending_add(index + 1); }
    }
}

// Try to make a fenced mount writable again: the counters are rewritten from
// the bitmaps and read back as agreeing. Blocks leaked by the failure that
// fenced it stay allocated (see the limitations above).
fn ext2_recover(mount: Ext2Mount) -> Ext2RecoverResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2RecoverResult = ext2_recover_with(slot, mount);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_recover_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> Ext2RecoverResult !{unsafe} {
    // GitHub issue #1088: a release whose rollback failed finishes it first.
    let owed: usize = ext2_undo_owed;
    if (owed > 0) {
        ext2_undo_owed = ext2_undo_replay(slot, mount, owed);
        if (ext2_undo_owed != 0) { return Ext2RecoverResult::Failed; }
    }
    for pending: usize in 0..<EXT2_FENCE_PENDING_MAX {
        if (pending < ext2_fence_pending_count) {
            let block: usize = ext2_fence_pending[pending];
            if (block == 0 || block > mount.filesystem_blocks - 1 ||
                ext2_bitmap_force_clear(slot, mount, false,
                        block - 1) == false) {
                return Ext2RecoverResult::Failed;
            }
        }
    }
    if (ext2_recount(slot,
            mount) == false) { return Ext2RecoverResult::Failed; }
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => { return Ext2RecoverResult::Failed; }
        Ext2FreeCountsResult::Counts(counts) => { }
    }
    ext2_fence_pending_count = 0;
    ext2_fenced = false;
    return Ext2RecoverResult::Recovered;
}

// GitHub issue #1088: the release operations -- O_TRUNC, the last unlink of
// a file, rename over a file and rmdir -- are all or nothing under a
// rejected write. Every write that detaches a name, an inode or a link goes
// through this undo log, and the blocks are freed last, by one write of the
// block bitmap. That write is the commit. A rejected write before it puts
// every logged range back, newest first, with the raw block_write, and the
// call fails with the disk as it was. After it only the counters, recounted
// from the bitmaps, and the scrub of the freed blocks remain: a failed
// recount fences (ext2_recover recounts), and a failed scrub is ignored,
// because an allocation zeroes a block before handing it out.
//
// Current limitations (2026-10-25):
// - ONE LOG, KERNEL-WIDE, like ext2_fenced: its users are mutators, which
//   callers serialize under ext2_mutation_lock (the boot fixture runs alone
//   on core 0).
// - A FAILED ROLLBACK FENCES AND KEEPS THE LOG. The rows not yet put back
//   stay in it, ext2_undo_save refuses on a fenced mount so nothing
//   overwrites them, and ext2_recover finishes the rollback before it
//   recounts. A reboot in between loses them, as it loses the pending
//   blocks above.
// - A ROW HOLDS AT MOST EXT2_UNDO_BYTES, one inode record, and an operation
//   logs at most EXT2_UNDO_ROWS rows (rmdir's five).
// - The rejected-write model above: a torn write is not undone.
const EXT2_UNDO_ROWS: usize = 6;
const EXT2_UNDO_BYTES: usize = 128;

struct Ext2UndoRow {
    block: usize;
    offset: usize;
    length: usize;
    bytes: [u8; EXT2_UNDO_BYTES];
}

private let mut ext2_undo_rows: [Ext2UndoRow; EXT2_UNDO_ROWS];
// Rows a fenced mount still owes the disk; ext2_recover puts them back.
private let mut ext2_undo_owed: usize;

// The rows this operation has written. It ends in ext2_undo_commit, or in
// ext2_undo_abort, which puts them back.
private linear struct Ext2Undo[unit: usize] {
    private count: usize;
}

private fn ext2_undo_begin() -> Ext2Undo[0] {
    let mut undo: Ext2Undo[0] = { 0 };
    return undo;
}

// Keep bytes [offset, offset + length) of a buffer (the file one when
// `in_file`) as they are now, before the caller changes them for a write of
// `block` through ext2_undo_write. False when the log is full, the range
// does not fit a row, or the mount is fenced.
private fn ext2_undo_save(slot: borrow Ext2Slot[0],
        undo: borrow mut Ext2Undo[0], block: usize, in_file: bool,
        offset: usize, length: usize) -> bool {
    if (ext2_fenced) { return false; }
    let row: usize = undo.count;
    if (row >= EXT2_UNDO_ROWS || length > EXT2_UNDO_BYTES ||
        offset > KERNEL_BLOCK_SIZE - length) {
        return false;
    }
    let mut bytes: Ext2Bytes = ext2_metadata();
    if (in_file) { bytes = ext2_file(); }
    ext2_undo_rows[row].block = block;
    ext2_undo_rows[row].offset = offset;
    ext2_undo_rows[row].length = length;
    for i: usize in 0..<EXT2_UNDO_BYTES {
        if (i < length) {
            ext2_undo_rows[row].bytes[i] = ext2_byte(slot, bytes, offset + i);
        }
    }
    return true;
}

// Write `block` from the buffer whose range ext2_undo_save just kept. The
// row joins the log only when the write landed: a rejected write left the
// block as it was, so there is nothing of it to put back.
private fn ext2_undo_write(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: borrow mut Ext2Undo[0], block: usize, in_file: bool)
        -> bool !{unsafe} {
    let row: usize = undo.count;
    if (row >= EXT2_UNDO_ROWS) { return false; }
    if (ext2_undo_rows[row].block != block) { return false; }
    let mut written: bool = false;
    if (in_file) {
        match ext2_block_write(mount, block,
                               ext2_scratch[slot.index].file as []u8) {
            BlockIoResult::Invalid => { }
            BlockIoResult::Ok => { written = true; }
        }
    } else {
        match ext2_block_write(mount, block,
                               ext2_scratch[slot.index].metadata as []u8) {
            BlockIoResult::Invalid => { }
            BlockIoResult::Ok => { written = true; }
        }
    }
    if (written) { undo.count = row + 1; }
    return written;
}

// Put row `row` back with the raw block_write, a repair a fenced mount still
// allows. Uses the metadata buffer.
private fn ext2_undo_put_back(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        row: usize) -> bool !{unsafe} {
    if (row >= EXT2_UNDO_ROWS) { return false; }
    let block: usize = ext2_undo_rows[row].block;
    let offset: usize = ext2_undo_rows[row].offset;
    let length: usize = ext2_undo_rows[row].length;
    if (block == 0 || block >= mount.filesystem_blocks ||
        length > EXT2_UNDO_BYTES || offset > KERNEL_BLOCK_SIZE - length) {
        return false;
    }
    match block_read(mount.device, block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    for i: usize in 0..<EXT2_UNDO_BYTES {
        if (i < length) {
            ext2_set_byte(slot, ext2_metadata(), offset + i,
                          ext2_undo_rows[row].bytes[i]);
        }
    }
    match block_write(mount.device, block,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { return true; }
    }
}

// Put the first `rows` rows back, newest first, and answer how many are
// still owed: zero when all landed, otherwise the rows up to and including
// the first that did not. Putting a row back twice writes the same bytes,
// so replaying rows already put back is harmless.
private fn ext2_undo_replay(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        rows: usize) -> usize !{unsafe} {
    let mut remaining: usize = rows;
    for step: usize in 0..<EXT2_UNDO_ROWS {
        let current: usize = remaining;
        if (current > 0 && current <= EXT2_UNDO_ROWS) {
            let row: usize = current - 1;
            if (ext2_undo_put_back(slot, mount, row) == false) {
                return current;
            }
            remaining = row;
        }
    }
    return remaining;
}

private fn ext2_undo_commit(undo: sink Ext2Undo[0]) {}

// The operation failed: put its rows back. False when a row could not be,
// in which case the mount is fenced and owes the rest (see above).
private fn ext2_undo_abort(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: sink Ext2Undo[0]) -> bool !{unsafe} {
    let owed: usize = ext2_undo_replay(slot, mount, undo.count);
    if (owed == 0) { return true; }
    ext2_undo_owed = owed;
    ext2_fenced = true;
    return false;
}

// What a release (#1088) ends in. RolledBack: the disk is as it was.
// Fenced: the rollback could not finish, and ext2_recover will. Committed:
// the operation happened (the mount is fenced too when the recount failed).
must_use variant Ext2ReleaseResult { RolledBack; Fenced; Committed; }

private fn ext2_release_abort(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: sink Ext2Undo[0]) -> Ext2ReleaseResult !{unsafe} {
    if (ext2_undo_abort(slot, mount, undo)) {
        return Ext2ReleaseResult::RolledBack;
    }
    return Ext2ReleaseResult::Fenced;
}

// The blocks a file or directory names, read from its inode record before
// anything is written: i_block and how many blocks its size covers.
struct Ext2BlockMap {
    direct: [usize; EXT2_MAX_DIRECT_BLOCKS];
    single: usize;
    double: usize;
    blocks: usize;
}

must_use variant Ext2BlockMapResult { Invalid; Map(Ext2BlockMap); }

private fn ext2_block_map_read(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        file: Ext2Inode) -> Ext2BlockMapResult {
    if (file.size > ext2_max_regular_file_size()) {
        return Ext2BlockMapResult::Invalid;
    }
    match block_read(mount.device, file.table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BlockMapResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut inode_bytes: Ext2Bytes =
        ext2_at(ext2_metadata(), file.table_offset);
    let mut map: Ext2BlockMap;
    map.single = ext2_u32(slot, inode_bytes, 88) as usize;
    map.double = ext2_u32(slot, inode_bytes, 92) as usize;
    map.blocks = (file.size + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
    for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
        map.direct[index] =
            ext2_u32(slot, inode_bytes, 40 + index * 4) as usize;
    }
    return Ext2BlockMapResult::Map(map);
}

// What a walk of a map does with each block. Check and Clear work on the
// block bitmap held in the file buffer: both ask that the block's bit be
// set, and Clear clears it. Scrub zeroes the block on the device, best
// effort, after the commit.
variant Ext2WalkMode { Check; Clear; Scrub; }

private fn ext2_walk_visit(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        mode: Ext2WalkMode, block: usize) -> bool !{unsafe} {
    if (block < 2 || block >= mount.filesystem_blocks) { return false; }
    let index: usize = block - 1;
    let byte_index: usize = index / 8;
    let mask: u8 = (1 << ((index % 8) as u8)) as u8;
    let value: u8 = ext2_byte(slot, ext2_file(), byte_index);
    match mode {
        Ext2WalkMode::Scrub => {
            for i: usize in 0..<KERNEL_BLOCK_SIZE {
                ext2_scratch[slot.index].file[i] = 0;
            }
            match ext2_block_write(mount, block,
                                   ext2_scratch[slot.index].file as []u8) {
                BlockIoResult::Invalid => { }
                BlockIoResult::Ok => { }
            }
            return true;
        }
        Ext2WalkMode::Check => { return (value & mask) != 0; }
        Ext2WalkMode::Clear => {
            if ((value & mask) == 0) { return false; }
            return ext2_set_byte(slot, ext2_file(), byte_index,
                                 value & (mask ^ 0xFF));
        }
    }
}

// Entry `index` of pointer block `block`, read afresh into the metadata
// buffer: a scrub in between overwrites the file buffer, and the visits of
// Check and Clear read the file buffer only.
private fn ext2_walk_entry(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        block: usize, index: usize) -> Ext2CountResult {
    match block_read(mount.device, block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2CountResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    return Ext2CountResult::Counted(
        ext2_u32(slot, ext2_metadata(), index * 4) as usize);
}

// The data blocks of one pointer block, `count` of them at most, then the
// pointer block itself, so a scrub reads every entry before it zeroes them.
private fn ext2_walk_pointer_block(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, mode: Ext2WalkMode, block: usize, count: usize)
        -> bool !{unsafe} {
    if (block < 2 || block >= mount.filesystem_blocks) { return false; }
    for index: usize in 0..<ext2_pointer_count() {
        if (index < count) {
            match ext2_walk_entry(slot, mount, block, index) {
                Ext2CountResult::Invalid => { return false; }
                Ext2CountResult::Counted(data) => {
                    // A hole (pointer 0) has nothing to visit.
                    if (data != 0 &&
                        ext2_walk_visit(slot, mount, mode, data) == false) {
                        return false;
                    }
                }
            }
        }
    }
    return ext2_walk_visit(slot, mount, mode, block);
}

// Every block the map names -- data blocks, the singly-indirect block, and
// the doubly-indirect block with its second-level blocks. False on the
// first block that fails its visit or pointer block that cannot be read.
private fn ext2_walk_map(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        map: Ext2BlockMap, mode: Ext2WalkMode) -> bool !{unsafe} {
    let pointers: usize = ext2_pointer_count();
    let blocks: usize = map.blocks;
    for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
        let block: usize = map.direct[index];
        if (index < blocks && block != 0 &&
            ext2_walk_visit(slot, mount, mode, block) == false) {
            return false;
        }
    }
    if (blocks > EXT2_MAX_DIRECT_BLOCKS && map.single != 0 &&
        ext2_walk_pointer_block(slot, mount, mode, map.single,
                                blocks - EXT2_MAX_DIRECT_BLOCKS) == false) {
        return false;
    }
    if (blocks > EXT2_MAX_DIRECT_BLOCKS + pointers && map.double != 0) {
        let remaining: usize = blocks - EXT2_MAX_DIRECT_BLOCKS - pointers;
        for outer: usize in 0..<ext2_pointer_count() {
            if (outer * pointers < remaining) {
                match ext2_walk_entry(slot, mount, map.double, outer) {
                    Ext2CountResult::Invalid => { return false; }
                    Ext2CountResult::Counted(second) => {
                        if (second != 0 &&
                            ext2_walk_pointer_block(slot, mount, mode, second,
                                    remaining - outer * pointers) == false) {
                            return false;
                        }
                    }
                }
            }
        }
        if (ext2_walk_visit(slot, mount, mode, map.double) == false) {
            return false;
        }
    }
    return true;
}

// The commit of a release: every block of `map` is freed by one write of the
// block bitmap, then the counters are recounted from the bitmaps and the
// freed blocks scrubbed. A failed read, a block whose bit is already clear,
// or a rejected bitmap write rolls the log back instead.
private fn ext2_release_commit(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: sink Ext2Undo[0], map: Ext2BlockMap)
        -> Ext2ReleaseResult !{unsafe} {
    let mut cleared: bool = false;
    match block_read(mount.device, mount.block_bitmap_block,
                     ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { }
        BlockIoResult::Ok => {
            if (ext2_walk_map(slot, mount, map, Ext2WalkMode::Clear)) {
                match ext2_block_write(mount, mount.block_bitmap_block,
                                       ext2_scratch[slot.index].file as []u8) {
                    BlockIoResult::Invalid => { }
                    BlockIoResult::Ok => { cleared = true; }
                }
            }
        }
    }
    if (cleared == false) { return ext2_release_abort(slot, mount, undo); }
    ext2_undo_commit(undo);
    if (ext2_recount(slot, mount) == false) { ext2_fenced = true; }
    if (ext2_walk_map(slot, mount, map, Ext2WalkMode::Scrub)) { }
    return Ext2ReleaseResult::Committed;
}

// The blocks of `map` all marked allocated: a release checks this before its
// first write, so a corrupt map is refused with nothing written.
private fn ext2_release_check(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        map: Ext2BlockMap) -> bool !{unsafe} {
    match block_read(mount.device, mount.block_bitmap_block,
                     ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    return ext2_walk_map(slot, mount, map, Ext2WalkMode::Check);
}

// Logged: the whole inode record zeroed, as ext2_release_inode does.
private fn ext2_inode_clear_logged(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: borrow mut Ext2Undo[0], file: Ext2Inode) -> bool !{unsafe} {
    match block_read(mount.device, file.table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    if (ext2_undo_save(slot, undo, file.table_block, false, file.table_offset,
                       128) == false) {
        return false;
    }
    let mut inode_bytes: Ext2Bytes =
        ext2_at(ext2_metadata(), file.table_offset);
    for i: usize in 0..<128 { ext2_set_byte(slot, inode_bytes, i, 0); }
    return ext2_undo_write(slot, mount, undo, file.table_block, false);
}

// Logged: O_TRUNC's inode -- size 0, no sectors, no block pointers.
private fn ext2_inode_truncate_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: borrow mut Ext2Undo[0], file: Ext2Inode)
        -> bool !{unsafe} {
    match block_read(mount.device, file.table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    if (ext2_undo_save(slot, undo, file.table_block, false, file.table_offset,
                       128) == false) {
        return false;
    }
    let mut inode_bytes: Ext2Bytes =
        ext2_at(ext2_metadata(), file.table_offset);
    if (ext2_put_u32(slot, inode_bytes, 4, 0) == false ||
        ext2_put_u32(slot, inode_bytes, 28, 0) == false) {
        return false;
    }
    // i_block[0..15]: twelve direct, single, double, triple.
    for index: usize in 0..<15 {
        if (ext2_put_u32(slot, inode_bytes, 40 + index * 4, 0) == false) {
            return false;
        }
    }
    return ext2_undo_write(slot, mount, undo, file.table_block, false);
}

// Logged: an inode's link count.
private fn ext2_inode_links_logged(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: borrow mut Ext2Undo[0], file: Ext2Inode, links: usize)
        -> bool !{unsafe} {
    if (links > 0xFFFF) { return false; }
    match block_read(mount.device, file.table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    if (file.table_offset > KERNEL_BLOCK_SIZE - 28 ||
        ext2_undo_save(slot, undo, file.table_block, false,
                       file.table_offset + 26, 2) == false ||
        ext2_put_u16(slot, ext2_at(ext2_metadata(), file.table_offset), 26,
                     links as u16) == false) {
        return false;
    }
    return ext2_undo_write(slot, mount, undo, file.table_block, false);
}

// Logged: an inode's bitmap bit set (a create, GitHub issue #1120) or
// cleared. The counters move at the recount.
private fn ext2_inode_bitmap_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: borrow mut Ext2Undo[0], inode_number: usize,
        set: bool) -> bool !{unsafe} {
    if (inode_number < 2 || inode_number > mount.inode_count) { return false; }
    match block_read(mount.device, mount.inode_bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    let index: usize = inode_number - 1;
    let byte_index: usize = index / 8;
    let mask: u8 = (1 << ((index % 8) as u8)) as u8;
    let value: u8 = ext2_byte(slot, ext2_metadata(), byte_index);
    let mut next: u8 = value & (mask ^ 0xFF);
    if (set) { next = value | mask; }
    if (((value & mask) != 0) == set ||
        ext2_undo_save(slot, undo, mount.inode_bitmap_block, false,
                       byte_index, 1) == false ||
        ext2_set_byte(slot, ext2_metadata(), byte_index, next) == false) {
        return false;
    }
    return ext2_undo_write(slot, mount, undo, mount.inode_bitmap_block, false);
}

// Logged: the group's used-directories count, up (mkdir) or down by one.
private fn ext2_used_directories_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: borrow mut Ext2Undo[0], increment: bool)
        -> bool !{unsafe} {
    match block_read(mount.device, 2, ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    let used: usize = ext2_u16(slot, ext2_file(), 16) as usize;
    if ((increment && used >= 0xFFFF) || (increment == false && used == 0)) {
        return false;
    }
    let mut next: usize = used - 1;
    if (increment) { next = used + 1; }
    if (ext2_undo_save(slot, undo, 2, true, 16, 2) == false ||
        ext2_put_u16(slot, ext2_file(), 16, next as u16) == false) {
        return false;
    }
    return ext2_undo_write(slot, mount, undo, 2, true);
}

// Free an inode none of whose names is left once the log commits: its
// record is zeroed and its bit cleared, logged, and its blocks are freed by
// the commit. The caller has logged the removal of its last name.
private fn ext2_release_file_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: sink Ext2Undo[0], file: Ext2Inode,
        inode_number: usize) -> Ext2ReleaseResult !{unsafe} {
    let mut log: Ext2Undo[0] = undo;
    match ext2_block_map_read(slot, mount, file) {
        Ext2BlockMapResult::Invalid => {
            return ext2_release_abort(slot, mount, log);
        }
        Ext2BlockMapResult::Map(map) => {
            if (ext2_release_check(slot, mount, map) == false ||
                ext2_inode_clear_logged(slot, mount, log, file) == false ||
                ext2_inode_bitmap_logged(slot, mount, log,
                        inode_number, false) == false) {
                return ext2_release_abort(slot, mount, log);
            }
            return ext2_release_commit(slot, mount, log, map);
        }
    }
}

fn ext2_bitmap_claim(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_bitmap: bool,
                     first_index: usize, item_count: usize)
        -> Ext2BitmapClaimResult {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    if (inode_bitmap) { bitmap_block = mount.inode_bitmap_block; }
    if (item_count == 0 || item_count > KERNEL_BLOCK_SIZE * 8 ||
        first_index >= item_count) {
        return Ext2BitmapClaimResult::Invalid;
    }
    match block_read(mount.device, bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapClaimResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut bitmap: Ext2Bytes = ext2_metadata();
    let mut index: usize = first_index;
    while (index < item_count) {
        let byte_index: usize = index / 8;
        let bit_index: usize = index % 8;
        let value: u8 = ext2_byte(slot, bitmap, byte_index);
        let mask: u8 = (1 << (bit_index as u8)) as u8;
        if ((value & mask) == 0) {
            ext2_set_byte(slot, bitmap, byte_index, value | mask);
            match ext2_block_write(mount, bitmap_block,
                              ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => {
                    return Ext2BitmapClaimResult::Invalid;
                }
                BlockIoResult::Ok => { }
            }
            match ext2_update_free_counts(slot, mount, inode_bitmap, true) {
                Ext2CounterResult::Invalid => {
                    // The bit is set and the counters are in an unknown
                    // half-written state: give the claim back.
                    ext2_settle_claim(slot, mount, inode_bitmap, index);
                    return Ext2BitmapClaimResult::Invalid;
                }
                Ext2CounterResult::Updated => {
                    return Ext2BitmapClaimResult::Claimed(index);
                }
            }
        }
        index = index + 1;
    }
    return Ext2BitmapClaimResult::Full;
}

fn ext2_bitmap_release(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_bitmap: bool,
                       index: usize) -> Ext2BitmapReleaseResult {
    let mut bitmap_block: usize = mount.block_bitmap_block;
    let mut item_count: usize = mount.filesystem_blocks - 1;
    if (inode_bitmap) {
        bitmap_block = mount.inode_bitmap_block;
        item_count = mount.inode_count;
    }
    if (index >= item_count) { return Ext2BitmapReleaseResult::Invalid; }
    match block_read(mount.device, bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut bitmap: Ext2Bytes = ext2_metadata();
    let byte_index: usize = index / 8;
    let bit_index: usize = index % 8;
    let value: u8 = ext2_byte(slot, bitmap, byte_index);
    let mask: u8 = (1 << (bit_index as u8)) as u8;
    if ((value & mask) == 0) { return Ext2BitmapReleaseResult::Invalid; }
    ext2_set_byte(slot, bitmap, byte_index, value & (mask ^ 0xFF));
    match ext2_block_write(mount, bitmap_block,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_update_free_counts(slot, mount, inode_bitmap, false) {
        Ext2CounterResult::Invalid => { return Ext2BitmapReleaseResult::Invalid; }
        Ext2CounterResult::Updated => {
            return Ext2BitmapReleaseResult::Released;
        }
    }
}

fn ext2_bitmap_roundtrip_check(mount: Ext2Mount)
        -> Ext2BitmapProbeResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2BitmapProbeResult = ext2_bitmap_roundtrip_check_with(slot,
            mount);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_bitmap_roundtrip_check_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount)
        -> Ext2BitmapProbeResult {
    let mut before_blocks: usize = 0;
    let mut before_inodes: usize = 0;
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            before_blocks = blocks;
            before_inodes = inodes;
        }
    }
    let mut block_index: usize = 0;
    match ext2_bitmap_claim(slot, 
            mount, false, mount.inode_table_block + 16,
            mount.filesystem_blocks - 1) {
        Ext2BitmapClaimResult::Full => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapClaimResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapClaimResult::Claimed(index) => { block_index = index; }
    }
    let mut inode_index: usize = 0;
    match ext2_bitmap_claim(slot, mount, true, 11, mount.inode_count) {
        Ext2BitmapClaimResult::Full => {
            match ext2_bitmap_release(slot, mount, false, block_index) {
                Ext2BitmapReleaseResult::Invalid => { }
                Ext2BitmapReleaseResult::Released => { }
            }
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapClaimResult::Invalid => {
            match ext2_bitmap_release(slot, mount, false, block_index) {
                Ext2BitmapReleaseResult::Invalid => { }
                Ext2BitmapReleaseResult::Released => { }
            }
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapClaimResult::Claimed(index) => { inode_index = index; }
    }
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            if (blocks + 1 != before_blocks || inodes + 1 != before_inodes) {
                return Ext2BitmapProbeResult::Invalid;
            }
        }
    }
    match ext2_bitmap_release(slot, mount, true, inode_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => { }
    }
    match ext2_bitmap_release(slot, mount, false, block_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => {
            match ext2_free_counts_with(slot, mount) {
                Ext2FreeCountsResult::Invalid => {
                    return Ext2BitmapProbeResult::Invalid;
                }
                Ext2FreeCountsResult::Counts(counts) => {
                    let (blocks, inodes) = counts;
                    if (blocks == before_blocks && inodes == before_inodes) {
                        return Ext2BitmapProbeResult::Verified;
                    }
                }
            }
            return Ext2BitmapProbeResult::Invalid;
        }
    }
}

fn ext2_block_owner_new(bitmap_index: usize,
                        block_number: usize,
                        witness: usize @ block) -> Ext2BlockOwner[block] {
    let mut owner: Ext2BlockOwner[block] = {
        bitmap_index, block_number, witness
    };
    return owner;
}

fn ext2_inode_owner_new(bitmap_index: usize,
                        inode_number: usize,
                        witness: usize @ inode) -> Ext2InodeOwner[inode] {
    let mut owner: Ext2InodeOwner[inode] = {
        bitmap_index, inode_number, witness
    };
    return owner;
}

fn ext2_allocate_block(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> Ext2BlockAllocResult {
    let inode_table_bytes: usize = mount.inode_count * mount.inode_size;
    let inode_table_blocks: usize =
        (inode_table_bytes + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
    let first_block: usize = mount.inode_table_block + inode_table_blocks;
    if (first_block == 0 || first_block >= mount.filesystem_blocks) {
        return Ext2BlockAllocResult::Failed;
    }
    // Bitmap index zero represents filesystem block one for a 1 KiB ext2
    // volume. This mount contract already requires first_data_block == 1.
    match ext2_bitmap_claim(slot, 
            mount, false, first_block - 1, mount.filesystem_blocks - 1) {
        Ext2BitmapClaimResult::Full => { return Ext2BlockAllocResult::NoSpace; }
        Ext2BitmapClaimResult::Invalid => {
            return Ext2BlockAllocResult::Failed;
        }
        Ext2BitmapClaimResult::Claimed(bitmap_index) => {
            let block_number: usize = bitmap_index + 1;
            for i: usize in 0..<KERNEL_BLOCK_SIZE {
                ext2_scratch[slot.index].file[i] = 0;
            }
            match ext2_block_write(mount, block_number,
                              ext2_scratch[slot.index].file as []u8) {
                BlockIoResult::Invalid => {
                    ext2_settle_claim(slot, mount, false, bitmap_index);
                    return Ext2BlockAllocResult::Failed;
                }
                BlockIoResult::Ok => {
                    return Ext2BlockAllocResult::Allocated(
                        ext2_block_owner_new(
                            bitmap_index, block_number, block_number));
                }
            }
        }
    }
}

fn ext2_allocate_inode(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> Ext2InodeAllocResult {
    // Inodes 1..10 are ext2 reserved in revision 1. Bitmap index 10 is
    // therefore the first allocatable inode (inode number 11).
    match ext2_bitmap_claim(slot, mount, true, 10, mount.inode_count) {
        Ext2BitmapClaimResult::Full => {
            return Ext2InodeAllocResult::NoSpace;
        }
        Ext2BitmapClaimResult::Invalid => {
            return Ext2InodeAllocResult::Failed;
        }
        Ext2BitmapClaimResult::Claimed(bitmap_index) => {
            let inode_number: usize = bitmap_index + 1;
            let byte_offset: usize = bitmap_index * mount.inode_size;
            let table_block: usize = mount.inode_table_block +
                                     byte_offset / KERNEL_BLOCK_SIZE;
            let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
            if (table_block >= mount.filesystem_blocks ||
                table_offset > KERNEL_BLOCK_SIZE - 128) {
                ext2_settle_claim(slot, mount, true, bitmap_index);
                return Ext2InodeAllocResult::Failed;
            }
            match block_read(mount.device, table_block,
                             ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => {
                    ext2_settle_claim(slot, mount, true, bitmap_index);
                    return Ext2InodeAllocResult::Failed;
                }
                BlockIoResult::Ok => { }
            }
            let mut inode_pointer: Ext2Bytes =
                ext2_at(ext2_metadata(), table_offset);
            for i: usize in 0..<128 { ext2_set_byte(slot, inode_pointer, i,
                    0); }
            match ext2_block_write(mount, table_block,
                              ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => {
                    ext2_settle_claim(slot, mount, true, bitmap_index);
                    return Ext2InodeAllocResult::Failed;
                }
                BlockIoResult::Ok => {
                    return Ext2InodeAllocResult::Allocated(
                        ext2_inode_owner_new(
                            bitmap_index, inode_number, inode_number));
                }
            }
        }
    }
}

fn ext2_block_number(owner: borrow Ext2BlockOwner[block]) -> usize @ block {
    return owner.witness;
}

fn ext2_inode_number(owner: borrow Ext2InodeOwner[inode]) -> usize @ inode {
    return owner.witness;
}

fn ext2_release_block(slot: borrow Ext2Slot[0], mount: Ext2Mount,
                      owner: sink Ext2BlockOwner[block])
        -> Ext2OwnerReleaseResult {
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch[slot.index].file[i] = 0; }
    match ext2_block_write(mount, owner.block_number,
                      ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_bitmap_release(slot, mount, false, owner.bitmap_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2OwnerReleaseResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => {
            return Ext2OwnerReleaseResult::Released;
        }
    }
}

private fn ext2_write_allocations_begin() -> Ext2WriteAllocations[0] {
    let mut allocations: Ext2WriteAllocations[0] = { 0 };
    return allocations;
}

// The owner moves into the transaction's recorded prefix. The transaction
// must later either release that prefix or publish every block in an inode.
private fn ext2_block_owner_staged(owner: sink Ext2BlockOwner[block]) {}

private fn ext2_write_allocations_record(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, allocations: sink Ext2WriteAllocations[0],
        owner: sink Ext2BlockOwner[block]) -> Ext2WriteRecordResult {
    let index: usize = allocations.count;
    if (index >= EXT2_MAX_WRITE_ALLOCATIONS) {
        match ext2_release_block(slot, mount, owner) {
            Ext2OwnerReleaseResult::Invalid => { }
            Ext2OwnerReleaseResult::Released => { }
        }
        return Ext2WriteRecordResult::Full(allocations);
    }
    let row: usize = slot.index * EXT2_MAX_WRITE_ALLOCATIONS + index;
    if (row >= KERNEL_MAX_CORES * EXT2_MAX_WRITE_ALLOCATIONS) {
        match ext2_release_block(slot, mount, owner) {
            Ext2OwnerReleaseResult::Invalid => { }
            Ext2OwnerReleaseResult::Released => { }
        }
        return Ext2WriteRecordResult::Full(allocations);
    }
    ext2_write_blocks[row] = owner.block_number;
    allocations.count = index + 1;
    ext2_block_owner_staged(owner);
    return Ext2WriteRecordResult::Recorded(allocations);
}

private fn ext2_write_allocations_block(slot: borrow Ext2Slot[0],
        allocations: borrow Ext2WriteAllocations[0], index: usize) -> usize {
    if (index >= allocations.count || index >= EXT2_MAX_WRITE_ALLOCATIONS) {
        return 0;
    }
    let row: usize = slot.index * EXT2_MAX_WRITE_ALLOCATIONS + index;
    if (row >= KERNEL_MAX_CORES * EXT2_MAX_WRITE_ALLOCATIONS) { return 0; }
    return ext2_write_blocks[row];
}

// Undo every staged claim: clear the bit of each, scrub the block, and then
// recount both counters from the bitmaps. True only when every clear and the
// recount completed. A failed scrub is not counted: the block is already free,
// and the scrub only keeps the staged bytes from a later owner.
private fn ext2_write_allocations_rollback(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, allocations: sink Ext2WriteAllocations[0])
        -> Ext2WriteFinishResult !{unsafe} {
    let mut settled: bool = true;
    for index: usize in 0..<EXT2_MAX_WRITE_ALLOCATIONS {
        if (index < allocations.count) {
            let block: usize = ext2_write_allocations_block(slot, allocations,
                    index);
            if (block == 0 || block >= mount.filesystem_blocks) {
                settled = false;
            } else {
                if (ext2_bitmap_force_clear(slot, mount, false,
                        block - 1) == false) {
                    settled = false;
                }
                for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                    ext2_scratch[slot.index].file[byte] = 0;
                }
                match block_write(mount.device, block,
                                  ext2_scratch[slot.index].file as []u8) {
                    BlockIoResult::Invalid => { }
                    BlockIoResult::Ok => { }
                }
            }
        }
    }
    if (ext2_recount(slot, mount) == false) { settled = false; }
    if (settled) { return Ext2WriteFinishResult::Finished; }
    for index: usize in 0..<EXT2_MAX_WRITE_ALLOCATIONS {
        if (index < allocations.count) {
            let block: usize = ext2_write_allocations_block(slot, allocations,
                    index);
            if (block != 0 && block < mount.filesystem_blocks) {
                ext2_fence_pending_add(block);
            }
        }
    }
    return Ext2WriteFinishResult::Invalid;
}

private fn ext2_write_abort(slot: borrow Ext2Slot[0], mount: Ext2Mount,
                            allocations: sink Ext2WriteAllocations[0])
        -> Ext2ResizeResult !{unsafe} {
    match ext2_write_allocations_rollback(slot, mount, allocations) {
        Ext2WriteFinishResult::Invalid => { ext2_fenced = true; }
        Ext2WriteFinishResult::Finished => { }
    }
    if (ext2_fenced) { return Ext2ResizeResult::Fenced; }
    return Ext2ResizeResult::Invalid;
}

// Exhaustion keeps its reason only after rollback has proved consistency.
private fn ext2_write_no_space_abort(slot: borrow Ext2Slot[0], mount: Ext2Mount,
                                    allocations: sink Ext2WriteAllocations[0])
        -> Ext2ResizeResult !{unsafe} {
    match ext2_write_abort(slot, mount, allocations) {
        Ext2ResizeResult::Invalid => { return Ext2ResizeResult::NoSpace; }
        Ext2ResizeResult::NoSpace => { return Ext2ResizeResult::NoSpace; }
        Ext2ResizeResult::Fenced => { return Ext2ResizeResult::Fenced; }
        Ext2ResizeResult::Resized => { return Ext2ResizeResult::Invalid; }
    }
}

private fn ext2_write_allocations_published(
        allocations: sink Ext2WriteAllocations[0]) {}

// Replace a regular file through one indirect level. Every new block is
// filled before the inode names any of them. A failed claim or data write
// rolls back the entire new set and leaves the old inode/data untouched.
fn ext2_replace_regular_file(mount: Ext2Mount, inode_number: usize,
                             source: []const u8, allocation_budget: usize)
        -> Ext2ResizeResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ResizeResult = ext2_replace_regular_file_with(slot, mount,
            inode_number, source, allocation_budget);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_replace_regular_file_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                             source: []const u8, allocation_budget: usize)
        -> Ext2ResizeResult !{unsafe} {
    return ext2_update_regular_file(slot, mount, inode_number, 0, source,
                                    false, allocation_budget);
}

fn ext2_write_regular_file_range(mount: Ext2Mount, inode_number: usize,
                                 offset: usize, source: []const u8)
        -> Ext2ResizeResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ResizeResult = ext2_write_regular_file_range_with(slot,
            mount, inode_number, offset, source);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_write_regular_file_range_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize,
                                 offset: usize, source: []const u8)
        -> Ext2ResizeResult !{unsafe} {
    if (source.len == 0) { return Ext2ResizeResult::Invalid; }
    return ext2_update_regular_file(slot, mount, inode_number, offset, source,
                                    true, EXT2_MAX_WRITE_ALLOCATIONS);
}

// GitHub issue #1023: a write past EOF (a peer fd's offset after a
// truncate) leaves a gap that reads as zeros; the old last block's bytes
// past the old size are not file data, whatever they hold. Out of line so
// ext2_update_regular_file's frame stays at its budget (#1081).
private fn ext2_zero_past_size(slot: borrow Ext2Slot[0], start: usize,
                               size: usize) !{unsafe} {
    for byte: usize in 0..<KERNEL_BLOCK_SIZE {
        if (start + byte >= size) {
            ext2_scratch[slot.index].file[byte] = 0;
        }
    }
}

// GitHub issue #1086: whether file block INDEX gets a new block in this
// update. A replace (preserve_existing false) rewrites every block; a
// write(2) copies only the blocks it changes -- the blocks it covers, and
// the old last block when its tail past the old size must become zeros --
// and keeps every other block where it is. A block it neither covers nor
// had stays a hole (pointer 0), as on Linux (#1087). The inode write stays
// the one commit point, so a failed update still leaves the old file
// exactly as it was. OLD_BLOCK is the block the file named there, 0 for a
// hole or past the old end.
private fn ext2_block_replaced(index: usize, offset: usize, length: usize,
                               old_size: usize, old_count: usize,
                               new_size: usize, old_block: usize,
                               preserve_existing: bool) -> bool {
    if (preserve_existing == false) { return true; }
    let start: usize = index * KERNEL_BLOCK_SIZE;
    if (start < offset + length && offset < start + KERNEL_BLOCK_SIZE) {
        return true;
    }
    return old_block != 0 && index + 1 == old_count && new_size > old_size &&
        old_size % KERNEL_BLOCK_SIZE != 0;
}

// GitHub issue #1087: how many of blocks FIRST..<COUNT the file names
// after an update writing LENGTH bytes at OFFSET -- the ones it had and the
// ones the update writes; the rest are holes. LENGTH 0 counts only the
// blocks old_blocks names (the file before the update). Out of line, and
// recomputed rather than kept, so ext2_update_regular_file's frame stays at
// its budget (#1081).
private fn ext2_named_blocks(old_blocks: borrow [usize; EXT2_MAX_SINGLE_FILE_BLOCKS..],
        first: usize, count: usize, offset: usize, length: usize,
        old_size: usize, old_count: usize, new_size: usize,
        preserve_existing: bool) -> usize {
    let mut named: usize = 0;
    for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
        if (index >= first && index < count &&
            (old_blocks[index] != 0 ||
             (length != 0 &&
              ext2_block_replaced(index, offset, length, old_size, old_count,
                                  new_size, old_blocks[index],
                                  preserve_existing)))) {
            named = named + 1;
        }
    }
    return named;
}

private fn ext2_update_regular_file(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_number: usize,
                                    offset: usize, source: []const u8,
                                    preserve_existing: bool,
                                    allocation_budget: usize)
        -> Ext2ResizeResult !{unsafe} {
    if (ext2_fenced) { return Ext2ResizeResult::Fenced; }
    if (source.len > EXT2_MAX_SINGLE_FILE_BLOCKS * KERNEL_BLOCK_SIZE) {
        return Ext2ResizeResult::Invalid;
    }
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2ResizeResult::Invalid; }
        Ext2InodeResult::Inode(inode) => {
            if ((inode.mode & 0xF000) != 0x8000 ||
                inode.size > EXT2_MAX_SINGLE_FILE_BLOCKS * KERNEL_BLOCK_SIZE) {
                return Ext2ResizeResult::Invalid;
            }
            let old_count: usize =
                (inode.size + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
            let mut new_size: usize = source.len;
            if (preserve_existing) {
                if (offset > EXT2_MAX_SINGLE_FILE_BLOCKS * KERNEL_BLOCK_SIZE -
                             source.len) {
                    return Ext2ResizeResult::Invalid;
                }
                new_size = offset + source.len;
                if (new_size < inode.size) { new_size = inode.size; }
            }
            let new_count: usize =
                (new_size + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
            let mut old_blocks: [usize; EXT2_MAX_SINGLE_FILE_BLOCKS];
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                old_blocks[index] = 0;
                if (index < old_count) {
                    // A hole stays 0 (#1087).
                    let mut block: usize = 0;
                    match ext2_file_block_lookup(slot, mount, inode, index) {
                        Ext2PointerResult::Invalid => {
                            return Ext2ResizeResult::Invalid;
                        }
                        Ext2PointerResult::Hole => { }
                        Ext2PointerResult::Block(named) => { block = named; }
                    }
                    for earlier: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                        if (block != 0 && earlier < index &&
                            old_blocks[earlier] == block) {
                            return Ext2ResizeResult::Invalid;
                        }
                    }
                    old_blocks[index] = block;
                }
            }
            match block_read(mount.device, inode.table_block,
                             ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => { return Ext2ResizeResult::Invalid; }
                BlockIoResult::Ok => { }
            }
            let mut inode_pointer: Ext2Bytes =
                ext2_at(ext2_metadata(), inode.table_offset);
            let old_indirect: usize = ext2_u32(slot, inode_pointer,
                    88) as usize;
            let old_double: usize = ext2_u32(slot, inode_pointer, 92) as usize;
            let old_sectors: usize = ext2_u32(slot, inode_pointer, 28) as usize;
            let mut old_pointer_blocks: usize = 0;
            if (old_indirect != 0) { old_pointer_blocks = 1; }
            if (old_double != 0 ||
                (old_count <= EXT2_MAX_DIRECT_BLOCKS && old_indirect != 0) ||
                (old_pointer_blocks == 1 &&
                 (old_indirect < 2 ||
                  old_indirect >= mount.filesystem_blocks)) ||
                old_sectors != (ext2_named_blocks(old_blocks as []usize, 0,
                        old_count, offset, 0, inode.size, old_count,
                        inode.size, false) + old_pointer_blocks) * 2) {
                return Ext2ResizeResult::Invalid;
            }
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                if (old_blocks[index] != 0 && old_blocks[index] == old_indirect) {
                    return Ext2ResizeResult::Invalid;
                }
            }

            let mut allocations: Ext2WriteAllocations[0] =
                ext2_write_allocations_begin();
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                if (index < new_count &&
                    ext2_block_replaced(index, offset, source.len, inode.size,
                            old_count, new_size, old_blocks[index], preserve_existing)) {
                    if (allocations.count >= allocation_budget) {
                        return ext2_write_abort(slot, mount, allocations);
                    }
                    match ext2_allocate_block(slot, mount) {
                        Ext2BlockAllocResult::NoSpace => {
                            return ext2_write_no_space_abort(slot, mount,
                                    allocations);
                        }
                        Ext2BlockAllocResult::Failed => {
                            return ext2_write_abort(slot, mount, allocations);
                        }
                        Ext2BlockAllocResult::Allocated(owner) => {
                            let block: usize = ext2_block_number(owner);
                            if (block < 2 || block >= mount.filesystem_blocks) {
                                match ext2_release_block(slot, mount, owner) {
                                    Ext2OwnerReleaseResult::Invalid => { }
                                    Ext2OwnerReleaseResult::Released => { }
                                }
                                return ext2_write_abort(slot, mount,
                                        allocations);
                            }
                            // Recorded before anything else can fail, so the
                            // rollback always covers this block.
                            match ext2_write_allocations_record(slot, 
                                    mount, allocations, owner) {
                                Ext2WriteRecordResult::Full(restored) => {
                                    return ext2_write_abort(slot, mount,
                                            restored);
                                }
                                Ext2WriteRecordResult::Recorded(updated) => {
                                    allocations = updated;
                                }
                            }
                            if (preserve_existing && old_blocks[index] != 0) {
                                match block_read(
                                        mount.device, old_blocks[index],
                                        ext2_scratch[slot.index].file as []u8) {
                                    BlockIoResult::Invalid => {
                                        return ext2_write_abort(slot, mount,
                                                allocations);
                                    }
                                    BlockIoResult::Ok => { }
                                }
                                ext2_zero_past_size(slot,
                                        index * KERNEL_BLOCK_SIZE, inode.size);
                            } else {
                                for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                                    ext2_scratch[slot.index].file[byte] = 0;
                                }
                            }
                            let start: usize = index * KERNEL_BLOCK_SIZE;
                            for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                                let file_position: usize = start + byte;
                                if (file_position >= offset) {
                                    let source_index: usize =
                                        ((file_position as isize) -
                                         (offset as isize)) as usize;
                                    if (source_index < source.len) {
                                        ext2_scratch[slot.index].file[byte] =
                                            source[source_index];
                                    }
                                }
                            }
                            match ext2_block_write(mount, block,
                                              ext2_scratch[slot.index].file as []u8) {
                                BlockIoResult::Invalid => {
                                    return ext2_write_abort(slot, mount,
                                            allocations);
                                }
                                BlockIoResult::Ok => { }
                            }
                        }
                    }
                }
            }
            let mut new_indirect: usize = 0;
            if (ext2_named_blocks(old_blocks as []usize,
                    EXT2_MAX_DIRECT_BLOCKS, new_count, offset, source.len,
                    inode.size, old_count, new_size, preserve_existing) != 0) {
                if (allocations.count >= allocation_budget) {
                    return ext2_write_abort(slot, mount, allocations);
                }
                match ext2_allocate_block(slot, mount) {
                    Ext2BlockAllocResult::NoSpace => {
                        return ext2_write_no_space_abort(slot, mount,
                                allocations);
                    }
                    Ext2BlockAllocResult::Failed => {
                        return ext2_write_abort(slot, mount, allocations);
                    }
                    Ext2BlockAllocResult::Allocated(owner) => {
                        new_indirect = ext2_block_number(owner);
                        if (new_indirect < 2 ||
                            new_indirect >= mount.filesystem_blocks) {
                            match ext2_release_block(slot, mount, owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            return ext2_write_abort(slot, mount, allocations);
                        }
                        match ext2_write_allocations_record(slot, 
                                mount, allocations, owner) {
                            Ext2WriteRecordResult::Full(restored) => {
                                return ext2_write_abort(slot, mount, restored);
                            }
                            Ext2WriteRecordResult::Recorded(updated) => {
                                allocations = updated;
                            }
                        }
                    }
                }
                for byte: usize in 0..<KERNEL_BLOCK_SIZE {
                    ext2_scratch[slot.index].file[byte] = 0;
                }
                let mut next: usize = 0;
                for direct: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                    if (direct < new_count &&
                        ext2_block_replaced(direct, offset, source.len,
                                inode.size, old_count, new_size,
                                old_blocks[direct], preserve_existing)) {
                        next = next + 1;
                    }
                }
                for single_index: usize in 0..<KERNEL_BLOCK_SIZE / 4 {
                    let index: usize = EXT2_MAX_DIRECT_BLOCKS + single_index;
                    if (index < new_count) {
                        let mut block: usize = old_blocks[index];
                        if (ext2_block_replaced(index, offset, source.len,
                                inode.size, old_count, new_size,
                                old_blocks[index], preserve_existing)) {
                            block = ext2_write_allocations_block(slot,
                                    allocations, next);
                            next = next + 1;
                        }
                        if ((block != 0 && block < 2) ||
                            block >= mount.filesystem_blocks ||
                            ext2_put_u32(slot, ext2_file(),
                                single_index * 4,
                                block as u32) == false) {
                            return ext2_write_abort(slot, mount, allocations);
                        }
                    }
                }
                match ext2_block_write(mount, new_indirect,
                                  ext2_scratch[slot.index].file as []u8) {
                    BlockIoResult::Invalid => {
                        return ext2_write_abort(slot, mount, allocations);
                    }
                    BlockIoResult::Ok => { }
                }
            }
            match block_read(mount.device, inode.table_block,
                             ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => {
                    return ext2_write_abort(slot, mount, allocations);
                }
                BlockIoResult::Ok => { }
            }
            let mut inode_bytes: Ext2Bytes =
                ext2_at(ext2_metadata(), inode.table_offset);
            if (ext2_u32(slot, inode_bytes, 4) as usize != inode.size ||
                ext2_u32(slot, inode_bytes, 28) as usize != old_sectors ||
                ext2_u32(slot, inode_bytes, 88) as usize != old_indirect) {
                return ext2_write_abort(slot, mount, allocations);
            }
            let mut next_direct: usize = 0;
            for index: usize in 0..<EXT2_MAX_DIRECT_BLOCKS {
                let mut block: usize = 0;
                if (index < new_count) {
                    block = old_blocks[index];
                    if (ext2_block_replaced(index, offset, source.len,
                            inode.size, old_count, new_size,
                            old_blocks[index], preserve_existing)) {
                        block = ext2_write_allocations_block(slot,
                                allocations, next_direct);
                        next_direct = next_direct + 1;
                    }
                    if ((block != 0 && block < 2) ||
                        block >= mount.filesystem_blocks) {
                        return ext2_write_abort(slot, mount, allocations);
                    }
                }
                if (ext2_put_u32(slot, inode_bytes, 40 + index * 4,
                                 block as u32) == false) {
                    return ext2_write_abort(slot, mount, allocations);
                }
            }
            let mut new_pointer_blocks: usize = 0;
            if (new_indirect != 0) { new_pointer_blocks = 1; }
            if (ext2_put_u32(slot, inode_bytes, 4, new_size as u32) == false ||
                ext2_put_u32(slot, inode_bytes, 28,
                             ((ext2_named_blocks(old_blocks as []usize, 0,
                                 new_count, offset, source.len, inode.size,
                                 old_count, new_size, preserve_existing) +
                               new_pointer_blocks) * 2) as u32) == false ||
                ext2_put_u32(slot, inode_bytes, 88,
                        new_indirect as u32) == false) {
                return ext2_write_abort(slot, mount, allocations);
            }
            match ext2_block_write(mount, inode.table_block,
                              ext2_scratch[slot.index].metadata as []u8) {
                BlockIoResult::Invalid => {
                    return ext2_write_abort(slot, mount, allocations);
                }
                BlockIoResult::Ok => { }
            }
            ext2_write_allocations_published(allocations);
            let mut released: bool = true;
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                if (old_blocks[index] != 0 &&
                    ext2_block_replaced(index, offset, source.len, inode.size,
                            old_count, new_size, old_blocks[index], preserve_existing)) {
                    let block: usize = old_blocks[index];
                    match ext2_release_block(slot, 
                            mount, ext2_block_owner_new(block - 1, block, block)) {
                        Ext2OwnerReleaseResult::Invalid => { released = false; }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                }
            }
            if (old_indirect != 0) {
                match ext2_release_block(slot, 
                        mount, ext2_block_owner_new(
                            old_indirect - 1, old_indirect, old_indirect)) {
                    Ext2OwnerReleaseResult::Invalid => { released = false; }
                    Ext2OwnerReleaseResult::Released => { }
                }
            }
            if (released == false) {
                // The inode already names the new blocks, so this is not a
                // failure to roll back: it is old space that must still be
                // given back. Clear each old bit whether or not the release
                // got that far, then recount; only a failure to do THAT
                // leaves the mount inconsistent.
                let mut settled: bool = true;
                for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                    if (old_blocks[index] != 0 &&
                        ext2_block_replaced(index, offset, source.len,
                                inode.size, old_count, new_size,
                                old_blocks[index], preserve_existing)) {
                        if (ext2_bitmap_force_clear(slot, 
                                mount, false, old_blocks[index] - 1) == false) {
                            settled = false;
                        }
                    }
                }
                if (old_indirect != 0) {
                    if (ext2_bitmap_force_clear(slot, 
                            mount, false, old_indirect - 1) == false) {
                        settled = false;
                    }
                }
                if (ext2_recount(slot, mount) == false) { settled = false; }
                if (settled == false) {
                    ext2_fenced = true;
                    for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                        if (old_blocks[index] != 0 &&
                            ext2_block_replaced(index, offset, source.len,
                                    inode.size, old_count, new_size,
                                    old_blocks[index], preserve_existing)) {
                            ext2_fence_pending_add(old_blocks[index]);
                        }
                    }
                    if (old_indirect != 0) {
                        ext2_fence_pending_add(old_indirect);
                    }
                    return Ext2ResizeResult::Fenced;
                }
            }
            return Ext2ResizeResult::Resized;
        }
    }
}


// A small exercise of the same runtime-sized owner that file replacement
// uses: two claims must be released by one rollback obligation.
fn ext2_write_allocations_roundtrip_check(mount: Ext2Mount)
        -> Ext2BitmapProbeResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2BitmapProbeResult = ext2_write_allocations_roundtrip_check_with(slot, mount);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_write_allocations_roundtrip_check_with(slot: borrow Ext2Slot[0], mount: Ext2Mount)
        -> Ext2BitmapProbeResult {
    let mut before_blocks: usize = 0;
    let mut before_inodes: usize = 0;
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            before_blocks = blocks;
            before_inodes = inodes;
        }
    }
    let mut allocations: Ext2WriteAllocations[0] =
        ext2_write_allocations_begin();
    for step: usize in 0..<2 {
        match ext2_allocate_block(slot, mount) {
            Ext2BlockAllocResult::NoSpace => {
                match ext2_write_allocations_rollback(slot, mount,
                        allocations) {
                    Ext2WriteFinishResult::Invalid => { }
                    Ext2WriteFinishResult::Finished => { }
                }
                return Ext2BitmapProbeResult::Invalid;
            }
            Ext2BlockAllocResult::Failed => {
                match ext2_write_allocations_rollback(slot, mount,
                        allocations) {
                    Ext2WriteFinishResult::Invalid => { }
                    Ext2WriteFinishResult::Finished => { }
                }
                return Ext2BitmapProbeResult::Invalid;
            }
            Ext2BlockAllocResult::Allocated(owner) => {
                match ext2_write_allocations_record(slot, mount, allocations,
                        owner) {
                    Ext2WriteRecordResult::Full(restored) => {
                        match ext2_write_allocations_rollback(slot, mount,
                                restored) {
                            Ext2WriteFinishResult::Invalid => { }
                            Ext2WriteFinishResult::Finished => { }
                        }
                        return Ext2BitmapProbeResult::Invalid;
                    }
                    Ext2WriteRecordResult::Recorded(updated) => {
                        allocations = updated;
                    }
                }
            }
        }
    }
    let first: usize = ext2_write_allocations_block(slot, allocations, 0);
    let second: usize = ext2_write_allocations_block(slot, allocations, 1);
    let mut claimed: bool = false;
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => { }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            claimed = first > 0 && second > 0 && first != second &&
                      blocks + 2 == before_blocks && inodes == before_inodes;
        }
    }
    match ext2_write_allocations_rollback(slot, mount, allocations) {
        Ext2WriteFinishResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2WriteFinishResult::Finished => { }
    }
    if (claimed == false) { return Ext2BitmapProbeResult::Invalid; }
    match ext2_free_counts_with(slot, mount) {
        Ext2FreeCountsResult::Invalid => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2FreeCountsResult::Counts(counts) => {
            let (blocks, inodes) = counts;
            if (blocks == before_blocks && inodes == before_inodes) {
                return Ext2BitmapProbeResult::Verified;
            }
        }
    }
    return Ext2BitmapProbeResult::Invalid;
}

fn ext2_release_inode(slot: borrow Ext2Slot[0], mount: Ext2Mount,
                      owner: sink Ext2InodeOwner[inode])
        -> Ext2OwnerReleaseResult {
    let byte_offset: usize = owner.bitmap_index * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        table_offset > KERNEL_BLOCK_SIZE - 128) {
        return Ext2OwnerReleaseResult::Invalid;
    }
    match block_read(mount.device, table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut inode_pointer: Ext2Bytes =
        ext2_at(ext2_metadata(), table_offset);
    for i: usize in 0..<128 { ext2_set_byte(slot, inode_pointer, i, 0); }
    match ext2_block_write(mount, table_block,
                      ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2OwnerReleaseResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    match ext2_bitmap_release(slot, mount, true, owner.bitmap_index) {
        Ext2BitmapReleaseResult::Invalid => {
            return Ext2OwnerReleaseResult::Invalid;
        }
        Ext2BitmapReleaseResult::Released => {
            return Ext2OwnerReleaseResult::Released;
        }
    }
}

fn ext2_owner_roundtrip_check(mount: Ext2Mount) -> Ext2BitmapProbeResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2BitmapProbeResult = ext2_owner_roundtrip_check_with(slot,
            mount);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_owner_roundtrip_check_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount) -> Ext2BitmapProbeResult {
    match ext2_allocate_block(slot, mount) {
        Ext2BlockAllocResult::NoSpace => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BlockAllocResult::Failed => {
            return Ext2BitmapProbeResult::Invalid;
        }
        Ext2BlockAllocResult::Allocated(block_owner) => {
            let block_number: usize = ext2_block_number(block_owner);
            if (block_number == 0) {
                match ext2_release_block(slot, mount, block_owner) {
                    Ext2OwnerReleaseResult::Invalid => { }
                    Ext2OwnerReleaseResult::Released => { }
                }
                return Ext2BitmapProbeResult::Invalid;
            }
            match ext2_allocate_inode(slot, mount) {
                Ext2InodeAllocResult::Failed => {
                    match ext2_release_block(slot, mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => { }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    return Ext2BitmapProbeResult::Invalid;
                }
                Ext2InodeAllocResult::NoSpace => {
                    match ext2_release_block(slot, mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => { }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    return Ext2BitmapProbeResult::Invalid;
                }
                Ext2InodeAllocResult::Allocated(inode_owner) => {
                    let inode_number: usize = ext2_inode_number(inode_owner);
                    if (inode_number == 0) {
                        match ext2_release_inode(slot, mount, inode_owner) {
                            Ext2OwnerReleaseResult::Invalid => { }
                            Ext2OwnerReleaseResult::Released => { }
                        }
                        match ext2_release_block(slot, mount, block_owner) {
                            Ext2OwnerReleaseResult::Invalid => { }
                            Ext2OwnerReleaseResult::Released => { }
                        }
                        return Ext2BitmapProbeResult::Invalid;
                    }
                    match ext2_release_inode(slot, mount, inode_owner) {
                        Ext2OwnerReleaseResult::Invalid => {
                            match ext2_release_block(slot, mount, block_owner) {
                                Ext2OwnerReleaseResult::Invalid => { }
                                Ext2OwnerReleaseResult::Released => { }
                            }
                            return Ext2BitmapProbeResult::Invalid;
                        }
                        Ext2OwnerReleaseResult::Released => { }
                    }
                    match ext2_release_block(slot, mount, block_owner) {
                        Ext2OwnerReleaseResult::Invalid => {
                            return Ext2BitmapProbeResult::Invalid;
                        }
                        Ext2OwnerReleaseResult::Released => {
                            return Ext2BitmapProbeResult::Verified;
                        }
                    }
                }
            }
        }
    }
}

// GitHub issue #537: the directory is a parameter, and its blocks are walked.
//
// Both of these used to read inode 2 by name and refuse a directory larger
// than one block, while `ext2_lookup_directory` next door already walked any
// directory across any number of blocks. So the kernel could find
// `/etc/init.sh` and could not create a file beside it.
//
// An ext2 directory entry never spans a block: each block is self-contained
// and its record lengths sum to exactly the block size. That is what makes
// this a per-block scan rather than a flat one over `size`, and it is why the
// modified block is the only one written back.
//
// Bounded by the singly-indirect reach (GitHub issue #968). When no block has
// room the directory grows by one, up to 268; a larger directory is refused
// rather than half-handled.
private fn ext2_directory_block_count(directory: Ext2Inode) -> usize {
    return directory.size / KERNEL_BLOCK_SIZE;
}

private fn ext2_directory_block_at(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        directory: Ext2Inode,
                                   index: usize) -> usize {
    let block: usize = ext2_inode_block_pointer(slot, mount, directory, index);
    if (block == 0 || block >= mount.filesystem_blocks) { return 0; }
    return block;
}

// A directory this code will mutate: a real directory, block-sized, and
// within the singly-indirect reach.
private fn ext2_directory_mutable(directory: Ext2Inode) -> bool {
    return (directory.mode & 0xF000) == 0x4000 &&
           directory.size >= KERNEL_BLOCK_SIZE &&
           directory.size <= ext2_max_directory_size() &&
           directory.size % KERNEL_BLOCK_SIZE == 0;
}

// GitHub issue #1120: rename to a new name, mkdir and create are all or
// nothing under a rejected write, as the releases are (#1088). Every write
// to a block already in use goes through the undo log -- the claimed
// inode's record and bit, the directory entry, a grown directory's inode
// and pointer block, the parent's link and the used-directories count. A
// block the operation claims is written while its bit is still clear, which
// nothing follows, and the bits of all of them are set last, by one write
// of the block bitmap in ext2_create_commit. That write is the commit; with
// no new block, the last logged write is. A rejected write before it puts
// the log back and leaves the claimed blocks free, so the counters, which
// move only at the recount after the commit, are never touched.
//
// The blocks one operation claims: a new file's data block or a new
// directory's block, and the block a full directory grows into with, for
// the thirteenth, its pointer block.
const EXT2_CLAIM_BLOCKS: usize = 3;

// Linear, so a create that has claimed blocks ends in ext2_create_finish,
// which commits them or leaves them free, and nowhere else.
private linear struct Ext2Claims[unit: usize] {
    private first: usize;
    private second: usize;
    private third: usize;
    private count: usize;
}

private fn ext2_claims_empty() -> Ext2Claims[0] {
    let mut claims: Ext2Claims[0] = { 0, 0, 0, 0 };
    return claims;
}

// Claims given up before anything was written.
private fn ext2_claims_unused(claims: sink Ext2Claims[0]) {}

private fn ext2_claims_block(claims: borrow Ext2Claims[0], index: usize)
        -> usize {
    if (index >= claims.count) { return 0; }
    if (index == 0) { return claims.first; }
    if (index == 1) { return claims.second; }
    if (index == 2) { return claims.third; }
    return 0;
}

private fn ext2_claims_hold(claims: borrow Ext2Claims[0], block: usize)
        -> bool {
    for index: usize in 0..<EXT2_CLAIM_BLOCKS {
        if (index < claims.count &&
            ext2_claims_block(claims, index) == block) {
            return true;
        }
    }
    return false;
}

// A free block for `claims`, chosen without writing: the first clear bit
// past the inode table that `claims` does not hold already. Uses the
// metadata buffer.
private fn ext2_claim_pick(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        claims: borrow mut Ext2Claims[0]) -> Ext2BitmapClaimResult {
    let count: usize = claims.count;
    if (count >= EXT2_CLAIM_BLOCKS) { return Ext2BitmapClaimResult::Invalid; }
    let inode_table_bytes: usize = mount.inode_count * mount.inode_size;
    let inode_table_blocks: usize =
        (inode_table_bytes + KERNEL_BLOCK_SIZE - 1) / KERNEL_BLOCK_SIZE;
    let first_block: usize = mount.inode_table_block + inode_table_blocks;
    if (first_block == 0 || first_block >= mount.filesystem_blocks ||
        mount.filesystem_blocks - 1 > KERNEL_BLOCK_SIZE * 8) {
        return Ext2BitmapClaimResult::Invalid;
    }
    match block_read(mount.device, mount.block_bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapClaimResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut index: usize = first_block - 1;
    while (index < mount.filesystem_blocks - 1) {
        let mask: u8 = (1 << ((index % 8) as u8)) as u8;
        if ((ext2_byte(slot, ext2_metadata(), index / 8) & mask) == 0 &&
            ext2_claims_hold(claims, index + 1) == false) {
            if (count == 0) { claims.first = index + 1; }
            if (count == 1) { claims.second = index + 1; }
            if (count == 2) { claims.third = index + 1; }
            claims.count = count + 1;
            return Ext2BitmapClaimResult::Claimed(index + 1);
        }
        index = index + 1;
    }
    return Ext2BitmapClaimResult::Full;
}

// Write block `block`, which `claims` holds, from the file buffer. Its bit
// is clear until the commit, so nothing reads it, and a rollback leaves it
// free with these bytes in it: an allocation zeroes a block before handing
// it out.
private fn ext2_claimed_write(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        claims: borrow Ext2Claims[0], block: usize) -> bool !{unsafe} {
    if (ext2_claims_hold(claims, block) == false) { return false; }
    match ext2_block_write(mount, block,
                           ext2_scratch[slot.index].file as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { return true; }
    }
}

// The inode a create claims, chosen without writing: the first clear bit
// from inode 11 (1..10 are reserved in revision 1). Uses the metadata
// buffer.
private fn ext2_inode_pick(slot: borrow Ext2Slot[0], mount: Ext2Mount)
        -> Ext2BitmapClaimResult {
    if (mount.inode_count > KERNEL_BLOCK_SIZE * 8) {
        return Ext2BitmapClaimResult::Invalid;
    }
    match block_read(mount.device, mount.inode_bitmap_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2BitmapClaimResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut index: usize = 10;
    while (index < mount.inode_count) {
        let mask: u8 = (1 << ((index % 8) as u8)) as u8;
        if ((ext2_byte(slot, ext2_metadata(), index / 8) & mask) == 0) {
            return Ext2BitmapClaimResult::Claimed(index + 1);
        }
        index = index + 1;
    }
    return Ext2BitmapClaimResult::Full;
}

// Logged: a claimed inode's record written whole -- mode, size, links,
// sectors and its first block pointer, everything else zero.
private fn ext2_inode_init_logged(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: borrow mut Ext2Undo[0], inode_number: usize, mode: usize,
        size: usize, links: usize, sectors: usize, block: usize)
        -> bool !{unsafe} {
    if (inode_number < 2 || inode_number > mount.inode_count ||
        mode > 0xFFFF || links > 0xFFFF || size > 0xFFFFFFFF ||
        sectors > 0xFFFFFFFF || block > 0xFFFFFFFF) {
        return false;
    }
    let byte_offset: usize = (inode_number - 1) * mount.inode_size;
    let table_block: usize = mount.inode_table_block +
                             byte_offset / KERNEL_BLOCK_SIZE;
    let table_offset: usize = byte_offset % KERNEL_BLOCK_SIZE;
    if (table_block >= mount.filesystem_blocks ||
        table_offset > KERNEL_BLOCK_SIZE - 128) {
        return false;
    }
    match block_read(mount.device, table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return false; }
        BlockIoResult::Ok => { }
    }
    if (ext2_undo_save(slot, undo, table_block, false, table_offset,
                       128) == false) {
        return false;
    }
    let mut inode_bytes: Ext2Bytes = ext2_at(ext2_metadata(), table_offset);
    for i: usize in 0..<128 { ext2_set_byte(slot, inode_bytes, i, 0); }
    if (ext2_put_u16(slot, inode_bytes, 0, mode as u16) == false ||
        ext2_put_u32(slot, inode_bytes, 4, size as u32) == false ||
        ext2_put_u16(slot, inode_bytes, 26, links as u16) == false ||
        ext2_put_u32(slot, inode_bytes, 28, sectors as u32) == false ||
        ext2_put_u32(slot, inode_bytes, 40, block as u32) == false) {
        return false;
    }
    return ext2_undo_write(slot, mount, undo, table_block, false);
}

// GitHub issue #537: a new directory's block holds `.` naming itself and
// `..` naming its parent, and the second record spans the rest of the
// block. Written to the claimed block.
private fn ext2_directory_init_claimed(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, claims: borrow Ext2Claims[0], block: usize,
        inode_number: usize, parent_inode: usize) -> bool !{unsafe} {
    if (inode_number == 0 || parent_inode == 0 ||
        inode_number > mount.inode_count) {
        return false;
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch[slot.index].file[i] = 0; }
    let mut base: Ext2Bytes = ext2_file();
    let mut parent_entry: Ext2Bytes = ext2_at(base, 12);
    if (ext2_put_u32(slot, base, 0, inode_number as u32) == false ||
        ext2_put_u16(slot, base, 4, 12) == false ||
        ext2_put_u32(slot, parent_entry, 0, parent_inode as u32) == false ||
        ext2_put_u16(slot, parent_entry, 4,
                     (KERNEL_BLOCK_SIZE - 12) as u16) == false) {
        return false;
    }
    ext2_set_byte(slot, base, 6, 1);
    ext2_set_byte(slot, base, 8, 0x2E);
    ext2_set_byte(slot, parent_entry, 6, 2);
    ext2_set_byte(slot, parent_entry, 8, 0x2E);
    ext2_set_byte(slot, parent_entry, 9, 0x2E);
    return ext2_claimed_write(slot, mount, claims, block);
}

// GitHub issue #537: the block a full directory grows into holds exactly
// one entry, the new one, whose record spans the whole block -- the shape
// ext2 requires of every block, whose record lengths sum to the block size.
//
// GitHub issue #968: block 12 onward is named by the singly-indirect block,
// as Linux's ext2 does. The thirteenth block brings that pointer block with
// it, written whole and naming only the new block, and i_blocks counts
// both. A later block is entered into the existing pointer block, whose
// slot must still be empty. Past the singly-indirect reach (this
// implementation's limit) or with no free block this answers NoSpace
// (GitHub issues #698, #968). GitHub issue #1120: the new blocks are
// claimed, the pointer-block entry and the directory's inode logged.
private fn ext2_directory_grow_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: borrow mut Ext2Undo[0],
        claims: borrow mut Ext2Claims[0], directory: Ext2Inode, blocks: usize,
        inode_number: usize, name: borrow []const u8)
        -> Ext2DirectoryAddResult !{unsafe} {
    if (blocks >= EXT2_MAX_SINGLE_FILE_BLOCKS) {
        return Ext2DirectoryAddResult::NoSpace;
    }
    if (name.len == 0 || name.len > 255) {
        return Ext2DirectoryAddResult::Invalid;
    }
    let block: usize = match ext2_claim_pick(slot, mount, claims) {
        Ext2BitmapClaimResult::Full => { return Ext2DirectoryAddResult::NoSpace; }
        Ext2BitmapClaimResult::Invalid => {
            return Ext2DirectoryAddResult::Invalid;
        }
        Ext2BitmapClaimResult::Claimed(found) => { found }
    };
    let mut indirect: usize = 0;
    if (blocks == EXT2_MAX_DIRECT_BLOCKS) {
        match ext2_claim_pick(slot, mount, claims) {
            Ext2BitmapClaimResult::Full => {
                return Ext2DirectoryAddResult::NoSpace;
            }
            Ext2BitmapClaimResult::Invalid => {
                return Ext2DirectoryAddResult::Invalid;
            }
            Ext2BitmapClaimResult::Claimed(found) => { indirect = found; }
        }
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch[slot.index].file[i] = 0; }
    let mut base: Ext2Bytes = ext2_file();
    if (ext2_put_u32(slot, base, 0, inode_number as u32) == false ||
        ext2_put_u16(slot, base, 4, KERNEL_BLOCK_SIZE as u16) == false) {
        return Ext2DirectoryAddResult::Invalid;
    }
    ext2_set_byte(slot, base, 6, name.len as u8);
    ext2_set_byte(slot, base, 7, 0);
    let data = ext2_scratch[slot.index].file as []u8;
    if (data.len < 8) { return Ext2DirectoryAddResult::Invalid; }
    let name_target = data[8..<data.len];
    if (name.len > name_target.len) { return Ext2DirectoryAddResult::Invalid; }
    slice_copy(name_target, name);
    if (ext2_claimed_write(slot, mount, claims, block) == false) {
        return Ext2DirectoryAddResult::Invalid;
    }
    if (indirect != 0) {
        for i: usize in 0..<KERNEL_BLOCK_SIZE {
            ext2_scratch[slot.index].file[i] = 0;
        }
        if (ext2_put_u32(slot, ext2_file(), 0, block as u32) == false ||
            ext2_claimed_write(slot, mount, claims, indirect) == false) {
            return Ext2DirectoryAddResult::Invalid;
        }
    }
    match block_read(mount.device, directory.table_block,
                     ext2_scratch[slot.index].metadata as []u8) {
        BlockIoResult::Invalid => { return Ext2DirectoryAddResult::Invalid; }
        BlockIoResult::Ok => { }
    }
    let mut inode_bytes: Ext2Bytes =
        ext2_at(ext2_metadata(), directory.table_offset);
    let sectors: u32 = ext2_u32(slot, inode_bytes, 28);
    // The size on disk must still be the one the walk was sized from:
    // anything else means the inode is not the directory that was just read.
    if (ext2_u32(slot, inode_bytes, 4) as usize != directory.size ||
        sectors > 0xFFFFFFFF - 4) {
        return Ext2DirectoryAddResult::Invalid;
    }
    if (blocks > EXT2_MAX_DIRECT_BLOCKS) {
        // The pointer block's entry, logged; the metadata buffer keeps the
        // inode meanwhile.
        let existing: usize = ext2_u32(slot, inode_bytes, 88) as usize;
        let entry: usize = (blocks - EXT2_MAX_DIRECT_BLOCKS) * 4;
        if (existing < 2 || existing >= mount.filesystem_blocks) {
            return Ext2DirectoryAddResult::Invalid;
        }
        match block_read(mount.device, existing,
                         ext2_scratch[slot.index].file as []u8) {
            BlockIoResult::Invalid => { return Ext2DirectoryAddResult::Invalid; }
            BlockIoResult::Ok => { }
        }
        if (ext2_u32(slot, ext2_file(), entry) != 0 ||
            ext2_undo_save(slot, undo, existing, true, entry, 4) == false ||
            ext2_put_u32(slot, ext2_file(), entry, block as u32) == false ||
            ext2_undo_write(slot, mount, undo, existing, true) == false) {
            return Ext2DirectoryAddResult::Invalid;
        }
    }
    if (ext2_undo_save(slot, undo, directory.table_block, false,
                       directory.table_offset, 128) == false) {
        return Ext2DirectoryAddResult::Invalid;
    }
    // i_blocks counts 512-byte sectors, so one 1 KiB block is two.
    let mut added_sectors: u32 = 2;
    if (blocks < EXT2_MAX_DIRECT_BLOCKS) {
        // The slot past the last block must be empty.
        let pointer_offset: usize = 40 + blocks * 4;
        if (ext2_u32(slot, inode_bytes, pointer_offset) != 0 ||
            ext2_put_u32(slot, inode_bytes, pointer_offset,
                         block as u32) == false) {
            return Ext2DirectoryAddResult::Invalid;
        }
    } else if (blocks == EXT2_MAX_DIRECT_BLOCKS) {
        if (ext2_u32(slot, inode_bytes, 88) != 0 ||
            ext2_put_u32(slot, inode_bytes, 88, indirect as u32) == false) {
            return Ext2DirectoryAddResult::Invalid;
        }
        added_sectors = 4;
    }
    if (ext2_put_u32(slot, inode_bytes, 4,
                     (directory.size + KERNEL_BLOCK_SIZE) as u32) == false ||
        ext2_put_u32(slot, inode_bytes, 28,
                     sectors + added_sectors) == false ||
        ext2_undo_write(slot, mount, undo, directory.table_block,
                        false) == false) {
        return Ext2DirectoryAddResult::Invalid;
    }
    return Ext2DirectoryAddResult::Updated;
}

// The entry `name` naming `inode_number` added to the directory, through
// the undo log: into the first record with room, or into a block the
// directory grows by (ext2_directory_grow_logged, which claims it).
//
// An ext2 directory entry never spans a block: each block is self-contained
// and its record lengths sum to exactly the block size. That is what makes
// this a per-block scan rather than a flat one over `size`. The row logged
// is the first eight bytes of the record that takes the entry: its record
// length when the entry splits off its slack, or, for a dead record, its
// inode and name length. Putting it back makes the new entry slack again.
private fn ext2_directory_add_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: borrow mut Ext2Undo[0],
        claims: borrow mut Ext2Claims[0], directory_inode: usize,
        inode_number: usize, name: borrow []const u8)
        -> Ext2DirectoryAddResult !{unsafe} {
    if (name.len == 0 || name.len > 255 || inode_number == 0 ||
        directory_inode == 0) {
        return Ext2DirectoryAddResult::Invalid;
    }
    match ext2_read_inode(slot, mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2DirectoryAddResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if (ext2_directory_mutable(directory) == false) {
                return Ext2DirectoryAddResult::Invalid;
            }
            let needed: usize = (8 + name.len + 3) & 0xFFFFFFFFFFFFFFFC;
            let blocks: usize = ext2_directory_block_count(directory);
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                if (index >= blocks) { break; }
                let block: usize =
                    ext2_directory_block_at(slot, mount, directory, index);
                if (block == 0) { return Ext2DirectoryAddResult::Invalid; }
                match block_read(mount.device, block,
                                 ext2_scratch[slot.index].file as []u8) {
                    BlockIoResult::Invalid => {
                        return Ext2DirectoryAddResult::Invalid;
                    }
                    BlockIoResult::Ok => { }
                }
                let mut base: Ext2Bytes = ext2_file();
                let mut cursor: usize = 0;
                while (cursor < KERNEL_BLOCK_SIZE) {
                    if (cursor > KERNEL_BLOCK_SIZE - 8) {
                        return Ext2DirectoryAddResult::Invalid;
                    }
                    let entry_start: usize = cursor;
                    let mut entry: Ext2Bytes = ext2_at(base, entry_start);
                    let entry_inode: usize = ext2_u32(slot, entry, 0) as usize;
                    let record_length: usize = ext2_u16(slot, entry,
                            4) as usize;
                    let name_length: usize = ext2_byte(slot, entry, 6) as usize;
                    let mut actual: usize =
                        (8 + name_length + 3) & 0xFFFFFFFFFFFFFFFC;
                    if (record_length < 8 ||
                        record_length > KERNEL_BLOCK_SIZE - entry_start ||
                        name_length > record_length - 8 ||
                        actual > record_length) {
                        return Ext2DirectoryAddResult::Invalid;
                    }
                    // A dead record -- inode zero, left behind when the first
                    // entry of a block was removed -- holds no name, so the
                    // whole record is free and the new entry takes its place
                    // rather than splitting after a name that is not there.
                    if (entry_inode == 0) { actual = 0; }
                    if (record_length - actual >= needed) {
                        let new_offset: usize = entry_start + actual;
                        let new_length: usize = record_length - actual;
                        let mut new_entry: Ext2Bytes = ext2_at(base, new_offset);
                        if (ext2_undo_save(slot, undo, block, true,
                                           entry_start, 8) == false ||
                            (actual != 0 &&
                             ext2_put_u16(slot, entry, 4,
                                     actual as u16) == false) ||
                            ext2_put_u32(slot, new_entry, 0,
                                    inode_number as u32) == false ||
                            ext2_put_u16(slot, new_entry, 4,
                                    new_length as u16) == false) {
                            return Ext2DirectoryAddResult::Invalid;
                        }
                        ext2_set_byte(slot, new_entry, 6, name.len as u8);
                        ext2_set_byte(slot, new_entry, 7, 0);
                        let data = ext2_scratch[slot.index].file as []u8;
                        if (new_offset > data.len) {
                            return Ext2DirectoryAddResult::Invalid;
                        }
                        let new_entry_bytes = data[new_offset..<data.len];
                        if (new_entry_bytes.len < 8) {
                            return Ext2DirectoryAddResult::Invalid;
                        }
                        let name_target =
                            new_entry_bytes[8..<new_entry_bytes.len];
                        if (name.len > name_target.len) {
                            return Ext2DirectoryAddResult::Invalid;
                        }
                        slice_copy(name_target, name);
                        if (ext2_undo_write(slot, mount, undo, block, true)) {
                            return Ext2DirectoryAddResult::Updated;
                        }
                        return Ext2DirectoryAddResult::Invalid;
                    }
                    cursor = cursor + record_length;
                }
            }
            return ext2_directory_grow_logged(slot, mount, undo, claims,
                    directory, blocks, inode_number, name);
        }
    }
}

// The commit of a create (GitHub issue #1120): the bit of every block
// `claims` holds set by one write of the block bitmap -- a bit found set
// already rolls back -- and then the counters recounted from the bitmaps,
// when `recount` or a block was claimed. A failed recount fences, and
// ext2_recover recounts. With no block claimed the last logged write was
// the commit.
private fn ext2_create_commit(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: sink Ext2Undo[0], claims: borrow Ext2Claims[0], recount: bool)
        -> Ext2ReleaseResult !{unsafe} {
    let count: usize = claims.count;
    if (count > 0) {
        let mut marked: bool = false;
        match block_read(mount.device, mount.block_bitmap_block,
                         ext2_scratch[slot.index].file as []u8) {
            BlockIoResult::Invalid => { }
            BlockIoResult::Ok => {
                let mut fresh: bool = true;
                for index: usize in 0..<EXT2_CLAIM_BLOCKS {
                    let block: usize = ext2_claims_block(claims, index);
                    if (index < count) {
                        if (block < 2 || block >= mount.filesystem_blocks) {
                            fresh = false;
                        } else {
                            let byte_index: usize = (block - 1) / 8;
                            let mask: u8 =
                                (1 << (((block - 1) % 8) as u8)) as u8;
                            let value: u8 =
                                ext2_byte(slot, ext2_file(), byte_index);
                            if ((value & mask) != 0 ||
                                ext2_set_byte(slot, ext2_file(), byte_index,
                                              value | mask) == false) {
                                fresh = false;
                            }
                        }
                    }
                }
                if (fresh) {
                    match ext2_block_write(mount, mount.block_bitmap_block,
                                           ext2_scratch[slot.index].file as []u8) {
                        BlockIoResult::Invalid => { }
                        BlockIoResult::Ok => { marked = true; }
                    }
                }
            }
        }
        if (marked == false) { return ext2_release_abort(slot, mount, undo); }
    }
    ext2_undo_commit(undo);
    if ((recount || count > 0) && ext2_recount(slot, mount) == false) {
        ext2_fenced = true;
    }
    return Ext2ReleaseResult::Committed;
}

// How a create ends: its log rolled back (NoSpace when the reason was a full
// bitmap or directory and the rollback landed) or committed.
must_use variant Ext2CreateStep { Invalid; NoSpace; Created; }

private fn ext2_create_finish(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: sink Ext2Undo[0], claims: sink Ext2Claims[0], linked: bool,
        no_space: bool, recount: bool) -> Ext2CreateStep !{unsafe} {
    let mut held: Ext2Claims[0] = claims;
    if (linked) {
        let committed: Ext2ReleaseResult =
            ext2_create_commit(slot, mount, undo, held, recount);
        // The claimed blocks are named by the tree now, or were never marked.
        ext2_claims_unused(held);
        return ext2_create_step(committed, no_space);
    }
    ext2_claims_unused(held);
    return ext2_create_step(ext2_release_abort(slot, mount, undo), no_space);
}

private fn ext2_create_step(result: Ext2ReleaseResult, no_space: bool)
        -> Ext2CreateStep {
    match result {
        Ext2ReleaseResult::Committed => { return Ext2CreateStep::Created; }
        Ext2ReleaseResult::RolledBack => {
            if (no_space) { return Ext2CreateStep::NoSpace; }
            return Ext2CreateStep::Invalid;
        }
        Ext2ReleaseResult::Fenced => { return Ext2CreateStep::Invalid; }
    }
}

// The entry `name` naming `inode_number` in the directory, through the undo
// log: removed when `replacement` is 0, otherwise made to name `replacement`
// in place, which is rename's replacement of an existing target (GitHub
// issue #1088) -- one write, so the target name never goes missing.
private fn ext2_directory_rewrite_logged(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, undo: borrow mut Ext2Undo[0],
        directory_inode: usize, inode_number: usize,
        name: borrow []const u8, replacement: usize)
        -> Ext2DirectoryResult !{unsafe} {
    if (name.len == 0 || name.len > 255 || inode_number == 0 ||
        directory_inode == 0) {
        return Ext2DirectoryResult::Invalid;
    }
    match ext2_read_inode(slot, mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2DirectoryResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if (ext2_directory_mutable(directory) == false) {
                return Ext2DirectoryResult::Invalid;
            }
            let blocks: usize = ext2_directory_block_count(directory);
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                if (index >= blocks) { break; }
                let block: usize =
                    ext2_directory_block_at(slot, mount, directory, index);
                if (block == 0) { return Ext2DirectoryResult::Invalid; }
                match block_read(mount.device, block,
                                 ext2_scratch[slot.index].file as []u8) {
                    BlockIoResult::Invalid => {
                        return Ext2DirectoryResult::Invalid;
                    }
                    BlockIoResult::Ok => { }
                }
                let mut base: Ext2Bytes = ext2_file();
                let mut cursor: usize = 0;
                let mut previous: usize = 0;
                let mut has_previous: bool = false;
                while (cursor < KERNEL_BLOCK_SIZE) {
                    if (cursor > KERNEL_BLOCK_SIZE - 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let mut entry: Ext2Bytes = ext2_at(base, cursor);
                    let entry_inode: usize = ext2_u32(slot, entry, 0) as usize;
                    let record_length: usize = ext2_u16(slot, entry,
                            4) as usize;
                    let name_length: usize = ext2_byte(slot, entry, 6) as usize;
                    if (record_length < 8 ||
                        record_length > KERNEL_BLOCK_SIZE - cursor ||
                        name_length > record_length - 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let data = ext2_scratch[slot.index].file as []u8;
                    // Bound to an immutable let before comparing: narrowing
                    // is immutable-only, and `cursor` is the loop's own
                    // mutable position.
                    let entry_start: usize = cursor;
                    if (entry_start > data.len) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_tail = data[entry_start..<data.len];
                    if (record_length > entry_tail.len) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_bytes = entry_tail[0..<record_length];
                    if (entry_bytes.len < 8) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_payload = entry_bytes[8..<entry_bytes.len];
                    if (name_length > entry_payload.len) {
                        return Ext2DirectoryResult::Invalid;
                    }
                    let entry_name = entry_payload[0..<name_length];
                    if (entry_inode == inode_number &&
                        ext2_name_matches(entry_name, name)) {
                        // The first entry of a block has no predecessor to
                        // absorb it, so it stays as a dead record -- inode
                        // zero, record length kept -- which lookup and
                        // getdents64 already skip and ext2_directory_add
                        // reuses. That is what Linux's ext2 does. Block 0
                        // opens with `.`, which is never removed by name.
                        // A replacement rewrites the inode field the same
                        // way, and the type byte to 0, as
                        // ext2_directory_add writes it.
                        if (replacement != 0 || has_previous == false) {
                            if ((replacement == 0 && index == 0) ||
                                ext2_undo_save(slot, undo, block, true,
                                               entry_start, 8) == false ||
                                ext2_put_u32(slot, entry, 0,
                                             replacement as u32) == false) {
                                return Ext2DirectoryResult::Invalid;
                            }
                            if (replacement != 0) {
                                ext2_set_byte(slot, entry, 7, 0);
                            }
                            if (ext2_undo_write(slot, mount, undo, block,
                                                true)) {
                                return Ext2DirectoryResult::Updated;
                            }
                            return Ext2DirectoryResult::Invalid;
                        }
                        let previous_start: usize = previous;
                        let mut previous_entry: Ext2Bytes =
                            ext2_at(base, previous_start);
                        let previous_length: usize =
                            ext2_u16(slot, previous_entry, 4) as usize;
                        if (previous_length > 0xFFFF - record_length ||
                            previous_start > KERNEL_BLOCK_SIZE - 8 ||
                            ext2_undo_save(slot, undo, block, true,
                                           previous_start + 4, 2) == false ||
                            ext2_put_u16(slot, previous_entry, 4,
                                         (previous_length + record_length) as u16) == false) {
                            return Ext2DirectoryResult::Invalid;
                        }
                        if (ext2_undo_write(slot, mount, undo, block, true)) {
                            return Ext2DirectoryResult::Updated;
                        }
                        return Ext2DirectoryResult::Invalid;
                    }
                    previous = cursor;
                    has_previous = true;
                    cursor = cursor + record_length;
                }
            }
        }
    }
    return Ext2DirectoryResult::Invalid;
}

// The live entries of a directory, across every block it occupies, with dead
// records skipped. It is the fixture's measure of "enumerated completely":
// a walk that stopped at the first block would undercount a grown directory.
fn ext2_directory_live_entries(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        directory_inode: usize)
        -> Ext2CountResult !{unsafe} {
    match ext2_read_inode(slot, mount, directory_inode) {
        Ext2InodeResult::Invalid => { return Ext2CountResult::Invalid; }
        Ext2InodeResult::Inode(directory) => {
            if (ext2_directory_mutable(directory) == false) {
                return Ext2CountResult::Invalid;
            }
            let blocks: usize = ext2_directory_block_count(directory);
            let mut live: usize = 0;
            for index: usize in 0..<EXT2_MAX_SINGLE_FILE_BLOCKS {
                if (index >= blocks) { break; }
                let block: usize =
                    ext2_directory_block_at(slot, mount, directory, index);
                if (block == 0) { return Ext2CountResult::Invalid; }
                match block_read(mount.device, block,
                                 ext2_scratch[slot.index].file as []u8) {
                    BlockIoResult::Invalid => {
                        return Ext2CountResult::Invalid;
                    }
                    BlockIoResult::Ok => { }
                }
                let mut base: Ext2Bytes = ext2_file();
                let mut cursor: usize = 0;
                while (cursor < KERNEL_BLOCK_SIZE) {
                    if (cursor > KERNEL_BLOCK_SIZE - 8) {
                        return Ext2CountResult::Invalid;
                    }
                    let mut entry: Ext2Bytes = ext2_at(base, cursor);
                    let record_length: usize = ext2_u16(slot, entry,
                            4) as usize;
                    let name_length: usize = ext2_byte(slot, entry, 6) as usize;
                    if (record_length < 8 ||
                        record_length > KERNEL_BLOCK_SIZE - cursor ||
                        name_length > record_length - 8) {
                        return Ext2CountResult::Invalid;
                    }
                    if (ext2_u32(slot, entry, 0) != 0) { live = live + 1; }
                    cursor = cursor + record_length;
                }
            }
            return Ext2CountResult::Counted(live);
        }
    }
}

fn ext2_linked_file_new(block_owner: sink Ext2BlockOwner[block],
                         inode_owner: sink Ext2InodeOwner[inode])
        -> Ext2LinkedFile[inode, block] {
    let mut linked: Ext2LinkedFile[inode, block] = {
        inode_owner.bitmap_index, block_owner.bitmap_index,
        inode_owner.witness, block_owner.witness
    };
    return linked;
}

// GitHub issue #537: create in any directory the mount can reach. The root
// form below is this one with the root named, kept because most callers mean
// the root and should not have to say 2.
// The root, named once. EXT2_ROOT_INODE is 2 by the on-disk format, not by
// this kernel's choice.
const EXT2_ROOT_INODE: usize = 2;

// Transfer a linked file's authority to its directory entry. A later
// pathname unlink derives the current blocks from the inode, including
// replacements made after publication, rather than this initial owner.
fn ext2_linked_file_keep(linked: sink Ext2LinkedFile[inode, block]) {}

fn ext2_create_root_file(mount: Ext2Mount, name: []const u8, content: []const u8)
        -> Ext2CreateResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2CreateResult = ext2_create_root_file_with(slot, mount,
            name, content);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_create_root_file_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, name: []const u8, content: []const u8)
        -> Ext2CreateResult {
    return ext2_create_file_in_with(slot, mount, EXT2_ROOT_INODE, name,
            content);
}

fn ext2_unlink_root_file(mount: Ext2Mount,
                         linked: sink Ext2LinkedFile[inode, block],
                         name: []const u8) -> Ext2UnlinkResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2UnlinkResult = ext2_unlink_root_file_with(slot, mount,
            linked, name);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_unlink_root_file_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount,
                         linked: sink Ext2LinkedFile[inode, block],
                         name: []const u8) -> Ext2UnlinkResult {
    return ext2_unlink_file_in_with(slot, mount, EXT2_ROOT_INODE, linked, name);
}

fn ext2_create_file_in(mount: Ext2Mount, directory_inode: usize,
                       name: []const u8, content: []const u8) -> Ext2CreateResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2CreateResult = ext2_create_file_in_with(slot, mount,
            directory_inode, name, content);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_create_file_in_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        directory_inode: usize,
                       name: []const u8, content: []const u8) -> Ext2CreateResult {
    // GitHub issue #1120: the data block is claimed and written, the inode
    // record, its bit and the entry logged, and the block's bit set by the
    // commit, so a rejected write leaves the disk as it was.
    if (content.len == 0 || content.len > KERNEL_BLOCK_SIZE) {
        return Ext2CreateResult::Invalid;
    }
    match ext2_lookup_directory_with(slot, mount, directory_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2CreateResult::Invalid; }
        Ext2LookupResult::Found(existing) => { return Ext2CreateResult::Invalid; }
        Ext2LookupResult::NotFound => { }
    }
    let inode_number: usize = match ext2_inode_pick(slot, mount) {
        Ext2BitmapClaimResult::Full => { return Ext2CreateResult::NoSpace; }
        Ext2BitmapClaimResult::Invalid => { return Ext2CreateResult::Invalid; }
        Ext2BitmapClaimResult::Claimed(found) => { found }
    };
    let mut claims: Ext2Claims[0] = ext2_claims_empty();
    let mut block: usize = 0;
    let mut full: bool = false;
    match ext2_claim_pick(slot, mount, claims) {
        Ext2BitmapClaimResult::Full => { full = true; }
        Ext2BitmapClaimResult::Invalid => { }
        Ext2BitmapClaimResult::Claimed(found) => { block = found; }
    }
    if (inode_number < 2 || block < 2) {
        ext2_claims_unused(claims);
        if (full) { return Ext2CreateResult::NoSpace; }
        return Ext2CreateResult::Invalid;
    }
    for i: usize in 0..<KERNEL_BLOCK_SIZE { ext2_scratch[slot.index].file[i] = 0; }
    let data = ext2_scratch[slot.index].file as []u8;
    slice_copy(data, content);
    let mut undo: Ext2Undo[0] = ext2_undo_begin();
    let mut linked: bool = false;
    let mut no_space: bool = false;
    if (ext2_claimed_write(slot, mount, claims, block) &&
        ext2_inode_init_logged(slot, mount, undo, inode_number, 0x81A4,
                               content.len, 1, 2, block) &&
        ext2_inode_bitmap_logged(slot, mount, undo, inode_number, true)) {
        match ext2_directory_add_logged(slot, mount, undo, claims,
                directory_inode, inode_number, name) {
            Ext2DirectoryAddResult::Invalid => { }
            Ext2DirectoryAddResult::NoSpace => { no_space = true; }
            Ext2DirectoryAddResult::Updated => { linked = true; }
        }
    }
    match ext2_create_finish(slot, mount, undo, claims, linked, no_space,
                             true) {
        Ext2CreateStep::Invalid => { return Ext2CreateResult::Invalid; }
        Ext2CreateStep::NoSpace => { return Ext2CreateResult::NoSpace; }
        Ext2CreateStep::Created => {
            return Ext2CreateResult::Created(ext2_linked_file_new(
                ext2_block_owner_new(block - 1, block, block),
                ext2_inode_owner_new(inode_number - 1, inode_number,
                                     inode_number)));
        }
    }
}

// GitHub issue #967: openat's O_CREAT. A new file is empty, so it takes an
// inode and no block: size 0, no block pointers, no sectors -- the shape the
// write path and the last-link unlink already accept for a file shrunk to
// nothing. NoSpace is the inode bitmap with no clear bit or a directory that
// had to grow and could not; either way the inode is released and the
// directory is unchanged. Created names the inode, which the tree owns from
// here on, as a mkdirat directory is.
must_use variant Ext2CreateEmptyResult { Invalid; NoSpace; Created(usize); }

// GitHub issue #1147: `permissions` is the new inode's permission bits
// (the low 12 of i_mode), the caller's mode with its umask applied.
fn ext2_create_empty_file_in(mount: Ext2Mount, directory_inode: usize,
                             name: borrow []const u8, permissions: usize)
        -> Ext2CreateEmptyResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2CreateEmptyResult = ext2_create_empty_file_in_with(slot,
            mount, directory_inode, name, permissions);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_create_empty_file_in_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, directory_inode: usize, name: borrow []const u8,
        permissions: usize)
        -> Ext2CreateEmptyResult !{unsafe} {
    if (ext2_fenced) { return Ext2CreateEmptyResult::Invalid; }
    match ext2_lookup_directory_with(slot, mount, directory_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2CreateEmptyResult::Invalid; }
        Ext2LookupResult::Found(existing) => {
            return Ext2CreateEmptyResult::Invalid;
        }
        Ext2LookupResult::NotFound => { }
    }
    let inode_number: usize = match ext2_inode_pick(slot, mount) {
        Ext2BitmapClaimResult::Full => { return Ext2CreateEmptyResult::NoSpace; }
        Ext2BitmapClaimResult::Invalid => {
            return Ext2CreateEmptyResult::Invalid;
        }
        Ext2BitmapClaimResult::Claimed(found) => { found }
    };
    // GitHub issue #1120: the inode record, its bit and the entry, logged.
    let mut claims: Ext2Claims[0] = ext2_claims_empty();
    let mut undo: Ext2Undo[0] = ext2_undo_begin();
    let mut linked: bool = false;
    let mut no_space: bool = false;
    if (ext2_inode_init_logged(slot, mount, undo, inode_number,
                               0x8000 | (permissions & 0xFFF), 0, 1, 0, 0) &&
        ext2_inode_bitmap_logged(slot, mount, undo, inode_number, true)) {
        match ext2_directory_add_logged(slot, mount, undo, claims,
                directory_inode, inode_number, name) {
            Ext2DirectoryAddResult::Invalid => { }
            Ext2DirectoryAddResult::NoSpace => { no_space = true; }
            Ext2DirectoryAddResult::Updated => { linked = true; }
        }
    }
    match ext2_create_finish(slot, mount, undo, claims, linked, no_space,
                             true) {
        Ext2CreateStep::Invalid => { return Ext2CreateEmptyResult::Invalid; }
        Ext2CreateStep::NoSpace => { return Ext2CreateEmptyResult::NoSpace; }
        Ext2CreateStep::Created => {
            return Ext2CreateEmptyResult::Created(inode_number);
        }
    }
}

fn ext2_unlink_file_in(mount: Ext2Mount, directory_inode: usize,
                       linked: sink Ext2LinkedFile[inode, block],
                       name: []const u8) -> Ext2UnlinkResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2UnlinkResult = ext2_unlink_file_in_with(slot, mount,
            directory_inode, linked, name);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_unlink_file_in_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        directory_inode: usize,
                       linked: sink Ext2LinkedFile[inode, block],
                       name: []const u8) -> Ext2UnlinkResult {
    // GitHub issue #1088: the same all-or-nothing release as unlink(2),
    // for the name this owner's create made.
    let inode_number: usize = linked.inode_number;
    ext2_linked_file_spent(linked);
    match ext2_lookup_directory_with(slot, mount, directory_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2UnlinkResult::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2UnlinkResult::Invalid; }
        Ext2LookupResult::Found(found) => {
            if (found != inode_number) { return Ext2UnlinkResult::Invalid; }
        }
    }
    match ext2_unlink_name_with(slot, mount, directory_inode, name) {
        Ext2UnlinkNameResult::Unlinked => { return Ext2UnlinkResult::Unlinked; }
        Ext2UnlinkNameResult::Invalid => { return Ext2UnlinkResult::Invalid; }
        Ext2UnlinkNameResult::NotFound => { return Ext2UnlinkResult::Invalid; }
        Ext2UnlinkNameResult::IsDirectory => {
            return Ext2UnlinkResult::Invalid;
        }
        Ext2UnlinkNameResult::Unsupported => {
            return Ext2UnlinkResult::Invalid;
        }
    }
}

// The file's owner ends here: the unlink above, through the log, decides
// whether its inode and block go.
private fn ext2_linked_file_spent(linked: sink Ext2LinkedFile[inode, block]) {}

// GitHub issue #537: nested directories.
//
// A new directory's block holds `.` naming itself and `..` naming its
// parent, and the second record spans the rest of the block. Its inode
// starts with two links -- the parent's entry and its own `.` -- and the
// parent gains one, for the new directory's `..`. The group descriptor's
// used-directories count moves with them; e2fsck's pass 5 compares it.
private fn ext2_linked_directory_new(block_owner: sink Ext2BlockOwner[block],
                                     inode_owner: sink Ext2InodeOwner[inode])
        -> Ext2LinkedDirectory[inode, block] {
    let mut linked: Ext2LinkedDirectory[inode, block] = {
        inode_owner.bitmap_index, block_owner.bitmap_index,
        inode_owner.witness, block_owner.witness
    };
    return linked;
}

// A directory that stays. The tree names its inode and block from here on,
// so the obligation ends without a release -- the directory counterpart of a
// file that is never unlinked.
fn ext2_directory_keep(linked: sink Ext2LinkedDirectory[inode, block]) {}

// `permissions` as ext2_create_empty_file_in's (GitHub issue #1147).
fn ext2_make_directory_in(mount: Ext2Mount, parent_inode: usize,
                          name: borrow []const u8, permissions: usize)
        -> Ext2MkdirResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2MkdirResult = ext2_make_directory_in_with(slot, mount,
            parent_inode, name, permissions);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_make_directory_in_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, parent_inode: usize,
                          name: borrow []const u8, permissions: usize)
        -> Ext2MkdirResult {
    match ext2_lookup_directory_with(slot, mount, parent_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2MkdirResult::Invalid; }
        Ext2LookupResult::Found(existing) => { return Ext2MkdirResult::Invalid; }
        Ext2LookupResult::NotFound => { }
    }
    let parent: Ext2Inode = match ext2_read_inode(slot, mount, parent_inode) {
        Ext2InodeResult::Invalid => { return Ext2MkdirResult::Invalid; }
        Ext2InodeResult::Inode(found) => { found }
    };
    // 32000 is ext2's own EXT2_LINK_MAX.
    if ((parent.mode & 0xF000) != 0x4000 || parent.links >= 32000) {
        return Ext2MkdirResult::Invalid;
    }
    let inode_number: usize = match ext2_inode_pick(slot, mount) {
        Ext2BitmapClaimResult::Full => { return Ext2MkdirResult::NoSpace; }
        Ext2BitmapClaimResult::Invalid => { return Ext2MkdirResult::Invalid; }
        Ext2BitmapClaimResult::Claimed(found) => { found }
    };
    let mut claims: Ext2Claims[0] = ext2_claims_empty();
    let mut block: usize = 0;
    let mut full: bool = false;
    match ext2_claim_pick(slot, mount, claims) {
        Ext2BitmapClaimResult::Full => { full = true; }
        Ext2BitmapClaimResult::Invalid => { }
        Ext2BitmapClaimResult::Claimed(found) => { block = found; }
    }
    if (inode_number < 2 || block < 2) {
        ext2_claims_unused(claims);
        if (full) { return Ext2MkdirResult::NoSpace; }
        return Ext2MkdirResult::Invalid;
    }
    // GitHub issue #1120: the inode record and its bit, the new block, the
    // entry, the parent's link (for the new `..`) and the used-directories
    // count, in that order, then the block's bit by the commit.
    let mut undo: Ext2Undo[0] = ext2_undo_begin();
    let mut linked: bool = false;
    let mut no_space: bool = false;
    if (ext2_inode_init_logged(slot, mount, undo, inode_number,
                               0x4000 | (permissions & 0xFFF),
                               KERNEL_BLOCK_SIZE, 2, 2, block) &&
        ext2_inode_bitmap_logged(slot, mount, undo, inode_number, true) &&
        ext2_directory_init_claimed(slot, mount, claims, block, inode_number,
                                    parent_inode)) {
        match ext2_directory_add_logged(slot, mount, undo, claims,
                parent_inode, inode_number, name) {
            Ext2DirectoryAddResult::Invalid => { }
            Ext2DirectoryAddResult::NoSpace => { no_space = true; }
            Ext2DirectoryAddResult::Updated => {
                linked = ext2_inode_links_logged(slot, mount, undo, parent,
                                                 parent.links + 1) &&
                    ext2_used_directories_logged(slot, mount, undo, true);
            }
        }
    }
    match ext2_create_finish(slot, mount, undo, claims, linked, no_space,
                             true) {
        Ext2CreateStep::Invalid => { return Ext2MkdirResult::Invalid; }
        Ext2CreateStep::NoSpace => { return Ext2MkdirResult::NoSpace; }
        Ext2CreateStep::Created => {
            return Ext2MkdirResult::Created(ext2_linked_directory_new(
                ext2_block_owner_new(block - 1, block, block),
                ext2_inode_owner_new(inode_number - 1, inode_number,
                                     inode_number)));
        }
    }
}

// Everything short of writing: the directory must be the one-block
// directory this owner made and must hold nothing but `.` and `..`.
private fn ext2_rmdir_check(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        inode_number: usize, block_number: usize) -> Ext2RmdirStep !{unsafe} {
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2RmdirStep::Refused; }
        Ext2InodeResult::Inode(directory) => {
            if ((directory.mode & 0xF000) != 0x4000 ||
                directory.size != KERNEL_BLOCK_SIZE ||
                directory.direct_block0 != block_number) {
                return Ext2RmdirStep::Refused;
            }
            match ext2_directory_live_entries(slot, mount, inode_number) {
                Ext2CountResult::Invalid => { return Ext2RmdirStep::Refused; }
                Ext2CountResult::Counted(live) => {
                    if (live != 2) { return Ext2RmdirStep::NotEmpty; }
                }
            }
            return Ext2RmdirStep::Empty(directory);
        }
    }
}

// The directory's owner ends here: from now on the tree, through the log,
// decides whether it stays.
private fn ext2_linked_directory_spent(
        linked: sink Ext2LinkedDirectory[inode, block]) {}

// GitHub issue #1088: the entry, the parent's link, the group's
// used-directories count, the inode record and its bit, all logged, then the
// block freed by the commit. A rejected write puts every one back.
private fn ext2_rmdir_release(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        parent_inode: usize, linked: sink Ext2LinkedDirectory[inode, block],
        directory: Ext2Inode, name: borrow []const u8)
        -> Ext2RmdirResult !{unsafe} {
    let inode_number: usize = linked.inode_number;
    ext2_linked_directory_spent(linked);
    let mut undo: Ext2Undo[0] = ext2_undo_begin();
    let mut unlinked: bool = false;
    match ext2_read_inode(slot, mount, parent_inode) {
        Ext2InodeResult::Invalid => { }
        Ext2InodeResult::Inode(parent) => {
            // A directory's own `.` and its entry in its parent mean it never
            // has fewer than two links.
            if ((parent.mode & 0xF000) == 0x4000 && parent.links > 2) {
                match ext2_directory_rewrite_logged(slot, mount, undo,
                        parent_inode, inode_number, name, 0) {
                    Ext2DirectoryResult::Invalid => { }
                    Ext2DirectoryResult::Updated => {
                        unlinked = ext2_inode_links_logged(slot, mount, undo,
                                parent, parent.links - 1) &&
                            ext2_used_directories_logged(slot, mount, undo, false);
                    }
                }
            }
        }
    }
    if (unlinked == false) {
        match ext2_release_abort(slot, mount, undo) {
            Ext2ReleaseResult::RolledBack => { }
            Ext2ReleaseResult::Fenced => { }
            Ext2ReleaseResult::Committed => { }
        }
        return Ext2RmdirResult::Invalid;
    }
    match ext2_release_file_logged(slot, mount, undo, directory,
                                   inode_number) {
        Ext2ReleaseResult::Committed => { return Ext2RmdirResult::Removed; }
        Ext2ReleaseResult::RolledBack => { return Ext2RmdirResult::Invalid; }
        Ext2ReleaseResult::Fenced => { return Ext2RmdirResult::Invalid; }
    }
}

private fn ext2_linked_directory_mint(inode_bitmap_index: usize,
                                      block_bitmap_index: usize,
                                      inode_number: usize @ inode,
                                      block_number: usize @ block)
        -> Ext2LinkedDirectory[inode, block] {
    let mut linked: Ext2LinkedDirectory[inode, block] = {
        inode_bitmap_index, block_bitmap_index, inode_number, block_number
    };
    return linked;
}

// GitHub issue #538: the owner of a directory made earlier and kept.
// ext2_directory_keep ended that directory's obligation when it was made, so
// a later rmdir has nothing to hand in; this mints the owner again from the
// tree -- the entry in the parent and the inode it names. `.` and `..` are
// refused here rather than only by the caller: minting an owner for `..`
// would hand a removal the parent's own parent.
//
// Minting from the tree is sound only while one core at a time reaches ext2
// mutation: two claims of the same entry would be two owners of one block.
// kernel/fs/ext2/mutation_lock.tkb is what holds that (GitHub issue #533).
// Every mutating syscall arm takes its guard, which is linear, so a path out
// of a mutation that left the lock held would not compile. That replaces
// what used to stand here: an ADMISSION claim -- every process reaching the
// filesystem admitted to core 0 only -- which was a statement about the
// scheduler that nothing in this file could check, and which issue #9
// removes. A peer READER takes no lock; it asks whether a mutation is in
// flight and is sent to core 0 if one is.
fn ext2_claim_directory(mount: Ext2Mount, parent_inode: usize,
                        name: borrow []const u8) -> Ext2ClaimResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2ClaimResult = ext2_claim_directory_with(slot, mount,
            parent_inode, name);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_claim_directory_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, parent_inode: usize,
                        name: borrow []const u8) -> Ext2ClaimResult !{unsafe} {
    if (name.len == 0) { return Ext2ClaimResult::Invalid; }
    if (name.len == 1) {
        if (name[0] == 0x2E) { return Ext2ClaimResult::Invalid; }
    }
    if (name.len == 2) {
        if (name[0] == 0x2E && name[1] == 0x2E) {
            return Ext2ClaimResult::Invalid;
        }
    }
    match ext2_lookup_directory_with(slot, mount, parent_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2ClaimResult::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2ClaimResult::NotFound; }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_read_inode(slot, mount, inode_number) {
                Ext2InodeResult::Invalid => { return Ext2ClaimResult::Invalid; }
                Ext2InodeResult::Inode(directory) => {
                    if ((directory.mode & 0xF000) != 0x4000) {
                        return Ext2ClaimResult::NotDirectory;
                    }
                    let block_number: usize = directory.direct_block0;
                    if (inode_number < 2 || block_number < 2) {
                        return Ext2ClaimResult::Invalid;
                    }
                    return Ext2ClaimResult::Claimed(ext2_linked_directory_mint(
                        inode_number - 1, block_number - 1,
                        inode_number, block_number));
                }
            }
        }
    }
}

// GitHub issue #538: unlink by name, for a file the syscall layer reaches.
// Such a file has no owner to hand in -- it came from the image or from a
// call that ended its owner -- so the owners of its blocks and inode are
// minted from the tree here, under the same one-core-at-a-time claim
// ext2_claim_directory states.
//
// A file with more than one link loses the entry and one link, which is what
// removing a BusyBox applet name is. The last link releases the data blocks
// and the inode. Their pointers are read before anything is written, because
// once the inode is released they read as zero.
//
// A symlink, or a file larger than the doubly-indirect reach, is
// Unsupported. The last link of a file reaching an indirect block releases
// its blocks through the O_TRUNC walk (GitHub issue #1020).
fn ext2_unlink_name(mount: Ext2Mount, parent_inode: usize,
                    name: borrow []const u8) -> Ext2UnlinkNameResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2UnlinkNameResult = ext2_unlink_name_with(slot, mount,
            parent_inode, name);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_unlink_name_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        parent_inode: usize,
                    name: borrow []const u8) -> Ext2UnlinkNameResult !{unsafe} {
    if (name.len == 0) { return Ext2UnlinkNameResult::Invalid; }
    if (name.len == 1) {
        if (name[0] == 0x2E) { return Ext2UnlinkNameResult::IsDirectory; }
    }
    if (name.len == 2) {
        if (name[0] == 0x2E && name[1] == 0x2E) {
            return Ext2UnlinkNameResult::IsDirectory;
        }
    }
    let mut inode_number: usize = 0;
    match ext2_lookup_directory_with(slot, mount, parent_inode, name) {
        Ext2LookupResult::Invalid => { return Ext2UnlinkNameResult::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2UnlinkNameResult::NotFound; }
        Ext2LookupResult::Found(found) => { inode_number = found; }
    }
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2UnlinkNameResult::Invalid; }
        Ext2InodeResult::Inode(file) => {
            if ((file.mode & 0xF000) == 0x4000) {
                return Ext2UnlinkNameResult::IsDirectory;
            }
            if ((file.mode & 0xF000) != 0x8000) {
                return Ext2UnlinkNameResult::Unsupported;
            }
            if (file.links == 0 || inode_number < 2) {
                return Ext2UnlinkNameResult::Invalid;
            }
            // A file that keeps another link keeps its blocks, so its size
            // is no reason to refuse -- removing a BusyBox applet name is a
            // 1 MiB file losing one of its links.
            if (file.links == 1 && file.size > ext2_max_regular_file_size()) {
                return Ext2UnlinkNameResult::Unsupported;
            }
            // GitHub issue #1088: the entry goes first, then the inode or
            // its link, all logged, so a rejected write puts the name back.
            let mut undo: Ext2Undo[0] = ext2_undo_begin();
            match ext2_directory_rewrite_logged(slot, mount, undo,
                    parent_inode, inode_number, name, 0) {
                Ext2DirectoryResult::Invalid => {
                    match ext2_release_abort(slot, mount, undo) {
                        Ext2ReleaseResult::RolledBack => { }
                        Ext2ReleaseResult::Fenced => { }
                        Ext2ReleaseResult::Committed => { }
                    }
                    return Ext2UnlinkNameResult::Invalid;
                }
                Ext2DirectoryResult::Updated => { }
            }
            return ext2_unlink_release(slot, mount, undo, file, inode_number);
        }
    }
}

// The rest of an unlink whose entry the log holds removed: one link fewer,
// or, for the last, the file released (GitHub issues #1020, #1088).
private fn ext2_unlink_release(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        undo: sink Ext2Undo[0], file: Ext2Inode, inode_number: usize)
        -> Ext2UnlinkNameResult !{unsafe} {
    let mut log: Ext2Undo[0] = undo;
    if (file.links > 1) {
        if (ext2_inode_links_logged(slot, mount, log, file,
                                    file.links - 1) == false) {
            match ext2_release_abort(slot, mount, log) {
                Ext2ReleaseResult::RolledBack => { }
                Ext2ReleaseResult::Fenced => { }
                Ext2ReleaseResult::Committed => { }
            }
            return Ext2UnlinkNameResult::Invalid;
        }
        ext2_undo_commit(log);
        return Ext2UnlinkNameResult::Unlinked;
    }
    match ext2_release_file_logged(slot, mount, log, file, inode_number) {
        Ext2ReleaseResult::Committed => { return Ext2UnlinkNameResult::Unlinked; }
        Ext2ReleaseResult::RolledBack => { return Ext2UnlinkNameResult::Invalid; }
        Ext2ReleaseResult::Fenced => { return Ext2UnlinkNameResult::Invalid; }
    }
}

// GitHub issue #1016: openat's O_TRUNC. A regular file loses its data:
// size 0, no block pointers, no sectors, and every block it named goes
// back to the bitmap -- data blocks, the singly-indirect block, and the
// doubly-indirect block with its second-level blocks. GitHub issue #1088:
// the inode write is logged and the blocks are freed after it by the one
// bitmap write that commits, so a rejected write leaves the file as it was.
// A hole (pointer 0) has nothing to release. A file already empty is
// Truncated with nothing written.
must_use variant Ext2TruncateResult { Invalid; Truncated; }

fn ext2_truncate_regular_file(mount: Ext2Mount, inode_number: usize)
        -> Ext2TruncateResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2TruncateResult = ext2_truncate_regular_file_with(slot,
            mount, inode_number);
    ext2_slot_release(slot);
    return result;
}

private fn ext2_truncate_regular_file_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, inode_number: usize)
        -> Ext2TruncateResult !{unsafe} {
    if (ext2_fenced) { return Ext2TruncateResult::Invalid; }
    if (inode_number < 2) { return Ext2TruncateResult::Invalid; }
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2TruncateResult::Invalid; }
        Ext2InodeResult::Inode(file) => {
            if ((file.mode & 0xF000) != 0x8000) {
                return Ext2TruncateResult::Invalid;
            }
            if (file.size == 0) { return Ext2TruncateResult::Truncated; }
            if (file.size > ext2_max_regular_file_size()) {
                return Ext2TruncateResult::Invalid;
            }
            match ext2_block_map_read(slot, mount, file) {
                Ext2BlockMapResult::Invalid => {
                    return Ext2TruncateResult::Invalid;
                }
                Ext2BlockMapResult::Map(map) => {
                    if (ext2_release_check(slot, mount, map) == false) {
                        return Ext2TruncateResult::Invalid;
                    }
                    let mut undo: Ext2Undo[0] = ext2_undo_begin();
                    if (ext2_inode_truncate_logged(slot, mount, undo,
                                                   file) == false) {
                        match ext2_release_abort(slot, mount, undo) {
                            Ext2ReleaseResult::RolledBack => { }
                            Ext2ReleaseResult::Fenced => { }
                            Ext2ReleaseResult::Committed => { }
                        }
                        return Ext2TruncateResult::Invalid;
                    }
                    match ext2_release_commit(slot, mount, undo, map) {
                        Ext2ReleaseResult::Committed => {
                            return Ext2TruncateResult::Truncated;
                        }
                        Ext2ReleaseResult::RolledBack => {
                            return Ext2TruncateResult::Invalid;
                        }
                        Ext2ReleaseResult::Fenced => {
                            return Ext2TruncateResult::Invalid;
                        }
                    }
                }
            }
        }
    }
}

private fn ext2_name_is_dot_entry(name: borrow []const u8) -> bool {
    if (name.len == 1) {
        if (name[0] == 0x2E) { return true; }
    }
    if (name.len == 2) {
        if (name[0] == 0x2E && name[1] == 0x2E) { return true; }
    }
    return false;
}

// GitHub issue #1088: rename over an existing regular file. The target's
// entry is made to name the source in place, the source's entry goes, and
// the target loses a link or, for its last, is released -- all through the
// undo log, so a rejected write leaves both names as they were. The old
// order (unlink the target, then add the new name) lost the target when the
// add failed.
private fn ext2_rename_over(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        old_parent: usize, old_name: borrow []const u8,
        new_parent: usize, new_name: borrow []const u8,
        inode_number: usize, target: usize) -> Ext2RenameResult !{unsafe} {
    match ext2_read_inode(slot, mount, target) {
        Ext2InodeResult::Invalid => { return Ext2RenameResult::Invalid; }
        Ext2InodeResult::Inode(file) => {
            if ((file.mode & 0xF000) != 0x8000) {
                return Ext2RenameResult::Unsupported;
            }
            if (file.links == 0 || target < 2) {
                return Ext2RenameResult::Invalid;
            }
            if (file.links == 1 && file.size > ext2_max_regular_file_size()) {
                return Ext2RenameResult::Unsupported;
            }
            let mut undo: Ext2Undo[0] = ext2_undo_begin();
            let mut moved: bool = false;
            match ext2_directory_rewrite_logged(slot, mount, undo, new_parent,
                    target, new_name, inode_number) {
                Ext2DirectoryResult::Invalid => { }
                Ext2DirectoryResult::Updated => {
                    match ext2_directory_rewrite_logged(slot, mount, undo,
                            old_parent, inode_number, old_name, 0) {
                        Ext2DirectoryResult::Invalid => { }
                        Ext2DirectoryResult::Updated => { moved = true; }
                    }
                }
            }
            if (moved == false) {
                match ext2_release_abort(slot, mount, undo) {
                    Ext2ReleaseResult::RolledBack => { }
                    Ext2ReleaseResult::Fenced => { }
                    Ext2ReleaseResult::Committed => { }
                }
                return Ext2RenameResult::Invalid;
            }
            match ext2_unlink_release(slot, mount, undo, file, target) {
                Ext2UnlinkNameResult::Unlinked => {
                    return Ext2RenameResult::Renamed;
                }
                Ext2UnlinkNameResult::Invalid => {
                    return Ext2RenameResult::Invalid;
                }
                Ext2UnlinkNameResult::NotFound => {
                    return Ext2RenameResult::Invalid;
                }
                Ext2UnlinkNameResult::IsDirectory => {
                    return Ext2RenameResult::Invalid;
                }
                Ext2UnlinkNameResult::Unsupported => {
                    return Ext2RenameResult::Invalid;
                }
            }
        }
    }
}

// GitHub issue #538: rename, composed from the add and remove the directory
// operations already have. The inode keeps its links: one name is added and
// one taken away, so no link count moves.
//
// A directory is renamed only within its own parent, where its `..` stays
// right. Moving one to another parent means rewriting its `..`, both
// parents' link counts, and refusing a move into its own subtree, and
// nothing calls for that yet, so it is Unsupported. An existing regular-file
// target is replaced, as rename(2) specifies, through ext2_rename_over; an
// existing directory target is refused. A target that already names the
// source is left alone and counts as done, as POSIX says.
fn ext2_rename_in(mount: Ext2Mount, old_parent: usize, old_name: borrow []const u8,
                  new_parent: usize, new_name: borrow []const u8)
        -> Ext2RenameResult !{unsafe} {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2RenameResult = ext2_rename_in_with(slot, mount, old_parent,
            old_name, new_parent, new_name);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_rename_in_with(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        old_parent: usize, old_name: borrow []const u8,
                  new_parent: usize, new_name: borrow []const u8)
        -> Ext2RenameResult !{unsafe} {
    if (old_name.len == 0 || new_name.len == 0 ||
        ext2_name_is_dot_entry(old_name) || ext2_name_is_dot_entry(new_name)) {
        return Ext2RenameResult::Invalid;
    }
    let mut inode_number: usize = 0;
    match ext2_lookup_directory_with(slot, mount, old_parent, old_name) {
        Ext2LookupResult::Invalid => { return Ext2RenameResult::Invalid; }
        Ext2LookupResult::NotFound => { return Ext2RenameResult::NotFound; }
        Ext2LookupResult::Found(found) => { inode_number = found; }
    }
    let mut source_is_directory: bool = false;
    match ext2_read_inode(slot, mount, inode_number) {
        Ext2InodeResult::Invalid => { return Ext2RenameResult::Invalid; }
        Ext2InodeResult::Inode(source) => {
            source_is_directory = (source.mode & 0xF000) == 0x4000;
        }
    }
    if (source_is_directory && old_parent != new_parent) {
        return Ext2RenameResult::Unsupported;
    }
    match ext2_lookup_directory_with(slot, mount, new_parent, new_name) {
        Ext2LookupResult::Invalid => { return Ext2RenameResult::Invalid; }
        Ext2LookupResult::NotFound => { }
        Ext2LookupResult::Found(target) => {
            if (target == inode_number) { return Ext2RenameResult::Renamed; }
            if ((ext2_inode_mode_with(slot, mount,
                    target) & 0xF000) == 0x4000) {
                if (source_is_directory) {
                    return Ext2RenameResult::Unsupported;
                }
                return Ext2RenameResult::IsDirectory;
            }
            if (source_is_directory) { return Ext2RenameResult::NotDirectory; }
            return ext2_rename_over(slot, mount, old_parent, old_name,
                                    new_parent, new_name, inode_number,
                                    target);
        }
    }
    return ext2_rename_new(slot, mount, old_parent, old_name, new_parent,
                           new_name, inode_number);
}

// GitHub issue #1120: rename to a name that does not exist. The new entry
// is added and the old one removed, both through the undo log (a directory
// that grows claims its block, set by the commit), so a rejected write
// leaves the old name alone, never both. The old order removed the new name
// with a forward write, and a second rejection left two names for one link.
private fn ext2_rename_new(slot: borrow Ext2Slot[0], mount: Ext2Mount,
        old_parent: usize, old_name: borrow []const u8,
        new_parent: usize, new_name: borrow []const u8, inode_number: usize)
        -> Ext2RenameResult !{unsafe} {
    let mut claims: Ext2Claims[0] = ext2_claims_empty();
    let mut undo: Ext2Undo[0] = ext2_undo_begin();
    let mut moved: bool = false;
    let mut no_space: bool = false;
    match ext2_directory_add_logged(slot, mount, undo, claims, new_parent,
                                    inode_number, new_name) {
        Ext2DirectoryAddResult::Invalid => { }
        Ext2DirectoryAddResult::NoSpace => { no_space = true; }
        Ext2DirectoryAddResult::Updated => {
            match ext2_directory_rewrite_logged(slot, mount, undo,
                    old_parent, inode_number, old_name, 0) {
                Ext2DirectoryResult::Invalid => { }
                Ext2DirectoryResult::Updated => { moved = true; }
            }
        }
    }
    match ext2_create_finish(slot, mount, undo, claims, moved, no_space,
                             false) {
        Ext2CreateStep::Invalid => { return Ext2RenameResult::Invalid; }
        Ext2CreateStep::NoSpace => { return Ext2RenameResult::NoSpace; }
        Ext2CreateStep::Created => { return Ext2RenameResult::Renamed; }
    }
}

fn ext2_remove_directory_in(mount: Ext2Mount, parent_inode: usize,
                            linked: sink Ext2LinkedDirectory[inode, block],
                            name: borrow []const u8) -> Ext2RmdirResult {
    let slot: Ext2Slot[0] = ext2_slot_acquire();
    let result: Ext2RmdirResult = ext2_remove_directory_in_with(slot, mount,
            parent_inode, linked, name);
    ext2_slot_release(slot);
    return result;
}

private inline fn ext2_remove_directory_in_with(slot: borrow Ext2Slot[0],
        mount: Ext2Mount, parent_inode: usize,
                            linked: sink Ext2LinkedDirectory[inode, block],
                            name: borrow []const u8) -> Ext2RmdirResult {
    match ext2_rmdir_check(slot, mount, linked.inode_number,
                           linked.block_number) {
        Ext2RmdirStep::Refused => { return Ext2RmdirResult::Refused(linked); }
        Ext2RmdirStep::NotEmpty => { return Ext2RmdirResult::NotEmpty(linked); }
        Ext2RmdirStep::Empty(directory) => {
            return ext2_rmdir_release(slot, mount, parent_inode, linked,
                                      directory, name);
        }
    }
}
