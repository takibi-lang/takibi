// Two-core evidence that TcpConnectionOwner is the critical section around
// one connection's multi-statement protocol-state transitions.
//
// Current limitations (2026-09-12): this uses one private connection and one
// peer. secondary.tkb admits only core 1 to this probe even when more CPUs are
// online. It tests exclusion and handoff, not network-device timing.
use "kernel/lib/execution_model.tkb";
use "kernel/net/tcp.tkb";
use "kernel/lib/atomic_word.tkb";

private let mut tcp_owner_probe_armed: usize;
private let mut tcp_owner_probe_phase: usize;
private let mut tcp_owner_probe_slot: usize;
private let mut tcp_owner_probe_generation: usize;
private let mut tcp_owner_probe_busy: usize;
private let mut tcp_owner_probe_advanced: usize;
private let mut tcp_owner_probe_active: usize;

private fn tcp_owner_probe_addr(value: *usize) -> usize { return value as usize; }

fn tcp_connection_contention_is_armed() -> bool !{unsafe} {
    return unsafe { atomic_load_acquire(tcp_owner_probe_addr(
        &tcp_owner_probe_armed)) } == 1;
}

fn tcp_connection_contention_secondary_run() !{unsafe} {
    unsafe { atomic_store_release(tcp_owner_probe_addr(
        &tcp_owner_probe_active), 1); }
    let slot: usize = unsafe { atomic_load_acquire(tcp_owner_probe_addr(
        &tcp_owner_probe_slot)) };
    let generation: usize = unsafe { atomic_load_acquire(tcp_owner_probe_addr(
        &tcp_owner_probe_generation)) };
    let phase: usize = unsafe { atomic_load_acquire(tcp_owner_probe_addr(
        &tcp_owner_probe_phase)) };
    match tcp_connection_probe_step(slot, generation) {
        TcpConnectionProbeStep::Missing => {}
        TcpConnectionProbeStep::Busy => {
            if (phase == 1) { unsafe { atomic_store_release(
                tcp_owner_probe_addr(&tcp_owner_probe_busy), 1); } }
        }
        TcpConnectionProbeStep::Advanced => {
            if (phase == 2) { unsafe { atomic_store_release(
                tcp_owner_probe_addr(&tcp_owner_probe_advanced), 1); } }
        }
    }
    unsafe {
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_active), 0);
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_armed), 0);
    }
}

private fn tcp_owner_probe_run_phase(phase: usize) -> bool !{unsafe} {
    unsafe {
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_phase), phase);
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_active), 0);
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_armed), 1);
    }
    let start: i64 = read_cntpct();
    let window: i64 = read_cntfrq() >> 1;
    while (read_cntpct() - start < window) {
        if (unsafe { atomic_load_acquire(tcp_owner_probe_addr(
                &tcp_owner_probe_armed)) } == 0) { return true; }
    }
    unsafe { atomic_store_release(tcp_owner_probe_addr(
        &tcp_owner_probe_armed), 0); }
    return false;
}

fn tcp_connection_contention_probe() -> bool !{unsafe} {
    static_assert(KERNEL_ACTIVE_CORES >= 2,
                  "TCP connection contention evidence requires one peer");
    tcp_connection_pool_init();
    let owner = match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => { return false; }
        TcpConnectionAllocResult::Allocated(value) => { value }
    };
    let slot: usize = tcp_connection_slot(owner);
    let generation: usize = tcp_connection_identity(owner);
    let before: u32 = tcp_connection_of(owner).snd_nxt;
    unsafe {
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_slot), slot);
        atomic_store_release(tcp_owner_probe_addr(
            &tcp_owner_probe_generation), generation);
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_busy), 0);
        atomic_store_release(tcp_owner_probe_addr(&tcp_owner_probe_advanced), 0);
    }
    let held_phase: bool = tcp_owner_probe_run_phase(1);
    let busy: usize = unsafe { atomic_load_acquire(tcp_owner_probe_addr(
        &tcp_owner_probe_busy)) };
    tcp_connection_put(owner);
    let released_phase: bool = tcp_owner_probe_run_phase(2);
    let advanced: usize = unsafe { atomic_load_acquire(tcp_owner_probe_addr(
        &tcp_owner_probe_advanced)) };
    let final_owner = match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => { return false; }
        TcpConnectionTakeResult::Ready(value) => { value }
    };
    let after: u32 = tcp_connection_of(final_owner).snd_nxt;
    tcp_connection_free(final_owner);
    kernel_boot_log("tcp owner contention counts: busy=");
    uart_put_udec(busy);
    kernel_boot_log(" advanced=");
    uart_put_udec(advanced);
    kernel_boot_log("\n");
    return held_phase && released_phase && busy == 1 && advanced == 1 &&
           after == before + 1;
}

// Warm, single-CPU cost samples from real TCP ownership and checksum APIs.
// Current limitations (2026-10-05): uncontended, one connection in the
// current pool; no cache-line contention or network I/O is measured.
// Execution model: core 0 owns the private connection; peers never receive
// its handle. IRQs retain their normal state except inside the pool guard.
// Timings are observations, never performance pass/fail limits. QEMU proves
// the operations and counts only; physical timing comes from the RPi5 lane.

// One record per sample keeps the boot's first marker in the bounded log.
private fn tcp_pin_cost_report(sample: usize, pin_ticks: i64,
        owner_ticks: i64, small_ticks: i64, large_ticks: i64) {
    kernel_boot_log("tcp pin cost: sample=");
    uart_put_udec(sample);
    kernel_boot_log(" rounds=4096 pin=");
    uart_put_udec(pin_ticks as usize);
    kernel_boot_log(" owner=");
    uart_put_udec(owner_ticks as usize);
    kernel_boot_log(" checksum20=");
    uart_put_udec(small_ticks as usize);
    kernel_boot_log(" checksum1480=");
    uart_put_udec(large_ticks as usize);
    kernel_boot_log(" frequency=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log("\n");
}

must_use variant TcpPinCostEvidence { Failed; Complete; }

fn tcp_pin_cost_evidence() -> TcpPinCostEvidence !{unsafe} {
    let first = match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => { return TcpPinCostEvidence::Failed; }
        TcpConnectionAllocResult::Allocated(owner) => { owner }
    };
    let address: usize = tcp_connection_slot(first);
    let generation: usize = tcp_connection_identity(first);
    tcp_connection_put(first);
    let mut ip: [u8; 20];
    let mut segment: [u8; 1480];
    for index: usize in 0..<20 { ip[index] = index as u8; }
    for index: usize in 0..<1480 { segment[index] = index as u8; }
    let mut digest: usize = 0;
    // Sample 0 also warms the paths; retain every sample rather than choosing
    // the fastest. Vary sequence bytes and consume every checksum to keep the
    // real packet work inside the loop even under LLVM optimization.
    for sample: usize in 0..<7 {
        let held = match tcp_connection_take(address, generation) {
            TcpConnectionTakeResult::Missing => { return TcpPinCostEvidence::Failed; }
            TcpConnectionTakeResult::Ready(owner) => { owner }
        };
        let pin_ticks: i64 = match tcp_connection_pin_cost(held) {
            TcpPinCostResult::Stale => {
                tcp_connection_free(held);
                return TcpPinCostEvidence::Failed;
            }
            TcpPinCostResult::Measured(ticks) => { ticks }
        };
        tcp_connection_put(held);
        let start: i64 = tcp_pin_cost_clock();
        let mut completed: usize = 0;
        for round: usize in 0..<4096 {
            match tcp_connection_take(address, generation) {
                TcpConnectionTakeResult::Missing => {}
                TcpConnectionTakeResult::Ready(owner) => {
                    completed = completed + 1;
                    tcp_connection_put(owner);
                }
            }
        }
        let owner_ticks: i64 = tcp_pin_cost_clock() - start;
        let small_start: i64 = tcp_pin_cost_clock();
        for round: usize in 0..<4096 {
            segment[4] = round as u8;
            segment[5] = (round >> 8) as u8;
            fix_tcp_checksum(ip[0..<20], segment[0..<20]);
            digest = digest + (segment[16] as usize) + (segment[17] as usize);
        }
        let small_ticks: i64 = tcp_pin_cost_clock() - small_start;
        let large_start: i64 = tcp_pin_cost_clock();
        for round: usize in 0..<4096 {
            segment[4] = round as u8;
            segment[5] = (round >> 8) as u8;
            fix_tcp_checksum(ip[0..<20], segment[0..<1480]);
            digest = digest + (segment[16] as usize) + (segment[17] as usize);
        }
        let large_ticks: i64 = tcp_pin_cost_clock() - large_start;
        if (completed != 4096 || pin_ticks <= 0 || owner_ticks <= 0 ||
                small_ticks <= 0 || large_ticks <= 0) {
            let final_owner = match tcp_connection_take(address, generation) {
                TcpConnectionTakeResult::Missing => { return TcpPinCostEvidence::Failed; }
                TcpConnectionTakeResult::Ready(owner) => { owner }
            };
            tcp_connection_free(final_owner);
            return TcpPinCostEvidence::Failed;
        }
        tcp_pin_cost_report(sample, pin_ticks, owner_ticks, small_ticks, large_ticks);
    }
    let final_owner = match tcp_connection_take(address, generation) {
        TcpConnectionTakeResult::Missing => { return TcpPinCostEvidence::Failed; }
        TcpConnectionTakeResult::Ready(owner) => { owner }
    };
    tcp_connection_free(final_owner);
    kernel_boot_log("tcp pin cost digest: ");
    uart_put_udec(digest);
    kernel_boot_log("\n");
    if (digest != 13525568) { return TcpPinCostEvidence::Failed; }
    return TcpPinCostEvidence::Complete;
}

// Current limitations (2026-10-05): online cores use distinct private
// connections, but their packed state words may share cache lines. Only the
// empty pool-lock interval isolates the global lock; owner timing includes
// validation, pin/unpin and the uncontended per-connection lock.
// Execution model: CPU 0 publishes each round; each CPU writes only its own
// mailbox. A release completion follows every result store. Padding separates
// CPU mailboxes by more than one physical cache line, even without alignment.
struct no_copy TcpPoolCostMailbox {
    address: AtomicWord;
    generation: AtomicWord;
    ready: AtomicWord;
    done: AtomicWord;
    ticks: AtomicWord;
    completed: AtomicWord;
    padding: [usize; 8];
}
private let mut tcp_pool_cost_mailboxes: [TcpPoolCostMailbox; KERNEL_MAX_CORES];
private let mut tcp_pool_cost_round: AtomicWord;
private let mut tcp_pool_cost_go: AtomicWord;
private let mut tcp_pool_cost_mode: AtomicWord;

private fn tcp_pool_cost_work(cpu: {0..<KERNEL_MAX_CORES as usize}, mode: usize)
        !{unsafe} {
    let mut completed: usize = 0;
    let mut ticks: i64 = 0;
    if (mode == 0) {
        ticks = tcp_connection_pool_lock_cost();
        completed = 4096;
    } else if (mode >= 2) {
        match pin_sharing_cycles(cpu, mode == 3) {
            TcpPinCostResult::Stale => {}
            TcpPinCostResult::Measured(value) => { ticks = value; completed = 4096; }
        }
    } else {
        let address: usize = atomic_word_load(&tcp_pool_cost_mailboxes[cpu].address);
        let generation: usize = atomic_word_load(&tcp_pool_cost_mailboxes[cpu].generation);
        let start: i64 = tcp_pin_cost_clock();
        for operation: usize in 0..<4096 {
            match tcp_connection_take(address, generation) {
                TcpConnectionTakeResult::Missing => {}
                TcpConnectionTakeResult::Ready(owner) => {
                    completed = completed + 1;
                    tcp_connection_put(owner);
                }
            }
        }
        ticks = tcp_pin_cost_clock() - start;
    }
    atomic_word_store(&tcp_pool_cost_mailboxes[cpu].ticks, ticks as usize);
    atomic_word_store(&tcp_pool_cost_mailboxes[cpu].completed, completed);
}

fn tcp_pool_cost_secondary_poll(raw_cpu: usize) !{unsafe} {
    if (raw_cpu >= KERNEL_MAX_CORES || raw_cpu == 0) { return; }
    let cpu: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    let round: usize = atomic_word_load(&tcp_pool_cost_round);
    if (round == 0 || atomic_word_load(&tcp_pool_cost_mailboxes[cpu].done) == round) {
        return;
    }
    let mode: usize = atomic_word_load(&tcp_pool_cost_mode);
    atomic_word_store(&tcp_pool_cost_mailboxes[cpu].ready, round);
    let start_ticks: usize = kernel_tick_count_of(0);
    while (atomic_word_load(&tcp_pool_cost_go) != round) {
        if (kernel_tick_count_of(0) - start_ticks > 200) {
            atomic_word_store(&tcp_pool_cost_mailboxes[cpu].completed, 0);
            atomic_word_store(&tcp_pool_cost_mailboxes[cpu].done, round);
            return;
        }
    }
    tcp_pool_cost_work(cpu, mode);
    atomic_word_store(&tcp_pool_cost_mailboxes[cpu].done, round);
}

must_use variant TcpPoolCostResult { Failed; Measured(usize); }

// Wake-and-recheck rendezvous, bounded by peer timer progress. Failure
// retains connections: it never frees storage a late participant may use.
private fn tcp_pool_cost_parallel(round: usize, mode: usize, online: usize)
        -> TcpPoolCostResult !{unsafe} {
    atomic_word_store(&tcp_pool_cost_mode, mode);
    atomic_word_store(&tcp_pool_cost_round, round);
    let mut peer_ticks: [usize; KERNEL_MAX_CORES];
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        peer_ticks[cpu] = kernel_tick_count_of(cpu);
    }
    let mut arrived: bool = false;
    while (arrived == false) {
        arrived = true;
        for cpu: usize in 1..<KERNEL_MAX_CORES {
            if (cpu < online && atomic_word_load(&tcp_pool_cost_mailboxes[cpu].ready) != round) {
                arrived = false;
                if (kernel_tick_count_of(cpu) - peer_ticks[cpu] > 200) {
                    return TcpPoolCostResult::Failed;
                }
            }
        }
    }
    atomic_word_store(&tcp_pool_cost_go, round);
    tcp_pool_cost_work(0, mode);
    atomic_word_store(&tcp_pool_cost_mailboxes[0].done, round);
    let mut joined: bool = false;
    while (joined == false) {
        joined = true;
        for cpu: usize in 1..<KERNEL_MAX_CORES {
            if (cpu < online && atomic_word_load(&tcp_pool_cost_mailboxes[cpu].done) != round) {
                joined = false;
                if (kernel_tick_count_of(cpu) - peer_ticks[cpu] > 500) {
                    return TcpPoolCostResult::Failed;
                }
            }
        }
    }
    let mut maximum: usize = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let ticks: usize = atomic_word_load(&tcp_pool_cost_mailboxes[cpu].ticks);
            if (atomic_word_load(&tcp_pool_cost_mailboxes[cpu].completed) != 4096 || ticks == 0) {
                return TcpPoolCostResult::Failed;
            }
            if (ticks > maximum) { maximum = ticks; }
        }
    }
    return TcpPoolCostResult::Measured(maximum);
}

// CPU 0 alone records these fields; combine reports with the sharing pair
// so the finite retained log gains no timing records.
struct TcpPoolCostSample {
    lock_serial: usize; lock_parallel: usize;
    owner_serial: usize; owner_parallel: usize;
}
private let mut tcp_pool_cost_samples: [TcpPoolCostSample; 3];

fn tcp_pool_cost_evidence() -> TcpPinCostEvidence !{unsafe} {
    let online: usize = kernel_online_core_count();
    if (online < 2 || online > KERNEL_MAX_CORES) { return TcpPinCostEvidence::Failed; }
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let owner = match tcp_connection_alloc() {
                TcpConnectionAllocResult::Full => { return TcpPinCostEvidence::Failed; }
                TcpConnectionAllocResult::Allocated(value) => { value }
            };
            atomic_word_store(&tcp_pool_cost_mailboxes[cpu].address, tcp_connection_slot(owner));
            atomic_word_store(&tcp_pool_cost_mailboxes[cpu].generation, tcp_connection_identity(owner));
            tcp_connection_put(owner);
        }
    }
    for sample: usize in 0..<3 {
        tcp_pool_cost_work(0, 0);
        let lock_serial: usize = atomic_word_load(&tcp_pool_cost_mailboxes[0].ticks);
        let lock_parallel: usize = match tcp_pool_cost_parallel(sample * 2 + 1, 0, online) {
            TcpPoolCostResult::Failed => { return TcpPinCostEvidence::Failed; }
            TcpPoolCostResult::Measured(value) => { value }
        };
        tcp_pool_cost_work(0, 1);
        if (atomic_word_load(&tcp_pool_cost_mailboxes[0].completed) != 4096) {
            return TcpPinCostEvidence::Failed;
        }
        let owner_serial: usize = atomic_word_load(&tcp_pool_cost_mailboxes[0].ticks);
        let owner_parallel: usize = match tcp_pool_cost_parallel(sample * 2 + 2, 1, online) {
            TcpPoolCostResult::Failed => { return TcpPinCostEvidence::Failed; }
            TcpPoolCostResult::Measured(value) => { value }
        };
        tcp_pool_cost_samples[sample].lock_serial = lock_serial;
        tcp_pool_cost_samples[sample].lock_parallel = lock_parallel;
        tcp_pool_cost_samples[sample].owner_serial = owner_serial;
        tcp_pool_cost_samples[sample].owner_parallel = owner_parallel;
    }
    atomic_word_store(&tcp_pool_cost_round, 0);
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let owner = match tcp_connection_take(
                atomic_word_load(&tcp_pool_cost_mailboxes[cpu].address),
                atomic_word_load(&tcp_pool_cost_mailboxes[cpu].generation)) {
                TcpConnectionTakeResult::Missing => { return TcpPinCostEvidence::Failed; }
                TcpConnectionTakeResult::Ready(value) => { value }
            };
            tcp_connection_free(owner);
        }
    }
    return TcpPinCostEvidence::Complete;
}

// Compare paired layouts in alternating order, keeping the global pool lock,
// one-chunk validation path and payload-free work identical.
fn pin_sharing_evidence() -> TcpPinCostEvidence !{unsafe} {
    let baseline: usize = page_allocator_live_count();
    match pin_sharing_setup() {
        PinSharingSetupResult::NoMemory => { return TcpPinCostEvidence::Failed; }
        PinSharingSetupResult::InvalidLayout => { return TcpPinCostEvidence::Failed; }
        PinSharingSetupResult::Ready => {}
    }
    let online: usize = kernel_online_core_count();
    for sample: usize in 0..<3 {
        let mut shared: usize = 0;
        let mut separate: usize = 0;
        for order: usize in 0..<2 {
            let mode: usize = 2 + ((sample + order) & 1);
            let ticks: usize = match tcp_pool_cost_parallel(7 + sample * 2 + order, mode, online) {
                TcpPoolCostResult::Failed => { return TcpPinCostEvidence::Failed; }
                TcpPoolCostResult::Measured(value) => { value }
            };
            if (mode == 2) { shared = ticks; } else { separate = ticks; }
        }
        kernel_boot_log("tcp pool cost: sample="); uart_put_udec(sample);
        kernel_boot_log(" cores="); uart_put_udec(online);
        kernel_boot_log(" rounds=4096 lock="); uart_put_udec(tcp_pool_cost_samples[sample].lock_serial);
        kernel_boot_log("/"); uart_put_udec(tcp_pool_cost_samples[sample].lock_parallel);
        kernel_boot_log(" owner="); uart_put_udec(tcp_pool_cost_samples[sample].owner_serial);
        kernel_boot_log("/"); uart_put_udec(tcp_pool_cost_samples[sample].owner_parallel);
        kernel_boot_log(" sharing="); uart_put_udec(shared);
        kernel_boot_log("/"); uart_put_udec(separate);
        kernel_boot_log(" frequency="); uart_put_udec(read_cntfrq() as usize);
        kernel_boot_log("\n");
    }
    atomic_word_store(&tcp_pool_cost_round, 0);
    match pin_sharing_cleanup() {
        PinSharingCleanupResult::Busy => { return TcpPinCostEvidence::Failed; }
        PinSharingCleanupResult::InvalidChunk => { return TcpPinCostEvidence::Failed; }
        PinSharingCleanupResult::Released => {}
    }
    if (page_allocator_live_count() != baseline) { return TcpPinCostEvidence::Failed; }
    return TcpPinCostEvidence::Complete;
}
