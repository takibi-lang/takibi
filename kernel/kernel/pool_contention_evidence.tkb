// GitHub issue #445's remaining acceptance criterion: two cores contending
// on one pool, allocating and freeing concurrently, in a test that FAILS
// when the acquire is removed. Since GitHub issue #745 the pool is the
// built-in RegionPool and a cycle is the process records' lifecycle:
// allocate, hold, take the held permission back, free.
//
// It could not be written before #447 -- there was no second core running
// kernel code to contend with. What it establishes is the one thing the
// spinlock has never had evidence for: that it excludes. Everything so far
// has been single-threaded exercise (linux_user/spinlock's "a second
// attempt must fail") and a check on emitted instructions
// (check_spinlock_is_atomic). Both are real and neither is contention.
//
// The pool is this file's own, not one the kernel uses. That is not
// squeamishness: a probe that hammered a live pool would be measuring the
// lock AND whatever else touches that pool, and a failure would not be
// attributable to either.
//
// Current limitations:
// - MEASURES EXCLUSION, NOT ORDERING. Two cores cycling a slot prove a
//   second holder cannot exist; they say nothing about whether a write
//   before the release is visible after the next acquire. That is the
//   release/acquire pair's job and it is checked where it is emitted
//   (scripts/check_kernel_asm_invariants.py's spin_unlock stlr line).
// - RUNS ONCE, AT BOOT, for a bounded number of rounds. Not a soak test:
//   a race this misses on one boot it may miss on every boot. What it is
//   for is the substitution -- remove the acquire and it fails -- which is
//   deterministic in a way the race itself is not.
// - THE SECONDARY CORE MUST NOT REACH THE PAGE ALLOCATOR. A RegionPool
//   grows only when asked and never shrinks on its own, so core 0 grows
//   the pool's one chunk before anything is armed and a cycle that finds
//   it Full fails rather than growing. CONTENTION_FLOOR keeps slots Held
//   for the whole run, as process records are.
// - The two cores run for different lengths. Core 0 does a fixed number of
//   rounds and then disarms; core 1 spins on the armed flag and stops when
//   it clears. So the cycle counts are not comparable and nothing here
//   claims they are -- what matters is that BOTH advanced, which is what
//   makes it contention rather than one core taking turns with itself.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
struct ContentionItem {
    stamp: usize;
}

// How many slots stay allocated for the whole run. Their only job is to
// keep every chunk non-empty, so that a cycle's free never releases a page.
const CONTENTION_FLOOR: usize = 4;

// Core 0's rounds. Large enough that core 1 gets many chances to be inside
// the lock at the same time, small enough not to lengthen the boot.
const CONTENTION_ROUNDS: usize = 4096;

// Work each core does OUTSIDE the lock, per cycle.
//
// Not padding, and not a timing hack. Measured on RPi5: with both cores
// re-acquiring the instant they release, core 0 completed 4096 cycles and
// core 1 completed ONE. Reversing which core had the gap reversed the
// result -- 892134 to 4096 the other way. The lock excludes and does not
// arbitrate, so whichever core loops tightest owns it, and a probe with no
// work outside the lock measures that monopoly rather than the lock.
//
// QEMU hid this completely (4096 vs 4110), because its round-robin vCPU
// scheduling supplies a fairness the hardware does not. Which is the
// clearest argument this file could carry for why the criterion named real
// hardware.
//
// The unfairness itself is real and is filed separately; it is a property
// of a test-and-set lock, not a defect in this probe. What the probe owes
// is not to depend on it.
const CONTENTION_OUTSIDE_WORK: usize = 64;

private let mut contention_pool: RegionPool(ContentionItem);
private let mut contention_pool_ready: bool = false;
private let mut contention_pool_grown: bool = false;
const CONTENTION_CHUNK_PAGES: usize = 1;

// The handshake and the results. Atomics, not `io`, because these are read
// and written by two cores at the same time -- which is the one situation
// volatile does not cover.
private let mut contention_armed: AtomicWord;
// Completed cycles and the inside-the-run level, one word per core
// (GitHub issue #756: every online peer, index 0 is core 0's). A peer's
// level is 1 while it is inside its cycle loop. Core 0 waits for every
// level rather than for a duration, because "a peer is between an
// allocate and its free" and "every peer has stopped" are different states
// and only one of them makes live_count meaningful.
private let mut contention_tally: PeerTally;
private let mut contention_failed_removes: AtomicWord;
// The slowest peer's count at the moment the primary stopped competing.
private let mut contention_overlap: AtomicWord;

private fn contention_armed_address() -> *AtomicWord {
    return &contention_armed;
}

private fn contention_failed_removes_address() -> *AtomicWord {
    return &contention_failed_removes;
}

private fn contention_overlap_address() -> *AtomicWord {
    return &contention_overlap;
}


private fn contention_pool_lock()
        -> RegionPoolGuard(ContentionItem)[&contention_pool] !{unsafe, acquires_lock_40_contention_pool, single_instance_lock,
          lock_guard_40_contention_pool} {
    let flags: usize = mutex_irq_save();
    return region_pool_lock_saving(&contention_pool, flags);
}

private fn contention_pool_unlock(
        guard: sink RegionPoolGuard(ContentionItem)[&contention_pool]) {
    mutex_irq_restore(region_pool_unlock_saved(guard));
}

// Core 0 only, before arming: the pool's one chunk.
private fn contention_pool_init() !{unsafe} {
    if (contention_pool_ready) { return; }
    contention_pool_ready = true;
    match page_alloc_contiguous(CONTENTION_CHUNK_PAGES, PageOwnerTag::PoolChunk) {
        PageRunAllocResult::OutOfMemory => {}
        PageRunAllocResult::Allocated(run_owner) => {
            let base: usize = page_run_physical_address(run_owner);
            let RegionBytes::Assumed(chunk) = page_run_into_region(run_owner) else {};
            let guard = contention_pool_lock();
            match region_pool_grow(guard, chunk) {
                RegionGrow(ContentionItem)::Grown => { contention_pool_grown = true; }
                RegionGrow(ContentionItem)::TooSmall(back) => {
                    region_release(back);
                    page_run_transferred_release_physical(base, CONTENTION_CHUNK_PAGES);
                }
            }
            contention_pool_unlock(guard);
        }
    }
}

// A slot allocated and Held, or none when the pool is full.
private fn contention_hold() -> RegionHeld(ContentionItem) !{unsafe} {
    let guard = contention_pool_lock();
    let mut held: RegionHeld(ContentionItem) = region_held_none__ContentionItem();
    match region_alloc(guard) {
        RegionPoolAlloc(ContentionItem)::Full => {}
        RegionPoolAlloc(ContentionItem)::Exhausted => {}
        RegionPoolAlloc(ContentionItem)::Allocated(slot) => {
            held = region_hold(guard, slot);
        }
    }
    contention_pool_unlock(guard);
    return held;
}

// The held permission back out and freed; false when it was not Held.
private fn contention_release(held: RegionHeld(ContentionItem)) -> bool !{unsafe} {
    let guard = contention_pool_lock();
    match region_take_held(guard, held) {
        RegionTake(ContentionItem)::Stale => {
            contention_pool_unlock(guard);
            return false;
        }
        RegionTake(ContentionItem)::Taken(slot) => {
            region_free(guard, slot);
            contention_pool_unlock(guard);
            return true;
        }
    }
}

private fn contention_live_count() -> usize !{unsafe} {
    let guard = contention_pool_lock();
    let held: usize = region_pool_held_count(guard);
    contention_pool_unlock(guard);
    return held;
}

// One allocate/free cycle. Both cores run THIS function, which is the
// point: the same code, the same pool, the same lock, at the same time.
//
// A refused take is the direct symptom of a lost race. If two cores are
// handed the same slot, one of them takes its permission back and frees it
// and the other's take finds it no longer Held under its generation --
// Stale -- rather than corrupting anything. The pool refusing is itself
// the detector, which is why this counts refusals rather than trying to
// catch the overlap.
private fn contention_cycle() -> bool !{unsafe} {
    let mut held: RegionHeld(ContentionItem) = contention_hold();
    if (region_held_address(held) == 0) { return false; }
    if (contention_release(held) == false) {
        atomic_word_fetch_add(contention_failed_removes_address(), 1);
        return false;
    }
    // Outside the lock, on both cores, for the reason
    // CONTENTION_OUTSIDE_WORK states.
    for spin: usize in 0..<CONTENTION_OUTSIDE_WORK { }
    return true;
}

// Called by the secondary core from its idle loop. Spins while core 0 keeps
// it armed, so the two are inside the same lock at the same time rather
// than taking turns a timer tick apart.
fn pool_contention_secondary_run(cpu: usize) !{unsafe} {
    if (peer_tally_is_peer(&contention_tally, cpu) == false) { return; }
    peer_tally_enter(&contention_tally, cpu);
    // Complete one cycle, then WAIT for the primary to have started.
    // GitHub issue #510: this is the second half of the start handshake
    // kernel/kernel/fd_table.tkb's probe already had and this one did not.
    // This core is driven from the idle loop in
    // kernel/arch/arm64/kernel/secondary.tkb, which re-enters an armed
    // probe after every `wfi` wake, so without the wait it can run every
    // round and leave before core 0 gets a slice -- and then `active` is
    // back to 0, core 0's entry poll below reports
    // `secondary-never-entered` about a core that did all of its work, and
    // the overlap it would otherwise have asserted covers a phase the two
    // cores never shared. A cycle that comes back false took no slot and
    // is not a round, so this retries rather than publishing one it did
    // not complete.
    while (peer_tally_count(&contention_tally, cpu) == 0 &&
           atomic_word_load(contention_armed_address()) == 1) {
        if (contention_cycle()) { peer_tally_add(&contention_tally, cpu); }
    }
    while (peer_tally_count(&contention_tally, 0) == 0 &&
           atomic_word_load(contention_armed_address()) == 1) { }
    // The SAME count the primary does, so the verdict is not a comparison
    // between two numbers that depend on how fast each core happened to
    // run. Stops early only if the primary gives up on it.
    while (peer_tally_count(&contention_tally, cpu) < CONTENTION_ROUNDS &&
           atomic_word_load(contention_armed_address()) == 1) {
        if (contention_cycle()) { peer_tally_add(&contention_tally, cpu); }
    }
    // Released AFTER the last cycle's free, so a core 0 that sees zero
    // here knows every slot this core took is back.
    peer_tally_leave(&contention_tally, cpu);
}

// Armed for `cpu` only while it still has work (GitHub issue #860).
fn pool_contention_is_armed(cpu: usize) -> bool !{unsafe} {
    return atomic_word_load(contention_armed_address()) == 1 &&
           peer_tally_count(&contention_tally, cpu) < CONTENTION_ROUNDS;
}

// Every number this probe knows, printed on EVERY exit path including the
// ones that give up. The first version printed them only after the last
// bounded wait succeeded, so the run that most needed the evidence -- a
// deliberately broken lock -- produced a boot that stopped with no counts
// at all. A diagnostic that vanishes exactly when it fires is worse than
// none, because it looks like a hang of unknown origin.
private fn contention_report(stage: *u8) !{unsafe} {
    // The stage is stable across boots and the numbers are not, so they
    // are two lines: a view can compare the first and a human reads the
    // second.
    kernel_boot_log("pool contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("pool contention counts:");
    peer_tally_put_counts(&contention_tally);
    kernel_boot_log(" refused=");
    uart_put_udec(atomic_word_load(contention_failed_removes_address()));
    kernel_boot_log(" live=");
    uart_put_udec(contention_live_count());
    kernel_boot_log(" overlap=");
    uart_put_udec(atomic_word_load(contention_overlap_address()));
    kernel_boot_log("\n");
}

// Core 0's half, and the verdict. Returns true when both cores cycled, no
// remove was refused, and the pool came back to exactly the floor.
fn pool_contention_probe() -> bool !{unsafe} {
    contention_pool_init();

    // The floor. Allocated before anything is armed and held for the whole
    // run, so no chunk ever empties and no cycle reaches the page
    // allocator. Their addresses are kept so they can be given back.
    let mut floor: [RegionHeld(ContentionItem); CONTENTION_FLOOR];
    let mut held: usize = 0;
    if (contention_pool_grown == false) {
        contention_report("floor" as *u8);
        return false;
    }
    for i: usize in 0..<CONTENTION_FLOOR {
        // Indexed by the loop variable, not by `held`: `i` carries the
        // proven range and `held` does not, which the trap-site rejection says out
        // loud. They are equal on every path that reaches the check below.
        floor[i] = contention_hold();
        if (region_held_address(floor[i]) != 0) { held = held + 1; }
    }
    if (held != CONTENTION_FLOOR) {
        contention_report("floor" as *u8);
        return false;
    }

    // GitHub issue #745: the pool-operation cost, recorded rather than
    // judged -- CONTENTION_ROUNDS uncontended allocate/hold/take-back/free
    // cycles on core 0, before the secondary is armed.
    let cost_start: i64 = read_cntpct();
    let mut cost_cycles: usize = 0;
    for round: usize in 0..<CONTENTION_ROUNDS {
        if (contention_cycle()) { cost_cycles = cost_cycles + 1; }
    }
    let cost_ticks: i64 = read_cntpct() - cost_start;
    kernel_boot_log("RECORDED pool cycle timing: cycles=");
    uart_put_udec(cost_cycles);
    kernel_boot_log(" ticks=");
    uart_put_udec(cost_ticks as usize);
    kernel_boot_log(" freq=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log("\n");

    peer_tally_reset(&contention_tally, kernel_online_core_count());
    atomic_word_store(contention_overlap_address(), 0);
    atomic_word_store(contention_armed_address(), 1);

    // Wait for every peer to be IN, before starting. Arming and
    // immediately running was the first version and it measured nothing:
    // a peer sits in `wfi` and wakes only on its own timer, so a window
    // shorter than one tick period closed before it ever looked. 4096
    // rounds take far less than the 15.6 ms tick, so `secondary=0` was the
    // honest answer to a question that had not been asked.
    //
    // A COMPLETED cycle on each peer, not the `active` flag. GitHub issue
    // #510: `active` is a level a peer clears on its way out, so polling it
    // asks whether that core is inside the loop at this instant, and the
    // question this gate needs answered is whether it was ever there. Each
    // wait is bounded by that peer's own ticks, so one that never arrives
    // fails the probe rather than hanging the boot.
    if (peer_tally_peers_reached(&contention_tally, 1,
                                 PeerTickPolicy::Entry) == false) {
        atomic_word_store(contention_armed_address(), 0);
        contention_report("secondary-never-entered" as *u8);
        return false;
    }

    for round: usize in 0..<CONTENTION_ROUNDS {
        if (contention_cycle()) { peer_tally_add(&contention_tally, 0); }
    }

    // THE OVERLAP, read the moment the primary stops competing: the least
    // number of cycles any peer completed while the primary was also inside
    // this lock. Reported rather than asserted at a value -- with two cores
    // it was 4110 on QEMU and 44 on RPi5, because the lock excludes without
    // arbitrating and the emulator supplies a fairness the hardware does
    // not. What is asserted is only that it is not zero, which is what
    // makes the run contention among every online core rather than cores
    // taking turns.
    atomic_word_store(contention_overlap_address(),
                      peer_tally_peers_least(&contention_tally));

    // Now let every peer reach the same count, unimpeded. Bounded, so a
    // peer that cannot get there fails the probe instead of hanging the
    // boot -- generous, because how long this takes is exactly the thing
    // that varies between a board and an emulator.
    let finished: bool = peer_tally_peers_reached(
        &contention_tally, CONTENTION_ROUNDS, PeerTickPolicy::Finish);
    atomic_word_store(contention_armed_address(), 0);
    if (finished == false) {
        contention_report("secondary-never-finished" as *u8);
        return false;
    }

    // Wait for every peer to actually be out of its loop, rather than for
    // a duration. One may be holding a slot right now, and freeing the
    // floor and reading live_count underneath it would report a leak that
    // is really a core still working. Bounded by each peer's ticks, not by
    // a spin count (GitHub issue #510: 4096 empty iterations expired on a
    // busy host before core 1 had been scheduled at all), and it REPORTS:
    // this was once the one exit path here that returned false in silence.
    if (peer_tally_peers_left(&contention_tally,
                              PeerTickPolicy::Entry) == false) {
        contention_report("secondary-never-left" as *u8);
        return false;
    }

    for i: usize in 0..<CONTENTION_FLOOR {
        if (contention_release(floor[i]) == false) {
            contention_report("floor-not-returned" as *u8);
            return false;
        }
    }

    contention_report("complete" as *u8);
    let primary: usize = peer_tally_count(&contention_tally, 0);
    let peers_least: usize = peer_tally_peers_least(&contention_tally);
    let refused: usize = atomic_word_load(contention_failed_removes_address());
    let overlap: usize = atomic_word_load(contention_overlap_address());
    let live: usize = contention_live_count();
    return primary == CONTENTION_ROUNDS && peers_least == CONTENTION_ROUNDS &&
           overlap > 0 && refused == 0 && live == 0;
}
