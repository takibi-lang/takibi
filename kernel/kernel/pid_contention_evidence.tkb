// GitHub issue #479 Group B: two cores minting a pid at once.
//
// The unlocked phase deliberately splits the production counter's read and
// write and rendezvouses both cores between them. It must lose exactly one
// update per round. The locked phase runs the ordinary production mint after
// the same per-round rendezvous and must lose none. What the race costs: two
// processes carrying one pid, and every accounting this kernel does by pid
// -- wait4 by pid, the process tree walk, ps -- becomes a question with two
// answers.
//
// The detector is the counter's own arithmetic: each mint advances it by
// exactly one, so the controlled unlocked phase advances once for each pair
// while the locked phase advances once for each call. "Number of mints" is
// this probe's OWN pair of atomic counters, never the kernel's, for the
// reason the asid probe learned -- a counter on the racing path loses
// increments to the race it is being used to detect.
//
// Current limitations:
// - IT PUTS THE COUNTER BACK. A pid appears in the process-lifecycle
//   views, in ps and in every wait4 line, so a probe that consumed
//   thousands of real numbers would move every later process's pid and
//   break views with nothing to do with it -- issue #437 moved PID 1 once
//   and 17 of 39 views changed. Nothing was created here, so nothing is
//   owed those numbers. The restore is stated rather than quiet because it
//   IS a mutation of kernel state for a test's convenience.
// - The unlocked begin/commit pair is an unsafe test-only escape through
//   LockedCell. Its pending value is linear, so every path commits or
//   cancels it, and ordinary PID allocation cannot call the split path.
// - Measures exclusion, not ordering.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/kernel/process.tkb";
use "kernel/lib/execution_model.tkb";

const PID_CONTENTION_ROUNDS: usize = 2048;
const PID_CONTENTION_OUTSIDE_WORK: usize = 64;

must_use variant PidProbeRendezvousResult {
    Met;
    TimedOut;
}

private let mut pid_probe_armed: AtomicWord;
private let mut pid_probe_primary: AtomicWord;
private let mut pid_probe_secondary: AtomicWord;
private let mut pid_probe_active: AtomicWord;
private let mut pid_probe_overlap: AtomicWord;
private let mut pid_probe_primary_arrived: AtomicWord;
private let mut pid_probe_secondary_arrived: AtomicWord;
private let mut pid_probe_primary_committed: AtomicWord;
private let mut pid_probe_secondary_committed: AtomicWord;
private let mut pid_probe_locked_phase: AtomicWord;

private fn pid_probe_armed_address() -> *AtomicWord {
    return &pid_probe_armed;
}

private fn pid_probe_primary_address() -> *AtomicWord {
    return &pid_probe_primary;
}

private fn pid_probe_secondary_address() -> *AtomicWord {
    return &pid_probe_secondary;
}

private fn pid_probe_active_address() -> *AtomicWord {
    return &pid_probe_active;
}

// GitHub issue #510: entries into the secondary's run function, counted and
// never cleared. This is what core 0's entry gate waits on.
//
// `active` cannot be that gate. It is a LEVEL the secondary clears on its
// way out, and this probe's secondary CAN leave while still armed: the
// rendezvous below sets `armed = 0` when it times out, and the round loop
// then falls through to clear `active`. A core 0 that was descheduled past
// the rendezvous deadline -- measured to happen under host saturation --
// comes back, polls `active`, sees 0, and reports `secondary-never-entered`
// about a core that entered and waited for it. The verdict is right and the
// reason is wrong, which is the whole of what #510 was filed about.
//
// A COUNT, not a flag, and incremented at the top of the function BEFORE any
// rendezvous. Gating on the per-round cycle count instead would deadlock:
// that count only advances after a rendezvous with core 0, and core 0 is the
// one waiting.
private let mut pid_probe_entries: AtomicWord;

private fn pid_probe_entries_address() -> *AtomicWord {
    return &pid_probe_entries;
}

private fn pid_probe_overlap_address() -> *AtomicWord {
    return &pid_probe_overlap;
}

private fn pid_probe_primary_arrived_address() -> *AtomicWord {
    return &pid_probe_primary_arrived;
}

private fn pid_probe_secondary_arrived_address() -> *AtomicWord {
    return &pid_probe_secondary_arrived;
}

private fn pid_probe_primary_committed_address() -> *AtomicWord {
    return &pid_probe_primary_committed;
}

private fn pid_probe_secondary_committed_address() -> *AtomicWord {
    return &pid_probe_secondary_committed;
}

private fn pid_probe_locked_phase_address() -> *AtomicWord {
    return &pid_probe_locked_phase;
}

private fn pid_probe_rendezvous(primary: bool, sequence: usize,
                                primary_address: *AtomicWord,
                                secondary_address: *AtomicWord)
        -> PidProbeRendezvousResult !{unsafe} {
    let mut own_address: *AtomicWord = secondary_address;
    let mut peer_address: *AtomicWord = primary_address;
    if (primary) {
        own_address = primary_address;
        peer_address = secondary_address;
    }
    atomic_word_store(own_address, sequence);
    let mut deadline: PeerTickWindow = peer_tick_window_start(128);
    while (peer_tick_window_open(deadline) &&
           atomic_word_load(peer_address) < sequence &&
           atomic_word_load(pid_probe_armed_address()) == 1) {
    }
    if (atomic_word_load(peer_address) >= sequence &&
        atomic_word_load(pid_probe_armed_address()) == 1) {
        return PidProbeRendezvousResult::Met;
    }
    atomic_word_store(pid_probe_armed_address(), 0);
    return PidProbeRendezvousResult::TimedOut;
}

private fn pid_probe_cycle(primary: bool, sequence: usize) -> bool !{unsafe} {
    let locked: bool = atomic_word_load(pid_probe_locked_phase_address()) == 1;
    if (locked) {
        match pid_probe_rendezvous(
                primary, sequence,
                pid_probe_primary_arrived_address(),
                pid_probe_secondary_arrived_address()) {
            PidProbeRendezvousResult::TimedOut => { return false; }
            PidProbeRendezvousResult::Met => {}
        }
        let pid: usize = scheduled_process_mint_pid_for_probe();
    } else {
        match scheduled_process_mint_pid_probe_begin() {
            ScheduledPidProbeBeginResult::Pending(pending) => {
                match pid_probe_rendezvous(
                        primary, sequence,
                        pid_probe_primary_arrived_address(),
                        pid_probe_secondary_arrived_address()) {
                    PidProbeRendezvousResult::TimedOut => {
                        scheduled_process_mint_pid_probe_cancel(pending);
                        return false;
                    }
                    PidProbeRendezvousResult::Met => {
                        let pid: usize =
                            scheduled_process_mint_pid_probe_commit(pending);
                    }
                }
            }
        }
        // Keep the two writes for this round ahead of either read for the
        // next one. Otherwise a fast core could read its own committed value
        // before the peer overwrote it and weaken the exact lost-update
        // count even though the first rendezvous did its job.
        match pid_probe_rendezvous(
                primary, sequence,
                pid_probe_primary_committed_address(),
                pid_probe_secondary_committed_address()) {
            PidProbeRendezvousResult::TimedOut => { return false; }
            PidProbeRendezvousResult::Met => {}
        }
    }
    for spin: usize in 0..<PID_CONTENTION_OUTSIDE_WORK { }
    return true;
}

fn pid_contention_is_armed() -> bool !{unsafe} {
    return atomic_word_load(pid_probe_armed_address()) == 1;
}

fn pid_contention_secondary_run() !{unsafe} {
    atomic_word_fetch_add(pid_probe_entries_address(), 1);
    atomic_word_store(pid_probe_active_address(), 1);
    while (atomic_word_load(pid_probe_secondary_address()) < PID_CONTENTION_ROUNDS &&
           atomic_word_load(pid_probe_armed_address()) == 1) {
        let sequence: usize = atomic_word_load(pid_probe_secondary_address()) + 1;
        if (pid_probe_cycle(false, sequence)) {
            atomic_word_fetch_add(pid_probe_secondary_address(), 1);
        }
    }
    atomic_word_store(pid_probe_active_address(), 0);
}

private fn pid_contention_report(stage: *u8, advanced: usize,
                                  calls: usize) !{unsafe} {
    kernel_boot_log("pid contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("pid contention counts: primary=");
    uart_put_udec(atomic_word_load(pid_probe_primary_address()));
    kernel_boot_log(" secondary=");
    uart_put_udec(atomic_word_load(pid_probe_secondary_address()));
    kernel_boot_log(" calls=");
    uart_put_udec(calls);
    kernel_boot_log(" advanced=");
    uart_put_udec(advanced);
    kernel_boot_log(" overlap=");
    uart_put_udec(atomic_word_load(pid_probe_overlap_address()));
    kernel_boot_log("\n");
}

// Call only after observing `active == 1`: that observation closes the gap
// between the secondary's outer armed check and its entry into the probe.
// A timeout must leave the monotonically advanced counter alone; restoring
// it while the secondary may still mint would move the counter backwards.
private fn pid_probe_disarm_and_quiesce() -> bool !{unsafe} {
    atomic_word_store(pid_probe_armed_address(), 0);
    let mut deadline: PeerTickWindow = peer_tick_window_start(128);
    while (peer_tick_window_open(deadline) &&
           atomic_word_load(pid_probe_active_address()) == 1) {
    }
    return atomic_word_load(pid_probe_active_address()) == 0;
}

private fn pid_contention_phase(locked: bool) -> bool !{unsafe} {
    let next_before: usize = scheduled_process_pid_counter();
    let entries_before: usize = atomic_word_load(pid_probe_entries_address());
    atomic_word_store(pid_probe_primary_address(), 0);
    atomic_word_store(pid_probe_secondary_address(), 0);
    atomic_word_store(pid_probe_active_address(), 0);
    atomic_word_store(pid_probe_overlap_address(), 0);
    atomic_word_store(pid_probe_primary_arrived_address(), 0);
    atomic_word_store(pid_probe_secondary_arrived_address(), 0);
    atomic_word_store(pid_probe_primary_committed_address(), 0);
    atomic_word_store(pid_probe_secondary_committed_address(), 0);
    if (locked) {
        atomic_word_store(pid_probe_locked_phase_address(), 1);
    } else {
        atomic_word_store(pid_probe_locked_phase_address(), 0);
    }
    atomic_word_store(pid_probe_armed_address(), 1);

    let mut entry_window: PeerTickWindow = peer_tick_window_start(16);
    let mut entered: bool = false;
    while (entered == false && peer_tick_window_open(entry_window)) {
        if (atomic_word_load(pid_probe_entries_address()) > entries_before) {
            entered = true;
        }
    }
    if (entered == false) {
        atomic_word_store(pid_probe_armed_address(), 0);
        pid_contention_report("secondary-never-entered" as *u8, 0, 0);
        return false;
    }

    for round: usize in 0..<PID_CONTENTION_ROUNDS {
        if (atomic_word_load(pid_probe_armed_address()) == 1 &&
            pid_probe_cycle(true, round + 1)) {
            atomic_word_fetch_add(pid_probe_primary_address(), 1);
        }
    }
    let rendezvous_failed: bool = atomic_word_load(pid_probe_armed_address()) == 0;

    // With per-round rendezvous this is the secondary completion count at
    // the instant the primary finishes, not a scheduler-granularity metric.
    atomic_word_store(pid_probe_overlap_address(),
        atomic_word_load(pid_probe_secondary_address()));

    let mut finish_window: PeerTickWindow = peer_tick_window_start(128);
    let mut finished: bool = false;
    while (finished == false && peer_tick_window_open(finish_window)) {
        if (atomic_word_load(pid_probe_secondary_address()) >=
                PID_CONTENTION_ROUNDS) {
            finished = true;
        }
    }
    let quiesced: bool = pid_probe_disarm_and_quiesce();

    let advanced: usize = scheduled_process_pid_counter() - next_before;
    let calls: usize =
        atomic_word_load(pid_probe_primary_address()) +
        atomic_word_load(pid_probe_secondary_address());
    if (quiesced == false) {
        pid_contention_report("secondary-never-quiesced" as *u8,
                              advanced, calls);
        return false;
    }
    if (finished == false) {
        let mut stage: *u8 = "secondary-never-finished" as *u8;
        if (rendezvous_failed) {
            stage = "rendezvous-timeout" as *u8;
        }
        scheduled_process_pid_counter_restore(next_before);
        pid_contention_report(stage, advanced, calls);
        return false;
    }
    // Back where it started, before the verdict, so a failed probe does
    // not also leave the counter moved.
    scheduled_process_pid_counter_restore(next_before);
    if (locked) {
        pid_contention_report("locked" as *u8, advanced, calls);
        return calls == PID_CONTENTION_ROUNDS * 2 && advanced == calls;
    }
    pid_contention_report("unlocked" as *u8, advanced, calls);
    return calls == PID_CONTENTION_ROUNDS * 2 &&
           advanced == PID_CONTENTION_ROUNDS;
}

fn pid_contention_probe() -> bool !{unsafe} {
    scheduled_process_pool_init_for_probe();
    if (pid_contention_phase(false) == false) { return false; }
    if (pid_contention_phase(true) == false) { return false; }
    return true;
}
