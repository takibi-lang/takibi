// GitHub issue #479 Group B: every online core minting a pid at once (two
// cores until GitHub issue #756; two is now the degenerate case).
//
// The unlocked phase deliberately splits the production counter's read and
// write and rendezvouses every online core between them. All of them read
// the same value, so the counter advances exactly once per round however
// many cores took part. The locked phase runs the ordinary production mint
// after the same per-round rendezvous and must lose none. What the race
// costs: two processes carrying one pid, and every accounting this kernel
// does by pid -- wait4 by pid, the process tree walk, ps -- becomes a
// question with two answers.
//
// The detector is the counter's own arithmetic: each mint advances it by
// exactly one, so the controlled unlocked phase advances once per round
// while the locked phase advances once for each call. "Number of mints" is
// this probe's OWN per-core atomic counters, never the kernel's, for the
// reason the asid probe learned -- a counter on the racing path loses
// increments to the race it is being used to detect.
//
// Current limitations:
// - IT PUTS THE COUNTER BACK. A pid appears in the process-lifecycle
//   views, in ps and in every wait4 line, so a probe that consumed
//   thousands of real numbers would move every later process's pid and
//   break views with nothing to do with it -- issue #437 moved PID 1 once
//   and 17 of 39 views changed. Nothing was created here, so nothing is
//   owed those numbers. The restore is stated rather than quiet because it
//   IS a mutation of kernel state for a test's convenience.
// - The unlocked begin/commit pair is an unsafe test-only escape through
//   LockedCell. Its pending value is linear, so every path commits or
//   cancels it, and ordinary PID allocation cannot call the split path.
// - Measures exclusion, not ordering.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/kernel/process.tkb";
use "kernel/lib/execution_model.tkb";

const PID_CONTENTION_ROUNDS: usize = 2048;
const PID_CONTENTION_OUTSIDE_WORK: usize = 64;

private let mut pid_probe_armed: AtomicWord;
private let mut pid_probe_locked_phase: AtomicWord;
private let mut pid_probe_online: AtomicWord;
// Completed rounds, one word per core (index 0 is core 0's).
private let mut pid_probe_done: [AtomicWord; KERNEL_MAX_CORES];
// Levels, one per core: inside the run function right now.
private let mut pid_probe_active: [AtomicWord; KERNEL_MAX_CORES];
private let mut pid_probe_overlap: AtomicWord;
private let mut pid_probe_arrived: PeerRound;
private let mut pid_probe_committed: PeerRound;

// GitHub issue #510: entries into a peer's run function, counted and never
// cleared. This is what core 0's entry gate waits on: a COUNT, not a level,
// incremented before any rendezvous (gating on the per-round count would
// deadlock -- it only advances after a rendezvous with core 0).
private let mut pid_probe_entries: AtomicWord;

private fn pid_probe_cycle(cpu: usize, online: usize, sequence: usize)
        -> bool !{unsafe} {
    let locked: bool = atomic_word_load(&pid_probe_locked_phase) == 1;
    if (locked) {
        if (peer_round_meet(&pid_probe_arrived, cpu, online, sequence,
                            &pid_probe_armed) == false) {
            return false;
        }
        let pid: usize = scheduled_process_mint_pid_for_probe();
    } else {
        match scheduled_process_mint_pid_probe_begin() {
            ScheduledPidProbeBeginResult::Pending(pending) => {
                if (peer_round_meet(&pid_probe_arrived, cpu, online, sequence,
                                    &pid_probe_armed) == false) {
                    scheduled_process_mint_pid_probe_cancel(pending);
                    return false;
                }
                let pid: usize =
                    scheduled_process_mint_pid_probe_commit(pending);
            }
        }
        // Keep every core's write for this round ahead of any core's read
        // for the next one. Otherwise a fast core could read its own
        // committed value before the others overwrote it and weaken the
        // exact lost-update count even though the first rendezvous did its
        // job.
        if (peer_round_meet(&pid_probe_committed, cpu, online, sequence,
                            &pid_probe_armed) == false) {
            return false;
        }
    }
    for spin: usize in 0..<PID_CONTENTION_OUTSIDE_WORK { }
    return true;
}

fn pid_contention_is_armed() -> bool !{unsafe} {
    return atomic_word_load(&pid_probe_armed) == 1;
}

// Every online peer runs this from its idle loop while the probe is armed.
fn pid_contention_secondary_run(raw_cpu: usize) !{unsafe} {
    let online: usize = atomic_word_load(&pid_probe_online);
    // core-role: core 0 is the probe's primary and mints from the boot
    // sequence; every other online core is a peer.
    if (raw_cpu == 0 || raw_cpu >= KERNEL_MAX_CORES || raw_cpu >= online) {
        return;
    }
    let cpu: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    if (atomic_word_load(&pid_probe_done[cpu]) >= PID_CONTENTION_ROUNDS) {
        return;
    }
    atomic_word_fetch_add(&pid_probe_entries, 1);
    atomic_word_store(&pid_probe_active[cpu], 1);
    while (atomic_word_load(&pid_probe_done[cpu]) < PID_CONTENTION_ROUNDS &&
           atomic_word_load(&pid_probe_armed) == 1) {
        let sequence: usize = atomic_word_load(&pid_probe_done[cpu]) + 1;
        if (pid_probe_cycle(cpu, online, sequence)) {
            atomic_word_fetch_add(&pid_probe_done[cpu], 1);
        }
    }
    atomic_word_store(&pid_probe_active[cpu], 0);
}

private fn pid_probe_peer_done_min(online: usize) -> usize !{unsafe} {
    let mut least: usize = PID_CONTENTION_ROUNDS;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu < online && atomic_word_load(&pid_probe_done[cpu]) < least) {
            least = atomic_word_load(&pid_probe_done[cpu]);
        }
    }
    return least;
}

private fn pid_probe_calls(online: usize) -> usize !{unsafe} {
    let mut calls: usize = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) { calls = calls + atomic_word_load(&pid_probe_done[cpu]); }
    }
    return calls;
}

private fn pid_probe_any_active(online: usize) -> bool !{unsafe} {
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu < online && atomic_word_load(&pid_probe_active[cpu]) == 1) {
            return true;
        }
    }
    return false;
}

private fn pid_contention_report(stage: *u8, online: usize, advanced: usize,
                                  calls: usize) !{unsafe} {
    kernel_boot_log("pid contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("pid contention counts: cores=");
    uart_put_udec(online);
    kernel_boot_log(" primary=");
    uart_put_udec(atomic_word_load(&pid_probe_done[0]));
    kernel_boot_log(" peers-least=");
    uart_put_udec(pid_probe_peer_done_min(online));
    kernel_boot_log(" calls=");
    uart_put_udec(calls);
    kernel_boot_log(" advanced=");
    uart_put_udec(advanced);
    kernel_boot_log(" overlap=");
    uart_put_udec(atomic_word_load(&pid_probe_overlap));
    kernel_boot_log("\n");
}

// A timeout must leave the monotonically advanced counter alone; restoring
// it while a peer may still mint would move the counter backwards.
private fn pid_probe_disarm_and_quiesce(online: usize) -> bool !{unsafe} {
    atomic_word_store(&pid_probe_armed, 0);
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let mut deadline = peer_tick_window_policy(cpu, PeerTickPolicy::Finish);
            while (peer_tick_window_open(deadline) &&
                   atomic_word_load(&pid_probe_active[cpu]) == 1) {
            }
            peer_tick_window_end(deadline);
        }
    }
    return pid_probe_any_active(online) == false;
}

private fn pid_contention_phase(locked: bool) -> bool !{unsafe} {
    let online: usize = kernel_online_core_count();
    let next_before: usize = scheduled_process_pid_counter();
    let entries_before: usize = atomic_word_load(&pid_probe_entries);
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        atomic_word_store(&pid_probe_done[cpu], 0);
        atomic_word_store(&pid_probe_active[cpu], 0);
    }
    atomic_word_store(&pid_probe_overlap, 0);
    peer_round_reset(&pid_probe_arrived);
    peer_round_reset(&pid_probe_committed);
    atomic_word_store(&pid_probe_online, online);
    if (locked) {
        atomic_word_store(&pid_probe_locked_phase, 1);
    } else {
        atomic_word_store(&pid_probe_locked_phase, 0);
    }
    atomic_word_store(&pid_probe_armed, 1);

    // Every online peer must have entered: the entry count reaches the
    // number of peers. Each wait is bounded by that peer's own ticks.
    let mut entered: bool = online >= 2;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu < online && entered) {
            let mut entry_window = peer_tick_window_policy(cpu, PeerTickPolicy::Entry);
            let mut started: bool = false;
            while (started == false && peer_tick_window_open(entry_window)) {
                if (atomic_word_load(&pid_probe_entries) >= entries_before + cpu) {
                    started = true;
                }
            }
            peer_tick_window_end(entry_window);
            entered = started;
        }
    }
    if (entered == false) {
        atomic_word_store(&pid_probe_armed, 0);
        pid_contention_report("secondary-never-entered" as *u8, online, 0, 0);
        return false;
    }

    for round: usize in 0..<PID_CONTENTION_ROUNDS {
        if (atomic_word_load(&pid_probe_armed) == 1 &&
            pid_probe_cycle(0, online, round + 1)) {
            atomic_word_fetch_add(&pid_probe_done[0], 1);
        }
    }
    let rendezvous_failed: bool = atomic_word_load(&pid_probe_armed) == 0;

    // With per-round rendezvous this is the slowest peer's completion count
    // at the instant core 0 finishes.
    atomic_word_store(&pid_probe_overlap, pid_probe_peer_done_min(online));

    let mut finished: bool = true;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let mut finish_window = peer_tick_window_policy(cpu, PeerTickPolicy::Finish);
            while (atomic_word_load(&pid_probe_done[cpu]) < PID_CONTENTION_ROUNDS &&
                   peer_tick_window_open(finish_window)) {
            }
            peer_tick_window_end(finish_window);
            if (atomic_word_load(&pid_probe_done[cpu]) < PID_CONTENTION_ROUNDS) {
                finished = false;
            }
        }
    }
    let quiesced: bool = pid_probe_disarm_and_quiesce(online);

    let advanced: usize = scheduled_process_pid_counter() - next_before;
    let calls: usize = pid_probe_calls(online);
    if (quiesced == false) {
        pid_contention_report("secondary-never-quiesced" as *u8, online,
                              advanced, calls);
        return false;
    }
    if (finished == false) {
        let mut stage: *u8 = "secondary-never-finished" as *u8;
        if (rendezvous_failed) {
            stage = "rendezvous-timeout" as *u8;
        }
        scheduled_process_pid_counter_restore(next_before);
        pid_contention_report(stage, online, advanced, calls);
        return false;
    }
    // Back where it started, before the verdict, so a failed probe does
    // not also leave the counter moved.
    scheduled_process_pid_counter_restore(next_before);
    if (locked) {
        pid_contention_report("locked" as *u8, online, advanced, calls);
        return calls == PID_CONTENTION_ROUNDS * online && advanced == calls;
    }
    pid_contention_report("unlocked" as *u8, online, advanced, calls);
    return calls == PID_CONTENTION_ROUNDS * online &&
           advanced == PID_CONTENTION_ROUNDS;
}

fn pid_contention_probe() -> bool !{unsafe} {
    scheduled_process_pool_init_for_probe();
    if (pid_contention_phase(false) == false) { return false; }
    if (pid_contention_phase(true) == false) { return false; }
    return true;
}
