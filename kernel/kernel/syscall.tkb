                CheckedUsize::Value(v) => { v }
            };
            match user_range_check_read(kernel_process_current_root(), entry_address, 8) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(range) => {
                    let (ok, string_address) = user_read_u64(range, 0);
                    if (ok == false) { return SyscallAction::Resume(LINUX_EFAULT); }
                    if (string_address == 0) {
                        vector_terminated = true;
                    } else {
                        let argument_name: []u8 = match kernel_syscall_path_name(
                                string_address as usize) {
                            SyscallPathResult::Fault => {
                                return SyscallAction::Resume(LINUX_EFAULT);
                            }
                            SyscallPathResult::Invalid => {
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            SyscallPathResult::Name(path) => { path }
                        };
                        let mut string_length: usize = argument_name.len;
                        if (path_view[0] == 0x2F) {
                            string_length = string_length + 1;
                        }
                        // Linux's script binfmt drops the caller's own
                        // argv[0] and puts the script pathname in its place,
                        // already appended above. Keeping both would shift
                        // every argument the interpreter sees by one.
                        let caller_argv0_replaced: bool =
                            index == 0 && script_argc != 0;
                        if (caller_argv0_replaced == false) {
                        match checked_add_usize(output_offset,
                                                string_length + 1) {
                            CheckedUsize::Overflow => {
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            CheckedUsize::Value(end) => {
                                if (end > 512 || argc >= 15) {
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                let copy_length: usize = string_length + 1;
                                let destination_start: usize = output_offset;
                                let exec_argv_view: []u8 =
                                    syscall_exec_argv_here();
                                if (destination_start > exec_argv_view.len) {
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                let destination_tail = exec_argv_view[
                                    destination_start..<exec_argv_view.len];
                                if (copy_length > destination_tail.len) {
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                let destination =
                                    destination_tail[0..<copy_length];
                                if (copy_length > path_view.len) {
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                let source = path_view[0..<copy_length];
                                let copied: usize = slice_copy(
                                    destination, source);
                                if (copied != copy_length) {
                                    return SyscallAction::Resume(LINUX_EFAULT);
                                }
                                output_offset = end;
                                argc = argc + 1;
                            }
                        }
                        }
                    }
                }
            }
            if (vector_terminated) { break; }
        }
        if (vector_terminated == false || argc == 0 ||
            path_length == 0) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        // Keep the path validation explicit even though this first image
        // registry currently contains one static BusyBox ELF.
        if (exec_path_absolute == false) { return SyscallAction::Resume(LINUX_ENOENT); }
        if (argc >= 16) { return SyscallAction::Resume(LINUX_EINVAL); }
        let packed_argc: {0..<16 as usize} = argc;
        let diagnostic_argv: []u8 = syscall_exec_argv_here();
        scheduled_process_set_command_line(
            kernel_syscall_process_slot(),
            diagnostic_argv, output_offset);
        scheduled_process_set_exec_argc(
            kernel_syscall_process_slot(), packed_argc);
        scheduled_process_set_exec_inode(
            kernel_syscall_process_slot(), exec_inode);
        scheduled_process_set_exec_pending(kernel_syscall_process_slot(), true);
        if (kernel_process_is_child()) { return SyscallAction::ChildExec; }
        return SyscallAction::Exec;
    }

    if (number == AARCH64_NR_CLONE || number == AARCH64_NR_VFORK ||
        number == AARCH64_NR_FORK || number == AARCH64_NR_CLONE3) {
        // musl's vfork() is not the vfork syscall: it is
        // clone(CLONE_VM|CLONE_VFORK|SIGCHLD, 0), measured at 0x4111 coming
        // out of the pinned BusyBox init. Both shapes become the same
        // copy-on-write fork here, which differs from Linux in two ways
        // worth naming: the child gets its own copy of the address space
        // rather than sharing the parent's, and the parent is not suspended
        // until the child execs. Both differences are in the safe
        // direction for a vfork caller -- a caller may not rely on writes
        // reaching the parent, and every one of them execs or _exits
        // immediately -- but a program that reads a value the child wrote
        // would see the pre-fork value here and the child's value on Linux.
        if (number == AARCH64_NR_CLONE &&
            ((x0 != 0x11 && x0 != 0x4111) || x1 != 0)) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let mut clone_flags: usize = 0x11;
        let mut clone_stack: usize = 0;
        let parent_slot: usize = kernel_syscall_process_slot();
        // GitHub issue #245: kernel_process_clone_begin() now runs first
        // (it used to run last), since the address-space root and
        // fd-table slot the VM/fd clone steps below need are the new
        // child's own ProcessHandle.pool_index -- not fixed to root 1 /
        // fd-slot 1 anymore, so nothing downstream can pick them without
        // asking process.tkb for the slot it actually allocated.
        match kernel_process_clone_begin(clone_flags, clone_stack) {
            ProcessCloneResult::Invalid => {
                return kernel_syscall_clone_failure_action(
                    ProcessCloneFailure::Invalid);
            }
            ProcessCloneResult::ResourceExhausted => {
                return kernel_syscall_clone_failure_action(
                    ProcessCloneFailure::ResourceExhausted);
            }
            ProcessCloneResult::ChildConstructing(child_pid) => {
                // Guard against PID 1's own fork of the interactive ash
                // (BusyBox init starting the /etc/inittab respawn ash):
                // that
                // happens automatically at boot, before the host ever
                // submits a command, and is not the boundary this
                // checkpoint means. The checkpoint is specifically the
                // interactive ash forking ITS OWN child (e.g. the
                // backgrounded HTTPd) -- excluding PID 1 as the forking
                // parent is sufficient, since PID 1 is the only process
                // that forks directly under the persistent-shell scenario
                // before the ash session itself forks anything.
                //
                // kernel_process_clone_begin() already switches "current"
                // to the newly created CHILD before returning (the clone
                // continuation resumes as the child directly, x0=0), so
                // "current" here is child_pid, not the forking parent --
                // kernel_process_parent_is_root() (which asks about
                // *current's* parent) is the right check for "did PID 1
                // do this fork", not a direct pid comparison against
                // kernel_process_current_pid().
                if (kernel_syscall_persistent_shell_active() &&
                    kernel_process_parent_is_root() == false) {
                    kernel_syscall_persistent_shell_checkpoint_fork(child_pid);
                }
                let child_slot: usize =
                    address_space_root_slot(kernel_process_current_root());
                match process_image_clone_vm_begin(child_slot) {
                    ProcessCloneVmResult::OutOfMemory => {
                        match kernel_process_clone_rollback() {
                            ProcessCloneRollbackResult::Invalid => {
                                return SyscallAction::Unreachable;
                            }
                            ProcessCloneRollbackResult::Restored => {}
                        }
                        return SyscallAction::Resume(LINUX_EAGAIN);
                    }
                    ProcessCloneVmResult::Copied => {
                        match kernel_syscall_clone_files_begin(
                                parent_slot, child_slot) {
                            UnifiedFdResult::Invalid => {
                                match process_image_clone_vm_reap(child_slot) {
                                    ProcessCloneVmReapResult::Missing => {}
                                    ProcessCloneVmReapResult::Reaped => {}
                                }
                                match kernel_process_clone_rollback() {
                                    ProcessCloneRollbackResult::Invalid => {
                                        return SyscallAction::Unreachable;
                                    }
                                    ProcessCloneRollbackResult::Restored => {}
                                }
                                return SyscallAction::Resume(LINUX_EAGAIN);
                            }
                            UnifiedFdResult::Ok => {}
                        }
                        // Assembly copies the complete saved parent frame
                        // to the dedicated child kernel stack and resumes
                        // x0=0.
                        return SyscallAction::CloneChild(child_pid);
                    }
                }
            }
        }
    }
    if (number == AARCH64_NR_EXIT || number == AARCH64_NR_EXIT_GROUP) {
        return kernel_syscall_exit_current_process(x0);
    }
    if (number == AARCH64_NR_WAIT4) {
        let requested_pid: usize = x0;
        let wait_options: usize = x2;
        // GitHub issue #244: x0's expected pid is the live child's own
        // pid if it hasn't exited yet, or the last reaped child's pid if
        // it has -- the live child's pid alone would wrongly read back
        // 0 once reaped (has_child cleared), and a fixed
        // literal (this used to be the literal 2, the only pid the old
        // two-process model could ever produce) is wrong for any process
        // other than the original root.
        // GitHub issue #437: a SEARCH, not a comparison. This asked
        // first_child's pid and fell back to the last reaped one, which
        // was exact while a parent could have one child. With several,
        // wait4(pid) for any of them but the newest would have been
        // -EINVAL.
        let selecting: bool = requested_pid != 0xFFFFFFFFFFFFFFFF;
        let known_child: bool =
            kernel_process_current_has_child_pid(requested_pid) ||
            (requested_pid != 0 &&
             requested_pid == kernel_process_last_child_pid());
        // GitHub issue #248: no longer rejects a child-status caller here
        // (kernel_process_is_child() used to gate this to the tree root
        // only) -- kernel_process_current_has_child_pid()/_last_child_pid()
        // above are already relative to whichever slot is calling, and
        // kernel/kernel/process.tkb's own child-exit/wait bookkeeping is
        // now per-slot too, so any live process may legitimately wait4()
        // for its own live child, not just the root.
        if ((selecting && known_child == false) ||
            (wait_options != 0 && wait_options != LINUX_WNOHANG)) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        // GitHub issue #571: ONE decision, not two unlocked walks with a gap
        // between them. "Is there a zombie to collect" and "is there a live
        // child to wait for" are separate walks of the same child list, and
        // kernel_process_child_exit moves a child from Running to Exited
        // under this lock on another CPU. A child that crossed that
        // transition between the two walks was a zombie to neither question
        // -- the first walk saw it Running, so not collectable, and the
        // second saw it Exited, so not live -- and this arm answered ECHILD
        // for a child that a second wait4 collected a few instructions
        // later. Under the lock the peer's exit lands wholly before both
        // walks or wholly after them, so the "neither" answer does not
        // exist: Running means block, exactly as before, and Exited means
        // reap. No case that used to block answers differently.
        let decision_guard = process_run_lock();
        let mut collectable: bool = kernel_process_child_waitable();
        if (selecting) {
            collectable = kernel_process_child_waitable_pid(requested_pid);
        }
        let has_live_child: bool = kernel_process_current_has_live_child();
        process_run_unlock(decision_guard);
        if (collectable == false) {
            if (wait_options == LINUX_WNOHANG) {
                return SyscallAction::Resume(0);
            }
            // GitHub issue #244: block for real instead of returning
            // -ECHILD immediately -- only reached when the scheduler
            // preempted the child and switched back to this parent
            // before the child's own exit did so on its own. A parent
            // with no child at all (never forked, or already reaped and
            // not waited on again) still fails fast.
            if (has_live_child) {
                // GitHub issue #244 bug fix: the block/wake trampoline
                // (kernel_syscall_block_return) only injects a return
                // value via el0_context_set_x0 -- there is no way back
                // into this handler's own code once the syscall took the
                // Block path (a one-way tail branch, same as the UART-wait
                // syscall this trampoline was built for). x1 (the status
                // pointer) has to be remembered here and re-applied at wake
                // time by kernel_syscall_wait4_deliver() -- issue #302
                // moved that memory into the blocking parent's own
                // ProcessRecord (kernel/kernel/process.tkb) instead of a
                // module global, or a woken wait4() would resume with a
                // stale x0/no status written.
                // GitHub issue #448: blocking with no runnable successor
                // used to fail-stop, and until this kernel had more than
                // one thing wanting the CPU it could not happen -- the
                // process this one is waiting for was always either
                // running or spinning inside the kernel. Now that a UART
                // waiter really yields, "every process is blocked" is a
                // state a healthy boot reaches: the shell waits for a
                // keystroke and its parent waits for the shell. Wait for
                // an interrupt and ask again instead. The retry is free of
                // side effects -- this handler has written nothing at this
                // point -- and the timer alone guarantees it runs again.
                if (kernel_process_other_ready() == false) {
                    return SyscallAction::WaitInterrupt;
                }
                kernel_process_current_set_pending_block(
                    ProcessWaitReason::ChildExit, x1);
                return SyscallAction::Block;
            }
            return SyscallAction::Resume(LINUX_ECHILD);
        }
        if (x1 != 0) {
            match user_range_check_write(kernel_process_current_root(), x1, 4) {
                UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserWriteRangeResult::Ok(range) => {
                    // GitHub issue #437: peek then reap, and both have to
                    // name the SAME child once a parent can have several.
                    // The peek is only used to write the status buffer, so
                    // the selecting reap below is what settles which one is
                    // collected.
                    let mut status: usize =
                        kernel_process_child_wait_status_peek();
                    if (selecting) {
                        status =
                            kernel_process_child_wait_status_peek_pid(
                                requested_pid);
                    }
                    if (user_write_u32(range, 0,
                            ((status & 0xFF) << 8) as u32) == false) {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    let mut consumed_status: usize = 0;
                    if (selecting) {
                        consumed_status =
                            kernel_process_child_wait_status_pid(requested_pid);
                    } else {
                        consumed_status = kernel_process_child_wait_status();
                    }
                    kernel_init_boot_fixture_reaped(
                        kernel_process_current_pid());
                    return SyscallAction::Resume(
                        kernel_process_last_child_pid());
                }
            }
        }
        let mut ignored_status: usize = 0;
        if (selecting) {
            ignored_status =
                kernel_process_child_wait_status_pid(requested_pid);
        } else {
            ignored_status = kernel_process_child_wait_status();
        }
        // GitHub issue #270: PID 1 reaping its first child is where the
        // bounded boot fixture ends now. The hook is a no-op for every
        // other reaper and after the first one.
        kernel_init_boot_fixture_reaped(kernel_process_current_pid());
        return SyscallAction::Resume(kernel_process_last_child_pid());
    }
    if (number == AARCH64_NR_GETCWD) {
        // getcwd(): HTTPd immediately changes to its configured root; `/` is
        // the only current working directory exposed by this kernel slice.
        // The real syscall (unlike the POSIX library wrapper, which returns
        // the buffer pointer) returns the number of bytes written including
        // the NUL terminator -- found via a real hang: BusyBox ash's `sh -c`
        // startup calls this, and this handler previously returned the
        // buffer ADDRESS instead of the byte count, which some downstream
        // use of that value (as a length, not just a >=0 success check)
        // turned into an effectively-unbounded userspace loop with no
        // further syscalls, not a kernel-visible fault.
        if (x1 < 2) { return SyscallAction::Resume(LINUX_EFAULT); }
        match user_range_check_write(kernel_process_current_root(), x0, 2) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(range) => {
                let wrote_slash: bool = user_write_byte(range, 0, 0x2F);
                let wrote_nul: bool = user_write_byte(range, 1, 0);
            }
        }
        return SyscallAction::Resume(2);
    }
    if (number == AARCH64_NR_CHDIR) {
        match user_range_check_read(kernel_process_current_root(), x0, 2) {
            UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserReadRangeResult::Ok(range) => {
                let path_view: []u8 = syscall_scratch_here().path_buffer as []u8;
                if (copy_from_user(range, path_view[0..<2]) &&
                        (path_view[0] == 0x2F || path_view[0] == 0x2E) &&
                        path_view[1] == 0) {
                    return SyscallAction::Resume(0);
                }
            }
        }
        return SyscallAction::Resume(LINUX_ENOENT);
    }
    if (number == AARCH64_NR_SETITIMER) {
        // setitimer(): HTTPd's request timeout is unnecessary for the single
        // bounded integration request. Return an all-zero previous timer.
        if (x2 != 0) {
            match user_range_check_write(kernel_process_current_root(), x2, 32) {
                UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserWriteRangeResult::Ok(range) => {
                    let zeroed: bool = user_zero_fill(range);
                }
            }
        }
        return SyscallAction::Resume(0);
    }
    if (number == AARCH64_NR_SYSLOG) {
        return syscall_syslog(x0, x1, x2);
    }
    if (number == 113) {
        match user_range_check_write(kernel_process_current_root(), x1, 16) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(range) => {
                if (x0 == 1) {
                    let frequency: usize = read_cntfrq() as usize;
                    if (frequency == 0) {
                        return SyscallAction::Resume(LINUX_EINVAL);
                    }
                    let ticks: usize = read_cntpct() as usize;
                    let wrote_seconds: bool = user_write_u64(
                        range, 0, (ticks / frequency) as u64);
                    let remainder: usize = ticks % frequency;
                    let nanos: usize = (remainder * 1000000000) / frequency;
                    let wrote_nanoseconds: bool =
                        user_write_u64(range, 8, nanos as u64);
                } else if (x0 == 0) {
                    let wrote_seconds: bool =
                        user_write_u64(range, 0, 1700000000 as u64);
                    let wrote_nanoseconds: bool = user_write_u64(range, 8, 0);
                } else {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
            }
        }
        return SyscallAction::Resume(0);
    }
    if (number == AARCH64_NR_SYSINFO) {
        // Linux aarch64 struct sysinfo. BusyBox ps consumes uptime; keep the
        // rest zero until a concrete consumer needs accounted values.
        match user_range_check_write(kernel_process_current_root(), x0, 112) {
            UserWriteRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserWriteRangeResult::Ok(range) => {
                user_zero_fill(range);
                let frequency: i64 = read_cntfrq();
                let mut uptime: usize = 0;
                if (frequency > 0) {
                    uptime = (read_cntpct() / frequency) as usize;
                }
                user_write_u64(range, 0, uptime as u64);
            }
        }
        return SyscallAction::Resume(0);
    }
    if (number == AARCH64_NR_RT_SIGACTION) {
        // rt_sigaction(signum, act, oldact, sigsetsize). Asynchronous signal
        // handlers are not implemented, but SIGCHLD=SIG_IGN is not merely a
        // handler choice on Linux: children must not remain as zombies.
        let signum: usize = x0;
        let act: usize = x1;
        let oldact: usize = x2;
        if (signum == 0 || signum == 9 || signum == 19) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (oldact != 0) {
            match user_range_check_write(kernel_process_current_root(), oldact, 32) {
                UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserWriteRangeResult::Ok(range) => {
                    let zeroed: bool = user_zero_fill(range);
                    if (signum == LINUX_SIGCHLD &&
                        kernel_process_current_sigchld_ignored()) {
                        let wrote_handler: bool = user_write_u64(range, 0, 1);
                    }
                }
            }
        }
        if (act != 0) {
            match user_range_check_read(kernel_process_current_root(), act, 32) {
                UserReadRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserReadRangeResult::Ok(range) => {
                    let (read_ok, handler) = user_read_u64(range, 0);
                    if (read_ok == false) {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    if (signum == LINUX_SIGCHLD) {
                        if (handler > 1) {
                            return SyscallAction::Resume(LINUX_EINVAL);
                        }
                        kernel_process_current_set_sigchld_ignored(
                            handler == 1);
                    }
                }
            }
        }
        return SyscallAction::Resume(0);
    }
    if (number == 135) {
        if (x3 != 8) { return SyscallAction::Resume(LINUX_EINVAL); }
        let old_mask: usize = kernel_process_current_signal_mask();
        let mut new_mask: usize = old_mask;
        if (x1 != 0) {
            match user_range_check_read(kernel_process_current_root(), x1, 8) {
                UserReadRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserReadRangeResult::Ok(range) => {
                    let (read_ok, requested_mask) = user_read_u64(range, 0);
                    if (read_ok == false) {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    if (x0 == 0) {
                        new_mask = old_mask | (requested_mask as usize);
                    } else if (x0 == 1) {
                        new_mask = old_mask & ~(requested_mask as usize);
                    } else if (x0 == 2) {
                        new_mask = requested_mask as usize;
                    } else {
                        return SyscallAction::Resume(LINUX_EINVAL);
                    }
                }
            }
        }
        if (x2 != 0) {
            match user_range_check_write(kernel_process_current_root(), x2, 8) {
                UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserWriteRangeResult::Ok(range) => {
                    let wrote_mask: bool =
                        user_write_u64(range, 0, old_mask as u64);
                }
            }
        }
        if (x1 != 0) { kernel_process_current_set_signal_mask(new_mask); }
        return SyscallAction::Resume(0);
    }
    if (number == AARCH64_NR_RT_SIGTIMEDWAIT) {
        if (x3 != 8) { return SyscallAction::Resume(LINUX_EINVAL); }
        // The maintained BusyBox path passes NULL siginfo. Refuse a shape
        // whose output this kernel cannot yet fill instead of returning a
        // signal number beside untouched userspace memory.
        if (x1 != 0) { return SyscallAction::Resume(LINUX_EINVAL); }
        match user_range_check_read(kernel_process_current_root(), x0, 8) {
            UserReadRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserReadRangeResult::Ok(range) => {
                let (read_ok, wait_set) = user_read_u64(range, 0);
                if (read_ok == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                return syscall_signal_wait(wait_set as usize, x2);
            }
        }
    }
    if (number == AARCH64_NR_KILL) {
        if (x0 == 0 || x1 > 64) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (x1 != 0 && x1 != LINUX_SIGTERM && x1 != LINUX_SIGCHLD) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (x0 == kernel_process_current_pid() && x1 == LINUX_SIGTERM) {
            return kernel_syscall_exit_current_process(128 + LINUX_SIGTERM);
        }
        match kernel_process_signal_send(x0, x1) {
            ProcessSignalSendResult::Missing => {
                return SyscallAction::Resume(LINUX_ESRCH);
            }
            ProcessSignalSendResult::Delivered => {
                return SyscallAction::Resume(0);
            }
        }
    }
    if (number == 205) {
        if (x0 != 0) { return SyscallAction::Resume(LINUX_EFAULT); }
        match user_range_check_write(kernel_process_current_root(), x1, 16) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(peer_range) => {
                let zeroed: bool = user_zero_fill(peer_range);
                let wrote_family: bool = user_write_byte(peer_range, 0, 2);
            }
        }
        match user_range_check_write(kernel_process_current_root(), x2, 4) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(length_range) => {
                let wrote_length: bool =
                    user_write_u32(length_range, 0, 16);
            }
        }
        return SyscallAction::Resume(0);
    }
    if (number == 208) {
        // setsockopt(level, optname, optval, optlen): this kernel's
        // single-listener-per-port/single-connection model has no state any
        // real option here would change, but the optval pointer itself is
        // now validated instead of never being touched.
        let optval: usize = x2;
        let optlen: usize = x3;
        if (optlen != 0) {
            match user_range_check_read(kernel_process_current_root(), optval, optlen) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(range) => {}
            }
        }
        return SyscallAction::Resume(0);
    }
    if (number == AARCH64_NR_SET_TID_ADDRESS) {
        return SyscallAction::Resume(kernel_process_current_pid());
    }
    if (number == AARCH64_NR_GETCPU) {
        // Linux permits either output pointer to be null. This kernel has no
        // NUMA topology, so every online CPU belongs to node 0.
        if (x0 != 0) {
            match user_range_check_write(
                    kernel_process_current_root(), x0, 4) {
                UserWriteRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserWriteRangeResult::Ok(cpu_range) => {
                    if (user_write_u32(cpu_range, 0, cpu_id() as u32) == false) {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                }
            }
        }
        if (x1 != 0) {
            match user_range_check_write(
                    kernel_process_current_root(), x1, 4) {
                UserWriteRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserWriteRangeResult::Ok(node_range) => {
                    if (user_write_u32(node_range, 0, 0) == false) {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                }
            }
        }
        return SyscallAction::Resume(0);
    }

    // GitHub issue #9: the affinity ABI. The kernel's mask is one 64-bit
    // word, so cpusetsize is measured against 8 bytes, as Linux measures it
    // against cpumask_size(). Bits past the first word name no CPU here.
    if (number == AARCH64_NR_SCHED_GETAFFINITY) {
        if (x1 < 8 || (x1 & 7) != 0) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        match kernel_process_affinity_get(x0) {
            ProcessAffinityResult::Missing => {
                return SyscallAction::Resume(LINUX_ESRCH);
            }
            ProcessAffinityResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            ProcessAffinityResult::Mask(mask) => {
                match user_range_check_write(
                        kernel_process_current_root(), x2, 8) {
                    UserWriteRangeResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    UserWriteRangeResult::Ok(mask_range) => {
                        if (user_write_u64(mask_range, 0, mask as u64) ==
                                false) {
                            return SyscallAction::Resume(LINUX_EFAULT);
                        }
                    }
                }
                return SyscallAction::Resume(8);
            }
        }
    }
    if (number == AARCH64_NR_SCHED_SETAFFINITY) {
        if (x1 < 8) { return SyscallAction::Resume(LINUX_EINVAL); }
        let mut requested: usize = 0;
        match user_range_check_read(kernel_process_current_root(), x2, 8) {
            UserReadRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserReadRangeResult::Ok(mask_range) => {
                let (mask_ok, mask_raw) = user_read_u64(mask_range, 0);
                if (mask_ok == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                requested = mask_raw as usize;
            }
        }
        match kernel_process_affinity_set(x0, requested) {
            ProcessAffinityResult::Missing => {
                return SyscallAction::Resume(LINUX_ESRCH);
            }
            ProcessAffinityResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            ProcessAffinityResult::Mask(mask) => {
                return SyscallAction::Resume(0);
            }
        }
    }
    if (number == 172 || number == 178) {
        return SyscallAction::Resume(kernel_process_current_pid());
    }
    if (number == 173 || (number >= 174 && number <= 177)) {
        return SyscallAction::Resume(0);
    }
    if (number == 214) {
        if (x0 == 0) { return SyscallAction::Resume(kernel_syscall_heap_break()); }
        if (x0 >= kernel_syscall_heap_start() &&
            x0 <= kernel_syscall_heap_limit()) {
            if (kernel_syscall_heap_set(x0) == false) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
        }
        return SyscallAction::Resume(kernel_syscall_heap_break());
    }
    if (number == 222) {
        let length: usize = x1;
        let prot: usize = x2;
        let flags: usize = x3;
        let fd: usize = x4;
        // This kernel has no file-backed or shared mapping and no
        // executable anonymous memory (issue #174's W^X story): only a
        // private anonymous request with fd=-1 and no PROT_EXEC is
        // supported. mallocng's call shapes (fixed
        // MAP_FIXED guard page, PROT_NONE meta-area pool, PROT_READ|WRITE
        // growth) already satisfies this.
        if ((flags & 0x22) != 0x22 || fd != 0xFFFFFFFFFFFFFFFF ||
                (prot & 0x4) != 0) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (length == 0 || length > 0xFFFFFFFFFFFFF000) {
            return SyscallAction::Resume(0xFFFFFFFFFFFFFFFF);
        }
        let rounded: usize = (length + PAGE_SIZE - 1) & 0xFFFFFFFFFFFFF000;
        // musl uses MAP_FIXED to turn the first page of its brk arena into a
        // guard page. The pages are already present in this prototype's
        // eagerly mapped process arena, so preserve the requested address
        // without consuming space from the independent anonymous-map cursor.
        if (x0 != 0) {
            if (x0 < kernel_syscall_heap_start() ||
                x0 > kernel_syscall_heap_limit() ||
                rounded > kernel_syscall_heap_limit() - x0) {
                return SyscallAction::Resume(0xFFFFFFFFFFFFFFFF);
            }
            return SyscallAction::Resume(x0);
        }
        if (rounded > kernel_syscall_heap_limit() -
                kernel_syscall_heap_break()) {
            return SyscallAction::Resume(0xFFFFFFFFFFFFFFFF);
        }
        let result: usize = kernel_syscall_heap_break();
        if (kernel_syscall_heap_set(
                kernel_syscall_heap_break() + rounded) == false) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        return SyscallAction::Resume(result);
    }
    if (number == 215) {
        // munmap: the fixed short-lived process arena is reclaimed as a
        // unit; this does not relax load-time permissions.
        return SyscallAction::Resume(0);
    }
    if (number == 226) {
        let addr: usize = x0;
        let len: usize = x1;
        let prot: usize = x2;
        if (addr % PAGE_SIZE != 0 || len == 0) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let (span_ok, first, last) = user_range_l3_span(addr, len);
        if (span_ok == false) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let class: usize = user_page_class_at(kernel_process_current_root(), first);
        let mut index: usize = first;
        while (index <= last) {
            if (index >= USER_SPACE_PAGE_COUNT ||
                    user_page_class_at(kernel_process_current_root(), index) != class) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            index = index + 1;
        }
        // The only transition this bounded per-page model supports:
        // downgrading a currently read-write data/heap/stack range to
        // read-only+XN. Once downgraded (or if the range is already
        // text/rodata), the page is bit-identical to ELF-loaded rodata, so
        // re-widening permissions is refused rather than risked -- a real
        // error, never false success.
        if (prot == LINUX_PROT_READ && class == 3) {
            user_range_reprotect(kernel_process_current_root(), first, last, USER_RODATA_R_FLAGS);
            return SyscallAction::Resume(0);
        }
        if (prot == (LINUX_PROT_READ | LINUX_PROT_WRITE) && class == 3) {
            return SyscallAction::Resume(0);
        }
        return SyscallAction::Resume(LINUX_EACCES);
    }
    if (number == AARCH64_NR_READV) {
        let fd: usize = x0;
        let iov_address: usize = x1;
        let raw_iovcnt: usize = x2;
        if (raw_iovcnt == 0) { return SyscallAction::Resume(0); }
        if (raw_iovcnt >= 0 && raw_iovcnt < IOV_MAX) {
            let iovcnt: {0..<IOV_MAX as usize} = raw_iovcnt;
            let array_bytes: usize = match checked_mul_usize(iovcnt, sizeof(Iovec)) {
                CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
                CheckedUsize::Value(v) => { v }
            };
            match user_range_check_read(kernel_process_current_root(), iov_address, array_bytes) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(array_range) => {
                    let mut total: usize = 0;
                    for index: usize in 0..<iovcnt {
                        let (base_ok, iov_base) = user_read_u64(
                            array_range,
                            index * sizeof(Iovec) + offsetof(Iovec, iov_base));
                        let (len_ok, iov_len) = user_read_u64(
                            array_range,
                            index * sizeof(Iovec) + offsetof(Iovec, iov_len));
                        if (base_ok == false || len_ok == false) {
                            if (total == 0) { return SyscallAction::Resume(LINUX_EFAULT); }
                            return SyscallAction::Resume(total);
                        }
                        match syscall_readv_segment(
                                fd, iov_base as usize, iov_len as usize) {
                            ReadSegmentResult::Errno(e) => {
                                if (total == 0) { return SyscallAction::Resume(e); }
                                return SyscallAction::Resume(total);
                            }
                            ReadSegmentResult::Read(n) => {
                                match checked_add_usize(total, n) {
                                    CheckedUsize::Overflow => { return SyscallAction::Resume(total); }
                                    CheckedUsize::Value(v) => { total = v; }
                                }
                                // A shorter-than-requested segment means EOF
                                // was hit (ext2_read_small_file already
                                // clamps to the file's real remaining
                                // length) -- further segments would only
                                // ever read 0 too.
                                if (n == 0) { return SyscallAction::Resume(total); }
                            }
                        }
                    }
                    return SyscallAction::Resume(total);
                }
            }
        }
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    if (number == AARCH64_NR_WRITEV) {
        let fd: usize = x0;
        let iov_address: usize = x1;
        let raw_iovcnt: usize = x2;
        if (raw_iovcnt == 0) { return SyscallAction::Resume(0); }
        if (raw_iovcnt >= 0 && raw_iovcnt < IOV_MAX) {
            let iovcnt: {0..<IOV_MAX as usize} = raw_iovcnt;
            let array_bytes: usize = match checked_mul_usize(iovcnt, sizeof(Iovec)) {
                CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
                CheckedUsize::Value(v) => { v }
            };
            match user_range_check_read(kernel_process_current_root(), iov_address, array_bytes) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(array_range) => {
                    let mut total: usize = 0;
                    for index: usize in 0..<iovcnt {
                        let (base_ok, iov_base) = user_read_u64(
                            array_range,
                            index * sizeof(Iovec) + offsetof(Iovec, iov_base));
                        let (len_ok, iov_len) = user_read_u64(
                            array_range,
                            index * sizeof(Iovec) + offsetof(Iovec, iov_len));
                        if (base_ok == false || len_ok == false) {
                            if (total == 0) { return SyscallAction::Resume(LINUX_EFAULT); }
                            return SyscallAction::Resume(total);
                        }
                        match syscall_writev_segment(
                                fd, iov_base as usize, iov_len as usize) {
                            WriteSegmentResult::Errno(e) => {
                                if (total == 0) { return SyscallAction::Resume(e); }
                                return SyscallAction::Resume(total);
                            }
                            WriteSegmentResult::WouldBlock => {
                                if (total == 0) {
                                    return syscall_terminal_write_wait();
                                }
                                return SyscallAction::Resume(total);
                            }
                            WriteSegmentResult::Written(n) => {
                                match checked_add_usize(total, n) {
                                    CheckedUsize::Overflow => { return SyscallAction::Resume(total); }
                                    CheckedUsize::Value(v) => { total = v; }
                                }
                                // A short segment ends the call: what is left
                                // goes in the caller's next writev.
                                if (n < iov_len as usize) {
                                    return SyscallAction::Resume(total);
                                }
                            }
                        }
                    }
                    return SyscallAction::Resume(total);
                }
            }
        }
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    if (number == AARCH64_NR_PPOLL) {
        return syscall_ppoll_dispatch(x0, x1, x2, x3);
    }
    if (number == AARCH64_NR_NANOSLEEP) {
        match syscall_deadline_wait(x0, false) {
            SyscallDeadlineResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            SyscallDeadlineResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            SyscallDeadlineResult::Ready => {
                return SyscallAction::Resume(0);
            }
            SyscallDeadlineResult::Block => { return SyscallAction::Block; }
            SyscallDeadlineResult::WaitInterrupt => {
                return SyscallAction::WaitInterrupt;
            }
        }
    }
    if (number == AARCH64_NR_CLOCK_NANOSLEEP) {
        if (x0 != 1 || x1 > 1) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        match syscall_deadline_wait(x2, x1 == 1) {
            SyscallDeadlineResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            SyscallDeadlineResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            SyscallDeadlineResult::Ready => {
                return SyscallAction::Resume(0);
            }
            SyscallDeadlineResult::Block => { return SyscallAction::Block; }
            SyscallDeadlineResult::WaitInterrupt => {
                return SyscallAction::WaitInterrupt;
            }
        }
    }
    if (number == AARCH64_NR_PRLIMIT64) {
        // pid 0 is "me". A real pid is accepted only when it is this
        // process's own: reaching into another process's descriptor
        // limits mid-syscall is a cross-process write this kernel has no
        // safe path for, and ESRCH is what Linux reports for a pid it
        // will not act on.
        if (x0 != 0 && x0 != kernel_process_current_pid()) {
            return SyscallAction::Resume(LINUX_ESRCH);
        }
        // A resource number Linux does not have is EINVAL there, and was
        // silently "unlimited" here -- which answered a question about a
        // resource that does not exist. RLIM_NLIMITS is 16.
        if (x1 >= LINUX_RLIM_NLIMITS) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let mut soft: usize = LINUX_RLIM64_INFINITY;
        let mut hard: usize = LINUX_RLIM64_INFINITY;
        if (x1 == LINUX_RLIMIT_NOFILE) {
            match unified_process_fd_limit(kernel_syscall_process_slot()) {
                UnifiedFdLimitResult::Missing => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                UnifiedFdLimitResult::Found(pair) => {
                    let (live_soft, live_hard) = pair;
                    soft = live_soft;
                    hard = live_hard;
                }
            }
        }
        // The OLD value is reported before the new one is applied, which
        // is prlimit64's own contract and the reason one call can do both.
        if (x3 != 0) {
            match user_range_check_write(kernel_process_current_root(), x3,
                                         sizeof(usize) * 2) {
                UserWriteRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserWriteRangeResult::Ok(range) => {
                    let old_bytes = syscall_scratch_here().rlimit_buffer as []u8;
                    syscall_rlimit_store(old_bytes[0..<8], soft);
                    syscall_rlimit_store(old_bytes[8..<16], hard);
                    let reported: []u8 = old_bytes[0..<16];
                    let sent: bool = copy_to_user(range, reported);
                }
            }
        }
        if (x2 == 0) { return SyscallAction::Resume(0); }
        match user_range_check_read(kernel_process_current_root(), x2,
                                    sizeof(usize) * 2) {
            UserReadRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserReadRangeResult::Ok(range) => {
                let copied: bool = copy_from_user_raw(
                    range, syscall_scratch_here().rlimit_buffer as *u8, sizeof(usize) * 2);
            }
        }
        let new_bytes = syscall_scratch_here().rlimit_buffer as []u8;
        let new_soft: usize = syscall_rlimit_load(new_bytes[0..<8]);
        let new_hard: usize = syscall_rlimit_load(new_bytes[8..<16]);
        if (new_soft > new_hard) { return SyscallAction::Resume(LINUX_EINVAL); }
        // Every other resource Linux HAS is genuinely unlimited in this
        // kernel -- there is no storage sized by one and nothing that
        // checks one -- so a write to it is accepted and there is nothing
        // to store. That is the true answer; a resource number Linux does
        // not have at all was refused above.
        if (x1 != LINUX_RLIMIT_NOFILE) { return SyscallAction::Resume(0); }
        match unified_process_fd_limit_configure(
                kernel_syscall_process_slot(), new_soft, new_hard) {
            UnifiedFdResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            UnifiedFdResult::Ok => { return SyscallAction::Resume(0); }
        }
    }
    if (number == AARCH64_NR_UNAME) {
        match user_range_check_write(kernel_process_current_root(), x0, sizeof(Utsname)) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(range) => {
                let uname_bytes = syscall_scratch_here().uname_buffer as []u8;
                for zero_index: usize in 0..<sizeof(Utsname) {
                    syscall_scratch_here().uname_buffer[zero_index] = 0;
                }
                uname_write_field(uname_bytes[
                                      offsetof(Utsname, sysname)..<
                                      offsetof(Utsname, sysname) +
                                          UTSNAME_FIELD_SIZE],
                                  bs"Linux");
                uname_write_field(uname_bytes[
                                      offsetof(Utsname, nodename)..<
                                      offsetof(Utsname, nodename) +
                                          UTSNAME_FIELD_SIZE],
                                  bs"takibi");
                uname_write_field(uname_bytes[
                                      offsetof(Utsname, release)..<
                                      offsetof(Utsname, release) +
                                          UTSNAME_FIELD_SIZE],
                                  bs"6.1.0-takibi");
                uname_write_field(uname_bytes[
                                      offsetof(Utsname, version)..<
                                      offsetof(Utsname, version) +
                                          UTSNAME_FIELD_SIZE],
                                  bs"#1");
                uname_write_field(uname_bytes[
                                      offsetof(Utsname, machine)..<
                                      offsetof(Utsname, machine) +
                                          UTSNAME_FIELD_SIZE],
                                  bs"aarch64");
                uname_write_field(uname_bytes[
                                      offsetof(Utsname, domainname)..<
                                      offsetof(Utsname, domainname) +
                                          UTSNAME_FIELD_SIZE],
                                  bs"(none)");
                let source: []u8 = uname_bytes[0..<sizeof(Utsname)];
                let ok: bool = copy_to_user(range, source);
                return SyscallAction::Resume(0);
            }
        }
    }
    return SyscallAction::Resume(LINUX_ENOSYS);
}

const SYSCALL_TRAP_ESR: usize = 0x54000000;

private fn kernel_syscall_clone_failure_action(
        failure: ProcessCloneFailure) -> SyscallAction {
    match failure {
        ProcessCloneFailure::Invalid => {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        ProcessCloneFailure::ResourceExhausted => {
            return SyscallAction::Resume(LINUX_EAGAIN);
        }
    }
}

// Boot-time negative-test coverage for issue #175: the real BusyBox/musl
// binary never requests PROT_EXEC/a real fd for mmap, an invalid rt_sigaction
// signum, or a non-null rt_sigaction oldact it then checks byte-for-byte, so
// passing hardware behavior alone can't prove those reject/zero-fill paths
// work. Exercises kernel_syscall_dispatch directly with crafted esr/args
// (exception_class 0x15, matching the real SVC trap), using its own
// throwaway page for the oldact buffer.
//
// GitHub issue #258: that page's virtual address is claimed via
// user_va_find_free_run (kernel/mm/user_memory.tkb) instead of the former
// hardcoded SYSCALL_SUBSET_PROBE_L3_INDEX = 503, whose only protection
// against colliding with issue #174's own probe was a hand-written prose
// comment here saying it was "outside ... L3 indices 500-502" -- both
// sat inside process_image.tkb's stack-growth region (448..510) in the
// same root-0 L3 table.
fn kernel_syscall_subset_probe() -> bool !{unsafe} {
    let probe_index: usize = match user_va_find_free_run(1) {
        UserVaRunResult::None => { return false; }
        UserVaRunResult::Found(index) => { index }
    };
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(page) => {
            match address_space_map_page(
                    0, probe_index, page, USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    return false;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    return false;
                }
                AddressSpacePteWriteResult::Written => {}
            }
            let oldact_va: usize = USER_TEXT_VA + probe_index * PAGE_SIZE;

            let mut ok: bool = true;

            // A scheduled_process_alloc failure during clone is distinct
            // from invalid clone arguments at the Linux syscall boundary.
            let (invalid_clone_action, invalid_clone_value) =
                syscall_action_encode(kernel_syscall_clone_failure_action(
                    ProcessCloneFailure::Invalid));
            let (exhausted_clone_action, exhausted_clone_value) =
                syscall_action_encode(kernel_syscall_clone_failure_action(
                    ProcessCloneFailure::ResourceExhausted));
            if (invalid_clone_action != 1 ||
                invalid_clone_value != LINUX_EINVAL ||
                exhausted_clone_action != 1 ||
                exhausted_clone_value != LINUX_EAGAIN) {
                ok = false;
            }

            // mmap: PROT_EXEC is always rejected.
            let (action1, value1) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 222, 0, 4096, 0x4, 0x22,
                0xFFFFFFFFFFFFFFFF);
            if (action1 != 1 || value1 != LINUX_EINVAL) { ok = false; }

            // mmap: a real fd (file-backed) is always rejected.
            let (action2, value2) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 222, 0, 4096, 0x3, 0x22, 3);
            if (action2 != 1 || value2 != LINUX_EINVAL) { ok = false; }

            // rt_sigaction: signum 0 is rejected.
            let (action3, value3) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 134, 0, 0, 0, 0, 0);
            if (action3 != 1 || value3 != LINUX_EINVAL) { ok = false; }

            // rt_sigaction: a non-null oldact is zero-filled, not left as
            // whatever was already there (poison it first to prove that).
            match user_range_check_write(kernel_process_current_root(), oldact_va, 32) {
                UserWriteRangeResult::Fault => { ok = false; }
                UserWriteRangeResult::Ok(range) => {
                    let poisoned: bool = user_write_byte(range, 0, 0xAA);
                }
            }
            let (action4, value4) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 134, 1, 0, oldact_va, 0, 0);
            if (action4 != 1 || value4 != 0) { ok = false; }
            match user_range_check_read(kernel_process_current_root(), oldact_va, 1) {
                UserReadRangeResult::Fault => { ok = false; }
                UserReadRangeResult::Ok(range) => {
                    if (user_read_byte(range, 0) != 0) { ok = false; }
                }
            }

            user_pte_clear(probe_index);
            return ok;
        }
    }
}

// GitHub issue #453. Persistent syscall state belongs to ProcessRecord and
// transient buffers belong to the executing core, so distinct active cores do
// not share mutable handler state. On one core a timer interrupt already
// arrives inside a syscall -- interrupts are unmasked on EL0 entry -- but the
// switch is deferred to kernel_process_syscall_return_schedule. Enabling
// kernel preemption would let another handler overwrite that core's scratch.
fn syscall_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "per-core syscall scratch cannot survive preemption by another handler");
}
