        let mut requested_for_held: usize = 0xFFFFFFFFFFFFFFFF;
        if (selecting) { requested_for_held = requested_pid; }
        let zombie_stack_held: bool =
            kernel_process_current_child_zombie_stack_held(decision_guard,
