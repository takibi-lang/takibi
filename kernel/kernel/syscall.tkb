            ProcfsLookupResult::Missing => {}
            ProcfsLookupResult::Found(node) => {
                match user_range_check_write(
                        kernel_process_current_root(), x2, 128) {
                    UserWriteRangeResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    UserWriteRangeResult::Ok(range) => {
                        user_zero_fill(range);
                        user_write_u64(range, 8, node.inode as u64);
                        if (procfs_node_is_directory(node)) {
                            user_write_u32(range, 16, 0x416D as u32);
                            user_write_u32(range, 20, 2);
                        } else {
                            user_write_u32(range, 16, 0x8124 as u32);
                            user_write_u32(range, 20, 1);
