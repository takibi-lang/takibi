            match kernel_socket_fd_alloc(5) {
                KernelSocketFdAllocResult::Full => {
                    kernel_boot_log_resource_exhausted(
                        "process fd table" as *u8,
                        kernel_syscall_fd_limit_soft());
                    return SyscallAction::Resume(LINUX_EAGAIN);
                }
                KernelSocketFdAllocResult::Allocated(found) => { found }
            };
