          TcpConnectionAllocResult::Full => {
            kernel_boot_log_resource_exhausted(
                "TCP connection pool" as *u8, 0);
            return SyscallAction::Resume(LINUX_EAGAIN);
          }
          TcpConnectionAllocResult::Allocated(owner) => {
           let slot: usize = tcp_connection_slot(owner);
           let generation: usize = tcp_connection_identity(owner);
           match network_capability_take() {
            NetworkCapabilityTakeResult::Empty => {
                tcp_connection_free(owner);
                return SyscallAction::Resume(LINUX_EAGAIN);
            }
            NetworkCapabilityTakeResult::Ready(ready) => {
                match kernel_tcp_accept_once(
                        owner, ready, kernel_listener_port(accept_listener_fd)) {
                    KernelTcpAcceptResult::TimedOut(next) => {
                        match network_capability_put(next) {
                            NetworkCapabilityPutResult::Conflict => {
                                tcp_connection_free(owner);
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            NetworkCapabilityPutResult::Stored => {
                                syscall_test_evidence_record_accept_capability_roundtrip();
                                tcp_connection_free(owner);
                                return SyscallAction::Resume(LINUX_EAGAIN);
                            }
                        }
                    }
                    KernelTcpAcceptResult::Accepted(next) => {
                        match network_capability_put(next) {
                            NetworkCapabilityPutResult::Conflict => {
                                tcp_connection_free(owner);
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            NetworkCapabilityPutResult::Stored => {
                                syscall_test_evidence_record_accept_capability_roundtrip();
