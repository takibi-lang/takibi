use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/arch/arm64/kernel/user_entry_extern.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/net/socket_capability.tkb";
use "kernel/net/tcp.tkb";

const AARCH64_NR_WRITE: usize = 64;
const AARCH64_NR_EXIT: usize = 93;
const AARCH64_NR_EXIT_GROUP: usize = 94;
const LINUX_EBADF: usize = 0xFFFFFFFFFFFFFFF7;
const LINUX_EFAULT: usize = 0xFFFFFFFFFFFFFFF2;
const LINUX_ENOSYS: usize = 0xFFFFFFFFFFFFFFDA;
const LINUX_ENOENT: usize = 0xFFFFFFFFFFFFFFFE;
const LINUX_EINVAL: usize = 0xFFFFFFFFFFFFFFEA;
const LINUX_EAGAIN: usize = 0xFFFFFFFFFFFFFFF5;

enum KernelSocketState: u8 { Closed; Created; Bound; Listening; }

private let mut syscall_ext2_mount: Ext2Mount;
private let mut syscall_ext2_ready: bool;
private let mut syscall_file_open: bool;
private let mut syscall_file_readable: bool;
private let mut syscall_file_writable: bool;
private let mut syscall_file_inode: usize;
private let mut syscall_file_offset: usize;
private let mut syscall_file_buffer: [u8; KERNEL_BLOCK_SIZE];
private let mut syscall_open_calls: usize;
private let mut syscall_read_calls: usize;
private let mut syscall_file_write_calls: usize;
private let mut syscall_close_calls: usize;
private let mut syscall_socket_state: KernelSocketState =
    KernelSocketState::Closed;
private let mut syscall_socket_port: u16;
private let mut syscall_socket_calls: usize;
private let mut syscall_bind_calls: usize;
private let mut syscall_listen_calls: usize;
private let mut syscall_socket_close_calls: usize;
private let mut syscall_accept_calls: usize;
private let mut syscall_accept_capability_roundtrips: usize;
private let mut syscall_connected_open: bool;
private let mut syscall_connected_close_calls: usize;
private let mut syscall_connected_read_calls: usize;
private let mut syscall_connected_write_calls: usize;
private let mut syscall_socket_buffer: [u8; 1460];

private let mut syscall_heap_start: usize;
private let mut syscall_heap_limit: usize;
private let mut syscall_heap_break: usize;

fn kernel_syscall_process_configure(heap_start: usize, heap_limit: usize) {
    syscall_heap_start = heap_start;
    syscall_heap_limit = heap_limit;
    syscall_heap_break = heap_start;
    syscall_socket_state = KernelSocketState::Closed;
    syscall_socket_port = 0;
    syscall_socket_calls = 0;
    syscall_bind_calls = 0;
    syscall_listen_calls = 0;
    syscall_socket_close_calls = 0;
    syscall_accept_calls = 0;
    syscall_accept_capability_roundtrips = 0;
    syscall_connected_open = false;
    syscall_connected_close_calls = 0;
    syscall_connected_read_calls = 0;
    syscall_connected_write_calls = 0;
}

fn kernel_syscall_ext2_configure(mount: Ext2Mount) {
    syscall_ext2_mount = mount;
    syscall_ext2_ready = true;
    syscall_file_open = false;
    syscall_file_offset = 0;
    syscall_open_calls = 0;
    syscall_read_calls = 0;
    syscall_file_write_calls = 0;
    syscall_close_calls = 0;
}

fn kernel_syscall_file_evidence()
        -> (usize, usize, usize, usize) {
    return (syscall_open_calls, syscall_read_calls,
            syscall_file_write_calls, syscall_close_calls);
}

fn kernel_syscall_socket_evidence() -> bool {
    return syscall_socket_calls == 1 && syscall_bind_calls == 1 &&
           syscall_listen_calls == 1 && syscall_accept_calls == 1 &&
           syscall_accept_capability_roundtrips == 1 &&
           syscall_connected_open == false &&
           syscall_connected_close_calls == 1 &&
           syscall_connected_read_calls == 1 &&
           syscall_connected_write_calls == 1 &&
           syscall_socket_close_calls == 1 &&
           syscall_socket_state == KernelSocketState::Closed &&
           syscall_socket_port == 8080;
}

// Returns 1 for /hello.txt, 2 for /mutable.txt, and 0 for unsupported or
// invalid paths. Raw pointer reads are confined behind mapped-range checks.
fn kernel_syscall_path_kind(address: usize) -> usize {
    if (kernel_user_range_is_mapped(address, 11)) {
        let path: *u8 = address as *u8;
        if (path[0] == 0x2F && path[1] == 0x68 && path[2] == 0x65 &&
            path[3] == 0x6C && path[4] == 0x6C && path[5] == 0x6F &&
            path[6] == 0x2E && path[7] == 0x74 && path[8] == 0x78 &&
            path[9] == 0x74 && path[10] == 0) {
            return 1;
        }
    }
    if (kernel_user_range_is_mapped(address, 13)) {
        let path: *u8 = address as *u8;
        if (path[0] == 0x2F && path[1] == 0x6D && path[2] == 0x75 &&
            path[3] == 0x74 && path[4] == 0x61 && path[5] == 0x62 &&
            path[6] == 0x6C && path[7] == 0x65 && path[8] == 0x2E &&
            path[9] == 0x74 && path[10] == 0x78 && path[11] == 0x74 &&
            path[12] == 0) {
            return 2;
        }
    }
    return 0;
}

fn kernel_user_range_is_mapped(address: usize, length: usize) -> bool {
    if (length == 0) { return true; }
    if (address < USER_TEXT_VA || address >= USER_TEXT_VA + 0x200000 ||
        length > 0x200000 ||
        address - USER_TEXT_VA > 0x200000 - length) {
        return false;
    }
    let first: usize = (address - USER_TEXT_VA) / PAGE_SIZE;
    let last: usize = (address - USER_TEXT_VA + length - 1) / PAGE_SIZE;
    let mut index: usize = first;
    while (index <= last) {
        if (index >= 512 || user_pte_read(index) == 0) { return false; }
        index = index + 1;
    }
    return true;
}

must_use variant InitialUserLoadResult { Loaded; TooLarge; }

fn initial_user_load(text: borrow PageOwner[page])
        -> InitialUserLoadResult !{unsafe} {
    let length: usize = initial_user_payload_len();
    if (length > PAGE_SIZE) {
        return InitialUserLoadResult::TooLarge;
    }
    let source: *u8 = initial_user_payload_addr() as *u8;
    let source_bytes = unsafe { source[0..<length as isize] };
    let destination = page_bytes(text);
    slice_copy(destination, source_bytes);
    user_code_sync(page_physical_address(text), length);
    return InitialUserLoadResult::Loaded;
}

// Returns (action, value): 0 = fail-stop, 1 = resume EL0 with value in x0,
// 2 = terminate and return the exit status to run_initial_user's EL1 caller.
// Linux -errno encoding exists only here at the ABI boundary.
fn kernel_syscall_dispatch(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize) -> (usize, usize) !{unsafe} {
    let exception_class: usize = (esr >> 26) & 0x3F;
    if (exception_class != 0x15) { return (0, 0); }

    if (number == AARCH64_NR_WRITE) {
        let fd: usize = x0;
        let address: usize = x1;
        let length: usize = x2;
        if (kernel_user_range_is_mapped(address, length) == false) {
            return (1, LINUX_EFAULT);
        }
        if (fd == 5) {
            syscall_connected_write_calls =
                syscall_connected_write_calls + 1;
            if (syscall_connected_open == false || length == 0 ||
                length > 1460) {
                return (1, LINUX_EINVAL);
            }
            let received_length: usize = network_frame_length();
            match network_frame_take() {
                NetworkFrameTakeResult::Empty => {
                    return (1, LINUX_EAGAIN);
                }
                NetworkFrameTakeResult::Frame(frame) => {
                    let source: *u8 = address as *u8;
                    let mut index: usize = 0;
                    while (index < length) {
                        let buffered: *u8 = syscall_socket_buffer as *u8;
                        buffered[index as isize] = source[index as isize];
                        index = index + 1;
                    }
                    match kernel_tcp_send_received(
                            frame, syscall_socket_buffer as []u8,
                            received_length, length) {
                        KernelTcpSendResult::Invalid(ready) => {
                            match network_capability_put(ready) {
                                NetworkCapabilityPutResult::Stored => {
                                    return (1, LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Conflict => {
                                    return (1, LINUX_EINVAL);
                                }
                            }
                        }
                        KernelTcpSendResult::Sent(ready) => {
                            match network_capability_put(ready) {
                                NetworkCapabilityPutResult::Conflict => {
                                    return (1, LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    return (1, length);
                                }
                            }
                        }
                    }
                }
            }
        }
        if (fd == 3) {
            syscall_file_write_calls = syscall_file_write_calls + 1;
            if (syscall_file_open == false || syscall_file_writable == false) {
                return (1, LINUX_EBADF);
            }
            if (syscall_file_offset != 0 || length == 0 ||
                length > KERNEL_BLOCK_SIZE) {
                return (1, LINUX_EINVAL);
            }
            let source: *u8 = address as *u8;
            let buffer: *u8 = syscall_file_buffer as *u8;
            let mut copy_index: usize = 0;
            while (copy_index < length) {
                buffer[copy_index as isize] = source[copy_index as isize];
                copy_index = copy_index + 1;
            }
            let content = unsafe { buffer[0..<length as isize] };
            match ext2_resize_small_file(
                    syscall_ext2_mount, syscall_file_inode, content) {
                Ext2ResizeResult::Invalid => { return (1, LINUX_EINVAL); }
                Ext2ResizeResult::Resized => {
                    syscall_file_offset = length;
                    return (1, length);
                }
            }
        }
        if (fd != 1 && fd != 2) { return (1, LINUX_EBADF); }
        let mut cursor: *u8 = address as *u8;
        let mut remaining: usize = length;
        while (remaining != 0) {
            uart_putc(*cursor);
            cursor = cursor + 1;
            remaining = remaining - 1;
        }
        return (1, length);
    }

    if (number == 56) {
        syscall_open_calls = syscall_open_calls + 1;
        // openat(dirfd, pathname, flags): only absolute root paths are in
        // scope, so dirfd is intentionally ignored.
        if (syscall_ext2_ready == false || syscall_file_open) {
            return (1, LINUX_EBADF);
        }
        let path_kind: usize = kernel_syscall_path_kind(x1);
        if (path_kind == 0) { return (1, LINUX_ENOENT); }
        let mut name: []u8 = "hello.txt" as []u8;
        if (path_kind == 2) { name = "mutable.txt" as []u8; }
        match ext2_lookup_root(syscall_ext2_mount, name) {
            Ext2LookupResult::Invalid => { return (1, LINUX_EINVAL); }
            Ext2LookupResult::NotFound => { return (1, LINUX_ENOENT); }
            Ext2LookupResult::Found(inode_number) => {
                let access_mode: usize = x2 & 3;
                syscall_file_open = true;
                syscall_file_readable = access_mode != 1;
                syscall_file_writable = access_mode != 0;
                syscall_file_inode = inode_number;
                syscall_file_offset = 0;
                return (1, 3);
            }
        }
    }

    if (number == 63) {
        syscall_read_calls = syscall_read_calls + 1;
        let fd: usize = x0;
        let address: usize = x1;
        let requested: usize = x2;
        if (fd == 5) {
            syscall_connected_read_calls = syscall_connected_read_calls + 1;
            if (syscall_connected_open == false || requested == 0) {
                return (1, LINUX_EBADF);
            }
            if (kernel_user_range_is_mapped(address, requested) == false) {
                return (1, LINUX_EFAULT);
            }
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    return (1, LINUX_EAGAIN);
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    match kernel_tcp_receive_once(
                            ready, syscall_socket_buffer as []u8) {
                        KernelTcpReceiveResult::TimedOut(next) => {
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Stored => {
                                    return (1, LINUX_EAGAIN);
                                }
                                NetworkCapabilityPutResult::Conflict => {
                                    return (1, LINUX_EINVAL);
                                }
                            }
                        }
                        KernelTcpReceiveResult::Received(frame) => {
                            let received: usize =
                                kernel_tcp_received_length();
                            let mut amount: usize = received;
                            if (amount > requested) { amount = requested; }
                            let destination: *u8 = address as *u8;
                            let source: *u8 = syscall_socket_buffer as *u8;
                            let mut index: usize = 0;
                            while (index < amount) {
                                destination[index as isize] =
                                    source[index as isize];
                                index = index + 1;
                            }
                            match network_frame_install(frame, received) {
                                NetworkFrameInstallResult::Conflict(incoming) => {
                                    match kernel_tcp_send_received(
                                            incoming,
                                            syscall_socket_buffer as []u8,
                                            0, 0) {
                                        KernelTcpSendResult::Invalid(next) => {
                                            match network_capability_put(next) {
                                                NetworkCapabilityPutResult::Stored => { }
                                                NetworkCapabilityPutResult::Conflict => { }
                                            }
                                        }
                                        KernelTcpSendResult::Sent(next) => {
                                            match network_capability_put(next) {
                                                NetworkCapabilityPutResult::Stored => { }
                                                NetworkCapabilityPutResult::Conflict => { }
                                            }
                                        }
                                    }
                                    return (1, LINUX_EINVAL);
                                }
                                NetworkFrameInstallResult::Installed => {
                                    return (1, amount);
                                }
                            }
                        }
                    }
                }
            }
        }
        if (fd != 3 || syscall_file_open == false ||
            syscall_file_readable == false) {
            return (1, LINUX_EBADF);
        }
        if (kernel_user_range_is_mapped(address, requested) == false) {
            return (1, LINUX_EFAULT);
        }
        match ext2_read_small_file(
                syscall_ext2_mount, syscall_file_inode,
                syscall_file_buffer as []u8) {
            Ext2ReadResult::Invalid => { return (1, LINUX_EINVAL); }
            Ext2ReadResult::Read(file_length) => {
                if (syscall_file_offset >= file_length) { return (1, 0); }
                let available: usize = file_length - syscall_file_offset;
                let mut amount: usize = requested;
                if (amount > available) { amount = available; }
                let destination: *u8 = address as *u8;
                let source: *u8 = syscall_file_buffer as *u8;
                let mut copy_index: usize = 0;
                while (copy_index < amount) {
                    destination[copy_index as isize] =
                        source[(syscall_file_offset + copy_index) as isize];
                    copy_index = copy_index + 1;
                }
                syscall_file_offset = syscall_file_offset + amount;
                return (1, amount);
            }
        }
    }

    if (number == 57) {
        if (x0 == 5) {
            if (syscall_connected_open == false) {
                return (1, LINUX_EBADF);
            }
            syscall_connected_open = false;
            syscall_connected_close_calls =
                syscall_connected_close_calls + 1;
            return (1, 0);
        }
        if (x0 == 4) {
            if (syscall_socket_state == KernelSocketState::Closed) {
                return (1, LINUX_EBADF);
            }
            syscall_socket_state = KernelSocketState::Closed;
            syscall_socket_close_calls = syscall_socket_close_calls + 1;
            return (1, 0);
        }
        syscall_close_calls = syscall_close_calls + 1;
        if (x0 != 3 || syscall_file_open == false) {
            return (1, LINUX_EBADF);
        }
        syscall_file_open = false;
        syscall_file_offset = 0;
        return (1, 0);
    }

    if (number == 198) {
        // socket(AF_INET, SOCK_STREAM, 0). Flags in the high type bits are
        // accepted; only the underlying stream type is relevant here.
        syscall_socket_calls = syscall_socket_calls + 1;
        if (x0 != 2 || (x1 & 0xF) != 1 || x2 != 0 ||
            syscall_socket_state != KernelSocketState::Closed) {
            return (1, LINUX_EINVAL);
        }
        syscall_socket_state = KernelSocketState::Created;
        syscall_socket_port = 0;
        return (1, 4);
    }

    if (number == 200) {
        syscall_bind_calls = syscall_bind_calls + 1;
        if (x0 != 4 || syscall_socket_state != KernelSocketState::Created ||
            x2 < 16) {
            return (1, LINUX_EINVAL);
        }
        if (kernel_user_range_is_mapped(x1, 16) == false) {
            return (1, LINUX_EFAULT);
        }
        let address: *u8 = x1 as *u8;
        if (address[0] != 2 || address[1] != 0 ||
            address[4] != 0 || address[5] != 0 ||
            address[6] != 0 || address[7] != 0) {
            return (1, LINUX_EINVAL);
        }
        syscall_socket_port =
            (((address[2] as u16) << 8) | (address[3] as u16));
        if (syscall_socket_port == 0) { return (1, LINUX_EINVAL); }
        syscall_socket_state = KernelSocketState::Bound;
        return (1, 0);
    }

    if (number == 201) {
        syscall_listen_calls = syscall_listen_calls + 1;
        if (x0 != 4 || syscall_socket_state != KernelSocketState::Bound) {
            return (1, LINUX_EINVAL);
        }
        syscall_socket_state = KernelSocketState::Listening;
        return (1, 0);
    }

    if (number == 242) {
        // accept4(): hold the sole RX capability across the blocking TCP
        // handshake, then restore it before returning connected fd 5.
        syscall_accept_calls = syscall_accept_calls + 1;
        if (x0 != 4 || syscall_socket_state != KernelSocketState::Listening ||
            x3 != 0 || syscall_connected_open) {
            return (1, LINUX_EINVAL);
        }
        match network_capability_take() {
            NetworkCapabilityTakeResult::Empty => {
                return (1, LINUX_EAGAIN);
            }
            NetworkCapabilityTakeResult::Ready(ready) => {
                match kernel_tcp_accept_once(
                        ready, syscall_socket_port) {
                    KernelTcpAcceptResult::TimedOut(next) => {
                        match network_capability_put(next) {
                            NetworkCapabilityPutResult::Conflict => {
                                return (1, LINUX_EINVAL);
                            }
                            NetworkCapabilityPutResult::Stored => {
                                syscall_accept_capability_roundtrips =
                                    syscall_accept_capability_roundtrips + 1;
                                return (1, LINUX_EAGAIN);
                            }
                        }
                    }
                    KernelTcpAcceptResult::Accepted(next) => {
                        match network_capability_put(next) {
                            NetworkCapabilityPutResult::Conflict => {
                                return (1, LINUX_EINVAL);
                            }
                            NetworkCapabilityPutResult::Stored => {
                                syscall_accept_capability_roundtrips =
                                    syscall_accept_capability_roundtrips + 1;
                                syscall_connected_open = true;
                                return (1, 5);
                            }
                        }
                    }
                }
            }
        }
    }

    if (number == 71) {
        // sendfile(out_fd, in_fd, offset, count). BusyBox cat uses a null
        // offset, so the shared file position is sufficient for this first
        // Linux-compatible path. Output remains the existing UART console.
        let output_fd: usize = x0;
        let input_fd: usize = x1;
        let offset_address: usize = x2;
        let requested: usize = x3;
        if ((output_fd != 1 && output_fd != 2) || input_fd != 3 ||
            syscall_file_open == false || syscall_file_readable == false) {
            return (1, LINUX_EBADF);
        }
        if (offset_address != 0) { return (1, LINUX_EINVAL); }
        match ext2_read_small_file(
                syscall_ext2_mount, syscall_file_inode,
                syscall_file_buffer as []u8) {
            Ext2ReadResult::Invalid => { return (1, LINUX_EINVAL); }
            Ext2ReadResult::Read(file_length) => {
                if (syscall_file_offset >= file_length) { return (1, 0); }
                let available: usize = file_length - syscall_file_offset;
                let mut amount: usize = requested;
                if (amount > available) { amount = available; }
                let source: *u8 = syscall_file_buffer as *u8;
                let mut copy_index: usize = 0;
                while (copy_index < amount) {
                    uart_putc(source[(syscall_file_offset + copy_index) as isize]);
                    copy_index = copy_index + 1;
                }
                syscall_file_offset = syscall_file_offset + amount;
                syscall_read_calls = syscall_read_calls + 1;
                return (1, amount);
            }
        }
    }

    if (number == AARCH64_NR_EXIT || number == AARCH64_NR_EXIT_GROUP) {
        return (2, x0);
    }
    if (number == 96) {
        // set_tid_address(): this single-process kernel has PID/TID 1.
        return (1, 1);
    }
    if (number == 172 || number == 178) { return (1, 1); }
    if (number == 173 || (number >= 174 && number <= 177)) {
        return (1, 0);
    }
    if (number == 214) {
        if (x0 == 0) { return (1, syscall_heap_break); }
        if (x0 >= syscall_heap_start && x0 <= syscall_heap_limit) {
            syscall_heap_break = x0;
        }
        return (1, syscall_heap_break);
    }
    if (number == 222) {
        let length: usize = x1;
        if (length == 0 || length > syscall_heap_limit - syscall_heap_break ||
            length > 0xFFFFFFFFFFFFF000) {
            return (1, 0xFFFFFFFFFFFFFFFF);
        }
        let rounded: usize = (length + PAGE_SIZE - 1) & 0xFFFFFFFFFFFFF000;
        if (rounded > syscall_heap_limit - syscall_heap_break) {
            return (1, 0xFFFFFFFFFFFFFFFF);
        }
        let result: usize = syscall_heap_break;
        syscall_heap_break = syscall_heap_break + rounded;
        return (1, result);
    }
    if (number == 215 || number == 226) {
        // munmap/mprotect: the fixed short-lived process arena is reclaimed
        // as a unit, and its load-time permissions are not relaxed here.
        return (1, 0);
    }
    return (1, LINUX_ENOSYS);
}
