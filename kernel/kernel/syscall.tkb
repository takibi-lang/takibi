// Current limitations (2026-08-26). Keep this list current as
// call sites change; a limitation that goes stale here is worse than
// none. This file is the Linux syscall dispatch/policy layer, so its own
// scope is inherently broad -- `kernel/README.md`'s "Current limits"
// section is the authoritative per-syscall-family list (mmap/mprotect/
// munmap scope, signal delivery, scatter/gather I/O coverage, ppoll
// shape, and more); this note only covers what is specific to THIS
// file's own dispatch mechanics, not every syscall it implements.
// - EPHEMERAL SCRATCH IS PER CORE, so independent handlers on two cores do
//   not overwrite each other's file/path/sockaddr/uname/rlimit staging.
//   The init logging latch lives in ProcessRecord.
//   Exec handoff is still global even though it describes one process; it
//   must move to process-owned storage before dispatch can be concurrent.
//   Non-preemptible syscall execution is what keeps two processes on one core
//   from interleaving through it now.
// - Every fixed-capacity pool a syscall handler here allocates from
//   (process slots, fd table, shared objects, TCP connections, address
//   spaces) is documented once, authoritatively, in
//   `kernel/RESOURCE_LIMITS.md` -- do not re-derive a pool's exhaustion
//   behavior from a single call site here without checking that file
//   first, since the errno mapping at a given call site is meant to
//   match its pool's documented contract exactly (`LINUX_EMFILE` for
//   per-process fd exhaustion, `LINUX_ENFILE` for the global shared-
//   object pool, etc.).
// - execve argv is bounded to fifteen entries and 512 bytes, including
//   all interpreter arguments and script names in a nested shebang chain.
//   Up to five script levels are resolved; the sixth returns ELOOP.
//
const AARCH64_NR_WRITE: usize = 64;
const AARCH64_NR_IOCTL: usize = 29;
const AARCH64_NR_GETSID: usize = 156;
const AARCH64_NR_SETSID: usize = 157;
const AARCH64_NR_READV: usize = 65;
const AARCH64_NR_WRITEV: usize = 66;
const AARCH64_NR_PPOLL: usize = 73;
const AARCH64_NR_NANOSLEEP: usize = 101;
const AARCH64_NR_CLOCK_NANOSLEEP: usize = 115;
const AARCH64_NR_KILL: usize = 129;
const AARCH64_NR_RT_SIGTIMEDWAIT: usize = 137;
const AARCH64_NR_RT_SIGSUSPEND: usize = 133;
const AARCH64_NR_RT_SIGRETURN: usize = 139;
const AARCH64_NR_SYSLOG: usize = 116;
const AARCH64_NR_GETCWD: usize = 17;
// GitHub issue #581: the filesystem read path, named where the rest of this
// table's numbers are rather than as literals inside syscall_peer_safe.
const AARCH64_NR_OPENAT: usize = 56;
const AARCH64_NR_CLOSE: usize = 57;
const AARCH64_NR_NEWFSTATAT: usize = 79;
const AARCH64_NR_CHDIR: usize = 49;
const AARCH64_NR_GETITIMER: usize = 102;
const AARCH64_NR_SETITIMER: usize = 103;
const AARCH64_NR_RT_SIGACTION: usize = 134;
const AARCH64_NR_SIGALTSTACK: usize = 132;
// GitHub issue #1147.
const AARCH64_NR_STATFS: usize = 43;
const AARCH64_NR_GETRUSAGE: usize = 165;
const AARCH64_NR_UMASK: usize = 166;
// mmap(2) flags (uapi asm-generic/mman-common.h, mman.h).
const LINUX_MAP_SHARED: usize = 0x01;
const LINUX_MAP_PRIVATE: usize = 0x02;
const LINUX_MAP_TYPE: usize = 0x0F;
const LINUX_MAP_FIXED: usize = 0x10;
const LINUX_MAP_ANONYMOUS: usize = 0x20;
const AARCH64_NR_SET_TID_ADDRESS: usize = 96;
const AARCH64_NR_UNAME: usize = 160;
const AARCH64_NR_MADVISE: usize = 233;
const AARCH64_NR_SYSINFO: usize = 179;
const AARCH64_NR_GETCPU: usize = 168;
const AARCH64_NR_SCHED_SETAFFINITY: usize = 122;
const AARCH64_NR_SCHED_GETAFFINITY: usize = 123;
const AARCH64_NR_SCHED_YIELD: usize = 124;
// GitHub issue #393: the only rlimit syscall this architecture has.
// asm-generic (and therefore arm64) has no getrlimit/setrlimit numbers at
// all, and musl 1.2.6's getrlimit()/setrlimit() go through SYS_prlimit64
// first, so implementing this one implements all of them -- and it is
// what ash's `ulimit -n` reaches.
const AARCH64_NR_PRLIMIT64: usize = 261;
const AARCH64_NR_EXIT: usize = 93;
const AARCH64_NR_EXIT_GROUP: usize = 94;
const AARCH64_NR_CLONE: usize = 220;
const AARCH64_NR_VFORK: usize = 58;
const AARCH64_NR_FORK: usize = 107;
const AARCH64_NR_CLONE3: usize = 435;
const AARCH64_NR_EXECVE: usize = 221;
const AARCH64_NR_EXECVEAT: usize = 281;
const AARCH64_NR_WAIT4: usize = 260;
const AARCH64_NR_FCNTL: usize = 25;
// GitHub issue #1042: pipe2. AArch64 has no pipe(2); musl's pipe() is
// pipe2(fds, 0).
const AARCH64_NR_PIPE2: usize = 59;
const LINUX_O_CLOEXEC: usize = 0x80000;
const LINUX_EPIPE: usize = 0xFFFFFFFFFFFFFFE0;
// GitHub issue #1116: read on a listening or never-connected TCP socket.
const LINUX_ENOTCONN: usize = 0xFFFFFFFFFFFFFF95;
// GitHub issue #1121: read or write on a connection the peer reset.
const LINUX_ECONNRESET: usize = 0xFFFFFFFFFFFFFF98;
const LINUX_SIGPIPE: usize = 13;
// GitHub issue #1113: send/sendto's flag for EPIPE without SIGPIPE.
const LINUX_MSG_NOSIGNAL: usize = 0x4000;
// lseek: BusyBox head gives back the input it read past its last line with
// lseek(0, -n, SEEK_CUR), which on a pipe is ESPIPE (GitHub issue #1042).
const AARCH64_NR_LSEEK: usize = 62;
const LINUX_ESPIPE: usize = 0xFFFFFFFFFFFFFFE3;
const AARCH64_NR_TAKIBI_UART_RX_WAIT: usize = 451;
const AARCH64_NR_TAKIBI_PARENT_PROGRESS: usize = 452;
const AARCH64_NR_TAKIBI_WORKLOAD_PROGRESS: usize = 453;
const LINUX_EBADF: usize = 0xFFFFFFFFFFFFFFF7;
const LINUX_EFAULT: usize = 0xFFFFFFFFFFFFFFF2;
const LINUX_ENOSYS: usize = 0xFFFFFFFFFFFFFFDA;
const LINUX_ENOTTY: usize = 0xFFFFFFFFFFFFFFE7;
const LINUX_EAGAIN: usize = 0xFFFFFFFFFFFFFFF5;
const LINUX_EACCES: usize = 0xFFFFFFFFFFFFFFF3;
const LINUX_ECHILD: usize = 0xFFFFFFFFFFFFFFF6;
const LINUX_SIGCHLD: usize = 17;
const LINUX_SIGKILL: usize = 9;
const LINUX_SIGSTOP: usize = 19;

// kill's accepted signal numbers (GitHub issue #629): the null signal and
// the standard ones whose action this kernel can carry out.
fn kill_signal_accepted(signum: usize) -> bool {
    match signum {
        18 | 19 | 21 | 22 => { return false; }
        _ => { return signum <= 31; }
    }
}
// GitHub issue #295: distinct errno for fixed-pool exhaustion, previously
// collapsed into LINUX_EBADF (which real Linux reserves for an actually bad
// descriptor argument) at every fd-allocating syscall handler below.
// EMFILE = this process's own RLIMIT_NOFILE was reached (issue #393);
// ENFILE = the global shared object pool is full. GitHub issue #391 left
// that mapping alone and changed only what "full" means: the pool has no
// capacity constant, so what is reported is the derived system-wide bound
// (Linux's files_stat.max_files) or the page allocator being empty.
const LINUX_EMFILE: usize = 0xFFFFFFFFFFFFFFE8;
const LINUX_ENFILE: usize = 0xFFFFFFFFFFFFFFE9;
// GitHub issue #393: installing a descriptor can need a descriptor block,
// and the page allocator being empty is neither a bad argument nor a
// limit. Linux's own expand_files() returns ENOMEM for it.
const LINUX_ENOMEM: usize = 0xFFFFFFFFFFFFFFF4;
const LINUX_ESRCH: usize = 0xFFFFFFFFFFFFFFFD;
// execve(2) reached a regular file that carries neither an ELF header nor a
// usable `#!` interpreter line. Real Linux reports this so a shell can decide
// what to do with a file it asked the kernel to execute and the kernel
// declined; guessing an executable format on its behalf is what this errno
// exists to avoid.
const LINUX_E2BIG: usize = 0xFFFFFFFFFFFFFFF9;
const LINUX_ELOOP: usize = 0xFFFFFFFFFFFFFFD8;
const LINUX_ENOEXEC: usize = 0xFFFFFFFFFFFFFFF8;
// Linux's answer for an ELF interpreter that exists but cannot be used.
const LINUX_ELIBBAD: usize = 0xFFFFFFFFFFFFFFB0;
const LINUX_O_CREAT: usize = 0x40;
const LINUX_O_EXCL: usize = 0x80;
const LINUX_O_TRUNC: usize = 0x200;
// GitHub issue #1022.
const AARCH64_NR_TRUNCATE: usize = 45;
const AARCH64_NR_FTRUNCATE: usize = 46;
// The openat flags that mutate ext2 and so take the guard (#967, #1016).
const LINUX_O_MUTATING: usize = 0x240;
// LINUX_ENOENT, EINVAL, ENOSPC, EIO, EROFS, EEXIST, ENOTDIR, ENOTEMPTY,
// EISDIR and EPERM: kernel/fs/ext2/ext2_syscall.tkb (GitHub issue #1035).
const LINUX_EBUSY: usize = 0xFFFFFFFFFFFFFFF0;
const LINUX_ENODEV: usize = 0xFFFFFFFFFFFFFFED;
const LINUX_AT_REMOVEDIR: usize = 0x200;
// RLIMIT_NOFILE, and Linux's RLIM64_INFINITY.
const LINUX_RLIMIT_NOFILE: usize = 7;
// Linux's RLIM_NLIMITS (include/uapi/asm-generic/resource.h): the number of
// resources that exist, and therefore the first invalid one.
const LINUX_RLIM_NLIMITS: usize = 16;
const LINUX_RLIM64_INFINITY: usize = 0xFFFFFFFFFFFFFFFF;
const LINUX_SYSLOG_ACTION_READ_ALL: usize = 3;
const LINUX_SYSLOG_ACTION_SIZE_BUFFER: usize = 10;

// GitHub issue #393: AT_FDCWD, spelled the way userspace passes it -- the
// 32-bit -100 sign-extended into x0. It used to be caught by accident:
// the dirfd paths below tested `x0 < PROCESS_FD_MAX` before treating x0 as
// a directory descriptor, and AT_FDCWD failed that test along with every
// other out-of-range value. With no such range left, "relative to the
// current directory" has to be recognised for what it is, which is also
// what Linux does -- any OTHER value really is a descriptor, and an
// unopened one really is EBADF.
const LINUX_AT_FDCWD: usize = 0xFFFFFFFFFFFFFF9C;
const LINUX_AT_EACCESS: usize = 0x200;
const LINUX_F_DUPFD: usize = 0;
const LINUX_F_SETFD: usize = 2;
const LINUX_F_DUPFD_CLOEXEC: usize = 1030;
const LINUX_WNOHANG: usize = 1;

const LINUX_PROT_READ: usize = 1;
const LINUX_PROT_WRITE: usize = 2;

// Issue #196: ABI-facing layout structs used only for sizeof/offsetof --
// actual field access always goes through user_read_u32/u64/
// user_write_u16/copy_to_user against a scratch buffer or a validated
// UserRange, never a constructed struct value, matching this codebase's
// existing KernelElf64Header pattern (kernel/fs/elf64.tkb).

// struct utsname (aarch64 Linux ABI, <sys/utsname.h>): six 65-byte
// (64 chars + NUL) fields, no padding between them.
const UTSNAME_FIELD_SIZE: usize = 65;
struct packed Utsname {
    sysname: [u8; UTSNAME_FIELD_SIZE];
    nodename: [u8; UTSNAME_FIELD_SIZE];
    release: [u8; UTSNAME_FIELD_SIZE];
    version: [u8; UTSNAME_FIELD_SIZE];
    machine: [u8; UTSNAME_FIELD_SIZE];
    domainname: [u8; UTSNAME_FIELD_SIZE];
}

// struct iovec (aarch64 Linux ABI, <sys/uio.h>).
struct packed Iovec {
    iov_base: usize;
    iov_len: usize;
}

// struct pollfd (aarch64 Linux ABI, <poll.h>).
struct packed Pollfd {
    fd: i32;
    events: i16;
    revents: i16;
}

const POLLIN: usize = 0x0001;
const POLLOUT: usize = 0x0004;
const POLLERR: usize = 0x0008;
const POLLHUP: usize = 0x0010;
const POLLNVAL: usize = 0x0020;

// Linux's own iovec-count cap (UIO_MAXIOV, include/uapi/linux/uio.h) --
// keeps iovcnt*sizeof(Iovec) far below any real overflow risk even before
// checked_mul_usize is applied, and keeps the per-iovec/pollfd validation
// loop provably bounded for --forbid-trap. Checked as `>= IOV_MAX`
// (rejecting the boundary value itself, not just values above it) so the
// accepted range narrows cleanly to the refined type `{0..<IOV_MAX}`
// with no separate lower-bound proof needed.
const IOV_MAX: usize = 1024;
// This kernel's own cap for pollfd arrays (not a Linux constant), same
// rationale and same off-by-one-avoiding `>=` check.
const POLL_MAX: usize = 1024;

// GitHub issue #409 removed the second name for the descriptor capacity
// from this file; issue #393 removed the capacity. The socket paths here
// range-checked fd values against it and then delegated to
// unified_fd_alloc/unified_socket_lookup; there is no range to check any
// more -- a descriptor is admitted by this process's own RLIMIT_NOFILE and
// validated by whether its block chain holds it, both of which are
// fd_table.tkb's to answer.
//
// The incident that makes a duplicated capacity worth remembering is
// recorded in kernel/RESOURCE_LIMITS.md: this file carried a literal 8
// while the real table was 16, so socket()/accept() reported resource
// exhaustion at fd>=8 while free slots existed -- a wrong refusal rather
// than a compile error, hit by a shell whose first eight descriptors were
// busy. Issue #295 made it a real reference so it could not drift
// numerically, #409 removed the second name, and #393 removed the number
// itself: what is left cannot disagree with anything.

// Boot configures this context before EL0 dispatch is enabled. The zero tag
// is Unconfigured; a mount can only be extracted from the Configured case.
// This combines readiness and its descriptor, not filesystem mutation locking.
variant SyscallFilesystemState { Unconfigured; Configured(Ext2Mount); }
struct SyscallFilesystemContext {
    private state: SyscallFilesystemState;
}
private let mut syscall_filesystem: SyscallFilesystemContext;
must_use variant SyscallFilesystemReady { Unconfigured; Configured(Ext2Mount); }

private fn syscall_filesystem_lookup() -> SyscallFilesystemReady {
    match syscall_filesystem.state {
        SyscallFilesystemState::Unconfigured => {
            return SyscallFilesystemReady::Unconfigured;
        }
        SyscallFilesystemState::Configured(mount) => {
            return SyscallFilesystemReady::Configured(mount);
        }
    }
}
const SYSCALL_SCRIPT_LINE_MAX: usize = 256;
// Scratch that lives only for one section of one syscall. The file buffer is a bounded one-block staging
// area, not a whole-file cache; read/readv/sendfile stream each chunk onward,
// so its size does not limit the file size userspace can consume. execve uses
// three disjoint regions of that same invocation-local buffer for argv, path,
// and script-header staging; it never overlaps a file-data syscall.
// GitHub issue #1066: the ELF header/program-table window execve validates
// at syscall time. The mapping path's EXEC_METADATA_SIZE
// (kernel/init/test_driver.tkb) is defined as this constant, so both run
// distro_elf_validate_with_length over the same prefix and refuse the same
// files; a change to one size is a change to both.
const SYSCALL_EXEC_ELF_WINDOW_SIZE: usize = 1024;

struct SyscallScratch {
    file_buffer: [u8; KERNEL_BLOCK_SIZE];
    path_buffer: [u8; 256];
    sockaddr_buffer: [u8; 28];
    // Headroom over sizeof(Utsname) (390 bytes), since array declarations
    // cannot use sizeof directly.
    uname_buffer: [u8; 512];
    // Two struct rlimit64 values. User memory is never accessed in place.
    rlimit_buffer: [u8; 16];
    // GitHub issue #591: an ELF's PT_INTERP name, for the ext2 lookup.
    interpreter_buffer: [u8; 64];
    // The ELF plan retains its metadata view. Keep this per-core window
    // separate from argv/path staging while resolving script interpreters.
    elf_buffer: [u8; SYSCALL_EXEC_ELF_WINDOW_SIZE];
}

// GitHub issue #203: per-call scratch. Every function that touches it sees
// it uninitialized on entry, whatever an earlier call left there, so a
// buffer is zero-filled or written whole before it is read or copied out.
//
// GitHub issue #638: the scratch is a pool of KERNEL_MAX_CORES slots, one per
// scratch-using section in flight, not one per CPU. A section is acquired
// narrowly around the handler that uses the buffers -- one that waits only a
// bounded time (ext2, block I/O) -- and never across a sleeping wait: a
// syscall sleeps only after its handler has returned SyscallAction::Block,
// and the linear SyscallSlot must be released before then. The compiler
// rejects a handler that forgets to release it, releases it twice, or keeps
// using it after the release. Static storage rather than kernel-stack
// buffers (DECISIONS.md 2026-10-17, stack-conservative).
//
// Trusted here, and only here (TRUSTED_BASE.md): syscall_slot_acquire
// returns a slot no other live SyscallSlot names. Its compare-exchange over
// syscall_slot_words is what makes that so; nothing checks it. Each element
// of the scratch global is therefore reached only by its slot's holder,
// which is the premise definite initialization takes for a scratch array.
//
// scripts/check_slot_pool_entries.py checks that no slot holder reaches
// another entry point (one slot per operation, so the pool cannot run dry
// with every holder waiting for a second), that no holder reaches a
// scheduler sleep (kernel_process_block_*), and that no function but the
// acquire returns a slot. A syscall holds its SyscallSlot while ext2, the
// block layer or the exec loader take their own pools' slots, never the
// reverse.
//
// Current limitations (2026-10-17):
// - While KERNEL_PREEMPTIBLE is 0 and every in-handler wait spins, at most
//   one section per CPU is live, so the acquire never waits.
private scratch let mut syscall_scratch: [SyscallScratch; KERNEL_MAX_CORES];
private let mut syscall_slot_words: [AtomicWord; KERNEL_MAX_CORES];

// `[unit]` is always 0: an owner needs a static parameter, and the slot's
// identity is its private index, which only this file reads.
linear struct SyscallSlot[unit: usize] {
    private index: {0..<KERNEL_MAX_CORES as usize};
}

// A free slot, waiting for one if every slot is held. The compare-exchange
// is an acquire, pairing with the release store in syscall_slot_release.
private fn syscall_slot_acquire() -> SyscallSlot[0] !{may_block} {
    preempt_assert_blockable();
    let mut index: {0..<KERNEL_MAX_CORES as usize} = 0;
    let mut held: bool = false;
    while (held == false) {
        for i: usize in 0..<KERNEL_MAX_CORES {
            if (held == false &&
                atomic_word_compare_exchange(&syscall_slot_words[i], 0, 1)) {
                index = i;
                held = true;
            }
        }
    }
    let mut slot: SyscallSlot[0] = { index };
    return slot;
}

private fn syscall_slot_release(slot: sink SyscallSlot[0]) {
    atomic_word_store(&syscall_slot_words[slot.index], 0);
}

// GitHub issue #559: this CPU's current syscall is a counted ext2 reader
// and owes ext2_read_leave. Kept out of the scratch above: it is state one
// function leaves for another, not per-call scratch.
// A per-CPU store (#704, #981), reached only with the CpuHere a preempt_off
// block mints; an MPIDR beyond KERNEL_MAX_CORES stops in the mint instead of
// sharing core 0's flag.
struct per_cpu SyscallExt2Reader {
    private reading: bool;
}
private let mut syscall_ext2_reader: [SyscallExt2Reader; KERNEL_MAX_CORES];

private fn syscall_ext2_reader_mark() {
    preempt_off (cpu) { syscall_ext2_reader[cpu].reading = true; }
}

// Whether this CPU's syscall was a counted reader, clearing the mark: the
// caller owes ext2_read_leave exactly when this answers true.
private fn syscall_ext2_reader_take() -> bool {
    preempt_off (cpu) {
        let reading: bool = syscall_ext2_reader[cpu].reading;
        syscall_ext2_reader[cpu].reading = false;
        return reading;
    }
}
// GitHub issue #257: connection_open, socket_buffer_length/_offset and
// inetd_response_length used to be four more [T; TCP_CONNECTION_MAX]
// arrays here (step 2), and syscall_socket_buffer/syscall_inetd_response
// two more, at 1460 bytes per connection each (step 4b). All six are gone,
// and the inetd response frame and length went with inetd mode (#835).
// The scalars are fields of kernel/net/tcp.tkb's TcpConnection; the two
// buffers are pooled NetFrames owned there, reached by holding the frame's
// permission (tcp_connection_frame_hold, #677). **No storage in
// this file is keyed by a connection index any more.** TCP_CONNECTION_MAX
// itself still appears, as the refinement on slot values passed across the
// tcp.tkb boundary ({0..<TCP_CONNECTION_MAX as usize}) and the loops that
// reset every connection -- proofs about an index, not the size of
// anything here. Those go when step 5 makes a connection's identity an
// address.

// struct rlimit64 is two little-endian u64s. Written a byte at a time
// rather than through a pointer cast onto the buffer: the cast would be
// unsafe (issue #316) and would assume an alignment a u8 array does not
// promise, and this is called twice per prlimit64 call.
private fn syscall_rlimit_store(field: borrow uninit [u8; 8..], value: usize)
        ensures init(field[0..<8]) {
    for i: usize in 0..<8 {
        field[i] = ((value >> (i * 8)) & 0xFF) as u8;
    }
}

private fn syscall_rlimit_load(field: borrow [u8; 8..]) -> usize {
    let mut value: usize = 0;
    for i: usize in 0..<8 {
        value = value | ((field[i] as usize) << (i * 8));
    }
    return value;
}

// GitHub issue #392: CloneFileState and UartBlockDelivery, and the two
// `[T; KERNEL_PROCESS_MAX]` arrays that held them, are gone from this
// file. The original two were keyed by process slot, which is a key that stops
// existing when the process table becomes a pool; the values are fields
// of ProcessRecord now, reached through
// scheduled_process_clone_file_state()/_uart_block_delivery() and their
// setters. Every decision made with them is still made here.
// The first line of an execve(2) target, read before any image is chosen.
// Bounded on purpose: this is the whole window in which a `#!` interpreter
// directive is allowed to live, and the kernel must decide the executable
// format from a fixed-size read rather than a file-length-dependent scan.
//
// 256 is Linux's own BINPRM_BUF_SIZE, and matching it exactly is what makes
// the boundary behave the same: an interpreter name that does not fit is
// ENOEXEC on both, and one that does fit is resolved on both. The window is
// zero-filled before the read for the same reason Linux zero-pads its
// buffer -- a file with no trailing newline then ends at a NUL, which the
// scan below treats as the end of the directive.

must_use variant SyscallPathResult { Fault; Invalid; Name([]u8); }

fn kernel_syscall_exec_pending() -> bool {
    let mut slot: ProcessSlot = kernel_syscall_process_slot();
    let guard = process_run_lock();
    let value: bool = scheduled_process_exec_pending(guard, slot);
    process_run_unlock(guard);
    return value;
}
fn kernel_syscall_exec_argc() -> usize {
    let mut slot: ProcessSlot = kernel_syscall_process_slot();
    let guard = process_run_lock();
    let value: usize = scheduled_process_exec_argc(guard, slot);
    process_run_unlock(guard);
    return value;
}
// GitHub issue #693 step 5: the exec's argv, copied under the run guard into
// a buffer the exec owns, as Linux's linux_binprm and FreeBSD's image_args
// do. The record's command line stays the ps/procfs cache; the exec's map
// path takes the run lock itself, so it cannot read the record under a
// guard held across it.
// GitHub issue #700: the page a child's exec copies its argv into is taken
// before execve decides ChildExec, so a shortage is the caller's ENOMEM
// rather than a fail-stop after the point of no return (Linux allocates
// linux_binprm before begin_new_exec for the same reason).
// GitHub issue #1080: execve returns the page in its own result
// (SyscallExecveResult::ChildExec), and dispatch hands it straight to
// kernel_syscall_child_exec_return before anything reaches user_entry.S, so
// no slot holds it in between, and a prepare without a page, or a second
// page beside it, cannot be written.

fn kernel_syscall_exec_argv_copy(destination: borrow [u8; 512..]) !{unsafe} {
    let mut slot: ProcessSlot = kernel_syscall_process_slot();
    let guard = process_run_lock();
    let copied: usize = slice_copy(destination as []u8,
        scheduled_process_command_line(guard, slot) as []u8);
    process_run_unlock(guard);
}
fn kernel_syscall_exec_clear() {
    // No caller holds the run lock (test_driver's exec handoff).
    let guard = process_run_lock();
    scheduled_process_set_exec_pending(guard, kernel_syscall_process_slot(),
                                       false);
    process_run_unlock(guard);
}

// execve's file_buffer staging spans several functions of one call. GitHub
// issue #974: these three views, and every function between them and
// syscall_execve_current's zero fill, require the buffer initialized, so
// each call is checked rather than trusted (they replaced assume_init).
private fn syscall_exec_argv_here(slot: borrow SyscallSlot[0]) -> [u8; 512..]
        requires init(syscall_scratch[slot.index].file_buffer) {
    static_assert(PROCESS_EXEC_ARGV_BYTES == 512,
                  "#1039: the argv staging area is execve's argv limit");
    let scratch: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch[slot.index].file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    return scratch[0..<512];
}

private fn syscall_exec_path_here(slot: borrow SyscallSlot[0]) -> [u8; 256..]
        requires init(syscall_scratch[slot.index].file_buffer) {
    let scratch: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch[slot.index].file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    return scratch[512..<768];
}

private fn syscall_script_line_here(slot: borrow SyscallSlot[0]) -> [u8; 256..]
        requires init(syscall_scratch[slot.index].file_buffer) {
    let scratch: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch[slot.index].file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    return scratch[768..<1024];
}

// GitHub issue #591, #1065: the inode execve resolved its pathname to,
// through any `#!` chain -- the one input that decides the image an exec
// maps. argv[0] cannot: a shell passes `httpd` for `/bin/httpd`. Zero only
// when execve ran before the root filesystem was configured.
//
// GitHub issue #1082: the inode travels as a SyscallExecInode, whose one
// field is private to this file, so outside it the only way to hold one is
// to be handed it: every value the exec prepare can see was minted by
// syscall_exec_elf_interpreter's verdict (or is the zero "none" token).
// The token cannot cross the user_entry.S return (#1080), so it is parked
// as bits in the process record between the syscall and the prepare; that
// round trip -- syscall_exec_inode_store below and this reload -- is the
// remaining trusted base, and both halves are in this file. The store's
// process.tkb setter takes a bare usize, so scripts/
// buildcheck_allowed_callers.py pins its one caller to the store (#1106).
struct SyscallExecInode { private inode: usize; }

private fn syscall_exec_inode_none() -> SyscallExecInode {
    let mut token: SyscallExecInode = { 0 };
    return token;
}

fn syscall_exec_inode_number(token: SyscallExecInode) -> usize {
    return token.inode;
}

private fn syscall_exec_inode_store(guard: borrow ProcessRunGuard[lock],
                                    token: SyscallExecInode) {
    scheduled_process_set_exec_inode(guard,
        kernel_syscall_process_slot(), token.inode);
}

fn kernel_syscall_exec_inode() -> SyscallExecInode {
    let mut slot: ProcessSlot = kernel_syscall_process_slot();
    let guard = process_run_lock();
    let value: usize = scheduled_process_exec_inode(guard, slot);
    process_run_unlock(guard);
    let mut token: SyscallExecInode = { value };
    return token;
}

// A `#!` script is executed by naming an interpreter, so the image execve(2)
// finally loads is not the file the caller named. Both facts are staged here
// before any image is chosen: `argc`/`length` describe the replacement argv
// prefix already written into syscall_exec_argv.
struct SyscallScriptPrefix {
    argc: usize;
    length: usize;
    inode: SyscallExecInode;
}

// Each case below was measured against Linux rather than assumed, because
// the errno is the whole interface a shell has to this decision:
//   absent path                        ENOENT
//   directory, or any non-regular file EACCES
//   regular file with no execute bit   EACCES   (before any header is read)
//   regular file, not ELF and not `#!` ENOEXEC
//   `#!` naming a missing interpreter  ENOENT   (the interpreter's error)
must_use variant SyscallExecFormatResult {
    // No filesystem yet. The caller keeps whatever image-selection path it
    // already had; deciding a format needs a file to read, and at this point
    // in the boot there is nowhere to read one from.
    NotMounted;
    Absent;
    NotPermitted;
    Unreadable;
    Executable(SyscallExecInode);
    NotExecutable;
    // GitHub issue #591: an ELF whose PT_INTERP names a file that is not
    // there -- ENOENT, as on Linux -- and one naming a file that is, but is
    // not the musl loader, the only interpreter this kernel maps (ELIBBAD).
    InterpreterAbsent;
    InterpreterUnsupported;
    Invalid;
    TooBig;
    TooDeep;
    Script(SyscallScriptPrefix);
}

must_use variant SyscallExecTargetResult {
    Absent;
    NotPermitted;
    Inode(usize);
}

// The kernel has no user/group identity model yet. A requested operation is
// permitted when any corresponding owner, group, or other mode bit is set.
// Both faccessat X_OK and execve use this same execute-bit rule; execve also
// requires a regular file before it asks the question.
private fn syscall_inode_mode_allows(inode_mode: usize, requested: usize)
        -> bool {
    if ((requested & 4) != 0 && (inode_mode & 0x124) == 0) { return false; }
    if ((requested & 2) != 0 && (inode_mode & 0x92) == 0) { return false; }
    if ((requested & 1) != 0 && (inode_mode & 0x49) == 0) { return false; }
    return true;
}

// Does this pathname name something this kernel may execute at all? Asked
// before any byte of the file is read, in the order Linux asks it: a
// directory or a device node is refused for being the wrong kind of object,
// and a regular file with no execute bit is refused for being unexecutable,
// neither of which is a statement about its contents.
private fn syscall_exec_target(mount: Ext2Mount, name: []u8) -> SyscallExecTargetResult
        !{unsafe} {

    match ext2_lookup_path(mount, name) {
        Ext2LookupResult::Invalid => { return SyscallExecTargetResult::Absent; }
        Ext2LookupResult::NotFound => {
            return SyscallExecTargetResult::Absent;
        }
        Ext2LookupResult::Found(inode) => {
            let mode: usize = ext2_inode_mode(mount, inode);
            if ((mode & 0xF000) != 0x8000) {
                return SyscallExecTargetResult::NotPermitted;
            }
            // 0o111. Linux refuses a regular file with no execute bit before
            // it reads a single header byte, and CAP_DAC_OVERRIDE does not
            // bypass exec permission -- so a uid-0 process sees this same
            // refusal, which is what makes it the right answer for a kernel
            // that has no uid model of its own yet.
            if (syscall_inode_mode_allows(mode, 1) == false) {
                return SyscallExecTargetResult::NotPermitted;
            }
            return SyscallExecTargetResult::Inode(inode);
        }
    }
}

must_use variant SyscallArgvAppendResult { Full; Appended(usize); }

// Append one NUL-terminated entry to the pending execve argv buffer and
// return the offset the next entry starts at.
private fn syscall_exec_argv_append(slot: borrow SyscallSlot[0], offset: usize, source: []u8)
        -> SyscallArgvAppendResult
        requires init(syscall_scratch[slot.index].file_buffer) {
    let argv_view: []u8 = syscall_exec_argv_here(slot);
    if (offset > argv_view.len) { return SyscallArgvAppendResult::Full; }
    let tail = argv_view[offset..<argv_view.len];
    let length: usize = source.len;
    if (length > tail.len) { return SyscallArgvAppendResult::Full; }
    let destination = tail[0..<length];
    if (slice_copy(destination, source) != length) {
        return SyscallArgvAppendResult::Full;
    }
    if (length < tail.len) {
        tail[length] = 0;
    } else {
        return SyscallArgvAppendResult::Full;
    }
    return SyscallArgvAppendResult::Appended(offset + length + 1);
}

// The same append, for a byte range of the staged `#!` line. It walks the
// staging array's own static size rather than subslicing it, so the range the
// directive parser produced needs no relational proof between its two ends:
// every index is bounded by the array, and the range is a filter over that
// walk instead of a slice construction.
private fn syscall_exec_argv_append_line(slot: borrow SyscallSlot[0], offset: usize, from: usize,
                                         to: usize)
        -> SyscallArgvAppendResult
        requires init(syscall_scratch[slot.index].file_buffer) {
    let argv_view: []u8 = syscall_exec_argv_here(slot);
    let line: []u8 = syscall_script_line_here(slot);
    let mut cursor: usize = offset;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= from && position < to) {
            let value: u8 = line[position];
            if (cursor < argv_view.len) {
                argv_view[cursor] = value;
            } else {
                return SyscallArgvAppendResult::Full;
            }
            cursor = cursor + 1;
        }
    }
    if (cursor < argv_view.len) {
        argv_view[cursor] = 0;
    } else {
        return SyscallArgvAppendResult::Full;
    }
    return SyscallArgvAppendResult::Appended(cursor + 1);
}

// Prepend the staged directive's interpreter, optional single argument,
// and current script pathname. Each rewrite drops the preceding argv[0],
// so the deepest interpreter comes first and earlier script names follow.
// The stored pathname then becomes the next interpreter to resolve.
private fn syscall_exec_script_prefix(slot: borrow SyscallSlot[0], path_length: usize, previous_argc: usize,
                                      previous_length: usize)
        -> SyscallExecFormatResult
        requires init(syscall_scratch[slot.index].file_buffer) {
    let line: []u8 = syscall_script_line_here(slot);
    let mut end: usize = 0;
    let mut line_terminated: bool = false;
    // The whole window is scanned, not only the bytes the file supplied: it
    // was zero-filled first, so a file with no trailing newline ends at a
    // padding NUL. Linux ends the directive at '\n' OR NUL for exactly that
    // reason, and `#!/bin/sh` with no newline is a working script there.
    //
    // CR is deliberately NOT a terminator. A CRLF script carries an
    // interpreter named "/bin/sh\r", which does not exist -- Linux reports
    // ENOENT for it, and being more forgiving here would mean a script that
    // runs on this kernel and fails on Linux.
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (line_terminated == false) {
            let current: u8 = line[position];
            if (current == 0x0A || current == 0) {
                end = position;
                line_terminated = true;
            }
        }
    }
    // A first line that fills the whole staging window without ending is a
    // truncated directive. The interpreter name it appears to carry may be
    // cut in half, and running the wrong program is worse than refusing.
    if (line_terminated == false) {
        return SyscallExecFormatResult::NotExecutable;
    }
    let mut interpreter_start: usize = end;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= 2 && position < end && interpreter_start == end) {
            let current: u8 = line[position];
            if (current != 0x20 && current != 0x09) {
                interpreter_start = position;
            }
        }
    }
    let mut interpreter_end: usize = end;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= interpreter_start && position < end &&
            interpreter_end == end) {
            let current: u8 = line[position];
            if (current == 0x20 || current == 0x09) {
                interpreter_end = position;
            }
        }
    }
    let mut argument_start: usize = end;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= interpreter_end && position < end &&
            argument_start == end) {
            let current: u8 = line[position];
            if (current != 0x20 && current != 0x09) {
                argument_start = position;
            }
        }
    }
    let mut argument_end: usize = argument_start;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= argument_start && position < end) {
            let current: u8 = line[position];
            if (current != 0x20 && current != 0x09) {
                argument_end = position + 1;
            }
        }
    }
    let interpreter_from: usize = interpreter_start;
    let interpreter_to: usize = interpreter_end;
    if (interpreter_from >= interpreter_to) {
        return SyscallExecFormatResult::NotExecutable;
    }
    if (interpreter_to > SYSCALL_SCRIPT_LINE_MAX) {
        return SyscallExecFormatResult::NotExecutable;
    }
    // A relative interpreter name would have to be resolved against a working
    // directory this kernel does not track. Linux resolves it against the
    // caller's cwd and reports ENOENT when that fails, which is the same
    // answer this reaches by a shorter route -- and the same answer a shell
    // has to act on either way.
    let mut interpreter_absolute: bool = false;
    if (interpreter_from < line.len) {
        interpreter_absolute = line[interpreter_from] == 0x2F;
    }
    if (interpreter_absolute == false) {
        return SyscallExecFormatResult::Absent;
    }
    // Each new interpreter replaces the previous argv[0]. Preserve the
    // remainder before writing its prefix, so deeper levels precede earlier
    // directive arguments and script names without recursive stack growth.
    let mut previous: [u8; 512];
    let argv: []u8 = syscall_exec_argv_here(slot);
    let mut tail_start: usize = 0;
    let mut first_ended: bool = previous_argc == 0;
    if (previous_length > 512) { return SyscallExecFormatResult::TooBig; }
    for position: usize in 0..<512 {
        previous[position] = argv[position];
        if (first_ended == false && position < previous_length &&
            argv[position] == 0) {
            tail_start = position + 1;
            first_ended = true;
        }
    }
    let mut offset: usize = 0;
    let mut argc: usize = 0;
    match syscall_exec_argv_append_line(slot, offset, interpreter_from,
                                        interpreter_to) {
        SyscallArgvAppendResult::Full => {
            return SyscallExecFormatResult::TooBig;
        }
        SyscallArgvAppendResult::Appended(next) => { offset = next; }
    }
    argc = argc + 1;
    let argument_from: usize = argument_start;
    let argument_to: usize = argument_end;
    if (argument_from < argument_to) {
        match syscall_exec_argv_append_line(slot, offset, argument_from,
                                            argument_to) {
            SyscallArgvAppendResult::Full => {
                return SyscallExecFormatResult::TooBig;
            }
            SyscallArgvAppendResult::Appended(next) => { offset = next; }
        }
        argc = argc + 1;
    }
    let stored_path: []u8 = syscall_exec_path_here(slot);
    if (path_length > stored_path.len) {
        return SyscallExecFormatResult::Invalid;
    }
    let script_path = stored_path[0..<path_length];
    match syscall_exec_argv_append(slot, offset, script_path) {
        SyscallArgvAppendResult::Full => {
            return SyscallExecFormatResult::TooBig;
        }
        SyscallArgvAppendResult::Appended(next) => { offset = next; }
    }
    argc = argc + 1;
    if (previous_argc != 0) {
        for position: usize in 0..<512 {
            if (position >= tail_start && position < previous_length) {
                let cursor: usize = offset;
                if (cursor >= 512) { return SyscallExecFormatResult::TooBig; }
                argv[cursor] = previous[position];
                offset = offset + 1;
            }
        }
        argc = argc + previous_argc - 1;
    }
    if (argc > 15) { return SyscallExecFormatResult::TooBig; }
    // This level's script pathname is in the replacement argv now,
    // so the stored path can become what it has to name from here on: the
    // image that will actually be loaded.
    for path_index: usize in 0..<256 { stored_path[path_index] = 0; }
    let mut path_cursor: usize = 0;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= interpreter_from && position < interpreter_to) {
            let value: u8 = line[position];
            if (path_cursor < 256) {
                let bounded: {0..<256 as usize} = path_cursor;
                stored_path[bounded] = value;
            } else {
                return SyscallExecFormatResult::Invalid;
            }
            path_cursor = path_cursor + 1;
        }
    }
    // The next bounded resolution step checks this interpreter's own
    // permissions and format before any process-image state is committed.
    let mut prefix: SyscallScriptPrefix = {
        argc, offset, syscall_exec_inode_none()
    };
    return SyscallExecFormatResult::Script(prefix);
}

// Decide an execve(2) target's executable format from one bounded read of the
// file itself, rather than from the caller's argv. This runs at syscall time
// on purpose: the image is not mapped until the syscall's action tail, which
// has no way left to report an error to userspace, so every refusal a shell
// can act on has to be decided here.
// GitHub issue #591: decide an ELF's interpreter at syscall time, where a
// refusal can still be an errno. Past this point the exec is committed and
// a failure to map fail-stops the caller.
// GitHub issue #1040: an ELF this validator rejects (ET_EXEC, or a PT_LOAD
// span over DISTRO_ELF_SPAN_MAX, 2 MiB before #1041) is ENOEXEC here. It used to be
// passed on as Executable, and the mapping path, which runs the same
// validator over the same 1 KiB window and could not tell "invalid" from
// "not found", ran the static BusyBox in its place.
const SYSCALL_EXEC_INTERPRETER_MAX: usize = 64;

private fn syscall_exec_elf_interpreter(slot: borrow SyscallSlot[0], mount: Ext2Mount, inode: usize)
        -> SyscallExecFormatResult !{unsafe} {
    // ELF probing must not overwrite the collected script argv or path.
    zero_fill(syscall_scratch[slot.index].elf_buffer as []u8);
    let window: [u8; SYSCALL_EXEC_ELF_WINDOW_SIZE..] =
        syscall_scratch[slot.index].elf_buffer
            as [u8; SYSCALL_EXEC_ELF_WINDOW_SIZE..];
    let file_length: usize = ext2_regular_file_size(mount, inode);
    // The mapping path refuses the same lengths (kernel_exec_resolve_ext2_
    // inode_at); refusing them here is what keeps that refusal reachable
    // only as an invariant break.
    if (file_length == 0 || file_length > ext2_max_regular_file_size()) {
        return SyscallExecFormatResult::NotExecutable;
    }
    let length: usize = match ext2_read_file_chunk(
            mount, inode, 0, window) {
        Ext2ReadResult::Invalid => {
            return SyscallExecFormatResult::Unreadable;
        }
        Ext2ReadResult::Read(read) => { read }
    };
    if (length > SYSCALL_EXEC_ELF_WINDOW_SIZE) {
        return SyscallExecFormatResult::Unreadable;
    }
    let bounded: {0..<SYSCALL_EXEC_ELF_WINDOW_SIZE + 1 as usize} = length;
    let plan: DistroElfLoadPlan =
        match distro_elf_validate_with_length(window[0..<bounded],
                                              file_length) {
            DistroElfResult::Invalid => {
                return SyscallExecFormatResult::NotExecutable;
            }
            DistroElfResult::Valid(valid) => { valid }
        };
    let named: usize = plan.interpreter_length;
    if (named == 0) {
        let mut judged: SyscallExecInode = { inode };
        return SyscallExecFormatResult::Executable(judged);
    }
    // The string less its leading slash and its NUL is the relative name
    // ext2_lookup_path takes. Copied out of the window by walking the
    // window's own fixed size, so every index is bounded by the array.
    let offset: usize = plan.interpreter_offset;
    if (named < 3 || named - 2 > SYSCALL_EXEC_INTERPRETER_MAX ||
        offset >= length || named > length - offset ||
        window[offset] != 0x2F) {
        return SyscallExecFormatResult::InterpreterUnsupported;
    }
    zero_fill(syscall_scratch[slot.index].interpreter_buffer as []u8);
    let name: [u8; SYSCALL_EXEC_INTERPRETER_MAX..] =
        syscall_scratch[slot.index].interpreter_buffer as
            [u8; SYSCALL_EXEC_INTERPRETER_MAX..];
    // The name ends at its first NUL, as Linux reads it, not at the end of
    // the segment.
    let mut target: usize = 0;
    let mut ended: bool = false;
    for position: usize in 0..<SYSCALL_EXEC_ELF_WINDOW_SIZE {
        if (position > offset && position < offset + named - 1 &&
            ended == false) {
            let byte: u8 = window[position];
            if (byte == 0) {
                ended = true;
            } else {
                if (target < SYSCALL_EXEC_INTERPRETER_MAX) {
                    name[target] = byte;
                }
                target = target + 1;
            }
        }
    }
    let name_length: usize = target;
    if (name_length > SYSCALL_EXEC_INTERPRETER_MAX) {
        return SyscallExecFormatResult::InterpreterUnsupported;
    }
    let bounded_name: {0..<SYSCALL_EXEC_INTERPRETER_MAX + 1 as usize} =
        name_length;
    let relative: []u8 = name[0..<bounded_name];
    match ext2_lookup_path(mount, relative) {
        Ext2LookupResult::Invalid => {
            return SyscallExecFormatResult::InterpreterAbsent;
        }
        Ext2LookupResult::NotFound => {
            return SyscallExecFormatResult::InterpreterAbsent;
        }
        Ext2LookupResult::Found(found) => {}
    }
    if (slice_eq(relative, bs"lib/ld-musl-aarch64.so.1")) {
        let mut judged: SyscallExecInode = { inode };
        return SyscallExecFormatResult::Executable(judged);
    }
    return SyscallExecFormatResult::InterpreterUnsupported;
}

private fn syscall_exec_format(slot: borrow SyscallSlot[0], path_length: usize)
        -> SyscallExecFormatResult !{unsafe}
        requires init(syscall_scratch[slot.index].file_buffer) {
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return SyscallExecFormatResult::NotMounted; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let mut current_length: usize = path_length;
    let mut argc: usize = 0;
    let mut prefix_length: usize = 0;
    for depth: usize in 0..<6 {
        let path: []u8 = syscall_exec_path_here(slot);
        let pathname_length: usize = current_length;
        if (pathname_length < 2 || pathname_length > path.len) {
            return SyscallExecFormatResult::Absent;
        }
        let full = path[0..<pathname_length];
        if (full.len < 2) { return SyscallExecFormatResult::Absent; }
        match syscall_exec_target(mount, full[1..<full.len]) {
            SyscallExecTargetResult::Absent => {
                return SyscallExecFormatResult::Absent;
            }
            SyscallExecTargetResult::NotPermitted => {
                return SyscallExecFormatResult::NotPermitted;
            }
            SyscallExecTargetResult::Inode(inode) => {
                let line: []u8 = syscall_script_line_here(slot);
                for index: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
                    line[index] = 0;
                }
                match ext2_read_file_chunk(mount, inode, 0, line) {
                    Ext2ReadResult::Invalid => {
                        // The kind and the permission were already settled above,
                        // so what is left is a read that failed on a file this
                        // kernel was allowed to execute. Linux reports the read's
                        // own error rather than a verdict about a format it never
                        // saw.
                        return SyscallExecFormatResult::Unreadable;
                    }
                    Ext2ReadResult::Read(length) => {
                        if (length < 4) {
                            return SyscallExecFormatResult::NotExecutable;
                        }
                        if (line[0] == 0x7F && line[1] == 0x45 &&
                            line[2] == 0x4C && line[3] == 0x46) {
                            match syscall_exec_elf_interpreter(slot, mount, inode) {
                                SyscallExecFormatResult::Executable(executable) => {
                                    if (argc == 0) {
                                        return SyscallExecFormatResult::Executable(executable);
                                    }
                                    let mut prefix: SyscallScriptPrefix = {
                                        argc, prefix_length, executable
                                    };
                                    return SyscallExecFormatResult::Script(prefix);
                                }
                                SyscallExecFormatResult::NotMounted => { return SyscallExecFormatResult::NotMounted; }
                                SyscallExecFormatResult::Absent => { return SyscallExecFormatResult::Absent; }
                                SyscallExecFormatResult::NotPermitted => { return SyscallExecFormatResult::NotPermitted; }
                                SyscallExecFormatResult::Unreadable => { return SyscallExecFormatResult::Unreadable; }
                                SyscallExecFormatResult::NotExecutable => { return SyscallExecFormatResult::NotExecutable; }
                                SyscallExecFormatResult::InterpreterAbsent => { return SyscallExecFormatResult::InterpreterAbsent; }
                                SyscallExecFormatResult::InterpreterUnsupported => { return SyscallExecFormatResult::InterpreterUnsupported; }
                                SyscallExecFormatResult::Invalid => { return SyscallExecFormatResult::Invalid; }
                                SyscallExecFormatResult::TooBig => { return SyscallExecFormatResult::TooBig; }
                                SyscallExecFormatResult::TooDeep => { return SyscallExecFormatResult::TooDeep; }
                                SyscallExecFormatResult::Script(value) => { return SyscallExecFormatResult::Script(value); }
                            }
                        }
                        if (line[0] != 0x23 || line[1] != 0x21) {
                            return SyscallExecFormatResult::NotExecutable;
                        }
                        if (depth == 5) { return SyscallExecFormatResult::TooDeep; }
                        match syscall_exec_script_prefix(slot, current_length, argc,
                                                         prefix_length) {
                            SyscallExecFormatResult::Script(prefix) => {
                                argc = prefix.argc;
                                prefix_length = prefix.length;
                            }
                            SyscallExecFormatResult::NotMounted => { return SyscallExecFormatResult::NotMounted; }
                            SyscallExecFormatResult::Absent => { return SyscallExecFormatResult::Absent; }
                            SyscallExecFormatResult::NotPermitted => { return SyscallExecFormatResult::NotPermitted; }
                            SyscallExecFormatResult::Unreadable => { return SyscallExecFormatResult::Unreadable; }
                            SyscallExecFormatResult::NotExecutable => { return SyscallExecFormatResult::NotExecutable; }
                            SyscallExecFormatResult::InterpreterAbsent => { return SyscallExecFormatResult::InterpreterAbsent; }
                            SyscallExecFormatResult::InterpreterUnsupported => { return SyscallExecFormatResult::InterpreterUnsupported; }
                            SyscallExecFormatResult::Invalid => { return SyscallExecFormatResult::Invalid; }
                            SyscallExecFormatResult::TooBig => { return SyscallExecFormatResult::TooBig; }
                            SyscallExecFormatResult::TooDeep => { return SyscallExecFormatResult::TooDeep; }
                            SyscallExecFormatResult::Executable(value) => { return SyscallExecFormatResult::Executable(value); }
                        }
                        let next_path: []u8 = syscall_exec_path_here(slot);
                        current_length = 0;
                        let mut ended: bool = false;
                        for index: usize in 0..<256 {
                            if (ended == false) {
                                if (next_path[index] == 0) { ended = true; }
                                else { current_length = current_length + 1; }
                            }
                        }
                    }
                }
            }
        }
    }
    return SyscallExecFormatResult::TooDeep;
}

must_use variant KernelFdReapResult { Failed; Reaped; }
// GitHub issue #257 step 5: the payload was
// `{0..<TCP_CONNECTION_MAX as usize}` -- a proof that the value indexed a
// real element of an array that no longer exists. It is a pool ADDRESS
// now, and plain `usize` is the honest type for one: what used to be a
// bounds proof is intrusive_pool_matches, which the take path performs on
// every use and which also catches the case a bounds proof never could,
// an address that is in range but names a connection that has since
// closed.
must_use variant KernelConnectionLookupResult {
    Missing;
    Found(usize);
}
// GitHub issue #393: plain usize. A descriptor number is bounded by the
// process's own RLIMIT_NOFILE, a runtime value, so there is no
// compile-time range to state -- the same trade the connection lookup
// above already made for a pool address.
must_use variant KernelSocketFdAllocResult {
    Full;
    Allocated(usize);
}
must_use variant KernelListenerLookupResult {
    Missing;
    Found(usize);
}

// GitHub issue #245: fd-table process slot == process.tkb's own
// ProcessHandle.pool_index (same convention as the address-space root),
// so this is now a direct pass-through instead of a binary pid==2?1:0.
fn kernel_syscall_process_slot() -> ProcessSlot {
    return kernel_process_current_slot();
}

// The same process as the key the fd-context table indexes by (#858).
inline fn kernel_syscall_process_key() -> usize {
    return process_slot_address(kernel_process_current_slot());
}

fn kernel_syscall_file_lookup(fd: usize) -> UnifiedFileResult {
    return unified_file_lookup(kernel_syscall_process_key(), fd);
}

fn kernel_syscall_directory_is_open(fd: usize) -> bool {
    match unified_directory_lookup(kernel_syscall_process_key(), fd) {
        UnifiedDirectoryResult::Missing => { return false; }
        UnifiedDirectoryResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_directory_inode(fd: usize) -> usize {
    match unified_directory_lookup(kernel_syscall_process_key(), fd) {
        UnifiedDirectoryResult::Missing => { return 0; }
        UnifiedDirectoryResult::Found(handle) => {
            return unified_directory_inode(handle);
        }
    }
}

fn kernel_syscall_file_is_open(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_terminal_is_open(fd: usize) -> bool {
    return unified_terminal_is_open(kernel_syscall_process_key(), fd);
}

fn kernel_syscall_file_readable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_readable(handle);
        }
    }
}

fn kernel_syscall_file_writable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_writable(handle);
        }
    }
}

fn kernel_syscall_file_inode(fd: usize) -> usize {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return 0; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_inode(handle);
        }
    }
}

fn kernel_syscall_file_offset(fd: usize) -> usize {
    match unified_fd_offset(kernel_syscall_process_key(), fd) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_file_set_offset(fd: usize, value: usize) -> bool {
    match unified_fd_set_offset(kernel_syscall_process_key(), fd, value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

// GitHub issue #497: one getdents64 record for a fixed procfs name at the
// start of the user buffer: d_ino, d_off, d_reclen, d_type, name, NUL.
must_use variant ProcfsDirentWrite {
    TooSmall;
    Fault;
    Written(usize);
}

private fn syscall_procfs_fixed_dirent(range: borrow UserWriteRange[process],
                                       capacity: usize, name: []const u8,
                                       inode: usize, kind: u8,
                                       next_offset: usize)
        -> ProcfsDirentWrite !{unsafe} {
    let record_length: usize = (19 + name.len + 1 + 7) & 0xFFFFFFFFFFFFFFF8;
    if (record_length > capacity) { return ProcfsDirentWrite::TooSmall; }
    let mut record = user_write_u64(range, 0, inode as u64);
    record = user_write_join(record, user_write_u64(range, 8, next_offset as u64));
    record = user_write_join(record, user_write_u16(range, 16, record_length));
    record = user_write_join(record, user_write_byte(range, 18, kind));
    for index: usize in 0..<name.len {
        record = user_write_join(record, user_write_byte(range, 19 + index, name[index]));
    }
    record = user_write_join(record, user_write_byte(range, 19 + name.len, 0));
    match record {
        UserWriteResult::Fault => { return ProcfsDirentWrite::Fault; }
        UserWriteResult::Written => { return ProcfsDirentWrite::Written(record_length); }
    }
}

fn kernel_syscall_procfs_open(node: ProcfsNode, fd: usize)
        -> SyscallAction {
    if (procfs_node_is_directory(node)) {
        match unified_directory_open(kernel_syscall_process_key(), fd,
                                     node.inode) {
            UnifiedOpenResult::Invalid => {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            UnifiedOpenResult::Full => {
                return SyscallAction::Resume(LINUX_ENFILE);
            }
            UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
        }
    }
    match unified_file_open(kernel_syscall_process_key(), fd, node.inode,
                            true, procfs_node_is_writable(node)) {
        UnifiedOpenResult::Invalid => {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        UnifiedOpenResult::Full => {
            return SyscallAction::Resume(LINUX_ENFILE);
        }
        UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
    }
}

// This process's own soft RLIMIT_NOFILE, for the exhaustion log lines that
// used to print the constant. Reporting the limit that actually refused
// the call is the point: two processes can now be refused at different
// numbers.
fn kernel_syscall_fd_limit_soft() -> usize !{unsafe} {
    match unified_process_fd_limit(kernel_syscall_process_key()) {
        UnifiedFdLimitResult::Missing => { return 0; }
        UnifiedFdLimitResult::Found(pair) => {
            let (soft, hard) = pair;
            return soft;
        }
    }
}

fn kernel_syscall_heap_break() -> usize {
    match unified_process_heap_break(kernel_syscall_process_key()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_set(value: usize) -> bool {
    let process: usize = kernel_syscall_process_key();
    let evidence = match unified_fd_context_lookup(process) {
        ProcessFdContextReady::Missing => { return false; }
        ProcessFdContextReady::Ready(ready) => { ready }
    };
    match unified_process_heap_configure(process, evidence, value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

// GitHub issue #1151: munmap of `length` bytes at `address`. The mmap
// region's held pages lose their PTE and their bit; a page outside the
// region (the image, the brk heap, the stack) stays mapped, as it did
// before the region existed.
fn syscall_munmap_pages(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], address: usize, length: usize) !{unsafe} {
    let (span_ok, first, last) = user_range_l3_span(address, length);
    if (span_ok == false) { return; }
    mmap_region_unmap(kernel_process_current_root(current_authority), first, last);
}

// GitHub issue #1151: an anonymous mmap of `rounded` bytes, already checked
// for its flags. A private mapping takes region pages and maps none of them:
// each is mapped zeroed on its first touch. A shared one is mapped now (see
// kernel/mm/process_image.tkb's MmapRegionBitmap limitations) and marked.
fn syscall_mmap_anonymous(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                          hint: usize, rounded: usize, shared: bool,
                          fixed: bool) -> SyscallAction !{unsafe} {
    // A shared mapping's pages are marked as such, which the fixed form
    // below never does. Linux would replace them; this kernel refuses.
    if (shared && fixed) { return SyscallAction::Resume(LINUX_EINVAL); }
    let mut root_space: AddressSpaceRoot = kernel_process_current_root(current_authority);
    let root: usize = root_slot_word(address_space_root_slot(root_space));
    let pages: usize = rounded / PAGE_SIZE;
    if (hint != 0 && shared == false) {
        // musl uses MAP_FIXED to turn the first page of its brk arena into
        // a guard page. The arena's pages are mapped eagerly, so the
        // requested address is kept as it is.
        if (hint >= kernel_syscall_heap_start() &&
            hint <= kernel_syscall_heap_limit() &&
            rounded <= kernel_syscall_heap_limit() - hint) {
            return SyscallAction::Resume(hint);
        }
        if (fixed) {
            if (hint % PAGE_SIZE != 0) { return SyscallAction::Resume(LINUX_EINVAL); }
            let (span_ok, first, last) = user_range_l3_span(hint, rounded);
            if (span_ok == false) { return SyscallAction::Resume(LINUX_ENOMEM); }
            // MAP_FIXED replaces what the range held, as on Linux.
            mmap_region_unmap(root_space, first, last);
            if (mmap_region_take_fixed(root, first, pages)) {
                return SyscallAction::Resume(hint);
            }
            return SyscallAction::Resume(LINUX_ENOMEM);
        }
        // Without MAP_FIXED a hint is only a hint.
    }
    match mmap_region_take(root, pages) {
        MmapRegionTake::Full => { return SyscallAction::Resume(LINUX_ENOMEM); }
        MmapRegionTake::Taken(first) => {
            let address: usize = USER_TEXT_VA + first * PAGE_SIZE;
            if (shared) {
                if (mmap_region_populate(root_space, address, rounded) == false ||
                    syscall_mmap_mark_shared(current_authority, address, rounded) == false) {
                    syscall_munmap_pages(current_authority, address, rounded);
                    return SyscallAction::Resume(LINUX_ENOMEM);
                }
            }
            return SyscallAction::Resume(address);
        }
    }
}

// GitHub issue #1151: madvise(2) advice values (include/uapi/asm-generic/
// mman-common.h).
const LINUX_MADV_DONTNEED: usize = 4;
const LINUX_MADV_REMOVE: usize = 9;
const LINUX_MADV_WIPEONFORK: usize = 18;
const LINUX_MADV_POPULATE_READ: usize = 22;
const LINUX_MADV_POPULATE_WRITE: usize = 23;
const LINUX_MADV_DONTNEED_LOCKED: usize = 24;
const LINUX_MADV_COLLAPSE: usize = 25;

// Advice this kernel accepts. NORMAL, RANDOM, SEQUENTIAL, WILLNEED, FREE,
// DONTFORK, DOFORK, MERGEABLE, UNMERGEABLE, HUGEPAGE, NOHUGEPAGE,
// DONTDUMP, DODUMP, KEEPONFORK, COLD, PAGEOUT and COLLAPSE change nothing a
// process can observe here, and are taken as no-ops, as a Linux built
// without the feature behind each takes them (FREE may keep the pages;
// DONTFORK is the one a child could observe, by reading the page Linux
// would not have mapped). REMOVE and WIPEONFORK are EINVAL: one needs a
// shared file mapping, the other a per-page fork flag this kernel does not
// keep; anything else is EINVAL, as Linux's madvise_behavior_valid says.
fn syscall_madvise_known(advice: usize) -> bool {
    if (advice == LINUX_MADV_REMOVE || advice == LINUX_MADV_WIPEONFORK) {
        return false;
    }
    return (advice <= 3) || (advice >= LINUX_MADV_DONTNEED && advice <= 17) ||
           (advice >= 19 && advice <= LINUX_MADV_COLLAPSE);
}

// Whether page `index` is anonymous memory of this process: the mmap
// region, the brk heap, the stack. Image pages are file-backed, and
// MADV_DONTNEED on them would re-read the file on Linux, which this kernel
// cannot; it leaves them.
fn syscall_madvise_anonymous(root: usize, index: usize) -> bool !{unsafe} {
    if (mmap_region_contains(index)) { return true; }
    let heap_start: usize = kernel_syscall_heap_start();
    let heap_limit: usize = kernel_syscall_heap_limit();
    if (heap_start >= USER_TEXT_VA && heap_limit > heap_start &&
        index >= (heap_start - USER_TEXT_VA) / PAGE_SIZE &&
        index < (heap_limit - USER_TEXT_VA) / PAGE_SIZE) {
        return true;
    }
    return index >= process_image_record_read(root).stack_low_page &&
           index <= process_stack_top_page();
}

// madvise(addr, len, advice), as Linux's: the advice and the alignment are
// checked first, a zero length is 0, MADV_DONTNEED leaves every private
// anonymous page of the range reading zero, the POPULATE pair maps
// untouched mmap pages, and a range with an unmapped page is ENOMEM after
// the mapped pages took the advice.
fn syscall_madvise(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                   address: usize, length: usize, advice: usize) -> SyscallAction !{unsafe} {
    if (syscall_madvise_known(advice) == false || address % PAGE_SIZE != 0) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    if (length == 0) { return SyscallAction::Resume(0); }
    if (length > 0xFFFFFFFFFFFFF000) { return SyscallAction::Resume(LINUX_EINVAL); }
    let rounded: usize = (length + PAGE_SIZE - 1) & 0xFFFFFFFFFFFFF000;
    if (address > 0xFFFFFFFFFFFFFFFF - rounded) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let (span_ok, first, last) = user_range_l3_span(address, rounded);
    if (span_ok == false) { return SyscallAction::Resume(LINUX_ENOMEM); }
    let mut root_space: AddressSpaceRoot = kernel_process_current_root(current_authority);
    let root: usize = root_slot_word(address_space_root_slot(root_space));
    if (advice == LINUX_MADV_POPULATE_READ || advice == LINUX_MADV_POPULATE_WRITE) {
        if (mmap_region_populate(root_space, address, rounded) == false) {
            return SyscallAction::Resume(LINUX_ENOMEM);
        }
    }
    let dontneed: bool = advice == LINUX_MADV_DONTNEED ||
                         advice == LINUX_MADV_DONTNEED_LOCKED;
    let mut unmapped: bool = false;
    let mut index: usize = first;
    while (index <= last) {
        let pte: usize = address_space_pte_read(root_space, index);
        if (pte == 0) {
            if (mmap_region_holds(root, index) == false) { unmapped = true; }
        } else if (dontneed && address_space_pte_is_shared(pte) == false &&
                   syscall_madvise_anonymous(root, index)) {
            // A shared page keeps its bytes: on Linux the next touch finds
            // them again in the shared object.
            if (mmap_region_contains(index) &&
                (address_space_pte_is_writable(pte) || address_space_pte_is_cow(pte))) {
                // Untouched again: the next touch maps a zeroed page.
                address_space_pte_clear(root_space, index);
            } else if (address_space_replace_with_zero(root_space, index) == false) {
                return SyscallAction::Resume(LINUX_ENOMEM);
            }
        }
        index = index + 1;
    }
    if (unmapped) { return SyscallAction::Resume(LINUX_ENOMEM); }
    return SyscallAction::Resume(0);
}

// GitHub issue #1147: getrusage(2). This kernel accounts no CPU time,
// faults, I/O or context switches per process, so every field of the
// 144-byte struct rusage is 0, as Linux reports a field it does not keep;
// `who` is checked as Linux checks it.
fn syscall_getrusage(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                     who: usize, usage: usize) -> usize {
    // RUSAGE_SELF 0, RUSAGE_THREAD 1, RUSAGE_CHILDREN -1 (an int).
    let who_word: usize = who & 0xFFFFFFFF;
    if (who_word != 0 && who_word != 1 && who_word != 0xFFFFFFFF) {
        return LINUX_EINVAL;
    }
    match user_range_check_write(current_authority, usage, 144) {
        UserWriteRangeResult::Fault => { return LINUX_EFAULT; }
        UserWriteRangeResult::Ok(range) => {
            match user_zero_fill(range) {
                UserWriteResult::Fault => { return LINUX_EFAULT; }
                UserWriteResult::Written => { return 0; }
            }
        }
    }
}

// GitHub issue #1147: statfs(2), struct statfs as arm64's generic 64-bit
// layout (120 bytes). A path on the ext2 root reports that filesystem as
// Linux's ext2_statfs does; one under /proc reports procfs's magic and
// block size with no counts, as Linux's simple_statfs.
const LINUX_EXT2_SUPER_MAGIC: usize = 0xEF53;
const LINUX_PROC_SUPER_MAGIC: usize = 0x9FA0;
const LINUX_ST_VALID: usize = 0x20;

fn syscall_statfs(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                  path: usize, buffer: usize) -> usize !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let answer: usize = syscall_statfs_with(slot, current_authority, path, buffer);
    syscall_slot_release(slot);
    return answer;
}

private fn syscall_statfs_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        path: usize, buffer: usize) -> usize !{unsafe} {
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return LINUX_ENOENT; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, path) {
        SyscallPathResult::Fault => { return LINUX_EFAULT; }
        SyscallPathResult::Invalid => { return LINUX_ENOENT; }
        SyscallPathResult::Name(name) => { name }
    };
    let mut procfs: bool = false;
    match procfs_lookup(path_name) {
        ProcfsLookupResult::Missing => {
            match ext2_lookup_path_from(mount, 2, path_name) {
                Ext2LookupResult::Invalid => { return LINUX_EIO; }
                Ext2LookupResult::NotFound => { return LINUX_ENOENT; }
                Ext2LookupResult::Found(found) => { }
            }
        }
        ProcfsLookupResult::Found(node) => { procfs = true; }
    }
    let mut counts: Ext2Statfs = { 0, 0, 0, 0, 0, 0 };
    if (procfs == false) {
        match ext2_statfs(mount) {
            Ext2StatfsResult::Invalid => { return LINUX_EIO; }
            Ext2StatfsResult::Counts(found) => { counts = found; }
        }
    }
    match user_range_check_write(current_authority, buffer, 120) {
        UserWriteRangeResult::Fault => { return LINUX_EFAULT; }
        UserWriteRangeResult::Ok(range) => {
            let mut written = user_zero_fill(range);
            if (procfs) {
                written = user_write_join(written, user_write_u64(range, 0, LINUX_PROC_SUPER_MAGIC as u64));
                written = user_write_join(written, user_write_u64(range, 8, PAGE_SIZE as u64));
                written = user_write_join(written, user_write_u64(range, 64, 255));
                written = user_write_join(written, user_write_u64(range, 72, PAGE_SIZE as u64));
            } else {
                written = user_write_join(written, user_write_u64(range, 0, LINUX_EXT2_SUPER_MAGIC as u64));
                written = user_write_join(written, user_write_u64(range, 8, KERNEL_BLOCK_SIZE as u64));
                written = user_write_join(written, user_write_u64(range, 16, counts.blocks as u64));
                written = user_write_join(written, user_write_u64(range, 24, counts.free_blocks as u64));
                written = user_write_join(written, user_write_u64(range, 32, counts.available_blocks as u64));
                written = user_write_join(written, user_write_u64(range, 40, counts.inodes as u64));
                written = user_write_join(written, user_write_u64(range, 48, counts.free_inodes as u64));
                written = user_write_join(written, user_write_u64(range, 56, counts.fsid as u64));
                written = user_write_join(written, user_write_u64(range, 64, 255));
                written = user_write_join(written, user_write_u64(range, 72, KERNEL_BLOCK_SIZE as u64));
            }
            written = user_write_join(written, user_write_u64(range, 80, LINUX_ST_VALID as u64));
            match written {
                UserWriteResult::Fault => { return LINUX_EFAULT; }
                UserWriteResult::Written => { return 0; }
            }
        }
    }
}

// GitHub issue #1176: the uid/gid family over ProcessCredentials, as
// Linux's kernel/sys.c does it for the initial user namespace. Privilege
// (CAP_SETUID / CAP_SETGID) is an effective uid of 0: with no capability
// sets here, that is what Linux's root-compatible capability rules give.
// An id argument is the low 32 bits; 0xFFFFFFFF (-1) leaves an id alone.
// asm-generic/errno.h: EAFNOSUPPORT 97.
const LINUX_EAFNOSUPPORT: usize = 0xFFFFFFFFFFFFFF9F;
const AARCH64_NR_SETREGID: usize = 143;
const AARCH64_NR_SETGID: usize = 144;
const AARCH64_NR_SETREUID: usize = 145;
const AARCH64_NR_SETUID: usize = 146;
const AARCH64_NR_SETRESUID: usize = 147;
const AARCH64_NR_GETRESUID: usize = 148;
const AARCH64_NR_SETRESGID: usize = 149;
const AARCH64_NR_GETRESGID: usize = 150;
const AARCH64_NR_GETGROUPS: usize = 158;
const AARCH64_NR_SETGROUPS: usize = 159;
const LINUX_ID_KEEP: u32 = 0xFFFFFFFF;
// include/uapi/linux/limits.h
const LINUX_NGROUPS_MAX: usize = 65536;

// One id of an unprivileged caller's request: -1, or one of the three it
// holds.
fn syscall_id_allowed(wanted: u32, real: u32, effective: u32, saved: u32) -> bool {
    return wanted == LINUX_ID_KEEP || wanted == real || wanted == effective ||
        wanted == saved;
}

fn syscall_id_or(wanted: u32, old: u32) -> u32 {
    if (wanted == LINUX_ID_KEEP) { return old; }
    return wanted;
}

// getresuid/getresgid: three u32 stores through three pointers, each its
// own EFAULT, in Linux's order.
fn syscall_getres_ids(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                      first: usize, second: usize, third: usize,
                      real: u32, effective: u32, saved: u32) -> usize {
    match user_range_check_write(current_authority, first, 4) {
        UserWriteRangeResult::Fault => { return LINUX_EFAULT; }
        UserWriteRangeResult::Ok(range) => {
            match user_write_u32(range, 0, real) {
                UserWriteResult::Fault => { return LINUX_EFAULT; }
                UserWriteResult::Written => {}
            }
        }
    }
    match user_range_check_write(current_authority, second, 4) {
        UserWriteRangeResult::Fault => { return LINUX_EFAULT; }
        UserWriteRangeResult::Ok(range) => {
            match user_write_u32(range, 0, effective) {
                UserWriteResult::Fault => { return LINUX_EFAULT; }
                UserWriteResult::Written => {}
            }
        }
    }
    match user_range_check_write(current_authority, third, 4) {
        UserWriteRangeResult::Fault => { return LINUX_EFAULT; }
        UserWriteRangeResult::Ok(range) => {
            match user_write_u32(range, 0, saved) {
                UserWriteResult::Fault => { return LINUX_EFAULT; }
                UserWriteResult::Written => { return 0; }
            }
        }
    }
}

fn syscall_id_call(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                   number: usize, x0: usize, x1: usize, x2: usize) -> usize {
    let mut ids: ProcessCredentials = kernel_process_current_credentials(current_authority);
    let privileged: bool = ids.euid == 0;
    let a: u32 = (x0 & 0xFFFFFFFF) as u32;
    let b: u32 = (x1 & 0xFFFFFFFF) as u32;
    let c: u32 = (x2 & 0xFFFFFFFF) as u32;
    if (number == 174) { return ids.ruid as usize; }
    if (number == 175) { return ids.euid as usize; }
    if (number == 176) { return ids.rgid as usize; }
    if (number == 177) { return ids.egid as usize; }
    if (number == AARCH64_NR_GETRESUID) {
        return syscall_getres_ids(current_authority, x0, x1, x2, ids.ruid, ids.euid, ids.suid);
    }
    if (number == AARCH64_NR_GETRESGID) {
        return syscall_getres_ids(current_authority, x0, x1, x2, ids.rgid, ids.egid, ids.sgid);
    }
    if (number == AARCH64_NR_GETGROUPS) {
        // No supplementary groups are kept: an empty list for any size.
        if ((x0 & 0xFFFFFFFF) >= 0x80000000) { return LINUX_EINVAL; }
        return 0;
    }
    if (number == AARCH64_NR_SETGROUPS) {
        // Linux checks the size, then CAP_SETGID, then reads the list.
        // The list is read for EFAULT and not kept (getgroups stays empty).
        let size: usize = x0 & 0xFFFFFFFF;
        if (size > LINUX_NGROUPS_MAX) { return LINUX_EINVAL; }
        if (privileged == false) { return LINUX_EPERM; }
        if (size == 0) { return 0; }
        match user_range_check_read(current_authority, x1, size * 4) {
            UserReadRangeResult::Fault => { return LINUX_EFAULT; }
            UserReadRangeResult::Ok(range) => { return 0; }
        }
    }
    if (number == AARCH64_NR_SETRESUID) {
        if (privileged == false &&
            (syscall_id_allowed(a, ids.ruid, ids.euid, ids.suid) == false ||
             syscall_id_allowed(b, ids.ruid, ids.euid, ids.suid) == false ||
             syscall_id_allowed(c, ids.ruid, ids.euid, ids.suid) == false)) {
            return LINUX_EPERM;
        }
        ids.ruid = syscall_id_or(a, ids.ruid);
        ids.euid = syscall_id_or(b, ids.euid);
        ids.suid = syscall_id_or(c, ids.suid);
    } else if (number == AARCH64_NR_SETRESGID) {
        if (privileged == false &&
            (syscall_id_allowed(a, ids.rgid, ids.egid, ids.sgid) == false ||
             syscall_id_allowed(b, ids.rgid, ids.egid, ids.sgid) == false ||
             syscall_id_allowed(c, ids.rgid, ids.egid, ids.sgid) == false)) {
            return LINUX_EPERM;
        }
        ids.rgid = syscall_id_or(a, ids.rgid);
        ids.egid = syscall_id_or(b, ids.egid);
        ids.sgid = syscall_id_or(c, ids.sgid);
    } else if (number == AARCH64_NR_SETUID) {
        if (a == LINUX_ID_KEEP) { return LINUX_EINVAL; }
        if (privileged) {
            ids.ruid = a;
            ids.euid = a;
            ids.suid = a;
        } else if (a == ids.ruid || a == ids.suid) {
            ids.euid = a;
        } else {
            return LINUX_EPERM;
        }
    } else if (number == AARCH64_NR_SETGID) {
        if (a == LINUX_ID_KEEP) { return LINUX_EINVAL; }
        if (privileged) {
            ids.rgid = a;
            ids.egid = a;
            ids.sgid = a;
        } else if (a == ids.rgid || a == ids.sgid) {
            ids.egid = a;
        } else {
            return LINUX_EPERM;
        }
    } else if (number == AARCH64_NR_SETREUID) {
        // The real id may become the old real or effective one; the
        // effective any of the three. Setting the real id, or an effective
        // id other than the old real one, makes the saved id the new
        // effective one.
        if (privileged == false &&
            ((a != LINUX_ID_KEEP && a != ids.ruid && a != ids.euid) ||
             syscall_id_allowed(b, ids.ruid, ids.euid, ids.suid) == false)) {
            return LINUX_EPERM;
        }
        let old_real: u32 = ids.ruid;
        ids.ruid = syscall_id_or(a, ids.ruid);
        ids.euid = syscall_id_or(b, ids.euid);
        if (a != LINUX_ID_KEEP || (b != LINUX_ID_KEEP && b != old_real)) {
            ids.suid = ids.euid;
        }
    } else if (number == AARCH64_NR_SETREGID) {
        if (privileged == false &&
            ((a != LINUX_ID_KEEP && a != ids.rgid && a != ids.egid) ||
             syscall_id_allowed(b, ids.rgid, ids.egid, ids.sgid) == false)) {
            return LINUX_EPERM;
        }
        let old_real: u32 = ids.rgid;
        ids.rgid = syscall_id_or(a, ids.rgid);
        ids.egid = syscall_id_or(b, ids.egid);
        if (a != LINUX_ID_KEEP || (b != LINUX_ID_KEEP && b != old_real)) {
            ids.sgid = ids.egid;
        }
    }
    kernel_process_current_set_credentials(current_authority, ids);
    return 0;
}

// GitHub issue #1147: a create call's `mode` as the new inode gets it, the
// bits `keep` names less the caller's umask.
fn syscall_umasked(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                   mode: usize, keep: usize) -> usize {
    return mode & keep & ~kernel_process_current_umask(current_authority);
}

// GitHub issue #1147: mark every page of a fresh MAP_SHARED mapping.
fn syscall_mmap_mark_shared(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], address: usize, length: usize) -> bool {
    let (span_ok, first, last) = user_range_l3_span(address, length);
    if (span_ok == false) { return false; }
    let mut root: AddressSpaceRoot = kernel_process_current_root(current_authority);
    let mut index: usize = first;
    while (index <= last) {
        if (address_space_mark_shared(root, index) == false) { return false; }
        index = index + 1;
    }
    return true;
}

fn kernel_syscall_heap_start() -> usize {
    match unified_process_heap_start(kernel_syscall_process_key()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_limit() -> usize {
    match unified_process_heap_limit(kernel_syscall_process_key()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

// Exec replaces only the calling process's image. Its brk/mmap arena must
// therefore be replaced in the same FD-context slot without resetting the
// parent shell's descriptors or global TCP state.
fn kernel_syscall_process_configure_current(
        heap_start: usize, heap_limit: usize) {
    let process: usize = kernel_syscall_process_key();
    let evidence = match unified_fd_context_lookup(process) {
        ProcessFdContextReady::Missing => { return; }
        ProcessFdContextReady::Ready(ready) => { ready }
    };
    match unified_process_heap_range_configure(
            process, evidence, heap_start, heap_limit) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

// The fd context, root image record, terminal stdio and heap range of a
// process the kernel starts itself rather than through clone: the boot
// thread for the boot fixtures, and PID 1 (GitHub issue #831), whose pooled
// record already has its context and image record from allocation, so the
// two ensures below find them. The image record is its root's: root 0's for
// the boot thread, which runs on the kernel's own root.
fn kernel_syscall_process_configure(slot: ProcessSlot, heap_start: usize,
                                    heap_limit: usize) !{unsafe} {
    let process: usize = process_slot_address(slot);
    unified_fd_context_pool_init();
    unified_fd_table_init();
    match unified_fd_context_ensure(process) {
        ProcessFdContextReady::Ready(evidence) => {}
        ProcessFdContextReady::Missing => {
            kernel_boot_log_resource_exhausted(
                "physical page allocator" as *u8, page_allocator_total_count());
        }
    }
    let image_root: usize = root_slot_word(address_space_root_slot(
        scheduled_process_address_space_root_lookup(slot)));
    match process_image_record_ensure(image_root) {
        ProcessImageRecordReady::Ready(evidence) => {}
        ProcessImageRecordReady::Missing => {
            kernel_boot_log_resource_exhausted(
                "physical page allocator" as *u8, page_allocator_total_count());
        }
    }
    match unified_terminal_stdio_open(process) {
        UnifiedOpenResult::Invalid => {}
        UnifiedOpenResult::Full => {
            kernel_boot_log_resource_exhausted(
                "shared object pool" as *u8, unified_object_max_files());
        }
        UnifiedOpenResult::Ok => {}
    }
    let configured: usize = process;
    match unified_fd_context_lookup(configured) {
        ProcessFdContextReady::Missing => {}
        ProcessFdContextReady::Ready(evidence) => {
            match unified_process_heap_range_configure(configured, evidence, heap_start, heap_limit) {
                UnifiedFdResult::Invalid => {}
                UnifiedFdResult::Ok => {}
            }
        }
    }
    syscall_test_evidence_reset_read_uart_waits();
    syscall_test_lifecycle_persistent_shell_clear();
    scheduled_process_reset_syscall_state_everywhere();
    // GitHub issue #837: draining frees connections, which walks the
    // retransmit chain, so it borrows the capability like any other free.
    // With none ever installed there is no connection to drain: every
    // allocation outside the boot probes happens under the capability.
    match network_capability_take_waiting() {
        NetworkCapabilityWaitResult::NeverInstalled => {}
        NetworkCapabilityWaitResult::Ready(ready) => {
            tcp_connection_pool_init(ready);
            match network_capability_put(ready) {
                NetworkCapabilityPutResult::Stored => {}
                NetworkCapabilityPutResult::Conflict => {}
            }
        }
    }
    syscall_test_evidence_reset_socket_counters();
    // This file's process-owned values are cleared above, in one walk over
    // the live processes -- configure is a whole-world reset and can run
    // while processes already exist, so it does not rely on
    // scheduled_process_alloc's own per-process reset.
}

// GitHub issue #245: parent/child slots used to be the literal 0/1 (the
// only two the old model could ever produce); child_slot is now whatever
// pool_index kernel_process_clone_begin() actually allocated, passed in
// by the caller once it knows it (see the CLONE syscall handler below,
// which now calls kernel_process_clone_begin() first for exactly this).
fn kernel_syscall_clone_files_begin(parent_slot: ProcessSlot, child_slot: ProcessSlot)
        -> UnifiedFdResult {
    if (scheduled_process_slot_valid(child_slot)) {
        match unified_fd_clone(process_slot_address(parent_slot),
                               process_slot_address(child_slot)) {
            UnifiedFdResult::Invalid => {
                let mut failed: CloneFileState = { false };
                let state_guard = process_run_lock();
                scheduled_process_set_clone_file_state(state_guard,
                                                       child_slot, failed);
                process_run_unlock(state_guard);
                return UnifiedFdResult::Invalid;
            }
            UnifiedFdResult::Ok => {}
        }
        let mut cloned: CloneFileState = { true };
        let state_guard = process_run_lock();
        scheduled_process_set_clone_file_state(state_guard, child_slot, cloned);
        process_run_unlock(state_guard);
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn kernel_connected_fd_is_open(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_key(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => { return true; }
    }
}

fn kernel_connected_fd_clear(fd: usize) {
    match unified_fd_close(kernel_syscall_process_key(), fd) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

fn kernel_connection_fd_lookup(fd: usize) -> KernelConnectionLookupResult {
    match unified_socket_lookup(kernel_syscall_process_key(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
          // No range test: an address is not in a range, and the check
          // that replaced one runs where the address is USED (see this
          // variant's own comment).
          return KernelConnectionLookupResult::Found(
              unified_connection_slot(handle));
        }
    }
    return KernelConnectionLookupResult::Missing;
}

fn kernel_socket_fd_alloc(first: usize) -> KernelSocketFdAllocResult !{unsafe} {
    match unified_fd_alloc(kernel_syscall_process_key(), first) {
        UnifiedFdAllocResult::Full => { return KernelSocketFdAllocResult::Full; }
        UnifiedFdAllocResult::Allocated(fd) => {
            return KernelSocketFdAllocResult::Allocated(fd);
        }
    }
}

fn kernel_listener_fd_lookup(fd: usize) -> KernelListenerLookupResult !{unsafe} {
    match unified_socket_lookup(kernel_syscall_process_key(), fd,
                                UnifiedFdKind::Listener) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
            return KernelListenerLookupResult::Found(fd);
        }
    }
    return KernelListenerLookupResult::Missing;
}

fn kernel_listener_handle(fd: usize) -> UnifiedSocketResult {
    return unified_socket_lookup(kernel_syscall_process_key(), fd,
                                 UnifiedFdKind::Listener);
}

must_use variant KernelListenerClaimResult {
    Missing;
    Busy;
    Claimed(exists object: usize. ListenerClaim[object]);
}

// GitHub issue #598: bind, listen and accept on one listener exclude each
// other across CPUs (kernel/kernel/fd_table.tkb's listener_busy).
fn kernel_listener_claim(fd: usize) -> KernelListenerClaimResult !{unsafe} {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => {
            return KernelListenerClaimResult::Missing;
        }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_claim(handle) {
                ListenerClaimResult::Missing => {
                    return KernelListenerClaimResult::Missing;
                }
                ListenerClaimResult::Busy => {
                    return KernelListenerClaimResult::Busy;
                }
                ListenerClaimResult::Claimed(claim) => {
                    return KernelListenerClaimResult::Claimed(claim);
                }
            }
        }
    }
}

fn kernel_listener_state(fd: usize) -> UnifiedListenerState {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => {
            return UnifiedListenerState::Closed;
        }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_state(handle);
        }
    }
}

fn kernel_listener_set_state(fd: usize, state: UnifiedListenerState) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_state(handle, state) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_listener_port(fd: usize) -> u16 {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_port(handle);
        }
    }
}

// GitHub issue #469: the handshake this listener is part way through, as
// the (address, generation) pair the connection pool minted. Both zero
// means none.
fn kernel_listener_pending(fd: usize) -> (usize, usize) {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return (0, 0); }
        UnifiedSocketResult::Found(handle) => {
            return (unified_listener_pending_slot(handle),
                    unified_listener_pending_generation(handle));
        }
    }
}

fn kernel_listener_set_pending(fd: usize, slot: usize, generation: usize)
        -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_pending(handle, slot, generation) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_listener_set_port(fd: usize, port: u16) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_port(handle, port) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_connected_fd_duplicate(old_fd: usize, new_fd: usize) -> bool !{unsafe} {
    match unified_fd_duplicate(kernel_syscall_process_key(), old_fd,
                               new_fd) {
        UnifiedFdInstallResult::Invalid => { return false; }
        UnifiedFdInstallResult::RefOverflow => { return false; }
        UnifiedFdInstallResult::NoMemory => { return false; }
        UnifiedFdInstallResult::Ok => { return true; }
    }
}

// Keep ordinary file/terminal descriptor duplication separate from connected
// socket ownership. dup3 uses this path when replacing a standard descriptor
// with another non-socket object.
fn kernel_regular_fd_duplicate(old_fd: usize, new_fd: usize) -> bool {
    if (syscall_fd_is_plain(old_fd) == false) {
        return false;
    }
    if (old_fd == new_fd) { return true; }
    if (syscall_fd_is_plain(new_fd)) {
        match unified_fd_close(kernel_syscall_process_key(), new_fd) {
            UnifiedFdResult::Invalid => { return false; }
            UnifiedFdResult::Ok => {}
        }
    }
    match unified_fd_duplicate(kernel_syscall_process_key(), old_fd, new_fd) {
        UnifiedFdInstallResult::Invalid => { return false; }
        UnifiedFdInstallResult::RefOverflow => { return false; }
        UnifiedFdInstallResult::NoMemory => { return false; }
        UnifiedFdInstallResult::Ok => { return true; }
    }
}

fn kernel_connection_fd_identity(fd: usize) -> usize {
    match unified_socket_lookup(kernel_syscall_process_key(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_connection_generation(handle);
        }
    }
    return 0;
}

// GitHub issue #581: whether the connection is still open is decided under
// its owner, not by a probe before taking it, so a close or shutdown on one
// core cannot act on a state another core's call is changing. A connection
// already freed is NotOpen, exactly as the pre-take probe used to answer.
must_use variant KernelTransportReleaseResult { Released; NotOpen; Failed; }

fn kernel_connected_transport_release(slot: usize, generation: usize)
        -> KernelTransportReleaseResult {
    match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => {
            return KernelTransportReleaseResult::NotOpen;
        }
        TcpConnectionTakeResult::Ready(owner) => {
            return kernel_connected_transport_release_owned(owner);
        }
    }
}

// GitHub issue #838: free a connection after this caller has already put
// the network capability back -- a Conflict arm, or a failure found after
// the put. tcp_connection_free walks the shared retransmit chain, which
// only the capability holder may do, so this takes the capability back
// (waiting out a holder on another CPU) for the free. Since #837 the free
// takes a borrow of the capability, so without one it does not compile.
// NeverInstalled is unreachable for the syscall callers -- each had a
// capability, and the store records the first install for good -- and for
// the boot probes, which run after the link came up (#837). Should it
// happen anyway, the connection is put back and named rather than freed
// without the capability.
fn kernel_connection_free_capped(owner: sink TcpConnectionOwner[connection_pool, connection]) {
    match network_capability_take_waiting() {
        NetworkCapabilityWaitResult::NeverInstalled => {
            kernel_boot_log("tcp: connection kept, no network capability to free it\n");
            tcp_connection_put(owner);
        }
        NetworkCapabilityWaitResult::Ready(ready) => {
            tcp_connection_free(ready, owner);
            match network_capability_put(ready) {
                NetworkCapabilityPutResult::Stored => {}
                NetworkCapabilityPutResult::Conflict => {}
            }
        }
    }
}

// The same release for a caller that already holds the owner. Consumes it:
// freed on Released and on a capability conflict, put back otherwise.
fn kernel_connected_transport_release_owned(
        owner: sink TcpConnectionOwner[connection_pool, connection])
        -> KernelTransportReleaseResult {
    if (tcp_connection_of(owner).connection_open == false) {
        tcp_connection_put(owner);
        return KernelTransportReleaseResult::NotOpen;
    }
    // GitHub issue #846: waits out another holder rather than failing the
    // close with EAGAIN. The stack-wide retransmit pass now holds the
    // capability for a bounded moment from the EL0-return hook and the
    // idle loop, so an Empty store is no longer rare, and that pass never
    // waits for this connection's lock (it try-takes, and skips a busy one).
    match network_capability_take_waiting() {
        NetworkCapabilityWaitResult::NeverInstalled => {
            tcp_connection_put(owner);
            return KernelTransportReleaseResult::Failed;
        }
        NetworkCapabilityWaitResult::Ready(ready) => {
            // GitHub issue #1121: a connection the peer reset is gone
            // (Linux's TCP_CLOSE); closing it sends no FIN.
            if (tcp_connection_of(owner).peer_reset) {
                tcp_connection_free(ready, owner);
                match network_capability_put(ready) {
                    NetworkCapabilityPutResult::Conflict => {
                        return KernelTransportReleaseResult::Failed;
                    }
                    NetworkCapabilityPutResult::Stored => {
                        return KernelTransportReleaseResult::Released;
                    }
                }
            }
            match kernel_tcp_close_stream(owner, ready) {
                KernelTcpCloseResult::Closed(after_close) => {
                    // GitHub issue #838: freed while the capability is
                    // still held -- the free walks the retransmit chain.
                    tcp_connection_free(after_close, owner);
                    match network_capability_put(after_close) {
                        NetworkCapabilityPutResult::Conflict => {
                            return KernelTransportReleaseResult::Failed;
                        }
                        NetworkCapabilityPutResult::Stored => {
                            return KernelTransportReleaseResult::Released;
                        }
                    }
                }
            }
        }
    }
}

// Close one descriptor of a connected socket: drop this process's
// reference, and close the transport if it was the last one. False means
// the transport could not be closed yet (the RX capability is held
// elsewhere) and nothing changed, so the caller can retry.
//
// GitHub issue #598: the reference count is read, and the descriptor
// cleared, while holding the connection's owner. Every close of a
// connected descriptor -- close(2), dup3 over one, and an exiting process's
// reap -- comes here, so two holders closing on two CPUs serialize on the
// owner: the first sees two references and only drops its own, the second
// sees one and closes the transport. Reading the count before taking the
// owner, as this used to, let both see two and leave the connection open
// with no descriptor naming it. That window was already reachable, since
// a peer exit reaps its descriptors on the peer. A count cannot rise under
// the owner either: only a holder can duplicate a descriptor, and a count
// of one means the only holder is the caller.
fn kernel_connected_descriptor_close(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_key(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            let slot: usize = unified_connection_slot(handle);
            let generation: usize = unified_connection_generation(handle);
            match tcp_connection_take(slot, generation) {
                // Freed already -- by a shutdown, or by the last other
                // holder's close. Only this descriptor is left to clear.
                TcpConnectionTakeResult::Missing => {
                    kernel_connected_fd_clear(fd);
                    return true;
                }
                TcpConnectionTakeResult::Ready(owner) => {
                    let references: usize = unified_object_references(handle);
                    if (references == 0) {
                        tcp_connection_put(owner);
                        return false;
                    }
                    if (references > 1) {
                        kernel_connected_fd_clear(fd);
                        tcp_connection_put(owner);
                        workload_peer_socket_teardown(false);
                        return true;
                    }
                    match kernel_connected_transport_release_owned(owner) {
                        KernelTransportReleaseResult::Failed => {
                            return false;
                        }
                        KernelTransportReleaseResult::Released => {}
                        KernelTransportReleaseResult::NotOpen => {}
                    }
                    kernel_connected_fd_clear(fd);
                    workload_peer_socket_teardown(false);
                    return true;
                }
            }
        }
    }
}

// Only ever called from the EXIT handler, while the exiting child is
// still the current process -- so its own fd-table slot is exactly what
// kernel_syscall_process_slot() reports here, and is the slot whose
// CloneFileState this reaps.
fn kernel_syscall_clone_files_reap() -> KernelFdReapResult {
    let mut child_slot: ProcessSlot = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(child_slot)) {
        let state_guard = process_run_lock();
        let mut state: CloneFileState =
            scheduled_process_clone_file_state(state_guard, child_slot);
        process_run_unlock(state_guard);
        if (state.file_state_live == false) {
            return KernelFdReapResult::Failed;
        }
        // GitHub issue #393: over the child's own descriptors. Clearing
        // one removes it from the scan, so the walk restarts after the fd
        // just cleared rather than from 0.
        let mut from: usize = 0;
        let mut scanning: bool = true;
        while (scanning) {
            scanning = false;
            match unified_fd_next_open(process_slot_address(child_slot), from) {
                UnifiedFdScanResult::Done => {}
                UnifiedFdScanResult::Found(fd) => {
                    if (kernel_connected_fd_is_open(fd)) {
                        if (kernel_connected_descriptor_close(fd) == false) {
                            return KernelFdReapResult::Failed;
                        }
                    }
                    from = fd + 1;
                    scanning = true;
                }
            }
        }
        match unified_fd_destroy(process_slot_address(child_slot)) {
            UnifiedFdResult::Invalid => { return KernelFdReapResult::Failed; }
            UnifiedFdResult::Ok => {}
        }
        let mut reaped: CloneFileState = { false };
        let state_guard = process_run_lock();
        scheduled_process_set_clone_file_state(state_guard, child_slot, reaped);
        process_run_unlock(state_guard);
        return KernelFdReapResult::Reaped;
    }
    return KernelFdReapResult::Failed;
}

// Exercise the actual entry refusal before boot publishes a root filesystem.
fn kernel_syscall_filesystem_unconfigured_probe() -> bool !{unsafe} {
    match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => {}
        SyscallFilesystemReady::Configured(mount) => { return false; }
    }
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    // syscall_exec_format requires the staging buffer initialized, as
    // syscall_execve_current leaves it; this probe stages it the same way.
    zero_fill(syscall_scratch[slot.index].file_buffer as []u8);
    let refused: bool = match syscall_exec_format(slot, 0) {
        SyscallExecFormatResult::NotMounted => { true }
        _ => { false }
    };
    syscall_slot_release(slot);
    return refused;
}

// Read the published descriptor through its closed result, including a real
// directory lookup, rather than only checking the stored tag.
fn kernel_syscall_filesystem_configured_probe() -> bool !{unsafe} {
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return false; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    match ext2_lookup_path(mount, bs"etc/init.sh") {
        Ext2LookupResult::Invalid => { return false; }
        Ext2LookupResult::NotFound => { return false; }
        Ext2LookupResult::Found(inode) => {
            return ext2_regular_file_size(mount, inode) != 0;
        }
    }
}

fn kernel_syscall_ext2_configure(mount: Ext2Mount) {
    syscall_filesystem.state = SyscallFilesystemState::Configured(mount);
}

// GitHub issue #257 step 5: this used to assert on connection slots 0 and
// 1 by hand -- a test that enumerated the capacity, which was defensible
// only while the capacity was 2. What it was actually checking is that no
// connection is left open, which is now one question rather than a list.
fn kernel_syscall_socket_evidence() -> bool !{unsafe} {
    // GitHub issue #270: socket() is no longer exactly-once for the whole
    // boot. BusyBox init logs through syslog, so every message(L_LOG) it
    // emits opens a datagram socket, fails to reach /dev/log, and closes
    // it again. That says nothing about this fixture, which is why the
    // count is a floor now. bind/listen/accept stay exact: a syslog socket
    // that never connects never reaches any of them, so the shape being
    // asserted here is unchanged in strength.
    let valid: bool = syscall_test_evidence_socket_calls() >= 1 &&
           syscall_test_evidence_bind_calls() == 1 &&
           syscall_test_evidence_listen_calls() == 1 &&
           syscall_test_evidence_accept_calls() == 2 &&
           syscall_test_evidence_accept_capability_roundtrips() == 2 &&
           tcp_any_connection_open() == false &&
           kernel_connected_fd_is_open(0) == false &&
           kernel_connected_fd_is_open(1) == false &&
           kernel_connected_fd_is_open(5) == false &&
           kernel_connected_fd_is_open(6) == false &&
           syscall_test_evidence_connected_close_calls() == 2 &&
           // GitHub issue #761 added B's long and short reads and its
           // one-byte answer between them; #842 the blocked read on A.
           // #846 one more of each: A's unread byte and B's read.
           // #1121 five more reads: three EOF reads on B after its FIN,
           // and ECONNRESET then EOF on A after its reset.
           syscall_test_evidence_connected_read_calls() == 13 &&
           // #1112 one more write: the zero-length one on A. #1121 three
           // more: the trigger bytes on B and A, and the EPIPE one on A.
           syscall_test_evidence_connected_write_calls() == 11 &&
           syscall_test_evidence_socket_close_calls() == 1 &&
           kernel_listener_state(4) == UnifiedListenerState::Closed;
    syscall_test_evidence_finish_socket_fixture();
    return valid;
}

// The path buffer as kernel_syscall_path_name left it. GitHub issue #954: the
// requires clause is checked at every call, where kernel_syscall_path_name's
// ensures established it; it replaced an assume_init site.
private fn syscall_path_view_here(slot: borrow SyscallSlot[0]) -> [u8; 256..]
        requires init(syscall_scratch[slot.index].path_buffer) {
    return syscall_scratch[slot.index].path_buffer as [u8; 256..];
}

// Copy one NUL-terminated pathname through the user-memory boundary. Only a
// single root component is supported by this first generic lookup slice;
// directory traversal and symlink resolution remain separate work.
//
// GitHub issue #203: the path buffer is per-call scratch, zero-filled here
// because the copy below writes only up to the terminator. A caller reads it
// afterwards only through syscall_path_view_here.
fn kernel_syscall_path_name(slot: borrow SyscallSlot[0], current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], address: usize) -> SyscallPathResult
        ensures init(syscall_scratch[slot.index].path_buffer) {
    zero_fill(syscall_scratch[slot.index].path_buffer as []u8);
    let path_view: []u8 = syscall_scratch[slot.index].path_buffer as []u8;
    let mut length: usize = 0;
    let mut terminated: bool = false;
    for offset: usize in 0..<255 {
        if (terminated == false) {
            let current: usize = match checked_add_usize(address, offset) {
                CheckedUsize::Overflow => { return SyscallPathResult::Fault; }
                CheckedUsize::Value(v) => { v }
            };
            match user_range_check_read(current_authority, current, 1) {
                UserReadRangeResult::Fault => { return SyscallPathResult::Fault; }
                UserReadRangeResult::Ok(range) => {
                    if (copy_from_user(range, path_view[offset..<offset + 1]) == false) {
                        return SyscallPathResult::Fault;
                    }
                }
            }
            if (path_view[offset] == 0) {
                length = offset;
                terminated = true;
            }
        }
    }
    if (terminated == false || length == 0) {
        return SyscallPathResult::Invalid;
    }
    let path_length: usize = length;
    if (path_length > path_view.len) {
        return SyscallPathResult::Invalid;
    }
    let full_path = path_view[0..<path_length];
    if (path_length == 1 && path_view[0] == 0x2F) {
        path_view[0] = 0x2E;
    }
    if (path_view[0] == 0x2F) {
        if (full_path.len < 2) {
            return SyscallPathResult::Invalid;
        }
        return SyscallPathResult::Name(full_path[1..<full_path.len]);
    }
    return SyscallPathResult::Name(full_path);
}

// GitHub issue #538: a path a mutating syscall names, split into the
// directory that holds its last component and that component's span in the
// path. Lookup can walk any path; a mutation needs the directory it changes,
// which is the path minus its last component.
struct SyscallParent {
    inode: usize;
    leaf_start: usize;
    leaf_end: usize;
}

must_use variant SyscallParentResult { Errno(usize); Found(SyscallParent); }

fn kernel_syscall_parent_of(mount: Ext2Mount, dirfd: usize, absolute: bool, path_name: []u8)
        -> SyscallParentResult !{unsafe} {
    // Trailing slashes name the same directory entry (`mkdir a/` is `a`).
    let mut end: usize = path_name.len;
    for step: usize in 0..<256 {
        if (end > 1) {
            let probe: usize = end - 1;
            if (probe < path_name.len) {
                if (path_name[probe] == 0x2F) { end = probe; }
            }
        }
    }
    let mut leaf_start: usize = 0;
    for position: usize in 0..<256 {
        if (position < end && position < path_name.len) {
            if (path_name[position] == 0x2F) { leaf_start = position + 1; }
        }
    }
    let mut start_inode: usize = 2;
    if (absolute == false && dirfd != LINUX_AT_FDCWD) {
        if (kernel_syscall_directory_is_open(dirfd) == false) {
            return SyscallParentResult::Errno(LINUX_EBADF);
        }
        start_inode = kernel_syscall_directory_inode(dirfd);
    }
    let mut parent_inode: usize = start_inode;
    if (leaf_start > 1) {
        let parent_end: usize = leaf_start - 1;
        if (parent_end > path_name.len) {
            return SyscallParentResult::Errno(LINUX_EINVAL);
        }
        let parent_path = path_name[0..<parent_end];
        match ext2_lookup_path_from(mount, start_inode,
                                    parent_path) {
            Ext2LookupResult::Invalid => {
                return SyscallParentResult::Errno(LINUX_ENOENT);
            }
            Ext2LookupResult::NotFound => {
                return SyscallParentResult::Errno(LINUX_ENOENT);
            }
            Ext2LookupResult::Found(found) => { parent_inode = found; }
        }
    }
    if ((ext2_inode_mode(mount, parent_inode) & 0xF000) !=
        0x4000) {
        return SyscallParentResult::Errno(LINUX_ENOTDIR);
    }
    if (leaf_start >= end) {
        return SyscallParentResult::Errno(LINUX_ENOENT);
    }
    let mut parent: SyscallParent = { parent_inode, leaf_start, end };
    return SyscallParentResult::Found(parent);
}

// The last component, or an empty slice when the span does not fit. Each end
// is checked against what it slices, one at a time, because two ends found
// by separate scans cannot be related to each other.
fn kernel_syscall_leaf(path_name: []u8, parent: SyscallParent) -> []u8 {
    let leaf_end: usize = parent.leaf_end;
    if (leaf_end > path_name.len) { return path_name[0..<0]; }
    let head = path_name[0..<leaf_end];
    let leaf_start: usize = parent.leaf_start;
    if (leaf_start > head.len) { return path_name[0..<0]; }
    return head[leaf_start..<head.len];
}

// `.` and `..` are names a directory has, not entries it can gain or lose.
fn kernel_syscall_leaf_is_dot(leaf: []u8) -> bool {
    if (leaf.len == 1) { return leaf[0] == 0x2E; }
    return false;
}

fn kernel_syscall_leaf_is_dot_dot(leaf: []u8) -> bool {
    if (leaf.len == 2) { return leaf[0] == 0x2E && leaf[1] == 0x2E; }
    return false;
}

// Issue #196: writev(2)/readv(2) per-segment results, kept distinct from
// the underlying byte count instead of encoding "this is actually an
// errno" via a magnitude heuristic (Linux -errno values happen to be
// huge as unsigned usize, which would work, but a discriminated variant
// makes the distinction a type-level fact instead of a convention every
// call site has to remember).
must_use variant SyscallIoResult {
    Errno(usize);
    Transferred(usize);
    NetWait;
    UartWait;
    InterruptWait;
    TerminalWait;
    // GitHub issue #1042: the call named a pipe in its record under the
    // pipe lock and must wait on it; or it wrote to a pipe whose read end
    // is closed, which is EPIPE and a SIGPIPE to the writer. #1113: a TCP
    // socket that is listening, never connected or closed answers the same.
    PipeWait;
    PipeBroken;
}

// Install a wait only when the syscall has transferred no bytes. A vectored
// call with a completed prefix returns that prefix instead of replaying it.
fn syscall_io_action(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], result: SyscallIoResult) -> SyscallAction {
    match result {
        SyscallIoResult::Errno(errno) => { return SyscallAction::Resume(errno); }
        SyscallIoResult::Transferred(count) => { return SyscallAction::Resume(count); }
        SyscallIoResult::NetWait => {
            kernel_process_current_set_pending_block(current_authority, ProcessWaitReason::NetRx, 0);
            return SyscallAction::Block;
        }
        SyscallIoResult::UartWait => {
            let mut process_slot: ProcessSlot = kernel_syscall_process_slot();
            let delivery_guard = process_run_lock();
            scheduled_process_set_uart_block_delivery(
                delivery_guard, process_slot, UartBlockDelivery::Read);
            process_run_unlock(delivery_guard);
            kernel_process_current_set_pending_block(current_authority, ProcessWaitReason::UartRx, 0);
            return SyscallAction::Block;
        }
        SyscallIoResult::InterruptWait => { return SyscallAction::WaitInterrupt; }
        SyscallIoResult::TerminalWait => { return syscall_terminal_write_wait(current_authority); }
        SyscallIoResult::PipeWait => {
            kernel_process_current_set_pending_block(current_authority, ProcessWaitReason::Pipe, 0);
            return SyscallAction::Block;
        }
        SyscallIoResult::PipeBroken => {
            // Linux's pipe_write: SIGPIPE to the writer, then EPIPE. A
            // writer that ignores, blocks or catches it sees the errno; one
            // that does not ends by the signal at this call's return.
            let self_pid: usize = kernel_process_current_pid();
            match kernel_process_signal_send(self_pid, LINUX_SIGPIPE, self_pid) {
                ProcessSignalSendResult::Missing => {}
                ProcessSignalSendResult::Delivered => {}
            }
            return SyscallAction::Resume(LINUX_EPIPE);
        }
    }
}

// GitHub issue #1113: syscall_io_action for send/sendto with MSG_NOSIGNAL:
// a broken socket answers EPIPE and raises no SIGPIPE (Linux's
// sk_stream_error); every other result is mapped as for write.
fn syscall_io_action_nosignal(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], result: SyscallIoResult) -> SyscallAction {
    match result {
        SyscallIoResult::PipeBroken => { return SyscallAction::Resume(LINUX_EPIPE); }
        SyscallIoResult::Errno(errno) => { return SyscallAction::Resume(errno); }
        SyscallIoResult::Transferred(count) => { return SyscallAction::Resume(count); }
        SyscallIoResult::NetWait => { return syscall_io_action(current_authority, SyscallIoResult::NetWait); }
        SyscallIoResult::UartWait => { return syscall_io_action(current_authority, SyscallIoResult::UartWait); }
        SyscallIoResult::InterruptWait => { return syscall_io_action(current_authority, SyscallIoResult::InterruptWait); }
        SyscallIoResult::TerminalWait => { return syscall_io_action(current_authority, SyscallIoResult::TerminalWait); }
        SyscallIoResult::PipeWait => { return syscall_io_action(current_authority, SyscallIoResult::PipeWait); }
    }
}

// GitHub issue #1042: a pipe end at `fd` in the calling process.
fn kernel_syscall_pipe_is_open(fd: usize) -> bool {
    match unified_pipe_lookup(kernel_syscall_process_key(), fd) {
        UnifiedPipeResult::Missing => { return false; }
        UnifiedPipeResult::Found(found) => { return true; }
    }
}

// One read of a pipe's read end: what is buffered, up to `requested`; end of
// file once it is empty and the write end is closed; otherwise a wait,
// named under the pipe lock so that any write after this look wakes it.
fn syscall_pipe_read(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                     address: usize, requested: usize, pipe_address: usize,
                     pipe_generation: usize) -> SyscallIoResult !{unsafe} {
    if (requested == 0) { return SyscallIoResult::Transferred(0); }
    let PipeTakeResult::Ready(owner) = pipe_take(pipe_address, pipe_generation) else {
        PipeTakeResult::Missing => { return SyscallIoResult::Errno(LINUX_EBADF); }
    };
    if (pipe_of(owner).length == 0) {
        if (pipe_of(owner).writer_open == false) {
            pipe_put(owner);
            return SyscallIoResult::Transferred(0);
        }
        pipe_put_waiting(owner);
        return SyscallIoResult::PipeWait;
    }
    let (offset, first, second) = pipe_read_plan(pipe_of(owner), requested);
    match user_range_check_write(current_authority, address, first) {
        UserWriteRangeResult::Fault => {
            pipe_put(owner);
            return SyscallIoResult::Errno(LINUX_EFAULT);
        }
        UserWriteRangeResult::Ok(range) => {
            match copy_to_user_span(range, pipe_of(owner).buffer as []u8, offset, first) {
                UserWriteResult::Fault => {
                    pipe_put(owner);
                    return SyscallIoResult::Errno(LINUX_EFAULT);
                }
                UserWriteResult::Written => {}
            }
        }
    }
    let mut delivered: usize = first;
    if (second != 0) {
        match checked_add_usize(address, first) {
            CheckedUsize::Overflow => {}
            CheckedUsize::Value(wrapped_address) => {
                match user_range_check_write(current_authority, wrapped_address, second) {
                    UserWriteRangeResult::Fault => {}
                    UserWriteRangeResult::Ok(wrapped) => {
                        match copy_to_user_span(wrapped, pipe_of(owner).buffer as []u8, 0, second) {
                            UserWriteResult::Fault => {}
                            UserWriteResult::Written => { delivered = first + second; }
                        }
                    }
                }
            }
        }
    }
    let consumed = pipe_consume(owner, delivered);
    pipe_put_changed(owner, consumed);
    return SyscallIoResult::Transferred(delivered);
}

// One write to a pipe's write end: EPIPE when the read end is closed; the
// whole of a write of at most PIPE_BUFFER_BYTES once it fits, else a wait;
// what fits of a larger one (kernel/kernel/pipe.tkb, limitations).
fn syscall_pipe_write(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                      address: usize, length: usize, pipe_address: usize,
                      pipe_generation: usize) -> SyscallIoResult !{unsafe} {
    if (length == 0) { return SyscallIoResult::Transferred(0); }
    let PipeTakeResult::Ready(owner) = pipe_take(pipe_address, pipe_generation) else {
        PipeTakeResult::Missing => { return SyscallIoResult::Errno(LINUX_EBADF); }
    };
    if (pipe_of(owner).reader_open == false) {
        pipe_put(owner);
        return SyscallIoResult::PipeBroken;
    }
    let amount: usize = pipe_write_amount(pipe_of(owner), length);
    if (amount == 0) {
        pipe_put_waiting(owner);
        return SyscallIoResult::PipeWait;
    }
    let (offset, first, second) = pipe_write_plan(pipe_of(owner), amount);
    match user_range_check_read(current_authority, address, first) {
        UserReadRangeResult::Fault => {
            pipe_put(owner);
            return SyscallIoResult::Errno(LINUX_EFAULT);
        }
        UserReadRangeResult::Ok(range) => {
            if (copy_from_user_span(range, pipe_of(owner).buffer as []u8, offset, first) == false) {
                pipe_put(owner);
                return SyscallIoResult::Errno(LINUX_EFAULT);
            }
        }
    }
    let mut accepted: usize = first;
    if (second != 0) {
        match checked_add_usize(address, first) {
            CheckedUsize::Overflow => {}
            CheckedUsize::Value(wrapped_address) => {
                match user_range_check_read(current_authority, wrapped_address, second) {
                    UserReadRangeResult::Fault => {}
                    UserReadRangeResult::Ok(wrapped) => {
                        if (copy_from_user_span(wrapped, pipe_of(owner).buffer as []u8, 0, second)) {
                            accepted = first + second;
                        }
                    }
                }
            }
        }
    }
    let produced = pipe_produce(owner, accepted);
    pipe_put_changed(owner, produced);
    return SyscallIoResult::Transferred(accepted);
}

// ppoll's view of a pipe end: POLLIN with bytes to read, POLLHUP once the
// write end is closed; POLLOUT with room, POLLERR once the read end is.
// Linux's pipe_poll reports the same four.
fn syscall_pipe_poll_mask(pipe_address: usize, pipe_generation: usize, reader: bool)
        -> (bool, usize) !{unsafe} {
    let PipeTakeResult::Ready(owner) = pipe_take(pipe_address, pipe_generation) else {
        PipeTakeResult::Missing => { return (false, POLLNVAL); }
    };
    let mask: usize = syscall_pipe_poll_mask_owned(owner, reader);
    pipe_put(owner);
    return (true, mask);
}

private fn syscall_pipe_poll_mask_owned(owner: borrow PipeOwner[p, pipe], reader: bool)
        -> usize !{unsafe} {
    let mut mask: usize = 0;
    if (reader) {
        if (pipe_of(owner).length != 0) { mask = mask | POLLIN; }
        if (pipe_of(owner).writer_open == false) { mask = mask | POLLHUP; }
    } else {
        if (pipe_room(pipe_of(owner)) != 0) { mask = mask | POLLOUT; }
        if (pipe_of(owner).reader_open == false) { mask = mask | POLLERR; }
    }
    return mask;
}

// A ppoll of one pipe end with no timeout found nothing it asked for: look
// again under the pipe lock, and either name the pipe for the wait or, when
// it became ready since, name none, so the block reruns the ppoll at once.
fn syscall_pipe_poll_wait(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                          fd: usize, events: usize) -> SyscallAction !{unsafe} {
    let UnifiedPipeResult::Found(found) =
            unified_pipe_lookup(kernel_syscall_process_key(), fd) else {
        UnifiedPipeResult::Missing => { return SyscallAction::Resume(0); }
    };
    let (pipe_address, pipe_generation, reader) = found;
    let PipeTakeResult::Ready(owner) = pipe_take(pipe_address, pipe_generation) else {
        PipeTakeResult::Missing => { return SyscallAction::Resume(0); }
    };
    let mask: usize = syscall_pipe_poll_mask_owned(owner, reader);
    if ((mask & (events | POLLERR | POLLHUP)) != 0) {
        pipe_put_ready(owner);
    } else {
        pipe_put_waiting(owner);
    }
    kernel_process_current_set_pending_block(current_authority, ProcessWaitReason::Pipe, 0);
    return SyscallAction::Block;
}

// pipe2(fds, flags): a pipe, its read end at the lowest free descriptor and
// its write end at the next, both close-on-exec under O_CLOEXEC. The array
// is checked before anything is made; a store into it that still faults
// closes both descriptors again, as Linux's does.
fn syscall_pipe2(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                 fds_address: usize, flags: usize) -> SyscallAction !{unsafe} {
    if ((flags | LINUX_O_CLOEXEC) != LINUX_O_CLOEXEC) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let UserWriteRangeResult::Ok(range) = user_range_check_write(current_authority, fds_address, 8) else {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
    };
    let PipeAllocResult::Allocated(made) = pipe_alloc() else {
        PipeAllocResult::Full => { return SyscallAction::Resume(LINUX_ENFILE); }
    };
    let (pipe_address, pipe_generation) = made;
    let process: usize = kernel_syscall_process_key();
    let UnifiedFdAllocResult::Allocated(read_fd) = unified_fd_alloc(process, 0) else {
        UnifiedFdAllocResult::Full => {
            pipe_end_close(pipe_address, pipe_generation, true);
            pipe_end_close(pipe_address, pipe_generation, false);
            kernel_boot_log_resource_exhausted("process fd table" as *u8,
                                               kernel_syscall_fd_limit_soft());
            return SyscallAction::Resume(LINUX_EMFILE);
        }
    };
    match unified_pipe_end_create(process, read_fd, pipe_address, pipe_generation, true) {
        UnifiedOpenResult::Ok => {}
        UnifiedOpenResult::Invalid => {
            pipe_end_close(pipe_address, pipe_generation, true);
            pipe_end_close(pipe_address, pipe_generation, false);
            return SyscallAction::Resume(LINUX_EMFILE);
        }
        UnifiedOpenResult::Full => {
            pipe_end_close(pipe_address, pipe_generation, true);
            pipe_end_close(pipe_address, pipe_generation, false);
            kernel_boot_log_resource_exhausted("shared object pool" as *u8,
                                               unified_object_max_files());
            return SyscallAction::Resume(LINUX_ENFILE);
        }
    }
    // From here the read end belongs to read_fd: closing that descriptor
    // closes the end (unified_object_release).
    let UnifiedFdAllocResult::Allocated(write_fd) = unified_fd_alloc(process, 0) else {
        UnifiedFdAllocResult::Full => {
            syscall_pipe2_close(process, read_fd);
            pipe_end_close(pipe_address, pipe_generation, false);
            kernel_boot_log_resource_exhausted("process fd table" as *u8,
                                               kernel_syscall_fd_limit_soft());
            return SyscallAction::Resume(LINUX_EMFILE);
        }
    };
    match unified_pipe_end_create(process, write_fd, pipe_address, pipe_generation, false) {
        UnifiedOpenResult::Ok => {}
        UnifiedOpenResult::Invalid => {
            syscall_pipe2_close(process, read_fd);
            pipe_end_close(pipe_address, pipe_generation, false);
            return SyscallAction::Resume(LINUX_EMFILE);
        }
        UnifiedOpenResult::Full => {
            syscall_pipe2_close(process, read_fd);
            pipe_end_close(pipe_address, pipe_generation, false);
            kernel_boot_log_resource_exhausted("shared object pool" as *u8,
                                               unified_object_max_files());
            return SyscallAction::Resume(LINUX_ENFILE);
        }
    }
    if ((flags & LINUX_O_CLOEXEC) != 0) {
        match unified_fd_set_close_on_exec(process, read_fd, true) {
            UnifiedFdResult::Invalid => {}
            UnifiedFdResult::Ok => {}
        }
        match unified_fd_set_close_on_exec(process, write_fd, true) {
            UnifiedFdResult::Invalid => {}
            UnifiedFdResult::Ok => {}
        }
    }
    match user_write_join(user_write_u32(range, 0, read_fd as u32),
                          user_write_u32(range, 4, write_fd as u32)) {
        UserWriteResult::Fault => {
            syscall_pipe2_close(process, read_fd);
            syscall_pipe2_close(process, write_fd);
            return SyscallAction::Resume(LINUX_EFAULT);
        }
        UserWriteResult::Written => {}
    }
    return SyscallAction::Resume(0);
}

// lseek(fd, offset, whence): an ext2 or procfs file moves its shared offset
// (SEEK_SET, SEEK_CUR, and SEEK_END from the inode's size); a directory
// accepts a rewind to 0 only; a pipe, socket or terminal is ESPIPE, as on
// Linux. A position below 0 or past 2^63 is EINVAL. SEEK_DATA/SEEK_HOLE
// are EINVAL.
fn syscall_lseek(fd: usize, offset: usize, whence: usize) -> SyscallAction !{unsafe} {
    if (kernel_syscall_pipe_is_open(fd) || kernel_syscall_terminal_is_open(fd) ||
        syscall_fd_is_socket(fd)) {
        return SyscallAction::Resume(LINUX_ESPIPE);
    }
    if (kernel_syscall_directory_is_open(fd)) {
        if (whence == 0 && offset == 0) {
            if (kernel_syscall_file_set_offset(fd, 0) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            return SyscallAction::Resume(0);
        }
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    if (kernel_syscall_file_is_open(fd) == false) {
        return SyscallAction::Resume(LINUX_EBADF);
    }
    let mut base: usize = 0;
    if (whence == 1) {
        base = kernel_syscall_file_offset(fd);
    } else if (whence == 2) {
        let inode: usize = kernel_syscall_file_inode(fd);
        if (procfs_inode_is_ours(inode)) { return SyscallAction::Resume(LINUX_EINVAL); }
        let mount: Ext2Mount = match syscall_filesystem_lookup() {
            SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
            SyscallFilesystemReady::Configured(found) => { found }
        };
        base = ext2_inode_size(mount, inode);
    } else if (whence != 0) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let limit: usize = 0x7FFFFFFFFFFFFFFF;
    let mut position: usize = 0;
    if (offset > limit) {
        // A negative offset, as two's complement: its magnitude.
        let back: usize = (~offset) + 1;
        if (back > base) { return SyscallAction::Resume(LINUX_EINVAL); }
        position = base - back;
    } else {
        match checked_add_usize(base, offset) {
            CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
            CheckedUsize::Value(value) => { position = value; }
        }
        if (position > limit) { return SyscallAction::Resume(LINUX_EINVAL); }
    }
    if (kernel_syscall_file_set_offset(fd, position) == false) {
        return SyscallAction::Resume(LINUX_EBADF);
    }
    return SyscallAction::Resume(position);
}

private fn syscall_pipe2_close(process: usize, fd: usize) !{unsafe} {
    match unified_fd_close(process, fd) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

// GitHub issue #544: a userspace write to the UART terminal, in chunks. Each
// chunk is one bounded copy from user memory into the syscall scratch buffer,
// then as much of it as the transmit queue will take. A write that queues
// some bytes returns that count -- a short write, which POSIX allows and
// musl and BusyBox both finish by writing again. One that can queue nothing,
// because the queue is above its low-water mark, answers WouldBlock and the
// caller puts the writer to sleep instead of spinning in the kernel.
must_use variant TerminalWriteResult { Errno(usize); Written(usize); WouldBlock; }

fn syscall_terminal_write(slot: borrow SyscallSlot[0], current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], address: usize, length: usize)
        -> TerminalWriteResult !{unsafe} {
    if (length == 0) { return TerminalWriteResult::Written(0); }
    // GitHub issue #975: each chunk is read only after copy_from_user
    // initialized it, so the scratch staging buffer is not zero-filled.
    let mut written: usize = 0;
    while (written < length) {
        let room: usize = uart_user_write_room();
        if (room == 0) {
            if (written == 0) { return TerminalWriteResult::WouldBlock; }
            return TerminalWriteResult::Written(written);
        }
        let mut chunk: usize = length - written;
        if (chunk > room) { chunk = room; }
        if (chunk > KERNEL_BLOCK_SIZE) { chunk = KERNEL_BLOCK_SIZE; }
        let chunk_address: usize = match checked_add_usize(address, written) {
            CheckedUsize::Overflow => {
                if (written == 0) { return TerminalWriteResult::Errno(LINUX_EFAULT); }
                return TerminalWriteResult::Written(written);
            }
            CheckedUsize::Value(v) => { v }
        };
        let staging_buffer = syscall_scratch[slot.index].file_buffer as []u8;
        if (chunk > staging_buffer.len) {
            return TerminalWriteResult::Errno(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk];
        match user_range_check_read(current_authority, chunk_address, chunk) {
            UserReadRangeResult::Fault => {
                if (written == 0) { return TerminalWriteResult::Errno(LINUX_EFAULT); }
                return TerminalWriteResult::Written(written);
            }
            UserReadRangeResult::Ok(range) => {
                if (copy_from_user(range, staging) == false) {
                    if (written == 0) { return TerminalWriteResult::Errno(LINUX_EFAULT); }
                    return TerminalWriteResult::Written(written);
                }
            }
        }
        // Attribute publication and the whole bounded chunk admission are
        // serialized with TCSETSW's drain query, including peer producers.
        let guard = process_run_lock();
        let convert: bool = (terminal_output_flags() & 5) == 5;
        let queued: usize = uart_terminal_write_chunk(staging, convert);
        process_run_unlock(guard);
        if (queued == 0) {
            if (written == 0) { return TerminalWriteResult::WouldBlock; }
            return TerminalWriteResult::Written(written);
        }
        // Conversion can fill the staging buffer before the input chunk
        // ends. Keep admitting input until the actual queue has no room.
        written = written + queued;
    }
    return TerminalWriteResult::Written(written);
}

// The writer that could queue nothing sleeps until the TX interrupt has
// drained the queue, and runs the write again when it wakes. GitHub issue
// #866: it blocks whether or not anything else is Ready -- a block with no
// successor publishes Blocked and idles the CPU, as a UART read does (#583)
// -- instead of staying Running in an EL1 retry loop.
fn syscall_terminal_write_wait(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running]) -> SyscallAction {
    // Every CPU waits on the shared queue. The room recheck under the run
    // lock and the TX wake scan use the same UartTx wait reason.
    uart_user_write_note_wait();
    uart_user_write_note_sleep();
    kernel_process_current_set_pending_block(current_authority, ProcessWaitReason::UartTx, 0);
    return SyscallAction::Block;
}

// Shared scalar and vectored fd operation; byte counts and errors stay distinct.
fn syscall_write_segment(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], fd: usize, address: usize, length: usize)
        -> SyscallIoResult !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallIoResult = syscall_write_segment_with(slot, current_authority, fd, address, length);
    syscall_slot_release(slot);
    return result;
}

fn syscall_write_segment_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], fd: usize, address: usize, length: usize)
        -> SyscallIoResult !{unsafe} {
        if (kernel_connected_fd_is_open(fd)) {
            syscall_test_evidence_record_connected_write();
            if (kernel_connected_fd_is_open(fd) == false) {
                return SyscallIoResult::Errno(LINUX_EBADF);
            }
            let write_slot: usize =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallIoResult::Errno(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let write_generation: usize = kernel_connection_fd_identity(fd);
            let mut amount: usize = length;
            if (amount > 1460) { amount = 1460; }
            // GitHub issue #581: the open check and the received-length
            // snapshot are taken under the connection's owner, not before
            // it, so a peer's write cannot act on a state the owning core
            // is changing.
            // GitHub issue #1113: a connection that is gone (retired, or
            // no longer open) is Linux's EPIPE with SIGPIPE, as for a pipe
            // with no reader; it was EINVAL.
            match tcp_connection_take(write_slot, write_generation) {
                TcpConnectionTakeResult::Missing => {
                    return SyscallIoResult::PipeBroken;
                }
                TcpConnectionTakeResult::Ready(owner) => {
                  if (tcp_connection_of(owner).connection_open == false) {
                      tcp_connection_put(owner);
                      return SyscallIoResult::PipeBroken;
                  }
                  // GitHub issue #1121 (#1117): after a peer reset the
                  // first write is ECONNRESET without SIGPIPE, unless a
                  // read reported it first; every later one is EPIPE with
                  // SIGPIPE, for any length, as tcp_sendmsg's do_error.
                  match tcp_connection_peer_write_answer(tcp_connection_of(owner)) {
                      TcpPeerWriteAnswer::Open => {}
                      TcpPeerWriteAnswer::Reset => {
                          tcp_connection_put(owner);
                          return SyscallIoResult::Errno(LINUX_ECONNRESET);
                      }
                      TcpPeerWriteAnswer::Broken => {
                          tcp_connection_put(owner);
                          return SyscallIoResult::PipeBroken;
                      }
                  }
                  // GitHub issue #1112: Linux's tcp_sendmsg checks the
                  // connection state first, then sends nothing and returns
                  // 0 for an empty buffer; it is not EINVAL.
                  if (length == 0) {
                      tcp_connection_put(owner);
                      return SyscallIoResult::Transferred(0);
                  }
                  let received_length: usize =
                      tcp_connection_of(owner).socket_buffer_length;
                  match network_capability_take() {
                    NetworkCapabilityTakeResult::Empty => {
                        tcp_connection_put(owner);
                        return SyscallIoResult::NetWait;
                    }
                    NetworkCapabilityTakeResult::Ready(ready) => {
                    let Place::Full(rx) =
                            tcp_connection_frame_hold(owner, TcpFrameRole::Rx) else {
                        Place::Empty => {
                            tcp_frame_missing();
                            tcp_connection_put(owner);
                            match network_capability_put(ready) {
                                NetworkCapabilityPutResult::Stored => {}
                                NetworkCapabilityPutResult::Conflict => {}
                            }
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    };
                    let socket_buffers = tcp_frame_bytes(rx);
                    match user_range_check_read(current_authority, address, amount) {
                        UserReadRangeResult::Fault => {
                            tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                        rx);
                            tcp_connection_put(owner);
                            match network_capability_put(ready) {
                                NetworkCapabilityPutResult::Stored => {}
                                NetworkCapabilityPutResult::Conflict => {}
                            }
                            return SyscallIoResult::Errno(LINUX_EFAULT);
                        }
                        UserReadRangeResult::Ok(range) => {
                            if (copy_from_user_span(range, socket_buffers, 0,
                                                    amount) == false) {
                                tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                            rx);
                                tcp_connection_put(owner);
                                match network_capability_put(ready) {
                                    NetworkCapabilityPutResult::Stored => {}
                                    NetworkCapabilityPutResult::Conflict => {}
                                }
                                return SyscallIoResult::Errno(LINUX_EFAULT);
                            }
                        }
                    }
                    let sent = kernel_tcp_send_received(
                            owner, ready,
                            socket_buffers[0..<1460],
                            received_length, amount);
                    tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                rx);
                    match sent {
                        KernelTcpSendResult::Invalid(after_invalid) => {
                            match network_capability_put(after_invalid) {
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_put(owner);
                                    return SyscallIoResult::Errno(LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Conflict => {
                                    kernel_connection_free_capped(owner);
                                    return SyscallIoResult::Errno(LINUX_EINVAL);
                                }
                            }
                        }
                        KernelTcpSendResult::Sent(after_send) => {
                            match network_capability_put(after_send) {
                                NetworkCapabilityPutResult::Conflict => {
                                    kernel_connection_free_capped(owner);
                                    return SyscallIoResult::Errno(LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_put(owner);
                                    workload_peer_socket_served(true);
                                    return SyscallIoResult::Transferred(amount);
                                }
                            }
                        }
                    }
                    }
                  }
                }
            }
        }
        // GitHub issue #1113: a socket that is listening or never
        // connected is Linux's LISTEN or CLOSE state, where tcp_sendmsg's
        // sk_stream_wait_connect answers EPIPE (with SIGPIPE) for any
        // length, 0 included; it was EBADF.
        match kernel_listener_fd_lookup(fd) {
            KernelListenerLookupResult::Missing => {}
            KernelListenerLookupResult::Found(listener_fd) => {
                return SyscallIoResult::PipeBroken;
            }
        }
        match unified_pipe_lookup(kernel_syscall_process_key(), fd) {
            UnifiedPipeResult::Missing => {}
            UnifiedPipeResult::Found(found) => {
                let (pipe_address, pipe_generation, reader) = found;
                if (reader) { return SyscallIoResult::Errno(LINUX_EBADF); }
                return syscall_pipe_write(current_authority, address, length,
                                          pipe_address, pipe_generation);
            }
        }
        if (kernel_syscall_file_is_open(fd)) {
            if (kernel_syscall_file_writable(fd) == false) {
                return SyscallIoResult::Errno(LINUX_EBADF);
            }
            // GitHub issue #1092: a zero-length write to an ext2 or procfs
            // file transfers nothing and changes nothing, as on Linux (and
            // as syscall_pipe_write already does); it is not EINVAL.
            if (length == 0) {
                return SyscallIoResult::Transferred(0);
            }
            // GitHub issue #497: /proc/takibi/profile, the one writable
            // procfs node, takes a command rather than file data; a command
            // longer than the staging block is not one.
            let written_inode: usize = kernel_syscall_file_inode(fd);
            if (procfs_inode_is_ours(written_inode)) {
                if (length > KERNEL_BLOCK_SIZE) {
                    return SyscallIoResult::Errno(LINUX_EINVAL);
                }
                // GitHub issue #975: the content read below is the span that
                // copy_from_user_span initialized; no zero fill.
                match user_range_check_read(current_authority, address, length) {
                    UserReadRangeResult::Fault => {
                        return SyscallIoResult::Errno(LINUX_EFAULT);
                    }
                    UserReadRangeResult::Ok(range) => {
                        if (copy_from_user_span(
                                range,
                                syscall_scratch[slot.index].file_buffer as []u8,
                                0, length) == false) {
                            return SyscallIoResult::Errno(LINUX_EFAULT);
                        }
                    }
                }
                let content_buffer = syscall_scratch[slot.index].file_buffer as []u8;
                if (length > content_buffer.len) {
                    return SyscallIoResult::Errno(LINUX_EINVAL);
                }
                let content = content_buffer[0..<length];
                let control_answer: usize = procfs_write(written_inode, content);
                if (control_answer != 0) {
                    return SyscallIoResult::Errno(control_answer);
                }
                return SyscallIoResult::Transferred(length);
            }
            // GitHub issue #1036: an ext2 write longer than the staging block
            // goes one block at a time, as the read path does; a failure
            // after a transferred prefix reports that prefix (a short write).
            let mut written: usize = 0;
            while (written < length) {
                let chunk: usize = min(length - written, KERNEL_BLOCK_SIZE);
                let source: usize = match checked_add_usize(address, written) {
                    CheckedUsize::Overflow => {
                        if (written != 0) {
                            return SyscallIoResult::Transferred(written);
                        }
                        return SyscallIoResult::Errno(LINUX_EFAULT);
                    }
                    CheckedUsize::Value(value) => { value }
                };
                match user_range_check_read(current_authority, source, chunk) {
                    UserReadRangeResult::Fault => {
                        if (written != 0) {
                            return SyscallIoResult::Transferred(written);
                        }
                        return SyscallIoResult::Errno(LINUX_EFAULT);
                    }
                    UserReadRangeResult::Ok(range) => {
                        if (copy_from_user_span(
                                range,
                                syscall_scratch[slot.index].file_buffer as []u8,
                                0, chunk) == false) {
                            if (written != 0) {
                                return SyscallIoResult::Transferred(written);
                            }
                            return SyscallIoResult::Errno(LINUX_EFAULT);
                        }
                    }
                }
                let content_buffer = syscall_scratch[slot.index].file_buffer as []u8;
                if (chunk > content_buffer.len) {
                    return SyscallIoResult::Errno(LINUX_EINVAL);
                }
                let content = content_buffer[0..<chunk];
                let answer: usize = syscall_ext2_write_locked(fd, content);
                if (answer != 0) {
                    if (written != 0) {
                        return SyscallIoResult::Transferred(written);
                    }
                    return SyscallIoResult::Errno(answer);
                }
                workload_peer_mutation_note(8);
                written = written + chunk;
            }
            return SyscallIoResult::Transferred(written);
        }
        if (kernel_syscall_terminal_is_open(fd) == false) {
            return SyscallIoResult::Errno(LINUX_EBADF);
        }
        match syscall_terminal_write(slot, current_authority, address, length) {
            TerminalWriteResult::Errno(errno) => {
                return SyscallIoResult::Errno(errno);
            }
            TerminalWriteResult::Written(count) => {
                return SyscallIoResult::Transferred(count);
            }
            TerminalWriteResult::WouldBlock => {
                return SyscallIoResult::TerminalWait;
            }
        }
}

// Shared scalar and vectored fd operation; byte counts and errors stay distinct.
fn syscall_read_segment(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], fd: usize, address: usize, requested: usize)
        -> SyscallIoResult !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallIoResult = syscall_read_segment_with(slot, current_authority, fd, address, requested);
    syscall_slot_release(slot);
    return result;
}

fn syscall_read_segment_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], fd: usize, address: usize, requested: usize)
        -> SyscallIoResult !{unsafe} {
        if (kernel_connected_fd_is_open(fd)) {
            let read_slot: usize =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallIoResult::Errno(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let read_generation: usize = kernel_connection_fd_identity(fd);
            // GitHub issue #581: every connection field below is read and
            // written under the connection's owner. A peer may make this
            // call, so an open check or a buffered-copy cursor update taken
            // before the owner would race the core that holds it.
            match tcp_connection_take(read_slot, read_generation) {
              TcpConnectionTakeResult::Missing => {
                return SyscallIoResult::Errno(LINUX_EBADF);
              }
              TcpConnectionTakeResult::Ready(owner) => {
               let conn: &mut TcpConnection = tcp_connection_of(owner);
               if (conn.connection_open == false) {
                   tcp_connection_put(owner);
                   return SyscallIoResult::Errno(LINUX_EBADF);
               }
               // GitHub issue #1121: with nothing buffered, a peer FIN is
               // EOF and a peer reset is ECONNRESET once, then EOF, for
               // any length (tcp_recvmsg's rcvlowat is at least 1). It
               // used to wait out the 30-second receive timeout.
               if (conn.socket_buffer_offset >= conn.socket_buffer_length) {
                   match tcp_connection_peer_read_answer(conn) {
                       TcpPeerReadAnswer::Open => {}
                       TcpPeerReadAnswer::Eof => {
                           // A new logical read counts once, as below.
                           if (conn.receive_waiting == false) {
                               syscall_test_evidence_record_connected_read();
                           }
                           conn.receive_waiting = false;
                           tcp_connection_put(owner);
                           return SyscallIoResult::Transferred(0);
                       }
                       TcpPeerReadAnswer::Reset => {
                           // A new logical read counts once, as below.
                           if (conn.receive_waiting == false) {
                               syscall_test_evidence_record_connected_read();
                           }
                           conn.receive_waiting = false;
                           tcp_connection_put(owner);
                           return SyscallIoResult::Errno(LINUX_ECONNRESET);
                       }
                   }
               }
               // GitHub issue #1116: Linux's tcp_recvmsg copies nothing
               // and returns 0 for a zero-length read on an open
               // connection; it was EBADF.
               if (requested == 0) {
                   tcp_connection_put(owner);
                   return SyscallIoResult::Transferred(0);
               }
               // A NetRx wake retries this same EL0 read syscall. Keep the
               // evidence count and timeout window attached to that logical
               // read rather than counting each handler re-entry as a new
               // userspace operation.
               if (conn.receive_waiting == false) {
                   syscall_test_evidence_record_connected_read();
                   conn.receive_started_at = read_cntpct();
                   conn.receive_waiting = true;
               }
               if (conn.socket_buffer_offset < conn.socket_buffer_length) {
                   conn.receive_waiting = false;
                   let available: usize =
                       conn.socket_buffer_length - conn.socket_buffer_offset;
                   let mut buffered: usize = requested;
                   if (buffered > available) { buffered = available; }
                   let Place::Full(rx) =
                           tcp_connection_frame_hold(owner, TcpFrameRole::Rx) else {
                       Place::Empty => {
                           tcp_frame_missing();
                           tcp_connection_put(owner);
                           return SyscallIoResult::Errno(LINUX_EINVAL);
                       }
                   };
                   match user_range_check_write(current_authority, address, buffered) {
                       UserWriteRangeResult::Fault => {
                           tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                       rx);
                           tcp_connection_put(owner);
                           return SyscallIoResult::Errno(LINUX_EFAULT);
                       }
                       UserWriteRangeResult::Ok(range) => {
                           match copy_to_user_span(range, tcp_frame_bytes(rx),
                                                   conn.socket_buffer_offset,
                                                   buffered) {
                               UserWriteResult::Fault => {
                                   // Nothing was delivered: keep the bytes
                                   // readable and the offset where it was.
                                   tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                               rx);
                                   tcp_connection_put(owner);
                                   return SyscallIoResult::Errno(LINUX_EFAULT);
                               }
                               UserWriteResult::Written => {}
                           }
                       }
                   }
                   tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                               rx);
                   conn.socket_buffer_offset = conn.socket_buffer_offset + buffered;
                   tcp_connection_put(owner);
                   workload_peer_socket_served(false);
                   return SyscallIoResult::Transferred(buffered);
               }
               let ready: NetRxCanAcquire = match network_capability_take() {
                 NetworkCapabilityTakeResult::Empty => {
                    tcp_connection_put(owner);
                    return SyscallIoResult::NetWait;
                 }
                 NetworkCapabilityTakeResult::Ready(r) => { r }
               };
               let Place::Full(rx) =
                       tcp_connection_frame_hold(owner, TcpFrameRole::Rx) else {
                   Place::Empty => {
                       tcp_frame_missing();
                       tcp_connection_put(owner);
                       match network_capability_put(ready) {
                           NetworkCapabilityPutResult::Stored => {}
                           NetworkCapabilityPutResult::Conflict => {}
                       }
                       return SyscallIoResult::Errno(LINUX_EINVAL);
                   }
               };
               let socket_buffers = tcp_frame_bytes(rx);
               let received_once = kernel_tcp_receive_once(
                    owner, ready, socket_buffers[0..<1460]);
               tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                           rx);
               match received_once {
                KernelTcpReceiveResult::Pending(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => {
                            tcp_connection_put(owner);
                            return SyscallIoResult::NetWait;
                        }
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    }
                }
                KernelTcpReceiveResult::Routed(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => {
                            tcp_connection_put(owner);
                            return SyscallIoResult::NetWait;
                        }
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    }
                }
                KernelTcpReceiveResult::PeerClosed(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => {
                            let answer: TcpPeerReadAnswer =
                                tcp_connection_peer_read_answer(
                                    tcp_connection_of(owner));
                            tcp_connection_put(owner);
                            match answer {
                                TcpPeerReadAnswer::Open => {
                                    return SyscallIoResult::NetWait;
                                }
                                TcpPeerReadAnswer::Eof => {
                                    return SyscallIoResult::Transferred(0);
                                }
                                TcpPeerReadAnswer::Reset => {
                                    return SyscallIoResult::Errno(LINUX_ECONNRESET);
                                }
                            }
                        }
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    }
                }
                KernelTcpReceiveResult::TimedOut(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => {
                            tcp_connection_put(owner);
                            return SyscallIoResult::Errno(LINUX_EAGAIN);
                        }
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    }
                }
                KernelTcpReceiveResult::Received(next) => {
                    let received: usize =
                        kernel_tcp_received_length(owner);
                    tcp_connection_of(owner).socket_buffer_length = received;
                    let mut amount: usize = received;
                    if (amount > requested) { amount = requested; }
                    let Place::Full(received_rx) =
                            tcp_connection_frame_hold(owner, TcpFrameRole::Rx) else {
                        Place::Empty => {
                            tcp_frame_missing();
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Stored => {}
                                NetworkCapabilityPutResult::Conflict => {}
                            }
                            tcp_connection_put(owner);
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    };
                    match user_range_check_write(current_authority, address, amount) {
                        UserWriteRangeResult::Fault => {
                            tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                        received_rx);
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Stored => {}
                                NetworkCapabilityPutResult::Conflict => {}
                            }
                            tcp_connection_put(owner);
                            return SyscallIoResult::Errno(LINUX_EFAULT);
                        }
                        UserWriteRangeResult::Ok(range) => {
                            match copy_to_user_span(range,
                                                    tcp_frame_bytes(received_rx),
                                                    0, amount) {
                                UserWriteResult::Fault => {
                                    // Nothing was delivered: the received
                                    // bytes stay buffered from offset 0 for
                                    // the next read.
                                    tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                                received_rx);
                                    tcp_connection_of(owner).socket_buffer_offset = 0;
                                    match network_capability_put(next) {
                                        NetworkCapabilityPutResult::Stored => {
                                            tcp_connection_put(owner);
                                            return SyscallIoResult::Errno(LINUX_EFAULT);
                                        }
                                        NetworkCapabilityPutResult::Conflict => {
                                            kernel_connection_free_capped(owner);
                                            return SyscallIoResult::Errno(LINUX_EINVAL);
                                        }
                                    }
                                }
                                UserWriteResult::Written => {}
                            }
                        }
                    }
                    tcp_connection_frame_unhold(owner, TcpFrameRole::Rx,
                                                received_rx);
                    tcp_connection_of(owner).socket_buffer_offset = amount;
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => {
                            tcp_connection_put(owner);
                            workload_peer_socket_served(false);
                            return SyscallIoResult::Transferred(amount);
                        }
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            return SyscallIoResult::Errno(LINUX_EINVAL);
                        }
                    }
                }
               }
              }
            }
        }
        // GitHub issue #1116: a socket that is listening or never
        // connected is Linux's LISTEN or CLOSE state, where tcp_recvmsg
        // answers ENOTCONN for any length; it was EBADF.
        match kernel_listener_fd_lookup(fd) {
            KernelListenerLookupResult::Missing => {}
            KernelListenerLookupResult::Found(listener_fd) => {
                return SyscallIoResult::Errno(LINUX_ENOTCONN);
            }
        }
        // GitHub issue #902: a read of any terminal descriptor reads the
        // terminal, as Linux's does.
        if (kernel_syscall_terminal_is_open(fd)) {
            return syscall_read_uart(current_authority, address, requested);
        }
        match unified_pipe_lookup(kernel_syscall_process_key(), fd) {
            UnifiedPipeResult::Missing => {}
            UnifiedPipeResult::Found(found) => {
                let (pipe_address, pipe_generation, reader) = found;
                if (reader == false) { return SyscallIoResult::Errno(LINUX_EBADF); }
                return syscall_pipe_read(current_authority, address, requested,
                                         pipe_address, pipe_generation);
            }
        }
        if (kernel_syscall_file_is_open(fd) == false ||
            kernel_syscall_file_readable(fd) == false) {
            return SyscallIoResult::Errno(LINUX_EBADF);
        }
        let opened_inode: usize = kernel_syscall_file_inode(fd);
        if (procfs_inode_is_ours(opened_inode)) {
            // GitHub issue #977: the renderer ensures init of the prefix it
            // reports, and only bytes inside that prefix are copied out, so
            // the staging needs no zero_fill (nor does the ext2 path below,
            // #975).
            let staging_buffer: []u8 =
                syscall_scratch[slot.index].file_buffer as []u8;
            let total: usize = procfs_render_file(opened_inode,
                                                  staging_buffer);
            let offset: usize = kernel_syscall_file_offset(fd);
            if (offset >= total || requested == 0) {
                return SyscallIoResult::Transferred(0);
            }
            let amount: usize = min(total - offset, requested);
            match user_range_check_write(current_authority, address, amount) {
                UserWriteRangeResult::Fault => {
                    return SyscallIoResult::Errno(LINUX_EFAULT);
                }
                UserWriteRangeResult::Ok(range) => {
                    match copy_to_user_span(
                            range,
                            syscall_scratch[slot.index].file_buffer as []u8,
                            offset, amount) {
                        UserWriteResult::Fault => {
                            return SyscallIoResult::Errno(LINUX_EFAULT);
                        }
                        UserWriteResult::Written => {}
                    }
                }
            }
            if (kernel_syscall_file_set_offset(fd, offset + amount) == false) {
                return SyscallIoResult::Errno(LINUX_EBADF);
            }
            return SyscallIoResult::Transferred(amount);
        }
        let mount: Ext2Mount = match syscall_filesystem_lookup() {
            SyscallFilesystemReady::Unconfigured => { return SyscallIoResult::Errno(LINUX_EBADF); }
            SyscallFilesystemReady::Configured(found) => { found }
        };
        // Do not turn the requested length into a kernel allocation. Each
        // iteration obtains one ext2 block and copies it into the next
        // validated portion of the user range, matching the bounded
        // page/buffer-cache transfer shape used by Unix kernels.
        let mut copied: usize = 0;
        while (copied < requested) {
            let mut chunk_limit: usize = requested - copied;
            if (chunk_limit > KERNEL_BLOCK_SIZE) {
                chunk_limit = KERNEL_BLOCK_SIZE;
            }
            let staging_buffer = syscall_scratch[slot.index].file_buffer as []u8;
            if (chunk_limit > staging_buffer.len) {
                return SyscallIoResult::Errno(LINUX_EINVAL);
            }
            let staging = staging_buffer[0..<chunk_limit];
            match ext2_read_file_chunk(
                    mount, kernel_syscall_file_inode(fd),
                    kernel_syscall_file_offset(fd),
                    staging) {
                Ext2ReadResult::Invalid => {
                    if (copied != 0) { return SyscallIoResult::Transferred(copied); }
                    return SyscallIoResult::Errno(LINUX_EINVAL);
                }
                Ext2ReadResult::Read(chunk) => {
                    if (chunk == 0) { return SyscallIoResult::Transferred(copied); }
                    let target_address: usize =
                        match checked_add_usize(address, copied) {
                            CheckedUsize::Overflow => {
                                if (copied != 0) {
                                    return SyscallIoResult::Transferred(copied);
                                }
                                return SyscallIoResult::Errno(LINUX_EFAULT);
                            }
                            CheckedUsize::Value(value) => { value }
                        };
                    match user_range_check_write(current_authority, target_address, chunk) {
                        UserWriteRangeResult::Fault => {
                            if (copied != 0) {
                                return SyscallIoResult::Transferred(copied);
                            }
                            return SyscallIoResult::Errno(LINUX_EFAULT);
                        }
                        UserWriteRangeResult::Ok(range) => {
                            match copy_to_user_span(
                                    range,
                                    syscall_scratch[slot.index].file_buffer as []u8,
                                    0, chunk) {
                                UserWriteResult::Fault => {
                                    // The file offset has not advanced past
                                    // this chunk; report the delivered prefix.
                                    if (copied != 0) {
                                        return SyscallIoResult::Transferred(copied);
                                    }
                                    return SyscallIoResult::Errno(LINUX_EFAULT);
                                }
                                UserWriteResult::Written => {}
                            }
                        }
                    }
                    if (kernel_syscall_file_set_offset(
                            fd, kernel_syscall_file_offset(fd) + chunk) ==
                            false) {
                        if (copied != 0) {
                            return SyscallIoResult::Transferred(copied);
                        }
                        return SyscallIoResult::Errno(LINUX_EBADF);
                    }
                    copied = copied + chunk;
                }
            }
        }
        return SyscallIoResult::Transferred(copied);
}

// ppoll(2) readiness for one fd: (is_valid_fd, revents). fd 0 checks the
// real UART RX ring (kernel_uart_rx_pending()). Its concrete BusyBox ash
// form -- one stdin pollfd and a null timeout -- waits on the retained
// interrupt event until the UART RX IRQ publishes a byte. Mixed fd sets and
// finite timeouts remain out of scope for this first real wait path.
// Connected TCP fds
// check already-buffered data read-only (no mutation, so no risk to the
// proven TCP send/receive paths). Regular files and directories are always
// ready (#768); every terminal fd reports as fd 0 does (#902); the rest is
// POLLNVAL.
// The UART RX ring lives in kernel/drivers/serial/uart_rx_ring.tkb (GitHub
// issue #543); this file reads it through kernel_uart_rx_pending and
// kernel_uart_rx_getc.

fn syscall_poll_fd_ready(fd: usize) -> (bool, usize) {
    // GitHub issue #902: any descriptor of the terminal, not fd 0 alone.
    if (kernel_syscall_terminal_is_open(fd)) {
        // GitHub issue #1221: POLLOUT when a write would not block -- the
        // same room syscall_terminal_write asks (#544).
        let mut ready: usize = 0;
        if (kernel_uart_rx_pending()) { ready = POLLIN; }
        if (uart_user_write_room() != 0) { ready = ready | POLLOUT; }
        return (true, ready);
    }
    if (kernel_connected_fd_is_open(fd)) {
        match kernel_connection_fd_lookup(fd) {
            KernelConnectionLookupResult::Missing => {
                return (false, POLLNVAL);
            }
            KernelConnectionLookupResult::Found(slot) => {
                if (tcp_connection_has_pending_read(slot)) {
                    return (true, POLLIN);
                }
                return (true, 0);
            }
        }
    }
    // GitHub issue #768: a regular file or directory is always ready, as
    // Linux's DEFAULT_POLLMASK says. ash's read builtin polls fd 0 with no
    // timeout before each read, so a file redirected onto stdin that
    // reported 0 here sent that poll into the UART wait.
    if (kernel_syscall_file_is_open(fd) ||
        kernel_syscall_directory_is_open(fd)) {
        return (true, POLLIN | POLLOUT);
    }
    if (kernel_syscall_terminal_is_open(fd)) {
        return (true, 0);
    }
    match unified_pipe_lookup(kernel_syscall_process_key(), fd) {
        UnifiedPipeResult::Missing => {}
        UnifiedPipeResult::Found(found) => {
            let (pipe_address, pipe_generation, reader) = found;
            return syscall_pipe_poll_mask(pipe_address, pipe_generation, reader);
        }
    }
    return (false, POLLNVAL);
}

must_use variant SyscallDeadlineResult {
    Fault;
    Invalid;
    Ready;
    Block;
}

// A deadline or signal wait always blocks (Blocked, queued on this core's
// tick-wake list, #829), on every core, as Linux does: the core idles in
// kernel_idle_loop, its own tick wakes the deadline, and a signal wakes the
// waiter under the run lock. Core 0 used to retry through WaitInterrupt
// while it was alone (#840 covered peers only); #852 made it equal.

// Parse one Linux arm64 timespec and either finish a zero/already-expired
// wait or arm the current process against the architectural generic counter.
fn syscall_deadline_wait(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], timespec_address: usize, absolute: bool)
        -> SyscallDeadlineResult {
    if (timespec_address == 0) { return SyscallDeadlineResult::Invalid; }
    let mut seconds: usize = 0;
    let mut nanoseconds: usize = 0;
    match user_range_check_read(current_authority, timespec_address, 16) {
        UserReadRangeResult::Fault => {
            return SyscallDeadlineResult::Fault;
        }
        UserReadRangeResult::Ok(range) => {
            let (seconds_ok, seconds_raw) = user_read_u64(range, 0);
            let (nanoseconds_ok, nanoseconds_raw) = user_read_u64(range, 8);
            if (seconds_ok == false || nanoseconds_ok == false) {
                return SyscallDeadlineResult::Invalid;
            }
            seconds = seconds_raw as usize;
            nanoseconds = nanoseconds_raw as usize;
        }
    }
    if (nanoseconds >= 1000000000) {
        return SyscallDeadlineResult::Invalid;
    }
    let now: usize = read_cntpct() as usize;
    if (kernel_process_current_pending_block_reason(current_authority) ==
            ProcessWaitReason::Deadline) {
        if (now >= kernel_process_current_deadline_ticks(current_authority)) {
            kernel_process_current_clear_deadline(current_authority);
            return SyscallDeadlineResult::Ready;
        }
        return SyscallDeadlineResult::Block;
    }
    let frequency: usize = read_cntfrq() as usize;
    let whole_ticks: usize = match checked_mul_usize(seconds, frequency) {
        CheckedUsize::Overflow => { return SyscallDeadlineResult::Invalid; }
        CheckedUsize::Value(value) => { value }
    };
    let subsecond_product: usize =
        match checked_mul_usize(nanoseconds, frequency) {
            CheckedUsize::Overflow => { return SyscallDeadlineResult::Invalid; }
            CheckedUsize::Value(value) => { value }
        };
    let requested_ticks: usize = match checked_add_usize(
            whole_ticks, subsecond_product / 1000000000) {
        CheckedUsize::Overflow => { return SyscallDeadlineResult::Invalid; }
        CheckedUsize::Value(value) => { value }
    };
    let mut deadline: usize = requested_ticks;
    if (absolute == false) {
        if (requested_ticks == 0) { return SyscallDeadlineResult::Ready; }
        match checked_add_usize(now, requested_ticks) {
            CheckedUsize::Overflow => {
                return SyscallDeadlineResult::Invalid;
            }
            CheckedUsize::Value(value) => { deadline = value; }
        }
    }
    if (deadline <= now) { return SyscallDeadlineResult::Ready; }
    kernel_process_current_arm_deadline(current_authority, deadline, 0);
    return SyscallDeadlineResult::Block;
}

fn syscall_signal_wait(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], wait_set: usize, timeout_address: usize)
        -> SyscallAction {
    match kernel_process_current_signal_take(wait_set) {
        ProcessSignalPendingResult::Pending(taken) => {
            kernel_process_current_clear_deadline(current_authority);
            return SyscallAction::Resume(taken_signal_delivered(taken));
        }
        ProcessSignalPendingResult::Missing => {}
    }
    let now: usize = read_cntpct() as usize;
    if (kernel_process_current_pending_block_reason(current_authority) ==
            ProcessWaitReason::Signal) {
        let armed: usize = kernel_process_current_deadline_ticks(current_authority);
        if (armed != 0 && now >= armed) {
            kernel_process_current_clear_deadline(current_authority);
            return SyscallAction::Resume(LINUX_EAGAIN);
        }
        return SyscallAction::Block;
    }
    if (timeout_address != 0) {
        let mut seconds: usize = 0;
        let mut nanoseconds: usize = 0;
        match user_range_check_read(current_authority, timeout_address, 16) {
            UserReadRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserReadRangeResult::Ok(range) => {
                let (seconds_ok, seconds_raw) = user_read_u64(range, 0);
                let (nanoseconds_ok, nanoseconds_raw) =
                    user_read_u64(range, 8);
                if (seconds_ok == false || nanoseconds_ok == false) {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                seconds = seconds_raw as usize;
                nanoseconds = nanoseconds_raw as usize;
            }
        }
        if (nanoseconds >= 1000000000) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let frequency: usize = read_cntfrq() as usize;
        let whole_ticks: usize = match checked_mul_usize(seconds, frequency) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            CheckedUsize::Value(value) => { value }
        };
        let subsecond_product: usize =
            match checked_mul_usize(nanoseconds, frequency) {
                CheckedUsize::Overflow => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                CheckedUsize::Value(value) => { value }
            };
        let duration: usize = match checked_add_usize(
                whole_ticks, subsecond_product / 1000000000) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            CheckedUsize::Value(value) => { value }
        };
        if (duration == 0) {
            return SyscallAction::Resume(LINUX_EAGAIN);
        }
        let deadline: usize = match checked_add_usize(now, duration) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            CheckedUsize::Value(value) => { value }
        };
        kernel_process_current_arm_deadline(current_authority, deadline, LINUX_EAGAIN);
    }
    kernel_process_current_prepare_signal_wait(current_authority, wait_set);
    let mut process_slot: ProcessSlot = kernel_syscall_process_slot();
    let mut first_init_wait: bool = false;
    if (kernel_process_current_pid() == 1) {
        let logged_guard = process_run_lock();
        if (scheduled_process_init_signal_wait_logged(logged_guard,
                                                      process_slot) == false) {
            scheduled_process_set_init_signal_wait_logged(logged_guard,
                                                          process_slot, true);
            first_init_wait = true;
        }
        process_run_unlock(logged_guard);
    }
    if (first_init_wait) {
        kernel_boot_log(
            "signal: BusyBox init blocked in rt_sigtimedwait for SIGCHLD\n");
    }
    return SyscallAction::Block;
}

fn syscall_ppoll_dispatch(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], fds_address: usize, raw_nfds: usize,
                          timeout_address: usize, sigmask_address: usize)
        -> SyscallAction !{unsafe} {
    if (raw_nfds == 0) {
        // GitHub issue #870: ppoll(0, NULL) is musl's pause(). It sleeps,
        // Blocked, until a signal it catches or one that ends it, as
        // rt_sigsuspend does under the mask ppoll was given (the caller's
        // own when none), and then answers EINTR after the handler.
        if (timeout_address == 0) {
            if (sigmask_address == 0) {
                kernel_process_current_clear_signal_suspend();
                return syscall_signal_suspend_under(
                    current_authority, kernel_process_current_signal_mask(),
                    true);
            }
            return syscall_signal_suspend(current_authority, sigmask_address, 8);
        }
        match syscall_deadline_wait(current_authority, timeout_address, false) {
            SyscallDeadlineResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            SyscallDeadlineResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            SyscallDeadlineResult::Ready => {
                return SyscallAction::Resume(0);
            }
            SyscallDeadlineResult::Block => { return SyscallAction::Block; }
        }
    }
    // GitHub issue #901, option (c) (maintainer 2026-10-29): with
    // descriptors, the sigmask argument is not applied for the wait --
    // the pipe and terminal waits run under the caller's own mask -- so a
    // non-NULL one is refused rather than ignored, which would let a call
    // that should sleep spin. Applying it is #1225, with #1000's delivery
    // chokepoint.
    if (raw_nfds > 0 && sigmask_address != 0) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    if (raw_nfds >= 0 && raw_nfds < POLL_MAX) {
      let nfds: {0..<POLL_MAX as usize} = raw_nfds;
      let array_bytes: usize = match checked_mul_usize(nfds, sizeof(Pollfd)) {
        CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
        CheckedUsize::Value(v) => { v }
    };
      match user_range_check_write(current_authority, fds_address, array_bytes) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(array_range) => {
            let mut ready_count: usize = 0;
            let mut uart_wait: bool = false;
            // GitHub issue #1042: hackbench's shape, poll(&one_pipe, 1, -1).
            let mut pipe_wait_fd: usize = 0;
            let mut pipe_wait_events: usize = 0;
            let mut pipe_wait: bool = false;
            for index: usize in 0..<nfds {
                let (fd_ok, fd_raw) = user_read_u32(
                    user_write_range_as_read(array_range),
                    index * sizeof(Pollfd) + offsetof(Pollfd, fd));
                let (events_ok, events_raw) = user_read_u32(
                    user_write_range_as_read(array_range),
                    index * sizeof(Pollfd) + offsetof(Pollfd, events));
                if (fd_ok == false || events_ok == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                let fd: usize = fd_raw as usize;
                let (valid, revents) = syscall_poll_fd_ready(fd);
                // Linux reports only the requested events, plus the
                // conditions it always reports (POLLERR, POLLHUP, POLLNVAL).
                let mut final_revents: usize =
                    revents & ((events_raw as usize) | 0x0008 | 0x0010 |
                               POLLNVAL);
                if (valid == false) { final_revents = POLLNVAL; }
                match user_write_u16(
                        array_range,
                        index * sizeof(Pollfd) + offsetof(Pollfd, revents),
                        final_revents) {
                    UserWriteResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    UserWriteResult::Written => {}
                }
                if (final_revents != 0) { ready_count = ready_count + 1; }
                if (nfds == 1 &&
                    kernel_syscall_terminal_is_open(fd) &&
                    (events_raw as usize & POLLIN) != 0) {
                    uart_wait = true;
                }
                if (nfds == 1 && valid && kernel_syscall_pipe_is_open(fd)) {
                    pipe_wait = true;
                    pipe_wait_fd = fd;
                    pipe_wait_events = events_raw as usize;
                }
            }
            // GitHub issue #1153: a timed ppoll is rerun with its Deadline
            // wait still pending -- after expiry, and after a caught signal
            // -- and syscall_deadline_wait clears it only on its own Ready
            // path. A rerun that finds an fd ready clears it here, or the
            // next timed ppoll would take the stale expired deadline as its
            // own and return 0 at once.
            if (ready_count != 0 && timeout_address != 0 &&
                kernel_process_current_pending_block_reason(current_authority) ==
                    ProcessWaitReason::Deadline) {
                kernel_process_current_clear_deadline(current_authority);
            }
            if (ready_count == 0 && pipe_wait && timeout_address == 0 &&
                sigmask_address == 0) {
                return syscall_pipe_poll_wait(current_authority, pipe_wait_fd,
                                              pipe_wait_events);
            }
            if (ready_count == 0 && uart_wait && timeout_address == 0 &&
                sigmask_address == 0) {
                if (syscall_terminal_ppoll_probe() &&
                    syscall_test_evidence_record_ppoll_uart_wait()) {
                    kernel_boot_log("shell ppoll: uart blocked\n");
                }
                syscall_terminal_note_wait();
                // The answer syscall_read_uart gives: block, idling the CPU
                // when nothing else can run here (#583). The Read delivery
                // rewinds this ppoll, so the wake reruns it and it reports
                // the byte. The block path's last look at the ring under the
                // run lock (#547) covers a byte that arrives before it
                // sleeps.
                {
                    let mut process_slot: ProcessSlot = kernel_syscall_process_slot();
                    if (scheduled_process_slot_valid(process_slot)) {
                        let delivery_guard = process_run_lock();
                        scheduled_process_set_uart_block_delivery(
                            delivery_guard, process_slot,
                            UartBlockDelivery::Read);
                        process_run_unlock(delivery_guard);
                        kernel_process_current_set_pending_block(current_authority,
                            ProcessWaitReason::UartRx, 0);
                        // The ash lane's /bin/ppoll-probe types its byte
                        // only after this line, so a kernel that retried
                        // the ppoll in EL1 instead leaves that probe waiting.
                        if (syscall_terminal_ppoll_probe() &&
                            syscall_test_evidence_record_ppoll_uart_block()) {
                            kernel_boot_log(
                                "ppoll: stdin wait blocked beside a runnable process\n");
                        }
                        return SyscallAction::Block;
                    }
                }
                return SyscallAction::WaitInterrupt;
            }
            if (ready_count == 0 && timeout_address != 0) {
                match syscall_deadline_wait(current_authority, timeout_address, false) {
                    SyscallDeadlineResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    SyscallDeadlineResult::Invalid => {
                        return SyscallAction::Resume(LINUX_EINVAL);
                    }
                    SyscallDeadlineResult::Ready => {
                        return SyscallAction::Resume(0);
                    }
                    SyscallDeadlineResult::Block => {
                        // At expiry the tick reruns this ppoll rather than
                        // returning 0: a byte that arrived while it slept is
                        // reported, as Linux reports it (#1153).
                        kernel_process_current_deadline_rerun(current_authority);
                        return SyscallAction::Block;
                    }
                }
            }
            return SyscallAction::Resume(ready_count);
        }
      }
    }
    return SyscallAction::Resume(LINUX_EINVAL);
}

// Termios is shared by aliases of the single local UART, not by fd number.
//
// GitHub issue #826: ioctl runs on the calling core, like any other syscall.
// The terminal's attribute state -- the settings, the receive ring and its
// canonical interpretation -- is guarded by the process-run lock, which any
// core takes, from a syscall or from its own interrupt handler: the UART RX
// handler decodes and stores input under it (terminal_io_receive borrows
// the guard), so moving the UART interrupt off core 0 needs no change here.
// The transmit side (pending output, the echo queue, the TX interrupt
// enable, the input-flow byte) is guarded by the console lock, which every
// CPU's terminal write already takes. The drain query reads the PL011 flag
// register, which is the same MMIO word from every core.
// The attribute change and everything that follows from it, as one section
// of the process-run lock. The guard parameter is the lock binding: the
// settings and the receive ring are shared with the RX handler on whichever
// core takes the UART interrupt, and with readers on every core.
fn syscall_terminal_settings_commit(
        guard: borrow ProcessRunGuard[process_run],
        settings: borrow [u8; TERMINAL_TERMIOS_BYTES..], command: usize)
        -> TerminalSettingsResult !{unsafe} {
    match terminal_settings_apply(settings) {
        TerminalSettingsResult::Unsupported => {
            return TerminalSettingsResult::Unsupported;
        }
        TerminalSettingsResult::Applied => {
            if (command == 0x5404) { kernel_uart_rx_ring_reset(); }
            kernel_uart_rx_canonical_set(terminal_canonical());
            terminal_input_flow_update(kernel_uart_rx_queued());
            if (kernel_uart_rx_pending()) { kernel_process_terminal_settings_wake(guard); }
            if (terminal_output_paused() == false) { kernel_process_uart_tx_wake_all(guard); }
        }
    }
    return TerminalSettingsResult::Applied;
}

fn syscall_terminal_ioctl(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], fd: usize, request: usize, address: usize)
        -> SyscallAction !{unsafe} {
    if (kernel_syscall_terminal_is_open(fd) == false) {
        match unified_fd_next_open(kernel_syscall_process_key(), fd) {
            UnifiedFdScanResult::Done => { return SyscallAction::Resume(LINUX_EBADF); }
            UnifiedFdScanResult::Found(open) => {
                if (open != fd) { return SyscallAction::Resume(LINUX_EBADF); }
                return SyscallAction::Resume(LINUX_ENOTTY);
            }
        }
    }
    let command: usize = request & 0xFFFFFFFF;
    if (command == 0x5413) {
        match user_range_check_write(current_authority, address, 8) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(range) => {
                let mut written = user_zero_fill(range);
                written = user_write_join(written, user_write_u16(range, 0, 24));
                written = user_write_join(written, user_write_u16(range, 2, 80));
                match written {
                    UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                    UserWriteResult::Written => { return SyscallAction::Resume(0); }
                }
            }
        }
    }
    if (command == 0x5401) {
        match user_range_check_write(current_authority, address,
                                    TERMINAL_TERMIOS_BYTES) {
            UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserWriteRangeResult::Ok(range) => {
                let guard = process_run_lock();
                for index: usize in 0..<TERMINAL_TERMIOS_BYTES {
                    match user_write_byte(range, index, terminal_settings_byte(index)) {
                        UserWriteResult::Fault => {
                            process_run_unlock(guard);
                            return SyscallAction::Resume(LINUX_EFAULT);
                        }
                        UserWriteResult::Written => {}
                    }
                }
                workload_settings_wake_ioctl_served(guard, command);
                process_run_unlock(guard);
                return SyscallAction::Resume(0);
            }
        }
    }
    if (command != 0x5402 && command != 0x5403 && command != 0x5404) {
        return SyscallAction::Resume(LINUX_ENOTTY);
    }
    let mut settings: [u8; TERMINAL_TERMIOS_BYTES];
    match user_range_check_read(current_authority, address,
                               TERMINAL_TERMIOS_BYTES) {
        UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserReadRangeResult::Ok(range) => {
            for index: usize in 0..<TERMINAL_TERMIOS_BYTES {
                settings[index] = user_read_byte(range, index);
            }
        }
    }
    match terminal_settings_validate(settings as [u8; TERMINAL_TERMIOS_BYTES..]) {
        TerminalSettingsValidation::Unsupported => { return SyscallAction::Resume(LINUX_EINVAL); }
        TerminalSettingsValidation::Valid => { }
    }
    let guard = process_run_lock();
    if (command != 0x5402) {
        let mut pending: bool = uart_terminal_output_pending() || uart_tx_busy();
        if (pending) {
            process_run_unlock(guard);
            return syscall_terminal_write_wait(current_authority);
        }
    }
    match syscall_terminal_settings_commit(guard, settings as [u8; TERMINAL_TERMIOS_BYTES..], command) {
        TerminalSettingsResult::Unsupported => {
            process_run_unlock(guard);
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        TerminalSettingsResult::Applied => {
            workload_settings_wake_ioctl_served(guard, command);
        }
    }
    process_run_unlock(guard);
    uart_terminal_resume_output();
    kernel_log_terminal_flow_poll();
    interrupt_notify();
    return SyscallAction::Resume(0);
}

// BusyBox's fallback read and its termios-enabled ppoll line editor both
// publish the same readiness checkpoint to the UART integration driver.
private fn syscall_terminal_note_wait() {
    if (syscall_test_evidence_record_read_uart_wait()) {
        if (kernel_syscall_persistent_shell_active()) {
            kernel_boot_log("\npersistent shell: uart blocked\n");
        } else { kernel_boot_log("\ninteractive shell: uart blocked\n"); }
    }
}

private fn syscall_terminal_ppoll_probe() -> bool {
    let mut slot: ProcessSlot = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(slot) == false) { return false; }
    let guard = process_run_lock();
    let command = scheduled_process_command_line(guard, slot);
    let expected = bs"/bin/ppoll-probe\0";
    let mut matches: bool = true;
    for index: usize in 0..<17 {
        if (command[index] != expected[index]) { matches = false; }
    }
    process_run_unlock(guard);
    return matches;
}

fn syscall_read_uart(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], address: usize, requested: usize) -> SyscallIoResult {
    if (requested == 0) { return SyscallIoResult::Transferred(0); }
    match user_range_check_write(current_authority, address, requested) {
        UserWriteRangeResult::Fault => { return SyscallIoResult::Errno(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(range) => {
            // GitHub issue #547: the ring is read under the lock its
            // producer holds, so a reader on any CPU sees a byte only
            // after that byte is stored.
            let guard = process_run_lock();
            kernel_process_terminal_reader(guard);
            if (kernel_uart_rx_pending() == false) {
                process_run_unlock(guard);
                syscall_terminal_note_wait();
                // GitHub issue #448: block whenever ANYTHING else could
                // run, not only when this process has a child. The old
                // question was the right one while a process could have
                // one child and nothing else existed beside it; with an
                // /etc/inittab that starts three entries, an interactive
                // shell waiting at its prompt has no child and two
                // runnable siblings, and answering "no" here left the
                // kernel spinning at EL1 for the whole wait -- which, in a
                // kernel that does not preempt kernel mode, stops every
                // other process too.
                //
                // GitHub issue #583: and with nobody else to run it blocks
                // too now. The block path publishes Blocked and idles the
                // CPU when there is no successor (kernel_process_block_to_
                // idle), which every CPU can do since #592; a reader on a
                // peer whose only relatives run on core 0 has no Ready
                // successor HERE, and an EL1 wait there held a CPU for
                // nothing.
                let mut process_slot: ProcessSlot = kernel_syscall_process_slot();
                if (scheduled_process_slot_valid(process_slot)) {
                    return SyscallIoResult::UartWait;
                }
                return SyscallIoResult::InterruptWait;
            }
            let canonical: bool = terminal_canonical();
            let mut transferred: usize = 0;
            let mut reading: bool = true;
            for index: usize in 0..<KERNEL_UART_RX_CAPACITY {
                if (reading && index < requested && kernel_uart_rx_pending()) {
                    match kernel_uart_rx_read() {
                        UartRxReadResult::EndFile => { reading = false; }
                        UartRxReadResult::Byte(pair) => {
                            let (value, end) = pair;
                            match user_write_byte(range, index, value) {
                                UserWriteResult::Fault => {
                                    process_run_unlock(guard);
                                    return SyscallIoResult::Errno(LINUX_EFAULT);
                                }
                                UserWriteResult::Written => {}
                            }
                            transferred = transferred + 1;
                            if (end || canonical == false) { reading = false; }
                        }
                    }
                }
            }
            terminal_input_flow_update(kernel_uart_rx_queued());
            process_run_unlock(guard);
            // GitHub issue #830: the reader that drained the ring sends the
            // START itself, on whichever core it runs, as a termios change
            // does; no core polls for it.
            kernel_log_terminal_flow_poll();
            return SyscallIoResult::Transferred(transferred);
        }
    }
}

// Issue #196: writes `value` into one fixed 65-byte struct utsname field.
// The field was already zero-filled by the caller (see the uname(2)
// handler below) before any field write, so a value shorter than 65
// bytes leaves real zero padding, not leftover scratch-buffer content
// from a previous uname(2) call.
fn uname_write_field(
        field_view: borrow [u8; UTSNAME_FIELD_SIZE..], value: []const u8) {
    let copied: usize = slice_copy(field_view, value);
}

// Mirrors user_entry.S's .Lsyscall_dispatch branch table exactly (action
// numbers 0/1/2/.../9 there correspond one-to-one to the variants below,
// via syscall_action_encode). Kept as a real sum type internally so a
// mistyped numeric action code -- the shape of bug class this file's
// syscall handling cannot otherwise catch at compile time -- is a type
// error instead of a silent wrong branch at the asm boundary. The asm
// side is untouched by this: kernel_syscall_dispatch below still returns
// a plain (usize, usize) register pair, exactly as before.
must_use variant SyscallAction {
    Unreachable;         // 0: esr wasn't a real SVC; asm's own default path
                          //    already fail-stops before this can be selected
    Resume(usize);        // 1: resume EL0 with x0 = value
    Exit(usize);           // 2: PID 1 exits; the kernel stops (#831)
    CloneChild(usize);      // 3: clone succeeded; value = child pid
    CloneParent(usize);      // 4: child exited; value = parent's saved SP
    Block;                    // 5: block this frame on the scheduler
    WaitInterrupt;             // 6: wfe, then run this syscall again
    // 7 was the parent-only execve, which returned PID 1 to its EL1 caller;
    // PID 1 execs like every process since #831.
    // 8 was ChildExec, whose branch called back into this file's
    // kernel_syscall_child_exec_return and found the argv page in a per-CPU
    // slot. Execve's success never leaves Takibi now (#1080, the first
    // instance of "assembly is a leaf", #1133): see SyscallExecveResult.
    Migrate;                      // 9: rerun this syscall on core 0
}

fn syscall_action_encode(action: SyscallAction) -> (usize, usize) {
    match action {
        SyscallAction::Unreachable => { return (0, 0); }
        SyscallAction::Resume(value) => { return (1, value); }
        SyscallAction::Exit(value) => { return (2, value); }
        SyscallAction::CloneChild(value) => { return (3, value); }
        SyscallAction::CloneParent(value) => { return (4, value); }
        SyscallAction::Block => { return (5, 0); }
        SyscallAction::WaitInterrupt => { return (6, 0); }
        SyscallAction::Migrate => { return (9, 0); }
    }
}

// GitHub issue #887: one log line per exit of a direct child of PID 1 -- pid,
// the image it ran (argv[0] from the command-line cache, at most
// INIT_CHILD_EXIT_IMAGE_BYTES), and how it ended -- so a respawn loop like
// #881's shows in the kernel log as the same image under rising pids. The
// rate is bounded: at most INIT_CHILD_EXIT_LOGS_PER_SECOND lines per second
// of CNTPCT, and each line carries the running count of the ones withheld.
// The window words only bound output, so a race between two exiting CPUs
// costs at most one extra line per CPU, never a lost exit.
const INIT_CHILD_EXIT_IMAGE_BYTES: usize = 32;
const INIT_CHILD_EXIT_LOGS_PER_SECOND: usize = 8;
private let mut init_child_exit_log_window: AtomicWord;
private let mut init_child_exit_log_count: AtomicWord;
private let mut init_child_exit_log_withheld: AtomicWord;

private fn kernel_syscall_note_init_child_exit(status: ProcessEnd) !{unsafe} {
    let mut slot: ProcessSlot = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(slot) == false) { return; }
    let mut image: [u8; INIT_CHILD_EXIT_IMAGE_BYTES];
    let guard = process_run_lock();
    let parent: usize = kernel_process_current_parent_pid(guard);
    let command = scheduled_process_command_line(guard, slot);
    for index: usize in 0..<INIT_CHILD_EXIT_IMAGE_BYTES {
        image[index] = command[index];
    }
    process_run_unlock(guard);
    if (parent != 1) { return; }
    let frequency: usize = read_cntfrq() as usize;
    let mut second: usize = 0;
    if (frequency != 0) { second = (read_cntpct() as usize) / frequency; }
    if (atomic_word_load(&init_child_exit_log_window) != second + 1) {
        atomic_word_store(&init_child_exit_log_window, second + 1);
        atomic_word_store(&init_child_exit_log_count, 0);
    }
    if (atomic_word_fetch_add(&init_child_exit_log_count, 1) >=
            INIT_CHILD_EXIT_LOGS_PER_SECOND) {
        atomic_word_fetch_add(&init_child_exit_log_withheld, 1);
        return;
    }
    kernel_boot_log("exit: init child pid=");
    uart_put_udec(kernel_process_current_pid());
    kernel_boot_log(" image=\"");
    let mut ended: bool = false;
    for index: usize in 0..<INIT_CHILD_EXIT_IMAGE_BYTES {
        let byte: u8 = image[index];
        if (byte == 0) { ended = true; }
        if (ended == false) {
            if (byte < 0x20 || byte > 0x7E || byte == 0x22 || byte == 0x5C) {
                uart_putc(0x3F);
            } else {
                uart_putc(byte);
            }
        }
    }
    kernel_boot_log("\"");
    if (ended == false) { kernel_boot_log("+"); }
    match status {
        ProcessEnd::Signaled(signal) => {
            kernel_boot_log(" signal="); uart_put_udec(signal as usize);
        }
        ProcessEnd::Exited(code) => {
            kernel_boot_log(" code="); uart_put_udec(code as usize);
        }
    }
    kernel_boot_log(" withheld=");
    uart_put_udec(atomic_word_load(&init_child_exit_log_withheld));
    kernel_boot_log("\n");
}

// Preserve clone-owned FD/VM teardown before returning through the parent
// frame. SyscallAction::Exit is the root EL0 process's, PID 1's, whose exit
// stops the kernel (kernel_syscall_init_exit).
fn kernel_syscall_exit_current_process(current_authority: ProcessCurrent[current_process, ProcessState::Running], status: ProcessEnd) -> SyscallAction {
    if (kernel_process_is_child(current_authority)) {
        kernel_syscall_note_init_child_exit(status);
        // GitHub issue #448 made an exit with nowhere to hand the CPU wait
        // for an interrupt and rerun, because core 0 had nowhere else to
        // go. It has since #592: an exit with no successor idles on any
        // CPU (kernel_process_child_exit's tail). The wait went with it,
        // after it livelocked a child exiting on core 0 against a parent
        // polling wait4(WNOHANG) on a peer (#609): the exit waited for the
        // parent to become Ready or Blocked, and the parent was neither.
        match kernel_syscall_clone_files_reap() {
            KernelFdReapResult::Failed => { process_current_end(current_authority); return SyscallAction::Unreachable; }
            KernelFdReapResult::Reaped => { }
        }
        if (kernel_process_exec_image_live_for_pid(
                kernel_process_current_pid()) == false) {
            // GitHub issue #448: the clone being given back is the one made
            // INTO this exiting process's own root, which it now has to
            // name -- there is no longer a single clone in flight for the
            // kernel to have meant implicitly.
            match process_image_clone_vm_reap(kernel_process_current_root(current_authority)) {
                ProcessCloneVmReapResult::Missing => {
                    process_current_end(current_authority); return SyscallAction::Unreachable;
                }
                ProcessCloneVmReapResult::Reaped => { }
            }
        }
        return kernel_syscall_clone_parent_action(
            kernel_process_child_exit(current_authority, status));
    }
    process_current_end(current_authority);
    return SyscallAction::Exit(syscall_status_shell_code(status));
}

// The only asm-facing entry point (user_entry.S calls this exact name via
// `bl kernel_syscall_dispatch`); its signature is untouched so this step
// needs no assembly changes. All real logic lives in the SyscallAction-
// returning kernel_syscall_dispatch_action below.
//
// GitHub issue #221: the functions below are user_entry.S's action-tail
// branches, migrated one at a time (each independently hardware-verified)
// from hand-written EXC_CONTEXT_RESTORE/eret assembly into .tkb, ending in
// the single shared el0_context_resume/kernel_invariant_stop primitives
// (kernel/arch/arm64/kernel/user_entry.S) instead of a per-branch copy of
// that sequence.

// GitHub issue #244: completes a blocked wait4() at the moment it is
// woken (called from kernel_process_child_exit()'s own wake-a-blocked-
// parent step, kernel/kernel/process.tkb) -- the mirror of what
// kernel_process_uart_wake() does for the UART blocker with a single
// el0_context_set_x0, except wait4() also needs its x1 status pointer
// (stashed in the blocking parent's own ProcessRecord, see issue #302)
// honored, which a bare scalar injection cannot express. frame_sp is the
// blocked parent's own saved SP -- writing x0 there, not the current
// frame, is exactly what el0_context_set_x0 is for (it takes an arbitrary
// saved context, not "the currently running one").
//
// GitHub issue #248: takes parent_slot explicitly (the blocked parent's
// own pool_index) rather than depending on an implicit current slot.
// GitHub issue #488 moved the current-process handoff before this call so
// the exiting child is not reaped while still current, but keeping the
// explicit slot preserves the original multi-level wait4 guarantee: each
// delivery names the parent whose saved frame is being completed.
// GitHub issue #302: the status pointer read below used to be exactly the
// shared-global bug #248 fixed for
// reaped_pid/parent_slot -- a second parent blocking in wait4() before the
// first one woke would silently overwrite the first parent's still-pending
// status pointer with its own. scheduled_process_record_wait4_status_ptr
// is keyed by parent_slot the same way reaped_pid/parent_slot already are.
// GitHub issue #652: every value wait4 returns from the syscall itself
// passes the lifecycle trace on its way to syscall_finish_current; the
// blocked case is traced in kernel_syscall_wait4_deliver.
private fn syscall_wait4_resume(frame: MaybeFrame, value: usize,
        current_authority: ProcessCurrent[process, ProcessState::Running],
        status: usize) -> SyscallAction !{unsafe} {
    kernel_process_trace_wait4_return(value, status);
    return syscall_finish_current(frame, SyscallAction::Resume(value),
                                  current_authority);
}

fn kernel_syscall_wait4_deliver(
        parent: borrow ScheduledProcessOwner[process],
        resuming: borrow ProcessCurrent[process, ProcessState::Running],
        frame: borrow FrameRef[process, ExceptionLevel::El0], reaped_pid: usize) !{unsafe} {
    let mut parent_slot: ProcessSlot = scheduled_process_owner_slot(parent);
    let wait4_status_ptr: usize =
        scheduled_process_record_wait4_status_ptr_owned(parent);
    let mut status_word: usize = 0;
    if (wait4_status_ptr != 0) {
        // The status buffer belongs to the parent being resumed.
        // user_write_u32 dereferences the user VA directly. The waking exit
        // handoff commits this parent's prepared root before reaching here,
        // and the range is checked under the parent's Running authority that
        // handoff mints (GitHub issue #202).
        match user_range_check_write(resuming, wait4_status_ptr, 4) {
            UserWriteRangeResult::Fault => {
                kernel_process_trace_wait4_deliver(parent, LINUX_EFAULT, 0);
                el0_context_set_x0(frame, LINUX_EFAULT);
                return;
            }
            UserWriteRangeResult::Ok(range) => {
                let status: ProcessEnd =
                    kernel_process_child_exit_status_for(parent_slot,
                                                         reaped_pid);
                status_word = syscall_wait_status_word(status) as usize;
                match user_write_u32(range, 0,
                        syscall_wait_status_word(status)) {
                    UserWriteResult::Fault => {
                        kernel_process_trace_wait4_deliver(parent, LINUX_EFAULT, 0);
                        el0_context_set_x0(frame, LINUX_EFAULT);
                        return;
                    }
                    UserWriteResult::Written => {}
                }
            }
        }
    }
    // The exiting child is still the physical SP_EL1 stack here even though
    // logical current already names this parent. The generated return hook
    // consumes the deferred reap after `mov sp` has reached the parent frame.
    kernel_process_trace_wait4_deliver(parent, reaped_pid, status_word);
    el0_context_set_x0(frame, reaped_pid);
}

// Linux syslog(2), consumed by BusyBox dmesg through musl's klogctl(). The
// current concrete applet uses action 10 to size its allocation and action 3
// to read a non-destructive snapshot. Console-level control and destructive
// reads remain EINVAL until a real caller needs them.
private fn syscall_syslog(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], action: usize, address: usize, requested: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallAction = syscall_syslog_with(slot, current_authority, action, address, requested);
    syscall_slot_release(slot);
    return result;
}

private fn syscall_syslog_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], action: usize, address: usize, requested: usize)
        -> SyscallAction !{unsafe} {
    if (action == LINUX_SYSLOG_ACTION_SIZE_BUFFER) {
        return SyscallAction::Resume(kernel_log_snapshot_capacity());
    }
    if (action != LINUX_SYSLOG_ACTION_READ_ALL || requested == 0) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let available: usize = kernel_log_snapshot_build();
    let mut amount: usize = requested;
    if (amount > available) { amount = available; }
    if (amount == 0) { return SyscallAction::Resume(0); }
    // GitHub issue #975: each chunk copied out is the prefix that
    // kernel_log_snapshot_copy initialized (staged == chunk); no zero fill.
    let mut copied: usize = 0;
    while (copied < amount) {
        let chunk: usize = min(amount - copied, KERNEL_BLOCK_SIZE);
        let staging_buffer = syscall_scratch[slot.index].file_buffer as []u8;
        if (chunk > staging_buffer.len) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk];
        let staged: usize = kernel_log_snapshot_copy(copied, staging);
        if (staged != chunk) { return SyscallAction::Resume(LINUX_EINVAL); }
        let target: usize = match checked_add_usize(address, copied) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            CheckedUsize::Value(value) => { value }
        };
        match user_range_check_write(current_authority, target, chunk) {
            UserWriteRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserWriteRangeResult::Ok(range) => {
                match copy_to_user_span(
                        range,
                        syscall_scratch[slot.index].file_buffer as []u8,
                        0, chunk) {
                    UserWriteResult::Fault => {
                        if (copied != 0) { return SyscallAction::Resume(copied); }
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    UserWriteResult::Written => {}
                }
            }
        }
        copied = copied + chunk;
    }
    // GitHub issue #612: the peer_syslog view's line, once, from the first
    // complete read on a peer. The snapshot it copied is whole records only,
    // with any overwritten while it read counted on a line of its own.
    // core-role: peer_syslog view evidence: reported once from a read on any
    // peer
    if (cpu_id() != 0 && syscall_syslog_peer_reported == false) {
        syscall_syslog_peer_reported = true;
        kernel_boot_log(
            "workload: syslog read the retained log on a peer, every record whole or counted lost\n");
    }
    return SyscallAction::Resume(copied);
}

private let mut syscall_syslog_peer_reported: bool = false;

must_use variant KernelUartDeliveryResult { Consumed; RetryRead; }

// A blocked Linux read(0, buf, ...), or a ppoll on fd 0, must retry its SVC
// after the IRQ places the byte in the kernel UART ring; only the Takibi
// scalar wait consumes the
// byte directly into x0. Keeping the IRQ path away from user memory also
// preserves its no-unsafe effect contract.
fn kernel_syscall_uart_deliver(
        guard: borrow ProcessRunGuard[lock],
        waiter: borrow ScheduledProcessOwner[process],
        frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize)
        -> KernelUartDeliveryResult !{interrupt} {
    let mut process_slot: ProcessSlot = scheduled_process_owner_slot(waiter);
    if (scheduled_process_slot_valid(process_slot)) {
        match scheduled_process_uart_block_delivery(guard, process_slot) {
            UartBlockDelivery::Scalar => {
                el0_context_set_x0(frame, value);
                return KernelUartDeliveryResult::Consumed;
            }
            UartBlockDelivery::Read => {
                scheduled_process_set_uart_block_delivery(
                    guard, process_slot, UartBlockDelivery::Scalar);
                return KernelUartDeliveryResult::RetryRead;
            }
        }
    }
    el0_context_set_x0(frame, LINUX_EFAULT);
    return KernelUartDeliveryResult::Consumed;
}

fn kernel_syscall_uart_block_prepare(frame: borrow FrameRef[process, ExceptionLevel::El0]) {
    let mut process_slot: ProcessSlot = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(process_slot)) {
        let guard = process_run_lock();
        let delivery: UartBlockDelivery =
            scheduled_process_uart_block_delivery(guard, process_slot);
        process_run_unlock(guard);
        match delivery {
            UartBlockDelivery::Scalar => {}
            UartBlockDelivery::Read => {
                el0_context_retry_syscall(frame);
            }
        }
    }
}

// Step 2/8: action 5 (.Lsyscall_block). Entered via a plain tail branch, not
// `bl` -- there is no caller to return to, every path ends in a noreturn call.
// GitHub issue #244: this single action-5 trampoline is now shared by two
// different blockers (the takibi UART-wait syscall and wait4()) rather
// than adding a 9th hand-written assembly action branch for the second
// one -- whichever syscall handler decided to return SyscallAction::Block
// records which reason first.
fn kernel_syscall_block_return(frame_sp: usize) {
    let ProcessRunningHere::Running(current_authority) = process_running_here() else {};
    let frame =
        frame_ref_from_el0_entry(frame_sp, kernel_process_entry_generation());
    let mut switch: BlockSwitch = BlockSwitch::Retry;
    let mut rewound: bool = false;
    let reason: ProcessWaitReason = kernel_process_current_pending_block_reason(current_authority);
    if (reason ==
            ProcessWaitReason::ChildExit) {
        switch = kernel_process_block_wait4(current_authority, frame);
    } else if (reason ==
                   ProcessWaitReason::NetRx) {
        process_current_end(current_authority);
        // GitHub issue #469: the woken process runs this same syscall
        // again rather than resuming after it with an answer. accept(2)
        // has no value to be handed on a wake -- what it wants is another
        // look, which is exactly what an ash `read` already gets this way.
        el0_context_retry_syscall(frame);
        // Nothing else to run after all -- the decision to block was
        // taken a few instructions earlier and an interrupt can have
        // changed the answer in between. The Retry arm below then resumes
        // the frame: this rewind already points it back at the syscall, so
        // the process re-enters accept and takes another bounded step.
        rewound = true;
        switch = kernel_process_block_net(frame);
    } else if (reason ==
                   ProcessWaitReason::Pipe) {
        process_current_end(current_authority);
        // GitHub issue #1042: as accept and a blocked write, the woken
        // reader or writer runs this same call again. The look that decides
        // whether it sleeps is the Blocked publication's
        // (kernel_process_block_would_miss), under the lock the waker's
        // wake takes too.
        el0_context_retry_syscall(frame);
        rewound = true;
        switch = kernel_process_block_pipe(frame);
    } else if (reason ==
                   ProcessWaitReason::UartTx) {
        process_current_end(current_authority);
        // GitHub issue #544: as with accept above, the woken writer runs
        // this same write again rather than resuming after it -- what it
        // wants is room in the transmit queue, and another look finds it.
        el0_context_retry_syscall(frame);
        // The window #546 closed for reads, on the transmit side. Between
        // the write's look at the queue and this sleep, the TX interrupt can
        // drain the queue past the mark and find no Blocked writer to wake.
        // Once the queue is empty it also disables itself, and the writer
        // would then sleep until some other output happened to start it
        // again. With interrupts masked from here, either the room is there
        // now and the rewound write runs again, or the interrupt that makes
        // the room arrives after this process is Blocked.
        disable_irq();
        if (kernel_log_tx_writer_room()) {
            workload_profile_el0_enter();
            el0_context_resume(frame);
        }
        rewound = true;
        switch = kernel_process_block_uart_tx(frame);
    } else if (reason ==
                   ProcessWaitReason::Deadline) {
        process_current_end(current_authority);
        switch = kernel_process_block_deadline(frame);
    } else if (reason ==
                   ProcessWaitReason::Signal) {
        process_current_end(current_authority);
        // GitHub issue #627: rt_sigsuspend reruns after its wake and
        // delivers the signal the wake left pending.
        if (kernel_process_current_signal_suspending()) {
            el0_context_retry_syscall(frame);
            rewound = true;
        }
        switch = kernel_process_block_signal(frame);
    } else {
        process_current_end(current_authority);
        // GitHub issue #546: look at the ring once more, with interrupts
        // masked, before sleeping on it. A terminal read found the ring
        // empty and unmasked interrupts before choosing to block, so a byte
        // that arrived since then found no Blocked reader to hand itself
        // to, went into the ring, and raised nothing further: the reader
        // slept beside the byte it was waiting for until another one came.
        // Masked from here, a byte either is in the ring now -- and the
        // syscall runs again and takes it -- or raises its interrupt after
        // this process is Blocked, where the wake finds it. The run lock
        // kernel_process_block_uart takes restores this masked state rather
        // than unmasking, and the next context's eret sets its own.
        //
        // This look is now the cheap early exit, not the proof. The mask is
        // local, and the RX interrupt is routed to CPU0. The look that
        // decides is in kernel_process_block_reserved, under the lock the
        // interrupt's push holds too, so it holds for a reader on any CPU
        // (GitHub issue #547).
        disable_irq();
        if (kernel_uart_rx_pending()) {
            el0_context_retry_syscall(frame);
            workload_profile_el0_enter();
            el0_context_resume(frame);
        }
        kernel_syscall_uart_block_prepare(frame);
        switch = kernel_process_block_uart(frame);
    }
    match switch {
        // GitHub issue #583: published Blocked with no successor; leave its
        // stack for this CPU's idle context.
        BlockSwitch::ToIdle => {
            kernel_idle_block_enter();
        }
        BlockSwitch::Retry => {
            // Another CPU may reserve the last Ready successor after dispatch
            // chose Block but before kernel_process_block_current takes the run
            // lock. The current process is still Running in that case. Retry its
            // syscall instead of treating an ordinary multicore race as fatal.
            // A terminal read was already rewound by uart_block_prepare above;
            // every other blocker still needs the rewind here.
            let mut retry_slot: ProcessSlot = kernel_syscall_process_slot();
            let retry_guard = process_run_lock();
            let retry_delivery: UartBlockDelivery =
                scheduled_process_uart_block_delivery(retry_guard, retry_slot);
            if (reason == ProcessWaitReason::ChildExit) {
                kernel_process_current_set_pending_block_locked(
                    retry_guard, ProcessWaitReason::None, 0);
            }
            process_run_unlock(retry_guard);
            let uart_read_prepared: bool =
                reason ==
                    ProcessWaitReason::UartRx &&
                retry_delivery == UartBlockDelivery::Read;
            // Rewound above: rt_sigsuspend, accept, a blocked write and a
            // pipe wait.
            if (uart_read_prepared == false && rewound == false) {
                el0_context_retry_syscall(frame);
            }
            // GitHub issue #603: wait4 recorded ChildExit on this Running
            // process when it chose to block. It did not block, so that is no
            // continuation any more. Left set, the rerun wait4 can reap its
            // child, and when a later tick leaves this process Ready,
            // scheduled_process_ready_take finds no pending child and refuses
            // it on every CPU for good.
            workload_profile_el0_enter();
            el0_context_resume(frame);
        }
        BlockSwitch::Switch(next) => {
            workload_profile_el0_enter();
            el0_context_resume(next);
        }
    }
}

// Step 3/8: action 1 (.Lsyscall_resume). The most common path -- every
// ordinary syscall return reaches this -- and also shared directly by
// .Lsyscall_clone_child's own tail (still raw asm at this step), which
// branches to the .Lsyscall_resume label with x7=0 after installing the new
// child frame, so the child's syscall-return-scheduling check is not
// skipped just because it arrived via clone rather than an ordinary return.
fn kernel_syscall_resume_return(frame_sp: usize, value: usize) {
    let frame =
        frame_ref_from_el0_entry(frame_sp, kernel_process_entry_generation());
    el0_context_set_x0(frame, value);
    kernel_stack_guard_check(frame_sp);  // issue #375
    match kernel_process_syscall_return_schedule(frame) {
        FrameSwitch::Stay => {
            // GitHub issue #592: no successor, and core 0 may not keep this
            // one.
            if (kernel_process_core0_leave_excluded(frame)) {
                kernel_idle_yield_enter();
            }
            workload_profile_el0_enter();
            el0_context_resume(frame);
        }
        FrameSwitch::Switch(next) => {
            workload_profile_el0_enter();
            el0_context_resume(next);
        }
    }
}

// Step 4/8: action 3 (.Lsyscall_clone_child). Replaces the hand-written
// EXC_CONTEXT_SIZE-word copy loop with slice_copy over two raw byte views of
// the same two addresses, and folds two redundant
// kernel_process_clone_child_stack_top() calls (the original asm called it
// once for the copy destination and again, unnecessarily, right before
// install) into one. Ends by sharing kernel_syscall_resume_return -- clone's
// return to the child is "resume with x0=0", exactly like an ordinary
// syscall return, and must not skip the same reschedule check.
fn kernel_syscall_clone_child_return(parent_frame_sp: usize, child_pid: usize)
        !{unsafe} {
    let parent_frame = frame_ref_from_el0_entry(
        parent_frame_sp, kernel_process_entry_generation());
    // The suspended parent observes clone() == child PID whenever it is
    // first selected; the copied child frame's own X0 is overwritten to 0
    // below via kernel_syscall_resume_return.
    el0_context_set_x0(parent_frame, child_pid);
    let child_stack_top: usize = kernel_process_clone_child_stack_top();
    if (child_stack_top == 0) {
        kernel_invariant_stop_with_frame(parent_frame);
    }
    // The exception entry assembly supplies `parent_frame`; the process
    // stack allocator supplies where the child's frame goes. The copy is
    // between two ABI-owned exception-frame bounds, not ordinary slice
    // provenance, and frame_copy is where that is said.
    let child_frame = frame_ref_fresh(
        child_stack_top - EXC_CONTEXT_SIZE, kernel_process_entry_generation());
    frame_copy(child_frame, parent_frame);
    let ProcessConstructingHere::Constructing(child_authority) = process_constructing_here() else {};
    match kernel_process_clone_context_install(child_authority, parent_frame, child_frame) {
        CloneInstall::Failed(retained) => { process_current_end(retained); kernel_invariant_stop_with_frame(parent_frame); }
        CloneInstall::Installed(current_authority) => {
            match kernel_process_activate_current_root(current_authority) {
                CurrentRootActivationResult::Invalid => {
                    process_current_end(current_authority);
                    kernel_invariant_stop_with_frame(parent_frame);
                }
                CurrentRootActivationResult::Activated => {}
            }
            process_current_end(current_authority);
            kernel_syscall_resume_return(frame_ref_address(child_frame), 0);
        }
    }
}

// Step 5/8: once action 8 (.Lsyscall_child_exec). This is the exact bug
// fixed in commit 8db27e3: the replacement entry/stack must be published through the
// saved frame's own fields, not via a direct msr, since el0_context_resume
// (like the EXC_CONTEXT_RESTORE it replaces) always reloads elr_el1/sp_el0
// from this same frame. Writing through el0_context_set_elr_el1/
// el0_context_set_sp_el0 and then calling el0_context_resume makes that
// class of bug structurally impossible now: there is no second code path
// left that could reload and silently discard these two field writes.
//
// GitHub issue #1080: called from the dispatcher with the frame the syscall
// entered on and the argv page execve allocated. It used to be user_entry.S's
// action 8, which found the page again in a per-CPU slot. Every path ends in
// el0_context_resume or a fail-stop.
fn kernel_syscall_child_exec_return(frame: FrameRef[process, ExceptionLevel::El0],
        args_page: sink PageOwner[page]) !{unsafe} {
    let ProcessRunningHere::Running(current_authority) = process_running_here() else {};
    kernel_process_exec_failure_clear();
    let result: KernelChildExecPrepareResult =
        kernel_process_child_exec_prepare(current_authority, args_page);
    // GitHub issue #597: the prepare was the last ext2 read of this execve.
    if (syscall_ext2_reader_take()) {
        ext2_read_leave();
    }
    // GitHub issue #1058 classified these arms; #1079 (maintainer decision
    // 2026-10-25, option c) retired the reachable ones. The point of no
    // return is the old image's teardown inside the prepare.
    // - Before it: ReserveOutOfMemory. The prepare resolves the image and
    //   reserves every page its map can allocate (page_reserve) first, so
    //   memory exhaustion is execve's ENOMEM and the old image runs on.
    // - After it, reachable from EL0: StaticImageInvalid and
    //   DynamicPairInvalid on an ext2 or block read error (a device's
    //   answer), and StaticMapOutOfMemory, ImageRecordOutOfMemory and the
    //   out-of-memory half of DynamicPairInvalid only if the reservation's
    //   bound undercounted (counted in kernel_exec_reserve_undercount).
    //   These end the process by SIGSEGV, as Linux's bprm_execve does past
    //   its point of no return; the kernel runs on.
    // - Retired by #1080: NotChildOrPending and ArgvPageMissing. Execve's
    //   ChildExec carries the argv page here, so a prepare with none cannot
    //   be written.
    // - Unreachable by construction, still stops: NoImageResolved (boot
    //   mounts ext2 and resolves the fallback image
    //   before EL0 runs), CloneVmMissing (a process has an installed image
    //   or an outstanding fork clone), ImageAlreadyInstalled and
    //   ImageNoTargetRoot (the teardown just cleared the image, and the map
    //   already checked the root), DynamicResolveInvalid (execve validated
    //   the same inode with the same validator, and its ext2 reader
    //   registration, held from dispatch to here, keeps writers out).
    match result {
        KernelChildExecPrepareResult::Prepared(prepared) => {
            kernel_syscall_child_exec_enter(frame, current_authority, prepared);
        }
        KernelChildExecPrepareResult::ReserveOutOfMemory => {
            kernel_syscall_child_exec_refused(frame, current_authority);
        }
        KernelChildExecPrepareResult::StaticImageInvalid => {
            kernel_syscall_child_exec_lost(frame, current_authority);
        }
        KernelChildExecPrepareResult::DynamicPairInvalid => {
            kernel_syscall_child_exec_lost(frame, current_authority);
        }
        KernelChildExecPrepareResult::StaticMapOutOfMemory => {
            kernel_syscall_child_exec_lost(frame, current_authority);
        }
        KernelChildExecPrepareResult::ImageRecordOutOfMemory => {
            kernel_syscall_child_exec_lost(frame, current_authority);
        }
        KernelChildExecPrepareResult::CloneVmMissing => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::CloneVmMissing);
            process_current_end(current_authority);
            kernel_invariant_stop_with_frame(frame);
        }
        KernelChildExecPrepareResult::DynamicResolveInvalid => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::DynamicResolveInvalid);
            process_current_end(current_authority);
            kernel_invariant_stop_with_frame(frame);
        }
        KernelChildExecPrepareResult::ImageAlreadyInstalled => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::ImageAlreadyInstalled);
            process_current_end(current_authority);
            kernel_invariant_stop_with_frame(frame);
        }
        // GitHub issue #516: an exec that reached the install with no target
        // root chosen. Fail-stops beside its neighbours rather than being
        // installed into root 0, which is what the old fallback did.
        KernelChildExecPrepareResult::ImageNoTargetRoot => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::ImageNoTargetRoot);
            process_current_end(current_authority);
            kernel_invariant_stop_with_frame(frame);
        }
        KernelChildExecPrepareResult::NoImageResolved => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::NoImageResolved);
            process_current_end(current_authority);
            kernel_invariant_stop_with_frame(frame);
        }
    }
}

// The new image is installed: the tail of a successful exec.
private fn kernel_syscall_child_exec_enter(frame: sink FrameRef[process, ExceptionLevel::El0],
        current_authority: ProcessCurrent[current_process, ProcessState::Running],
        user_entry: ExecUserEntry) !{unsafe} {
    // The new image is committed, so this is execve's point of no return,
    // and Linux closes every descriptor marked close-on-exec here. Only the
    // kernel-driven exec that 73988b03 retired ever made this call, so from
    // then on a descriptor set with F_SETFD or F_DUPFD_CLOEXEC survived
    // execve. GitHub issue #540's unused-function check found the orphaned
    // helper.
    unified_fd_close_exec_descriptors(kernel_syscall_process_key());
    // Default-false debugger test switch: stop after the real prepare+commit
    // path without affecting ordinary exec or adding a userspace interface.
    if (kernel_process_trace_fail_after_exec_requested()) {
        kernel_process_exec_failure_debugger_after_commit();
        process_current_end(current_authority);
        kernel_invariant_stop_with_frame(frame);
    }
    let entry: usize = user_entry.entry;
    let stack: usize = user_entry.stack;
    el0_context_set_sp_el0(frame, stack);
    el0_context_set_elr_el1(frame, entry);
    // exec starts a new runtime image. Do not expose the previous image's
    // TLS base until that runtime installs its own TPIDR_EL0.
    el0_context_set_tpidr_el0(frame, 0);
    el0_context_set_x0(frame, 0);
    workload_profile_el0_enter();
    process_current_end(current_authority);
    el0_context_resume(frame);
}

// GitHub issue #1079: the new image's pages could not be reserved, so the
// prepare stopped before the teardown and the caller's image is intact.
// execve returns ENOMEM to it, as for the argv page (#700).
private fn kernel_syscall_child_exec_refused(frame: sink FrameRef[process, ExceptionLevel::El0],
        current_authority: ProcessCurrent[current_process, ProcessState::Running]) !{unsafe} {
    kernel_syscall_exec_clear();
    atomic_word_fetch_add(&kernel_syscall_exec_refused_count, 1);
    el0_context_set_x0(frame, LINUX_ENOMEM);
    workload_profile_el0_enter();
    process_current_end(current_authority);
    el0_context_resume(frame);
}

// GitHub issue #1079: an exec that failed past its point of no return (an
// image read error, or a map past an undercounted reservation). The caller
// has no image left to return to; Linux's bprm_execve forces SIGSEGV here,
// and so does this: the process ends, its parent reaps a SIGSEGV status,
// and the kernel runs on. PID 1 ending stops the kernel as any PID 1 exit
// does (#831).
private fn kernel_syscall_child_exec_lost(frame: borrow FrameRef[process, ExceptionLevel::El0],
        current_authority: ProcessCurrent[current_process, ProcessState::Running]) !{unsafe} {
    kernel_syscall_exec_clear();
    atomic_word_fetch_add(&kernel_syscall_exec_lost_count, 1);
    kernel_process_child_exec_lost(current_authority);
    // The same exit tail a refused sigreturn takes: it does not return.
    signal_return_exit(current_authority, frame,
                       process_end_signaled(LINUX_SIGSEGV));
}

// Evidence for the #1079 paths: execs refused with ENOMEM before the
// teardown, and execs that ended their process after it.
private let mut kernel_syscall_exec_refused_count: AtomicWord;
private let mut kernel_syscall_exec_lost_count: AtomicWord;

fn kernel_syscall_exec_reserve_evidence() -> (usize, usize) {
    return (atomic_word_load(&kernel_syscall_exec_refused_count),
            atomic_word_load(&kernel_syscall_exec_lost_count));
}

// GitHub issue #831 (maintainer decision 2026-10-20, item 2-1 A): PID 1
// exited. It used to return to the boot driver through run_initial_user's
// frame, which then reported this line and shut down; PID 1 now starts from
// a saved frame on its own kernel stack and has no caller to return to. Its
// exit stops the kernel, as Linux's "Attempted to kill init" does, with the
// line and the shutdown the boot driver gave it.
fn kernel_syscall_init_exit(status: usize) !{unsafe} {
    kernel_boot_log("init: PID 1 exited unexpectedly status=");
    uart_put_udec(status);
    kernel_boot_log("\n");
    uart_tx_flush();
    platform_shutdown();
    while (true) { }
}

// The one place an ExitSwitch becomes the assembly's parent_sp: the frame to
// resume, or 0 when no successor was admitted and this CPU idles.
fn kernel_syscall_clone_parent_action(switch: sink ExitSwitch)
        -> SyscallAction {
    match switch {
        ExitSwitch::Idle => { return SyscallAction::CloneParent(0); }
        ExitSwitch::Resume(frame) => {
            return SyscallAction::CloneParent(frame_ref_address(frame));
        }
    }
}

// Step 6/8: action 4 (.Lsyscall_clone_parent). This is the exact bug fixed
// in commit 8db27e3: parent_sp used to be kept in the caller-saved x7 across
// `bl kernel_process_child_exec_reap`, safe only as long as nothing that
// call reached ever clobbered it -- true for every boot-time clone/exit
// cycle until a child exec image was actually live. As an ordinary .tkb
// local, parent_sp's liveness across this call is the compiler's own
// calling-convention problem now, the same way it already is for every
// other .tkb function call in this file; there is no register to pick by
// hand and therefore no way to pick the wrong one.
//
// `parent_sp` is the assembly's encoding of an ExitSwitch: the successor's
// frame, or 0 for "nothing admitted, idle" (see
// kernel_syscall_clone_parent_action, the one place that encodes it).
fn kernel_syscall_clone_parent_return(parent_sp: usize) {
    kernel_process_child_exec_reap();
    if (parent_sp == 0) {
        kernel_idle_exit_enter();
    }
    workload_profile_el0_enter();
    // GitHub issue #992: the frame ExitSwitch named, of whichever level.
    frame_any_resume(frame_leveled_any(
        frame_ref_from_entry(parent_sp, kernel_process_entry_generation())));
}

// GitHub issue #9: peer-safety. Since #583 a syscall runs where it is
// called unless syscall_peer_refused names it or syscall_peer_safe narrows
// it by descriptor; the migration gate reruns those on core 0. read and
// write are split by descriptor in the order their handlers use. Of the
// ext2 mutations, only a file write stays core 0's (by descriptor, below);
// the directory mutations run anywhere since #597.
// GitHub issue #533: the five ext2 MUTATIONS, each under the filesystem
// lock for exactly as long as its own linear tokens live.
//
// One helper per mutating syscall rather than a lock taken in the arms
// themselves, because each arm has a dozen early returns and the guard is
// linear: a `return` past it is a compile error, so the helper is what makes
// "exactly one release on every path" checkable instead of reviewed. Each
// answers an errno (0 on success) and leaves SyscallAction to its caller.
// What each does to the filesystem under the guard is
// kernel/fs/ext2/ext2_syscall.tkb's, which linux_user/ext2_host runs too
// (GitHub issue #1035).
//
// A lookup that decides whether a mutation may proceed belongs INSIDE the
// same guard as the mutation it gates -- mkdir's existence check is the
// example: outside it, another core could create the name in between.
// GitHub issue #602: the file position is read, bounded and advanced under
// the same guard as the write it positions. Two processes sharing one open
// file (a forked descriptor) on two CPUs would otherwise both write at the
// position they read and both advance it by their own length, which lost
// one write -- harmless while every file write ran on core 0, whose
// dispatch is not preemptible. A reader's position update is not under
// this guard; see kernel/CONCURRENCY.md.
private fn syscall_ext2_write_locked(fd: usize, content: []u8) -> usize {
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return LINUX_EBADF; }
        SyscallFilesystemReady::Configured(found) => { found }
    };

    let guard = ext2_mutation_take();
    let offset: usize = kernel_syscall_file_offset(fd);
    let length: usize = content.len;
    let inode: usize = kernel_syscall_file_inode(fd);
    let mut answer: usize =
        ext2_syscall_write_at(mount, guard, inode, offset, content);
    if (answer == 0 &&
        kernel_syscall_file_set_offset(fd, offset + length) == false) {
        answer = LINUX_EBADF;
    }
    ext2_mutation_give(guard);
    if (answer == LINUX_ENOSPC) {
        kernel_boot_log_resource_exhausted("ext2 blocks" as *u8,
                                          ext2_block_capacity(mount));
    }
    return answer;
}

// GitHub issue #597: mkdirat's whole arm, lookup included, under the
// mutation guard its caller holds. With mutation admitted on a peer, the
// parent a lookup finds could otherwise be renamed or removed by another
// core before the mutation it gates -- the atomicity core 0's
// non-preemptible dispatch used to give for free.
private fn syscall_mkdirat_under(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, permissions: usize) -> usize !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: usize = syscall_mkdirat_under_with(slot, current_authority, guard, x0, x1, permissions);
    syscall_slot_release(slot);
    return result;
}

private fn syscall_mkdirat_under_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, permissions: usize) -> usize !{unsafe} {
    // mkdirat(dirfd, pathname, mode), GitHub issue #538. `permissions` is
    // the mode with the umask applied (GitHub issue #1147); every process
    // is root, so nothing else in this kernel reads it.
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return LINUX_EBADF; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, x1) {
        SyscallPathResult::Fault => { return LINUX_EFAULT; }
        SyscallPathResult::Invalid => { return LINUX_ENOENT; }
        SyscallPathResult::Name(path) => { path }
    };
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    let absolute: bool = path_view[0] == 0x2F;
    let parent: SyscallParent = match kernel_syscall_parent_of(mount,
            x0, absolute, path_name) {
        SyscallParentResult::Errno(errno) => {
            return errno;
        }
        SyscallParentResult::Found(found) => { found }
    };
    let leaf: []u8 = kernel_syscall_leaf(path_name, parent);
    if (leaf.len == 0) { return LINUX_ENOENT; }
    if (kernel_syscall_leaf_is_dot(leaf) ||
        kernel_syscall_leaf_is_dot_dot(leaf)) {
        return LINUX_EEXIST;
    }
    return
        ext2_syscall_mkdir(mount, guard, parent.inode, leaf, permissions);
}

// GitHub issue #597: unlinkat's whole arm, lookup included, under the
// mutation guard its caller holds. With mutation admitted on a peer, the
// parent a lookup finds could otherwise be renamed or removed by another
// core before the mutation it gates -- the atomicity core 0's
// non-preemptible dispatch used to give for free.
private fn syscall_unlinkat_under(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, x2: usize) -> usize !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: usize = syscall_unlinkat_under_with(slot, current_authority, guard, x0, x1, x2);
    syscall_slot_release(slot);
    return result;
}

private fn syscall_unlinkat_under_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, x2: usize) -> usize !{unsafe} {
    // unlinkat(dirfd, pathname, flags), GitHub issue #538: unlink with no
    // flag, rmdir with AT_REMOVEDIR, and EINVAL for any other flag.
    if (x2 != 0 && x2 != LINUX_AT_REMOVEDIR) {
        return LINUX_EINVAL;
    }
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return LINUX_EBADF; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, x1) {
        SyscallPathResult::Fault => { return LINUX_EFAULT; }
        SyscallPathResult::Invalid => { return LINUX_ENOENT; }
        SyscallPathResult::Name(path) => { path }
    };
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    let absolute: bool = path_view[0] == 0x2F;
    let parent: SyscallParent = match kernel_syscall_parent_of(mount,
            x0, absolute, path_name) {
        SyscallParentResult::Errno(errno) => {
            return errno;
        }
        SyscallParentResult::Found(found) => { found }
    };
    let leaf: []u8 = kernel_syscall_leaf(path_name, parent);
    if (leaf.len == 0) { return LINUX_ENOENT; }
    if (x2 == 0) {
        return
            ext2_syscall_unlink(mount, guard, parent.inode, leaf);
    }
    // Linux's own answers: rmdir(".") is EINVAL, rmdir("..") ENOTEMPTY.
    if (kernel_syscall_leaf_is_dot(leaf)) {
        return LINUX_EINVAL;
    }
    if (kernel_syscall_leaf_is_dot_dot(leaf)) {
        return LINUX_ENOTEMPTY;
    }
    return
        ext2_syscall_rmdir(mount, guard, parent.inode, leaf);
}

// GitHub issue #597: renameat's whole arm, lookup included, under the
// mutation guard its caller holds. With mutation admitted on a peer, the
// parent a lookup finds could otherwise be renamed or removed by another
// core before the mutation it gates -- the atomicity core 0's
// non-preemptible dispatch used to give for free.
private fn syscall_renameat_under(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, x2: usize, x3: usize) -> usize !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: usize = syscall_renameat_under_with(slot, current_authority, guard, x0, x1, x2, x3);
    syscall_slot_release(slot);
    return result;
}

private fn syscall_renameat_under_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, x2: usize, x3: usize) -> usize !{unsafe} {
    // renameat(olddirfd, oldpath, newdirfd, newpath), GitHub issue #538.
    // Both paths are read through the one per-core path buffer, so the
    // old path's directory is resolved and its last component copied out
    // before the new path is read over it.
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return LINUX_EBADF; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let old_path: []u8 = match kernel_syscall_path_name(slot, current_authority, x1) {
        SyscallPathResult::Fault => { return LINUX_EFAULT; }
        SyscallPathResult::Invalid => { return LINUX_ENOENT; }
        SyscallPathResult::Name(path) => { path }
    };
    let old_view: [u8; 256..] = syscall_path_view_here(slot);
    let old_absolute: bool = old_view[0] == 0x2F;
    let old_parent: SyscallParent = match kernel_syscall_parent_of(mount,
            x0, old_absolute, old_path) {
        SyscallParentResult::Errno(errno) => {
            return errno;
        }
        SyscallParentResult::Found(found) => { found }
    };
    let old_leaf: []u8 = kernel_syscall_leaf(old_path, old_parent);
    if (old_leaf.len == 0) { return LINUX_ENOENT; }
    // Linux's answer for renaming `.` or `..`.
    if (kernel_syscall_leaf_is_dot(old_leaf) ||
        kernel_syscall_leaf_is_dot_dot(old_leaf)) {
        return LINUX_EBUSY;
    }
    let mut old_name_storage: [u8; 256];
    let old_name_view: []u8 = old_name_storage as []u8;
    let old_length: usize = old_leaf.len;
    if (old_length > old_name_view.len) {
        return LINUX_EINVAL;
    }
    let old_name: []u8 = old_name_view[0..<old_length];
    slice_copy(old_name, old_leaf);
    let old_directory: usize = old_parent.inode;

    let new_path: []u8 = match kernel_syscall_path_name(slot, current_authority, x3) {
        SyscallPathResult::Fault => { return LINUX_EFAULT; }
        SyscallPathResult::Invalid => { return LINUX_ENOENT; }
        SyscallPathResult::Name(path) => { path }
    };
    let new_view: [u8; 256..] = syscall_path_view_here(slot);
    let new_absolute: bool = new_view[0] == 0x2F;
    let new_parent: SyscallParent = match kernel_syscall_parent_of(mount,
            x2, new_absolute, new_path) {
        SyscallParentResult::Errno(errno) => {
            return errno;
        }
        SyscallParentResult::Found(found) => { found }
    };
    let new_leaf: []u8 = kernel_syscall_leaf(new_path, new_parent);
    if (new_leaf.len == 0) { return LINUX_ENOENT; }
    if (kernel_syscall_leaf_is_dot(new_leaf) ||
        kernel_syscall_leaf_is_dot_dot(new_leaf)) {
        return LINUX_EBUSY;
    }
    return
        ext2_syscall_rename(mount, guard, old_directory, old_name,
                                   new_parent.inode, new_leaf);
}

// GitHub issue #598: bind's arm, run while its caller holds the
// listener's claim (or found no listener, which the body answers).
private fn syscall_bind_claimed(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], number: usize, x0: usize, x1: usize,
                                  x2: usize, x3: usize) -> SyscallAction
        !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallAction = syscall_bind_claimed_with(slot, current_authority, number, x0, x1, x2, x3);
    syscall_slot_release(slot);
    return result;
}

private fn syscall_bind_claimed_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], number: usize, x0: usize, x1: usize,
                                  x2: usize, x3: usize) -> SyscallAction
        !{unsafe} {
    syscall_test_evidence_record_bind();
    let bind_fd: usize =
        match kernel_listener_fd_lookup(x0) {
            KernelListenerLookupResult::Missing => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            KernelListenerLookupResult::Found(found) => { found }
        };
    if (kernel_listener_state(bind_fd) != UnifiedListenerState::Created ||
        x2 < 16) { return SyscallAction::Resume(LINUX_EINVAL); }
    // GitHub issue #975: x2 >= 16 here, and the IPv6 bytes are read only
    // once x2 >= 28, so every byte read is inside the copied span; the
    // scratch sockaddr buffer is not zero-filled.
    let sockaddr_len: usize = min(x2, 28);
    match user_range_check_read(current_authority, x1, sockaddr_len) {
        UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserReadRangeResult::Ok(range) => {
            if (copy_from_user_span(
                    range,
                    syscall_scratch[slot.index].sockaddr_buffer as []u8,
                    0, sockaddr_len) == false) {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
        }
    }
    let address: []u8 = syscall_scratch[slot.index].sockaddr_buffer as []u8;
    if (address[0] == 2 && address[1] == 0) {
        if (address[4] != 0 || address[5] != 0 ||
            address[6] != 0 || address[7] != 0) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
    } else {
        if (address[0] != 10 || address[1] != 0 || x2 < 28) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        for address_index: usize in 8..<24 {
            if (address[address_index] != 0) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
        }
    }
    let bind_port: u16 =
        (((address[2] as u16) << 8) | (address[3] as u16));
    if (bind_port == 0 ||
        kernel_listener_set_port(bind_fd, bind_port) == false ||
        kernel_listener_set_state(
            bind_fd, UnifiedListenerState::Bound) == false) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    return SyscallAction::Resume(0);
}

// GitHub issue #598: listen's arm, run while its caller holds the
// listener's claim (or found no listener, which the body answers).
private fn syscall_listen_claimed(number: usize, x0: usize, x1: usize,
                                  x2: usize, x3: usize) -> SyscallAction
        !{unsafe} {
    syscall_test_evidence_record_listen();
    let listen_fd: usize =
        match kernel_listener_fd_lookup(x0) {
            KernelListenerLookupResult::Missing => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            KernelListenerLookupResult::Found(found) => { found }
        };
    if (kernel_listener_state(listen_fd) != UnifiedListenerState::Bound) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    if (kernel_listener_set_state(
            listen_fd, UnifiedListenerState::Listening) == false) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    match syscall_test_lifecycle_listener_ready_label() {
        ListenerReadyLabel::ConnectedFixture => {
            kernel_boot_log("linux socket: listener ready port=");
        }
        ListenerReadyLabel::Persistent => {
            kernel_boot_log("persistent server: listener ready port=");
        }
    }
    uart_put_udec(kernel_listener_port(listen_fd) as usize);
    kernel_boot_log("\n");
    return SyscallAction::Resume(0);
}

// GitHub issue #598: accept's arm, run while its caller holds the
// listener's claim (or found no listener, which the body answers).
private fn syscall_accept_claimed(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], number: usize, x0: usize, x1: usize,
                                  x2: usize, x3: usize) -> SyscallAction
        !{unsafe} {
    // accept4(): hold the sole physical RX capability across the
    // blocking TCP handshake, then restore it before publishing the
    // new connection owner and returning its allocated descriptor.
    let accept_listener_fd: usize =
        match kernel_listener_fd_lookup(x0) {
            KernelListenerLookupResult::Missing => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            KernelListenerLookupResult::Found(found) => { found }
        };
    if (kernel_listener_state(accept_listener_fd) !=
            UnifiedListenerState::Listening ||
        (number == 242 && x3 != 0)) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    // GitHub issue #469: whichever handshake this listener already has
    // in progress, or a fresh one. accept(2) may return before the
    // three-way handshake finishes now, so the connection carrying it
    // has to outlive the call, and the listener is what holds it --
    // see kernel/kernel/fd_table.tkb's pending_accept_slot.
    let (pending_slot, pending_generation) =
        kernel_listener_pending(accept_listener_fd);
    // GitHub issue #469: counted once per accept(2) THE CALLER MADE,
    // which is what it has always meant and is no longer the same as
    // "once per entry into this handler" -- a blocked accept re-runs
    // the syscall when it is woken. A call that resumes a handshake
    // this listener already had is that same call coming back.
    // One accept step owns the RX capability briefly, then parks the
    // handshake and returns it before any wait.
    // GitHub issue #837: the capability comes first. Beginning a fresh
    // handshake resets the connection's retransmit entries, a walk of the
    // stack-wide chain that only the capability holder may make, and
    // kernel_tcp_accept_resume_or_begin takes a borrow of it to say so.
    match network_capability_take() {
        NetworkCapabilityTakeResult::Empty => {
            // The handshake keeps its place: somebody else holds the
            // one physical receive capability right now, which says
            // nothing about this connection. The listener's pending
            // slot is untouched, so the rerun resumes or begins as
            // this call would have.
            //
            // GitHub issue #866: block on NetRx even with no Ready
            // successor. The block idles this CPU, and the tick-wake
            // list wakes a NetRx waiter on the next tick (#829), which
            // reruns this call with the parked handshake and its
            // original deadline intact.
            kernel_process_current_set_pending_block(current_authority,
                ProcessWaitReason::NetRx, 0);
            return SyscallAction::Block;
        }
        NetworkCapabilityTakeResult::Ready(ready) => {
    // GitHub issue #469: counted once per accept(2) THE CALLER MADE,
    // which is what it has always meant and is no longer the same as
    // "once per entry into this handler" -- a blocked accept re-runs
    // the syscall when it is woken. A call that resumes a handshake
    // this listener already had is that same call coming back. Since
    // #837 a call that found the capability taken parks nothing, so it
    // is counted on the entry that first holds the capability.
    if (pending_slot == 0) {
        syscall_test_evidence_record_accept();
    }
    match kernel_tcp_accept_resume_or_begin(
            ready, pending_slot, pending_generation,
            kernel_listener_port(accept_listener_fd)) {
      TcpConnectionAllocResult::Full => {
        match network_capability_put(ready) {
            NetworkCapabilityPutResult::Stored => {}
            NetworkCapabilityPutResult::Conflict => {}
        }
        kernel_boot_log_resource_exhausted(
            "TCP connection pool" as *u8, 0);
        return SyscallAction::Resume(LINUX_EAGAIN);
      }
      TcpConnectionAllocResult::Allocated(owner) => {
       let slot: usize = tcp_connection_slot(owner);
       let generation: usize = tcp_connection_identity(owner);
            match kernel_tcp_accept_step(owner, ready) {
                KernelTcpAcceptStep::Pending(next) => {
                    // Not finished, and not failed. Give the machine
                    // back and leave the handshake where the next
                    // accept(2) will find it.
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            let cleared: bool = kernel_listener_set_pending(
                                accept_listener_fd, 0, 0);
                            return SyscallAction::Resume(LINUX_EINVAL);
                        }
                        NetworkCapabilityPutResult::Stored => {
                            // No roundtrip recorded: the capability
                            // came back, but this accept has not
                            // finished, and that counter pairs with
                            // the accept count above.
                            let parked: bool = kernel_listener_set_pending(
                                accept_listener_fd, slot, generation);
                            tcp_connection_put(owner);
                            // GitHub issue #469: BLOCK, not EAGAIN. A
                            // blocking accept(2) that answers "try
                            // again" is not accept -- the EL0 payload
                            // fixture calls it once and checks the
                            // descriptor it gets, which is what Linux
                            // promises. So this process waits, off the
                            // run queue, holding nothing, and runs the
                            // syscall again when it is woken.
                            // GitHub issue #866: with or without a Ready
                            // successor; the next tick wakes NetRx.
                            kernel_process_current_set_pending_block(current_authority,
                                ProcessWaitReason::NetRx, 0);
                            return SyscallAction::Block;
                        }
                    }
                }
                KernelTcpAcceptStep::GaveUp(next) => {
                    // GitHub issue #838: freed under the capability.
                    tcp_connection_free(next, owner);
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Conflict => {
                            let cleared: bool = kernel_listener_set_pending(
                                accept_listener_fd, 0, 0);
                            return SyscallAction::Resume(LINUX_EINVAL);
                        }
                        NetworkCapabilityPutResult::Stored => {
                            syscall_test_evidence_record_accept_capability_roundtrip();
                            let cleared: bool = kernel_listener_set_pending(
                                accept_listener_fd, 0, 0);
                            // The deadline expires one incomplete TCP
                            // handshake, not this blocking accept(2).
                            // Returning EAGAIN here made BusyBox httpd
                            // terminate after an idle interval. Forget
                            // the stale peer and keep waiting; the next
                            // dispatch starts a fresh handshake.
                            kernel_process_current_set_pending_block(current_authority,
                                ProcessWaitReason::NetRx, 0);
                            return SyscallAction::Block;
                        }
                    }
                }
                KernelTcpAcceptStep::Accepted(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Conflict => {
                            kernel_connection_free_capped(owner);
                            return SyscallAction::Resume(LINUX_EINVAL);
                        }
                        NetworkCapabilityPutResult::Stored => {
                            syscall_test_evidence_record_accept_capability_roundtrip();
                            let cleared: bool = kernel_listener_set_pending(
                                accept_listener_fd, 0, 0);
                            // GitHub issue #469: the descriptor is
                            // allocated HERE, not before the handshake.
                            // A call that returns without accepting is
                            // an ordinary outcome now, and one that had
                            // already taken an fd would have to give it
                            // back on every poll.
                            let connected_fd: usize =
                                match kernel_socket_fd_alloc(5) {
                                    KernelSocketFdAllocResult::Full => {
                                        kernel_boot_log_resource_exhausted(
                                            "process fd table" as *u8,
                                            kernel_syscall_fd_limit_soft());
                                        // #838: the capability went back above.
                                        kernel_connection_free_capped(owner);
                                        return SyscallAction::Resume(LINUX_EAGAIN);
                                    }
                                    KernelSocketFdAllocResult::Allocated(found) => { found }
                                };
                            // Issue #257 step 5: no Conflict arm and no
                            // `slot >= TCP_CONNECTION_MAX` guard: the fd
                            // records the connection's address and
                            // generation, which tcp_connection_take
                            // revalidates, so neither is a check quietly
                            // dropped.
                            // GitHub issue #598: written under the owner,
                            // since this may run on a peer while core 0's
                            // receive path reaches the same connection.
                            tcp_connection_of(owner).connection_open = true;
                            tcp_connection_of(owner).socket_buffer_length = 0;
                            tcp_connection_of(owner).socket_buffer_offset = 0;
                            tcp_connection_put(owner);
                            match unified_connection_create(
                                    kernel_syscall_process_key(),
                                    connected_fd, slot, generation) {
                                UnifiedOpenResult::Invalid => {
                                    return SyscallAction::Resume(LINUX_EAGAIN);
                                }
                                UnifiedOpenResult::Full => {
                                    kernel_boot_log_resource_exhausted(
                                        "shared object pool" as *u8,
                                        unified_object_max_files());
                                    return SyscallAction::Resume(LINUX_EAGAIN);
                                }
                                UnifiedOpenResult::Ok => {}
                            }
                            return SyscallAction::Resume(connected_fd);
                        }
                    }
                }
            }
        }
       }
      }
    }
}

// GitHub issue #583: the REFUSAL LIST. Every syscall this kernel implements
// is callable from any CPU unless it is named here with the reason it stays
// core 0's, so a syscall added later is peer-callable by default rather than
// silently core-0-only. syscall_peer_safe below still narrows some admitted
// calls by descriptor kind; that is a statement about a path, not a refusal
// of the call. What each group needs before it can leave the list is on
// issue #583.
fn syscall_peer_refused(number: usize) -> bool {
    // reboot (142) left this list in #933: its world stop takes the owner
    // from cpu_id(), and the console is owned on any core since #830.
    // The payload fixture's parent report, the last of the process
    // lifecycle here. Every multicore defect this project has closed lived in
    // that lifecycle (#532, #552, #569, #571), each found with its operations
    // on core 0, and they left this list one at a time: wait4 in #609, once
    // #550 had made its decision and its Blocked publication one critical
    // section; execve and execveat in #610, once exec's per-call state was
    // per CPU and its record writes one hold (#618), with the three execs
    // that stayed core 0's handed there from the handler (the last, the
    // BusyBox Extras exec, runs where it is called since #828); clone, clone3, fork
    // and vfork in #611, whose child's first return on its parent's stack
    // StackOwnership.tla already models on either core. syslog, the one
    // entry that was not lifecycle, left in #612: its reader takes no lock
    // and drops a record overwritten while it copied (LogRing.tla, #613).
    if (number == AARCH64_NR_TAKIBI_PARENT_PROGRESS) {
        return true;
    }
    return false;
}

fn syscall_peer_safe(number: usize, fd: usize, second: usize) -> bool {
    if (syscall_peer_refused(number)) { return false; }
    // Session lookups and changes hold the process-run lock.
    if (number == AARCH64_NR_GETSID || number == AARCH64_NR_SETSID) {
        return true;
    }
    // The caller's own record, or architectural state: getpid, getppid,
    // the uid/gid family, gettid, clock_gettime, and getcpu (#533).
    if (number == 172 || number == 173 || number == 178 ||
        (number >= 174 && number <= 177) || number == 113 ||
        number == AARCH64_NR_GETRESUID || number == AARCH64_NR_GETRESGID ||
        number == AARCH64_NR_GETCPU) {
        return true;
    }
    // The affinity ABI takes the run lock for everything it reads or writes.
    if (number == AARCH64_NR_SCHED_SETAFFINITY ||
        number == AARCH64_NR_SCHED_GETAFFINITY) {
        return true;
    }
    // GitHub issue #665: sched_yield only asks this CPU for a reschedule.
    if (number == AARCH64_NR_SCHED_YIELD) {
        return true;
    }
    // A per-process deadline, held in the caller's own record (86fb1cbd).
    // The sleeper is queued on this CPU's tick-wake list and this CPU's
    // own tick wakes it (#829; kernel_process_tick_wake_scan).
    if (number == AARCH64_NR_NANOSLEEP ||
        number == AARCH64_NR_CLOCK_NANOSLEEP) {
        return true;
    }
    // A peer exit returns to architectural idle (#552, bcaf4419).
    if (number == AARCH64_NR_EXIT || number == AARCH64_NR_EXIT_GROUP) {
        return true;
    }
    // GitHub issue #9 phase B entry 6: the system-identity reads.
    //
    // uname answers from fixed string literals into the bounded per-CPU scratch array,
    // and that scratch is `[SyscallScratch; KERNEL_MAX_CORES]` indexed by
    // `cpu_id()` -- two cores never share the buffer, so a peer cannot see
    // half of core 0's fill. sysinfo keeps no kernel scratch at all: it
    // zero-fills the caller's own range and writes one word read from the
    // architectural generic counter, which is system-wide on AArch64 and
    // readable from any CPU.
    //
    // Neither reaches the filesystem, the network, the console, or a device.
    // What they do reach is the user-memory boundary -- a range check against
    // the caller's own root, then a copy -- and that is not new on a peer: a
    // terminal write has crossed it from one since #534. Nothing here widens
    // WHICH processes run on a peer, so the default-mask decision that #514
    // and #516 gate is untouched.
    if (number == AARCH64_NR_UNAME || number == AARCH64_NR_SYSINFO) {
        return true;
    }
    // The workload fixtures' own progress report. Every handler in
    // kernel/kernel/workload_evidence.tkb takes the process run lock, and
    // these fixtures have reported from a peer since #533, #534 and #547.
    if (number == AARCH64_NR_TAKIBI_WORKLOAD_PROGRESS) { return true; }
    // GitHub issue #9 phase B entry 6, second increment: the per-process
    // reads that answer from the caller's own record and take no lock.
    //
    // getcwd writes `/` and a NUL into the caller's own range and keeps no
    // kernel scratch. This kernel has exactly one directory, so the answer
    // is a constant; even if it stops being one, a process's cwd is its own
    // and no other CPU writes it.
    //
    // set_tid_address returns the current pid, which is a read of
    // `execution_here().current_handle` -- this CPU's own current process --
    // and of that record's own pid word.
    if (number == AARCH64_NR_GETCWD || number == AARCH64_NR_SET_TID_ADDRESS) {
        return true;
    }
    // GitHub issue #9 phase B entry 6, third increment: prlimit64 in both
    // directions. The increment before admitted the read only and said the
    // WRITE belonged to the increment that answered whether a peer may
    // mutate its own record. This is that answer, and for THESE two words it
    // is yes -- by enumeration rather than by analogy.
    //
    // `fd_limit_soft`/`fd_limit_hard` live in the process's own
    // ProcessFdContext. Written: at creation, by its own prlimit64, and by
    // its own clone copying them into a child that is still Constructing.
    // Read: by `unified_fd_alloc`/`unified_fd_install` for the slot whose
    // syscall is running, by that same clone as the parent, and by boot
    // probes that use slot 0 -- the boot process, which is never admitted to
    // a peer. A reaper reaches a child's fd table only once that child has
    // Exited, and #552 put a peer's stack release before PID 1 collects it.
    // So while a process runs on a peer, no other CPU touches the two words
    // it is writing.
    //
    // No argument-dependent admission is left, so this takes the number and
    // the descriptor again. One number being two questions did not stop
    // being true -- read and write still turn on their descriptor -- only
    // this instance of it did.
    if (number == AARCH64_NR_PRLIMIT64) { return true; }
    // Calls whose only WRITE is into the caller's own user memory, touching
    // no kernel state at all:
    //
    //   chdir         copies two bytes into the per-CPU path buffer,
    //                 compares them against `/` and `.`, and stores nothing.
    //                 This kernel has one directory, so there is no cwd to
    //                 move.
    //   rt_sigaction  validates signum and zero-fills a non-null oldact.
    //                 Handlers are never installed, so nothing is stored.
    //
    // Each crosses the user-memory boundary against its own root, which a
    // peer terminal write has crossed since #534.
    if (number == AARCH64_NR_CHDIR || number == AARCH64_NR_RT_SIGACTION) {
        return true;
    }
    // GitHub issue #1172: setitimer and getitimer read and write the
    // caller's own ITIMER_REAL under the process-run lock, which the tick
    // that fires it takes too, so the caller's CPU is not part of it.
    if (number == AARCH64_NR_SETITIMER || number == AARCH64_NR_GETITIMER) {
        return true;
    }
    // rt_sigprocmask (GitHub issue #570). The process's own signal_mask is
    // read by a sender on any CPU and written only by the process itself,
    // and pending_signals is read-modify-written by both; every such access
    // is under the process-run lock now (process_signal_pending_raise and
    // _clear take its guard), so a peer writing its own mask is one more
    // locked party rather than an unsynchronized one.
    //
    // kill joined in GitHub issue #583's first increment. Delivery runs
    // under the same lock and a wake publishes through the guarded Blocked
    // take (#589), so the sender's CPU is not part of the argument. A
    // self-directed SIGTERM exits, and a peer exit is admitted already.
    if (number == 135 || number == AARCH64_NR_KILL) { return true; }
    // GitHub issue #1138: sigaltstack reads and writes only the caller's
    // own record (signal_altstack, which nothing else on any CPU touches)
    // and the caller's own memory.
    if (number == AARCH64_NR_SIGALTSTACK) { return true; }
    // GitHub issue #581: read and write on a connected TCP descriptor. Every
    // field of the connection is read and written under its owner
    // (tcp_connection_take's TaskMutex, revalidated by generation after the
    // acquire), and the receive and transmit paths hold the sole network
    // capability, which is itself behind a Mutex. So a peer's call and core
    // 0's call on the same connection serialize on the owner, and two
    // connections serialize on the capability.
    //
    // GitHub issue #598 adds close, dup3 and shutdown, which reach the
    // transport release through kernel_connected_descriptor_close or the
    // shutdown arm, both under the connection's owner; and getpeername and
    // setsockopt, which write or check only the caller's memory. A
    // connection duplicated onto a standard descriptor is not the terminal.
    if (kernel_connected_fd_is_open(fd)) {
        return number == 63 || number == AARCH64_NR_WRITE ||
            number == AARCH64_NR_READV || number == AARCH64_NR_WRITEV ||
            number == AARCH64_NR_CLOSE || number == 24 || number == 210 ||
            number == 205 || number == 208;
    }
    // The terminal: a peer's output goes through its console ring (#534),
    // and input is ordered by the run lock (#547).
    // An ext2 file since GitHub issue #602: the write, its position and
    // its bound are one section under the mutation guard, which waits for
    // every CPU's counted readers.
    // A pipe since GitHub issue #1042: every field of a pipe is read and
    // written under its own TaskMutex, and its wait and wake under the run
    // lock (kernel/kernel/pipe.tkb), so a reader and a writer on two CPUs
    // serialize there.
    if (number == AARCH64_NR_WRITE || number == AARCH64_NR_WRITEV) {
        return kernel_syscall_terminal_is_open(fd) ||
            kernel_syscall_file_is_open(fd) ||
            kernel_syscall_pipe_is_open(fd);
    }
    // GitHub issue #581: the filesystem READ path, which is the first
    // subsystem in this table rather than another per-process word.
    //
    // What makes it admissible is already built and already exercised from a
    // peer, by /bin/peer-read under the per-pid rule: ext2 mutation excludes
    // itself through kernel/fs/ext2/mutation_lock.tkb at lock rank 20, the
    // block cache publishes its write epoch with release ordering and sums
    // it with acquire loads (#533), and the per-CPU ext2 scratch means two
    // cores never share a staging buffer. A reader still takes no lock --
    // readers have to stay concurrent or `peer_filesystem.expected`'s
    // both-CPU device contention disappears -- and instead asks at syscall
    // entry whether a mutation is in flight. `syscall_reaches_filesystem`
    // below is what keeps that question being asked now that the table
    // admits these calls rather than refusing them.
    //
    // NOT the file write path, which stays core 0's by descriptor. The
    // directory mutations are admitted since #597, and
    // scripts/buildcheck_ext2_mutation_guard.py, over the compiler's call
    // graph, is what proves each mutator is reached with the guard held.
    //
    // #559 closed the in-flight window: a reader is counted until its
    // syscall is done, and a mutation waits for the count to drain.
    if (number == AARCH64_NR_OPENAT || number == AARCH64_NR_CLOSE ||
        number == AARCH64_NR_NEWFSTATAT) {
        return true;
    }
    if (number == 63 || number == AARCH64_NR_READV) {
        if (kernel_syscall_terminal_is_open(fd)) { return true; }
        if (kernel_syscall_pipe_is_open(fd)) { return true; }
        return kernel_syscall_file_readable(fd);
    }
    // GitHub issue #583, second increment: the descriptor table.
    //
    // fcntl (F_SETFD, F_DUPFD, F_DUPFD_CLOEXEC) and dup3 edit the CALLER's
    // own table through unified_fd_*, keyed by its own slot, and the only
    // shared state they touch is an open object's reference count -- which
    // close, admitted since #581, already drops from a peer through the same
    // functions. Both are admitted only between terminal, file and directory
    // descriptors: dup3 onto a connected socket runs
    // kernel_connected_descriptor_close, whose close is core 0's, and a
    // listener is accept's state.
    if (number == AARCH64_NR_FCNTL) {
        return syscall_fd_is_plain(fd);
    }
    if (number == 24) {
        return syscall_fd_is_plain(fd) && syscall_fd_is_socket(second) == false;
    }
    // getdents64 over an ext2 directory is a read like read's, and owes the
    // same mutation question. NOT the procfs root: listing it walks the
    // process pool with no guard, which is GitHub issue #482's open walk,
    // and a peer would be one more walker of it.
    if (number == 61) {
        return kernel_syscall_directory_is_open(fd) &&
            kernel_syscall_directory_inode(fd) != PROCFS_ROOT_INODE;
    }
    // access, faccessat and faccessat2 look a path up and read one inode's
    // mode, the same read newfstatat is admitted for.
    if (number == 21 || number == 48 || number == 439) { return true; }
    // GitHub issue #583, third increment: the caller's own memory.
    //
    // brk and mmap move the heap break, a word in the caller's own fd
    // context that the process alone writes after exec -- prlimit64's
    // argument for its limit words. The arena is mapped at exec, so neither
    // allocates. munmap does nothing. mprotect rewrites the caller's own
    // page-table entries through address_space_pte_write, whose
    // mmu_pte_update invalidates with `tlbi vae1is`, broadcast to every
    // core, so a core the process ran on before keeps no stale entry. Data
    // aborts already rewrite the same tables from a peer since #580.
    if (number == 214 || number == 215 || number == 222 || number == 226) {
        return true;
    }
    // Fourth increment: rt_sigtimedwait. Its take runs under the process-run
    // lock (#570), and its block re-checks the pending set inside the
    // critical section that publishes Blocked (kernel_process_block_reserved),
    // so a signal raised from any CPU between the take and the block is
    // either seen there or delivered to a Blocked waiter.
    if (number == AARCH64_NR_RT_SIGTIMEDWAIT) { return true; }
    // Fifth increment: the terminal waits. ppoll combines paths a peer is
    // admitted for already -- the RX ring's pending check, the UartRx block
    // whose decisive look is inside the critical section that publishes
    // Blocked (#547), the deadline wait nanosleep uses, and the connected
    // socket's deliberately lockless readiness hint. It blocks whether or
    // not a successor is Ready on this CPU, because a block with none now
    // idles the CPU instead of declining. The fixture wait blocks on UartRx
    // the same way, taking its byte under the run lock.
    if (number == AARCH64_NR_PPOLL ||
        number == AARCH64_NR_TAKIBI_UART_RX_WAIT) {
        return true;
    }
    // Everything the refusal list above does not name, and the descriptor
    // rules above do not narrow, runs where it was called (#583).
    return true;
}

// Does this call reach ext2, and therefore owe the mutation question?
//
// GitHub issue #581: this used to be answered by `syscall_peer_safe` saying
// no -- the only filesystem calls a peer could make were /bin/peer-read's,
// which the table refused and the per-pid rule admitted anyway. The table
// admits the read path itself now, so "the table does not admit it" has
// stopped being the same question and the two are asked separately.
fn syscall_reaches_filesystem(number: usize, fd: usize, flags: usize) -> bool {
    // GitHub issue #967: O_CREAT is a mutation, which takes the guard
    // instead; a counted reader that then took it would wait for itself.
    // scripts/buildcheck_ext2_reader_self_wait.py refuses a registered
    // handler that reaches the guard (GitHub issue #1015); a number added
    // here whose dispatch arm takes the guard inline is not visible to it.
    // So is O_TRUNC (GitHub issue #1016).
    if (number == AARCH64_NR_OPENAT && (flags & LINUX_O_MUTATING) != 0) {
        return false;
    }
    if (number == AARCH64_NR_OPENAT || number == AARCH64_NR_CLOSE ||
        number == AARCH64_NR_NEWFSTATAT) {
        return true;
    }
    // GitHub issue #597: execve looks the image up in dispatch, and a
    // child's exec prepare streams it from ext2 after dispatch has
    // returned; the registration made here is held across both.
    if (number == AARCH64_NR_EXECVE || number == AARCH64_NR_EXECVEAT) {
        return true;
    }
    // sendfile reads its input file from ext2 (GitHub issue #598).
    if (number == 71) { return true; }
    // lseek's SEEK_END reads an ext2 inode's size.
    if (number == AARCH64_NR_LSEEK) { return kernel_syscall_file_is_open(fd); }
    if (number == 63 || number == AARCH64_NR_READV) {
        return kernel_syscall_file_readable(fd);
    }
    if (number == 61 || number == 21 || number == 48 || number == 439) {
        return true;
    }
    return false;
}

// A terminal, ext2 file, directory or pipe descriptor: the kinds whose
// table entries fcntl, dup3 and close edit without reaching a socket's
// state. A pipe end's last close reaches the pipe through the object
// release (GitHub issue #1042), under the pipe's own lock.
fn syscall_fd_is_plain(fd: usize) -> bool {
    return kernel_syscall_terminal_is_open(fd) ||
        kernel_syscall_file_is_open(fd) ||
        kernel_syscall_directory_is_open(fd) ||
        kernel_syscall_pipe_is_open(fd);
}

fn syscall_fd_is_socket(fd: usize) -> bool {
    if (kernel_connected_fd_is_open(fd)) { return true; }
    match kernel_listener_fd_lookup(fd) {
        KernelListenerLookupResult::Missing => { return false; }
        KernelListenerLookupResult::Found(found) => { return true; }
    }
}

// Step 9/9: action 9 (.Lsyscall_migrate). The gate chose core 0 for this
// syscall. Rewind it, mark the process core-0-only until the call
// completes, and leave this CPU; the process becomes Ready only once this
// core is off its stack (kernel_process_stack_idle_yield).
fn kernel_syscall_migrate_return(frame_sp: usize) {
    let frame =
        frame_ref_from_el0_entry(frame_sp, kernel_process_entry_generation());
    el0_context_retry_syscall(frame);
    if (kernel_process_migrate_current(frame) == false) {
        kernel_invariant_stop_with_frame(frame);
    }
    kernel_idle_yield_enter();
}

// GitHub issue #627: asynchronous SIGCHLD handlers, rt_sigsuspend and
// rt_sigreturn -- what BusyBox ash's `wait` builtin needs. It masks SIGCHLD,
// then loops on sigsuspend until its handler has set a flag; with neither
// call it spun forever beside an unreaped child.
//
// A syscall return runs a handler: kernel_syscall_dispatch hands every
// Resume to syscall_signal_deliver below, which builds the frame the
// handler returns through. Every other return to EL0 runs one too, the
// timer interrupt's included (kernel_signal_return_deliver, GitHub issue
// #628).
//
// The frame is Linux's arm64 rt_sigframe, so a handler that reads its
// ucontext reads what it would on Linux: siginfo (128 bytes), then the
// ucontext, whose uc_sigmask is the mask rt_sigreturn restores and whose
// mcontext carries x0..x30, sp, pc, pstate and one fpsimd_context record
// followed by the empty terminator record. There is no vDSO, so the return
// path is the caller's SA_RESTORER trampoline (musl always supplies one);
// installing a handler without one is refused.
const LINUX_EINTR: usize = 0xFFFFFFFFFFFFFFFC;
const LINUX_SIGSEGV: usize = 11;
// siginfo si_code of a signal the kernel raised itself (GitHub issue #895).
const LINUX_SI_KERNEL: u32 = 0x80;

const LINUX_SA_RESTORER: usize = 0x04000000;
const LINUX_SA_NODEFER: usize = 0x40000000;
const LINUX_SA_RESETHAND: usize = 0x80000000;
const SIGFRAME_SIZE: usize = 4688;
const SIGFRAME_UC_SIGMASK: usize = 168;
const SIGFRAME_REGS: usize = 312;
const SIGFRAME_SP: usize = 560;
const SIGFRAME_PC: usize = 568;
const SIGFRAME_PSTATE: usize = 576;
const SIGFRAME_FPSIMD: usize = 592;
const SIGFRAME_FPSIMD_MAGIC: usize = 0x46508001;
const SIGFRAME_FPSIMD_SIZE: usize = 528;
// EL0 may choose only the condition flags of the PSTATE it returns to.
const SIGFRAME_PSTATE_USER_BITS: usize = 0xF0000000;
// A lower-EL data abort (EC 0x24), level-3 translation fault (FSC 0x07).
const SIGFRAME_STACK_GROWTH_ESR: usize = 0x90000007;

// GitHub issue #1138: sigaltstack(2), as Linux's do_sigaltstack. stack_t is
// { ss_sp (u64), ss_flags (int), ss_size (u64) }: 24 bytes.
const LINUX_SA_ONSTACK: usize = 0x08000000;
const LINUX_SS_ONSTACK: usize = 1;
const LINUX_SS_DISABLE: usize = 2;
const LINUX_SS_AUTODISARM: usize = 0x80000000;
// arm64's MINSIGSTKSZ (uapi asm/signal.h), the smallest stack accepted.
const LINUX_MINSIGSTKSZ: usize = 5120;
const SIGFRAME_UC_STACK: usize = 144;

// Linux's on_sig_stack: `sp` lies on the alternate stack. A stack armed
// with SS_AUTODISARM never counts, since delivery disarms it.
// -- setitimer and getitimer (GitHub issue #1172) ------------------------
//
// ITIMER_REAL only: its SIGALRM goes through the ordinary signal path from
// the tick (kernel_process_itimer_fire_if_due). ITIMER_VIRTUAL and
// ITIMER_PROF would need per-process CPU-time accounting this kernel does
// not keep, so they are EINVAL, as is any other `which`.
const LINUX_ITIMER_REAL: usize = 0;
const ITIMERVAL_BYTES: usize = 32;
const MICROS_PER_SECOND: usize = 1000000;
// A time too large to count in ticks is never reached; a saturated due
// time stands for it.
const ITIMER_NEVER: usize = 0xFFFFFFFFFFFFFFFF;

// One struct timeval of a user itimerval as microseconds, saturated; false
// when it is not a valid timeval (negative, or tv_usec past a second), as
// Linux's timeval_valid.
fn itimer_timeval_us(range: borrow UserReadRange[process], offset: usize)
        -> (bool, usize) !{unsafe} {
    let (seconds_ok, seconds_raw) = user_read_u64(range, offset);
    let (micros_ok, micros_raw) = user_read_u64(range, offset + 8);
    if (seconds_ok == false || micros_ok == false) { return (false, 0); }
    let seconds: usize = seconds_raw as usize;
    let micros: usize = micros_raw as usize;
    if (seconds >= 0x8000000000000000 || micros >= MICROS_PER_SECOND) {
        return (false, 0);
    }
    let mut whole: usize = ITIMER_NEVER;
    match checked_mul_usize(seconds, MICROS_PER_SECOND) {
        CheckedUsize::Overflow => {}
        CheckedUsize::Value(value) => { whole = value; }
    }
    match checked_add_usize(whole, micros) {
        CheckedUsize::Overflow => { return (true, ITIMER_NEVER); }
        CheckedUsize::Value(value) => { return (true, value); }
    }
}

// Microseconds as generic-counter ticks, rounded up so a timer never fires
// early; saturated.
fn itimer_us_ticks(micros: usize) -> usize {
    let frequency: usize = read_cntfrq() as usize;
    let whole: usize = match checked_mul_usize(micros / MICROS_PER_SECOND, frequency) {
        CheckedUsize::Overflow => { return ITIMER_NEVER; }
        CheckedUsize::Value(value) => { value }
    };
    // Below 10^6 * 2^32, so the product does not overflow for any counter
    // frequency under 2^32 Hz; checked all the same.
    let part: usize = match checked_mul_usize(micros % MICROS_PER_SECOND, frequency) {
        CheckedUsize::Overflow => { return ITIMER_NEVER; }
        CheckedUsize::Value(value) => { value }
    };
    match checked_add_usize(whole, (part + MICROS_PER_SECOND - 1) / MICROS_PER_SECOND) {
        CheckedUsize::Overflow => { return ITIMER_NEVER; }
        CheckedUsize::Value(value) => { return value; }
    }
}

// Write `timer` as a struct itimerval: the interval as set, the time left
// until the next expiry (0 when disarmed).
fn itimer_write_value(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                      address: usize, timer: ProcessItimerReal) -> bool !{unsafe} {
    let mut remaining_us: usize = 0;
    if (timer.due != 0) {
        let now: usize = read_cntpct() as usize;
        if (timer.due > now) {
            let frequency: usize = read_cntfrq() as usize;
            let left: usize = timer.due - now;
            if (frequency == 0) { return false; }
            let seconds: usize = left / frequency;
            // The remainder is below the frequency, so the product fits.
            let mut part: usize = 0;
            match checked_mul_usize(left % frequency, MICROS_PER_SECOND) {
                CheckedUsize::Overflow => {}
                CheckedUsize::Value(value) => { part = value / frequency; }
            }
            remaining_us = ITIMER_NEVER - MICROS_PER_SECOND;
            match checked_mul_usize(seconds, MICROS_PER_SECOND) {
                CheckedUsize::Overflow => {}
                CheckedUsize::Value(value) => {
                    if (value < ITIMER_NEVER - MICROS_PER_SECOND) { remaining_us = value + part; }
                }
            }
        }
    }
    match user_range_check_write(current_authority, address, ITIMERVAL_BYTES) {
        UserWriteRangeResult::Fault => { return false; }
        UserWriteRangeResult::Ok(range) => {
            let mut written = user_write_u64(range, 0, (timer.interval_us / MICROS_PER_SECOND) as u64);
            written = user_write_join(written, user_write_u64(range, 8, (timer.interval_us % MICROS_PER_SECOND) as u64));
            written = user_write_join(written, user_write_u64(range, 16, (remaining_us / MICROS_PER_SECOND) as u64));
            written = user_write_join(written, user_write_u64(range, 24, (remaining_us % MICROS_PER_SECOND) as u64));
            match written {
                UserWriteResult::Fault => { return false; }
                UserWriteResult::Written => { return true; }
            }
        }
    }
}

// Linux's setitimer: the new value is read and validated first (a NULL one
// disarms, as Linux has accepted since 2.6.x), the timer replaced, and only
// then the old value written, so an unwritable old_value is EFAULT after
// the timer changed.
fn syscall_setitimer(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                     which: usize, value_address: usize, old_address: usize)
        -> SyscallAction !{unsafe} {
    if (which != LINUX_ITIMER_REAL) { return SyscallAction::Resume(LINUX_EINVAL); }
    let mut interval_us: usize = 0;
    let mut value_us: usize = 0;
    if (value_address != 0) {
        match user_range_check_read(current_authority, value_address, ITIMERVAL_BYTES) {
            UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserReadRangeResult::Ok(range) => {
                let (interval_ok, interval) = itimer_timeval_us(range, 0);
                let (value_ok, value) = itimer_timeval_us(range, 16);
                if (interval_ok == false || value_ok == false) {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                interval_us = interval;
                value_us = value;
            }
        }
    }
    let mut timer: ProcessItimerReal = { 0, 0, 0 };
    if (value_us != 0) {
        timer.due = ITIMER_NEVER;
        match checked_add_usize(read_cntpct() as usize, itimer_us_ticks(value_us)) {
            CheckedUsize::Overflow => {}
            CheckedUsize::Value(value) => { timer.due = value; }
        }
        timer.interval_us = interval_us;
        if (interval_us != 0) { timer.interval_ticks = itimer_us_ticks(interval_us); }
    }
    let mut old: ProcessItimerReal =
        kernel_process_current_itimer_real_swap(current_authority, timer, true);
    if (old_address != 0 && itimer_write_value(current_authority, old_address, old) == false) {
        return SyscallAction::Resume(LINUX_EFAULT);
    }
    return SyscallAction::Resume(0);
}

fn syscall_getitimer(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                     which: usize, value_address: usize) -> SyscallAction !{unsafe} {
    if (which != LINUX_ITIMER_REAL) { return SyscallAction::Resume(LINUX_EINVAL); }
    let mut none: ProcessItimerReal = { 0, 0, 0 };
    let mut current: ProcessItimerReal =
        kernel_process_current_itimer_real_swap(current_authority, none, false);
    if (itimer_write_value(current_authority, value_address, current) == false) {
        return SyscallAction::Resume(LINUX_EFAULT);
    }
    return SyscallAction::Resume(0);
}

fn signal_altstack_holds(altstack: SignalAltStack, sp: usize) -> bool {
    if ((altstack.flags & LINUX_SS_AUTODISARM) != 0) { return false; }
    return sp > altstack.sp && sp - altstack.sp <= altstack.size;
}

// Linux's sas_ss_flags: SS_DISABLE with no stack, SS_ONSTACK while `sp`
// is on it, else 0.
fn signal_altstack_state(altstack: SignalAltStack, sp: usize) -> usize {
    if (altstack.size == 0) { return LINUX_SS_DISABLE; }
    if (signal_altstack_holds(altstack, sp)) { return LINUX_SS_ONSTACK; }
    return 0;
}

// Install { new_sp, new_flags, new_size } for a caller whose SP is `sp`:
// 0, or EPERM while on the current stack, EINVAL for an unknown mode,
// ENOMEM below MINSIGSTKSZ. SS_DISABLE stores no stack.
fn signal_altstack_change(
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        sp: usize, new_sp: usize, new_flags: usize, new_size: usize) -> usize {
    let mut current: SignalAltStack =
        kernel_process_current_signal_altstack(current_authority);
    if (signal_altstack_holds(current, sp)) { return LINUX_EPERM; }
    let mode: usize = new_flags & ~LINUX_SS_AUTODISARM;
    if (mode != LINUX_SS_DISABLE && mode != LINUX_SS_ONSTACK && mode != 0) {
        return LINUX_EINVAL;
    }
    if (current.sp == new_sp && current.size == new_size &&
        current.flags == new_flags) {
        return 0;
    }
    let mut installed: SignalAltStack = { new_sp, new_size, new_flags };
    if (mode == LINUX_SS_DISABLE) {
        installed.sp = 0;
        installed.size = 0;
    } else if (new_size < LINUX_MINSIGSTKSZ) {
        return LINUX_ENOMEM;
    }
    kernel_process_current_set_signal_altstack(current_authority, installed);
    return 0;
}

// sigaltstack(ss, old_ss) for a caller whose SP is `sp`. The old stack is
// the one before any change, and is written only when the change (if any)
// succeeded, as Linux does.
fn syscall_sigaltstack(
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        sp: usize, new_address: usize, old_address: usize) -> usize !{unsafe} {
    let mut old: SignalAltStack =
        kernel_process_current_signal_altstack(current_authority);
    if (new_address != 0) {
        match user_range_check_read(current_authority, new_address, 24) {
            UserReadRangeResult::Fault => { return LINUX_EFAULT; }
            UserReadRangeResult::Ok(range) => {
                let (sp_ok, new_sp) = user_read_u64(range, 0);
                let (flags_ok, new_flags) = user_read_u32(range, 8);
                let (size_ok, new_size) = user_read_u64(range, 16);
                if (sp_ok == false || flags_ok == false || size_ok == false) {
                    return LINUX_EFAULT;
                }
                let changed: usize = signal_altstack_change(current_authority,
                    sp, new_sp as usize, new_flags as usize, new_size as usize);
                if (changed != 0) { return changed; }
            }
        }
    }
    if (old_address != 0) {
        match user_range_check_write(current_authority, old_address, 24) {
            UserWriteRangeResult::Fault => { return LINUX_EFAULT; }
            UserWriteRangeResult::Ok(range) => {
                let flags: usize = signal_altstack_state(old, sp) |
                    (old.flags & LINUX_SS_AUTODISARM);
                let mut written = user_zero_fill(range);
                written = user_write_join(written, user_write_u64(range, 0, old.sp as u64));
                written = user_write_join(written, user_write_u32(range, 8, flags as u32));
                written = user_write_join(written, user_write_u64(range, 16, old.size as u64));
                match written {
                    UserWriteResult::Fault => { return LINUX_EFAULT; }
                    UserWriteResult::Written => {}
                }
            }
        }
    }
    return 0;
}

// Write the frame for `signum` below `top`: the interrupted user stack, or
// the top of the alternate stack (GitHub issue #1138). The frame records x0
// as `value`, the result the interrupted syscall returns once the handler
// is done, and uc_stack as `altstack`. False when the stack cannot take it.
fn syscall_signal_frame_write(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize,
                              signum: usize,
                              restore_mask: usize, child_pid: usize,
                              child_status: ProcessEnd, sender_pid: usize,
                              top: usize, altstack: SignalAltStack)
        -> (bool, usize)
        !{unsafe} {
    let user_sp: usize = frame_sp_el0(frame);
    if (top < SIGFRAME_SIZE + 16) { return (false, 0); }
    let base: usize = (top - SIGFRAME_SIZE) & ~15;
    // The stack below SP may not be populated yet: EL0 grows it by
    // faulting, and this write is the kernel's. Ask the same growth path a
    // translation fault on the frame's lowest byte would, with interrupts
    // masked as they are on that path. Memory already there answers false,
    // and the range check below is what decides.
    let irq_flags: usize = mutex_irq_save();
    let grown: bool = process_image_handle_data_abort(
        kernel_process_current_root(current_authority),
        SIGFRAME_STACK_GROWTH_ESR, base);
    mutex_irq_restore(irq_flags);
    match user_range_check_write(current_authority, base,
                                 SIGFRAME_SIZE) {
        UserWriteRangeResult::Fault => { return (false, 0); }
        UserWriteRangeResult::Ok(range) => {
            let mut written = user_zero_fill(range);
            // siginfo: si_signo, si_errno, si_code. SIGCHLD carries the
            // child it was queued for: si_pid (16), si_code CLD_EXITED or
            // CLD_KILLED, si_status (24) the exit code or the signal (GitHub
            // issue #885; si_uid, si_utime and si_stime stay 0). Any other
            // signal, and a SIGCHLD kill sent, is SI_USER (0) with si_pid
            // the kill(2) sender and si_uid (20) 0, not yet the
            // sender's real uid (GitHub issues #894, #1176). Sender pid 0 means the kernel raised
            // it (the terminal's ^C, ^\ and ^Z; no process has pid 0), which
            // Linux reports as SI_KERNEL with si_pid and si_uid 0 (GitHub
            // issue #895).
            written = user_write_join(written, user_write_u32(range, 0, signum as u32));
            if (signum == LINUX_SIGCHLD && child_pid != 0) {
                written = user_write_join(written, user_write_u32(range, 8,
                    syscall_sigchld_code(child_status)));
                written = user_write_join(written, user_write_u32(range, 16,
                    child_pid as u32));
                written = user_write_join(written, user_write_u32(range, 24,
                    syscall_sigchld_status(child_status)));
            } else if (sender_pid == 0) {
                written = user_write_join(written, user_write_u32(range, 8,
                    LINUX_SI_KERNEL));
            } else {
                written = user_write_join(written, user_write_u32(range, 16,
                    sender_pid as u32));
            }
            written = user_write_join(written, user_write_u64(range, SIGFRAME_UC_SIGMASK,
                                      restore_mask as u64));
            // uc_stack, as Linux's __save_altstack: the stack as set, which
            // rt_sigreturn installs again.
            written = user_write_join(written, user_write_u64(range, SIGFRAME_UC_STACK,
                                      altstack.sp as u64));
            written = user_write_join(written, user_write_u32(range, SIGFRAME_UC_STACK + 8,
                                      altstack.flags as u32));
            written = user_write_join(written, user_write_u64(range, SIGFRAME_UC_STACK + 16,
                                      altstack.size as u64));
            for index: usize in 0..<31 {
                let register: usize = frame_general(frame, index);
                let mut saved: usize = register;
                if (index == 0) { saved = value; }
                written = user_write_join(written, user_write_u64(range, SIGFRAME_REGS + index * 8,
                                          saved as u64));
            }
            written = user_write_join(written, user_write_u64(range, SIGFRAME_SP, user_sp as u64));
            written = user_write_join(written, user_write_u64(range, SIGFRAME_PC,
                frame_elr_el1(frame) as u64));
            written = user_write_join(written, user_write_u64(range, SIGFRAME_PSTATE,
                frame_spsr_el1(frame) as u64));
            written = user_write_join(written, user_write_u32(range, SIGFRAME_FPSIMD,
                                      SIGFRAME_FPSIMD_MAGIC as u32));
            written = user_write_join(written, user_write_u32(range, SIGFRAME_FPSIMD + 4,
                                      SIGFRAME_FPSIMD_SIZE as u32));
            written = user_write_join(written, user_write_u32(range, SIGFRAME_FPSIMD + 8,
                frame_fpsr(frame) as u32));
            written = user_write_join(written, user_write_u32(range, SIGFRAME_FPSIMD + 12,
                frame_fpcr(frame) as u32));
            for word: usize in 0..<64 {
                written = user_write_join(written, user_write_u64(range, SIGFRAME_FPSIMD + 16 + word * 8,
                    frame_vector_word(frame, word) as u64));
            }
            match written {
                UserWriteResult::Fault => { return (false, 0); }
                UserWriteResult::Written => { return (true, base); }
            }
        }
    }
}

// Every Resume passes through here. With a caught signal pending and
// unmasked, the syscall's result goes into a signal frame and the process
// returns into its handler instead.
fn syscall_signal_deliver(current_authority: ProcessCurrent[current_process, ProcessState::Running], frame: MaybeFrame, action: SyscallAction)
        -> SyscallAction !{unsafe} {
    let value: usize = match action {
        SyscallAction::Resume(resumed) => { resumed }
        SyscallAction::Unreachable => { process_current_end(current_authority); return SyscallAction::Unreachable; }
        SyscallAction::Exit(status) => { process_current_end(current_authority); return SyscallAction::Exit(status); }
        SyscallAction::CloneChild(pid) => {
            process_current_end(current_authority); return SyscallAction::CloneChild(pid);
        }
        SyscallAction::CloneParent(sp) => {
            process_current_end(current_authority); return SyscallAction::CloneParent(sp);
        }
        SyscallAction::Block => { return syscall_block_interrupt(current_authority, frame); }
        SyscallAction::WaitInterrupt => { process_current_end(current_authority); return SyscallAction::WaitInterrupt; }
        SyscallAction::Migrate => { process_current_end(current_authority); return SyscallAction::Migrate; }
    };
    match frame {
        MaybeFrame::NoFrame => {
            kernel_process_current_suspend_mask_restore();
            process_current_end(current_authority); return SyscallAction::Resume(value);
        }
        MaybeFrame::Frame(present) => {
            return syscall_signal_deliver_into(current_authority, present, value);
        }
    }
}

const LINUX_SA_RESTART: usize = 0x10000000;

// GitHub issue #726, signal(7) "Interruption of system calls and library
// functions by signal handlers": the calls Linux never restarts after a
// handler, whatever SA_RESTART says. Each answers EINTR. Every other call
// that sleeps here -- read, readv and ppoll's terminal wait excepted, write
// and writev on the terminal, wait4, accept and accept4, the network reads
// -- restarts under SA_RESTART. rt_sigsuspend never reaches this question
// (process_signal_interrupt_of).
fn syscall_never_restarts(number: usize) -> bool {
    return number == AARCH64_NR_PPOLL || number == AARCH64_NR_NANOSLEEP ||
           number == AARCH64_NR_CLOCK_NANOSLEEP ||
           number == AARCH64_NR_RT_SIGTIMEDWAIT ||
           number == AARCH64_NR_RT_SIGSUSPEND;
}

// GitHub issue #726: every Block passes here before the process sleeps. A
// caught, unmasked signal already pending -- raised before the call, or
// the one whose wake made this a rerun -- interrupts the call instead:
// it returns EINTR, or under SA_RESTART is rewound with its first argument
// back in x0, and either way the handler runs first, from the frame
// syscall_signal_deliver_into builds. The block path's re-check under the
// run lock (kernel_process_block_would_miss) covers a signal raised after
// this, and kernel_process_signal_deliver_to one raised after the sleep.
private fn syscall_block_interrupt(
        current_authority: ProcessCurrent[current_process, ProcessState::Running],
        frame: MaybeFrame) -> SyscallAction !{unsafe} {
    match frame {
        MaybeFrame::NoFrame => {
            process_current_end(current_authority); return SyscallAction::Block;
        }
        MaybeFrame::Frame(present) => {
            match kernel_process_current_signal_interrupt(current_authority) {
                ProcessSignalInterrupt::Missing => {
                    process_current_end(current_authority); return SyscallAction::Block;
                }
                ProcessSignalInterrupt::Interrupt(interruption) => {
                    let flags: usize = interruption.flags;
                    let deadline: usize = interruption.deadline;
                    let number: usize = frame_general(present, 8);
                    if ((flags & LINUX_SA_RESTART) != 0 &&
                        syscall_never_restarts(number) == false) {
                        el0_context_retry_syscall(present);
                        return syscall_signal_deliver_into(current_authority, present,
                            frame_general(present, 0));
                    }
                    let mut result: usize = LINUX_EINTR;
                    let mut remaining: usize = 0;
                    if (number == AARCH64_NR_NANOSLEEP) {
                        remaining = frame_general(present, 1);
                    } else if (number == AARCH64_NR_CLOCK_NANOSLEEP &&
                               frame_general(present, 1) == 0) {
                        remaining = frame_general(present, 3);
                    }
                    if (remaining != 0 &&
                        syscall_sleep_remaining_write(current_authority,
                            remaining, deadline) == false) {
                        result = LINUX_EFAULT;
                    }
                    return syscall_signal_deliver_into(current_authority, present,
                                                       result);
                }
            }
        }
    }
}

// nanosleep's `rem` after a signal: the time from now to the deadline the
// sleep had armed, as a timespec, or zero once it has passed. False when
// `rem` faults, which Linux answers with EFAULT instead of EINTR.
private fn syscall_sleep_remaining_write(
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        address: usize, deadline: usize) -> bool {
    let now: usize = read_cntpct() as usize;
    let frequency: usize = read_cntfrq() as usize;
    let mut seconds: usize = 0;
    let mut nanoseconds: usize = 0;
    if (deadline > now && frequency != 0) {
        let left: usize = deadline - now;
        seconds = left / frequency;
        // Below one second of ticks times 10^9: fits in 64 bits for any
        // counter frequency under 18 GHz.
        nanoseconds = ((left % frequency) * 1000000000) / frequency;
    }
    match user_range_check_write(current_authority, address, 16) {
        UserWriteRangeResult::Fault => { return false; }
        UserWriteRangeResult::Ok(range) => {
            let mut written = user_write_u64(range, 0, seconds as u64);
            written = user_write_join(written, user_write_u64(range, 8, nanoseconds as u64));
            match written {
                UserWriteResult::Fault => { return false; }
                UserWriteResult::Written => { return true; }
            }
        }
    }
}

private fn syscall_signal_deliver_into(current_authority: ProcessCurrent[current_process, ProcessState::Running], here: borrow FrameRef[process, ExceptionLevel::El0],
                                       value: usize)
        -> SyscallAction !{unsafe} {
    match kernel_process_current_caught_signal_take() {
        ProcessSignalPendingResult::Missing => {
            kernel_process_current_suspend_mask_restore();
            process_current_end(current_authority); return SyscallAction::Resume(value);
        }
        ProcessSignalPendingResult::Pending(taken) => {
            if (signal_handler_enter(current_authority, here, value, taken) == false) {
                // Linux forces SIGSEGV when the frame cannot be written.
                let delivered: usize = taken_signal_delivered(taken);
                return kernel_syscall_exit_current_process(current_authority,
                    process_end_signaled(LINUX_SIGSEGV));
            }
            let signum: usize = taken_signal_delivered(taken);
            process_current_end(current_authority); return SyscallAction::Resume(signum);
        }
    }
}

// Point `here` at the handler for `taken`: write the frame that records
// the interrupted context, with x0 as `value`, below its user stack, then
// apply the handler's mask and SA_RESETHAND and set x1, x2, x30, SP and PC
// for the handler. x0 (the signal number) is the caller's to set, since a
// syscall return sets it from its result. False, with `here` and the
// handler table unchanged, when the frame cannot be written.
private fn signal_handler_enter(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                                here: borrow FrameRef[process, ExceptionLevel::El0], value: usize,
                                taken: borrow TakenSignal[signal])
        -> bool !{unsafe} {
    let signum: usize = taken_signal_number(taken);
    let mut handler: SignalAction =
        kernel_process_current_signal_action(current_authority, signum);
    let restore_mask: usize = kernel_process_current_frame_mask_take();
    // GitHub issue #1138, Linux's sigsp: an SA_ONSTACK handler runs from
    // the top of an enabled alternate stack the process is not already on;
    // on it, the frame stacks below the interrupted SP as usual.
    let mut altstack: SignalAltStack =
        kernel_process_current_signal_altstack(current_authority);
    let mut top: usize = frame_sp_el0(here);
    if ((handler.flags & LINUX_SA_ONSTACK) != 0 &&
        signal_altstack_state(altstack, top) == 0) {
        top = altstack.sp + altstack.size;
    }
    let (written, base) = syscall_signal_frame_write(current_authority,
        here, value, signum, restore_mask,
        taken_signal_child_pid(taken),
        taken_signal_child_status(taken),
        taken_signal_sender_pid(taken), top, altstack);
    if (written == false) {
        kernel_process_trace_signal_take(signum, ProcessTraceSignalFrameFault);
        return false;
    }
    if ((altstack.flags & LINUX_SS_AUTODISARM) != 0) {
        let mut disarmed: SignalAltStack = { 0, 0, LINUX_SS_DISABLE };
        kernel_process_current_set_signal_altstack(current_authority, disarmed);
    }
    kernel_process_trace_signal_take(signum, ProcessTraceSignalHandler);
    let mut handler_mask: usize = restore_mask | handler.mask;
    if ((handler.flags & LINUX_SA_NODEFER) == 0) {
        handler_mask = handler_mask | (1 << (signum - 1));
    }
    kernel_process_current_set_signal_mask(handler_mask);
    if ((handler.flags & LINUX_SA_RESETHAND) != 0) {
        let mut reset: SignalAction = { 0, 0, 0, 0 };
        kernel_process_current_set_signal_action(current_authority, signum, reset);
    }
    frame_general_set(here, 1, base);
    frame_general_set(here, 2, base + 128);
    frame_general_set(here, 30, handler.restorer);
    frame_sp_el0_set(here, base);
    frame_elr_el1_set(here, handler.handler);
    return true;
}

// GitHub issue #628: every return to EL0 runs a pending caught signal's
// handler, as Linux does on every return to user space -- the return from
// an interrupt taken in EL0 included, so a process that computes without
// making a syscall still runs its handler at its next timer tick.
//
// kernel_process_stack_switch_complete calls this last, on the stack of
// the process `frame` belongs to, which it has just made this CPU's own,
// with that process current, its root active and DAIF.I set. That hook
// ends every resume of a saved EL0 frame: the IRQ return (el0_irq_entry),
// whether or not its tick switched processes, and el0_context_resume, which
// every syscall return, switch and first start goes through. It is not the
// IRQ handler's context: the interrupt is acknowledged and the CPU is off
// its IRQ stack, which is why the frame write may grow the user stack here
// as it does from a syscall. A syscall return has already run its own
// signal through syscall_signal_deliver; a second pending one runs here,
// its frame stacked on the first, as Linux delivers every pending signal
// before it returns.
//
// The frame holds the whole interrupted context, as the entry saved it,
// and the signal frame records all of it, x0 included; rt_sigreturn puts
// it back. Two returns leave the signal pending instead:
// - The frame resumes at an SVC. That is a syscall rewound to rerun -- by a
//   signal's wake (#726), a Retry or a migration -- or one the process is
//   about to make; either way the syscall comes next, and its own return
//   runs the handler: before EINTR, or before the restart SA_RESTART asks
//   for. Taking the signal here would run the handler first and then rerun
//   the call with nothing left to interrupt it, so a wait4 or rt_sigsuspend
//   that a signal woke would go back to sleep.
//
// GitHub issue #949: two returns end the process instead, as Linux does on
// its way back to user space, so a process spinning without syscalls is
// not spared until its next one:
// - A pending, unmasked signal whose default action terminates (SIGKILL
//   always). It is taken first, whether or not the frame resumes at an
//   SVC: the syscall there would end the process at its entry anyway.
// - A caught signal whose frame cannot be written: Linux forces SIGSEGV.
fn kernel_signal_return_deliver(frame: borrow FrameRef[process, ExceptionLevel::El0]) !{unsafe} {
    let ProcessRunningHere::Running(current_authority) = process_running_here() else {};
    match kernel_process_current_termination_signal_take() {
        ProcessSignalPendingResult::Missing => {}
        ProcessSignalPendingResult::Pending(ending) => {
            let signum: usize = taken_signal_delivered(ending);
            signal_return_exit(current_authority, frame,
                process_end_signaled(signum));
            return;
        }
    }
    match kernel_process_current_caught_signal_take() {
        ProcessSignalPendingResult::Missing => {
            process_current_end(current_authority);
        }
        ProcessSignalPendingResult::Pending(taken) => {
            if (signal_resumes_at_svc(current_authority, frame)) {
                taken_signal_restore(taken);
                process_current_end(current_authority);
                return;
            }
            if (signal_handler_enter(current_authority, frame,
                    frame_general(frame, 0), taken) == false) {
                let lost: usize = taken_signal_delivered(taken);
                signal_return_exit(current_authority, frame,
                    process_end_signaled(LINUX_SIGSEGV));
                return;
            }
            frame_general_set(frame, 0, taken_signal_delivered(taken));
            process_current_end(current_authority);
        }
    }
}

// GitHub issue #846: retransmit every connection's due segments, from a
// context that holds no connection and no lock -- the return to EL0 after
// an interrupt (kernel_irq_return_complete below) and the idle loop
// (kernel/arch/arm64/kernel/secondary.tkb). Linux runs its retransmit
// timer as a softirq on the way out of an interrupt; this is that shape
// without a new thread. Nothing is due: one load and a branch. Otherwise
// the capability is taken only if it is free right now -- a syscall
// holding it is never waited for, and the next return tries again -- and
// tcp_retx_service_all bounds the work and skips a connection a syscall
// holds. A syscall itself still services only its own connection (#257).
fn kernel_net_retransmit_pass() !{may_block, unsafe} {
    if (tcp_retx_pass_due() == false) { return; }
    if (tcp_retx_pass_held()) { return; }
    match network_capability_take() {
        NetworkCapabilityTakeResult::Empty => {}
        NetworkCapabilityTakeResult::Ready(ready) => {
            let after: NetRxCanAcquire = tcp_retx_service_all(ready);
            match network_capability_put(after) {
                NetworkCapabilityPutResult::Stored => {}
                NetworkCapabilityPutResult::Conflict => {}
            }
        }
    }
}

// GitHub issue #846: el0_irq_entry's after_switch, and the only EL0
// return that runs the retransmit pass. Everything
// kernel_process_stack_switch_complete does for every EL0 return comes
// first. A syscall return (el0_context_resume) does not run the pass, as
// Linux runs softirqs at irq_exit and never on the way out of a syscall
// (maintainer, 2026-10-24); scripts/buildcheck_kernel_asm_invariants.py
// checks both halves in the linked image. Here the interrupt is
// acknowledged, the CPU is off its IRQ stack and on the process's own, and
// no lock is held, as kernel_signal_return_deliver's comment states. A
// return hook that ended the process does not come back here.
//
// The pass runs with interrupts unmasked (maintainer, 2026-10-24): a send
// waits for its TX completion (up to 14 ms on GEM), and that wait must not
// be interrupt latency. signal_return_exit unmasks from this hook the same
// way. An interrupt taken here enters el1_current_irq_entry on the
// process's own stack, which this CPU now owns, and never switches: kernel
// mode is not preempted. DAIF.I is set again with the raw instruction, not
// disable_irq: the generated restore after this hook relies on DAIF.I being
// set, and under the GIC priority mask (#920) disable_irq would mask at the
// GIC and leave DAIF.I clear. enable_irq lowers the priority mask and
// clears DAIF.I; after the pass the priority mask is reset for EL0 as
// kernel_process_stack_switch_complete resets it. scripts/buildcheck_kernel_asm_invariants.py checks
// that this function sets DAIF.I again after the pass and before it
// returns.
fn kernel_irq_return_complete(frame_sp: usize) !{unsafe} {
    kernel_process_stack_switch_complete(frame_sp);
    // GitHub issue #992: only a return to EL0 runs the pass; an El1 frame
    // resumes a kernel path that was preempted, which may hold what the pass
    // would take, and keeps the priority mask it had.
    match frame_ref_from_entry(frame_sp, kernel_process_entry_generation()) {
        LeveledFrame::El1(kernel_frame) => { return; }
        LeveledFrame::El0(user_frame) => {}
    }
    if (tcp_retx_pass_due() == false) { return; }
    enable_irq();
    kernel_net_retransmit_pass();
    msr_daifset_irq();
    // GitHub issue #920: and EL0 runs with the GIC priority mask unmasked,
    // whatever the pass left in it (its locks save and restore it, so this
    // is the hook's own reset again, not a repair).
    irq_mask_reset_el0();
}

// GitHub issue #949: end the current process from the return hook. Once
// kernel_process_stack_switch_complete has made the process's stack this
// CPU's own, this CPU is where a syscall's dispatch stands: the process
// current and Running, on its own stack, no lock held, the interrupt that
// led here acknowledged and its IRQ stack left. So the exit is the
// syscall's, with IRQs unmasked as .Lsyscall_dispatch unmasks them (the
// exit's file teardown may wait for a device interrupt), and its outcome
// is acted on as the syscall tail acts on it: a child hands the CPU to its
// successor or idles (kernel_syscall_clone_parent_return), PID 1 stops the
// kernel. Neither returns; the frame on this stack is abandoned with it.
private fn signal_return_exit(current_authority: ProcessCurrent[current_process, ProcessState::Running],
                              frame: borrow FrameRef[process, ExceptionLevel::El0],
                              status: ProcessEnd) !{unsafe} {
    kernel_activity_set(KernelActivity::Syscall);
    enable_irq();
    match kernel_syscall_exit_current_process(current_authority, status) {
        SyscallAction::CloneParent(parent_sp) => {
            kernel_syscall_clone_parent_return(parent_sp);
        }
        SyscallAction::Exit(code) => { kernel_syscall_init_exit(code); }
        _ => { }
    }
    // kernel_syscall_exit_current_process answers nothing else; the
    // syscall tail fail-stops on Unreachable (its file reap failed) too.
    kernel_invariant_stop_with_frame(frame);
}

// AArch64 SVC #imm16: 0xD4000001 with the immediate in bits 20..5.
const AARCH64_SVC_MASK: u32 = 0xFFE0001F;
const AARCH64_SVC: u32 = 0xD4000001;

// True when the instruction `frame` resumes at is an SVC. An unreadable PC
// is not one: the process faults there before it can make a syscall.
private fn signal_resumes_at_svc(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
                                 frame: borrow FrameRef[process, ExceptionLevel::El0]) -> bool !{unsafe} {
    match user_range_check_read(current_authority, frame_elr_el1(frame), 4) {
        UserReadRangeResult::Fault => { return false; }
        UserReadRangeResult::Ok(range) => {
            let (read_ok, instruction) = user_read_u32(range, 0);
            return read_ok && (instruction & AARCH64_SVC_MASK) == AARCH64_SVC;
        }
    }
}

// rt_sigreturn: put back what syscall_signal_frame_write saved. The frame
// is wherever the handler left SP, which is where the restorer calls from.
fn syscall_signal_return(current_authority: ProcessCurrent[current_process, ProcessState::Running], frame: MaybeFrame) -> SyscallAction !{unsafe} {
    match frame {
        MaybeFrame::NoFrame => {
            return syscall_finish_current(MaybeFrame::NoFrame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
        }
        MaybeFrame::Frame(present) => {
            return syscall_signal_return_into(current_authority, present);
        }
    }
}

private fn syscall_signal_return_into(current_authority: ProcessCurrent[current_process, ProcessState::Running], here: borrow FrameRef[process, ExceptionLevel::El0])
        -> SyscallAction !{unsafe} {
    let base: usize = frame_sp_el0(here);
    match user_range_check_read(current_authority, base,
                                SIGFRAME_SIZE) {
        UserReadRangeResult::Fault => {
            return kernel_syscall_exit_current_process(current_authority, process_end_signaled(LINUX_SIGSEGV));
        }
        UserReadRangeResult::Ok(range) => {
            let (magic_ok, magic) = user_read_u32(range, SIGFRAME_FPSIMD);
            let (size_ok, size) = user_read_u32(range, SIGFRAME_FPSIMD + 4);
            let (pc_ok, pc) = user_read_u64(range, SIGFRAME_PC);
            let (sp_ok, sp) = user_read_u64(range, SIGFRAME_SP);
            let (pstate_ok, pstate) = user_read_u64(range, SIGFRAME_PSTATE);
            let (mask_ok, mask) = user_read_u64(range, SIGFRAME_UC_SIGMASK);
            let (stack_sp_ok, stack_sp) = user_read_u64(range, SIGFRAME_UC_STACK);
            let (stack_flags_ok, stack_flags) = user_read_u32(range, SIGFRAME_UC_STACK + 8);
            let (stack_size_ok, stack_size) = user_read_u64(range, SIGFRAME_UC_STACK + 16);
            if (stack_sp_ok == false || stack_flags_ok == false ||
                stack_size_ok == false) {
                return kernel_syscall_exit_current_process(current_authority,
                    process_end_signaled(LINUX_SIGSEGV));
            }
            if (magic_ok == false || size_ok == false || pc_ok == false ||
                sp_ok == false || pstate_ok == false || mask_ok == false ||
                magic as usize != SIGFRAME_FPSIMD_MAGIC ||
                size as usize != SIGFRAME_FPSIMD_SIZE ||
                ((pc as usize) & 3) != 0) {
                return kernel_syscall_exit_current_process(current_authority,
                    process_end_signaled(LINUX_SIGSEGV));
            }
            let mut x0: usize = 0;
            for index: usize in 0..<31 {
                let (register_ok, register) =
                    user_read_u64(range, SIGFRAME_REGS + index * 8);
                if (index == 0) { x0 = register as usize; }
                frame_general_set(here, index, register as usize);
            }
            for word: usize in 0..<64 {
                let (vector_ok, vector) =
                    user_read_u64(range, SIGFRAME_FPSIMD + 16 + word * 8);
                frame_vector_word_set(here, word, vector as usize);
            }
            let (fpsr_ok, fpsr) = user_read_u32(range, SIGFRAME_FPSIMD + 8);
            let (fpcr_ok, fpcr) = user_read_u32(range, SIGFRAME_FPSIMD + 12);
            frame_fpsr_set(here, fpsr as usize);
            frame_fpcr_set(here, fpcr as usize);
            let kept_pstate: usize = frame_spsr_el1(here);
            frame_spsr_el1_set(here,
                (kept_pstate & ~SIGFRAME_PSTATE_USER_BITS) |
                ((pstate as usize) & SIGFRAME_PSTATE_USER_BITS));
            frame_sp_el0_set(here, sp as usize);
            frame_elr_el1_set(here, pc as usize);
            kernel_process_current_set_signal_mask(mask as usize);
            // GitHub issue #1138, Linux's restore_altstack: uc_stack goes
            // back in as a sigaltstack call from the restored SP would put
            // it, and a refusal (EPERM on that stack, EINVAL, ENOMEM) is
            // ignored as Linux ignores it.
            let restored: usize = signal_altstack_change(current_authority,
                sp as usize, stack_sp as usize, stack_flags as usize,
                stack_size as usize);
            return syscall_signal_deliver_into(current_authority, here, x0);
        }
    }
}

// rt_sigsuspend(mask, sigsetsize): wait, under `mask`, for a signal whose
// handler then runs; always -EINTR. The process's own mask is not replaced
// while it sleeps -- the wait set is what `mask` lets through -- so a rerun
// after the wake asks the question afresh.
fn syscall_signal_suspend(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], mask_address: usize, set_size: usize)
        -> SyscallAction !{unsafe} {
    if (set_size != 8) { return SyscallAction::Resume(LINUX_EINVAL); }
    kernel_process_current_clear_signal_suspend();
    let mut mask: usize = 0;
    match user_range_check_read(current_authority, mask_address, 8) {
        UserReadRangeResult::Fault => {
            return SyscallAction::Resume(LINUX_EFAULT);
        }
        UserReadRangeResult::Ok(range) => {
            let (read_ok, requested) = user_read_u64(range, 0);
            if (read_ok == false) { return SyscallAction::Resume(LINUX_EFAULT); }
            mask = requested as usize;
        }
    }
    return syscall_signal_suspend_under(current_authority, mask, false);
}

// The wait itself, once the caller's sigsuspend flag is clear: under `mask`,
// run a caught signal already pending, or Block until one arrives. A
// terminating signal ends the wait through the kill path's own wake.
// `pause` marks ppoll's pause() form, whose first block by /bin/ppoll-probe
// the ash lane's driver waits for before it lets the probe send its signal.
fn syscall_signal_suspend_under(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running], mask: usize,
                                pause: bool)
        -> SyscallAction !{unsafe} {
    kernel_process_current_suspend_mask_install(mask);
    match kernel_process_current_caught_signal_take() {
        ProcessSignalPendingResult::Pending(taken) => {
            // The return below takes it again and runs the handler under
            // the temporary mask; the frame restores the caller's.
            taken_signal_restore(taken);
            return SyscallAction::Resume(LINUX_EINTR);
        }
        ProcessSignalPendingResult::Missing => {}
    }
    kernel_process_current_suspend_mask_restore();
    let wait_set: usize = kernel_process_current_caught_set(current_authority, mask);
    kernel_process_current_prepare_signal_suspend(current_authority, wait_set);
    if (pause && syscall_terminal_ppoll_probe() &&
        syscall_test_evidence_record_ppoll_pause_block()) {
        kernel_boot_log("ppoll: pause blocked until a signal\n");
    }
    return SyscallAction::Block;
}

// `frame_sp` is the EL0 frame this syscall entered on, for a signal frame
// (GitHub issue #627); 0 from an in-kernel probe, which has none.
fn kernel_syscall_dispatch(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize, frame_sp: usize)
        -> (usize, usize) !{unsafe} {
    kernel_activity_set(KernelActivity::Syscall);
    workload_profile_note_syscall(number);
    // GitHub issue #580: sample the real BusyBox sleep applet at syscall
    // entry, before peer-safety policy can migrate its frame to core 0.
    workload_ordinary_placement_note_syscall(number);
    let mut caller_slot: ProcessSlot = kernel_syscall_process_slot();
    let (action_code, action_value) = syscall_action_encode(
        kernel_syscall_dispatch_action(esr, number, x0, x1, x2, x3, x4,
            maybe_frame_from_entry(frame_sp, kernel_process_entry_generation())));
    // GitHub issue #559: the ext2 reader registered at entry is done with
    // ext2 by the time the handler has chosen what happens next, whatever
    // that is -- Block and Migrate included. An execve that succeeded is the
    // exception (#597) and never returns here: its prepare reads the image,
    // and kernel_syscall_child_exec_return releases the registration then.
    if (syscall_ext2_reader_take()) { ext2_read_leave(); }
    // A call that completed no longer needs core 0 (GitHub issue #9). A
    // blocked or waiting one keeps the mark until it completes, and a
    // migrated one has only just been given it.
    if (action_code != 5 && action_code != 6 && action_code != 9) {
        kernel_process_clear_core0_for_call(caller_slot);
    }
    if (action_code == 6) {
        workload_profile_syscall_wait(number);
    } else {
        workload_profile_syscall_complete(number);
    }
    // GitHub issue #241/#244/#245 postmortem: action 0 (SyscallAction::
    // Unreachable) matches no branch in user_entry.S's dispatch table and
    // silently fail-stops with zero UART evidence. Naming the syscall
    // number here, right before that happens, is cheap and turns a
    // multi-hour cold-read-the-dispatch-table bisection into a one-line
    // lookup in SYSCALLS.md.
    if (action_code == 0) {
        kernel_boot_log_syscall_unreachable(number);
    }
    return (action_code, action_value);
}

// GitHub issue #1080: execve succeeded and is past its point of no return.
// The call completed, so it gets kernel_syscall_dispatch's completion
// bookkeeping here, and then the exec's tail runs on the Takibi side instead
// of in user_entry.S. Its ext2 reader registration is still held; the tail
// releases it after the prepare. The frame is the one the syscall entered
// on: an in-kernel probe, which has none, was answered ENOSYS before execve.
private fn kernel_syscall_dispatch_child_exec(number: usize,
        frame: FrameRef[process, ExceptionLevel::El0], args_page: sink PageOwner[page]) !{unsafe} {
    kernel_process_clear_core0_for_call(kernel_syscall_process_slot());
    workload_profile_syscall_complete(number);
    kernel_syscall_child_exec_return(frame, args_page);
}

// Linux's reboot ABI is decoded before any world-stop request. Alternate
// magic2 values are real Linux ABI values, not commands or permissions.
must_use variant SyscallRebootRequest {
    Invalid;
    Cad;
    Halt;
    Restart;
    PowerOff;
}

fn syscall_reboot_request(magic1: usize, magic2: usize, command: usize)
        -> SyscallRebootRequest {
    // Linux declares these arguments as int, int, and unsigned int.
    let first: u32 = magic1 as u32;
    let second: u32 = magic2 as u32;
    let cmd: u32 = command as u32;
    if (first != 0xFEE1DEAD ||
        (second != 672274793 && second != 85072278 &&
         second != 369367448 && second != 537993216)) {
        return SyscallRebootRequest::Invalid;
    }
    match cmd {
        0x00000000 => { return SyscallRebootRequest::Cad; }
        0x89ABCDEF => { return SyscallRebootRequest::Cad; }
        0xCDEF0123 => { return SyscallRebootRequest::Halt; }
        0x01234567 => { return SyscallRebootRequest::Restart; }
        0x4321FEDC => { return SyscallRebootRequest::PowerOff; }
        _ => { return SyscallRebootRequest::Invalid; }
    }
}

// All three terminal requests park the machine on both platforms. Restart
// does not re-enter boot, and poweroff does not remove physical power. The
// complete WorldStopped token is required before any success marker appears.
// A failed request releases its partial stop and lets userspace retry.
//
// GitHub issue #980: Linux's order. Everything that takes a lock (here the
// console drain, Linux's kernel_restart_prepare) runs before the stop, and
// the stop is the debug stop, which escalates to the pseudo-NMI so a core
// hung with IRQs masked no longer blocks reboot. A core it holds may own any
// lock, so what follows the stop is a debug_stopped root: lock-free output
// and platform_shutdown only (Linux's machine_restart, PSCI only).
fn syscall_system_stop(marker: *u8) -> SyscallAction !{unsafe} {
    uart_tx_flush();
    return SyscallAction::Resume(syscall_system_stop_stopped(marker));
}

// The errno of a refused stop; a complete stop never returns.
private fn syscall_system_stop_stopped(marker: *u8) -> usize
        !{unsafe, debug_stopped} {
    match world_stop_debug_begin(10000000) {
        MachineStopResult::Busy => { return LINUX_EAGAIN; }
        MachineStopResult::Partial(partial) => {
            machine_stop_partial_release(partial, &kernel_world_stop);
            return LINUX_EAGAIN;
        }
        MachineStopResult::Complete(stopped) => {
            disable_irq();
            let mask: usize = machine_stopped_mask(stopped);
            machine_stop_keep_forever(stopped);
            // Output queued between the drain above and the stop goes out
            // only if the console lock is free (a held core may own it).
            uart_tx_flush_stopped();
            // GitHub issue #933: name the initiating core, so a test that
            // pins the caller to a peer can tell a local stop from a rerun
            // on core 0. Printed before the marker drivers wait for.
            ddb_puts("\n" as *u8);
            ddb_puts("system stop: initiator cpu=" as *u8);
            ddb_put_udec(cpu_id());
            ddb_puts("\n" as *u8);
            // GitHub issue #980: the cores the stop holds, and the one the
            // hung-core lane made spin with IRQs masked (none outside it).
            ddb_puts("system stop: mask=" as *u8);
            ddb_put_hex(mask);
            let spinning: usize = uart_irq_hang_active_cpu();
            if (spinning == 0) {
                ddb_puts(" masked-spin=none\n" as *u8);
            } else {
                ddb_puts(" masked-spin=cpu" as *u8);
                ddb_put_udec(spinning - 1);
                ddb_puts("\n" as *u8);
            }
            ddb_puts(marker);
            platform_shutdown();
            while (true) { wfi(); }
            // Variant-return checking does not treat a terminal loop as a return.
            return LINUX_EAGAIN;
        }
    }
}

fn syscall_reboot(magic1: usize, magic2: usize, command: usize)
        -> SyscallAction !{unsafe} {
    match syscall_reboot_request(magic1, magic2, command) {
        SyscallRebootRequest::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
        SyscallRebootRequest::Cad => { return SyscallAction::Resume(0); }
        SyscallRebootRequest::Halt => {
            return syscall_system_stop("system stop: halt (all cores parked)\n" as *u8);
        }
        SyscallRebootRequest::Restart => {
            return syscall_system_stop("system stop: restart (all cores parked)\n" as *u8);
        }
        SyscallRebootRequest::PowerOff => {
            return syscall_system_stop("system stop: poweroff (all cores parked)\n" as *u8);
        }
    }
}

// The procfs half of openat: a virtual node, never ext2.
private fn syscall_openat_procfs(node: ProcfsNode, flags: usize)
        -> SyscallAction !{unsafe} {
    let access_mode: usize = flags & 3;
    if (access_mode != 0 && (access_mode == 3 ||
            procfs_node_is_writable(node) == false)) {
        return SyscallAction::Resume(LINUX_EACCES);
    }
    let fd: usize = match unified_fd_alloc(
            kernel_syscall_process_key(), 0) {
        UnifiedFdAllocResult::Full => {
            return SyscallAction::Resume(LINUX_EMFILE);
        }
        UnifiedFdAllocResult::Allocated(allocated) => { allocated }
    };
    return kernel_syscall_procfs_open(node, fd);
}

// The descriptor half of openat, once the path has named an ext2 inode --
// found by lookup, or just made by O_CREAT (GitHub issue #967).
private fn syscall_openat_inode(mount: Ext2Mount, inode_number: usize,
        flags: usize) -> SyscallAction !{unsafe} {
    let access_mode: usize = flags & 3;
    match unified_fd_alloc(kernel_syscall_process_key(), 0) {
        UnifiedFdAllocResult::Full => {
            kernel_boot_log_resource_exhausted(
                "process fd table" as *u8,
                kernel_syscall_fd_limit_soft());
            return SyscallAction::Resume(LINUX_EMFILE);
        }
        UnifiedFdAllocResult::Allocated(fd) => {
            let inode_mode: usize = ext2_inode_mode(
                mount, inode_number);
            if ((inode_mode & 0xF000) == 0x4000) {
                match unified_directory_open(
                        kernel_syscall_process_key(), fd,
                        inode_number) {
                    UnifiedOpenResult::Invalid => {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    UnifiedOpenResult::Full => {
                        kernel_boot_log_resource_exhausted(
                            "shared object pool" as *u8,
                            unified_object_max_files());
                        return SyscallAction::Resume(LINUX_ENFILE);
                    }
                    UnifiedOpenResult::Ok => {
                        return SyscallAction::Resume(fd);
                    }
                }
            }
            match unified_file_open(
                    kernel_syscall_process_key(), fd, inode_number,
                    access_mode != 1, access_mode != 0) {
                UnifiedOpenResult::Invalid => {
                    return SyscallAction::Resume(LINUX_EBADF);
                }
                UnifiedOpenResult::Full => {
                    kernel_boot_log_resource_exhausted(
                        "shared object pool" as *u8,
                        unified_object_max_files());
                    return SyscallAction::Resume(LINUX_ENFILE);
                }
                UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
            }
        }
    }
}

private fn syscall_openat_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    // openat(dirfd, pathname, flags) without O_CREAT: absolute paths start
    // at the ext2 root; relative paths use an open directory fd (or
    // AT_FDCWD, whose unsigned value lies outside the descriptor namespace).
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, x1) {
        SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
        SyscallPathResult::Name(path) => { path }
    };
    match procfs_lookup(path_name) {
        ProcfsLookupResult::Missing => {}
        ProcfsLookupResult::Found(node) => {
            return syscall_openat_procfs(node, x2);
        }
    }
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    let mut lookup_inode: usize = 2;
    if (path_view[0] != 0x2F && x0 != LINUX_AT_FDCWD) {
        if (kernel_syscall_directory_is_open(x0) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        lookup_inode = kernel_syscall_directory_inode(x0);
    }
    match ext2_lookup_path_from(
        mount,
        lookup_inode,
        path_name) {
        Ext2LookupResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
        Ext2LookupResult::NotFound => {
            return SyscallAction::Resume(LINUX_ENOENT);
        }
        Ext2LookupResult::Found(inode_number) => {
            return syscall_openat_inode(mount, inode_number, x2);
        }
    }
}

// GitHub issue #967: openat with O_CREAT, its lookup, creation and open one
// section under the mutation guard its caller holds, as mkdirat's are
// (#597). An existing name opens as without O_CREAT (EEXIST under O_EXCL,
// EISDIR for a directory, as Linux says); a missing one becomes an empty
// regular file with the mode argument less the umask (#1147); every
// process is root. ENOSPC when the inode bitmap has no clear bit or the
// parent would have to grow and cannot; nothing is changed then.
//
// GitHub issue #1016: O_TRUNC, with or without O_CREAT, comes here too. An
// existing regular file loses its blocks and its size before it opens, as
// Linux does whatever the access mode; without O_CREAT a missing name is
// ENOENT and O_EXCL means nothing. O_TRUNC asks for write access, so a
// directory is EISDIR.
private fn syscall_openat_create_under(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, x2: usize, permissions: usize) -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_openat_create_under_with(slot,
            current_authority, guard, x0, x1, x2, permissions);
    syscall_slot_release(slot);
    return action;
}

private fn syscall_openat_create_under_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        guard: borrow Ext2MutationGuard[ext2_mutation],
        x0: usize, x1: usize, x2: usize, permissions: usize) -> SyscallAction !{unsafe} {
    let create: bool = (x2 & LINUX_O_CREAT) != 0;
    let exclusive: bool = create && (x2 & LINUX_O_EXCL) != 0;
    let truncate: bool = (x2 & LINUX_O_TRUNC) != 0;
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, x1) {
        SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
        SyscallPathResult::Name(path) => { path }
    };
    match procfs_lookup(path_name) {
        ProcfsLookupResult::Missing => {}
        ProcfsLookupResult::Found(node) => {
            if (exclusive) { return SyscallAction::Resume(LINUX_EEXIST); }
            return syscall_openat_procfs(node, x2);
        }
    }
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    let absolute: bool = path_view[0] == 0x2F;
    let parent: SyscallParent = match kernel_syscall_parent_of(mount,
            x0, absolute, path_name) {
        SyscallParentResult::Errno(errno) => {
            return SyscallAction::Resume(errno);
        }
        SyscallParentResult::Found(found) => { found }
    };
    let leaf: []u8 = kernel_syscall_leaf(path_name, parent);
    // A trailing slash, `/`, `.` and `..` all name a directory, and
    // O_CREAT on a directory is EISDIR (EEXIST first under O_EXCL).
    let names_directory: bool = leaf.len == 0 ||
        parent.leaf_end != path_name.len ||
        kernel_syscall_leaf_is_dot(leaf) ||
        kernel_syscall_leaf_is_dot_dot(leaf);
    if (names_directory) {
        if (exclusive) { return SyscallAction::Resume(LINUX_EEXIST); }
        return SyscallAction::Resume(LINUX_EISDIR);
    }
    match ext2_syscall_open_leaf(mount, guard, parent.inode, leaf,
                                 create, exclusive, truncate, permissions) {
        Ext2SyscallOpenResult::Errno(errno) => {
            return SyscallAction::Resume(errno);
        }
        Ext2SyscallOpenResult::Opened(inode_number) => {
            return syscall_openat_inode(mount, inode_number, x2);
        }
    }
}

// GitHub issue #1022: truncate(path, length) and ftruncate(fd, length), to
// length 0 only, through openat O_TRUNC's walk (#1016) and under the
// mutation guard their caller holds; any other length is EINVAL, which
// Linux also answers for a negative one. truncate looks the path up as
// faccessat does, from `/` (the one cwd) or absolutely: a directory is
// EISDIR, anything else not regular EINVAL, a missing path ENOENT.
// ftruncate wants an ext2 file open for writing (EINVAL otherwise, as
// Linux; EBADF for no descriptor at all) and leaves its offset alone.
private fn syscall_truncate_under(current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        guard: borrow Ext2MutationGuard[ext2_mutation],
        number: usize, x0: usize, x1: usize) -> usize !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let answer: usize = syscall_truncate_under_with(slot, current_authority,
            guard, number, x0, x1);
    syscall_slot_release(slot);
    return answer;
}

private fn syscall_truncate_under_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[current_process, ProcessState::Running],
        guard: borrow Ext2MutationGuard[ext2_mutation],
        number: usize, x0: usize, x1: usize) -> usize !{unsafe} {
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return LINUX_EBADF; }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let mut inode_number: usize = 0;
    if (number == AARCH64_NR_FTRUNCATE) {
        if (kernel_syscall_file_is_open(x0) == false) {
            if (kernel_syscall_directory_is_open(x0) ||
                kernel_syscall_terminal_is_open(x0)) {
                return LINUX_EINVAL;
            }
            return LINUX_EBADF;
        }
        if (kernel_syscall_file_writable(x0) == false) { return LINUX_EINVAL; }
        inode_number = kernel_syscall_file_inode(x0);
    } else {
        let path_name: []u8 = match kernel_syscall_path_name(slot,
                current_authority, x0) {
            SyscallPathResult::Fault => { return LINUX_EFAULT; }
            SyscallPathResult::Invalid => { return LINUX_ENOENT; }
            SyscallPathResult::Name(path) => { path }
        };
        match ext2_lookup_path_from(mount, 2, path_name) {
            Ext2LookupResult::Invalid => { return LINUX_EINVAL; }
            Ext2LookupResult::NotFound => { return LINUX_ENOENT; }
            Ext2LookupResult::Found(found) => { inode_number = found; }
        }
    }
    if (x1 != 0) { return LINUX_EINVAL; }
    let mode: usize = ext2_inode_mode(mount, inode_number) & 0xF000;
    if (mode == 0x4000) { return LINUX_EISDIR; }
    if (mode != 0x8000) { return LINUX_EINVAL; }
    match ext2_truncate_regular_file(mount, inode_number) {
        Ext2TruncateResult::Invalid => { return LINUX_EIO; }
        Ext2TruncateResult::Truncated => { return 0; }
    }
}

private fn syscall_openat(current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_openat_with(slot, current_authority, x0, x1, x2);
    syscall_slot_release(slot);
    return action;
}

private fn syscall_faccessat_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        number: usize, x0: usize, x1: usize, x2: usize, x3: usize)
        -> SyscallAction !{unsafe} {
    // access(path, mode), faccessat(dirfd, path, mode), and faccessat2
    // with its fourth flags argument share the inode-mode verdict.
    // Real and effective identities are identical in this kernel, so
    // AT_EACCESS selects the same mode check. Other flags require path
    // behavior (such as no-follow or empty-path) that is not supported.
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    let mut path_address: usize = x1;
    let mut requested_mode: usize = x2;
    let mut dirfd: usize = x0;
    if (number == 21) {
        path_address = x0;
        requested_mode = x1;
        dirfd = LINUX_AT_FDCWD;
    }
    if (requested_mode > 7 ||
        (number == 439 && x3 != 0 && x3 != LINUX_AT_EACCESS)) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, path_address) {
        SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
        SyscallPathResult::Name(path) => { path }
    };
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    let mut lookup_inode: usize = 2;
    if (path_view[0] != 0x2F && dirfd != LINUX_AT_FDCWD) {
        if (kernel_syscall_directory_is_open(dirfd) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        lookup_inode = kernel_syscall_directory_inode(dirfd);
    }
    match ext2_lookup_path_from(
            mount,
            lookup_inode,
            path_name) {
        Ext2LookupResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
        Ext2LookupResult::NotFound => { return SyscallAction::Resume(LINUX_ENOENT); }
        Ext2LookupResult::Found(inode_number) => {
            let inode_mode: usize =
                ext2_inode_mode(mount, inode_number);
            if (syscall_inode_mode_allows(inode_mode, requested_mode)) {
                return SyscallAction::Resume(0);
            }
            return SyscallAction::Resume(LINUX_EACCES);
        }
    }
}

private fn syscall_faccessat(current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        number: usize, x0: usize, x1: usize, x2: usize, x3: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_faccessat_with(slot, current_authority, number, x0, x1, x2, x3);
    syscall_slot_release(slot);
    return action;
}

private fn syscall_newfstatat_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    // newfstatat(AT_FDCWD, path, stat, flags): return the bounded ext2
    // file, directory, or applet-link shape after validating the complete
    // userspace result.
    let path_name: []u8 = match kernel_syscall_path_name(slot, current_authority, x1) {
        SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
        SyscallPathResult::Name(path) => { path }
    };
    match procfs_lookup(path_name) {
        ProcfsLookupResult::Missing => {}
        ProcfsLookupResult::Found(node) => {
            match user_range_check_write(current_authority, x2, 128) {
                UserWriteRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserWriteRangeResult::Ok(range) => {
                    let mut written = user_zero_fill(range);
                    written = user_write_join(written, user_write_u64(range, 8, node.inode as u64));
                    if (procfs_node_is_directory(node)) {
                        written = user_write_join(written, user_write_u32(range, 16, 0x416D as u32));
                        written = user_write_join(written, user_write_u32(range, 20, 2));
                    } else {
                        written = user_write_join(written, user_write_u32(range, 16, 0x8124 as u32));
                        written = user_write_join(written, user_write_u32(range, 20, 1));
                    }
                    match written {
                        UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                        UserWriteResult::Written => { return SyscallAction::Resume(0); }
                    }
                }
            }
        }
    }
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    let mut lookup_inode: usize = 2;
    if (path_view[0] != 0x2F && x0 != LINUX_AT_FDCWD) {
        if (kernel_syscall_directory_is_open(x0) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        lookup_inode = kernel_syscall_directory_inode(x0);
    }
    match user_range_check_write(current_authority, x2, 128) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(precheck) => {}
    }
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    match ext2_lookup_path_from(
            mount,
            lookup_inode,
            path_name) {
        Ext2LookupResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
        Ext2LookupResult::NotFound => { return SyscallAction::Resume(LINUX_ENOENT); }
        Ext2LookupResult::Found(inode_number) => {
            let inode_mode: usize = ext2_inode_mode(
                mount, inode_number);
            if ((inode_mode & 0xF000) == 0x4000) {
                match user_range_check_write(current_authority, x2, 128) {
                    UserWriteRangeResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    UserWriteRangeResult::Ok(range) => {
                        let mut written = user_zero_fill(range);
                        written = user_write_join(written, user_write_u64(range, 8, inode_number as u64));
                        written = user_write_join(written, user_write_u32(range, 16, inode_mode as u32));
                        written = user_write_join(written, user_write_u32(range, 20, 2));
                        written = user_write_join(written, user_write_u64(
                            range,
                            48,
                            ext2_inode_size(
                                mount,
                                inode_number) as u64));
                        match written {
                            UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                            UserWriteResult::Written => { return SyscallAction::Resume(0); }
                        }
                    }
                }
            }
            if (ext2_inode_is_symlink(
                    mount, inode_number)) {
                match user_range_check_write(current_authority, x2, 128) {
                    UserWriteRangeResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    UserWriteRangeResult::Ok(range) => {
                        let mut written = user_zero_fill(range);
                        written = user_write_join(written, user_write_u64(range, 8, inode_number as u64));
                        // Present the ext2-resident BusyBox target as an
                        // executable regular file to ash's command probe.
                        written = user_write_join(written, user_write_u32(range, 16, 0x81ED as u32));
                        written = user_write_join(written, user_write_u32(range, 20, 1));
                        match written {
                            UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                            UserWriteResult::Written => { return SyscallAction::Resume(0); }
                        }
                    }
                }
            }
            match user_range_check_write(current_authority, x2, 128) {
                UserWriteRangeResult::Fault => {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                UserWriteRangeResult::Ok(range) => {
                    let mut written = user_zero_fill(range);
                    written = user_write_join(written, user_write_u64(range, 8, inode_number as u64));
                    // GitHub issue #1147: the inode's own mode, which a
                    // create's mode and umask decide; it read 0644 always.
                    written = user_write_join(written, user_write_u32(range, 16, inode_mode as u32));
                    written = user_write_join(written, user_write_u32(range, 20, 1));
                    written = user_write_join(written, user_write_u64(range, 48,
                                   ext2_inode_size(
                                       mount,
                                       inode_number) as u64));
                    written = user_write_join(written, user_write_u32(range, 56, 1024));
                    written = user_write_join(written, user_write_u64(range, 64, 2));
                    match written {
                        UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                        UserWriteResult::Written => { return SyscallAction::Resume(0); }
                    }
                }
            }
        }
    }
}

private fn syscall_newfstatat(current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_newfstatat_with(slot, current_authority, x0, x1, x2);
    syscall_slot_release(slot);
    return action;
}

private fn syscall_chdir_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize)
        -> SyscallAction !{unsafe} {
    match user_range_check_read(current_authority, x0, 2) {
        UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserReadRangeResult::Ok(range) => {
            zero_fill(syscall_scratch[slot.index].path_buffer as []u8);
            let path_view: []u8 = syscall_scratch[slot.index].path_buffer as []u8;
            if (copy_from_user(range, path_view[0..<2]) &&
                    (path_view[0] == 0x2F || path_view[0] == 0x2E) &&
                    path_view[1] == 0) {
                return SyscallAction::Resume(0);
            }
        }
    }
    return SyscallAction::Resume(LINUX_ENOENT);
}

private fn syscall_chdir(current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_chdir_with(slot, current_authority, x0);
    syscall_slot_release(slot);
    return action;
}

private fn syscall_prlimit64_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize, x1: usize, x2: usize, x3: usize)
        -> SyscallAction !{unsafe} {
    // pid 0 is "me". A real pid is accepted only when it is this
    // process's own: reaching into another process's descriptor
    // limits mid-syscall is a cross-process write this kernel has no
    // safe path for, and ESRCH is what Linux reports for a pid it
    // will not act on.
    if (x0 != 0 && x0 != kernel_process_current_pid()) {
        return SyscallAction::Resume(LINUX_ESRCH);
    }
    // A resource number Linux does not have is EINVAL there, and was
    // silently "unlimited" here -- which answered a question about a
    // resource that does not exist. RLIM_NLIMITS is 16.
    if (x1 >= LINUX_RLIM_NLIMITS) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    // GitHub issue #954: per-call scratch, not zero-filled. The two 8-byte
    // stores below initialize [0, 8) and [8, 16) (syscall_rlimit_store's
    // ensures), and a successful copy_from_user_span all 16 bytes.
    let mut soft: usize = LINUX_RLIM64_INFINITY;
    let mut hard: usize = LINUX_RLIM64_INFINITY;
    if (x1 == LINUX_RLIMIT_NOFILE) {
        match unified_process_fd_limit(kernel_syscall_process_key()) {
            UnifiedFdLimitResult::Missing => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            UnifiedFdLimitResult::Found(pair) => {
                let (live_soft, live_hard) = pair;
                soft = live_soft;
                hard = live_hard;
            }
        }
    }
    // The OLD value is reported before the new one is applied, which
    // is prlimit64's own contract and the reason one call can do both.
    if (x3 != 0) {
        match user_range_check_write(current_authority, x3,
                                     sizeof(usize) * 2) {
            UserWriteRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserWriteRangeResult::Ok(range) => {
                let old_bytes = syscall_scratch[slot.index].rlimit_buffer as []u8;
                syscall_rlimit_store(old_bytes[0..<8], soft);
                syscall_rlimit_store(old_bytes[8..<16], hard);
                let reported: []u8 = old_bytes[0..<16];
                match copy_to_user(range, reported) {
                    UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                    UserWriteResult::Written => {}
                }
            }
        }
    }
    if (x2 == 0) { return SyscallAction::Resume(0); }
    match user_range_check_read(current_authority, x2,
                                sizeof(usize) * 2) {
        UserReadRangeResult::Fault => {
            return SyscallAction::Resume(LINUX_EFAULT);
        }
        UserReadRangeResult::Ok(range) => {
            if (copy_from_user_span(
                    range,
                    syscall_scratch[slot.index].rlimit_buffer as []u8,
                    0, sizeof(usize) * 2) == false) {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
        }
    }
    let new_bytes = syscall_scratch[slot.index].rlimit_buffer as []u8;
    let new_soft: usize = syscall_rlimit_load(new_bytes[0..<8]);
    let new_hard: usize = syscall_rlimit_load(new_bytes[8..<16]);
    if (new_soft > new_hard) { return SyscallAction::Resume(LINUX_EINVAL); }
    // Every other resource Linux HAS is genuinely unlimited in this
    // kernel -- there is no storage sized by one and nothing that
    // checks one -- so a write to it is accepted and there is nothing
    // to store. That is the true answer; a resource number Linux does
    // not have at all was refused above.
    if (x1 != LINUX_RLIMIT_NOFILE) { return SyscallAction::Resume(0); }
    match unified_process_fd_limit_configure(
            kernel_syscall_process_key(), new_soft, new_hard) {
        UnifiedFdResult::Invalid => {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        UnifiedFdResult::Ok => { return SyscallAction::Resume(0); }
    }
}

private fn syscall_prlimit64(current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize, x1: usize, x2: usize, x3: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_prlimit64_with(slot, current_authority, x0, x1, x2, x3);
    syscall_slot_release(slot);
    return action;
}

private fn syscall_uname_with(slot: borrow SyscallSlot[0],
        current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize)
        -> SyscallAction !{unsafe} {
    match user_range_check_write(current_authority, x0, sizeof(Utsname)) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(range) => {
            // GitHub issue #203: zero every byte, the unused tail of each
            // field included, before any view of the buffer exists;
            // without this fill the copy-out is rejected.
            zero_fill(syscall_scratch[slot.index].uname_buffer as []u8);
            let uname_bytes = syscall_scratch[slot.index].uname_buffer as []u8;
            uname_write_field(uname_bytes[
                                  offsetof(Utsname, sysname)..<
                                  offsetof(Utsname, sysname) +
                                      UTSNAME_FIELD_SIZE],
                              bs"Linux");
            uname_write_field(uname_bytes[
                                  offsetof(Utsname, nodename)..<
                                  offsetof(Utsname, nodename) +
                                      UTSNAME_FIELD_SIZE],
                              bs"takibi");
            uname_write_field(uname_bytes[
                                  offsetof(Utsname, release)..<
                                  offsetof(Utsname, release) +
                                      UTSNAME_FIELD_SIZE],
                              bs"6.1.0-takibi");
            uname_write_field(uname_bytes[
                                  offsetof(Utsname, version)..<
                                  offsetof(Utsname, version) +
                                      UTSNAME_FIELD_SIZE],
                              bs"#1");
            uname_write_field(uname_bytes[
                                  offsetof(Utsname, machine)..<
                                  offsetof(Utsname, machine) +
                                      UTSNAME_FIELD_SIZE],
                              bs"aarch64");
            uname_write_field(uname_bytes[
                                  offsetof(Utsname, domainname)..<
                                  offsetof(Utsname, domainname) +
                                      UTSNAME_FIELD_SIZE],
                              bs"(none)");
            let source: []u8 = uname_bytes[0..<sizeof(Utsname)];
            match copy_to_user(range, source) {
                UserWriteResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserWriteResult::Written => {
                    return SyscallAction::Resume(0);
                }
            }
        }
    }
}

private fn syscall_uname(current_authority: borrow ProcessCurrent[process, ProcessState::Running],
        x0: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let action: SyscallAction = syscall_uname_with(slot, current_authority, x0);
    syscall_slot_release(slot);
    return action;
}

fn kernel_syscall_dispatch_action(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize, frame: MaybeFrame)
        -> SyscallAction !{unsafe} {
    let ProcessRunningHere::Running(current_authority) = process_running_here() else {};
    let exception_class: usize = (esr >> 26) & 0x3F;
    if (exception_class != 0x15) { return syscall_finish_current(frame, SyscallAction::Unreachable, current_authority); }
    // GitHub issue #9: the migration gate, before this syscall touches any
    // kernel state. A process on a peer because its affinity mask put it
    // there runs only what syscall_peer_safe allows; any other syscall is
    // rerun on core 0. A fixture the per-pid rule admits keeps its own
    // audit instead.
    // GitHub issue #579: this CPU may no longer run this process AT ALL --
    // its affinity mask has stopped naming this CPU, which is what happens
    // the moment a process re-pins itself with sched_setaffinity. Hand it
    // back before asking anything else about the syscall.
    //
    // Nothing else could do this. `kernel_process_affinity_set` asks for a
    // reschedule, and `kernel_process_schedule` returns the current frame
    // unchanged when no OTHER process is Ready on this CPU -- so a peer with
    // nothing else to run kept a process its mask had already excluded. That
    // was invisible while the only transition anybody exercised was core 0
    // to CPU 1, where the fixture keeps a spinner Ready on core 0 for
    // exactly this reason, and it is what stopped a process reaching cores 2
    // and 3.
    //
    // A peer that hands a process back has somewhere to go: the architectural
    // idle loop it booted into. Core 0 does not rewind the call; it lets it
    // finish and hands the process away at the return (below).
    // core-role: a peer rewinds a call its mask excludes and idles; core 0
    // lets the call finish and hands the process away at the return
    if (cpu_id() != 0) {
        // Affinity may have been changed by another CPU. Take the process
        // run lock for this scheduling-boundary snapshot, then release it
        // before the migration path acquires the same lock.
        let guard = process_run_lock();
        let current_cpu_allows: bool =
            kernel_process_current_cpu_allows(guard);
        process_run_unlock(guard);
        if (current_cpu_allows == false) { return syscall_finish_current(frame, SyscallAction::Migrate, current_authority); }
    } else {
        // GitHub issue #581: the same question on core 0. A process whose
        // mask excludes core 0 is here only because it was born here (clone
        // runs on core 0) or because the gate above sent it one syscall that
        // has now finished. Without this it stayed until the next timer
        // tick, which a short-lived process such as an HTTPd connection
        // handler never reaches. The reschedule lets the syscall return
        // switch to another process core 0 may run; with none Ready, that
        // return parks this one Ready and idles core 0 (#592).
        kernel_process_reschedule_if_excluded_here();
    }
    // core-role: calls outside the peer-safety table run on core 0 (the
    // parent-progress report)
    if (cpu_id() != 0 && syscall_peer_safe(number, x0, x1) == false) {
        return syscall_finish_current(frame, SyscallAction::Migrate, current_authority);
    }
    // GitHub issue #533: a reader must not read a tree that is being
    // rewritten. The mutators hold kernel/fs/ext2/mutation_lock.tkb; this
    // asks, with one acquire-load and no wait, whether one is inside right
    // now. If so, the calling core -- any core -- waits for an interrupt
    // and reruns the syscall (GitHub issues #597, #775).
    //
    // GitHub issue #533: asked of anything that reaches ext2, independently
    // of whether the peer-safe table admits it. A normal process can now run
    // on any online core without being named by a fixture; this mutation
    // check must therefore remain attached to the operation, not to how the
    // process was placed.
    //
    // GitHub issue #559: and the answer is now also a registration. A peer
    // reader that finds no mutation in flight is counted until this syscall
    // is done (kernel_syscall_dispatch releases it), and a mutation that
    // starts meanwhile waits for it -- the entry question alone let a
    // mutation start during an admitted read. A call the peer-safety table
    // refuses has been sent to core 0 above already.
    if (syscall_reaches_filesystem(number, x0, x2)) {
        if (ext2_read_enter() == false) {
            // GitHub issue #775: every core waits in place. A peer used to
            // hand the call to core 0 to wait there, which changed the
            // process's placement for a condition no core owns.
