            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (kernel_listener_set_state(
                listen_fd, UnifiedListenerState::Listening) == false) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        match syscall_test_lifecycle_listener_ready_label() {
            ListenerReadyLabel::ForegroundServer => {
                kernel_boot_log("foreground server: listener ready port=8080\n");
            }
            ListenerReadyLabel::ConnectedFixture => {
                kernel_boot_log("linux socket: listener ready port=8080\n");
            }
            ListenerReadyLabel::Persistent => {
                kernel_boot_log("persistent server: listener ready port=8080\n");
            }
        }
        return SyscallAction::Resume(0);
    }

    if (number == 202 || number == 242) {
        // accept4(): hold the sole physical RX capability across the
        // blocking TCP handshake, then restore it before publishing the
        // new connection owner and returning its allocated descriptor.
        // The test driver may bound its foreground server after two
        // completed child sessions so the one-boot suite can continue.
        if (syscall_test_lifecycle_foreground_server_should_bound(
                kernel_process_child_exit_count())) {
            return kernel_syscall_exit_current_process(0);
        }
