            // written under the connection's owner. A peer may make this
            // call, so an open check or a buffered-copy cursor update taken
            // before the owner would race the core that holds it.
            match tcp_connection_take(read_slot, read_generation) {
              TcpConnectionTakeResult::Missing => {
                return SyscallAction::Resume(LINUX_EBADF);
              }
              TcpConnectionTakeResult::Ready(owner) => {
               let conn: *TcpConnection = tcp_connection_of(owner);
               if (conn.connection_open == false) {
                   tcp_connection_put(owner);
                   return SyscallAction::Resume(LINUX_EBADF);
               }
               if (requested == 0) {
                   tcp_connection_put(owner);
                   return SyscallAction::Resume(LINUX_EBADF);
               }
