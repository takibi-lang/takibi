use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/arch/arm64/kernel/user_entry_extern.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/net/socket_capability.tkb";
use "kernel/net/tcp.tkb";

const AARCH64_NR_WRITE: usize = 64;
const AARCH64_NR_EXIT: usize = 93;
const AARCH64_NR_EXIT_GROUP: usize = 94;
const AARCH64_NR_CLONE: usize = 220;
const LINUX_EBADF: usize = 0xFFFFFFFFFFFFFFF7;
const LINUX_EFAULT: usize = 0xFFFFFFFFFFFFFFF2;
const LINUX_ENOSYS: usize = 0xFFFFFFFFFFFFFFDA;
const LINUX_ENOENT: usize = 0xFFFFFFFFFFFFFFFE;
const LINUX_EINVAL: usize = 0xFFFFFFFFFFFFFFEA;
const LINUX_EAGAIN: usize = 0xFFFFFFFFFFFFFFF5;

enum KernelSocketState: u8 { Closed; Created; Bound; Listening; }

private let mut syscall_ext2_mount: Ext2Mount;
private let mut syscall_ext2_ready: bool;
private let mut syscall_file_open: bool;
private let mut syscall_file_readable: bool;
private let mut syscall_file_writable: bool;
private let mut syscall_file_inode: usize;
private let mut syscall_file_offset: usize;
private let mut syscall_file_buffer: [u8; KERNEL_BLOCK_SIZE];
private let mut syscall_open_calls: usize;
private let mut syscall_read_calls: usize;
private let mut syscall_file_write_calls: usize;
private let mut syscall_close_calls: usize;
private let mut syscall_socket_state: KernelSocketState =
    KernelSocketState::Closed;
private let mut syscall_socket_port: u16;
private let mut syscall_socket_calls: usize;
private let mut syscall_bind_calls: usize;
private let mut syscall_listen_calls: usize;
private let mut syscall_socket_close_calls: usize;
private let mut syscall_accept_calls: usize;
private let mut syscall_accept_capability_roundtrips: usize;
private let mut syscall_connected_open: bool;
private let mut syscall_connected_references: usize;
private let mut syscall_connected_close_calls: usize;
private let mut syscall_connected_read_calls: usize;
private let mut syscall_connected_write_calls: usize;
private let mut syscall_partial_write_observed: bool;
private let mut syscall_socket_buffer: [u8; 1460];
private let mut syscall_socket_buffer_length: usize;
private let mut syscall_socket_buffer_offset: usize;
private let mut syscall_inetd_mode: bool;
private let mut syscall_inetd_response: [u8; 1460];
private let mut syscall_inetd_response_length: usize;

must_use variant KernelInetdAcceptResult { TimedOut; Accepted; }

private let mut syscall_heap_start: usize;
private let mut syscall_heap_limit: usize;
private let mut syscall_heap_break: usize;

private let mut clone_parent_file_open: bool;
private let mut clone_parent_file_readable: bool;
private let mut clone_parent_file_writable: bool;
private let mut clone_parent_file_inode: usize;
private let mut clone_parent_file_offset: usize;
private let mut clone_parent_socket_state: KernelSocketState;
private let mut clone_parent_socket_port: u16;
private let mut clone_parent_connected_open: bool;
private let mut clone_parent_socket_buffer_length: usize;
private let mut clone_parent_socket_buffer_offset: usize;
private let mut clone_parent_inetd_mode: bool;
private let mut clone_parent_inetd_response_length: usize;
private let mut clone_parent_heap_break: usize;
private let mut clone_file_state_live: bool;

must_use variant KernelFdReapResult { Failed; Reaped; }

fn kernel_syscall_process_configure(heap_start: usize, heap_limit: usize) {
    syscall_heap_start = heap_start;
    syscall_heap_limit = heap_limit;
    syscall_heap_break = heap_start;
    syscall_file_open = false;
    syscall_file_readable = false;
    syscall_file_writable = false;
    syscall_file_inode = 0;
    syscall_file_offset = 0;
    syscall_open_calls = 0;
    syscall_read_calls = 0;
    syscall_file_write_calls = 0;
    syscall_close_calls = 0;
    syscall_socket_state = KernelSocketState::Closed;
    syscall_socket_port = 0;
    syscall_socket_calls = 0;
    syscall_bind_calls = 0;
    syscall_listen_calls = 0;
    syscall_socket_close_calls = 0;
    syscall_accept_calls = 0;
    syscall_accept_capability_roundtrips = 0;
    syscall_connected_open = false;
    syscall_connected_references = 0;
    syscall_connected_close_calls = 0;
    syscall_connected_read_calls = 0;
    syscall_connected_write_calls = 0;
    syscall_partial_write_observed = false;
    syscall_socket_buffer_length = 0;
    syscall_socket_buffer_offset = 0;
    syscall_inetd_mode = false;
    syscall_inetd_response_length = 0;
    clone_file_state_live = false;
}

fn kernel_syscall_clone_files_begin() {
    clone_parent_file_open = syscall_file_open;
    clone_parent_file_readable = syscall_file_readable;
    clone_parent_file_writable = syscall_file_writable;
    clone_parent_file_inode = syscall_file_inode;
    clone_parent_file_offset = syscall_file_offset;
    clone_parent_socket_state = syscall_socket_state;
    clone_parent_socket_port = syscall_socket_port;
    clone_parent_connected_open = syscall_connected_open;
    clone_parent_socket_buffer_length = syscall_socket_buffer_length;
    clone_parent_socket_buffer_offset = syscall_socket_buffer_offset;
    clone_parent_inetd_mode = syscall_inetd_mode;
    clone_parent_inetd_response_length = syscall_inetd_response_length;
    clone_parent_heap_break = syscall_heap_break;
    if (syscall_connected_open) {
        syscall_connected_references = syscall_connected_references + 1;
    }
    clone_file_state_live = true;
}

fn kernel_connected_transport_release() -> bool {
    match network_capability_take() {
        NetworkCapabilityTakeResult::Empty => { return false; }
        NetworkCapabilityTakeResult::Ready(ready) => {
            match kernel_tcp_close_stream(ready) {
                KernelTcpCloseResult::Closed(after_close) => {
                    match network_capability_put(after_close) {
                        NetworkCapabilityPutResult::Conflict => {
                            return false;
                        }
                        NetworkCapabilityPutResult::Stored => { return true; }
                    }
                }
            }
        }
    }
}

fn kernel_connected_descriptor_release() -> bool {
    if (syscall_connected_references == 0) { return false; }
    syscall_connected_references = syscall_connected_references - 1;
    if (syscall_connected_references == 0) {
        return kernel_connected_transport_release();
    }
    return true;
}

fn kernel_syscall_clone_files_reap() -> KernelFdReapResult {
    if (clone_file_state_live == false) {
        return KernelFdReapResult::Failed;
    }
    if (syscall_connected_open) {
        if (kernel_connected_descriptor_release() == false) {
            return KernelFdReapResult::Failed;
        }
    }
    syscall_file_open = clone_parent_file_open;
    syscall_file_readable = clone_parent_file_readable;
    syscall_file_writable = clone_parent_file_writable;
    syscall_file_inode = clone_parent_file_inode;
    syscall_file_offset = clone_parent_file_offset;
    syscall_socket_state = clone_parent_socket_state;
    syscall_socket_port = clone_parent_socket_port;
    syscall_connected_open = clone_parent_connected_open;
    syscall_socket_buffer_length = clone_parent_socket_buffer_length;
    syscall_socket_buffer_offset = clone_parent_socket_buffer_offset;
    syscall_inetd_mode = clone_parent_inetd_mode;
    syscall_inetd_response_length = clone_parent_inetd_response_length;
    syscall_heap_break = clone_parent_heap_break;
    clone_file_state_live = false;
    return KernelFdReapResult::Reaped;
}

fn kernel_syscall_inetd_accept(port: u16)
        -> KernelInetdAcceptResult !{may_block} {
    match network_capability_take() {
        NetworkCapabilityTakeResult::Empty => {
            return KernelInetdAcceptResult::TimedOut;
        }
        NetworkCapabilityTakeResult::Ready(ready) => {
            match kernel_tcp_accept_once(ready, port) {
                KernelTcpAcceptResult::TimedOut(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => { }
                        NetworkCapabilityPutResult::Conflict => { }
                    }
                    return KernelInetdAcceptResult::TimedOut;
                }
                KernelTcpAcceptResult::Accepted(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Conflict => {
                            return KernelInetdAcceptResult::TimedOut;
                        }
                        NetworkCapabilityPutResult::Stored => {
                            syscall_inetd_mode = true;
                            syscall_connected_open = true;
                            syscall_connected_references = 1;
                            syscall_socket_buffer_length = 0;
                            syscall_socket_buffer_offset = 0;
                            syscall_inetd_response_length = 0;
                            return KernelInetdAcceptResult::Accepted;
                        }
                    }
                }
            }
        }
    }
}

fn kernel_syscall_ext2_configure(mount: Ext2Mount) {
    syscall_ext2_mount = mount;
    syscall_ext2_ready = true;
    syscall_file_open = false;
    syscall_file_offset = 0;
    syscall_open_calls = 0;
    syscall_read_calls = 0;
    syscall_file_write_calls = 0;
    syscall_close_calls = 0;
}

fn kernel_syscall_file_evidence()
        -> (usize, usize, usize, usize) {
    return (syscall_open_calls, syscall_read_calls,
            syscall_file_write_calls, syscall_close_calls);
}

fn kernel_syscall_socket_evidence() -> bool {
    return syscall_socket_calls == 1 && syscall_bind_calls == 1 &&
           syscall_listen_calls == 1 && syscall_accept_calls == 1 &&
           syscall_accept_capability_roundtrips == 1 &&
           syscall_connected_open == false &&
           syscall_connected_references == 0 &&
           syscall_connected_close_calls == 2 &&
           syscall_connected_read_calls == 2 &&
           syscall_connected_write_calls == 3 &&
           syscall_socket_close_calls == 2 &&
           syscall_socket_state == KernelSocketState::Closed &&
           syscall_socket_port == 8080;
}

fn kernel_syscall_partial_write_evidence() -> bool {
    return syscall_partial_write_observed;
}

// Returns 1 for /hello.txt, 2 for /mutable.txt, 3 for index.html (absolute
// or relative), and 0 for unsupported or invalid paths. Raw pointer reads
// are confined behind mapped-range checks.
fn kernel_syscall_path_kind(address: usize) -> usize {
    if (kernel_user_range_is_mapped(address, 11)) {
        let path: *u8 = address as *u8;
        if (path[0] == 0x2F && path[1] == 0x68 && path[2] == 0x65 &&
            path[3] == 0x6C && path[4] == 0x6C && path[5] == 0x6F &&
            path[6] == 0x2E && path[7] == 0x74 && path[8] == 0x78 &&
            path[9] == 0x74 && path[10] == 0) {
            return 1;
        }
    }
    if (kernel_user_range_is_mapped(address, 13)) {
        let path: *u8 = address as *u8;
        if (path[0] == 0x2F && path[1] == 0x6D && path[2] == 0x75 &&
            path[3] == 0x74 && path[4] == 0x61 && path[5] == 0x62 &&
            path[6] == 0x6C && path[7] == 0x65 && path[8] == 0x2E &&
            path[9] == 0x74 && path[10] == 0x78 && path[11] == 0x74 &&
            path[12] == 0) {
            return 2;
        }
    }
    if (kernel_user_range_is_mapped(address, 12)) {
        let path: *u8 = address as *u8;
        if (path[0] == 0x2F && path[1] == 0x69 && path[2] == 0x6E &&
            path[3] == 0x64 && path[4] == 0x65 && path[5] == 0x78 &&
            path[6] == 0x2E && path[7] == 0x68 && path[8] == 0x74 &&
            path[9] == 0x6D && path[10] == 0x6C && path[11] == 0) {
            return 3;
        }
    }
    if (kernel_user_range_is_mapped(address, 11)) {
        let path: *u8 = address as *u8;
        if (path[0] == 0x69 && path[1] == 0x6E && path[2] == 0x64 &&
            path[3] == 0x65 && path[4] == 0x78 && path[5] == 0x2E &&
            path[6] == 0x68 && path[7] == 0x74 && path[8] == 0x6D &&
            path[9] == 0x6C && path[10] == 0) {
            return 3;
        }
    }
    return 0;
}

fn kernel_user_range_is_mapped(address: usize, length: usize) -> bool {
    if (length == 0) { return true; }
    if (address < USER_TEXT_VA || address >= USER_TEXT_VA + 0x200000 ||
        length > 0x200000 ||
        address - USER_TEXT_VA > 0x200000 - length) {
        return false;
    }
    let first: usize = (address - USER_TEXT_VA) / PAGE_SIZE;
    let last: usize = (address - USER_TEXT_VA + length - 1) / PAGE_SIZE;
    let mut index: usize = first;
    while (index <= last) {
        if (index >= 512 || user_pte_read(index) == 0) { return false; }
        index = index + 1;
    }
    return true;
}

must_use variant InitialUserLoadResult { Loaded; TooLarge; }

fn initial_user_load(text: borrow PageOwner[page])
        -> InitialUserLoadResult !{unsafe} {
    let length: usize = initial_user_payload_len();
    if (length > PAGE_SIZE) {
        return InitialUserLoadResult::TooLarge;
    }
    let source: *u8 = initial_user_payload_addr() as *u8;
    let source_bytes = unsafe { source[0..<length as isize] };
    let destination = page_bytes(text);
    slice_copy(destination, source_bytes);
    user_code_sync(page_physical_address(text), length);
    return InitialUserLoadResult::Loaded;
}

// Returns (action, value): 0 = fail-stop, 1 = resume EL0 with value in x0,
// 2 = terminate and return the exit status to run_initial_user's EL1 caller.
// Linux -errno encoding exists only here at the ABI boundary.
fn kernel_syscall_dispatch(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> (usize, usize) !{unsafe} {
    let exception_class: usize = (esr >> 26) & 0x3F;
    if (exception_class != 0x15) { return (0, 0); }

    if (number == AARCH64_NR_WRITE) {
        let fd: usize = x0;
        let address: usize = x1;
        let length: usize = x2;
        if (kernel_user_range_is_mapped(address, length) == false) {
            return (1, LINUX_EFAULT);
        }
        if (fd == 5) {
            syscall_connected_write_calls =
                syscall_connected_write_calls + 1;
            if (syscall_connected_open == false || length == 0) {
                return (1, LINUX_EINVAL);
            }
            let mut amount: usize = length;
            if (amount > 1460) { amount = 1460; }
            if (amount < length) {
                syscall_partial_write_observed = true;
            }
            let received_length: usize = syscall_socket_buffer_length;
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    return (1, LINUX_EAGAIN);
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    // The complete userspace range and the kernel buffer
                    // capacity were checked above. Use explicitly typed byte
                    // pointers at this ABI boundary so each transfer is one
                    // byte, independent of raw-pointer indexing semantics.
                    let source_base: *u8 = address as *u8;
                    let destination_base: *u8 =
                        syscall_socket_buffer as *u8;
                    let mut index: usize = 0;
                    while (index < amount) {
                        let source_byte: *u8 = source_base + (index as isize);
                        let destination_byte: *u8 =
                            destination_base + (index as isize);
                        *destination_byte = *source_byte;
                        index = index + 1;
                    }
                    match kernel_tcp_send_received(
                            ready, syscall_socket_buffer as []u8,
                            received_length, amount) {
                        KernelTcpSendResult::Invalid(after_invalid) => {
                            match network_capability_put(after_invalid) {
                                NetworkCapabilityPutResult::Stored => {
                                    return (1, LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Conflict => {
                                    return (1, LINUX_EINVAL);
                                }
                            }
                        }
                        KernelTcpSendResult::Sent(after_send) => {
                            match network_capability_put(after_send) {
                                NetworkCapabilityPutResult::Conflict => {
                                    return (1, LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    return (1, amount);
                                }
                            }
                        }
                    }
                }
            }
        }
        if (fd == 1 && syscall_inetd_mode) {
            if (syscall_connected_open == false ||
                length > 1460 - syscall_inetd_response_length) {
                return (1, LINUX_EINVAL);
            }
            let source_base: *u8 = address as *u8;
            let destination_base: *u8 = syscall_inetd_response as *u8;
            let mut index: usize = 0;
            while (index < length) {
                let source_byte: *u8 = source_base + (index as isize);
                let destination_offset: usize =
                    syscall_inetd_response_length + index;
                let destination_byte: *u8 =
                    destination_base + (destination_offset as isize);
                *destination_byte = *source_byte;
                index = index + 1;
            }
            syscall_inetd_response_length =
                syscall_inetd_response_length + length;
            return (1, length);
        }
        if (fd == 3) {
            syscall_file_write_calls = syscall_file_write_calls + 1;
            if (syscall_file_open == false || syscall_file_writable == false) {
                return (1, LINUX_EBADF);
            }
            if (syscall_file_offset != 0 || length == 0 ||
                length > KERNEL_BLOCK_SIZE) {
                return (1, LINUX_EINVAL);
            }
            let source_base: *u8 = address as *u8;
            let destination_base: *u8 = syscall_file_buffer as *u8;
            let mut copy_index: usize = 0;
            while (copy_index < length) {
                let source_byte: *u8 =
                    source_base + (copy_index as isize);
                let destination_byte: *u8 =
                    destination_base + (copy_index as isize);
                *destination_byte = *source_byte;
                copy_index = copy_index + 1;
            }
            let content = unsafe { destination_base[0..<length as isize] };
            match ext2_resize_small_file(
                    syscall_ext2_mount, syscall_file_inode, content) {
                Ext2ResizeResult::Invalid => { return (1, LINUX_EINVAL); }
                Ext2ResizeResult::Resized => {
                    syscall_file_offset = length;
                    return (1, length);
                }
            }
        }
        if (fd != 1 && fd != 2) { return (1, LINUX_EBADF); }
        let mut cursor: *u8 = address as *u8;
        let mut remaining: usize = length;
        while (remaining != 0) {
            uart_putc(*cursor);
            cursor = cursor + 1;
            remaining = remaining - 1;
        }
        return (1, length);
    }

    if (number == 56) {
        syscall_open_calls = syscall_open_calls + 1;
        // openat(dirfd, pathname, flags): only absolute root paths are in
        // scope, so dirfd is intentionally ignored.
        if (syscall_ext2_ready == false || syscall_file_open) {
            return (1, LINUX_EBADF);
        }
        let path_kind: usize = kernel_syscall_path_kind(x1);
        if (path_kind == 0) { return (1, LINUX_ENOENT); }
        let mut name: []u8 = "hello.txt" as []u8;
        if (path_kind == 2) { name = "mutable.txt" as []u8; }
        if (path_kind == 3) { name = "index.html" as []u8; }
        match ext2_lookup_root(syscall_ext2_mount, name) {
            Ext2LookupResult::Invalid => { return (1, LINUX_EINVAL); }
            Ext2LookupResult::NotFound => { return (1, LINUX_ENOENT); }
            Ext2LookupResult::Found(inode_number) => {
                let access_mode: usize = x2 & 3;
                syscall_file_open = true;
                syscall_file_readable = access_mode != 1;
                syscall_file_writable = access_mode != 0;
                syscall_file_inode = inode_number;
                syscall_file_offset = 0;
                return (1, 3);
            }
        }
    }

    if (number == 79) {
        // newfstatat(AT_FDCWD, path, stat, flags): the current ext2 root has
        // regular files only. Fill the asm-generic AArch64 stat fields used
        // by BusyBox httpd after validating the complete userspace result.
        let path_kind: usize = kernel_syscall_path_kind(x1);
        if (path_kind == 0) { return (1, LINUX_ENOENT); }
        if (kernel_user_range_is_mapped(x2, 128) == false) {
            return (1, LINUX_EFAULT);
        }
        let mut name: []u8 = "hello.txt" as []u8;
        if (path_kind == 2) { name = "mutable.txt" as []u8; }
        if (path_kind == 3) { name = "index.html" as []u8; }
        match ext2_lookup_root(syscall_ext2_mount, name) {
            Ext2LookupResult::Invalid => { return (1, LINUX_EINVAL); }
            Ext2LookupResult::NotFound => { return (1, LINUX_ENOENT); }
            Ext2LookupResult::Found(inode_number) => {
                match ext2_read_small_file(
                        syscall_ext2_mount, inode_number,
                        syscall_file_buffer as []u8) {
                    Ext2ReadResult::Invalid => { return (1, LINUX_EINVAL); }
                    Ext2ReadResult::Read(file_length) => {
                        let stat_base: *u8 = x2 as *u8;
                        let stat = unsafe { stat_base[0..<128] };
                        for i: usize in 0..<128 { stat[i] = 0; }
                        let inode_field: *u64 = (x2 + 8) as *u64;
                        *inode_field = inode_number as u64;
                        let mode_field: *u32 = (x2 + 16) as *u32;
                        *mode_field = 0x81A4 as u32;
                        let links_field: *u32 = (x2 + 20) as *u32;
                        *links_field = 1;
                        let size_field: *u64 = (x2 + 48) as *u64;
                        *size_field = file_length as u64;
                        let block_size_field: *u32 = (x2 + 56) as *u32;
                        *block_size_field = 1024;
                        let blocks_field: *u64 = (x2 + 64) as *u64;
                        *blocks_field = 2;
                        return (1, 0);
                    }
                }
            }
        }
    }

    if (number == 63) {
        syscall_read_calls = syscall_read_calls + 1;
        let fd: usize = x0;
        let address: usize = x1;
        let requested: usize = x2;
        if (fd == 5 || (fd == 0 && syscall_inetd_mode)) {
            syscall_connected_read_calls = syscall_connected_read_calls + 1;
            if (syscall_connected_open == false || requested == 0) {
                return (1, LINUX_EBADF);
            }
            if (kernel_user_range_is_mapped(address, requested) == false) {
                return (1, LINUX_EFAULT);
            }
            if (syscall_socket_buffer_offset < syscall_socket_buffer_length) {
                let available: usize = syscall_socket_buffer_length -
                    syscall_socket_buffer_offset;
                let mut amount: usize = requested;
                if (amount > available) { amount = available; }
                let destination_base: *u8 = address as *u8;
                let source_base: *u8 = syscall_socket_buffer as *u8;
                let mut index: usize = 0;
                while (index < amount) {
                    let destination_byte: *u8 =
                        destination_base + (index as isize);
                    let source_offset: usize =
                        syscall_socket_buffer_offset + index;
                    let source_byte: *u8 =
                        source_base + (source_offset as isize);
                    *destination_byte = *source_byte;
                    index = index + 1;
                }
                syscall_socket_buffer_offset =
                    syscall_socket_buffer_offset + amount;
                return (1, amount);
            }
            let ready: NetRxCanAcquire = match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    return (1, LINUX_EAGAIN);
                }
                NetworkCapabilityTakeResult::Ready(r) => { r }
            };
            match kernel_tcp_receive_once(
                    ready, syscall_socket_buffer as []u8) {
                KernelTcpReceiveResult::TimedOut(next) => {
                    match network_capability_put(next) {
                        NetworkCapabilityPutResult::Stored => {
                            return (1, LINUX_EAGAIN);
                        }
                        NetworkCapabilityPutResult::Conflict => {
                            return (1, LINUX_EINVAL);
                        }
                    }
                }
                KernelTcpReceiveResult::Received(next) => {
                    let received: usize =
                        kernel_tcp_received_length();
                    syscall_socket_buffer_length = received;
                    let mut amount: usize = received;
                    if (amount > requested) { amount = requested; }
                    let destination_base: *u8 = address as *u8;
                    let source_base: *u8 =
                        syscall_socket_buffer as *u8;
                    let mut index: usize = 0;
                    while (index < amount) {
                        let destination_byte: *u8 =
                            destination_base + (index as isize);
                        let source_byte: *u8 =
                            source_base + (index as isize);
                        *destination_byte = *source_byte;
                        index = index + 1;
                    }
