            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
