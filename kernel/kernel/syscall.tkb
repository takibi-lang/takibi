            return SyscallAction::Resume(LINUX_EBADF);
        }
        let mut path_address: usize = x1;
        let mut requested_mode: usize = x2;
        let mut dirfd: usize = x0;
        if (number == 21) {
            path_address = x0;
            requested_mode = x1;
            dirfd = LINUX_AT_FDCWD;
