        let accept_listener_fd: usize =
            match kernel_listener_fd_lookup(x0) {
                KernelListenerLookupResult::Missing => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                KernelListenerLookupResult::Found(found) => { found }
