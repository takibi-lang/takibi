                                match tcp_connection_put(owner) {
                                  TcpConnectionPutResult::Conflict => {
                                    return (1, LINUX_EINVAL);
                                  }
                                  TcpConnectionPutResult::Stored => {
                                    if (slot >= TCP_CONNECTION_MAX) {
                                        return (1, LINUX_EINVAL);
                                    }
                                    syscall_connection_open[slot] = true;
                                    match unified_connection_create(
                                            kernel_syscall_process_slot(),
                                            connected_fd, slot, generation) {
                                        UnifiedFdResult::Invalid => {
                                            return (1, LINUX_EAGAIN);
                                        }
                                        UnifiedFdResult::Ok => {}
                                    }
                                    syscall_socket_buffer_length[slot] = 0;
                                    syscall_socket_buffer_offset[slot] = 0;
                                    return (1, connected_fd);
                                  }
                                }
                            }
                        }
                    }
                }
            }
           }
          }
        }
    }

    if (number == 71) {
        // sendfile(out_fd, in_fd, offset, count). BusyBox cat uses a null
        // offset, so the shared file position is sufficient for this first
        // Linux-compatible path. Output remains the existing UART console.
        let output_fd: usize = x0;
        let input_fd: usize = x1;
        let offset_address: usize = x2;
        let requested: usize = x3;
        if ((output_fd != 1 && output_fd != 2) || input_fd != 3 ||
            kernel_syscall_file_is_open() == false || kernel_syscall_file_readable() == false) {
            return (1, LINUX_EBADF);
        }
        if (offset_address != 0) { return (1, LINUX_EINVAL); }
        match ext2_read_small_file(
                syscall_ext2_mount, kernel_syscall_file_inode(),
                syscall_file_buffer as []u8) {
            Ext2ReadResult::Invalid => { return (1, LINUX_EINVAL); }
            Ext2ReadResult::Read(file_length) => {
                if (kernel_syscall_file_offset() >= file_length) { return (1, 0); }
                let available: usize = file_length - kernel_syscall_file_offset();
                let mut amount: usize = requested;
                if (amount > available) { amount = available; }
                let source: *u8 = syscall_file_buffer as *u8;
                let mut copy_index: usize = 0;
                while (copy_index < amount) {
                    uart_putc(source[(kernel_syscall_file_offset() + copy_index) as isize]);
                    copy_index = copy_index + 1;
                }
                if (kernel_syscall_file_set_offset(
                        kernel_syscall_file_offset() + amount) == false) {
                    return (1, LINUX_EBADF);
                }
                syscall_read_calls = syscall_read_calls + 1;
                return (1, amount);
            }
        }
    }

    if (number == 210) {
        // shutdown(1, SHUT_WR) is BusyBox httpd's end-of-response boundary
        // in inetd mode. Its header/body writes are coalesced in the kernel
        // response buffer and transmitted independently of RX ownership.
        if (x0 == 1 && syscall_inetd_mode == false &&
            kernel_connected_fd_is_open(1) && x1 == 1) {
            let direct_shutdown_slot: {0..<TCP_CONNECTION_MAX as usize} =
                match kernel_connection_fd_lookup(1) {
                    KernelConnectionLookupResult::Missing => {
                        return (1, LINUX_EINVAL);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let direct_shutdown_generation: usize =
                kernel_connection_fd_identity(1);
            if (syscall_connection_open[direct_shutdown_slot] == false ||
                kernel_connected_transport_release(
                    direct_shutdown_slot, direct_shutdown_generation) == false) {
                return (1, LINUX_EAGAIN);
            }
            syscall_connection_open[direct_shutdown_slot] = false;
            return (1, 0);
        }
        let inetd_shutdown_slot: {0..<TCP_CONNECTION_MAX as usize} =
            match kernel_connection_fd_lookup(1) {
                KernelConnectionLookupResult::Missing => {
                    return (1, LINUX_EINVAL);
                }
                KernelConnectionLookupResult::Found(found) => { found }
            };
        let inetd_shutdown_generation: usize = kernel_connection_fd_identity(1);
        if (x0 != 1 || syscall_inetd_mode == false ||
            syscall_connection_open[inetd_shutdown_slot] == false ||
            syscall_inetd_response_length[inetd_shutdown_slot] == 0) {
            return (1, LINUX_EINVAL);
        }
        let received_length: usize =
            syscall_socket_buffer_length[inetd_shutdown_slot];
        match tcp_connection_take(
                inetd_shutdown_slot, inetd_shutdown_generation) {
          TcpConnectionTakeResult::Missing => { return (1, LINUX_EAGAIN); }
          TcpConnectionTakeResult::Ready(owner) => {
           match network_capability_take() {
            NetworkCapabilityTakeResult::Empty => {
                match tcp_connection_put(owner) {
                    TcpConnectionPutResult::Stored => {}
                    TcpConnectionPutResult::Conflict => {}
                }
                return (1, LINUX_EAGAIN);
            }
            NetworkCapabilityTakeResult::Ready(ready) => {
                let response_base: {0..<1461 as usize} =
                    inetd_shutdown_slot * 1460;
                let inetd_responses = syscall_inetd_response as []u8;
                match kernel_tcp_send_received(
                        owner, ready, inetd_responses[
                            response_base..<response_base + 1460],
                        received_length,
                        syscall_inetd_response_length[inetd_shutdown_slot]) {
                    KernelTcpSendResult::Invalid(after_invalid) => {
                        match network_capability_put(after_invalid) {
                            NetworkCapabilityPutResult::Stored => { }
                            NetworkCapabilityPutResult::Conflict => {
                                tcp_connection_free(owner);
                                return (1, LINUX_EINVAL);
                            }
                        }
                        match tcp_connection_put(owner) {
                            TcpConnectionPutResult::Stored => {}
                            TcpConnectionPutResult::Conflict => {}
                        }
                        return (1, LINUX_EINVAL);
                    }
                    KernelTcpSendResult::Sent(after_send) => {
                        match kernel_tcp_close_stream(owner, after_send) {
                            KernelTcpCloseResult::Closed(after_close) => {
                                match network_capability_put(after_close) {
                                    NetworkCapabilityPutResult::Conflict => {
                                        tcp_connection_free(owner);
                                        return (1, LINUX_EINVAL);
                                    }
                                    NetworkCapabilityPutResult::Stored => {
                                        tcp_connection_free(owner);
                                        syscall_connection_open[
                                            inetd_shutdown_slot] = false;
                                        return (1, 0);
                                    }
                                }
                            }
                        }
                    }
                }
            }
           }
          }
        }
    }

    if (number == AARCH64_NR_CLONE) {
        if (x0 != 0x11 || x1 != 0) { return (1, LINUX_EINVAL); }
        match process_image_clone_vm_begin() {
            ProcessCloneVmResult::OutOfMemory => {
                return (1, LINUX_EAGAIN);
            }
            ProcessCloneVmResult::Copied => {
                match kernel_syscall_clone_files_begin() {
                    UnifiedFdResult::Invalid => {
                        match process_image_clone_vm_reap() {
                            ProcessCloneVmReapResult::Missing => {}
                            ProcessCloneVmReapResult::Reaped => {}
                        }
                        return (1, LINUX_EAGAIN);
                    }
                    UnifiedFdResult::Ok => {}
                }
                match kernel_process_clone_begin(x0, x1) {
                    ProcessCloneResult::Invalid => {
                        match kernel_syscall_clone_files_reap() {
                            KernelFdReapResult::Failed => { }
                            KernelFdReapResult::Reaped => { }
                        }
                        match process_image_clone_vm_reap() {
                            ProcessCloneVmReapResult::Missing => { }
                            ProcessCloneVmReapResult::Reaped => { }
                        }
                        return (1, LINUX_EINVAL);
                    }
                    ProcessCloneResult::ChildReady(child_pid) => {
                        // Assembly copies the complete saved parent frame to
                        // the dedicated child kernel stack and resumes x0=0.
                        return (3, child_pid);
                    }
                }
            }
        }
    }
    if (number == AARCH64_NR_EXIT || number == AARCH64_NR_EXIT_GROUP) {
        if (kernel_process_is_child()) {
            // Restore the preserved parent frame with clone() == child PID.
            match kernel_syscall_clone_files_reap() {
                KernelFdReapResult::Failed => { return (0, 0); }
                KernelFdReapResult::Reaped => { }
            }
            match process_image_clone_vm_reap() {
                ProcessCloneVmReapResult::Missing => { return (0, 0); }
                ProcessCloneVmReapResult::Reaped => { }
            }
            return (4, kernel_process_child_exit(x0));
        }
        return (2, x0);
    }
    if (number == 17) {
        // getcwd(): HTTPd immediately changes to its configured root; `/` is
        // the only current working directory exposed by this kernel slice.
        // The real syscall (unlike the POSIX library wrapper, which returns
        // the buffer pointer) returns the number of bytes written including
        // the NUL terminator -- found via a real hang: BusyBox ash's `sh -c`
        // startup calls this, and this handler previously returned the
        // buffer ADDRESS instead of the byte count, which some downstream
        // use of that value (as a length, not just a >=0 success check)
        // turned into an effectively-unbounded userspace loop with no
        // further syscalls, not a kernel-visible fault.
        if (x1 < 2) { return (1, LINUX_EFAULT); }
        match user_range_check(x0, 2, UserAccessMode::Write) {
            UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
            UserRangeResult::Ok(range) => {
                let wrote_slash: bool = user_write_byte(range, 0, 0x2F);
                let wrote_nul: bool = user_write_byte(range, 1, 0);
            }
        }
        return (1, 2);
    }
    if (number == 49) {
        match user_range_check(x0, 2, UserAccessMode::Read) {
            UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
            UserRangeResult::Ok(range) => {
                let path_view: []u8 = syscall_path_buffer as []u8;
                if (copy_from_user(range, path_view[0..<2]) &&
                        path_view[0] == 0x2F && path_view[1] == 0) {
                    return (1, 0);
                }
            }
        }
        return (1, LINUX_ENOENT);
    }
    if (number == 103) {
        // setitimer(): HTTPd's request timeout is unnecessary for the single
        // bounded integration request. Return an all-zero previous timer.
        if (x2 != 0) {
            match user_range_check(x2, 32, UserAccessMode::Write) {
                UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
                UserRangeResult::Ok(range) => {
                    let zeroed: bool = user_zero_fill(range);
                }
            }
        }
        return (1, 0);
    }
    if (number == 113) {
        match user_range_check(x1, 16, UserAccessMode::Write) {
            UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
            UserRangeResult::Ok(range) => {
                let wrote_seconds: bool =
                    user_write_u64(range, 0, 1700000000 as u64);
                let wrote_nanoseconds: bool = user_write_u64(range, 8, 0);
            }
        }
        return (1, 0);
    }
    if (number == 134) {
        // rt_sigaction(signum, act, oldact, sigsetsize): this kernel does
        // not deliver signals, but musl's signal() (SIGPIPE/SIGALRM/SIGCHLD/
        // SIGHUP in BusyBox httpd) always passes a non-null oldact expecting
        // the previous struct sigaction (32 bytes on aarch64: handler,
        // flags, restorer, 2-word mask) to be filled, not left untouched.
        let signum: usize = x0;
        let oldact: usize = x2;
        if (signum == 0 || signum == 9 || signum == 19) {
            return (1, LINUX_EINVAL);
        }
        if (oldact != 0) {
            match user_range_check(oldact, 32, UserAccessMode::Write) {
                UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
                UserRangeResult::Ok(range) => {
                    let zeroed: bool = user_zero_fill(range);
                }
            }
        }
        return (1, 0);
    }
    if (number == 135) {
        if (x2 != 0) {
            match user_range_check(x2, 8, UserAccessMode::Write) {
                UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
                UserRangeResult::Ok(range) => {
                    let wrote_mask: bool = user_write_u64(range, 0, 0);
                }
            }
        }
        return (1, 0);
    }
    if (number == 205) {
        if (x0 != 0) { return (1, LINUX_EFAULT); }
        match user_range_check(x1, 16, UserAccessMode::Write) {
            UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
            UserRangeResult::Ok(peer_range) => {
                let zeroed: bool = user_zero_fill(peer_range);
                let wrote_family: bool = user_write_byte(peer_range, 0, 2);
            }
        }
        match user_range_check(x2, 4, UserAccessMode::Write) {
            UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
            UserRangeResult::Ok(length_range) => {
                let wrote_length: bool =
                    user_write_u32(length_range, 0, 16);
            }
        }
        return (1, 0);
    }
    if (number == 208) {
        // setsockopt(level, optname, optval, optlen): this kernel's
        // single-listener-per-port/single-connection model has no state any
        // real option here would change, but the optval pointer itself is
        // now validated instead of never being touched.
        let optval: usize = x2;
        let optlen: usize = x3;
        if (optlen != 0) {
            match user_range_check(optval, optlen, UserAccessMode::Read) {
                UserRangeResult::Fault => { return (1, LINUX_EFAULT); }
                UserRangeResult::Ok(range) => {}
            }
        }
        return (1, 0);
    }
    if (number == 96) {
        return (1, kernel_process_current_pid());
    }
    if (number == 172 || number == 178) {
        return (1, kernel_process_current_pid());
    }
    if (number == 173 || (number >= 174 && number <= 177)) {
        return (1, 0);
    }
    if (number == 214) {
        if (x0 == 0) { return (1, kernel_syscall_heap_break()); }
        if (x0 >= syscall_heap_start && x0 <= syscall_heap_limit) {
            if (kernel_syscall_heap_set(x0) == false) {
                return (1, LINUX_EINVAL);
            }
        }
        return (1, kernel_syscall_heap_break());
    }
    if (number == 222) {
        let length: usize = x1;
        let prot: usize = x2;
        let flags: usize = x3;
        let fd: usize = x4;
        // This kernel has no file-backed or shared mapping and no
        // executable anonymous memory (issue #174's W^X story): only a
        // private anonymous request with fd=-1 and no PROT_EXEC is
        // supported. musl's mallocng is the only real caller reached by
        // BusyBox httpd and every one of its three call shapes (fixed
        // MAP_FIXED guard page, PROT_NONE meta-area pool, PROT_READ|WRITE
        // growth) already satisfies this.
        if ((flags & 0x22) != 0x22 || fd != 0xFFFFFFFFFFFFFFFF ||
                (prot & 0x4) != 0) {
            return (1, LINUX_EINVAL);
        }
        if (length == 0 || length > 0xFFFFFFFFFFFFF000) {
            return (1, 0xFFFFFFFFFFFFFFFF);
        }
        let rounded: usize = (length + PAGE_SIZE - 1) & 0xFFFFFFFFFFFFF000;
        // musl uses MAP_FIXED to turn the first page of its brk arena into a
        // guard page. The pages are already present in this prototype's
        // eagerly mapped process arena, so preserve the requested address
        // without consuming space from the independent anonymous-map cursor.
        if (x0 != 0) {
            if (x0 < syscall_heap_start || x0 > syscall_heap_limit ||
                rounded > syscall_heap_limit - x0) {
                return (1, 0xFFFFFFFFFFFFFFFF);
            }
            return (1, x0);
        }
        if (rounded > syscall_heap_limit - kernel_syscall_heap_break()) {
            return (1, 0xFFFFFFFFFFFFFFFF);
        }
        let result: usize = kernel_syscall_heap_break();
        if (kernel_syscall_heap_set(
                kernel_syscall_heap_break() + rounded) == false) {
            return (1, LINUX_EINVAL);
        }
        return (1, result);
    }
    if (number == 215) {
        // munmap: the fixed short-lived process arena is reclaimed as a
        // unit; this does not relax load-time permissions.
        return (1, 0);
    }
    if (number == 226) {
        let addr: usize = x0;
        let len: usize = x1;
        let prot: usize = x2;
        if (addr % PAGE_SIZE != 0 || len == 0) {
            return (1, LINUX_EINVAL);
        }
        let (span_ok, first, last) = user_range_l3_span(addr, len);
        if (span_ok == false) {
            return (1, LINUX_EINVAL);
        }
        let class: usize = user_page_class_at(first);
        let mut index: usize = first;
        while (index <= last) {
            if (index >= USER_RANGE_MAX_INDEX ||
                    user_page_class_at(index) != class) {
                return (1, LINUX_EINVAL);
            }
            index = index + 1;
        }
        // The only transition this bounded per-page model supports:
        // downgrading a currently read-write data/heap/stack range to
        // read-only+XN. Once downgraded (or if the range is already
        // text/rodata), the page is bit-identical to ELF-loaded rodata, so
        // re-widening permissions is refused rather than risked -- a real
        // error, never false success.
        if (prot == LINUX_PROT_READ && class == 3) {
            user_range_reprotect(first, last, USER_RODATA_R_FLAGS);
            return (1, 0);
        }
        if (prot == (LINUX_PROT_READ | LINUX_PROT_WRITE) && class == 3) {
            return (1, 0);
        }
        return (1, LINUX_EACCES);
    }
    if (number == AARCH64_NR_READV) {
        syscall_readv_requested = true;
        return (1, LINUX_ENOSYS);
    }
    if (number == AARCH64_NR_WRITEV) {
        syscall_writev_requested = true;
        return (1, LINUX_ENOSYS);
    }
    if (number == AARCH64_NR_PPOLL) {
        syscall_ppoll_requested = true;
        return (1, LINUX_ENOSYS);
    }
    if (number == AARCH64_NR_UNAME) {
        syscall_uname_requested = true;
        return (1, LINUX_ENOSYS);
    }
    return (1, LINUX_ENOSYS);
}

const SYSCALL_SUBSET_PROBE_L3_INDEX: usize = 503;
const SYSCALL_TRAP_ESR: usize = 0x54000000;

// Boot-time negative-test coverage for issue #175: the real BusyBox/musl
// binary never requests PROT_EXEC/a real fd for mmap, an invalid rt_sigaction
// signum, or a non-null rt_sigaction oldact it then checks byte-for-byte, so
// passing hardware behavior alone can't prove those reject/zero-fill paths
// work. Exercises kernel_syscall_dispatch directly with crafted esr/args
// (exception_class 0x15, matching the real SVC trap), using its own
// throwaway page (outside issue #174's own probe's L3 indices 500-502) for
// the oldact buffer.
fn kernel_syscall_subset_probe() -> bool !{unsafe} {
    if (user_pte_read(SYSCALL_SUBSET_PROBE_L3_INDEX) != 0) { return false; }
    match page_alloc() {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(page) => {
            let phys: usize = page_physical_address(page);
            user_pte_write(SYSCALL_SUBSET_PROBE_L3_INDEX,
                           phys | USER_RW_XN_FLAGS);
            user_tlb_invalidate(
                USER_TEXT_VA + SYSCALL_SUBSET_PROBE_L3_INDEX * PAGE_SIZE);
            let oldact_va: usize =
                USER_TEXT_VA + SYSCALL_SUBSET_PROBE_L3_INDEX * PAGE_SIZE;

            let mut ok: bool = true;

            // mmap: PROT_EXEC is always rejected.
            let (action1, value1) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 222, 0, 4096, 0x4, 0x22,
                0xFFFFFFFFFFFFFFFF);
            if (action1 != 1 || value1 != LINUX_EINVAL) { ok = false; }

            // mmap: a real fd (file-backed) is always rejected.
            let (action2, value2) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 222, 0, 4096, 0x3, 0x22, 3);
            if (action2 != 1 || value2 != LINUX_EINVAL) { ok = false; }

            // rt_sigaction: signum 0 is rejected.
            let (action3, value3) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 134, 0, 0, 0, 0, 0);
            if (action3 != 1 || value3 != LINUX_EINVAL) { ok = false; }

            // rt_sigaction: a non-null oldact is zero-filled, not left as
            // whatever was already there (poison it first to prove that).
            match user_range_check(oldact_va, 32, UserAccessMode::Write) {
                UserRangeResult::Fault => { ok = false; }
                UserRangeResult::Ok(range) => {
                    let poisoned: bool = user_write_byte(range, 0, 0xAA);
                }
            }
            let (action4, value4) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 134, 1, 0, oldact_va, 0, 0);
            if (action4 != 1 || value4 != 0) { ok = false; }
            match user_range_check(oldact_va, 1, UserAccessMode::Read) {
                UserRangeResult::Fault => { ok = false; }
                UserRangeResult::Ok(range) => {
                    if (user_read_byte(range, 0) != 0) { ok = false; }
                }
            }

            user_pte_write(SYSCALL_SUBSET_PROBE_L3_INDEX, 0);
            user_tlb_invalidate(oldact_va);
            page_free(page);
            return ok;
        }
    }
}
