                pending_slot, pending_generation,
                kernel_listener_port(accept_listener_fd)) {
          TcpConnectionAllocResult::Full => {
            kernel_boot_log_resource_exhausted(
                "TCP connection pool" as *u8, 0);
            return SyscallAction::Resume(LINUX_EAGAIN);
          }
          TcpConnectionAllocResult::Allocated(owner) => {
           let slot: usize = tcp_connection_slot(owner);
           let generation: usize = tcp_connection_identity(owner);
