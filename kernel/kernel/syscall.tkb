                                    ext2_u32(entry, 0) as usize;
                                let record_length: usize =
                                    ext2_u16(entry, 4) as usize;
                                let name_length: usize = entry[6] as usize;
                                if (record_length < 8 ||
                                    record_length > chunk - cursor ||
                                    name_length > record_length - 8) {
                                    if (written != 0) {
                                        return SyscallAction::Resume(written);
                                    }
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
