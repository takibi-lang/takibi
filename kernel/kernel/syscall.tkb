use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/mm/user_memory.tkb";
use "kernel/arch/arm64/kernel/user_entry_extern.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/fs/procfs.tkb";
use "kernel/drivers/serial/uart_rx_ring.tkb";
use "kernel/net/socket_capability.tkb";
use "kernel/net/tcp.tkb";
use "kernel/kernel/fd_table.tkb";
use "kernel/kernel/syscall_test_evidence.tkb";
use "kernel/kernel/syscall_test_lifecycle.tkb";
use "kernel/kernel/workload_evidence.tkb";
use "kernel/lib/execution_model.tkb";

// Current limitations (2026-08-26). Keep this list current as
// call sites change; a limitation that goes stale here is worse than
// none. This file is the Linux syscall dispatch/policy layer, so its own
// scope is inherently broad -- `kernel/README.md`'s "Current limits"
// section is the authoritative per-syscall-family list (mmap/mprotect/
// munmap scope, signal delivery, scatter/gather I/O coverage, ppoll
// shape, and more); this note only covers what is specific to THIS
// file's own dispatch mechanics, not every syscall it implements.
// - EPHEMERAL SCRATCH IS PER CORE, so independent handlers on two cores do
//   not overwrite each other's file/path/sockaddr/uname/rlimit staging.
//   Persistent inetd mode and the init logging latch live in ProcessRecord.
//   Exec handoff is still global even though it describes one process; it
//   must move to process-owned storage before dispatch can be concurrent.
//   Non-preemptible syscall execution is what keeps two processes on one core
//   from interleaving through it now.
// - Every fixed-capacity pool a syscall handler here allocates from
//   (process slots, fd table, shared objects, TCP connections, address
//   spaces) is documented once, authoritatively, in
//   `kernel/RESOURCE_LIMITS.md` -- do not re-derive a pool's exhaustion
//   behavior from a single call site here without checking that file
//   first, since the errno mapping at a given call site is meant to
//   match its pool's documented contract exactly (`LINUX_EMFILE` for
//   per-process fd exhaustion, `LINUX_ENFILE` for the global shared-
//   object pool, etc.).
// - execve's `#!` dispatch is ONE LEVEL DEEP: the interpreter a script
//   names must itself be an executable image. Linux allows five nested
//   script levels and reports ELOOP on the sixth; this kernel would
//   instead fall back to the static BusyBox image for a nested one.
//   Everything else about the directive matches measured Linux behavior:
//   one argument wide, a 256-byte window (`BINPRM_BUF_SIZE`), '\n' or NUL
//   ends it, CR does not, and a first line that fills the window without
//   ending is refused rather than truncated.
//
const AARCH64_NR_WRITE: usize = 64;
const AARCH64_NR_READV: usize = 65;
const AARCH64_NR_WRITEV: usize = 66;
const AARCH64_NR_PPOLL: usize = 73;
const AARCH64_NR_NANOSLEEP: usize = 101;
const AARCH64_NR_CLOCK_NANOSLEEP: usize = 115;
const AARCH64_NR_KILL: usize = 129;
const AARCH64_NR_RT_SIGTIMEDWAIT: usize = 137;
const AARCH64_NR_SYSLOG: usize = 116;
const AARCH64_NR_GETCWD: usize = 17;
// GitHub issue #581: the filesystem read path, named where the rest of this
// table's numbers are rather than as literals inside syscall_peer_safe.
const AARCH64_NR_OPENAT: usize = 56;
const AARCH64_NR_CLOSE: usize = 57;
const AARCH64_NR_NEWFSTATAT: usize = 79;
const AARCH64_NR_CHDIR: usize = 49;
const AARCH64_NR_SETITIMER: usize = 103;
const AARCH64_NR_RT_SIGACTION: usize = 134;
const AARCH64_NR_SET_TID_ADDRESS: usize = 96;
const AARCH64_NR_UNAME: usize = 160;
const AARCH64_NR_SYSINFO: usize = 179;
const AARCH64_NR_GETCPU: usize = 168;
const AARCH64_NR_SCHED_SETAFFINITY: usize = 122;
const AARCH64_NR_SCHED_GETAFFINITY: usize = 123;
// GitHub issue #393: the only rlimit syscall this architecture has.
// asm-generic (and therefore arm64) has no getrlimit/setrlimit numbers at
// all, and musl 1.2.6's getrlimit()/setrlimit() go through SYS_prlimit64
// first, so implementing this one implements all of them -- and it is
// what ash's `ulimit -n` reaches.
const AARCH64_NR_PRLIMIT64: usize = 261;
const AARCH64_NR_EXIT: usize = 93;
const AARCH64_NR_EXIT_GROUP: usize = 94;
const AARCH64_NR_CLONE: usize = 220;
const AARCH64_NR_VFORK: usize = 58;
const AARCH64_NR_FORK: usize = 107;
const AARCH64_NR_CLONE3: usize = 435;
const AARCH64_NR_EXECVE: usize = 221;
const AARCH64_NR_EXECVEAT: usize = 281;
const AARCH64_NR_WAIT4: usize = 260;
const AARCH64_NR_FCNTL: usize = 25;
const AARCH64_NR_TAKIBI_UART_RX_WAIT: usize = 451;
const AARCH64_NR_TAKIBI_PARENT_PROGRESS: usize = 452;
const AARCH64_NR_TAKIBI_WORKLOAD_PROGRESS: usize = 453;
const LINUX_EBADF: usize = 0xFFFFFFFFFFFFFFF7;
const LINUX_EFAULT: usize = 0xFFFFFFFFFFFFFFF2;
const LINUX_ENOSYS: usize = 0xFFFFFFFFFFFFFFDA;
const LINUX_ENOENT: usize = 0xFFFFFFFFFFFFFFFE;
const LINUX_EINVAL: usize = 0xFFFFFFFFFFFFFFEA;
const LINUX_EAGAIN: usize = 0xFFFFFFFFFFFFFFF5;
const LINUX_EACCES: usize = 0xFFFFFFFFFFFFFFF3;
const LINUX_ECHILD: usize = 0xFFFFFFFFFFFFFFF6;
const LINUX_SIGTERM: usize = 15;
const LINUX_SIGCHLD: usize = 17;
// GitHub issue #295: distinct errno for fixed-pool exhaustion, previously
// collapsed into LINUX_EBADF (which real Linux reserves for an actually bad
// descriptor argument) at every fd-allocating syscall handler below.
// EMFILE = this process's own RLIMIT_NOFILE was reached (issue #393);
// ENFILE = the global shared object pool is full. GitHub issue #391 left
// that mapping alone and changed only what "full" means: the pool has no
// capacity constant, so what is reported is the derived system-wide bound
// (Linux's files_stat.max_files) or the page allocator being empty.
const LINUX_EMFILE: usize = 0xFFFFFFFFFFFFFFE8;
const LINUX_ENFILE: usize = 0xFFFFFFFFFFFFFFE9;
// GitHub issue #393: installing a descriptor can need a descriptor block,
// and the page allocator being empty is neither a bad argument nor a
// limit. Linux's own expand_files() returns ENOMEM for it.
const LINUX_ENOMEM: usize = 0xFFFFFFFFFFFFFFF4;
const LINUX_ESRCH: usize = 0xFFFFFFFFFFFFFFFD;
// execve(2) reached a regular file that carries neither an ELF header nor a
// usable `#!` interpreter line. Real Linux reports this so a shell can decide
// what to do with a file it asked the kernel to execute and the kernel
// declined; guessing an executable format on its behalf is what this errno
// exists to avoid.
const LINUX_ENOEXEC: usize = 0xFFFFFFFFFFFFFFF8;
// Linux's answer for an ELF interpreter that exists but cannot be used.
const LINUX_ELIBBAD: usize = 0xFFFFFFFFFFFFFFB0;
// A regular file whose bytes cannot be read. Linux answers execve(2) with
// this when the header read itself fails, rather than with a verdict about a
// format it never saw.
const LINUX_EIO: usize = 0xFFFFFFFFFFFFFFFB;
// GitHub issue #538: the errnos BusyBox mkdir and rmdir tell apart.
const LINUX_EEXIST: usize = 0xFFFFFFFFFFFFFFEF;
const LINUX_ENOTDIR: usize = 0xFFFFFFFFFFFFFFEC;
const LINUX_ENOTEMPTY: usize = 0xFFFFFFFFFFFFFFD9;
const LINUX_EISDIR: usize = 0xFFFFFFFFFFFFFFEB;
const LINUX_EPERM: usize = 0xFFFFFFFFFFFFFFFF;
const LINUX_EBUSY: usize = 0xFFFFFFFFFFFFFFF0;
const LINUX_AT_REMOVEDIR: usize = 0x200;
// RLIMIT_NOFILE, and Linux's RLIM64_INFINITY.
const LINUX_RLIMIT_NOFILE: usize = 7;
// Linux's RLIM_NLIMITS (include/uapi/asm-generic/resource.h): the number of
// resources that exist, and therefore the first invalid one.
const LINUX_RLIM_NLIMITS: usize = 16;
const LINUX_RLIM64_INFINITY: usize = 0xFFFFFFFFFFFFFFFF;
const LINUX_SYSLOG_ACTION_READ_ALL: usize = 3;
const LINUX_SYSLOG_ACTION_SIZE_BUFFER: usize = 10;

// GitHub issue #393: AT_FDCWD, spelled the way userspace passes it -- the
// 32-bit -100 sign-extended into x0. It used to be caught by accident:
// the dirfd paths below tested `x0 < PROCESS_FD_MAX` before treating x0 as
// a directory descriptor, and AT_FDCWD failed that test along with every
// other out-of-range value. With no such range left, "relative to the
// current directory" has to be recognised for what it is, which is also
// what Linux does -- any OTHER value really is a descriptor, and an
// unopened one really is EBADF.
const LINUX_AT_FDCWD: usize = 0xFFFFFFFFFFFFFF9C;
const LINUX_AT_EACCESS: usize = 0x200;
const LINUX_F_DUPFD: usize = 0;
const LINUX_F_SETFD: usize = 2;
const LINUX_F_DUPFD_CLOEXEC: usize = 1030;
const LINUX_WNOHANG: usize = 1;

const LINUX_PROT_READ: usize = 1;
const LINUX_PROT_WRITE: usize = 2;

// Issue #196: ABI-facing layout structs used only for sizeof/offsetof --
// actual field access always goes through user_read_u32/u64/
// user_write_u16/copy_to_user against a scratch buffer or a validated
// UserRange, never a constructed struct value, matching this codebase's
// existing KernelElf64Header pattern (kernel/fs/elf64.tkb).

// struct utsname (aarch64 Linux ABI, <sys/utsname.h>): six 65-byte
// (64 chars + NUL) fields, no padding between them.
const UTSNAME_FIELD_SIZE: usize = 65;
struct packed Utsname {
    sysname: [u8; UTSNAME_FIELD_SIZE];
    nodename: [u8; UTSNAME_FIELD_SIZE];
    release: [u8; UTSNAME_FIELD_SIZE];
    version: [u8; UTSNAME_FIELD_SIZE];
    machine: [u8; UTSNAME_FIELD_SIZE];
    domainname: [u8; UTSNAME_FIELD_SIZE];
}

// struct iovec (aarch64 Linux ABI, <sys/uio.h>).
struct packed Iovec {
    iov_base: usize;
    iov_len: usize;
}

// struct pollfd (aarch64 Linux ABI, <poll.h>).
struct packed Pollfd {
    fd: i32;
    events: i16;
    revents: i16;
}

const POLLIN: usize = 0x0001;
const POLLNVAL: usize = 0x0020;

// Linux's own iovec-count cap (UIO_MAXIOV, include/uapi/linux/uio.h) --
// keeps iovcnt*sizeof(Iovec) far below any real overflow risk even before
// checked_mul_usize is applied, and keeps the per-iovec/pollfd validation
// loop provably bounded for --forbid-trap. Checked as `>= IOV_MAX`
// (rejecting the boundary value itself, not just values above it) so the
// accepted range narrows cleanly to the refined type `{0..<IOV_MAX}`
// with no separate lower-bound proof needed.
const IOV_MAX: usize = 1024;
// This kernel's own cap for pollfd arrays (not a Linux constant), same
// rationale and same off-by-one-avoiding `>=` check.
const POLL_MAX: usize = 1024;

// GitHub issue #409 removed the second name for the descriptor capacity
// from this file; issue #393 removed the capacity. The socket paths here
// range-checked fd values against it and then delegated to
// unified_fd_alloc/unified_socket_lookup; there is no range to check any
// more -- a descriptor is admitted by this process's own RLIMIT_NOFILE and
// validated by whether its block chain holds it, both of which are
// fd_table.tkb's to answer.
//
// The incident that makes a duplicated capacity worth remembering is
// recorded in kernel/RESOURCE_LIMITS.md: this file carried a literal 8
// while the real table was 16, so socket()/accept() reported resource
// exhaustion at fd>=8 while free slots existed -- a wrong refusal rather
// than a compile error, hit by a shell whose first eight descriptors were
// busy. Issue #295 made it a real reference so it could not drift
// numerically, #409 removed the second name, and #393 removed the number
// itself: what is left cannot disagree with anything.

private let mut syscall_ext2_mount: Ext2Mount;
private let mut syscall_ext2_ready: bool;
const SYSCALL_SCRIPT_LINE_MAX: usize = 256;
// Scratch that lives only for one non-preemptible syscall invocation. Per
// core rather than global: two cores may dispatch concurrently, but one core
// cannot enter a second handler until the current one returns while
// KERNEL_PREEMPTIBLE is zero. The file buffer is a bounded one-block staging
// area, not a whole-file cache; read/readv/sendfile stream each chunk onward,
// so its size does not limit the file size userspace can consume. execve uses
// three disjoint regions of that same invocation-local buffer for argv, path,
// and script-header staging; it never overlaps a file-data syscall.
struct SyscallScratch {
    file_buffer: [u8; KERNEL_BLOCK_SIZE];
    path_buffer: [u8; 256];
    sockaddr_buffer: [u8; 28];
    // Headroom over sizeof(Utsname) (390 bytes), since array declarations
    // cannot use sizeof directly.
    uname_buffer: [u8; 512];
    // Two struct rlimit64 values. User memory is never accessed in place.
    rlimit_buffer: [u8; 16];
    // GitHub issue #591: an ELF's PT_INTERP name, for the ext2 lookup.
    interpreter_buffer: [u8; 64];
}

private let mut syscall_scratch: [SyscallScratch; KERNEL_MAX_CORES];

private fn syscall_scratch_here() -> *SyscallScratch {
    // Takibi cannot take &array[index] yet (issue #385), so use the same
    // bounded array-decay pattern as process.tkb's execution_here(). A
    // hardware affinity outside KERNEL_MAX_CORES falls back to slot zero;
    // such a core is not active and must never reach syscall dispatch.
    let base: *SyscallScratch = syscall_scratch;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}
// GitHub issue #257: connection_open, socket_buffer_length/_offset and
// inetd_response_length used to be four more [T; TCP_CONNECTION_MAX]
// arrays here (step 2), and syscall_socket_buffer/syscall_inetd_response
// two more, at 1460 bytes per connection each (step 4b). All six are gone.
// The scalars are fields of kernel/net/tcp.tkb's TcpConnection; the two
// buffers are pooled NetFrames owned there, reached through
// tcp_connection_rx_slice()/tcp_connection_inetd_slice(). **No storage in
// this file is keyed by a connection index any more.** TCP_CONNECTION_MAX
// itself still appears, as the refinement on slot values passed across the
// tcp.tkb boundary ({0..<TCP_CONNECTION_MAX as usize}) and the loops that
// reset every connection -- proofs about an index, not the size of
// anything here. Those go when step 5 makes a connection's identity an
// address.

// struct rlimit64 is two little-endian u64s. Written a byte at a time
// rather than through a pointer cast onto the buffer: the cast would be
// unsafe (issue #316) and would assume an alignment a u8 array does not
// promise, and this is called twice per prlimit64 call.
private fn syscall_rlimit_store(field: borrow [u8; 8..], value: usize) {
    for i: usize in 0..<8 {
        field[i] = ((value >> (i * 8)) & 0xFF) as u8;
    }
}

private fn syscall_rlimit_load(field: borrow [u8; 8..]) -> usize {
    let mut value: usize = 0;
    for i: usize in 0..<8 {
        value = value | ((field[i] as usize) << (i * 8));
    }
    return value;
}

must_use variant KernelInetdAcceptResult { TimedOut; Accepted; }

// GitHub issue #392: CloneFileState and UartBlockDelivery, and the two
// `[T; KERNEL_PROCESS_MAX]` arrays that held them, are gone from this
// file. The original two were keyed by process slot, which is a key that stops
// existing when the process table becomes a pool; the values are fields
// of ProcessRecord now, reached through
// scheduled_process_clone_file_state()/_uart_block_delivery() and their
// setters. Every decision made with them is still made here.
// The first line of an execve(2) target, read before any image is chosen.
// Bounded on purpose: this is the whole window in which a `#!` interpreter
// directive is allowed to live, and the kernel must decide the executable
// format from a fixed-size read rather than a file-length-dependent scan.
//
// 256 is Linux's own BINPRM_BUF_SIZE, and matching it exactly is what makes
// the boundary behave the same: an interpreter name that does not fit is
// ENOEXEC on both, and one that does fit is resolved on both. The window is
// zero-filled before the read for the same reason Linux zero-pads its
// buffer -- a file with no trailing newline then ends at a NUL, which the
// scan below treats as the end of the directive.

must_use variant SyscallPathResult { Fault; Invalid; Name([]u8); }

fn kernel_syscall_daemon_start() {
    // Reinitialize only reusable TCP/socket scratch state; unlike
    // kernel_syscall_process_configure(), this must not clear the parent
    // shell's descriptors or the HTTPD child's clone-reap record. Interactive
    // HTTPd uses this same handoff, but does not opt into the bounded test
    // lifecycle below.
    // GitHub issue #257 step 5: the per-connection reset loop that stood
    // here is gone with the connections it walked. A connection exists only
    // while it is allocated, and tcp_connection_pool_init drains every one
    // -- there is no fixed set of slots left to put back into a clean
    // state.
    tcp_connection_pool_init();
    kernel_syscall_set_inetd_mode(false);
    syscall_test_lifecycle_daemon_reset();
}

fn kernel_syscall_exec_pending() -> bool {
    return scheduled_process_exec_pending(kernel_syscall_process_slot());
}
fn kernel_syscall_exec_argc() -> usize {
    return scheduled_process_exec_argc(kernel_syscall_process_slot());
}
fn kernel_syscall_exec_argv() -> []u8 {
    return scheduled_process_command_line(kernel_syscall_process_slot());
}
fn kernel_syscall_exec_clear() {
    scheduled_process_set_exec_pending(kernel_syscall_process_slot(), false);
}

private fn syscall_exec_argv_here() -> [u8; 512..] {
    let scratch: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch_here().file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    return scratch[0..<512];
}

private fn syscall_exec_path_here() -> [u8; 256..] {
    let scratch: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch_here().file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    return scratch[512..<768];
}

private fn syscall_script_line_here() -> [u8; 256..] {
    let scratch: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch_here().file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    return scratch[768..<1024];
}

private fn kernel_syscall_inetd_mode() -> bool {
    return scheduled_process_inetd_mode(kernel_syscall_process_slot());
}

private fn kernel_syscall_set_inetd_mode(enabled: bool) {
    scheduled_process_set_inetd_mode(kernel_syscall_process_slot(), enabled);
}

// GitHub issue #591: the inode execve resolved its pathname to, which is
// what decides a dynamic image. argv[0] cannot: a shell passes `httpd` for
// `/bin/httpd`. Zero when no ELF inode was resolved (no filesystem yet, or
// a `#!` script, whose image is the interpreter argv[0] names).
fn kernel_syscall_exec_inode() -> usize {
    return scheduled_process_exec_inode(kernel_syscall_process_slot());
}

// A `#!` script is executed by naming an interpreter, so the image execve(2)
// finally loads is not the file the caller named. Both facts are staged here
// before any image is chosen: `argc`/`length` describe the replacement argv
// prefix already written into syscall_exec_argv.
struct SyscallScriptPrefix {
    argc: usize;
    length: usize;
}

// Each case below was measured against Linux rather than assumed, because
// the errno is the whole interface a shell has to this decision:
//   absent path                        ENOENT
//   directory, or any non-regular file EACCES
//   regular file with no execute bit   EACCES   (before any header is read)
//   regular file, not ELF and not `#!` ENOEXEC
//   `#!` naming a missing interpreter  ENOENT   (the interpreter's error)
must_use variant SyscallExecFormatResult {
    // No filesystem yet. The caller keeps whatever image-selection path it
    // already had; deciding a format needs a file to read, and at this point
    // in the boot there is nowhere to read one from.
    NotMounted;
    Absent;
    NotPermitted;
    Unreadable;
    Executable(usize);
    NotExecutable;
    // GitHub issue #591: an ELF whose PT_INTERP names a file that is not
    // there -- ENOENT, as on Linux -- and one naming a file that is, but is
    // not the musl loader, the only interpreter this kernel maps (ELIBBAD).
    InterpreterAbsent;
    InterpreterUnsupported;
    Invalid;
    Script(SyscallScriptPrefix);
}

must_use variant SyscallExecTargetResult {
    Absent;
    NotPermitted;
    Inode(usize);
}

// The kernel has no user/group identity model yet. A requested operation is
// permitted when any corresponding owner, group, or other mode bit is set.
// Both faccessat X_OK and execve use this same execute-bit rule; execve also
// requires a regular file before it asks the question.
private fn syscall_inode_mode_allows(inode_mode: usize, requested: usize)
        -> bool {
    if ((requested & 4) != 0 && (inode_mode & 0x124) == 0) { return false; }
    if ((requested & 2) != 0 && (inode_mode & 0x92) == 0) { return false; }
    if ((requested & 1) != 0 && (inode_mode & 0x49) == 0) { return false; }
    return true;
}

// Does this pathname name something this kernel may execute at all? Asked
// before any byte of the file is read, in the order Linux asks it: a
// directory or a device node is refused for being the wrong kind of object,
// and a regular file with no execute bit is refused for being unexecutable,
// neither of which is a statement about its contents.
private fn syscall_exec_target(name: []u8) -> SyscallExecTargetResult
        !{unsafe} {
    match ext2_lookup_path(syscall_ext2_mount, name) {
        Ext2LookupResult::Invalid => { return SyscallExecTargetResult::Absent; }
        Ext2LookupResult::NotFound => {
            return SyscallExecTargetResult::Absent;
        }
        Ext2LookupResult::Found(inode) => {
            let mode: usize = ext2_inode_mode(syscall_ext2_mount, inode);
            if ((mode & 0xF000) != 0x8000) {
                return SyscallExecTargetResult::NotPermitted;
            }
            // 0o111. Linux refuses a regular file with no execute bit before
            // it reads a single header byte, and CAP_DAC_OVERRIDE does not
            // bypass exec permission -- so a uid-0 process sees this same
            // refusal, which is what makes it the right answer for a kernel
            // that has no uid model of its own yet.
            if (syscall_inode_mode_allows(mode, 1) == false) {
                return SyscallExecTargetResult::NotPermitted;
            }
            return SyscallExecTargetResult::Inode(inode);
        }
    }
}

must_use variant SyscallArgvAppendResult { Full; Appended(usize); }

// Append one NUL-terminated entry to the pending execve argv buffer and
// return the offset the next entry starts at.
private fn syscall_exec_argv_append(offset: usize, source: []u8)
        -> SyscallArgvAppendResult {
    let argv_view: []u8 = syscall_exec_argv_here();
    if (offset > argv_view.len) { return SyscallArgvAppendResult::Full; }
    let tail = argv_view[offset..<argv_view.len];
    let length: usize = source.len;
    if (length > tail.len) { return SyscallArgvAppendResult::Full; }
    let destination = tail[0..<length];
    if (slice_copy(destination, source) != length) {
        return SyscallArgvAppendResult::Full;
    }
    if (length < tail.len) {
        tail[length] = 0;
    } else {
        return SyscallArgvAppendResult::Full;
    }
    return SyscallArgvAppendResult::Appended(offset + length + 1);
}

// The same append, for a byte range of the staged `#!` line. It walks the
// staging array's own static size rather than subslicing it, so the range the
// directive parser produced needs no relational proof between its two ends:
// every index is bounded by the array, and the range is a filter over that
// walk instead of a slice construction.
private fn syscall_exec_argv_append_line(offset: usize, from: usize,
                                         to: usize)
        -> SyscallArgvAppendResult {
    let argv_view: []u8 = syscall_exec_argv_here();
    let line: []u8 = syscall_script_line_here();
    let mut cursor: usize = offset;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= from && position < to) {
            let value: u8 = line[position];
            if (cursor < argv_view.len) {
                argv_view[cursor] = value;
            } else {
                return SyscallArgvAppendResult::Full;
            }
            cursor = cursor + 1;
        }
    }
    if (cursor < argv_view.len) {
        argv_view[cursor] = 0;
    } else {
        return SyscallArgvAppendResult::Full;
    }
    return SyscallArgvAppendResult::Appended(cursor + 1);
}

// Parse the `#!` directive already staged in the current core's scratch and build
// the replacement argv: the interpreter becomes argv[0], its single optional
// argument follows, and the pathname execve(2) was called with takes the
// place of the caller's own argv[0]. That is the argv shape Linux's script
// binfmt produces, and the reason the pathname is used rather than argv[0] is
// that the interpreter has to be able to open the script it was given.
// The process's exec path is rewritten to the interpreter for the same reason the
// argv is: it names the image that will actually be loaded.
private fn syscall_exec_script_prefix(line_length: usize, path_length: usize)
        -> SyscallExecFormatResult {
    let line: []u8 = syscall_script_line_here();
    let mut end: usize = 0;
    let mut line_terminated: bool = false;
    // The whole window is scanned, not only the bytes the file supplied: it
    // was zero-filled first, so a file with no trailing newline ends at a
    // padding NUL. Linux ends the directive at '\n' OR NUL for exactly that
    // reason, and `#!/bin/sh` with no newline is a working script there.
    //
    // CR is deliberately NOT a terminator. A CRLF script carries an
    // interpreter named "/bin/sh\r", which does not exist -- Linux reports
    // ENOENT for it, and being more forgiving here would mean a script that
    // runs on this kernel and fails on Linux.
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (line_terminated == false) {
            let current: u8 = line[position];
            if (current == 0x0A || current == 0) {
                end = position;
                line_terminated = true;
            }
        }
    }
    // A first line that fills the whole staging window without ending is a
    // truncated directive. The interpreter name it appears to carry may be
    // cut in half, and running the wrong program is worse than refusing.
    if (line_terminated == false) {
        return SyscallExecFormatResult::NotExecutable;
    }
    let mut interpreter_start: usize = end;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= 2 && position < end && interpreter_start == end) {
            let current: u8 = line[position];
            if (current != 0x20 && current != 0x09) {
                interpreter_start = position;
            }
        }
    }
    let mut interpreter_end: usize = end;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= interpreter_start && position < end &&
            interpreter_end == end) {
            let current: u8 = line[position];
            if (current == 0x20 || current == 0x09) {
                interpreter_end = position;
            }
        }
    }
    let mut argument_start: usize = end;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= interpreter_end && position < end &&
            argument_start == end) {
            let current: u8 = line[position];
            if (current != 0x20 && current != 0x09) {
                argument_start = position;
            }
        }
    }
    let mut argument_end: usize = argument_start;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= argument_start && position < end) {
            let current: u8 = line[position];
            if (current != 0x20 && current != 0x09) {
                argument_end = position + 1;
            }
        }
    }
    let interpreter_from: usize = interpreter_start;
    let interpreter_to: usize = interpreter_end;
    if (interpreter_from >= interpreter_to) {
        return SyscallExecFormatResult::NotExecutable;
    }
    if (interpreter_to > SYSCALL_SCRIPT_LINE_MAX) {
        return SyscallExecFormatResult::NotExecutable;
    }
    // A relative interpreter name would have to be resolved against a working
    // directory this kernel does not track. Linux resolves it against the
    // caller's cwd and reports ENOENT when that fails, which is the same
    // answer this reaches by a shorter route -- and the same answer a shell
    // has to act on either way.
    let mut interpreter_absolute: bool = false;
    if (interpreter_from < line.len) {
        interpreter_absolute = line[interpreter_from] == 0x2F;
    }
    if (interpreter_absolute == false) {
        return SyscallExecFormatResult::Absent;
    }
    let mut offset: usize = 0;
    let mut argc: usize = 0;
    match syscall_exec_argv_append_line(offset, interpreter_from,
                                        interpreter_to) {
        SyscallArgvAppendResult::Full => {
            return SyscallExecFormatResult::Invalid;
        }
        SyscallArgvAppendResult::Appended(next) => { offset = next; }
    }
    argc = argc + 1;
    let argument_from: usize = argument_start;
    let argument_to: usize = argument_end;
    if (argument_from < argument_to) {
        match syscall_exec_argv_append_line(offset, argument_from,
                                            argument_to) {
            SyscallArgvAppendResult::Full => {
                return SyscallExecFormatResult::Invalid;
            }
            SyscallArgvAppendResult::Appended(next) => { offset = next; }
        }
        argc = argc + 1;
    }
    let stored_path: []u8 = syscall_exec_path_here();
    if (path_length > stored_path.len) {
        return SyscallExecFormatResult::Invalid;
    }
    let script_path = stored_path[0..<path_length];
    match syscall_exec_argv_append(offset, script_path) {
        SyscallArgvAppendResult::Full => {
            return SyscallExecFormatResult::Invalid;
        }
        SyscallArgvAppendResult::Appended(next) => { offset = next; }
    }
    argc = argc + 1;
    // The pathname execve(2) was called with is in the replacement argv now,
    // so the stored path can become what it has to name from here on: the
    // image that will actually be loaded.
    for path_index: usize in 0..<256 { stored_path[path_index] = 0; }
    let mut path_cursor: usize = 0;
    for position: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
        if (position >= interpreter_from && position < interpreter_to) {
            let value: u8 = line[position];
            if (path_cursor < 256) {
                let bounded: {0..<256 as usize} = path_cursor;
                stored_path[bounded] = value;
            } else {
                return SyscallExecFormatResult::Invalid;
            }
            path_cursor = path_cursor + 1;
        }
    }
    // Linux resolves the interpreter itself and reports ITS error, so a
    // script naming a missing interpreter is ENOENT and one naming a
    // directory is EACCES -- neither is a complaint about the script. The
    // stored path is the interpreter now, so the same question asked of the
    // original target above is asked of it here.
    let interpreter_path: []u8 = stored_path;
    let interpreter_length: usize = path_cursor;
    if (interpreter_length > interpreter_path.len) {
        return SyscallExecFormatResult::Invalid;
    }
    let interpreter_full = interpreter_path[0..<interpreter_length];
    if (interpreter_full.len < 2) {
        return SyscallExecFormatResult::Absent;
    }
    match syscall_exec_target(interpreter_full[1..<interpreter_full.len]) {
        SyscallExecTargetResult::Absent => {
            return SyscallExecFormatResult::Absent;
        }
        SyscallExecTargetResult::NotPermitted => {
            return SyscallExecFormatResult::NotPermitted;
        }
        SyscallExecTargetResult::Inode(interpreter_inode) => {}
    }
    let mut prefix: SyscallScriptPrefix = { argc, offset };
    return SyscallExecFormatResult::Script(prefix);
}

// Decide an execve(2) target's executable format from one bounded read of the
// file itself, rather than from the caller's argv. This runs at syscall time
// on purpose: the image is not mapped until the syscall's action tail, which
// has no way left to report an error to userspace, so every refusal a shell
// can act on has to be decided here.
// GitHub issue #591: decide an ELF's interpreter at syscall time, where a
// refusal can still be an errno. Past this point the exec is committed and
// a failure to map fail-stops the caller. An ELF this validator rejects is
// left to the mapping path exactly as before; only a valid PT_INTERP is
// judged here.
const SYSCALL_EXEC_INTERPRETER_MAX: usize = 64;

private fn syscall_exec_elf_interpreter(inode: usize)
        -> SyscallExecFormatResult !{unsafe} {
    let window: [u8; KERNEL_BLOCK_SIZE..] =
        syscall_scratch_here().file_buffer as [u8; KERNEL_BLOCK_SIZE..];
    let file_length: usize = ext2_regular_file_size(syscall_ext2_mount, inode);
    let length: usize = match ext2_read_file_chunk(
            syscall_ext2_mount, inode, 0, window) {
        Ext2ReadResult::Invalid => {
            return SyscallExecFormatResult::Unreadable;
        }
        Ext2ReadResult::Read(read) => { read }
    };
    if (length > KERNEL_BLOCK_SIZE) {
        return SyscallExecFormatResult::Unreadable;
    }
    let bounded: {0..<KERNEL_BLOCK_SIZE + 1 as usize} = length;
    let plan: DistroElfLoadPlan =
        match distro_elf_validate_with_length(window[0..<bounded],
                                              file_length) {
            DistroElfResult::Invalid => {
                return SyscallExecFormatResult::Executable(inode);
            }
            DistroElfResult::Valid(valid) => { valid }
        };
    let named: usize = plan.interpreter_length;
    if (named == 0) {
        return SyscallExecFormatResult::Executable(inode);
    }
    // The string less its leading slash and its NUL is the relative name
    // ext2_lookup_path takes. Copied out of the window by walking the
    // window's own fixed size, so every index is bounded by the array.
    let offset: usize = plan.interpreter_offset;
    if (named < 3 || named - 2 > SYSCALL_EXEC_INTERPRETER_MAX ||
        offset >= length || named > length - offset ||
        window[offset] != 0x2F) {
        return SyscallExecFormatResult::InterpreterUnsupported;
    }
    let name: [u8; SYSCALL_EXEC_INTERPRETER_MAX..] =
        syscall_scratch_here().interpreter_buffer as
            [u8; SYSCALL_EXEC_INTERPRETER_MAX..];
    // The name ends at its first NUL, as Linux reads it, not at the end of
    // the segment.
    let mut target: usize = 0;
    let mut ended: bool = false;
    for position: usize in 0..<KERNEL_BLOCK_SIZE {
        if (position > offset && position < offset + named - 1 &&
            ended == false) {
            let byte: u8 = window[position];
            if (byte == 0) {
                ended = true;
            } else {
                if (target < SYSCALL_EXEC_INTERPRETER_MAX) {
                    name[target] = byte;
                }
                target = target + 1;
            }
        }
    }
    let name_length: usize = target;
    if (name_length > SYSCALL_EXEC_INTERPRETER_MAX) {
        return SyscallExecFormatResult::InterpreterUnsupported;
    }
    let bounded_name: {0..<SYSCALL_EXEC_INTERPRETER_MAX + 1 as usize} =
        name_length;
    let relative: []u8 = name[0..<bounded_name];
    match ext2_lookup_path(syscall_ext2_mount, relative) {
        Ext2LookupResult::Invalid => {
            return SyscallExecFormatResult::InterpreterAbsent;
        }
        Ext2LookupResult::NotFound => {
            return SyscallExecFormatResult::InterpreterAbsent;
        }
        Ext2LookupResult::Found(found) => {}
    }
    if (slice_eq(relative, bs"lib/ld-musl-aarch64.so.1")) {
        return SyscallExecFormatResult::Executable(inode);
    }
    return SyscallExecFormatResult::InterpreterUnsupported;
}

private fn syscall_exec_format(name: []u8, path_length: usize)
        -> SyscallExecFormatResult !{unsafe} {
    if (syscall_ext2_ready == false) {
        return SyscallExecFormatResult::NotMounted;
    }
    match syscall_exec_target(name) {
        SyscallExecTargetResult::Absent => {
            return SyscallExecFormatResult::Absent;
        }
        SyscallExecTargetResult::NotPermitted => {
            return SyscallExecFormatResult::NotPermitted;
        }
        SyscallExecTargetResult::Inode(inode) => {
            let line: []u8 = syscall_script_line_here();
            for index: usize in 0..<SYSCALL_SCRIPT_LINE_MAX {
                line[index] = 0;
            }
            match ext2_read_file_chunk(syscall_ext2_mount, inode, 0, line) {
                Ext2ReadResult::Invalid => {
                    // The kind and the permission were already settled above,
                    // so what is left is a read that failed on a file this
                    // kernel was allowed to execute. Linux reports the read's
                    // own error rather than a verdict about a format it never
                    // saw.
                    return SyscallExecFormatResult::Unreadable;
                }
                Ext2ReadResult::Read(length) => {
                    if (length < 4) {
                        return SyscallExecFormatResult::NotExecutable;
                    }
                    if (line[0] == 0x7F && line[1] == 0x45 &&
                        line[2] == 0x4C && line[3] == 0x46) {
                        return syscall_exec_elf_interpreter(inode);
                    }
                    if (line[0] != 0x23 || line[1] != 0x21) {
                        return SyscallExecFormatResult::NotExecutable;
                    }
                    return syscall_exec_script_prefix(length, path_length);
                }
            }
        }
    }
}

must_use variant KernelFdReapResult { Failed; Reaped; }
// GitHub issue #257 step 5: the payload was
// `{0..<TCP_CONNECTION_MAX as usize}` -- a proof that the value indexed a
// real element of an array that no longer exists. It is a pool ADDRESS
// now, and plain `usize` is the honest type for one: what used to be a
// bounds proof is intrusive_pool_matches, which the take path performs on
// every use and which also catches the case a bounds proof never could,
// an address that is in range but names a connection that has since
// closed.
must_use variant KernelConnectionLookupResult {
    Missing;
    Found(usize);
}
// GitHub issue #393: plain usize. A descriptor number is bounded by the
// process's own RLIMIT_NOFILE, a runtime value, so there is no
// compile-time range to state -- the same trade the connection lookup
// above already made for a pool address.
must_use variant KernelSocketFdAllocResult {
    Full;
    Allocated(usize);
}
must_use variant KernelListenerLookupResult {
    Missing;
    Found(usize);
}

// GitHub issue #245: fd-table process slot == process.tkb's own
// ProcessHandle.pool_index (same convention as the address-space root),
// so this is now a direct pass-through instead of a binary pid==2?1:0.
fn kernel_syscall_process_slot() -> usize {
    return address_space_root_slot(kernel_process_current_root());
}

fn kernel_syscall_file_lookup(fd: usize) -> UnifiedFileResult {
    return unified_file_lookup(kernel_syscall_process_slot(), fd);
}

fn kernel_syscall_directory_is_open(fd: usize) -> bool {
    match unified_directory_lookup(kernel_syscall_process_slot(), fd) {
        UnifiedDirectoryResult::Missing => { return false; }
        UnifiedDirectoryResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_directory_inode(fd: usize) -> usize {
    match unified_directory_lookup(kernel_syscall_process_slot(), fd) {
        UnifiedDirectoryResult::Missing => { return 0; }
        UnifiedDirectoryResult::Found(handle) => {
            return unified_directory_inode(handle);
        }
    }
}

fn kernel_syscall_file_is_open(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_terminal_is_open(fd: usize) -> bool {
    return unified_terminal_is_open(kernel_syscall_process_slot(), fd);
}

fn kernel_syscall_file_readable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_readable(handle);
        }
    }
}

fn kernel_syscall_file_writable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_writable(handle);
        }
    }
}

fn kernel_syscall_file_inode(fd: usize) -> usize {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return 0; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_inode(handle);
        }
    }
}

fn kernel_syscall_file_offset(fd: usize) -> usize {
    match unified_fd_offset(kernel_syscall_process_slot(), fd) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_file_set_offset(fd: usize, value: usize) -> bool {
    match unified_fd_set_offset(kernel_syscall_process_slot(), fd, value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

fn kernel_syscall_procfs_open(node: ProcfsNode, fd: usize)
        -> SyscallAction {
    if (procfs_node_is_directory(node)) {
        match unified_directory_open(kernel_syscall_process_slot(), fd,
                                     node.inode) {
            UnifiedOpenResult::Invalid => {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            UnifiedOpenResult::Full => {
                return SyscallAction::Resume(LINUX_ENFILE);
            }
            UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
        }
    }
    match unified_file_open(kernel_syscall_process_slot(), fd, node.inode,
                            true, false) {
        UnifiedOpenResult::Invalid => {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        UnifiedOpenResult::Full => {
            return SyscallAction::Resume(LINUX_ENFILE);
        }
        UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
    }
}

// This process's own soft RLIMIT_NOFILE, for the exhaustion log lines that
// used to print the constant. Reporting the limit that actually refused
// the call is the point: two processes can now be refused at different
// numbers.
fn kernel_syscall_fd_limit_soft() -> usize !{unsafe} {
    match unified_process_fd_limit(kernel_syscall_process_slot()) {
        UnifiedFdLimitResult::Missing => { return 0; }
        UnifiedFdLimitResult::Found(pair) => {
            let (soft, hard) = pair;
            return soft;
        }
    }
}

fn kernel_syscall_heap_break() -> usize {
    match unified_process_heap_break(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_set(value: usize) -> bool {
    match unified_process_heap_configure(kernel_syscall_process_slot(), value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

fn kernel_syscall_heap_start() -> usize {
    match unified_process_heap_start(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_limit() -> usize {
    match unified_process_heap_limit(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

// Exec replaces only the calling process's image. Its brk/mmap arena must
// therefore be replaced in the same FD-context slot without resetting the
// parent shell's descriptors or global TCP state.
fn kernel_syscall_process_configure_current(
        heap_start: usize, heap_limit: usize) {
    match unified_process_heap_range_configure(
            kernel_syscall_process_slot(), heap_start, heap_limit) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

fn kernel_syscall_process_configure(heap_start: usize, heap_limit: usize)
        !{unsafe} {
    unified_fd_context_pool_init();
    unified_fd_table_init();
    // GitHub issue #392: process slot 0 is the bootstrap, which this
    // kernel sets up directly rather than through
    // scheduled_process_alloc -- so it is the one process that does not
    // get an fd context from the allocation path, and has to be given one
    // here. It got one for free while contexts were an array with an entry
    // per slot whether or not a process occupied it.
    if (unified_fd_context_ensure(0) == false) {
        kernel_boot_log_resource_exhausted(
            "physical page allocator" as *u8, page_allocator_total_count());
    }
    if (process_image_record_ensure(0) == false) {
        kernel_boot_log_resource_exhausted(
            "physical page allocator" as *u8, page_allocator_total_count());
    }
    match unified_terminal_stdio_open(0) {
        UnifiedOpenResult::Invalid => {}
        UnifiedOpenResult::Full => {
            kernel_boot_log_resource_exhausted(
                "shared object pool" as *u8, unified_object_max_files());
        }
        UnifiedOpenResult::Ok => {}
    }
    match unified_process_heap_range_configure(0, heap_start, heap_limit) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
    syscall_test_evidence_reset_read_uart_waits();
    syscall_test_lifecycle_persistent_shell_clear();
    scheduled_process_reset_syscall_state_everywhere();
    tcp_connection_pool_init();
    syscall_test_evidence_reset_socket_counters();
    kernel_syscall_set_inetd_mode(false);
    // This file's process-owned values are cleared above, in one walk over
    // the live processes -- configure is a whole-world reset and can run
    // while processes already exist, so it does not rely on
    // scheduled_process_alloc's own per-process reset.
}

// GitHub issue #245: parent/child slots used to be the literal 0/1 (the
// only two the old model could ever produce); child_slot is now whatever
// pool_index kernel_process_clone_begin() actually allocated, passed in
// by the caller once it knows it (see the CLONE syscall handler below,
// which now calls kernel_process_clone_begin() first for exactly this).
fn kernel_syscall_clone_files_begin(parent_slot: usize, child_slot: usize)
        -> UnifiedFdResult {
    if (scheduled_process_slot_valid(child_slot)) {
        match unified_fd_clone(parent_slot, child_slot) {
            UnifiedFdResult::Invalid => {
                let mut failed: CloneFileState = { false };
                scheduled_process_set_clone_file_state(child_slot, failed);
                return UnifiedFdResult::Invalid;
            }
            UnifiedFdResult::Ok => {}
        }
        let mut cloned: CloneFileState = { true };
        scheduled_process_set_clone_file_state(child_slot, cloned);
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn kernel_connected_fd_is_open(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => { return true; }
    }
}

fn kernel_connected_fd_clear(fd: usize) {
    match unified_fd_close(kernel_syscall_process_slot(), fd) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

fn kernel_connection_fd_lookup(fd: usize) -> KernelConnectionLookupResult {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
          // No range test: an address is not in a range, and the check
          // that replaced one runs where the address is USED (see this
          // variant's own comment).
          return KernelConnectionLookupResult::Found(
              unified_connection_slot(handle));
        }
    }
    return KernelConnectionLookupResult::Missing;
}

fn kernel_socket_fd_alloc(first: usize) -> KernelSocketFdAllocResult !{unsafe} {
    match unified_fd_alloc(kernel_syscall_process_slot(), first) {
        UnifiedFdAllocResult::Full => { return KernelSocketFdAllocResult::Full; }
        UnifiedFdAllocResult::Allocated(fd) => {
            return KernelSocketFdAllocResult::Allocated(fd);
        }
    }
}

fn kernel_listener_fd_lookup(fd: usize) -> KernelListenerLookupResult !{unsafe} {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Listener) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
            return KernelListenerLookupResult::Found(fd);
        }
    }
    return KernelListenerLookupResult::Missing;
}

fn kernel_listener_handle(fd: usize) -> UnifiedSocketResult {
    return unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                 UnifiedFdKind::Listener);
}

fn kernel_listener_state(fd: usize) -> UnifiedListenerState {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => {
            return UnifiedListenerState::Closed;
        }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_state(handle);
        }
    }
}

fn kernel_listener_set_state(fd: usize, state: UnifiedListenerState) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_state(handle, state) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_listener_port(fd: usize) -> u16 {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_port(handle);
        }
    }
}

// GitHub issue #469: the handshake this listener is part way through, as
// the (address, generation) pair the connection pool minted. Both zero
// means none.
fn kernel_listener_pending(fd: usize) -> (usize, usize) {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return (0, 0); }
        UnifiedSocketResult::Found(handle) => {
            return (unified_listener_pending_slot(handle),
                    unified_listener_pending_generation(handle));
        }
    }
}

fn kernel_listener_set_pending(fd: usize, slot: usize, generation: usize)
        -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_pending(handle, slot, generation) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_listener_set_port(fd: usize, port: u16) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_port(handle, port) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_connected_fd_duplicate(old_fd: usize, new_fd: usize) -> bool !{unsafe} {
    match unified_fd_duplicate(kernel_syscall_process_slot(), old_fd,
                               new_fd) {
        UnifiedFdInstallResult::Invalid => { return false; }
        UnifiedFdInstallResult::RefOverflow => { return false; }
        UnifiedFdInstallResult::NoMemory => { return false; }
        UnifiedFdInstallResult::Ok => { return true; }
    }
}

// Keep ordinary file/terminal descriptor duplication separate from connected
// socket ownership. dup3 uses this path when replacing a standard descriptor
// with another non-socket object.
fn kernel_regular_fd_duplicate(old_fd: usize, new_fd: usize) -> bool {
    if ((kernel_syscall_terminal_is_open(old_fd) == false &&
         kernel_syscall_file_is_open(old_fd) == false &&
         kernel_syscall_directory_is_open(old_fd) == false)) {
        return false;
    }
    if (old_fd == new_fd) { return true; }
    if (kernel_syscall_terminal_is_open(new_fd) ||
        kernel_syscall_file_is_open(new_fd) ||
        kernel_syscall_directory_is_open(new_fd)) {
        match unified_fd_close(kernel_syscall_process_slot(), new_fd) {
            UnifiedFdResult::Invalid => { return false; }
            UnifiedFdResult::Ok => {}
        }
    }
    match unified_fd_duplicate(kernel_syscall_process_slot(), old_fd, new_fd) {
        UnifiedFdInstallResult::Invalid => { return false; }
        UnifiedFdInstallResult::RefOverflow => { return false; }
        UnifiedFdInstallResult::NoMemory => { return false; }
        UnifiedFdInstallResult::Ok => { return true; }
    }
}

fn kernel_connection_fd_identity(fd: usize) -> usize {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_connection_generation(handle);
        }
    }
    return 0;
}

// GitHub issue #581: whether the connection is still open is decided under
// its owner, not by a probe before taking it, so a close or shutdown on one
// core cannot act on a state another core's call is changing. A connection
// already freed is NotOpen, exactly as the pre-take probe used to answer.
must_use variant KernelTransportReleaseResult { Released; NotOpen; Failed; }

fn kernel_connected_transport_release(slot: usize, generation: usize)
        -> KernelTransportReleaseResult {
    match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => {
            return KernelTransportReleaseResult::NotOpen;
        }
        TcpConnectionTakeResult::Ready(owner) => {
            if (tcp_connection_of(owner).connection_open == false) {
                tcp_connection_put(owner);
                return KernelTransportReleaseResult::NotOpen;
            }
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    tcp_connection_put(owner);
                    return KernelTransportReleaseResult::Failed;
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    match kernel_tcp_close_stream(owner, ready) {
                        KernelTcpCloseResult::Closed(after_close) => {
                            match network_capability_put(after_close) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return KernelTransportReleaseResult::Failed;
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_free(owner);
                                    return KernelTransportReleaseResult::Released;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn kernel_connected_descriptor_release(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
      UnifiedSocketResult::Missing => { return false; }
      UnifiedSocketResult::Found(handle) => {
          let slot: usize = unified_connection_slot(handle);
          let generation: usize = unified_connection_generation(handle);
          let references: usize = unified_object_references(handle);
          {
              if (references == 0) { return false; }
              if (references == 1) {
                  // GitHub issue #257 step 5: `connection_open = false`
                  // used to be written here, into an array element that
                  // outlived the connection. It cannot be written now,
                  // because on success there is no connection left to
                  // write it to -- kernel_connected_transport_release
                  // frees it, and tcp_connection_free clears the flag on
                  // its way out for exactly the readers that used to need
                  // this line.
                  match kernel_connected_transport_release(slot, generation) {
                      KernelTransportReleaseResult::Released => { return true; }
                      KernelTransportReleaseResult::NotOpen => { return true; }
                      KernelTransportReleaseResult::Failed => { return false; }
                  }
              }
              return true;
          }
          return false;
      }
    }
}

// Only ever called from the EXIT handler, while the exiting child is
// still the current process -- so its own fd-table slot is exactly what
// kernel_syscall_process_slot() reports here, and is the slot whose
// CloneFileState this reaps.
fn kernel_syscall_clone_files_reap() -> KernelFdReapResult {
    let child_slot: usize = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(child_slot)) {
        let mut state: CloneFileState =
            scheduled_process_clone_file_state(child_slot);
        if (state.file_state_live == false) {
            return KernelFdReapResult::Failed;
        }
        // GitHub issue #393: over the child's own descriptors. Clearing
        // one removes it from the scan, so the walk restarts after the fd
        // just cleared rather than from 0.
        let mut from: usize = 0;
        let mut scanning: bool = true;
        while (scanning) {
            scanning = false;
            match unified_fd_next_open(child_slot, from) {
                UnifiedFdScanResult::Done => {}
                UnifiedFdScanResult::Found(fd) => {
                    if (kernel_connected_fd_is_open(fd)) {
                        if (kernel_connected_descriptor_release(fd) == false) {
                            return KernelFdReapResult::Failed;
                        }
                        kernel_connected_fd_clear(fd);
                    }
                    from = fd + 1;
                    scanning = true;
                }
            }
        }
        match unified_fd_destroy(child_slot) {
            UnifiedFdResult::Invalid => { return KernelFdReapResult::Failed; }
            UnifiedFdResult::Ok => {}
        }
        let mut reaped: CloneFileState = { false };
        scheduled_process_set_clone_file_state(child_slot, reaped);
        return KernelFdReapResult::Reaped;
    }
    return KernelFdReapResult::Failed;
}

fn kernel_syscall_ext2_configure(mount: Ext2Mount) {
    syscall_ext2_mount = mount;
    syscall_ext2_ready = true;
}

// GitHub issue #257 step 5: this used to assert on connection slots 0 and
// 1 by hand -- a test that enumerated the capacity, which was defensible
// only while the capacity was 2. What it was actually checking is that no
// connection is left open, which is now one question rather than a list.
fn kernel_syscall_socket_evidence() -> bool !{unsafe} {
    // GitHub issue #270: socket() is no longer exactly-once for the whole
    // boot. BusyBox init logs through syslog, so every message(L_LOG) it
    // emits opens a datagram socket, fails to reach /dev/log, and closes
    // it again. That says nothing about this fixture, which is why the
    // count is a floor now. bind/listen/accept stay exact: a syslog socket
    // that never connects never reaches any of them, so the shape being
    // asserted here is unchanged in strength.
    let valid: bool = syscall_test_evidence_socket_calls() >= 1 &&
           syscall_test_evidence_bind_calls() == 1 &&
           syscall_test_evidence_listen_calls() == 1 &&
           syscall_test_evidence_accept_calls() == 2 &&
           syscall_test_evidence_accept_capability_roundtrips() == 2 &&
           tcp_any_connection_open() == false &&
           kernel_connected_fd_is_open(0) == false &&
           kernel_connected_fd_is_open(1) == false &&
           kernel_connected_fd_is_open(5) == false &&
           kernel_connected_fd_is_open(6) == false &&
           syscall_test_evidence_connected_close_calls() == 2 &&
           syscall_test_evidence_connected_read_calls() == 3 &&
           syscall_test_evidence_connected_write_calls() == 4 &&
           syscall_test_evidence_socket_close_calls() == 1 &&
           kernel_listener_state(4) == UnifiedListenerState::Closed;
    syscall_test_evidence_finish_socket_fixture();
    return valid;
}

// Copy one NUL-terminated pathname through the user-memory boundary. Only a
// single root component is supported by this first generic lookup slice;
// directory traversal and symlink resolution remain separate work.
fn kernel_syscall_path_name(address: usize) -> SyscallPathResult {
    let path_view: []u8 = syscall_scratch_here().path_buffer as []u8;
    let mut length: usize = 0;
    let mut terminated: bool = false;
    for offset: usize in 0..<255 {
        if (terminated == false) {
            let current: usize = match checked_add_usize(address, offset) {
                CheckedUsize::Overflow => { return SyscallPathResult::Fault; }
                CheckedUsize::Value(v) => { v }
            };
            match user_range_check_read(kernel_process_current_root(), current, 1) {
                UserReadRangeResult::Fault => { return SyscallPathResult::Fault; }
                UserReadRangeResult::Ok(range) => {
                    if (copy_from_user(range, path_view[offset..<offset + 1]) == false) {
                        return SyscallPathResult::Fault;
                    }
                }
            }
            if (path_view[offset] == 0) {
                length = offset;
                terminated = true;
            }
        }
    }
    if (terminated == false || length == 0) {
        return SyscallPathResult::Invalid;
    }
    let path_length: usize = length;
    if (path_length > path_view.len) {
        return SyscallPathResult::Invalid;
    }
    let full_path = path_view[0..<path_length];
    if (path_length == 1 && path_view[0] == 0x2F) {
        path_view[0] = 0x2E;
    }
    if (path_view[0] == 0x2F) {
        if (full_path.len < 2) {
            return SyscallPathResult::Invalid;
        }
        return SyscallPathResult::Name(full_path[1..<full_path.len]);
    }
    return SyscallPathResult::Name(full_path);
}

// GitHub issue #538: a path a mutating syscall names, split into the
// directory that holds its last component and that component's span in the
// path. Lookup can walk any path; a mutation needs the directory it changes,
// which is the path minus its last component.
struct SyscallParent {
    inode: usize;
    leaf_start: usize;
    leaf_end: usize;
}

must_use variant SyscallParentResult { Errno(usize); Found(SyscallParent); }

fn kernel_syscall_parent_of(dirfd: usize, absolute: bool, path_name: []u8)
        -> SyscallParentResult !{unsafe} {
    // Trailing slashes name the same directory entry (`mkdir a/` is `a`).
    let mut end: usize = path_name.len;
    for step: usize in 0..<256 {
        if (end > 1) {
            let probe: usize = end - 1;
            if (probe < path_name.len) {
                if (path_name[probe] == 0x2F) { end = probe; }
            }
        }
    }
    let mut leaf_start: usize = 0;
    for position: usize in 0..<256 {
        if (position < end && position < path_name.len) {
            if (path_name[position] == 0x2F) { leaf_start = position + 1; }
        }
    }
    let mut start_inode: usize = 2;
    if (absolute == false && dirfd != LINUX_AT_FDCWD) {
        if (kernel_syscall_directory_is_open(dirfd) == false) {
            return SyscallParentResult::Errno(LINUX_EBADF);
        }
        start_inode = kernel_syscall_directory_inode(dirfd);
    }
    let mut parent_inode: usize = start_inode;
    if (leaf_start > 1) {
        let parent_end: usize = leaf_start - 1;
        if (parent_end > path_name.len) {
            return SyscallParentResult::Errno(LINUX_EINVAL);
        }
        let parent_path = path_name[0..<parent_end];
        match ext2_lookup_path_from(syscall_ext2_mount, start_inode,
                                    parent_path) {
            Ext2LookupResult::Invalid => {
                return SyscallParentResult::Errno(LINUX_ENOENT);
            }
            Ext2LookupResult::NotFound => {
                return SyscallParentResult::Errno(LINUX_ENOENT);
            }
            Ext2LookupResult::Found(found) => { parent_inode = found; }
        }
    }
    if ((ext2_inode_mode(syscall_ext2_mount, parent_inode) & 0xF000) !=
        0x4000) {
        return SyscallParentResult::Errno(LINUX_ENOTDIR);
    }
    if (leaf_start >= end) {
        return SyscallParentResult::Errno(LINUX_ENOENT);
    }
    let mut parent: SyscallParent = { parent_inode, leaf_start, end };
    return SyscallParentResult::Found(parent);
}

// The last component, or an empty slice when the span does not fit. Each end
// is checked against what it slices, one at a time, because two ends found
// by separate scans cannot be related to each other.
fn kernel_syscall_leaf(path_name: []u8, parent: SyscallParent) -> []u8 {
    let leaf_end: usize = parent.leaf_end;
    if (leaf_end > path_name.len) { return path_name[0..<0]; }
    let head = path_name[0..<leaf_end];
    let leaf_start: usize = parent.leaf_start;
    if (leaf_start > head.len) { return path_name[0..<0]; }
    return head[leaf_start..<head.len];
}

// `.` and `..` are names a directory has, not entries it can gain or lose.
fn kernel_syscall_leaf_is_dot(leaf: []u8) -> bool {
    if (leaf.len == 1) { return leaf[0] == 0x2E; }
    return false;
}

fn kernel_syscall_leaf_is_dot_dot(leaf: []u8) -> bool {
    if (leaf.len == 2) { return leaf[0] == 0x2E && leaf[1] == 0x2E; }
    return false;
}

// Issue #196: writev(2)/readv(2) per-segment results, kept distinct from
// the underlying byte count instead of encoding "this is actually an
// errno" via a magnitude heuristic (Linux -errno values happen to be
// huge as unsigned usize, which would work, but a discriminated variant
// makes the distinction a type-level fact instead of a convention every
// call site has to remember).
must_use variant WriteSegmentResult { Errno(usize); Written(usize); WouldBlock; }

// GitHub issue #544: a userspace write to the UART terminal, in chunks. Each
// chunk is one bounded copy from user memory into the syscall scratch buffer,
// then as much of it as the transmit queue will take. A write that queues
// some bytes returns that count -- a short write, which POSIX allows and
// musl and BusyBox both finish by writing again. One that can queue nothing,
// because the queue is above its low-water mark, answers WouldBlock and the
// caller puts the writer to sleep instead of spinning in the kernel.
must_use variant TerminalWriteResult { Errno(usize); Written(usize); WouldBlock; }

fn syscall_terminal_write(address: usize, length: usize)
        -> TerminalWriteResult !{unsafe} {
    if (length == 0) { return TerminalWriteResult::Written(0); }
    let mut written: usize = 0;
    while (written < length) {
        let room: usize = uart_user_write_room();
        if (room == 0) {
            if (written == 0) { return TerminalWriteResult::WouldBlock; }
            return TerminalWriteResult::Written(written);
        }
        let mut chunk: usize = length - written;
        if (chunk > room) { chunk = room; }
        if (chunk > KERNEL_BLOCK_SIZE) { chunk = KERNEL_BLOCK_SIZE; }
        let chunk_address: usize = match checked_add_usize(address, written) {
            CheckedUsize::Overflow => {
                if (written == 0) { return TerminalWriteResult::Errno(LINUX_EFAULT); }
                return TerminalWriteResult::Written(written);
            }
            CheckedUsize::Value(v) => { v }
        };
        let staging_buffer = syscall_scratch_here().file_buffer as []u8;
        if (chunk > staging_buffer.len) {
            return TerminalWriteResult::Errno(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk];
        match user_range_check_read(kernel_process_current_root(),
                                    chunk_address, chunk) {
            UserReadRangeResult::Fault => {
                if (written == 0) { return TerminalWriteResult::Errno(LINUX_EFAULT); }
                return TerminalWriteResult::Written(written);
            }
            UserReadRangeResult::Ok(range) => {
                if (copy_from_user(range, staging) == false) {
                    if (written == 0) { return TerminalWriteResult::Errno(LINUX_EFAULT); }
                    return TerminalWriteResult::Written(written);
                }
            }
        }
        let queued: usize = uart_user_write(staging);
        written = written + queued;
        if (queued < chunk) {
            return TerminalWriteResult::Written(written);
        }
    }
    return TerminalWriteResult::Written(written);
}

// The writer that could queue nothing sleeps when something else can run --
// the same question a UART read asks -- and otherwise waits here for the TX
// interrupt and runs the write again, which is what being alone means.
fn syscall_terminal_write_wait() -> SyscallAction {
    // GitHub issue #534: a peer waits for room in its console ring, which
    // only core 0's drain frees. Sleeping on UartTx would have core 0's TX
    // interrupt wake a process on another CPU, a path nothing has audited;
    // retrying on this CPU's own tick needs nothing from core 0 but the
    // drain it does anyway.
    if (cpu_id() != 0) { return SyscallAction::WaitInterrupt; }
    uart_user_write_note_wait();
    if (kernel_process_other_ready()) {
        uart_user_write_note_sleep();
        kernel_process_current_set_pending_block(ProcessWaitReason::UartTx, 0);
        return SyscallAction::Block;
    }
    return SyscallAction::WaitInterrupt;
}
must_use variant ReadSegmentResult { Errno(usize); Read(usize); }

// Single-segment write, fd 1/2 (raw UART) only. Deliberately NOT shared
// with write(64)'s own handler below (which also supports connected TCP
// fds, descriptor duplication, and ext2 files) -- extracting
// that already-proven-working, TCP-timing-sensitive code into a shared
// helper was judged more regression risk than this issue's actual
// traced scenarios (uname -a's writev to stdout) need. Broadening
// writev/readv to the other fd kinds is natural follow-up work, not
// done here.
fn syscall_writev_segment(fd: usize, address: usize, length: usize)
        -> WriteSegmentResult {
    if (kernel_syscall_terminal_is_open(fd) == false) {
        return WriteSegmentResult::Errno(LINUX_EBADF);
    }
    match syscall_terminal_write(address, length) {
        TerminalWriteResult::Errno(errno) => {
            return WriteSegmentResult::Errno(errno);
        }
        TerminalWriteResult::Written(count) => {
            return WriteSegmentResult::Written(count);
        }
        TerminalWriteResult::WouldBlock => {
            return WriteSegmentResult::WouldBlock;
        }
    }
}

// Single-segment read from any open ext2 file descriptor.
fn syscall_readv_segment(fd: usize, address: usize, length: usize)
        -> ReadSegmentResult !{unsafe} {
    if (kernel_syscall_file_is_open(fd) == false ||
            kernel_syscall_file_readable(fd) == false) {
        return ReadSegmentResult::Errno(LINUX_EBADF);
    }
    let mut copied: usize = 0;
    while (copied < length) {
        let mut chunk_limit: usize = length - copied;
        if (chunk_limit > KERNEL_BLOCK_SIZE) {
            chunk_limit = KERNEL_BLOCK_SIZE;
        }
        let staging_buffer = syscall_scratch_here().file_buffer as []u8;
        if (chunk_limit > staging_buffer.len) {
            return ReadSegmentResult::Errno(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk_limit];
        match ext2_read_file_chunk(
                syscall_ext2_mount, kernel_syscall_file_inode(fd),
                kernel_syscall_file_offset(fd),
                staging) {
            Ext2ReadResult::Invalid => {
                if (copied != 0) { return ReadSegmentResult::Read(copied); }
                return ReadSegmentResult::Errno(LINUX_EINVAL);
            }
            Ext2ReadResult::Read(chunk) => {
                if (chunk == 0) { break; }
                let target_address: usize = match checked_add_usize(address, copied) {
                    CheckedUsize::Overflow => {
                        if (copied != 0) { return ReadSegmentResult::Read(copied); }
                        return ReadSegmentResult::Errno(LINUX_EFAULT);
                    }
                    CheckedUsize::Value(value) => { value }
                };
                match user_range_check_write(kernel_process_current_root(),
                                       target_address, chunk) {
                    UserWriteRangeResult::Fault => {
                        if (copied != 0) { return ReadSegmentResult::Read(copied); }
                        return ReadSegmentResult::Errno(LINUX_EFAULT);
                    }
                    UserWriteRangeResult::Ok(range) => {
                        let copied_chunk: bool = copy_to_user_raw(
                            range, syscall_scratch_here().file_buffer as *u8, chunk);
                    }
                }
                if (kernel_syscall_file_set_offset(
                        fd, kernel_syscall_file_offset(fd) + chunk) == false) {
                    if (copied != 0) { return ReadSegmentResult::Read(copied); }
                    return ReadSegmentResult::Errno(LINUX_EBADF);
                }
                copied = copied + chunk;
            }
        }
    }
    return ReadSegmentResult::Read(copied);
}

// ppoll(2) readiness for one fd: (is_valid_fd, revents). fd 0 checks the
// real UART RX ring (kernel_uart_rx_pending()). Its concrete BusyBox ash
// form -- one stdin pollfd and a null timeout -- waits on the retained
// interrupt event until the UART RX IRQ publishes a byte. Mixed fd sets and
// finite timeouts remain out of scope for this first real wait path.
// Connected TCP fds
// check already-buffered data read-only (no mutation, so no risk to the
// proven TCP send/receive paths). Everything else is POLLNVAL.
// The UART RX ring lives in kernel/drivers/serial/uart_rx_ring.tkb (GitHub
// issue #543); this file reads it through kernel_uart_rx_pending and
// kernel_uart_rx_getc.

fn syscall_poll_fd_ready(fd: usize) -> (bool, usize) {
    if (fd == 0 && kernel_syscall_terminal_is_open(fd)) {
        if (kernel_uart_rx_pending()) { return (true, POLLIN); }
        return (true, 0);
    }
    if (kernel_connected_fd_is_open(fd)) {
        match kernel_connection_fd_lookup(fd) {
            KernelConnectionLookupResult::Missing => {
                return (false, POLLNVAL);
            }
            KernelConnectionLookupResult::Found(slot) => {
                if (tcp_connection_has_pending_read(slot)) {
                    return (true, POLLIN);
                }
                return (true, 0);
            }
        }
    }
    if (kernel_syscall_terminal_is_open(fd) ||
        kernel_syscall_file_is_open(fd)) {
        return (true, 0);
    }
    return (false, POLLNVAL);
}

must_use variant SyscallDeadlineResult {
    Fault;
    Invalid;
    Ready;
    Block;
    WaitInterrupt;
}

// Parse one Linux arm64 timespec and either finish a zero/already-expired
// wait or arm the current process against the architectural generic counter.
fn syscall_deadline_wait(timespec_address: usize, absolute: bool)
        -> SyscallDeadlineResult {
    if (timespec_address == 0) { return SyscallDeadlineResult::Invalid; }
    let mut seconds: usize = 0;
    let mut nanoseconds: usize = 0;
    match user_range_check_read(kernel_process_current_root(),
                                timespec_address, 16) {
        UserReadRangeResult::Fault => {
            return SyscallDeadlineResult::Fault;
        }
        UserReadRangeResult::Ok(range) => {
            let (seconds_ok, seconds_raw) = user_read_u64(range, 0);
            let (nanoseconds_ok, nanoseconds_raw) = user_read_u64(range, 8);
            if (seconds_ok == false || nanoseconds_ok == false) {
                return SyscallDeadlineResult::Invalid;
            }
            seconds = seconds_raw as usize;
            nanoseconds = nanoseconds_raw as usize;
        }
    }
    if (nanoseconds >= 1000000000) {
        return SyscallDeadlineResult::Invalid;
    }
    let now: usize = read_cntpct() as usize;
    if (kernel_process_current_pending_block_reason() ==
            ProcessWaitReason::Deadline) {
        if (now >= kernel_process_current_deadline_ticks()) {
            kernel_process_current_clear_deadline();
            return SyscallDeadlineResult::Ready;
        }
        // Ask again on every retry, as the first entry does. A process that
        // found nobody else Ready when it armed keeps retrying here in EL1,
        // and without this it held its CPU after others became Ready: the
        // DDB lane's BREAK found init at this read_cntpct on core 0 while
        // the workload it was waiting for got no time.
        if (kernel_process_other_ready()) {
            return SyscallDeadlineResult::Block;
        }
        return SyscallDeadlineResult::WaitInterrupt;
    }
    let frequency: usize = read_cntfrq() as usize;
    let whole_ticks: usize = match checked_mul_usize(seconds, frequency) {
        CheckedUsize::Overflow => { return SyscallDeadlineResult::Invalid; }
        CheckedUsize::Value(value) => { value }
    };
    let subsecond_product: usize =
        match checked_mul_usize(nanoseconds, frequency) {
            CheckedUsize::Overflow => { return SyscallDeadlineResult::Invalid; }
            CheckedUsize::Value(value) => { value }
        };
    let requested_ticks: usize = match checked_add_usize(
            whole_ticks, subsecond_product / 1000000000) {
        CheckedUsize::Overflow => { return SyscallDeadlineResult::Invalid; }
        CheckedUsize::Value(value) => { value }
    };
    let mut deadline: usize = requested_ticks;
    if (absolute == false) {
        if (requested_ticks == 0) { return SyscallDeadlineResult::Ready; }
        match checked_add_usize(now, requested_ticks) {
            CheckedUsize::Overflow => {
                return SyscallDeadlineResult::Invalid;
            }
            CheckedUsize::Value(value) => { deadline = value; }
        }
    }
    if (deadline <= now) { return SyscallDeadlineResult::Ready; }
    kernel_process_current_arm_deadline(deadline, 0);
    if (kernel_process_other_ready()) {
        return SyscallDeadlineResult::Block;
    }
    return SyscallDeadlineResult::WaitInterrupt;
}

fn syscall_signal_wait(wait_set: usize, timeout_address: usize)
        -> SyscallAction {
    match kernel_process_current_signal_take(wait_set) {
        ProcessSignalPendingResult::Pending(signum) => {
            kernel_process_current_clear_deadline();
            return SyscallAction::Resume(signum);
        }
        ProcessSignalPendingResult::Missing => {}
    }
    let now: usize = read_cntpct() as usize;
    if (kernel_process_current_pending_block_reason() ==
            ProcessWaitReason::Signal) {
        let armed: usize = kernel_process_current_deadline_ticks();
        if (armed != 0 && now >= armed) {
            kernel_process_current_clear_deadline();
            return SyscallAction::Resume(LINUX_EAGAIN);
        }
        // The same retry question as syscall_deadline_wait's.
        if (kernel_process_other_ready()) { return SyscallAction::Block; }
        return SyscallAction::WaitInterrupt;
    }
    if (timeout_address != 0) {
        let mut seconds: usize = 0;
        let mut nanoseconds: usize = 0;
        match user_range_check_read(kernel_process_current_root(),
                                    timeout_address, 16) {
            UserReadRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserReadRangeResult::Ok(range) => {
                let (seconds_ok, seconds_raw) = user_read_u64(range, 0);
                let (nanoseconds_ok, nanoseconds_raw) =
                    user_read_u64(range, 8);
                if (seconds_ok == false || nanoseconds_ok == false) {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                seconds = seconds_raw as usize;
                nanoseconds = nanoseconds_raw as usize;
            }
        }
        if (nanoseconds >= 1000000000) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let frequency: usize = read_cntfrq() as usize;
        let whole_ticks: usize = match checked_mul_usize(seconds, frequency) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            CheckedUsize::Value(value) => { value }
        };
        let subsecond_product: usize =
            match checked_mul_usize(nanoseconds, frequency) {
                CheckedUsize::Overflow => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                CheckedUsize::Value(value) => { value }
            };
        let duration: usize = match checked_add_usize(
                whole_ticks, subsecond_product / 1000000000) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            CheckedUsize::Value(value) => { value }
        };
        if (duration == 0) {
            return SyscallAction::Resume(LINUX_EAGAIN);
        }
        let deadline: usize = match checked_add_usize(now, duration) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            CheckedUsize::Value(value) => { value }
        };
        kernel_process_current_arm_deadline(deadline, LINUX_EAGAIN);
    }
    kernel_process_current_prepare_signal_wait(wait_set);
    let process_slot: usize = kernel_syscall_process_slot();
    if (kernel_process_current_pid() == 1 &&
        scheduled_process_init_signal_wait_logged(process_slot) == false) {
        scheduled_process_set_init_signal_wait_logged(process_slot, true);
        kernel_boot_log(
            "signal: BusyBox init blocked in rt_sigtimedwait for SIGCHLD\n");
    }
    if (kernel_process_other_ready()) { return SyscallAction::Block; }
    return SyscallAction::WaitInterrupt;
}

fn syscall_ppoll_dispatch(fds_address: usize, raw_nfds: usize,
                          timeout_address: usize, sigmask_address: usize)
        -> SyscallAction !{unsafe} {
    if (raw_nfds == 0) {
        if (timeout_address == 0) { return SyscallAction::WaitInterrupt; }
        match syscall_deadline_wait(timeout_address, false) {
            SyscallDeadlineResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            SyscallDeadlineResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            SyscallDeadlineResult::Ready => {
                return SyscallAction::Resume(0);
            }
            SyscallDeadlineResult::Block => { return SyscallAction::Block; }
            SyscallDeadlineResult::WaitInterrupt => {
                return SyscallAction::WaitInterrupt;
            }
        }
    }
    if (raw_nfds >= 0 && raw_nfds < POLL_MAX) {
      let nfds: {0..<POLL_MAX as usize} = raw_nfds;
      let array_bytes: usize = match checked_mul_usize(nfds, sizeof(Pollfd)) {
        CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
        CheckedUsize::Value(v) => { v }
    };
      match user_range_check_write(kernel_process_current_root(), fds_address, array_bytes) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(array_range) => {
            let mut ready_count: usize = 0;
            let mut uart_wait: bool = false;
            for index: usize in 0..<nfds {
                let (fd_ok, fd_raw) = user_read_u32(
                    user_write_range_as_read(array_range),
                    index * sizeof(Pollfd) + offsetof(Pollfd, fd));
                let (events_ok, events_raw) = user_read_u32(
                    user_write_range_as_read(array_range),
                    index * sizeof(Pollfd) + offsetof(Pollfd, events));
                if (fd_ok == false || events_ok == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                let fd: usize = fd_raw as usize;
                let (valid, revents) = syscall_poll_fd_ready(fd);
                let mut final_revents: usize = revents;
                if (valid == false) { final_revents = POLLNVAL; }
                if (user_write_u16(
                        array_range,
                        index * sizeof(Pollfd) + offsetof(Pollfd, revents),
                        final_revents) == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                if (final_revents != 0) { ready_count = ready_count + 1; }
                if (nfds == 1 && fd == 0 &&
                    (events_raw as usize & POLLIN) != 0) {
                    uart_wait = true;
                }
            }
            if (ready_count == 0 && uart_wait && timeout_address == 0 &&
                sigmask_address == 0) {
                if (syscall_test_evidence_record_ppoll_uart_wait()) {
                    kernel_boot_log("shell ppoll: uart blocked\n");
                }
                // The question syscall_read_uart asks: block when anything
                // else can run. The Read delivery rewinds this ppoll, so the
                // wake reruns it and it reports the byte. The block path's
                // last look at the ring under the run lock (#547) covers a
                // byte that arrives before it sleeps.
                if (kernel_process_other_ready()) {
                    let process_slot: usize = kernel_syscall_process_slot();
                    if (scheduled_process_slot_valid(process_slot)) {
                        scheduled_process_set_uart_block_delivery(
                            process_slot, UartBlockDelivery::Read);
                        kernel_process_current_set_pending_block(
                            ProcessWaitReason::UartRx, 0);
                        // The ash lane's /bin/ppoll-probe types its byte
                        // only after this line, so a kernel that retried
                        // the ppoll in EL1 instead leaves that probe waiting.
                        if (syscall_test_evidence_record_ppoll_uart_block()) {
                            kernel_boot_log(
                                "ppoll: stdin wait blocked beside a runnable process\n");
                        }
                        return SyscallAction::Block;
                    }
                }
                return SyscallAction::WaitInterrupt;
            }
            if (ready_count == 0 && timeout_address != 0) {
                match syscall_deadline_wait(timeout_address, false) {
                    SyscallDeadlineResult::Fault => {
                        return SyscallAction::Resume(LINUX_EFAULT);
                    }
                    SyscallDeadlineResult::Invalid => {
                        return SyscallAction::Resume(LINUX_EINVAL);
                    }
                    SyscallDeadlineResult::Ready => {
                        return SyscallAction::Resume(0);
                    }
                    SyscallDeadlineResult::Block => {
                        return SyscallAction::Block;
                    }
                    SyscallDeadlineResult::WaitInterrupt => {
                        return SyscallAction::WaitInterrupt;
                    }
                }
            }
            return SyscallAction::Resume(ready_count);
        }
      }
    }
    return SyscallAction::Resume(LINUX_EINVAL);
}

fn syscall_read_uart(address: usize, requested: usize) -> SyscallAction {
    if (requested == 0) { return SyscallAction::Resume(0); }
    match user_range_check_write(kernel_process_current_root(), address, requested) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(range) => {
            // GitHub issue #547: the ring is read under the lock its
            // producer holds, so a reader on any CPU sees a byte only
            // after that byte is stored.
            let guard = process_run_lock();
            if (kernel_uart_rx_pending() == false) {
                process_run_unlock(guard);
                if (syscall_test_evidence_record_read_uart_wait()) {
                    if (kernel_syscall_persistent_shell_active()) {
                        kernel_boot_log(
                            "\npersistent shell: uart blocked\n");
                    } else {
                        kernel_boot_log(
                            "\ninteractive shell: uart blocked\n");
                    }
                }
                // GitHub issue #448: block whenever ANYTHING else could
                // run, not only when this process has a child. The old
                // question was the right one while a process could have
                // one child and nothing else existed beside it; with an
                // /etc/inittab that starts three entries, an interactive
                // shell waiting at its prompt has no child and two
                // runnable siblings, and answering "no" here left the
                // kernel spinning at EL1 for the whole wait -- which, in a
                // kernel that does not preempt kernel mode, stops every
                // other process too. WaitInterrupt below stays for the case
                // that question was really about: nobody else to run.
                if (kernel_process_other_ready()) {
                    let process_slot: usize = kernel_syscall_process_slot();
                    if (scheduled_process_slot_valid(process_slot)) {
                        scheduled_process_set_uart_block_delivery(
                            process_slot, UartBlockDelivery::Read);
                        kernel_process_current_set_pending_block(
                            ProcessWaitReason::UartRx, 0);
                        return SyscallAction::Block;
                    }
                }
                return SyscallAction::WaitInterrupt;
            }
            let value: u8 = kernel_uart_rx_getc();
            process_run_unlock(guard);
            if (user_write_byte(range, 0, value) == false) {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            return SyscallAction::Resume(1);
        }
    }
}

// Issue #196: writes `value` into one fixed 65-byte struct utsname field.
// The field was already zero-filled by the caller (see the uname(2)
// handler below) before any field write, so a value shorter than 65
// bytes leaves real zero padding, not leftover scratch-buffer content
// from a previous uname(2) call.
fn uname_write_field(
        field_view: borrow [u8; UTSNAME_FIELD_SIZE..], value: []u8) {
    let copied: usize = slice_copy(field_view, value);
}

// Mirrors user_entry.S's .Lsyscall_dispatch branch table exactly (action
// numbers 0/1/2/.../8 there correspond one-to-one to the variants below,
// via syscall_action_encode). Kept as a real sum type internally so a
// mistyped numeric action code -- the shape of bug class this file's
// syscall handling cannot otherwise catch at compile time -- is a type
// error instead of a silent wrong branch at the asm boundary. The asm
// side is untouched by this: kernel_syscall_dispatch below still returns
// a plain (usize, usize) register pair, exactly as before.
must_use variant SyscallAction {
    Unreachable;         // 0: esr wasn't a real SVC; asm's own default path
                          //    already fail-stops before this can be selected
    Resume(usize);        // 1: resume EL0 with x0 = value
    Exit(usize);           // 2: parent exit; return status to the EL1 caller
    CloneChild(usize);      // 3: clone succeeded; value = child pid
    CloneParent(usize);      // 4: child exited; value = parent's saved SP
    Block;                    // 5: block this frame on the scheduler
    WaitInterrupt;             // 6: wfe, then run this syscall again
    Exec;                       // 7: parent-only execve pending
    ChildExec;                   // 8: child execve pending
    Migrate;                      // 9: rerun this syscall on core 0
}

fn syscall_action_encode(action: SyscallAction) -> (usize, usize) {
    match action {
        SyscallAction::Unreachable => { return (0, 0); }
        SyscallAction::Resume(value) => { return (1, value); }
        SyscallAction::Exit(value) => { return (2, value); }
        SyscallAction::CloneChild(value) => { return (3, value); }
        SyscallAction::CloneParent(value) => { return (4, value); }
        SyscallAction::Block => { return (5, 0); }
        SyscallAction::WaitInterrupt => { return (6, 0); }
        SyscallAction::Exec => { return (7, 7); }
        SyscallAction::ChildExec => { return (8, 8); }
        SyscallAction::Migrate => { return (9, 0); }
    }
}

// Preserve clone-owned FD/VM teardown before returning through the parent
// frame; returning SyscallAction::Exit directly is valid only for the root
// EL0 process.
fn kernel_syscall_exit_current_process(status: usize) -> SyscallAction {
    if (kernel_process_is_child()) {
        // GitHub issue #448: nothing is torn down yet, so waiting for an
        // interrupt and running this syscall again is free of side
        // effects -- and it is the only thing to do when a core-0 exit has
        // nowhere to hand the CPU. A peer may return to architectural idle.
        // See kernel_process_exit_would_strand.
        if (kernel_process_exit_would_strand()) {
            return SyscallAction::WaitInterrupt;
        }
        match kernel_syscall_clone_files_reap() {
            KernelFdReapResult::Failed => { return SyscallAction::Unreachable; }
            KernelFdReapResult::Reaped => { }
        }
        if (kernel_process_exec_image_live_for_pid(
                kernel_process_current_pid()) == false) {
            // GitHub issue #448: the clone being given back is the one made
            // INTO this exiting process's own root, which it now has to
            // name -- there is no longer a single clone in flight for the
            // kernel to have meant implicitly.
            let exiting_root: usize =
                address_space_root_slot(kernel_process_current_root());
            match process_image_clone_vm_reap(exiting_root) {
                ProcessCloneVmReapResult::Missing => {
                    return SyscallAction::Unreachable;
                }
                ProcessCloneVmReapResult::Reaped => { }
            }
        }
        return SyscallAction::CloneParent(kernel_process_child_exit(status));
    }
    return SyscallAction::Exit(status);
}

// The only asm-facing entry point (user_entry.S calls this exact name via
// `bl kernel_syscall_dispatch`); its signature is untouched so this step
// needs no assembly changes. All real logic lives in the SyscallAction-
// returning kernel_syscall_dispatch_action below.
//
// GitHub issue #221: the functions below are user_entry.S's action-tail
// branches, migrated one at a time (each independently hardware-verified)
// from hand-written EXC_CONTEXT_RESTORE/eret assembly into .tkb, ending in
// the single shared el0_context_resume/kernel_syscall_fail_stop primitives
// (kernel/arch/arm64/kernel/user_entry.S) instead of a per-branch copy of
// that sequence.

// GitHub issue #244: completes a blocked wait4() at the moment it is
// woken (called from kernel_process_child_exit()'s own wake-a-blocked-
// parent step, kernel/kernel/process.tkb) -- the mirror of what
// kernel_process_uart_wake() does for the UART blocker with a single
// el0_context_set_x0, except wait4() also needs its x1 status pointer
// (stashed in the blocking parent's own ProcessRecord, see issue #302)
// honored, which a bare scalar injection cannot express. frame_sp is the
// blocked parent's own saved SP -- writing x0 there, not the current
// frame, is exactly what el0_context_set_x0 is for (it takes an arbitrary
// saved context, not "the currently running one").
//
// GitHub issue #248: takes parent_slot explicitly (the blocked parent's
// own pool_index) rather than depending on an implicit current slot.
// GitHub issue #488 moved the current-process handoff before this call so
// the exiting child is not reaped while still current, but keeping the
// explicit slot preserves the original multi-level wait4 guarantee: each
// delivery names the parent whose saved frame is being completed.
// GitHub issue #302: the status pointer read below used to be exactly the
// shared-global bug #248 fixed for
// reaped_pid/parent_slot -- a second parent blocking in wait4() before the
// first one woke would silently overwrite the first parent's still-pending
// status pointer with its own. scheduled_process_record_wait4_status_ptr
// is keyed by parent_slot the same way reaped_pid/parent_slot already are.
fn kernel_syscall_wait4_deliver(frame_sp: usize, reaped_pid: usize,
                                parent_slot: usize) !{unsafe} {
    let wait4_status_ptr: usize =
        scheduled_process_record_wait4_status_ptr(parent_slot);
    if (wait4_status_ptr != 0) {
        // The status buffer belongs to the parent being resumed.
        // user_write_u32 dereferences the user VA directly. The waking exit
        // handoff commits this parent's prepared root before reaching here;
        // the synchronous wait4 path is already running in the same parent.
        // kernel_process_reap_zombie likewise restores that current root
        // before teardown, so another direct activation here was redundant.
        match user_range_check_write(address_space_root_for_slot(parent_slot), wait4_status_ptr, 4) {
            UserWriteRangeResult::Fault => {
                el0_context_set_x0(frame_sp, LINUX_EFAULT);
                return;
            }
            UserWriteRangeResult::Ok(range) => {
                let status: usize =
                    kernel_process_child_wait_status_peek_for(parent_slot);
                if (user_write_u32(range, 0,
                        ((status & 0xFF) << 8) as u32) == false) {
                    el0_context_set_x0(frame_sp, LINUX_EFAULT);
                    return;
                }
            }
        }
    }
    // The exiting child is still the physical SP_EL1 stack here even though
    // logical current already names this parent. The generated return hook
    // consumes the deferred reap after `mov sp` has reached the parent frame.
    el0_context_set_x0(frame_sp, reaped_pid);
}

// Linux syslog(2), consumed by BusyBox dmesg through musl's klogctl(). The
// current concrete applet uses action 10 to size its allocation and action 3
// to read a non-destructive snapshot. Console-level control and destructive
// reads remain EINVAL until a real caller needs them.
private fn syscall_syslog(action: usize, address: usize, requested: usize)
        -> SyscallAction !{unsafe} {
    if (action == LINUX_SYSLOG_ACTION_SIZE_BUFFER) {
        return SyscallAction::Resume(kernel_log_snapshot_capacity());
    }
    if (action != LINUX_SYSLOG_ACTION_READ_ALL || requested == 0) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let available: usize = kernel_log_snapshot_build();
    let mut amount: usize = requested;
    if (amount > available) { amount = available; }
    if (amount == 0) { return SyscallAction::Resume(0); }
    let mut copied: usize = 0;
    while (copied < amount) {
        let mut chunk: usize = amount - copied;
        if (chunk > KERNEL_BLOCK_SIZE) { chunk = KERNEL_BLOCK_SIZE; }
        let staging_buffer = syscall_scratch_here().file_buffer as []u8;
        if (chunk > staging_buffer.len) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk];
        let staged: usize = kernel_log_snapshot_copy(copied, staging);
        if (staged != chunk) { return SyscallAction::Resume(LINUX_EINVAL); }
        let target: usize = match checked_add_usize(address, copied) {
            CheckedUsize::Overflow => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            CheckedUsize::Value(value) => { value }
        };
        match user_range_check_write(
                kernel_process_current_root(), target, chunk) {
            UserWriteRangeResult::Fault => {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            UserWriteRangeResult::Ok(range) => {
                let sent: bool = copy_to_user_raw(
                    range, syscall_scratch_here().file_buffer as *u8, chunk);
                if (sent == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
            }
        }
        copied = copied + chunk;
    }
    return SyscallAction::Resume(copied);
}

must_use variant KernelUartDeliveryResult { Consumed; RetryRead; }

// A blocked Linux read(0, buf, ...), or a ppoll on fd 0, must retry its SVC
// after the IRQ places the byte in the kernel UART ring; only the Takibi
// scalar wait consumes the
// byte directly into x0. Keeping the IRQ path away from user memory also
// preserves its no-unsafe effect contract.
fn kernel_syscall_uart_deliver(frame_sp: usize, process_slot: usize,
                               value: usize)
        -> KernelUartDeliveryResult !{interrupt} {
    if (scheduled_process_slot_valid(process_slot)) {
        match scheduled_process_uart_block_delivery(process_slot) {
            UartBlockDelivery::Scalar => {
                el0_context_set_x0(frame_sp, value);
                return KernelUartDeliveryResult::Consumed;
            }
            UartBlockDelivery::Read => {
                scheduled_process_set_uart_block_delivery(
                    process_slot, UartBlockDelivery::Scalar);
                return KernelUartDeliveryResult::RetryRead;
            }
        }
    }
    el0_context_set_x0(frame_sp, LINUX_EFAULT);
    return KernelUartDeliveryResult::Consumed;
}

fn kernel_syscall_uart_block_prepare(frame_sp: usize) {
    let process_slot: usize = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(process_slot)) {
        match scheduled_process_uart_block_delivery(process_slot) {
            UartBlockDelivery::Scalar => {}
            UartBlockDelivery::Read => {
                el0_context_retry_syscall(frame_sp);
            }
        }
    }
}

// Step 2/8: action 5 (.Lsyscall_block). Entered via a plain tail branch, not
// `bl` -- there is no caller to return to, every path ends in a noreturn call.
// GitHub issue #244: this single action-5 trampoline is now shared by two
// different blockers (the takibi UART-wait syscall and wait4()) rather
// than adding a 9th hand-written assembly action branch for the second
// one -- whichever syscall handler decided to return SyscallAction::Block
// records which reason first.
fn kernel_syscall_block_return(frame_sp: usize) {
    let mut next_sp: usize = 0;
    if (kernel_process_current_pending_block_reason() ==
            ProcessWaitReason::ChildExit) {
        next_sp = kernel_process_block_wait4(frame_sp);
    } else if (kernel_process_current_pending_block_reason() ==
                   ProcessWaitReason::NetRx) {
        // GitHub issue #469: the woken process runs this same syscall
        // again rather than resuming after it with an answer. accept(2)
        // has no value to be handed on a wake -- what it wants is another
        // look, which is exactly what an ash `read` already gets this way.
        el0_context_retry_syscall(frame_sp);
        next_sp = kernel_process_block_net(frame_sp);
        if (next_sp == 0) {
            // Nothing else to run after all -- the decision to block was
            // taken a few instructions earlier and an interrupt can have
            // changed the answer in between. Resume the frame instead: the
            // rewind above already points it back at the syscall, so the
            // process re-enters accept and takes another bounded step.
            workload_profile_el0_enter();
            el0_context_resume(frame_sp);
        }
    } else if (kernel_process_current_pending_block_reason() ==
                   ProcessWaitReason::UartTx) {
        // GitHub issue #544: as with accept above, the woken writer runs
        // this same write again rather than resuming after it -- what it
        // wants is room in the transmit queue, and another look finds it.
        el0_context_retry_syscall(frame_sp);
        // The window #546 closed for reads, on the transmit side. Between
        // the write's look at the queue and this sleep, the TX interrupt can
        // drain the queue past the mark and find no Blocked writer to wake.
        // Once the queue is empty it also disables itself, and the writer
        // would then sleep until some other output happened to start it
        // again. With interrupts masked from here, either the room is there
        // now and the rewound write runs again, or the interrupt that makes
        // the room arrives after this process is Blocked.
        disable_irq();
        if (kernel_log_tx_writer_room()) {
            workload_profile_el0_enter();
            el0_context_resume(frame_sp);
        }
        next_sp = kernel_process_block_uart_tx(frame_sp);
        if (next_sp == 0) {
            workload_profile_el0_enter();
            el0_context_resume(frame_sp);
        }
    } else if (kernel_process_current_pending_block_reason() ==
                   ProcessWaitReason::Deadline) {
        next_sp = kernel_process_block_deadline(frame_sp);
    } else if (kernel_process_current_pending_block_reason() ==
                   ProcessWaitReason::Signal) {
        next_sp = kernel_process_block_signal(frame_sp);
    } else {
        // GitHub issue #546: look at the ring once more, with interrupts
        // masked, before sleeping on it. A terminal read found the ring
        // empty and unmasked interrupts before choosing to block, so a byte
        // that arrived since then found no Blocked reader to hand itself
        // to, went into the ring, and raised nothing further: the reader
        // slept beside the byte it was waiting for until another one came.
        // Masked from here, a byte either is in the ring now -- and the
        // syscall runs again and takes it -- or raises its interrupt after
        // this process is Blocked, where the wake finds it. The run lock
        // kernel_process_block_uart takes restores this masked state rather
        // than unmasking, and the next context's eret sets its own.
        //
        // This look is now the cheap early exit, not the proof. The mask is
        // local, and the RX interrupt is routed to CPU0. The look that
        // decides is in kernel_process_block_reserved, under the lock the
        // interrupt's push holds too, so it holds for a reader on any CPU
        // (GitHub issue #547).
        disable_irq();
        if (kernel_uart_rx_pending()) {
            el0_context_retry_syscall(frame_sp);
            workload_profile_el0_enter();
            el0_context_resume(frame_sp);
        }
        kernel_syscall_uart_block_prepare(frame_sp);
        next_sp = kernel_process_block_uart(frame_sp);
    }
    if (next_sp == 0) {
        // Another CPU may reserve the last Ready successor after dispatch
        // chose Block but before kernel_process_block_current takes the run
        // lock. The current process is still Running in that case. Retry its
        // syscall instead of treating an ordinary multicore race as fatal.
        // A terminal read was already rewound by uart_block_prepare above;
        // every other blocker still needs the rewind here.
        let uart_read_prepared: bool =
            kernel_process_current_pending_block_reason() ==
                ProcessWaitReason::UartRx &&
            scheduled_process_uart_block_delivery(
                kernel_syscall_process_slot()) == UartBlockDelivery::Read;
        if (uart_read_prepared == false) {
            el0_context_retry_syscall(frame_sp);
        }
        workload_profile_el0_enter();
        el0_context_resume(frame_sp);
    }
    workload_profile_el0_enter();
    el0_context_resume(next_sp);
}

// Step 3/8: action 1 (.Lsyscall_resume). The most common path -- every
// ordinary syscall return reaches this -- and also shared directly by
// .Lsyscall_clone_child's own tail (still raw asm at this step), which
// branches to the .Lsyscall_resume label with x7=0 after installing the new
// child frame, so the child's syscall-return-scheduling check is not
// skipped just because it arrived via clone rather than an ordinary return.
fn kernel_syscall_resume_return(frame_sp: usize, value: usize) {
    el0_context_set_x0(frame_sp, value);
    kernel_stack_guard_check(frame_sp);  // issue #375
    let resume_sp: usize = kernel_process_syscall_return_schedule(frame_sp);
    // GitHub issue #592: no successor, and core 0 may not keep this one.
    if (resume_sp == frame_sp &&
        kernel_process_core0_leave_excluded(frame_sp)) {
        kernel_core0_idle_yield_enter();
    }
    workload_profile_el0_enter();
    el0_context_resume(resume_sp);
}

// Step 4/8: action 3 (.Lsyscall_clone_child). Replaces the hand-written
// EXC_CONTEXT_SIZE-word copy loop with slice_copy over two raw byte views of
// the same two addresses, and folds two redundant
// kernel_process_clone_child_stack_top() calls (the original asm called it
// once for the copy destination and again, unnecessarily, right before
// install) into one. Ends by sharing kernel_syscall_resume_return -- clone's
// return to the child is "resume with x0=0", exactly like an ordinary
// syscall return, and must not skip the same reschedule check.
fn kernel_syscall_clone_child_return(parent_frame_sp: usize, child_pid: usize)
        !{unsafe} {
    // The suspended parent observes clone() == child PID whenever it is
    // first selected; the copied child frame's own X0 is overwritten to 0
    // below via kernel_syscall_resume_return.
    el0_context_set_x0(parent_frame_sp, child_pid);
    let child_stack_top: usize = kernel_process_clone_child_stack_top();
    if (child_stack_top == 0) {
        kernel_syscall_fail_stop(parent_frame_sp);
    }
    let child_frame_sp: usize = child_stack_top - EXC_CONTEXT_SIZE;
    // The exception entry assembly supplies `parent_frame_sp`; the process
    // stack allocator supplies `child_frame_sp`.  These are ABI-owned
    // exception-frame bounds, not ordinary slice provenance.
    let parent_frame_base: *u8 = unsafe { parent_frame_sp as *u8 };
    let child_frame_base: *u8 = unsafe { child_frame_sp as *u8 };
    let src: []u8 = unsafe { parent_frame_base[0..<EXC_CONTEXT_SIZE as isize] };
    let dst: []u8 = unsafe { child_frame_base[0..<EXC_CONTEXT_SIZE as isize] };
    let copied: usize = slice_copy(dst, src);
    let installed_child_sp: usize =
        kernel_process_clone_context_install(parent_frame_sp, child_frame_sp);
    if (installed_child_sp == 0) {
        kernel_syscall_fail_stop(parent_frame_sp);
    }
    match kernel_process_activate_current_root() {
        CurrentRootActivationResult::Invalid => {
            kernel_syscall_fail_stop(parent_frame_sp);
        }
        CurrentRootActivationResult::Activated => {}
    }
    kernel_syscall_resume_return(installed_child_sp, 0);
}

// Step 5/8: action 8 (.Lsyscall_child_exec). This is the exact bug fixed in
// commit 8db27e3: the replacement entry/stack must be published through the
// saved frame's own fields, not via a direct msr, since el0_context_resume
// (like the EXC_CONTEXT_RESTORE it replaces) always reloads elr_el1/sp_el0
// from this same frame. Writing through el0_context_set_elr_el1/
// el0_context_set_sp_el0 and then calling el0_context_resume makes that
// class of bug structurally impossible now: there is no second code path
// left that could reload and silently discard these two field writes.
fn kernel_syscall_child_exec_return(frame_sp: usize) {
    kernel_process_exec_failure_clear();
    let result: KernelChildExecPrepareResult = kernel_process_child_exec_prepare();
    match result {
        KernelChildExecPrepareResult::Prepared => {}
        KernelChildExecPrepareResult::NotChildOrPending => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::NotChildOrPending);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::CloneVmMissing => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::CloneVmMissing);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::DynamicResolveInvalid => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::DynamicResolveInvalid);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::DynamicPairInvalid => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::DynamicPairInvalid);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::ImageAlreadyInstalled => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::ImageAlreadyInstalled);
            kernel_syscall_fail_stop(frame_sp);
        }
        // GitHub issue #516: an exec that reached the install with no target
        // root chosen. Fail-stops beside its neighbours rather than being
        // installed into root 0, which is what the old fallback did.
        KernelChildExecPrepareResult::ImageNoTargetRoot => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::ImageNoTargetRoot);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::NoImageResolved => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::NoImageResolved);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::StaticImageInvalid => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::StaticImageInvalid);
            kernel_syscall_fail_stop(frame_sp);
        }
        KernelChildExecPrepareResult::StaticMapOutOfMemory => {
            kernel_process_exec_failure_set(KernelChildExecPrepareResult::StaticMapOutOfMemory);
            kernel_syscall_fail_stop(frame_sp);
        }
    }
    // The new image is committed, so this is execve's point of no return,
    // and Linux closes every descriptor marked close-on-exec here. Only the
    // kernel-driven exec that 73988b03 retired ever made this call, so from
    // then on a descriptor set with F_SETFD or F_DUPFD_CLOEXEC survived
    // execve. GitHub issue #540's unused-function check found the orphaned
    // helper.
    unified_fd_close_exec_descriptors(kernel_syscall_process_slot());
    // Default-false debugger test switch: stop after the real prepare+commit
    // path without affecting ordinary exec or adding a userspace interface.
    if (kernel_process_trace_fail_after_exec_requested()) {
        kernel_process_exec_failure_debugger_after_commit();
        kernel_syscall_fail_stop(frame_sp);
    }
    let entry: usize = kernel_process_child_exec_entry();
    let stack: usize = kernel_process_child_exec_stack();
    el0_context_set_sp_el0(frame_sp, stack);
    el0_context_set_elr_el1(frame_sp, entry);
    // exec starts a new runtime image. Do not expose the previous image's
    // TLS base until that runtime installs its own TPIDR_EL0.
    el0_context_set_tpidr_el0(frame_sp, 0);
    el0_context_set_x0(frame_sp, 0);
    workload_profile_el0_enter();
    el0_context_resume(frame_sp);
}

// Step 6/8: action 4 (.Lsyscall_clone_parent). This is the exact bug fixed
// in commit 8db27e3: parent_sp used to be kept in the caller-saved x7 across
// `bl kernel_process_child_exec_reap`, safe only as long as nothing that
// call reached ever clobbered it -- true for every boot-time clone/exit
// cycle until a child exec image was actually live. As an ordinary .tkb
// local, parent_sp's liveness across this call is the compiler's own
// calling-convention problem now, the same way it already is for every
// other .tkb function call in this file; there is no register to pick by
// hand and therefore no way to pick the wrong one.
fn kernel_syscall_clone_parent_return(parent_sp: usize) {
    kernel_process_child_exec_reap();
    if (parent_sp == 0) {
        if (cpu_id() != 0) {
            kernel_secondary_idle_enter();
        }
        kernel_syscall_fail_stop(parent_sp);
    }
    workload_profile_el0_enter();
    el0_context_resume(parent_sp);
}

// GitHub issue #9: the peer-safety table. A syscall runs on a peer only
// with a cited audit; the migration gate reruns every other one on core 0.
// read and write are split by descriptor in the order their handlers use.
// Files stay core 0 only: #533 found ext2 mutation unserialized against a
// peer reader and its write epoch read without a barrier, gaps its one
// fixture could ignore and an arbitrary process cannot.
// GitHub issue #533: the five ext2 MUTATIONS, each under the filesystem
// lock for exactly as long as its own linear tokens live.
//
// One helper per mutating syscall rather than a lock taken in the arms
// themselves, because each arm has a dozen early returns and the guard is
// linear: a `return` past it is a compile error, so the helper is what makes
// "exactly one release on every path" checkable instead of reviewed. Each
// answers an errno (0 on success) and leaves SyscallAction to its caller.
//
// A lookup that decides whether a mutation may proceed belongs INSIDE the
// same guard as the mutation it gates -- mkdir's existence check is the
// example: outside it, another core could create the name in between.
private fn syscall_ext2_resize_locked(inode: usize, content: []u8) -> usize {
    let guard = ext2_mutation_take();
    let answer: usize = match ext2_resize_small_file(
            syscall_ext2_mount, inode, content) {
        Ext2ResizeResult::Invalid => { LINUX_EINVAL }
        Ext2ResizeResult::Resized => { 0 }
    };
    ext2_mutation_give(guard);
    return answer;
}

private fn syscall_ext2_mkdir_locked(parent_inode: usize, leaf: borrow []u8)
        -> usize {
    let guard = ext2_mutation_take();
    let mut answer: usize = 0;
    match ext2_lookup_directory(syscall_ext2_mount, parent_inode, leaf) {
        Ext2LookupResult::Found(existing) => { answer = LINUX_EEXIST; }
        Ext2LookupResult::Invalid => { answer = LINUX_EIO; }
        Ext2LookupResult::NotFound => { }
    }
    if (answer == 0) {
        // The directory stays, so its owner ends here: the tree names it
        // from now on, and a later rmdir claims it back from the tree.
        match ext2_make_directory_in(syscall_ext2_mount, parent_inode, leaf) {
            Ext2MkdirResult::Invalid => { answer = LINUX_EIO; }
            Ext2MkdirResult::Created(directory) => {
                ext2_directory_keep(directory);
            }
        }
    }
    ext2_mutation_give(guard);
    return answer;
}

// Unsupported is a symlink or a file reaching an indirect block, which the
// ext2 layer does not release; EPERM is Linux's word for a filesystem that
// does not allow the unlink.
private fn syscall_ext2_unlink_locked(parent_inode: usize, leaf: borrow []u8)
        -> usize {
    let guard = ext2_mutation_take();
    let answer: usize = match ext2_unlink_name(
            syscall_ext2_mount, parent_inode, leaf) {
        Ext2UnlinkNameResult::Unlinked => { 0 }
        Ext2UnlinkNameResult::NotFound => { LINUX_ENOENT }
        Ext2UnlinkNameResult::IsDirectory => { LINUX_EISDIR }
        Ext2UnlinkNameResult::Unsupported => { LINUX_EPERM }
        Ext2UnlinkNameResult::Invalid => { LINUX_EIO }
    };
    ext2_mutation_give(guard);
    return answer;
}

// The claim and the removal are one section: the owner minted from the tree
// lives across both, and handing it back is what ext2_directory_keep does on
// every path that does not remove.
private fn syscall_ext2_rmdir_locked(parent_inode: usize, leaf: borrow []u8)
        -> usize {
    let guard = ext2_mutation_take();
    let mut answer: usize = 0;
    match ext2_claim_directory(syscall_ext2_mount, parent_inode, leaf) {
        Ext2ClaimResult::Invalid => { answer = LINUX_EIO; }
        Ext2ClaimResult::NotFound => { answer = LINUX_ENOENT; }
        Ext2ClaimResult::NotDirectory => { answer = LINUX_ENOTDIR; }
        Ext2ClaimResult::Claimed(directory) => {
            match ext2_remove_directory_in(syscall_ext2_mount,
                                           parent_inode, directory, leaf) {
                Ext2RmdirResult::Removed => { }
                Ext2RmdirResult::Invalid => { answer = LINUX_EIO; }
                Ext2RmdirResult::NotEmpty(kept) => {
                    ext2_directory_keep(kept);
                    answer = LINUX_ENOTEMPTY;
                }
                Ext2RmdirResult::Refused(kept) => {
                    ext2_directory_keep(kept);
                    answer = LINUX_EIO;
                }
            }
        }
    }
    ext2_mutation_give(guard);
    return answer;
}

// Unsupported is a directory moved to another parent, which the ext2 layer
// does not do; EPERM is Linux's word for a filesystem that does not allow
// the rename.
private fn syscall_ext2_rename_locked(old_directory: usize,
                                      old_name: borrow []u8,
                                      new_parent_inode: usize,
                                      new_leaf: borrow []u8) -> usize {
    let guard = ext2_mutation_take();
    let answer: usize = match ext2_rename_in(
            syscall_ext2_mount, old_directory, old_name,
            new_parent_inode, new_leaf) {
        Ext2RenameResult::Renamed => { 0 }
        Ext2RenameResult::NotFound => { LINUX_ENOENT }
        Ext2RenameResult::IsDirectory => { LINUX_EISDIR }
        Ext2RenameResult::NotDirectory => { LINUX_ENOTDIR }
        Ext2RenameResult::Unsupported => { LINUX_EPERM }
        Ext2RenameResult::Invalid => { LINUX_EIO }
    };
    ext2_mutation_give(guard);
    return answer;
}

fn syscall_peer_safe(number: usize, fd: usize) -> bool {
    // The caller's own record, or architectural state: getpid, getppid,
    // the uid/gid family, gettid, clock_gettime, and getcpu (#533).
    if (number == 172 || number == 173 || number == 178 ||
        (number >= 174 && number <= 177) || number == 113 ||
        number == AARCH64_NR_GETCPU) {
        return true;
    }
    // The affinity ABI takes the run lock for everything it reads or writes.
    if (number == AARCH64_NR_SCHED_SETAFFINITY ||
        number == AARCH64_NR_SCHED_GETAFFINITY) {
        return true;
    }
    // A per-process deadline that any CPU's tick wakes (86fb1cbd).
    if (number == AARCH64_NR_NANOSLEEP ||
        number == AARCH64_NR_CLOCK_NANOSLEEP) {
        return true;
    }
    // A peer exit returns to architectural idle (#552, bcaf4419).
    if (number == AARCH64_NR_EXIT || number == AARCH64_NR_EXIT_GROUP) {
        return true;
    }
    // GitHub issue #9 phase B entry 6: the system-identity reads.
    //
    // uname answers from fixed string literals into `syscall_scratch_here()`,
    // and that scratch is `[SyscallScratch; KERNEL_MAX_CORES]` indexed by
    // `cpu_id()` -- two cores never share the buffer, so a peer cannot see
    // half of core 0's fill. sysinfo keeps no kernel scratch at all: it
    // zero-fills the caller's own range and writes one word read from the
    // architectural generic counter, which is system-wide on AArch64 and
    // readable from any CPU.
    //
    // Neither reaches the filesystem, the network, the console, or a device.
    // What they do reach is the user-memory boundary -- a range check against
    // the caller's own root, then a copy -- and that is not new on a peer: a
    // terminal write has crossed it from one since #534. Nothing here widens
    // WHICH processes run on a peer, so the default-mask decision that #514
    // and #516 gate is untouched.
    if (number == AARCH64_NR_UNAME || number == AARCH64_NR_SYSINFO) {
        return true;
    }
    // The workload fixtures' own progress report. Every handler in
    // kernel/kernel/workload_evidence.tkb takes the process run lock, and
    // these fixtures have reported from a peer since #533, #534 and #547.
    if (number == AARCH64_NR_TAKIBI_WORKLOAD_PROGRESS) { return true; }
    // GitHub issue #9 phase B entry 6, second increment: the per-process
    // reads that answer from the caller's own record and take no lock.
    //
    // getcwd writes `/` and a NUL into the caller's own range and keeps no
    // kernel scratch. This kernel has exactly one directory, so the answer
    // is a constant; even if it stops being one, a process's cwd is its own
    // and no other CPU writes it.
    //
    // set_tid_address returns the current pid, which is a read of
    // `execution_here().current_handle` -- this CPU's own current process --
    // and of that record's own pid word.
    if (number == AARCH64_NR_GETCWD || number == AARCH64_NR_SET_TID_ADDRESS) {
        return true;
    }
    // GitHub issue #9 phase B entry 6, third increment: prlimit64 in both
    // directions. The increment before admitted the read only and said the
    // WRITE belonged to the increment that answered whether a peer may
    // mutate its own record. This is that answer, and for THESE two words it
    // is yes -- by enumeration rather than by analogy.
    //
    // `fd_limit_soft`/`fd_limit_hard` live in the process's own
    // ProcessFdContext. Written: at creation, by its own prlimit64, and by
    // its own clone copying them into a child that is still Constructing.
    // Read: by `unified_fd_alloc`/`unified_fd_install` for the slot whose
    // syscall is running, by that same clone as the parent, and by boot
    // probes that use slot 0 -- the boot process, which is never admitted to
    // a peer. A reaper reaches a child's fd table only once that child has
    // Exited, and #552 put a peer's stack release before PID 1 collects it.
    // So while a process runs on a peer, no other CPU touches the two words
    // it is writing.
    //
    // No argument-dependent admission is left, so this takes the number and
    // the descriptor again. One number being two questions did not stop
    // being true -- read and write still turn on their descriptor -- only
    // this instance of it did.
    if (number == AARCH64_NR_PRLIMIT64) { return true; }
    // Calls whose only WRITE is into the caller's own user memory, touching
    // no kernel state at all:
    //
    //   chdir         copies two bytes into the per-CPU path buffer,
    //                 compares them against `/` and `.`, and stores nothing.
    //                 This kernel has one directory, so there is no cwd to
    //                 move.
    //   setitimer     zero-fills the caller's old-timer struct. No itimer is
    //                 armed here, so there is nothing per-record to arm.
    //   rt_sigaction  validates signum and zero-fills a non-null oldact.
    //                 Handlers are never installed, so nothing is stored.
    //
    // Each crosses the user-memory boundary against its own root, which a
    // peer terminal write has crossed since #534.
    if (number == AARCH64_NR_CHDIR || number == AARCH64_NR_SETITIMER ||
        number == AARCH64_NR_RT_SIGACTION) {
        return true;
    }
    // rt_sigprocmask (GitHub issue #570). The process's own signal_mask is
    // read by a sender on any CPU and written only by the process itself,
    // and pending_signals is read-modify-written by both; every such access
    // is under the process-run lock now (process_signal_pending_raise and
    // _clear take its guard), so a peer writing its own mask is one more
    // locked party rather than an unsynchronized one.
    //
    // kill joined in GitHub issue #583's first increment. Delivery runs
    // under the same lock and a wake publishes through the guarded Blocked
    // take (#589), so the sender's CPU is not part of the argument. A
    // self-directed SIGTERM exits, and a peer exit is admitted already.
    if (number == 135 || number == AARCH64_NR_KILL) { return true; }
    // GitHub issue #581: read and write on a connected TCP descriptor. Every
    // field of the connection is read and written under its owner
    // (tcp_connection_take's TaskMutex, revalidated by generation after the
    // acquire), and the receive and transmit paths hold the sole network
    // capability, which is itself behind a Mutex. So a peer's call and core
    // 0's call on the same connection serialize on the owner, and two
    // connections serialize on the capability. The inetd response mode is
    // not admitted: it is a boot fixture that never runs on a peer.
    //
    // Nothing else on a connected descriptor is: close, shutdown, poll and
    // accept stay on core 0. A connection duplicated onto a standard
    // descriptor is not the terminal.
    if (kernel_connected_fd_is_open(fd)) {
        if (kernel_syscall_inetd_mode()) { return false; }
        return number == 63 || number == AARCH64_NR_WRITE;
    }
    // The terminal: a peer's output goes through its console ring (#534),
    // and input is ordered by the run lock (#547).
    if (number == AARCH64_NR_WRITE) {
        return kernel_syscall_terminal_is_open(fd);
    }
    // GitHub issue #581: the filesystem READ path, which is the first
    // subsystem in this table rather than another per-process word.
    //
    // What makes it admissible is already built and already exercised from a
    // peer, by /bin/peer-read under the per-pid rule: ext2 mutation excludes
    // itself through kernel/fs/ext2/mutation_lock.tkb at lock rank 20, the
    // block cache publishes its write epoch with release ordering and sums
    // it with acquire loads (#533), and the per-CPU ext2 scratch means two
    // cores never share a staging buffer. A reader still takes no lock --
    // readers have to stay concurrent or `peer_filesystem.expected`'s
    // both-CPU device contention disappears -- and instead asks at syscall
    // entry whether a mutation is in flight. `syscall_reaches_filesystem`
    // below is what keeps that question being asked now that the table
    // admits these calls rather than refusing them.
    //
    // NOT the write path. The five mutating arms take the guard, and
    // admitting them here would make a peer the sixth caller of a boundary
    // whose own limitations section says nothing proves a sixth would take
    // it.
    //
    // #559 is the honest remainder and is unchanged by this: the reader's
    // question is asked at syscall ENTRY only, so a mutation that starts
    // during an in-flight peer read still overlaps it.
    if (number == AARCH64_NR_OPENAT || number == AARCH64_NR_CLOSE ||
        number == AARCH64_NR_NEWFSTATAT) {
        return true;
    }
    if (number == 63) {
        if (fd == 0 && kernel_syscall_terminal_is_open(fd)) { return true; }
        return kernel_syscall_file_readable(fd);
    }
    // GitHub issue #583, first increment: the vectored forms. readv reads
    // only a readable ext2 file (syscall_readv_segment) and writev writes
    // only the terminal (syscall_writev_segment), the same paths read and
    // write are admitted for above, so they carry the same argument and the
    // same mutation question.
    if (number == AARCH64_NR_READV) { return kernel_syscall_file_readable(fd); }
    if (number == AARCH64_NR_WRITEV) {
        return kernel_syscall_terminal_is_open(fd);
    }
    return false;
}

// Does this call reach ext2, and therefore owe the mutation question?
//
// GitHub issue #581: this used to be answered by `syscall_peer_safe` saying
// no -- the only filesystem calls a peer could make were /bin/peer-read's,
// which the table refused and the per-pid rule admitted anyway. The table
// admits the read path itself now, so "the table does not admit it" has
// stopped being the same question and the two are asked separately.
fn syscall_reaches_filesystem(number: usize, fd: usize) -> bool {
    if (number == AARCH64_NR_OPENAT || number == AARCH64_NR_CLOSE ||
        number == AARCH64_NR_NEWFSTATAT) {
        return true;
    }
    if (number == 63 || number == AARCH64_NR_READV) {
        return kernel_syscall_file_readable(fd);
    }
    return false;
}

// Step 9/9: action 9 (.Lsyscall_migrate). The gate chose core 0 for this
// syscall. Rewind it, mark the process core-0-only until the call
// completes, and leave this CPU; the process becomes Ready only once this
// core is off its stack (kernel_process_stack_idle_yield).
fn kernel_syscall_migrate_return(frame_sp: usize) {
    el0_context_retry_syscall(frame_sp);
    if (kernel_process_migrate_current(frame_sp) == false) {
        kernel_syscall_fail_stop(frame_sp);
    }
    kernel_secondary_idle_yield_enter();
}

fn kernel_syscall_dispatch(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> (usize, usize) !{unsafe} {
    kernel_log_peer_drain();
    workload_profile_note_syscall(number);
    // GitHub issue #580: sample the real BusyBox sleep applet at syscall
    // entry, before peer-safety policy can migrate its frame to core 0.
    workload_ordinary_placement_note_syscall(number);
    let caller_slot: usize = kernel_syscall_process_slot();
    let (action_code, action_value) = syscall_action_encode(
        kernel_syscall_dispatch_action(esr, number, x0, x1, x2, x3, x4));
    // A call that completed no longer needs core 0 (GitHub issue #9). A
    // blocked or waiting one keeps the mark until it completes, and a
    // migrated one has only just been given it.
    if (action_code != 5 && action_code != 6 && action_code != 9) {
        kernel_process_clear_core0_for_call(caller_slot);
    }
    if (action_code == 6) {
        workload_profile_syscall_wait(number);
    } else {
        workload_profile_syscall_complete(number);
    }
    // GitHub issue #241/#244/#245 postmortem: action 0 (SyscallAction::
    // Unreachable) matches no branch in user_entry.S's dispatch table and
    // silently fail-stops with zero UART evidence. Naming the syscall
    // number here, right before that happens, is cheap and turns a
    // multi-hour cold-read-the-dispatch-table bisection into a one-line
    // lookup in SYSCALLS.md.
    if (action_code == 0) {
        kernel_boot_log_syscall_unreachable(number);
    }
    return (action_code, action_value);
}

fn kernel_syscall_dispatch_action(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> SyscallAction !{unsafe} {
    let exception_class: usize = (esr >> 26) & 0x3F;
    if (exception_class != 0x15) { return SyscallAction::Unreachable; }
    // GitHub issue #9: the migration gate, before this syscall touches any
    // kernel state. A process on a peer because its affinity mask put it
    // there runs only what syscall_peer_safe allows; any other syscall is
    // rerun on core 0. A fixture the per-pid rule admits keeps its own
    // audit instead.
    // GitHub issue #579: this CPU may no longer run this process AT ALL --
    // its affinity mask has stopped naming this CPU, which is what happens
    // the moment a process re-pins itself with sched_setaffinity. Hand it
    // back before asking anything else about the syscall.
    //
    // Nothing else could do this. `kernel_process_affinity_set` asks for a
    // reschedule, and `kernel_process_schedule` returns the current frame
    // unchanged when no OTHER process is Ready on this CPU -- so a peer with
    // nothing else to run kept a process its mask had already excluded. That
    // was invisible while the only transition anybody exercised was core 0
    // to CPU 1, where the fixture keeps a spinner Ready on core 0 for
    // exactly this reason, and it is what stopped a process reaching cores 2
    // and 3.
    //
    // A peer that hands a process back has somewhere to go: the architectural
    // idle loop it booted into. Core 0 does not rewind the call; it lets it
    // finish and hands the process away at the return (below).
    if (cpu_id() != 0) {
        // Affinity may have been changed by another CPU. Take the process
        // run lock for this scheduling-boundary snapshot, then release it
        // before the migration path acquires the same lock.
        let guard = process_run_lock();
        let current_cpu_allows: bool =
            kernel_process_current_cpu_allows(guard);
        process_run_unlock(guard);
        if (current_cpu_allows == false) { return SyscallAction::Migrate; }
    } else {
        // GitHub issue #581: the same question on core 0. A process whose
        // mask excludes core 0 is here only because it was born here (clone
        // runs on core 0) or because the gate above sent it one syscall that
        // has now finished. Without this it stayed until the next timer
        // tick, which a short-lived process such as an HTTPd connection
        // handler never reaches. The reschedule lets the syscall return
        // switch to another process core 0 may run; with none Ready, that
        // return parks this one Ready and idles core 0 (#592).
        kernel_process_reschedule_if_excluded_here();
    }
    if (cpu_id() != 0 && syscall_peer_safe(number, x0) == false) {
        return SyscallAction::Migrate;
    }
    // GitHub issue #533: a peer must not read a tree that is being rewritten.
    // The mutators above hold kernel/fs/ext2/mutation_lock.tkb; this asks,
    // with one acquire-load and no wait, whether one is inside right now,
    // and hands this syscall to core 0 if so. Core 0 never asks: mutation
    // runs there too and this kernel is not preemptible, so a core 0 reader
    // cannot be dispatched while a core 0 mutation is mid-rewrite.
    //
    // GitHub issue #533: asked of anything that reaches ext2, independently
    // of whether the peer-safe table admits it. A normal process can now run
    // on any online core without being named by a fixture; this mutation
    // check must therefore remain attached to the operation, not to how the
    // process was placed.
    if (cpu_id() != 0 &&
        (syscall_peer_safe(number, x0) == false ||
         syscall_reaches_filesystem(number, x0)) &&
        ext2_mutation_in_flight()) {
        return SyscallAction::Migrate;
    }
    kernel_init_boot_fixture_poll();
    kernel_syscall_persistent_shell_checkpoint_selected();
    match kernel_process_current_termination_signal_take() {
        ProcessSignalPendingResult::Missing => {}
        ProcessSignalPendingResult::Pending(signum) => {
            // A core-0 exit with nowhere to hand the CPU waits and reruns
            // this syscall. The rerun must still see the signal it was for.
            match kernel_syscall_exit_current_process(128 + signum) {
                SyscallAction::WaitInterrupt => {
                    kernel_process_current_termination_signal_restore();
                    return SyscallAction::WaitInterrupt;
                }
                SyscallAction::Unreachable => {
                    return SyscallAction::Unreachable;
                }
                SyscallAction::Resume(value) => {
                    return SyscallAction::Resume(value);
                }
                SyscallAction::Exit(value) => {
                    return SyscallAction::Exit(value);
                }
                SyscallAction::CloneChild(value) => {
                    return SyscallAction::CloneChild(value);
                }
                SyscallAction::CloneParent(value) => {
                    return SyscallAction::CloneParent(value);
                }
                SyscallAction::Block => { return SyscallAction::Block; }
                SyscallAction::Exec => { return SyscallAction::Exec; }
                SyscallAction::ChildExec => { return SyscallAction::ChildExec; }
                SyscallAction::Migrate => { return SyscallAction::Migrate; }
            }
        }
    }
    if (number == AARCH64_NR_TAKIBI_UART_RX_WAIT) {
        let guard = process_run_lock();
        if (kernel_uart_rx_pending()) {
            let value: usize = kernel_uart_rx_getc() as usize;
            process_run_unlock(guard);
            return SyscallAction::Resume(value);
        }
        process_run_unlock(guard);
        kernel_process_current_set_pending_block(
            ProcessWaitReason::UartRx, 0);
        return SyscallAction::Block;
    }

    // The busy pair /etc/inittab starts reports a finished round here.
    // x0 names which of the two entries is speaking; the caller's identity
    // and the fairness arithmetic are kernel/kernel/workload_evidence.tkb's,
    // and the non-zero answer is that file telling the caller the
    // measurement is over.
    if (number == AARCH64_NR_TAKIBI_WORKLOAD_PROGRESS) {
        if (x0 == 3) {
            return SyscallAction::Resume(workload_peer_read_progress(x1, x2));
        }
        if (x0 == 4) {
            return SyscallAction::Resume(
                workload_peer_console_progress(x1, x2));
        }
        if (x0 == 5) {
            return SyscallAction::Resume(workload_peer_tty_progress(x1, x2));
        }
        if (x0 == 6) {
            match workload_peer_net_wake_progress(x1) {
                WorkloadPeerNetWakeResult::Cpu(cpu) => {
                    return SyscallAction::Resume(cpu);
                }
                WorkloadPeerNetWakeResult::Block => {
                    kernel_process_current_set_pending_block(
                        ProcessWaitReason::NetRx, 0);
                    return SyscallAction::Block;
                }
                WorkloadPeerNetWakeResult::Resumed => {
                    return SyscallAction::Resume(1);
                }
                WorkloadPeerNetWakeResult::Refused => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
            }
        }
        if (x0 == 10) {
            return SyscallAction::Resume(
                workload_peer_core_read_ready());
        }
        if (x0 == 11) {
            return SyscallAction::Resume(
                workload_peer_read_peer_ready());
        }
        return SyscallAction::Resume(workload_busy_record_progress(x0, x1, x2));
    }

    if (number == AARCH64_NR_TAKIBI_PARENT_PROGRESS) {
        match kernel_process_uart_record_parent_progress() {
            ProcessUartProgressResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            ProcessUartProgressResult::Recorded => {
                kernel_boot_log(
                    "concurrency: parent progressed while child uart-blocked\n");
                return SyscallAction::Resume(0);
            }
        }
    }

    if (number == AARCH64_NR_WRITE) {
        let fd: usize = x0;
        let address: usize = x1;
        let length: usize = x2;
        if (kernel_connected_fd_is_open(fd) &&
            (fd != 1 || kernel_syscall_inetd_mode() == false)) {
            syscall_test_evidence_record_connected_write();
            if (kernel_connected_fd_is_open(fd) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            let write_slot: usize =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let write_generation: usize = kernel_connection_fd_identity(fd);
            if (length == 0) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let mut amount: usize = length;
            if (amount > 1460) { amount = 1460; }
            // GitHub issue #581: the open check and the received-length
            // snapshot are taken under the connection's owner, not before
            // it, so a peer's write cannot act on a state the owning core
            // is changing.
            match tcp_connection_take(write_slot, write_generation) {
                TcpConnectionTakeResult::Missing => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                TcpConnectionTakeResult::Ready(owner) => {
                  if (tcp_connection_of(owner).connection_open == false) {
                      tcp_connection_put(owner);
                      return SyscallAction::Resume(LINUX_EINVAL);
                  }
                  let received_length: usize =
                      tcp_connection_of(owner).socket_buffer_length;
                  match network_capability_take() {
                    NetworkCapabilityTakeResult::Empty => {
                        tcp_connection_put(owner);
                        kernel_process_current_set_pending_block(
                            ProcessWaitReason::NetRx, 0);
                        return SyscallAction::Block;
                    }
                    NetworkCapabilityTakeResult::Ready(ready) => {
                    let socket_buffers = tcp_connection_rx_slice(tcp_connection_payload(write_slot));
                    let destination_base: *u8 = socket_buffers as *u8;
                    match user_range_check_read(kernel_process_current_root(), address, amount) {
                        UserReadRangeResult::Fault => {
                            tcp_connection_put(owner);
                            match network_capability_put(ready) {
                                NetworkCapabilityPutResult::Stored => {}
                                NetworkCapabilityPutResult::Conflict => {}
                            }
                            return SyscallAction::Resume(LINUX_EFAULT);
                        }
                        UserReadRangeResult::Ok(range) => {
                            let copied: bool = copy_from_user_raw(
                                range, destination_base, amount);
                        }
                    }
                    match kernel_tcp_send_received(
                            owner, ready,
                            socket_buffers[0..<1460],
                            received_length, amount) {
                        KernelTcpSendResult::Invalid(after_invalid) => {
                            match network_capability_put(after_invalid) {
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_put(owner);
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                            }
                        }
                        KernelTcpSendResult::Sent(after_send) => {
                            match network_capability_put(after_send) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_put(owner);
                                    workload_peer_socket_served(true);
                                    return SyscallAction::Resume(amount);
                                }
                            }
                        }
                    }
                    }
                  }
                }
            }
        }
        if (fd == 1 && kernel_syscall_inetd_mode()) {
            let inetd_write_slot: usize =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let inetd_write_generation: usize = kernel_connection_fd_identity(fd);
            // GitHub issue #581: the response buffer and its length are the
            // connection's, so they are appended to under its owner.
            match tcp_connection_take(inetd_write_slot, inetd_write_generation) {
                TcpConnectionTakeResult::Missing => {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                TcpConnectionTakeResult::Ready(owner) => {
                    let conn: *TcpConnection = tcp_connection_of(owner);
                    if (conn.connection_open == false ||
                        length > 1460 - conn.inetd_response_length) {
                        tcp_connection_put(owner);
                        return SyscallAction::Resume(LINUX_EINVAL);
                    }
                    let response_base: *u8 =
                        (tcp_connection_inetd_slice(conn) as *u8) +
                        (conn.inetd_response_length as isize);
                    match user_range_check_read(kernel_process_current_root(), address, length) {
                        UserReadRangeResult::Fault => {
                            tcp_connection_put(owner);
                            return SyscallAction::Resume(LINUX_EFAULT);
                        }
                        UserReadRangeResult::Ok(range) => {
                            let copied: bool =
                                copy_from_user_raw(range, response_base, length);
                        }
                    }
                    conn.inetd_response_length = conn.inetd_response_length + length;
                    tcp_connection_put(owner);
                    return SyscallAction::Resume(length);
                }
            }
        }
        if (kernel_syscall_file_is_open(fd)) {
            if (kernel_syscall_file_writable(fd) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            if (kernel_syscall_file_offset(fd) != 0 || length == 0 ||
                length > KERNEL_BLOCK_SIZE) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let destination_base: *u8 = syscall_scratch_here().file_buffer as *u8;
            match user_range_check_read(kernel_process_current_root(), address, length) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(range) => {
                    let copied: bool =
                        copy_from_user_raw(range, destination_base, length);
                }
            }
            let content_buffer = syscall_scratch_here().file_buffer as []u8;
            if (length > content_buffer.len) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let content = content_buffer[0..<length];
            let resized: usize = syscall_ext2_resize_locked(
                    kernel_syscall_file_inode(fd), content);
            if (resized != 0) { return SyscallAction::Resume(resized); }
            if (kernel_syscall_file_set_offset(fd, length) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            return SyscallAction::Resume(length);
        }
        if (kernel_syscall_terminal_is_open(fd) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        match syscall_terminal_write(address, length) {
            TerminalWriteResult::Errno(errno) => {
                return SyscallAction::Resume(errno);
            }
            TerminalWriteResult::Written(count) => {
                return SyscallAction::Resume(count);
            }
            TerminalWriteResult::WouldBlock => {
                return syscall_terminal_write_wait();
            }
        }
    }

    if (number == 56) {
        // openat(dirfd, pathname, flags): absolute paths start at the ext2
        // root; relative paths use an open directory fd (or AT_FDCWD, whose
        // unsigned value lies outside the descriptor namespace).
        if (syscall_ext2_ready == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        let path_name: []u8 = match kernel_syscall_path_name(x1) {
            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
        };
        match procfs_lookup(path_name) {
            ProcfsLookupResult::Missing => {}
            ProcfsLookupResult::Found(node) => {
                let access_mode: usize = x2 & 3;
                if (access_mode != 0) {
                    return SyscallAction::Resume(LINUX_EACCES);
                }
                let fd: usize = match unified_fd_alloc(
                        kernel_syscall_process_slot(), 0) {
                    UnifiedFdAllocResult::Full => {
                        return SyscallAction::Resume(LINUX_EMFILE);
                    }
                    UnifiedFdAllocResult::Allocated(allocated) => { allocated }
                };
                return kernel_syscall_procfs_open(node, fd);
            }
        }
        let path_view: []u8 = syscall_scratch_here().path_buffer as []u8;
        let mut lookup_inode: usize = 2;
        if (path_view[0] != 0x2F && x0 != LINUX_AT_FDCWD) {
            if (kernel_syscall_directory_is_open(x0) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            lookup_inode = kernel_syscall_directory_inode(x0);
        }
        match ext2_lookup_path_from(
            syscall_ext2_mount,
            lookup_inode,
            path_name) {
            Ext2LookupResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
            Ext2LookupResult::NotFound => {
                return SyscallAction::Resume(LINUX_ENOENT);
            }
            Ext2LookupResult::Found(inode_number) => {
                let access_mode: usize = x2 & 3;
                match unified_fd_alloc(kernel_syscall_process_slot(), 0) {
                    UnifiedFdAllocResult::Full => {
                        kernel_boot_log_resource_exhausted(
                            "process fd table" as *u8,
                            kernel_syscall_fd_limit_soft());
                        return SyscallAction::Resume(LINUX_EMFILE);
                    }
                    UnifiedFdAllocResult::Allocated(fd) => {
                        let inode_mode: usize = ext2_inode_mode(
                            syscall_ext2_mount, inode_number);
                        if ((inode_mode & 0xF000) == 0x4000) {
                            match unified_directory_open(
                                    kernel_syscall_process_slot(), fd,
                                    inode_number) {
                                UnifiedOpenResult::Invalid => {
                                    return SyscallAction::Resume(LINUX_EBADF);
                                }
                                UnifiedOpenResult::Full => {
                                    kernel_boot_log_resource_exhausted(
                                        "shared object pool" as *u8,
                                        unified_object_max_files());
                                    return SyscallAction::Resume(LINUX_ENFILE);
                                }
                                UnifiedOpenResult::Ok => {
                                    return SyscallAction::Resume(fd);
                                }
                            }
                        }
                        match unified_file_open(
                                kernel_syscall_process_slot(), fd, inode_number,
                                access_mode != 1, access_mode != 0) {
                            UnifiedOpenResult::Invalid => {
                                return SyscallAction::Resume(LINUX_EBADF);
                            }
                            UnifiedOpenResult::Full => {
                                kernel_boot_log_resource_exhausted(
                                    "shared object pool" as *u8,
                                    unified_object_max_files());
                                return SyscallAction::Resume(LINUX_ENFILE);
                            }
                            UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
                        }
                    }
                }
            }
        }
    }

    if (number == 34) {
        // mkdirat(dirfd, pathname, mode), GitHub issue #538. The mode is not
        // applied: every directory is 0755 and every process is root, which
        // is the whole of this kernel's permission model today.
        if (syscall_ext2_ready == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        let path_name: []u8 = match kernel_syscall_path_name(x1) {
            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
        };
        let path_view: []u8 = syscall_scratch_here().path_buffer as []u8;
        let absolute: bool = path_view[0] == 0x2F;
        let parent: SyscallParent = match kernel_syscall_parent_of(
                x0, absolute, path_name) {
            SyscallParentResult::Errno(errno) => {
                return SyscallAction::Resume(errno);
            }
            SyscallParentResult::Found(found) => { found }
        };
        let leaf: []u8 = kernel_syscall_leaf(path_name, parent);
        if (leaf.len == 0) { return SyscallAction::Resume(LINUX_ENOENT); }
        if (kernel_syscall_leaf_is_dot(leaf) ||
            kernel_syscall_leaf_is_dot_dot(leaf)) {
            return SyscallAction::Resume(LINUX_EEXIST);
        }
        return SyscallAction::Resume(
            syscall_ext2_mkdir_locked(parent.inode, leaf));
    }

    if (number == 35) {
        // unlinkat(dirfd, pathname, flags), GitHub issue #538: unlink with no
        // flag, rmdir with AT_REMOVEDIR, and EINVAL for any other flag.
        if (x2 != 0 && x2 != LINUX_AT_REMOVEDIR) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (syscall_ext2_ready == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        let path_name: []u8 = match kernel_syscall_path_name(x1) {
            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
        };
        let path_view: []u8 = syscall_scratch_here().path_buffer as []u8;
        let absolute: bool = path_view[0] == 0x2F;
        let parent: SyscallParent = match kernel_syscall_parent_of(
                x0, absolute, path_name) {
            SyscallParentResult::Errno(errno) => {
                return SyscallAction::Resume(errno);
            }
            SyscallParentResult::Found(found) => { found }
        };
        let leaf: []u8 = kernel_syscall_leaf(path_name, parent);
        if (leaf.len == 0) { return SyscallAction::Resume(LINUX_ENOENT); }
        if (x2 == 0) {
            return SyscallAction::Resume(
                syscall_ext2_unlink_locked(parent.inode, leaf));
        }
        // Linux's own answers: rmdir(".") is EINVAL, rmdir("..") ENOTEMPTY.
        if (kernel_syscall_leaf_is_dot(leaf)) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        if (kernel_syscall_leaf_is_dot_dot(leaf)) {
            return SyscallAction::Resume(LINUX_ENOTEMPTY);
        }
        return SyscallAction::Resume(
            syscall_ext2_rmdir_locked(parent.inode, leaf));
    }

    if (number == 38) {
        // renameat(olddirfd, oldpath, newdirfd, newpath), GitHub issue #538.
        // Both paths are read through the one per-core path buffer, so the
        // old path's directory is resolved and its last component copied out
        // before the new path is read over it.
        if (syscall_ext2_ready == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        let old_path: []u8 = match kernel_syscall_path_name(x1) {
            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
        };
        let old_view: []u8 = syscall_scratch_here().path_buffer as []u8;
        let old_absolute: bool = old_view[0] == 0x2F;
        let old_parent: SyscallParent = match kernel_syscall_parent_of(
                x0, old_absolute, old_path) {
            SyscallParentResult::Errno(errno) => {
                return SyscallAction::Resume(errno);
            }
            SyscallParentResult::Found(found) => { found }
        };
        let old_leaf: []u8 = kernel_syscall_leaf(old_path, old_parent);
        if (old_leaf.len == 0) { return SyscallAction::Resume(LINUX_ENOENT); }
        // Linux's answer for renaming `.` or `..`.
        if (kernel_syscall_leaf_is_dot(old_leaf) ||
            kernel_syscall_leaf_is_dot_dot(old_leaf)) {
            return SyscallAction::Resume(LINUX_EBUSY);
        }
        let mut old_name_storage: [u8; 256];
        let old_name_view: []u8 = old_name_storage as []u8;
        let old_length: usize = old_leaf.len;
        if (old_length > old_name_view.len) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let old_name: []u8 = old_name_view[0..<old_length];
        slice_copy(old_name, old_leaf);
        let old_directory: usize = old_parent.inode;

        let new_path: []u8 = match kernel_syscall_path_name(x3) {
            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
        };
        let new_view: []u8 = syscall_scratch_here().path_buffer as []u8;
        let new_absolute: bool = new_view[0] == 0x2F;
        let new_parent: SyscallParent = match kernel_syscall_parent_of(
                x2, new_absolute, new_path) {
            SyscallParentResult::Errno(errno) => {
                return SyscallAction::Resume(errno);
            }
            SyscallParentResult::Found(found) => { found }
        };
        let new_leaf: []u8 = kernel_syscall_leaf(new_path, new_parent);
        if (new_leaf.len == 0) { return SyscallAction::Resume(LINUX_ENOENT); }
        if (kernel_syscall_leaf_is_dot(new_leaf) ||
            kernel_syscall_leaf_is_dot_dot(new_leaf)) {
            return SyscallAction::Resume(LINUX_EBUSY);
        }
        return SyscallAction::Resume(
            syscall_ext2_rename_locked(old_directory, old_name,
                                       new_parent.inode, new_leaf));
    }

    if (number == 61) {
        // getdents64(fd, dirent, count): the directory FD owns the stream
        // offset, while ext2 supplies one filesystem block at a time. The
        // userspace ABI records are packed to 8-byte alignment and carry the
        // next directory offset in d_off.
        if (kernel_syscall_directory_is_open(x0) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        if (x2 == 0) { return SyscallAction::Resume(0); }
