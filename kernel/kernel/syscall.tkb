        let path_view: []u8 = syscall_scratch_here().path_buffer as []u8;
        if (path_view[0] == 0x2F) { path_length = path_length + 1; }
        if (path_length == 0 || argv_address == 0) { return SyscallAction::Resume(LINUX_EINVAL); }
        let exec_path_absolute: bool = path_view[0] == 0x2F;
        if (path_length > 256) { return SyscallAction::Resume(LINUX_EINVAL); }
        let exec_path: []u8 = syscall_exec_path_here();
        for path_index: usize in 0..<256 { exec_path[path_index] = 0; }
