        }
        match user_range_check_write(current_authority, x2, 4) {
            UserWriteRangeResult::Fault => { return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority); }
            UserWriteRangeResult::Ok(length_range) => {
                match user_write_u32(length_range, 0, 16) {
                    UserWriteResult::Fault => { return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority); }
                    UserWriteResult::Written => {}
                }
            }
        }
        return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
    }
    if (number == 208) {
        // setsockopt(level, optname, optval, optlen): this kernel's
        // single-listener-per-port/single-connection model has no state any
        // real option here would change, but the optval pointer itself is
        // now validated instead of never being touched.
        let optval: usize = x2;
        let optlen: usize = x3;
        if (optlen != 0) {
            match user_range_check_read(current_authority, optval, optlen) {
                UserReadRangeResult::Fault => { return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority); }
                UserReadRangeResult::Ok(range) => {}
            }
        }
        return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
    }
    if (number == AARCH64_NR_SET_TID_ADDRESS) {
        return syscall_finish_current(frame, SyscallAction::Resume(kernel_process_current_pid()), current_authority);
    }
    // GitHub issue #665: a plain reschedule. The syscall return honours the
    // pending request like a tick's; with nothing else Ready here it resumes
    // the caller. /bin/protocol-trace calls it when its window is deferred.
    if (number == AARCH64_NR_SCHED_YIELD) {
        kernel_process_request_reschedule();
        return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
    }
    if (number == AARCH64_NR_GETCPU) {
        // Linux permits either output pointer to be null. This kernel has no
        // NUMA topology, so every online CPU belongs to node 0.
        if (x0 != 0) {
            match user_range_check_write(current_authority, x0, 4) {
                UserWriteRangeResult::Fault => {
                    return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                }
                UserWriteRangeResult::Ok(cpu_range) => {
                    match user_write_u32(cpu_range, 0, cpu_id() as u32) {
                        UserWriteResult::Fault => {
                            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                        }
                        UserWriteResult::Written => {}
                    }
                }
            }
        }
        if (x1 != 0) {
            match user_range_check_write(current_authority, x1, 4) {
                UserWriteRangeResult::Fault => {
                    return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                }
                UserWriteRangeResult::Ok(node_range) => {
                    match user_write_u32(node_range, 0, 0) {
                        UserWriteResult::Fault => {
                            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                        }
                        UserWriteResult::Written => {}
                    }
                }
            }
        }
        return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
    }

    // GitHub issue #9: the affinity ABI. The kernel's mask is one 64-bit
    // word, so cpusetsize is measured against 8 bytes, as Linux measures it
    // against cpumask_size(). Bits past the first word name no CPU here.
    if (number == AARCH64_NR_SCHED_GETAFFINITY) {
        if (x1 < 8 || (x1 & 7) != 0) {
            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
        }
        match kernel_process_affinity_get(x0) {
            ProcessAffinityResult::Missing => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_ESRCH), current_authority);
            }
            ProcessAffinityResult::Invalid => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
            }
            ProcessAffinityResult::Mask(mask) => {
                match user_range_check_write(current_authority, x2, 8) {
                    UserWriteRangeResult::Fault => {
                        return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                    }
                    UserWriteRangeResult::Ok(mask_range) => {
                        match user_write_u64(mask_range, 0, mask as u64) {
                            UserWriteResult::Fault => {
                                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                            }
                            UserWriteResult::Written => {}
                        }
                    }
                }
                return syscall_finish_current(frame, SyscallAction::Resume(8), current_authority);
            }
        }
    }
    if (number == AARCH64_NR_SCHED_SETAFFINITY) {
        if (x1 < 8) { return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority); }
        let mut requested: usize = 0;
        match user_range_check_read(current_authority, x2, 8) {
            UserReadRangeResult::Fault => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
            }
            UserReadRangeResult::Ok(mask_range) => {
                let (mask_ok, mask_raw) = user_read_u64(mask_range, 0);
                if (mask_ok == false) {
                    return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
                }
                requested = mask_raw as usize;
            }
        }
        match kernel_process_affinity_set(x0, requested) {
            ProcessAffinityResult::Missing => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_ESRCH), current_authority);
            }
            ProcessAffinityResult::Invalid => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
            }
            ProcessAffinityResult::Mask(mask) => {
                return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
            }
        }
    }
    if (number == AARCH64_NR_GETSID) {
        // pid_t is signed 32-bit at the Linux syscall boundary.
        if ((x0 & 0x80000000) != 0) {
            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_ESRCH), current_authority);
        }
        match kernel_process_session_get(x0 & 0xFFFFFFFF) {
            ProcessSessionResult::Id(id) => {
                return syscall_finish_current(frame, SyscallAction::Resume(id), current_authority);
            }
            ProcessSessionResult::Missing => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_ESRCH), current_authority);
            }
            ProcessSessionResult::Leader => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EPERM), current_authority);
            }
        }
    }
    if (number == AARCH64_NR_SETSID) {
        match kernel_process_session_create() {
            ProcessSessionResult::Id(id) => {
                return syscall_finish_current(frame, SyscallAction::Resume(id), current_authority);
            }
            ProcessSessionResult::Missing => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_ESRCH), current_authority);
            }
            ProcessSessionResult::Leader => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EPERM), current_authority);
            }
        }
    }
    if (number == 172 || number == 178) {
        return syscall_finish_current(frame, SyscallAction::Resume(kernel_process_current_pid()), current_authority);
    }
    if (number == 173) {
        return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
    }
    if (number == 174 || number == 175 || number == 176 || number == 177 ||
        number == AARCH64_NR_SETREGID || number == AARCH64_NR_SETGID ||
        number == AARCH64_NR_SETREUID || number == AARCH64_NR_SETUID ||
        number == AARCH64_NR_SETRESUID || number == AARCH64_NR_GETRESUID ||
        number == AARCH64_NR_SETRESGID || number == AARCH64_NR_GETRESGID ||
        number == AARCH64_NR_GETGROUPS || number == AARCH64_NR_SETGROUPS) {
        return syscall_finish_current(frame,
            SyscallAction::Resume(syscall_id_call(current_authority, number, x0, x1, x2)),
            current_authority);
    }
    if (number == 214) {
        if (x0 == 0) { return syscall_finish_current(frame, SyscallAction::Resume(kernel_syscall_heap_break()), current_authority); }
        // GitHub issue #1151: no mapping lives in the heap arena any more
        // (the mmap region is apart from it), so any break inside it is
        // granted; one outside is refused and the old break returned.
        if (x0 >= kernel_syscall_heap_start() &&
            x0 <= kernel_syscall_heap_limit()) {
            if (kernel_syscall_heap_set(x0) == false) {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
            }
        }
        return syscall_finish_current(frame, SyscallAction::Resume(kernel_syscall_heap_break()), current_authority);
    }
    if (number == 222) {
        let length: usize = x1;
        let prot: usize = x2;
        let flags: usize = x3;
        let fd: usize = x4;
        // This kernel has no file-backed mapping and no executable
        // anonymous memory (issue #174's W^X story): only an anonymous
        // request with fd=-1 and no PROT_EXEC is supported, MAP_PRIVATE or
        // (GitHub issue #1147) MAP_SHARED. mallocng's call shapes (fixed
        // MAP_FIXED guard page, PROT_NONE meta-area pool, PROT_READ|WRITE
        // growth) already satisfy this.
        let map_type: usize = flags & LINUX_MAP_TYPE;
        let shared: bool = map_type == LINUX_MAP_SHARED;
        if ((flags & LINUX_MAP_ANONYMOUS) == 0 ||
                (map_type != LINUX_MAP_PRIVATE && shared == false) ||
                fd != 0xFFFFFFFFFFFFFFFF || (prot & 0x4) != 0) {
            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
        }
        if (length == 0 || length > 0xFFFFFFFFFFFFF000) {
            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
        }
        let rounded: usize = (length + PAGE_SIZE - 1) & 0xFFFFFFFFFFFFF000;
        return syscall_finish_current(frame, syscall_mmap_anonymous(
            current_authority, x0, rounded, shared, (flags & LINUX_MAP_FIXED) != 0), current_authority);
    }
    if (number == 215) {
        // munmap(addr, len): see syscall_munmap_pages.
        if (x0 % PAGE_SIZE != 0 || x1 == 0 || x1 > 0xFFFFFFFFFFFFF000) {
            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
        }
        syscall_munmap_pages(current_authority, x0, (x1 + PAGE_SIZE - 1) & 0xFFFFFFFFFFFFF000);
        return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
    }
    if (number == 226) {
        return syscall_finish_current(frame, syscall_mprotect_current(current_authority, x0, x1, x2), current_authority);
    }
    if (number == AARCH64_NR_MADVISE) {
        return syscall_finish_current(frame, syscall_madvise(current_authority, x0, x1, x2), current_authority);
    }
    if (number == AARCH64_NR_READV) {
        return syscall_finish_current(frame, syscall_readv_current(current_authority, x0, x1, x2), current_authority);
    }
    if (number == AARCH64_NR_WRITEV) {
        return syscall_finish_write(frame, syscall_writev_current(current_authority, x0, x1, x2), current_authority);
    }
    if (number == AARCH64_NR_PPOLL) {
        return syscall_finish_current(frame, syscall_ppoll_dispatch(current_authority, x0, x1, x2, x3), current_authority);
    }
    if (number == AARCH64_NR_NANOSLEEP) {
        match syscall_deadline_wait(current_authority, x0, false) {
            SyscallDeadlineResult::Fault => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
            }
            SyscallDeadlineResult::Invalid => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
            }
            SyscallDeadlineResult::Ready => {
                return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
            }
            SyscallDeadlineResult::Block => { return syscall_finish_current(frame, SyscallAction::Block, current_authority); }
        }
    }
    if (number == AARCH64_NR_CLOCK_NANOSLEEP) {
        if (x0 != 1 || x1 > 1) {
            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
        }
        match syscall_deadline_wait(current_authority, x2, x1 == 1) {
            SyscallDeadlineResult::Fault => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EFAULT), current_authority);
            }
            SyscallDeadlineResult::Invalid => {
                return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EINVAL), current_authority);
            }
            SyscallDeadlineResult::Ready => {
                return syscall_finish_current(frame, SyscallAction::Resume(0), current_authority);
            }
            SyscallDeadlineResult::Block => { return syscall_finish_current(frame, SyscallAction::Block, current_authority); }
        }
    }
    if (number == AARCH64_NR_PRLIMIT64) {
        return syscall_finish_current(frame, syscall_prlimit64(current_authority, x0, x1, x2, x3), current_authority);
    }
    if (number == AARCH64_NR_UNAME) {
        return syscall_finish_current(frame, syscall_uname(current_authority, x0), current_authority);
    }
    // GitHub issue #640: no arm above took this number. Record who reached
    // it, quietly -- a UART line here broke the lanes that compare ash's
    // output exactly.
    let recorded: bool = syscall_unimplemented_record(
        number, kernel_process_current_pid());
    return syscall_finish_current(frame, SyscallAction::Resume(LINUX_ENOSYS), current_authority);
}

const SYSCALL_TRAP_ESR: usize = 0x54000000;

private fn kernel_syscall_clone_failure_action(
        failure: ProcessCloneFailure) -> SyscallAction {
    match failure {
        ProcessCloneFailure::Invalid => {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        ProcessCloneFailure::ResourceExhausted => {
            return SyscallAction::Resume(LINUX_EAGAIN);
        }
    }
}

// With the network capability held by the caller (or absent at boot), the
// second read cannot acquire it. It must return its already copied prefix
// without installing NetRx as this process's pending wait.
fn syscall_vectored_prefix_wait_probe(address: usize, slot: usize,
                                      generation: usize) -> bool !{unsafe} {
    match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => { return false; }
        TcpConnectionTakeResult::Ready(owner) => {
            tcp_connection_of(owner).socket_buffer_length = 1;
            tcp_connection_of(owner).socket_buffer_offset = 0;
            tcp_connection_put(owner);
        }
    }
    let ProcessRunningHere::Running(probe_current) = process_running_here() else {};
    match user_range_check_write(probe_current, address, 32) {
        UserWriteRangeResult::Fault => { process_current_end(probe_current); return false; }
        UserWriteRangeResult::Ok(range) => {
            let mut written = user_write_u64(range, 8, 1);
            written = user_write_join(written,
                user_write_u64(range, 16, (address + 65) as u64));
            written = user_write_join(written, user_write_u64(range, 24, 1));
            match written {
                UserWriteResult::Fault => { process_current_end(probe_current); return false; }
                UserWriteResult::Written => {}
            }
        }
    }
    process_current_end(probe_current);
    let prior_wait: ProcessWaitReason = match process_running_here() {
        ProcessRunningHere::Running(current_authority) => {
            let value: ProcessWaitReason = kernel_process_current_pending_block_reason(current_authority);
            process_current_end(current_authority);
            value
        }
    };
    let (action, count) = kernel_syscall_dispatch(
        SYSCALL_TRAP_ESR, AARCH64_NR_READV, 1, address, 2, 0, 0, 0);
    let after_wait: ProcessWaitReason = match process_running_here() {
        ProcessRunningHere::Running(current_authority) => {
            let value: ProcessWaitReason = kernel_process_current_pending_block_reason(current_authority);
            process_current_end(current_authority);
            value
        }
    };
    return action == 1 && count == 1 && after_wait == prior_wait;
}

// Exercise readv on a connected descriptor without a live network exchange.
// The caller owns a mapped scratch page; this probe restores its stdout and
// frees its private transport before returning, including on refusals.
// GitHub issue #835: this was the inetd-mode probe; the mode is gone, and
// what remains is the connected read it shared with every TCP descriptor.
fn syscall_vectored_connected_read_probe(address: usize) -> bool !{unsafe} {
    let process: usize = kernel_syscall_process_key();
    // The preceding process-table probe may have released root 0's context.
    match unified_fd_context_ensure(process) {
        ProcessFdContextReady::Ready(evidence) => {}
        ProcessFdContextReady::Missing => {
            return false;
        }
    }
    let saved_fd: usize = match unified_fd_alloc(process, 3) {
        UnifiedFdAllocResult::Full => { return false; }
        UnifiedFdAllocResult::Allocated(fd) => { fd }
    };
    let had_stdout: bool = kernel_syscall_terminal_is_open(1);
    if (had_stdout && kernel_regular_fd_duplicate(1, saved_fd) == false) {
        return false;
    }
    let owner = match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            kernel_connected_fd_clear(saved_fd);
            return false;
        }
        TcpConnectionAllocResult::Allocated(found) => { found }
    };
    let slot: usize = tcp_connection_of(owner).self_address;
    let generation: usize = tcp_connection_identity(owner);
    tcp_connection_of(owner).connection_open = true;
    let Place::Full(rx) =
            tcp_connection_frame_hold(owner, TcpFrameRole::Rx) else {
        Place::Empty => {
            tcp_frame_missing();
            kernel_connection_free_capped(owner);
            kernel_connected_fd_clear(saved_fd);
            return false;
        }
    };
    let rx_bytes = tcp_frame_bytes(rx);
    rx_bytes[0] = 0x61;
    rx_bytes[1] = 0x62;
    tcp_connection_frame_unhold(owner, TcpFrameRole::Rx, rx);
    tcp_connection_of(owner).socket_buffer_length = 2;
    tcp_connection_put(owner);
    kernel_connected_fd_clear(1);
    let mut ok: bool = true;
    match unified_connection_create(process, 1, slot, generation) {
        UnifiedOpenResult::Invalid => { ok = false; }
        UnifiedOpenResult::Full => { ok = false; }
        UnifiedOpenResult::Ok => {
            // readv consumes the connected descriptor's RX data. A short
            // first segment must leave the invalid (null) second untouched.
            let ProcessRunningHere::Running(probe_current) = process_running_here() else {};
            match user_range_check_write(probe_current, address, 32) {
                UserWriteRangeResult::Fault => { ok = false; }
                UserWriteRangeResult::Ok(range) => {
                    let mut written = user_write_u64(range, 0, (address + 64) as u64);
                    written = user_write_join(written, user_write_u64(range, 8, 4));
                    written = user_write_join(written, user_write_u64(range, 16, 0));
                    written = user_write_join(written, user_write_u64(range, 24, 1));
                    match written {
                        UserWriteResult::Fault => { ok = false; }
                        UserWriteResult::Written => {}
                    }
                }
            }
            process_current_end(probe_current);
            let (read_action, read_count) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, AARCH64_NR_READV, 1, address, 2, 0, 0, 0);
            if (read_action != 1 || read_count != 2) { ok = false; }
            let ProcessRunningHere::Running(probe_current) = process_running_here() else {};
            match user_range_check_read(probe_current, address + 64, 2) {
                UserReadRangeResult::Fault => { ok = false; }
                UserReadRangeResult::Ok(range) => {
                    if (user_read_byte(range, 0) != 0x61 ||
                        user_read_byte(range, 1) != 0x62) { ok = false; }
                }
            }
            process_current_end(probe_current);
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    if (syscall_vectored_prefix_wait_probe(address, slot, generation) == false) {
                        ok = false;
                    }
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    if (syscall_vectored_prefix_wait_probe(address, slot, generation) == false) {
                        ok = false;
                    }
                    match network_capability_put(ready) {
                        NetworkCapabilityPutResult::Conflict => { ok = false; }
                        NetworkCapabilityPutResult::Stored => {}
                    }
                }
            }
        }
    }
    match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => { ok = false; }
        TcpConnectionTakeResult::Ready(after) => { kernel_connection_free_capped(after); }
    }
    kernel_connected_fd_clear(1);
    if (had_stdout && kernel_regular_fd_duplicate(saved_fd, 1) == false) {
        ok = false;
    }
    kernel_connected_fd_clear(saved_fd);
    return ok;
}

// Boot-time negative-test coverage for issue #175: the real BusyBox/musl
// binary never requests PROT_EXEC/a real fd for mmap, an invalid rt_sigaction
// signum, or a non-null rt_sigaction oldact it then checks byte-for-byte, so
// passing hardware behavior alone can't prove those reject/zero-fill paths
// work. Exercises kernel_syscall_dispatch directly with crafted esr/args
// (exception_class 0x15, matching the real SVC trap), using its own
// throwaway page for the oldact buffer.
//
// GitHub issue #258: that page's virtual address is claimed via
// user_va_find_free_run (kernel/mm/user_memory.tkb) instead of the former
// hardcoded SYSCALL_SUBSET_PROBE_L3_INDEX = 503, whose only protection
// against colliding with issue #174's own probe was a hand-written prose
// comment here saying it was "outside ... L3 indices 500-502" -- both
// sat inside process_image.tkb's stack-growth region (448..510) in the
// same root-0 L3 table.
variant SyscallCowReadReport { Failed; Delivered; RefusedThenDelivered; }

// GitHub issue #725: read(2) into a page that is still copy-on-write.
// Validation accepts the page without allocating its private copy, so the
// copy happens inside the store, and may be refused. A refused copy must
// leave the file offset where it was and the shared page intact, and a
// retry must deliver the same bytes. A second mapping reference makes the
// page genuinely shared, so address_space_resolve_cow takes its
// allocating path; the QEMU cow-read lane forces that allocation to fail
// once from the debugger, and every other boot sees it succeed.
fn kernel_syscall_cow_read_probe() -> SyscallCowReadReport !{unsafe} {
    let probe_index: usize = match user_va_find_free_run(1) {
        UserVaRunResult::None => { return SyscallCowReadReport::Failed; }
        UserVaRunResult::Found(index) => { index }
    };
    let mut root: AddressSpaceRoot = address_space_boot_root();
    let shared_physical: usize = match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => { return SyscallCowReadReport::Failed; }
        PageAllocResult::Allocated(page) => {
            let physical: usize = page_physical_address(page);
            match address_space_map_page(root, probe_index, page,
                                         USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    return SyscallCowReadReport::Failed;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    return SyscallCowReadReport::Failed;
                }
                AddressSpacePteWriteResult::Written => {}
            }
            physical
        }
    };
    let address: usize = USER_TEXT_VA + probe_index * PAGE_SIZE;
    // A sibling address space maps the same page, as a fork leaves it.
    let mut sibling_slot: ProcessSlot = scheduled_process_probe_slot_acquire();
    let sibling: usize = process_slot_address(sibling_slot);
    if (sibling == 0) {
        user_pte_clear(probe_index);
        return SyscallCowReadReport::Failed;
    }
    let mut sibling_root: AddressSpaceRoot =
        scheduled_process_address_space_root_lookup(sibling_slot);
    let mut shared: bool = false;
    match address_space_ensure_root(sibling_slot) {
        AddressSpaceEnsureResult::SlotOutOfRange => {}
        AddressSpaceEnsureResult::OutOfMemory => {}
        AddressSpaceEnsureResult::Ok => {
            match page_mapping_retain_physical(shared_physical,
                                               address_space_live_count()) {
                PageMappingRetainResult::NotMapped => {}
                PageMappingRetainResult::RefCeilingReached => {}
                PageMappingRetainResult::Retained => {
                    let cow_pte: usize = address_space_pte_cow_value(
                        shared_physical | USER_RW_XN_FLAGS);
                    match address_space_pte_write(sibling_root, probe_index,
                                                  cow_pte) {
                        AddressSpacePteWriteResult::Invalid => {
                            page_mapping_release_physical(shared_physical);
                        }
                        AddressSpacePteWriteResult::OutOfMemory => {
                            page_mapping_release_physical(shared_physical);
                        }
                        AddressSpacePteWriteResult::Written => {
                            match address_space_pte_write(root, probe_index,
                                                          cow_pte) {
                                AddressSpacePteWriteResult::Invalid => {}
                                AddressSpacePteWriteResult::OutOfMemory => {}
                                AddressSpacePteWriteResult::Written => {
                                    shared = true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    let process: usize = kernel_syscall_process_key();
    let mut ok: bool = shared;
    let mut fd: usize = 0;
    match unified_fd_context_ensure(process) {
        ProcessFdContextReady::Missing => { ok = false; }
        ProcessFdContextReady::Ready(evidence) => {
            match unified_fd_alloc(process, 3) {
                UnifiedFdAllocResult::Full => { ok = false; }
                UnifiedFdAllocResult::Allocated(found) => { fd = found; }
            }
        }
    }
    // Any live process's stat file: boot probes run before a current
    // process has a diagnostic record of its own.
    let inode: usize = procfs_inode(procfs_next_pid(0), 1);
    if (ok) {
        match unified_file_open(process, fd, inode, true, false) {
            UnifiedOpenResult::Invalid => { ok = false; }
            UnifiedOpenResult::Full => { ok = false; }
            UnifiedOpenResult::Ok => {}
        }
    }
    let mut expected: [u8; 1024];
    let total: usize = procfs_render_file(inode, expected as [u8; 1024..]);
    if (total < 8) { ok = false; }

    let mut report: SyscallCowReadReport = SyscallCowReadReport::Failed;
    if (ok) {
        // read(fd, address, 8)
        let (first_action, first_value) = kernel_syscall_dispatch(
            SYSCALL_TRAP_ESR, 63, fd, address, 8, 0, 0, 0);
        let after_first: usize = address_space_pte_read(root, probe_index);
        if (first_action == 1 && first_value == 8) {
            if (kernel_syscall_file_offset(fd) == 8 &&
                address_space_pte_is_cow(after_first) == false &&
                (after_first & USER_PAGE_PHYS_MASK) != shared_physical &&
                user_probe_boot_read_matches(address, expected as []const u8)) {
                report = SyscallCowReadReport::Delivered;
            }
        } else if (first_action == 1 && first_value == LINUX_EFAULT &&
                   kernel_syscall_file_offset(fd) == 0 &&
                   after_first == address_space_pte_cow_value(
                       shared_physical | USER_RW_XN_FLAGS) &&
                   page_mapping_refcount_physical(shared_physical) == 2) {
            let (retry_action, retry_value) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 63, fd, address, 8, 0, 0, 0);
            if (retry_action == 1 && retry_value == 8 &&
                kernel_syscall_file_offset(fd) == 8 &&
                user_probe_boot_read_matches(address, expected as []const u8)) {
                report = SyscallCowReadReport::RefusedThenDelivered;
            }
        }
    }
    match unified_fd_close(process, fd) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
    // Releasing the sibling drops its reference; the clear then gives back
    // the page this root maps, whether that is the shared page or its copy.
    address_space_release_root(sibling_root);
    scheduled_process_probe_slot_release(sibling_slot);
    user_pte_clear(probe_index);
    return report;
}


fn kernel_syscall_subset_probe() -> bool !{unsafe} {
    let probe_index: usize = match user_va_find_free_run(1) {
        UserVaRunResult::None => { return false; }
        UserVaRunResult::Found(index) => { index }
    };
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => { return false; }
        PageAllocResult::Allocated(page) => {
            match address_space_map_page(
                    address_space_boot_root(), probe_index, page, USER_RW_XN_FLAGS) {
                AddressSpacePteWriteResult::Invalid => {
                    return false;
                }
                AddressSpacePteWriteResult::OutOfMemory => {
                    return false;
                }
                AddressSpacePteWriteResult::Written => {}
            }
            let oldact_va: usize = USER_TEXT_VA + probe_index * PAGE_SIZE;

            let mut ok: bool = true;

            // A scheduled_process_alloc failure during clone is distinct
            // from invalid clone arguments at the Linux syscall boundary.
            let (invalid_clone_action, invalid_clone_value) =
                syscall_action_encode(kernel_syscall_clone_failure_action(
                    ProcessCloneFailure::Invalid));
            let (exhausted_clone_action, exhausted_clone_value) =
                syscall_action_encode(kernel_syscall_clone_failure_action(
                    ProcessCloneFailure::ResourceExhausted));
            if (invalid_clone_action != 1 ||
                invalid_clone_value != LINUX_EINVAL ||
                exhausted_clone_action != 1 ||
                exhausted_clone_value != LINUX_EAGAIN) {
                ok = false;
            }

            // mmap: PROT_EXEC is always rejected.
            let (action1, value1) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 222, 0, 4096, 0x4, 0x22,
                0xFFFFFFFFFFFFFFFF, 0);
            if (action1 != 1 || value1 != LINUX_EINVAL) { ok = false; }

            // mmap: a real fd (file-backed) is always rejected.
            let (action2, value2) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 222, 0, 4096, 0x3, 0x22, 3, 0);
            if (action2 != 1 || value2 != LINUX_EINVAL) { ok = false; }

            // rt_sigaction: signum 0 is rejected.
            let (action3, value3) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 134, 0, 0, 0, 0, 0, 0);
            if (action3 != 1 || value3 != LINUX_EINVAL) { ok = false; }

            // rt_sigaction: a non-null oldact is zero-filled, not left as
            // whatever was already there (poison it first to prove that).
            let ProcessRunningHere::Running(probe_current) = process_running_here() else {};
            match user_range_check_write(probe_current, oldact_va, 32) {
                UserWriteRangeResult::Fault => { ok = false; }
                UserWriteRangeResult::Ok(range) => {
                    match user_write_byte(range, 0, 0xAA) {
                        UserWriteResult::Fault => { ok = false; }
                        UserWriteResult::Written => {}
                    }
                }
            }
            process_current_end(probe_current);
            let (action4, value4) = kernel_syscall_dispatch(
                SYSCALL_TRAP_ESR, 134, 1, 0, oldact_va, 0, 0, 0);
            if (action4 != 1 || value4 != 0) { ok = false; }
            let ProcessRunningHere::Running(probe_current) = process_running_here() else {};
            match user_range_check_read(probe_current, oldact_va, 1) {
                UserReadRangeResult::Fault => { ok = false; }
                UserReadRangeResult::Ok(range) => {
                    if (user_read_byte(range, 0) != 0) { ok = false; }
                }
            }
            process_current_end(probe_current);

            if (syscall_vectored_connected_read_probe(oldact_va) == false) { ok = false; }
            user_pte_clear(probe_index);
            return ok;
        }
    }
}

// GitHub issue #453. Persistent syscall state belongs to ProcessRecord, and
// the transient buffers are SyscallSlot pool slots (#638), which survive
// preemption as they are. What still belongs to the executing core is
// syscall_ext2_reader. On one core a timer interrupt already arrives inside
// a syscall -- interrupts are unmasked on EL0 entry -- but the switch is
// deferred to kernel_process_syscall_return_schedule.
fn syscall_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "syscall_ext2_reader is per-CPU state one function leaves for another; preemption would let another handler on this CPU take it over");
}

// Complete a syscall while retaining its current authority through signal delivery.
private fn syscall_finish_current(
        frame: MaybeFrame, action: SyscallAction,
        current_authority: ProcessCurrent[process, ProcessState::Running])
        -> SyscallAction !{unsafe} {
    return syscall_signal_deliver(current_authority, frame, action);
}

// GitHub issue #1042: the write family's return. A write that met a pipe
// with no reader answers EPIPE and has raised SIGPIPE (syscall_io_action);
// when that signal ends the writer, it ends it here, on the way out of the
// write, as Linux does and as kill(2) of oneself does above -- not at the
// writer's next syscall or tick. EPIPE comes from nowhere else (a broken
// TCP socket, #1113, takes the same PipeBroken path).
private fn syscall_finish_write(
        frame: MaybeFrame, action: SyscallAction,
        current_authority: ProcessCurrent[process, ProcessState::Running])
        -> SyscallAction !{unsafe} {
    match action {
        SyscallAction::Resume(value) => {
            if (value == LINUX_EPIPE &&
                kernel_process_current_signal_terminates(LINUX_SIGPIPE)) {
                return kernel_syscall_exit_current_process(
                    current_authority, process_end_signaled(LINUX_SIGPIPE));
            }
            return syscall_finish_current(frame, SyscallAction::Resume(value), current_authority);
        }
        SyscallAction::Unreachable => { return syscall_finish_current(frame, SyscallAction::Unreachable, current_authority); }
        SyscallAction::Exit(status) => { return syscall_finish_current(frame, SyscallAction::Exit(status), current_authority); }
        SyscallAction::CloneChild(pid) => { return syscall_finish_current(frame, SyscallAction::CloneChild(pid), current_authority); }
        SyscallAction::CloneParent(sp) => { return syscall_finish_current(frame, SyscallAction::CloneParent(sp), current_authority); }
        SyscallAction::Block => { return syscall_finish_current(frame, SyscallAction::Block, current_authority); }
        SyscallAction::WaitInterrupt => { return syscall_finish_current(frame, SyscallAction::WaitInterrupt, current_authority); }
        SyscallAction::Migrate => { return syscall_finish_current(frame, SyscallAction::Migrate, current_authority); }
    }
}

// Clone owns the parent's authority and returns only after consuming/restoring it.
private fn syscall_clone_current(
        current_authority: ProcessCurrent[process, ProcessState::Running],
        frame: MaybeFrame) -> SyscallAction !{unsafe} {
    let mut clone_flags: usize = 0x11;
    let mut clone_stack: usize = 0;
    let mut parent_slot: ProcessSlot = kernel_syscall_process_slot();
    // GitHub issue #981: the root the child's VM is copied from, named
    // while current_authority is still the parent's.
    let mut parent_space: AddressSpaceRoot = kernel_process_current_root(current_authority);
    // GitHub issue #245: kernel_process_clone_begin() now runs first
    // (it used to run last), since the address-space root and
    // fd-table slot the VM/fd clone steps below need are the new
    // child's own ProcessHandle.pool_index -- not fixed to root 1 /
    // fd-slot 1 anymore, so nothing downstream can pick them without
    // asking process.tkb for the slot it actually allocated.
    match kernel_process_clone_begin(current_authority, clone_flags, clone_stack) {
        ProcessCloneResult::Invalid(restored) => {
            return syscall_finish_current(frame, kernel_syscall_clone_failure_action(ProcessCloneFailure::Invalid), restored);
        }
        ProcessCloneResult::ResourceExhausted(restored) => {
            return syscall_finish_current(frame, kernel_syscall_clone_failure_action(ProcessCloneFailure::ResourceExhausted), restored);
        }
        ProcessCloneResult::ChildConstructing(child_authority) => {
            let child_pid: usize = kernel_process_current_pid();
            // Guard against PID 1's own fork of the interactive ash
            // (BusyBox init starting the /etc/inittab respawn ash):
            // that
            // happens automatically at boot, before the host ever
            // submits a command, and is not the boundary this
            // checkpoint means. The checkpoint is specifically the
            // interactive ash forking ITS OWN child (e.g. the
            // backgrounded HTTPd) -- excluding PID 1 as the forking
            // parent is sufficient, since PID 1 is the only process
            // that forks directly under the persistent-shell scenario
            // before the ash session itself forks anything.
            //
            // kernel_process_clone_begin() already switches "current"
            // to the newly created CHILD before returning (the clone
            // continuation resumes as the child directly, x0=0), so
            // "current" here is child_pid, not the forking parent --
            // kernel_process_parent_is_root() (which asks about
            // *current's* parent) is the right check for "did PID 1
            // do this fork", not a direct pid comparison against
            // kernel_process_current_pid().
            if (kernel_syscall_persistent_shell_active() &&
                kernel_process_parent_is_root(child_authority) == false) {
                kernel_syscall_persistent_shell_checkpoint_fork(child_pid);
            }
            let mut child_space: AddressSpaceRoot = kernel_process_current_root(child_authority);
            let child_slot: usize = root_slot_word(address_space_root_slot(child_space));
            match process_image_clone_vm_begin(parent_space, child_space) {
                ProcessCloneVmResult::OutOfMemory => {
                    match kernel_process_clone_rollback(child_authority) {
                        ProcessCloneRollbackResult::Invalid => {
                            return SyscallAction::Unreachable;
                        }
                        ProcessCloneRollbackResult::Restored(restored) => {
                            return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EAGAIN), restored);
                        }
                    }
                }
                ProcessCloneVmResult::Copied => {
                    match kernel_syscall_clone_files_begin(
                        parent_slot, kernel_process_slot_of_current(child_authority)) {
                        UnifiedFdResult::Invalid => {
                            match process_image_clone_vm_reap(child_space) {
                                ProcessCloneVmReapResult::Missing => {}
                                ProcessCloneVmReapResult::Reaped => {}
                            }
                            match kernel_process_clone_rollback(child_authority) {
                                ProcessCloneRollbackResult::Invalid => {
                                    return SyscallAction::Unreachable;
                                }
                                ProcessCloneRollbackResult::Restored(restored) => {
                                    return syscall_finish_current(frame, SyscallAction::Resume(LINUX_EAGAIN), restored);
                                }
                            }
                        }
                        UnifiedFdResult::Ok => {}
                    }
                    // Assembly copies the complete saved parent frame
                    // to the dedicated child kernel stack and resumes
                    // x0=0.
                    process_current_end(child_authority);
                    return SyscallAction::CloneChild(child_pid);
                }
            }
        }
    }
}

// Borrow current through the getdents64 operation; ownership stays at dispatch.
private fn syscall_getdents64_current(
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallAction = syscall_getdents64_current_with(slot, current_authority, x0, x1, x2);
    syscall_slot_release(slot);
    return result;
}

private inline fn syscall_getdents64_current_with(slot: borrow SyscallSlot[0],
        
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    // getdents64(fd, dirent, count): the directory FD owns the stream
    // offset, while ext2 supplies one filesystem block at a time. The
    // userspace ABI records are packed to 8-byte alignment and carry the
    // next directory offset in d_off.
    if (kernel_syscall_directory_is_open(x0) == false) {
        return SyscallAction::Resume(LINUX_EBADF);
    }
    if (x2 == 0) { return SyscallAction::Resume(0); }
    match user_range_check_write(current_authority, x1, x2) {
        UserWriteRangeResult::Fault => {
            return SyscallAction::Resume(LINUX_EFAULT);
        }
        UserWriteRangeResult::Ok(range) => {
            let inode_number: usize = kernel_syscall_directory_inode(x0);
            let mut directory_offset: usize =
                kernel_syscall_file_offset(x0);
            let mut written: usize = 0;
            if (inode_number == PROCFS_TAKIBI_INODE) {
                // GitHub issue #497: /proc/takibi lists "profile", then
                // (#1245) "security", one entry per call.
                if (directory_offset > 1) { return SyscallAction::Resume(0); }
                let mut entry_name: []const u8 = bs"profile";
                let mut entry_inode: usize = PROCFS_TAKIBI_PROFILE_INODE;
                if (directory_offset == 1) {
                    entry_name = bs"security";
                    entry_inode = PROCFS_TAKIBI_SECURITY_INODE;
                }
                match syscall_procfs_fixed_dirent(range, x2, entry_name,
                                                  entry_inode, 8, directory_offset + 1) {
                    ProcfsDirentWrite::TooSmall => { return SyscallAction::Resume(LINUX_EINVAL); }
                    ProcfsDirentWrite::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                    ProcfsDirentWrite::Written(size) => {
                        if (kernel_syscall_file_set_offset(x0, directory_offset + 1) == false) {
                            return SyscallAction::Resume(LINUX_EBADF);
                        }
                        return SyscallAction::Resume(size);
                    }
                }
            }
            if (inode_number == PROCFS_ROOT_INODE) {
                if (directory_offset == 0) {
                    // GitHub issue #497: /proc/takibi, before the pids.
                    match syscall_procfs_fixed_dirent(range, x2, bs"takibi",
                                                      PROCFS_TAKIBI_INODE, 4,
                                                      procfs_root_takibi_offset()) {
                        ProcfsDirentWrite::TooSmall => { return SyscallAction::Resume(LINUX_EINVAL); }
                        ProcfsDirentWrite::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                        ProcfsDirentWrite::Written(size) => {
                            written = size;
                            directory_offset = procfs_root_takibi_offset();
                        }
                    }
                }
                let mut name_storage: [u8; 20];
                let name_view: []u8 = name_storage as []u8;
                let mut scanning: bool = true;
                while (scanning) {
                    let pid: usize = procfs_next_pid(
                        directory_offset & (procfs_root_takibi_offset() - 1));
                    if (pid == 0) {
                        scanning = false;
                    } else {
                        let name_length: usize =
                            procfs_pid_name(pid, name_view);
                        let mut record_length: usize =
                            19 + name_length + 1;
                        record_length = (record_length + 7) &
                        0xFFFFFFFFFFFFFFF8;
                        if (record_length > x2 - written) {
                            if (written == 0) {
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            scanning = false;
                        } else {
                            let mut record = user_write_u64(range, written,
                                procfs_inode(pid, 0) as u64);
                            record = user_write_join(record,
                                user_write_u64(range, written + 8,
                                    (pid | procfs_root_takibi_offset()) as u64));
                            record = user_write_join(record,
                                user_write_u16(range, written + 16, record_length));
                            record = user_write_join(record,
                                user_write_byte(range, written + 18, 4));
                            for index: usize in 0..<20 {
                                if (index < name_length) {
                                    record = user_write_join(record,
                                        user_write_byte(
                                            range, written + 19 + index,
                                            name_storage[index]));
                                }
                            }
                            record = user_write_join(record,
                                user_write_byte(
                                    range, written + 19 + name_length, 0));
                            match record {
                                UserWriteResult::Fault => {
                                    // Stop before this pid: the stream
                                    // offset names the last delivered one.
                                    if (written == 0) {
                                        return SyscallAction::Resume(LINUX_EFAULT);
                                    }
                                    scanning = false;
                                }
                                UserWriteResult::Written => {
                                    written = written + record_length;
                                    directory_offset = pid | procfs_root_takibi_offset();
                                }
                            }
                        }
                    }
                }
                if (kernel_syscall_file_set_offset(
                    x0, directory_offset) == false) {
                    return SyscallAction::Resume(LINUX_EBADF);
                }
                return SyscallAction::Resume(written);
            }
            let mount: Ext2Mount = match syscall_filesystem_lookup() {
                SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
                SyscallFilesystemReady::Configured(found) => { found }
            };
            // GitHub issue #975: every entry read lies in the chunk the
            // directory read initialized; no zero fill.
            while (written < x2) {
                match ext2_read_directory_chunk(
                    mount, inode_number,
                    directory_offset,
                    syscall_scratch[slot.index].file_buffer as []u8) {
                    Ext2ReadResult::Invalid => {
                        if (written != 0) {
                            return SyscallAction::Resume(written);
                        }
                        return SyscallAction::Resume(LINUX_EINVAL);
                    }
                    Ext2ReadResult::Read(chunk) => {
                        if (chunk == 0) {
                            if (kernel_syscall_file_set_offset(
                                x0, directory_offset) == false) {
                                return SyscallAction::Resume(LINUX_EBADF);
                            }
                            return SyscallAction::Resume(written);
                        }
                        let mut cursor: usize = 0;
                        while (cursor < chunk && written < x2) {
                            let entry_start: usize = cursor;
                            if (entry_start > chunk || chunk - entry_start < 8) {
                                if (written != 0) {
                                    return SyscallAction::Resume(written);
                                }
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            let file_bytes = syscall_scratch[slot.index].file_buffer as []u8;
                            if (entry_start > file_bytes.len) {
                                if (written != 0) { return SyscallAction::Resume(written); }
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            let entry_tail = file_bytes[entry_start..<file_bytes.len];
                            if (entry_tail.len < 8) {
                                if (written != 0) { return SyscallAction::Resume(written); }
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            let entry = entry_tail[0..<8];
                            let entry_inode: usize =
                                ext2_slice_u32(entry, 0) as usize;
                            let record_length: usize =
                                ext2_slice_u16(entry, 4) as usize;
                            let name_length: usize = entry[6] as usize;
                            if (record_length < 8 ||
                                record_length > chunk - entry_start ||
                                name_length > record_length - 8) {
                                if (written != 0) {
                                    return SyscallAction::Resume(written);
                                }
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            let next_offset: usize =
                                directory_offset + record_length;
                            cursor = cursor + record_length;
                            directory_offset = next_offset;
                            if (entry_inode == 0) { continue; }
                            let mut output_length: usize =
                                19 + name_length + 1;
                            output_length = (output_length + 7) &
                            0xFFFFFFFFFFFFFFF8;
                            if (output_length > x2 - written) {
                                if (written == 0) {
                                    return SyscallAction::Resume(
                                        LINUX_EINVAL);
                                }
                                if (kernel_syscall_file_set_offset(
                                    x0, directory_offset -
                                    record_length) == false) {
                                    return SyscallAction::Resume(
                                        LINUX_EBADF);
                                }
                                return SyscallAction::Resume(written);
                            }
                            let name_tail = entry_tail[8..<entry_tail.len];
                            if (name_length > name_tail.len) {
                                if (written != 0) { return SyscallAction::Resume(written); }
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            let entry_name = name_tail[0..<name_length];
                            let mut record = user_write_u64(range, written,
                                entry_inode as u64);
                            record = user_write_join(record,
                                user_write_u64(range, written + 8,
                                               directory_offset as u64));
                            record = user_write_join(record,
                                user_write_u16(range, written + 16, output_length));
                            record = user_write_join(record,
                                user_write_byte(range, written + 18, entry[7]));
                            let mut name_output: usize = written + 19;
                            for name_byte in entry_name {
                                record = user_write_join(record,
                                    user_write_byte(range, name_output, name_byte));
                                name_output = name_output + 1;
                            }
                            record = user_write_join(record,
                                user_write_byte(range,
                                    written + 19 + name_length, 0));
                            match record {
                                UserWriteResult::Fault => {
                                    // Not delivered: the stream resumes at
                                    // this entry, as when it does not fit.
                                    if (written == 0) {
                                        return SyscallAction::Resume(LINUX_EFAULT);
                                    }
                                    if (kernel_syscall_file_set_offset(
                                        x0, directory_offset -
                                        record_length) == false) {
                                        return SyscallAction::Resume(
                                            LINUX_EBADF);
                                    }
                                    return SyscallAction::Resume(written);
                                }
                                UserWriteResult::Written => {}
                            }
                            written = written + output_length;
                        }
                        if (cursor == 0) {
                            return SyscallAction::Resume(LINUX_EINVAL);
                        }
                    }
                }
            }
            if (kernel_syscall_file_set_offset(x0, directory_offset) ==
                false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            return SyscallAction::Resume(written);
        }
    }
}

// Borrow current through the sendfile operation; ownership stays at dispatch.
private fn syscall_sendfile_current(
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize, x3: usize)
        -> SyscallAction !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallAction = syscall_sendfile_current_with(slot, current_authority, x0, x1, x2, x3);
    syscall_slot_release(slot);
    return result;
}

private inline fn syscall_sendfile_current_with(slot: borrow SyscallSlot[0],
        
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize, x3: usize)
        -> SyscallAction !{unsafe} {
    // sendfile(out_fd, in_fd, offset, count). BusyBox cat uses a null
    // offset, so the shared file position is sufficient for this first
    // Linux-compatible path. Output remains the existing UART console.
    let output_fd: usize = x0;
    let input_fd: usize = x1;
    let offset_address: usize = x2;
    let requested: usize = x3;
    // GitHub issue #1042: the output must BE the terminal, not merely fd 1
    // or 2. BusyBox cat's stdout in a pipeline is a pipe, and this path
    // used to queue its bytes on the UART instead; refused, BusyBox falls
    // back to read and write. GitHub issue #1222: and it is the terminal
    // whatever its number, as reads and polls are since #902; a dup of the
    // terminal is a terminal.
    if (kernel_syscall_terminal_is_open(output_fd) == false ||
        kernel_syscall_file_is_open(input_fd) == false ||
        kernel_syscall_file_readable(input_fd) == false) {
        return SyscallAction::Resume(LINUX_EBADF);
    }
    if (offset_address != 0) { return SyscallAction::Resume(LINUX_EINVAL); }
    let mount: Ext2Mount = match syscall_filesystem_lookup() {
        SyscallFilesystemReady::Unconfigured => { return SyscallAction::Resume(LINUX_EBADF); }
        SyscallFilesystemReady::Configured(found) => { found }
    };
    // GitHub issue #975: the bytes queued are the chunk the file read
    // initialized; no zero fill.
    let mut copied: usize = 0;
    while (copied < requested) {
        let mut chunk_limit: usize = requested - copied;
        if (chunk_limit > KERNEL_BLOCK_SIZE) {
            chunk_limit = KERNEL_BLOCK_SIZE;
        }
        let staging_buffer = syscall_scratch[slot.index].file_buffer as []u8;
        if (chunk_limit > staging_buffer.len) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk_limit];
        match ext2_read_file_chunk(
            mount, kernel_syscall_file_inode(input_fd),
            kernel_syscall_file_offset(input_fd),
            staging) {
            Ext2ReadResult::Invalid => {
                if (copied != 0) { return SyscallAction::Resume(copied); }
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            Ext2ReadResult::Read(chunk) => {
                if (chunk == 0) { return SyscallAction::Resume(copied); }
                // GitHub issue #598: through the terminal's own queue,
                // as write(1) goes -- on a peer that is its console
                // ring, which core 0 drains (#534). The raw per-byte
                // UART write this replaces would have driven the
                // device from a peer. Only the bytes the queue took
                // advance the file position.
                if (chunk > staging.len) {
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                let queued: usize = uart_user_write(staging[0..<chunk]);
                if (queued == 0) {
                    if (copied != 0) {
                        return SyscallAction::Resume(copied);
                    }
                    return syscall_terminal_write_wait(current_authority);
                }
                if (kernel_syscall_file_set_offset(
                    input_fd,
                    kernel_syscall_file_offset(input_fd) + queued) ==
                    false) {
                    if (copied != 0) {
                        return SyscallAction::Resume(copied);
                    }
                    return SyscallAction::Resume(LINUX_EBADF);
                }
                copied = copied + queued;
                if (queued < chunk) {
                    return SyscallAction::Resume(copied);
                }
            }
        }
    }
    return SyscallAction::Resume(copied);
}

// Borrow current through the execve operation; ownership stays at dispatch.
// What execve answers (GitHub issue #1080). A refusal is an errno for the
// caller, which returns through the ordinary signal-delivering Resume. A
// success has passed the point where the caller's image survives and holds
// the argv page execve allocated; dispatch runs the exec's tail with it
// (kernel_syscall_dispatch_child_exec) and never returns to user_entry.S.
// This is its own type rather than a SyscallAction arm: a page owner is
// five words, and a SyscallAction that large is returned through memory at
// each of the dispatcher's several hundred inlined return sites, which
// grew kernel_syscall_dispatch_action's frame from 240 B to 21 KiB.
must_use variant SyscallExecveResult {
    Refused(usize);
    ChildExec(exists page: usize. PageOwner[page]);
}

private fn syscall_execve_current(
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], number: usize, x0: usize, x1: usize, x2: usize)
        -> SyscallExecveResult !{unsafe} {
    let slot: SyscallSlot[0] = syscall_slot_acquire();
    let result: SyscallExecveResult = syscall_execve_current_with(slot, current_authority, number, x0, x1, x2);
    syscall_slot_release(slot);
    return result;
}

private inline fn syscall_execve_current_with(slot: borrow SyscallSlot[0],
        
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], number: usize, x0: usize, x1: usize, x2: usize)
        -> SyscallExecveResult !{unsafe} {
    // First handoff slice: only the current parent image may request an
    // exec. The child path still needs a process-owned image token and is
    // deliberately rejected until the general child lifecycle lands.
    if (kernel_syscall_exec_pending()) {
        return SyscallExecveResult::Refused(LINUX_EAGAIN);
    }
    // GitHub issue #610: an exec runs where it is called, PID 1's included
    // (#775, #831).
    let mut path_address: usize = x0;
    let mut argv_address: usize = x1;
    if (number == AARCH64_NR_EXECVEAT) {
        path_address = x1;
        argv_address = x2;
    }
    let exec_lookup_name: []u8 = match kernel_syscall_path_name(slot, current_authority, path_address) {
        SyscallPathResult::Fault => { return SyscallExecveResult::Refused(LINUX_EFAULT); }
        SyscallPathResult::Invalid => { return SyscallExecveResult::Refused(LINUX_ENOENT); }
        SyscallPathResult::Name(path) => { path }
    };
    let mut path_length: usize = exec_lookup_name.len;
    let path_view: [u8; 256..] = syscall_path_view_here(slot);
    if (path_view[0] == 0x2F) { path_length = path_length + 1; }
    if (path_length == 0 || argv_address == 0) { return SyscallExecveResult::Refused(LINUX_EINVAL); }
    let exec_path_absolute: bool = path_view[0] == 0x2F;
    if (path_length > 256) { return SyscallExecveResult::Refused(LINUX_EINVAL); }
    // GitHub issue #974: the staging helpers and every function between
    // here and them require file_buffer initialized; this fill is what
    // shows it, checked at each call.
    zero_fill(syscall_scratch[slot.index].file_buffer as []u8);
    let exec_path: []u8 = syscall_exec_path_here(slot);
    for path_index: usize in 0..<256 { exec_path[path_index] = 0; }
    let saved_path: usize = slice_copy(
        exec_path[0..<path_length],
        path_view[0..<path_length]);
    if (saved_path != path_length) {
        return SyscallExecveResult::Refused(LINUX_EFAULT);
    }
    // The executable format is decided from the file, before the
    // caller's argv is copied: a `#!` target replaces argv[0] with its
    // own interpreter, so the copy below has to know whether the
    // caller's argv[0] still belongs in the result.
    let mut script_argc: usize = 0;
    let mut script_offset: usize = 0;
    let mut exec_inode: SyscallExecInode = syscall_exec_inode_none();
    if (exec_path_absolute) {
        match syscall_exec_format(slot, path_length) {
            SyscallExecFormatResult::NotMounted => {}
            SyscallExecFormatResult::Executable(inode) => {
                exec_inode = inode;
            }
            SyscallExecFormatResult::Absent => {
                return SyscallExecveResult::Refused(LINUX_ENOENT);
            }
            SyscallExecFormatResult::NotPermitted => {
                return SyscallExecveResult::Refused(LINUX_EACCES);
            }
            SyscallExecFormatResult::Unreadable => {
                return SyscallExecveResult::Refused(LINUX_EIO);
            }
            SyscallExecFormatResult::NotExecutable => {
                return SyscallExecveResult::Refused(LINUX_ENOEXEC);
            }
            SyscallExecFormatResult::InterpreterAbsent => {
                return SyscallExecveResult::Refused(LINUX_ENOENT);
            }
            SyscallExecFormatResult::InterpreterUnsupported => {
                return SyscallExecveResult::Refused(LINUX_ELIBBAD);
            }
            SyscallExecFormatResult::Invalid => {
                return SyscallExecveResult::Refused(LINUX_EINVAL);
            }
            SyscallExecFormatResult::TooBig => {
                return SyscallExecveResult::Refused(LINUX_E2BIG);
            }
            SyscallExecFormatResult::TooDeep => {
                return SyscallExecveResult::Refused(LINUX_ELOOP);
            }
            SyscallExecFormatResult::Script(prefix) => {
                script_argc = prefix.argc;
                script_offset = prefix.length;
                exec_inode = prefix.inode;
            }
        }
    }
    // GitHub issue #610 kept exec'ing BusyBox Extras on core 0 because its
    // handoff drained the TCP connection pool; #828 ran it where it was
    // called, and #836 removed the drain.
    let mut output_offset: usize = script_offset;
    let mut argc: usize = script_argc;
    let mut vector_terminated: bool = false;
    // GitHub issue #591: fifteen arguments plus the terminating NULL,
    // which is what the process record's four-bit argc field holds.
    // Eight was one short of `taskset -c 1 /bin/httpd -f -p 8080 -h /`.
    for index: usize in 0..<16 {
        let entry_offset: usize = index * 8;
        let entry_address: usize = match checked_add_usize(
            argv_address, entry_offset) {
            CheckedUsize::Overflow => { return SyscallExecveResult::Refused(LINUX_EFAULT); }
            CheckedUsize::Value(v) => { v }
        };
        match user_range_check_read(current_authority, entry_address, 8) {
            UserReadRangeResult::Fault => { return SyscallExecveResult::Refused(LINUX_EFAULT); }
            UserReadRangeResult::Ok(range) => {
                let (ok, string_address) = user_read_u64(range, 0);
                if (ok == false) { return SyscallExecveResult::Refused(LINUX_EFAULT); }
                if (string_address == 0) {
                    vector_terminated = true;
                } else {
                    let argument_name: []u8 = match kernel_syscall_path_name(slot, current_authority,
                        string_address as usize) {
                        SyscallPathResult::Fault => {
                            return SyscallExecveResult::Refused(LINUX_EFAULT);
                        }
                        SyscallPathResult::Invalid => {
                            return SyscallExecveResult::Refused(LINUX_E2BIG);
                        }
                        SyscallPathResult::Name(path) => { path }
                    };
                    let mut string_length: usize = argument_name.len;
                    if (path_view[0] == 0x2F) {
                        string_length = string_length + 1;
                    }
                    // Linux's script binfmt drops the caller's own
                    // argv[0] and puts the script pathname in its place,
                    // already appended above. Keeping both would shift
                    // every argument the interpreter sees by one.
                    let caller_argv0_replaced: bool =
                        index == 0 && script_argc != 0;
                    if (caller_argv0_replaced == false) {
                        match checked_add_usize(output_offset,
                            string_length + 1) {
                            CheckedUsize::Overflow => {
                                return SyscallExecveResult::Refused(LINUX_E2BIG);
                            }
                            CheckedUsize::Value(end) => {
                                if (end > PROCESS_EXEC_ARGV_BYTES ||
                                    argc >= PROCESS_EXEC_ARGC_MAX) {
                                    return SyscallExecveResult::Refused(LINUX_E2BIG);
                                }
                                let copy_length: usize = string_length + 1;
                                let destination_start: usize = output_offset;
                                let exec_argv_view: []u8 =
                                    syscall_exec_argv_here(slot);
                                if (destination_start > exec_argv_view.len) {
                                    return SyscallExecveResult::Refused(LINUX_E2BIG);
                                }
                                let destination_tail = exec_argv_view[
                                destination_start..<exec_argv_view.len];
                                if (copy_length > destination_tail.len) {
                                    return SyscallExecveResult::Refused(LINUX_E2BIG);
                                }
                                let destination =
                                    destination_tail[0..<copy_length];
                                if (copy_length > path_view.len) {
                                    return SyscallExecveResult::Refused(LINUX_E2BIG);
                                }
                                let source = path_view[0..<copy_length];
                                let copied: usize = slice_copy(
                                    destination, source);
                                if (copied != copy_length) {
                                    return SyscallExecveResult::Refused(LINUX_EFAULT);
                                }
                                output_offset = end;
                                argc = argc + 1;
                            }
                        }
                    }
                }
            }
        }
        if (vector_terminated) { break; }
    }
    if (vector_terminated == false) { return SyscallExecveResult::Refused(LINUX_E2BIG); }
    if (argc == 0 || path_length == 0) {
        return SyscallExecveResult::Refused(LINUX_EINVAL);
    }
    // Keep the path validation explicit even though this first image
    // registry currently contains one static BusyBox ELF.
    if (exec_path_absolute == false) { return SyscallExecveResult::Refused(LINUX_ENOENT); }
    if (argc >= 16) { return SyscallExecveResult::Refused(LINUX_EINVAL); }
    let packed_argc: {0..<16 as usize} = argc;
    // GitHub issue #700: the last fallible step, before anything below
    // records the exec as pending. The page leaves in the result (#1080).
    let args_page = match page_alloc(PageOwnerTag::ExecArgs) {
        PageAllocResult::OutOfMemory => {
            return SyscallExecveResult::Refused(LINUX_ENOMEM);
        }
        PageAllocResult::Allocated(page) => { page }
    };
    let diagnostic_argv: []u8 = syscall_exec_argv_here(slot);
    // GitHub issue #618: one critical section, so a procfs snapshot on
    // another CPU copies the old command line or the new one, never
    // half of each.
    let exec_guard = process_run_lock();
    scheduled_process_set_command_line(exec_guard,
        kernel_syscall_process_slot(),
        diagnostic_argv, output_offset);
    scheduled_process_set_exec_argc(exec_guard,
        kernel_syscall_process_slot(), packed_argc);
    syscall_exec_inode_store(exec_guard, exec_inode);
    scheduled_process_set_exec_pending(exec_guard,
        kernel_syscall_process_slot(), true);
    process_run_unlock(exec_guard);
    return SyscallExecveResult::ChildExec(args_page);
}

// Borrow current through the mprotect operation; ownership stays at dispatch.
private inline fn syscall_mprotect_current(
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    let addr: usize = x0;
    let len: usize = x1;
    let prot: usize = x2;
    if (addr % PAGE_SIZE != 0 || len == 0) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    let (span_ok, first, last) = user_range_l3_span(addr, len);
    if (span_ok == false) {
        return SyscallAction::Resume(LINUX_EINVAL);
    }
    // GitHub issue #1151: an untouched mmap page has no PTE to change yet.
    if (mmap_region_populate(kernel_process_current_root(current_authority), addr, len) == false) {
        return SyscallAction::Resume(LINUX_ENOMEM);
    }
    let class: usize = user_page_class_at(kernel_process_current_root(current_authority), first);
    let mut index: usize = first;
    while (index <= last) {
        if (index >= USER_SPACE_PAGE_COUNT ||
            user_page_class_at(kernel_process_current_root(current_authority), index) != class) {
            return SyscallAction::Resume(LINUX_EINVAL);
        }
        index = index + 1;
    }
    // The only transition this bounded per-page model supports:
    // downgrading a currently read-write data/heap/stack range to
    // read-only+XN. Once downgraded (or if the range is already
    // text/rodata), the page is bit-identical to ELF-loaded rodata, so
    // re-widening permissions is refused rather than risked -- a real
    // error, never false success.
    if (prot == LINUX_PROT_READ && class == 3) {
        user_range_reprotect(kernel_process_current_root(current_authority), first, last, USER_RODATA_R_FLAGS);
        return SyscallAction::Resume(0);
    }
    if (prot == (LINUX_PROT_READ | LINUX_PROT_WRITE) && class == 3) {
        return SyscallAction::Resume(0);
    }
    return SyscallAction::Resume(LINUX_EACCES);
}

// Borrow current through the readv operation; ownership stays at dispatch.
private inline fn syscall_readv_current(
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    let fd: usize = x0;
    let iov_address: usize = x1;
    let raw_iovcnt: usize = x2;
    if (raw_iovcnt == 0) { return SyscallAction::Resume(0); }
    if (raw_iovcnt >= 0 && raw_iovcnt < IOV_MAX) {
        let iovcnt: {0..<IOV_MAX as usize} = raw_iovcnt;
        let array_bytes: usize = match checked_mul_usize(iovcnt, sizeof(Iovec)) {
            CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
            CheckedUsize::Value(v) => { v }
        };
        match user_range_check_read(current_authority, iov_address, array_bytes) {
            UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserReadRangeResult::Ok(array_range) => {
                let mut total: usize = 0;
                for index: usize in 0..<iovcnt {
                    let (base_ok, iov_base) = user_read_u64(
                        array_range,
                        index * sizeof(Iovec) + offsetof(Iovec, iov_base));
                    let (len_ok, iov_len) = user_read_u64(
                        array_range,
                        index * sizeof(Iovec) + offsetof(Iovec, iov_len));
                    if (base_ok == false || len_ok == false) {
                        if (total == 0) { return SyscallAction::Resume(LINUX_EFAULT); }
                        return SyscallAction::Resume(total);
                    }
                    if (iov_len == 0) { continue; }
                    match syscall_read_segment(current_authority,
                        fd, iov_base as usize, iov_len as usize) {
                        SyscallIoResult::Errno(e) => {
                            if (total == 0) { return SyscallAction::Resume(e); }
                            return SyscallAction::Resume(total);
                        }
                        SyscallIoResult::NetWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::NetWait);
                        }
                        SyscallIoResult::UartWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::UartWait);
                        }
                        SyscallIoResult::InterruptWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::InterruptWait);
                        }
                        SyscallIoResult::TerminalWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::TerminalWait);
                        }
                        SyscallIoResult::PipeWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::PipeWait);
                        }
                        SyscallIoResult::PipeBroken => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::PipeBroken);
                        }
                        SyscallIoResult::Transferred(n) => {
                            match checked_add_usize(total, n) {
                                CheckedUsize::Overflow => { return SyscallAction::Resume(total); }
                                CheckedUsize::Value(v) => { total = v; }
                            }
                            // A short read ends the vector, including EOF.
                            if (n < iov_len as usize) { return SyscallAction::Resume(total); }
                        }
                    }
                }
                return SyscallAction::Resume(total);
            }
        }
    }
    return SyscallAction::Resume(LINUX_EINVAL);
}

// Borrow current through the writev operation; ownership stays at dispatch.
private inline fn syscall_writev_current(
        current_authority: borrow ProcessCurrent[process, ProcessState::Running], x0: usize, x1: usize, x2: usize)
        -> SyscallAction !{unsafe} {
    let fd: usize = x0;
    let iov_address: usize = x1;
    let raw_iovcnt: usize = x2;
    if (raw_iovcnt == 0) { return SyscallAction::Resume(0); }
    if (raw_iovcnt >= 0 && raw_iovcnt < IOV_MAX) {
        let iovcnt: {0..<IOV_MAX as usize} = raw_iovcnt;
        let array_bytes: usize = match checked_mul_usize(iovcnt, sizeof(Iovec)) {
            CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
            CheckedUsize::Value(v) => { v }
        };
        match user_range_check_read(current_authority, iov_address, array_bytes) {
            UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserReadRangeResult::Ok(array_range) => {
                let mut total: usize = 0;
                for index: usize in 0..<iovcnt {
                    let (base_ok, iov_base) = user_read_u64(
                        array_range,
                        index * sizeof(Iovec) + offsetof(Iovec, iov_base));
                    let (len_ok, iov_len) = user_read_u64(
                        array_range,
                        index * sizeof(Iovec) + offsetof(Iovec, iov_len));
                    if (base_ok == false || len_ok == false) {
                        if (total == 0) { return SyscallAction::Resume(LINUX_EFAULT); }
                        return SyscallAction::Resume(total);
                    }
                    if (iov_len == 0) { continue; }
                    match syscall_write_segment(current_authority,
                        fd, iov_base as usize, iov_len as usize) {
                        SyscallIoResult::Errno(e) => {
                            if (total == 0) { return SyscallAction::Resume(e); }
                            return SyscallAction::Resume(total);
                        }
                        SyscallIoResult::NetWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::NetWait);
                        }
                        SyscallIoResult::UartWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::UartWait);
                        }
                        SyscallIoResult::InterruptWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::InterruptWait);
                        }
                        SyscallIoResult::TerminalWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::TerminalWait);
                        }
                        SyscallIoResult::PipeWait => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::PipeWait);
                        }
                        SyscallIoResult::PipeBroken => {
                            if (total != 0) { return SyscallAction::Resume(total); }
                            return syscall_io_action(current_authority, SyscallIoResult::PipeBroken);
                        }
                        SyscallIoResult::Transferred(n) => {
                            match checked_add_usize(total, n) {
                                CheckedUsize::Overflow => { return SyscallAction::Resume(total); }
                                CheckedUsize::Value(v) => { total = v; }
                            }
                            // A short segment ends the call: what is left
                            // goes in the caller's next writev.
                            if (n < iov_len as usize) {
                                return SyscallAction::Resume(total);
                            }
                        }
                    }
                }
                return SyscallAction::Resume(total);
            }
        }
    }
    return SyscallAction::Resume(LINUX_EINVAL);
}
