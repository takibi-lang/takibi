               // evidence count and timeout window attached to that logical
               // read rather than counting each handler re-entry as a new
               // userspace operation.
               if (conn.receive_waiting == false) {
                   syscall_test_evidence_record_connected_read();
                   conn.receive_started_at = read_cntpct();
                   conn.receive_waiting = true;
               }
               if (conn.socket_buffer_offset < conn.socket_buffer_length) {
                   conn.receive_waiting = false;
                   let available: usize =
                       conn.socket_buffer_length - conn.socket_buffer_offset;
                   let mut buffered: usize = requested;
                   if (buffered > available) { buffered = available; }
                   let buffered_base: *u8 =
