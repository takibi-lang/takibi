                    }
                    UserWriteRangeResult::Ok(range) => {
                        user_zero_fill(range);
                        user_write_u64(range, 8, inode_number as u64);
                        user_write_u32(range, 16, 0x81A4 as u32);
                        user_write_u32(range, 20, 1);
                        user_write_u64(range, 48,
