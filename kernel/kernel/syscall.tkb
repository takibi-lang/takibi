        // syscall entered on. An in-kernel probe has none, so it is answered
        // before anything is decided; no probe issues execve.
        let entry_frame = match frame {
            MaybeFrame::NoFrame => {
                return syscall_finish_current(MaybeFrame::NoFrame,
                    SyscallAction::Resume(LINUX_ENOSYS), current_authority);
            }
            MaybeFrame::Frame(found) => { found }
        };
        match syscall_execve_current(current_authority, number, x0, x1, x2) {
            SyscallExecveResult::Refused(errno) => {
                return syscall_finish_current(MaybeFrame::Frame(entry_frame),
                    SyscallAction::Resume(errno), current_authority);
            }
            SyscallExecveResult::ChildExec(args_page) => {
                process_current_end(current_authority);
                kernel_syscall_dispatch_child_exec(number, entry_frame,
                                                   args_page);
