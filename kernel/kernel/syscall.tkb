                syscall_ext2_mount,
                lookup_inode,
                path_name) {
            Ext2LookupResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
            Ext2LookupResult::NotFound => { return SyscallAction::Resume(LINUX_ENOENT); }
            Ext2LookupResult::Found(inode_number) => {
                let inode_mode: usize = ext2_inode_mode(
                    syscall_ext2_mount, inode_number);
