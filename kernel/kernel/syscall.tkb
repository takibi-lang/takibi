                    ProcessWaitReason::NetRx, 0);
                return SyscallAction::Block;
            }
            NetworkCapabilityTakeResult::Ready(ready) => {
                match kernel_tcp_accept_step(owner, ready) {
                    KernelTcpAcceptStep::Pending(next) => {
                        // Not finished, and not failed. Give the machine
                        // back and leave the handshake where the next
                        // accept(2) will find it.
