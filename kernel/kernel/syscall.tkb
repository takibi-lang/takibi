use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/mm/user_memory.tkb";
use "kernel/arch/arm64/kernel/user_entry_extern.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/net/socket_capability.tkb";
use "kernel/net/tcp.tkb";
use "kernel/kernel/fd_table.tkb";
use "kernel/kernel/syscall_test_evidence.tkb";
use "kernel/kernel/syscall_test_lifecycle.tkb";

// Current limitations (2026-08-13, issue #295). Keep this list current as
// call sites change; a limitation that goes stale here is worse than
// none. This file is the Linux syscall dispatch/policy layer, so its own
// scope is inherently broad -- `kernel/README.md`'s "Current limits"
// section is the authoritative per-syscall-family list (mmap/mprotect/
// munmap scope, signal delivery, scatter/gather I/O coverage, ppoll
// shape, and more); this note only covers what is specific to THIS
// file's own dispatch mechanics, not every syscall it implements.
// - NOT SYNCHRONIZED, single-core dispatch only -- every syscall handler
//   here assumes it runs to completion on core 0 with no concurrent
//   dispatch from another core.
// - Every fixed-capacity pool a syscall handler here allocates from
//   (process slots, fd table, shared objects, TCP connections, address
//   spaces) is documented once, authoritatively, in
//   `kernel/RESOURCE_LIMITS.md` -- do not re-derive a pool's exhaustion
//   behavior from a single call site here without checking that file
//   first, since the errno mapping at a given call site is meant to
//   match its pool's documented contract exactly (`LINUX_EMFILE` for
//   per-process fd exhaustion, `LINUX_ENFILE` for the global shared-
//   object pool, etc.).
//
const AARCH64_NR_WRITE: usize = 64;
const AARCH64_NR_READV: usize = 65;
const AARCH64_NR_WRITEV: usize = 66;
const AARCH64_NR_PPOLL: usize = 73;
const AARCH64_NR_UNAME: usize = 160;
// GitHub issue #393: the only rlimit syscall this architecture has.
// asm-generic (and therefore arm64) has no getrlimit/setrlimit numbers at
// all, and musl 1.2.6's getrlimit()/setrlimit() go through SYS_prlimit64
// first, so implementing this one implements all of them -- and it is
// what ash's `ulimit -n` reaches.
const AARCH64_NR_PRLIMIT64: usize = 261;
const AARCH64_NR_EXIT: usize = 93;
const AARCH64_NR_EXIT_GROUP: usize = 94;
const AARCH64_NR_CLONE: usize = 220;
const AARCH64_NR_VFORK: usize = 58;
const AARCH64_NR_FORK: usize = 107;
const AARCH64_NR_CLONE3: usize = 435;
const AARCH64_NR_EXECVE: usize = 221;
const AARCH64_NR_EXECVEAT: usize = 281;
const AARCH64_NR_WAIT4: usize = 260;
const AARCH64_NR_FCNTL: usize = 25;
const AARCH64_NR_TAKIBI_UART_RX_WAIT: usize = 451;
const AARCH64_NR_TAKIBI_PARENT_PROGRESS: usize = 452;
const LINUX_EBADF: usize = 0xFFFFFFFFFFFFFFF7;
const LINUX_EFAULT: usize = 0xFFFFFFFFFFFFFFF2;
const LINUX_ENOSYS: usize = 0xFFFFFFFFFFFFFFDA;
const LINUX_ENOENT: usize = 0xFFFFFFFFFFFFFFFE;
const LINUX_EINVAL: usize = 0xFFFFFFFFFFFFFFEA;
const LINUX_EAGAIN: usize = 0xFFFFFFFFFFFFFFF5;
const LINUX_EACCES: usize = 0xFFFFFFFFFFFFFFF3;
const LINUX_ECHILD: usize = 0xFFFFFFFFFFFFFFF6;
// GitHub issue #295: distinct errno for fixed-pool exhaustion, previously
// collapsed into LINUX_EBADF (which real Linux reserves for an actually bad
// descriptor argument) at every fd-allocating syscall handler below.
// EMFILE = this process's own RLIMIT_NOFILE was reached (issue #393);
// ENFILE = the global shared object pool is full. GitHub issue #391 left
// that mapping alone and changed only what "full" means: the pool has no
// capacity constant, so what is reported is the derived system-wide bound
// (Linux's files_stat.max_files) or the page allocator being empty.
const LINUX_EMFILE: usize = 0xFFFFFFFFFFFFFFE8;
const LINUX_ENFILE: usize = 0xFFFFFFFFFFFFFFE9;
// GitHub issue #393: installing a descriptor can need a descriptor block,
// and the page allocator being empty is neither a bad argument nor a
// limit. Linux's own expand_files() returns ENOMEM for it.
const LINUX_ENOMEM: usize = 0xFFFFFFFFFFFFFFF4;
const LINUX_ESRCH: usize = 0xFFFFFFFFFFFFFFFD;
// RLIMIT_NOFILE, and Linux's RLIM64_INFINITY.
const LINUX_RLIMIT_NOFILE: usize = 7;
// Linux's RLIM_NLIMITS (include/uapi/asm-generic/resource.h): the number of
// resources that exist, and therefore the first invalid one.
const LINUX_RLIM_NLIMITS: usize = 16;
const LINUX_RLIM64_INFINITY: usize = 0xFFFFFFFFFFFFFFFF;

// GitHub issue #393: AT_FDCWD, spelled the way userspace passes it -- the
// 32-bit -100 sign-extended into x0. It used to be caught by accident:
// the dirfd paths below tested `x0 < PROCESS_FD_MAX` before treating x0 as
// a directory descriptor, and AT_FDCWD failed that test along with every
// other out-of-range value. With no such range left, "relative to the
// current directory" has to be recognised for what it is, which is also
// what Linux does -- any OTHER value really is a descriptor, and an
// unopened one really is EBADF.
const LINUX_AT_FDCWD: usize = 0xFFFFFFFFFFFFFF9C;
const LINUX_F_DUPFD: usize = 0;
const LINUX_F_SETFD: usize = 2;
const LINUX_F_DUPFD_CLOEXEC: usize = 1030;
const LINUX_WNOHANG: usize = 1;

const LINUX_PROT_READ: usize = 1;
const LINUX_PROT_WRITE: usize = 2;

// Issue #196: ABI-facing layout structs used only for sizeof/offsetof --
// actual field access always goes through user_read_u32/u64/
// user_write_u16/copy_to_user against a scratch buffer or a validated
// UserRange, never a constructed struct value, matching this codebase's
// existing KernelElf64Header pattern (kernel/fs/elf64.tkb).

// struct utsname (aarch64 Linux ABI, <sys/utsname.h>): six 65-byte
// (64 chars + NUL) fields, no padding between them.
const UTSNAME_FIELD_SIZE: usize = 65;
struct packed Utsname {
    sysname: [u8; UTSNAME_FIELD_SIZE];
    nodename: [u8; UTSNAME_FIELD_SIZE];
    release: [u8; UTSNAME_FIELD_SIZE];
    version: [u8; UTSNAME_FIELD_SIZE];
    machine: [u8; UTSNAME_FIELD_SIZE];
    domainname: [u8; UTSNAME_FIELD_SIZE];
}

// struct iovec (aarch64 Linux ABI, <sys/uio.h>).
struct packed Iovec {
    iov_base: usize;
    iov_len: usize;
}

// struct pollfd (aarch64 Linux ABI, <poll.h>).
struct packed Pollfd {
    fd: i32;
    events: i16;
    revents: i16;
}

const POLLIN: usize = 0x0001;
const POLLNVAL: usize = 0x0020;

// Linux's own iovec-count cap (UIO_MAXIOV, include/uapi/linux/uio.h) --
// keeps iovcnt*sizeof(Iovec) far below any real overflow risk even before
// checked_mul_usize is applied, and keeps the per-iovec/pollfd validation
// loop provably bounded for --forbid-trap. Checked as `>= IOV_MAX`
// (rejecting the boundary value itself, not just values above it) so the
// accepted range narrows cleanly to the refined type `{0..<IOV_MAX}`
// with no separate lower-bound proof needed.
const IOV_MAX: usize = 1024;
// This kernel's own cap for pollfd arrays (not a Linux constant), same
// rationale and same off-by-one-avoiding `>=` check.
const POLL_MAX: usize = 1024;

// GitHub issue #409 removed the second name for the descriptor capacity
// from this file; issue #393 removed the capacity. The socket paths here
// range-checked fd values against it and then delegated to
// unified_fd_alloc/unified_socket_lookup; there is no range to check any
// more -- a descriptor is admitted by this process's own RLIMIT_NOFILE and
// validated by whether its block chain holds it, both of which are
// fd_table.tkb's to answer.
//
// The incident that makes a duplicated capacity worth remembering is
// recorded in kernel/RESOURCE_LIMITS.md: this file carried a literal 8
// while the real table was 16, so socket()/accept() reported resource
// exhaustion at fd>=8 while free slots existed -- a wrong refusal rather
// than a compile error, hit by a shell whose first eight descriptors were
// busy. Issue #295 made it a real reference so it could not drift
// numerically, #409 removed the second name, and #393 removed the number
// itself: what is left cannot disagree with anything.

private let mut syscall_ext2_mount: Ext2Mount;
private let mut syscall_ext2_ready: bool;
// A bounded one-block staging area, not a whole-file cache. ext2 reads fill
// it one block at a time and read(2)/readv(2)/sendfile(2) stream each chunk
// onward, so its size does not limit the file size userspace can consume.
private let mut syscall_file_buffer: [u8; KERNEL_BLOCK_SIZE];
private let mut syscall_path_buffer: [u8; 256];
private let mut syscall_sockaddr_buffer: [u8; 28];
// GitHub issue #257: connection_open, socket_buffer_length/_offset and
// inetd_response_length used to be four more [T; TCP_CONNECTION_MAX]
// arrays here (step 2), and syscall_socket_buffer/syscall_inetd_response
// two more, at 1460 bytes per connection each (step 4b). All six are gone.
// The scalars are fields of kernel/net/tcp.tkb's TcpConnection; the two
// buffers are pooled NetFrames owned there, reached through
// tcp_connection_rx_slice()/tcp_connection_inetd_slice(). **No storage in
// this file is keyed by a connection index any more.** TCP_CONNECTION_MAX
// itself still appears, as the refinement on slot values passed across the
// tcp.tkb boundary ({0..<TCP_CONNECTION_MAX as usize}) and the loops that
// reset every connection -- proofs about an index, not the size of
// anything here. Those go when step 5 makes a connection's identity an
// address.
private let mut syscall_inetd_mode: bool;

// Issue #196: scratch buffer for uname(2)'s struct utsname reply, sized
// with headroom over sizeof(Utsname) (390 bytes) since array declarations
// can't use sizeof(...) directly (SPEC.md).
private let mut syscall_uname_buffer: [u8; 512];
// GitHub issue #393: scratch for prlimit64(2)'s two struct rlimit64
// values, the same shape as the uname and sockaddr buffers above -- user
// memory is never read or written in place.
private let mut syscall_rlimit_buffer: [u8; 16];

// struct rlimit64 is two little-endian u64s. Written a byte at a time
// rather than through a pointer cast onto the buffer: the cast would be
// unsafe (issue #316) and would assume an alignment a u8 array does not
// promise, and this is called twice per prlimit64 call.
private fn syscall_rlimit_store(field: borrow [u8; 8..], value: usize) {
    for i: usize in 0..<8 {
        field[i] = ((value >> (i * 8)) & 0xFF) as u8;
    }
}

private fn syscall_rlimit_load(field: borrow [u8; 8..]) -> usize {
    let mut value: usize = 0;
    for i: usize in 0..<8 {
        value = value | ((field[i] as usize) << (i * 8));
    }
    return value;
}

must_use variant KernelInetdAcceptResult { TimedOut; Accepted; }

// GitHub issue #392: CloneFileState and UartBlockDelivery, and the two
// `[T; KERNEL_PROCESS_MAX]` arrays that held them, are gone from this
// file. Both were keyed by process slot, which is a key that stops
// existing when the process table becomes a pool; the values are fields
// of ProcessRecord now, reached through
// scheduled_process_clone_file_state()/_uart_block_delivery() and their
// setters. Every decision made with them is still made here.
private let mut syscall_exec_pending: bool;
private let mut syscall_exec_argc: usize;
private let mut syscall_exec_argv: [u8; 512];
private let mut syscall_exec_path: [u8; 256];

must_use variant SyscallPathResult { Fault; Invalid; Name([]u8); }

fn kernel_syscall_daemon_start() {
    // Reinitialize only reusable TCP/socket scratch state; unlike
    // kernel_syscall_process_configure(), this must not clear the parent
    // shell's descriptors or the HTTPD child's clone-reap record. Interactive
    // HTTPd uses this same handoff, but does not opt into the bounded test
    // lifecycle below.
    // GitHub issue #257 step 5: the per-connection reset loop that stood
    // here is gone with the connections it walked. A connection exists only
    // while it is allocated, and tcp_connection_pool_init drains every one
    // -- there is no fixed set of slots left to put back into a clean
    // state.
    tcp_connection_pool_init();
    syscall_inetd_mode = false;
    syscall_test_lifecycle_daemon_reset();
}

fn kernel_syscall_exec_pending() -> bool { return syscall_exec_pending; }
fn kernel_syscall_exec_argc() -> usize { return syscall_exec_argc; }
fn kernel_syscall_exec_argv() -> []u8 { return syscall_exec_argv as []u8; }
fn kernel_syscall_exec_clear() { syscall_exec_pending = false; }

// execve's pathname is distinct from argv[0]. Preserve it for generic image
// source selection; userspace remains free to choose a different argv[0].
fn kernel_syscall_exec_path_matches(name: []u8) -> bool !{unsafe} {
    let path: []u8 = syscall_exec_path as []u8;
    if (name.len > path.len) { return false; }
    let mut index: usize = 0;
    for byte in name {
        if (byte == 0) { return true; }
        if (index < 256) {
            let bounded: {0..<256 as usize} = index;
            if (path[bounded] != byte) { return false; }
        } else {
            return false;
        }
        index = index + 1;
    }
    return true;
}

must_use variant KernelFdReapResult { Failed; Reaped; }
must_use variant KernelDaemonTeardownResult { Invalid; Reclaimed; }
// GitHub issue #257 step 5: the payload was
// `{0..<TCP_CONNECTION_MAX as usize}` -- a proof that the value indexed a
// real element of an array that no longer exists. It is a pool ADDRESS
// now, and plain `usize` is the honest type for one: what used to be a
// bounds proof is intrusive_pool_matches, which the take path performs on
// every use and which also catches the case a bounds proof never could,
// an address that is in range but names a connection that has since
// closed.
must_use variant KernelConnectionLookupResult {
    Missing;
    Found(usize);
}
// GitHub issue #393: plain usize. A descriptor number is bounded by the
// process's own RLIMIT_NOFILE, a runtime value, so there is no
// compile-time range to state -- the same trade the connection lookup
// above already made for a pool address.
must_use variant KernelSocketFdAllocResult {
    Full;
    Allocated(usize);
}
must_use variant KernelListenerLookupResult {
    Missing;
    Found(usize);
}

// GitHub issue #245: fd-table process slot == process.tkb's own
// ProcessHandle.pool_index (same convention as the address-space root),
// so this is now a direct pass-through instead of a binary pid==2?1:0.
fn kernel_syscall_process_slot() -> usize {
    return address_space_root_slot(kernel_process_current_root());
}

fn kernel_syscall_file_lookup(fd: usize) -> UnifiedFileResult {
    return unified_file_lookup(kernel_syscall_process_slot(), fd);
}

fn kernel_syscall_directory_is_open(fd: usize) -> bool {
    match unified_directory_lookup(kernel_syscall_process_slot(), fd) {
        UnifiedDirectoryResult::Missing => { return false; }
        UnifiedDirectoryResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_directory_inode(fd: usize) -> usize {
    match unified_directory_lookup(kernel_syscall_process_slot(), fd) {
        UnifiedDirectoryResult::Missing => { return 0; }
        UnifiedDirectoryResult::Found(handle) => {
            return unified_directory_inode(handle);
        }
    }
}

fn kernel_syscall_file_is_open(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_terminal_is_open(fd: usize) -> bool {
    return unified_terminal_is_open(kernel_syscall_process_slot(), fd);
}

fn kernel_syscall_file_readable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_readable(handle);
        }
    }
}

fn kernel_syscall_file_writable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_writable(handle);
        }
    }
}

fn kernel_syscall_file_inode(fd: usize) -> usize {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return 0; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_inode(handle);
        }
    }
}

fn kernel_syscall_file_offset(fd: usize) -> usize {
    match unified_fd_offset(kernel_syscall_process_slot(), fd) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_file_set_offset(fd: usize, value: usize) -> bool {
    match unified_fd_set_offset(kernel_syscall_process_slot(), fd, value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

// GitHub issue #393: over the descriptors this process has, rather than
// over every number below a constant.
fn kernel_syscall_any_file_is_open() -> bool !{unsafe} {
    let mut from: usize = 0;
    let mut scanning: bool = true;
    while (scanning) {
        scanning = false;
        match unified_fd_next_open(kernel_syscall_process_slot(), from) {
            UnifiedFdScanResult::Done => {}
            UnifiedFdScanResult::Found(fd) => {
                if (kernel_syscall_file_is_open(fd)) { return true; }
                from = fd + 1;
                scanning = true;
            }
        }
    }
    return false;
}

// This process's own soft RLIMIT_NOFILE, for the exhaustion log lines that
// used to print the constant. Reporting the limit that actually refused
// the call is the point: two processes can now be refused at different
// numbers.
fn kernel_syscall_fd_limit_soft() -> usize !{unsafe} {
    match unified_process_fd_limit(kernel_syscall_process_slot()) {
        UnifiedFdLimitResult::Missing => { return 0; }
        UnifiedFdLimitResult::Found(pair) => {
            let (soft, hard) = pair;
            return soft;
        }
    }
}

fn kernel_syscall_heap_break() -> usize {
    match unified_process_heap_break(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_set(value: usize) -> bool {
    match unified_process_heap_configure(kernel_syscall_process_slot(), value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

fn kernel_syscall_heap_start() -> usize {
    match unified_process_heap_start(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_limit() -> usize {
    match unified_process_heap_limit(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

// Exec replaces only the calling process's image. Its brk/mmap arena must
// therefore be replaced in the same FD-context slot without resetting the
// parent shell's descriptors or global TCP state.
fn kernel_syscall_process_configure_current(
        heap_start: usize, heap_limit: usize) {
    match unified_process_heap_range_configure(
            kernel_syscall_process_slot(), heap_start, heap_limit) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

fn kernel_syscall_process_configure(heap_start: usize, heap_limit: usize)
        !{unsafe} {
    unified_fd_context_pool_init();
    unified_fd_table_init();
    // GitHub issue #392: process slot 0 is the bootstrap, which this
    // kernel sets up directly rather than through
    // scheduled_process_alloc -- so it is the one process that does not
    // get an fd context from the allocation path, and has to be given one
    // here. It got one for free while contexts were an array with an entry
    // per slot whether or not a process occupied it.
    if (unified_fd_context_ensure(0) == false) {
        kernel_boot_log_resource_exhausted(
            "physical page allocator" as *u8, BOOT_PAGE_COUNT);
    }
    if (process_image_record_ensure(0) == false) {
        kernel_boot_log_resource_exhausted(
            "physical page allocator" as *u8, BOOT_PAGE_COUNT);
    }
    match unified_terminal_stdio_open(0) {
        UnifiedOpenResult::Invalid => {}
        UnifiedOpenResult::Full => {
            kernel_boot_log_resource_exhausted(
                "shared object pool" as *u8, unified_object_max_files());
        }
        UnifiedOpenResult::Ok => {}
    }
    match unified_process_heap_range_configure(0, heap_start, heap_limit) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
    syscall_test_evidence_reset_file_counters();
    syscall_test_evidence_reset_read_uart_waits();
    syscall_exec_pending = false;
    syscall_exec_argc = 0;
    syscall_test_lifecycle_persistent_shell_clear();
    scheduled_process_reset_syscall_state_everywhere();
    for path_index: usize in 0..<256 { syscall_exec_path[path_index] = 0; }
    tcp_connection_pool_init();
    syscall_test_evidence_reset_socket_counters();
    syscall_inetd_mode = false;
    // Both of this file's per-process values are cleared above, in one
    // walk over the live processes -- configure is a whole-world reset and
    // can run while processes already exist, so it does not rely on
    // scheduled_process_alloc's own per-process reset.
}

// GitHub issue #245: parent/child slots used to be the literal 0/1 (the
// only two the old model could ever produce); child_slot is now whatever
// pool_index kernel_process_clone_begin() actually allocated, passed in
// by the caller once it knows it (see the CLONE syscall handler below,
// which now calls kernel_process_clone_begin() first for exactly this).
fn kernel_syscall_clone_files_begin(parent_slot: usize, child_slot: usize)
        -> UnifiedFdResult {
    if (scheduled_process_slot_valid(child_slot)) {
        match unified_fd_clone(parent_slot, child_slot) {
            UnifiedFdResult::Invalid => {
                let mut failed: CloneFileState = { false, syscall_inetd_mode };
                scheduled_process_set_clone_file_state(child_slot, failed);
                return UnifiedFdResult::Invalid;
            }
            UnifiedFdResult::Ok => {}
        }
        let mut cloned: CloneFileState = { true, syscall_inetd_mode };
        scheduled_process_set_clone_file_state(child_slot, cloned);
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn kernel_connected_fd_is_open(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => { return true; }
    }
}

fn kernel_connected_fd_clear(fd: usize) {
    match unified_fd_close(kernel_syscall_process_slot(), fd) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

fn kernel_connection_fd_lookup(fd: usize) -> KernelConnectionLookupResult {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
          // No range test: an address is not in a range, and the check
          // that replaced one runs where the address is USED (see this
          // variant's own comment).
          return KernelConnectionLookupResult::Found(
              unified_connection_slot(handle));
        }
    }
    return KernelConnectionLookupResult::Missing;
}

fn kernel_socket_fd_alloc(first: usize) -> KernelSocketFdAllocResult !{unsafe} {
    match unified_fd_alloc(kernel_syscall_process_slot(), first) {
        UnifiedFdAllocResult::Full => { return KernelSocketFdAllocResult::Full; }
        UnifiedFdAllocResult::Allocated(fd) => {
            return KernelSocketFdAllocResult::Allocated(fd);
        }
    }
}

fn kernel_listener_fd_lookup(fd: usize) -> KernelListenerLookupResult !{unsafe} {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Listener) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
            return KernelListenerLookupResult::Found(fd);
        }
    }
    return KernelListenerLookupResult::Missing;
}

fn kernel_listener_handle(fd: usize) -> UnifiedSocketResult {
    return unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                 UnifiedFdKind::Listener);
}

fn kernel_listener_state(fd: usize) -> UnifiedListenerState {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => {
            return UnifiedListenerState::Closed;
        }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_state(handle);
        }
    }
}

fn kernel_listener_set_state(fd: usize, state: UnifiedListenerState) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_state(handle, state) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_listener_port(fd: usize) -> u16 {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_port(handle);
        }
    }
}

fn kernel_listener_set_port(fd: usize, port: u16) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_port(handle, port) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_connected_fd_duplicate(old_fd: usize, new_fd: usize) -> bool !{unsafe} {
    match unified_fd_duplicate(kernel_syscall_process_slot(), old_fd,
                               new_fd) {
        UnifiedFdInstallResult::Invalid => { return false; }
        UnifiedFdInstallResult::RefOverflow => { return false; }
        UnifiedFdInstallResult::NoMemory => { return false; }
        UnifiedFdInstallResult::Ok => { return true; }
    }
}

// Keep ordinary file/terminal descriptor duplication separate from connected
// socket ownership. dup3 uses this path when replacing a standard descriptor
// with another non-socket object.
fn kernel_regular_fd_duplicate(old_fd: usize, new_fd: usize) -> bool {
    if ((kernel_syscall_terminal_is_open(old_fd) == false &&
         kernel_syscall_file_is_open(old_fd) == false &&
         kernel_syscall_directory_is_open(old_fd) == false)) {
        return false;
    }
    if (old_fd == new_fd) { return true; }
    if (kernel_syscall_terminal_is_open(new_fd) ||
        kernel_syscall_file_is_open(new_fd) ||
        kernel_syscall_directory_is_open(new_fd)) {
        match unified_fd_close(kernel_syscall_process_slot(), new_fd) {
            UnifiedFdResult::Invalid => { return false; }
            UnifiedFdResult::Ok => {}
        }
    }
    match unified_fd_duplicate(kernel_syscall_process_slot(), old_fd, new_fd) {
        UnifiedFdInstallResult::Invalid => { return false; }
        UnifiedFdInstallResult::RefOverflow => { return false; }
        UnifiedFdInstallResult::NoMemory => { return false; }
        UnifiedFdInstallResult::Ok => { return true; }
    }
}

fn kernel_connection_fd_identity(fd: usize) -> usize {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_connection_generation(handle);
        }
    }
    return 0;
}

fn kernel_connected_transport_release(slot: usize, generation: usize)
        -> bool {
    match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => { return false; }
        TcpConnectionTakeResult::Ready(owner) => {
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    tcp_connection_put(owner);
                    return false;
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    match kernel_tcp_close_stream(owner, ready) {
                        KernelTcpCloseResult::Closed(after_close) => {
                            match network_capability_put(after_close) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return false;
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_free(owner);
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn kernel_connected_descriptor_release(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
      UnifiedSocketResult::Missing => { return false; }
      UnifiedSocketResult::Found(handle) => {
          let slot: usize = unified_connection_slot(handle);
          let generation: usize = unified_connection_generation(handle);
          let references: usize = unified_object_references(handle);
          {
              if (references == 0) { return false; }
              if (references == 1 && tcp_connection_open_at(slot)) {
                  // GitHub issue #257 step 5: `connection_open = false`
                  // used to be written here, into an array element that
                  // outlived the connection. It cannot be written now,
                  // because on success there is no connection left to
                  // write it to -- kernel_connected_transport_release
                  // frees it, and tcp_connection_free clears the flag on
                  // its way out for exactly the readers that used to need
                  // this line.
                  return kernel_connected_transport_release(slot, generation);
              }
              return true;
          }
          return false;
      }
    }
}

// Only ever called from the EXIT handler, while the exiting child is
// still the current process -- so its own fd-table slot is exactly what
// kernel_syscall_process_slot() reports here, and is the slot whose
// CloneFileState this reaps.
fn kernel_syscall_clone_files_reap() -> KernelFdReapResult {
    let child_slot: usize = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(child_slot)) {
        let mut state: CloneFileState =
            scheduled_process_clone_file_state(child_slot);
        if (state.file_state_live == false) {
            return KernelFdReapResult::Failed;
        }
        // GitHub issue #393: over the child's own descriptors. Clearing
        // one removes it from the scan, so the walk restarts after the fd
        // just cleared rather than from 0.
        let mut from: usize = 0;
        let mut scanning: bool = true;
        while (scanning) {
            scanning = false;
            match unified_fd_next_open(child_slot, from) {
                UnifiedFdScanResult::Done => {}
                UnifiedFdScanResult::Found(fd) => {
                    if (kernel_connected_fd_is_open(fd)) {
                        if (kernel_connected_descriptor_release(fd) == false) {
                            return KernelFdReapResult::Failed;
                        }
                        kernel_connected_fd_clear(fd);
                    }
                    from = fd + 1;
                    scanning = true;
                }
            }
        }
        match unified_fd_destroy(child_slot) {
            UnifiedFdResult::Invalid => { return KernelFdReapResult::Failed; }
            UnifiedFdResult::Ok => {}
        }
        syscall_inetd_mode = state.parent_inetd_mode;
        let mut reaped: CloneFileState = { false, state.parent_inetd_mode };
        scheduled_process_set_clone_file_state(child_slot, reaped);
        return KernelFdReapResult::Reaped;
    }
    return KernelFdReapResult::Failed;
}

fn kernel_syscall_daemon_teardown() -> KernelDaemonTeardownResult {
    if (kernel_listener_state(4) != UnifiedListenerState::Listening ||
        kernel_syscall_any_file_is_open()) {
        return KernelDaemonTeardownResult::Invalid;
    }
    if (tcp_any_connection_open()) {
        return KernelDaemonTeardownResult::Invalid;
    }
    match unified_fd_close(kernel_syscall_process_slot(), 4) {
        UnifiedFdResult::Invalid => {
            return KernelDaemonTeardownResult::Invalid;
        }
        UnifiedFdResult::Ok => {}
    }
    syscall_test_evidence_record_socket_close();
    return KernelDaemonTeardownResult::Reclaimed;
}

fn kernel_syscall_inetd_accept(port: u16)
        -> KernelInetdAcceptResult !{may_block} {
    match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            kernel_boot_log_resource_exhausted(
                "TCP connection pool" as *u8, 0);
            return KernelInetdAcceptResult::TimedOut;
        }
        TcpConnectionAllocResult::Allocated(owner) => {
            let slot: usize = tcp_connection_slot(owner);
            let generation: usize = tcp_connection_identity(owner);
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    tcp_connection_free(owner);
                    return KernelInetdAcceptResult::TimedOut;
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    match kernel_tcp_accept_once(owner, ready, port) {
                        KernelTcpAcceptResult::TimedOut(next) => {
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Stored => { }
                                NetworkCapabilityPutResult::Conflict => { }
                            }
                            tcp_connection_free(owner);
                            return KernelInetdAcceptResult::TimedOut;
                        }
                        KernelTcpAcceptResult::Accepted(next) => {
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return KernelInetdAcceptResult::TimedOut;
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    // GitHub issue #257 step 5: the
                                    // Conflict arm that stood here
                                    // described the parking lot already
                                    // holding an owner for this slot, and
                                    // there is no parking lot. The
                                    // `slot >= TCP_CONNECTION_MAX` guard
                                    // it wrapped is gone too, and not
                                    // silently: what bounded the slot was
                                    // the array it indexed, and what
                                    // validates the address that replaced
                                    // it is the pool, on every use.
                                    tcp_connection_put(owner);
                                        syscall_inetd_mode = true;
                                        tcp_connection_payload(slot).connection_open = true;
                                        match unified_connection_create(
                                                kernel_syscall_process_slot(),
                                                0, slot, generation) {
                                            UnifiedOpenResult::Invalid => {
                                                return KernelInetdAcceptResult::TimedOut;
                                            }
                                            UnifiedOpenResult::Full => {
                                                kernel_boot_log_resource_exhausted(
                                                    "shared object pool" as *u8,
                                                    unified_object_max_files());
                                                return KernelInetdAcceptResult::TimedOut;
                                            }
                                            UnifiedOpenResult::Ok => {}
                                        }
                                        match unified_fd_duplicate(
                                                kernel_syscall_process_slot(),
                                                0, 1) {
                                            UnifiedFdInstallResult::Invalid => {
                                                return KernelInetdAcceptResult::TimedOut;
                                            }
                                            UnifiedFdInstallResult::RefOverflow => {
                                                return KernelInetdAcceptResult::TimedOut;
                                            }
                                            UnifiedFdInstallResult::NoMemory => {
                                                return KernelInetdAcceptResult::TimedOut;
                                            }
                                            UnifiedFdInstallResult::Ok => {}
                                        }
                                        tcp_connection_payload(slot).socket_buffer_length = 0;
                                        tcp_connection_payload(slot).socket_buffer_offset = 0;
                                        tcp_connection_payload(slot).inetd_response_length = 0;
                                        return KernelInetdAcceptResult::Accepted;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn kernel_syscall_ext2_configure(mount: Ext2Mount) {
    syscall_ext2_mount = mount;
    syscall_ext2_ready = true;
    syscall_test_evidence_reset_file_counters();
}

fn kernel_syscall_file_evidence()
        -> (usize, usize, usize, usize) {
    return syscall_test_evidence_file_counts();
}

// GitHub issue #257 step 5: this used to assert on connection slots 0 and
// 1 by hand -- a test that enumerated the capacity, which was defensible
// only while the capacity was 2. What it was actually checking is that no
// connection is left open, which is now one question rather than a list.
fn kernel_syscall_socket_evidence() -> bool !{unsafe} {
    return syscall_test_evidence_socket_calls() == 1 &&
           syscall_test_evidence_bind_calls() == 1 &&
           syscall_test_evidence_listen_calls() == 1 &&
           syscall_test_evidence_accept_calls() == 2 &&
           syscall_test_evidence_accept_capability_roundtrips() == 2 &&
           tcp_any_connection_open() == false &&
           kernel_connected_fd_is_open(0) == false &&
           kernel_connected_fd_is_open(1) == false &&
           kernel_connected_fd_is_open(5) == false &&
           kernel_connected_fd_is_open(6) == false &&
           syscall_test_evidence_connected_close_calls() == 2 &&
           syscall_test_evidence_connected_read_calls() == 3 &&
           syscall_test_evidence_connected_write_calls() == 4 &&
           syscall_test_evidence_socket_close_calls() == 1 &&
           kernel_listener_state(4) == UnifiedListenerState::Closed;
}

fn kernel_syscall_partial_write_evidence() -> bool {
    return syscall_test_evidence_partial_write_observed();
}

// Copy one NUL-terminated pathname through the user-memory boundary. Only a
// single root component is supported by this first generic lookup slice;
// directory traversal and symlink resolution remain separate work.
fn kernel_syscall_path_name(address: usize) -> SyscallPathResult {
    let path_view: []u8 = syscall_path_buffer as []u8;
    let mut length: usize = 0;
    let mut terminated: bool = false;
    for offset: usize in 0..<255 {
        if (terminated == false) {
            let current: usize = match checked_add_usize(address, offset) {
                CheckedUsize::Overflow => { return SyscallPathResult::Fault; }
                CheckedUsize::Value(v) => { v }
            };
            match user_range_check_read(kernel_process_current_root(), current, 1) {
                UserReadRangeResult::Fault => { return SyscallPathResult::Fault; }
                UserReadRangeResult::Ok(range) => {
                    if (copy_from_user(range, path_view[offset..<offset + 1]) == false) {
                        return SyscallPathResult::Fault;
                    }
                }
            }
            if (path_view[offset] == 0) {
                length = offset;
                terminated = true;
            }
        }
    }
    if (terminated == false || length == 0) {
        return SyscallPathResult::Invalid;
    }
    let path_length: usize = length;
    if (path_length > path_view.len) {
        return SyscallPathResult::Invalid;
    }
    let full_path = path_view[0..<path_length];
    if (path_length == 1 && path_view[0] == 0x2F) {
        path_view[0] = 0x2E;
    }
    if (path_view[0] == 0x2F) {
        if (full_path.len < 2) {
            return SyscallPathResult::Invalid;
        }
        return SyscallPathResult::Name(full_path[1..<full_path.len]);
    }
    return SyscallPathResult::Name(full_path);
}

// Issue #196: writev(2)/readv(2) per-segment results, kept distinct from
// the underlying byte count instead of encoding "this is actually an
// errno" via a magnitude heuristic (Linux -errno values happen to be
// huge as unsigned usize, which would work, but a discriminated variant
// makes the distinction a type-level fact instead of a convention every
// call site has to remember).
must_use variant WriteSegmentResult { Errno(usize); Written(usize); }
must_use variant ReadSegmentResult { Errno(usize); Read(usize); }

// Single-segment write, fd 1/2 (raw UART) only. Deliberately NOT shared
// with write(64)'s own handler below (which also supports connected TCP
// fds, descriptor duplication, and ext2 files) -- extracting
// that already-proven-working, TCP-timing-sensitive code into a shared
// helper was judged more regression risk than this issue's actual
// traced scenarios (uname -a's writev to stdout) need. Broadening
// writev/readv to the other fd kinds is natural follow-up work, not
// done here.
fn syscall_writev_segment(fd: usize, address: usize, length: usize)
        -> WriteSegmentResult {
    if (kernel_syscall_terminal_is_open(fd) == false) {
        return WriteSegmentResult::Errno(LINUX_EBADF);
    }
    if (length == 0) { return WriteSegmentResult::Written(0); }
    match user_range_check_read(kernel_process_current_root(), address, length) {
        UserReadRangeResult::Fault => {
            return WriteSegmentResult::Errno(LINUX_EFAULT);
        }
        UserReadRangeResult::Ok(range) => {
            let mut remaining: usize = length;
            let mut offset: usize = 0;
            while (remaining != 0) {
                uart_putc(user_read_byte(range, offset));
                offset = offset + 1;
                remaining = remaining - 1;
            }
        }
    }
    return WriteSegmentResult::Written(length);
}

// Single-segment read from any open ext2 file descriptor.
fn syscall_readv_segment(fd: usize, address: usize, length: usize)
        -> ReadSegmentResult !{unsafe} {
    if (kernel_syscall_file_is_open(fd) == false ||
            kernel_syscall_file_readable(fd) == false) {
        return ReadSegmentResult::Errno(LINUX_EBADF);
    }
    let mut copied: usize = 0;
    while (copied < length) {
        let mut chunk_limit: usize = length - copied;
        if (chunk_limit > KERNEL_BLOCK_SIZE) {
            chunk_limit = KERNEL_BLOCK_SIZE;
        }
        let staging_buffer = syscall_file_buffer as []u8;
        if (chunk_limit > staging_buffer.len) {
            return ReadSegmentResult::Errno(LINUX_EINVAL);
        }
        let staging = staging_buffer[0..<chunk_limit];
        match ext2_read_file_chunk(
                syscall_ext2_mount, kernel_syscall_file_inode(fd),
                kernel_syscall_file_offset(fd),
                staging) {
            Ext2ReadResult::Invalid => {
                if (copied != 0) { return ReadSegmentResult::Read(copied); }
                return ReadSegmentResult::Errno(LINUX_EINVAL);
            }
            Ext2ReadResult::Read(chunk) => {
                if (chunk == 0) { break; }
                let target_address: usize = match checked_add_usize(address, copied) {
                    CheckedUsize::Overflow => {
                        if (copied != 0) { return ReadSegmentResult::Read(copied); }
                        return ReadSegmentResult::Errno(LINUX_EFAULT);
                    }
                    CheckedUsize::Value(value) => { value }
                };
                match user_range_check_write(kernel_process_current_root(),
                                       target_address, chunk) {
                    UserWriteRangeResult::Fault => {
                        if (copied != 0) { return ReadSegmentResult::Read(copied); }
                        return ReadSegmentResult::Errno(LINUX_EFAULT);
                    }
                    UserWriteRangeResult::Ok(range) => {
                        let copied_chunk: bool = copy_to_user_raw(
                            range, syscall_file_buffer as *u8, chunk);
                    }
                }
                if (kernel_syscall_file_set_offset(
                        fd, kernel_syscall_file_offset(fd) + chunk) == false) {
                    if (copied != 0) { return ReadSegmentResult::Read(copied); }
                    return ReadSegmentResult::Errno(LINUX_EBADF);
                }
                copied = copied + chunk;
            }
        }
    }
    return ReadSegmentResult::Read(copied);
}

// ppoll(2) readiness for one fd: (is_valid_fd, revents). fd 0 checks the
// real UART RX ring (kernel_uart_rx_pending()). Its concrete BusyBox ash
// form -- one stdin pollfd and a null timeout -- waits on the retained
// interrupt event until the UART RX IRQ publishes a byte. Mixed fd sets and
// finite timeouts remain out of scope for this first real wait path.
// Connected TCP fds
// check already-buffered data read-only (no mutation, so no risk to the
// proven TCP send/receive paths). Everything else is POLLNVAL.
// UART RX ring buffer: moved here from kernel/platform/rpi5/init.tkb (issue #196)
// now that ppoll(2)'s fd==0 readiness check is a second real caller of
// kernel_uart_rx_pending, alongside the existing
// AARCH64_NR_TAKIBI_UART_RX_WAIT dispatch below -- both live in this
// file's kernel_syscall_dispatch. kernel_uart_rx_isr/kernel_uart_rx_getc
// (the actual ISR and consumer) stay in main.tkb, since they need
// kernel_process_uart_wake from kernel/kernel/process.tkb, which this
// file does not otherwise depend on.
let mut kernel_uart_rx_buf: [u8; 64];
let mut kernel_uart_rx_head: io usize;
let mut kernel_uart_rx_tail: io usize;
fn kernel_uart_rx_ring_reset() {
    kernel_uart_rx_head = 0;
    kernel_uart_rx_tail = 0;
}

fn kernel_uart_rx_pending() -> bool {
    return kernel_uart_rx_tail != kernel_uart_rx_head;
}

fn syscall_poll_fd_ready(fd: usize) -> (bool, usize) {
    if (fd == 0 && kernel_syscall_terminal_is_open(fd)) {
        if (kernel_uart_rx_pending()) { return (true, POLLIN); }
        return (true, 0);
    }
    if (kernel_connected_fd_is_open(fd)) {
        match kernel_connection_fd_lookup(fd) {
            KernelConnectionLookupResult::Missing => {
                return (false, POLLNVAL);
            }
            KernelConnectionLookupResult::Found(slot) => {
                if (tcp_connection_has_pending_read(slot)) {
                    return (true, POLLIN);
                }
                return (true, 0);
            }
        }
    }
    if (kernel_syscall_terminal_is_open(fd) ||
        kernel_syscall_file_is_open(fd)) {
        return (true, 0);
    }
    return (false, POLLNVAL);
}

fn syscall_ppoll_dispatch(fds_address: usize, raw_nfds: usize,
                          timeout_address: usize, sigmask_address: usize)
        -> SyscallAction !{unsafe} {
    if (raw_nfds == 0) { return SyscallAction::Resume(0); }
    if (raw_nfds >= 0 && raw_nfds < POLL_MAX) {
      let nfds: {0..<POLL_MAX as usize} = raw_nfds;
      let array_bytes: usize = match checked_mul_usize(nfds, sizeof(Pollfd)) {
        CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
        CheckedUsize::Value(v) => { v }
    };
      match user_range_check_write(kernel_process_current_root(), fds_address, array_bytes) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(array_range) => {
            let mut ready_count: usize = 0;
            let mut uart_wait: bool = false;
            for index: usize in 0..<nfds {
                let (fd_ok, fd_raw) = user_read_u32(
                    user_write_range_as_read(array_range),
                    index * sizeof(Pollfd) + offsetof(Pollfd, fd));
                let (events_ok, events_raw) = user_read_u32(
                    user_write_range_as_read(array_range),
                    index * sizeof(Pollfd) + offsetof(Pollfd, events));
                if (fd_ok == false || events_ok == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                let fd: usize = fd_raw as usize;
                let (valid, revents) = syscall_poll_fd_ready(fd);
                let mut final_revents: usize = revents;
                if (valid == false) { final_revents = POLLNVAL; }
                if (user_write_u16(
                        array_range,
                        index * sizeof(Pollfd) + offsetof(Pollfd, revents),
                        final_revents) == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                if (final_revents != 0) { ready_count = ready_count + 1; }
                if (nfds == 1 && fd == 0 &&
                    (events_raw as usize & POLLIN) != 0) {
                    uart_wait = true;
                }
            }
            if (ready_count == 0 && uart_wait && timeout_address == 0 &&
                sigmask_address == 0) {
                if (syscall_test_evidence_record_ppoll_uart_wait()) {
                    kernel_boot_log("shell ppoll: uart blocked\n");
                }
                return SyscallAction::WaitUart;
            }
            return SyscallAction::Resume(ready_count);
        }
      }
    }
    return SyscallAction::Resume(LINUX_EINVAL);
}

fn syscall_read_uart(address: usize, requested: usize) -> SyscallAction {
    if (requested == 0) { return SyscallAction::Resume(0); }
    match user_range_check_write(kernel_process_current_root(), address, requested) {
        UserWriteRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserWriteRangeResult::Ok(range) => {
            disable_irq();
            if (kernel_uart_rx_pending() == false) {
                enable_irq();
                if (syscall_test_evidence_record_read_uart_wait()) {
                    if (kernel_syscall_persistent_shell_active()) {
                        kernel_boot_log(
                            "\npersistent shell: uart blocked\n");
                    } else {
                        kernel_boot_log(
                            "\ninteractive shell: uart blocked\n");
                    }
                }
                if (kernel_process_current_has_live_child()) {
                    let process_slot: usize = kernel_syscall_process_slot();
                    if (scheduled_process_slot_valid(process_slot)) {
                        scheduled_process_set_uart_block_delivery(
                            process_slot, UartBlockDelivery::Read);
                        kernel_process_current_set_pending_block(
                            ProcessWaitReason::UartRx, 0);
                        return SyscallAction::Block;
                    }
                }
                return SyscallAction::WaitUart;
            }
            let value: u8 = kernel_uart_rx_getc();
            enable_irq();
            if (user_write_byte(range, 0, value) == false) {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            return SyscallAction::Resume(1);
        }
    }
}

// Issue #196: writes `value` into one fixed 65-byte struct utsname field.
// The field was already zero-filled by the caller (see the uname(2)
// handler below) before any field write, so a value shorter than 65
// bytes leaves real zero padding, not leftover scratch-buffer content
// from a previous uname(2) call.
fn uname_write_field(
        field_view: borrow [u8; UTSNAME_FIELD_SIZE..], value: []u8) {
    let copied: usize = slice_copy(field_view, value);
}

// Mirrors user_entry.S's .Lsyscall_dispatch branch table exactly (action
// numbers 0/1/2/.../8 there correspond one-to-one to the variants below,
// via syscall_action_encode). Kept as a real sum type internally so a
// mistyped numeric action code -- the shape of bug class this file's
// syscall handling cannot otherwise catch at compile time -- is a type
// error instead of a silent wrong branch at the asm boundary. The asm
// side is untouched by this: kernel_syscall_dispatch below still returns
// a plain (usize, usize) register pair, exactly as before.
must_use variant SyscallAction {
    Unreachable;         // 0: esr wasn't a real SVC; asm's own default path
                          //    already fail-stops before this can be selected
    Resume(usize);        // 1: resume EL0 with x0 = value
    Exit(usize);           // 2: parent exit; return status to the EL1 caller
    CloneChild(usize);      // 3: clone succeeded; value = child pid
    CloneParent(usize);      // 4: child exited; value = parent's saved SP
    Block;                    // 5: block this frame on the scheduler
    WaitUart;                  // 6: retry after an uncontended UART wfe
    Exec;                       // 7: parent-only execve pending
    ChildExec;                   // 8: child execve pending
}

fn syscall_action_encode(action: SyscallAction) -> (usize, usize) {
    match action {
        SyscallAction::Unreachable => { return (0, 0); }
        SyscallAction::Resume(value) => { return (1, value); }
        SyscallAction::Exit(value) => { return (2, value); }
        SyscallAction::CloneChild(value) => { return (3, value); }
        SyscallAction::CloneParent(value) => { return (4, value); }
        SyscallAction::Block => { return (5, 0); }
        SyscallAction::WaitUart => { return (6, 0); }
        SyscallAction::Exec => { return (7, 7); }
        SyscallAction::ChildExec => { return (8, 8); }
    }
}

// A process may be ended either by exit(2) itself or by a bounded test
// daemon's completed-work condition.  Both routes must preserve the same
// clone-owned FD/VM teardown and return through the parent frame; returning
// SyscallAction::Exit directly is valid only for the root EL0 process.
fn kernel_syscall_exit_current_process(status: usize) -> SyscallAction {
    if (kernel_process_is_child()) {
        match kernel_syscall_clone_files_reap() {
            KernelFdReapResult::Failed => { return SyscallAction::Unreachable; }
            KernelFdReapResult::Reaped => { }
        }
        if (kernel_process_exec_image_live_for_pid(
                kernel_process_current_pid()) == false) {
            match process_image_clone_vm_reap() {
                ProcessCloneVmReapResult::Missing => {
                    return SyscallAction::Unreachable;
                }
                ProcessCloneVmReapResult::Reaped => { }
            }
        }
        syscall_test_lifecycle_foreground_server_note_reaped_pages(
            process_image_clone_vm_reaped_pages());
        return SyscallAction::CloneParent(kernel_process_child_exit(status));
    }
    return SyscallAction::Exit(status);
}

// The only asm-facing entry point (user_entry.S calls this exact name via
// `bl kernel_syscall_dispatch`); its signature is untouched so this step
// needs no assembly changes. All real logic lives in the SyscallAction-
// returning kernel_syscall_dispatch_action below.
//
// GitHub issue #221: the functions below are user_entry.S's action-tail
// branches, migrated one at a time (each independently hardware-verified)
// from hand-written EXC_CONTEXT_RESTORE/eret assembly into .tkb, ending in
// the single shared el0_context_resume/kernel_syscall_fail_stop primitives
// (kernel/arch/arm64/kernel/user_entry.S) instead of a per-branch copy of
// that sequence.

// GitHub issue #244: completes a blocked wait4() at the moment it is
// woken (called from kernel_process_child_exit()'s own wake-a-blocked-
// parent step, kernel/kernel/process.tkb) -- the mirror of what
// kernel_process_uart_wake() does for the UART blocker with a single
// el0_context_set_x0, except wait4() also needs its x1 status pointer
// (stashed in the blocking parent's own ProcessRecord, see issue #302)
// honored, which a bare scalar injection cannot express. frame_sp is the
// blocked parent's own saved SP -- writing x0 there, not the current
// frame, is exactly what el0_context_set_x0 is for (it takes an arbitrary
// saved context, not "the currently running one").
//
// GitHub issue #248: takes parent_slot explicitly (the blocked parent's
// own pool_index) rather than reading kernel/kernel/process.tkb's
// implicit "current" slot -- this runs from INSIDE
// kernel_process_child_exit(), at the moment execution_current_handle is
// still the EXITING CHILD, not yet switched to the parent being woken
// here. Needed so a multi-level concurrent wait4() chain delivers each
// parent's OWN child's status/pid, not whichever slot happened to be
// "current" (irrelevant here). GitHub issue #302: the status pointer read
// below used to be exactly the shared-global bug #248 fixed for
// reaped_pid/parent_slot -- a second parent blocking in wait4() before the
// first one woke would silently overwrite the first parent's still-pending
// status pointer with its own. scheduled_process_record_wait4_status_ptr
// is keyed by parent_slot the same way reaped_pid/parent_slot already are.
fn kernel_syscall_wait4_deliver(frame_sp: usize, reaped_pid: usize,
                                parent_slot: usize) !{unsafe} {
    let wait4_status_ptr: usize =
        scheduled_process_record_wait4_status_ptr(parent_slot);
    if (wait4_status_ptr != 0) {
        // The status buffer belongs to the PARENT being woken, but this runs
        // while the exiting CHILD is still current (see this function's
        // header comment and kernel_process_child_exit). user_write_u32
        // dereferences the user VA directly, so TTBR0_EL1 has to already
        // name the parent's root -- and user_range_check has to validate
        // against that same root -- before the status is written. Otherwise
        // the write lands in the exiting child's address space, which after
        // that child has execve'd is a completely different set of physical
        // pages, and the woken parent goes on to read whatever uninitialised
        // value its own status variable happened to hold. Only the BLOCKING
        // wait4() path reaches here, which is why the synchronous
        // already-exited path (correct address space, current is the parent)
        // never showed this.
        process_image_activate_root(parent_slot);
        match user_range_check_write(address_space_root_for_slot(parent_slot), wait4_status_ptr, 4) {
            UserWriteRangeResult::Fault => {
                el0_context_set_x0(frame_sp, LINUX_EFAULT);
                return;
            }
            UserWriteRangeResult::Ok(range) => {
                let status: usize =
                    kernel_process_child_wait_status_peek_for(parent_slot);
                if (user_write_u32(range, 0,
                        ((status & 0xFF) << 8) as u32) == false) {
                    el0_context_set_x0(frame_sp, LINUX_EFAULT);
                    return;
                }
            }
        }
    }
    kernel_process_child_wait_status_consume_for(parent_slot);
    el0_context_set_x0(frame_sp, reaped_pid);
}

must_use variant KernelUartDeliveryResult { Consumed; RetryRead; }

// A blocked Linux read(0, buf, ...) must retry its SVC after the IRQ places
// the byte in the kernel UART ring; only the Takibi scalar wait consumes the
// byte directly into x0. Keeping the IRQ path away from user memory also
// preserves its no-unsafe effect contract.
fn kernel_syscall_uart_deliver(frame_sp: usize, process_slot: usize,
                               value: usize)
        -> KernelUartDeliveryResult !{interrupt} {
    if (scheduled_process_slot_valid(process_slot)) {
        match scheduled_process_uart_block_delivery(process_slot) {
            UartBlockDelivery::Scalar => {
                el0_context_set_x0(frame_sp, value);
                return KernelUartDeliveryResult::Consumed;
            }
            UartBlockDelivery::Read => {
                scheduled_process_set_uart_block_delivery(
                    process_slot, UartBlockDelivery::Scalar);
                return KernelUartDeliveryResult::RetryRead;
            }
        }
    }
    el0_context_set_x0(frame_sp, LINUX_EFAULT);
    return KernelUartDeliveryResult::Consumed;
}

fn kernel_syscall_uart_block_prepare(frame_sp: usize) {
    let process_slot: usize = kernel_syscall_process_slot();
    if (scheduled_process_slot_valid(process_slot)) {
        match scheduled_process_uart_block_delivery(process_slot) {
            UartBlockDelivery::Scalar => {}
            UartBlockDelivery::Read => {
                el0_context_retry_syscall(frame_sp);
            }
        }
    }
}

// Step 2/8: action 5 (.Lsyscall_block). Entered via a plain tail branch, not
// `bl` -- there is no caller to return to, every path ends in a noreturn call.
// GitHub issue #244: this single action-5 trampoline is now shared by two
// different blockers (the takibi UART-wait syscall and wait4()) rather
// than adding a 9th hand-written assembly action branch for the second
// one -- whichever syscall handler decided to return SyscallAction::Block
// records which reason first.
fn kernel_syscall_block_return(frame_sp: usize) {
    let mut next_sp: usize = 0;
    if (kernel_process_current_pending_block_reason() ==
            ProcessWaitReason::ChildExit) {
        next_sp = kernel_process_block_wait4(frame_sp);
    } else {
        kernel_syscall_uart_block_prepare(frame_sp);
        next_sp = kernel_process_block_uart(frame_sp);
    }
    if (next_sp == 0) {
        kernel_syscall_fail_stop(frame_sp);
    }
    el0_context_resume(next_sp);
}

// Step 3/8: action 1 (.Lsyscall_resume). The most common path -- every
// ordinary syscall return reaches this -- and also shared directly by
// .Lsyscall_clone_child's own tail (still raw asm at this step), which
// branches to the .Lsyscall_resume label with x7=0 after installing the new
// child frame, so the child's syscall-return-scheduling check is not
// skipped just because it arrived via clone rather than an ordinary return.
fn kernel_syscall_resume_return(frame_sp: usize, value: usize) {
    el0_context_set_x0(frame_sp, value);
    kernel_stack_guard_check(frame_sp);  // issue #375
    let resume_sp: usize = kernel_process_syscall_return_schedule(frame_sp);
    el0_context_resume(resume_sp);
}

// Step 4/8: action 3 (.Lsyscall_clone_child). Replaces the hand-written
// EXC_CONTEXT_SIZE-word copy loop with slice_copy over two raw byte views of
// the same two addresses, and folds two redundant
// kernel_process_clone_child_stack_top() calls (the original asm called it
// once for the copy destination and again, unnecessarily, right before
// install) into one. Ends by sharing kernel_syscall_resume_return -- clone's
// return to the child is "resume with x0=0", exactly like an ordinary
// syscall return, and must not skip the same reschedule check.
fn kernel_syscall_clone_child_return(parent_frame_sp: usize, child_pid: usize)
        !{unsafe} {
    // The suspended parent observes clone() == child PID whenever it is
    // first selected; the copied child frame's own X0 is overwritten to 0
    // below via kernel_syscall_resume_return.
    el0_context_set_x0(parent_frame_sp, child_pid);
    let child_stack_top: usize = kernel_process_clone_child_stack_top();
    if (child_stack_top == 0) {
        kernel_syscall_fail_stop(parent_frame_sp);
    }
    let child_frame_sp: usize = child_stack_top - EXC_CONTEXT_SIZE;
    // The exception entry assembly supplies `parent_frame_sp`; the process
    // stack allocator supplies `child_frame_sp`.  These are ABI-owned
    // exception-frame bounds, not ordinary slice provenance.
    let parent_frame_base: *u8 = unsafe { parent_frame_sp as *u8 };
    let child_frame_base: *u8 = unsafe { child_frame_sp as *u8 };
    let src: []u8 = unsafe { parent_frame_base[0..<EXC_CONTEXT_SIZE as isize] };
    let dst: []u8 = unsafe { child_frame_base[0..<EXC_CONTEXT_SIZE as isize] };
    let copied: usize = slice_copy(dst, src);
    let installed_child_sp: usize =
        kernel_process_clone_context_install(parent_frame_sp, child_frame_sp);
    if (installed_child_sp == 0) {
        kernel_syscall_fail_stop(parent_frame_sp);
    }
    process_image_activate_root(
        address_space_root_slot(kernel_process_current_root()));
    kernel_syscall_resume_return(installed_child_sp, 0);
}

// Step 5/8: action 8 (.Lsyscall_child_exec). This is the exact bug fixed in
// commit 8db27e3: the replacement entry/stack must be published through the
// saved frame's own fields, not via a direct msr, since el0_context_resume
// (like the EXC_CONTEXT_RESTORE it replaces) always reloads elr_el1/sp_el0
// from this same frame. Writing through el0_context_set_elr_el1/
// el0_context_set_sp_el0 and then calling el0_context_resume makes that
// class of bug structurally impossible now: there is no second code path
// left that could reload and silently discard these two field writes.
fn kernel_syscall_child_exec_return(frame_sp: usize) {
    if (kernel_process_child_exec_prepare() == 0) {
        kernel_syscall_fail_stop(frame_sp);
    }
    // Default-false debugger test switch: stop after the real prepare+commit
    // path without affecting ordinary exec or adding a userspace interface.
    if (kernel_process_trace_fail_after_exec_requested()) {
        kernel_syscall_fail_stop(frame_sp);
    }
    let entry: usize = kernel_process_child_exec_entry();
    let stack: usize = kernel_process_child_exec_stack();
    el0_context_set_sp_el0(frame_sp, stack);
    el0_context_set_elr_el1(frame_sp, entry);
    // exec starts a new runtime image. Do not expose the previous image's
    // TLS base until that runtime installs its own TPIDR_EL0.
    el0_context_set_tpidr_el0(frame_sp, 0);
    el0_context_set_x0(frame_sp, 0);
    el0_context_resume(frame_sp);
}

// Step 6/8: action 4 (.Lsyscall_clone_parent). This is the exact bug fixed
// in commit 8db27e3: parent_sp used to be kept in the caller-saved x7 across
// `bl kernel_process_child_exec_reap`, safe only as long as nothing that
// call reached ever clobbered it -- true for every boot-time clone/exit
// cycle until a child exec image was actually live. As an ordinary .tkb
// local, parent_sp's liveness across this call is the compiler's own
// calling-convention problem now, the same way it already is for every
// other .tkb function call in this file; there is no register to pick by
// hand and therefore no way to pick the wrong one.
fn kernel_syscall_clone_parent_return(parent_sp: usize) {
    kernel_process_child_exec_reap();
    if (parent_sp == 0) {
        kernel_syscall_fail_stop(parent_sp);
    }
    el0_context_resume(parent_sp);
}

fn kernel_syscall_dispatch(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> (usize, usize) !{unsafe} {
    let (action_code, action_value) = syscall_action_encode(
        kernel_syscall_dispatch_action(esr, number, x0, x1, x2, x3, x4));
    // GitHub issue #241/#244/#245 postmortem: action 0 (SyscallAction::
    // Unreachable) matches no branch in user_entry.S's dispatch table and
    // silently fail-stops with zero UART evidence. Naming the syscall
    // number here, right before that happens, is cheap and turns a
    // multi-hour cold-read-the-dispatch-table bisection into a one-line
    // lookup in SYSCALLS.md.
    if (action_code == 0) {
        kernel_boot_log_syscall_unreachable(number);
    }
    return (action_code, action_value);
}

fn kernel_syscall_dispatch_action(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> SyscallAction !{unsafe} {
    let exception_class: usize = (esr >> 26) & 0x3F;
    if (exception_class != 0x15) { return SyscallAction::Unreachable; }
    kernel_syscall_persistent_shell_checkpoint_selected();
    if (number == AARCH64_NR_TAKIBI_UART_RX_WAIT) {
        disable_irq();
        if (kernel_uart_rx_pending()) {
            let value: usize = kernel_uart_rx_getc() as usize;
            enable_irq();
            return SyscallAction::Resume(value);
        }
        kernel_process_current_set_pending_block(
            ProcessWaitReason::UartRx, 0);
        return SyscallAction::Block;
    }

    if (number == AARCH64_NR_TAKIBI_PARENT_PROGRESS) {
        match kernel_process_uart_record_parent_progress() {
            ProcessUartProgressResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            ProcessUartProgressResult::Recorded => {
                kernel_boot_log(
                    "concurrency: parent progressed while child uart-blocked\n");
                return SyscallAction::Resume(0);
            }
        }
    }

    if (number == AARCH64_NR_WRITE) {
        let fd: usize = x0;
        let address: usize = x1;
        let length: usize = x2;
        if (kernel_connected_fd_is_open(fd) &&
            (fd != 1 || syscall_inetd_mode == false)) {
            syscall_test_evidence_record_connected_write();
            if (kernel_connected_fd_is_open(fd) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            let write_slot: usize =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let write_generation: usize = kernel_connection_fd_identity(fd);
            if (tcp_connection_open_at(write_slot) == false || length == 0) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let mut amount: usize = length;
            if (amount > 1460) { amount = 1460; }
            if (amount < length) {
                syscall_test_evidence_record_partial_write();
            }
            let received_length: usize = tcp_connection_payload(write_slot).socket_buffer_length;
            match tcp_connection_take(write_slot, write_generation) {
                TcpConnectionTakeResult::Missing => {
                    return SyscallAction::Resume(LINUX_EAGAIN);
                }
                TcpConnectionTakeResult::Ready(owner) => {
                  match network_capability_take() {
                    NetworkCapabilityTakeResult::Empty => {
                        tcp_connection_put(owner);
                        return SyscallAction::Resume(LINUX_EAGAIN);
                    }
                    NetworkCapabilityTakeResult::Ready(ready) => {
                    let socket_buffers = tcp_connection_rx_slice(tcp_connection_payload(write_slot));
                    let destination_base: *u8 = socket_buffers as *u8;
                    match user_range_check_read(kernel_process_current_root(), address, amount) {
                        UserReadRangeResult::Fault => {
                            tcp_connection_put(owner);
                            match network_capability_put(ready) {
                                NetworkCapabilityPutResult::Stored => {}
                                NetworkCapabilityPutResult::Conflict => {}
                            }
                            return SyscallAction::Resume(LINUX_EFAULT);
                        }
                        UserReadRangeResult::Ok(range) => {
                            let copied: bool = copy_from_user_raw(
                                range, destination_base, amount);
                        }
                    }
                    match kernel_tcp_send_received(
                            owner, ready,
                            socket_buffers[0..<1460],
                            received_length, amount) {
                        KernelTcpSendResult::Invalid(after_invalid) => {
                            match network_capability_put(after_invalid) {
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_put(owner);
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                            }
                        }
                        KernelTcpSendResult::Sent(after_send) => {
                            match network_capability_put(after_send) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return SyscallAction::Resume(LINUX_EINVAL);
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_put(owner);
                                    return SyscallAction::Resume(amount);
                                }
                            }
                        }
                    }
                    }
                  }
                }
            }
        }
        if (fd == 1 && syscall_inetd_mode) {
            let inetd_write_slot: usize =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            if (tcp_connection_open_at(inetd_write_slot) == false ||
                length > 1460 -
                    tcp_connection_payload(inetd_write_slot).inetd_response_length) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let response_base: *u8 =
                (tcp_connection_inetd_slice(tcp_connection_payload(inetd_write_slot)) as *u8) +
                (tcp_connection_payload(inetd_write_slot).inetd_response_length as isize);
            match user_range_check_read(kernel_process_current_root(), address, length) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(range) => {
                    let copied: bool =
                        copy_from_user_raw(range, response_base, length);
                }
            }
            tcp_connection_payload(inetd_write_slot).inetd_response_length =
                tcp_connection_payload(inetd_write_slot).inetd_response_length + length;
            return SyscallAction::Resume(length);
        }
        if (kernel_syscall_file_is_open(fd)) {
            syscall_test_evidence_record_file_write();
            if (kernel_syscall_file_writable(fd) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            if (kernel_syscall_file_offset(fd) != 0 || length == 0 ||
                length > KERNEL_BLOCK_SIZE) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let destination_base: *u8 = syscall_file_buffer as *u8;
            match user_range_check_read(kernel_process_current_root(), address, length) {
                UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
                UserReadRangeResult::Ok(range) => {
                    let copied: bool =
                        copy_from_user_raw(range, destination_base, length);
                }
            }
            let content_buffer = syscall_file_buffer as []u8;
            if (length > content_buffer.len) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let content = content_buffer[0..<length];
            match ext2_resize_small_file(
                    syscall_ext2_mount, kernel_syscall_file_inode(fd), content) {
                Ext2ResizeResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
                Ext2ResizeResult::Resized => {
                    if (kernel_syscall_file_set_offset(fd, length) == false) {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    return SyscallAction::Resume(length);
                }
            }
        }
        if (kernel_syscall_terminal_is_open(fd) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        match user_range_check_read(kernel_process_current_root(), address, length) {
            UserReadRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            UserReadRangeResult::Ok(range) => {
                let mut remaining: usize = length;
                let mut offset: usize = 0;
                while (remaining != 0) {
                    uart_putc(user_read_byte(range, offset));
                    offset = offset + 1;
                    remaining = remaining - 1;
                }
            }
        }
        return SyscallAction::Resume(length);
    }

    if (number == 56) {
        syscall_test_evidence_record_open();
        // openat(dirfd, pathname, flags): absolute paths start at the ext2
        // root; relative paths use an open directory fd (or AT_FDCWD, whose
        // unsigned value lies outside the descriptor namespace).
        if (syscall_ext2_ready == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        let path_name: []u8 = match kernel_syscall_path_name(x1) {
            SyscallPathResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
            SyscallPathResult::Invalid => { return SyscallAction::Resume(LINUX_ENOENT); }
            SyscallPathResult::Name(path) => { path }
        };
        let path_view: []u8 = syscall_path_buffer as []u8;
        let mut lookup_inode: usize = 2;
        if (path_view[0] != 0x2F && x0 != LINUX_AT_FDCWD) {
            if (kernel_syscall_directory_is_open(x0) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            lookup_inode = kernel_syscall_directory_inode(x0);
        }
        match ext2_lookup_path_from(
            syscall_ext2_mount,
            lookup_inode,
            path_name) {
            Ext2LookupResult::Invalid => { return SyscallAction::Resume(LINUX_EINVAL); }
            Ext2LookupResult::NotFound => {
                return SyscallAction::Resume(LINUX_ENOENT);
            }
            Ext2LookupResult::Found(inode_number) => {
                let access_mode: usize = x2 & 3;
                match unified_fd_alloc(kernel_syscall_process_slot(), 0) {
                    UnifiedFdAllocResult::Full => {
                        kernel_boot_log_resource_exhausted(
                            "process fd table" as *u8,
                            kernel_syscall_fd_limit_soft());
                        return SyscallAction::Resume(LINUX_EMFILE);
                    }
                    UnifiedFdAllocResult::Allocated(fd) => {
                        let inode_mode: usize = ext2_inode_mode(
                            syscall_ext2_mount, inode_number);
                        if ((inode_mode & 0xF000) == 0x4000) {
                            match unified_directory_open(
                                    kernel_syscall_process_slot(), fd,
                                    inode_number) {
                                UnifiedOpenResult::Invalid => {
                                    return SyscallAction::Resume(LINUX_EBADF);
                                }
                                UnifiedOpenResult::Full => {
                                    kernel_boot_log_resource_exhausted(
                                        "shared object pool" as *u8,
                                        unified_object_max_files());
                                    return SyscallAction::Resume(LINUX_ENFILE);
                                }
                                UnifiedOpenResult::Ok => {
                                    return SyscallAction::Resume(fd);
                                }
                            }
                        }
                        match unified_file_open(
                                kernel_syscall_process_slot(), fd, inode_number,
                                access_mode != 1, access_mode != 0) {
                            UnifiedOpenResult::Invalid => {
                                return SyscallAction::Resume(LINUX_EBADF);
                            }
                            UnifiedOpenResult::Full => {
                                kernel_boot_log_resource_exhausted(
                                    "shared object pool" as *u8,
                                    unified_object_max_files());
                                return SyscallAction::Resume(LINUX_ENFILE);
                            }
                            UnifiedOpenResult::Ok => { return SyscallAction::Resume(fd); }
                        }
                    }
                }
            }
