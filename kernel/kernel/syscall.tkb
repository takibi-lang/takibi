        return syscall_finish_current(frame, syscall_chdir(current_authority, x0), current_authority);
    }
    if (number == AARCH64_NR_SETITIMER) {
        return syscall_finish_current(frame, syscall_setitimer(current_authority, x0, x1, x2), current_authority);
    }
    if (number == AARCH64_NR_GETITIMER) {
        return syscall_finish_current(frame, syscall_getitimer(current_authority, x0, x1), current_authority);
    }
    if (number == AARCH64_NR_SYSLOG) {
