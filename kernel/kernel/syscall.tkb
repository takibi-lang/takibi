                                // descriptor it gets, which is what Linux
                                // promises. So this process waits, off the
                                // run queue, holding nothing, and runs the
                                // syscall again when it is woken.
                                // Re-read after progress: another core may
                                // have moved the parent into wait4() while
                                // accept_progress was examining the socket.
                                // A simultaneous UART wake takes priority:
                                // blocking this process is what lets that
                                // newly Ready shell consume its byte.
                                if (kernel_process_current_exit_has_waiter() &&
                                    kernel_process_other_ready() == false) {
                                    return SyscallAction::WaitInterrupt;
                                }
                                kernel_process_current_set_pending_block(
                                    ProcessWaitReason::NetRx, 0);
                                return SyscallAction::Block;
                            }
                        }
                    }
                    KernelTcpAcceptStep::GaveUp(next) => {
                        match network_capability_put(next) {
                            NetworkCapabilityPutResult::Conflict => {
                                tcp_connection_free(owner);
                                let cleared: bool = kernel_listener_set_pending(
                                    accept_listener_fd, 0, 0);
                                return SyscallAction::Resume(LINUX_EINVAL);
                            }
                            NetworkCapabilityPutResult::Stored => {
                                syscall_test_evidence_record_accept_capability_roundtrip();
                                tcp_connection_free(owner);
                                let cleared: bool = kernel_listener_set_pending(
                                    accept_listener_fd, 0, 0);
