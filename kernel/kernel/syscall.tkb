use "kernel/mm/page.tkb";
use "kernel/mm/address_space.tkb";
use "kernel/mm/user_memory.tkb";
use "kernel/arch/arm64/kernel/user_entry_extern.tkb";
use "kernel/fs/ext2/ext2.tkb";
use "kernel/net/socket_capability.tkb";
use "kernel/net/tcp.tkb";
use "kernel/kernel/fd_table.tkb";

const AARCH64_NR_WRITE: usize = 64;
const AARCH64_NR_READV: usize = 65;
const AARCH64_NR_WRITEV: usize = 66;
const AARCH64_NR_PPOLL: usize = 73;
const AARCH64_NR_UNAME: usize = 160;
const AARCH64_NR_EXIT: usize = 93;
const AARCH64_NR_EXIT_GROUP: usize = 94;
const AARCH64_NR_CLONE: usize = 220;
const AARCH64_NR_VFORK: usize = 58;
const AARCH64_NR_FORK: usize = 107;
const AARCH64_NR_CLONE3: usize = 435;
const AARCH64_NR_EXECVE: usize = 221;
const AARCH64_NR_EXECVEAT: usize = 281;
const AARCH64_NR_WAIT4: usize = 260;
const AARCH64_NR_FCNTL: usize = 25;
const AARCH64_NR_TAKIBI_UART_RX_WAIT: usize = 451;
const AARCH64_NR_TAKIBI_PARENT_PROGRESS: usize = 452;
const LINUX_EBADF: usize = 0xFFFFFFFFFFFFFFF7;
const LINUX_EFAULT: usize = 0xFFFFFFFFFFFFFFF2;
const LINUX_ENOSYS: usize = 0xFFFFFFFFFFFFFFDA;
const LINUX_ENOENT: usize = 0xFFFFFFFFFFFFFFFE;
const LINUX_EINVAL: usize = 0xFFFFFFFFFFFFFFEA;
const LINUX_EAGAIN: usize = 0xFFFFFFFFFFFFFFF5;
const LINUX_EACCES: usize = 0xFFFFFFFFFFFFFFF3;
const LINUX_ECHILD: usize = 0xFFFFFFFFFFFFFFF6;

const LINUX_F_DUPFD: usize = 0;
const LINUX_F_SETFD: usize = 2;
const LINUX_F_DUPFD_CLOEXEC: usize = 1030;

const LINUX_PROT_READ: usize = 1;
const LINUX_PROT_WRITE: usize = 2;

// Issue #196: ABI-facing layout structs used only for sizeof/offsetof --
// actual field access always goes through user_read_u32/u64/
// user_write_u16/copy_to_user against a scratch buffer or a validated
// UserRange, never a constructed struct value, matching this codebase's
// existing CpioNewcHeader/KernelElf64Header pattern (kernel/fs/
// initramfs.tkb, kernel/fs/elf64.tkb).

// struct utsname (aarch64 Linux ABI, <sys/utsname.h>): six 65-byte
// (64 chars + NUL) fields, no padding between them.
struct packed Utsname {
    sysname: [u8; 65];
    nodename: [u8; 65];
    release: [u8; 65];
    version: [u8; 65];
    machine: [u8; 65];
    domainname: [u8; 65];
}

// struct iovec (aarch64 Linux ABI, <sys/uio.h>).
struct packed Iovec {
    iov_base: usize;
    iov_len: usize;
}

// struct pollfd (aarch64 Linux ABI, <poll.h>).
struct packed Pollfd {
    fd: i32;
    events: i16;
    revents: i16;
}

const POLLIN: usize = 0x0001;
const POLLNVAL: usize = 0x0020;

// Linux's own iovec-count cap (UIO_MAXIOV, include/uapi/linux/uio.h) --
// keeps iovcnt*sizeof(Iovec) far below any real overflow risk even before
// checked_mul_usize is applied, and keeps the per-iovec/pollfd validation
// loop provably bounded for --forbid-trap. Checked as `>= IOV_MAX`
// (rejecting the boundary value itself, not just values above it) so the
// accepted range narrows cleanly to the refined type `{0..<IOV_MAX}`
// with no separate lower-bound proof needed.
const IOV_MAX: usize = 1024;
// This kernel's own cap for pollfd arrays (not a Linux constant), same
// rationale and same off-by-one-avoiding `>=` check.
const POLL_MAX: usize = 1024;

const KERNEL_SOCKET_FD_MAX: usize = 8;

private let mut syscall_ext2_mount: Ext2Mount;
private let mut syscall_ext2_ready: bool;
private let mut syscall_file_buffer: [u8; KERNEL_BLOCK_SIZE];
private let mut syscall_path_buffer: [u8; 256];
private let mut syscall_sockaddr_buffer: [u8; 28];
private let mut syscall_open_calls: usize;
private let mut syscall_read_calls: usize;
private let mut syscall_file_write_calls: usize;
private let mut syscall_close_calls: usize;
private let mut syscall_ppoll_uart_waits: usize;
private let mut syscall_connection_open: [bool; TCP_CONNECTION_MAX];
private let mut syscall_socket_calls: usize;
private let mut syscall_bind_calls: usize;
private let mut syscall_listen_calls: usize;
private let mut syscall_socket_close_calls: usize;
private let mut syscall_accept_calls: usize;
private let mut syscall_accept_capability_roundtrips: usize;
private let mut syscall_connected_close_calls: usize;
private let mut syscall_connected_read_calls: usize;
private let mut syscall_connected_write_calls: usize;
private let mut syscall_partial_write_observed: bool;
private let mut syscall_socket_buffer: [u8; 1460 * TCP_CONNECTION_MAX];
private let mut syscall_socket_buffer_length: [usize; TCP_CONNECTION_MAX];
private let mut syscall_socket_buffer_offset: [usize; TCP_CONNECTION_MAX];
private let mut syscall_inetd_mode: bool;
private let mut syscall_inetd_response: [u8; 1460 * TCP_CONNECTION_MAX];
private let mut syscall_inetd_response_length: [usize; TCP_CONNECTION_MAX];

// Issue #196: scratch buffer for uname(2)'s struct utsname reply, sized
// with headroom over sizeof(Utsname) (390 bytes) since array declarations
// can't use sizeof(...) directly (SPEC.md).
private let mut syscall_uname_buffer: [u8; 512];

must_use variant KernelInetdAcceptResult { TimedOut; Accepted; }

private let mut syscall_heap_start: usize;
private let mut syscall_heap_limit: usize;
// GitHub issue #264 fifth stage: nested clones need separate bookkeeping for
// each child. One record holds the values keyed by the child fd-table slot;
// the exit handler reaps that child before switching execution to its parent.
struct CloneFileState {
    file_state_live: bool;
    parent_inetd_mode: bool;
}

private let mut clone_file_state: [CloneFileState; PROCESS_CONTEXT_MAX];
// GitHub issue #244: set by whichever syscall handler returns
// SyscallAction::Block, read by kernel_syscall_block_return() to decide
// which of the two now-sharing-one-trampoline blockers to invoke.
private let mut syscall_block_reason: ProcessWaitReason = ProcessWaitReason::None;
// GitHub issue #244: wait4()'s own x1 (status pointer), stashed across the
// block/wake gap -- see kernel_syscall_wait4_deliver()'s own comment.
private let mut syscall_wait4_status_ptr: usize;
private let mut syscall_connected_fixture_pending: bool;
private let mut syscall_httpd_daemon_pending: bool;
private let mut syscall_exec_pending: bool;
private let mut syscall_exec_argc: usize;
private let mut syscall_exec_argv: [u8; 512];

must_use variant SyscallPathResult { Fault; Invalid; Name(usize); }

fn kernel_syscall_httpd_daemon_start() {
    syscall_httpd_daemon_pending = true;
}

fn kernel_syscall_exec_pending() -> bool { return syscall_exec_pending; }
fn kernel_syscall_exec_argc() -> usize { return syscall_exec_argc; }
fn kernel_syscall_exec_argv() -> []u8 { return syscall_exec_argv as []u8; }
fn kernel_syscall_exec_clear() { syscall_exec_pending = false; }

fn kernel_syscall_connected_fixture_start() {
    syscall_connected_fixture_pending = true;
}

must_use variant KernelFdReapResult { Failed; Reaped; }
must_use variant KernelDaemonTeardownResult { Invalid; Reclaimed; }
variant KernelConnectionLookupResult {
    Missing;
    Found({0..<TCP_CONNECTION_MAX as usize});
}
variant KernelSocketFdAllocResult {
    Full;
    Allocated({0..<KERNEL_SOCKET_FD_MAX as usize});
}
variant KernelListenerLookupResult {
    Missing;
    Found({0..<KERNEL_SOCKET_FD_MAX as usize});
}

// GitHub issue #245: fd-table process slot == process.tkb's own
// ProcessHandle.pool_index (same convention as the address-space root),
// so this is now a direct pass-through instead of a binary pid==2?1:0.
fn kernel_syscall_process_slot() -> usize {
    return kernel_process_current_root();
}

fn kernel_syscall_file_lookup(fd: usize) -> UnifiedFileResult {
    return unified_file_lookup(kernel_syscall_process_slot(), fd);
}

fn kernel_syscall_file_is_open(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => { return true; }
    }
}

fn kernel_syscall_file_readable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_readable(handle);
        }
    }
}

fn kernel_syscall_file_writable(fd: usize) -> bool {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return false; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_is_writable(handle);
        }
    }
}

fn kernel_syscall_file_inode(fd: usize) -> usize {
    match kernel_syscall_file_lookup(fd) {
        UnifiedFileResult::Missing => { return 0; }
        UnifiedFileResult::Found(handle) => {
            return unified_file_inode(handle);
        }
    }
}

fn kernel_syscall_file_offset(fd: usize) -> usize {
    match unified_fd_offset(kernel_syscall_process_slot(), fd) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_file_set_offset(fd: usize, value: usize) -> bool {
    match unified_fd_set_offset(kernel_syscall_process_slot(), fd, value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

fn kernel_syscall_any_file_is_open() -> bool {
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (kernel_syscall_file_is_open(fd)) { return true; }
    }
    return false;
}

fn kernel_syscall_heap_break() -> usize {
    match unified_process_heap_break(kernel_syscall_process_slot()) {
        UnifiedOffsetResult::Missing => { return 0; }
        UnifiedOffsetResult::Found(value) => { return value; }
    }
}

fn kernel_syscall_heap_set(value: usize) -> bool {
    match unified_process_heap_configure(kernel_syscall_process_slot(), value) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => { return true; }
    }
}

fn kernel_syscall_process_configure(heap_start: usize, heap_limit: usize) {
    syscall_heap_start = heap_start;
    syscall_heap_limit = heap_limit;
    unified_fd_table_init();
    match unified_process_heap_configure(0, heap_start) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
    syscall_open_calls = 0;
    syscall_read_calls = 0;
    syscall_file_write_calls = 0;
    syscall_close_calls = 0;
    syscall_exec_pending = false;
    syscall_exec_argc = 0;
    tcp_connection_pool_init();
    for connection_index: usize in 0..<TCP_CONNECTION_MAX {
        syscall_connection_open[connection_index] = false;
        syscall_socket_buffer_length[connection_index] = 0;
        syscall_socket_buffer_offset[connection_index] = 0;
        syscall_inetd_response_length[connection_index] = 0;
    }
    syscall_socket_calls = 0;
    syscall_bind_calls = 0;
    syscall_listen_calls = 0;
    syscall_socket_close_calls = 0;
    syscall_accept_calls = 0;
    syscall_accept_capability_roundtrips = 0;
    syscall_connected_close_calls = 0;
    syscall_connected_read_calls = 0;
    syscall_connected_write_calls = 0;
    syscall_partial_write_observed = false;
    syscall_inetd_mode = false;
    for context: usize in 0..<PROCESS_CONTEXT_MAX {
        clone_file_state[context].file_state_live = false;
        clone_file_state[context].parent_inetd_mode = false;
    }
}

// GitHub issue #245: parent/child slots used to be the literal 0/1 (the
// only two the old model could ever produce); child_slot is now whatever
// pool_index kernel_process_clone_begin() actually allocated, passed in
// by the caller once it knows it (see the CLONE syscall handler below,
// which now calls kernel_process_clone_begin() first for exactly this).
fn kernel_syscall_clone_files_begin(parent_slot: usize, child_slot: usize)
        -> UnifiedFdResult {
    if (child_slot < PROCESS_CONTEXT_MAX) {
        let child: {0..<PROCESS_CONTEXT_MAX as usize} = child_slot;
        match unified_fd_clone(parent_slot, child_slot) {
            UnifiedFdResult::Invalid => {
                clone_file_state[child].file_state_live = false;
                return UnifiedFdResult::Invalid;
            }
            UnifiedFdResult::Ok => {
                clone_file_state[child].file_state_live = true;
            }
        }
        clone_file_state[child].parent_inetd_mode = syscall_inetd_mode;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn kernel_connected_fd_is_open(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => { return true; }
    }
}

fn kernel_connected_fd_clear(fd: usize) {
    match unified_fd_close(kernel_syscall_process_slot(), fd) {
        UnifiedFdResult::Invalid => {}
        UnifiedFdResult::Ok => {}
    }
}

fn kernel_connection_fd_lookup(fd: usize) -> KernelConnectionLookupResult {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => {}
        UnifiedSocketResult::Found(handle) => {
          let slot_value: usize = unified_connection_slot(handle);
          if (slot_value < TCP_CONNECTION_MAX) {
            let slot: {0..<TCP_CONNECTION_MAX as usize} = slot_value;
            return KernelConnectionLookupResult::Found(slot);
          }
        }
    }
    return KernelConnectionLookupResult::Missing;
}

fn kernel_socket_fd_alloc(first: usize) -> KernelSocketFdAllocResult {
    match unified_fd_alloc(kernel_syscall_process_slot(), first) {
        UnifiedFdAllocResult::Full => { return KernelSocketFdAllocResult::Full; }
        UnifiedFdAllocResult::Allocated(fd) => {
            if (fd < KERNEL_SOCKET_FD_MAX) {
                let socket_fd: {0..<KERNEL_SOCKET_FD_MAX as usize} = fd;
                return KernelSocketFdAllocResult::Allocated(socket_fd);
            }
            return KernelSocketFdAllocResult::Full;
        }
    }
}

fn kernel_listener_fd_lookup(fd: usize) -> KernelListenerLookupResult {
    if (fd >= 0 && fd < KERNEL_SOCKET_FD_MAX) {
        let index: {0..<KERNEL_SOCKET_FD_MAX as usize} = fd;
        match unified_socket_lookup(kernel_syscall_process_slot(), index,
                                    UnifiedFdKind::Listener) {
            UnifiedSocketResult::Missing => {}
            UnifiedSocketResult::Found(handle) => {
                return KernelListenerLookupResult::Found(index);
            }
        }
    }
    return KernelListenerLookupResult::Missing;
}

fn kernel_listener_handle(fd: usize) -> UnifiedSocketResult {
    return unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                 UnifiedFdKind::Listener);
}

fn kernel_listener_state(fd: usize) -> UnifiedListenerState {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => {
            return UnifiedListenerState::Closed;
        }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_state(handle);
        }
    }
}

fn kernel_listener_set_state(fd: usize, state: UnifiedListenerState) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_state(handle, state) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_listener_port(fd: usize) -> u16 {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_listener_port(handle);
        }
    }
}

fn kernel_listener_set_port(fd: usize, port: u16) -> bool {
    match kernel_listener_handle(fd) {
        UnifiedSocketResult::Missing => { return false; }
        UnifiedSocketResult::Found(handle) => {
            match unified_listener_set_port(handle, port) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn kernel_connected_fd_duplicate(old_fd: usize, new_fd: usize) -> bool {
    if (old_fd >= 0 && old_fd < KERNEL_SOCKET_FD_MAX &&
        new_fd >= 0 && new_fd < KERNEL_SOCKET_FD_MAX) {
        match unified_fd_duplicate(kernel_syscall_process_slot(), old_fd,
                                   new_fd) {
            UnifiedFdResult::Invalid => { return false; }
            UnifiedFdResult::Ok => { return true; }
        }
    }
    return false;
}

fn kernel_connection_fd_identity(fd: usize) -> usize {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
        UnifiedSocketResult::Missing => { return 0; }
        UnifiedSocketResult::Found(handle) => {
            return unified_connection_generation(handle);
        }
    }
    return 0;
}

fn kernel_connected_transport_release(slot: usize, generation: usize)
        -> bool {
    match tcp_connection_take(slot, generation) {
        TcpConnectionTakeResult::Missing => { return false; }
        TcpConnectionTakeResult::Ready(owner) => {
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    match tcp_connection_put(owner) {
                        TcpConnectionPutResult::Stored => {}
                        TcpConnectionPutResult::Conflict => {}
                    }
                    return false;
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    match kernel_tcp_close_stream(owner, ready) {
                        KernelTcpCloseResult::Closed(after_close) => {
                            match network_capability_put(after_close) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return false;
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    tcp_connection_free(owner);
                                    return true;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn kernel_connected_descriptor_release(fd: usize) -> bool {
    match unified_socket_lookup(kernel_syscall_process_slot(), fd,
                                UnifiedFdKind::Connection) {
      UnifiedSocketResult::Missing => { return false; }
      UnifiedSocketResult::Found(handle) => {
          let found_slot: usize = unified_connection_slot(handle);
          let generation: usize = unified_connection_generation(handle);
          let references: usize = unified_object_references(handle);
          if (found_slot < TCP_CONNECTION_MAX) {
              let slot: {0..<TCP_CONNECTION_MAX as usize} = found_slot;
              if (references == 0) { return false; }
              if (references == 1 && syscall_connection_open[slot]) {
                  let closed: bool = kernel_connected_transport_release(
                      slot, generation);
                  if (closed) { syscall_connection_open[slot] = false; }
                  return closed;
              }
              return true;
          }
          return false;
      }
    }
}

// Only ever called from the EXIT handler, while the exiting child is
// still the current process -- so its own fd-table slot is exactly what
// kernel_syscall_process_slot() reports here, and is the slot whose
// CloneFileState this reaps.
fn kernel_syscall_clone_files_reap() -> KernelFdReapResult {
    let child_slot: usize = kernel_syscall_process_slot();
    if (child_slot < PROCESS_CONTEXT_MAX) {
        let child: {0..<PROCESS_CONTEXT_MAX as usize} = child_slot;
        if (clone_file_state[child].file_state_live == false) {
            return KernelFdReapResult::Failed;
        }
        for fd: usize in 0..<KERNEL_SOCKET_FD_MAX {
            if (kernel_connected_fd_is_open(fd)) {
                if (kernel_connected_descriptor_release(fd) == false) {
                    return KernelFdReapResult::Failed;
                }
                kernel_connected_fd_clear(fd);
            }
        }
        match unified_fd_destroy(child_slot) {
            UnifiedFdResult::Invalid => { return KernelFdReapResult::Failed; }
            UnifiedFdResult::Ok => {}
        }
        syscall_inetd_mode = clone_file_state[child].parent_inetd_mode;
        clone_file_state[child].file_state_live = false;
        return KernelFdReapResult::Reaped;
    }
    return KernelFdReapResult::Failed;
}

fn kernel_syscall_daemon_teardown() -> KernelDaemonTeardownResult {
    if (kernel_listener_state(4) != UnifiedListenerState::Listening ||
        kernel_syscall_any_file_is_open()) {
        return KernelDaemonTeardownResult::Invalid;
    }
    for connection_index: usize in 0..<TCP_CONNECTION_MAX {
        if (syscall_connection_open[connection_index]) {
            return KernelDaemonTeardownResult::Invalid;
        }
    }
    match unified_fd_close(kernel_syscall_process_slot(), 4) {
        UnifiedFdResult::Invalid => {
            return KernelDaemonTeardownResult::Invalid;
        }
        UnifiedFdResult::Ok => {}
    }
    syscall_socket_close_calls = syscall_socket_close_calls + 1;
    return KernelDaemonTeardownResult::Reclaimed;
}

fn kernel_syscall_inetd_accept(port: u16)
        -> KernelInetdAcceptResult !{may_block} {
    match tcp_connection_alloc() {
        TcpConnectionAllocResult::Full => {
            return KernelInetdAcceptResult::TimedOut;
        }
        TcpConnectionAllocResult::Allocated(owner) => {
            let slot: usize = tcp_connection_slot(owner);
            let generation: usize = tcp_connection_identity(owner);
            match network_capability_take() {
                NetworkCapabilityTakeResult::Empty => {
                    tcp_connection_free(owner);
                    return KernelInetdAcceptResult::TimedOut;
                }
                NetworkCapabilityTakeResult::Ready(ready) => {
                    match kernel_tcp_accept_once(owner, ready, port) {
                        KernelTcpAcceptResult::TimedOut(next) => {
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Stored => { }
                                NetworkCapabilityPutResult::Conflict => { }
                            }
                            tcp_connection_free(owner);
                            return KernelInetdAcceptResult::TimedOut;
                        }
                        KernelTcpAcceptResult::Accepted(next) => {
                            match network_capability_put(next) {
                                NetworkCapabilityPutResult::Conflict => {
                                    tcp_connection_free(owner);
                                    return KernelInetdAcceptResult::TimedOut;
                                }
                                NetworkCapabilityPutResult::Stored => {
                                    match tcp_connection_put(owner) {
                                        TcpConnectionPutResult::Conflict => {
                                            return KernelInetdAcceptResult::TimedOut;
                                        }
                                        TcpConnectionPutResult::Stored => {
                                            if (slot >= TCP_CONNECTION_MAX) {
                                                return KernelInetdAcceptResult::TimedOut;
                                            }
                                            syscall_inetd_mode = true;
                                            syscall_connection_open[slot] = true;
                                            match unified_connection_create(
                                                    kernel_syscall_process_slot(),
                                                    0, slot, generation) {
                                                UnifiedFdResult::Invalid => {
                                                    return KernelInetdAcceptResult::TimedOut;
                                                }
                                                UnifiedFdResult::Ok => {}
                                            }
                                            match unified_fd_duplicate(
                                                    kernel_syscall_process_slot(),
                                                    0, 1) {
                                                UnifiedFdResult::Invalid => {
                                                    return KernelInetdAcceptResult::TimedOut;
                                                }
                                                UnifiedFdResult::Ok => {}
                                            }
                                            syscall_socket_buffer_length[slot] = 0;
                                            syscall_socket_buffer_offset[slot] = 0;
                                            syscall_inetd_response_length[slot] = 0;
                                            return KernelInetdAcceptResult::Accepted;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn kernel_syscall_ext2_configure(mount: Ext2Mount) {
    syscall_ext2_mount = mount;
    syscall_ext2_ready = true;
    syscall_open_calls = 0;
    syscall_read_calls = 0;
    syscall_file_write_calls = 0;
    syscall_close_calls = 0;
}

fn kernel_syscall_file_evidence()
        -> (usize, usize, usize, usize) {
    return (syscall_open_calls, syscall_read_calls,
            syscall_file_write_calls, syscall_close_calls);
}

fn kernel_syscall_socket_evidence() -> bool {
    return syscall_socket_calls == 1 && syscall_bind_calls == 1 &&
           syscall_listen_calls == 1 && syscall_accept_calls == 2 &&
           syscall_accept_capability_roundtrips == 2 &&
           syscall_connection_open[0] == false &&
           kernel_connected_fd_is_open(0) == false &&
           kernel_connected_fd_is_open(1) == false &&
           kernel_connected_fd_is_open(5) == false &&
           syscall_connection_open[1] == false &&
           kernel_connected_fd_is_open(6) == false &&
           syscall_connected_close_calls == 2 &&
           syscall_connected_read_calls == 3 &&
           syscall_connected_write_calls == 4 &&
           syscall_socket_close_calls == 1 &&
           kernel_listener_state(4) == UnifiedListenerState::Closed;
}

fn kernel_syscall_partial_write_evidence() -> bool {
    return syscall_partial_write_observed;
}

// Copy one NUL-terminated pathname through the user-memory boundary. Only a
// single root component is supported by this first generic lookup slice;
// directory traversal and symlink resolution remain separate work.
fn kernel_syscall_path_name(address: usize) -> SyscallPathResult {
    let path_view: []u8 = syscall_path_buffer as []u8;
    let mut length: usize = 0;
    let mut terminated: bool = false;
    for offset: usize in 0..<255 {
        if (terminated == false) {
            let current: usize = match checked_add_usize(address, offset) {
                CheckedUsize::Overflow => { return SyscallPathResult::Fault; }
                CheckedUsize::Value(v) => { v }
            };
            match user_range_check(kernel_process_current_root(), current, 1, UserAccessMode::Read) {
                UserRangeResult::Fault => { return SyscallPathResult::Fault; }
                UserRangeResult::Ok(range) => {
                    if (copy_from_user(range, path_view[offset..<offset + 1]) == false) {
                        return SyscallPathResult::Fault;
                    }
                }
            }
            if (path_view[offset] == 0) {
                length = offset;
                terminated = true;
            }
        }
    }
    if (terminated == false || length == 0) {
        return SyscallPathResult::Invalid;
    }
    if (path_view[0] == 0x2F) {
        if (length == 1) { return SyscallPathResult::Invalid; }
        return SyscallPathResult::Name(256 + length - 1);
    }
    return SyscallPathResult::Name(length);
}

// Issue #196: writev(2)/readv(2) per-segment results, kept distinct from
// the underlying byte count instead of encoding "this is actually an
// errno" via a magnitude heuristic (Linux -errno values happen to be
// huge as unsigned usize, which would work, but a discriminated variant
// makes the distinction a type-level fact instead of a convention every
// call site has to remember).
must_use variant WriteSegmentResult { Errno(usize); Written(usize); }
must_use variant ReadSegmentResult { Errno(usize); Read(usize); }

// Single-segment write, fd 1/2 (raw UART) only. Deliberately NOT shared
// with write(64)'s own handler below (which also supports connected TCP
// fds, BusyBox httpd's inetd-mode fd 1, and the ext2 fd 3) -- extracting
// that already-proven-working, TCP-timing-sensitive code into a shared
// helper was judged more regression risk than this issue's actual
// traced scenarios (uname -a's writev to stdout) need. Broadening
// writev/readv to the other fd kinds is natural follow-up work, not
// done here.
fn syscall_writev_segment(fd: usize, address: usize, length: usize)
        -> WriteSegmentResult {
    if (fd != 1 && fd != 2) { return WriteSegmentResult::Errno(LINUX_EBADF); }
    if (length == 0) { return WriteSegmentResult::Written(0); }
    match user_range_check(kernel_process_current_root(), address, length, UserAccessMode::Read) {
        UserRangeResult::Fault => {
            return WriteSegmentResult::Errno(LINUX_EFAULT);
        }
        UserRangeResult::Ok(range) => {
            let mut remaining: usize = length;
            let mut offset: usize = 0;
            while (remaining != 0) {
                uart_putc(user_read_byte(range, offset));
                offset = offset + 1;
                remaining = remaining - 1;
            }
        }
    }
    return WriteSegmentResult::Written(length);
}

// Single-segment read from any open ext2 file descriptor.
fn syscall_readv_segment(fd: usize, address: usize, length: usize)
        -> ReadSegmentResult {
    if (kernel_syscall_file_is_open(fd) == false ||
            kernel_syscall_file_readable(fd) == false) {
        return ReadSegmentResult::Errno(LINUX_EBADF);
    }
    match ext2_read_small_file(
            syscall_ext2_mount, kernel_syscall_file_inode(fd),
            syscall_file_buffer as []u8) {
        Ext2ReadResult::Invalid => { return ReadSegmentResult::Errno(LINUX_EINVAL); }
        Ext2ReadResult::Read(file_length) => {
            if (kernel_syscall_file_offset(fd) >= file_length) {
                return ReadSegmentResult::Read(0);
            }
            let available: usize = file_length - kernel_syscall_file_offset(fd);
            let mut amount: usize = length;
            if (amount > available) { amount = available; }
            let source_base: *u8 = (syscall_file_buffer as *u8) +
                (kernel_syscall_file_offset(fd) as isize);
            match user_range_check(kernel_process_current_root(), address, amount, UserAccessMode::Write) {
                UserRangeResult::Fault => {
                    return ReadSegmentResult::Errno(LINUX_EFAULT);
                }
                UserRangeResult::Ok(range) => {
                    let copied: bool =
                        copy_to_user_raw(range, source_base, amount);
                }
            }
            if (kernel_syscall_file_set_offset(
                    fd, kernel_syscall_file_offset(fd) + amount) == false) {
                return ReadSegmentResult::Errno(LINUX_EBADF);
            }
            return ReadSegmentResult::Read(amount);
        }
    }
}

// ppoll(2) readiness for one fd: (is_valid_fd, revents). fd 0 checks the
// real UART RX ring (kernel_uart_rx_pending()). Its concrete BusyBox ash
// form -- one stdin pollfd and a null timeout -- waits on the retained
// interrupt event until the UART RX IRQ publishes a byte. Mixed fd sets and
// finite timeouts remain out of scope for this first real wait path.
// Connected TCP fds
// check already-buffered data read-only (no mutation, so no risk to the
// proven TCP send/receive paths). Everything else is POLLNVAL.
// UART RX ring buffer: moved here from kernel/platform/rpi5/init.tkb (issue #196)
// now that ppoll(2)'s fd==0 readiness check is a second real caller of
// kernel_uart_rx_pending, alongside the existing
// AARCH64_NR_TAKIBI_UART_RX_WAIT dispatch below -- both live in this
// file's kernel_syscall_dispatch. kernel_uart_rx_isr/kernel_uart_rx_getc
// (the actual ISR and consumer) stay in main.tkb, since they need
// kernel_process_uart_wake from kernel/kernel/process.tkb, which this
// file does not otherwise depend on.
let mut kernel_uart_rx_buf: [u8; 64];
let mut kernel_uart_rx_head: io usize;
let mut kernel_uart_rx_tail: io usize;
fn kernel_uart_rx_ring_reset() {
    kernel_uart_rx_head = 0;
    kernel_uart_rx_tail = 0;
}

fn kernel_uart_rx_pending() -> bool {
    return kernel_uart_rx_tail != kernel_uart_rx_head;
}

fn syscall_poll_fd_ready(fd: usize) -> (bool, usize) {
    if (fd == 0) {
        if (kernel_uart_rx_pending()) { return (true, POLLIN); }
        return (true, 0);
    }
    if (kernel_connected_fd_is_open(fd)) {
        match kernel_connection_fd_lookup(fd) {
            KernelConnectionLookupResult::Missing => {
                return (false, POLLNVAL);
            }
            KernelConnectionLookupResult::Found(slot) => {
                if (syscall_connection_open[slot] &&
                        syscall_socket_buffer_offset[slot] <
                            syscall_socket_buffer_length[slot]) {
                    return (true, POLLIN);
                }
                return (true, 0);
            }
        }
    }
    if (fd == 1 || fd == 2 || kernel_syscall_file_is_open(fd)) {
        return (true, 0);
    }
    return (false, POLLNVAL);
}

fn syscall_ppoll_dispatch(fds_address: usize, raw_nfds: usize,
                          timeout_address: usize, sigmask_address: usize)
        -> SyscallAction !{may_block} {
    if (raw_nfds == 0) { return SyscallAction::Resume(0); }
    if (raw_nfds >= 0 && raw_nfds < POLL_MAX) {
      let nfds: {0..<POLL_MAX as usize} = raw_nfds;
      let array_bytes: usize = match checked_mul_usize(nfds, sizeof(Pollfd)) {
        CheckedUsize::Overflow => { return SyscallAction::Resume(LINUX_EINVAL); }
        CheckedUsize::Value(v) => { v }
    };
      match user_range_check(kernel_process_current_root(), fds_address, array_bytes, UserAccessMode::Write) {
        UserRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserRangeResult::Ok(array_range) => {
            let mut ready_count: usize = 0;
            let mut uart_wait: bool = false;
            for index: usize in 0..<nfds {
                let (fd_ok, fd_raw) = user_read_u32(
                    array_range,
                    index * sizeof(Pollfd) + offsetof(Pollfd, fd));
                let (events_ok, events_raw) = user_read_u32(
                    array_range,
                    index * sizeof(Pollfd) + offsetof(Pollfd, events));
                if (fd_ok == false || events_ok == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                let fd: usize = fd_raw as usize;
                let (valid, revents) = syscall_poll_fd_ready(fd);
                let mut final_revents: usize = revents;
                if (valid == false) { final_revents = POLLNVAL; }
                if (user_write_u16(
                        array_range,
                        index * sizeof(Pollfd) + offsetof(Pollfd, revents),
                        final_revents) == false) {
                    return SyscallAction::Resume(LINUX_EFAULT);
                }
                if (final_revents != 0) { ready_count = ready_count + 1; }
                if (nfds == 1 && fd == 0 &&
                    (events_raw as usize & POLLIN) != 0) {
                    uart_wait = true;
                }
            }
            if (ready_count == 0 && uart_wait && timeout_address == 0 &&
                sigmask_address == 0) {
                syscall_ppoll_uart_waits = syscall_ppoll_uart_waits + 1;
                if (syscall_ppoll_uart_waits == 1) {
                    kernel_boot_log("shell ppoll: uart blocked\n");
                }
                return SyscallAction::WaitUart;
            }
            return SyscallAction::Resume(ready_count);
        }
      }
    }
    return SyscallAction::Resume(LINUX_EINVAL);
}

fn syscall_read_uart(address: usize, requested: usize) -> SyscallAction {
    if (requested == 0) { return SyscallAction::Resume(0); }
    match user_range_check(kernel_process_current_root(), address, requested, UserAccessMode::Write) {
        UserRangeResult::Fault => { return SyscallAction::Resume(LINUX_EFAULT); }
        UserRangeResult::Ok(range) => {
            disable_irq();
            if (kernel_uart_rx_pending() == false) {
                enable_irq();
                return SyscallAction::Resume(LINUX_EAGAIN);
            }
            let value: u8 = kernel_uart_rx_getc();
            enable_irq();
            if (user_write_byte(range, 0, value) == false) {
                return SyscallAction::Resume(LINUX_EFAULT);
            }
            return SyscallAction::Resume(1);
        }
    }
}

// Issue #196: writes `value` into a fixed 65-byte struct utsname field at
// `field_offset` within the kernel-side scratch buffer `base` points at.
// The field was already zero-filled by the caller (see the uname(2)
// handler below) before any field write, so a value shorter than 65
// bytes leaves real zero padding, not leftover scratch-buffer content
// from a previous uname(2) call.
fn uname_write_field(base: *u8, field_offset: usize, value: []u8) !{unsafe} {
    let field_base: *u8 = base + (field_offset as isize);
    let field_view: []u8 = unsafe { field_base[0..<65 as isize] };
    let copied: usize = slice_copy(field_view, value);
}

// Mirrors user_entry.S's .Lsyscall_dispatch branch table exactly (action
// numbers 0/1/2/.../8 there correspond one-to-one to the variants below,
// via syscall_action_encode). Kept as a real sum type internally so a
// mistyped numeric action code -- the shape of bug class this file's
// syscall handling cannot otherwise catch at compile time -- is a type
// error instead of a silent wrong branch at the asm boundary. The asm
// side is untouched by this: kernel_syscall_dispatch below still returns
// a plain (usize, usize) register pair, exactly as before.
must_use variant SyscallAction {
    Unreachable;         // 0: esr wasn't a real SVC; asm's own default path
                          //    already fail-stops before this can be selected
    Resume(usize);        // 1: resume EL0 with x0 = value
    Exit(usize);           // 2: parent exit; return status to the EL1 caller
    CloneChild(usize);      // 3: clone succeeded; value = child pid
    CloneParent(usize);      // 4: child exited; value = parent's saved SP
    Block;                    // 5: block this frame on the scheduler
    WaitUart;                  // 6: retry after an uncontended UART wfe
    Exec;                       // 7: parent-only execve pending
    ChildExec;                   // 8: child execve pending
}

fn syscall_action_encode(action: SyscallAction) -> (usize, usize) {
    match action {
        SyscallAction::Unreachable => { return (0, 0); }
        SyscallAction::Resume(value) => { return (1, value); }
        SyscallAction::Exit(value) => { return (2, value); }
        SyscallAction::CloneChild(value) => { return (3, value); }
        SyscallAction::CloneParent(value) => { return (4, value); }
        SyscallAction::Block => { return (5, 0); }
        SyscallAction::WaitUart => { return (6, 0); }
        SyscallAction::Exec => { return (7, 7); }
        SyscallAction::ChildExec => { return (8, 8); }
    }
}

// The only asm-facing entry point (user_entry.S calls this exact name via
// `bl kernel_syscall_dispatch`); its signature is untouched so this step
// needs no assembly changes. All real logic lives in the SyscallAction-
// returning kernel_syscall_dispatch_action below.
//
// GitHub issue #221: the functions below are user_entry.S's action-tail
// branches, migrated one at a time (each independently hardware-verified)
// from hand-written EXC_CONTEXT_RESTORE/eret assembly into .tkb, ending in
// the single shared el0_context_resume/kernel_syscall_fail_stop primitives
// (kernel/arch/arm64/kernel/user_entry.S) instead of a per-branch copy of
// that sequence.

// GitHub issue #244: completes a blocked wait4() at the moment it is
// woken (called from kernel_process_child_exit()'s own wake-a-blocked-
// parent step, kernel/kernel/process.tkb) -- the mirror of what
// kernel_process_uart_wake() does for the UART blocker with a single
// el0_context_set_x0, except wait4() also needs its x1 status pointer
// (stashed in syscall_wait4_status_ptr when it blocked) honored, which a
// bare scalar injection cannot express. frame_sp is the blocked parent's
// own saved SP -- writing x0 there, not the current frame, is exactly
// what el0_context_set_x0 is for (it takes an arbitrary saved context,
// not "the currently running one").
//
// GitHub issue #248: takes parent_slot explicitly (the blocked parent's
// own pool_index) rather than reading kernel/kernel/process.tkb's
// implicit "current" slot -- this runs from INSIDE
// kernel_process_child_exit(), at the moment execution_current_handle is
// still the EXITING CHILD, not yet switched to the parent being woken
// here. Needed so a multi-level concurrent wait4() chain delivers each
// parent's OWN child's status/pid, not whichever slot happened to be
// "current" (irrelevant here) or a shared global (the #248 bug this
// parameter exists to avoid).
fn kernel_syscall_wait4_deliver(frame_sp: usize, reaped_pid: usize,
                                parent_slot: usize) !{unsafe} {
    if (syscall_wait4_status_ptr != 0) {
        match user_range_check(kernel_process_current_root(), syscall_wait4_status_ptr, 4, UserAccessMode::Write) {
            UserRangeResult::Fault => {
                el0_context_set_x0(frame_sp, LINUX_EFAULT);
                return;
            }
            UserRangeResult::Ok(range) => {
                let status: usize =
                    kernel_process_child_wait_status_peek_for(parent_slot);
                if (user_write_u32(range, 0,
                        ((status & 0xFF) << 8) as u32) == false) {
                    el0_context_set_x0(frame_sp, LINUX_EFAULT);
                    return;
                }
            }
        }
    }
    kernel_process_child_wait_status_consume_for(parent_slot);
    el0_context_set_x0(frame_sp, reaped_pid);
}

// Step 2/8: action 5 (.Lsyscall_block). Entered via a plain tail branch, not
// `bl` -- there is no caller to return to, every path ends in a noreturn call.
// GitHub issue #244: this single action-5 trampoline is now shared by two
// different blockers (the takibi UART-wait syscall and wait4()) rather
// than adding a 9th hand-written assembly action branch for the second
// one -- whichever syscall handler decided to return SyscallAction::Block
// records which reason first.
fn kernel_syscall_block_return(frame_sp: usize) {
    let mut next_sp: usize = 0;
    if (syscall_block_reason == ProcessWaitReason::ChildExit) {
        next_sp = kernel_process_block_wait4(frame_sp);
    } else {
        next_sp = kernel_process_block_uart(frame_sp);
    }
    if (next_sp == 0) {
        kernel_syscall_fail_stop();
    }
    el0_context_resume(next_sp);
}

// Step 3/8: action 1 (.Lsyscall_resume). The most common path -- every
// ordinary syscall return reaches this -- and also shared directly by
// .Lsyscall_clone_child's own tail (still raw asm at this step), which
// branches to the .Lsyscall_resume label with x7=0 after installing the new
// child frame, so the child's syscall-return-scheduling check is not
// skipped just because it arrived via clone rather than an ordinary return.
fn kernel_syscall_resume_return(frame_sp: usize, value: usize) {
    el0_context_set_x0(frame_sp, value);
    let resume_sp: usize = kernel_process_syscall_return_schedule(frame_sp);
    el0_context_resume(resume_sp);
}

// Step 4/8: action 3 (.Lsyscall_clone_child). Replaces the hand-written
// EXC_CONTEXT_SIZE-word copy loop with slice_copy over two raw byte views of
// the same two addresses, and folds two redundant
// kernel_process_clone_child_stack_top() calls (the original asm called it
// once for the copy destination and again, unnecessarily, right before
// install) into one. Ends by sharing kernel_syscall_resume_return -- clone's
// return to the child is "resume with x0=0", exactly like an ordinary
// syscall return, and must not skip the same reschedule check.
fn kernel_syscall_clone_child_return(parent_frame_sp: usize, child_pid: usize)
        !{unsafe} {
    // The suspended parent observes clone() == child PID whenever it is
    // first selected; the copied child frame's own X0 is overwritten to 0
    // below via kernel_syscall_resume_return.
    el0_context_set_x0(parent_frame_sp, child_pid);
    let child_stack_top: usize = kernel_process_clone_child_stack_top();
    if (child_stack_top == 0) {
        kernel_syscall_fail_stop();
    }
    let child_frame_sp: usize = child_stack_top - EXC_CONTEXT_SIZE;
    let parent_frame_base: *u8 = parent_frame_sp as *u8;
    let child_frame_base: *u8 = child_frame_sp as *u8;
    let src: []u8 =
        unsafe { parent_frame_base[0..<EXC_CONTEXT_SIZE as isize] };
    let dst: []u8 =
        unsafe { child_frame_base[0..<EXC_CONTEXT_SIZE as isize] };
    let copied: usize = slice_copy(dst, src);
    let installed_child_sp: usize =
        kernel_process_clone_context_install(parent_frame_sp, child_frame_sp);
    if (installed_child_sp == 0) {
        kernel_syscall_fail_stop();
    }
    process_image_activate_root(kernel_process_current_root());
    kernel_syscall_resume_return(installed_child_sp, 0);
}

// Step 5/8: action 8 (.Lsyscall_child_exec). This is the exact bug fixed in
// commit 8db27e3: the replacement entry/stack must be published through the
// saved frame's own fields, not via a direct msr, since el0_context_resume
// (like the EXC_CONTEXT_RESTORE it replaces) always reloads elr_el1/sp_el0
// from this same frame. Writing through el0_context_set_elr_el1/
// el0_context_set_sp_el0 and then calling el0_context_resume makes that
// class of bug structurally impossible now: there is no second code path
// left that could reload and silently discard these two field writes.
fn kernel_syscall_child_exec_return(frame_sp: usize) {
    if (kernel_process_child_exec_prepare() == 0) {
        kernel_syscall_fail_stop();
    }
    let entry: usize = kernel_process_child_exec_entry();
    let stack: usize = kernel_process_child_exec_stack();
    el0_context_set_sp_el0(frame_sp, stack);
    el0_context_set_elr_el1(frame_sp, entry);
    el0_context_set_x0(frame_sp, 0);
    el0_context_resume(frame_sp);
}

// Step 6/8: action 4 (.Lsyscall_clone_parent). This is the exact bug fixed
// in commit 8db27e3: parent_sp used to be kept in the caller-saved x7 across
// `bl kernel_process_child_exec_reap`, safe only as long as nothing that
// call reached ever clobbered it -- true for every boot-time clone/exit
// cycle until a child exec image was actually live. As an ordinary .tkb
// local, parent_sp's liveness across this call is the compiler's own
// calling-convention problem now, the same way it already is for every
// other .tkb function call in this file; there is no register to pick by
// hand and therefore no way to pick the wrong one.
fn kernel_syscall_clone_parent_return(parent_sp: usize) {
    kernel_process_child_exec_reap();
    if (parent_sp == 0) {
        kernel_syscall_fail_stop();
    }
    el0_context_resume(parent_sp);
}

fn kernel_syscall_dispatch(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> (usize, usize) !{unsafe} {
    let (action_code, action_value) = syscall_action_encode(
        kernel_syscall_dispatch_action(esr, number, x0, x1, x2, x3, x4));
    // GitHub issue #241/#244/#245 postmortem: action 0 (SyscallAction::
    // Unreachable) matches no branch in user_entry.S's dispatch table and
    // silently fail-stops with zero UART evidence. Naming the syscall
    // number here, right before that happens, is cheap and turns a
    // multi-hour cold-read-the-dispatch-table bisection into a one-line
    // lookup in SYSCALLS.md.
    if (action_code == 0) {
        kernel_boot_log_syscall_unreachable(number);
    }
    return (action_code, action_value);
}

fn kernel_syscall_dispatch_action(esr: usize, number: usize, x0: usize, x1: usize,
                           x2: usize, x3: usize, x4: usize)
        -> SyscallAction !{unsafe} {
    let exception_class: usize = (esr >> 26) & 0x3F;
    if (exception_class != 0x15) { return SyscallAction::Unreachable; }

    if (number == AARCH64_NR_TAKIBI_UART_RX_WAIT) {
        disable_irq();
        if (kernel_uart_rx_pending()) {
            let value: usize = kernel_uart_rx_getc() as usize;
            enable_irq();
            return SyscallAction::Resume(value);
        }
        syscall_block_reason = ProcessWaitReason::UartRx;
        return SyscallAction::Block;
    }

    if (number == AARCH64_NR_TAKIBI_PARENT_PROGRESS) {
        match kernel_process_uart_record_parent_progress() {
            ProcessUartProgressResult::Invalid => {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            ProcessUartProgressResult::Recorded => {
                kernel_boot_log(
                    "concurrency: parent progressed while child uart-blocked\n");
                return SyscallAction::Resume(0);
            }
        }
    }

    if (number == AARCH64_NR_WRITE) {
        let fd: usize = x0;
        let address: usize = x1;
        let length: usize = x2;
        if (kernel_connected_fd_is_open(fd) &&
            (fd != 1 || syscall_inetd_mode == false)) {
            syscall_connected_write_calls =
                syscall_connected_write_calls + 1;
            if (kernel_connected_fd_is_open(fd) == false) {
                return SyscallAction::Resume(LINUX_EBADF);
            }
            let write_slot: {0..<TCP_CONNECTION_MAX as usize} =
                match kernel_connection_fd_lookup(fd) {
                    KernelConnectionLookupResult::Missing => {
                        return SyscallAction::Resume(LINUX_EBADF);
                    }
                    KernelConnectionLookupResult::Found(found) => { found }
                };
            let write_generation: usize = kernel_connection_fd_identity(fd);
            if (syscall_connection_open[write_slot] == false || length == 0) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let mut amount: usize = length;
            if (amount > 1460) { amount = 1460; }
            if (amount < length) {
                syscall_partial_write_observed = true;
            }
            let received_length: usize = syscall_socket_buffer_length[write_slot];
            match tcp_connection_take(write_slot, write_generation) {
                TcpConnectionTakeResult::Missing => {
                    return SyscallAction::Resume(LINUX_EAGAIN);
                }
                TcpConnectionTakeResult::Ready(owner) => {
                  match network_capability_take() {
                    NetworkCapabilityTakeResult::Empty => {
                        match tcp_connection_put(owner) {
                            TcpConnectionPutResult::Stored => {}
                            TcpConnectionPutResult::Conflict => {}
                        }
                        return SyscallAction::Resume(LINUX_EAGAIN);
                    }
                    NetworkCapabilityTakeResult::Ready(ready) => {
                    let destination_base: *u8 =
                        (syscall_socket_buffer as *u8) +
                        ((write_slot * 1460) as isize);
                    let buffer_base: {0..<1461 as usize} = write_slot * 1460;
                    let socket_buffers = syscall_socket_buffer as []u8;
