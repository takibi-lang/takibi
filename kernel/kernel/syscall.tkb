        // offset, so the shared file position is sufficient for this first
        // Linux-compatible path. Output remains the existing UART console.
        let output_fd: usize = x0;
        let input_fd: usize = x1;
        let offset_address: usize = x2;
        let requested: usize = x3;
        if ((output_fd != 1 && output_fd != 2) ||
            kernel_syscall_file_is_open(input_fd) == false ||
            kernel_syscall_file_readable(input_fd) == false) {
            return SyscallAction::Resume(LINUX_EBADF);
        }
        if (offset_address != 0) { return SyscallAction::Resume(LINUX_EINVAL); }
        let mut copied: usize = 0;
        while (copied < requested) {
            let mut chunk_limit: usize = requested - copied;
            if (chunk_limit > KERNEL_BLOCK_SIZE) {
                chunk_limit = KERNEL_BLOCK_SIZE;
            }
            let staging_buffer = syscall_scratch_here().file_buffer as []u8;
            if (chunk_limit > staging_buffer.len) {
                return SyscallAction::Resume(LINUX_EINVAL);
            }
            let staging = staging_buffer[0..<chunk_limit];
            match ext2_read_file_chunk(
                    syscall_ext2_mount, kernel_syscall_file_inode(input_fd),
                    kernel_syscall_file_offset(input_fd),
                    staging) {
                Ext2ReadResult::Invalid => {
                    if (copied != 0) { return SyscallAction::Resume(copied); }
                    return SyscallAction::Resume(LINUX_EINVAL);
                }
                Ext2ReadResult::Read(chunk) => {
                    if (chunk == 0) { return SyscallAction::Resume(copied); }
                    let source: *u8 = syscall_scratch_here().file_buffer as *u8;
                    let mut copy_index: usize = 0;
                    while (copy_index < chunk) {
                        uart_putc(source[copy_index as isize]);
                        copy_index = copy_index + 1;
                    }
                    if (kernel_syscall_file_set_offset(
                            input_fd,
                            kernel_syscall_file_offset(input_fd) + chunk) ==
                            false) {
