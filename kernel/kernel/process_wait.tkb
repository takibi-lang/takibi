// A process record's scheduling state and what it waits for, as one value
// (GitHub issue #653).
//
// The wait used to be a field beside the state, and any path could leave
// one without the other: wait4 wrote a wait reason into a Running process
// when it only meant to block (#603 path 2), and every child's exit wrote
// the parent's last_child_pid from whichever CPU it ran on, so a sibling
// retargeted a pending wait4 (#633). Now the wait is the payload of the
// state that has it, so a Running process carries none by construction:
//
//   Blocked(reason)    blocked, waiting for `reason`
//   ReadyWait4(child)  a wait4 parent woken by `child`'s exit on a CPU that
//                      could not run it; its wait4 result is still owed
//   Resuming(child)    the same parent after a CPU started it, until that
//                      CPU settles the continuation; a refused start yields
//                      it back to ReadyWait4, so no other CPU reaps the
//                      child while its exit is still on its kernel stack
//
// Readers ask through process_state_kind and process_wait_reason, which
// answer as the two fields did: ReadyWait4 is Ready and Resuming is
// Running, both with ChildExit. The fields are private, so the transitions
// below are the only writers; which transition a caller may make is the
// state token's business in process.tkb.
//
// Current limitations (2026-10-10):
// - THE CALLER SERIALIZES. Every write is made holding the process-run
//   lock, and a reader that does not hold it sees a value that may be one
//   step old, which the two readers that do so (the DDB and crash
//   reports) accept.
// - ONE WOKEN CHILD. A second child exiting while the continuation is
//   pending does not replace it: the first is the one whose wait4 result is
//   delivered.

enum ProcessWaitReason: u8 {
    None; UartRx; ChildExit; NetRx; Deadline; Signal; UartTx;
}

// The kind of state, as readers compare it.
enum ProcessSlotState: u8 { Free; Ready; Running; Blocked; Exited; Constructing; }

// Free is first: a zeroed record is a free one.
variant ProcessRecordState {
    Free;
    Ready;
    Running;
    Blocked(ProcessWaitReason);
    Exited;
    Constructing;
    ReadyWait4(usize);
    Resuming(usize);
}

struct ProcessStateCell {
    private value: ProcessRecordState;
}

must_use variant ProcessWaitKeep {
    Kept;
    Refused;
}

fn process_state_kind(cell: &ProcessStateCell) -> ProcessSlotState {
    match (*cell).value {
        ProcessRecordState::Free => { return ProcessSlotState::Free; }
        ProcessRecordState::Ready => { return ProcessSlotState::Ready; }
        ProcessRecordState::Running => { return ProcessSlotState::Running; }
        ProcessRecordState::Blocked(_) => { return ProcessSlotState::Blocked; }
        ProcessRecordState::Exited => { return ProcessSlotState::Exited; }
        ProcessRecordState::Constructing => {
            return ProcessSlotState::Constructing;
        }
        ProcessRecordState::ReadyWait4(_) => { return ProcessSlotState::Ready; }
        ProcessRecordState::Resuming(_) => { return ProcessSlotState::Running; }
    }
}

fn process_wait_reason(cell: &ProcessStateCell) -> ProcessWaitReason {
    match (*cell).value {
        ProcessRecordState::Blocked(reason) => { return reason; }
        ProcessRecordState::ReadyWait4(_) => {
            return ProcessWaitReason::ChildExit;
        }
        ProcessRecordState::Resuming(_) => {
            return ProcessWaitReason::ChildExit;
        }
        _ => { return ProcessWaitReason::None; }
    }
}

// The pid of the child whose exit woke a pending wait4; 0 for none (no
// process has pid 0).
fn process_wait_woken_by(cell: &ProcessStateCell) -> usize {
    match (*cell).value {
        ProcessRecordState::ReadyWait4(child) => { return child; }
        ProcessRecordState::Resuming(child) => { return child; }
        _ => { return 0; }
    }
}

// The slot is free again.
fn process_state_free(cell: &mut ProcessStateCell) {
    (*cell).value = ProcessRecordState::Free;
}

// A new record: Ready when it may run at once, otherwise Constructing.
fn process_state_new(cell: &mut ProcessStateCell, runnable_now: bool) {
    if (runnable_now) {
        (*cell).value = ProcessRecordState::Ready;
    } else {
        (*cell).value = ProcessRecordState::Constructing;
    }
}

// A clone's frame is installed and it runs.
fn process_state_run(cell: &mut ProcessStateCell) {
    (*cell).value = ProcessRecordState::Running;
}

fn process_state_exit(cell: &mut ProcessStateCell) {
    (*cell).value = ProcessRecordState::Exited;
}

// A CPU takes a Ready process. A pending wait4 continuation goes with it
// until process_state_settle.
fn process_state_start(cell: &mut ProcessStateCell) {
    match (*cell).value {
        ProcessRecordState::ReadyWait4(child) => {
            (*cell).value = ProcessRecordState::Resuming(child);
        }
        _ => { (*cell).value = ProcessRecordState::Running; }
    }
}

// The process gives up the CPU. A continuation not yet settled is owed
// again.
fn process_state_yield(cell: &mut ProcessStateCell) {
    match (*cell).value {
        ProcessRecordState::Resuming(child) => {
            (*cell).value = ProcessRecordState::ReadyWait4(child);
        }
        _ => { (*cell).value = ProcessRecordState::Ready; }
    }
}

// The one place a process becomes Blocked: state and reason change
// together.
fn process_state_block(cell: &mut ProcessStateCell, reason: ProcessWaitReason) {
    (*cell).value = ProcessRecordState::Blocked(reason);
}

// A wake leaves nothing pending.
fn process_state_wake(cell: &mut ProcessStateCell) {
    (*cell).value = ProcessRecordState::Ready;
}

// A ChildExit waiter woken by `child` that cannot be resumed now: it stays
// Ready with its wait4 pending, and names the child.
fn process_state_wake_keeping_wait4(cell: &mut ProcessStateCell, child: usize) {
    (*cell).value = ProcessRecordState::ReadyWait4(child);
}

// A pending wait4 continuation is consumed: a Ready parent stays Ready and a
// started one is plainly Running. A Blocked wait loses its reason, as a wake
// is about to end it.
fn process_state_settle(cell: &mut ProcessStateCell) {
    match (*cell).value {
        ProcessRecordState::ReadyWait4(_) => {
            (*cell).value = ProcessRecordState::Ready;
        }
        ProcessRecordState::Resuming(_) => {
            (*cell).value = ProcessRecordState::Running;
        }
        ProcessRecordState::Blocked(_) => {
            (*cell).value = ProcessRecordState::Blocked(ProcessWaitReason::None);
        }
        _ => {}
    }
}

// Boot probe only: a Ready process given a wait4 continuation without
// having blocked, the state a child's exit leaves on a CPU that cannot run
// its parent. Anything but plain Ready is refused.
fn process_state_probe_ready_wait4(cell: &mut ProcessStateCell, child: usize)
        -> ProcessWaitKeep {
    match (*cell).value {
        ProcessRecordState::Ready => {
            (*cell).value = ProcessRecordState::ReadyWait4(child);
            return ProcessWaitKeep::Kept;
        }
        _ => { return ProcessWaitKeep::Refused; }
    }
}

// Boot probe only: the negative control that republishes a Constructing
// record as Ready, and puts it back.
fn process_state_probe_set(cell: &mut ProcessStateCell, kind: ProcessSlotState) {
    match kind {
        ProcessSlotState::Ready => { (*cell).value = ProcessRecordState::Ready; }
        ProcessSlotState::Constructing => {
            (*cell).value = ProcessRecordState::Constructing;
        }
        _ => {}
    }
}
