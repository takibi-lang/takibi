// The CPU-bound pair /etc/inittab starts, and the fairness question asked
// about it.
//
// This exists because nothing else in this kernel can keep a core busy.
// Every other fixture here is I/O-bound: it blocks on UART, on a socket,
// or on a child, so it spends its time not running and says nothing about
// who the scheduler picks when two things both want the CPU. A pair of
// busy loops makes the scheduler the only variable, which is what a
// second core has to be measured against -- and it has to pass on ONE
// core first, so that anything that breaks after the second core is
// enabled is a concurrency defect rather than a workload defect.
//
// The measurement is deliberately not "how many rounds did each finish".
// That number is a property of the machine and of whatever else the boot
// is doing, so no fixture could pin it. What IS pinnable is the SKEW: how
// far ahead of the other either process ever got, counted only over the
// interval where both were alive. On one core with a rotating scheduler
// that is bounded by how many rounds fit in a timer slice; a scheduler
// that stopped covering one of them would drive it to the round count
// itself.
//
// Current limitations (2026-08-28). Keep this list current; a stale one
// invites relying on a guarantee that quietly stopped holding.
// - TWO TAGS, NOT N. The pair is the shape the inittab starts, and the
//   two-versus-four decision for cores is the same one made here: every
//   class of unfairness appears at two.
// - ONE GENERATION IS MEASURED. The fairness verdict latches the first
//   time both tags have run their rounds side by side, and a later
//   generation does not re-open it. What DOES follow it is one restart:
//   this file asks tag A to exit, once, and then checks that init brought
//   only A back -- B keeping both its pid and a counter that never went
//   backwards is the other half of that claim. After that everything is
//   latched and the pair reports nothing more.
// - THE VERDICT IS SERIALIZED with the process run lock. Scheduler picks
//   that already hold the lock thread its guard into this file; syscall and
//   lifecycle paths that do not hold it acquire once at their boundary.
//   Profiling interval boundaries additionally stop every active core before
//   resetting or reading the per-core arrays. The stop rendezvous happens
//   outside the run lock; a peer holding that IRQ-masking lock could not
//   otherwise acknowledge its stop SGI.
// - THE PROGRESS COUNT IS THE CALLER'S CLAIM. A process that reported
//   without doing the work between reports would be believed. What the
//   syscall checks is identity (which process is speaking) and ordering,
//   not effort; the effort is in kernel/arch/arm64/kernel/busy_loop.tkb
//   and is the fixture's own business.

use "kernel/arch/arm64/kernel/timer.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/occupancy.tkb";
use "kernel/kernel/profile_samples.tkb";
use "kernel/kernel/profile_timeline.tkb";

// The two inittab entries, told apart by the tag they pass rather than by
// their pid -- a respawned entry gets a new pid and is still the same
// workload.
const WORKLOAD_BUSY_TAG_A: usize = 1;
const WORKLOAD_BUSY_TAG_B: usize = 2;

// How many rounds each must run WHILE THE OTHER IS ALSO RUNNING before the
// verdict is taken. Enough that a scheduler that alternates unevenly has
// somewhere to show it, few enough that the boot's remaining fixtures are
// not waiting on it.
const WORKLOAD_BUSY_ROUNDS: usize = 8;

// The completion assertion is intentionally topology-independent: both
// processes must report WORKLOAD_BUSY_ROUNDS while the other is live, or the
// lane times out. max_skew remains diagnostic. Starting the init-managed
// HTTPd beside this pair changed it from 1-2 to 5-52 in measured boots, so
// the old fixed <=4 fairness verdict no longer described this workload.
//
// They used to carry a warning that RPi5's were untrustworthy, because
// `cpu_a + cpu_b` printed larger than the `elapsed` they were measured
// inside -- impossible for a monotonic counter, and not seen under QEMU.
// That was never this board's counter. It was uart_put_udec, which had
// five place values on RPi5 and silently truncated anything above 99999
// (GitHub issue #470). With one shared formatter the same boot reports
// cpu_a=8438690 cpu_b=7585307 inside elapsed=25531883 at tickfreq
// 54000000 -- 63% of the window, against QEMU's 24%, and the sum fits.
// So these are now real numbers on both targets, which is what issue
// #448's "report what the second core bought" criterion needs. They stay
// diagnostic here only because no bound has been chosen for them yet.
const WORKLOAD_PROFILE_WORLD_STOP_SPINS: usize = 10000000;
const WORKLOAD_BUSY_MIGRATION_GOAL: usize = 2;

must_use variant WorkloadBusyProgressResult {
    Value(usize);
    StartRequested;
    FinishRequested;
}

must_use variant WorkloadPeerNetWakeResult {
    Cpu(usize);
    Block;
    Resumed;
    Refused;
}

// Observing the result on B's CPU is distinct from emitting it on the
// ordinary console's owner. Pending freezes the verdict until core 0 prints.
enum WorkloadRestartReportState { Waiting; Pending; Reported; }

struct WorkloadBusyPair {
    // The pid currently reporting under each tag, and how many times that
    // pid has changed -- which is init having respawned that entry.
    a_pid: usize;
    b_pid: usize;
    a_restarts: usize;
    b_restarts: usize;
    a_rounds: usize;
    b_rounds: usize;
    a_checksum: usize;
    b_checksum: usize;
    // Each tag's round count at the moment the second one first reported.
    // Skew is measured from there: whichever entry init forked first is
    // ahead by however long the second took to start, and that is startup
    // ordering, not starvation.
    a_base: usize;
    b_base: usize;
    both_running: bool;
    start_requested: bool;
    max_skew: usize;
    a_slices: usize;
    b_slices: usize;
    a_ticks: usize;
    b_ticks: usize;
    // GitHub issue #580: PER CPU, because the interval between two
    // selections belongs to the core that made them. These were one pair
    // shared by every core, so the time since the last selection ANYWHERE
    // was charged to whichever pid was selected last ANYWHERE. It read
    // plausibly while the secondary kept re-selecting its worker between
    // idle wakeups, and stopped the moment an ordinary process gave that
    // core something else to do: `cpu_a=26048999 cpu_b=0` for a worker that
    // had completed nine rounds.
    last_pid: [usize; KERNEL_MAX_CORES];
    last_tick: [usize; KERNEL_MAX_CORES];
    start_ticks: usize;
    end_ticks: usize;
    profile_cpu: usize;
    reported: bool;
    finish_ready: bool;
    finish_requested: bool;
    // The restart demonstration, which runs once after the fairness
    // verdict. `restart_requested` is this file having told tag A to exit;
    // the three `*_before` fields are what was true of the pair at that
    // moment, and what B is checked against when A's replacement speaks.
    restart_requested: bool;
    restart_a_pid_before: usize;
    restart_b_pid_before: usize;
    restart_b_rounds_before: usize;
    restart_report_state: WorkloadRestartReportState;
    a_last_cpu: usize;
    b_last_cpu: usize;
    a_cpu_seen: bool;
    b_cpu_seen: bool;
    a_migrations: usize;
    b_migrations: usize;
    migration_reported: bool;
    // The one post-migration exit that proves a peer can give up its
    // process stack, return to architectural idle, and leave init to reap
    // the zombie on core 0. The pid identifies that one lifetime only; init
    // may reuse its number for the replacement, so post-reap routing uses tag.
    peer_exit_pid: usize;
    peer_exit_tag: usize;
    peer_exit_cpu: usize;
    peer_exit_stack_released: bool;
    peer_exit_reported: bool;
    // The read-only filesystem fixture is admitted to a peer only after the
    // exit fixture above has completed. Its pid is fixed by its first tag-3
    // report, before it opens the fixture file.
    peer_read_pid: usize;
    peer_read_reported: bool;
    // The output-only process follows the filesystem reader. It registers
    // before writing, then belongs exclusively to the admitted peer until
    // one deliberately over-capacity write and its retry have completed.
    // A UART-BREAK DDB lane keeps it for one more record: held, pending,
    // then released by the debugger's entry.
    peer_console_pid: usize;
    peer_console_initial_reported: bool;
    peer_console_holding: bool;
    peer_console_pending: bool;
    peer_console_reported: bool;
    // GitHub issue #547: the terminal reader the persistent shell starts
    // after the whole chain. Its pid is fixed by its first tag-5 report, and
    // it then runs only on the admitted secondary until its line is read.
    peer_tty_pid: usize;
    peer_tty_reading: bool;
    peer_tty_reported: bool;
    // A report this file refused: an unknown tag, or a caller that is not
    // a child of init. Zero on a healthy boot, and printed only when it
    // is not.
    refused: usize;
}

private let mut workload_busy_pair: WorkloadBusyPair;

// One peer process owns this one-shot NetRx publication test. The tag-6
// syscall registers it on CPU0, then asks the ordinary scheduler path to
// publish it Blocked before the CPU0 timer wake scans all slots.
private let mut workload_peer_net_wake_pid: usize;
private let mut workload_peer_net_wake_block_requested: bool;

enum WorkloadCpuMode { Idle; El0; El1; Irq; }

struct WorkloadProfileCore {
    mode: WorkloadCpuMode;
    irq_resume_mode: WorkloadCpuMode;
    last_tick: usize;
    el0_ticks: usize;
    el1_ticks: usize;
    irq_ticks: usize;
    idle_ticks: usize;
    context_switches: usize;
    blocks: usize;
    wakeups: usize;
    syscalls: usize;
    syscall_retrying: bool;
    block_read_bytes: usize;
    block_write_bytes: usize;
    network_rx_bytes: usize;
    network_tx_bytes: usize;
    selected_pid: usize;
    has_selected_pid: bool;
}

private let mut workload_profile_cores: [WorkloadProfileCore; KERNEL_MAX_CORES];
private let mut workload_profile_active: bool = false;

private fn workload_profile_core_reset(cpu: {0..<KERNEL_MAX_CORES as usize}) {
    workload_profile_cores[cpu].mode = WorkloadCpuMode::Idle;
    workload_profile_cores[cpu].irq_resume_mode = WorkloadCpuMode::Idle;
    workload_profile_cores[cpu].last_tick = 0;
    workload_profile_cores[cpu].el0_ticks = 0;
    workload_profile_cores[cpu].el1_ticks = 0;
    workload_profile_cores[cpu].irq_ticks = 0;
    workload_profile_cores[cpu].idle_ticks = 0;
    workload_profile_cores[cpu].context_switches = 0;
    workload_profile_cores[cpu].blocks = 0;
    workload_profile_cores[cpu].wakeups = 0;
    workload_profile_cores[cpu].syscalls = 0;
    workload_profile_cores[cpu].syscall_retrying = false;
    workload_profile_cores[cpu].block_read_bytes = 0;
    workload_profile_cores[cpu].block_write_bytes = 0;
    workload_profile_cores[cpu].network_rx_bytes = 0;
    workload_profile_cores[cpu].network_tx_bytes = 0;
    workload_profile_cores[cpu].selected_pid = 0;
    workload_profile_cores[cpu].has_selected_pid = false;
}

private fn workload_profile_charge(cpu: {0..<KERNEL_MAX_CORES as usize},
                                   now: usize) {
    if (workload_profile_cores[cpu].last_tick == 0) {
        workload_profile_cores[cpu].last_tick = now;
        return;
    }
    let spent: usize = now - workload_profile_cores[cpu].last_tick;
    match workload_profile_cores[cpu].mode {
        WorkloadCpuMode::Idle => {
            workload_profile_cores[cpu].idle_ticks =
                workload_profile_cores[cpu].idle_ticks + spent;
        }
        WorkloadCpuMode::El0 => {
            workload_profile_cores[cpu].el0_ticks =
                workload_profile_cores[cpu].el0_ticks + spent;
        }
        WorkloadCpuMode::El1 => {
            workload_profile_cores[cpu].el1_ticks =
                workload_profile_cores[cpu].el1_ticks + spent;
        }
        WorkloadCpuMode::Irq => {
            workload_profile_cores[cpu].irq_ticks =
                workload_profile_cores[cpu].irq_ticks + spent;
        }
    }
    workload_profile_cores[cpu].last_tick = now;
}

private fn workload_profile_transition_masked(next: WorkloadCpuMode) {
    // Syscall handling runs with IRQs enabled. Without one critical section,
    // a timer IRQ can charge from the same last_tick before this transition
    // stores its new boundary, making the classified total exceed wall time.
    let before_irq_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    if (workload_profile_active == false) {
        mutex_irq_restore(before_irq_masked);
        return;
    }
    let cpu: usize = cpu_id();
    if (cpu >= kernel_online_core_count() || cpu >= KERNEL_MAX_CORES) {
        mutex_irq_restore(before_irq_masked);
        return;
    }
    let bounded_cpu: {0..<KERNEL_MAX_CORES as usize} = cpu;
    workload_profile_charge(bounded_cpu, read_cntpct() as usize);
    workload_profile_cores[bounded_cpu].mode = next;
    mutex_irq_restore(before_irq_masked);
}

private fn workload_profile_transition(next: WorkloadCpuMode) {
    if (workload_profile_active == false) { return; }
    // EL1 syscall handling deliberately unmasks IRQs before entering Takibi
    // code (user_entry.S), so these transitions are not inherently atomic.
    // Save and restore DAIF.I rather than unconditionally enabling it: the
    // same helpers are also valid at callers that arrived already masked.
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    workload_profile_transition_masked(next);
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_el1_enter() { workload_profile_transition(WorkloadCpuMode::El1); }
fn workload_profile_el0_enter() { workload_profile_transition(WorkloadCpuMode::El0); }
fn workload_profile_idle_enter() { workload_profile_transition(WorkloadCpuMode::Idle); }

fn workload_profile_interrupt_wait() !{may_block} {
    workload_profile_idle_enter();
    interrupt_wait();
    workload_profile_el1_enter();
}

fn workload_profile_irq_enter() {
    if (workload_profile_active == false) { return; }
    let cpu: usize = cpu_id();
    if (cpu >= kernel_online_core_count() || cpu >= KERNEL_MAX_CORES) { return; }
    let bounded_cpu: {0..<KERNEL_MAX_CORES as usize} = cpu;
    profile_timeline_irq_enter(
        workload_profile_selected_pid(bounded_cpu));
    workload_profile_cores[bounded_cpu].irq_resume_mode =
        workload_profile_cores[bounded_cpu].mode;
    workload_profile_transition_masked(WorkloadCpuMode::Irq);
}

fn workload_profile_irq_exit() {
    if (workload_profile_active == false) { return; }
    let cpu: usize = cpu_id();
    if (cpu >= kernel_online_core_count() || cpu >= KERNEL_MAX_CORES) { return; }
    let bounded_cpu: {0..<KERNEL_MAX_CORES as usize} = cpu;
    profile_timeline_irq_exit(
        workload_profile_selected_pid(bounded_cpu));
    workload_profile_transition_masked(
        workload_profile_cores[bounded_cpu].irq_resume_mode);
}

private fn workload_profile_current_cpu() -> usize {
    // Callers hold their local IRQ mask from this activation check through
    // the last counter write. A future world-stop close can therefore wait
    // for a complete update, rather than resume a half-finished one later.
    if (workload_profile_active == false) { return KERNEL_MAX_CORES; }
    let cpu: usize = cpu_id();
    if (cpu >= kernel_online_core_count() || cpu >= KERNEL_MAX_CORES) {
        return KERNEL_MAX_CORES;
    }
    return cpu;
}

private fn workload_profile_selected_pid(
        cpu: {0..<KERNEL_MAX_CORES as usize}) -> usize {
    if (workload_profile_cores[cpu].has_selected_pid) {
        return workload_profile_cores[cpu].selected_pid;
    }
    return 0;
}

fn workload_profile_note_syscall(number: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    workload_profile_el1_enter();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        profile_timeline_syscall_enter(
            workload_profile_selected_pid(cpu), number);
        if (workload_profile_cores[cpu].syscall_retrying == false) {
            workload_profile_cores[cpu].syscalls =
                workload_profile_cores[cpu].syscalls + 1;
        }
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_syscall_wait(number: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        profile_timeline_syscall_wait(
            workload_profile_selected_pid(cpu), number);
        workload_profile_cores[cpu].syscall_retrying = true;
    }
    workload_profile_idle_enter();
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_syscall_complete(number: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        profile_timeline_syscall_exit(
            workload_profile_selected_pid(cpu), number);
        workload_profile_cores[cpu].syscall_retrying = false;
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_note_block(pid: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        profile_timeline_block(pid);
        workload_profile_cores[cpu].blocks = workload_profile_cores[cpu].blocks + 1;
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_note_wakeup(pid: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        profile_timeline_wakeup(pid);
        workload_profile_cores[cpu].wakeups = workload_profile_cores[cpu].wakeups + 1;
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_note_block_read(bytes: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        workload_profile_cores[cpu].block_read_bytes =
            workload_profile_cores[cpu].block_read_bytes + bytes;
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_note_block_write(bytes: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        workload_profile_cores[cpu].block_write_bytes =
            workload_profile_cores[cpu].block_write_bytes + bytes;
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_note_network_rx(bytes: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        workload_profile_cores[cpu].network_rx_bytes =
            workload_profile_cores[cpu].network_rx_bytes + bytes;
    }
    mutex_irq_restore(irq_was_masked);
}

fn workload_profile_note_network_tx(bytes: usize) {
    let irq_was_masked: usize = (mrs_daif() >> 7) & 1;
    disable_irq();
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        workload_profile_cores[cpu].network_tx_bytes =
            workload_profile_cores[cpu].network_tx_bytes + bytes;
    }
    mutex_irq_restore(irq_was_masked);
}

private fn workload_profile_start(
        stopped: borrow WorldStopped[stop],
        guard: borrow ProcessRunGuard[lock], now: usize, pid: usize) {
    let online: usize = kernel_online_core_count();
    let mut selected_at_start: [usize; KERNEL_MAX_CORES];
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        selected_at_start[cpu] = workload_profile_selected_pid(cpu);
    }
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        workload_profile_core_reset(cpu);
    }
    // A core with no transition during the interval is idle for the whole
    // interval, not absent from the partition. This also gives every active
    // core the same wall-time boundary for the future multicore re-audit.
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            workload_profile_cores[cpu].last_tick = now;
        }
    }
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let selected: usize = selected_at_start[cpu];
            workload_profile_cores[cpu].selected_pid = selected;
            workload_profile_cores[cpu].has_selected_pid = selected != 0;
        }
    }
    // The core opening the interval is known even when it has not crossed a
    // scheduler selection since the busy pair registered. Restore the other
    // cores first, then make this current witness authoritative; doing this
    // before the restore loop let a saved zero overwrite `pid`, and the
    // process-attributed CPU-time report intermittently assigned this core's
    // entire nonzero profile to nobody.
    let current_cpu: usize = cpu_id();
    if (current_cpu < online && current_cpu < KERNEL_MAX_CORES) {
        workload_profile_cores[current_cpu].mode = WorkloadCpuMode::El1;
        workload_profile_cores[current_cpu].last_tick = now;
        workload_profile_cores[current_cpu].selected_pid = pid;
        workload_profile_cores[current_cpu].has_selected_pid = true;
    }
    workload_profile_active = true;
    profile_timeline_start(
        workload_busy_pair.a_pid, workload_busy_pair.b_pid);
    // GitHub issue #572: the per-worker totals belong to THIS window, and
    // each core's interval opens here against whatever it is running. They
    // used to be derived at the end instead, which is the premise #580
    // breaks -- see workload_profile_finish.
    workload_busy_pair.a_ticks = 0;
    workload_busy_pair.b_ticks = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            let selected: usize = workload_profile_selected_pid(cpu);
            workload_busy_pair.last_pid[cpu] = selected;
            workload_busy_pair.last_tick[cpu] = now;
            profile_timeline_interval_start_cpu(stopped, cpu, selected, now);
        }
    }
    // The flat PC profile shares this interval exactly: same IRQ-masked
    // boundary, same start timestamp, so a sample outside the interval the
    // artifact reports cannot exist.
    profile_sample_start();
}

private fn workload_profile_finish(
        stopped: borrow WorldStopped[stop],
        guard: borrow ProcessRunGuard[lock], now: usize) {
    let online: usize = kernel_online_core_count();
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
            workload_profile_charge(cpu, now);
            profile_timeline_interval_finish_cpu(
                stopped, cpu, workload_profile_selected_pid(cpu), now);
        }
    }
    // GitHub issue #572: close each core's in-flight interval against the
    // pid that core was actually running, which is the step the selection-
    // driven charge cannot make on its own -- a core that never switches
    // again never closes its last interval.
    //
    // This replaces a derivation that summed each CPU's whole busy time and
    // attributed it to whichever pid was SELECTED when the window shut. That
    // was valid only while the scheduler boundary pinned A to core 0 and B
    // to core 1 for the entire interval, and it said so. GitHub issue #580's
    // default placement is exactly what ends that premise: with an ordinary
    // process able to reach a peer, the measurement reported
    // `cpu_a=26048999 cpu_b=0` for a worker that had completed nine rounds,
    // because B was not what core 1 had selected last.
    //
    // The charge below is the same one workload_busy_note_selected_locked
    // makes at every selection, applied once more at the boundary, so the
    // two halves now have one rule between them instead of two that
    // disagree above one core.
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online && workload_busy_pair.last_tick[cpu] != 0) {
            let spent: usize = now - workload_busy_pair.last_tick[cpu];
            if (workload_busy_pair.a_pid != 0 &&
                workload_busy_pair.last_pid[cpu] ==
                    workload_busy_pair.a_pid) {
                workload_busy_pair.a_ticks =
                    workload_busy_pair.a_ticks + spent;
            } else if (workload_busy_pair.b_pid != 0 &&
                       workload_busy_pair.last_pid[cpu] ==
                           workload_busy_pair.b_pid) {
                workload_busy_pair.b_ticks =
                    workload_busy_pair.b_ticks + spent;
            }
            workload_busy_pair.last_tick[cpu] = now;
        }
    }
    profile_timeline_finish();
    workload_profile_active = false;
    profile_sample_finish();
}

private fn workload_profile_note_selected(pid: usize) {
    // Reached only through workload_busy_note_selected_locked, under the
    // IRQ-masking ProcessRunGuard. Keep that mask across the update.
    let cpu: usize = workload_profile_current_cpu();
    if (cpu < KERNEL_MAX_CORES) {
        if (workload_profile_cores[cpu].has_selected_pid &&
            workload_profile_cores[cpu].selected_pid != pid) {
            workload_profile_cores[cpu].context_switches =
                workload_profile_cores[cpu].context_switches + 1;
        }
        workload_profile_cores[cpu].selected_pid = pid;
        workload_profile_cores[cpu].has_selected_pid = true;
    }
}

// Every time the scheduler picks one of the pair, counted where the pick
// happens. This is the fairness question asked of the SCHEDULER rather
// than of the workload: two processes doing identical work should be
// selected about equally often, and a round count that says otherwise
// cannot say whether the cause was the pick or the work.
fn workload_busy_note_selected_locked(
        guard: borrow ProcessRunGuard[lock], pid: usize) {
    // Free until the pair exists: every boot before this workload starts,
    // and every switch after the verdict, leaves here without reading the
    // counter. The scheduler calls this on every context switch.
    if (workload_busy_pair.a_pid == 0 && workload_busy_pair.b_pid == 0) {
        return;
    }
    workload_profile_note_selected(pid);
    let raw_cpu: usize = cpu_id();
    if (raw_cpu >= KERNEL_MAX_CORES) { return; }
    let core: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    let now: usize = read_cntpct() as usize;
    if (workload_busy_pair.last_tick[core] != 0) {
        let spent: usize = now - workload_busy_pair.last_tick[core];
        if (workload_busy_pair.a_pid != 0 &&
            workload_busy_pair.last_pid[core] == workload_busy_pair.a_pid) {
            workload_busy_pair.a_ticks = workload_busy_pair.a_ticks + spent;
        } else if (workload_busy_pair.b_pid != 0 &&
                   workload_busy_pair.last_pid[core] ==
                       workload_busy_pair.b_pid) {
            workload_busy_pair.b_ticks = workload_busy_pair.b_ticks + spent;
        }
    }
    workload_busy_pair.last_pid[core] = pid;
    workload_busy_pair.last_tick[core] = now;
    if (workload_busy_pair.a_pid != 0 && pid == workload_busy_pair.a_pid) {
        workload_busy_pair.a_slices = workload_busy_pair.a_slices + 1;
        if (workload_busy_pair.restart_report_state ==
                WorkloadRestartReportState::Reported) {
            if (workload_busy_pair.a_cpu_seen &&
                workload_busy_pair.a_last_cpu != cpu_id()) {
                workload_busy_pair.a_migrations =
                    workload_busy_pair.a_migrations + 1;
            }
            workload_busy_pair.a_last_cpu = cpu_id();
            workload_busy_pair.a_cpu_seen = true;
        }
    } else if (workload_busy_pair.b_pid != 0 && pid == workload_busy_pair.b_pid) {
        workload_busy_pair.b_slices = workload_busy_pair.b_slices + 1;
        if (workload_busy_pair.restart_report_state ==
                WorkloadRestartReportState::Reported) {
            if (workload_busy_pair.b_cpu_seen &&
                workload_busy_pair.b_last_cpu != cpu_id()) {
                workload_busy_pair.b_migrations =
                    workload_busy_pair.b_migrations + 1;
            }
            workload_busy_pair.b_last_cpu = cpu_id();
            workload_busy_pair.b_cpu_seen = true;
        }
    }
}

// B is the persistent secondary participant. A deliberately remains on the
// console-owning core because it exits once to exercise init's SIGCHLD respawn;
// moving that handoff to the peer would admit init and its I/O descendants to
// subsystems whose non-pool state has not completed the multicore audit.
fn workload_busy_secondary_candidate(pid: usize) -> bool {
    if (workload_busy_pair.a_pid == 0 || workload_busy_pair.b_pid == 0) {
        return false;
    }
    // Once a peer exit is armed, keep only that currently-running process
    // admitted until the physical idle-stack boundary publishes its release.
    // The idle loop immediately asks this policy again, so widening here lets
    // it select the next workload without waiting for a second idle wakeup.
    if (workload_busy_pair.peer_exit_pid != 0 &&
        workload_busy_pair.peer_exit_stack_released == false) {
        return pid == workload_busy_pair.peer_exit_pid;
    }
    // GitHub issue #9: the console writer and the terminal reader are not
    // named here, and GitHub issue #581 removed the last one that was. Each
    // asks its progress handler for the CPU when its turn comes and pins
    // itself to it, so their admission is their own affinity mask. The
    // filesystem reader needed a rule only while its file reads were
    // outside the kernel's peer-safety table; they are in it now, so it
    // pins like the other two.
    if (workload_busy_pair.restart_report_state ==
            WorkloadRestartReportState::Reported) {
        return pid == workload_busy_pair.a_pid ||
               pid == workload_busy_pair.b_pid;
    }
    return pid == workload_busy_pair.b_pid;
}

// GitHub issue #581: nothing is excluded from core 0 by name any more. The
// peer reader used to be: it registers before opening the fixture and then
// belongs exclusively to CPU 1, and excluding it here was the other half of
// secondary admission. It pins itself now, like the console writer and the
// terminal reader, so a mask says where it runs and this rule says nothing
// about it -- which is what keeps its reads contending with core 0's
// whatever the placement policy becomes.
fn workload_busy_primary_candidate(pid: usize) -> bool {
    return true;
}

fn workload_busy_note_selected(pid: usize) {
    let guard = process_run_lock();
    workload_busy_note_selected_locked(guard, pid);
    process_run_unlock(guard);
}

private fn workload_busy_absolute_difference(left: usize, right: usize)
        -> usize {
    if (left > right) { return left - right; }
    return right - left;
}

// One process's report that it finished another round of work.
//
// The answer is an instruction to the caller, so that what the fixture is
// doing lives here rather than being duplicated in the two programs:
//
//   0  keep working and keep reporting
//   1  keep working, stop reporting -- everything this file wanted is done
//   2  exit now, so init is made to respawn you
//
// A CPU-bound process that stopped being CPU-bound would stop being the
// thing a second core is measured against, which is why 1 is "stop
// reporting" and not "stop".
private fn workload_busy_record_progress_locked(
        guard: borrow ProcessRunGuard[lock], tag: usize, checksum: usize,
        input_steps: usize) -> WorkloadBusyProgressResult !{unsafe} {
    if (workload_busy_pair.restart_report_state ==
            WorkloadRestartReportState::Reported) {
        if (workload_busy_pair.migration_reported == false && cpu_id() != 0 &&
            workload_busy_pair.a_migrations >= WORKLOAD_BUSY_MIGRATION_GOAL &&
            workload_busy_pair.b_migrations >= WORKLOAD_BUSY_MIGRATION_GOAL) {
            kernel_boot_log(
                "\nworkload: busy pair migrated across both cpus with stack handoff intact\n");
            workload_busy_pair.migration_reported = true;
            workload_busy_pair.peer_exit_pid = kernel_process_current_pid();
            workload_busy_pair.peer_exit_tag = tag;
        }
        if (workload_busy_pair.migration_reported) {
            // Ask exactly the armed process to exit, and only while it is
            // actually running on a peer. Before reap, its pid names that
            // lifetime; after reap, the stable tag routes the replacement
            // and survivor to the two filesystem images.
            if (workload_busy_pair.peer_exit_reported == false) {
                if (workload_busy_pair.peer_exit_pid ==
                        kernel_process_current_pid() && cpu_id() != 0) {
                    workload_busy_pair.peer_exit_cpu = cpu_id();
                    return WorkloadBusyProgressResult::Value(2);
                }
                return WorkloadBusyProgressResult::Value(0);
            }
            if (tag == workload_busy_pair.peer_exit_tag) {
                return WorkloadBusyProgressResult::Value(4);
            }
            return WorkloadBusyProgressResult::Value(5);
        }
        return WorkloadBusyProgressResult::Value(0);
    }
    if (workload_busy_pair.restart_report_state ==
            WorkloadRestartReportState::Pending) {
        if (cpu_id() != 0) { return WorkloadBusyProgressResult::Value(0); }
        workload_busy_report_restart(guard);
        return WorkloadBusyProgressResult::Value(1);
    }
    // Started by init, from /etc/inittab. A report from anywhere else is
    // not this workload, and counting it would let an unrelated process
    // satisfy the fairness assertion on the real one's behalf.
    if (kernel_process_parent_is_root() == false) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        return WorkloadBusyProgressResult::Value(0);
    }
    let pid: usize = kernel_process_current_pid();
    if (tag != WORKLOAD_BUSY_TAG_A && tag != WORKLOAD_BUSY_TAG_B) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        return WorkloadBusyProgressResult::Value(0);
    }
    // Once both tags reached the exact round goal, freeze their counters and
    // let only the CPU that armed the local PMU request the close. Both busy
    // processes keep reporting, so the owner reaches this path without
    // requiring migration or a remote PMU operation.
    if (workload_busy_pair.finish_ready &&
            workload_busy_pair.reported == false) {
        if ((tag == WORKLOAD_BUSY_TAG_A &&
             pid != workload_busy_pair.a_pid) ||
            (tag == WORKLOAD_BUSY_TAG_B &&
             pid != workload_busy_pair.b_pid)) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            return WorkloadBusyProgressResult::Value(0);
        }
        if (cpu_id() == workload_busy_pair.profile_cpu) {
            workload_busy_pair.finish_requested = true;
            return WorkloadBusyProgressResult::FinishRequested;
        }
        return WorkloadBusyProgressResult::Value(0);
    }
    if (tag == WORKLOAD_BUSY_TAG_A) {
        if (workload_busy_pair.a_pid == 0) {
            workload_busy_pair.a_pid = pid;
        } else if (workload_busy_pair.a_pid != pid) {
            workload_busy_pair.a_pid = pid;
            workload_busy_pair.a_restarts = workload_busy_pair.a_restarts + 1;
        }
        workload_busy_pair.a_rounds = workload_busy_pair.a_rounds + 1;
        workload_busy_pair.a_checksum = checksum;
    } else if (tag == WORKLOAD_BUSY_TAG_B) {
        if (workload_busy_pair.b_pid == 0) {
            workload_busy_pair.b_pid = pid;
        } else if (workload_busy_pair.b_pid != pid) {
            workload_busy_pair.b_pid = pid;
            workload_busy_pair.b_restarts = workload_busy_pair.b_restarts + 1;
        }
        workload_busy_pair.b_rounds = workload_busy_pair.b_rounds + 1;
        workload_busy_pair.b_checksum = checksum;
    }
    if (workload_busy_pair.both_running == false) {
        if (workload_busy_pair.a_pid == 0 || workload_busy_pair.b_pid == 0) {
            return WorkloadBusyProgressResult::Value(0);
        }
        if (workload_busy_pair.start_requested) {
            return WorkloadBusyProgressResult::Value(0);
        }
        workload_busy_pair.start_requested = true;
        return WorkloadBusyProgressResult::StartRequested;
    }
    if (workload_busy_pair.reported) {
        return WorkloadBusyProgressResult::Value(
            workload_busy_restart_step(guard, tag));
    }
    if (workload_busy_pair.finish_requested) {
        return WorkloadBusyProgressResult::Value(0);
    }
    let a_progress: usize =
        workload_busy_pair.a_rounds - workload_busy_pair.a_base;
    let b_progress: usize =
        workload_busy_pair.b_rounds - workload_busy_pair.b_base;
    let skew: usize =
        workload_busy_absolute_difference(a_progress, b_progress);
    if (skew > workload_busy_pair.max_skew) {
        workload_busy_pair.max_skew = skew;
    }
    if (a_progress < WORKLOAD_BUSY_ROUNDS || b_progress < WORKLOAD_BUSY_ROUNDS) {
        return WorkloadBusyProgressResult::Value(0);
    }
    workload_busy_pair.finish_ready = true;
    if (cpu_id() != workload_busy_pair.profile_cpu) {
        return WorkloadBusyProgressResult::Value(0);
    }
    // Reserve the close while serialized, then leave the run lock before
    // asking peers to stop. A peer spinning for this IRQ-masking lock cannot
    // acknowledge the stop SGI until this guard is released.
    workload_busy_pair.finish_requested = true;
    return WorkloadBusyProgressResult::FinishRequested;
}

// Called at the physical boundary after the peer has moved from the exiting
// process stack to its architectural IRQ/idle stack. ProcessRunGuard orders
// this publication before core 0 can take and reap the zombie.
fn workload_busy_peer_exit_stack_released(pid: usize, cpu: usize) {
    if (workload_busy_pair.peer_exit_pid == pid &&
        workload_busy_pair.peer_exit_cpu == cpu && cpu != 0) {
        workload_busy_pair.peer_exit_stack_released = true;
    }
}

// Called immediately before the target zombie's record is consumed. The
// caller has already checked the real ProcessRecord's stack_owner_cpu, so the
// fixed line is end-to-end evidence rather than a synthetic state probe.
fn workload_busy_peer_exit_reaped(pid: usize, parent_pid: usize,
                                  stack_unowned: bool) {
    if (workload_busy_pair.peer_exit_reported == false &&
        workload_busy_pair.peer_exit_pid == pid &&
        workload_busy_pair.peer_exit_stack_released && stack_unowned &&
        cpu_id() == 0 && parent_pid == 1) {
        kernel_boot_log(
            "workload: peer exit returned to idle, init collected on core 0 after stack release\n");
        workload_busy_pair.peer_exit_reported = true;
    }
}

// Tag 3 belongs to /bin/peer-read, not to the CPU-bound pair. The first call
// registers the init child for peer admission. Later calls claim one complete
// 96 KiB read; accept one only when it returns on a peer and both CPUs have
// actually waited for the device mutex at least once.
fn workload_peer_read_progress(bytes: usize, checksum: usize) -> usize {
    let guard = process_run_lock();
    let pid: usize = kernel_process_current_pid();
    if (workload_busy_pair.peer_read_pid == 0) {
        if (kernel_process_parent_is_root() == false) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        } else {
            workload_busy_pair.peer_read_pid = pid;
        }
        process_run_unlock(guard);
        return SECONDARY_CORE_ID;
    }
    if (pid != workload_busy_pair.peer_read_pid ||
        workload_busy_pair.peer_read_reported || bytes != 98304 ||
        checksum != 8847360 || cpu_id() != SECONDARY_CORE_ID) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        process_run_unlock(guard);
        return 0;
    }
    if (block_read_call_count(SECONDARY_CORE_ID) == 0 ||
        block_device_wait_count(0) == 0 ||
        block_device_wait_count(SECONDARY_CORE_ID) == 0) {
        process_run_unlock(guard);
        return 0;
    }
    workload_busy_pair.peer_read_reported = true;
    kernel_boot_log(
        "workload: peer read 98304 pattern bytes; block device mutex contended on both cpus\n");
    process_run_unlock(guard);
    return 2;
}

// GitHub issue #587: the peer waiter fixture runs the real scheduler block
// and timer wake paths without admitting socket calls on a peer. Re-entry of
// the same test syscall proves the Blocked record was woken and selected.
fn workload_peer_net_wake_progress(step: usize)
        -> WorkloadPeerNetWakeResult !{unsafe} {
    let guard = process_run_lock();
    let pid: usize = kernel_process_current_pid();
    if (step == 0 && workload_peer_net_wake_pid == 0) {
        workload_peer_net_wake_pid = pid;
        process_run_unlock(guard);
        return WorkloadPeerNetWakeResult::Cpu(SECONDARY_CORE_ID);
    }
    if (pid != workload_peer_net_wake_pid ||
        cpu_id() != SECONDARY_CORE_ID) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        process_run_unlock(guard);
        return WorkloadPeerNetWakeResult::Refused;
    }
    if (step == 1 && workload_peer_net_wake_block_requested == false) {
        workload_peer_net_wake_block_requested = true;
        process_run_unlock(guard);
        return WorkloadPeerNetWakeResult::Block;
    }
    if (step == 1 && workload_peer_net_wake_block_requested &&
        kernel_process_current_pending_block_reason() ==
            ProcessWaitReason::None) {
        process_run_unlock(guard);
        return WorkloadPeerNetWakeResult::Resumed;
    }
    workload_busy_pair.refused = workload_busy_pair.refused + 1;
    process_run_unlock(guard);
    return WorkloadPeerNetWakeResult::Refused;
}

// Tag 4 belongs to /bin/peer-console. Registration happens before its first
// write, and the process then stays off core 0. The first write is exactly
// seventeen publication records while the ring holds sixteen, so accepting
// only 1024 bytes proves the full-ring path returned a short count. The
// payload retries the remaining record and reports all 1088 bytes only after
// write(2) has accepted them.
//
// Returns 0 for a refused report, 1 to keep polling, 2 to exit, and 3 to
// write the one record a UART-BREAK DDB lane holds.
fn workload_peer_console_progress(first: usize, total: usize) -> usize {
    let guard = process_run_lock();
    let pid: usize = kernel_process_current_pid();
    if (workload_busy_pair.peer_console_pid == 0) {
        if (kernel_process_parent_is_root() == false) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        }
        // GitHub issue #9: this answer carries the writer's TURN now, not
        // its admission -- the fixture pins itself to the CPU named here.
        // So hold the name back until the filesystem reader has its
        // verdict, which the admission rule used to do. Not a refusal: init
        // starts this writer long before that, and it asks again.
        if (workload_busy_pair.peer_read_reported == false) {
            process_run_unlock(guard);
            return 0;
        }
        workload_busy_pair.peer_console_pid = pid;
        process_run_unlock(guard);
        return SECONDARY_CORE_ID;
    }
    if (pid != workload_busy_pair.peer_console_pid ||
        workload_busy_pair.peer_console_reported ||
        cpu_id() != SECONDARY_CORE_ID) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        process_run_unlock(guard);
        return 0;
    }
    if (workload_busy_pair.peer_console_initial_reported == false) {
        if (workload_busy_pair.peer_read_reported == false ||
            first != 1024 || total != 1088) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        }
        workload_busy_pair.peer_console_initial_reported = true;
        kernel_boot_log(
            "workload: peer console short-wrote 1024 of 1088 bytes, then delivered the final record\n");
        if (kernel_ddb_peer_console_test_enabled == false) {
            workload_busy_pair.peer_console_reported = true;
            process_run_unlock(guard);
            return 2;
        }
        process_run_unlock(guard);
        return 1;
    }
    // The DDB phase. Hold only once core 0 has drained every earlier
    // record, so the hold covers the DDB record alone and the view's
    // seventeen records reach the wire whether or not a debugger follows.
    if (workload_busy_pair.peer_console_holding == false) {
        if (first != 0 || total != 0) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        }
        if (peer_console_drained(SECONDARY_CORE_ID) == false) {
            process_run_unlock(guard);
            return 1;
        }
        workload_busy_pair.peer_console_holding = true;
        peer_console_ddb_hold(SECONDARY_CORE_ID);
        process_run_unlock(guard);
        return 3;
    }
    if (first != 0 || total != 0) {
        if (workload_busy_pair.peer_console_pending ||
            first != 64 || total != 64) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        }
        workload_busy_pair.peer_console_pending = true;
        peer_console_ddb_note_pending(SECONDARY_CORE_ID);
        kernel_boot_log("workload: peer console record pending for DDB\n");
        process_run_unlock(guard);
        return 1;
    }
    if (workload_busy_pair.peer_console_pending &&
        peer_console_ddb_released_since_hold(SECONDARY_CORE_ID)) {
        peer_console_ddb_clear(SECONDARY_CORE_ID);
        workload_busy_pair.peer_console_reported = true;
        process_run_unlock(guard);
        return 2;
    }
    process_run_unlock(guard);
    return 1;
}

// The line scripts/run_kernel_uart_driver.py types, "peer-tty-line-ok\n":
// its length, and the sum of each byte times its one-based position.
const PEER_TTY_LINE_BYTES: usize = 17;
// GitHub issue #9 phase B entry 6. Nine calls -- uname, sysinfo, getcwd,
// set_tid_address, prlimit64 read and write, chdir, setitimer and
// rt_sigaction -- and the
// position-weighted sum of uname's `machine` field, "aarch64":
// 97*1 + 97*2 + 114*3 + 99*4 + 104*5 + 54*6 + 52*7 = 2237. The fixture
// answers 0 for any failure, so a wrong placement, a wrong return, a
// mismatched machine string and a sysinfo tail that is not zero all arrive
// as the same refusal rather than as a number close to the right one.
const PEER_TTY_IDENTITY_CALLS: usize = 9;
const PEER_TTY_MACHINE_CHECKSUM: usize = 2237;
const PEER_TTY_LINE_CHECKSUM: usize = 13224;

// Tag 5 belongs to /bin/peer-tty (GitHub issue #547), which the persistent
// shell starts once the chain above is done. It registers before it reads,
// then runs only on the admitted secondary and reports twice. The first
// report, (0, 0), says it is about to read the terminal. The second gives
// the count and the position-weighted sum of the line it read, each byte
// read on the secondary.
//
// Returns 0 for a refused report, the secondary CPU on registration, 1 once
// reading is announced, and 2 when the line is accepted and it may exit.
fn workload_peer_tty_progress(count: usize, checksum: usize) -> usize {
    let guard = process_run_lock();
    let pid: usize = kernel_process_current_pid();
    if (workload_busy_pair.peer_tty_pid == 0) {
        if (workload_busy_pair.peer_console_initial_reported == false) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        }
        workload_busy_pair.peer_tty_pid = pid;
        process_run_unlock(guard);
        return SECONDARY_CORE_ID;
    }
    if (pid != workload_busy_pair.peer_tty_pid ||
        workload_busy_pair.peer_tty_reported ||
        cpu_id() != SECONDARY_CORE_ID) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        process_run_unlock(guard);
        return 0;
    }
    if (workload_busy_pair.peer_tty_reading == false) {
        if (count != PEER_TTY_IDENTITY_CALLS ||
            checksum != PEER_TTY_MACHINE_CHECKSUM) {
            workload_busy_pair.refused = workload_busy_pair.refused + 1;
            process_run_unlock(guard);
            return 0;
        }
        workload_busy_pair.peer_tty_reading = true;
        kernel_boot_log(
            "workload: peer tty answered every peer-safe per-process call on the secondary cpu, reads and writes, each checked for content\n");
        kernel_boot_log(
            "workload: peer tty reading the terminal on the secondary cpu\n");
        process_run_unlock(guard);
        return 1;
    }
    if (count != PEER_TTY_LINE_BYTES || checksum != PEER_TTY_LINE_CHECKSUM) {
        workload_busy_pair.refused = workload_busy_pair.refused + 1;
        process_run_unlock(guard);
        return 0;
    }
    workload_busy_pair.peer_tty_reported = true;
    kernel_boot_log(
        "workload: peer tty read its 17-byte line on the secondary cpu, none lost, repeated or reordered\n");
    process_run_unlock(guard);
    return 2;
}

private fn workload_busy_start_profile(pid: usize, input_steps: usize)
        !{unsafe} {
    match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                           WORKLOAD_PROFILE_WORLD_STOP_SPINS) {
        WorldStopResult::Busy => {
            let retry_guard = process_run_lock();
            workload_busy_pair.start_requested = false;
            process_run_unlock(retry_guard);
        }
        WorldStopResult::Partial(partial) => {
            world_stop_partial_release(partial, &kernel_world_stop);
            let retry_guard = process_run_lock();
            workload_busy_pair.start_requested = false;
            process_run_unlock(retry_guard);
        }
        WorldStopResult::Complete(stopped) => {
            let start_guard = process_run_lock();
            if (workload_busy_pair.start_requested &&
                    workload_busy_pair.both_running == false &&
                    workload_busy_pair.a_pid != 0 &&
                    workload_busy_pair.b_pid != 0) {
                // Both have spoken and remain serialized. Reset every CPU at
                // the actual stopped boundary, not at the earlier request.
                workload_busy_pair.both_running = true;
                workload_busy_pair.start_requested = false;
                workload_busy_pair.a_base = workload_busy_pair.a_rounds;
                workload_busy_pair.b_base = workload_busy_pair.b_rounds;
                workload_busy_pair.start_ticks = read_cntpct() as usize;
                workload_busy_pair.profile_cpu = cpu_id();
                workload_profile_start(
                    stopped, start_guard, workload_busy_pair.start_ticks, pid);
                workload_busy_pair.a_ticks = 0;
                workload_busy_pair.b_ticks = 0;
                for reset_cpu: usize in 0..<KERNEL_MAX_CORES {
                    workload_busy_pair.last_pid[reset_cpu] = 0;
                    workload_busy_pair.last_tick[reset_cpu] = 0;
                }
                kernel_boot_log("profile: begin name=busy-pair input_steps=");
                uart_put_udec(input_steps);
                kernel_boot_log(" cpu_count=");
                uart_put_udec(kernel_online_core_count());
                kernel_boot_log(" iterations_goal=");
                uart_put_udec(WORKLOAD_BUSY_ROUNDS * 2);
                kernel_boot_log(" pid_a=");
                uart_put_udec(workload_busy_pair.a_pid);
                kernel_boot_log(" pid_b=");
                uart_put_udec(workload_busy_pair.b_pid);
                kernel_boot_log("\n");
            }
            process_run_unlock(start_guard);
            world_stop_release(stopped, &kernel_world_stop);
        }
    }
}

fn workload_busy_record_progress(tag: usize, checksum: usize,
                                 input_steps: usize) -> usize !{unsafe} {
    let guard = process_run_lock();
    match workload_busy_record_progress_locked(
            guard, tag, checksum, input_steps) {
        WorkloadBusyProgressResult::Value(value) => {
            process_run_unlock(guard);
            return value;
        }
        WorkloadBusyProgressResult::StartRequested => {
            process_run_unlock(guard);
            workload_busy_start_profile(
                kernel_process_current_pid(), input_steps);
            return 0;
        }
        WorkloadBusyProgressResult::FinishRequested => {
            process_run_unlock(guard);
        }
    }
    match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                           WORKLOAD_PROFILE_WORLD_STOP_SPINS) {
        WorldStopResult::Busy => {
            let retry_guard = process_run_lock();
            workload_busy_pair.finish_requested = false;
            process_run_unlock(retry_guard);
        }
        WorldStopResult::Partial(partial) => {
            world_stop_partial_release(partial, &kernel_world_stop);
            let retry_guard = process_run_lock();
            workload_busy_pair.finish_requested = false;
            process_run_unlock(retry_guard);
        }
        WorldStopResult::Complete(stopped) => {
            let finish_guard = process_run_lock();
            // The reservation is still serialized by ProcessRunGuard. With
            // peers stopped, no producer can resume between the final charge
            // and publication of inactive state.
            if (workload_busy_pair.finish_requested &&
                    workload_busy_pair.reported == false) {
                workload_busy_pair.end_ticks = read_cntpct() as usize;
                workload_profile_finish(
                    stopped, finish_guard, workload_busy_pair.end_ticks);
                workload_busy_pair.reported = true;
                workload_busy_pair.finish_requested = false;
                workload_busy_pair_report();
            }
            process_run_unlock(finish_guard);
            world_stop_release(stopped, &kernel_world_stop);
        }
    }
    // Not 1: the pair keeps reporting, because the restart demonstration is
    // driven entirely by which of them speaks next.
    return 0;
}

// The second half of the fixture: init brings back the entry that died, and
// only that entry.
//
// Making one of the pair die is this file's job rather than an external test
// driver's: answer 3 asks that EL0 process to send SIGTERM to itself. This
// exercises kill(2), child-exit SIGCHLD delivery, and init's respawn path in
// one deterministic fixture.
//
// A is chosen arbitrarily. B is the control: its pid must be the one it
// already had (init did not restart it too) and its counter must have moved
// while A was away (it kept running rather than waiting on its sibling).
private fn workload_busy_restart_step(
        guard: borrow ProcessRunGuard[lock], tag: usize) -> usize !{unsafe} {
    if (workload_busy_pair.restart_requested == false) {
        if (tag != WORKLOAD_BUSY_TAG_A) { return 0; }
        workload_busy_pair.restart_requested = true;
        workload_busy_pair.restart_a_pid_before = workload_busy_pair.a_pid;
        workload_busy_pair.restart_b_pid_before = workload_busy_pair.b_pid;
        workload_busy_pair.restart_b_rounds_before =
            workload_busy_pair.b_rounds;
        return 3;
    }
    // A's replacement has spoken once the restart counter moved -- that is
    // a report under tag A from a pid that is not the one told to terminate.
    if (workload_busy_pair.a_restarts == 0) { return 0; }
    // Then wait for B to finish another round before judging. Asking at A's
    // replacement instead made "B kept going" a race against how fast the
    // board respawns: on RPi5 the fork and exec beat B's next round and the
    // check failed on a boot where nothing was wrong. Waiting for B's own
    // next report asks the same question with no clock in it.
    if (tag != WORKLOAD_BUSY_TAG_B) { return 0; }
    workload_busy_pair.restart_report_state = WorkloadRestartReportState::Pending;
    // B alone establishes the original predicate. A later progress call on
    // core 0 only prints that frozen result; it cannot count another round
    // or change the success/failure decision while the report is pending.
    if (cpu_id() != 0) { return 0; }
    workload_busy_report_restart(guard);
    return 1;
}

private fn workload_busy_report_restart(guard: borrow ProcessRunGuard[lock]) {
    if (workload_busy_pair.a_restarts == 1 &&
        workload_busy_pair.b_restarts == 0 &&
        workload_busy_pair.b_pid == workload_busy_pair.restart_b_pid_before &&
        workload_busy_pair.b_rounds >
            workload_busy_pair.restart_b_rounds_before) {
        kernel_boot_log(
            "workload: busy pair init restarted a only, b kept its pid and its counter\n");
    } else {
        kernel_boot_log("workload: busy pair RESTART a=");
        uart_put_udec(workload_busy_pair.a_restarts);
        kernel_boot_log(" b=");
        uart_put_udec(workload_busy_pair.b_restarts);
        kernel_boot_log(" b_pid_moved=");
        if (workload_busy_pair.b_pid !=
                workload_busy_pair.restart_b_pid_before) {
            kernel_boot_log("yes");
        } else {
            kernel_boot_log("no");
        }
        kernel_boot_log(" b_rounds=");
        uart_put_udec(workload_busy_pair.b_rounds -
                      workload_busy_pair.restart_b_rounds_before);
        kernel_boot_log("\n");
    }
    // The host starts its interactive workload at this marker. That supplies
    // the third runnable context which lets the two currently Running busy
    // processes become Ready in turn and exchange CPUs.
    kernel_boot_log("workload: busy pair done\n");
    workload_busy_pair.restart_report_state = WorkloadRestartReportState::Reported;
}

// The verdict, and the numbers behind it.
//
// Two lines on purpose. The first is fixed text a view can match exactly:
// it says what held, and it is absent when it did not. The second carries
// the measurements, which are machine- and load-dependent and therefore
// belong in the capture for a person (and for the one-core versus
// two-core comparison) rather than in a fixture's expected output.
private fn workload_busy_pair_report() !{unsafe} {
    let online: usize = kernel_online_core_count();
    if (workload_busy_pair.a_pid != workload_busy_pair.b_pid) {
        kernel_boot_log("workload: busy pair two pids under init, ");
        uart_put_udec(WORKLOAD_BUSY_ROUNDS);
        kernel_boot_log(
            " rounds each completed beside the init-managed httpd service\n");
    } else if (workload_busy_pair.a_pid == workload_busy_pair.b_pid) {
        kernel_boot_log("workload: busy pair ONE pid reported both tags\n");
    }
    // The throughput half. `elapsed` is what the pair took wall-clock;
    // `cpu` is what each was actually given, which is the number a second
    // core has to change. Both in counter ticks, with the frequency beside
    // them so a reader needs nothing else to turn them into seconds.
    kernel_boot_log("workload: busy pair measured skew=");
    uart_put_udec(workload_busy_pair.max_skew);
    kernel_boot_log(" rounds=");
    uart_put_udec(WORKLOAD_BUSY_ROUNDS * 2);
    kernel_boot_log(" elapsed=");
    uart_put_udec(workload_busy_pair.end_ticks -
                  workload_busy_pair.start_ticks);
    kernel_boot_log(" cpu_a=");
    uart_put_udec(workload_busy_pair.a_ticks);
    kernel_boot_log(" cpu_b=");
    uart_put_udec(workload_busy_pair.b_ticks);
    kernel_boot_log(" slices=");
    uart_put_udec(workload_busy_pair.a_slices);
    kernel_boot_log("/");
    uart_put_udec(workload_busy_pair.b_slices);
    kernel_boot_log(" tickfreq=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log(" restarts=");
    uart_put_udec(workload_busy_pair.a_restarts +
                  workload_busy_pair.b_restarts);
    kernel_boot_log("\n");
    kernel_boot_log("profile: end name=busy-pair elapsed_cycles=");
    uart_put_udec(workload_busy_pair.end_ticks -
                  workload_busy_pair.start_ticks);
    kernel_boot_log(" tick_frequency=");
    uart_put_udec(read_cntfrq() as usize);
    kernel_boot_log(" iterations_a=");
    uart_put_udec(workload_busy_pair.a_rounds - workload_busy_pair.a_base);
    kernel_boot_log(" iterations_b=");
    uart_put_udec(workload_busy_pair.b_rounds - workload_busy_pair.b_base);
    kernel_boot_log(" result_count=2 checksum_a=");
    uart_put_udec(workload_busy_pair.a_checksum);
    kernel_boot_log(" checksum_b=");
    uart_put_udec(workload_busy_pair.b_checksum);
    kernel_boot_log("\n");
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) {
        kernel_boot_log("profile: cpu name=busy-pair cpu=");
        uart_put_udec(cpu);
        kernel_boot_log(" wall_cycles=");
        uart_put_udec(workload_busy_pair.end_ticks -
                      workload_busy_pair.start_ticks);
        kernel_boot_log(" el0_cycles=");
        uart_put_udec(workload_profile_cores[cpu].el0_ticks);
        kernel_boot_log(" el1_cycles=");
        uart_put_udec(workload_profile_cores[cpu].el1_ticks);
        kernel_boot_log(" irq_cycles=");
        uart_put_udec(workload_profile_cores[cpu].irq_ticks);
        kernel_boot_log(" idle_cycles=");
        uart_put_udec(workload_profile_cores[cpu].idle_ticks);
        kernel_boot_log(" context_switches=");
        uart_put_udec(workload_profile_cores[cpu].context_switches);
        kernel_boot_log(" blocks=");
        uart_put_udec(workload_profile_cores[cpu].blocks);
        kernel_boot_log(" wakeups=");
        uart_put_udec(workload_profile_cores[cpu].wakeups);
        kernel_boot_log(" syscalls=");
        uart_put_udec(workload_profile_cores[cpu].syscalls);
        kernel_boot_log(" block_read_bytes=");
        uart_put_udec(workload_profile_cores[cpu].block_read_bytes);
        kernel_boot_log(" block_write_bytes=");
        uart_put_udec(workload_profile_cores[cpu].block_write_bytes);
        kernel_boot_log(" network_rx_bytes=");
        uart_put_udec(workload_profile_cores[cpu].network_rx_bytes);
        kernel_boot_log(" network_tx_bytes=");
        uart_put_udec(workload_profile_cores[cpu].network_tx_bytes);
        kernel_boot_log("\n");
        }
    }
    profile_timeline_report(
        workload_busy_pair.start_ticks, workload_busy_pair.end_ticks);
    if (workload_busy_pair.refused != 0) {
        kernel_boot_log("workload: busy pair REFUSED reports=");
        uart_put_udec(workload_busy_pair.refused);
        kernel_boot_log("\n");
    }
    // Last, because scripts/profile_kernel_samples.py requires every
    // `profile: sample` record to fall between this interval's `profile:
    // end` and its `profile: sample-summary`.
    profile_sample_report();
}

// GitHub issue #479: this file had no execution-model assertion and holds
// the state a busy-loop process reports into -- which is precisely the
// state a process on a SECOND core would report into. It was found by
// chasing which syscall the busy loop actually makes, the same accidental
// way kernel/mm/page.tkb was, which is why
// scripts/check_execution_model_coverage.py now exists.
//
// What is and is not shared here, because the answer is not uniform:
//
// The busy-pair verdict is now under ProcessRunGuard. That includes the
// apparently partitioned per-tag fields because the verdict compares them:
// a reader taking a lock is not synchronized with an unlocked writer.
// Scheduler paths already in a process-run section thread their guard into
// workload_busy_note_selected_locked; all other scheduler and syscall paths
// acquire through the public wrappers, so nested acquisition is explicit and
// rejected by the linear guard API rather than becoming a runtime deadlock.
//
// Profile start/finish now require both machine quiescence and ProcessRunGuard:
// the first prevents per-core producers from changing the arrays, while the
// second serializes the busy-pair state that decides which boundary is valid.
// Flat PC sampling intentionally remains single-core: the stopped start
// boundary records which CPU armed its local PMU, round counters freeze at
// their exact goal, and only that CPU may request the stopped finish boundary.
// Workload accounting and timeline storage remain per-core and cover every
// active CPU; only the optional PC sample source has one explicit owner.
