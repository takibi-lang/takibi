// GitHub issue #508: does kernel/lib/occupancy.tkb's give-up path work?
//
// `occupancy_drain` has two outcomes. `Empty(proof)` runs on every boot,
// because every probe that tears down what it raced for ends with one.
// `Busy` had never executed, on QEMU or on RPi5 -- so the branch that
// exists precisely for the situation where something has gone wrong was
// the branch with no evidence behind it. That is the wrong way round: a
// give-up path is worth having only if it works when the thing it guards
// against actually happens, and by then nobody is in a position to debug
// it.
//
// It becomes load-bearing with issue #504, which proposes this token as
// the mechanism DDB and the page allocator both accept in place of a
// lock. `Busy` then means "a core did not stop", and a debugger has to do
// something correct with it.
//
// WHAT THIS PROBE MAKES HAPPEN
//
// Every online peer enters the region and STAYS, holding it until this
// core says otherwise. So the first drain cannot succeed, whatever its spin
// bound is -- which is the point, and the reason this probe is not
// timing-sensitive on either target. A test that made the drain expire by
// racing it would be a different spin count on RPi5 than on QEMU and would
// be exactly the kind of load-dependent verdict issue #510 was about.
//
// Then this core releases the peers one at a time, waits for each to have
// provably left, and drains again with the SAME bound after each. Same call, same number,
// opposite answer, and only the second one produces a proof -- which is
// what "the caller refuses to tear down on Busy" means when the refusal is
// a type rather than a branch.
//
// WHAT IT ASSERTS, AND WHAT THE COMPILER ASSERTS INSTEAD
//
// The teardown below takes `borrow Quiesced[region]`, so the Busy arm
// CANNOT call it: there is no proof in scope to pass. That is a compile-
// time property and a boot cannot observe it, so the runtime stand-in is a
// count -- teardowns must be exactly one across two drains. A change that
// made Busy proceed anyway would have to mint a proof from somewhere, and
// this counter says whether it did.
//
// Current limitations:
// - IT PROVES THE BOUND EXPIRES, not that the bound is well chosen. The
//   secondary holds the region for as long as it takes, so this says
//   nothing about whether SCHEDULE_CONTENTION_DRAIN_SPINS is large enough
//   for a core that is merely slow. That is a different question and needs
//   a different probe.
// - IT DOES NOT COVER A CORE THAT NEVER LEAVES. This one always leaves,
//   because the boot continues afterwards. A wedged core is the case the
//   `Busy` report is FOR, and the honest position is that this probe
//   exercises the mechanism, not the emergency.
// - ONE REGION, private to this file, so a failure names the primitive
//   rather than whatever else shares a live instance -- the same reason
//   every sibling probe owns its own instance.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/lib/occupancy.tkb";
use "kernel/lib/execution_model.tkb";

// Any finite number works, because the secondary holds the region until
// released. Small on purpose: the first drain is EXPECTED to expire, and
// spending a million iterations to learn that costs boot time on the
// board for nothing.
const OCCUPANCY_PROBE_DRAIN_SPINS: usize = 4096;
const WORLD_STOP_PROBE_SPINS: usize = 10000000;

private let mut occupancy_probe_region: Occupancy;
private let mut occupancy_probe_armed: AtomicWord;
// Per core, a LATCH: 1 once that peer is inside, 2 once it has left, never
// cleared by the peer. GitHub issue #510: a level flag that the other core
// clears on its way out cannot answer "was it ever there", which is the
// question a report that has to tell a harness fault from a kernel one is
// asking. GitHub issue #756: one word per online peer.
private let mut occupancy_probe_tally: PeerTally;
// Peers 1..release may leave.
private let mut occupancy_probe_release: AtomicWord;
private let mut occupancy_probe_teardowns: usize;
private let mut world_stop_probe_inspections: usize;
private let mut world_stop_stale_probe_controller: WorldStop;

private fn occupancy_probe_armed_address() -> *AtomicWord {
    return &occupancy_probe_armed;
}

// Armed for a peer only until it has made its one visit. GitHub issue #853:
// a peer released early used to keep re-entering this probe from its idle
// loop until core 0 disarmed it, and under the 651 window every re-entry
// sat 0.75 s with interrupts masked -- so core 0's world stop, begun right
// after this probe, found core 1 masked and could not get its acknowledgement.
// A peer that has visited stays idle, interrupts open, like the per-turn
// arming of the world stop from a peer.
fn occupancy_drain_is_armed(cpu: usize) -> bool !{unsafe} {
    return atomic_word_load(occupancy_probe_armed_address()) == 1 &&
           peer_tally_count(&occupancy_probe_tally, cpu) == 0;
}

// Enter, announce, and HOLD. Linear, so the leave is checked on every path
// out of this function including the disarmed one -- which is the half of
// the protocol a bare flag is worst at, and the half this file exists to
// exercise. Every online peer runs this; peer `cpu` holds until core 0 has
// released peers 1..cpu.
fn occupancy_drain_secondary_run(cpu: usize) !{unsafe} {
    if (peer_tally_is_peer(&occupancy_probe_tally, cpu) == false) { return; }
    // Once per probe: a second visit would make the final drain Busy.
    // occupancy_drain_is_armed already turns a visited peer away (#853);
    // this keeps the property local to the run function as well.
    if (peer_tally_count(&occupancy_probe_tally, cpu) != 0) { return; }
    let visit = occupancy_enter(&occupancy_probe_region);
    peer_tally_set(&occupancy_probe_tally, cpu, 1);
    // Held until core 0 says otherwise, or until it gives up on this probe
    // entirely -- a peer that spun here after an abandoned probe would hold
    // the region for the rest of the boot.
    while (atomic_word_load(&occupancy_probe_release) < cpu &&
           atomic_word_load(occupancy_probe_armed_address()) == 1) { }
    occupancy_leave(visit, &occupancy_probe_region);
    peer_tally_set(&occupancy_probe_tally, cpu, 2);
}

private fn occupancy_drain_report(stage: *u8, busy: usize, empty: usize)
        !{unsafe} {
    kernel_boot_log("occupancy drain stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    // Per peer, 1 = entered and holding, 2 = left.
    kernel_boot_log("occupancy drain counts:");
    peer_tally_put_counts(&occupancy_probe_tally);
    kernel_boot_log(" released=");
    uart_put_udec(atomic_word_load(&occupancy_probe_release));
    kernel_boot_log(" busy=");
    uart_put_udec(busy);
    kernel_boot_log(" empty=");
    uart_put_udec(empty);
    kernel_boot_log(" teardowns=");
    uart_put_udec(occupancy_probe_teardowns);
    kernel_boot_log(" spins=");
    uart_put_udec(OCCUPANCY_PROBE_DRAIN_SPINS);
    kernel_boot_log("\n");
}

// The teardown, and the reason this file has one: it CANNOT be called
// without a proof that no other core is inside the region. The Busy arm
// has no proof to pass, so its refusal is the absence of a call rather
// than a check somebody has to remember.
private fn occupancy_probe_teardown(proof: borrow Quiesced[region]) {
    occupancy_probe_teardowns = occupancy_probe_teardowns + 1;
}

// One drain with the probe's bound: true when it came back Empty.
private fn occupancy_probe_drain_once() -> bool !{unsafe} {
    match occupancy_drain(&occupancy_probe_region,
                          OCCUPANCY_PROBE_DRAIN_SPINS) {
        OccupancyDrainResult::Busy => { return false; }
        OccupancyDrainResult::Empty(proof) => {
            // Before the last peer is released this is a peer that left
            // without being asked, which no path in this file does. The
            // proof is still spent on the teardown so the count tells an
            // early drain that tore down apart from one that did not.
            occupancy_probe_teardown(proof);
            quiesced_release(proof);
            return true;
        }
    }
}

fn occupancy_drain_probe() -> bool !{unsafe} {
    atomic_word_store(&occupancy_probe_release, 0);
    occupancy_probe_teardowns = 0;
    peer_tally_reset(&occupancy_probe_tally, kernel_online_core_count());
    let peers: usize = peer_tally_peers(&occupancy_probe_tally);
    atomic_word_store(occupancy_probe_armed_address(), 1);

    // Bounded in TIME here, unlike the drain itself: this file has a clock
    // and occupancy.tkb deliberately does not.
    if (peer_tally_peers_reached(&occupancy_probe_tally, 1,
                                 PeerTickPolicy::Entry) == false) {
        atomic_word_store(occupancy_probe_armed_address(), 0);
        // The distinction issue #508 asked for. A drain that comes back
        // Empty because nothing was ever inside is a HARNESS fault and
        // reads identically to a working give-up unless the probe says so
        // -- this is the arm that says so, before any drain has run.
        occupancy_drain_report("secondary-never-entered" as *u8, 0, 0);
        return false;
    }

    // GitHub issue #756: every online peer holds the region, and core 0
    // lets them go one at a time. Each drain while ANY peer is still
    // inside must expire; only the drain after the last has left may
    // succeed. With one peer this is the original two drains.
    let mut busy_seen: usize = 0;
    let mut empty_seen: usize = 0;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu <= peers) {
            if (occupancy_probe_drain_once()) { empty_seen = empty_seen + 1; }
            else { busy_seen = busy_seen + 1; }
            // Let peer `cpu` go, and wait until it has provably left -- not
            // for a duration, because "long enough" is the assumption this
            // whole file is about.
            atomic_word_store(&occupancy_probe_release, cpu);
            if (peer_tally_peer_reached(&occupancy_probe_tally, cpu, 2,
                                        PeerTickPolicy::Entry) == false) {
                atomic_word_store(occupancy_probe_armed_address(), 0);
                occupancy_drain_report("secondary-never-left" as *u8,
                                       busy_seen, empty_seen);
                return false;
            }
        }
    }

    // The last drain: same call, same bound, and now it must succeed.
    if (occupancy_probe_drain_once()) { empty_seen = empty_seen + 1; }
    else { busy_seen = busy_seen + 1; }
    atomic_word_store(occupancy_probe_armed_address(), 0);

    occupancy_drain_report("complete" as *u8, busy_seen, empty_seen);
    // One Busy per peer still holding, then one Empty, and exactly one
    // teardown -- the Busy arm had no proof to spend, which is the
    // property the token exists for.
    return peers >= 1 && busy_seen == peers && empty_seen == 1 &&
           occupancy_probe_teardowns == 1;
}

// The guarded operation cannot accept WorldStopPartial: its parameter is the
// complete token itself, so a partial stop has no source for this call.
private fn world_stop_probe_inspect(stopped: borrow WorldStopped[id]) {
    world_stop_probe_inspections = world_stop_probe_inspections + 1;
}

// Exercise both runtime outcomes. The full path sends a real SGI to every
// online peer; the negative-control entry suppresses that notification so
// the same online peers deliberately do not acknowledge and must produce
// Partial. GitHub issue #848: every online core, not core 0 and core 1 only.
fn world_stop_probe() -> bool !{unsafe} {
    world_stop_probe_inspections = 0;
    let online: usize = kernel_online_core_count();
    let mut full: bool = false;
    let mut acknowledged: bool = false;
    let mut resumed: bool = false;
    match world_stop_begin(
            &kernel_world_stop, online, WORLD_STOP_PROBE_SPINS) {
        WorldStopResult::Busy => { }
        WorldStopResult::Partial(partial) => {
            world_stop_partial_release(partial, &kernel_world_stop);
        }
        WorldStopResult::Complete(stopped) => {
            acknowledged = true;
            let mut held_before: [usize; KERNEL_MAX_CORES];
            for cpu: usize in 0..<KERNEL_MAX_CORES {
                held_before[cpu] = kernel_tick_count_of(cpu);
            }
            // Deliberate hold: no stopped peer may take a tick throughout.
            let mut hold_start: WallTickStamp = wall_tick_stamp();
            let mut hold_window: WallHoldBudget = wall_stopped_hold_budget();
            while (wall_hold_open(hold_start, hold_window)) { }
            full = online >= 2;
            for cpu: usize in 1..<KERNEL_MAX_CORES {
                if (cpu < online && kernel_tick_count_of(cpu) != held_before[cpu]) {
                    full = false;
                }
            }
            world_stop_probe_inspect(stopped);
            // Core 1's resume through the typed ticket, then every other
            // peer's against the count it was held at: each wait ends at that
            // peer's first tick after the release, or after its own window.
            let ticket = world_stop_release_for_tick(stopped, &kernel_world_stop, 1);
            let mut resume_window = peer_tick_window_policy(1, PeerTickPolicy::Entry);
            while (resumed == false && peer_tick_window_open(resume_window)) {
                resumed = world_resume_tick_observed(ticket);
            }
            peer_tick_window_end(resume_window);
            world_resume_tick_cancel(ticket);
            for cpu: usize in 2..<KERNEL_MAX_CORES {
                if (cpu < online && resumed) {
                    let mut window = peer_tick_window_policy(cpu, PeerTickPolicy::Entry);
                    while (peer_tick_window_open(window) &&
                           kernel_tick_count_of(cpu) == held_before[cpu]) {
                    }
                    peer_tick_window_end(window);
                    resumed = kernel_tick_count_of(cpu) != held_before[cpu];
                }
            }
        }
    }

    if (acknowledged == false) {
        kernel_boot_log("world stop stage: secondary-never-acknowledged\n");
    } else if (resumed == false) {
        kernel_boot_log("world stop stage: secondary-never-resumed\n");
    }

    let mut partial_ok: bool = false;
    match world_stop_begin_nonack_probe(
            &kernel_world_stop, online, WORLD_STOP_PROBE_SPINS) {
        WorldStopResult::Busy => { }
        WorldStopResult::Complete(stopped) => {
            world_stop_release(stopped, &kernel_world_stop);
        }
        WorldStopResult::Partial(partial) => {
            let mask: usize = world_stop_partial_mask(partial);
            partial_ok = mask == 0;
            world_stop_partial_release(partial, &kernel_world_stop);
        }
    }

    // The same live peer must acknowledge fresh requests without a timer
    // delay between release and the next begin. Also exercise Busy while a
    // complete token is live, without releasing that token on the refusal.
    let mut repeated: usize = 0;
    let mut busy: usize = 0;
    for round: usize in 0..<16 {
        match world_stop_begin(&kernel_world_stop, online, WORLD_STOP_PROBE_SPINS) {
            WorldStopResult::Busy => { }
            WorldStopResult::Partial(partial) => {
                world_stop_partial_release(partial, &kernel_world_stop);
            }
            WorldStopResult::Complete(stopped) => {
                repeated = repeated + 1;
                match world_stop_busy_claim_probe(stopped, &kernel_world_stop) {
                    WorldStopClaimProbeResult::Busy => { busy = busy + 1; }
                    WorldStopClaimProbeResult::UnexpectedUnclaimed => {}
                }
                world_stop_release(stopped, &kernel_world_stop);
            }
        }
    }

    // No SGI uses this private controller. The first request advances its
    // generation; the second injects that now-stale, NONZERO acknowledgement
    // after publication. Only Partial, with no acknowledged CPUs, is valid.
    let mut stale: bool = false;
    match world_stop_begin_nonack_probe(&world_stop_stale_probe_controller, online, 1) {
        WorldStopResult::Busy => { }
        WorldStopResult::Complete(unexpected) => {
            world_stop_release(unexpected, &world_stop_stale_probe_controller);
        }
        WorldStopResult::Partial(first) => {
            world_stop_partial_release(first, &world_stop_stale_probe_controller);
            match world_stop_begin_stale_ack_probe(
                    &world_stop_stale_probe_controller, online, 1) {
                WorldStopResult::Busy => { }
                WorldStopResult::Complete(unexpected) => {
                    world_stop_release(unexpected, &world_stop_stale_probe_controller);
                }
                WorldStopResult::Partial(second) => {
                    stale = world_stop_partial_mask(second) == 0;
                    world_stop_partial_release(second, &world_stop_stale_probe_controller);
                }
            }
        }
    }

    let mut full_count: usize = 0;
    let mut partial_count: usize = 0;
    let mut resumed_count: usize = 0;
    if (full) { full_count = 1; }
    if (partial_ok) { partial_count = 1; }
    if (resumed) { resumed_count = 1; }
    kernel_boot_log("world stop counts: full=");
    uart_put_udec(full_count);
    kernel_boot_log(" partial=");
    uart_put_udec(partial_count);
    kernel_boot_log(" resumed=");
    uart_put_udec(resumed_count);
    kernel_boot_log(" inspections=");
    uart_put_udec(world_stop_probe_inspections);
    kernel_boot_log(" repeated=");
    uart_put_udec(repeated);
    kernel_boot_log(" busy=");
    uart_put_udec(busy);
    kernel_boot_log(" stale-refused=");
    if (stale) { uart_put_udec(1); } else { uart_put_udec(0); }
    kernel_boot_log("\n");
    return full && partial_ok && resumed &&
           world_stop_probe_inspections == 1 && repeated == 16 && busy == 16 && stale;
}

// GitHub issue #632: a world stop that a PEER begins. world_stop_probe above
// only ever starts the stop on core 0, and GICC_IAR carries the sending CPU
// in bits [12:10] of an SGI, so a dispatcher comparing the raw word saw 1
// from core 0 and 0x401 from core 1 -- and every stop a peer began went
// unacknowledged. That hid until a four-core churn run rolled the ASID
// counter over on a peer. GitHub issue #756: every online peer in turn
// begins a stop of every online core, and core 0 -- waiting with
// interrupts open -- and the other peers, idle, must acknowledge it. In
// turn rather than at once: the stop is one-deep and refuses a second
// initiator with Busy, which is a different property.
// The peer whose turn it is, 0 when none. Armed for that peer alone, so the
// others stay idle -- interrupts open -- to acknowledge its stop rather than
// entering a probe that is not theirs.
private let mut world_stop_peer_probe_turn: AtomicWord;
// Per peer: 1 Complete, 2 Partial, 3 Busy, 0 not run.
private let mut world_stop_peer_probe_result: PeerTally;

fn world_stop_peer_probe_is_armed(cpu: usize) -> bool !{unsafe} {
    let turn: usize = atomic_word_load(&world_stop_peer_probe_turn);
    return turn != 0 && turn == cpu;
}

// Every online peer runs this from its idle loop; only the peer whose turn
// it is begins a stop.
fn world_stop_peer_probe_secondary_run(cpu: usize) !{unsafe} {
    if (peer_tally_is_peer(&world_stop_peer_probe_result, cpu) == false) {
        return;
    }
    if (atomic_word_load(&world_stop_peer_probe_turn) != cpu ||
        peer_tally_count(&world_stop_peer_probe_result, cpu) != 0) {
        return;
    }
    let online: usize = peer_tally_online(&world_stop_peer_probe_result);
    let mut result: usize = 0;
    match world_stop_begin(&kernel_world_stop, online, WORLD_STOP_PROBE_SPINS) {
        WorldStopResult::Busy => { result = 3; }
        WorldStopResult::Partial(partial) => {
            world_stop_partial_release(partial, &kernel_world_stop);
            result = 2;
        }
        WorldStopResult::Complete(stopped) => {
            world_stop_release(stopped, &kernel_world_stop);
            result = 1;
        }
    }
    peer_tally_set(&world_stop_peer_probe_result, cpu, result);
}

fn world_stop_peer_probe() -> bool !{unsafe} {
    peer_tally_reset(&world_stop_peer_probe_result, kernel_online_core_count());
    let peers: usize = peer_tally_peers(&world_stop_peer_probe_result);
    let mut complete: usize = 0;
    let mut finished: bool = peers >= 1;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu <= peers && finished) {
            atomic_word_store(&world_stop_peer_probe_turn, cpu);
            finished = peer_tally_peer_reached(&world_stop_peer_probe_result,
                                               cpu, 1, PeerTickPolicy::Complete);
            atomic_word_store(&world_stop_peer_probe_turn, 0);
            if (peer_tally_count(&world_stop_peer_probe_result, cpu) == 1) {
                complete = complete + 1;
            }
        }
    }
    atomic_word_store(&world_stop_peer_probe_turn, 0);
    kernel_boot_log("world stop from a peer counts: complete=" as *u8);
    if (complete == peers) {
        kernel_boot_log("every-peer" as *u8);
    } else {
        uart_put_udec(complete);
        kernel_boot_log(" of " as *u8);
        uart_put_udec(peers);
    }
    kernel_boot_log("\n" as *u8);
    if (finished == false) {
        kernel_boot_log("world stop from a peer stage: secondary-never-finished\n");
    }
    return finished && complete == peers;
}
