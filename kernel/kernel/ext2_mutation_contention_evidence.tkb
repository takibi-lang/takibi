// GitHub issue #533: does kernel/fs/ext2/mutation_lock.tkb actually exclude?
//
// The lock it measures replaced an ADMISSION claim -- "every process that
// reaches the filesystem is admitted to core 0 only" -- which was a
// statement about the scheduler that ext2 could not check. Replacing it with
// a lock is only progress if a second core can be shown to observe the
// exclusion, and kernel/CONCURRENCY.md is explicit about why this file has
// to exist: a lock added correct-by-audit changed nothing any lane could
// see, because the second core never reached the subsystem.
//
// WHAT THE PEER ACTUALLY DOES IN PRODUCTION
//
// It does not take this lock. Readers stay concurrent, because
// peer_filesystem.expected asserts the BLOCK DEVICE mutex is contended on
// both cpus and a lock held across reads would zero one side of that. What
// a peer does instead is ASK -- ext2_mutation_in_flight(), one acquire-load,
// no wait -- and the migration gate hands its syscall to core 0 when the
// answer is yes. So the property to measure is exactly that answer, observed
// from the other core.
//
// TWO PHASES, AND PHASE 1 IS THE ONE THAT MATTERS
//
// - Phase 1: core 0 holds NOTHING. The peer asks and must see `false`.
// - Phase 2: core 0 holds the mutation guard across the whole phase. The
//   peer asks and must see `true`.
//
// Phase 1 is not decoration. Without it a probe that always answered `true`
// -- a lock left held by some earlier path, or an in_flight() that returned
// a constant -- would pass, and `true` is the answer that costs a peer its
// placement. CONCURRENCY.md's rule is that a probe with only the locked
// phase goes quietly green the day the window stops reproducing; here it
// would go green the day the answer stopped depending on the lock at all.
//
// NO RENDEZVOUS, AND NO ROUNDS
//
// This is the occupancy_drain shape rather than the statistical one. Core 0
// HOLDS the lock for the duration of phase 2, so the peer's observation
// cannot miss the window however slow either core is, and the counts come
// out the same on QEMU and on the board. A probe that raced a mutation
// against a read and hoped they overlapped would be a different spin count
// on RPi5 than on QEMU, which is the load-dependent verdict issue #510 was
// about.
//
// Current limitations (2026-09-16). Keep this list current as call sites
// change; a limitation that goes stale here is worse than none, since it
// invites relying on a guarantee that quietly stopped holding.
//
// - It observes the ANSWER, not a torn directory. Proving that a reader
//   which ignored the answer would see two owners of one block needs ext2
//   mutation and a peer lookup in the same instant, which is a rendezvous
//   inside ext2 rather than around it. The lock is what makes that
//   unreachable, so there is nothing left to observe once it holds.
// - EVERY ONLINE PEER (GitHub issue #756) asks, reads and mutates; the
//   mutation lock serializes the peers' mutations among themselves.
// - Phases 5 and 6 (GitHub issue #597) put the mutator on the peer and a
//   reader on core 0, the arrangement admitting mutation on a peer created.
// - It does not exercise the five mutating syscall arms. Those are covered
//   by the ext2_mutation view; this covers the lock they share.
use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/fs/ext2/mutation_lock.tkb";
use "kernel/lib/execution_model.tkb";

private let mut ext2_mutation_probe_armed: AtomicWord;
private let mut ext2_mutation_probe_phase: AtomicWord;
// Bumped by core 0 for every phase; each peer serves each phase once and
// records it in `done`, which is what core 0 waits on.
private let mut ext2_mutation_probe_sequence: AtomicWord;
private let mut ext2_mutation_probe_done: PeerTally;
// Phases 1 and 2, per peer: 1 when it was told the answer the phase expects.
private let mut ext2_mutation_probe_seen: PeerTally;
// Phases 3 and 4, per peer: 1 once inside as a reader, and 1 when a mutation
// was taken while it was still inside.
private let mut ext2_mutation_probe_inside: PeerTally;
private let mut ext2_mutation_probe_overlapped: PeerTally;
// Asks, across phases 1 and 2 and every peer.
private let mut ext2_mutation_probe_asked: AtomicWord;
// Shared words: some core is trying to take the mutation, has taken it, and
// (phases 5 and 6) core 0's reader has left.
private let mut ext2_mutation_probe_trying: AtomicWord;
private let mut ext2_mutation_probe_taken: AtomicWord;
private let mut ext2_mutation_probe_left: AtomicWord;

fn ext2_mutation_contention_is_armed() -> bool !{unsafe} {
    return atomic_word_load(&ext2_mutation_probe_armed) == 1;
}

// Every online peer runs this from its idle loop while the probe is armed.
fn ext2_mutation_contention_secondary_run(cpu: usize) !{unsafe} {
    if (peer_tally_is_peer(&ext2_mutation_probe_done, cpu) == false) { return; }
    let sequence: usize = atomic_word_load(&ext2_mutation_probe_sequence);
    if (peer_tally_count(&ext2_mutation_probe_done, cpu) == sequence) { return; }
    let phase: usize = atomic_word_load(&ext2_mutation_probe_phase);
    if (phase == 3 || phase == 4) {
        ext2_mutation_probe_reader(cpu);
    } else if (phase == 5 || phase == 6) {
        ext2_mutation_probe_mutator(phase);
    } else {
        let in_flight: bool = ext2_mutation_in_flight();
        atomic_word_fetch_add(&ext2_mutation_probe_asked, 1);
        if (phase == 1 && in_flight == false) {
            peer_tally_set(&ext2_mutation_probe_seen, cpu, 1);
        }
        if (phase == 2 && in_flight) {
            peer_tally_set(&ext2_mutation_probe_seen, cpu, 1);
        }
    }
    peer_tally_set(&ext2_mutation_probe_done, cpu, sequence);
}

// GitHub issue #559: a peer reader that core 0's mutation must wait for.
private fn ext2_mutation_probe_reader(cpu: usize) !{unsafe} {
    if (ext2_read_enter()) {
        peer_tally_set(&ext2_mutation_probe_inside, cpu, 1);
        // Stay inside until core 0 has started taking the lock, then a
        // little longer, so a take that did not wait has time to return.
        let mut window = peer_tick_window_policy(
            peer_tick_window_peer(), PeerTickPolicy::Entry);
        while (atomic_word_load(&ext2_mutation_probe_trying) == 0 &&
               peer_tick_window_open(window)) { }
        peer_tick_window_end(window);
        // Wait for the take itself, bounded by peer ticks rather than wall
        // time: core 0's vCPU can be descheduled between announcing the
        // take and taking, and a fixed wall-clock linger then missed a
        // control take that did not wait (seen under a full allcheck). A
        // take that waits for this reader does not come; the window ends.
        let mut taking = peer_tick_window_policy(
            peer_tick_window_peer(), PeerTickPolicy::Entry);
        while (atomic_word_load(&ext2_mutation_probe_taken) == 0 &&
               peer_tick_window_open(taking)) { }
        peer_tick_window_end(taking);
        // Deliberate linger: expose a mutation that failed to wait for readers.
        let linger: i64 = read_cntpct();
        while (read_cntpct() - linger < (read_cntfrq() >> 6)) { }
        if (atomic_word_load(&ext2_mutation_probe_taken) == 1) {
            peer_tally_set(&ext2_mutation_probe_overlapped, cpu, 1);
        }
        ext2_read_leave();
        peer_tally_set(&ext2_mutation_probe_inside, cpu, 2);
    }
}

// GitHub issue #597: a peer mutator against core 0's reader. Every peer
// tries; the mutation lock serializes them among themselves.
private fn ext2_mutation_probe_mutator(phase: usize) !{unsafe} {
    atomic_word_store(&ext2_mutation_probe_trying, 1);
    if (phase == 6) {
        let guard = ext2_mutation_take();
        atomic_word_store(&ext2_mutation_probe_taken, 1);
        ext2_mutation_give(guard);
    } else {
        let guard = ext2_mutation_take_without_readers_unchecked();
        atomic_word_store(&ext2_mutation_probe_taken, 1);
        // Keep the lock until core 0's reader has left, as a real mutation
        // would still be running.
        let mut hold = peer_tick_window_policy(
            peer_tick_window_peer(), PeerTickPolicy::Arrival);
        while (atomic_word_load(&ext2_mutation_probe_left) == 0 &&
               peer_tick_window_open(hold)) { }
        peer_tick_window_end(hold);
        ext2_mutation_give(guard);
    }
}

// Arm one phase for every online peer.
private fn ext2_mutation_probe_arm(phase: usize) -> usize !{unsafe} {
    atomic_word_store(&ext2_mutation_probe_phase, phase);
    let sequence: usize = atomic_word_load(&ext2_mutation_probe_sequence) + 1;
    atomic_word_store(&ext2_mutation_probe_sequence, sequence);
    atomic_word_store(&ext2_mutation_probe_armed, 1);
    return sequence;
}

// Every peer finished the phase; disarmed either way.
private fn ext2_mutation_probe_finish(sequence: usize) -> bool !{unsafe} {
    let finished: bool = peer_tally_peers_reached(
        &ext2_mutation_probe_done, sequence, PeerTickPolicy::Arrival);
    atomic_word_store(&ext2_mutation_probe_armed, 0);
    return finished;
}

// Phases 5 and 6: core 0 reads while every peer tries to mutate. Returns 1
// when a mutation was taken while core 0 was inside, 0 when none was, and
// 2 when no peer tried.
private fn ext2_mutation_probe_core0_reader(phase: usize) -> usize
        !{unsafe} {
    atomic_word_store(&ext2_mutation_probe_trying, 0);
    atomic_word_store(&ext2_mutation_probe_taken, 0);
    atomic_word_store(&ext2_mutation_probe_left, 0);
    if (ext2_read_enter() == false) { return 2; }
    let sequence: usize = ext2_mutation_probe_arm(phase);
    let mut window = peer_tick_window_policy(
        peer_tick_window_peer(), PeerTickPolicy::Arrival);
    while (atomic_word_load(&ext2_mutation_probe_trying) == 0 &&
           peer_tick_window_open(window)) { }
    peer_tick_window_end(window);
    let started: usize = atomic_word_load(&ext2_mutation_probe_trying);
    // As in the peer reader: wait for the take, by peer ticks, before the
    // linger, so a descheduled peer cannot hide a control take.
    let mut taking = peer_tick_window_policy(
        peer_tick_window_peer(), PeerTickPolicy::Arrival);
    while (atomic_word_load(&ext2_mutation_probe_taken) == 0 &&
           peer_tick_window_open(taking)) { }
    peer_tick_window_end(taking);
    // Deliberate linger: measure whether a peer bypassed reader exclusion.
    let linger: i64 = read_cntpct();
    while (read_cntpct() - linger < (read_cntfrq() >> 6)) { }
    let overlapped: usize = atomic_word_load(&ext2_mutation_probe_taken);
    atomic_word_store(&ext2_mutation_probe_left, 1);
    ext2_read_leave();
    let finished: bool = ext2_mutation_probe_finish(sequence);
    if (started == 0 || finished == false) { return 2; }
    return overlapped;
}

// Phases 3 and 4: every peer reads while core 0 mutates. Returns how many
// peers saw the mutation taken while still inside, or ~0 when some peer
// never got inside or never finished.
private fn ext2_mutation_probe_overlap(phase: usize) -> usize !{unsafe} {
    let online: usize = peer_tally_online(&ext2_mutation_probe_done);
    peer_tally_reset(&ext2_mutation_probe_inside, online);
    peer_tally_reset(&ext2_mutation_probe_overlapped, online);
    atomic_word_store(&ext2_mutation_probe_trying, 0);
    atomic_word_store(&ext2_mutation_probe_taken, 0);
    let sequence: usize = ext2_mutation_probe_arm(phase);
    if (peer_tally_peers_reached(&ext2_mutation_probe_inside, 1,
                                 PeerTickPolicy::Arrival) == false) {
        atomic_word_store(&ext2_mutation_probe_armed, 0);
        return ~(0 as usize);
    }
    atomic_word_store(&ext2_mutation_probe_trying, 1);
    if (phase == 3) {
        let guard = ext2_mutation_take();
        atomic_word_store(&ext2_mutation_probe_taken, 1);
        ext2_mutation_give(guard);
    } else {
        let guard = ext2_mutation_take_without_readers_unchecked();
        atomic_word_store(&ext2_mutation_probe_taken, 1);
        // Keep the lock until every peer reader has left, as a real
        // mutation would still be running.
        let left: bool = peer_tally_peers_reached(
            &ext2_mutation_probe_inside, 2, PeerTickPolicy::Arrival);
        ext2_mutation_give(guard);
    }
    if (ext2_mutation_probe_finish(sequence) == false) { return ~(0 as usize); }
    return peer_tally_peers_sum(&ext2_mutation_probe_overlapped);
}

// Phases 1 and 2: every peer asks once.
private fn ext2_mutation_probe_run_phase(phase: usize) -> bool !{unsafe} {
    let online: usize = peer_tally_online(&ext2_mutation_probe_done);
    peer_tally_reset(&ext2_mutation_probe_seen, online);
    let sequence: usize = ext2_mutation_probe_arm(phase);
    return ext2_mutation_probe_finish(sequence);
}

// "every-peer" when `count` is the number of peers, else "<count> of
// <peers>": these lines are in a view shared by targets whose core counts
// may differ.
private fn ext2_mutation_probe_put_peers(count: usize) !{unsafe} {
    let peers: usize = peer_tally_peers(&ext2_mutation_probe_done);
    if (count == peers) {
        kernel_boot_log("every-peer");
    } else {
        uart_put_udec(count);
        kernel_boot_log(" of ");
        uart_put_udec(peers);
    }
}

private fn ext2_mutation_probe_report(stage: *u8, clear: usize, held: usize)
        !{unsafe} {
    kernel_boot_log("ext2 mutation contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("ext2 mutation contention counts: asked=");
    let asked: usize = atomic_word_load(&ext2_mutation_probe_asked);
    if (asked == 2 * peer_tally_peers(&ext2_mutation_probe_done)) {
        kernel_boot_log("every-peer-twice");
    } else {
        uart_put_udec(asked);
    }
    kernel_boot_log(" clear=");
    ext2_mutation_probe_put_peers(clear);
    kernel_boot_log(" held=");
    ext2_mutation_probe_put_peers(held);
    kernel_boot_log("\n");
}

fn ext2_mutation_contention_probe() -> bool !{unsafe} {
    static_assert(KERNEL_ACTIVE_CORES >= 2,
                  "ext2 mutation contention evidence requires one peer");
    let online: usize = kernel_online_core_count();
    peer_tally_reset(&ext2_mutation_probe_done, online);
    atomic_word_store(&ext2_mutation_probe_sequence, 0);
    atomic_word_store(&ext2_mutation_probe_asked, 0);
    let peers: usize = peer_tally_peers(&ext2_mutation_probe_done);

    // Phase 1: nothing held here, so every peer must be told no mutation is
    // in flight. This is the term that goes false if in_flight() ever stops
    // depending on the lock.
    let clear_phase: bool = ext2_mutation_probe_run_phase(1);
    let clear: usize = peer_tally_peers_sum(&ext2_mutation_probe_seen);
    if (clear_phase == false) {
        ext2_mutation_probe_report("peer-never-asked-unheld" as *u8, clear, 0);
        return false;
    }

    // Phase 2: hold the guard across the whole phase, the way
    // occupancy_drain's peers hold their region, so no peer can miss the
    // window whatever either core's speed is. The guard is linear, so the
    // release below is checked on every path out of this function.
    let guard = ext2_mutation_take();
    let held_phase: bool = ext2_mutation_probe_run_phase(2);
    ext2_mutation_give(guard);
    let held: usize = peer_tally_peers_sum(&ext2_mutation_probe_seen);
    if (held_phase == false) {
        ext2_mutation_probe_report("peer-never-asked-held" as *u8, clear, held);
        return false;
    }

    // GitHub issue #559. Phase 4 first, the control: the lock without the
    // reader wait returns while every peer reader is still inside, which is
    // the window. Phase 3: the real take waits them all out.
    let control: usize = ext2_mutation_probe_overlap(4);
    let waited: usize = ext2_mutation_probe_overlap(3);
    kernel_boot_log("ext2 mutation contention reader: control-overlap=");
    ext2_mutation_probe_put_peers(control);
    kernel_boot_log(" waited-overlap=");
    uart_put_udec(waited);
    kernel_boot_log("\n");
    if (control != peers || waited != 0) {
        ext2_mutation_probe_report("reader-wait-not-shown" as *u8, clear, held);
        return false;
    }

    // GitHub issue #597: the mirror, with core 0 as the reader and every
    // peer a mutator. Control first again.
    let core0_control: usize = ext2_mutation_probe_core0_reader(5);
    let core0_waited: usize = ext2_mutation_probe_core0_reader(6);
    kernel_boot_log("ext2 mutation contention core0 reader: control-overlap=");
    uart_put_udec(core0_control);
    kernel_boot_log(" waited-overlap=");
    uart_put_udec(core0_waited);
    kernel_boot_log("\n");
    if (core0_control != 1 || core0_waited != 0) {
        ext2_mutation_probe_report("core0-reader-wait-not-shown" as *u8, clear,
                                   held);
        return false;
    }

    ext2_mutation_probe_report("complete" as *u8, clear, held);
    // asked == 2 per peer is the term that is FALSE when the probe did no
    // work: one ask per phase, counted by each peer. The observations are
    // what it found, and a probe that never looked must not report what it
    // did not see.
    return peers >= 1 &&
           atomic_word_load(&ext2_mutation_probe_asked) == 2 * peers &&
           clear == peers && held == peers;
}
