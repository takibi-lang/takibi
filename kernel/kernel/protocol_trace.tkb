// The stack-ownership protocol as it actually ran, for
// scripts/validate_protocol_trace.py to replay against StackOwnership.tla
// (GitHub issue #606, stage 1). Each process also carries its parent's pid,
// which the same replay uses to hold the steps to Wait4Block.tla and
// RecordLifetime.tla (#647).
//
// What is recorded is not a list of hand-placed events. Every hold of the
// process-run lock inside a window is diffed, at its release, against the
// last state seen: each process's (state, stack owner) and each core's
// (current process, stack stood on). A change is recorded under that hold's
// sequence number, so the host sees one step per critical section, in the
// lock's own total order. A path that changes the protocol state is recorded
// whether or not anyone knew to instrument it, which is the point: #609's
// defect was a path the model did not know about. The same diff taken at
// acquire records what changed while nobody held the lock, marked unlocked.
//
// A window is opened and closed by /bin/protocol-trace through the
// workload-progress syscall. Opening records every live process and every
// core as sequence 0, so the replay starts from the kernel's real state
// rather than from an assumed one. Closing prints the whole buffer.
//
// Current limitations (2026-09-27):
// - Only what the run lock serializes is ordered. A change made outside it
//   is attributed to the next pass that notices, on whichever CPU that is:
//   an acquire, marked unlocked, or the release of an unrelated hold,
//   marked locked. The one such change the kernel makes is allocating a
//   Constructing record, and the checker takes that in wherever it lands.
// - The buffer holds PROTOCOL_TRACE_EVENTS changes, and the processes
//   tracked are bounded by PROTOCOL_TRACE_PROCESSES. Anything beyond either
//   is counted as lost and the checker refuses the window: a replay with a
//   gap in it proves nothing.
// - Every writer holds the process-run lock; the report runs after the
//   window is closed under that lock, so it reads a buffer nobody writes.

use "kernel/lib/atomic_word.tkb";
use "kernel/lib/execution_model.tkb";

const PROTOCOL_TRACE_EVENTS: usize = 512;
const PROTOCOL_TRACE_PROCESSES: usize = 64;
// A process's stack owner, or a core's current or stood-on process, that
// names nothing.
const PROTOCOL_TRACE_NONE: usize = 0xFFFFFFFFFFFFFFFF;

enum ProtocolTraceKind { Process; Gone; Core; }

struct ProtocolTraceEvent {
    sequence: usize;
    cpu: usize;
    unlocked: bool;
    kind: ProtocolTraceKind;
    // Process: pid, state, owner, wait reason, parent pid.  Gone: pid.
    // Core: core, current pid, stood-on pid.
    first: usize;
    second: usize;
    third: usize;
    fourth: usize;
    fifth: usize;
}

struct ProtocolTraceProcess {
    pid: usize;
    state: usize;
    owner: usize;
    reason: usize;
    parent: usize;
    seen: bool;
}

struct ProtocolTraceCore {
    current: usize;
    stands: usize;
}

// Inline guarded fields keep the shadow arrays in place under the existing
// process-run hold. no_copy prevents whole-wrapper copies or replacement;
// guarded_ref permits only in-place scalar access under the matching guard.
struct no_copy ProtocolTraceProcessShadow {
    private rows: [ProtocolTraceProcess; PROTOCOL_TRACE_PROCESSES]
        guarded_by(scheduled_process_run_lock);
}

struct no_copy ProtocolTraceCoreShadow {
    private rows: [ProtocolTraceCore; KERNEL_MAX_CORES]
        guarded_by(scheduled_process_run_lock);
}

private let mut protocol_trace_active: AtomicWord;
private let mut protocol_trace_sequence: AtomicWord;
private let mut protocol_trace_stored: AtomicWord;
private let mut protocol_trace_lost: AtomicWord;
private let mut protocol_trace_events:
    [ProtocolTraceEvent; PROTOCOL_TRACE_EVENTS];
private let mut protocol_trace_processes: ProtocolTraceProcessShadow;
private let mut protocol_trace_process_count: AtomicWord;
private let mut protocol_trace_cores: ProtocolTraceCoreShadow;
private let mut protocol_trace_unlocked_pass: AtomicWord;

fn protocol_trace_is_active() -> bool {
    return atomic_word_load(&protocol_trace_active) != 0;
}

private fn protocol_trace_record(kind: ProtocolTraceKind, first: usize,
                                 second: usize, third: usize, fourth: usize,
                                 fifth: usize) {
    let stored: usize = atomic_word_load(&protocol_trace_stored);
    if (stored >= PROTOCOL_TRACE_EVENTS) {
        atomic_word_fetch_add(&protocol_trace_lost, 1);
        return;
    }
    let slot: {0..<PROTOCOL_TRACE_EVENTS as usize} = stored;
    protocol_trace_events[slot].sequence = atomic_word_load(&protocol_trace_sequence);
    protocol_trace_events[slot].cpu = cpu_id();
    protocol_trace_events[slot].unlocked = atomic_word_load(&protocol_trace_unlocked_pass) != 0;
    protocol_trace_events[slot].kind = kind;
    protocol_trace_events[slot].first = first;
    protocol_trace_events[slot].second = second;
    protocol_trace_events[slot].third = third;
    protocol_trace_events[slot].fourth = fourth;
    protocol_trace_events[slot].fifth = fifth;
    atomic_word_store(&protocol_trace_stored, stored + 1);
}

// Opening: forget every earlier window. The caller then observes every
// process and core, which records them all, as sequence 0.
fn protocol_trace_prepare_open(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock]) {
    atomic_word_store(&protocol_trace_sequence, 0);
    atomic_word_store(&protocol_trace_stored, 0);
    atomic_word_store(&protocol_trace_lost, 0);
    atomic_word_store(&protocol_trace_process_count, 0);
    for core: usize in 0..<KERNEL_MAX_CORES {
        guarded_ref(guard, protocol_trace_cores.rows)[core].current = 0;
        guarded_ref(guard, protocol_trace_cores.rows)[core].stands = 0;
    }
    atomic_word_store(&protocol_trace_unlocked_pass, 0);
    atomic_word_store(&protocol_trace_active, 0);
}

must_use variant ProtocolTraceOpenResult { Opened; ReservationPending; Invalid; }

// The wire format has no explicit per-CPU reservation. A snapshot may start
// only when every Running process is visible as current or stood-on. Later
// Ready -> Running holds let the replay infer reservations normally.
fn protocol_trace_commit_open(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock]) -> ProtocolTraceOpenResult {
    let count: usize = atomic_word_load(&protocol_trace_process_count);
    for index: usize in 0..<PROTOCOL_TRACE_PROCESSES {
        if (index < count && guarded_ref(guard, protocol_trace_processes.rows)[index].state == 2) {
            let pid: usize = guarded_ref(guard, protocol_trace_processes.rows)[index].pid;
            let mut held: bool = false;
            for core: usize in 0..<KERNEL_MAX_CORES {
                if (guarded_ref(guard, protocol_trace_cores.rows)[core].current == pid ||
                    guarded_ref(guard, protocol_trace_cores.rows)[core].stands == pid) { held = true; }
            }
            if (held == false) { return ProtocolTraceOpenResult::ReservationPending; }
        }
    }
    atomic_word_store(&protocol_trace_active, 1);
    return ProtocolTraceOpenResult::Opened;
}

// Deterministic regression for the real failed snapshot: Running pid 2 is
// reserved off-core while CPU 1 holds pid 85. Publishing that candidate must
// be refused, and a later candidate with CPU 0 holding pid 2 must open.
fn protocol_trace_open_probe(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock]) -> bool {
    protocol_trace_prepare_open(guard);
    protocol_trace_pass_begin(guard, false);
    protocol_trace_observe_process(guard, 2, 2, PROTOCOL_TRACE_NONE, 0, 1);
    protocol_trace_observe_process(guard, 85, 2, 1, 0, 2);
    protocol_trace_observe_core(guard, 0, PROTOCOL_TRACE_NONE, PROTOCOL_TRACE_NONE);
    protocol_trace_observe_core(guard, 1, 85, 85);
    protocol_trace_pass_end(guard, false);
    match protocol_trace_commit_open(guard) {
        ProtocolTraceOpenResult::Opened => { protocol_trace_close(); return false; }
        ProtocolTraceOpenResult::Invalid => { return false; }
        ProtocolTraceOpenResult::ReservationPending => {}
    }
    if (protocol_trace_is_active()) { protocol_trace_close(); return false; }
    protocol_trace_observe_core(guard, 0, 2, PROTOCOL_TRACE_NONE);
    match protocol_trace_commit_open(guard) {
        ProtocolTraceOpenResult::Opened => { protocol_trace_close(); return true; }
        ProtocolTraceOpenResult::ReservationPending => { return false; }
        ProtocolTraceOpenResult::Invalid => { return false; }
    }
}

fn protocol_trace_close() { atomic_word_store(&protocol_trace_active, 0); }

// The caller's walk stopped before the pool's end: the pass is incomplete.
fn protocol_trace_note_lost() {
    atomic_word_fetch_add(&protocol_trace_lost, 1);
}

// One diff pass. `unlocked` says the pass is taken at acquire, so whatever
// it finds changed while no CPU held the lock; at release it is this hold's
// own step, and the next hold gets the next sequence number.
fn protocol_trace_pass_begin(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock], unlocked: bool) {
    if (unlocked) { atomic_word_store(&protocol_trace_unlocked_pass, 1); } else { atomic_word_store(&protocol_trace_unlocked_pass, 0); }
    for index: usize in 0..<PROTOCOL_TRACE_PROCESSES {
        guarded_ref(guard, protocol_trace_processes.rows)[index].seen = false;
    }
}

fn protocol_trace_observe_process(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock], pid: usize, state: usize, owner: usize,
                                  reason: usize, parent: usize) {
    let count: usize = atomic_word_load(&protocol_trace_process_count);
    for index: usize in 0..<PROTOCOL_TRACE_PROCESSES {
        if (index < count && guarded_ref(guard, protocol_trace_processes.rows)[index].pid == pid) {
            guarded_ref(guard, protocol_trace_processes.rows)[index].seen = true;
            if (guarded_ref(guard, protocol_trace_processes.rows)[index].state != state ||
                guarded_ref(guard, protocol_trace_processes.rows)[index].owner != owner ||
                guarded_ref(guard, protocol_trace_processes.rows)[index].reason != reason ||
                guarded_ref(guard, protocol_trace_processes.rows)[index].parent != parent) {
                guarded_ref(guard, protocol_trace_processes.rows)[index].state = state;
                guarded_ref(guard, protocol_trace_processes.rows)[index].owner = owner;
                guarded_ref(guard, protocol_trace_processes.rows)[index].reason = reason;
                guarded_ref(guard, protocol_trace_processes.rows)[index].parent = parent;
                protocol_trace_record(ProtocolTraceKind::Process, pid, state,
                                      owner, reason, parent);
            }
            return;
        }
    }
    if (count >= PROTOCOL_TRACE_PROCESSES) {
        atomic_word_fetch_add(&protocol_trace_lost, 1);
        return;
    }
    let slot: {0..<PROTOCOL_TRACE_PROCESSES as usize} = count;
    guarded_ref(guard, protocol_trace_processes.rows)[slot].pid = pid;
    guarded_ref(guard, protocol_trace_processes.rows)[slot].state = state;
    guarded_ref(guard, protocol_trace_processes.rows)[slot].owner = owner;
    guarded_ref(guard, protocol_trace_processes.rows)[slot].reason = reason;
    guarded_ref(guard, protocol_trace_processes.rows)[slot].parent = parent;
    guarded_ref(guard, protocol_trace_processes.rows)[slot].seen = true;
    atomic_word_store(&protocol_trace_process_count, count + 1);
    protocol_trace_record(ProtocolTraceKind::Process, pid, state, owner,
                          reason, parent);
}

fn protocol_trace_observe_core(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock], core: {0..<KERNEL_MAX_CORES as usize},
                               current: usize, stands: usize) {
    if (guarded_ref(guard, protocol_trace_cores.rows)[core].current == current &&
        guarded_ref(guard, protocol_trace_cores.rows)[core].stands == stands &&
        atomic_word_load(&protocol_trace_sequence) != 0) {
        return;
    }
    guarded_ref(guard, protocol_trace_cores.rows)[core].current = current;
    guarded_ref(guard, protocol_trace_cores.rows)[core].stands = stands;
    protocol_trace_record(ProtocolTraceKind::Core, core, current, stands, 0,
                          0);
}

// A process no longer in the pool is recorded gone, and the entries still
// tracked are packed to the front.
fn protocol_trace_pass_end(
        guard: borrow ProcessRunGuard[&scheduled_process_run_lock], unlocked: bool) {
    let count: usize = atomic_word_load(&protocol_trace_process_count);
    let mut kept: usize = 0;
    for position: usize in 0..<PROTOCOL_TRACE_PROCESSES {
        if (position < count) {
            if (guarded_ref(guard, protocol_trace_processes.rows)[position].seen) {
                let dest: usize = kept;
                if (dest < PROTOCOL_TRACE_PROCESSES) {
                    guarded_ref(guard, protocol_trace_processes.rows)[dest].pid =
                        guarded_ref(guard, protocol_trace_processes.rows)[position].pid;
                    guarded_ref(guard, protocol_trace_processes.rows)[dest].state =
                        guarded_ref(guard, protocol_trace_processes.rows)[position].state;
                    guarded_ref(guard, protocol_trace_processes.rows)[dest].owner =
                        guarded_ref(guard, protocol_trace_processes.rows)[position].owner;
                    guarded_ref(guard, protocol_trace_processes.rows)[dest].reason =
                        guarded_ref(guard, protocol_trace_processes.rows)[position].reason;
                    guarded_ref(guard, protocol_trace_processes.rows)[dest].parent =
                        guarded_ref(guard, protocol_trace_processes.rows)[position].parent;
                }
                kept = kept + 1;
            } else {
                protocol_trace_record(ProtocolTraceKind::Gone,
                                      guarded_ref(guard, protocol_trace_processes.rows)[position].pid,
                                      0, 0, 0, 0);
            }
        }
    }
    atomic_word_store(&protocol_trace_process_count, kept);
    if (unlocked == false) {
        atomic_word_fetch_add(&protocol_trace_sequence, 1);
    }
}

private fn protocol_trace_put(value: usize) {
    if (value == PROTOCOL_TRACE_NONE) {
        kernel_boot_log(" -");
    } else {
        kernel_boot_log(" ");
        uart_put_udec(value);
    }
}

// After protocol_trace_close, from a context that may print. One line per
// change; scripts/validate_protocol_trace.py is the only reader.
fn protocol_trace_report() {
    kernel_boot_log("protocol-trace: begin cores=");
    uart_put_udec(kernel_online_core_count());
    kernel_boot_log(" stored=");
    uart_put_udec(atomic_word_load(&protocol_trace_stored));
    kernel_boot_log(" lost=");
    uart_put_udec(atomic_word_load(&protocol_trace_lost));
    kernel_boot_log(" holds=");
    uart_put_udec(atomic_word_load(&protocol_trace_sequence));
    kernel_boot_log("\n");
    let stored: usize = atomic_word_load(&protocol_trace_stored);
    for slot: usize in 0..<PROTOCOL_TRACE_EVENTS {
        if (slot < stored) {
            kernel_boot_log("protocol-trace: ");
            uart_put_udec(protocol_trace_events[slot].sequence);
            kernel_boot_log(" ");
            uart_put_udec(protocol_trace_events[slot].cpu);
            if (protocol_trace_events[slot].unlocked) {
                kernel_boot_log(" u");
            } else {
                kernel_boot_log(" l");
            }
            match protocol_trace_events[slot].kind {
                ProtocolTraceKind::Process => { kernel_boot_log(" p"); }
                ProtocolTraceKind::Gone => { kernel_boot_log(" g"); }
                ProtocolTraceKind::Core => { kernel_boot_log(" c"); }
            }
            protocol_trace_put(protocol_trace_events[slot].first);
            protocol_trace_put(protocol_trace_events[slot].second);
            protocol_trace_put(protocol_trace_events[slot].third);
            match protocol_trace_events[slot].kind {
                ProtocolTraceKind::Process => {
                    protocol_trace_put(protocol_trace_events[slot].fourth);
                    protocol_trace_put(protocol_trace_events[slot].fifth);
                }
                ProtocolTraceKind::Gone => {}
                ProtocolTraceKind::Core => {}
            }
            kernel_boot_log("\n");
        }
    }
    kernel_boot_log("protocol-trace: end\n");
}
