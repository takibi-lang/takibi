// GitHub issue #479, Group A: every online core assigning ASIDs at once
// (two cores until GitHub issue #756; two is now the degenerate case).
//
// Written before the lock, expected to fail, for the reason the free-list
// probe next door was: "asid_next/asid_generation are unlocked globals" is
// an assertion message until somebody produces the number.
//
// What the race costs is the worst thing in this file's neighbourhood. An
// ASID is what the hardware compares to decide whether a TLB entry belongs
// to the address space asking; two address spaces holding one number is
// silent cross-process memory access, with no fault to point at.
//
// The detector: asid_assign advances asid_next by exactly one per call, so
//
//     (asid_next after) - (asid_next before)  <  (calls made)
//
// means some call did not advance it -- two cores read the same value and
// both wrote value+1. Exact, not statistical.
//
// "Calls made" is this probe's OWN pair of atomic counters and NOT
// the assign counter asid.tkb used to keep, which was the first version
// and was unsound:
// that counter is an unlocked `+ 1` on the same racing path, so it loses
// increments to the very race it was being used to detect. Measured
// saying so -- calls=3978 against advanced=3984, a difference that can
// only mean the counter undercounted, since a number cannot be handed out
// more often than it is asked for. Comparing two racy counters would have
// reported success whenever they happened to lose the same amount.
//
// Current limitations:
// - CONSUMES REAL ASIDs, because there is no private ASID allocator and a
//   copy would be testing a copy. Harmless: the space is 65535 wide and a
//   run here uses a few thousand, and the scheme is a rollover counter --
//   spending numbers is what it is for.
// - A rollover DURING the probe would make the delta arithmetic wrong (the
//   counter restarts at 1). The verdict refuses that run rather than
//   reporting a race that is really a wrap; with the current numbers it
//   cannot happen, and checking is cheaper than arguing that it cannot.
// - Measures exclusion, not ordering.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/arch/arm64/mm/asid.tkb";
use "kernel/lib/execution_model.tkb";

const ASID_CONTENTION_ROUNDS: usize = 2048;
const ASID_CONTENTION_OUTSIDE_WORK: usize = 64;

private let mut asid_probe_armed: AtomicWord;
// Completed cycles and the inside-the-run level, one word per core
// (GitHub issue #756: every online peer, index 0 is core 0's).
private let mut asid_probe_tally: PeerTally;
private let mut asid_probe_overlap: AtomicWord;

private fn asid_probe_cycle() {
    let (value, generation) = asid_assign();
    for spin: usize in 0..<ASID_CONTENTION_OUTSIDE_WORK { }
}

// Armed for `cpu` only while it still has work (GitHub issue #860).
fn asid_contention_is_armed(cpu: usize) -> bool !{unsafe} {
    return atomic_word_load(&asid_probe_armed) == 1 &&
           peer_tally_count(&asid_probe_tally, cpu) < ASID_CONTENTION_ROUNDS;
}

// Every online peer runs this from its idle loop while the probe is armed.
fn asid_contention_secondary_run(cpu: usize) !{unsafe} {
    if (peer_tally_is_peer(&asid_probe_tally, cpu) == false) { return; }
    peer_tally_enter(&asid_probe_tally, cpu);
    // One cycle, published, and then WAIT for the primary to have started.
    // GitHub issue #510: this is the second half of the start handshake
    // kernel/kernel/fd_table.tkb's probe already had and this one did not.
    // Without it, this core -- driven from the idle loop in
    // kernel/arch/arm64/kernel/secondary.tkb, which re-enters an armed
    // probe after every `wfi` wake -- can run every round and leave before
    // core 0 gets a slice, and the overlap core 0 then asserts is a number
    // from a phase the cores never shared.
    while (peer_tally_count(&asid_probe_tally, cpu) == 0 &&
           atomic_word_load(&asid_probe_armed) == 1) {
        asid_probe_cycle();
        peer_tally_add(&asid_probe_tally, cpu);
    }
    while (peer_tally_count(&asid_probe_tally, 0) == 0 &&
           atomic_word_load(&asid_probe_armed) == 1) { }
    while (peer_tally_count(&asid_probe_tally, cpu) < ASID_CONTENTION_ROUNDS &&
           atomic_word_load(&asid_probe_armed) == 1) {
        asid_probe_cycle();
        peer_tally_add(&asid_probe_tally, cpu);
    }
    peer_tally_leave(&asid_probe_tally, cpu);
}

private fn asid_contention_report(stage: *u8, advanced: usize,
                                  calls: usize) !{unsafe} {
    kernel_boot_log("asid contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("asid contention counts:");
    peer_tally_put_counts(&asid_probe_tally);
    kernel_boot_log(" calls=");
    uart_put_udec(calls);
    kernel_boot_log(" advanced=");
    uart_put_udec(advanced);
    kernel_boot_log(" overlap=");
    uart_put_udec(atomic_word_load(&asid_probe_overlap));
    kernel_boot_log("\n");
}

fn asid_contention_probe() -> bool !{unsafe} {
    let next_before: usize = asid_next_value();
    let rollovers_before: usize = asid_rollover_count_value();
    atomic_word_store(&asid_probe_overlap, 0);
    peer_tally_reset(&asid_probe_tally, kernel_online_core_count());
    atomic_word_store(&asid_probe_armed, 1);

    // GitHub issue #479: wait for a COMPLETED ROUND on every peer, not
    // merely for `active`, which a peer sets BEFORE its first cycle. Under
    // issue #478's starvation the primary can otherwise run its entire
    // phase before a peer does anything, and `overlap > 0` then fails on a
    // healthy kernel. `tag` failed on RPi5 with overlap 18 of 2048 and then
    // with 0 before this gate.
    if (peer_tally_peers_reached(&asid_probe_tally, 1,
                                 PeerTickPolicy::Entry) == false) {
        atomic_word_store(&asid_probe_armed, 0);
        asid_contention_report("secondary-never-completed-a-round" as *u8, 0, 0);
        return false;
    }

    for round: usize in 0..<ASID_CONTENTION_ROUNDS {
        asid_probe_cycle();
        peer_tally_add(&asid_probe_tally, 0);
    }

    // The slowest peer's progress when core 0 finished: above zero means
    // every online core was assigning while core 0 was.
    atomic_word_store(&asid_probe_overlap,
                      peer_tally_peers_least(&asid_probe_tally));

    let finished: bool = peer_tally_peers_reached(
        &asid_probe_tally, ASID_CONTENTION_ROUNDS, PeerTickPolicy::Finish);
    atomic_word_store(&asid_probe_armed, 0);

    // `advanced` and `calls` are read one after the other, and disarming
    // stops a peer at its next condition check rather than mid cycle. A
    // mint that lands between the two reads advances the kernel's counter
    // without advancing this probe's, and `advanced == calls` then fails on
    // a kernel that did nothing wrong. GitHub issue #510: wait for every
    // peer to be provably OUT first, the way the pool probe waits before
    // reading its live count.
    let settled: bool = peer_tally_peers_left(&asid_probe_tally,
                                              PeerTickPolicy::Entry);

    let advanced: usize = asid_next_value() - next_before;
    let calls: usize = peer_tally_count(&asid_probe_tally, 0) +
                       peer_tally_peers_sum(&asid_probe_tally);
    if (finished == false) {
        asid_contention_report("secondary-never-finished" as *u8, advanced,
                               calls);
        return false;
    }
    if (settled == false) {
        asid_contention_report("secondary-never-left" as *u8, advanced,
                                 calls);
        return false;
    }
    if (asid_rollover_count_value() != rollovers_before) {
        asid_contention_report("rolled-over" as *u8, advanced, calls);
        return false;
    }
    asid_contention_report("complete" as *u8, advanced, calls);
    let overlap: usize = atomic_word_load(&asid_probe_overlap);
    return advanced == calls && overlap > 0;
}
