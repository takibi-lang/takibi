// GitHub issue #482, carried onto the built-in RegionPool by GitHub issue
// #745: what does a pool WALK with no lock tolerate?
//
// The process records are walked with no lock -- the scheduler's pick, the
// protocol trace and the stopped-machine reporters follow
// region_pool_first_unproven/next_unproven -- and every slot such a walk
// yields is validated again, under the pool lock, before a record is read
// (region_probe_held: the slot must still be Held under the generation the
// walk saw). The RegionPool walk trusts one thing (TRUSTED_BASE.md): the
// pool is never shrunk, so a chunk a walker stands in is never released.
// What remains to show is the other half -- that a walk holding a
// reference to a record that is then freed is refused, not handed the
// slot's next occupant or its scrubbed bytes.
//
// HOW: A RENDEZVOUS, NOT A RACE (kernel/CONCURRENCY.md)
//
//     core 1: walk; at the round's record, take its reference under the
//             lock (region_held_at), publish, wait for the free
//             probe the reference         -- MUST answer Stale
//
//     core 0: allocate and hold the round's record
//             wait for the walker to be holding its reference
//             take the permission back and free the slot
//             publish released, wait for the probe
//
// The pool has one chunk of two slots: a floor record Held for the whole
// run, and the round's record. The floor is written once, so reading it
// on every walk is a control that the walk reads the slot it named.
//
// WHAT IT ASSERTS
// - `refused`: probes of a freed record's reference that answered Stale.
//   Must equal the rounds.
// - `admitted`: probes that answered Held for it. Must be ZERO.
// - `floor_bad`: a floor read that was not the sentinel. Must be ZERO.
//
// Current limitations:
// - The intrusive pool's half of #482 -- a walk across a chunk released
//   underneath it -- has no counterpart: a RegionPool walked this way is
//   never shrunk, which TRUSTED_BASE.md records instead of a probe.
// - The view-holds-the-lock phase is gone with IntrusivePool: a RegionPool
//   view lives inside its caller's pool guard, which the type states.
// - The verdict is a LOWER BOUND on a real machine, like every QEMU
//   concurrency result -- see kernel/CONCURRENCY.md.
use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/lib/execution_model.tkb";

const POOL_WALK_ROUNDS: usize = 64;
const POOL_WALK_SENTINEL: usize = 0x5AFE5107;
// A walk's own termination bound: a two-slot pool is covered many times.
const POOL_WALK_STEP_BUDGET: usize = 64;
const POOL_WALK_CHUNK_PAGES: usize = 1;

// Wide enough that one page holds two slots: the floor and the round's.
struct PoolWalkItem {
    stamp: usize;
    filler: [usize; 250];
}

private let mut pool_walk_pool: RegionPool(PoolWalkItem);
private let mut pool_walk_ready: bool = false;
private let mut pool_walk_floor: RegionHeld(PoolWalkItem);

private let mut pool_walk_armed: AtomicWord;
// The rendezvous, as round numbers (GitHub issue #510): core 0 publishes
// `seq`, the walker answers `held_seq` holding that round's reference,
// core 0 answers `released_seq` once it is freed, and the walker answers
// `probed_seq` once it has asked.
private let mut pool_walk_seq: AtomicWord;
// Per peer (GitHub issue #756: every online peer walks): the last round
// whose record it holds, and the last it probed after the free.
private let mut pool_walk_held_seq: PeerTally;
private let mut pool_walk_released_seq: AtomicWord;
private let mut pool_walk_probed_seq: PeerTally;
// The round's record address, published by core 0.
private let mut pool_walk_target: AtomicWord;

private let mut pool_walk_rounds_met: AtomicWord;
private let mut pool_walk_refused: AtomicWord;
private let mut pool_walk_admitted: AtomicWord;
private let mut pool_walk_floor_bad: AtomicWord;
private let mut pool_walk_steps: AtomicWord;

private fn pool_walk_armed_address() -> *AtomicWord { return &pool_walk_armed; }
private fn pool_walk_seq_address() -> *AtomicWord { return &pool_walk_seq; }
private fn pool_walk_released_seq_address() -> *AtomicWord { return &pool_walk_released_seq; }
private fn pool_walk_target_address() -> *AtomicWord { return &pool_walk_target; }
private fn pool_walk_rounds_met_address() -> *AtomicWord { return &pool_walk_rounds_met; }
private fn pool_walk_refused_address() -> *AtomicWord { return &pool_walk_refused; }
private fn pool_walk_admitted_address() -> *AtomicWord { return &pool_walk_admitted; }
private fn pool_walk_floor_bad_address() -> *AtomicWord { return &pool_walk_floor_bad; }
private fn pool_walk_steps_address() -> *AtomicWord { return &pool_walk_steps; }

private fn pool_walk_lock() -> RegionPoolGuard(PoolWalkItem)[&pool_walk_pool] !{unsafe, acquires_lock_40_pool_walk_pool, single_instance_lock,
          lock_guard_40_pool_walk_pool} {
    let flags: usize = mutex_irq_save();
    return region_pool_lock_saving(&pool_walk_pool, flags);
}

private fn pool_walk_unlock(guard: sink RegionPoolGuard(PoolWalkItem)[&pool_walk_pool]) {
    mutex_irq_restore(region_pool_unlock_saved(guard));
}

// The stamp of the Held record a reference names, or 0 when it is Stale.
private fn pool_walk_read(held: RegionHeld(PoolWalkItem)) -> usize !{unsafe} {
    let guard = pool_walk_lock();
    let mut stamp: usize = 0;
    match region_probe_held(guard, held) {
        RegionHeldProbe(PoolWalkItem)::Stale => {}
        RegionHeldProbe(PoolWalkItem)::Held(found) => {
            stamp = region_held_record(found).stamp;
            region_held_view_drop(found);
        }
    }
    pool_walk_unlock(guard);
    return stamp;
}

private fn pool_walk_held_at(address: usize) -> RegionHeld(PoolWalkItem) !{unsafe} {
    let guard = pool_walk_lock();
    let mut held: RegionHeld(PoolWalkItem) = region_held_at(guard, address);
    pool_walk_unlock(guard);
    return held;
}

// A record allocated, stamped and Held, or none.
private fn pool_walk_hold() -> RegionHeld(PoolWalkItem) !{unsafe} {
    let guard = pool_walk_lock();
    let mut held: RegionHeld(PoolWalkItem) = region_held_none__PoolWalkItem();
    match region_alloc(guard) {
        RegionPoolAlloc(PoolWalkItem)::Full => {}
        RegionPoolAlloc(PoolWalkItem)::Exhausted => {}
        RegionPoolAlloc(PoolWalkItem)::Allocated(slot) => {
            region_slot_zero(slot);
            region_slot_record(slot).stamp = POOL_WALK_SENTINEL;
            held = region_hold(guard, slot);
        }
    }
    pool_walk_unlock(guard);
    return held;
}

private fn pool_walk_release(held: RegionHeld(PoolWalkItem)) -> bool !{unsafe} {
    let guard = pool_walk_lock();
    match region_take_held(guard, held) {
        RegionTake(PoolWalkItem)::Stale => { pool_walk_unlock(guard); return false; }
        RegionTake(PoolWalkItem)::Taken(slot) => {
            region_slot_zero(slot);
            region_free(guard, slot);
            pool_walk_unlock(guard);
            return true;
        }
    }
}

// Core 0, before arming: the one chunk and the floor record. The chunk is
// kept for the rest of the boot (a walked pool is never shrunk).
private fn pool_walk_init() -> bool !{unsafe} {
    if (pool_walk_ready) { return region_held_address(pool_walk_floor) != 0; }
    pool_walk_ready = true;
    pool_walk_floor = region_held_none__PoolWalkItem();
    match page_alloc_contiguous(POOL_WALK_CHUNK_PAGES, PageOwnerTag::PoolChunk) {
        PageRunAllocResult::OutOfMemory => { return false; }
        PageRunAllocResult::Allocated(run_owner) => {
            let base: usize = page_run_physical_address(run_owner);
            let RegionBytes::Assumed(chunk) = page_run_into_region(run_owner) else {};
            let guard = pool_walk_lock();
            let mut grown: bool = false;
            match region_pool_grow(guard, chunk) {
                RegionGrow(PoolWalkItem)::Grown => { grown = true; }
                RegionGrow(PoolWalkItem)::TooSmall(back) => {
                    region_release(back);
                    page_run_transferred_release_physical(base, POOL_WALK_CHUNK_PAGES);
                }
            }
            pool_walk_unlock(guard);
            if (grown == false) { return false; }
        }
    }
    pool_walk_floor = pool_walk_hold();
    return region_held_address(pool_walk_floor) != 0;
}

// -- The walking core --------------------------------------------------

// Armed for `cpu` while it is a peer: the run function holds it until
// disarmed, so it cannot re-enter an armed probe (GitHub issue #860).
fn pool_walk_contention_is_armed(cpu: usize) -> bool !{unsafe} {
    return atomic_word_load(pool_walk_armed_address()) == 1 &&
           peer_tally_is_peer(&pool_walk_held_seq, cpu);
}

// One enumeration with no lock. Every slot is validated under the lock;
// the round's record is where this core stops and hands the round over.
private fn pool_walk_once(cpu: usize) !{unsafe} {
    let round: usize = atomic_word_load(pool_walk_seq_address());
    let target: usize = atomic_word_load(pool_walk_target_address());
    let mut cursor: usize = region_pool_first_unproven(&pool_walk_pool);
    let mut budget: usize = POOL_WALK_STEP_BUDGET;
    let mut crossed: bool = false;
    while (cursor != 0 && budget != 0 && crossed == false) {
        budget = budget - 1;
        atomic_word_fetch_add(pool_walk_steps_address(), 1);
        if (cursor == region_held_address(pool_walk_floor)) {
            if (pool_walk_read(pool_walk_held_at(cursor)) != POOL_WALK_SENTINEL) {
                atomic_word_fetch_add(pool_walk_floor_bad_address(), 1);
            }
        } else if (round != 0 && cursor == target &&
                   peer_tally_count(&pool_walk_held_seq, cpu) < round) {
            // THE RENDEZVOUS: the reference the walk obtained, held while
            // core 0 frees the record it names.
            let mut held: RegionHeld(PoolWalkItem) = pool_walk_held_at(cursor);
            if (region_held_address(held) != 0) {
                crossed = true;
                peer_tally_set(&pool_walk_held_seq, cpu, round);
                let mut window = peer_tick_window_policy(
                    peer_tick_window_peer(), PeerTickPolicy::Entry);
                let mut released: bool = false;
                while (released == false && peer_tick_window_open(window) &&
                       atomic_word_load(pool_walk_armed_address()) == 1) {
                    if (atomic_word_load(pool_walk_released_seq_address()) >= round) {
                        released = true;
                    }
                }
                peer_tick_window_end(window);
                if (released) {
                    if (pool_walk_read(held) == 0) {
                        atomic_word_fetch_add(pool_walk_refused_address(), 1);
                    } else {
                        atomic_word_fetch_add(pool_walk_admitted_address(), 1);
                    }
                    atomic_word_fetch_add(pool_walk_rounds_met_address(), 1);
                }
                peer_tally_set(&pool_walk_probed_seq, cpu, round);
            }
        }
        cursor = region_pool_next_unproven(&pool_walk_pool, cursor);
    }
}

// Every online peer runs this from its idle loop while the probe is armed.
fn pool_walk_contention_secondary_run(cpu: usize) !{unsafe} {
    if (peer_tally_is_peer(&pool_walk_held_seq, cpu) == false) { return; }
    peer_tally_enter(&pool_walk_held_seq, cpu);
    while (atomic_word_load(pool_walk_armed_address()) == 1) {
        pool_walk_once(cpu);
    }
    peer_tally_leave(&pool_walk_held_seq, cpu);
}

// -- The churning core -------------------------------------------------

private fn pool_walk_report(stage: *u8) !{unsafe} {
    kernel_boot_log("pool walk stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("pool walk counts: rounds=");
    uart_put_udec(POOL_WALK_ROUNDS);
    kernel_boot_log(" met=");
    uart_put_udec(atomic_word_load(pool_walk_rounds_met_address()));
    kernel_boot_log(" refused=");
    uart_put_udec(atomic_word_load(pool_walk_refused_address()));
    kernel_boot_log(" admitted=");
    uart_put_udec(atomic_word_load(pool_walk_admitted_address()));
    kernel_boot_log(" floor_bad=");
    uart_put_udec(atomic_word_load(pool_walk_floor_bad_address()));
    kernel_boot_log(" steps=");
    uart_put_udec(atomic_word_load(pool_walk_steps_address()));
    kernel_boot_log("\n");
}

// Wait, bounded by the peer's ticks, for the other core to reach `target`.
// Every online peer's word in `tally` at `target`, each wait bounded by that
// peer's own ticks.
private fn pool_walk_await(tally: &mut PeerTally, target: usize)
        -> bool !{unsafe} {
    return peer_tally_peers_reached(tally, target, PeerTickPolicy::Entry);
}

must_use variant PoolWalkRound { Met; Failed(*u8); }

private fn pool_walk_round(round: usize) -> PoolWalkRound !{unsafe} {
    let mut held: RegionHeld(PoolWalkItem) = pool_walk_hold();
    if (region_held_address(held) == 0) {
        return PoolWalkRound::Failed("pool-full" as *u8);
    }
    atomic_word_store(pool_walk_target_address(), region_held_address(held));
    atomic_word_store(pool_walk_seq_address(), round);
    // The walker has to hold the reference BEFORE the record goes.
    let walker_held: bool = pool_walk_await(&pool_walk_held_seq, round);
    let freed: bool = pool_walk_release(held);
    if (freed == false) { return PoolWalkRound::Failed("record-not-freed" as *u8); }
    if (walker_held == false) { return PoolWalkRound::Failed("walk-never-held-it" as *u8); }
    atomic_word_store(pool_walk_released_seq_address(), round);
    if (pool_walk_await(&pool_walk_probed_seq, round) == false) {
        return PoolWalkRound::Failed("walk-never-probed-it" as *u8);
    }
    return PoolWalkRound::Met;
}

fn pool_walk_contention_probe() -> bool !{allocates, unsafe} {
    if (pool_walk_init() == false) {
        pool_walk_report("floor-not-taken" as *u8);
        return false;
    }
    let online: usize = kernel_online_core_count();
    peer_tally_reset(&pool_walk_held_seq, online);
    peer_tally_reset(&pool_walk_probed_seq, online);
    let peers: usize = peer_tally_peers(&pool_walk_held_seq);
    atomic_word_store(pool_walk_armed_address(), 1);
    // Every peer's own entry count, each wait bounded by that peer's ticks.
    let entered: bool = peers > 0 && peer_tally_peers_entered(
        &pool_walk_held_seq, PeerTickPolicy::Entry);
    if (entered == false) {
        atomic_word_store(pool_walk_armed_address(), 0);
        pool_walk_report("secondary-never-entered" as *u8);
        return false;
    }

    let mut rounds_ok: bool = true;
    let mut round_stage: *u8 = "rounds-not-run" as *u8;
    for round: usize in 0..<POOL_WALK_ROUNDS {
        if (rounds_ok) {
            match pool_walk_round(round + 1) {
                PoolWalkRound::Met => { }
                PoolWalkRound::Failed(stage) => {
                    rounds_ok = false;
                    round_stage = stage;
                }
            }
        }
    }
    atomic_word_store(pool_walk_armed_address(), 0);
    let settled: bool = peer_tally_peers_left(&pool_walk_held_seq,
                                              PeerTickPolicy::Entry);
    if (rounds_ok == false) {
        pool_walk_report(round_stage);
        return false;
    }
    if (settled == false) {
        pool_walk_report("secondary-never-left" as *u8);
        return false;
    }
    pool_walk_report("complete" as *u8);
    let met: usize = atomic_word_load(pool_walk_rounds_met_address());
    let refused: usize = atomic_word_load(pool_walk_refused_address());
    let admitted: usize = atomic_word_load(pool_walk_admitted_address());
    let floor_bad: usize = atomic_word_load(pool_walk_floor_bad_address());
    // Every round, every peer.
    if (met != POOL_WALK_ROUNDS * peers) {
        kernel_boot_log("pool walk: a round ended without the walk holding the freed record's reference, so it proved nothing\n");
        return false;
    }
    if (admitted != 0) {
        kernel_boot_log("pool walk: a walk's reference to a freed record was answered Held, which is the defect\n");
        return false;
    }
    if (refused != POOL_WALK_ROUNDS * peers) {
        kernel_boot_log("pool walk: a freed record's reference was neither refused nor admitted\n");
        return false;
    }
    if (floor_bad != 0) {
        kernel_boot_log("pool walk: the floor record read back something other than its stamp\n");
        return false;
    }
    return true;
}
