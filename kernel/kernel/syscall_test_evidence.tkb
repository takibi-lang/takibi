// Part of #294 (consolidate kernel runtime state behind explicit owners),
// same split as issue #303 applied to kernel/kernel/process.tkb. These
// thirteen syscall.tkb counters are read only by
// kernel_syscall_socket_evidence() and by four log-once wait boot
// messages -- never by real syscall dispatch decisions, unlike
// syscall_connection_open (per-connection open state, stays in
// syscall.tkb) or the persistent-service/shell lifecycle state (real
// control-flow branches on those; a separate, later split out of #294).
//
// Current limitations (2026-09-26): the UART one-shot counters are used by
// the core-0 boot and shell fixture. The socket counters are enabled only
// during the connected-I/O fixture and frozen before HTTPd starts. Since
// GitHub issue #598 admitted the socket calls on a peer, the fixture's own
// calls may run on any CPU, so each socket counter is read and written
// under the process-run lock. The enable flag is
// written by core 0 at configure and at the fixture's end only.
// GitHub issue #1475: the fields are AtomicWords (the flag 1 or 0); a
// counter's first-time test reads fetch_add's previous value.

use "kernel/lib/atomic_word.tkb";

struct SyscallTestEvidence {
    ppoll_uart_waits: AtomicWord;
    ppoll_uart_blocks: AtomicWord;
    ppoll_pause_blocks: AtomicWord;
    read_uart_waits: AtomicWord;
    socket_calls: AtomicWord;
    bind_calls: AtomicWord;
    listen_calls: AtomicWord;
    socket_close_calls: AtomicWord;
    accept_calls: AtomicWord;
    accept_capability_roundtrips: AtomicWord;
    connected_close_calls: AtomicWord;
    connected_read_calls: AtomicWord;
    connected_write_calls: AtomicWord;
    socket_fixture_active: AtomicWord;
}

private let mut syscall_test_evidence: SyscallTestEvidence;

fn syscall_test_evidence_reset_read_uart_waits() {
    atomic_word_store(&syscall_test_evidence.read_uart_waits, 0);
}

fn syscall_test_evidence_reset_socket_counters() {
    atomic_word_store(&syscall_test_evidence.socket_fixture_active, 1);
    atomic_word_store(&syscall_test_evidence.socket_calls, 0);
    atomic_word_store(&syscall_test_evidence.bind_calls, 0);
    atomic_word_store(&syscall_test_evidence.listen_calls, 0);
    atomic_word_store(&syscall_test_evidence.socket_close_calls, 0);
    atomic_word_store(&syscall_test_evidence.accept_calls, 0);
    atomic_word_store(&syscall_test_evidence.accept_capability_roundtrips, 0);
    atomic_word_store(&syscall_test_evidence.connected_close_calls, 0);
    atomic_word_store(&syscall_test_evidence.connected_read_calls, 0);
    atomic_word_store(&syscall_test_evidence.connected_write_calls, 0);
}

fn syscall_test_evidence_finish_socket_fixture() {
    atomic_word_store(&syscall_test_evidence.socket_fixture_active, 0);
}

// Returns true only the first time since the last
// syscall_test_evidence_reset_read_uart_waits() -- callers use that to gate
// a one-time boot log line, mirroring
// process_test_evidence_record_uart_block()'s own pattern.
fn syscall_test_evidence_record_ppoll_uart_wait() -> bool {
    return atomic_word_fetch_add(&syscall_test_evidence.ppoll_uart_waits, 1) == 0;
}

// The same one-time pattern, for a stdin ppoll that blocked beside a Ready
// process instead of retrying in the kernel (GitHub issue #9).
fn syscall_test_evidence_record_ppoll_uart_block() -> bool {
    return atomic_word_fetch_add(&syscall_test_evidence.ppoll_uart_blocks, 1) == 0;
}

// The same one-time pattern, for ppoll(0, NULL) -- pause() -- that blocked
// until a signal instead of waiting Running in the kernel (GitHub issue #870).
fn syscall_test_evidence_record_ppoll_pause_block() -> bool {
    return atomic_word_fetch_add(&syscall_test_evidence.ppoll_pause_blocks, 1) == 0;
}

fn syscall_test_evidence_record_read_uart_wait() -> bool {
    return atomic_word_fetch_add(&syscall_test_evidence.read_uart_waits, 1) == 0;
}

fn syscall_test_evidence_record_socket() {
    if (atomic_word_load(&syscall_test_evidence.socket_fixture_active) == 0) { return; }
    let guard = process_run_lock();
    atomic_word_fetch_add(&syscall_test_evidence.socket_calls, 1);
    process_run_unlock(guard);
}

fn syscall_test_evidence_socket_calls() -> usize {
    let guard = process_run_lock();
    let value: usize = atomic_word_load(&syscall_test_evidence.socket_calls);
    process_run_unlock(guard);
    return value;
}

