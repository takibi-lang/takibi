// Part of #294 (consolidate kernel runtime state behind explicit owners),
// same split as issue #303 applied to kernel/kernel/process.tkb. These
// twelve syscall.tkb counters are read only by
// kernel_syscall_socket_evidence() and by three log-once UART-wait boot
// messages -- never by real syscall dispatch decisions, unlike
// syscall_connection_open (per-connection open state, stays in
// syscall.tkb) or the persistent-service/shell lifecycle state (real
// control-flow branches on those; a separate, later split out of #294).
//
// Current limitations: single-writer, matching kernel/kernel/syscall.tkb's
// own "NOT SYNCHRONIZED, single-core dispatch only" limitation -- every
// record_*() call here assumes it runs to completion on core 0 with no
// concurrent syscall dispatch from another core.
//
// One exception (2026-09-24): connected_read_calls, connected_write_calls
// and partial_write_observed are also recorded from a peer since GitHub
// issue #581 admitted connected read/write there. They still have one
// writer at a time only because one process uses a connected descriptor at
// a time: the resident HTTPd's listener refuses to accept while its
// connection child is alive, and the inetd and boot socket fixtures run on
// core 0 before it starts. A second concurrent connection user would make
// these counts racy.

struct SyscallTestEvidence {
    ppoll_uart_waits: usize;
    ppoll_uart_blocks: usize;
    read_uart_waits: usize;
    socket_calls: usize;
    bind_calls: usize;
    listen_calls: usize;
    socket_close_calls: usize;
    accept_calls: usize;
    accept_capability_roundtrips: usize;
    connected_close_calls: usize;
    connected_read_calls: usize;
    connected_write_calls: usize;
}

private let mut syscall_test_evidence: SyscallTestEvidence;

fn syscall_test_evidence_reset_read_uart_waits() {
    syscall_test_evidence.read_uart_waits = 0;
}

fn syscall_test_evidence_reset_socket_counters() {
    syscall_test_evidence.socket_calls = 0;
    syscall_test_evidence.bind_calls = 0;
    syscall_test_evidence.listen_calls = 0;
    syscall_test_evidence.socket_close_calls = 0;
    syscall_test_evidence.accept_calls = 0;
    syscall_test_evidence.accept_capability_roundtrips = 0;
    syscall_test_evidence.connected_close_calls = 0;
    syscall_test_evidence.connected_read_calls = 0;
    syscall_test_evidence.connected_write_calls = 0;
}

// Returns true only the first time since the last
// syscall_test_evidence_reset_read_uart_waits() -- callers use that to gate
// a one-time boot log line, mirroring
// process_test_evidence_record_uart_block()'s own pattern.
fn syscall_test_evidence_record_ppoll_uart_wait() -> bool {
    syscall_test_evidence.ppoll_uart_waits =
        syscall_test_evidence.ppoll_uart_waits + 1;
    return syscall_test_evidence.ppoll_uart_waits == 1;
}

// The same one-time pattern, for a stdin ppoll that blocked beside a Ready
// process instead of retrying in the kernel (GitHub issue #9).
fn syscall_test_evidence_record_ppoll_uart_block() -> bool {
    syscall_test_evidence.ppoll_uart_blocks =
        syscall_test_evidence.ppoll_uart_blocks + 1;
    return syscall_test_evidence.ppoll_uart_blocks == 1;
}

fn syscall_test_evidence_record_read_uart_wait() -> bool {
    syscall_test_evidence.read_uart_waits =
        syscall_test_evidence.read_uart_waits + 1;
    return syscall_test_evidence.read_uart_waits == 1;
}

fn syscall_test_evidence_record_socket() {
    syscall_test_evidence.socket_calls =
        syscall_test_evidence.socket_calls + 1;
}

fn syscall_test_evidence_socket_calls() -> usize {
    return syscall_test_evidence.socket_calls;
}

fn syscall_test_evidence_record_bind() {
    syscall_test_evidence.bind_calls = syscall_test_evidence.bind_calls + 1;
}

fn syscall_test_evidence_bind_calls() -> usize {
    return syscall_test_evidence.bind_calls;
}

fn syscall_test_evidence_record_listen() {
    syscall_test_evidence.listen_calls =
        syscall_test_evidence.listen_calls + 1;
}

fn syscall_test_evidence_listen_calls() -> usize {
    return syscall_test_evidence.listen_calls;
}

fn syscall_test_evidence_record_socket_close() {
    syscall_test_evidence.socket_close_calls =
        syscall_test_evidence.socket_close_calls + 1;
}

fn syscall_test_evidence_socket_close_calls() -> usize {
    return syscall_test_evidence.socket_close_calls;
}

fn syscall_test_evidence_record_accept() {
    syscall_test_evidence.accept_calls =
        syscall_test_evidence.accept_calls + 1;
}

fn syscall_test_evidence_accept_calls() -> usize {
    return syscall_test_evidence.accept_calls;
}

fn syscall_test_evidence_record_accept_capability_roundtrip() {
    syscall_test_evidence.accept_capability_roundtrips =
        syscall_test_evidence.accept_capability_roundtrips + 1;
}

fn syscall_test_evidence_accept_capability_roundtrips() -> usize {
    return syscall_test_evidence.accept_capability_roundtrips;
}

fn syscall_test_evidence_record_connected_close() {
    syscall_test_evidence.connected_close_calls =
        syscall_test_evidence.connected_close_calls + 1;
}

fn syscall_test_evidence_connected_close_calls() -> usize {
    return syscall_test_evidence.connected_close_calls;
}

fn syscall_test_evidence_record_connected_read() {
    syscall_test_evidence.connected_read_calls =
        syscall_test_evidence.connected_read_calls + 1;
}

fn syscall_test_evidence_connected_read_calls() -> usize {
    return syscall_test_evidence.connected_read_calls;
}

fn syscall_test_evidence_record_connected_write() {
    syscall_test_evidence.connected_write_calls =
        syscall_test_evidence.connected_write_calls + 1;
}

fn syscall_test_evidence_connected_write_calls() -> usize {
    return syscall_test_evidence.connected_write_calls;
}
