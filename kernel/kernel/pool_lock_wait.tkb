// GitHub issue #953: how often a production region pool's lock was found
// held when a core came to take it. The evidence that brings parked
// issue #680 (region_pool validation under the pool lock) back:
// scripts/check_parked_triggers.py reads the RECORDED line below from the
// RPi5 log and fails when the contended count passes the threshold its
// header derives.
//
// Each production pool's lock wrapper asks region_pool_lock_contended_hint before
// it takes the lock (one load of the line the compare-exchange fetches
// anyway) and, only when the lock is held, counts one contended acquire in
// its own CPU's row: plain stores to a line no other CPU writes, so
// counting creates no contention of its own, and the uncontended path
// counts nothing (#953: counting every acquire cost 6.1 ns per pair).
//
// Current limitations (2026-10-24). Keep this list current as call sites
// change; a stale limitation is worse than none.
// - CONTENDED MEANS "SEEN HELD AT THE DOOR", not spin iterations or wait
//   time: a core that found the lock free but lost the compare-exchange
//   counts as uncontended. It is a lower bound on contention.
// - THE CONTENTION PROBES ARE NOT COUNTED. contention_probes() pauses the
//   count while its deliberately dense fixtures run (the tcp pool cost
//   fixture alone takes the TCP pool lock ~100k times from every core); a
//   real acquire on another core during that window is not counted either.
// - ONLY THE TEN PRODUCTION POOLS listed below are counted; fixture-private
//   pools (pin sharing, pool walk, pool contention) are not.

use "kernel/lib/atomic_word.tkb";
use "kernel/lib/execution_model.tkb";

const POOL_LOCK_WAIT_POOLS: usize = 10;

variant PoolLockWaitPool {
    Process;
    FdBlock;
    FdContext;
    Object;
    AddressSpace;
    ProcessImage;
    TcpConnection;
    TcpFrame;
    TcpRetx;
    Pipe;
}

inline fn pool_lock_wait_index(pool: PoolLockWaitPool) -> {0..<POOL_LOCK_WAIT_POOLS as usize} {
    match pool {
        PoolLockWaitPool::Process => { return 0; }
        PoolLockWaitPool::FdBlock => { return 1; }
        PoolLockWaitPool::FdContext => { return 2; }
        PoolLockWaitPool::Object => { return 3; }
        PoolLockWaitPool::AddressSpace => { return 4; }
        PoolLockWaitPool::ProcessImage => { return 5; }
        PoolLockWaitPool::TcpConnection => { return 6; }
        PoolLockWaitPool::TcpFrame => { return 7; }
        PoolLockWaitPool::TcpRetx => { return 8; }
        PoolLockWaitPool::Pipe => { return 9; }
    }
}

// Per CPU, per pool: the contended acquires. A row is 16 words (two
// 64-byte lines) so no two CPUs' rows share a line. Only the row's own CPU
// writes it, with plain loads and stores and no barrier; the reporter sums
// the rows once, after the suite (a stale read there costs at most a count
// in flight).
const POOL_LOCK_WAIT_ROW: usize = 16;
struct PoolLockWaitCore { words: [usize; POOL_LOCK_WAIT_ROW]; }
private let mut pool_lock_wait_cores: [PoolLockWaitCore; KERNEL_MAX_CORES];
// 1 while contention_probes() runs its deliberate contention fixtures.
// Written by core 0 twice per boot; read only on the contended path.
private let mut pool_lock_wait_paused: AtomicWord;

// Called by a pool's lock wrapper, before it takes the lock, only when
// region_pool_lock_contended_hint said the lock is held: the uncontended path
// pays one load of the lock line the compare-exchange fetches anyway.
fn pool_lock_wait_contended(tag: PoolLockWaitPool) !{unsafe} {
    if (atomic_word_load(&pool_lock_wait_paused) != 0) { return; }
    let raw: usize = cpu_id();
    if (raw >= KERNEL_MAX_CORES) { return; }
    let core: {0..<KERNEL_MAX_CORES as usize} = raw;
    let at: {0..<POOL_LOCK_WAIT_POOLS as usize} = pool_lock_wait_index(tag);
    pool_lock_wait_cores[core].words[at] = pool_lock_wait_cores[core].words[at] + 1;
}

fn pool_lock_wait_pause(paused: bool) {
    if (paused) {
        atomic_word_store(&pool_lock_wait_paused, 1);
    } else {
        atomic_word_store(&pool_lock_wait_paused, 0);
    }
}

// One RECORDED line: per pool, the contended acquires. A cost, not a verdict
// here; the verdict is scripts/check_parked_triggers.py's.
fn pool_lock_wait_log() !{unsafe} {
    kernel_boot_log("RECORDED pool lock wait:");
    pool_lock_wait_log_one(" process=", PoolLockWaitPool::Process);
    pool_lock_wait_log_one(" fd_block=", PoolLockWaitPool::FdBlock);
    pool_lock_wait_log_one(" fd_context=", PoolLockWaitPool::FdContext);
    pool_lock_wait_log_one(" object=", PoolLockWaitPool::Object);
    pool_lock_wait_log_one(" address_space=", PoolLockWaitPool::AddressSpace);
    pool_lock_wait_log_one(" process_image=", PoolLockWaitPool::ProcessImage);
    pool_lock_wait_log_one(" tcp_connection=", PoolLockWaitPool::TcpConnection);
    pool_lock_wait_log_one(" tcp_frame=", PoolLockWaitPool::TcpFrame);
    pool_lock_wait_log_one(" tcp_retx=", PoolLockWaitPool::TcpRetx);
    pool_lock_wait_log_one(" pipe=", PoolLockWaitPool::Pipe);
    kernel_boot_log("\n");
}

private fn pool_lock_wait_log_one(label: *u8, tag: PoolLockWaitPool) {
    let at: {0..<POOL_LOCK_WAIT_POOLS as usize} = pool_lock_wait_index(tag);
    let mut contended: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        contended = contended + pool_lock_wait_cores[core].words[at];
    }
    kernel_boot_log(label);
    uart_put_udec(contended);
}
