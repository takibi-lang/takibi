use "kernel/lib/intrusive_pool.tkb";

// Current limitations (2026-08-24, issues #295/#392/#391). Keep this list
// current as call sites change; a limitation that goes stale here is
// worse than none, since it invites relying on a guarantee that quietly
// stopped holding.
// - NOT SYNCHRONIZED. Reachable only from single-core boot/syscall-
//   dispatch context today, same as every kernel/lib/-backed pool this
//   file builds on (IntrusivePool).
// - unified_object_retain()/_release() are a bare counter increment/
//   decrement on SharedObject.refs, not linear-tracked: nothing in the
//   type system proves a caller's retains and releases stay balanced.
//   Issue #391 moved that counter out of RefcountSlotMap and into the
//   object; it did not make it any more checkable, and issue #297 is
//   still the issue that would. unified_fd_clone() leaked exactly this way on a mid-loop
//   failure (fixed via unified_fd_clone_rollback(), issue #295) --
//   every NEW multi-retain call site must roll back its own already-
//   retained references by hand on any failure path; the compiler will
//   not catch a forgotten one.
// - A process's fd context is acquired by scheduled_process_alloc() and
//   released by scheduled_process_reap()/scheduled_process_table_clear()
//   (issue #392), EXCEPT for the bootstrap process, which this kernel
//   sets up directly and which therefore gets its context from
//   kernel_syscall_process_configure(). A future process created by some
//   third path would silently have no fd table: every entry point here
//   would refuse it, correctly but confusingly, and the fix is to give
//   that path the same ensure call rather than to make lookups forgiving.
// - Fixed capacities (PROCESS_FD_MAX=16, and the computed shared-object
//   reference bound): see `kernel/RESOURCE_LIMITS.md` for the
//   authoritative exhaustion-result/boundary-test contract for each.
//   Neither the number of fd CONTEXTS (issue #392) nor the number of
//   shared OBJECTS (issue #391) is among them any more.
//
// GitHub issues #246 and #264: process index == kernel/kernel/process.tkb's
// ProcessHandle.pool_index. One ProcessFdContext keeps the descriptor and
// heap state for that process together, instead of coupling parallel globals
// through a flat process * PROCESS_FD_MAX + fd index.

// Ash reserves a script fd at 10 with F_DUPFD_CLOEXEC. Keep a small but real
// per-process descriptor namespace rather than treating fd 3 as a special
// file-only slot.
const PROCESS_FD_MAX: usize = 16;
// GitHub issue #391: there is no shared-object capacity constant any
// more. SHARED_OBJECT_MAX was 16 open file descriptions system-wide --
// the one ceiling in this file that was a genuine resource limit rather
// than a restatement of the process table's, and a shell running a
// pipeline over a few files was not far from it. What replaces it is the
// shape Linux uses: an open file description is an individually allocated
// object (`struct file`, out of the filp cache), and what bounds how many
// can exist is derived from the memory the machine has rather than
// picked -- see unified_object_max_files below.
// Every descriptor slot could in principle
// hold its own reference to the same shared object (unified_fd_clone/
// unified_fd_duplicate both create independent references to an existing
// object rather than new objects), so that is the real bound on
// simultaneous holders -- see kernel/lib/refcount_slotmap.tkb's header
// for why this is passed explicitly rather than left an unbounded usize,
// and unified_object_ref_bound below for where this kernel's number comes
// from now that it is computed rather than declared.

enum UnifiedFdKind: u8 {
    Empty;
    Terminal;
    OpenFile;
    Directory;
    Listener;
    Connection;
}
enum UnifiedListenerState: u8 { Closed; Created; Bound; Listening; }
// GitHub issue #264 third stage: descriptor state and the process heap break
// share one record, so a process slot has one local FD context rather than
// five globals that must be indexed in lockstep.
struct ProcessFdContext {
    fd_kind: [UnifiedFdKind; PROCESS_FD_MAX];
    fd_object: [usize; PROCESS_FD_MAX];
    fd_generation: [usize; PROCESS_FD_MAX];
    fd_close_on_exec: [bool; PROCESS_FD_MAX];
    heap_break: usize;
    heap_start: usize;
    heap_limit: usize;
}
// GitHub issue #392: pooled, not an array keyed by process slot.
//
// An array keyed by slot cannot outlive the slot, and the slot is the
// ceiling this is on the way to removing. The handle lives in the process
// record (ProcessRecord.fd_context), because this file cannot hold a
// table keyed by process without reintroducing exactly the bound being
// removed.
//
// Allocated with the process, in scheduled_process_alloc's existing
// rollback chain beside its kernel stack and address-space root, and
// released with it -- so a live slot always has a context, and
// fd_context_address returning 0 means the caller named a slot that is
// not a live process.
//
// insert_zeroed, not insert: UnifiedFdKind::Empty is declaration-order tag
// zero and heap_break/_start/_limit all start at 0, so a zeroed payload IS
// the empty table this file's init loop used to write by hand.
private let mut fd_context_pool: IntrusivePool(ProcessFdContext);

// The pooled context for a process slot, or 0 if that slot has none.
// Every entry point below tests this instead of the `process <
// KERNEL_PROCESS_MAX` bound it used to test -- the question was never
// really "is this index in range", it was "does this process have an fd
// table", and only one of those survives the array going away.
private fn fd_context_address(process: usize) -> usize !{unsafe} {
    let address: usize = scheduled_process_fd_context(process);
    if (address == 0) { return 0; }
    let generation: usize = scheduled_process_fd_context_generation(process);
    // The handle is (address, generation) and both halves are checked: a
    // stale pair naming a recycled slot is exactly the use-after-free
    // intrusive_pool_matches exists to refuse.
    if (intrusive_pool_matches(&fd_context_pool, address, generation) == false) {
        return 0;
    }
    return address;
}

// The PAYLOAD, not the slot. A slot address is the address of
// IntrusiveSlot(T), whose first word is the occupant generation -- casting
// it straight to *ProcessFdContext puts every field 8 bytes early, which
// reads the generation's low byte as fd_kind[0] and is exactly as quiet as
// that sounds. The pool's own accessor knows the offset; nothing here
// should.
private fn fd_context_at(process: usize) -> *ProcessFdContext !{unsafe} {
    let address: usize = scheduled_process_fd_context(process);
    let generation: usize = scheduled_process_fd_context_generation(process);
    let owner = intrusive_owner_new(&fd_context_pool, address, generation);
    let payload: *ProcessFdContext = intrusive_pool_ref(&fd_context_pool, owner);
    intrusive_owner_drop(owner);
    return payload;
}

// Called from scheduled_process_alloc, which owns the rollback if this
// fails. Idempotent: a slot that already has a live context keeps it.
fn unified_fd_context_ensure(process: usize) -> bool !{unsafe} {
    if (fd_context_address(process) != 0) { return true; }
    let guard = intrusive_pool_lock(&fd_context_pool);
    let result = intrusive_pool_insert_zeroed(&fd_context_pool, guard);
    intrusive_pool_unlock(&fd_context_pool, guard);
    match result {
        IntrusivePoolInsertResult::OutOfMemory => { return false; }
        IntrusivePoolInsertResult::Allocated(owner) => {
            let address: usize = intrusive_owner_slot(owner);
            let generation: usize = intrusive_owner_generation(owner);
            intrusive_owner_drop(owner);
            scheduled_process_set_fd_context(process, address, generation);
            return true;
        }
    }
}

// Called from the process lifecycle when a slot is given up. Giving the
// context back is what makes this a pool rather than a differently-spelled
// array.
fn unified_fd_context_release(process: usize) !{unsafe} {
    let address: usize = fd_context_address(process);
    if (address == 0) { return; }
    // Read the generation BEFORE clearing the record, or the handle
    // rebuilt below names the right slot with the wrong occupant and the
    // pool correctly refuses it.
    let generation: usize = scheduled_process_fd_context_generation(process);
    scheduled_process_set_fd_context(process, 0, 0);
    let owner = intrusive_owner_new(&fd_context_pool, address, generation);
    let guard = intrusive_pool_lock(&fd_context_pool);
    let (ok, reason) = intrusive_remove_outcome(
        intrusive_pool_remove(&fd_context_pool, guard, owner));
    intrusive_pool_unlock(&fd_context_pool, guard);
    if (ok == false) {
        kernel_boot_log("fd table: releasing a process context -- ");
        kernel_boot_log(reason);
        kernel_boot_log("\n");
    }
}
// GitHub issue #391: an open file description is a pool ALLOCATION and
// its identity is that allocation's address, exactly as issue #257 made a
// TCP connection one. It was a RefcountSlotMap(16) slot with the record
// beside it in an [SharedObject; 16] array (issue #242/#305), which meant
// a fixed sixteen of them however much memory the machine had.
//
// The blocker #391 recorded was the second dimension: RefcountSlotMap
// exists because this resource has several independent holders and dies
// with the last one, and IntrusivePool has one generic argument and
// nothing to say about refcounts. The way out is the one Linux already
// takes -- the count belongs to the object, not to the container, and
// `struct file` carries its own `f_count`. So SharedObject carries `refs`
// below, and what is left for the pool to provide is identity, which is
// all IntrusivePool claims to provide.
//
// kernel/lib/refcount_slotmap.tkb stays maintained (linux_user/ runs it
// host-native) as the substrate issue #297's retain/release verification
// was going to extend; what moved is this consumer, not the primitive.
// GitHub issue #305: one record per shared-object slot, replacing nine
// parallel arrays that had to be indexed in lockstep -- the same
// consolidation ProcessFdContext above already did for per-process
// descriptor state (issue #264).
struct SharedObject {
    kind: UnifiedFdKind;
    offset: usize;
    inode: usize;
    readable: bool;
    writable: bool;
    listener_state: UnifiedListenerState;
    port: u16;
    // GitHub issue #257 step 5: transport_slot is the connection's POOL
    // ADDRESS now, not an index into a [TcpConnection; TCP_CONNECTION_MAX].
    // The type did not change -- it was always a plain usize here -- but
    // what checked it did.
    //
    // Every consumer used to narrow it to {0..<TCP_CONNECTION_MAX as usize}
    // before indexing, so a wrong value was caught by the refinement
    // before the generation check ever ran. An address is not in a range
    // and there is nothing left for a refinement to say. What replaces it
    // is intrusive_pool_matches / intrusive_pool_probe_slot in
    // kernel/net/tcp.tkb, run on every use, which checks that the address
    // lands on a real slot of that pool AND that the occupant is still the
    // one transport_generation names.
    //
    // That is not a weaker check, it is a different and stronger one: the
    // refinement could only say "in range", and being in range was never
    // the interesting question -- a recycled slot is in range too. It IS
    // one layer fewer, in that a garbage value now meets one check instead
    // of two. The pair is written by exactly one place
    // (unified_connection_create, from a value the pool minted at accept
    // time) and read only through that validation, so the defence-in-depth
    // the refinement provided was against kernel bugs, not against
    // anything userspace supplies -- userspace supplies the fd, and that
    // path is separately validated (unified_object_matches on the
    // descriptor's own object address) before this field is ever reached.
    transport_slot: usize;
    transport_generation: usize;
    // GitHub issue #391: the reference count lives in the object, the way
    // Linux's `struct file.f_count` does, rather than in a parallel slot
    // of a refcounting container. Retained by unified_fd_install /
    // _duplicate / _clone, released by unified_fd_close, and the object is
    // given back to the pool when it reaches 0 -- unified_object_retain /
    // _release below are the only two places that touch it.
    refs: usize;
}
private let mut object_pool: IntrusivePool(SharedObject);

// Initialised exactly once, for the same reason fd_context_pool is: a
// re-init forgets the pool's pages while live descriptors still name
// addresses inside them (the hazard issue #257 hit). unified_fd_table_init
// DRAINS this pool instead, which is what its "write Empty into every
// record" loop meant back when the records were an array.
private let mut object_pool_ready: bool = false;

fn unified_object_pool_init() {
    if (object_pool_ready) { return; }
    object_pool_ready = true;
    intrusive_pool_init(&object_pool);
}

// GitHub issue #391: how many open file descriptions may exist at once,
// COMPUTED from the memory this kernel has rather than declared. Linux's
// fs/file_table.c files_maxfiles_init() is
//
//     n = memory_pages * (PAGE_SIZE / 1024) / 10
//
// -- one open file description per 10 KiB of RAM -- and this is that
// derivation over this kernel's own page count: 204800 * 4 / 10 = 81920,
// against the 16 that used to be the whole supply. Linux additionally
// floors the result at NR_FILE (8192) for very small machines; the
// derived value here is an order of magnitude above that floor, so
// reproducing it would only add a constant that can never be the answer.
//
// It is deliberately not a capacity: it sizes no storage (a slot is a
// pool allocation, made when it is needed), and the limit that actually
// binds first is the page allocator, which arrives through the same
// UnifiedOpenResult::Full and the same LINUX_ENFILE.
fn unified_object_max_files() -> usize {
    return page_allocator_total_count() *
           (page_allocator_page_bytes() / 1024) / 10;
}

private fn unified_object_matches(handle: UnifiedObjectHandle) -> bool !{unsafe} {
    return intrusive_pool_matches(&object_pool, handle.slot,
                                  handle.generation);
}

// The PAYLOAD of a slot the caller has already matched -- the same split,
// and the same reason for it, as fd_context_address/fd_context_at above.
// Every caller in this file tests unified_object_matches first; reading
// the payload of an address that failed that test is exactly the
// use-after-free the generation check exists to refuse.
private fn unified_object_at(handle: UnifiedObjectHandle) -> *SharedObject !{unsafe} {
    let owner = intrusive_owner_new(&object_pool, handle.slot,
                                    handle.generation);
    let payload: *SharedObject = intrusive_pool_ref(&object_pool, owner);
    intrusive_owner_drop(owner);
    return payload;
}

// Gives the allocation back. Replaces refcount_pool_abandon (an object
// allocated but never installed) and the Freed arm of the old release
// (its last holder went away): with the record no longer an array
// element, both mean the same thing, and neither has an
// `object_records[slot].kind = Empty` to write afterwards -- the record
// stops existing instead.
private fn unified_object_free(slot: usize, generation: usize) !{unsafe} {
    let owner = intrusive_owner_new(&object_pool, slot, generation);
    let guard = intrusive_pool_lock(&object_pool);
    let (ok, reason) = intrusive_remove_outcome(
        intrusive_pool_remove(&object_pool, guard, owner));
    intrusive_pool_unlock(&object_pool, guard);
    if (ok == false) {
        kernel_boot_log("fd table: releasing a shared object -- ");
        kernel_boot_log(reason);
        kernel_boot_log("\n");
    }
}

must_use variant UnifiedObjectRetainResult { Invalid; Overflow; Ok; }
must_use variant UnifiedObjectReleaseResult { Invalid; StillHeld; Freed; }

// RefcountSlotMap's retain/release, over the object's own field. The
// limit parameter is unchanged in meaning and still passed per call
// (issue #401): it is the caller's world's bound, not the container's.
private fn unified_object_retain(handle: UnifiedObjectHandle, limit: usize)
        -> UnifiedObjectRetainResult !{unsafe} {
    if (unified_object_matches(handle) == false) {
        return UnifiedObjectRetainResult::Invalid;
    }
    let object: *SharedObject = unified_object_at(handle);
    if (object.refs >= limit) { return UnifiedObjectRetainResult::Overflow; }
    object.refs = object.refs + 1;
    return UnifiedObjectRetainResult::Ok;
}

// A release of a live object that nobody holds is the double release
// RefcountSlotMap counted, and it is counted here for the same reason:
// unified_fd_table_probe asserts the count is 0 at the end of a run.
private let mut object_double_release_count: usize = 0;

fn unified_object_double_release_count() -> usize {
    return object_double_release_count;
}

private fn unified_object_release(handle: UnifiedObjectHandle)
        -> UnifiedObjectReleaseResult !{unsafe} {
    if (unified_object_matches(handle) == false) {
        return UnifiedObjectReleaseResult::Invalid;
    }
    let object: *SharedObject = unified_object_at(handle);
    // `held < 1` rather than `held == 1`/`!= 0`, and through a `let`
    // rather than off the field: this file's range narrowing is what
    // proves `held - 1` non-negative below, and it narrows the `<` form
    // on a binding (kernel/arch/arm64/mm/asid.tkb records the same
    // rewrite for the same reason).
    let held: usize = object.refs;
    if (held < 1) {
        object_double_release_count = object_double_release_count + 1;
        return UnifiedObjectReleaseResult::Invalid;
    }
    object.refs = held - 1;
    if (held < 2) {
        unified_object_free(handle.slot, handle.generation);
        return UnifiedObjectReleaseResult::Freed;
    }
    return UnifiedObjectReleaseResult::StillHeld;
}

// Gives every live object back. Removing a slot can hand its whole chunk
// to the page allocator, which invalidates a cursor into that chunk, so
// this restarts the walk after each removal instead of carrying `next`
// across it. Both loops are bounded by the live count, which is small.
private fn unified_object_drain_one() -> bool !{unsafe} {
    let mut at: usize = intrusive_pool_first_slot(&object_pool);
    while (at != 0) {
        match intrusive_pool_probe_slot(&object_pool, at) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let generation: usize = intrusive_view_generation(slot_view);
                intrusive_view_drop(slot_view);
                unified_object_free(at, generation);
                return true;
            }
        }
        at = intrusive_pool_next_slot(&object_pool, at);
    }
    return false;
}

private fn unified_object_pool_drain() !{unsafe} {
    while (unified_object_drain_one()) {}
}

must_use variant UnifiedFdResult { Invalid; Ok; }
// GitHub issue #295: a narrower result for the object-creating entry points
// below (unified_file_open/unified_directory_open/unified_terminal_stdio_open/
// unified_listener_create/unified_connection_create) whose only source of
// failure beyond a bad argument is UnifiedObjectResult::Full -- the shared
// object pool being exhausted. Kept distinct from UnifiedFdResult
// (used by ~40 other call sites with no such distinction to make) so this
// change stays scoped to the functions that can actually distinguish it.
must_use variant UnifiedOpenResult { Invalid; Full; Ok; }
// GitHub issue #295: unified_fd_install/unified_fd_duplicate's only source
// of failure beyond a bad argument is unified_object_retain's own
// UnifiedObjectRetainResult::Overflow -- more references than descriptor
// slots exist, which is an invariant break rather than a limit (#401).
// That already
// had its own distinct variant one layer down; this file used to discard it
// into the same UnifiedFdResult::Invalid as a genuinely bad fd/process
// argument. Realistically reachable only via unified_fd_duplicate (dup()/
// dup2()/fcntl(F_DUPFD)) -- the five *_open/*_create callers below install a
// freshly allocated object whose refcount starts at 0, so RefOverflow is
// unreachable there, but is still handled explicitly rather than assumed.
must_use variant UnifiedFdInstallResult { Invalid; RefOverflow; Ok; }
// GitHub issue #391: `slot` is the pool ADDRESS of the object now, not an
// index into an array, so there is no range for a refinement to state --
// the same trade issue #257 made for TcpConnection, and for the same
// reason. What checks it is unified_object_matches, which asks the pool
// whether the address lands on a real slot AND whether the occupant is
// still the one `generation` names. Being in range was never the
// interesting question; a recycled slot is in range too.
struct UnifiedObjectHandle {
    private slot: usize;
    private generation: usize;
}
must_use variant UnifiedObjectResult {
    Invalid;
    Full;
    Allocated(UnifiedObjectHandle);
}
must_use variant UnifiedOffsetResult { Missing; Found(usize); }
must_use variant UnifiedFileResult {
    Missing;
    Found(UnifiedObjectHandle);
}
must_use variant UnifiedSocketResult {
    Missing;
    Found(UnifiedObjectHandle);
}
must_use variant UnifiedFdAllocResult {
    Full;
    Allocated({0..<PROCESS_FD_MAX as usize});
}

fn unified_fd_table_init() !{unsafe} {
    unified_fd_context_pool_init();
    unified_object_pool_init();
    // GitHub issue #391: giving every object back, rather than writing
    // Empty into every element of an array that always existed. The pool
    // itself is deliberately NOT re-initialised, for the same reason the
    // context pool is not -- see unified_object_pool_init.
    unified_object_pool_drain();
    object_double_release_count = 0;
    // GitHub issue #392: the loop is over LIVE contexts rather than over
    // every process slot, because contexts only exist for processes that
    // have one. Emptying them is not optional: this function also resets
    // the shared object pool, so a context left holding object references
    // would be holding references to objects that no longer exist.
    let mut cursor: usize = intrusive_pool_first_slot(&fd_context_pool);
    while (cursor != 0) {
        match intrusive_pool_probe_slot(&fd_context_pool, cursor) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let live: *ProcessFdContext =
                    intrusive_pool_payload_of(&fd_context_pool, slot_view);
                for fd: usize in 0..<PROCESS_FD_MAX {
                    live.fd_kind[fd] = UnifiedFdKind::Empty;
                    live.fd_object[fd] = 0;
                    live.fd_generation[fd] = 0;
                    live.fd_close_on_exec[fd] = false;
                }
                live.heap_break = 0;
                live.heap_start = 0;
                live.heap_limit = 0;
            }
        }
        cursor = intrusive_pool_next_slot(&fd_context_pool, cursor);
    }
    //
    // The context POOL is deliberately not reset here. This function is
    // called by probes as well as at boot, and re-initialising a pool
    // forgets its pages while every ProcessRecord still holds an address
    // into them -- the same hazard issue #257 hit. The pool is initialised
    // once, by unified_fd_context_pool_init.
}

// Initialised exactly once, however many times this is called.
//
// The flag is not defensive tidiness. The only available call site,
// kernel_syscall_process_configure, runs PER PROCESS, and re-initialising
// a pool forgets its pages while every ProcessRecord still holds an
// address into them -- the same hazard issue #257 hit, and the reason
// unified_fd_table_init no longer touches this pool either. A guard that
// is explicit is cheaper to read than one inferred from chunk counts.
private let mut fd_context_pool_ready: bool = false;

fn unified_fd_context_pool_init() {
    if (fd_context_pool_ready) { return; }
    fd_context_pool_ready = true;
    intrusive_pool_init(&fd_context_pool);
}

fn unified_process_heap_range_configure(
        process: usize, start: usize, limit: usize) -> UnifiedFdResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address != 0 && start <= limit) {
        let ctx: *ProcessFdContext = fd_context_at(process);
        ctx.heap_start = start;
        ctx.heap_limit = limit;
        ctx.heap_break = start;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_process_heap_configure(process: usize, value: usize)
        -> UnifiedFdResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address != 0) {
        let ctx: *ProcessFdContext = fd_context_at(process);
        ctx.heap_break = value;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_process_heap_break(process: usize) -> UnifiedOffsetResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address != 0) {
        let ctx: *ProcessFdContext = fd_context_at(process);
        return UnifiedOffsetResult::Found(ctx.heap_break);
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_process_heap_start(process: usize) -> UnifiedOffsetResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address != 0) {
        let ctx: *ProcessFdContext = fd_context_at(process);
        return UnifiedOffsetResult::Found(ctx.heap_start);
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_process_heap_limit(process: usize) -> UnifiedOffsetResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address != 0) {
        let ctx: *ProcessFdContext = fd_context_at(process);
        return UnifiedOffsetResult::Found(ctx.heap_limit);
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_file_open(process: usize, fd: usize, inode: usize,
                     readable: bool, writable: bool) -> UnifiedOpenResult {
    match unified_object_alloc_first(UnifiedFdKind::OpenFile) {
        UnifiedObjectResult::Invalid => { return UnifiedOpenResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedOpenResult::Full; }
        UnifiedObjectResult::Allocated(handle) => {
            // Straight to the payload with no unified_object_matches
            // first: this handle was minted by the allocation two lines
            // up and nothing has run since that could invalidate it.
            let object: *SharedObject = unified_object_at(handle);
            object.inode = inode;
            object.readable = readable;
            object.writable = writable;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdInstallResult::Invalid => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                // Unreachable: object_pool just allocated this slot fresh,
                // so its refcount is 0 -- see UnifiedFdInstallResult's own
                // header comment. Handled the same as Invalid for totality.
                UnifiedFdInstallResult::RefOverflow => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => { return UnifiedOpenResult::Ok; }
            }
        }
    }
}

fn unified_directory_open(process: usize, fd: usize, inode: usize)
        -> UnifiedOpenResult {
    match unified_object_alloc_first(UnifiedFdKind::Directory) {
        UnifiedObjectResult::Invalid => { return UnifiedOpenResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedOpenResult::Full; }
        UnifiedObjectResult::Allocated(handle) => {
            let object: *SharedObject = unified_object_at(handle);
            object.inode = inode;
            object.readable = true;
            object.writable = false;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdInstallResult::Invalid => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::RefOverflow => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => { return UnifiedOpenResult::Ok; }
            }
        }
    }
}

// Standard input/output/error are ordinary inherited descriptors, even
// though their backing object is the kernel UART rather than ext2 or TCP.
// Keeping them in the same table makes close(0) followed by openat() select
// fd 0, which is the Unix redirection contract used by ash background jobs.
fn unified_terminal_stdio_open(process: usize) -> UnifiedOpenResult {
    match unified_object_alloc_first(UnifiedFdKind::Terminal) {
        UnifiedObjectResult::Invalid => { return UnifiedOpenResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedOpenResult::Full; }
        UnifiedObjectResult::Allocated(handle) => {
            match unified_fd_install(process, 0, handle.slot,
                                     handle.generation) {
                UnifiedFdInstallResult::Invalid => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::RefOverflow => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => {}
            }
            match unified_fd_duplicate(process, 0, 1) {
                UnifiedFdInstallResult::Invalid => {
                    match unified_fd_close(process, 0) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::RefOverflow => {
                    match unified_fd_close(process, 0) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => {}
            }
            match unified_fd_duplicate(process, 0, 2) {
                UnifiedFdInstallResult::Invalid => {
                    match unified_fd_close(process, 1) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    match unified_fd_close(process, 0) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::RefOverflow => {
                    match unified_fd_close(process, 1) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    match unified_fd_close(process, 0) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => { return UnifiedOpenResult::Ok; }
            }
        }
    }
}

fn unified_terminal_is_open(process: usize, fd: usize) -> bool {
    if (fd >= PROCESS_FD_MAX) { return false; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return false; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    // GitHub issue #391: the descriptor's (address, generation) pair is
    // checked by the pool before the record behind it is read, where the
    // array form could read first and check afterwards. Reading the
    // payload of an address the pool does not recognise is not a stale
    // answer, it is a wild pointer, so the order is now load-bearing.
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if (ctx.fd_kind[fd] == UnifiedFdKind::Terminal &&
        unified_object_matches(handle)) {
        return unified_object_at(handle).kind == UnifiedFdKind::Terminal;
    }
    return false;
}

// GitHub issue #391: Full has two causes now and they are both real
// exhaustion, so both keep the variant the callers already map to
// LINUX_ENFILE: the system-wide derived ceiling (Linux's
// files_stat.max_files), and the page allocator having nothing left to
// carve a slot out of. Neither is a hand-picked sixteen.
//
// insert_zeroed, not insert: a zeroed SharedObject is the empty record
// this function used to write field by field -- UnifiedFdKind::Empty and
// UnifiedListenerState::Closed are both declaration-order tag zero, and
// every other field starts at 0/false. Only the two that differ from
// zero for a fresh object are written below.
fn unified_object_alloc_first(kind: UnifiedFdKind) -> UnifiedObjectResult !{unsafe} {
    if (kind == UnifiedFdKind::Empty) {
        return UnifiedObjectResult::Invalid;
    }
    unified_object_pool_init();
    if (intrusive_pool_live_count(&object_pool) >= unified_object_max_files()) {
        return UnifiedObjectResult::Full;
    }
    let guard = intrusive_pool_lock(&object_pool);
    let inserted = intrusive_pool_insert_zeroed(&object_pool, guard);
    intrusive_pool_unlock(&object_pool, guard);
    match inserted {
        IntrusivePoolInsertResult::OutOfMemory => {
            return UnifiedObjectResult::Full;
        }
        IntrusivePoolInsertResult::Allocated(owner) => {
            let slot: usize = intrusive_owner_slot(owner);
            let generation: usize = intrusive_owner_generation(owner);
            let object: *SharedObject = intrusive_pool_ref(&object_pool, owner);
            object.kind = kind;
            object.refs = 0;
            intrusive_owner_drop(owner);
            let mut handle: UnifiedObjectHandle = { slot, generation };
            return UnifiedObjectResult::Allocated(handle);
        }
    }
}

fn unified_fd_alloc(process: usize, first: usize) -> UnifiedFdAllocResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdAllocResult::Full; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    for fd: usize in first..<PROCESS_FD_MAX {
        if (fd < PROCESS_FD_MAX) {
            if (ctx.fd_kind[fd] == UnifiedFdKind::Empty) {
                let result: {0..<PROCESS_FD_MAX as usize} = fd;
                return UnifiedFdAllocResult::Allocated(result);
            }
        }
    }
    return UnifiedFdAllocResult::Full;
}

fn unified_socket_lookup(process: usize, fd: usize,
                         kind: UnifiedFdKind) -> UnifiedSocketResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedSocketResult::Missing; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedSocketResult::Missing; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if (ctx.fd_kind[fd] == kind && unified_object_matches(handle)) {
        if (unified_object_at(handle).kind == kind) {
            return UnifiedSocketResult::Found(handle);
        }
    }
    return UnifiedSocketResult::Missing;
}

fn unified_listener_create(process: usize, fd: usize) -> UnifiedOpenResult {
    match unified_object_alloc_first(UnifiedFdKind::Listener) {
        UnifiedObjectResult::Invalid => { return UnifiedOpenResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedOpenResult::Full; }
        UnifiedObjectResult::Allocated(handle) => {
            let object: *SharedObject = unified_object_at(handle);
            object.listener_state = UnifiedListenerState::Created;
            object.port = 0;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdInstallResult::Invalid => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::RefOverflow => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => { return UnifiedOpenResult::Ok; }
            }
        }
    }
}

fn unified_connection_create(process: usize, fd: usize,
                             transport_slot: usize,
                             transport_generation: usize)
        -> UnifiedOpenResult {
    match unified_object_alloc_first(UnifiedFdKind::Connection) {
        UnifiedObjectResult::Invalid => { return UnifiedOpenResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedOpenResult::Full; }
        UnifiedObjectResult::Allocated(handle) => {
            let object: *SharedObject = unified_object_at(handle);
            object.transport_slot = transport_slot;
            object.transport_generation = transport_generation;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdInstallResult::Invalid => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::RefOverflow => {
                    unified_object_free(handle.slot, handle.generation);
                    return UnifiedOpenResult::Invalid;
                }
                UnifiedFdInstallResult::Ok => { return UnifiedOpenResult::Ok; }
            }
        }
    }
}

fn unified_fd_duplicate(process: usize, old_fd: usize, new_fd: usize)
        -> UnifiedFdInstallResult {
    if (old_fd >= PROCESS_FD_MAX ||
        new_fd >= PROCESS_FD_MAX || old_fd == new_fd) { return UnifiedFdInstallResult::Invalid; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdInstallResult::Invalid; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    if (ctx.fd_kind[old_fd] == UnifiedFdKind::Empty) {
        return UnifiedFdInstallResult::Invalid;
    }
    return unified_fd_install(process, new_fd,
                              ctx.fd_object[old_fd],
                              ctx.fd_generation[old_fd]);
}

fn unified_fd_set_close_on_exec(process: usize, fd: usize, value: bool)
        -> UnifiedFdResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedFdResult::Invalid; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdResult::Invalid; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    if (ctx.fd_kind[fd] != UnifiedFdKind::Empty) {
        ctx.fd_close_on_exec[fd] = value;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_fd_close_on_exec(process: usize, fd: usize) -> bool {
    if (fd >= PROCESS_FD_MAX) { return false; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return false; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    return ctx.fd_close_on_exec[fd];
}

fn unified_fd_close_exec_descriptors(process: usize) !{unsafe} {
    if (scheduled_process_slot_valid(process) == false) { return; }
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (unified_fd_close_on_exec(process, fd)) {
            match unified_fd_close(process, fd) {
                UnifiedFdResult::Invalid => {}
                UnifiedFdResult::Ok => {}
            }
        }
    }
}

fn unified_object_references(handle: UnifiedObjectHandle) -> usize !{unsafe} {
    if (unified_object_matches(handle) == false) { return 0; }
    return unified_object_at(handle).refs;
}

fn unified_listener_state(handle: UnifiedObjectHandle) -> UnifiedListenerState {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Listener) {
            return object.listener_state;
        }
    }
    return UnifiedListenerState::Closed;
}

fn unified_listener_set_state(handle: UnifiedObjectHandle,
                              state: UnifiedListenerState)
        -> UnifiedFdResult {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Listener) {
            object.listener_state = state;
            return UnifiedFdResult::Ok;
        }
    }
    return UnifiedFdResult::Invalid;
}

fn unified_listener_port(handle: UnifiedObjectHandle) -> u16 {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Listener) { return object.port; }
    }
    return 0;
}

fn unified_listener_set_port(handle: UnifiedObjectHandle, port: u16)
        -> UnifiedFdResult {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Listener) {
            object.port = port;
            return UnifiedFdResult::Ok;
        }
    }
    return UnifiedFdResult::Invalid;
}

fn unified_connection_slot(handle: UnifiedObjectHandle) -> usize {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Connection) {
            return object.transport_slot;
        }
    }
    // GitHub issue #391: 0, not SHARED_OBJECT_MAX. The old sentinel was
    // "one past the last valid index", which stopped meaning anything
    // when the value became a transport POOL ADDRESS. 0 is the address
    // no slot has, and is what kernel/net/tcp.tkb's own lookups already
    // treat as "no connection".
    return 0;
}

fn unified_connection_generation(handle: UnifiedObjectHandle) -> usize {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Connection) {
            return object.transport_generation;
        }
    }
    return 0;
}

fn unified_file_lookup(process: usize, fd: usize) -> UnifiedFileResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedFileResult::Missing; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFileResult::Missing; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if (ctx.fd_kind[fd] == UnifiedFdKind::OpenFile &&
        unified_object_matches(handle)) {
        if (unified_object_at(handle).kind == UnifiedFdKind::OpenFile) {
            return UnifiedFileResult::Found(handle);
        }
    }
    return UnifiedFileResult::Missing;
}

fn unified_file_inode(handle: UnifiedObjectHandle) -> usize {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::OpenFile) { return object.inode; }
    }
    return 0;
}

must_use variant UnifiedDirectoryResult { Missing; Found(UnifiedObjectHandle); }

fn unified_directory_lookup(process: usize, fd: usize)
        -> UnifiedDirectoryResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedDirectoryResult::Missing; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedDirectoryResult::Missing; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if (ctx.fd_kind[fd] == UnifiedFdKind::Directory &&
        unified_object_matches(handle)) {
        if (unified_object_at(handle).kind == UnifiedFdKind::Directory) {
            return UnifiedDirectoryResult::Found(handle);
        }
    }
    return UnifiedDirectoryResult::Missing;
}

fn unified_directory_inode(handle: UnifiedObjectHandle) -> usize {
    if (unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::Directory) { return object.inode; }
    }
    return 0;
}

fn unified_file_is_readable(handle: UnifiedObjectHandle) -> bool {
    if (unified_object_matches(handle) == false) { return false; }
    let object: *SharedObject = unified_object_at(handle);
    return object.kind == UnifiedFdKind::OpenFile && object.readable;
}

fn unified_file_is_writable(handle: UnifiedObjectHandle) -> bool {
    if (unified_object_matches(handle) == false) { return false; }
    let object: *SharedObject = unified_object_at(handle);
    return object.kind == UnifiedFdKind::OpenFile && object.writable;
}

// GitHub issue #401: how many holders one shared object can have, COMPUTED
// rather than declared. Every reference is held by one descriptor slot --
// unified_fd_install, _duplicate and _clone are the only retains here, and
// each is paired with filling an fd-table entry -- so the number of
// descriptor slots in existence is an exact upper bound, and it is this:
// one ProcessFdContext per live process, PROCESS_FD_MAX entries each.
//
// It replaces SHARED_OBJECT_MAX_REFS, which was KERNEL_PROCESS_MAX *
// PROCESS_FD_MAX until issue #392 removed the process ceiling and left the
// product unbounded -- at which point the constant became a picked 4096
// rather than an inventory. The check was never a capacity (it sizes no
// storage; it is one comparison), so what was lost was the DERIVATION, and
// this is it back.
//
// Measured before it was enforced: instrumented to count how often a
// retain would exceed this bound, the whole boot suite -- fork, exec, dup,
// clone, the interactive shell, the HTTPd -- reported zero. The same
// instrumentation with the bound deliberately set to one slot per process
// reported 71, which is what says the counter was reached at all.
fn unified_object_ref_bound() -> usize !{unsafe} {
    return intrusive_pool_live_count(&fd_context_pool) * PROCESS_FD_MAX;
}

// Exceeding a DERIVED bound is not a resource limit: it says a reference
// was taken that no descriptor slot can be holding. That is an invariant
// break, and it is named as one here rather than reported as ordinary
// exhaustion -- the callers still refuse the operation and map it to
// LINUX_EMFILE, because a bound this file computes for the first time
// should not be able to halt the kernel. Promoting it to a fail-stop is a
// one-line change once it has run long enough to be trusted.
private let mut unified_object_ref_bound_breaks: usize = 0;

fn unified_object_ref_bound_breaks_count() -> usize {
    return unified_object_ref_bound_breaks;
}

private fn unified_object_ref_bound_break(object: usize) {
    unified_object_ref_bound_breaks = unified_object_ref_bound_breaks + 1;
    kernel_boot_log("fd table: INVARIANT BREAK -- shared object at ");
    uart_put_udec(object);
    kernel_boot_log(" has more references than there are descriptor slots (");
    uart_put_udec(unified_object_ref_bound());
    kernel_boot_log(")\n");
}

fn unified_fd_install(process: usize, fd: usize, object_value: usize,
                      generation: usize) -> UnifiedFdInstallResult !{unsafe} {
    if (fd >= PROCESS_FD_MAX) { return UnifiedFdInstallResult::Invalid; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdInstallResult::Invalid; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    // GitHub issue #391: what used to be a range test on the object index
    // is the pool's own occupancy test on the object address. It answers
    // the stronger question -- this address is a real slot of this pool
    // AND still holds the occupant `generation` names -- and it is what
    // makes the payload read below legitimate.
    let mut handle: UnifiedObjectHandle = { object_value, generation };
    if (unified_object_matches(handle) == false) {
        return UnifiedFdInstallResult::Invalid;
    }
    let object: *SharedObject = unified_object_at(handle);
    if (ctx.fd_kind[fd] != UnifiedFdKind::Empty ||
        object.kind == UnifiedFdKind::Empty) {
        return UnifiedFdInstallResult::Invalid;
    }
    match unified_object_retain(handle, unified_object_ref_bound()) {
        UnifiedObjectRetainResult::Invalid => {
            return UnifiedFdInstallResult::Invalid;
        }
        UnifiedObjectRetainResult::Overflow => {
            unified_object_ref_bound_break(object_value);
            return UnifiedFdInstallResult::RefOverflow;
        }
        UnifiedObjectRetainResult::Ok => {}
    }
    ctx.fd_kind[fd] = object.kind;
    ctx.fd_object[fd] = object_value;
    ctx.fd_generation[fd] = generation;
    ctx.fd_close_on_exec[fd] = false;
    return UnifiedFdInstallResult::Ok;
}

fn unified_fd_close(process: usize, fd: usize) -> UnifiedFdResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedFdResult::Invalid; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdResult::Invalid; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if (ctx.fd_kind[fd] != UnifiedFdKind::Empty &&
        unified_object_matches(handle)) {
        match unified_object_release(handle) {
            UnifiedObjectReleaseResult::Invalid => { return UnifiedFdResult::Invalid; }
            UnifiedObjectReleaseResult::StillHeld => {}
            // Nothing to write back on Freed: the record is gone rather
            // than marked Empty, which is the whole difference between a
            // pool allocation and an array element.
            UnifiedObjectReleaseResult::Freed => {}
        }
        ctx.fd_kind[fd] = UnifiedFdKind::Empty;
        ctx.fd_object[fd] = 0;
        ctx.fd_generation[fd] = 0;
        ctx.fd_close_on_exec[fd] = false;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

// GitHub issue #295: shared undo for unified_fd_clone's copy+retain loop --
// releases every reference already retained among child fds 0..<limit and
// resets those slots back to Empty.
//
// GitHub issue #392: takes the child's CONTEXT rather than re-deriving it
// from an index. There is no index to re-derive from once the context is
// pooled, and passing the thing itself is what the old comment's "matching
// this file's existing idiom" was a workaround for.
fn unified_fd_clone_rollback(
        child_ctx: *ProcessFdContext,
        limit: {0..<PROCESS_FD_MAX as usize}) !{unsafe} {
    // GitHub issue #312 (2026-08-16): `undo < PROCESS_FD_MAX` is now
    // proven directly -- the for-loop's own range-refinement reuses
    // `limit`'s own already-proven {0..<PROCESS_FD_MAX} upper bound, no
    // `!{unsafe}`/per-index unsafe wrapping needed.
    for undo: usize in 0..<limit {
        if (child_ctx.fd_kind[undo] != UnifiedFdKind::Empty) {
            let mut undo_handle: UnifiedObjectHandle = {
                child_ctx.fd_object[undo], child_ctx.fd_generation[undo]
            };
            if (unified_object_matches(undo_handle)) {
                match unified_object_release(undo_handle) {
                    UnifiedObjectReleaseResult::Invalid => {}
                    UnifiedObjectReleaseResult::StillHeld => {}
                    UnifiedObjectReleaseResult::Freed => {}
                }
            }
            child_ctx.fd_kind[undo] = UnifiedFdKind::Empty;
        }
    }
}

fn unified_fd_clone(parent: usize, child: usize) -> UnifiedFdResult !{unsafe} {
    if (parent == child) { return UnifiedFdResult::Invalid; }
    let parent_ctx_address: usize = fd_context_address(parent);
    if (parent_ctx_address == 0) { return UnifiedFdResult::Invalid; }
    let parent_ctx: *ProcessFdContext = fd_context_at(parent);
    let child_ctx_address: usize = fd_context_address(child);
    if (child_ctx_address == 0) { return UnifiedFdResult::Invalid; }
    let child_ctx: *ProcessFdContext = fd_context_at(child);
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (child_ctx.fd_kind[fd] != UnifiedFdKind::Empty) {
            return UnifiedFdResult::Invalid;
        }
        if (parent_ctx.fd_kind[fd] != UnifiedFdKind::Empty) {
            let mut parent_handle: UnifiedObjectHandle = {
                parent_ctx.fd_object[fd], parent_ctx.fd_generation[fd]
            };
            if (unified_object_matches(parent_handle) == false) {
                return UnifiedFdResult::Invalid;
            }
            if (unified_object_at(parent_handle).kind != parent_ctx.fd_kind[fd] ||
                unified_object_references(parent_handle) == 0) {
                return UnifiedFdResult::Invalid;
            }
        }
    }
    child_ctx.heap_break =
        parent_ctx.heap_break;
    child_ctx.heap_start =
        parent_ctx.heap_start;
    child_ctx.heap_limit =
        parent_ctx.heap_limit;
    // GitHub issue #295: the first (read-only) loop above already proves
    // every non-Empty parent fd's object is live and kind-matched, so
    // RefcountRetainResult::Invalid below is provably unreachable -- the
    // one real failure mode this loop can hit is ::Overflow
    // (the computed reference bound exceeded). Before this fix, a failure at fd=k left
    // fds 0..k already retained (their refcounts incremented, never
    // released) and fd=k itself half-copied (child_fd_kind set but its
    // refcount never bumped) -- exactly the "partially linked descriptor
    // state" issue #295's Required Behavior section prohibits on a failed
    // clone. Each failure branch below now undoes fds 0..fd before
    // returning, matching scheduled_process_alloc's own rollback discipline.
    for fd: usize in 0..<PROCESS_FD_MAX {
        child_ctx.fd_kind[fd] =
            parent_ctx.fd_kind[fd];
        child_ctx.fd_object[fd] =
            parent_ctx.fd_object[fd];
        child_ctx.fd_generation[fd] =
            parent_ctx.fd_generation[fd];
        child_ctx.fd_close_on_exec[fd] =
            parent_ctx.fd_close_on_exec[fd];
        if (parent_ctx.fd_kind[fd] != UnifiedFdKind::Empty) {
            let value: usize = parent_ctx.fd_object[fd];
            let mut retain_handle: UnifiedObjectHandle = {
                value, parent_ctx.fd_generation[fd]
            };
            match unified_object_retain(retain_handle,
                                        unified_object_ref_bound()) {
                UnifiedObjectRetainResult::Ok => {}
                UnifiedObjectRetainResult::Invalid => {
                    child_ctx.fd_kind[fd] = UnifiedFdKind::Empty;
                    unified_fd_clone_rollback(child_ctx, fd);
                    return UnifiedFdResult::Invalid;
                }
                UnifiedObjectRetainResult::Overflow => {
                    unified_object_ref_bound_break(value);
                    child_ctx.fd_kind[fd] = UnifiedFdKind::Empty;
                    unified_fd_clone_rollback(child_ctx, fd);
                    return UnifiedFdResult::Invalid;
                }
            }
        }
    }
    return UnifiedFdResult::Ok;
}

fn unified_fd_set_offset(process: usize, fd: usize, offset: usize)
        -> UnifiedFdResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedFdResult::Invalid; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdResult::Invalid; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if ((ctx.fd_kind[fd] == UnifiedFdKind::OpenFile ||
         ctx.fd_kind[fd] == UnifiedFdKind::Directory) &&
        unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::OpenFile ||
            object.kind == UnifiedFdKind::Directory) {
            object.offset = offset;
            return UnifiedFdResult::Ok;
        }
    }
    return UnifiedFdResult::Invalid;
}

fn unified_fd_offset(process: usize, fd: usize) -> UnifiedOffsetResult {
    if (fd >= PROCESS_FD_MAX) { return UnifiedOffsetResult::Missing; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedOffsetResult::Missing; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    let mut handle: UnifiedObjectHandle = {
        ctx.fd_object[fd], ctx.fd_generation[fd]
    };
    if ((ctx.fd_kind[fd] == UnifiedFdKind::OpenFile ||
         ctx.fd_kind[fd] == UnifiedFdKind::Directory) &&
        unified_object_matches(handle)) {
        let object: *SharedObject = unified_object_at(handle);
        if (object.kind == UnifiedFdKind::OpenFile ||
            object.kind == UnifiedFdKind::Directory) {
            return UnifiedOffsetResult::Found(object.offset);
        }
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_fd_destroy(process: usize) -> UnifiedFdResult {
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return UnifiedFdResult::Invalid; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (ctx.fd_kind[fd] != UnifiedFdKind::Empty) {
            match unified_fd_close(process, fd) {
                UnifiedFdResult::Invalid => {
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => {}
            }
        }
    }
    return UnifiedFdResult::Ok;
}

// GitHub issue #391 replaces issue #295's exhaustion probe here, the same
// way issue #257 replaced TCP's: there is no capacity of sixteen left to
// be refused at, so what is worth proving is the OPPOSITE of what the old
// probe proved -- the pool goes past the old ceiling, each object is its
// own storage, a freed object's address is refused afterwards on the
// generation rather than on a range, and the pool ends holding exactly
// what it held before.
//
// It still drives the object pool directly, bypassing per-process fd
// installation, for the reason the old one did: unified_fd_table_probe
// covers the descriptor paths functionally, and this covers the pool.
const OBJECT_POOL_PROBE_COUNT: usize = 24;

fn unified_object_pool_probe() -> bool !{unsafe} {
    unified_fd_table_init();
    let before: usize = intrusive_pool_live_count(&object_pool);
    let mut handles: [UnifiedObjectHandle; OBJECT_POOL_PROBE_COUNT];
    for i: usize in 0..<OBJECT_POOL_PROBE_COUNT {
        match unified_object_alloc_first(UnifiedFdKind::OpenFile) {
            UnifiedObjectResult::Invalid => { return false; }
            UnifiedObjectResult::Full => { return false; }
            UnifiedObjectResult::Allocated(handle) => { handles[i] = handle; }
        }
    }
    for i: usize in 0..<OBJECT_POOL_PROBE_COUNT {
        for j: usize in 0..<OBJECT_POOL_PROBE_COUNT {
            if (i != j && handles[i].slot == handles[j].slot) { return false; }
        }
    }
    if (intrusive_pool_live_count(&object_pool) !=
            before + OBJECT_POOL_PROBE_COUNT) {
        return false;
    }

    let mut stale: UnifiedObjectHandle = {
        handles[0].slot, handles[0].generation
    };
    unified_object_free(stale.slot, stale.generation);
    if (unified_object_matches(stale)) { return false; }

    for i: usize in 1..<OBJECT_POOL_PROBE_COUNT {
        unified_object_free(handles[i].slot, handles[i].generation);
    }
    if (intrusive_pool_live_count(&object_pool) != before) { return false; }
    unified_fd_table_init();
    return true;
}

// GitHub issue #295 boundary test, reworked by issue #401. It used to
// retain a fixed SHARED_OBJECT_MAX_REFS times and check that one more was
// refused -- a test that the constant equalled itself. The bound is
// COMPUTED now (unified_object_ref_bound: one descriptor slot per
// PROCESS_FD_MAX per live fd context), so the thing worth proving is that
// it TRACKS: fill it exactly, be refused at one past it, then create one
// more process and be allowed exactly PROCESS_FD_MAX more.
//
// It still drives retain/release directly rather than installing real
// fd-table entries: the point is this bound's own boundary, not the
// descriptor paths, which unified_fd_table_probe covers.
fn unified_object_ref_ceiling_probe() -> bool !{unsafe} {
    unified_fd_table_init();
    let bound: usize = unified_object_ref_bound();
    if (bound == 0) { return false; }
    match unified_object_alloc_first(UnifiedFdKind::OpenFile) {
        UnifiedObjectResult::Invalid => { return false; }
        UnifiedObjectResult::Full => { return false; }
        UnifiedObjectResult::Allocated(handle) => {
            // unified_object_alloc_first's own doc comment: a freshly
            // allocated object's refs starts at 0, so `bound` successful
            // retains bring it to exactly the bound.
            let mut retained: usize = 0;
            while (retained < bound) {
                match unified_object_retain(handle, bound) {
                    UnifiedObjectRetainResult::Ok => {}
                    UnifiedObjectRetainResult::Invalid => { return false; }
                    UnifiedObjectRetainResult::Overflow => { return false; }
                }
                retained = retained + 1;
            }
            let mut ok: bool = false;
            match unified_object_retain(handle, bound) {
                UnifiedObjectRetainResult::Overflow => { ok = true; }
                UnifiedObjectRetainResult::Invalid => {}
                UnifiedObjectRetainResult::Ok => { retained = retained + 1; }
            }
            // ...and one more process means PROCESS_FD_MAX more descriptor
            // slots, so the same retain that was refused above is allowed
            // now. This is the half a fixed constant could not have.
            let extra: usize = scheduled_process_probe_slot_acquire();
            if (extra == 0) { ok = false; }
            let grown: usize = unified_object_ref_bound();
            if (grown != bound + PROCESS_FD_MAX) { ok = false; }
            if (ok) {
                match unified_object_retain(handle, grown) {
                    UnifiedObjectRetainResult::Ok => { retained = retained + 1; }
                    UnifiedObjectRetainResult::Invalid => { ok = false; }
                    UnifiedObjectRetainResult::Overflow => { ok = false; }
                }
            }
            scheduled_process_probe_slot_release(extra);
            let mut released: usize = 0;
            while (released < retained) {
                match unified_object_release(handle) {
                    UnifiedObjectReleaseResult::Invalid => { ok = false; }
                    UnifiedObjectReleaseResult::StillHeld => {}
                    UnifiedObjectReleaseResult::Freed => {}
                }
                released = released + 1;
            }
            unified_fd_table_init();
            return ok;
        }
    }
}

// GitHub issue #295 boundary test: exhausts one process's own PROCESS_FD_MAX
// descriptor namespace, distinct from unified_object_pool_exhaustion_probe
// above (the global object pool) -- unified_fd_table_probe
// exercises fd installation functionally but never fills a process's table
// to its own capacity. Every fd here duplicates the SAME one shared object
// (unified_fd_duplicate only bumps its refcount, well under the computed
// reference bound) so this isolates PROCESS_FD_MAX's own boundary
// rather than conflating it with the object pool's.
fn unified_fd_table_exhaustion_probe() -> bool !{unsafe} {
    unified_fd_table_init();
    // GitHub issue #392: a probe standing in for a process has to acquire
    // what a process acquires. Before the context was pooled it got one
    // for free, because every slot's context existed whether or not a
    // process did.
    unified_fd_context_release(0);
    if (unified_fd_context_ensure(0) == false) { return false; }
    match unified_object_alloc_first(UnifiedFdKind::OpenFile) {
        UnifiedObjectResult::Invalid => { return false; }
        UnifiedObjectResult::Full => { return false; }
        UnifiedObjectResult::Allocated(handle) => {
            match unified_fd_install(0, 0, handle.slot, handle.generation) {
                UnifiedFdInstallResult::Invalid => { return false; }
                UnifiedFdInstallResult::RefOverflow => { return false; }
                UnifiedFdInstallResult::Ok => {}
            }
        }
    }
    for fd: usize in 1..<PROCESS_FD_MAX {
        match unified_fd_duplicate(0, 0, fd) {
            UnifiedFdInstallResult::Invalid => { return false; }
            UnifiedFdInstallResult::RefOverflow => { return false; }
            UnifiedFdInstallResult::Ok => {}
        }
    }

    let mut capacity_ok: bool = false;
    match unified_fd_alloc(0, 0) {
        UnifiedFdAllocResult::Full => { capacity_ok = true; }
        UnifiedFdAllocResult::Allocated(unexpected) => {
            if (unexpected == 0) {}
        }
    }
    if (capacity_ok == false) { return false; }

    match unified_fd_close(0, 0) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    let mut reused_ok: bool = false;
    match unified_fd_alloc(0, 0) {
        UnifiedFdAllocResult::Full => {}
        UnifiedFdAllocResult::Allocated(reused_fd) => {
            if (reused_fd == 0) { reused_ok = true; }
        }
    }
    if (reused_ok == false) { return false; }

    for fd: usize in 1..<PROCESS_FD_MAX {
        match unified_fd_close(0, fd) {
            UnifiedFdResult::Invalid => {}
            UnifiedFdResult::Ok => {}
        }
    }
    unified_fd_table_init();
    return true;
}

fn unified_fd_probe_install(fd: usize, result: UnifiedObjectResult) -> bool {
    match result {
        UnifiedObjectResult::Invalid => { return false; }
        UnifiedObjectResult::Full => { return false; }
        UnifiedObjectResult::Allocated(handle) => {
            match unified_fd_install(0, fd, handle.slot, handle.generation) {
                UnifiedFdInstallResult::Invalid => { return false; }
                UnifiedFdInstallResult::RefOverflow => { return false; }
                UnifiedFdInstallResult::Ok => { return true; }
            }
        }
    }
}

fn unified_fd_table_probe() -> bool !{unsafe} {
    unified_fd_table_init();
    // GitHub issue #392: process 0's context has to exist before its heap
    // break can be set -- which is the probe standing in for what
    // scheduled_process_alloc does for a real process.
    // Released first, so this is a fresh zeroed table rather than
    // whatever an earlier probe stage left in the slot.
    unified_fd_context_release(0);
    if (unified_fd_context_ensure(0) == false) { return false; }
    // ...and a second process's, which the clone stage below writes into.
    // It used to be the bare slot `1`, which named a process only while
    // every index below the ceiling did; a slot is a live process's record
    // now, so the probe allocates one.
    let child: usize = scheduled_process_probe_slot_acquire();
    if (child == 0) { return false; }
    unified_fd_context_release(child);
    if (unified_fd_context_ensure(child) == false) {
        scheduled_process_probe_slot_release(child);
        return false;
    }
    let probe_address: usize = fd_context_address(0);
    if (probe_address == 0) { scheduled_process_probe_slot_release(child);
 return false; }
    let ctx: *ProcessFdContext = fd_context_at(0);
    ctx.heap_break = 0x50000000;
    match unified_terminal_stdio_open(0) {
        UnifiedOpenResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedOpenResult::Full => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedOpenResult::Ok => {}
    }
    if (unified_terminal_is_open(0, 0) == false ||
        unified_terminal_is_open(0, 1) == false ||
        unified_terminal_is_open(0, 2) == false) {
        scheduled_process_probe_slot_release(child);
        return false;
    }
    match unified_fd_close(0, 0) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_alloc(0, 0) {
        UnifiedFdAllocResult::Full => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdAllocResult::Allocated(fd) => {
            if (fd != 0 || unified_fd_probe_install(
                    fd, unified_object_alloc_first(
                        UnifiedFdKind::OpenFile)) == false) {
                scheduled_process_probe_slot_release(child);
                return false;
            }
        }
    }
    if (unified_fd_probe_install(
            3, unified_object_alloc_first(UnifiedFdKind::OpenFile)) == false ||
        unified_fd_probe_install(
            4, unified_object_alloc_first(UnifiedFdKind::Listener)) == false ||
        unified_fd_probe_install(
            5, unified_object_alloc_first(UnifiedFdKind::Connection)) == false) {
        scheduled_process_probe_slot_release(child);
        return false;
    }
    match unified_fd_clone(0, child) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_process_heap_configure(child, 0x50001000) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_set_offset(child, 3, 9) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    let mut shared: bool = false;
    match unified_fd_offset(0, 3) {
        UnifiedOffsetResult::Missing => {}
        UnifiedOffsetResult::Found(offset) => {
            if (offset == 9) { shared = true; }
        }
    }
    match unified_fd_close(child, 4) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_destroy(child) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_destroy(0) {
        UnifiedFdResult::Invalid => { scheduled_process_probe_slot_release(child);
 return false; }
        UnifiedFdResult::Ok => {}
    }
    // GitHub issue #391: "every record is Empty again" is "the pool holds
    // nothing again" now -- an object that nobody references stops
    // existing rather than being marked free in place.
    if (intrusive_pool_live_count(&object_pool) != 0) {
        scheduled_process_probe_slot_release(child);
        return false;
    }
    if (unified_object_double_release_count() != 0) {
        scheduled_process_probe_slot_release(child);
        return false;
    }
    let mut heap_independent: bool = false;
    match unified_process_heap_break(0) {
        UnifiedOffsetResult::Missing => {}
        UnifiedOffsetResult::Found(value) => {
            if (value == 0x50000000) { heap_independent = true; }
        }
    }
    scheduled_process_probe_slot_release(child);
    return shared && heap_independent;
}

// Allocation-free diagnostic view for the terminal exception path (issue
// #294's last acceptance criterion), mirroring kernel/kernel/process.tkb's
// own kernel_process_crash_*() accessors: reads plain ProcessFdContext data
// only, never object_pool's RefcountSlotMap internals -- a crash report
// must not acquire a lock after a fatal exception.
fn kernel_fd_table_crash_kind(process: usize, fd: usize) -> usize {
    if (fd >= PROCESS_FD_MAX) { return 0; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return 0; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    match ctx.fd_kind[fd] {
        UnifiedFdKind::Empty => { return 0; }
        UnifiedFdKind::Terminal => { return 1; }
        UnifiedFdKind::OpenFile => { return 2; }
        UnifiedFdKind::Directory => { return 3; }
        UnifiedFdKind::Listener => { return 4; }
        UnifiedFdKind::Connection => { return 5; }
    }
}

fn kernel_fd_table_crash_object(process: usize, fd: usize) -> usize {
    if (fd >= PROCESS_FD_MAX) { return 0; }
    let ctx_address: usize = fd_context_address(process);
    if (ctx_address == 0) { return 0; }
    let ctx: *ProcessFdContext = fd_context_at(process);
    return ctx.fd_object[fd];
}
