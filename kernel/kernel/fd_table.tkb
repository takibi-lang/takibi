use "kernel/lib/refcount_slotmap.tkb";

// GitHub issues #246 and #264: process index == kernel/kernel/process.tkb's
// ProcessHandle.pool_index. One ProcessFdContext keeps the descriptor and
// heap state for that process together, instead of coupling parallel globals
// through a flat process * PROCESS_FD_MAX + fd index. These small records are
// eagerly sized; growable_pool.tkb remains for genuinely expensive resources.
const PROCESS_CONTEXT_MAX: usize = 16;
// Ash reserves a script fd at 10 with F_DUPFD_CLOEXEC. Keep a small but real
// per-process descriptor namespace rather than treating fd 3 as a special
// file-only slot.
const PROCESS_FD_MAX: usize = 16;
// A daemon child keeps its inherited shell descriptors while opening its
// listener, accepted streams, and /dev/null redirection. Keep the shared
// object pool at the same fixed capacity as the per-process descriptor
// namespace so the interactive path does not have a smaller hidden limit.
const SHARED_OBJECT_MAX: usize = 16;
// Every descriptor slot could in principle
// hold its own reference to the same shared object (unified_fd_clone/
// unified_fd_duplicate both create independent references to an existing
// object rather than new objects), so that is the real bound on
// simultaneous holders -- see kernel/lib/refcount_slotmap.tkb's header
// for why this is passed explicitly rather than left an unbounded usize.
// Must equal PROCESS_CONTEXT_MAX * PROCESS_FD_MAX (256), kept as its own
// literal because a top-level const cannot be initialized from another
// const's identifier in an arithmetic expression.
const SHARED_OBJECT_MAX_REFS: usize = 256;

enum UnifiedFdKind: u8 {
    Empty;
    Terminal;
    OpenFile;
    Directory;
    Listener;
    Connection;
}
enum UnifiedListenerState: u8 { Closed; Created; Bound; Listening; }
// GitHub issue #264 third stage: descriptor state and the process heap break
// share one record, so a process slot has one local FD context rather than
// five globals that must be indexed in lockstep. Array fields are accessed
// through local bindings below because embedded-array indexing is not yet a
// direct parser/lowering operation (issue #15).
struct ProcessFdContext {
    fd_kind: [UnifiedFdKind; PROCESS_FD_MAX];
    fd_object: [usize; PROCESS_FD_MAX];
    fd_generation: [usize; PROCESS_FD_MAX];
    fd_close_on_exec: [bool; PROCESS_FD_MAX];
    heap_break: usize;
    heap_start: usize;
    heap_limit: usize;
}
private let mut process_fd_context:
    [ProcessFdContext; PROCESS_CONTEXT_MAX];
// Slot allocation is O(1) via kernel/lib/refcount_slotmap.tkb's
// RefcountSlotMap(N, MAX_REFS) (issue #242, follow-up to issue #207)
// instead of a hand-rolled linear scan over object_kind[]==Empty, and
// object_generation[]/object_references[] are replaced by the pool's own
// per-slot generation+refcount pair. object_kind stays this file's own
// application data (RefcountSlotMap only knows "occupied or not", not what
// kind of object occupies a slot).
private let mut object_pool: RefcountSlotMap(SHARED_OBJECT_MAX, SHARED_OBJECT_MAX_REFS);
private let mut object_kind: [UnifiedFdKind; SHARED_OBJECT_MAX];
private let mut object_offset: [usize; SHARED_OBJECT_MAX];
private let mut object_inode: [usize; SHARED_OBJECT_MAX];
private let mut object_readable: [bool; SHARED_OBJECT_MAX];
private let mut object_writable: [bool; SHARED_OBJECT_MAX];
private let mut object_listener_state: [UnifiedListenerState; SHARED_OBJECT_MAX];
private let mut object_port: [u16; SHARED_OBJECT_MAX];
private let mut object_transport_slot: [usize; SHARED_OBJECT_MAX];
private let mut object_transport_generation: [usize; SHARED_OBJECT_MAX];

// Public callers validate their process argument before narrowing it. The
// fallback is unreachable at those call sites, but keeps the helper total.
fn unified_fd_narrow_process(value: usize)
        -> {0..<PROCESS_CONTEXT_MAX as usize} {
    if (value < PROCESS_CONTEXT_MAX) {
        let process: {0..<PROCESS_CONTEXT_MAX as usize} = value;
        return process;
    }
    return 0;
}

must_use variant UnifiedFdResult { Invalid; Ok; }
struct UnifiedObjectHandle {
    private slot: {0..<SHARED_OBJECT_MAX as usize};
    private generation: usize;
}
must_use variant UnifiedObjectResult {
    Invalid;
    Full;
    Allocated(UnifiedObjectHandle);
}
must_use variant UnifiedOffsetResult { Missing; Found(usize); }
must_use variant UnifiedFileResult {
    Missing;
    Found(UnifiedObjectHandle);
}
must_use variant UnifiedSocketResult {
    Missing;
    Found(UnifiedObjectHandle);
}
must_use variant UnifiedFdAllocResult {
    Full;
    Allocated({0..<PROCESS_FD_MAX as usize});
}

fn unified_fd_table_init() {
    refcount_pool_init(&object_pool);
    for object: usize in 0..<SHARED_OBJECT_MAX {
        object_kind[object] = UnifiedFdKind::Empty;
        object_offset[object] = 0;
        object_inode[object] = 0;
        object_readable[object] = false;
        object_writable[object] = false;
        object_listener_state[object] = UnifiedListenerState::Closed;
        object_port[object] = 0;
        object_transport_slot[object] = 0;
        object_transport_generation[object] = 0;
    }
    for process: usize in 0..<PROCESS_CONTEXT_MAX {
        let fd_kind = process_fd_context[process].fd_kind;
        let fd_object = process_fd_context[process].fd_object;
        let fd_generation = process_fd_context[process].fd_generation;
        let fd_close_on_exec = process_fd_context[process].fd_close_on_exec;
        for fd: isize in 0..<(PROCESS_FD_MAX as isize) {
            fd_kind[fd] = UnifiedFdKind::Empty;
            fd_object[fd] = 0;
            fd_generation[fd] = 0;
            fd_close_on_exec[fd] = false;
        }
        process_fd_context[process].heap_break = 0;
        process_fd_context[process].heap_start = 0;
        process_fd_context[process].heap_limit = 0;
    }
}

fn unified_process_heap_range_configure(
        process: usize, start: usize, limit: usize) -> UnifiedFdResult {
    if (process < PROCESS_CONTEXT_MAX && start <= limit) {
        let index: {0..<PROCESS_CONTEXT_MAX as usize} = process;
        process_fd_context[index].heap_start = start;
        process_fd_context[index].heap_limit = limit;
        process_fd_context[index].heap_break = start;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_process_heap_configure(process: usize, value: usize)
        -> UnifiedFdResult {
    if (process < PROCESS_CONTEXT_MAX) {
        let index: {0..<PROCESS_CONTEXT_MAX as usize} = process;
        process_fd_context[index].heap_break = value;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_process_heap_break(process: usize) -> UnifiedOffsetResult {
    if (process < PROCESS_CONTEXT_MAX) {
        let index: {0..<PROCESS_CONTEXT_MAX as usize} = process;
        return UnifiedOffsetResult::Found(process_fd_context[index].heap_break);
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_process_heap_start(process: usize) -> UnifiedOffsetResult {
    if (process < PROCESS_CONTEXT_MAX) {
        let index: {0..<PROCESS_CONTEXT_MAX as usize} = process;
        return UnifiedOffsetResult::Found(process_fd_context[index].heap_start);
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_process_heap_limit(process: usize) -> UnifiedOffsetResult {
    if (process < PROCESS_CONTEXT_MAX) {
        let index: {0..<PROCESS_CONTEXT_MAX as usize} = process;
        return UnifiedOffsetResult::Found(process_fd_context[index].heap_limit);
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_file_open(process: usize, fd: usize, inode: usize,
                     readable: bool, writable: bool) -> UnifiedFdResult {
    match unified_object_alloc_first(UnifiedFdKind::OpenFile) {
        UnifiedObjectResult::Invalid => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Allocated(handle) => {
            object_inode[handle.slot] = inode;
            object_readable[handle.slot] = readable;
            object_writable[handle.slot] = writable;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdResult::Invalid => {
                    object_kind[handle.slot] = UnifiedFdKind::Empty;
                    refcount_pool_abandon(&object_pool, handle.slot,
                                         handle.generation);
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => { return UnifiedFdResult::Ok; }
            }
        }
    }
}

fn unified_directory_open(process: usize, fd: usize, inode: usize)
        -> UnifiedFdResult {
    match unified_object_alloc_first(UnifiedFdKind::Directory) {
        UnifiedObjectResult::Invalid => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Allocated(handle) => {
            object_inode[handle.slot] = inode;
            object_readable[handle.slot] = true;
            object_writable[handle.slot] = false;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdResult::Invalid => {
                    object_kind[handle.slot] = UnifiedFdKind::Empty;
                    refcount_pool_abandon(&object_pool, handle.slot,
                                         handle.generation);
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => { return UnifiedFdResult::Ok; }
            }
        }
    }
}

// Standard input/output/error are ordinary inherited descriptors, even
// though their backing object is the kernel UART rather than ext2 or TCP.
// Keeping them in the same table makes close(0) followed by openat() select
// fd 0, which is the Unix redirection contract used by ash background jobs.
fn unified_terminal_stdio_open(process: usize) -> UnifiedFdResult {
    match unified_object_alloc_first(UnifiedFdKind::Terminal) {
        UnifiedObjectResult::Invalid => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Allocated(handle) => {
            match unified_fd_install(process, 0, handle.slot,
                                     handle.generation) {
                UnifiedFdResult::Invalid => {
                    object_kind[handle.slot] = UnifiedFdKind::Empty;
                    refcount_pool_abandon(&object_pool, handle.slot,
                                         handle.generation);
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => {}
            }
            match unified_fd_duplicate(process, 0, 1) {
                UnifiedFdResult::Invalid => {
                    match unified_fd_close(process, 0) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => {}
            }
            match unified_fd_duplicate(process, 0, 2) {
                UnifiedFdResult::Invalid => {
                    match unified_fd_close(process, 1) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    match unified_fd_close(process, 0) {
                        UnifiedFdResult::Invalid => {}
                        UnifiedFdResult::Ok => {}
                    }
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => { return UnifiedFdResult::Ok; }
            }
        }
    }
}

fn unified_terminal_is_open(process: usize, fd: usize) -> bool {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return false;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let object_value: usize = fd_object[fd as isize];
    if (fd_kind[fd as isize] == UnifiedFdKind::Terminal &&
        object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        return object_kind[object] == UnifiedFdKind::Terminal &&
               refcount_pool_matches(&object_pool, object,
                                     fd_generation[fd as isize]);
    }
    return false;
}

fn unified_object_alloc_first(kind: UnifiedFdKind) -> UnifiedObjectResult {
    if (kind == UnifiedFdKind::Empty) {
        return UnifiedObjectResult::Invalid;
    }
    match refcount_pool_alloc(&object_pool) {
        RefcountAllocResult::Full => { return UnifiedObjectResult::Full; }
        RefcountAllocResult::Allocated(pair) => {
            let (slot_value, generation) = pair;
            if (slot_value < SHARED_OBJECT_MAX) {
                let slot: {0..<SHARED_OBJECT_MAX as usize} = slot_value;
                object_kind[slot] = kind;
                object_offset[slot] = 0;
                let mut handle: UnifiedObjectHandle = { slot, generation };
                return UnifiedObjectResult::Allocated(handle);
            }
            return UnifiedObjectResult::Full;
        }
    }
}

fn unified_fd_alloc(process: usize, first: usize) -> UnifiedFdAllocResult {
    if (process >= PROCESS_CONTEXT_MAX) { return UnifiedFdAllocResult::Full; }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let mut fd: usize = first;
    while (fd < PROCESS_FD_MAX) {
        if (fd_kind[fd as isize] == UnifiedFdKind::Empty &&
            fd < PROCESS_FD_MAX) {
            let result: {0..<PROCESS_FD_MAX as usize} = fd;
            return UnifiedFdAllocResult::Allocated(result);
        }
        fd = fd + 1;
    }
    return UnifiedFdAllocResult::Full;
}

fn unified_socket_lookup(process: usize, fd: usize,
                         kind: UnifiedFdKind) -> UnifiedSocketResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedSocketResult::Missing;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let object_value: usize = fd_object[fd as isize];
    if (fd_kind[fd as isize] == kind && object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        if (object_kind[object] == kind &&
            refcount_pool_matches(&object_pool, object,
                                  fd_generation[fd as isize])) {
            let mut handle: UnifiedObjectHandle = {
                object, fd_generation[fd as isize]
            };
            return UnifiedSocketResult::Found(handle);
        }
    }
    return UnifiedSocketResult::Missing;
}

fn unified_listener_create(process: usize, fd: usize) -> UnifiedFdResult {
    match unified_object_alloc_first(UnifiedFdKind::Listener) {
        UnifiedObjectResult::Invalid => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Allocated(handle) => {
            object_listener_state[handle.slot] = UnifiedListenerState::Created;
            object_port[handle.slot] = 0;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdResult::Invalid => {
                    object_kind[handle.slot] = UnifiedFdKind::Empty;
                    refcount_pool_abandon(&object_pool, handle.slot,
                                         handle.generation);
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => { return UnifiedFdResult::Ok; }
            }
        }
    }
}

fn unified_connection_create(process: usize, fd: usize,
                             transport_slot: usize,
                             transport_generation: usize)
        -> UnifiedFdResult {
    match unified_object_alloc_first(UnifiedFdKind::Connection) {
        UnifiedObjectResult::Invalid => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Full => { return UnifiedFdResult::Invalid; }
        UnifiedObjectResult::Allocated(handle) => {
            object_transport_slot[handle.slot] = transport_slot;
            object_transport_generation[handle.slot] = transport_generation;
            match unified_fd_install(process, fd, handle.slot,
                                     handle.generation) {
                UnifiedFdResult::Invalid => {
                    object_kind[handle.slot] = UnifiedFdKind::Empty;
                    refcount_pool_abandon(&object_pool, handle.slot,
                                         handle.generation);
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => { return UnifiedFdResult::Ok; }
            }
        }
    }
}

fn unified_fd_duplicate(process: usize, old_fd: usize, new_fd: usize)
        -> UnifiedFdResult {
    if (process >= PROCESS_CONTEXT_MAX || old_fd >= PROCESS_FD_MAX ||
        new_fd >= PROCESS_FD_MAX || old_fd == new_fd) {
        return UnifiedFdResult::Invalid;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    if (fd_kind[old_fd as isize] == UnifiedFdKind::Empty) {
        return UnifiedFdResult::Invalid;
    }
    return unified_fd_install(process, new_fd, fd_object[old_fd as isize],
                              fd_generation[old_fd as isize]);
}

fn unified_fd_set_close_on_exec(process: usize, fd: usize, value: bool)
        -> UnifiedFdResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedFdResult::Invalid;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_close_on_exec = process_fd_context[process_index].fd_close_on_exec;
    if (fd_kind[fd as isize] != UnifiedFdKind::Empty) {
        fd_close_on_exec[fd as isize] = value;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_fd_close_on_exec(process: usize, fd: usize) -> bool {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return false;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_close_on_exec = process_fd_context[process_index].fd_close_on_exec;
    return fd_close_on_exec[fd as isize];
}

fn unified_fd_close_exec_descriptors(process: usize) {
    if (process >= PROCESS_CONTEXT_MAX) { return; }
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (unified_fd_close_on_exec(process, fd)) {
            match unified_fd_close(process, fd) {
                UnifiedFdResult::Invalid => {}
                UnifiedFdResult::Ok => {}
            }
        }
    }
}

fn unified_object_references(handle: UnifiedObjectHandle) -> usize {
    return refcount_pool_count(&object_pool, handle.slot, handle.generation);
}

fn unified_listener_state(handle: UnifiedObjectHandle) -> UnifiedListenerState {
    if (object_kind[handle.slot] == UnifiedFdKind::Listener &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        return object_listener_state[handle.slot];
    }
    return UnifiedListenerState::Closed;
}

fn unified_listener_set_state(handle: UnifiedObjectHandle,
                              state: UnifiedListenerState)
        -> UnifiedFdResult {
    if (object_kind[handle.slot] == UnifiedFdKind::Listener &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        object_listener_state[handle.slot] = state;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_listener_port(handle: UnifiedObjectHandle) -> u16 {
    if (object_kind[handle.slot] == UnifiedFdKind::Listener &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        return object_port[handle.slot];
    }
    return 0;
}

fn unified_listener_set_port(handle: UnifiedObjectHandle, port: u16)
        -> UnifiedFdResult {
    if (object_kind[handle.slot] == UnifiedFdKind::Listener &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        object_port[handle.slot] = port;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_connection_slot(handle: UnifiedObjectHandle) -> usize {
    if (object_kind[handle.slot] == UnifiedFdKind::Connection &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        return object_transport_slot[handle.slot];
    }
    return SHARED_OBJECT_MAX;
}

fn unified_connection_generation(handle: UnifiedObjectHandle) -> usize {
    if (object_kind[handle.slot] == UnifiedFdKind::Connection &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        return object_transport_generation[handle.slot];
    }
    return 0;
}

fn unified_file_lookup(process: usize, fd: usize) -> UnifiedFileResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedFileResult::Missing;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let object_value: usize = fd_object[fd as isize];
    if (fd_kind[fd as isize] == UnifiedFdKind::OpenFile &&
        object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        if (object_kind[object] == UnifiedFdKind::OpenFile &&
            refcount_pool_matches(&object_pool, object,
                                  fd_generation[fd as isize])) {
            let mut handle: UnifiedObjectHandle = {
                object, fd_generation[fd as isize]
            };
            return UnifiedFileResult::Found(handle);
        }
    }
    return UnifiedFileResult::Missing;
}

fn unified_file_inode(handle: UnifiedObjectHandle) -> usize {
    if (object_kind[handle.slot] == UnifiedFdKind::OpenFile &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        return object_inode[handle.slot];
    }
    return 0;
}

must_use variant UnifiedDirectoryResult { Missing; Found(UnifiedObjectHandle); }

fn unified_directory_lookup(process: usize, fd: usize)
        -> UnifiedDirectoryResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedDirectoryResult::Missing;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let object_value: usize = fd_object[fd as isize];
    if (fd_kind[fd as isize] == UnifiedFdKind::Directory &&
        object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        if (object_kind[object] == UnifiedFdKind::Directory &&
            refcount_pool_matches(&object_pool, object,
                                  fd_generation[fd as isize])) {
            let mut handle: UnifiedObjectHandle = {
                object, fd_generation[fd as isize]
            };
            return UnifiedDirectoryResult::Found(handle);
        }
    }
    return UnifiedDirectoryResult::Missing;
}

fn unified_directory_inode(handle: UnifiedObjectHandle) -> usize {
    if (object_kind[handle.slot] == UnifiedFdKind::Directory &&
        refcount_pool_matches(&object_pool, handle.slot, handle.generation)) {
        return object_inode[handle.slot];
    }
    return 0;
}

fn unified_file_is_readable(handle: UnifiedObjectHandle) -> bool {
    return object_kind[handle.slot] == UnifiedFdKind::OpenFile &&
           refcount_pool_matches(&object_pool, handle.slot, handle.generation) &&
           object_readable[handle.slot];
}

fn unified_file_is_writable(handle: UnifiedObjectHandle) -> bool {
    return object_kind[handle.slot] == UnifiedFdKind::OpenFile &&
           refcount_pool_matches(&object_pool, handle.slot, handle.generation) &&
           object_writable[handle.slot];
}

fn unified_fd_install(process: usize, fd: usize, object_value: usize,
                      generation: usize) -> UnifiedFdResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX ||
        object_value >= SHARED_OBJECT_MAX) {
        return UnifiedFdResult::Invalid;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let fd_close_on_exec = process_fd_context[process_index].fd_close_on_exec;
    if (object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        if (fd_kind[fd as isize] != UnifiedFdKind::Empty ||
            object_kind[object] == UnifiedFdKind::Empty) {
            return UnifiedFdResult::Invalid;
        }
        match refcount_pool_retain(&object_pool, object, generation) {
            RefcountRetainResult::Invalid => { return UnifiedFdResult::Invalid; }
            RefcountRetainResult::Overflow => { return UnifiedFdResult::Invalid; }
            RefcountRetainResult::Ok => {}
        }
        fd_kind[fd as isize] = object_kind[object];
        fd_object[fd as isize] = object;
        fd_generation[fd as isize] = generation;
        fd_close_on_exec[fd as isize] = false;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_fd_close(process: usize, fd: usize) -> UnifiedFdResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedFdResult::Invalid;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let fd_close_on_exec = process_fd_context[process_index].fd_close_on_exec;
    let object_value: usize = fd_object[fd as isize];
    if (fd_kind[fd as isize] != UnifiedFdKind::Empty &&
        object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        let generation: usize = fd_generation[fd as isize];
        match refcount_pool_release(&object_pool, object, generation) {
            RefcountReleaseResult::Invalid => { return UnifiedFdResult::Invalid; }
            RefcountReleaseResult::StillHeld => {}
            RefcountReleaseResult::Freed => {
                object_kind[object] = UnifiedFdKind::Empty;
            }
        }
        fd_kind[fd as isize] = UnifiedFdKind::Empty;
        fd_object[fd as isize] = 0;
        fd_generation[fd as isize] = 0;
        fd_close_on_exec[fd as isize] = false;
        return UnifiedFdResult::Ok;
    }
    return UnifiedFdResult::Invalid;
}

fn unified_fd_clone(parent: usize, child: usize) -> UnifiedFdResult {
    if (parent >= PROCESS_CONTEXT_MAX || child >= PROCESS_CONTEXT_MAX ||
        parent == child) { return UnifiedFdResult::Invalid; }
    let parent_index = unified_fd_narrow_process(parent);
    let child_index = unified_fd_narrow_process(child);
    let parent_fd_kind = process_fd_context[parent_index].fd_kind;
    let parent_fd_object = process_fd_context[parent_index].fd_object;
    let parent_fd_generation = process_fd_context[parent_index].fd_generation;
    let parent_fd_close_on_exec =
        process_fd_context[parent_index].fd_close_on_exec;
    let child_fd_kind = process_fd_context[child_index].fd_kind;
    let child_fd_object = process_fd_context[child_index].fd_object;
    let child_fd_generation = process_fd_context[child_index].fd_generation;
    let child_fd_close_on_exec =
        process_fd_context[child_index].fd_close_on_exec;
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (child_fd_kind[fd as isize] != UnifiedFdKind::Empty) {
            return UnifiedFdResult::Invalid;
        }
        if (parent_fd_kind[fd as isize] != UnifiedFdKind::Empty) {
            let object_value: usize = parent_fd_object[fd as isize];
            if (object_value < SHARED_OBJECT_MAX) {
                let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
                if (object_kind[object] != parent_fd_kind[fd as isize] ||
                    refcount_pool_count(&object_pool, object,
                                        parent_fd_generation[fd as isize]) == 0) {
                    return UnifiedFdResult::Invalid;
                }
            } else {
                return UnifiedFdResult::Invalid;
            }
        }
    }
    process_fd_context[child_index].heap_break =
        process_fd_context[parent_index].heap_break;
    process_fd_context[child_index].heap_start =
        process_fd_context[parent_index].heap_start;
    process_fd_context[child_index].heap_limit =
        process_fd_context[parent_index].heap_limit;
    for fd: usize in 0..<PROCESS_FD_MAX {
        child_fd_kind[fd as isize] = parent_fd_kind[fd as isize];
        child_fd_object[fd as isize] = parent_fd_object[fd as isize];
        child_fd_generation[fd as isize] = parent_fd_generation[fd as isize];
        child_fd_close_on_exec[fd as isize] =
            parent_fd_close_on_exec[fd as isize];
        if (parent_fd_kind[fd as isize] != UnifiedFdKind::Empty) {
            let value: usize = parent_fd_object[fd as isize];
            if (value < SHARED_OBJECT_MAX) {
                let object: {0..<SHARED_OBJECT_MAX as usize} = value;
                match refcount_pool_retain(&object_pool, object,
                                           parent_fd_generation[fd as isize]) {
                    RefcountRetainResult::Ok => {}
                    RefcountRetainResult::Invalid => {
                        return UnifiedFdResult::Invalid;
                    }
                    RefcountRetainResult::Overflow => {
                        return UnifiedFdResult::Invalid;
                    }
                }
            } else {
                return UnifiedFdResult::Invalid;
            }
        }
    }
    return UnifiedFdResult::Ok;
}

fn unified_fd_set_offset(process: usize, fd: usize, offset: usize)
        -> UnifiedFdResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedFdResult::Invalid;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let object_value: usize = fd_object[fd as isize];
    if ((fd_kind[fd as isize] == UnifiedFdKind::OpenFile ||
         fd_kind[fd as isize] == UnifiedFdKind::Directory) &&
        object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        if ((object_kind[object] == UnifiedFdKind::OpenFile ||
             object_kind[object] == UnifiedFdKind::Directory) &&
            refcount_pool_matches(&object_pool, object,
                                  fd_generation[fd as isize])) {
            object_offset[object] = offset;
            return UnifiedFdResult::Ok;
        }
    }
    return UnifiedFdResult::Invalid;
}

fn unified_fd_offset(process: usize, fd: usize) -> UnifiedOffsetResult {
    if (process >= PROCESS_CONTEXT_MAX || fd >= PROCESS_FD_MAX) {
        return UnifiedOffsetResult::Missing;
    }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    let fd_object = process_fd_context[process_index].fd_object;
    let fd_generation = process_fd_context[process_index].fd_generation;
    let object_value: usize = fd_object[fd as isize];
    if ((fd_kind[fd as isize] == UnifiedFdKind::OpenFile ||
         fd_kind[fd as isize] == UnifiedFdKind::Directory) &&
        object_value < SHARED_OBJECT_MAX) {
        let object: {0..<SHARED_OBJECT_MAX as usize} = object_value;
        if ((object_kind[object] == UnifiedFdKind::OpenFile ||
             object_kind[object] == UnifiedFdKind::Directory) &&
            refcount_pool_matches(&object_pool, object,
                                  fd_generation[fd as isize])) {
            return UnifiedOffsetResult::Found(object_offset[object]);
        }
    }
    return UnifiedOffsetResult::Missing;
}

fn unified_fd_destroy(process: usize) -> UnifiedFdResult {
    if (process >= PROCESS_CONTEXT_MAX) { return UnifiedFdResult::Invalid; }
    let process_index = unified_fd_narrow_process(process);
    let fd_kind = process_fd_context[process_index].fd_kind;
    for fd: usize in 0..<PROCESS_FD_MAX {
        if (fd_kind[fd as isize] != UnifiedFdKind::Empty) {
            match unified_fd_close(process, fd) {
                UnifiedFdResult::Invalid => {
                    return UnifiedFdResult::Invalid;
                }
                UnifiedFdResult::Ok => {}
            }
        }
    }
    return UnifiedFdResult::Ok;
}

fn unified_fd_probe_install(fd: usize, result: UnifiedObjectResult) -> bool {
    match result {
        UnifiedObjectResult::Invalid => { return false; }
        UnifiedObjectResult::Full => { return false; }
        UnifiedObjectResult::Allocated(handle) => {
            match unified_fd_install(0, fd, handle.slot, handle.generation) {
                UnifiedFdResult::Invalid => { return false; }
                UnifiedFdResult::Ok => { return true; }
            }
        }
    }
}

fn unified_fd_table_probe() -> bool {
    unified_fd_table_init();
    process_fd_context[0].heap_break = 0x50000000;
    match unified_terminal_stdio_open(0) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    if (unified_terminal_is_open(0, 0) == false ||
        unified_terminal_is_open(0, 1) == false ||
        unified_terminal_is_open(0, 2) == false) {
        return false;
    }
    match unified_fd_close(0, 0) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_alloc(0, 0) {
        UnifiedFdAllocResult::Full => { return false; }
        UnifiedFdAllocResult::Allocated(fd) => {
            if (fd != 0 || unified_fd_probe_install(
                    fd, unified_object_alloc_first(
                        UnifiedFdKind::OpenFile)) == false) {
                return false;
            }
        }
    }
    if (unified_fd_probe_install(
            3, unified_object_alloc_first(UnifiedFdKind::OpenFile)) == false ||
        unified_fd_probe_install(
            4, unified_object_alloc_first(UnifiedFdKind::Listener)) == false ||
        unified_fd_probe_install(
            5, unified_object_alloc_first(UnifiedFdKind::Connection)) == false) {
        return false;
    }
    match unified_fd_clone(0, 1) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_process_heap_configure(1, 0x50001000) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_set_offset(1, 3, 9) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    let mut shared: bool = false;
    match unified_fd_offset(0, 3) {
        UnifiedOffsetResult::Missing => {}
        UnifiedOffsetResult::Found(offset) => {
            if (offset == 9) { shared = true; }
        }
    }
    match unified_fd_close(1, 4) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_destroy(1) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    match unified_fd_destroy(0) {
        UnifiedFdResult::Invalid => { return false; }
        UnifiedFdResult::Ok => {}
    }
    for object: usize in 0..<SHARED_OBJECT_MAX {
        if (object_kind[object] != UnifiedFdKind::Empty ||
            refcount_pool_raw_count(&object_pool, object) != 0) {
            return false;
        }
    }
    if (refcount_pool_double_release_count(&object_pool) != 0) {
        return false;
    }
    let mut heap_independent: bool = false;
    match unified_process_heap_break(0) {
        UnifiedOffsetResult::Missing => {}
        UnifiedOffsetResult::Found(value) => {
            if (value == 0x50000000) { heap_independent = true; }
        }
    }
    return shared && heap_independent;
}
