// GitHub issue #303, part of #294 (consolidate kernel runtime state behind
// explicit owners). Split out of kernel/kernel/process.tkb's own
// execution_* globals: these ten counters/flags are read only by
// kernel_process_*_evidence()/kernel_process_*_acceptance_evidence()
// predicate functions (process.tkb), never by real scheduling/dispatch
// decisions. That is what distinguishes this file's
// state from process.tkb's execution_scheduler_enabled/
// execution_reschedule_pending, which stay there because
// kernel_process_schedule()/kernel_process_syscall_return_schedule()
// actually branch on them.
//
// Current limitations: single-writer, boot-scoped, matching the rest of
// process.tkb's execution_* state before this split -- reset only from
// kernel_process_execution_reset() via process_test_evidence_reset(),
// never independently. process_test_evidence_record_timer_switch() is
// called from kernel_process_timer_schedule(), a `!{interrupt}` context;
// this file has no locking of its own, safe only because there is one
// core running the scheduler (see process.tkb's own "Current
// limitations" header).
// GitHub issue #1475: the fields are AtomicWords, so a counter another core
// bumps is never torn or lost to a plain read-modify-write, and the UART
// marker is claimed by one compare-and-swap.

use "kernel/lib/atomic_word.tkb";

struct ProcessTestEvidence {
    clone_calls: AtomicWord;
    exit_42_seen: AtomicWord;
    uart_blocks: AtomicWord;
    uart_wakes: AtomicWord;
    uart_parent_progress: AtomicWord;
    // Evidence is boot-scoped, unlike the per-workload counters above. The
    // final interactive shell starts after another process_test_evidence_
    // reset(), but must not make the same one-time integration marker
    // appear twice in a shared UART capture -- see
    // process_test_evidence_record_uart_block()'s own comment.
    uart_block_logged: AtomicWord;
    timer_switches: AtomicWord;
    deferred_switches: AtomicWord;
    deferred_requests: AtomicWord;
}

private let mut process_test_evidence: ProcessTestEvidence;

fn process_test_evidence_reset() {
    atomic_word_store(&process_test_evidence.clone_calls, 0);
    atomic_word_store(&process_test_evidence.exit_42_seen, 0);
    atomic_word_store(&process_test_evidence.timer_switches, 0);
    atomic_word_store(&process_test_evidence.deferred_switches, 0);
    atomic_word_store(&process_test_evidence.deferred_requests, 0);
    atomic_word_store(&process_test_evidence.uart_blocks, 0);
    atomic_word_store(&process_test_evidence.uart_wakes, 0);
    atomic_word_store(&process_test_evidence.uart_parent_progress, 0);
    // uart_block_logged intentionally NOT reset here, matching the
    // original execution_uart_block_logged behavior.
}

fn process_test_evidence_record_clone() {
    atomic_word_fetch_add(&process_test_evidence.clone_calls, 1);
}

fn process_test_evidence_release_clone() {
    // Never below zero: the decrement is a compare-and-swap from the value
    // just read, retried while another core moves it.
    for attempt: usize in 0..<64 {
        let calls: usize = atomic_word_load(&process_test_evidence.clone_calls);
        if (calls == 0) { return; }
        if (atomic_word_compare_exchange(&process_test_evidence.clone_calls,
                                         calls, calls - 1)) {
            return;
        }
    }
}

fn process_test_evidence_clone_calls() -> usize {
    return atomic_word_load(&process_test_evidence.clone_calls);
}

fn process_test_evidence_record_child_exit(status: ProcessEnd) {
    match status {
        ProcessEnd::Exited(code) => {
            if (code == 42) { atomic_word_store(&process_test_evidence.exit_42_seen, 1); }
        }
        ProcessEnd::Signaled(_) => {}
    }
}

fn process_test_evidence_exit_42_seen() -> bool {
    return atomic_word_load(&process_test_evidence.exit_42_seen) != 0;
}

// Increments the block counter and returns true only the first time since
// the last process_test_evidence_set_uart_block_logged(false) -- callers
// use that to gate a one-time boot log line without duplicating the
// increment-then-check-then-set sequence at each call site.
//
// GitHub issue #448: counting and CLAIMING THE MARKER are two different
// questions now. Every UART block is counted, because
// kernel_process_uart_block_evidence() checks wakes against blocks and a
// block that went uncounted would make a woken process look like a wake
// with no block. But only the payload fixture's own block may claim the
// one-time line: an ash `read(2)` reaches this function too since
// #448 made a UART waiter really yield, and on RPi5 it got here first and
// printed the payload's marker into the middle of the ash transcript.
fn process_test_evidence_record_uart_block(claim_marker: bool) -> bool {
    atomic_word_fetch_add(&process_test_evidence.uart_blocks, 1);
    // The claim is one compare-and-swap, so two blocks cannot both claim it.
    return claim_marker &&
        atomic_word_compare_exchange(&process_test_evidence.uart_block_logged, 0, 1);
}

fn process_test_evidence_set_uart_block_logged(value: bool) {
    let mut word: usize = 0;
    if (value) { word = 1; }
    atomic_word_store(&process_test_evidence.uart_block_logged, word);
}

fn process_test_evidence_uart_blocks() -> usize {
    return atomic_word_load(&process_test_evidence.uart_blocks);
}

fn process_test_evidence_record_uart_wake() {
    atomic_word_fetch_add(&process_test_evidence.uart_wakes, 1);
}

fn process_test_evidence_uart_wakes() -> usize {
    return atomic_word_load(&process_test_evidence.uart_wakes);
}

fn process_test_evidence_record_uart_parent_progress() {
    atomic_word_fetch_add(&process_test_evidence.uart_parent_progress, 1);
}

fn process_test_evidence_uart_parent_progress() -> usize {
    return atomic_word_load(&process_test_evidence.uart_parent_progress);
}

fn process_test_evidence_record_timer_switch() {
    atomic_word_fetch_add(&process_test_evidence.timer_switches, 1);
}

fn process_test_evidence_timer_switches() -> usize {
    return atomic_word_load(&process_test_evidence.timer_switches);
}

fn process_test_evidence_record_deferred_switch() {
    atomic_word_fetch_add(&process_test_evidence.deferred_switches, 1);
}

fn process_test_evidence_deferred_switches() -> usize {
    return atomic_word_load(&process_test_evidence.deferred_switches);
}

fn process_test_evidence_record_deferred_request() {
    atomic_word_fetch_add(&process_test_evidence.deferred_requests, 1);
}

fn process_test_evidence_deferred_requests() -> usize {
    return atomic_word_load(&process_test_evidence.deferred_requests);
}
