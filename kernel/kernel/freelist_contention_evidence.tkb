// GitHub issue #479, Group A: does `kernel/lib/freelist.tkb`'s free chain
// actually break under two cores, and does the fix actually fix it.
//
// The order matters and is the point. This probe is written BEFORE the fix
// and is expected to FAIL, because "the free chain has no lock, and a
// concurrent push corrupts it silently" is an assertion message, not a
// measurement. An assertion that names a race nobody has produced is a
// claim; producing it first is what turns the fix into an answer to
// something.
//
// The method is #479's: exercise one subsystem from core 1 while
// KERNEL_ACTIVE_CORES is still 1 and core 1 still runs no process. That is
// possible here for the same reason it was for the pool
// (kernel/kernel/pool_contention_evidence.tkb) -- this probe owns its own
// FreelistCore and touches nothing else, so a failure is attributable to
// the primitive rather than to whatever else shares a live instance.
//
// What the race is: freelist_core_insert reads free_head, then writes
// next_free[head] back into free_head. Two cores that read the same head
// both pop the same index. Both then hold what each believes is an
// exclusive allocation.
//
// Current limitations:
// - DETECTS DOUBLE HAND-OUT, not every possible corruption. A chain that
//   loses entries without duplicating them would show up as Empty rather
//   than as a caught index; that is counted too, but the counter that
//   matters is the duplicate one, because a duplicate is what a caller
//   turns into two owners of one object.
// - The instance is small on purpose. A short chain makes two cores
//   collide on the same head often; a long one would need many more
//   rounds to hit the same window.
// - Says nothing about generations. FreelistOwner's generation is what
//   makes a STALE handle detectable; this is about two LIVE ones.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/freelist.tkb";
use "kernel/lib/pool_lock.tkb";
use "kernel/lib/execution_model.tkb";

const FREELIST_CONTENTION_SLOTS: usize = 8;
const FREELIST_CONTENTION_ROUNDS: usize = 4096;

// Same reasoning as the pool probe's CONTENTION_OUTSIDE_WORK: a core that
// re-enters the instant it leaves owns the structure, and measures that
// rather than the structure.
const FREELIST_CONTENTION_OUTSIDE_WORK: usize = 64;

must_use variant FreelistProbeRendezvousResult {
    Met;
    TimedOut;
}

private let mut freelist_probe: FreelistCore(FREELIST_CONTENTION_SLOTS);
private let mut freelist_probe_ready: bool = false;

// One word per slot: 1 while some core believes it exclusively holds that
// index. Two cores handed the same index find it already 1, which is the
// double hand-out this probe exists to catch.
private let mut freelist_probe_held: [AtomicWord; FREELIST_CONTENTION_SLOTS];

// Phase 2's lock. The primitive still has none -- that is deliberate, see
// freelist.tkb -- so what phase 2 demonstrates is the CALLER holding one,
// which is the arrangement kernel/mm/page.tkb now uses for the free chain
// that matters (GitHub issue #479).
private let mut freelist_probe_lock: Mutex;
// 0 = phase 1, no lock, the race is expected. 1 = phase 2, locked.
private let mut freelist_probe_locked_phase: AtomicWord;

private let mut freelist_probe_armed: AtomicWord;
private let mut freelist_probe_primary: AtomicWord;
private let mut freelist_probe_secondary: AtomicWord;
private let mut freelist_probe_duplicates: AtomicWord;
private let mut freelist_probe_empty: AtomicWord;
private let mut freelist_probe_active: AtomicWord;
private let mut freelist_probe_overlap: AtomicWord;
private let mut freelist_probe_primary_arrived: AtomicWord;
private let mut freelist_probe_secondary_arrived: AtomicWord;
private let mut freelist_probe_primary_marked: AtomicWord;
private let mut freelist_probe_secondary_marked: AtomicWord;

private fn freelist_probe_armed_address() -> *AtomicWord {
    return &freelist_probe_armed;
}

private fn freelist_probe_primary_address() -> *AtomicWord {
    return &freelist_probe_primary;
}

private fn freelist_probe_secondary_address() -> *AtomicWord {
    return &freelist_probe_secondary;
}

private fn freelist_probe_duplicates_address() -> *AtomicWord {
    return &freelist_probe_duplicates;
}

private fn freelist_probe_empty_address() -> *AtomicWord {
    return &freelist_probe_empty;
}

private fn freelist_probe_active_address() -> *AtomicWord {
    return &freelist_probe_active;
}

// GitHub issue #510: entries into the secondary's run function, counted and
// never cleared. This is what core 0's entry gate waits on.
//
// `active` cannot be that gate. It is a LEVEL the secondary clears on its
// way out, and this probe's secondary CAN leave while still armed: the
// rendezvous below sets `armed = 0` when it times out, and the round loop
// then falls through to clear `active`. A core 0 that was descheduled past
// the rendezvous deadline -- measured to happen under host saturation --
// comes back, polls `active`, sees 0, and reports `secondary-never-entered`
// about a core that entered and waited for it. The verdict is right and the
// reason is wrong, which is the whole of what #510 was filed about.
//
// A COUNT, not a flag, and incremented at the top of the function BEFORE any
// rendezvous. Gating on the per-round cycle count instead would deadlock:
// that count only advances after a rendezvous with core 0, and core 0 is the
// one waiting.
private let mut freelist_probe_entries: AtomicWord;

private fn freelist_probe_entries_address() -> *AtomicWord {
    return &freelist_probe_entries;
}

private fn freelist_probe_overlap_address() -> *AtomicWord {
    return &freelist_probe_overlap;
}

private fn freelist_probe_primary_arrived_address() -> *AtomicWord {
    return &freelist_probe_primary_arrived;
}

private fn freelist_probe_secondary_arrived_address() -> *AtomicWord {
    return &freelist_probe_secondary_arrived;
}

private fn freelist_probe_primary_marked_address() -> *AtomicWord {
    return &freelist_probe_primary_marked;
}

private fn freelist_probe_secondary_marked_address() -> *AtomicWord {
    return &freelist_probe_secondary_marked;
}

private fn freelist_probe_locked_phase_address() -> *AtomicWord {
    return &freelist_probe_locked_phase;
}

private fn freelist_probe_held_address(
        index: {0..<FREELIST_CONTENTION_SLOTS as usize}) -> *AtomicWord {
    return &freelist_probe_held[index];
}

private fn freelist_probe_init() {
    if (freelist_probe_ready) { return; }
    freelist_probe_ready = true;
    freelist_core_init(&freelist_probe);
    // No mutex_init: a global Mutex is free from .bss, and initialising it
    // behind this `ready` flag would be the same lazy-init race the tag
    // counter's version was. See kernel/lib/mutex.tkb.
}

// Take an index, mark it held, give it back. Both cores run this.
//
// The marking is a real atomic exchange, so the DETECTOR is sound even
// while the thing under test is not: a probe whose own bookkeeping raced
// would report duplicates that were its own fault.
private fn freelist_probe_rendezvous(primary: bool, sequence: usize,
                                     primary_address: *AtomicWord,
                                     secondary_address: *AtomicWord)
        -> FreelistProbeRendezvousResult !{unsafe} {
    let mut own_address: *AtomicWord = secondary_address;
    let mut peer_address: *AtomicWord = primary_address;
    if (primary) {
        own_address = primary_address;
        peer_address = secondary_address;
    }
    atomic_word_store(own_address, sequence);
    let mut deadline: PeerTickWindow = peer_tick_window_start(128);
    while (peer_tick_window_open(deadline) &&
           atomic_word_load(peer_address) < sequence &&
           atomic_word_load(freelist_probe_armed_address()) == 1) {
    }
    if (atomic_word_load(peer_address) >= sequence &&
        atomic_word_load(freelist_probe_armed_address()) == 1) {
        return FreelistProbeRendezvousResult::Met;
    }
    atomic_word_store(freelist_probe_armed_address(), 0);
    return FreelistProbeRendezvousResult::TimedOut;
}

private fn freelist_probe_record_pop(result: FreelistPopResult,
                                     primary: bool, sequence: usize)
        -> bool !{unsafe} {
    match result {
        FreelistPopResult::Empty => {
            if (atomic_word_load( freelist_probe_locked_phase_address()) == 0) {
                match freelist_probe_rendezvous(
                        primary, sequence,
                        freelist_probe_primary_marked_address(),
                        freelist_probe_secondary_marked_address()) {
                    FreelistProbeRendezvousResult::TimedOut => {}
                    FreelistProbeRendezvousResult::Met => {}
                }
            }
            atomic_word_fetch_add(freelist_probe_empty_address(), 1);
            return false;
        }
        FreelistPopResult::Popped(owner) => {
            let index: usize = freelist_owner_index(owner);
            if (index < FREELIST_CONTENTION_SLOTS) {
                let previous: usize =
                    atomic_word_swap(freelist_probe_held_address(index), 1);
                if (previous != 0) {
                    atomic_word_fetch_add(
                        freelist_probe_duplicates_address(), 1);
                }
                if (atomic_word_load( freelist_probe_locked_phase_address()) == 0) {
                    match freelist_probe_rendezvous(
                            primary, sequence,
                            freelist_probe_primary_marked_address(),
                            freelist_probe_secondary_marked_address()) {
                        FreelistProbeRendezvousResult::TimedOut => {}
                        FreelistProbeRendezvousResult::Met => {}
                    }
                }
                atomic_word_store(
                    freelist_probe_held_address(index), 0);
            }
            freelist_core_remove(&freelist_probe, owner);
            return true;
        }
    }
}

private fn freelist_probe_cycle(primary: bool, sequence: usize)
        -> bool !{unsafe} {
    let locked: bool = atomic_word_load(freelist_probe_locked_phase_address()) == 1;
    let mut taken: bool = false;
    if (locked) {
        match freelist_probe_rendezvous(
                primary, sequence,
                freelist_probe_primary_arrived_address(),
                freelist_probe_secondary_arrived_address()) {
            FreelistProbeRendezvousResult::TimedOut => {}
            FreelistProbeRendezvousResult::Met => {
                let flags: usize =
                    pool_lock_acquire(0, &freelist_probe_lock);
                taken = freelist_probe_record_pop(
                    freelist_core_insert(&freelist_probe),
                    primary, sequence);
                pool_lock_release(0, &freelist_probe_lock, flags);
            }
        }
    } else {
        match freelist_core_insert_probe_begin(&freelist_probe) {
            FreelistPopProbeBeginResult::Empty => {
                match freelist_probe_rendezvous(
                        primary, sequence,
                        freelist_probe_primary_arrived_address(),
                        freelist_probe_secondary_arrived_address()) {
                    FreelistProbeRendezvousResult::TimedOut => {}
                    FreelistProbeRendezvousResult::Met => {}
                }
                taken = freelist_probe_record_pop(
                    FreelistPopResult::Empty, primary, sequence);
            }
            FreelistPopProbeBeginResult::Pending(pending) => {
                match freelist_probe_rendezvous(
                        primary, sequence,
                        freelist_probe_primary_arrived_address(),
                        freelist_probe_secondary_arrived_address()) {
                    FreelistProbeRendezvousResult::TimedOut => {
                        freelist_core_insert_probe_cancel(pending);
                    }
                    FreelistProbeRendezvousResult::Met => {
                        taken = freelist_probe_record_pop(
                            freelist_core_insert_probe_commit(
                                &freelist_probe, pending),
                            primary, sequence);
                    }
                }
            }
        }
    }
    // Outside the lock in phase 2, and in the same place in phase 1 so the
    // two phases differ by exactly one thing.
    for spin: usize in 0..<FREELIST_CONTENTION_OUTSIDE_WORK { }
    return taken;
}

fn freelist_contention_is_armed() -> bool !{unsafe} {
    return atomic_word_load(freelist_probe_armed_address()) == 1;
}

fn freelist_contention_secondary_run() !{unsafe} {
    atomic_word_fetch_add(freelist_probe_entries_address(), 1);
    atomic_word_store(freelist_probe_active_address(), 1);
    // The idle loop may enter again before the primary disarms this phase.
    // Keep the round in the phase's published count, not a fresh local loop:
    // an old rendezvous sequence must never authorize another allocation.
    while (atomic_word_load(freelist_probe_secondary_address()) <
               FREELIST_CONTENTION_ROUNDS &&
           atomic_word_load(freelist_probe_armed_address()) == 1) {
        let sequence: usize =
            atomic_word_load(freelist_probe_secondary_address()) + 1;
        if (freelist_probe_cycle(false, sequence)) {
            atomic_word_fetch_add(freelist_probe_secondary_address(), 1);
        }
    }
    atomic_word_store(freelist_probe_active_address(), 0);
}

private fn freelist_contention_report(stage: *u8) !{unsafe} {
    kernel_boot_log("freelist contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("freelist contention counts: primary=");
    uart_put_udec(atomic_word_load(freelist_probe_primary_address()));
    kernel_boot_log(" secondary=");
    uart_put_udec(atomic_word_load(freelist_probe_secondary_address()));
    kernel_boot_log(" duplicates=");
    uart_put_udec(atomic_word_load(freelist_probe_duplicates_address()));
    kernel_boot_log(" empty=");
    uart_put_udec(atomic_word_load(freelist_probe_empty_address()));
    kernel_boot_log(" overlap=");
    uart_put_udec(atomic_word_load(freelist_probe_overlap_address()));
    kernel_boot_log("\n");
}

// One phase: arm, wait for the secondary, both cores cycle, wait for it to
// finish. Returns the duplicate count, or a negative-shaped failure through
// `ok`.
private fn freelist_contention_phase(locked: bool) -> bool !{unsafe} {
    atomic_word_store(freelist_probe_primary_address(), 0);
    atomic_word_store(freelist_probe_secondary_address(), 0);
    atomic_word_store(freelist_probe_duplicates_address(), 0);
    atomic_word_store(freelist_probe_empty_address(), 0);
    atomic_word_store(freelist_probe_overlap_address(), 0);
    atomic_word_store(freelist_probe_primary_arrived_address(), 0);
    atomic_word_store(freelist_probe_secondary_arrived_address(), 0);
    atomic_word_store(freelist_probe_primary_marked_address(), 0);
    atomic_word_store(freelist_probe_secondary_marked_address(), 0);
    atomic_word_store(freelist_probe_active_address(), 0);
    freelist_core_init(&freelist_probe);
    if (locked) {
        atomic_word_store(freelist_probe_locked_phase_address(), 1);
    } else {
        atomic_word_store(freelist_probe_locked_phase_address(), 0);
    }
    let entries_before: usize = atomic_word_load(freelist_probe_entries_address());
    atomic_word_store(freelist_probe_armed_address(), 1);

    // Core 1 remains inside its first per-round rendezvous until core 0
    // arrives, so `active` can no longer be a pulse that a long QEMU vCPU
    // timeslice misses. In the unlocked phase each core has already read
    // the same freelist head before that rendezvous completes.
    let mut entry_window: PeerTickWindow = peer_tick_window_start(16);
    let mut entered: bool = false;
    while (entered == false && peer_tick_window_open(entry_window)) {
        if (atomic_word_load(freelist_probe_entries_address()) > entries_before) {
            entered = true;
        }
    }
    if (entered == false) {
        atomic_word_store(freelist_probe_armed_address(), 0);
        freelist_contention_report("secondary-never-entered" as *u8);
        return false;
    }


    for round: usize in 0..<FREELIST_CONTENTION_ROUNDS {
        if (freelist_probe_cycle(true, round + 1)) {
            atomic_word_fetch_add(freelist_probe_primary_address(), 1);
        }
    }

    if (atomic_word_load(freelist_probe_armed_address()) == 0) {
        freelist_contention_report("rendezvous-timeout" as *u8);
        return false;
    }

    // With per-round rendezvous this is the secondary completion count at
    // the instant the primary finishes, not a scheduler-granularity metric.
    atomic_word_store(freelist_probe_overlap_address(),
        atomic_word_load(freelist_probe_secondary_address()));

    let mut finish_window: PeerTickWindow = peer_tick_window_start(128);
    let mut finished: bool = false;
    while (finished == false && peer_tick_window_open(finish_window)) {
        if (atomic_word_load(freelist_probe_secondary_address()) >=
                FREELIST_CONTENTION_ROUNDS) {
            finished = true;
        }
    }
    atomic_word_store(freelist_probe_armed_address(), 0);
    if (finished == false) {
        freelist_contention_report("secondary-never-finished" as *u8);
        return false;
    }
    // Disarming is a request, not an acknowledgement. Wait for the last
    // secondary invocation to leave before the next phase resets its state.
    let mut settle_window: PeerTickWindow = peer_tick_window_start(16);
    while (atomic_word_load(freelist_probe_active_address()) != 0 &&
           peer_tick_window_open(settle_window)) { }
    if (atomic_word_load(freelist_probe_active_address()) != 0) {
        freelist_contention_report("secondary-never-left" as *u8);
        return false;
    }
    let primary: usize = atomic_word_load(freelist_probe_primary_address());
    let secondary: usize = atomic_word_load(freelist_probe_secondary_address());
    let empty: usize = atomic_word_load(freelist_probe_empty_address());
    if (primary != FREELIST_CONTENTION_ROUNDS ||
        secondary != FREELIST_CONTENTION_ROUNDS || empty != 0) {
        freelist_contention_report("incomplete" as *u8);
        return false;
    }
    return true;
}

fn freelist_contention_duplicates() -> usize !{unsafe} {
    return atomic_word_load(freelist_probe_duplicates_address());
}

// TWO phases, and the verdict needs BOTH to come out right.
//
// Phase 1 runs unlocked and must SHOW the race. Its two cores rendezvous
// after the real primitive's shared begin step has read free_head, then
// commit through the same private implementation as ordinary insertion.
// Phase 2 rendezvouses before the complete insertion and has the caller
// lock around it. A test that only checked phase 2 would assert nothing
// about whether its contention control still exercised the vulnerable
// read/update window.
fn freelist_contention_probe() -> bool !{unsafe} {
    freelist_probe_init();

    if (freelist_contention_phase(false) == false) { return false; }
    let unlocked_duplicates: usize = freelist_contention_duplicates();
    freelist_contention_report("unlocked" as *u8);

    if (freelist_contention_phase(true) == false) { return false; }
    let locked_duplicates: usize = freelist_contention_duplicates();
    freelist_contention_report("locked" as *u8);

    if (unlocked_duplicates == 0) {
        kernel_boot_log(
            "freelist contention verdict: unlocked-race-not-reproduced\n");
        return false;
    }
    if (locked_duplicates != 0) {
        kernel_boot_log(
            "freelist contention verdict: locked-duplicate-handout\n");
        return false;
    }
    return true;
}
