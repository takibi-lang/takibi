// How a process ended, as this kernel records it and as wait4 reports it.
// Kept apart from syscall.tkb so linux_user/wait_status can run this same
// encoding natively against the host Linux's own wait4 (GitHub issue #882).
//
// Current limitations: pure functions over a value, no shared state. No
// core dump is ever reported (bit 0x80 stays clear), and there are no
// stopped/continued forms because there is no job control. Callers pass
// an exit code already masked to its low byte, or a value from
// syscall_status_signaled; nothing here enforces that.
//
// GitHub issue #882: a process's recorded end is an exit code 0..255 or,
// with SYSCALL_STATUS_SIGNALED set, the signal that killed it. It used to
// record a signal's end as exit code 128+signal, which wait4 then encoded
// as an exit -- a shell's $? convention, not Linux's status word, so
// WIFSIGNALED was false for a killed child. No core dumps: bit 0x80 stays 0.
const SYSCALL_STATUS_SIGNALED: usize = 0x100;

fn syscall_status_signaled(signal: usize) -> usize {
    return SYSCALL_STATUS_SIGNALED | (signal & 0x7F);
}

// The wait4 status word: Linux's WTERMSIG form (signal in the low seven
// bits) for a killed process, WEXITSTATUS form (code << 8) for an exit.
fn syscall_wait_status_word(status: usize) -> u32 {
    if ((status & SYSCALL_STATUS_SIGNALED) != 0) {
        return (status & 0x7F) as u32;
    }
    return ((status & 0xFF) << 8) as u32;
}

// What a shell's $? shows for it: the code, or 128 + signal. Only for
// logs; wait4 reports syscall_wait_status_word.
fn syscall_status_shell_code(status: usize) -> usize {
    if ((status & SYSCALL_STATUS_SIGNALED) != 0) {
        return 128 + (status & 0x7F);
    }
    return status & 0xFF;
}
