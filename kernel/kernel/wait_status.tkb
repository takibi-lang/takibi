// How a process ended, as this kernel records it and as wait4 reports it.
// Kept apart from syscall.tkb so linux_user/wait_status can run this same
// encoding natively against the host Linux's own wait4 (GitHub issue #882).
//
// Current limitations: pure functions over a value, no shared state. No
// core dump is ever reported (bit 0x80 stays clear), and there are no
// stopped/continued forms because there is no job control.
//
// GitHub issue #882: a process's recorded end used to be one integer for
// both an exit code and a signal; a signal's end was recorded as exit code
// 128+signal, which wait4 then encoded as an exit -- a shell's $?
// convention, not Linux's status word, so WIFSIGNALED was false for a
// killed child. GitHub issue #886: the end is now a closed variant, so an
// exit code cannot be passed where a signal's end is meant, or the reverse,
// and every report below is derived from the case rather than from a flag
// bit. The constructors keep only what Linux keeps: an exit code's low
// byte, a signal's low seven bits.
variant ProcessEnd {
    Exited(u8);
    Signaled(u8);
}

fn process_end_exited(code: usize) -> ProcessEnd {
    return ProcessEnd::Exited((code & 0xFF) as u8);
}

fn process_end_signaled(signal: usize) -> ProcessEnd {
    return ProcessEnd::Signaled((signal & 0x7F) as u8);
}

// A ProcessEnd kept in an indexed owner's field (TakenSignal), which the
// compiler does not let hold a variant. The packing is private to this
// file: elsewhere it is only made from a ProcessEnd and turned back into
// one, so it cannot be built from a bare integer.
struct ProcessEndWord { private word: u32; }

fn process_end_word(end: ProcessEnd) -> ProcessEndWord {
    match end {
        ProcessEnd::Exited(code) => {
            let mut stored: ProcessEndWord = { code as u32 };
            return stored;
        }
        ProcessEnd::Signaled(signal) => {
            let mut stored: ProcessEndWord = { 0x100 | signal as u32 };
            return stored;
        }
    }
}

// The packed word itself, for the process trace's aux field only: a
// signal's end is 0x100 | signal, an exit is its code.
fn process_end_trace_aux(end: ProcessEnd) -> usize {
    let mut stored: ProcessEndWord = process_end_word(end);
    return stored.word as usize;
}

fn process_end_of_word(stored: ProcessEndWord) -> ProcessEnd {
    if ((stored.word & 0x100) != 0) {
        return ProcessEnd::Signaled((stored.word & 0x7F) as u8);
    }
    return ProcessEnd::Exited((stored.word & 0xFF) as u8);
}

// The wait4 status word: Linux's WTERMSIG form (signal in the low seven
// bits) for a killed process, WEXITSTATUS form (code << 8) for an exit.
fn syscall_wait_status_word(end: ProcessEnd) -> u32 {
    match end {
        ProcessEnd::Exited(code) => { return (code as u32) << 8; }
        ProcessEnd::Signaled(signal) => { return signal as u32; }
    }
}

// What a shell's $? shows for it: the code, or 128 + signal. Only for
// logs; wait4 reports syscall_wait_status_word.
fn syscall_status_shell_code(end: ProcessEnd) -> usize {
    match end {
        ProcessEnd::Exited(code) => { return code as usize; }
        ProcessEnd::Signaled(signal) => { return 128 + signal as usize; }
    }
}

// GitHub issue #885: the SIGCHLD siginfo's si_code and si_status for a
// recorded end, as Linux reports them: CLD_KILLED (2) with the signal for a
// killed child, CLD_EXITED (1) with the exit code otherwise. No CLD_DUMPED,
// since no core is ever written.
const SYSCALL_CLD_EXITED: u32 = 1;
const SYSCALL_CLD_KILLED: u32 = 2;

fn syscall_sigchld_code(end: ProcessEnd) -> u32 {
    match end {
        ProcessEnd::Exited(_) => { return SYSCALL_CLD_EXITED; }
        ProcessEnd::Signaled(_) => { return SYSCALL_CLD_KILLED; }
    }
}

fn syscall_sigchld_status(end: ProcessEnd) -> u32 {
    match end {
        ProcessEnd::Exited(code) => { return code as u32; }
        ProcessEnd::Signaled(signal) => { return signal as u32; }
    }
}
