// Part of #294 (consolidate kernel runtime state behind explicit owners),
// deferred out of #303/#304 on purpose (see #307): these twelve
// syscall.tkb fields are entirely test-driver-orchestrated -- every entry
// point below is called only from init/test_driver.tkb -- but unlike
// #303/#304's pure evidence counters, some of them gate real control
// flow (whether accept4() bounds the test daemon by exiting early; which
// boot-log line a real UART-block/listener-ready path prints). That is
// why this state gets its own file with real predicate/mutator functions
// instead of #303/#304's plain get/record accessors: the actual decision
// logic moves here too, so kernel/kernel/syscall.tkb's dispatch code only
// ever calls a named, self-contained function, never touches these
// fields directly.
//
// Current limitations (2026-10-30): every flag is an AtomicWord, and a
// one-shot is one swap, so two CPUs take it once (GitHub issues #598, #1012).
// Nothing orders the words against each other: the child pid is stored after
// its fork flag, so a checkpoint seeing 0 there takes it as not yet forked.

use "kernel/lib/atomic_word.tkb";

private let mut syscall_connected_fixture_pending: AtomicWord;
// Set only for the persistent terminal demo shell launched (via self-replace
// exec, see kernel/tests/ext2/init.sh's final line) after the bounded suite
// has completed. Its direct HTTPd child is a normal daemon even though that
// shell occupies PID 1, which otherwise identifies the bounded init.sh
// fixture. Named for the kernel-owned concept it gates -- persistent,
// unbounded lifecycle vs. the bounded one-shot fixture -- not the payload
// that happens to run under it.
private let mut syscall_persistent_shell: AtomicWord;
// Issue #289: lifecycle checkpoints for the persistent-shell scenario, so a
// kernelcheck-qemu/kernelcheck-rpi5 stall names the last completed boundary
// instead of a single generic timeout. `_child_pid` is the pending target
// for the one-shot "child selected" checkpoint (0 = none/consumed); the
// four checkpoint-printed booleans are one-shot guards, mirroring the
// existing `syscall_test_evidence_record_read_uart_wait()` return-true-
// once idiom (kernel/kernel/syscall_test_evidence.tkb). Each checkpoint
// is its own named function (not inlined) so a QEMU regression can skip one
// via a GDB breakpoint + `return`, without any dedicated test-only switch.
private let mut syscall_persistent_shell_child_pid: AtomicWord;
private let mut syscall_persistent_shell_checkpoint_fork_logged: AtomicWord;
private let mut syscall_persistent_shell_checkpoint_selected_logged: AtomicWord;
private let mut syscall_persistent_shell_checkpoint_exec_prepare_logged: AtomicWord;
private let mut syscall_persistent_shell_checkpoint_exec_commit_logged: AtomicWord;

// Called from kernel_syscall_process_configure() (syscall.tkb) alongside
// its other real per-boot resets.
fn syscall_test_lifecycle_persistent_shell_clear() {
    atomic_word_store(&syscall_persistent_shell, 0);
}

enum ListenerReadyLabel: u8 { ConnectedFixture; Persistent; }

// Encapsulates listen()'s "which one-shot boot-log line applies" check
// (moved from syscall.tkb's own listen() handler): checks and consumes
// whichever pending flag matches, in the same priority order the original
// inline if/else-if/else chain used.
//
// One swap since GitHub issue #1012 (the process-run lock since #598 admitted
// listen on a peer): two listens on two CPUs must not both consume the flag.
fn syscall_test_lifecycle_listener_ready_label() -> ListenerReadyLabel {
    if (atomic_word_swap(&syscall_connected_fixture_pending, 0) != 0) {
        return ListenerReadyLabel::ConnectedFixture;
    }
    return ListenerReadyLabel::Persistent;
}

// GitHub issue #836: the connected fixture's listener label ends when a
// BusyBox Extras image is exec'd, since every listener from then on is the
// init-managed httpd service. This used to ride on the exec's TCP pool
// drain (kernel_syscall_daemon_start); the drain is gone and the label
// rule stays here, beside the flag it retires. An interactive boot runs no
// fixture, so its first listen is httpd's and must read as persistent.
fn syscall_test_lifecycle_extras_exec() {
    atomic_word_store(&syscall_connected_fixture_pending, 0);
}

fn kernel_syscall_connected_fixture_start() {
    atomic_word_store(&syscall_connected_fixture_pending, 1);
}

fn kernel_syscall_persistent_shell_start() {
    atomic_word_store(&syscall_persistent_shell, 1);
    // The "shell blocked on the UART" marker is a one-shot latch, and the
    // bounded phase's own interactive ash already spent it. Re-arming it
    // here is what makes the persistent shell's block announce itself --
    // kernel_syscall_process_configure() used to do this as a side effect
    // of the parent-exec handoff, which no longer happens under an init
    // that stays PID 1.
    syscall_test_evidence_reset_read_uart_waits();
}

fn kernel_syscall_persistent_shell_active() -> bool {
    return atomic_word_load(&syscall_persistent_shell) != 0;
}

// noinline (all four checkpoints below): each is a real, addressable call
// site with a durable debugger-facing frame contract for postmortem work.
noinline fn kernel_syscall_persistent_shell_checkpoint_fork(pid: usize) {
    if (atomic_word_swap(&syscall_persistent_shell_checkpoint_fork_logged, 1) != 0) { return; }
    atomic_word_store(&syscall_persistent_shell_child_pid, pid);
    kernel_boot_log("persistent shell: fork child pid=");
    uart_put_udec(pid);
    kernel_boot_log("\n");
}

// Self-disarming: fires once, the first time the forked child (identified
// only by pid -- no generation check needed, since the pending target is
// cleared on the very first match) is dispatched into a syscall of its own,
// proving the scheduler actually resumed it rather than merely creating it.
noinline fn kernel_syscall_persistent_shell_checkpoint_selected() {
    let child_pid: usize = atomic_word_load(&syscall_persistent_shell_child_pid);
    if (child_pid == 0 ||
        atomic_word_load(&syscall_persistent_shell_checkpoint_selected_logged) != 0) {
        return;
    }
    if (kernel_process_current_pid() != child_pid) {
        return;
    }
    if (atomic_word_swap(&syscall_persistent_shell_checkpoint_selected_logged, 1) != 0) {
        return;
    }
    kernel_boot_log("persistent shell: child selected pid=");
    uart_put_udec(child_pid);
    kernel_boot_log("\n");
}

// Both exec checkpoints below are scoped to the one tracked target pid (set
// by the fork checkpoint above), not merely to the persistent-shell scenario
// being active -- the interactive ash's own launch (PID 1 forking+execing
// it) and any later applet it runs would otherwise also match, well before
// or after the boundary this checkpoint actually means.
noinline fn kernel_syscall_persistent_shell_checkpoint_exec_prepare(pid: usize) {
    if (pid != atomic_word_load(&syscall_persistent_shell_child_pid) ||
        atomic_word_swap(&syscall_persistent_shell_checkpoint_exec_prepare_logged, 1) != 0) {
        return;
    }
    kernel_boot_log("persistent shell: exec prepare pid=");
    uart_put_udec(pid);
    kernel_boot_log("\n");
}

noinline fn kernel_syscall_persistent_shell_checkpoint_exec_commit(pid: usize) {
    if (pid != atomic_word_load(&syscall_persistent_shell_child_pid) ||
        atomic_word_swap(&syscall_persistent_shell_checkpoint_exec_commit_logged, 1) != 0) {
        return;
    }
    kernel_boot_log("persistent shell: exec commit pid=");
    uart_put_udec(pid);
    kernel_boot_log("\n");
}
