// GitHub issue #704: the current CPU's authority, and the one file that
// mints it. CpuHere's index is private, so a CpuHere exists only as this
// file hands it out, and the compiler lets a per-CPU store
// (`struct per_cpu`) be indexed only by one: `store[cpu]`. It is never
// stored -- not in a global, a field or a place.
//
// GitHub issue #638: a CpuHere is minted only by a preemption-disabled
// region, `preempt_off (cpu) { ... }`, which the compiler lowers to a call
// of the private preempt_off_enter below. The compiler keeps the CpuHere
// inside the block (no function outside this file returns one) and rejects
// a block that can reach may_block. A span the block cannot express holds the
// same count through the linear PreemptOff below (#638 option A).
//
// Stage 2 (#638, maintainer 2026-10-25): the region is a preempt count, as
// Linux's preempt_disable/preempt_enable. preempt_off_enter raises it and
// preempt_off_exit lowers it; the compiler calls preempt_off_exit at the
// closing brace and before every return, break or continue that leaves the
// block, so regions nest. Independent of the IRQ mask.
//
// Slice 2 of the per-task count (maintainer, 2026-11-04, #638 (b)): the count
// is the stack's, not the CPU's. It is the 16-byte word at the top of the
// stack's run (KERNEL_STACK_TOP_RESERVE, scripts/check_kernel_stack_top_reserve.py),
// which the assembly leaf preempt_count_add reaches from SP alone. A raise is
// a read-modify-write of a word only the task standing on that stack writes,
// so a move to another CPU between the read and the store changes nothing;
// the CPU-indexed slot it replaces could be raised on the CPU the task had
// just left (seen on QEMU and RPi5, the #638 stage 8 investigation). The
// CpuHere is minted after the raise, so the CPU it names stays the CPU until
// the region ends.
//
// The region helpers are inline: they run three levels deep on every mask and
// unmask, so as out-of-line calls they cost 21 ns of a lock pair (GitHub issue
// #1288, measured on RPi5). The count's leaf is one call, as TPIDR_EL1's was.
//
// Trusted here, and only here:
// - preempt_off_enter reads cpu_id() (MPIDR) after the raise and is the CPU
//   it says;
// - every stack's preempt word is the last 16 bytes of its 0x8000-aligned
//   run and starts at zero (the entry code and the process stack fill zero
//   it), so preempt_count_add names this stack's count;
// - TPIDR_EL1 is this core's index times the per-core stack group stride
//   (each core's entry path sets it once, before any Takibi code runs; the
//   linker scripts assert the stride is 1 << PERCPU_STACK_GROUP_SHIFT). It is
//   read by the assembly helper kernel_cpu_offset (user_entry.S; no compiler
//   builtin, DECISIONS 2026-10-25), and preempt_slot_index() is its one
//   caller (scripts/buildcheck_allowed_callers.py). With
//   KERNEL_PREEMPT_ASSERTS, every region entry checks it agrees with MPIDR.
//   No public function mints one (scripts/check_cpu_authority_mints.py);
//   the boot probe's any-CPU mint went with the exec argv slot (#1080).
//
// Current limitations (2026-11-06):
// - KERNEL_PREEMPTIBLE is 0. The EL1 IRQ return consults the count
//   (preempt_count_zero_at, on the interrupted frame's stack) only inside the
//   window of kernel/kernel/el1_preempt_scenario.tkb (#638 stage 8); outside
//   it no EL1 frame is switched away.
// - preempt_count_after_switch resets the stack it lands on and asserts
//   nothing: a stack keeps the count it had when it was left, so the check
//   that at most one span reached a resume no longer reads the right word.
//   An El1 resume checks its own stack's count is zero first
//   (preempt_count_el1_resume_check).

use "kernel/lib/execution_model.tkb";
use "kernel/arch/arm64/kernel/cpu_stop_extern.tkb";

struct cpu_authority CpuHere {
    private id: {0..<KERNEL_MAX_CORES as usize};
}

// The runtime checks of the preempt count: that every region entry finds
// TPIDR_EL1 naming the CPU cpu_id() names, that no exit lowers a count of
// zero, and that a blocking point is reached at count zero. The compiler
// already rejects a region that can reach may_block; the last check is
// the runtime witness of that rule (maintainer, 2026-10-25). The kernel has
// no separate release build, so the checks are on in every image.
const KERNEL_PREEMPT_ASSERTS: usize = 1;

// log2 of the per-core stack group stride that TPIDR_EL1 is a multiple of
// (see link.ld and link_qemu.ld, which assert it).
const PERCPU_STACK_GROUP_SHIFT: usize = 16;

// TPIDR_EL1's slot number, unchecked: the one read of kernel_cpu_offset
// (scripts/allowed_callers.tsv).
private inline fn preempt_slot_index() -> usize {
    return kernel_cpu_offset() >> PERCPU_STACK_GROUP_SHIFT;
}

private inline fn preempt_off_enter() -> CpuHere {
    preempt_count_add(1);
    let core: usize = cpu_id();
    if (core < KERNEL_MAX_CORES) {
        if (KERNEL_PREEMPT_ASSERTS != 0 && preempt_slot_index() != core) {
            // TPIDR_EL1 names another CPU than MPIDR does.
            kernel_invariant_stop();
        }
        let id: {0..<KERNEL_MAX_CORES as usize} = core;
        let mut cpu: CpuHere = { id };
        return cpu;
    }
    // An inactive CPU must not run a kernel action.
    kernel_invariant_stop();
    let mut unreachable: CpuHere = { 0 };
    return unreachable;
}

// GitHub issue #638 stage 4 (maintainer, D2 (i)): the test of a fallible
// `preempt_off (cpu) { ... } else { ... }`. True exactly when the CPU MPIDR
// names is one this kernel runs, so the region's mint cannot reach its
// inactive-CPU stop from here; false sends the caller to its else arm with no
// authority. The IRQ mask needs this: the stop path masks IRQs, so a mask that
// stopped would re-enter itself. TPIDR_EL1 is not compared here: read before
// the raise, a move between the two reads would answer false for a CPU that
// is fine.
private inline fn preempt_off_available() -> bool {
    return cpu_id() < KERNEL_MAX_CORES;
}

// Called by the compiler at every exit of a preempt_off block.
private inline fn preempt_off_exit() {
    if (preempt_count_add(0xFFFFFFFFFFFFFFFF) == 0) {
        // An exit with no open region: the count wrapped.
        kernel_invariant_stop();
    }
}

// GitHub issue #1350: a short-hold unmasked lock (the rank-39 pools and the
// object refcount) holds the count from before its acquire to after its
// release, Linux's spin_lock shape, so its holder is never switched off a core
// where a span's waiter could spin for it. Every such lock goes through this
// pair (scripts/check_lock_rank_wrappers.py). Not a region: no authority is
// minted.
inline fn preempt_lock_raise() {
    preempt_count_add(1);
}

inline fn preempt_lock_lower() {
    preempt_off_exit();
}

// GitHub issue #638 stage 7 (maintainer, 2026-11-01, #1323 option A): a span
// that cannot be a lexical preempt_off block, because it ends at an exception
// return in another function. It holds the same count. The token is linear, so
// a path that neither ends the span nor hands it to a resume does not compile.
// A span may not reach a blocking point: preempt_assert_blockable says so at
// run time; the static rule the block has is not extended to the token.
// Spelling is provisional (DECISIONS.md 2026-11-01).
linear struct PreemptOff[unit: usize] {
    private held: usize;
}

inline fn preempt_span_begin() -> PreemptOff[0] {
    preempt_count_add(1);
    let mut span: PreemptOff[0] = { 1 };
    return span;
}

// The span ended here: nothing was switched.
inline fn preempt_span_end(span: sink PreemptOff[0]) {
    preempt_off_exit();
}

// The span ends at the exception return (or idle entry) that follows. The
// count stays raised on the stack the span began on; the stack the return
// lands on has its own reset by preempt_count_after_switch. The callers are
// the resume paths (scripts/allowed_callers.tsv).
inline fn preempt_span_resume(span: sink PreemptOff[0]) {
}

// The Takibi function an assembly hop of the syscall action table branches to
// (SyscallAction::CloneChild) takes the span back: a value crossing assembly
// loses its type (DECISIONS 2026-10-25), so the count stood in for the token.
// Trusted: the hop always arrives here; it stops when no span is open.
inline fn preempt_span_adopt() -> PreemptOff[0] {
    if (KERNEL_PREEMPT_ASSERTS != 0 && preempt_count_here() != 1) {
        kernel_invariant_stop();
    }
    let mut span: PreemptOff[0] = { 1 };
    return span;
}

// The Linux schedule_tail shape: the after_switch hook of every exception
// return, and every idle entry, on the far side of the stack change. What it
// resumes runs at count zero by construction (only a zero count is ever
// switched away from), so the count of the stack it now stands on is reset:
// that stack kept whatever count it had when it was left, a span's included.
fn preempt_count_after_switch() {
    preempt_count_reset();
}

// GitHub issue #638 slice 3: the check an El1 resume makes before
// preempt_count_after_switch resets its stack's count. A frame is switched
// away from only at count zero and its stack keeps that count while it is
// away, so a resume that finds anything else resumes a raise that leaked.
fn preempt_count_el1_resume_check() {
    if (KERNEL_PREEMPT_ASSERTS != 0 && preempt_count_here() != 0) {
        kernel_invariant_stop();
    }
}

// This stack's preempt count.
private fn preempt_count_here() -> usize {
    return preempt_count_add(0);
}

// GitHub issue #638 stage 8: the IRQ-return consult. A tick may switch away
// from the frame it interrupted only when the stack that frame stands on has
// no region and no span open. Masked, in the handler, so the answer cannot
// move under it.
fn preempt_count_zero_at(frame_sp: usize) -> bool !{interrupt} {
    return preempt_count_at(frame_sp) == 0;
}

// A blocking point's runtime check: nothing may block inside a region.
// Called first by every function the kernel declares the leaves of
// may_block (the interrupt wait and the slot-pool acquires).
fn preempt_assert_blockable() {
    if (KERNEL_PREEMPT_ASSERTS != 0 && preempt_count_here() != 0) {
        kernel_invariant_stop();
    }
}

