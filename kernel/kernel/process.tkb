use "kernel/lib/atomic_word.tkb";
use "kernel/mm/page.tkb";
use "kernel/lib/diagnostic_ring.tkb";
use "kernel/lib/slotmap.tkb";
use "kernel/lib/freelist.tkb";
use "kernel/lib/pool_lock.tkb";
use "kernel/kernel/process_test_evidence.tkb";
use "kernel/kernel/process_wait.tkb";
use "kernel/kernel/protocol_trace.tkb";
// A process slot remains the temporary address-space key, but process.tkb
// owns no table details. scheduled_process_alloc/reap are the lifecycle
// choke points for kernel/mm/address_space.tkb's backing-page and ASID
// records; mmu.tkb itself sees only resolved physical addresses and ASIDs.
use "kernel/mm/address_space.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/lib/mutex.tkb";
use "kernel/lib/locked_cell.tkb";

// Current limitations (2026-08-13, issue #295). Keep this list current as
// call sites change; a limitation that goes stale here is worse than
// none.
// - Peer process dispatch stays closed while the boot driver's destructive
//   scheduler probes reset the shared process table. The peer still starts,
//   runs its contention probes, and handles its timer; the gate opens once
//   PID 1's image is ready to enter userspace. From there, an unset affinity
//   mask admits every online core.
// - PARTLY SYNCHRONIZED as of GitHub issue #479. The pid counter is minted
//   inside a LockedCell whose guard is the only way to reach the count
//   (issue #452), and execution_state is per-core,
//   indexed by cpu_id(). Parent/sibling walks and all Ready/Running/Blocked
//   transitions take the run lock, including the static bootstrap record;
//   the crash trace uses per-core storage and an atomic global sequence.
//   What remains unsynchronized is named by this file's
//   process_execution_model_assumption: one core cannot preempt a lifecycle
//   operation with another process's operation on that same core.
// - scheduled_process_spare_lock takes a real lock as of issue #451. It
//   returns a linear STRUCT carrying the interrupt state its release
//   restores, where it used to return an erased `linear view` that emitted
//   nothing -- a compile-time proof that no second holder exists in the
//   program, which is a stronger statement than a spinlock makes and a
//   strictly weaker one at runtime. Both hold now. The four other guards
//   in this kernel moved in the same change.
// - No fixed process-table capacity: a ProcessRecord is an
//   IntrusivePool allocation, so the page allocator is the only limit
//   (issue #392). The bootstrap is the exception and is a static record
//   named by slot value 0, because root 0 exists before the MMU is on.
//   Nothing on the creation path has a fixed ceiling any more: the ASID
//   was the last one, and issue #402 replaced it with a generation that
//   rolls over (kernel/arch/arm64/mm/asid.tkb) rather than a number that
//   runs out.
//   A kernel stack run is recycled through a one-deep spare rather than
//   freed at reap, because a reap usually runs ON the stack it is
//   reaping. See `kernel/RESOURCE_LIMITS.md` for the full
//   exhaustion-result/boundary-test contract for every backing resource
//   scheduled_process_alloc() touches.
// - A pid is minted monotonically per run of the process table and is
//   never recycled within one run, so a pid found in a record does not
//   mean that process is still live -- scheduled_process_slot_for_pid
//   answers "which slot last held this pid", which is what the exec-reap
//   path needs and is all it promises. That lookup is a linear scan of
//   the table; the slot -> pid direction is a field read.
// - A process may have as many children as the page allocator allows
//   (issue #437). An exited child stays as a ZOMBIE holding its own
//   exit_status until wait4 collects it, so a record outlives the process
//   it described; wait4(pid) selects among siblings, and wait4(-1) takes
//   the newest zombie rather than the earliest -- Linux promises "some
//   terminated child" and not an order. What is NOT here: a parent that
//   never waits keeps its zombies until it exits (its own exit drains
//   them), which is Linux's behaviour and is a real way to hold slots.
//
// GitHub issue #614: Startable and Reapable are Ready and Exited with the
// proof StackOwnership.tla's StartsOnFreeStack asks for -- no other core
// stands on the process's kernel stack. Only the functions named in
// "Where a stack is proved free" below mint them, and only
// scheduled_process_start and scheduled_process_reap take them, so a path
// that starts or reaps without asking does not compile.
enum ProcessState: u8 { Ready; Startable; Running; Blocked; Exited; Reapable;
                        Constructing; }
// GitHub issue #244: ChildExit lets wait4() actually block a parent whose
// child hasn't exited yet, instead of returning -ECHILD immediately (safe
// only when the scheduler never ran the parent before the child's own
// exit switched back to it -- no longer true once the scheduler is
// enabled across a fork, since a timer IRQ can preempt the child and
// hand control to the parent early).
// GitHub issue #469: NetRx is a process waiting for a frame to arrive.
// It exists because the alternative was waiting for one INSIDE the kernel,
// which stops every other process for the duration -- kernel mode does not
// preempt. Added at the end so the numbers the oops path prints for the
// first three are unchanged.
// GitHub issue #392: declared here, with the rest of a process's
// lifecycle state, rather than in kernel/kernel/syscall.tkb where the
// logic that uses them lives. They were `[T; KERNEL_PROCESS_MAX]` arrays
// keyed by process slot -- the last two of those outside this file -- and
// a field of ProcessRecord cannot name a type declared in a file parsed
// after this one. The concepts already belonged next to
// ProcessWaitReason: UartBlockDelivery is the delivery half of
// ProcessWaitReason::UartRx (how the blocked read is resumed once the
// byte arrives: Read reruns the terminal read(2) or ppoll(2) that blocked,
// Scalar hands the byte to the Takibi wait), and CloneFileState is fork
// bookkeeping for one child.
enum UartBlockDelivery: u8 { Scalar; Read; }

// GitHub issue #264 fifth stage: nested clones need separate bookkeeping
// for each child. One record holds the values for one child; the exit
// handler reaps that child before switching execution to its parent.
struct CloneFileState {
    file_state_live: bool;
}

// GitHub issue #392: KERNEL_PROCESS_MAX is GONE. It was 16 -- "a generous
// compile-time ceiling, not a razor-thin one bumped by hand each time a
// workload needs one more" (issue #246, after issue #245 bumped it from 2
// to 3) -- and it was the array size of the process table, the bound on
// the fd context table, the image record table, the address-space backing
// table, and the ASID pool, all at once. Four of those became pools in
// their own right in earlier stages of this issue; this is the fifth and
// last, and with it there is no number anywhere in this kernel that says
// how many processes there may be. What bounds them is the page allocator.
// GitHub issue #377: four pages. Linux arm64's THREAD_SIZE is 16K and
// FreeBSD's kern.kstack_pages defaults to four, and this stack carries
// two worst cases at once because interrupts still run on it.
//
// NOT derived from issue #376's measurement. That measurement came back
// SATURATED on both QEMU and RPi5 -- every byte of the old 3968 was
// consumed -- and a saturated watermark is a FLOOR, not a requirement:
// once the poison runs out there is nothing left to measure with. So the
// size is generous first and re-measured after, which is only possible
// because there is now room for the measurement to land inside.
const KERNEL_STACK_PAGES: usize = 4;
const KERNEL_PROCESS_STACK_SIZE: usize = KERNEL_STACK_PAGES * PAGE_SIZE;

// ...and the page RUN behind each stack is twice that, with the stack in
// its UPPER half. Two properties fall out of one allocation:
//
// - Containment. The lower half belongs to the same run, so the
//   allocator never hands it to anyone else. A stack that runs past its
//   end writes into 16384 bytes that are nobody's -- which is precisely
//   what issue #373 did not have, when it wrote into a process's text
//   and the process executed kernel frames.
// - Detection, in one bit. page_alloc_contiguous aligns a power-of-two
//   run to its own size, so bit 14 of an address is 1 everywhere in the
//   upper half and 0 everywhere in the lower half. That single bit is
//   Linux arm64's kernel-stack overflow test
//   (https://lkml.iu.edu/hypermail/linux/kernel/1708.0/05410.html), and
//   it needs no per-stack base to compare against.
//
// Linux puts the stack in the LOWER half and relies on an unmapped guard
// page below it. There is no unmapped page to be had here -- this
// kernel's identity map is block-mapped, so punching a 4K hole means
// splitting a 2 MB block -- so the halves are swapped: the same one bit
// answers, and an overflow is CONTAINED rather than trapped.
const KERNEL_STACK_RUN_PAGES: usize = KERNEL_STACK_PAGES * 2;
const KERNEL_STACK_RUN_BYTES: usize = KERNEL_STACK_RUN_PAGES * PAGE_SIZE;

// WHICH bit, for the generated exception-entry check. log2 of
// KERNEL_PROCESS_STACK_SIZE, written as a bare literal because an
// `exception_entry` declaration can only name a compile-time integer
// constant -- and named there rather than written into the compiler,
// because it is a fact about this kernel's stacks, not about AArch64.
// scheduled_process_table_init checks it against the size it claims to be
// the log of.
const KERNEL_STACK_SHIFT: usize = 14;
// No hardware CPU has this identity. A Ready process carrying any smaller
// value still has an old CPU physically using its saved-frame stack and is
// not selectable, even though its logical state is already public.
const PROCESS_STACK_UNOWNED: usize = KERNEL_MAX_CORES;

// A failed stop only cancels this scheduling attempt; the next tick retries.
// The bound is deliberately the same as the maintained stop probes, while
// remaining owned by the scheduler rather than by profiling evidence.
const SCHEDULER_WORLD_STOP_SPINS: usize = 10000000;

// Issue #188 Stage 2: the stable store holds one generation-indexed process
// identity. A separate linear state token carries Ready/Running/Exited, so
// adding a later Blocked state does not require another copy of the stable
// store algorithm. The reusable table slot is never the static identity.
// GitHub issue #392: pool_index is a pool SLOT ADDRESS now (or 0, the
// bootstrap), not an index, so there is no array bound left to refine it
// against. What the refinement proved -- that the value named a real
// array element -- is proved by intrusive_pool_probe_slot on every use
// instead, and strictly more of it: a refinement could not tell a live
// process from a recycled slot, which was always the generation's job.
// The name is kept because it is what a hundred call sites spell.
linear struct ScheduledProcessOwner[process: usize] {
    private pool_index: usize;
    private generation: usize @ process;
}

linear struct ScheduledProcessState[process: usize, state: ProcessState] {
    private pool_index: usize;
}

struct ProcessHandle {
    private pool_index: usize;
    private generation: usize;
}

private fn process_handle_new(slot: usize, generation: usize)
        -> ProcessHandle {
    let mut handle: ProcessHandle = { slot, generation };
    return handle;
}

// A live token says that this CPU is still executing the Running process
// whose generation supplies `process`. Handles derived through the accessor
// below remain valid across calls that may reap some other process. The exit
// path consumes the token before its own process becomes Exited.
private linear view CurrentProcess[process: usize];

private fn current_process_new(
        generation: usize @ process) -> CurrentProcess[process] {
    return view CurrentProcess[process];
}

private fn current_process_handle(
        current: borrow CurrentProcess[process]) -> ProcessHandle
        !{handle_of_witness} {
    return execution_here().current_handle;
}

private fn current_process_exit(
        current: sink CurrentProcess[process]) {}

// GitHub issue #264 first stage: keep the scheduler/lifecycle bookkeeping
// for one process slot together. This is deliberately a plain data struct:
// the linear ScheduledProcessOwner/state protocol, stable store, SlotMap,
// and growable kernel-stack pool remain separate and unchanged in this
// behavior-preserving consolidation stage.
struct ProcessRecord {
    // GitHub issue #392: the pid this process reports to userspace, and
    // the ONLY place it is written. It used to be computed as
    // `pool_index + 1` at some twenty sites, which made the pid a second
    // reading of the slot index rather than a number of its own -- and a
    // slot index is exactly what the remaining stage of this issue stops
    // being a small integer. A pid derived from a pool address would be
    // an address: visible to userspace through getpid()/wait4(), printed
    // into every oops line, and expected to be 1 for the bootstrap
    // process by the oops lane's own pattern.
    //
    // Allocated monotonically from scheduled_process_pid_cell, so a
    // reused slot does NOT reuse its pid. That is a deliberate behaviour
    // change and the Unix one: `pid - 1` was a valid way to find a
    // process only while a pid named a table row.
    pid: usize;
    start_time_ticks: usize;
    // With no setpgid API, each session has exactly one process group.
    // Both IDs are inherited by fork and preserved by exec. Zero is the
    // bootstrap group before PID 1 creates its userspace session.
    session_id: usize;
    // Bounded kernel-owned diagnostic copy. procfs must never retain or
    // revisit userspace argv pointers while a process can exit or replace
    // its address space underneath the read.
    command_line: [u8; 512];
    command_line_length: usize;
    saved_sp: usize;
    // Physical SP_EL1 ownership, separate from logical Ready/Running state.
    // The run lock serializes every transition. PROCESS_STACK_UNOWNED is the
    // only value from which another CPU may acquire this stack.
    stack_owner_cpu: usize;
    state: ProcessSlotState;
    // What this process is blocked on, and the child that woke a wait4 that
    // is still pending. Private to process_wait.tkb, which is the only
    // place either changes (GitHub issue #653).
    wait: ProcessWaitCell;
    // What the process running a syscall has decided to block on, read back
    // by the block that follows. Separate from `wait` so a decision that is
    // abandoned leaves nothing behind for a scheduler to trust (#603).
    pending_block_reason: ProcessWaitReason;
    // Absolute generic-counter deadline for nanosleep/clock_nanosleep and
    // finite ppoll. Meaningful only while the published wait is Deadline.
    deadline_ticks: usize;
    // Linux signal sets use bit (signum - 1). Pending state and the set a
    // blocked rt_sigtimedwait accepts belong to the process whose frame is
    // parked, not to the syscall dispatcher globally.
    signal_mask: usize;
    pending_signals: usize;
    sigwait_set: usize;
    // Linux gives SIGCHLD=SIG_IGN special process-lifecycle semantics:
    // children are discarded after exit instead of becoming waitable zombies.
    sigchld_ignored: bool;
    // GitHub issue #627: the one asynchronous handler this kernel delivers,
    // SIGCHLD's, as rt_sigaction installed it. handler 0 is SIG_DFL and 1
    // SIG_IGN (sigchld_ignored above carries that one's lifecycle meaning);
    // anything larger is an EL0 entry point, reached at a syscall return.
    sigchld_handler: usize;
    sigchld_flags: usize;
    sigchld_restorer: usize;
    sigchld_action_mask: usize;
    // rt_sigsuspend's mask swap, as Linux's saved_sigmask: the mask the
    // caller had, put back into the signal frame (and so restored by
    // rt_sigreturn) or restored directly when nothing is delivered.
    sigsuspend_saved_mask: usize;
    sigsuspend_mask_saved: bool;
    // A Signal-blocked waiter that is rt_sigsuspend rather than
    // rt_sigtimedwait: its frame is rewound, and a wake leaves the signal
    // pending for the rerun to deliver instead of consuming it.
    sigwait_suspend: bool;
    deadline_result: usize;
    // GitHub issue #302: wait4()'s status pointer, owned per-slot so a
    // multi-level concurrent wait4() chain delivers each blocked parent's
    // OWN status pointer instead of a value shared across every blocked
    // parent (the same bug class issue #248 fixed for reaped_pid/
    // parent_slot -- see kernel_syscall_wait4_deliver's header comment).
    wait4_status_ptr: usize;
    // GitHub issue #550: the pid wait4 is waiting for, as the syscall
    // received it (all ones for "any child"). The Blocked publication
    // re-checks THAT child: "is any child a zombie" would spin a wait4(X)
    // beside an uncollected sibling Y.
    wait4_pid: usize;
    parent: ProcessHandle;
    has_parent: bool;
    // GitHub issue #437: FIRST child, and the sibling link beside it.
    //
    // This was `child`, one slot, and the name was accurate: a process
    // could have one. That is the ceiling on any workload that wants two
    // things running, and `/etc/inittab` with two `respawn` entries is the
    // shape that makes it visible.
    //
    // First-child/next-sibling rather than a second pool: a tree costs one
    // link field per process, and the scheduler's walk over it reduces to
    // exactly today's "child, else up to the root" when no process has a
    // sibling -- which is why this change can be made without moving any
    // existing behaviour.
    first_child: ProcessHandle;
    has_first_child: bool;
    next_sibling: ProcessHandle;
    has_next_sibling: bool;
    // GitHub issue #437: the pid this process most recently REAPED, which
    // is genuinely about the reaper and stays here. What left is
    // child_exit_status/child_waitable: they described "the" child, and
    // there is no longer one. Written only by the reaper itself (#653: a
    // child's exit used to write it too, from another CPU).
    last_reaped_pid: usize;
    // The status this process exited with, on the process that exited.
    // It lives here because the record now survives the exit -- see
    // kernel_process_child_exit. Meaningful only while state is Exited.
    exit_status: usize;
    exec_image_live: bool;
    // GitHub issue #392: kernel/kernel/syscall.tkb's own per-process
    // state, which had nowhere to live but an array keyed by this
    // record's slot. It is reached through the accessors below; that file
    // still owns every decision made with it.
    uart_block_delivery: UartBlockDelivery;
    clone_file_state: CloneFileState;
    // Syscall policy belonging to this process. These used to be machine
    // globals in syscall.tkb, with clone saving the parent's inetd flag and
    // child exit restoring it. Keeping the value on each record makes that
    // save/restore unnecessary and preserves it across future core migration.
    inetd_mode: bool;
    init_signal_wait_logged: bool;
    // GitHub issue #9: sched_setaffinity's mask, one bit per CPU. 0 means
    // the process never set one, which is every online CPU.
    affinity_mask: usize;
    // GitHub issue #9: the migration gate sent this process's current
    // syscall to core 0. It stays off every peer until that call completes.
    core0_for_call: bool;
    // GitHub issue #392 stage 1: the run backing this slot's kernel
    // stack, as its base physical address (0 = never backed). It was a
    // parallel [usize; KERNEL_PROCESS_MAX] beside this array, indexed in
    // lockstep -- the shape issue #264 consolidated the rest of this
    // file's per-process state out of, and which a new field walked
    // straight back into.
    //
    // Being a field rather than a parallel array is also what lets the
    // whole record eventually be pooled: an array keyed by slot cannot
    // outlive the slot, and the slot is the ceiling this is on the way to
    // removing.
    stack_run: usize;
    // GitHub issue #392: this process's fd context, as the pooled slot
    // address and the occupant generation that says the slot is still
    // ours. 0 means none yet.
    //
    // A nominal slot address plus the generation rather than the record type:
    // kernel/kernel/fd_table.tkb is parsed AFTER this file, so its struct
    // is not nameable here -- but a function is (functions resolve
    // globally regardless of file order), which is how this file can
    // ensure and release a context it cannot describe.
    // The fd context's pool address (0: none) and generation (#672).
    fd_context: usize;
    fd_context_generation: usize;
    // GitHub issue #392: and this process's image record, by the same
    // rule and for the same reason -- kernel/mm/process_image.tkb is
    // parsed after this file, so its struct is not nameable here.
    // The image record's pool address (0: none) and generation (#672).
    image_record: usize;
    image_record_generation: usize;
    // GitHub issue #392: and this process's address-space backing. Unlike
    // the two above, kernel/mm/address_space.tkb is parsed BEFORE this
    // file, so AddressSpaceBacking IS nameable here -- but it is still a
    // handle rather than an embedded field, because taking the address of
    // a field of an array element is not expressible (issue #385) and
    // that file needs a pointer to work through.
    // The backing's pool address (0: none) and generation (#672).
    address_space_backing: usize;
    address_space_backing_generation: usize;
}

// GitHub issue #392: THE PARKING LOT IS GONE, as issue #257's went.
//
// `scheduled_process_store` was a [ScheduledProcessStore;
// KERNEL_PROCESS_MAX] of { mutex, ScheduledProcessValue } -- somewhere for
// the linear ScheduledProcessOwner to live between syscalls, since a
// syscall returns to userspace and cannot hold one. The take pulled the
// owner out of a stable slot, the put shoved it back, and
// ScheduledProcessPutResult::Conflict described "that slot already had
// one", which the stable_replace / displaced / Occupied(incoming) dance
// existed to handle.
//
// There is nowhere to park now and nothing to conflict with: the SlotMap
// below is the record of who is live, a ProcessHandle is the (slot,
// generation) pair every caller already carries, and an owner is MINTED
// from that pair on demand and discharged when the operation ends. So a
// take is a validation, a put is a drop, Conflict is unreachable, and
// ScheduledProcessValue, ScheduledProcessStore, ScheduledProcessGuard,
// scheduled_process_lock/_unlock and ScheduledProcessPutResult are deleted
// rather than ported.
//
// This is deliberately separate from swapping the storage underneath: it
// removes an array whose key is the process slot without touching what a
// slot IS.

// Slot allocation is O(1) via kernel/lib/slotmap.tkb's SlotMap(N) (issue
// #207) instead of a hand-rolled used[]/generation[] linear scan.
// slotmap_matches() also covers what the used[]+generation[] pair served
// as, and is now the whole of it: revalidating a plain ProcessHandle
// (index, generation) against the current occupant. Every owner this file
// hands out is minted after that check and discharged before the
// operation returns.
private let mut scheduled_process_pool: IntrusivePool(ProcessRecord);
private let mut scheduled_process_pool_ready: bool = false;

// The bootstrap process's record, and the reason slot value 0 still means
// something after every other slot became a pool address.
//
// A pool address is never 0, so the two namespaces are disjoint and `slot
// == 0` keeps its meaning at the dozen call sites that already spell the
// bootstrap that way. It has to: kernel/mm/address_space.tkb creates root
// 0 from kernel_mmu_init, which runs with the MMU OFF, before anything may
// allocate -- so the bootstrap's identity must exist before the pool does.
// That file already keeps root 0's backing in a plain static for exactly
// this reason; this is the same fact one layer up.
private let mut scheduled_process_boot_record: ProcessRecord;
private let mut scheduled_process_boot_live: bool = false;
private let mut scheduled_process_boot_generation: usize = 0;
// Boot-time process probes reset the shared table while CPU 1 is already in
// its idle loop. Keep that loop from starting an EL0 context until the
// initial userspace image is ready; after the one-way publication, normal
// affinity policy applies to every pooled process.
private let mut scheduled_process_peer_dispatch_enabled: bool = false;

// Reached only when a slot address names no live record. A real struct
// rather than a null pointer so the impossible case is harmless instead of
// undefined, and COUNTED so it cannot be silent -- the shape
// kernel/mm/process_image.tkb's own fallback established, where an
// uncounted one would have absorbed 1648 accesses on one boot.
private let mut scheduled_process_record_absent: ProcessRecord;
private let mut scheduled_process_record_missing_count: usize = 0;
// GitHub issue #488: how many times a reap took the record that
// execution_here() still calls current, with current_live still true.
//
// It must be zero. When it is not, every later read through
// execution_here().current_handle lands on a slot the pool no longer
// recognises -- or, worse and more usually, on whatever record has since
// been allocated at that address, so the kernel operates on the WRONG
// process in silence. The boot suite reported it as `records MISSING`
// only because an unrelated probe had shifted the pool layout enough to
// stop the address being recycled.
//
// The fault was measured at 26 reaps per boot before issue #488 moved the
// blocked-parent handoff ahead of wait4 delivery. Keep the counter: its
// conditional report is captured by the process-lifecycle view, whose
// expected output asserts that no reap takes the current record.
private let mut scheduled_process_reaped_current_count: usize = 0;
// GitHub issue #492: reads through a handle whose generation no longer
// matches the slot's occupant. Must be zero; see
// scheduled_process_record_of.
private let mut scheduled_process_stale_handle_reads: usize = 0;
private let mut scheduled_process_stale_first_slot: usize = 0;
private let mut scheduled_process_stale_first_generation: usize = 0;

// The kernel stack run of a reaped process, held until something can
// safely take it.
//
// MEASURED, not assumed: 18 of the 35 reaps in one QEMU boot run ON the
// stack they are reaping -- an exiting process is still standing on its
// own kernel stack when kernel_process_child_exit reaps it. Handing those
// pages back to the allocator there gives away the memory under the
// caller's own feet. So a run is parked here instead, taken by the next
// process that needs one, and given back only from a context that has
// checked it is not standing on it.
//
// One deep, which is enough to bound it: parking a second run gives the
// first one back. The array this replaces never gave a run back at all --
// it kept one per slot forever, which is a leak only because the number of
// slots stopped being 16.
//
// So ONE run can be held with no live process owning it, including at the
// end of the boot suite -- measured, it is. kernel/init/test_driver.tkb's
// `resources: pages=0` still means what it says because that is a constant
// eight pages on both sides of its comparison, not because nothing is
// held; its own comment says so where the baseline is taken.
variant SpareStackRunValue {
    Empty;
    Held(exists run: usize. PageRunOwner[run]);
}

struct SpareStackRunCell {
    private mutex: Mutex;
    private value: SpareStackRunValue;
}

private let mut scheduled_process_spare: SpareStackRunCell;
// GitHub issue #451: a linear STRUCT, not an erased view any more.
// A view emits nothing, so it could not carry the interrupt state a
// release must restore -- and it did not need to while the lock itself
// emitted nothing either. Now that mutex_acquire really masks and really
// takes, `flags` is the frame slot Linux's own `unsigned long flags`
// occupies, and holding it per-guard is what makes the pair correct
// inside an interrupt handler (DAIF.I already set on entry, so release
// leaves it set) and correct when two nest. Identity is unchanged:
// `[lock: addr]` still makes another container's guard a compile error.
private linear struct SpareStackRunGuard[lock: addr] {
    private flags: usize;
}

private fn scheduled_process_spare_lock(lock: *Mutex @ address)
        -> SpareStackRunGuard[address]
        !{acquires_lock_40_spare_stack, lock_guard_40_spare_stack} {
    let mut guard: SpareStackRunGuard[address] = { mutex_acquire(lock) };
    return guard;
}

private fn scheduled_process_spare_unlock(
        guard: sink SpareStackRunGuard[address], lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

// The deepest a REAPED process's kernel stack ever got. The array this
// replaces kept every slot's run for the life of the kernel, so the
// end-of-boot watermark could still read the poison of a process that had
// long exited; a pooled record's run is recycled, so the measurement has
// to be taken while it still exists. Issues #376/#377 are about this
// number specifically, so losing it to the storage change would be losing
// the thing the storage change is measured against.
private let mut scheduled_process_stack_deepest_reaped: usize = 0;
// GitHub issue #392: the pid namespace, monotonic within one run of the
// process table. Reset by scheduled_process_table_init/_clear -- the two
// points that already restart slot numbering -- so the bootstrap process
// created right after a reset is pid 1, which the oops lane matches
// literally. Nothing recycles a pid inside one run: that is what makes it
// independent of the slot it happens to occupy.
//
// GitHub issue #452: the counter and its lock are ONE value. #479 gave the
// counter a lock and a comment saying the lock covered it; the compiler
// could not read the comment, so a new read anywhere in this file -- the
// kernel's largest -- would have compiled. The count is a private field of
// LockedCell, so the guard is the only way in.
//
// HOW MANY pids have been minted, not WHICH pid is next: a LockedCell
// carries no initialiser (its field belongs to another file), and this way
// it needs none, because .bss zero is already the right starting count and
// a pid is count + 1. So the bootstrap process is still pid 1 and the oops
// lane still matches it literally.
private let mut scheduled_process_pid_cell: LockedCell(usize);

// The one place a pid is minted, and now the only place the counter is
// read or written outside a reset. It used to be a read at one statement
// and an increment nine lines later, with a counter frequency division in
// between -- two cores would both read the same value and both write it
// plus one, so two processes would carry one pid. Every accounting this
// kernel does by pid (wait4 by pid, the process tree walk, ps) would then
// be asking a question with two answers.
//
// The critical section is a read and an add, which is shorter than what it
// replaces rather than longer.
private fn scheduled_process_mint_pid() -> usize {
    let guard = locked_cell_take(&scheduled_process_pid_cell);
    let minted = locked_cell_value(guard, &scheduled_process_pid_cell);
    let pid: usize = *minted + 1;
    *minted = pid;
    locked_cell_give(&scheduled_process_pid_cell, guard);
    return pid;
}

// The probe below mints thousands of pids and then puts the counter back.
// Restoring is not tidying: a pid appears in the process-lifecycle views,
// in ps, and in every wait4 line, so a probe that consumed real numbers
// would move every later process's pid and break views that have nothing
// to do with it (issue #437 moved PID 1 once and 17 of 39 views changed).
// Nothing was created here, so nothing is owed those numbers.
// GitHub issue #479: the mint, reachable by the contention probe. Private
// would be better and is not possible -- the probe is another file, and
// putting it in this one would grow the kernel's largest file for a test.
// POOL ONLY, and that distinction is load-bearing rather than pedantic.
//
// scheduled_process_table_init() additionally runs
// scheduled_process_release_every_process(), which resets the per-slot
// state that -- as that function's own comment says -- three OTHER tables
// key by the same slot index. Initialising the pool alone and then
// ALLOCATING leaves those three holding a previous life's state for the
// slot, and something later reads through one of them with a handle the
// pool no longer recognises.
//
// Measured (GitHub issue #479 Group B): a probe that allocated a record
// after this call produced `process table: records MISSING uses=16
// reason=2` in 3 boots out of 22, and 0 out of 14 after switching to
// scheduled_process_table_init(). Intermittent, and it survived a wrong
// first diagnosis -- the reap was blamed and removing the reap did not
// remove it.
//
// So: this is for a probe that only wants the pool to EXIST (minting a
// pid, reading a count). A probe that allocates a record wants
// scheduled_process_table_init().
fn scheduled_process_pool_init_for_probe() {
    scheduled_process_pool_init();
}

fn scheduled_process_mint_pid_for_probe() -> usize {
    return scheduled_process_mint_pid();
}

// The contention probe's negative control pauses after reading the counter
// and before writing it. Ordinary callers cannot obtain this pending value;
// they continue to use scheduled_process_mint_pid(), whose LockedCell guard
// spans both operations.
linear struct ScheduledPidProbePending[pending: usize] {
    private pid: usize @ pending;
}

must_use variant ScheduledPidProbeBeginResult {
    Pending(exists pending: usize. ScheduledPidProbePending[pending]);
}

private fn scheduled_pid_probe_pending_new(pid: usize @ pending)
        -> ScheduledPidProbePending[pending] {
    let mut value: ScheduledPidProbePending[pending] = { pid };
    return value;
}

fn scheduled_process_mint_pid_probe_begin()
        -> ScheduledPidProbeBeginResult !{unsafe} {
    let minted: *usize =
        locked_cell_value_boot(&scheduled_process_pid_cell);
    return ScheduledPidProbeBeginResult::Pending(
        scheduled_pid_probe_pending_new(*minted + 1));
}

fn scheduled_process_mint_pid_probe_commit(
        pending: sink ScheduledPidProbePending[pending]) -> usize !{unsafe} {
    let minted: *usize =
        locked_cell_value_boot(&scheduled_process_pid_cell);
    *minted = pending.pid;
    return pending.pid;
}

fn scheduled_process_mint_pid_probe_cancel(
        pending: sink ScheduledPidProbePending[pending]) {}

// Both take the lock, which the bare globals they replace did not -- and
// with the count inside a LockedCell an unlocked read is not expressible.
// The probe reads this WHILE the other core is minting, which is exactly
// the shape that made the first ASID detector report an impossible number.
fn scheduled_process_pid_counter() -> usize {
    let guard = locked_cell_take(&scheduled_process_pid_cell);
    let minted = locked_cell_value(guard, &scheduled_process_pid_cell);
    let count: usize = *minted;
    locked_cell_give(&scheduled_process_pid_cell, guard);
    return count;
}

fn scheduled_process_pid_counter_restore(value: usize) {
    let guard = locked_cell_take(&scheduled_process_pid_cell);
    let minted = locked_cell_value(guard, &scheduled_process_pid_cell);
    *minted = value;
    locked_cell_give(&scheduled_process_pid_cell, guard);
}

// GitHub issue #448: how many reaps found nothing to unlink, i.e. were
// handed a parent with no first_child. Only the teardown sweep can
// produce one, and only for a record whose has_parent is false. It is
// a counter and not a fail-stop because that record is observed but
// unexplained: the number tells us whether it is one straggler at
// teardown or something that happens while the system runs.
private let mut kernel_process_reap_unlinked_count: usize = 0;

// GitHub issue #579: which CPUs have ever carried an EL0 process, as a bit
// per core. `smp bringup:` already says which cores STARTED, and a core that
// starts, takes SGIs, stops in DDB and runs nothing reads exactly the same
// in that view as one carrying half the machine's work. This is the other
// half of that sentence, and it is what makes "cores 2 and 3 are idle" a
// line a lane compares rather than something a reader has to know.
//
// Written under the process-run lock at the one place a CPU takes a process
// for itself, and read once at the end of the boot suite.
private let mut kernel_process_cpus_that_ran: usize = 0;

fn kernel_process_cpus_that_ran_value() -> usize {
    return kernel_process_cpus_that_ran;
}

fn kernel_process_reap_unlinked_count_value() -> usize { 
    return kernel_process_reap_unlinked_count;
}

// -- The record a slot names ------------------------------------------

private fn scheduled_process_pool_init() {
    if (scheduled_process_pool_ready) { return; }
    scheduled_process_pool_ready = true;
    // No mutex_init for the pid cell's lock: a global Mutex is free from
    // .bss, and initialising it HERE would have put it behind a `ready`
    // flag that is itself an unlocked read-modify-write. See
    // kernel/lib/mutex.tkb.
    intrusive_pool_init(&scheduled_process_pool);
}

// Read a record through a HANDLE, which carries a generation, instead of
// through a bare slot, which does not.
//
// GitHub issue #492. `scheduled_process_record_at` takes a slot address and
// asks the pool whether anything lives there. It cannot ask whether the
// occupant is the one the caller meant, because a slot address does not say.
// So a record that was reaped and immediately reallocated answers Live, and
// the caller gets the NEW occupant's record. Silently. That is why #488 --
// the kernel reaping the record execution_here() calls current, 26 times a
// boot -- was invisible for however long it existed.
//
// ProcessHandle has carried the generation all along, and
// scheduled_process_handle_matches has always known how to compare it. The
// reads just threw it away.
//
// COUNTED, NOT ENFORCED, and deliberately so: this tree ships the counter
// first and proves it fires before changing behaviour. The record returned
// is exactly what the slot-only path returns, so nothing downstream moves
// until the number is known. `process invariant:` rather than `process
// table:` for the same reason the reap counter uses it -- the latter prefix
// is captured by process_lifecycle.filter, and an expected file is the wrong
// place for a violation whose count is not yet zero.
private fn scheduled_process_record_of(handle: ProcessHandle)
        -> *ProcessRecord !{unsafe} {
    if (scheduled_process_handle_matches(handle) == false) {
        scheduled_process_stale_handle_reads =
            scheduled_process_stale_handle_reads + 1;
        if (scheduled_process_stale_first_slot == 0) {
            scheduled_process_stale_first_slot = handle.pool_index;
            scheduled_process_stale_first_generation = handle.generation;
        }
    }
    return scheduled_process_record_at(handle.pool_index);
}

// GitHub issue #672 layer 3 (ProcessRecord, plan (2)): a record reached
// under the process-run lock. The run lock is what keeps a record alive --
// reap removes it under the same lock -- so the pointer is tied to the
// guard: once the guard is given back, a use of the pointer does not
// compile. Same lookup as the slot and handle forms below; only the
// authority it is derived from is new.
fn scheduled_process_record_locked(guard: borrow ProcessRunGuard[lock],
                                   slot: usize)
        -> *ProcessRecord @ lock !{unsafe} {
    return scheduled_process_record_at(slot);
}

fn scheduled_process_record_of_locked(guard: borrow ProcessRunGuard[lock],
                                      handle: ProcessHandle)
        -> *ProcessRecord @ lock !{unsafe} {
    return scheduled_process_record_of(handle);
}

// GitHub issue #693 step 2: evidence that a process is the one running on
// this CPU. Its own record is reached through it, and the pointer lives no
// longer than the evidence. A running process is not reaped
// (StackOwnership.tla), which is what makes the read sound; the mint is
// process_running_here, the one place that turns "this CPU's current
// process" into the evidence (scripts/check_process_running_mints.py keeps
// the list of its callers).
linear struct ProcessRunning[process: usize] {
    private handle: ProcessHandle;
}

must_use variant ProcessRunningHere {
    Running(exists process: usize. ProcessRunning[process]);
}

private fn process_running_new(handle: ProcessHandle, slot: usize @ process)
        -> ProcessRunning[process] {
    let mut running: ProcessRunning[process] = { handle };
    return running;
}

fn process_running_here() -> ProcessRunningHere !{unsafe} {
    let mut handle: ProcessHandle = execution_here().current_handle;
    return ProcessRunningHere::Running(
        process_running_new(handle, handle.pool_index));
}

fn process_running_end(running: sink ProcessRunning[process]) {}

fn scheduled_process_record_running(running: borrow ProcessRunning[process])
        -> *ProcessRecord @ process !{unsafe} {
    return scheduled_process_record_of(running.handle);
}

fn scheduled_process_stale_handle_reads_value() -> usize {
    return scheduled_process_stale_handle_reads;
}

fn scheduled_process_stale_first_slot_value() -> usize {
    return scheduled_process_stale_first_slot;
}

fn scheduled_process_stale_first_generation_value() -> usize {
    return scheduled_process_stale_first_generation;
}

fn scheduled_process_reaped_current_count_value() -> usize {
    return scheduled_process_reaped_current_count;
}

fn scheduled_process_record_missing_uses() -> usize {
    return scheduled_process_record_missing_count;
}

// GitHub issue #492: lookups that named this pool's slot with the previous
// occupant's generation. The pool counts it; this only publishes it, so the
// boot summary can add the pools up.
fn scheduled_process_recycled_handle_count() -> usize !{unsafe} {
    if (scheduled_process_pool_ready == false) { return 0; }
    return intrusive_pool_recycled_handle_count(&scheduled_process_pool);
}

// Validated on every call, which is strictly more than the old
// `{0..<KERNEL_PROCESS_MAX as usize}` refinement proved: a refinement said
// the index named a real array element, never that a live process was in
// it. Slot 0 is always answerable -- the bootstrap record is a static.
// The FIRST slot address this fallback was ever asked for, and which of
// the two ways it missed (1 = the pool was not ready yet, 2 = the pool did
// not recognise the address). A bare count says a lookup failed; these say
// which lookup, which is the difference between an investigation that has
// somewhere to start and one that does not.
//
// Recorded rather than logged, because the miss path can run in interrupt
// context where printing is not available -- the same reason
// kernel/lib/diagnostic_ring.tkb exists. Read by kernel/init/test_driver's
// resource summary, which only prints any of it when the count is nonzero.
//
// Both stores sit INSIDE the miss branches, so the path that finds a record
// pays nothing for them.
private let mut scheduled_process_missing_first_slot: usize = 0;
private let mut scheduled_process_missing_reason: usize = 0;
// GitHub issue #514: reason 2 was one word for two different failures, and
// the difference is the whole fork in the road. `intrusive_pool_probe_slot`
// answers NoPayload either because the pool does not own the address at all
// or because it owns a slot whose generation is 0 -- a record that has been
// released. A bogus address is a corrupted or invented slot number; a freed
// one is a live handle outliving its record. They want different fixes.
//
// The CPU and the slot running at the time come with it, because a lookup
// that misses says nothing about WHO asked, and 102 call sites in this file
// reach here. Stored, not printed: the miss path can run in interrupt
// context.
private let mut scheduled_process_missing_cpu: usize = 0;
private let mut scheduled_process_missing_current: usize = 0;
// GitHub issue #573: what this CPU is doing, one word per CPU, readable by a
// capture after the fact. #569 and #571 each stalled on "what was this CPU
// doing when the miss happened", and each time the answer was an ad-hoc
// per-CPU word added, read once and removed. This is that word, kept.
//
// The vocabulary is this enum, and kernel_activity_name answers with a
// match that has no default arm: an activity added without a name does not
// compile. The first four values keep the numbers the record-walk marker
// they replace used. A site enters with kernel_activity_enter and leaves by
// restoring what it found, so a record walk inside a syscall reads as the
// walk and then as the syscall again.
//
// Readers: the record-miss reports in the boot suite, the oops record
// (`oops: activity=`), and DDB's `current` (`ddb: activity cpu=`), which is
// taken with every CPU stopped. One store per entry and per exit; no lock,
// since only this CPU writes its own word.
enum KernelActivity: u8 {
    None; SecondaryStart; NextReady; ReapOwnZombies; ReleaseEveryProcess;
    Syscall; IdleLoop;
    // Not an activity but a verdict: scheduled_process_start found the
    // stack owned by another CPU (#609) and fail-stops with this set, so
    // the oops names the cause rather than where the fault surfaced.
    StartOnOwnedStack;
    // The same for scheduled_process_exited_take: a zombie reaped while a
    // CPU still stands on its stack (#609).
    ReapOnOwnedStack;
}

fn kernel_activity_name(activity: KernelActivity) -> *u8 {
    match activity {
        KernelActivity::None => { return "none" as *u8; }
        KernelActivity::SecondaryStart => { return "secondary-start" as *u8; }
        KernelActivity::NextReady => { return "next-ready" as *u8; }
        KernelActivity::ReapOwnZombies => { return "reap-own-zombies" as *u8; }
        KernelActivity::ReleaseEveryProcess => {
            return "release-every-process" as *u8;
        }
        KernelActivity::Syscall => { return "syscall" as *u8; }
        KernelActivity::IdleLoop => { return "idle-loop" as *u8; }
        KernelActivity::StartOnOwnedStack => {
            return "start-on-owned-stack" as *u8;
        }
        KernelActivity::ReapOnOwnedStack => {
            return "reap-on-owned-stack" as *u8;
        }
    }
}

private let mut kernel_activity: [KernelActivity; KERNEL_MAX_CORES];
private let mut scheduled_process_missing_site: KernelActivity;

private fn kernel_activity_here() -> *KernelActivity {
    let base: *KernelActivity = kernel_activity;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

fn kernel_activity_enter(activity: KernelActivity) -> KernelActivity {
    let previous: KernelActivity = *kernel_activity_here();
    *kernel_activity_here() = activity;
    return previous;
}

fn kernel_activity_leave(previous: KernelActivity) {
    *kernel_activity_here() = previous;
}

fn kernel_activity_set(activity: KernelActivity) {
    *kernel_activity_here() = activity;
}

// Any CPU's word, for a reporter that runs with every CPU stopped.
fn kernel_activity_of(core: {0..<KERNEL_MAX_CORES as usize}) -> KernelActivity {
    return kernel_activity[core];
}

// GitHub issue #609: which process a CPU runs and which one's stack it
// stands on, for DDB's `current` with the world stopped. They differ after
// a switch until the exception return, and after a block or an exit until
// idle entry. #609's shared stack was two CPUs where these two answers
// overlapped. 0 is "none" (pid 0 is never a process here).
private fn execution_of(core: {0..<KERNEL_MAX_CORES as usize}) -> *ExecutionState {
    let base: *ExecutionState = execution_state;
    return base + (core as isize);
}

fn kernel_process_cpu_current_pid(core: {0..<KERNEL_MAX_CORES as usize})
        -> usize {
    let state: *ExecutionState = execution_of(core);
    if (state.current_live == false) { return 0; }
    if (scheduled_process_handle_matches(state.current_handle) == false) {
        return 0;
    }
    return scheduled_process_pid_of_handle(state.current_handle);
}

fn kernel_process_cpu_stack_pid(core: {0..<KERNEL_MAX_CORES as usize})
        -> usize {
    let state: *ExecutionState = execution_of(core);
    if (state.stack_live == false) { return 0; }
    if (scheduled_process_handle_matches(state.stack_handle) == false) {
        return 0;
    }
    return scheduled_process_pid_of_handle(state.stack_handle);
}

// The oops record keeps words, not enums, because it is a retained layout
// read by gdb scripts as well; these two cross that boundary. A code no
// activity has reads as "unknown" rather than being trusted. The chain below
// is not checked for exhaustiveness the way kernel_activity_name is; the
// oops lane refuses `unknown` until GitHub issue #608 gives the language a
// checked integer-to-enum conversion.
fn kernel_activity_code_here() -> usize {
    return ((*kernel_activity_here()) as u8) as usize;
}

fn kernel_activity_name_for_code(code: usize) -> *u8 {
    let mut named: *u8 = "unknown" as *u8;
    if (code == (KernelActivity::None as u8) as usize) {
        named = kernel_activity_name(KernelActivity::None);
    }
    if (code == (KernelActivity::SecondaryStart as u8) as usize) {
        named = kernel_activity_name(KernelActivity::SecondaryStart);
    }
    if (code == (KernelActivity::NextReady as u8) as usize) {
        named = kernel_activity_name(KernelActivity::NextReady);
    }
    if (code == (KernelActivity::ReapOwnZombies as u8) as usize) {
        named = kernel_activity_name(KernelActivity::ReapOwnZombies);
    }
    if (code == (KernelActivity::ReleaseEveryProcess as u8) as usize) {
        named = kernel_activity_name(KernelActivity::ReleaseEveryProcess);
    }
    if (code == (KernelActivity::Syscall as u8) as usize) {
        named = kernel_activity_name(KernelActivity::Syscall);
    }
    if (code == (KernelActivity::IdleLoop as u8) as usize) {
        named = kernel_activity_name(KernelActivity::IdleLoop);
    }
    if (code == (KernelActivity::StartOnOwnedStack as u8) as usize) {
        named = kernel_activity_name(KernelActivity::StartOnOwnedStack);
    }
    if (code == (KernelActivity::ReapOnOwnedStack as u8) as usize) {
        named = kernel_activity_name(KernelActivity::ReapOnOwnedStack);
    }
    return named;
}

fn scheduled_process_missing_site_value() -> KernelActivity {
    return scheduled_process_missing_site;
}

// A slot a walk named and found free by the time it looked. Reported, not
// asserted at zero: it is a race the walk handles, and its rate is a fact
// about how often a reap lands inside a walk rather than a defect.
private let mut scheduled_process_freed_slot_count: usize = 0;
private let mut scheduled_process_freed_first_slot: usize = 0;
private let mut scheduled_process_freed_cpu: usize = 0;
private let mut scheduled_process_freed_site: KernelActivity;

fn scheduled_process_freed_slot_count_value() -> usize {
    return scheduled_process_freed_slot_count;
}

fn scheduled_process_freed_first_slot_value() -> usize {
    return scheduled_process_freed_first_slot;
}

fn scheduled_process_freed_cpu_value() -> usize {
    return scheduled_process_freed_cpu;
}

fn scheduled_process_freed_site_value() -> KernelActivity {
    return scheduled_process_freed_site;
}

fn scheduled_process_missing_first_slot_value() -> usize {
    return scheduled_process_missing_first_slot;
}

fn scheduled_process_missing_reason_value() -> usize {
    return scheduled_process_missing_reason;
}

fn scheduled_process_missing_cpu_value() -> usize {
    return scheduled_process_missing_cpu;
}

fn scheduled_process_missing_current_value() -> usize {
    return scheduled_process_missing_current;
}

private fn scheduled_process_record_at(slot: usize) -> *ProcessRecord
        !{unsafe} {
    if (slot == 0) { return &scheduled_process_boot_record; }
    if (scheduled_process_pool_ready == false) {
        scheduled_process_record_missing_count =
            scheduled_process_record_missing_count + 1;
        if (scheduled_process_missing_first_slot == 0) {
            scheduled_process_missing_first_slot = slot;
            scheduled_process_missing_reason = 1;
        }
        return &scheduled_process_record_absent;
    }
    match intrusive_pool_probe_slot(&scheduled_process_pool, slot) {
        IntrusiveSlotProbe::NoPayload => {
            // GitHub issue #569: two different answers wore one counter,
            // and only one of them is a defect.
            //
            // The pool owning this slot with generation 0 means the slot is
            // FREE. Every slot walk here reaches its slots through
            // scheduled_process_live_pool_slot_from, which probes under the
            // pool lock, sees Live, DROPS the view, and returns a bare slot
            // number; the caller then looks that number up again. Nothing is
            // held between the two probes, so a free in the gap is a walk
            // that raced -- and the walk handles it correctly already, since
            // the absent record reads back Free and `== Ready` skips it.
            //
            // Counting that as a missing record made a benign, expected race
            // fail the lane a view asserts the counter on, about three runs
            // of `make cicheck` in eight. It also made the counter useless as
            // a detector, which is the worse half: a number that fires when
            // nothing is wrong stops being read.
            //
            // What stays in the counter is the other answer: an address the
            // pool does not own at all. That is an invented or corrupted slot
            // number and has no benign reading. A slot that was freed and
            // REUSED is not either of these -- the lookup succeeds and the
            // generation check catches it, on `process invariant: STALE
            // HANDLE READS` and `RECYCLED HANDLE READS`.
            if (intrusive_pool_slot_is_valid(&scheduled_process_pool, slot)) {
                scheduled_process_freed_slot_count =
                    scheduled_process_freed_slot_count + 1;
                if (scheduled_process_freed_first_slot == 0) {
                    scheduled_process_freed_first_slot = slot;
                    scheduled_process_freed_cpu = cpu_id();
                    scheduled_process_freed_site =
                        *kernel_activity_here();
                }
                return &scheduled_process_record_absent;
            }
            scheduled_process_record_missing_count =
                scheduled_process_record_missing_count + 1;
            if (scheduled_process_missing_first_slot == 0) {
                scheduled_process_missing_first_slot = slot;
                scheduled_process_missing_reason = 2;
                scheduled_process_missing_cpu = cpu_id();
                scheduled_process_missing_site =
                    *kernel_activity_here();
                // +1, so 0 means "no current process here" rather than
                // "current is slot 0". The first version could not tell
                // those apart and the difference is the idle path.
                if (execution_here().current_live) {
                    scheduled_process_missing_current =
                        execution_here().current_handle.pool_index + 1;
                }
            }
            return &scheduled_process_record_absent;
        }
        IntrusiveSlotProbe::Live(slot_view) => {
            // GitHub issue #488, and THIS IS THE SITE. Every read of a
            // process record comes through here, and returning the payload
            // drops the view -- the only proof that the slot was occupied
            // when it was looked up. That is why a handle to a reaped
            // record kept working: the pointer outlived its proof, landed
            // on whatever was allocated at the address next, and nothing
            // noticed.
            //
            // The unproven form is what this has always done; its name and
            // its place in the trusted-base count are new, so the 159 call
            // sites it feeds are a NUMBER rather than an assumption.
            // Migrating them to hold the view is filed separately -- that
            // is the difference between "the default is safe" (this
            // change) and "nothing launders" (that one).
            return intrusive_pool_payload_unproven_of(
                &scheduled_process_pool, slot_view);
        }
    }
}

// Walking every live process. The bootstrap comes first and is not in the
// pool, which is exactly the thing a hand-written walk would forget -- so
// there is one walk and every caller uses it. Done rather than 0 for the
// end, because 0 is a real slot here.
variant ProcessSlotCursor {
    Done;
    At(usize);
}

struct ProcessDiagnosticSnapshot {
    pid: usize;
    ppid: usize;
    session_id: usize;
    state: u8;
    resident_pages: usize;
    start_time_ticks: usize;
    command_line: [u8; 512];
    command_line_length: usize;
}

const DDB_PROCESS_RECORDS: usize = 32;
const DDB_PROCESS_PROBE_BUDGET: usize = 64;

struct ProcessDdbRecord {
    pid: usize;
    ppid: usize;
    state: usize;
    wait_reason: usize;
    saved_sp: usize;
    stack_bottom: usize;
    stack_top: usize;
    // PROCESS_STACK_UNOWNED or the one CPU permitted to execute with this
    // process stack as SP_EL1. DDB copies the value while the world is
    // stopped so its per-CPU roots can be checked against the scheduler's
    // authoritative physical-ownership record.
    stack_owner_cpu: usize;
    root_slot: usize;
    // GitHub issue #564: a napping process carrying a SIGTERM its parent had
    // already sent looks exactly like one that was never signalled, because
    // `kernel_process_current_termination_signal_take` refuses a SIGTERM the
    // mask blocks and the snapshot carried neither word. Both are copied so
    // the debugger can tell an unsent signal from a masked one from a capture
    // already on disk.
    pending_signals: usize;
    signal_mask: usize;
    // GitHub issue #593: where the process may run. A Ready process no CPU
    // starts is placement -- a mask naming one CPU, or a syscall waiting for
    // core 0 -- and neither was visible until these were copied.
    affinity_mask: usize;
    core0_for_call: bool;
}

struct ProcessDdbCopyResult {
    count: usize;
    truncated: bool;
}

// `borrow *ProcessRecord`, and GitHub issue #488 is why. The caller reads
// the record through a live IntrusiveSlotView; a retaining parameter would
// let this function keep the pointer past the view, which is exactly the
// escape the view exists to close. It only copies fields out, so borrowing
// is what it meant all along.
private fn scheduled_process_ddb_copy_one(
        output: borrow [ProcessDdbRecord; DDB_PROCESS_RECORDS..],
        index: usize, slot: usize,
        record: borrow *ProcessRecord) {
    if (index >= 32) { return; }
    output[index].pid = record.pid;
    output[index].ppid = 0;
    if (record.has_parent) {
        output[index].ppid = scheduled_process_pid_of_handle(record.parent);
    }
    match record.state {
        ProcessSlotState::Free => { output[index].state = 0; }
        ProcessSlotState::Ready => { output[index].state = 1; }
        ProcessSlotState::Running => { output[index].state = 2; }
        ProcessSlotState::Blocked => { output[index].state = 3; }
        ProcessSlotState::Exited => { output[index].state = 4; }
        ProcessSlotState::Constructing => { output[index].state = 5; }
    }
    match process_wait_reason(&record.wait) {
        ProcessWaitReason::None => { output[index].wait_reason = 0; }
        ProcessWaitReason::UartRx => { output[index].wait_reason = 1; }
        ProcessWaitReason::ChildExit => { output[index].wait_reason = 2; }
        ProcessWaitReason::NetRx => { output[index].wait_reason = 3; }
        ProcessWaitReason::Deadline => { output[index].wait_reason = 4; }
        ProcessWaitReason::Signal => { output[index].wait_reason = 5; }
        ProcessWaitReason::UartTx => { output[index].wait_reason = 6; }
    }
    output[index].saved_sp = record.saved_sp;
    output[index].stack_bottom = 0;
    output[index].stack_top = 0;
    if (slot == 0) {
        // PID 1 executes on the linker-owned boot stack even if its record
        // retained a reusable process-stack run from an earlier fixture.
        output[index].stack_bottom = boot_stack_bottom;
        output[index].stack_top = boot_stack_top;
    } else if (kernel_stack_run_usable(record.stack_run)) {
        output[index].stack_bottom =
            record.stack_run + KERNEL_PROCESS_STACK_SIZE;
        output[index].stack_top = record.stack_run + KERNEL_STACK_RUN_BYTES;
    }
    output[index].stack_owner_cpu = record.stack_owner_cpu;
    output[index].root_slot = slot;
    output[index].pending_signals = record.pending_signals;
    output[index].signal_mask = record.signal_mask;
    output[index].affinity_mask = record.affinity_mask;
    output[index].core0_for_call = record.core0_for_call;
}

// GitHub issue #606: one diff pass of kernel/kernel/protocol_trace.tkb,
// called with the run lock held. The protocol state is what
// StackOwnership.tla models: each process's state and stack owner, and each
// core's current process and the stack it stands on.
const PROTOCOL_TRACE_PROBE_BUDGET: usize = 256;

private fn kernel_process_protocol_state(state: ProcessSlotState) -> usize {
    match state {
        ProcessSlotState::Free => { return 0; }
        ProcessSlotState::Ready => { return 1; }
        ProcessSlotState::Running => { return 2; }
        ProcessSlotState::Blocked => { return 3; }
        ProcessSlotState::Exited => { return 4; }
        ProcessSlotState::Constructing => { return 5; }
    }
}

private fn kernel_process_protocol_reason(reason: ProcessWaitReason)
        -> usize {
    match reason {
        ProcessWaitReason::None => { return 0; }
        ProcessWaitReason::UartRx => { return 1; }
        ProcessWaitReason::ChildExit => { return 2; }
        ProcessWaitReason::NetRx => { return 3; }
        ProcessWaitReason::Deadline => { return 4; }
        ProcessWaitReason::Signal => { return 5; }
        ProcessWaitReason::UartTx => { return 6; }
    }
}

private fn kernel_process_protocol_owner(owner: usize) -> usize {
    if (owner == PROCESS_STACK_UNOWNED) { return PROTOCOL_TRACE_NONE; }
    return owner;
}

// A record with no parent (the boot process, or an orphan the teardown
// sweep detached) names nothing.
private fn kernel_process_protocol_parent(record: borrow *ProcessRecord)
        -> usize !{unsafe} {
    if (record.has_parent) {
        return scheduled_process_pid_of_handle(record.parent);
    }
    return PROTOCOL_TRACE_NONE;
}

private fn kernel_process_protocol_observe(unlocked: bool) !{unsafe} {
    protocol_trace_pass_begin(unlocked);
    if (scheduled_process_boot_live) {
        protocol_trace_observe_process(
            scheduled_process_boot_record.pid,
            kernel_process_protocol_state(scheduled_process_boot_record.state),
            kernel_process_protocol_owner(
                scheduled_process_boot_record.stack_owner_cpu),
            kernel_process_protocol_reason(
                process_wait_reason(&scheduled_process_boot_record.wait)),
            PROTOCOL_TRACE_NONE);
    }
    let mut slot: usize = 0;
    if (scheduled_process_pool_ready) {
        slot = intrusive_pool_first_slot(&scheduled_process_pool);
    }
    let mut probes: usize = 0;
    while (slot != 0 && probes < PROTOCOL_TRACE_PROBE_BUDGET) {
        let next: usize = intrusive_pool_next_slot(&scheduled_process_pool, slot);
        match intrusive_pool_probe_slot_unproven(&scheduled_process_pool, slot) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                let record: *ProcessRecord = intrusive_pool_payload_of(
                    &scheduled_process_pool, slot_view);
                // A slot being allocated is not a process yet.
                if (record.state != ProcessSlotState::Free) {
                    protocol_trace_observe_process(
                        record.pid,
                        kernel_process_protocol_state(record.state),
                        kernel_process_protocol_owner(record.stack_owner_cpu),
                        kernel_process_protocol_reason(process_wait_reason(&record.wait)),
                        kernel_process_protocol_parent(record));
                }
                intrusive_view_release(slot_view);
            }
        }
        probes = probes + 1;
        slot = next;
    }
    if (slot != 0) { protocol_trace_note_lost(); }
    for core: usize in 0..<KERNEL_MAX_CORES {
        let mut current: usize = PROTOCOL_TRACE_NONE;
        if (execution_state[core].current_live) {
            current = scheduled_process_pid_of_handle(
                execution_state[core].current_handle);
        }
        let mut stands: usize = PROTOCOL_TRACE_NONE;
        if (execution_state[core].stack_live) {
            stands = scheduled_process_pid_of_handle(
                execution_state[core].stack_handle);
        }
        protocol_trace_observe_core(core, current, stands);
    }
    protocol_trace_pass_end(unlocked);
}

// /bin/protocol-trace opens and closes the window (GitHub issue #606). The
// opening pass records the whole protocol state as sequence 0; the closing
// hold is the window's last step, and the report is printed after it,
// outside the lock.
fn kernel_process_protocol_trace_open() -> usize {
    let guard = process_run_lock();
    protocol_trace_open();
    process_run_unlock(guard);
    return 1;
}

fn kernel_process_protocol_trace_close() -> usize {
    let guard = process_run_lock();
    protocol_trace_close();
    process_run_unlock(guard);
    protocol_trace_report();
    return 1;
}

// Fixed work for interrupt-safe DDB entry: at most 64 physical pool slots
// are probed and at most 32 live records copied. A truncated result is an
// explicit diagnostic fact, never silently presented as the whole table.
fn kernel_process_ddb_copy(
        output: borrow [ProcessDdbRecord; DDB_PROCESS_RECORDS..])
        -> ProcessDdbCopyResult !{unsafe} {
    let mut count: usize = 0;
    if (scheduled_process_boot_live) {
        scheduled_process_ddb_copy_one(
            output, 0, 0, &scheduled_process_boot_record);
        count = count + 1;
    }
    let mut slot: usize = 0;
    if (scheduled_process_pool_ready) {
        slot = intrusive_pool_first_slot(&scheduled_process_pool);
    }
    let mut probes: usize = 0;
    while (slot != 0 && probes < DDB_PROCESS_PROBE_BUDGET &&
            count < DDB_PROCESS_RECORDS) {
        let next: usize = intrusive_pool_next_slot(&scheduled_process_pool, slot);
        match intrusive_pool_probe_slot_unproven(&scheduled_process_pool, slot) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                // The view is held across the read and released after,
                // which is the shape GitHub issue #488 wants everywhere:
                // the payload pointer cannot outlive the proof that the
                // slot was occupied. This walk was already doing the right
                // thing by accident -- it just had no way to say so.
                let record: *ProcessRecord = intrusive_pool_payload_of(
                    &scheduled_process_pool, slot_view);
                scheduled_process_ddb_copy_one(output, count, slot, record);
                intrusive_view_release(slot_view);
                count = count + 1;
            }
        }
        probes = probes + 1;
        slot = next;
    }
    let mut result: ProcessDdbCopyResult = { count, slot != 0 };
    return result;
}

must_use variant ProcessDiagnosticResult {
    Missing;
    Found(ProcessDiagnosticSnapshot);
}

private fn scheduled_process_live_pool_slot_from(cursor: usize)
        -> ProcessSlotCursor !{unsafe} {
    let mut probe: usize = cursor;
    while (probe != 0) {
        match intrusive_pool_probe_slot(&scheduled_process_pool, probe) {
            IntrusiveSlotProbe::NoPayload => {}
            IntrusiveSlotProbe::Live(slot_view) => {
                intrusive_view_drop(slot_view);
                return ProcessSlotCursor::At(probe);
            }
        }
        probe = intrusive_pool_next_slot(&scheduled_process_pool, probe);
    }
    return ProcessSlotCursor::Done;
}

private fn scheduled_process_first_pool_slot() -> ProcessSlotCursor
        !{unsafe} {
    if (scheduled_process_pool_ready == false) {
        return ProcessSlotCursor::Done;
    }
    return scheduled_process_live_pool_slot_from(
        intrusive_pool_first_slot(&scheduled_process_pool));
}

fn scheduled_process_first_slot() -> ProcessSlotCursor !{unsafe} {
    if (scheduled_process_boot_live) { return ProcessSlotCursor::At(0); }
    return scheduled_process_first_pool_slot();
}

fn scheduled_process_next_slot(slot: usize) -> ProcessSlotCursor !{unsafe} {
    if (slot == 0) { return scheduled_process_first_pool_slot(); }
    if (scheduled_process_pool_ready == false) {
        return ProcessSlotCursor::Done;
    }
    return scheduled_process_live_pool_slot_from(
        intrusive_pool_next_slot(&scheduled_process_pool, slot));
}

// Keep enum field reads in their typed result context. Direct enum reads
// through an array-of-struct field do not yet lower a load correctly.
fn scheduled_process_record_state(slot: usize) -> ProcessSlotState
        !{unsafe} {
    return scheduled_process_record_at(slot).state;
}

// The same two questions asked through a HANDLE, which carries the
// generation the slot-taking pair above cannot check.
//
// GitHub issue #492's third acceptance line is "no call site that holds a
// handle passes only its slot", and these two accessors were where most of
// them were: seventeen of the twenty state reads and six of the seven
// wait-reason reads had a ProcessHandle in scope and passed `X.pool_index`.
// Writing `.pool_index` at a call site is what discarding a generation looks
// like, and it looks like nothing.
//
// Both go through scheduled_process_record_of, so a stale handle is COUNTED
// on the existing `process invariant: STALE HANDLE READS` line rather than
// refused -- the same ship-the-counter-first rule that accessor was added
// under. The slot-taking forms stay for the callers that genuinely never had
// a handle: a slot from scheduled_process_slot_for_pid, the teardown sweep's
// scan, and the crash paths.
fn scheduled_process_state_of(handle: ProcessHandle) -> ProcessSlotState
        !{unsafe} {
    return scheduled_process_record_of(handle).state;
}

fn scheduled_process_record_wait_reason(slot: usize) -> ProcessWaitReason
        !{unsafe} {
    return process_wait_reason(&scheduled_process_record_at(slot).wait);
}

fn scheduled_process_wait_reason_of(handle: ProcessHandle) -> ProcessWaitReason
        !{unsafe} {
    return process_wait_reason(&scheduled_process_record_of(handle).wait);
}

// GitHub issue #392 and the multicore follow-up: syscall.tkb's per-process
// values, asked for by slot. Out of range answers with the same default a
// fresh record has, so a caller that cannot name a process is never handed
// another process's state.
// GitHub issue #693 step 5: the UART delivery kind is read and written under
// the run guard; the wake paths that consult it already hold it.
fn scheduled_process_uart_block_delivery(guard: borrow ProcessRunGuard[lock], slot: usize)
        -> UartBlockDelivery {
    return scheduled_process_record_locked(guard, slot).uart_block_delivery;
}

fn scheduled_process_set_uart_block_delivery(
        guard: borrow ProcessRunGuard[lock], slot: usize, delivery: UartBlockDelivery) {
    scheduled_process_record_locked(guard, slot).uart_block_delivery =
        delivery;
}

// GitHub issue #693 step 5: under the run guard its callers take.
fn scheduled_process_clone_file_state(guard: borrow ProcessRunGuard[lock],
                                      slot: usize) -> CloneFileState
        !{unsafe} {
    return scheduled_process_record_locked(guard, slot).clone_file_state;
}

fn scheduled_process_set_clone_file_state(
        guard: borrow ProcessRunGuard[lock], slot: usize,
        state: CloneFileState) {
    scheduled_process_record_locked(guard, slot).clone_file_state = state;
}

// GitHub issue #693 step 5: these per-process syscall flags are read and
// written under the run guard, which their callers take.
fn scheduled_process_inetd_mode(guard: borrow ProcessRunGuard[lock], slot: usize) -> bool {
    return scheduled_process_record_locked(guard, slot).inetd_mode;
}

fn scheduled_process_set_inetd_mode(guard: borrow ProcessRunGuard[lock], slot: usize,
                                    enabled: bool) {
    scheduled_process_record_locked(guard, slot).inetd_mode = enabled;
}

fn scheduled_process_affinity_mask(guard: borrow ProcessRunGuard[lock],
        slot: usize) -> usize {
    return scheduled_process_record_locked(guard, slot).affinity_mask;
}

fn scheduled_process_set_affinity_mask(guard: borrow ProcessRunGuard[lock],
        slot: usize,
        mask: usize) {
    scheduled_process_record_locked(guard, slot).affinity_mask = mask;
}

fn scheduled_process_core0_for_call(guard: borrow ProcessRunGuard[lock],
        slot: usize) -> bool {
    return scheduled_process_record_locked(guard, slot).core0_for_call;
}

fn scheduled_process_set_core0_for_call(guard: borrow ProcessRunGuard[lock],
        slot: usize,
        value: bool) {
    scheduled_process_record_locked(guard, slot).core0_for_call = value;
}

fn scheduled_process_init_signal_wait_logged(
        guard: borrow ProcessRunGuard[lock], slot: usize) -> bool {
    return scheduled_process_record_locked(guard, slot)
        .init_signal_wait_logged;
}

fn scheduled_process_set_init_signal_wait_logged(
        guard: borrow ProcessRunGuard[lock], slot: usize, logged: bool) {
    scheduled_process_record_locked(guard, slot).init_signal_wait_logged =
        logged;
}

// command_line_length needs ten bits for 0..512. Its remaining bits carry the
// short-lived exec handoff metadata, avoiding a ProcessRecord size increase
// that would push every intrusive-pool record across a page boundary.
const PROCESS_COMMAND_LENGTH_MASK: usize = 0x3FF;
const PROCESS_EXEC_ARGC_SHIFT: usize = 10;
const PROCESS_EXEC_ARGC_MASK: usize = 0x3C00;
const PROCESS_EXEC_PENDING: usize = 0x4000;
// GitHub issue #591: the ext2 inode execve named, in the top 32 bits (ext2
// inode numbers are 32-bit). Zero means none was resolved.
const PROCESS_EXEC_INODE_SHIFT: usize = 32;
const PROCESS_EXEC_INODE_MASK: usize = 0xFFFFFFFF00000000;

fn scheduled_process_exec_pending(guard: borrow ProcessRunGuard[lock], slot: usize) -> bool {
    return (scheduled_process_record_locked(guard, slot).command_line_length &
            PROCESS_EXEC_PENDING) != 0;
}

fn scheduled_process_set_exec_pending(guard: borrow ProcessRunGuard[lock],
                                      slot: usize, pending: bool) {
    let record = scheduled_process_record_locked(guard, slot);
    record.command_line_length = record.command_line_length &
                                 ~PROCESS_EXEC_PENDING;
    if (pending) {
        record.command_line_length = record.command_line_length |
                                     PROCESS_EXEC_PENDING;
    }
}

fn scheduled_process_exec_argc(guard: borrow ProcessRunGuard[lock], slot: usize) -> usize {
    return (scheduled_process_record_locked(guard, slot).command_line_length &
            PROCESS_EXEC_ARGC_MASK) >> PROCESS_EXEC_ARGC_SHIFT;
}

fn scheduled_process_set_exec_argc(
        guard: borrow ProcessRunGuard[lock],
        slot: usize, argc: {0..<16 as usize}) {
    let record = scheduled_process_record_locked(guard, slot);
    record.command_line_length = record.command_line_length &
                                 ~PROCESS_EXEC_ARGC_MASK;
    record.command_line_length = record.command_line_length |
        ((argc << PROCESS_EXEC_ARGC_SHIFT) & PROCESS_EXEC_ARGC_MASK);
}

fn scheduled_process_exec_inode(guard: borrow ProcessRunGuard[lock], slot: usize) -> usize {
    return (scheduled_process_record_locked(guard, slot).command_line_length &
            PROCESS_EXEC_INODE_MASK) >> PROCESS_EXEC_INODE_SHIFT;
}

fn scheduled_process_set_exec_inode(guard: borrow ProcessRunGuard[lock],
                                    slot: usize, inode: usize) {
    let record = scheduled_process_record_locked(guard, slot);
    record.command_line_length = record.command_line_length &
                                 ~PROCESS_EXEC_INODE_MASK;
    record.command_line_length = record.command_line_length |
        ((inode << PROCESS_EXEC_INODE_SHIFT) & PROCESS_EXEC_INODE_MASK);
}

// The same reset applied to every live process, for
// kernel_syscall_process_configure -- a whole-world reset that can run
// while processes already exist. It walks rather than sweeping an index
// range, because there is no index range.
fn scheduled_process_reset_syscall_state_everywhere() !{unsafe} {
    // No caller holds the run lock (kernel_syscall_process_configure).
    let guard = process_run_lock();
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                scheduled_process_record_reset_syscall_state(
                    scheduled_process_record_locked(guard, slot));
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    process_run_unlock(guard);
}

// Fresh syscall-owned process state in one place, so a slot handed out again
// does not inherit the previous occupant's blocking, clone, or policy state.
// GitHub issue #693 step 5: written through the record the caller already
// holds an authority for (the run guard, the creating owner, or the reset
// of a record being removed), not looked up again by slot.
private fn scheduled_process_record_reset_syscall_state(
        record: borrow *ProcessRecord) {
    record.uart_block_delivery = UartBlockDelivery::Scalar;
    let mut fresh: CloneFileState = { false };
    record.clone_file_state = fresh;
    record.inetd_mode = false;
    record.init_signal_wait_logged = false;
    record.affinity_mask = 0;
    record.core0_for_call = false;
    record.command_line_length = record.command_line_length &
        ~(PROCESS_EXEC_PENDING | PROCESS_EXEC_ARGC_MASK |
          PROCESS_EXEC_INODE_MASK);
}

// GitHub issue #392: both directions between a pid and a slot, asked
// rather than computed. `pool_index + 1` and `pid - 1` were the same
// conversion written inline at some twenty sites, each of which silently
// assumed a slot is a small integer.
//
// A reaped slot keeps its pid until the slot is handed out again, which
// is what `pid - 1` also did and what the exec-reap path depends on: it
// asks about a child that has already exited but whose image has not yet
// been reclaimed.
// A pid lookup is a DIAGNOSTIC, and the crash/trace paths ask about a peer
// that may already have been reaped -- so it reads through a peek that
// tolerates a dead slot instead of the counted accessor, whose whole point
// is to notice code that assumed a record outlives its process.
private fn scheduled_process_record_peek(slot: usize) -> *ProcessRecord
        !{unsafe} {
    if (slot == 0) { return &scheduled_process_boot_record; }
    if (scheduled_process_pool_ready == false) {
        return &scheduled_process_record_absent;
    }
    match intrusive_pool_probe_slot(&scheduled_process_pool, slot) {
        IntrusiveSlotProbe::NoPayload => {
            return &scheduled_process_record_absent;
        }
        IntrusiveSlotProbe::Live(slot_view) => {
            // Unproven DELIBERATELY here, unlike the counted accessor
            // above: this whole function exists to tolerate a dead slot,
            // for crash and trace paths asking about an already-reaped
            // peer. Its callers must not hold the pointer, and the header
            // above says so. GitHub issue #488.
            return intrusive_pool_payload_unproven_of(
                &scheduled_process_pool, slot_view);
        }
    }
}

fn scheduled_process_pid_of_slot(slot: usize) -> usize !{unsafe} {
    return scheduled_process_record_peek(slot).pid;
}

// The same tolerance for the other three fields a trace or a crash report
// reads about a process that may already be gone. The scheduler's own
// reads go through scheduled_process_record_state/_wait_reason, which
// count -- these do not, because "the subject was reaped" is a normal
// answer to a diagnostic and an abnormal one to the scheduler.
fn scheduled_process_peek_state(slot: usize) -> ProcessSlotState !{unsafe} {
    return scheduled_process_record_peek(slot).state;
}

fn scheduled_process_peek_wait_reason(slot: usize) -> ProcessWaitReason
        !{unsafe} {
    return process_wait_reason(&scheduled_process_record_peek(slot).wait);
}

fn scheduled_process_peek_saved_sp(slot: usize) -> usize !{unsafe} {
    return scheduled_process_record_peek(slot).saved_sp;
}

fn scheduled_process_pid_of_handle(handle: ProcessHandle) -> usize
        !{unsafe} {
    return scheduled_process_record_peek(handle.pool_index).pid;
}

must_use variant ProcessSlotForPidResult {
    Missing;
    Found(usize);
}

fn scheduled_process_slot_for_pid(pid: usize) -> ProcessSlotForPidResult
        !{unsafe} {
    if (pid == 0) { return ProcessSlotForPidResult::Missing; }
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                if (scheduled_process_record_at(slot).pid == pid) {
                    return ProcessSlotForPidResult::Found(slot);
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    return ProcessSlotForPidResult::Missing;
}

// Allocation-free, kernel-owned procfs input. The caller receives a value
// copy, never a ProcessRecord pointer or a userspace argv pointer.
//
// GitHub issue #618: under the process-run lock, from the pid lookup to the
// last byte copied. procfs reads run on any CPU, a peer can reap the record
// (#609) or exec can rewrite its command line in between, and #482's fix --
// the reap's removal under this lock -- protects only a reader that holds
// it. RecordLifetime.tla's READER_HOLDS_LOCK and EXEC_WRITES_UNDER_LOCK
// variants are what goes wrong without it.
fn scheduled_process_diagnostic_snapshot(pid: usize)
        -> ProcessDiagnosticResult !{unsafe} {
    let mut snapshot: ProcessDiagnosticSnapshot;
    let guard = process_run_lock();
    let found: bool = scheduled_process_diagnostic_fill(pid, &snapshot);
    process_run_unlock(guard);
    if (found == false) { return ProcessDiagnosticResult::Missing; }
    return ProcessDiagnosticResult::Found(snapshot);
}

// The same copy with no lock, for the monitor's `ps` and `proc`: a reporter
// must not take a lock (kernel/CONCURRENCY.md), and they run with every
// other CPU stopped.
private fn scheduled_process_diagnostic_copy(pid: usize)
        -> ProcessDiagnosticResult !{unsafe} {
    let mut snapshot: ProcessDiagnosticSnapshot;
    if (scheduled_process_diagnostic_fill(pid, &snapshot) == false) {
        return ProcessDiagnosticResult::Missing;
    }
    return ProcessDiagnosticResult::Found(snapshot);
}

// The copy both share. It fills the caller's snapshot rather than returning
// one: a second 600-byte value in flight on the way out of a wrapper
// overflowed a debug build's 16 KiB kernel stack under BusyBox ps.
private fn scheduled_process_diagnostic_fill(
        pid: usize, snapshot: borrow *ProcessDiagnosticSnapshot) -> bool
        !{unsafe} {
    let slot: usize = match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => { return false; }
        ProcessSlotForPidResult::Found(found) => { found }
    };
    // GitHub issue #693 step 6: a diagnostic read. procfs holds the run
    // lock across the whole fill; the monitor runs with every other CPU
    // stopped. Neither is the counted accessor's question.
    snapshot.pid = scheduled_process_record_peek(slot).pid;
    snapshot.session_id = scheduled_process_record_peek(slot).session_id;
    snapshot.ppid = 0;
    if (scheduled_process_record_peek(slot).has_parent) {
        snapshot.ppid = scheduled_process_pid_of_handle(
            scheduled_process_record_peek(slot).parent);
    }
    match scheduled_process_record_peek(slot).state {
        ProcessSlotState::Free => { snapshot.state = 0x3F; }
        ProcessSlotState::Ready => { snapshot.state = 0x52; }
        ProcessSlotState::Running => { snapshot.state = 0x52; }
        ProcessSlotState::Blocked => { snapshot.state = 0x53; }
        ProcessSlotState::Exited => { snapshot.state = 0x5A; }
        ProcessSlotState::Constructing => { snapshot.state = 0x49; }
    }
    let mut image_words: ProcessPoolHandleWords = {
        scheduled_process_record_peek(slot).image_record,
        scheduled_process_record_peek(slot).image_record_generation };
    snapshot.resident_pages = process_image_active_page_count_words(image_words);
    snapshot.start_time_ticks =
        scheduled_process_record_peek(slot).start_time_ticks;
    snapshot.command_line_length =
        scheduled_process_record_peek(slot).command_line_length &
        PROCESS_COMMAND_LENGTH_MASK;
    for index: usize in 0..<512 {
        snapshot.command_line[index] =
            scheduled_process_record_peek(slot).command_line[index];
    }
    return true;
}

// PID-ordered enumeration gives procfs deterministic directory output even
// though the process pool is address-ordered internally.
fn scheduled_process_diagnostic_next_pid(after: usize) -> usize !{unsafe} {
    let mut next: usize = 0;
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let pid: usize = scheduled_process_pid_of_slot(slot);
                if (pid > after && (next == 0 || pid < next)) { next = pid; }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    return next;
}

private fn kernel_process_monitor_put_command(snapshot: ProcessDiagnosticSnapshot) {
    let mut index: usize = 0;
    while (index < snapshot.command_line_length && index < 512) {
        if (index >= 0 && index < 512) {
            let byte: u8 = snapshot.command_line[index];
            if (byte == 0) { return; }
            if (byte >= 0x20 && byte <= 0x7E) { uart_putc(byte); }
            else { uart_putc(0x3F); }
        }
        index = index + 1;
    }
}

// Read-only monitor views deliberately consume the same value snapshot as
// procfs. They never retain a ProcessRecord pointer while the kernel is
// stopped, and the UART frontend does not become a second process model.
fn kernel_process_monitor_ps() !{unsafe} {
    kernel_boot_log("ps: pid ppid state pages command\n");
    let mut after: usize = 0;
    let mut walking: bool = true;
    while (walking) {
        let pid: usize = scheduled_process_diagnostic_next_pid(after);
        if (pid == 0) { walking = false; }
        else {
            match scheduled_process_diagnostic_copy(pid) {
                ProcessDiagnosticResult::Missing => {}
                ProcessDiagnosticResult::Found(snapshot) => {
                    kernel_boot_log("ps: "); uart_put_udec(snapshot.pid);
                    kernel_boot_log(" "); uart_put_udec(snapshot.ppid);
                    kernel_boot_log(" "); uart_putc(snapshot.state);
                    kernel_boot_log(" "); uart_put_udec(snapshot.resident_pages);
                    kernel_boot_log(" ");
                    kernel_process_monitor_put_command(snapshot);
                    kernel_boot_log("\n");
                }
            }
            after = pid;
        }
    }
}

fn kernel_process_monitor_proc(pid: usize) !{unsafe} {
    let slot: usize = match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => {
            kernel_boot_log("proc: no such pid\n");
            return;
        }
        ProcessSlotForPidResult::Found(found) => { found }
    };
    let snapshot: ProcessDiagnosticSnapshot =
        match scheduled_process_diagnostic_copy(pid) {
            ProcessDiagnosticResult::Missing => {
                kernel_boot_log("proc: no such pid\n");
                return;
            }
            ProcessDiagnosticResult::Found(found) => { found }
        };
    kernel_boot_log("proc: pid="); uart_put_udec(snapshot.pid);
    kernel_boot_log(" ppid="); uart_put_udec(snapshot.ppid);
    kernel_boot_log(" state="); uart_putc(snapshot.state);
    kernel_boot_log(" wait=");
    match scheduled_process_peek_wait_reason(slot) {
        ProcessWaitReason::None => { uart_put_udec(0); }
        ProcessWaitReason::UartRx => { uart_put_udec(1); }
        ProcessWaitReason::ChildExit => { uart_put_udec(2); }
        ProcessWaitReason::NetRx => { uart_put_udec(3); }
        ProcessWaitReason::Deadline => { uart_put_udec(4); }
        ProcessWaitReason::Signal => { uart_put_udec(5); }
        ProcessWaitReason::UartTx => { uart_put_udec(6); }
    }
    kernel_boot_log(" saved_sp=");
    uart_put_hex(scheduled_process_peek_saved_sp(slot));
    kernel_boot_log(" pages="); uart_put_udec(snapshot.resident_pages);
    kernel_boot_log(" command=");
    kernel_process_monitor_put_command(snapshot);
    kernel_boot_log("\n");
}

// GitHub issue #693 step 5: the exec staging setters take the run guard
// their callers hold (#618's one critical section for a procfs reader).
fn scheduled_process_set_command_line(guard: borrow ProcessRunGuard[lock],
                                      slot: usize, value: []u8,
                                      requested: usize) !{unsafe} {
    let record = scheduled_process_record_locked(guard, slot);
    let mut length: usize = requested;
    if (length > value.len) { length = value.len; }
    if (length > 512) { length = 512; }
    let destination: []u8 = record.command_line as []u8;
    let copied: usize = slice_copy(destination, value);
    record.command_line_length = length;
}

// GitHub issue #693 step 5: the command line is the ps/procfs cache, read
// under the run guard and gone with it. An exec that needs its argv past the
// guard copies it into a page it owns (kernel_syscall_exec_argv_copy).
fn scheduled_process_command_line(guard: borrow ProcessRunGuard[lock],
                                  slot: usize) -> [u8; 512..] @ lock {
    return scheduled_process_record_locked(guard, slot).command_line
        as [u8; 512..];
}

// The parent as a HANDLE and the child as a slot, which looks asymmetric
// and is not. GitHub issue #492: the one caller holds a ProcessHandle for
// the parent, so the generation is there to be spent; the child arrives as
// a ScheduledProcessOwner from the allocation that just produced it, and an
// owner is a linear proof of THAT allocation -- strictly stronger than a
// generation compare, so record_at is the right read for it.
private fn scheduled_process_copy_command_line(parent: borrow ProcessRunning[p],
        child: borrow ScheduledProcessOwner[c]) !{unsafe} {
    let source: *ProcessRecord = scheduled_process_record_running(parent);
    let destination: *ProcessRecord = scheduled_process_record_owned(child);
    destination.command_line_length = source.command_line_length &
                                      PROCESS_COMMAND_LENGTH_MASK;
    for index: usize in 0..<512 {
        destination.command_line[index] = source.command_line[index];
    }
}

private fn scheduled_process_copy_signal_mask(parent: borrow ProcessRunning[p],
        child: borrow ScheduledProcessOwner[c]) !{unsafe} {
    scheduled_process_record_owned(child).signal_mask =
        scheduled_process_record_running(parent).signal_mask;
    scheduled_process_record_owned(child).sigchld_ignored =
        scheduled_process_record_running(parent).sigchld_ignored;
    // Linux: a forked child inherits its parent's handlers.
    scheduled_process_record_owned(child).sigchld_handler =
        scheduled_process_record_running(parent).sigchld_handler;
    scheduled_process_record_owned(child).sigchld_flags =
        scheduled_process_record_running(parent).sigchld_flags;
    scheduled_process_record_owned(child).sigchld_restorer =
        scheduled_process_record_running(parent).sigchld_restorer;
    scheduled_process_record_owned(child).sigchld_action_mask =
        scheduled_process_record_running(parent).sigchld_action_mask;
}

// Linux: a child inherits its parent's affinity mask across fork, and
// execve keeps it, which this record does by surviving the exec.
private fn scheduled_process_copy_affinity_mask(parent: borrow ProcessRunning[p],
        child: borrow ScheduledProcessOwner[c]) !{unsafe} {
    scheduled_process_record_owned(child).affinity_mask =
        scheduled_process_record_running(parent).affinity_mask;
}

// GitHub issue #392: where kernel/kernel/fd_table.tkb keeps this
// process's context handle. It cannot hold it itself without a table
// keyed by process slot, which is the ceiling this is on the way to
// removing -- so the process record holds it, and fd_table asks.
// GitHub issue #693 step 5: the handle is read under the run lock, which is
// what keeps the record alive against reap, and both words in one hold so a
// concurrent set cannot be seen half-written. Taking the lock here is safe
// only because a caller already holding the run guard is rejected at
// compile time (single_instance_lock, #694).
// ProcessPoolHandleWords is defined in kernel/mm/address_space.tkb, which
// is parsed first and holds one in AddressSpaceRoot.

// The one place each pair is read; every authority below passes the
// record it reached.
private fn process_fd_context_words(record: borrow *ProcessRecord)
        -> ProcessPoolHandleWords !{unsafe} {
    let mut words: ProcessPoolHandleWords =
        { record.fd_context, record.fd_context_generation };
    return words;
}

private fn process_image_record_words(record: borrow *ProcessRecord)
        -> ProcessPoolHandleWords !{unsafe} {
    let mut words: ProcessPoolHandleWords =
        { record.image_record, record.image_record_generation };
    return words;
}

fn scheduled_process_fd_context_handle(slot: usize) -> ProcessPoolHandleWords
        !{unsafe} {
    let guard = process_run_lock();
    let mut words: ProcessPoolHandleWords = process_fd_context_words(
        scheduled_process_record_locked(guard, slot));
    process_run_unlock(guard);
    return words;
}

fn scheduled_process_set_fd_context(slot: usize, address: usize,
                                    generation: usize) {
    scheduled_process_record_at(slot).fd_context = address;
    scheduled_process_record_at(slot).fd_context_generation = generation;
}

// For the crash report and DDB, which must not take a lock: the diagnostic
// peek, as the rest of their record reads use.
fn scheduled_process_fd_context_handle_peek(slot: usize)
        -> ProcessPoolHandleWords !{unsafe} {
    let mut words: ProcessPoolHandleWords = {
        scheduled_process_record_peek(slot).fd_context,
        scheduled_process_record_peek(slot).fd_context_generation };
    return words;
}

fn scheduled_process_fd_context_handle_owned(
        owner: borrow ScheduledProcessOwner[process])
        -> ProcessPoolHandleWords !{unsafe} {
    return process_fd_context_words(scheduled_process_record_owned(owner));
}

fn scheduled_process_image_record_handle_owned(
        owner: borrow ScheduledProcessOwner[process])
        -> ProcessPoolHandleWords !{unsafe} {
    return process_image_record_words(scheduled_process_record_owned(owner));
}

// As the fd context's: the slot form reads under the run lock, which a
// caller already holding the run guard cannot reach (#694); the reap reads
// through its owner instead.
fn scheduled_process_image_record_handle(slot: usize) -> ProcessPoolHandleWords
        !{unsafe} {
    let guard = process_run_lock();
    let mut words: ProcessPoolHandleWords = process_image_record_words(
        scheduled_process_record_locked(guard, slot));
    process_run_unlock(guard);
    return words;
}

fn scheduled_process_set_image_record(slot: usize, address: usize,
                                      generation: usize) {
    scheduled_process_record_at(slot).image_record = address;
    scheduled_process_record_at(slot).image_record_generation = generation;
}

// Is this a slot the process table can hold? The question belongs here,
// and asking it by FUNCTION is what lets kernel/mm/address_space.tkb --
// parsed before this file, so unable to name KERNEL_PROCESS_MAX in a
// bound -- stop keeping its own copy of the number (issue #392).
fn scheduled_process_slot_valid(slot: usize) -> bool !{unsafe} {
    // Slot 0 is the bootstrap, whose record is a static and therefore
    // always answerable -- including from kernel_mmu_init, with the MMU
    // off, before the pool exists.
    if (slot == 0) { return true; }
    if (scheduled_process_pool_ready == false) { return false; }
    match intrusive_pool_probe_slot(&scheduled_process_pool, slot) {
        IntrusiveSlotProbe::NoPayload => { return false; }
        IntrusiveSlotProbe::Live(slot_view) => {
            intrusive_view_drop(slot_view);
            return true;
        }
    }
}

// The backing handle read with no authority, for
// address_space_root_for_slot alone: the pre-#693 read, kept until its
// callers move to an authority's mint.
private fn process_backing_words(record: borrow *ProcessRecord)
        -> ProcessPoolHandleWords !{unsafe} {
    let mut words: ProcessPoolHandleWords = {
        record.address_space_backing, record.address_space_backing_generation };
    return words;
}

fn scheduled_process_address_space_backing_handle_bare(slot: usize)
        -> ProcessPoolHandleWords !{unsafe} {
    return process_backing_words(scheduled_process_record_at(slot));
}

// GitHub issue #693 step 5: a process's address-space root, with its
// backing handle read under an authority over the record. These and
// address_space_boot_root are the mints scripts/check_address_space_root_mints.py
// allows besides the transitional address_space_root_for_slot.
fn scheduled_process_address_space_root_owned(
        owner: borrow ScheduledProcessOwner[process]) -> AddressSpaceRoot !{unsafe} {
    return address_space_root_mint(owner.pool_index,
        process_backing_words(scheduled_process_record_owned(owner)));
}

fn scheduled_process_address_space_root_running(
        running: borrow ProcessRunning[process]) -> AddressSpaceRoot !{unsafe} {
    return address_space_root_mint(running.handle.pool_index,
        process_backing_words(scheduled_process_record_running(running)));
}

fn scheduled_process_set_address_space_backing(
        slot: usize, address: usize, generation: usize) {
    scheduled_process_record_at(slot).address_space_backing = address;
    scheduled_process_record_at(slot).address_space_backing_generation =
        generation;
}

fn scheduled_process_record_wait4_status_ptr(slot: usize) -> usize {
    return scheduled_process_record_at(slot).wait4_status_ptr;
}
// One half of a run, named as a struct purely so that the poison fill,
// the guard and the watermark scan keep ordinary checked indexing over a
// region whose address is computed. Nothing reads `bytes` as a whole;
// the struct exists to give `[u8; KERNEL_PROCESS_STACK_SIZE]` a name a
// cast can produce.
//
// Both halves are exactly this size by construction, so one struct
// serves the stack and the region below it. Which one a given cast means
// is stated by the accessor that produces it -- kernel_stack_span versus
// kernel_stack_quarantine_span -- not by the type.
struct KernelStackHalf {
    bytes: [u8; KERNEL_PROCESS_STACK_SIZE];
}

// GitHub issue #377: one KERNEL_STACK_RUN_BYTES page run per slot, kept
// as its base physical address in ProcessRecord.stack_run. 0 means this
// slot has never been backed.
//
// The linear PageRunOwner is consumed at allocation
// (page_run_owner_transfer_index) rather than stored. A linear value
// cannot live in a record like this, and there is nothing for an owner to
// do here in any case: a slot's run is never given back, so there is no
// release path for it to guard.
//
// Never reset by scheduled_process_table_clear() (called several times
// per boot). Keeping the base is what makes a reused slot reuse the SAME
// run instead of allocating a fresh one and leaking the old, which is
// exactly the property growable_pool_ensure's idempotence used to
// provide.

// A run base this file is willing to read through.
//
// Alignment is the invariant everything else rests on: the single-bit
// membership test, the probe's stack-top check, and the containment
// claim all assume the run begins on a KERNEL_STACK_RUN_BYTES boundary.
// A base that is not so aligned is not one of these runs, and reading
// through it would report on unrelated memory -- which is how a first
// RPi5 run under issue #375 produced base=89984, neither page-aligned
// nor above that platform's kernel image.
private fn kernel_stack_run_usable(base: usize) -> bool {
    return base != 0 && base % KERNEL_STACK_RUN_BYTES == 0;
}

// The lowest address this slot's stack may occupy: the run's midpoint.
// 0 for a slot with no usable run, so every caller's existing "0 means
// there is nothing to look at" test still holds.
private fn kernel_stack_bottom(slot: usize)
        -> usize {
    let base: usize = scheduled_process_record_at(slot).stack_run;
    if (kernel_stack_run_usable(base) == false) { return 0; }
    return base + KERNEL_PROCESS_STACK_SIZE;
}

// The stack region itself, [bottom, bottom + KERNEL_PROCESS_STACK_SIZE).
// Callers establish `bottom != 0` first; this file's own accessor is the
// only producer, so the cast is over storage page.tkb has already
// confirmed it owns and has withheld from every other consumer.
private fn kernel_stack_span(bottom: usize) -> *KernelStackHalf !{unsafe} {
    return unsafe { bottom as *KernelStackHalf };
}

// The region BELOW the stack, which belongs to the same run and to
// nothing else. Poisoned with the stack and never written by anything
// that is behaving: a disturbed byte here is an overflow that already
// happened, as opposed to a stack merely standing at its own bottom.
private fn kernel_stack_quarantine_span(bottom: usize)
        -> *KernelStackHalf !{unsafe} {
    return unsafe { (bottom - KERNEL_PROCESS_STACK_SIZE) as *KernelStackHalf };
}

// The shared rollback implementation produces a plain handle internally.
// Its two public entry points wrap that value in distinct nominal types, so
// code acquiring an ordinary pooled process cannot pass it to a bootstrap-only
// operation. GitHub issue #415.
//
// The distinction ends explicitly at scheduled_*_process_handle. A full
// split through ProcessHandle would duplicate the scheduler API rather than
// strengthen it: the pre-split call graph had 103 ProcessHandle type uses and
// 123 pool_index field uses, and both kinds must enter the same ready/running/
// blocked lifecycle after allocation. The bootstrap-only storage and release
// rules therefore remain at their existing process/address-space/image
// boundaries; moving all of them onto separate APIs would require parallel
// scheduler and VM surfaces. The type pays for the boundary where the
// historical bug occurred, not for those parallel implementations.
must_use variant ScheduledProcessAllocResult {
    Full;
    Allocated(ProcessHandle);
}

struct PooledProcessHandle {
    private handle: ProcessHandle;
}

struct BootstrapProcessHandle {
    private handle: ProcessHandle;
}

must_use variant ScheduledPooledProcessAllocResult {
    Full;
    Allocated(PooledProcessHandle);
}

must_use variant ScheduledBootstrapProcessAllocResult {
    Full;
    Allocated(BootstrapProcessHandle);
}

fn scheduled_pooled_process_handle(pooled: PooledProcessHandle)
        -> ProcessHandle {
    return pooled.handle;
}

fn scheduled_bootstrap_process_handle(bootstrap: BootstrapProcessHandle)
        -> ProcessHandle {
    return bootstrap.handle;
}

// The case keeps the name of what was taken, a Ready process; the token it
// carries is Startable, because taking it is where its stack was checked.
must_use variant ScheduledProcessReadyTakeResult {
    Missing;
    Ready(exists process: usize.
          (ScheduledProcessOwner[process],
           ScheduledProcessState[process, ProcessState::Startable]));
}

// A Ready process whose stack was looked at once more: either no other core
// stands on it, and it is Startable, or one does, and it comes back Ready.
must_use variant ScheduledProcessStartCheck[process: usize] {
    Standing(ScheduledProcessState[process, ProcessState::Ready]);
    Startable(ScheduledProcessState[process, ProcessState::Startable]);
}

must_use variant ScheduledProcessConstructingTakeResult {
    Missing;
    Constructing(exists process: usize.
        (ScheduledProcessOwner[process],
         ScheduledProcessState[process, ProcessState::Constructing]));
}

must_use variant ScheduledProcessExitedTakeResult {
    Missing;
    Exited(exists process: usize.
           (ScheduledProcessOwner[process],
            ScheduledProcessState[process, ProcessState::Reapable]));
}

must_use variant ScheduledProcessRunningTakeResult {
    Missing;
    Running(exists process: usize.
            (ScheduledProcessOwner[process],
             ScheduledProcessState[process, ProcessState::Running]));
}

must_use variant ScheduledProcessBlockedTakeResult {
    Missing;
    Blocked(exists process: usize.
            (ScheduledProcessOwner[process],
             ScheduledProcessState[process, ProcessState::Blocked]));
}

fn scheduled_process_owner_new(
        slot: usize,
        generation: usize @ process) -> ScheduledProcessOwner[process] {
    let mut owner: ScheduledProcessOwner[process] = { slot, generation };
    return owner;
}

fn scheduled_process_owner_drop(
        owner: sink ScheduledProcessOwner[process]) {}

fn scheduled_process_state_drop(
        state: sink ScheduledProcessState[process, process_state]) {}

// Where a stack is proved free: scheduled_process_ready_take,
// scheduled_process_start_check, scheduled_process_restart_check and
// scheduled_process_exited_take are the only functions that build these two
// states, each after reading the record's stack owner under the run lock.
// The read itself is the trusted step; the type says that nobody skipped it.
private fn scheduled_process_startable_state(
        owner: borrow ScheduledProcessOwner[process])
        -> ScheduledProcessState[process, ProcessState::Startable] {
    let mut state: ScheduledProcessState[process, ProcessState::Startable] =
        { owner.pool_index };
    return state;
}

private fn scheduled_process_reapable_state(
        owner: borrow ScheduledProcessOwner[process])
        -> ScheduledProcessState[process, ProcessState::Reapable] {
    let mut state: ScheduledProcessState[process, ProcessState::Reapable] =
        { owner.pool_index };
    return state;
}

fn scheduled_process_running_state(
        owner: borrow ScheduledProcessOwner[process])
        -> ScheduledProcessState[process, ProcessState::Running] {
    let mut state: ScheduledProcessState[process, ProcessState::Running] =
        { owner.pool_index };
    return state;
}

fn scheduled_process_blocked_state(
        owner: borrow ScheduledProcessOwner[process])
        -> ScheduledProcessState[process, ProcessState::Blocked] {
    let mut state: ScheduledProcessState[process, ProcessState::Blocked] =
        { owner.pool_index };
    return state;
}

fn scheduled_process_exited_state(
        owner: borrow ScheduledProcessOwner[process])
        -> ScheduledProcessState[process, ProcessState::Exited] {
    let mut state: ScheduledProcessState[process, ProcessState::Exited] =
        { owner.pool_index };
    return state;
}

// GitHub issue #693 step 4: the record an owner stands for, tied to the
// owner. Whoever holds the owner of a process is what keeps its record from
// being reaped under it (the run guard is held for every transition that
// takes or gives one), so the pointer lives no longer than the owner.
fn scheduled_process_record_owned(owner: borrow ScheduledProcessOwner[process])
        -> *ProcessRecord @ process !{unsafe} {
    return scheduled_process_record_at(owner.pool_index);
}

// The pool slot an owner stands for, for the deliveries that write into the
// frame of the process the owner names and need its record as well.
fn scheduled_process_owner_slot(
        owner: borrow ScheduledProcessOwner[process]) -> usize {
    return owner.pool_index;
}

// The frame this process parked when it last left the CPU, indexed by the
// process whose owner is given. This is the saved-frame mint's only caller:
// what stays trusted is that the record's saved_sp really points at that
// process's frame, and the assembly that wrote it.
fn scheduled_process_saved_frame(
        owner: borrow ScheduledProcessOwner[process]) -> FrameRef[process] {
    return frame_ref_from_saved(
        scheduled_process_record_owned(owner).saved_sp,
        owner.generation);
}

// Does this handle still name the process it was minted for? What the
// take path used to prove by finding an owner parked under the same pair,
// asked of the SlotMap directly.
fn scheduled_process_handle_matches(handle: ProcessHandle) -> bool {
    if (handle.pool_index == 0) {
        return scheduled_process_boot_live &&
               handle.generation == scheduled_process_boot_generation;
    }
    if (scheduled_process_pool_ready == false) { return false; }
    return intrusive_pool_matches_untrusted(
        &scheduled_process_pool, handle.pool_index, handle.generation);
}

// A put is a drop: there is nowhere to put an owner back to.
fn scheduled_process_release(
        owner: sink ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, process_state]) {
    scheduled_process_state_drop(state);
    scheduled_process_owner_drop(owner);
}

fn scheduled_process_table_init() !{unsafe} {
    scheduled_process_pool_init();
    // AArch64 requires SP to be 16-byte aligned, and
    // scheduled_process_alloc sets saved_sp to the run's END. The run
    // base is aligned to the whole run, so the size is what has to
    // divide (issue #373).
    static_assert(KERNEL_PROCESS_STACK_SIZE % 16 == 0,
                  "KERNEL_PROCESS_STACK_SIZE must keep saved_sp 16-byte aligned");
    // The one-bit overflow test is a statement about the run's shape, so
    // state it here rather than leaving it implied by two `* 2`s.
    static_assert(KERNEL_STACK_RUN_BYTES == KERNEL_PROCESS_STACK_SIZE * 2,
                  "the stack must be exactly half its run, or bit-testing an address does not decide which half it is in");
    // page_alloc_contiguous only promises alignment for a power-of-two
    // run, and the promise is the whole basis of the test above.
    static_assert(KERNEL_STACK_RUN_PAGES == 8,
                  "KERNEL_STACK_RUN_PAGES must be a power of two for page_alloc_contiguous to align the run");
    // The generated exception-entry check tests exactly this bit, and a
    // wrong shift would test some unrelated address bit on every
    // exception this kernel takes.
    static_assert(1 << KERNEL_STACK_SHIFT == KERNEL_PROCESS_STACK_SIZE,
                  "KERNEL_STACK_SHIFT must be log2(KERNEL_PROCESS_STACK_SIZE)");
    // GitHub issue #367: a process slot index is ONE identity, used as the
    // array key by four separate tables. Three files carried prose saying
    // their constant "must match" this one, and nothing checked it -- so
    // the agreement was a convention, and a convention between four
    // separately-written literals is the shape that goes wrong silently
    // (see issue #286's incident for what that costs). It is a build
    // error now.
    //
    // These being equal is also the reason none of those tables is a pool
    // in its own right: they are per-process-slot state, not independently
    // allocated things, and giving any one of them its own identity is a
    // different change from swapping a pool primitive.
    scheduled_process_release_every_process();
}

// The fresh state of one record, for the bootstrap's static -- a pool
// record is destroyed rather than reset, so this is the only one that has
// to be written back to zero. stack_run is deliberately NOT cleared: the
// bootstrap keeps its run for the life of the kernel, as it always did.
private fn scheduled_process_record_reset(slot: usize) !{unsafe} {
    let record: *ProcessRecord = scheduled_process_record_at(slot);
    record.pid = 0;
    record.session_id = 0;
    record.start_time_ticks = 0;
    record.command_line_length = 0;
    record.saved_sp = 0;
    record.stack_owner_cpu = PROCESS_STACK_UNOWNED;
    record.state = ProcessSlotState::Free;
    process_wait_clear(&record.wait);
    record.pending_block_reason = ProcessWaitReason::None;
    record.deadline_ticks = 0;
    record.signal_mask = 0;
    record.pending_signals = 0;
    record.sigwait_set = 0;
    record.sigchld_ignored = false;
    record.sigchld_handler = 0;
    record.sigchld_flags = 0;
    record.sigchld_restorer = 0;
    record.sigchld_action_mask = 0;
    record.sigsuspend_saved_mask = 0;
    record.sigsuspend_mask_saved = false;
    record.sigwait_suspend = false;
    record.deadline_result = 0;
    record.wait4_status_ptr = 0;
    record.wait4_pid = 0;
    record.has_parent = false;
    record.has_first_child = false;
    record.has_next_sibling = false;
    record.last_reaped_pid = 0;
    record.exit_status = 0;
    record.exec_image_live = false;
    scheduled_process_record_reset_syscall_state(record);
}

// Everything scheduled_process_reap does for one process, done for every
// live one. Slot 0 is visited whether or not the bootstrap is live,
// because its per-process resources (an fd context from
// kernel_syscall_process_configure, an image record) can outlive the
// process the way the static record itself does.
private fn scheduled_process_release_every_process() !{unsafe} {
    let activity_before: KernelActivity =
        kernel_activity_enter(KernelActivity::ReleaseEveryProcess);
    scheduled_process_pool_init();
    let mut cursor = scheduled_process_first_pool_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let next = scheduled_process_next_slot(slot);
                scheduled_process_release_slot_resources(slot);
                let removal_guard = process_run_lock();
                scheduled_process_slot_remove(removal_guard, slot);
                process_run_unlock(removal_guard);
                cursor = next;
            }
        }
    }
    scheduled_process_release_slot_resources(0);
    scheduled_process_record_reset(0);
    scheduled_process_boot_live = false;
    // Back to zero minted, so the next process created is pid 1 again.
    scheduled_process_pid_counter_restore(0);
    kernel_activity_leave(activity_before);
}

// No exec teardown here, deliberately: a whole-world reset is not a
// process exiting, and address_space_release_root has already freed the
// mappings an installed image would name. Adding one would count reaps
// that no process performed.
private fn scheduled_process_release_slot_resources(slot: usize) !{unsafe} {
    unified_fd_context_release(slot);
    address_space_release_root(address_space_root_for_slot(slot));
    // GitHub issue #414: the ROOT's pages and the RECORD that named them
    // are two things, and only the first was being given back.
    address_space_backing_release(address_space_root_for_slot(slot));
    process_image_record_release(slot);
}

// Gives a slot back. The bootstrap's record is a static and is only
// marked free; a pool record is removed, and its kernel stack run is
// parked rather than freed (see scheduled_process_spare).
//
// GitHub issue #482: under the process-run lock, by type. Every CPU's
// scheduler walk and the interrupt-side wakes read records they do not own
// under that lock, through scheduled_process_record_at's escaped pointer;
// a removal outside it could scrub and free a record between one of those
// probes and its read. See scheduled_process_reap.
private fn scheduled_process_slot_remove(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        slot: usize) !{unsafe} {
    if (slot == 0) {
        scheduled_process_boot_live = false;
        return;
    }
    let mut generation: usize = 0;
    let mut address: IntrusiveSlotAddress = intrusive_slot_address_none();
    match intrusive_pool_probe_slot(&scheduled_process_pool, slot) {
        IntrusiveSlotProbe::NoPayload => { return; }
        IntrusiveSlotProbe::Live(slot_view) => {
            address = intrusive_view_slot(slot_view);
            generation = intrusive_view_generation(slot_view);
            intrusive_view_drop(slot_view);
        }
    }
    scheduled_process_park_stack_run(
        scheduled_process_record_locked(guard, slot).stack_run);
    let owner = intrusive_owner_new(&scheduled_process_pool, address,
                                    generation);
    let guard = intrusive_pool_lock(&scheduled_process_pool);
    let (ok, reason) = intrusive_remove_outcome(
        intrusive_pool_remove(&scheduled_process_pool, guard, owner));
    intrusive_pool_unlock(&scheduled_process_pool, guard);
    if (ok == false) {
        kernel_boot_log("process table: releasing a record -- ");
        kernel_boot_log(reason);
        kernel_boot_log("\n");
    }
}

// Parking, not freeing: see scheduled_process_spare's own note
// for the measurement that says why. Parking a second run gives the first
// one back, which is safe because it belonged to a process reaped before
// this one -- checked anyway, since the cost of being wrong is the
// allocator handing out memory a live stack is standing on.
private fn scheduled_process_park_stack_run(base: usize) !{unsafe} {
    if (base == 0) { return; }
    let guard = scheduled_process_spare_lock(
        &scheduled_process_spare.mutex);
    let previous: SpareStackRunValue = stable_replace(
        guard, &scheduled_process_spare.mutex,
        scheduled_process_spare.value, SpareStackRunValue::Empty);
    match previous {
        SpareStackRunValue::Empty => {
            match page_run_reclaim_transferred_physical(
                    base, KERNEL_STACK_RUN_PAGES) {
                PageRunReclaimResult::Invalid => {}
                PageRunReclaimResult::Reclaimed(incoming) => {
                    let displaced: SpareStackRunValue = stable_replace(
                        guard, &scheduled_process_spare.mutex,
                        scheduled_process_spare.value,
                        SpareStackRunValue::Held(incoming));
                    match displaced {
                        SpareStackRunValue::Empty => {}
                        SpareStackRunValue::Held(impossible) => {
                            page_run_free(impossible);
                        }
                    }
                }
            }
        }
        SpareStackRunValue::Held(old) => {
            let old_base: usize = page_run_physical_address(old);
            if (old_base == base) {
                let displaced: SpareStackRunValue = stable_replace(
                    guard, &scheduled_process_spare.mutex,
                    scheduled_process_spare.value,
                    SpareStackRunValue::Held(old));
                match displaced {
                    SpareStackRunValue::Empty => {}
                    SpareStackRunValue::Held(impossible) => {
                        page_run_free(impossible);
                    }
                }
            } else {
                let sp: usize = kernel_stack_read_sp_el1();
                if (sp >= old_base &&
                    sp < old_base + KERNEL_STACK_RUN_BYTES) {
                    let displaced: SpareStackRunValue = stable_replace(
                        guard, &scheduled_process_spare.mutex,
                        scheduled_process_spare.value,
                        SpareStackRunValue::Held(old));
                    match displaced {
                        SpareStackRunValue::Empty => {}
                        SpareStackRunValue::Held(impossible) => {
                            page_run_free(impossible);
                        }
                    }
                    page_run_transferred_release_physical(
                        base, KERNEL_STACK_RUN_PAGES);
                } else {
                    match page_run_reclaim_transferred_physical(
                            base, KERNEL_STACK_RUN_PAGES) {
                        PageRunReclaimResult::Invalid => {
                            page_run_free(old);
                        }
                        PageRunReclaimResult::Reclaimed(incoming) => {
                            let displaced: SpareStackRunValue = stable_replace(
                                guard, &scheduled_process_spare.mutex,
                                scheduled_process_spare.value,
                                SpareStackRunValue::Held(incoming));
                            match displaced {
                                SpareStackRunValue::Empty => {}
                                SpareStackRunValue::Held(impossible) => {
                                    page_run_free(impossible);
                                }
                            }
                            page_run_free(old);
                        }
                    }
                }
            }
        }
    }
    scheduled_process_spare_unlock(
        guard, &scheduled_process_spare.mutex);
}

private fn scheduled_process_take_spare_stack_run() -> usize !{unsafe} {
    let guard = scheduled_process_spare_lock(
        &scheduled_process_spare.mutex);
    let previous: SpareStackRunValue = stable_replace(
        guard, &scheduled_process_spare.mutex,
        scheduled_process_spare.value, SpareStackRunValue::Empty);
    match previous {
        SpareStackRunValue::Empty => {
            scheduled_process_spare_unlock(
                guard, &scheduled_process_spare.mutex);
            return 0;
        }
        SpareStackRunValue::Held(owner) => {
            let base: usize = page_run_physical_address(owner);
            let sp: usize = kernel_stack_read_sp_el1();
            if (sp >= base && sp < base + KERNEL_STACK_RUN_BYTES) {
                let displaced: SpareStackRunValue = stable_replace(
                    guard, &scheduled_process_spare.mutex,
                    scheduled_process_spare.value,
                    SpareStackRunValue::Held(owner));
                match displaced {
                    SpareStackRunValue::Empty => {}
                    SpareStackRunValue::Held(impossible) => {
                        page_run_free(impossible);
                    }
                }
                scheduled_process_spare_unlock(
                    guard, &scheduled_process_spare.mutex);
                return 0;
            }
            let index = page_run_owner_transfer_index(owner);
            scheduled_process_spare_unlock(
                guard, &scheduled_process_spare.mutex);
            return usable_ram_start + index * PAGE_SIZE;
        }
    }
}

fn scheduled_process_table_clear() !{unsafe} {
    // Reset can enter while a child root is in TTBR0_EL1. Select the
    // permanent bootstrap root before releasing any nonzero backing record.
    process_image_activate_root(0);
    scheduled_process_release_every_process();
}

// GitHub issue #392: a process record is a pool allocation now, so
// "Full" no longer means "the sixteenth slot was taken" -- it means the
// page allocator is empty. The rollback chain is unchanged in shape: every
// resource acquired below is given back on every later failure.
// GitHub issue #580: every caller of this is a probe -- the schedule
// contention race, the slot-acquire helper and the table probe -- and none
// of them installs an EL0 frame. They do want the record READY, because
// Ready is what their own ready_take consumes and, for the contention
// probe, the state under test.
//
// So the record says both things itself: Ready, and an affinity mask no CPU
// satisfies. That is exactly the pair the old per-pid placement rule used to
// produce by accident, and having the record carry it is what lets the
// default placement change without a probe's private process becoming
// something a peer will try to resume.
fn scheduled_process_alloc() -> ScheduledPooledProcessAllocResult !{unsafe} {
    match scheduled_process_alloc_pending(false) {
        ScheduledPooledProcessAllocResult::Full => {
            return ScheduledPooledProcessAllocResult::Full;
        }
        ScheduledPooledProcessAllocResult::Allocated(pooled) => {
            let mut handle: ProcessHandle =
                scheduled_pooled_process_handle(pooled);
            scheduled_process_probe_publish_ready(handle);
            let mut published: PooledProcessHandle = { handle };
            return ScheduledPooledProcessAllocResult::Allocated(published);
        }
    }
}

// A process is not schedulable until its frame, VM and descriptors are
// installed. It must never pass through Ready while another CPU can select
// it.
//
// GitHub issue #580: the flag says whether this record is RUNNABLE on
// return, and it used to say `clone_pending` -- which named the one caller
// that answered no rather than the property every caller has to answer.
// The bootstrap is the only entry point that hands back a record something
// is about to run; a clone's frame is installed later, and every other
// caller is a probe that never runs its record at all. Those two were
// indistinguishable while the question was "is this a clone".
private fn scheduled_process_alloc_pending(runnable_now: bool)
        -> ScheduledPooledProcessAllocResult !{unsafe} {
    scheduled_process_pool_init();
    let mut slot: usize = 0;
    let mut generation: usize = 0;
    let guard = intrusive_pool_lock(&scheduled_process_pool);
    let inserted =
        intrusive_pool_insert_zeroed(&scheduled_process_pool, guard);
    intrusive_pool_unlock(&scheduled_process_pool, guard);
    match inserted {
        IntrusivePoolInsertResult::OutOfMemory => {
            kernel_boot_log_resource_exhausted(
                "physical page allocator" as *u8,
                page_allocator_total_count());
            return ScheduledPooledProcessAllocResult::Full;
        }
        IntrusivePoolInsertResult::Allocated(pool_owner) => {
            slot = intrusive_slot_address_identity(
                intrusive_owner_slot(pool_owner));
            generation = intrusive_owner_generation(pool_owner);
            intrusive_owner_drop(pool_owner);
        }
    }
    match scheduled_process_alloc_finish(slot, generation, runnable_now) {
        ScheduledProcessAllocResult::Full => {
            return ScheduledPooledProcessAllocResult::Full;
        }
        ScheduledProcessAllocResult::Allocated(handle) => {
            let mut pooled: PooledProcessHandle = { handle };
            return ScheduledPooledProcessAllocResult::Allocated(pooled);
        }
    }
}

// The bootstrap process: the static record at slot 0, asked for by name.
//
// It used to be "whoever allocates first gets it", which is true of the
// real boot path and false of anything else that allocates a process --
// and a probe that acquires one silently took the bootstrap's record,
// used it, and gave it back WITH slot 0's fd context and image record
// attached, breaking a later probe that had set those up. One caller
// wants the bootstrap; it says so.
fn scheduled_process_alloc_bootstrap() -> ScheduledBootstrapProcessAllocResult
        !{unsafe} {
    scheduled_process_pool_init();
    if (scheduled_process_boot_live) {
        return ScheduledBootstrapProcessAllocResult::Full;
    }
    scheduled_process_boot_generation = scheduled_process_boot_generation + 1;
    scheduled_process_boot_live = true;
    match scheduled_process_alloc_finish(
            0, scheduled_process_boot_generation, true) {
        ScheduledProcessAllocResult::Full => {
            return ScheduledBootstrapProcessAllocResult::Full;
        }
        ScheduledProcessAllocResult::Allocated(handle) => {
            let mut bootstrap: BootstrapProcessHandle = { handle };
            return ScheduledBootstrapProcessAllocResult::Allocated(bootstrap);
        }
    }
}

// Everything a new process needs once it has a record: the same rollback
// chain for both entry points above, so a bootstrap and an ordinary
// process cannot drift apart in what they are given.
private fn scheduled_process_alloc_finish(slot: usize, generation: usize,
                                         runnable_now: bool)
        -> ScheduledProcessAllocResult !{unsafe} {
    // GitHub issue #693 step 4: the process being created is not yet
    // visible to anyone else, so this path owns it; its record is read
    // through that ownership.
    let creating = scheduled_process_owner_new(slot, generation);
    // A run the last reaped process left behind, before asking the page
    // allocator for another one. This is also what preserves the old
    // "a reused slot reuses its run" behaviour now that there are no
    // slots to reuse: a new process reuses a dead one's run.
    if (scheduled_process_record_owned(creating).stack_run == 0) {
        let spare: usize = scheduled_process_take_spare_stack_run();
        if (spare != 0) {
            scheduled_process_record_owned(creating).stack_run = spare;
        }
    }
    if (scheduled_process_record_owned(creating).stack_run == 0) {
        match page_alloc_contiguous(KERNEL_STACK_RUN_PAGES,
                                  PageOwnerTag::KernelStack) {
            PageRunAllocResult::OutOfMemory => {
                kernel_boot_log_resource_exhausted(
                    "physical page allocator" as *u8,
                    page_allocator_total_count());
                let rollback_guard = process_run_lock();
                scheduled_process_slot_remove(rollback_guard, slot);
                process_run_unlock(rollback_guard);
                { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
            }
            PageRunAllocResult::Allocated(run) => {
                let base: usize = page_run_physical_address(run);
                if (kernel_stack_run_usable(base)) {
                    page_run_owner_transfer_index(run);
                    scheduled_process_record_owned(creating).stack_run = base;
                } else {
                    // An unaligned run from an allocator that promises
                    // alignment is an invariant break, not a resource
                    // limit. Give it back and refuse the slot: a stack
                    // built on it would answer the one-bit membership
                    // test with a lie, which is worse than not having
                    // the slot.
                    page_run_free(run);
                    kernel_boot_log_resource_exhausted(
                        "kernel stack run (unaligned; refused)" as *u8,
                        KERNEL_STACK_RUN_PAGES);
                    let rollback_guard = process_run_lock();
                    scheduled_process_slot_remove(rollback_guard, slot);
                    process_run_unlock(rollback_guard);
                    { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
                }
            }
        }
    }
    match address_space_ensure_root(slot) {
        AddressSpaceEnsureResult::Ok => {}
        AddressSpaceEnsureResult::SlotOutOfRange => {
            address_space_backing_release(scheduled_process_address_space_root_owned(creating));
            let rollback_guard = process_run_lock();
            scheduled_process_slot_remove(rollback_guard, slot);
            process_run_unlock(rollback_guard);
            { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
        }
        AddressSpaceEnsureResult::OutOfMemory => {
            kernel_boot_log_resource_exhausted(
                "physical page allocator" as *u8,
                page_allocator_total_count());
            // GitHub issue #414: a backing RECORD exists by now even
            // though the root does not -- address_space_ensure_root asks
            // for the record before it asks the page allocator for the
            // tables. Releasing it here is the difference between a
            // refused allocation that costs nothing and one that costs a
            // pool slot per attempt. It must come before the process
            // record goes, because the handle naming it lives there.
            address_space_backing_release(scheduled_process_address_space_root_owned(creating));
            let rollback_guard = process_run_lock();
            scheduled_process_slot_remove(rollback_guard, slot);
            process_run_unlock(rollback_guard);
            { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
        }
    }
    // GitHub issue #392: the fd context is a per-process resource like
    // the stack run and the address-space root above, so it is acquired
    // here, in the same rollback chain, rather than materialising on
    // first use inside kernel/kernel/fd_table.tkb. A live slot therefore
    // always has one, which is what lets every entry point there test
    // "does this process have an fd table" instead of "is this index in
    // range".
    if (process_image_record_ensure(slot) == false) {
        kernel_boot_log_resource_exhausted(
            "physical page allocator" as *u8,
            page_allocator_total_count());
        address_space_release_root(scheduled_process_address_space_root_owned(creating));
        address_space_backing_release(scheduled_process_address_space_root_owned(creating));
        let rollback_guard = process_run_lock();
        scheduled_process_slot_remove(rollback_guard, slot);
        process_run_unlock(rollback_guard);
        { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
    }
    if (unified_fd_context_ensure(slot) == false) {
        kernel_boot_log_resource_exhausted(
            "physical page allocator" as *u8,
            page_allocator_total_count());
        process_image_record_release(slot);
        address_space_release_root(scheduled_process_address_space_root_owned(creating));
        address_space_backing_release(scheduled_process_address_space_root_owned(creating));
        let rollback_guard = process_run_lock();
        scheduled_process_slot_remove(rollback_guard, slot);
        process_run_unlock(rollback_guard);
        { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
    }
    let bottom: usize = kernel_stack_bottom(slot);
    // Unreachable given the branch above stored only a base
    // kernel_stack_run_usable accepted, but the two casts below are the
    // ones that must never be handed 0, so the guarantee is checked where
    // it is used rather than argued from ten lines away.
    if (bottom == 0) {
        unified_fd_context_release(slot);
        process_image_record_release(slot);
        address_space_release_root(scheduled_process_address_space_root_owned(creating));
        address_space_backing_release(scheduled_process_address_space_root_owned(creating));
        let rollback_guard = process_run_lock();
        scheduled_process_slot_remove(rollback_guard, slot);
        process_run_unlock(rollback_guard);
        { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Full; scheduled_process_owner_drop(creating); return __creating_result; }
    }
    scheduled_process_record_owned(creating).saved_sp =
        bottom + KERNEL_PROCESS_STACK_SIZE;
    scheduled_process_record_owned(creating).stack_owner_cpu =
        PROCESS_STACK_UNOWNED;
    // GitHub issue #392: the one place a pid is minted. Past every branch
    // that can still refuse the slot.
    scheduled_process_record_owned(creating).pid = scheduled_process_mint_pid();
    scheduled_process_record_owned(creating).session_id = 0;
    let counter_frequency: usize = read_cntfrq() as usize;
    let tick_divisor: usize = counter_frequency / 100;
    if (tick_divisor != 0) {
        scheduled_process_record_owned(creating).start_time_ticks =
            (read_cntpct() as usize) / tick_divisor;
    } else {
        scheduled_process_record_owned(creating).start_time_ticks = 0;
    }
    scheduled_process_record_reset_syscall_state(
        scheduled_process_record_owned(creating));
    // GitHub issues #375/#376: a reused run would otherwise inherit the
    // previous occupant's marks. Re-poison BOTH halves here so the guard,
    // the high-water measurement and the overflow depth all answer about
    // THIS process.
    let stack: *KernelStackHalf = kernel_stack_span(bottom);
    let below: *KernelStackHalf = kernel_stack_quarantine_span(bottom);
    for i: usize in 0..<KERNEL_PROCESS_STACK_SIZE {
        stack.bytes[i] = KERNEL_STACK_POISON;
        below.bytes[i] = KERNEL_STACK_POISON;
    }
    // GitHub issue #580: Constructing unless the caller says this record is
    // runnable now, which only the bootstrap does. The invariant above was
    // already written down and the clone path was the only one keeping it.
    //
    // A probe's fresh allocation published Ready with no EL0 frame anywhere.
    // What stopped a CPU running it was not that invariant but the placement
    // rule: `kernel_process_next_ready` walks the CALLER's process chain, so
    // core 0 never reached a record with no parent, and the secondary walks
    // every slot but refused any pid no fixture had registered. Flipping the
    // default placement removes the second half, and the first thing the
    // secondary did with its new freedom was resume the schedule-contention
    // probe's private process, which has no frame: `oops: fail-stop seq=1
    // cpu=1` twelve lines into the boot.
    //
    // Making this Constructing for every non-clone caller was the first
    // attempt and it is wrong in a way worth recording: the bootstrap comes
    // through the same branch, and it IS a real process about to run init.
    // The boot then died at the first execve instead. The flag has to name
    // the property rather than the caller.
    if (runnable_now) {
        scheduled_process_record_owned(creating).state = ProcessSlotState::Ready;
    } else {
        scheduled_process_record_owned(creating).state =
            ProcessSlotState::Constructing;
    }
    let mut handle: ProcessHandle = { slot, generation };
    { let mut __creating_result: ScheduledProcessAllocResult = ScheduledProcessAllocResult::Allocated(handle); scheduled_process_owner_drop(creating); return __creating_result; }
}

// GitHub issue #479 Group B: the scheduler's lock. Linux calls it
// rq->lock and it is here for the reason Linux's is.
//
// WHAT IS ALREADY RIGHT, because it explains why this was easy to miss.
// ProcessSlotState distinguishes Ready from Running, and
// kernel_process_next_ready only ever selects a Ready successor -- so two
// cores cannot pick the same process off the chain. There is no missing
// runqueue.
//
// WHAT IS NOT. scheduled_process_ready_take reads the state, finds Ready,
// and then mints the linear tokens that stand for the claim. Two cores
// doing that on one handle both find Ready and both get tokens, and the
// linear types are satisfied on each core SEPARATELY -- each really did
// consume its own Ready and produce its own Running. The ownership
// discipline is sound per-core and says nothing across cores, because the
// race is between a read and a mint it has no reason to think are one
// step.
//
// AND THE WALK. kernel_process_next_ready follows parent/first_child/
// next_sibling, and clone and child_exit splice exactly those links. A
// walk concurrent with a splice can follow a link into a record being
// torn down -- so the walk and the take are ONE critical section. Locking
// them separately would turn the race into a livelock (select a successor,
// find it gone, return) rather than fixing it.
//
// Its own global, never a field, for the reason kernel/mm/page.tkb's is.
// No mutex_init: a global Mutex is free from .bss and mutex_init
// FORCE-FREES. See kernel/lib/mutex.tkb.
//
// LOCK ORDER: this is the OUTERMOST lock. run -> fd -> pool -> page, with
// asid a leaf. Checked, not assumed: nothing on the transition path takes
// a pool lock (scheduled_process_record_at reaches the pool through
// intrusive_pool_probe_slot, a WALK, which takes no guard -- issue #482);
// clone takes run and then the pool's, which is run -> pool; and
// Scheduler activation drops this lock before ASID preparation. Once a
// prepared activation exists, commit reacquires the run lock and reaches only
// the non-allocating ASID-current check before changing TTBR0.
private let mut scheduled_process_run_lock: Mutex;

// THREADED, NOT ACQUIRED INTERNALLY, and that is the decision worth
// reading. Eight functions here perform a state transition and several
// call each other -- kernel_process_execution_reset alone has seven
// callers in this file. If each acquired the lock itself, whether two of
// them ever nest would be answered by reading, and being wrong is a HANG:
// Mutex has no owner and no recursion count, so it cannot tell "another
// core holds it" from "I hold it" (kernel/lib/mutex.tkb says so).
//
// Taking the guard as a PARAMETER makes self-deadlock unwritable. Whoever
// is at the top acquires once and the compiler carries it down every path,
// including the ones a reader would have missed. It also pushes the
// parameter out into syscall.tkb and the test drivers, which is the point:
// those are the boundaries where the lock belongs (syscall entry, timer
// entry), and having the compiler name them beats deriving the list by
// hand.
//
// `[lock: addr]` is the identity of the mutex it came from, so another
// container's guard is a static value mismatch. Linear, so no path can
// forget to give it back.
linear struct ProcessRunGuard[lock: addr] {
    private flags: usize;
}

// mutex_acquire, not pool_lock_acquire: the tag pool_lock takes registers
// the acquire in linux_user's finite lock-ORDER table, and this is not a
// pool lock. See kernel/lib/intrusive_pool.tkb's tag counter for what
// putting a non-pool in that table cost.
fn process_run_lock() -> ProcessRunGuard[scheduled_process_run_lock]
        !{acquires_lock_40_process_run, single_instance_lock,
          lock_guard_40_process_run,
          irq_masking_guard} {
    let mut guard: ProcessRunGuard[scheduled_process_run_lock] =
        { mutex_acquire(&scheduled_process_run_lock) };
    // GitHub issue #606: what changed while nobody held the lock.
    if (protocol_trace_is_active()) {
        kernel_process_protocol_observe(true);
    }
    return guard;
}

fn process_run_unlock(guard: sink ProcessRunGuard[scheduled_process_run_lock]) {
    // GitHub issue #606: this hold's step, before anyone else can take one.
    if (protocol_trace_is_active()) {
        kernel_process_protocol_observe(false);
    }
    mutex_release(&scheduled_process_run_lock, guard.flags);
}

// Phase 1 of kernel/kernel/schedule_contention_evidence.tkb, and nothing
// else. It mints a guard WITHOUT acquiring, which is exactly the thing the
// guard exists to prevent -- so that the probe can produce the race before
// the lock and show that the lock removes it.
//
// That pair is not optional caution. A probe that only ran the locked
// phase would go quietly green the day the window stopped reproducing --
// the timing shifts, the window closes -- and would then assert nothing
// while looking like it asserted something.
// kernel/kernel/freelist_contention_evidence.tkb carries the same pair for
// the same reason.
//
// `unsafe`, so it is counted in the trusted base and any use outside that
// probe is visible in the inventory rather than only in review.
fn process_run_guard_forge_unlocked()
        -> ProcessRunGuard[scheduled_process_run_lock] !{unsafe} {
    let mut guard: ProcessRunGuard[scheduled_process_run_lock] = { 0 };
    return guard;
}

// Consumes a forged guard. It holds nothing, so there is nothing to
// release -- but it is linear, so it still has to be given somewhere, and
// the probe cannot simply drop it.
fn process_run_guard_discard_unlocked(
        guard: sink ProcessRunGuard[scheduled_process_run_lock]) !{unsafe} {}

fn scheduled_process_ready_take(guard: borrow ProcessRunGuard[lock],
                                handle: ProcessHandle)
        -> ScheduledProcessReadyTakeResult {
    if (scheduled_process_state_of(handle) !=
            ProcessSlotState::Ready) {
        return ScheduledProcessReadyTakeResult::Missing;
    }
    if (scheduled_process_handle_matches(handle) == false) {
        return ScheduledProcessReadyTakeResult::Missing;
    }
    if (scheduled_process_record_of(handle).stack_owner_cpu !=
            PROCESS_STACK_UNOWNED) {
        return ScheduledProcessReadyTakeResult::Missing;
    }
    // A Ready parent may still carry a blocked wait4 continuation when a
    // child exits on a CPU that cannot admit that parent. Do not let another
    // CPU resume and reap it until the exiting CPU has physically left the
    // child's kernel stack.
    if (scheduled_process_wait_reason_of(handle) ==
            ProcessWaitReason::ChildExit) {
        match kernel_process_pending_wait4_child(guard, handle) {
            ProcessNextReadyResult::Missing => {
                return ScheduledProcessReadyTakeResult::Missing;
            }
            ProcessNextReadyResult::Next(child) => {
                if (scheduled_process_record_of(child).stack_owner_cpu !=
                        PROCESS_STACK_UNOWNED) {
                    return ScheduledProcessReadyTakeResult::Missing;
                }
            }
        }
    }
    let owner = scheduled_process_owner_new(handle.pool_index,
                                            handle.generation);
    let state = scheduled_process_startable_state(owner);
    return ScheduledProcessReadyTakeResult::Ready((owner, state));
}

private fn scheduled_process_constructing_take(
        guard: borrow ProcessRunGuard[lock], handle: ProcessHandle)
        -> ScheduledProcessConstructingTakeResult {
    if (scheduled_process_handle_matches(handle) == false ||
        scheduled_process_state_of(handle) != ProcessSlotState::Constructing) {
        return ScheduledProcessConstructingTakeResult::Missing;
    }
    let owner = scheduled_process_owner_new(handle.pool_index, handle.generation);
    let state = scheduled_process_constructing_state(owner);
    return ScheduledProcessConstructingTakeResult::Constructing((owner, state));
}

private fn scheduled_process_constructing_state(
        owner: borrow ScheduledProcessOwner[process])
        -> ScheduledProcessState[process, ProcessState::Constructing] {
    let mut state: ScheduledProcessState[process, ProcessState::Constructing] =
        { owner.pool_index };
    return state;
}

private fn scheduled_process_finish_clone(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Constructing],
        frame: borrow FrameRef[frame_process])
        -> ScheduledProcessState[process, ProcessState::Running] {
    scheduled_process_state_drop(state);
    scheduled_process_record_owned(owner).saved_sp =
        frame_ref_address(frame);
    scheduled_process_record_owned(owner).state = ProcessSlotState::Running;
    return scheduled_process_running_state(owner);
}

private fn scheduled_process_cancel_clone(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Constructing])
        -> ScheduledProcessState[process, ProcessState::Exited] {
    scheduled_process_state_drop(state);
    scheduled_process_record_owned(owner).state = ProcessSlotState::Exited;
    return scheduled_process_exited_state(owner);
}

fn scheduled_process_exited_take(guard: borrow ProcessRunGuard[lock],
                                 handle: ProcessHandle)
        -> ScheduledProcessExitedTakeResult {
    if (scheduled_process_state_of(handle) !=
            ProcessSlotState::Exited) {
        return ScheduledProcessExitedTakeResult::Missing;
    }
    if (scheduled_process_handle_matches(handle) == false) {
        return ScheduledProcessExitedTakeResult::Missing;
    }
    // GitHub issue #609: every reap takes the zombie here, and none may
    // while the CPU that ran its exit still stands on its stack; the
    // collecting searches skip such a zombie, and the deferred reap runs
    // only after the release. A path that forgot would free a stack in use.
    if (scheduled_process_record_of_locked(guard, handle).stack_owner_cpu !=
            PROCESS_STACK_UNOWNED) {
        kernel_activity_set(KernelActivity::ReapOnOwnedStack);
        kernel_syscall_fail_stop(0);
    }
    let owner = scheduled_process_owner_new(handle.pool_index,
                                            handle.generation);
    let state = scheduled_process_reapable_state(owner);
    return ScheduledProcessExitedTakeResult::Exited((owner, state));
}

fn scheduled_process_running_take(guard: borrow ProcessRunGuard[lock],
                                  handle: ProcessHandle)
        -> ScheduledProcessRunningTakeResult {
    if (scheduled_process_state_of(handle) !=
            ProcessSlotState::Running) {
        return ScheduledProcessRunningTakeResult::Missing;
    }
    if (scheduled_process_handle_matches(handle) == false) {
        return ScheduledProcessRunningTakeResult::Missing;
    }
    let owner = scheduled_process_owner_new(handle.pool_index,
                                            handle.generation);
    let state = scheduled_process_running_state(owner);
    return ScheduledProcessRunningTakeResult::Running((owner, state));
}

fn scheduled_process_blocked_take(guard: borrow ProcessRunGuard[lock],
                                  handle: ProcessHandle)
        -> ScheduledProcessBlockedTakeResult {
    if (scheduled_process_state_of(handle) !=
            ProcessSlotState::Blocked) {
        return ScheduledProcessBlockedTakeResult::Missing;
    }
    if (scheduled_process_handle_matches(handle) == false) {
        return ScheduledProcessBlockedTakeResult::Missing;
    }
    let owner = scheduled_process_owner_new(handle.pool_index,
                                            handle.generation);
    let state = scheduled_process_blocked_state(owner);
    return ScheduledProcessBlockedTakeResult::Blocked((owner, state));
}

// A Ready process this caller already holds, offered for a start. Strict:
// the stack must be no core's, which is what a woken parent started by
// another process's exit needs (#609).
fn scheduled_process_start_check(
        guard: borrow ProcessRunGuard[lock],
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Ready])
        -> ScheduledProcessStartCheck[process] {
    if (scheduled_process_record_locked(guard, owner.pool_index).stack_owner_cpu !=
            PROCESS_STACK_UNOWNED) {
        return ScheduledProcessStartCheck::Standing(state);
    }
    scheduled_process_state_drop(state);
    return ScheduledProcessStartCheck::Startable(
        scheduled_process_startable_state(owner));
}

// The same for a process this CPU itself stands on: a block that would miss
// restarts the very process that just blocked, in place.
fn scheduled_process_restart_check(
        guard: borrow ProcessRunGuard[lock],
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Ready])
        -> ScheduledProcessStartCheck[process] {
    let stack_owner: usize =
        scheduled_process_record_locked(guard, owner.pool_index).stack_owner_cpu;
    if (stack_owner != PROCESS_STACK_UNOWNED && stack_owner != cpu_id()) {
        return ScheduledProcessStartCheck::Standing(state);
    }
    scheduled_process_state_drop(state);
    return ScheduledProcessStartCheck::Startable(
        scheduled_process_startable_state(owner));
}

fn scheduled_process_start(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Startable])
        -> ScheduledProcessState[process, ProcessState::Running] {
    scheduled_process_state_drop(state);
    // GitHub issue #609: StackOwnership.tla's StartsOnFreeStack, checked
    // where every start passes. A process starts on a stack no core owns,
    // or on this core's own (a block that would miss restarts in place).
    // #609's direct start of a woken parent broke this silently: the fault
    // surfaced later, far away, as two CPUs' oopses on one slot. No log
    // line: the timer's schedule reaches here from interrupt context.
    let stack_owner: usize =
        scheduled_process_record_owned(owner).stack_owner_cpu;
    if (stack_owner != PROCESS_STACK_UNOWNED && stack_owner != cpu_id()) {
        kernel_activity_set(KernelActivity::StartOnOwnedStack);
        kernel_syscall_fail_stop(0);
    }
    // GitHub issue #579: this is the one place a CPU takes a Ready process
    // for itself -- every scheduling path reaches Running through here, and
    // every caller holds the process-run lock -- so it is where "this core
    // has run something" is recorded.
    kernel_process_cpus_that_ran =
        kernel_process_cpus_that_ran | (1 << cpu_id());
    scheduled_process_record_owned(owner).state =
        ProcessSlotState::Running;
    let mut running:
        ScheduledProcessState[process, ProcessState::Running] =
        { owner.pool_index };
    return running;
}

fn scheduled_process_yield(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Running])
        -> ScheduledProcessState[process, ProcessState::Ready] {
    scheduled_process_state_drop(state);
    scheduled_process_record_owned(owner).state =
        ProcessSlotState::Ready;
    let mut ready: ScheduledProcessState[process, ProcessState::Ready] =
        { owner.pool_index };
    return ready;
}

// The one place a process becomes Blocked, and so the one place a wait is
// published (GitHub issue #653): state and reason change together, so a
// process that is still Running never carries one.
fn scheduled_process_block(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Running],
        reason: ProcessWaitReason)
        -> ScheduledProcessState[process, ProcessState::Blocked] {
    scheduled_process_state_drop(state);
    scheduled_process_record_owned(owner).state =
        ProcessSlotState::Blocked;
    match process_wait_publish(
            &scheduled_process_record_owned(owner).wait, reason,
            scheduled_process_record_owned(owner).state) {
        ProcessWaitPublish::Published => {}
        // Set just above, so this is the record changing under a caller that
        // does not hold the run lock.
        ProcessWaitPublish::Refused => { kernel_syscall_fail_stop(0); }
    }
    workload_profile_note_block(
        scheduled_process_pid_of_slot(owner.pool_index));
    let mut blocked: ScheduledProcessState[process, ProcessState::Blocked] =
        { owner.pool_index };
    return blocked;
}

// A wait has ended: the published wait is cleared, and so is the decision
// that led to it, which a rerun of the syscall reads as "first entry" only
// when nothing is left of the last one.
private fn scheduled_process_wait_settle(record: borrow *ProcessRecord) {
    process_wait_clear(&record.wait);
    record.pending_block_reason = ProcessWaitReason::None;
}

// A wake leaves nothing pending: the wait it ends is cleared with the state.
fn scheduled_process_wake(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Blocked])
        -> ScheduledProcessState[process, ProcessState::Ready] {
    scheduled_process_wait_settle(
        scheduled_process_record_owned(owner));
    return scheduled_process_wake_ready(owner, state);
}

// A ChildExit waiter woken by `child`'s exit on a CPU that cannot run it. It
// stays Ready with its wait4 pending and names the child that woke it, so
// the CPU that admits it delivers that child's result even if a sibling
// exits meanwhile (GitHub issue #633).
fn scheduled_process_wake_keeping_wait4(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Blocked],
        child_pid: usize)
        -> ScheduledProcessState[process, ProcessState::Ready] {
    process_wait_keep_continuation(
        &scheduled_process_record_owned(owner).wait, child_pid);
    return scheduled_process_wake_ready(owner, state);
}

private fn scheduled_process_wake_ready(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Blocked])
        -> ScheduledProcessState[process, ProcessState::Ready] {
    scheduled_process_state_drop(state);
    scheduled_process_record_owned(owner).state =
        ProcessSlotState::Ready;
    workload_profile_note_wakeup(
        scheduled_process_pid_of_slot(owner.pool_index));
    let mut ready: ScheduledProcessState[process, ProcessState::Ready] =
        { owner.pool_index };
    return ready;
}

fn scheduled_process_exit(
        owner: borrow ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Running])
        -> ScheduledProcessState[process, ProcessState::Exited] {
    scheduled_process_state_drop(state);
    scheduled_process_record_owned(owner).state =
        ProcessSlotState::Exited;
    let mut exited: ScheduledProcessState[process, ProcessState::Exited] =
        { owner.pool_index };
    return exited;
}

// GitHub issue #482: a reap is two steps, and only the second needs the
// process-run lock.
//
// The teardown frees what belongs to the exited process alone: its fd
// context, roots, image and backing. Nothing but the process and its reaper
// reaches those. It can free pages and reach a world stop, which a peer
// spinning on the IRQ-masking run lock could not acknowledge, so it runs
// wherever the caller is.
//
// The removal hands the RECORD back to the pool, and that record is not
// the exited process's alone. Every CPU's scheduler walk, the timer's wakes
// and the UART wake read records of processes they do not own under the
// run lock, through a pointer the pool's view has already let go of
// (scheduled_process_record_at, one of the named liveness escapes). With
// the removal outside the lock, a reap on one CPU could scrub and free a
// record between another CPU's probe and its read, and a peer's own exit
// reaps its zombies on that peer. So the removal takes the run lock's
// guard, and a reader that holds the lock sees the record either whole or
// already gone.
fn scheduled_process_reap(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        owner: sink ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Reapable])
        !{unsafe, invalidates_ProcessHandle} {
    scheduled_process_reap_teardown(owner);
    scheduled_process_reap_remove(guard, owner, state);
}

fn scheduled_process_reap_teardown(
        owner: borrow ScheduledProcessOwner[process]) !{unsafe} {
    // GitHub issue #488: see scheduled_process_reaped_current_count.
    if (execution_here().current_live) {
        if (execution_here().current_handle.pool_index == owner.pool_index) {
            scheduled_process_reaped_current_count =
                scheduled_process_reaped_current_count + 1;
        }
    }
    kernel_process_trace_record(
        ProcessTraceReap, scheduled_process_pid_of_slot(owner.pool_index),
        owner.generation, 0, 0, 4, 0, owner.pool_index,
        scheduled_process_record_owned(owner).saved_sp, 0);
    unified_fd_context_release_words(owner.pool_index,
        scheduled_process_fd_context_handle_owned(owner));
    address_space_release_root(scheduled_process_address_space_root_owned(owner));
    // GitHub issue #392: a root's image record dies with the process, as
    // the fd context above already does -- so this is the last moment its
    // installed exec image can be torn down and accounted for, and the
    // teardown moved here from the parent's return for exactly that
    // reason. Root 0 is exempt inside the release itself.
    process_image_exec_teardown(owner.pool_index,
        scheduled_process_image_record_handle_owned(owner));
    process_image_record_release_words(owner.pool_index,
        scheduled_process_image_record_handle_owned(owner));
    // GitHub issue #414: last, because process_image_exec_teardown above
    // still resolves against this root.
    address_space_backing_release(scheduled_process_address_space_root_owned(owner));
    // Read the watermark before the run is recycled -- see
    // scheduled_process_stack_deepest_reaped.
    let used: usize = kernel_stack_used_bytes(owner.pool_index);
    if (used > scheduled_process_stack_deepest_reaped) {
        scheduled_process_stack_deepest_reaped = used;
    }
}

// The record itself goes last: the teardown still needed to read it. Reset
// first, because slot 0's record is a static that survives -- for a pool
// slot the reset is written into memory about to be handed back, which
// costs a few stores and keeps one rule instead of two.
fn scheduled_process_reap_remove(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        owner: sink ScheduledProcessOwner[process],
        state: sink ScheduledProcessState[process, ProcessState::Reapable])
        !{unsafe, invalidates_ProcessHandle} {
    scheduled_process_state_drop(state);
    scheduled_process_record_reset(owner.pool_index);
    scheduled_process_slot_remove(guard, owner.pool_index);
    scheduled_process_owner_drop(owner);
}

// GitHub issue #392: a root of one's own, for a probe.
//
// A probe that needs a second address space used to name one as a bare
// `1`, which worked while any index below the ceiling was a root whether
// or not a process occupied it. A root is a live process's record now, so
// a probe has to be a process -- the same thing this issue's fd-context
// stage did to the probes that used to get contexts for free.
//
// Plain usizes in and out, and 0 for "none", because the callers are in
// kernel/mm/address_space.tkb and kernel/mm/process_image.tkb, both parsed
// BEFORE this file: a function resolves regardless of file order, a type
// does not. 0 is unambiguous -- it is the bootstrap, which this never
// hands out.
//
// The address space allocated for the slot is given straight back: these
// probes are about creating one, and want a slot that has none.
// Publish a probe's private record as Ready and selectable by nobody, in one
// place, because the two halves are one statement: "a Ready process that no
// scheduler may run."
//
// The schedule-contention probe races two cores for one Ready process, so
// Ready is the state under test and cannot be avoided; the table probe and
// the slot-acquire helper consume Ready through their own ready_take. What
// can be said explicitly is that no CPU may take it: an affinity mask naming
// only a core that does not exist answers false in
// kernel_process_cpu_allows_slot for every cpu, which is what the old
// per-pid placement rule used to do by accident. A probe's own ready_take
// does not consult the mask, so what it measures is unaffected.
//
// KERNEL_MAX_CORES is out of range of every online set by construction, and
// kernel_process_affinity_set could not be used to write it: it intersects
// with the online mask and refuses an empty result, which is exactly right
// for a syscall and exactly wrong here.
private fn scheduled_process_probe_publish_ready(handle: ProcessHandle)
        !{unsafe} {
    if (scheduled_process_handle_matches(handle) == false) { return; }
    // GitHub issue #693 step 6: the record is already in the pool, so a
    // peer can see it; written under the run guard. No caller holds it.
    let guard = process_run_lock();
    scheduled_process_record_locked(guard, handle.pool_index).affinity_mask =
        1 << KERNEL_MAX_CORES;
    scheduled_process_record_locked(guard, handle.pool_index).state =
        ProcessSlotState::Ready;
    process_run_unlock(guard);
}

// The other half of the same statement, asked rather than asserted by the
// probe reaching into a slot: may THIS cpu take this record? The probe wants
// "no" from every cpu while the record sits Ready with no frame.
fn scheduled_process_probe_cpu_allows(cpu: usize, handle: ProcessHandle)
        -> bool {
    if (scheduled_process_handle_matches(handle) == false) { return false; }
    // Its one caller, the schedule contention probe, holds no run lock.
    let probe_guard = process_run_lock();
    let allowed: bool =
        kernel_process_cpu_allows_slot(probe_guard, cpu, handle.pool_index);
    process_run_unlock(probe_guard);
    return allowed;
}

fn scheduled_process_probe_slot_acquire() -> usize !{unsafe} {
    let mut slot: usize = 0;
    match scheduled_process_alloc() {
        ScheduledPooledProcessAllocResult::Full => { return 0; }
        ScheduledPooledProcessAllocResult::Allocated(pooled) => {
            let mut handle: ProcessHandle =
                scheduled_pooled_process_handle(pooled);
            slot = handle.pool_index;
        }
    }
    address_space_release_root(address_space_root_for_slot(slot));
    return slot;
}

fn scheduled_process_probe_slot_release(slot: usize) !{unsafe} {
    scheduled_process_release_slot_resources(slot);
    scheduled_process_record_reset(slot);
    let removal_guard = process_run_lock();
    scheduled_process_slot_remove(removal_guard, slot);
    process_run_unlock(removal_guard);
}

fn scheduled_process_stack_top(handle: ProcessHandle) -> usize !{unsafe} {
    if (scheduled_process_handle_matches(handle)) {
        return scheduled_process_record_of(handle).saved_sp;
    }
    return 0;
}

fn scheduled_process_same_slot(a: ProcessHandle, b: ProcessHandle) -> bool {
    return a.pool_index == b.pool_index;
}

fn scheduled_process_same_generation(
        a: ProcessHandle, b: ProcessHandle) -> bool {
    return a.generation == b.generation;
}

// GitHub issue #479 Group B: one critical section for the whole cycle, so
// the probe exercises the transitions the same way the scheduler does
// rather than a looser way of its own.
fn scheduled_process_probe_cycle(handle: ProcessHandle) -> bool {
    let guard = process_run_lock();
    let ok: bool = scheduled_process_probe_cycle_locked(guard, handle);
    process_run_unlock(guard);
    return ok;
}

private fn scheduled_process_probe_cycle_locked(
        guard: borrow ProcessRunGuard[lock],
        handle: ProcessHandle) -> bool {
    match scheduled_process_ready_take(guard, handle) {
        ScheduledProcessReadyTakeResult::Missing => { return false; }
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            let running = scheduled_process_start(owner, ready);
            let ready_again = scheduled_process_yield(owner, running);
            scheduled_process_release(owner, ready_again);
        }
    }
    match scheduled_process_ready_take(guard, handle) {
        ScheduledProcessReadyTakeResult::Missing => { return false; }
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            let running = scheduled_process_start(owner, ready);
            let exited = scheduled_process_exit(owner, running);
            scheduled_process_release(owner, exited);
        }
    }
    match scheduled_process_exited_take(guard, handle) {
        ScheduledProcessExitedTakeResult::Missing => { return false; }
        ScheduledProcessExitedTakeResult::Exited(resources) => {
            let (owner, exited) = resources;
            scheduled_process_reap(guard, owner, exited);
            return true;
        }
    }
}

// GitHub issue #392: this probe used to prove the OPPOSITE of what it
// proves now. It allocated every slot and then confirmed the next
// allocation was Full -- an assertion that the ceiling was where the
// constant said. There is no ceiling, so it allocates PAST the old one
// instead: 24 concurrent processes where 16 was the number, each with its
// own kernel stack run, and every record given back afterwards. That is
// the shape issue #257 left behind when TCP_CONNECTION_MAX went.
//
// It also still proves what it always did: typed Ready -> Running ->
// Ready/Exited transitions, run-aligned distinct kernel stacks, and that a
// handle to a reaped process is refused.
//
// ProcessHandle is a plain struct (not an indexed/existential owner type),
// so an array of them is legal storage, unlike a linear owner such as
// PageRunOwner or FreelistOwner.
const PROCESS_TABLE_PROBE_COUNT: usize = 24;

fn scheduled_process_table_probe() -> bool !{unsafe} {
    scheduled_process_table_init();
    let records_before: usize = process_image_record_live_count();
    let mut handles: [ProcessHandle; PROCESS_TABLE_PROBE_COUNT];
    for i: usize in 0..<PROCESS_TABLE_PROBE_COUNT {
        match scheduled_process_alloc() {
            ScheduledPooledProcessAllocResult::Full => { return false; }
            ScheduledPooledProcessAllocResult::Allocated(pooled) => {
                let mut handle: ProcessHandle =
                    scheduled_pooled_process_handle(pooled);
                handles[i] = handle;
            }
        }
    }

    // The boot and secondary stacks are held to the same shape as the
    // ones allocated below, checked here because this is the probe that
    // owns "a kernel stack is where it says it is".
    if (kernel_linker_stacks_well_shaped() == false) { return false; }

    // Every live process's stack must be distinct, and must END exactly
    // where its run ends. Both loops bound by the same constant, not one
    // loop bound by the other's variable, so --forbid-trap can prove both
    // `handles[i]`/`handles[j]` accesses in one pass (a variable inner
    // bound like `0..<i` does not carry a provable range here).
    //
    // GitHub issue #377: the run is KERNEL_STACK_RUN_BYTES-aligned and
    // the stack is its upper half, so the top is a multiple of the whole
    // run -- and that one equation is the same fact the single-bit
    // overflow test relies on. Asserting it here is asserting that test's
    // premise on every stack the kernel ever hands out.
    //
    // Two earlier versions of this check were each true only of the
    // layout of their day: PAGE-alignment (issue #373 -- true only while
    // a page was entirely payload, so it required the first push to land
    // inside the allocator's metadata), then the payload boundary. Both
    // named an offset within one page. This one names the allocation.
    for i: usize in 0..<PROCESS_TABLE_PROBE_COUNT {
        let stack: usize = scheduled_process_stack_top(handles[i]);
        if (stack == 0 || stack % KERNEL_STACK_RUN_BYTES != 0 ||
            stack % 16 != 0) { return false; }
        for j: usize in 0..<PROCESS_TABLE_PROBE_COUNT {
            if (j != i && stack == scheduled_process_stack_top(handles[j])) {
                return false;
            }
        }
    }

    // Exercise cycle/reap/reuse on one process before cycling the rest.
    // The reused allocation may or may not land on the same pool slot --
    // that is the allocator's business -- but the reaped handle must be
    // refused either way, and refused on the generation rather than on a
    // range check, since there is no range left to fail.
    let mut first: ProcessHandle = handles[0];
    let first_slot: usize = first.pool_index;
    let first_generation: usize = first.generation;
    if (scheduled_process_probe_cycle(first) == false) { return false; }
    first = process_handle_new(first_slot, first_generation);
    if (scheduled_process_stack_top(first) != 0) { return false; }
    match scheduled_process_alloc() {
        ScheduledPooledProcessAllocResult::Full => { return false; }
        ScheduledPooledProcessAllocResult::Allocated(pooled) => {
            let mut reused: ProcessHandle =
                scheduled_pooled_process_handle(pooled);
            if (scheduled_process_same_slot(first, reused) &&
                scheduled_process_same_generation(first, reused)) {
                return false;
            }
            if (scheduled_process_stack_top(reused) == 0) { return false; }
            if (scheduled_process_probe_cycle(reused) == false) {
                return false;
            }
        }
    }
    for i: usize in 1..<PROCESS_TABLE_PROBE_COUNT {
        if (scheduled_process_probe_cycle(handles[i]) == false) {
            return false;
        }
    }
    // Everything given back. Two counts, because two pools are involved
    // and each has its own way of leaking.
    //
    // The image records: back to what the pool held before. This probe
    // does not touch the bootstrap (scheduled_process_alloc_bootstrap is a
    // separate entry point), so root 0's record -- the one release exempts
    // -- is neither created nor destroyed here.
    //
    // The process records: none survives. 24 allocated and 23 given back
    // is what a per-slot array used to hide, because a slot that is never
    // freed cannot leak.
    if (process_image_record_live_count() != records_before) {
        return false;
    }
    if (intrusive_pool_live_count(&scheduled_process_pool) != 0) {
        return false;
    }
    return true;
}

// Existing synchronous clone fixture. GitHub issue #264's first stage keeps
// its per-slot lifecycle state in scheduled_process_records above; later
// stages may extend that record without reintroducing parallel arrays.
// GitHub issue #245: replaces the old ExecutionProcess::{Parent,Child}
// enum plus single execution_parent_handle/execution_child_handle pair,
// which hardcoded "current process" as one of exactly two fixed global
// roles. A process tree deeper than two levels (#241's ash -> user_payload
// -> user_payload's own child) has nowhere to go under that model: the
// third scheduled_process_alloc() finds the pool Full, and there is no
// slot for "current" to mean anything but the same two roles.
//
// Now: execution_here().current_handle is whichever slot is actually running,
// and each ProcessRecord tracks its own parent/child link instead of one
// global pair. "Parent" and "child" become relative to whichever slot is
// asking, not fixed identities. Each parent has a sibling list, so clone may
// add children until the process/page pools are exhausted and wait4 can name
// and reap any one of them.
// GitHub issue #222: the scheduler's own state, grouped and made an
// ARRAY, so that "which core is this" has somewhere to be asked.
//
// These were four sibling scalars, and being scalars was the assumption:
// not that there is one core, but that there is one SET of them and
// nowhere to put a second. 176 references across this file each named a
// scalar directly, so adding a core meant touching all of them. Now they
// name a field of whichever ExecutionState execution_here() hands back,
// and there is exactly one function that decides which that is.
//
// Sized by KERNEL_MAX_CORES (kernel/lib/execution_model.tkb), like NR_CPUS
// rather than cpu_online_mask: storage exists before a core becomes an active
// scheduler participant, while execution_here() rejects an out-of-range CPU.
struct ExecutionState {
    current_handle: ProcessHandle;
    current_live: bool;
    // The process stack SP_EL1 physically occupies. During a syscall
    // handoff this intentionally remains the outgoing handle after
    // current_handle has become the incoming one, until the generated
    // post-switch hook runs on the incoming stack.
    stack_handle: ProcessHandle;
    stack_live: bool;
    // A child whose blocked-parent wait4 completion must reap only after
    // generated return code has left that child's physical kernel stack.
    deferred_reap_handle: ProcessHandle;
    deferred_reap_parent: ProcessHandle;
    deferred_reap_live: bool;
    // The pid of the child whose exit this CPU last ran, for the code that
    // runs right after it on this CPU (child_exec_reap). Only this CPU
    // writes or reads it, unlike the parent's record, which a sibling's exit
    // on another CPU could overwrite (#633).
    last_exited_child_pid: usize;
    reschedule_pending: bool;
    scheduler_enabled: bool;
}

private let mut execution_state: [ExecutionState; KERNEL_MAX_CORES];
// Which ExecutionState belongs to the core asking.
//
// It asks cpu_id() which core is running, and indexes the array by that.
//
// It used to return slot 0 unconditionally with a static_assert saying to
// teach it cpu_id() before a second core ran kernel code. This is that
// change (GitHub issue #479 Group B), and it is a no-op while
// KERNEL_ACTIVE_CORES is 1: only core 0 reaches here, cpu_id() answers 0,
// and the arithmetic below adds nothing.
//
// The array is sized by KERNEL_MAX_CORES rather than by the active count,
// which is Linux's NR_CPUS versus cpu_online_mask -- storage for the most
// cores the build could have, participation counted separately.
//
// The bound check is not defensive padding. cpu_id() reads a hardware
// affinity field, and a part whose cores are numbered differently than
// this platform's cpu_id() expects would index past the array; returning
// slot 0 there is wrong but bounded, where the alternative is a write into
// whatever follows.
//
// One function, not 176 call sites, is the whole change issue #222 asked
// for.
private fn execution_here() -> *ExecutionState {
    // `&execution_state[i]` is what this wants to say and GitHub issue
    // #385 rejects it -- there is no way to take the address of an array
    // element. The array decays to a pointer to its first element, and
    // this core's slot is that plus its index.
    // linux_user/diagnostic_ring reaches per-CPU storage the same way.
    let base: *ExecutionState = execution_state;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

// The generation an assembly entry gives frame_ref_from_entry: the process
// this CPU is running, 0 when it is running none (an EL1 interrupt on an idle
// stack). The entry mint is the one place a frame's index is asserted rather
// than derived, and this is what it asserts.
fn kernel_process_entry_generation() -> usize {
    if (execution_here().current_live == false) { return 0; }
    return execution_here().current_handle.generation;
}

private fn kernel_process_frame_belongs_to(
        handle: ProcessHandle, frame: borrow FrameRef[process]) -> bool {
    let frame_sp: usize = frame_ref_address(frame);
    let mut bottom: usize = 0;
    let mut top: usize = 0;
    if (handle.pool_index == 0) {
        bottom = boot_stack_bottom;
        top = boot_stack_top;
    } else {
        bottom = kernel_stack_bottom(handle.pool_index);
        if (bottom != 0) { top = bottom + KERNEL_PROCESS_STACK_SIZE; }
    }
    if (bottom == 0 || top <= bottom || frame_sp < bottom ||
        frame_sp >= top) {
        return false;
    }
    return top - frame_sp >= EXC_CONTEXT_SIZE;
}

// Lower-EL IRQ entry calls this only after generated entry code has moved SP
// onto this CPU's IRQ stack. The interrupted process frame remains intact,
// but the physical process stack is no longer in use and may become eligible
// for another CPU once its logical state becomes Ready.
// GitHub issue #468: three authorities answer "which address-space root is
// active" -- the process record's own root, this CPU's software target root
// (process_image.tkb), and TTBR0_EL1, which is what the hardware walks --
// and #437's hardest bug was two of them disagreeing while each looked
// valid. EL0 return is the one moment all three must name the same root,
// and the last moment a disagreement is still a report rather than a user
// access through the wrong page table. So they are compared here, on every
// EL0 return, and a disagreement fail-stops with all three values. Not a
// counter: the fallback counter #437 had was healthy and wrong at once.
//
// Measured before it became a fail-stop: 6615 EL0 returns in one QEMU boot,
// no disagreement.
const TTBR0_BADDR_MASK: usize = 0x0000FFFFFFFFFFFE;

private fn kernel_process_root_authorities_check(incoming: ProcessHandle,
                                                 frame: borrow FrameRef[process]) {
    let slot: usize = incoming.pool_index;
    let record_l1: usize = address_space_l1_physical(address_space_root_for_slot(slot));
    let hardware_l1: usize = crash_snapshot_read_ttbr0_el1() & TTBR0_BADDR_MASK;
    let mut target: usize = 0xFFFFFFFFFFFFFFFF;
    match process_image_target_root_peek() {
        ProcessImageTargetRootResult::Missing => {}
        ProcessImageTargetRootResult::Ready(root) => {
            target = process_image_root_index(root);
        }
    }
    if (record_l1 == hardware_l1 && target == slot) { return; }
    kernel_boot_log("oops: root authorities disagree at EL0 return: pid=");
    uart_put_udec(scheduled_process_pid_of_handle(incoming));
    kernel_boot_log(" slot=");
    uart_put_udec(slot);
    kernel_boot_log(" record_l1=");
    uart_put_hex(record_l1);
    kernel_boot_log(" ttbr0_l1=");
    uart_put_hex(hardware_l1);
    if (target == 0xFFFFFFFFFFFFFFFF) {
        kernel_boot_log(" target=unset\n");
    } else {
        kernel_boot_log(" target_slot=");
        uart_put_udec(target);
        kernel_boot_log(" target_l1=");
        uart_put_hex(address_space_l1_physical(address_space_root_for_slot(target)));
        kernel_boot_log("\n");
    }
    kernel_syscall_fail_stop(frame_ref_address(frame));
}

fn kernel_process_stack_interrupt_depart() {
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES || execution_here().stack_live == false) {
        return;
    }
    let guard = process_run_lock();
    let mut physical: ProcessHandle = execution_here().stack_handle;
    if (scheduled_process_handle_matches(physical) &&
        scheduled_process_record_of_locked(guard, physical).stack_owner_cpu == core) {
        scheduled_process_record_of_locked(guard, physical).stack_owner_cpu =
            PROCESS_STACK_UNOWNED;
        execution_here().stack_live = false;
    }
    process_run_unlock(guard);
}

// Generated exception-return code calls this with interrupts masked and SP
// already changed to frame_sp. Until that instruction executes,
// stack_handle deliberately continues to name the outgoing process even when
// current_handle has logically moved to the incoming one. This is the
// physical handoff boundary that a run-lock release alone cannot express.
fn kernel_process_stack_switch_complete(frame_sp: usize) {
    let frame =
        frame_ref_from_entry(frame_sp, kernel_process_entry_generation());
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) {
        kernel_syscall_fail_stop(frame_sp);
    }
    let guard = process_run_lock();
    if (execution_here().stack_live) {
        let mut outgoing: ProcessHandle = execution_here().stack_handle;
        if (scheduled_process_handle_matches(outgoing) == false ||
            scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu != core) {
            process_run_unlock(guard);
            kernel_syscall_fail_stop(frame_sp);
        }
        scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu =
            PROCESS_STACK_UNOWNED;
        execution_here().stack_live = false;
        if (scheduled_process_state_of(outgoing) ==
                ProcessSlotState::Exited) {
            workload_busy_peer_exit_stack_released(
                scheduled_process_pid_of_handle(outgoing), core);
        }
    }
    if (execution_here().current_live == false) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(frame_sp);
    }
    let mut incoming: ProcessHandle = execution_here().current_handle;
    if (scheduled_process_handle_matches(incoming) == false ||
        scheduled_process_state_of(incoming) != ProcessSlotState::Running ||
        scheduled_process_record_of_locked(guard, incoming).stack_owner_cpu !=
            PROCESS_STACK_UNOWNED ||
        kernel_process_frame_belongs_to(incoming, frame) == false) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(frame_sp);
    }
    scheduled_process_record_of_locked(guard, incoming).stack_owner_cpu = core;
    execution_here().stack_handle = incoming;
    execution_here().stack_live = true;
    let reap_live: bool = execution_here().deferred_reap_live;
    let mut reap_child: ProcessHandle = execution_here().deferred_reap_handle;
    let mut reap_parent: ProcessHandle = execution_here().deferred_reap_parent;
    execution_here().deferred_reap_live = false;
    process_run_unlock(guard);
    if (reap_live) {
        let reaped_status: usize =
            kernel_process_reap_zombie(reap_parent, reap_child);
        incoming = execution_here().current_handle;
        kernel_init_boot_fixture_reaped(
            scheduled_process_pid_of_handle(incoming));
    }
    // Last, after the deferred reap: that reap is the path that left the
    // target at root 0 in #437.
    kernel_process_root_authorities_check(incoming, frame);
    // Back to EL0: the kernel is doing nothing on this CPU's behalf.
    kernel_activity_set(KernelActivity::None);
}

// Called after kernel_secondary_idle_enter has moved SP_EL1 onto this CPU's
// IRQ stack. This is the no-successor exit path; a switch to another process
// publishes the same physical release in kernel_process_stack_switch_complete.
// The exiting process remains a zombie for its parent, but its kernel stack
// is now physically free and may be reaped safely.
fn kernel_process_stack_idle_complete() {
    let core: usize = cpu_id();
    // Core 0 arrives here too since GitHub issue #592's exit follow-up, from
    // kernel_core0_idle_enter.
    if (core >= KERNEL_MAX_CORES ||
        execution_here().current_live || execution_here().stack_live == false) {
        kernel_syscall_fail_stop(0);
    }
    let guard = process_run_lock();
    let mut outgoing: ProcessHandle = execution_here().stack_handle;
    if (scheduled_process_handle_matches(outgoing) == false ||
        scheduled_process_state_of(outgoing) != ProcessSlotState::Exited ||
        scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu != core) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(0);
    }
    // Leave the exiting process's root before core 0 may reap it. The
    // release there switches only ITS OWN core off a root it frees, and
    // this core idles with no process to activate. It kept TTBR0 on a
    // freed root, ran on cached global kernel entries, and at the first
    // miss faulted fetching its own vector, forever, with IRQs masked:
    // the DDB lane's peer that never answered a world stop.
    address_space_activate_root(address_space_boot_root());
    scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu =
        PROCESS_STACK_UNOWNED;
    execution_here().stack_live = false;
    workload_busy_peer_exit_stack_released(
        scheduled_process_pid_of_handle(outgoing), core);
    let reap_live: bool = execution_here().deferred_reap_live;
    let mut reap_child: ProcessHandle = execution_here().deferred_reap_handle;
    let mut reap_parent: ProcessHandle = execution_here().deferred_reap_parent;
    execution_here().deferred_reap_live = false;
    process_run_unlock(guard);
    if (reap_live) {
        let reaped_status: usize =
            kernel_process_reap_zombie(reap_parent, reap_child);
    }
    workload_profile_idle_enter();
}

// GitHub issue #9: the migration gate's twin of the function above, called
// after kernel_secondary_idle_yield_enter has moved SP_EL1 off the process's
// stack. The process stays live. It becomes Ready, with its stack unowned,
// in one critical section, so core 0 can take stack and rewound frame
// together, and never while this core still stands on them.
fn kernel_process_stack_idle_yield() {
    let core: usize = cpu_id();
    // Core 0 arrives here too since GitHub issue #592, from
    // kernel_core0_idle_yield_enter.
    if (core >= KERNEL_MAX_CORES ||
        execution_here().current_live || execution_here().stack_live == false) {
        kernel_syscall_fail_stop(0);
    }
    let guard = process_run_lock();
    let mut outgoing: ProcessHandle = execution_here().stack_handle;
    if (scheduled_process_handle_matches(outgoing) == false ||
        scheduled_process_state_of(outgoing) != ProcessSlotState::Running ||
        scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu != core) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(0);
    }
    // Leave its root before it can run elsewhere, as an exit does.
    address_space_activate_root(address_space_boot_root());
    scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu =
        PROCESS_STACK_UNOWNED;
    execution_here().stack_live = false;
    if (kernel_process_yield_handle(guard, outgoing) == false) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(0);
    }
    process_run_unlock(guard);
    workload_profile_idle_enter();
}
// GitHub issue #583: the blocked twin of kernel_process_stack_idle_yield,
// after the CPU's idle entry has moved SP_EL1 off the stack of a process
// kernel_process_block_to_idle published Blocked. The process keeps its
// state -- Blocked, or Ready if a wake already landed -- and only its stack
// changes hands, so a wake from here on can start it on any CPU it may run.
fn kernel_process_stack_idle_blocked() {
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES ||
        execution_here().current_live || execution_here().stack_live == false) {
        kernel_syscall_fail_stop(0);
    }
    let guard = process_run_lock();
    let mut outgoing: ProcessHandle = execution_here().stack_handle;
    if (scheduled_process_handle_matches(outgoing) == false ||
        (scheduled_process_state_of(outgoing) != ProcessSlotState::Blocked &&
         scheduled_process_state_of(outgoing) != ProcessSlotState::Ready) ||
        scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu != core) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(0);
    }
    address_space_activate_root(address_space_boot_root());
    scheduled_process_record_of_locked(guard, outgoing).stack_owner_cpu =
        PROCESS_STACK_UNOWNED;
    execution_here().stack_live = false;
    process_run_unlock(guard);
    // A wake that landed while this core stood on the stack left the
    // process Ready and unselectable; it is selectable now.
    interrupt_notify();
    workload_profile_idle_enter();
}

// GitHub issue #264 first stage keeps the #248 wait4 result fields and
// #245 exec-image flag in the same ProcessRecord as their slot's state
// and links. They remain indexed by the waiting/current process exactly
// as before; only their storage layout changes.
// GitHub issue #303: the clone/exit/UART/scheduling *counters* that used
// to live here as sibling execution_* globals moved to
// kernel/kernel/process_test_evidence.tkb -- unlike
// execution_here().reschedule_pending/execution_here().scheduler_enabled just above,
// nothing in this file's real scheduling logic ever reads them back; only
// the kernel_process_*_evidence() predicates below and syscall.tkb's
// test-driver-bounded foreground-server lifecycle do.
// Probe-only stand-ins for the two saved exception frames.  The real UART
// wake path writes x0 into the blocked child's frame, so using valid fixed
// storage here proves that path without touching a raw numeric address.
const KERNEL_PROCESS_TRACE_PROBE_FRAME_WORDS: usize = 128;
private let mut kernel_process_trace_probe_parent_frame:
    [usize; KERNEL_PROCESS_TRACE_PROBE_FRAME_WORDS];
private let mut kernel_process_trace_probe_child_frame:
    [usize; KERNEL_PROCESS_TRACE_PROBE_FRAME_WORDS];

// Fixed-size scheduler/process tail for fail-stop diagnostics.  This first
// implementation has one producer CPU: core 1 is brought up only to prove
// EL1 entry and then parks, while all process execution remains on core 0.
// The ABI nevertheless reserves cpu and a local sequence number now, so SMP
// can grow this into one independently-written ring per CPU.  It must not be
// replaced by a shared SMP ring: a global order would need atomic reservation
// and would still not describe causality between concurrent CPUs honestly.
//
// Tracing is opt-in.  A record is allocation-free and never prints from a
// scheduler or IRQ path.  A later SMP writer must publish each record with a
// commit sequence after its fields are written; the present single-writer
// implementation deliberately keeps the same field ABI and copy interface.
// Sixteen records retain the complete first fork+exec handoff in the QEMU
// fail-stop regression while remaining a small fixed 1536-byte object.
// Records PER CPU. The output buffer below is still one core's worth,
// because a snapshot carries the newest 16 records of the whole machine
// however they are spread across cores.
const KERNEL_CRASH_TRACE_EVENTS: usize = 16;
const KERNEL_PROCESS_TRACE_WORDS_PER_EVENT: usize = 12;
// Compiler-owned field positions for the flat snapshot ABI. External readers
// consume these through --emit-debug-metadata rather than repeating the
// numeric layout. Keep the kernel's writer and renderers on the same names.
const KERNEL_PROCESS_TRACE_SEQUENCE_WORD: usize = 0;
const KERNEL_PROCESS_TRACE_CPU_WORD: usize = 1;
const KERNEL_PROCESS_TRACE_EVENT_WORD: usize = 2;
const KERNEL_PROCESS_TRACE_PID_WORD: usize = 3;
const KERNEL_PROCESS_TRACE_GENERATION_WORD: usize = 4;
const KERNEL_PROCESS_TRACE_PEER_PID_WORD: usize = 5;
const KERNEL_PROCESS_TRACE_PEER_GENERATION_WORD: usize = 6;
const KERNEL_PROCESS_TRACE_STATE_WORD: usize = 7;
const KERNEL_PROCESS_TRACE_WAIT_REASON_WORD: usize = 8;
const KERNEL_PROCESS_TRACE_ROOT_WORD: usize = 9;
const KERNEL_PROCESS_TRACE_SAVED_SP_WORD: usize = 10;
const KERNEL_PROCESS_TRACE_AUX_WORD: usize = 11;
// The SNAPSHOT's size, and an ABI: kernel/arch/arm64/kernel/
// exception_evidence.tkb's CrashSnapshot and DdbSnapshot both declare
// `trace: [usize; KERNEL_CRASH_TRACE_WORDS]`, and the oops lane and the
// DDB renderer read twelve-word records out of it. Unchanged by the
// per-CPU split on purpose -- what grew is the STORAGE, not the report.
const KERNEL_CRASH_TRACE_WORDS: usize = 192;
// The storage: one segment per core. An array size cannot be a product
// expression, so the product is its own constant -- which is exactly the
// shape that goes stale when somebody raises the core count, so it is
// checked rather than remembered (see kernel_crash_trace_slot below).
const KERNEL_CRASH_TRACE_STORAGE_WORDS: usize = 768;
// How many records the storage holds in total, for the reader's walk.
const KERNEL_CRASH_TRACE_SLOTS: usize = 64;
const ProcessTraceFork: usize = 1;
const ProcessTraceExecPrepare: usize = 2;
const ProcessTraceExecCommit: usize = 3;
const ProcessTraceSchedule: usize = 4;
const ProcessTraceBlock: usize = 5;
const ProcessTraceWake: usize = 6;
const ProcessTraceResume: usize = 7;
const ProcessTraceExit: usize = 8;
const ProcessTraceReap: usize = 9;
const ProcessTraceAddressSpaceActivate: usize = 10;
// GitHub issue #479 Group B: PER-CPU storage, one global sequence.
//
// This ring was one segment and one `next` counter, and `next` was a read,
// an add and a write with nothing excluding a second core. Two cores
// recording at once would take the same slot and interleave twelve words
// into it -- and this is the ring the oops lane and DDB read to find out
// what a crashed kernel was doing, so a torn record is a wrong answer at
// the one moment a wrong answer costs most.
//
// NOT A LOCK, and that is a deliberate choice rather than an omission. A
// reporter that can block cannot report the deadlock it is in. Linux moved
// printk to a lock-free ringbuffer in 5.10 for exactly this, and
// bust_spinlocks()/oops_in_progress exists so an oops can reach the user
// past a console lock; NetBSD's DDB reads every kernel structure through
// db_read_bytes rather than taking anything; FreeBSD makes every mutex a
// no-op under SCHEDULER_STOPPED(). This file's siblings in that class are
// GitHub issues #465 (the retained text log) and #486 (the crash
// snapshot), and kernel/lib/diagnostic_ring.tkb already answers it here
// with per-CPU rings and issue #299's publication record.
//
// Each core writes only its own segment and its own slot counter, so the
// only shared word is the sequence -- and that is an atomic fetch-add
// rather than a lock, which is what #465 specifies for the same job.
//
// WHY A GLOBAL SEQUENCE AND NOT A PER-CPU ONE. diagnostic_ring.tkb's
// limitation says it "does not invent a global order between CPUs", and
// that is right for classified event tracing. It is wrong here: this ring
// exists to answer "what was the kernel doing when it died", and on two
// cores the interesting version of that question is the interleaving. One
// atomic counter buys the total order, and the reader reconstructs it by
// sequence rather than by segment.
private let mut kernel_crash_trace:
    [usize; KERNEL_CRASH_TRACE_STORAGE_WORDS];
// How many records THIS core has written. Per-core, so it needs no
// atomic: one writer, and it selects a slot inside that core's own
// segment.
private let mut kernel_crash_trace_next: [usize; KERNEL_MAX_CORES];
// The order. Shared, so it is the one word here that is an atomic.
private let mut kernel_crash_trace_sequence: AtomicWord;

// Which segment this core writes. Bounded for the same reason
// execution_here() bounds its index: cpu_id() reads a hardware affinity
// field, and a part numbering its cores differently would index past the
// array. Falling back to segment 0 is wrong but bounded.
private fn kernel_crash_trace_cpu() -> {0..<KERNEL_MAX_CORES as usize} {
    let raw: usize = cpu_id();
    if (raw >= KERNEL_MAX_CORES) { return 0; }
    return raw;
}
// A debugger-owned boot-test switch. Production BSS leaves this false, while
// a test may set it before the first process reset to retain a real workload's
// tail without adding UART traffic or a production control surface.
private let mut kernel_process_trace_boot_enabled: bool;
// Debugger-owned test configuration only. It makes the QEMU oops regression
// stop immediately after a real child exec commit, proving one lifecycle tail
// contains fork, exec prepare, and exec commit. Normal boot leaves it false.
private let mut kernel_process_trace_fail_after_exec: bool;
// Debugger-owned test configuration only (GitHub issue #632). Nonzero makes
// the next stable activation find the ASID counter exhausted and treat that
// many world-stop attempts as Busy before stopping the world for real, which
// is the answer another core's rollover gives. Normal boot leaves it zero.
private let mut kernel_process_rollover_busy_injections: usize;
// The same for kernel_process_activate_current_root, the activation a fork
// child makes before its first return to EL0 (GitHub issue #632).
private let mut kernel_process_clone_rollover_busy_injections: usize;
// The syscall path records its named committed-exec failure before it enters
// the common fail-stop entry. The exhaustive enum makes adding a reason
// without teaching the exception renderer about it a compile error.
enum KernelExecFailureReason: u8 {
    None;
    NotChildOrPending;
    CloneVmMissing;
    DynamicResolveInvalid;
    DynamicPairInvalid;
    ImageAlreadyInstalled;
    ImageNoTargetRoot;
    NoImageResolved;
    StaticImageInvalid;
    StaticMapOutOfMemory;
    ArgvOutOfMemory;
    DebuggerAfterCommit;
}
private let mut kernel_process_exec_failure_reason: KernelExecFailureReason;

must_use variant KernelChildExecPrepareResult {
    Prepared;
    NotChildOrPending;
    CloneVmMissing;
    DynamicResolveInvalid;
    DynamicPairInvalid;
    ImageAlreadyInstalled;
    // GitHub issue #516: an exec that reached the install with no target
    // root chosen. It used to install into root 0.
    ImageNoTargetRoot;
    NoImageResolved;
    StaticImageInvalid;
    StaticMapOutOfMemory;
    // No page for the exec's own copy of its argv.
    ArgvOutOfMemory;
}
private let mut kernel_process_trace_enabled: bool;

// Layout: sequence, cpu, kind, subject pid/generation, peer
// pid/generation, state, wait reason, root, saved SP, event-specific aux.
// The sequence is global now (GitHub issue #479 Group B), so the cpu field
// beside it stopped being a placeholder.

// Where a (cpu, local count) pair lands. One function, so the ring's only
// piece of index arithmetic has one home -- the writer and the reader used
// to compute it separately from the same two constants, which is how
// kernel/lib/diagnostic_ring.tkb's own equivalent went wrong.
private fn kernel_crash_trace_slot(cpu: {0..<KERNEL_MAX_CORES as usize},
                                   local: usize)
        -> {0..<KERNEL_CRASH_TRACE_SLOTS as usize} {
    static_assert(KERNEL_CRASH_TRACE_STORAGE_WORDS ==
                  KERNEL_MAX_CORES * KERNEL_CRASH_TRACE_EVENTS *
                  KERNEL_PROCESS_TRACE_WORDS_PER_EVENT,
                  "the crash trace storage constant must be CORES * EVENTS * WORDS: this function indexes past the array otherwise");
    static_assert(KERNEL_CRASH_TRACE_WORDS ==
                  KERNEL_CRASH_TRACE_EVENTS *
                  KERNEL_PROCESS_TRACE_WORDS_PER_EVENT,
                  "the snapshot buffer must hold exactly EVENTS records: exception_evidence.tkb declares it that size");
    static_assert(KERNEL_CRASH_TRACE_SLOTS ==
                  KERNEL_MAX_CORES * KERNEL_CRASH_TRACE_EVENTS,
                  "the slot count must be CORES * EVENTS: the reader walks every slot with it");
    return cpu * KERNEL_CRASH_TRACE_EVENTS +
           ((local - 1) % KERNEL_CRASH_TRACE_EVENTS);
}

// Empty the ring: every core's slot counter, the shared sequence, and
// every slot's COMMIT word.
//
// Clearing the commit words is new and it is required, not tidiness. The
// old reader derived "the newest sequence" from the single `next` counter,
// so zeroing that counter was enough to make the whole ring invisible. The
// per-CPU reader derives it from the SLOTS, because there is no longer one
// counter that knows about every core -- so a reset that left stale
// commits behind would leave the previous workload's records showing in
// the next one's snapshot. Only word 0 needs clearing: a record whose
// commit is 0 is never matched.
//
// This replaces two sites that each said `kernel_crash_trace_next = 0`.
// Those still COMPILED after the counter became an array, which is GitHub
// issue #487 -- an integer literal assigned to an array is accepted, the
// same hole issue #460 found for structs.
private fn kernel_process_crash_trace_reset() !{unsafe} {
    for core: usize in 0..<KERNEL_MAX_CORES {
        kernel_crash_trace_next[core] = 0;
    }
    atomic_word_store(&kernel_crash_trace_sequence, 0);
    for slot: usize in 0..<KERNEL_CRASH_TRACE_SLOTS {
        kernel_crash_trace[
            slot * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT +
            KERNEL_PROCESS_TRACE_SEQUENCE_WORD] = 0;
    }
}

fn kernel_process_trace_record(event: usize, pid: usize, generation: usize,
                               peer_pid: usize, peer_generation: usize,
                               state: usize, wait_reason: usize, root: usize,
                               saved_sp: usize, aux: usize) !{unsafe} {
    if (kernel_process_trace_enabled == false) { return; }
    // Publish the reservation before touching the entry. An IRQ that arrives
    // while ordinary EL1 code is recording therefore receives the next slot,
    // rather than interleaving words into this one. `sequence` is written
    // last; zero means an exception observed an in-progress entry.
    //
    // GitHub issue #479 Group B: the slot counter is this core's own, so
    // the interrupt-versus-thread reservation above still works unchanged
    // and needs no atomic. The SEQUENCE is shared and does, and it is a
    // fetch-add returning the previous value.
    let cpu: {0..<KERNEL_MAX_CORES as usize} = kernel_crash_trace_cpu();
    let sequence: usize =
        atomic_word_fetch_add(&kernel_crash_trace_sequence, 1) + 1;
    let local: usize = kernel_crash_trace_next[cpu] + 1;
    kernel_crash_trace_next[cpu] = local;
    let slot: {0..<KERNEL_CRASH_TRACE_SLOTS as usize} =
        kernel_crash_trace_slot(cpu, local);
    let base: usize = slot * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_SEQUENCE_WORD] = 0;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_CPU_WORD] = cpu;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_EVENT_WORD] = event;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_PID_WORD] = pid;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_GENERATION_WORD] =
        generation;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_PEER_PID_WORD] = peer_pid;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_PEER_GENERATION_WORD] =
        peer_generation;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_STATE_WORD] = state;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_WAIT_REASON_WORD] =
        wait_reason;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_ROOT_WORD] = root;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_SAVED_SP_WORD] = saved_sp;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_AUX_WORD] = aux;
    kernel_crash_trace[base + KERNEL_PROCESS_TRACE_SEQUENCE_WORD] = sequence;
}

fn kernel_process_trace_enable() { kernel_process_trace_enabled = true; }
fn kernel_process_trace_disable() { kernel_process_trace_enabled = false; }

fn kernel_process_trace_fail_after_exec_requested() -> bool {
    return kernel_process_trace_fail_after_exec;
}

fn kernel_process_exec_failure_clear() {
    kernel_process_exec_failure_reason = KernelExecFailureReason::None;
}

fn kernel_process_exec_failure_set(result: KernelChildExecPrepareResult) {
    match result {
        KernelChildExecPrepareResult::Prepared => { kernel_process_exec_failure_reason = KernelExecFailureReason::None; }
        KernelChildExecPrepareResult::NotChildOrPending => { kernel_process_exec_failure_reason = KernelExecFailureReason::NotChildOrPending; }
        KernelChildExecPrepareResult::CloneVmMissing => { kernel_process_exec_failure_reason = KernelExecFailureReason::CloneVmMissing; }
        KernelChildExecPrepareResult::DynamicResolveInvalid => { kernel_process_exec_failure_reason = KernelExecFailureReason::DynamicResolveInvalid; }
        KernelChildExecPrepareResult::DynamicPairInvalid => { kernel_process_exec_failure_reason = KernelExecFailureReason::DynamicPairInvalid; }
        KernelChildExecPrepareResult::ImageAlreadyInstalled => { kernel_process_exec_failure_reason = KernelExecFailureReason::ImageAlreadyInstalled; }
        KernelChildExecPrepareResult::ImageNoTargetRoot => { kernel_process_exec_failure_reason = KernelExecFailureReason::ImageNoTargetRoot; }
        KernelChildExecPrepareResult::NoImageResolved => { kernel_process_exec_failure_reason = KernelExecFailureReason::NoImageResolved; }
        KernelChildExecPrepareResult::StaticImageInvalid => { kernel_process_exec_failure_reason = KernelExecFailureReason::StaticImageInvalid; }
        KernelChildExecPrepareResult::StaticMapOutOfMemory => { kernel_process_exec_failure_reason = KernelExecFailureReason::StaticMapOutOfMemory; }
        KernelChildExecPrepareResult::ArgvOutOfMemory => { kernel_process_exec_failure_reason = KernelExecFailureReason::ArgvOutOfMemory; }
    }
}

fn kernel_process_exec_failure_debugger_after_commit() {
    kernel_process_exec_failure_reason = KernelExecFailureReason::DebuggerAfterCommit;
}

fn kernel_process_exec_failure_render() {
    if (kernel_process_exec_failure_reason == KernelExecFailureReason::None) {
        return;
    }
    kernel_boot_log("oops: exec prepare=");
    match kernel_process_exec_failure_reason {
        KernelExecFailureReason::None => { kernel_boot_log("none\n"); }
        KernelExecFailureReason::NotChildOrPending => { kernel_boot_log("not-child-or-pending\n"); }
        KernelExecFailureReason::CloneVmMissing => { kernel_boot_log("clone-vm-missing\n"); }
        KernelExecFailureReason::DynamicResolveInvalid => { kernel_boot_log("dynamic-resolve-invalid\n"); }
        KernelExecFailureReason::DynamicPairInvalid => { kernel_boot_log("dynamic-pair-invalid\n"); }
        KernelExecFailureReason::ImageAlreadyInstalled => { kernel_boot_log("image-already-installed\n"); }
        KernelExecFailureReason::ImageNoTargetRoot => { kernel_boot_log("image-no-target-root\n"); }
        KernelExecFailureReason::NoImageResolved => { kernel_boot_log("no-image-resolved\n"); }
        KernelExecFailureReason::StaticImageInvalid => { kernel_boot_log("static-image-invalid\n"); }
        KernelExecFailureReason::StaticMapOutOfMemory => { kernel_boot_log("static-map-out-of-memory\n"); }
        KernelExecFailureReason::ArgvOutOfMemory => { kernel_boot_log("argv-out-of-memory\n"); }
        KernelExecFailureReason::DebuggerAfterCommit => { kernel_boot_log("debugger-after-commit\n"); }
    }
}

fn kernel_process_trace_address_space_activate(root: usize) !{unsafe} {
    if (execution_here().current_live == false) { return; }
    let mut current: ProcessHandle = execution_here().current_handle;
    kernel_process_trace_record(
        ProcessTraceAddressSpaceActivate,
        scheduled_process_pid_of_handle(current),
        current.generation, 0, 0, kernel_process_crash_state(),
        kernel_process_crash_wait_reason(), root,
        scheduled_process_peek_saved_sp(current.pool_index), 0);
}

fn kernel_process_trace_exec_prepare() !{unsafe} {
    if (execution_here().current_live == false) { return; }
    let mut current: ProcessHandle = execution_here().current_handle;
    kernel_process_trace_record(
        ProcessTraceExecPrepare, scheduled_process_pid_of_handle(current),
        current.generation, 0, 0, kernel_process_crash_state(),
        kernel_process_crash_wait_reason(),
        current.pool_index, scheduled_process_peek_saved_sp(current.pool_index),
        0);
}

fn kernel_process_trace_handle(event: usize, subject: ProcessHandle,
                               peer: ProcessHandle, aux: usize) !{unsafe} {
    let state: ProcessSlotState = scheduled_process_peek_state(
        subject.pool_index);
    let reason: ProcessWaitReason = scheduled_process_peek_wait_reason(
        subject.pool_index);
    let state_u8: u8 = state as u8;
    let reason_u8: u8 = reason as u8;
    let state_code: usize = state_u8 as usize;
    let reason_code: usize = reason_u8 as usize;
    kernel_process_trace_record(
        event, scheduled_process_pid_of_handle(subject), subject.generation,
        scheduled_process_pid_of_handle(peer), peer.generation, state_code,
        reason_code, subject.pool_index,
        scheduled_process_peek_saved_sp(subject.pool_index),
        aux);
}

// Copies oldest-to-newest into the caller-owned fixed array. This gives the
// crash report a stable chronological tail even after the ring wrapped.
fn kernel_process_crash_trace_copy(output: *usize) -> usize {
    // A slot's commit sequence is written LAST and is zero while the record
    // is in flight, so chronology is never derived from a count: every slot
    // is validated against the sequence being looked for, and an in-flight
    // hole is skipped. That was true of the single-segment ring and is what
    // the per-CPU one retains.
    //
    // GitHub issue #479 Group B: the newest KERNEL_CRASH_TRACE_EVENTS
    // records OF THE MACHINE, however they are spread across segments, in
    // sequence order. That is why the sequence is global -- on two cores the
    // interesting version of "what was the kernel doing" is the
    // interleaving, and a reader that concatenated segments would destroy
    // exactly that.
    //
    // Cost: EVENTS * (CORES * EVENTS) comparisons, both bounds static, which
    // is 512 today. A snapshot is taken once, while the machine is already
    // stopping.
    let mut latest: usize = 0;
    for slot: usize in 0..<KERNEL_CRASH_TRACE_SLOTS {
        let slot_base: usize = slot * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT +
            KERNEL_PROCESS_TRACE_SEQUENCE_WORD;
        let committed: usize = kernel_crash_trace[slot_base];
        if (committed > latest) { latest = committed; }
    }
    let mut first: usize = 1;
    if (latest > KERNEL_CRASH_TRACE_EVENTS) {
        first = latest - KERNEL_CRASH_TRACE_EVENTS + 1;
    }
    let mut copied: usize = 0;
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        let sequence: usize = first + item;
        if (sequence <= latest) {
            for slot: usize in 0..<KERNEL_CRASH_TRACE_SLOTS {
                let source_base: usize =
                    slot * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
                if (kernel_crash_trace[
                        source_base + KERNEL_PROCESS_TRACE_SEQUENCE_WORD] ==
                        sequence &&
                    copied < KERNEL_CRASH_TRACE_EVENTS) {
                    let output_base: usize =
                        copied * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
                    for word: usize in 0..<KERNEL_PROCESS_TRACE_WORDS_PER_EVENT {
                        *(output + (output_base as isize) + (word as isize)) =
                            kernel_crash_trace[source_base + word];
                    }
                    copied = copied + 1;
                }
            }
        }
    }
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        if (item >= copied) {
            let output_base: usize = item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
            for word: usize in 0..<KERNEL_PROCESS_TRACE_WORDS_PER_EVENT {
                *(output + (output_base as isize) + (word as isize)) = 0;
            }
        }
    }
    return copied;
}


// One formatter for both a live on-demand report and the trace frozen into a
// crash snapshot. `prefix` identifies the surrounding report while every row
// keeps the same field order and representation.
fn kernel_process_trace_render(
        trace: borrow [usize; KERNEL_CRASH_TRACE_WORDS..],
        count: usize, prefix: *u8) {
    kernel_boot_log(prefix);
    kernel_boot_log(" count=");
    uart_put_udec(count);
    kernel_boot_log("\n");
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        if (item < count) {
            let base: usize = item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
            kernel_boot_log(prefix);
            kernel_boot_log(" seq=");
            uart_put_udec(trace[
                base + KERNEL_PROCESS_TRACE_SEQUENCE_WORD]);
            kernel_boot_log(" cpu=");
            uart_put_udec(trace[base + KERNEL_PROCESS_TRACE_CPU_WORD]);
            kernel_boot_log(" event=");
            uart_put_udec(trace[base + KERNEL_PROCESS_TRACE_EVENT_WORD]);
            kernel_boot_log(" pid=");
            uart_put_udec(trace[base + KERNEL_PROCESS_TRACE_PID_WORD]);
            kernel_boot_log(" gen=");
            uart_put_udec(trace[
                base + KERNEL_PROCESS_TRACE_GENERATION_WORD]);
            kernel_boot_log(" peer=");
            uart_put_udec(trace[
                base + KERNEL_PROCESS_TRACE_PEER_PID_WORD]);
            kernel_boot_log(" peer-gen=");
            uart_put_udec(trace[
                base + KERNEL_PROCESS_TRACE_PEER_GENERATION_WORD]);
            kernel_boot_log(" state=");
            uart_put_udec(trace[base + KERNEL_PROCESS_TRACE_STATE_WORD]);
            kernel_boot_log(" wait=");
            uart_put_udec(trace[
                base + KERNEL_PROCESS_TRACE_WAIT_REASON_WORD]);
            kernel_boot_log(" root=");
            uart_put_udec(trace[base + KERNEL_PROCESS_TRACE_ROOT_WORD]);
            kernel_boot_log(" sp=");
            uart_put_hex(
                trace[base + KERNEL_PROCESS_TRACE_SAVED_SP_WORD]);
            kernel_boot_log(" aux=");
            uart_put_hex(
                trace[base + KERNEL_PROCESS_TRACE_AUX_WORD]);
            kernel_boot_log("\n");
        }
    }
}

// Callable from a fixture, a deliberate debug stop, or GDB. Snapshot first:
// printing is deliberately outside scheduler/IRQ writers, and the caller sees
// one oldest-to-newest tail rather than following a ring that keeps moving.
fn kernel_process_trace_report() {
    let mut trace: [usize; KERNEL_CRASH_TRACE_WORDS];
    let count: usize = kernel_process_crash_trace_copy(trace as *usize);
    kernel_process_trace_render(
        trace as []usize, count, "process trace:" as *u8);
}

must_use variant ProcessUartProgressResult { Invalid; Recorded; }

fn kernel_process_start_handle(guard: borrow ProcessRunGuard[lock],
                               handle: ProcessHandle) -> bool {
    match scheduled_process_ready_take(guard, handle) {
        ScheduledProcessReadyTakeResult::Missing => { return false; }
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            let running = scheduled_process_start(owner, ready);
            let core: usize = cpu_id();
            if (core >= KERNEL_MAX_CORES) {
                let back = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, back);
                return false;
            }
            scheduled_process_record_of_locked(guard, handle).stack_owner_cpu = core;
            execution_here().stack_handle = handle;
            execution_here().stack_live = true;
            scheduled_process_release(owner, running);
            return true;
        }
    }
}

fn kernel_process_yield_handle(guard: borrow ProcessRunGuard[lock],
                               handle: ProcessHandle) -> bool {
    match scheduled_process_running_take(guard, handle) {
        ScheduledProcessRunningTakeResult::Missing => { return false; }
        ScheduledProcessRunningTakeResult::Running(resources) => {
            let (owner, running) = resources;
            let ready = scheduled_process_yield(owner, running);
            scheduled_process_release(owner, ready);
            return true;
        }
    }
}

must_use variant ProcessCloneFailure {
    Invalid;
    ResourceExhausted;
}

must_use variant ProcessCloneResult {
    Invalid;
    ResourceExhausted;
    ChildConstructing(usize);
}

fn kernel_process_execution_reset() {
    // Timer IRQs stay enabled across consecutive EL0 workloads. Close the
    // scheduling gate before invalidating any handle or saved frame: leaving
    // the previous workload enabled until later in this reset allowed an IRQ
    // to select a half-cleared stale context.
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
    execution_here().stack_live = false;
    execution_here().deferred_reap_live = false;
    scheduled_process_table_clear();
    execution_here().current_live = false;
    process_test_evidence_reset();
    kernel_process_trace_enabled = kernel_process_trace_boot_enabled;
    kernel_process_crash_trace_reset();
    // No per-slot clearing loop: scheduled_process_table_clear above
    // destroyed every pooled record and reset the bootstrap's static one,
    // which is strictly more than this loop did (issue #392).
    match scheduled_process_alloc_bootstrap() {
        ScheduledBootstrapProcessAllocResult::Full => {}
        ScheduledBootstrapProcessAllocResult::Allocated(bootstrap) => {
            let mut root: ProcessHandle =
                scheduled_bootstrap_process_handle(bootstrap);
            execution_here().current_handle = root;
            let start_guard = process_run_lock();
            execution_here().current_live =
                kernel_process_start_handle(start_guard, root);
            let root_saved_sp: usize =
                scheduled_process_record_of_locked(start_guard, root).saved_sp;
            process_run_unlock(start_guard);
            if (execution_here().current_live) {
                kernel_process_trace_record(
                    ProcessTraceResume,
                    scheduled_process_pid_of_handle(root), root.generation,
                    0, 0, 2, 0, root.pool_index, root_saved_sp, 0);
            }
        }
    }
}

fn kernel_process_request_reschedule() {
    if (execution_here().scheduler_enabled) {
        execution_here().reschedule_pending = true;
        process_test_evidence_record_deferred_request();
    }
}

fn kernel_process_scheduler_enable() {
    execution_here().scheduler_enabled = true;
}

fn kernel_process_scheduler_disable() {
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
}

// Lookup-only debugger view of the scheduler control bits. DDB must not
// acquire an owner or make a scheduling decision merely to describe them.
fn kernel_process_ddb_scheduler_enabled() -> usize {
    if (execution_here().scheduler_enabled) { return 1; }
    return 0;
}

fn kernel_process_ddb_reschedule_pending() -> usize {
    if (execution_here().reschedule_pending) { return 1; }
    return 0;
}

// GitHub issue #209: how many slots could the scheduler still choose
// between. Exited slots are excluded: they are awaiting reap, never
// selection.
// GitHub issue #414: how many process records the pool is holding. The
// boot suite compares it against a baseline at the end of the bounded
// run, which is what says a refused allocation gave its record back --
// the page check one line below cannot say that on its own, because a
// chunk keeps its page whether or not the record inside it was returned.
fn scheduled_process_pool_live_count() -> usize !{unsafe} {
    return intrusive_pool_live_count(&scheduled_process_pool);
}

fn kernel_process_schedulable_count() -> usize {
    let mut live: usize = 0;
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let state: ProcessSlotState =
                    scheduled_process_record_state(slot);
                if (state != ProcessSlotState::Free &&
                    state != ProcessSlotState::Exited) {
                    live = live + 1;
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    return live;
}

// Walking up parent links from anywhere reaches the root, which is what
// makes the rotation below definable without a run queue.
//
// This used to say the live tree is a CHAIN, because a ProcessRecord held
// one child. It holds a first child and a sibling list now (issue #437),
// so the tree branches and the rotation is a pre-order walk of it -- see
// kernel_process_next_successor. The root is still the root; only the
// shape below it changed.
private fn kernel_process_chain_root(guard: borrow ProcessRunGuard[lock], from: ProcessHandle) -> ProcessHandle {
    let mut root: ProcessHandle = from;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    let mut climbing: bool = true;
    while (climbing && remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_record_of_locked(guard, root).has_parent == false) {
            climbing = false;
        } else {
            let mut parent: ProcessHandle =
                scheduled_process_record_of_locked(guard, root).parent;
            if (scheduled_process_handle_matches(parent) == false) {
                climbing = false;
            } else {
                root = parent;
            }
        }
    }
    return root;
}

must_use variant ProcessNextReadyResult { Missing; Next(ProcessHandle); }

// The next runnable process, in one fixed cyclic order over that chain: a
// process's successor is its child, or the root again when it has none.
//
// The policy this replaces was "switch to my child if I have one, otherwise
// to my parent", and its failure was that it could not step OVER a process
// that was not itself runnable. An interactive shell whose child is a script
// shell parked in wait4 for a daemon two levels further down was never
// selected again: the bottom two processes handed the CPU back and forth,
// which is a valid answer to "who is my relative" and a wrong answer to
// "who should run next". The prompt went silent while the daemon kept
// serving. Rotating instead makes every runnable process reachable from
// every other, at the cost of visiting processes the old policy skipped --
// including a busy-looping PID 1, which was genuinely runnable all along.
// GitHub issue #437: a depth-first walk of the process TREE, where this
// used to be a walk of a process CHAIN.
//
// The old rotation was "successor is your child, or the chain root when
// you have none". That enumerates every live process exactly once only
// because the live tree IS a chain -- give any process two children and
// the walk stops covering the second one and everything under it, so
// lifting the fan-out limit without replacing this would produce a kernel
// that forks and then starves.
//
// The successor here is the ordinary pre-order one: first child, else next
// sibling, else the nearest ancestor's next sibling, else back to the
// root. With no siblings anywhere that reduces to "child, else root" --
// the old walk exactly, which is why this change moves no behaviour and
// the existing views are its oracle.
//
// A pool walk was the alternative and would have dropped the tree
// dependency entirely. It also reorders scheduling by slot address rather
// than by descent, which every view that pins a switch sequence would
// have noticed. Keeping parent/child locality is worth more than dropping
// a dependency the tree walk handles correctly anyway.
private fn kernel_process_next_successor(guard: borrow ProcessRunGuard[lock], from: ProcessHandle,
                                         root: ProcessHandle)
        -> ProcessHandle {
    if (scheduled_process_record_of_locked(guard, from).has_first_child) {
        let mut child: ProcessHandle =
            scheduled_process_record_of_locked(guard, from).first_child;
        if (scheduled_process_handle_matches(child)) { return child; }
    }
    // No child: the next sibling, and failing that the nearest ancestor
    // that has one. Bounded by the live count -- an ancestor chain cannot
    // be longer than the number of live processes, and a cycle would
    // otherwise spin here rather than in the caller.
    let mut cursor: ProcessHandle = from;
    let mut climbing: usize = scheduled_process_pool_live_count() + 1;
    while (climbing != 0) {
        climbing = climbing - 1;
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling) {
            let mut sibling: ProcessHandle =
                scheduled_process_record_of_locked(guard, cursor).next_sibling;
            if (scheduled_process_handle_matches(sibling)) { return sibling; }
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_parent == false) {
            return root;
        }
        let mut parent: ProcessHandle =
            scheduled_process_record_of_locked(guard, cursor).parent;
        if (scheduled_process_handle_matches(parent) == false) { return root; }
        if (scheduled_process_same_slot(parent, root)) { return root; }
        cursor = parent;
    }
    return root;
}

// GitHub issue #9: the affinity ABI. A process that never set a mask is
// placed on every online CPU. A nonzero mask is an admission request of its
// own: the process may run on the CPUs it names, and the migration gate in
// kernel_syscall_dispatch_action keeps every syscall not known to be peer-safe
// on core 0.
fn kernel_process_online_mask() -> usize {
    let online: usize = kernel_online_core_count();
    let mut mask: usize = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if (cpu < online) { mask = mask | (1 << cpu); }
    }
    return mask;
}

// The boot driver's scheduler probes deliberately dismantle and rebuild the
// process table. Once PID 1 has a complete image and is about to enter EL0,
// every Ready pooled process may be dispatched on every online core.
fn kernel_process_peer_dispatch_enable() {
    let guard = process_run_lock();
    scheduled_process_peer_dispatch_enabled = true;
    process_run_unlock(guard);
}

// One placement answer for a real process. A syscall the gate sent to core
// 0 pins the process there until the call completes.
fn kernel_process_cpu_allows_slot(guard: borrow ProcessRunGuard[lock], cpu: usize, slot: usize)
        -> bool {
    if (cpu >= KERNEL_MAX_CORES) { return false; }
    let bit: {0..<KERNEL_MAX_CORES as usize} = cpu;
    // Slot 0 is the permanent bootstrap record. Unlike an ordinary task, it
    // can be Ready before it has a resumable EL0 frame; keep it on the core
    // that owns the bootstrap execution context. Unset affinity on every
    // pooled process still means every online CPU.
    if (slot == 0) { return cpu == 0; }
    if (scheduled_process_core0_for_call(guard, slot)) { return cpu == 0; }
    let mask: usize = scheduled_process_affinity_mask(guard, slot);
    if (mask == 0) {
        return (kernel_process_online_mask() & (1 << bit)) != 0;
    }
    // GitHub issue #579: every core that came up, not core 0 and one
    // secondary. `kernel_process_schedulable_mask` used to name
    // `SECONDARY_CORE_ID` here and was the only thing keeping cores 2 and 3
    // from carrying a process -- `kernel_process_secondary_start` already
    // asks this question with its own `cpu_id()`, and the idle loop every
    // started core sits in already calls it. The set is the online set now,
    // so the second name is gone rather than left as a synonym.
    return (mask & kernel_process_online_mask() & (1 << bit)) != 0;
}

// Whether this CPU may still run the process it is running. False means the
// process's own affinity mask has stopped naming this CPU, which is what
// `sched_setaffinity` does to a process that re-pins itself. The mask is
// shared process state and is written under this same guard, so require it
// for the snapshot used at the syscall boundary.
fn kernel_process_current_cpu_allows(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) -> bool {
    if (execution_here().current_live == false) { return true; }
    return kernel_process_cpu_allows_slot(guard, 
        cpu_id(), execution_here().current_handle.pool_index);
}

// Written under the run lock, by core 0 only. Reported by the workload
// evidence at a fixed point rather than here, where a line would land in the
// middle of whatever the console is showing.
private let mut kernel_process_core0_idle_seen: bool;

fn kernel_process_core0_idle_was_seen(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) -> bool {
    return kernel_process_core0_idle_seen;
}

// GitHub issue #592: core 0's counterpart of kernel_process_migrate_current,
// asked at a syscall return that found no successor. If the returning
// process may not run on core 0, publish core 0 as having no current process
// and keep the frame; kernel_process_stack_idle_yield makes it Ready once
// core 0 is off its stack.
fn kernel_process_core0_leave_excluded(frame: borrow FrameRef[process])
        -> bool {
    if (cpu_id() != 0) { return false; }
    let guard = process_run_lock();
    if (execution_here().current_live == false) {
        process_run_unlock(guard);
        return false;
    }
    let slot: usize = execution_here().current_handle.pool_index;
    if (slot == 0 || kernel_process_cpu_allows_slot(guard, 0, slot)) {
        process_run_unlock(guard);
        return false;
    }
    // Only from the process's own stack. A clone child's first return still
    // stands on its parent's stack until el0_context_resume completes the
    // physical switch, and the yield below releases whatever stack this CPU
    // stands on; the child leaves at its next syscall return instead.
    if (execution_here().stack_live == false ||
        execution_here().stack_handle.pool_index != slot ||
        execution_here().stack_handle.generation !=
            execution_here().current_handle.generation) {
        process_run_unlock(guard);
        return false;
    }
    scheduled_process_record_locked(guard, slot).saved_sp = frame_ref_address(frame);
    execution_here().current_live = false;
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
    kernel_process_core0_idle_seen = true;
    process_run_unlock(guard);
    return true;
}

// Core 0's half of the affinity gate (GitHub issue #581): ask for a
// reschedule at this syscall's return when the running process's mask no
// longer names this CPU. The run lock covers the snapshot, since another CPU
// may be changing the mask.
fn kernel_process_reschedule_if_excluded_here() {
    let guard = process_run_lock();
    let allowed: bool = kernel_process_current_cpu_allows(guard);
    process_run_unlock(guard);
    if (allowed == false) { kernel_process_request_reschedule(); }
}

// The gate handed this peer's current syscall away, and its frame has
// already been rewound. Publish this peer as having no current EL0 context,
// as an exit to idle does; the process stays Running, and so unselectable,
// until kernel_process_stack_idle_yield has moved this CPU off its stack.
//
// GitHub issue #579: WHERE it goes depends on why it was handed away, and
// asking that here is what lets one action serve both reasons.
//
// If this CPU may still run the process, the reason is the syscall -- it is
// outside the peer-safety table and core 0 is the only place it may run --
// so the process is pinned there for the duration of the call. If this CPU
// may NOT run it, the reason is the process's own affinity mask, which
// already names where it may go; pinning it to core 0 would override the
// mask the process just set and send it to a CPU it excluded.
fn kernel_process_migrate_current(frame: borrow FrameRef[process]) -> bool {
    if (cpu_id() == 0) { return false; }
    let guard = process_run_lock();
    if (execution_here().current_live == false) {
        process_run_unlock(guard);
        return false;
    }
    let slot: usize = execution_here().current_handle.pool_index;
    let syscall_needs_core0: bool =
        kernel_process_cpu_allows_slot(guard, cpu_id(), slot);
    scheduled_process_record_locked(guard, slot).saved_sp = frame_ref_address(frame);
    if (syscall_needs_core0) {
        scheduled_process_set_core0_for_call(guard, slot, true);
    }
    execution_here().current_live = false;
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
    process_run_unlock(guard);
    return true;
}

// The syscall the gate sent to core 0 has completed there.
fn kernel_process_clear_core0_for_call(slot: usize) {
    if (scheduled_process_slot_valid(slot) == false) { return; }
    let guard = process_run_lock();
    scheduled_process_set_core0_for_call(guard, slot, false);
    process_run_unlock(guard);
}

must_use variant ProcessAffinityResult { Missing; Invalid; Mask(usize); }

// Pid 0 is the caller, as in Linux.
private fn kernel_process_affinity_slot(pid: usize) -> ProcessSlotForPidResult
        !{unsafe} {
    if (pid == 0) {
        if (execution_here().current_live == false) {
            return ProcessSlotForPidResult::Missing;
        }
        return ProcessSlotForPidResult::Found(
            execution_here().current_handle.pool_index);
    }
    return scheduled_process_slot_for_pid(pid);
}

// GitHub issue #582: every move of a process between CPUs -- an idle CPU's
// pull, a switch, a start after a wake -- takes it through
// scheduled_process_ready_take, and that refuses a process whose stack
// another CPU still stands on. This asks the real function about a real
// Ready process: with a CPU other than this one named as the stack's owner
// it must refuse, and with the owner cleared it must accept. The run lock
// is held across both questions, so no other CPU sees the owner this names,
// and each accepted take is dropped without starting anything.
//
// The caller arranges that `pid` is Ready with an unowned stack.
// Answers: 1 refused then accepted; 0 the process was not in that state;
// 2 taken while another CPU owned its stack; 3 refused with none owning it.
fn kernel_process_stack_owner_probe(pid: usize) -> usize !{unsafe} {
    let guard = process_run_lock();
    let slot: usize = match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => {
            process_run_unlock(guard);
            return 0;
        }
        ProcessSlotForPidResult::Found(found) => { found }
    };
    let mut handle: ProcessHandle = scheduled_process_handle_of_slot(slot);
    if (slot == 0 ||
        scheduled_process_record_state(slot) != ProcessSlotState::Ready ||
        scheduled_process_record_locked(guard, slot).stack_owner_cpu !=
            PROCESS_STACK_UNOWNED) {
        process_run_unlock(guard);
        return 0;
    }
    let mut other_cpu: usize = 0;
    if (cpu_id() == 0) { other_cpu = 1; }
    scheduled_process_record_locked(guard, slot).stack_owner_cpu = other_cpu;
    let mut refused: bool = true;
    match scheduled_process_ready_take(guard, handle) {
        ScheduledProcessReadyTakeResult::Missing => {}
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            scheduled_process_release(owner, ready);
            refused = false;
        }
    }
    scheduled_process_record_locked(guard, slot).stack_owner_cpu = PROCESS_STACK_UNOWNED;
    let mut accepted: bool = false;
    match scheduled_process_ready_take(guard, handle) {
        ScheduledProcessReadyTakeResult::Missing => {}
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            scheduled_process_release(owner, ready);
            accepted = true;
        }
    }
    process_run_unlock(guard);
    if (refused == false) { return 2; }
    if (accepted == false) { return 3; }
    return 1;
}

// sched_getaffinity: the mask the process set, or every online CPU when it
// set none.
fn kernel_process_affinity_get(pid: usize) -> ProcessAffinityResult
        !{unsafe} {
    let guard = process_run_lock();
    let slot: usize = match kernel_process_affinity_slot(pid) {
        ProcessSlotForPidResult::Missing => {
            process_run_unlock(guard);
            return ProcessAffinityResult::Missing;
        }
        ProcessSlotForPidResult::Found(found) => { found }
    };
    let mask: usize = scheduled_process_affinity_mask(guard, slot);
    process_run_unlock(guard);
    if (mask == 0) {
        return ProcessAffinityResult::Mask(kernel_process_online_mask());
    }
    return ProcessAffinityResult::Mask(mask);
}

// sched_setaffinity keeps the online CPUs of the requested mask. Linux
// refuses a mask with no online CPU in it, or none the task's cpuset
// permits; here the permitted set is the CPUs the scheduler runs processes
// on. The process moves at the next scheduling decision on the CPU it is
// on -- a syscall return, or a tick taken from EL0 -- not at once.
fn kernel_process_affinity_set(pid: usize, requested: usize)
        -> ProcessAffinityResult !{unsafe} {
    let mask: usize = requested & kernel_process_online_mask();
    if (mask == 0) { return ProcessAffinityResult::Invalid; }
    let guard = process_run_lock();
    let slot: usize = match kernel_process_affinity_slot(pid) {
        ProcessSlotForPidResult::Missing => {
            process_run_unlock(guard);
            return ProcessAffinityResult::Missing;
        }
        ProcessSlotForPidResult::Found(found) => { found }
    };
    // `mask` is already the requested set intersected with the online one,
    // and a request naming no online CPU was refused above, so this can only
    // fail if the two sets ever stop agreeing again.
    if ((mask & kernel_process_online_mask()) == 0) {
        process_run_unlock(guard);
        return ProcessAffinityResult::Invalid;
    }
    scheduled_process_set_affinity_mask(guard, slot, mask);
    let mut leave_this_cpu: bool = false;
    if (execution_here().current_live) {
        if (execution_here().current_handle.pool_index == slot) {
            leave_this_cpu =
                kernel_process_cpu_allows_slot(guard, cpu_id(), slot) == false;
        }
    }
    process_run_unlock(guard);
    if (leave_this_cpu) { kernel_process_request_reschedule(); }
    return ProcessAffinityResult::Mask(mask);
}

private fn kernel_process_next_ready(guard: borrow ProcessRunGuard[lock], from: ProcessHandle, cpu: usize)
        -> ProcessNextReadyResult {
    let activity_before: KernelActivity =
        kernel_activity_enter(KernelActivity::NextReady);
    let mut root: ProcessHandle = kernel_process_chain_root(guard, from);
    let mut cursor: ProcessHandle = from;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        cursor = kernel_process_next_successor(guard, cursor, root);
        if (scheduled_process_same_slot(cursor, from) == false &&
            scheduled_process_state_of(cursor) == ProcessSlotState::Ready &&
            kernel_process_cpu_allows_slot(guard, cpu, cursor.pool_index) &&
            workload_busy_starve_skips(
                scheduled_process_pid_of_handle(cursor)) == false) {
            kernel_activity_leave(activity_before);
            return ProcessNextReadyResult::Next(cursor);
        }
    }
    kernel_activity_leave(activity_before);
    return ProcessNextReadyResult::Missing;
}

// GitHub issue #245 generalized this from a fixed two-process Parent/Child
// toggle to "whichever slot has a live child is playing the parent role".
// That still only ever looked at ONE relative; the rotation above looks at
// every live process, which is what a chain deeper than that one relative
// requires.
// GitHub issue #479 Group B: ONE critical section, covering the walk and
// the transition together. Two sections would not be a smaller version of
// this -- selecting a successor under one lock and then finding it
// claimed under another is a livelock, not a fix -- and the walk itself
// reads the parent/sibling links that clone and child_exit splice.
//
// The lock is released before this returns, and that is safe because the
// switch is not performed here: this returns the incoming process's saved
// SP and the exception-return path installs it. So the guard's lifetime
// does not have to survive a context switch, which is the problem Linux
// solves with finish_task_switch.
// What a scheduling decision came to. `Stay` keeps the frame that entered, so
// the caller still holds it and decides what to resume; `Switch` is the
// frame of another process, which is the one to resume instead.
must_use variant FrameSwitch {
    Stay;
    Switch(exists next: usize. FrameRef[next]);
}

fn kernel_process_schedule(current: borrow FrameRef[process]) -> FrameSwitch {
    if (execution_here().current_live == false) { return FrameSwitch::Stay; }
    let mut from: ProcessHandle = execution_here().current_handle;
    let guard = process_run_lock();
    match kernel_process_next_ready(guard, from, cpu_id()) {
        ProcessNextReadyResult::Missing => {
            process_run_unlock(guard);
            return FrameSwitch::Stay;
        }
        ProcessNextReadyResult::Next(to) => {
            match scheduled_process_ready_take(guard, to) {
                ScheduledProcessReadyTakeResult::Missing => {
                    process_run_unlock(guard);
                    return FrameSwitch::Stay;
                }
                ScheduledProcessReadyTakeResult::Ready(resources) => {
                    let (owner, ready) = resources;
                    let running = scheduled_process_start(owner, ready);
                    process_run_unlock(guard);
                    return kernel_process_schedule_reserved(
                        from, owner, running, current);
                }
            }
        }
    }
}

// Start a Ready process on a CPU that has no outgoing EL0 context yet. The
// Ready -> Running state token is the reservation while ASID preparation may
// drop ProcessRunGuard or stop the machine, exactly as in an ordinary switch.
must_use variant ProcessSecondaryStart {
    Idle;
    Frame(exists process: usize. FrameRef[process]);
}

private fn kernel_process_secondary_start_reserved(
        owner: sink ScheduledProcessOwner[process],
        running: sink ScheduledProcessState[process, ProcessState::Running])
        -> ProcessSecondaryStart {
    match process_image_prepare_activation(owner.pool_index) {
        AddressSpaceActivationPrepareResult::Invalid => {
            let guard = process_run_lock();
            let ready = scheduled_process_yield(owner, running);
            scheduled_process_release(owner, ready);
            process_run_unlock(guard);
            return ProcessSecondaryStart::Idle;
        }
        AddressSpaceActivationPrepareResult::RolloverNeeded => {
            match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                                   SCHEDULER_WORLD_STOP_SPINS) {
                WorldStopResult::Busy => {
                    let guard = process_run_lock();
                    let ready = scheduled_process_yield(owner, running);
                    scheduled_process_release(owner, ready);
                    process_run_unlock(guard);
                    return ProcessSecondaryStart::Idle;
                }
                WorldStopResult::Partial(partial) => {
                    world_stop_partial_release(partial, &kernel_world_stop);
                    let guard = process_run_lock();
                    let ready = scheduled_process_yield(owner, running);
                    scheduled_process_release(owner, ready);
                    process_run_unlock(guard);
                    return ProcessSecondaryStart::Idle;
                }
                WorldStopResult::Complete(stopped) => {
                    if (asid_rollover_stopped(stopped)) {}
                    world_stop_release(stopped, &kernel_world_stop);
                    return kernel_process_secondary_start_reserved(owner, running);
                }
            }
        }
        AddressSpaceActivationPrepareResult::Prepared(prepared) => {
            let guard = process_run_lock();
            let mut to: ProcessHandle = {
                owner.pool_index, owner.generation
            };
            if (execution_here().current_live ||
                scheduled_process_handle_matches(to) == false ||
                scheduled_process_state_of(to) != ProcessSlotState::Running) {
                process_image_cancel_activation(prepared);
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return ProcessSecondaryStart::Idle;
            }
            if (process_image_commit_activation(prepared) == false) {
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return ProcessSecondaryStart::Idle;
            }
            execution_here().current_handle = to;
            execution_here().current_live = true;
            execution_here().scheduler_enabled = true;
            execution_here().reschedule_pending = false;
            timer_tick_rearm();
            workload_busy_note_selected_locked(
                guard, scheduled_process_pid_of_handle(to));
            kernel_process_trace_handle(ProcessTraceResume, to, to, 0);
            let next = scheduled_process_saved_frame(owner);
            if (scheduled_process_wait_reason_of(to) ==
                    ProcessWaitReason::ChildExit) {
                scheduled_process_wait_settle(scheduled_process_record_of_locked(guard, to));
            }
            scheduled_process_release(owner, running);
            process_run_unlock(guard);
            return ProcessSecondaryStart::Frame(next);
        }
    }
}

// An idle CPU that goes on idling beside a Ready process it may run and
// could take. The walk above decides what to take; this asks the same
// question independently -- every record, slot 0 included, by state, mask
// and stack owner alone -- so a filter the walk should not have had shows
// up by name. It found nothing to watch for until b1447bfb, where the walk
// skipped PID 1 and init was left Ready on every four-core RPi5 run; the
// evidence then took five instrumented board runs to collect.
//
// A take can be refused for a moment (a reap waiting for a stack to be
// released), so only the same pid left for KERNEL_IDLE_STARVATION_PASSES
// consecutive empty passes on this CPU is reported, once per boot.
const KERNEL_IDLE_STARVATION_PASSES: usize = 256;
private let mut kernel_idle_starvation_pid: [usize; KERNEL_MAX_CORES];
private let mut kernel_idle_starvation_passes: [usize; KERNEL_MAX_CORES];
private let mut kernel_idle_starvation_reported: bool = false;

private fn kernel_process_idle_starvation_note(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) !{unsafe} {
    let raw_cpu: usize = cpu_id();
    if (raw_cpu >= KERNEL_MAX_CORES) { return; }
    let cpu: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    let mut left: usize = 0;
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                if (left == 0 &&
                    scheduled_process_record_state(slot) ==
                        ProcessSlotState::Ready &&
                    kernel_process_cpu_allows_slot(guard, raw_cpu, slot) &&
                    scheduled_process_record_locked(guard, slot).stack_owner_cpu ==
                        PROCESS_STACK_UNOWNED) {
                    left = scheduled_process_record_locked(guard, slot).pid;
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    if (left == 0 || left != kernel_idle_starvation_pid[cpu]) {
        kernel_idle_starvation_pid[cpu] = left;
        kernel_idle_starvation_passes[cpu] = 0;
        return;
    }
    kernel_idle_starvation_passes[cpu] = kernel_idle_starvation_passes[cpu] + 1;
    if (kernel_idle_starvation_passes[cpu] == KERNEL_IDLE_STARVATION_PASSES &&
        kernel_idle_starvation_reported == false) {
        kernel_idle_starvation_reported = true;
        kernel_boot_log("sched: STARVED cpu=");
        uart_put_udec(raw_cpu);
        kernel_boot_log(" idled beside Ready pid=");
        uart_put_udec(left);
        kernel_boot_log(" it may run\n");
    }
}

// Called by a secondary CPU's architectural idle loop. Idle means no admitted
// Ready process exists yet; Frame carries a complete saved EL0 context.
fn kernel_process_secondary_start() -> ProcessSecondaryStart {
    if (cpu_id() >= KERNEL_ACTIVE_CORES) {
        return ProcessSecondaryStart::Idle;
    }
    if (execution_here().current_live) { return ProcessSecondaryStart::Idle; }
    let guard = process_run_lock();
    if (scheduled_process_peer_dispatch_enabled == false) {
        process_run_unlock(guard);
        return ProcessSecondaryStart::Idle;
    }
    let activity_before: KernelActivity =
        kernel_activity_enter(KernelActivity::SecondaryStart);
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                // Slot 0 is PID 1, which only core 0 may run
                // (kernel_process_cpu_allows_slot). Core 0's idle loop
                // (#592) takes it like any other: by the time peer dispatch
                // is enabled, just before run_initial_user, the bootstrap has
                // its complete image, and from then on it is Ready only after
                // a block or a switch saved its EL0 frame. It used to be
                // skipped here, which left PID 1 Ready and never run once
                // #611 put init's children on peers: a child that exits on a
                // peer leaves its parent Ready rather than starting it, and
                // an idle core 0 then never took it, so init stopped
                // reaping and respawning (four-core RPi5, every run).
                // The last test is #572's starvation control, false on
                // every boot a debugger did not arm.
                if (scheduled_process_record_state(slot) ==
                        ProcessSlotState::Ready &&
                    kernel_process_cpu_allows_slot(guard, cpu_id(), slot) &&
                    workload_busy_starve_skips(
                        scheduled_process_record_locked(guard, slot).pid) == false) {
                    let mut handle: ProcessHandle =
                        scheduled_process_handle_of_slot(slot);
                    match scheduled_process_ready_take(guard, handle) {
                        ScheduledProcessReadyTakeResult::Missing => {}
                        ScheduledProcessReadyTakeResult::Ready(resources) => {
                            let (owner, ready) = resources;
                            let running = scheduled_process_start(owner, ready);
                            kernel_activity_leave(activity_before);
                            process_run_unlock(guard);
                            return kernel_process_secondary_start_reserved(
                                owner, running);
                        }
                    }
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    kernel_activity_leave(activity_before);
    kernel_process_idle_starvation_note(guard);
    process_run_unlock(guard);
    return ProcessSecondaryStart::Idle;
}

private fn kernel_process_schedule_cancel_reserved(
        owner: sink ScheduledProcessOwner[process],
        running: sink ScheduledProcessState[process, ProcessState::Running]) {
    let guard = process_run_lock();
    let ready = scheduled_process_yield(owner, running);
    scheduled_process_release(owner, ready);
    process_run_unlock(guard);
}

private fn kernel_process_schedule_reserved(
        from: ProcessHandle,
        owner: sink ScheduledProcessOwner[process],
        running: sink ScheduledProcessState[process, ProcessState::Running],
        current: borrow FrameRef[from_process]) -> FrameSwitch {
    match process_image_prepare_activation(owner.pool_index) {
        AddressSpaceActivationPrepareResult::Invalid => {
            kernel_process_schedule_cancel_reserved(owner, running);
            return FrameSwitch::Stay;
        }
        AddressSpaceActivationPrepareResult::RolloverNeeded => {
            match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                                   SCHEDULER_WORLD_STOP_SPINS) {
                WorldStopResult::Busy => {
                    kernel_process_schedule_cancel_reserved(owner, running);
                    return FrameSwitch::Stay;
                }
                WorldStopResult::Partial(partial) => {
                    world_stop_partial_release(partial, &kernel_world_stop);
                    kernel_process_schedule_cancel_reserved(owner, running);
                    return FrameSwitch::Stay;
                }
                WorldStopResult::Complete(stopped) => {
                    if (asid_rollover_stopped(stopped)) {}
                    world_stop_release(stopped, &kernel_world_stop);
                    return kernel_process_schedule_reserved(
                        from, owner, running, current);
                }
            }
        }
        AddressSpaceActivationPrepareResult::Prepared(prepared) => {
            let guard = process_run_lock();
            let mut to: ProcessHandle = {
                owner.pool_index, owner.generation
            };
            let mut current_matches: bool = false;
            if (execution_here().current_live) {
                current_matches = scheduled_process_same_slot(
                    execution_here().current_handle, from);
            }
            if (current_matches == false ||
                scheduled_process_handle_matches(from) == false ||
                scheduled_process_state_of(from) != ProcessSlotState::Running ||
                scheduled_process_handle_matches(to) == false ||
                scheduled_process_state_of(to) != ProcessSlotState::Running) {
                process_image_cancel_activation(prepared);
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return FrameSwitch::Stay;
            }
            scheduled_process_record_of_locked(guard, from).saved_sp = frame_ref_address(current);
            if (kernel_process_yield_handle(guard, from) == false) {
                process_image_cancel_activation(prepared);
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return FrameSwitch::Stay;
            }
            if (process_image_commit_activation(prepared) == false) {
                if (kernel_process_start_handle(guard, from)) {}
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return FrameSwitch::Stay;
            }
            execution_here().current_handle = to;
            profile_timeline_schedule(
                scheduled_process_pid_of_handle(from),
                scheduled_process_pid_of_handle(to));
            // GitHub issue #448: every incoming process starts a whole
            // quantum, including a deferred switch taken at syscall return.
            timer_tick_rearm();
            workload_busy_note_selected_locked(
                guard, scheduled_process_pid_of_handle(to));
            kernel_process_trace_handle(ProcessTraceSchedule, to, from, 0);
            kernel_process_trace_handle(ProcessTraceResume, to, from, 0);
            let next = scheduled_process_saved_frame(owner);
            if (scheduled_process_wait_reason_of(to) ==
                    ProcessWaitReason::ChildExit) {
                scheduled_process_wait_settle(scheduled_process_record_of_locked(guard, to));
            }
            scheduled_process_release(owner, running);
            process_run_unlock(guard);
            return FrameSwitch::Switch(next);
        }
    }
}

// Activate the process that is already logically current. Clone installs its
// child state before returning through the copied frame, and clone rollback
// restores the parent before discarding the unfinished child; neither path
// needs a target reservation, but both still need rollover outside the run
// lock and a revalidation immediately before TTBR0 changes.
must_use variant CurrentRootActivationResult { Invalid; Activated; }

fn kernel_process_activate_current_root() -> CurrentRootActivationResult {
    if (execution_here().current_live == false) {
        return CurrentRootActivationResult::Invalid;
    }
    let mut current: ProcessHandle = execution_here().current_handle;
    // GitHub issue #632: as in kernel_process_activate_stable_root, a
    // rollover that cannot stop the world at once is waited out and retried.
    // A fork child makes this activation before its first return to EL0.
    // #584's long churn run fail-stopped here on a Partial stop at the first
    // ASID wrap after a DDB reading, on QEMU and RPi5, once exec no longer did.
    if (kernel_process_clone_rollover_busy_injections != 0) {
        asid_force_rollover_needed();
    }
    let mut injected_busy: usize = 0;
    while (true) {
    match process_image_prepare_activation(current.pool_index) {
        AddressSpaceActivationPrepareResult::Invalid => {
            return CurrentRootActivationResult::Invalid;
        }
        AddressSpaceActivationPrepareResult::RolloverNeeded => {
            if (kernel_process_clone_rollover_busy_injections != 0) {
                kernel_process_clone_rollover_busy_injections =
                    kernel_process_clone_rollover_busy_injections - 1;
                injected_busy = injected_busy + 1;
                kernel_process_rollover_backoff();
                continue;
            }
            match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                                   SCHEDULER_WORLD_STOP_SPINS) {
                WorldStopResult::Busy => {
                    kernel_process_rollover_backoff();
                }
                WorldStopResult::Partial(partial) => {
                    world_stop_partial_release(partial, &kernel_world_stop);
                    kernel_process_rollover_backoff();
                }
                WorldStopResult::Complete(stopped) => {
                    if (asid_rollover_stopped(stopped)) {}
                    world_stop_release(stopped, &kernel_world_stop);
                }
            }
        }
        AddressSpaceActivationPrepareResult::Prepared(prepared) => {
            let guard = process_run_lock();
            let mut current_matches: bool = false;
            if (execution_here().current_live) {
                current_matches = scheduled_process_same_slot(
                    execution_here().current_handle, current);
            }
            if (current_matches == false ||
                scheduled_process_handle_matches(current) == false ||
                scheduled_process_state_of(current) !=
                    ProcessSlotState::Running) {
                process_image_cancel_activation(prepared);
                process_run_unlock(guard);
                return CurrentRootActivationResult::Invalid;
            }
            let committed: bool = process_image_commit_activation(prepared);
            process_run_unlock(guard);
            if (injected_busy != 0) {
                kernel_boot_log("asid rollover: clone activation retried " as *u8);
                uart_put_udec(injected_busy);
                kernel_boot_log(" busy world stops, then rolled over\n" as *u8);
            }
            if (committed) { return CurrentRootActivationResult::Activated; }
            return CurrentRootActivationResult::Invalid;
        }
    }
    }
    return CurrentRootActivationResult::Invalid;
}

// Activate a root while the current process remains fixed in non-preemptible
// EL1. Unlike a scheduler handoff, no Ready target exists to reserve: callers
// use this before tearing down a different root or to restore the already-
// current Running process around kernel-only work. Rollover still requires a
// complete world stop. Once teardown depends on this switch there is no safe
// userspace return on failure, so the existing syscall fail-stop is explicit.
// GitHub issue #632: a rollover this core cannot stop the world for is
// retried, not fatal. Busy means another core holds the world stop -- very
// likely rolling the same counter over, after which the retried preparation
// simply finds a current generation. Partial means a core did not
// acknowledge in time; it has been released and asked again. Either used to
// fail-stop the whole kernel, which #584's long churn run hit on RPi5 at the
// ASID counter's first wrap during a real workload: exec is the one caller
// with no scheduler to hand the work back to, and it has already committed
// the new image, so it cannot fail either.
//
// The wait between attempts leaves this core's interrupt mask as it is. With
// interrupts open it answers the other core's stop request while it waits;
// with them masked the other core ends with Partial and releases, and this
// core's next claim succeeds. The wait differs per core so two cores that
// both retry do not keep meeting.
fn kernel_process_activate_stable_root(root: usize) {
    let mut activating: bool = true;
    let mut injected_busy: usize = 0;
    if (kernel_process_rollover_busy_injections != 0) {
        asid_force_rollover_needed();
    }
    while (activating) {
        match process_image_prepare_activation(root) {
            AddressSpaceActivationPrepareResult::Invalid => {
                kernel_syscall_fail_stop(
                    scheduled_process_record_of(
                        execution_here().current_handle).saved_sp);
            }
            AddressSpaceActivationPrepareResult::RolloverNeeded => {
                if (kernel_process_rollover_busy_injections != 0) {
                    kernel_process_rollover_busy_injections =
                        kernel_process_rollover_busy_injections - 1;
                    injected_busy = injected_busy + 1;
                    kernel_process_rollover_backoff();
                    continue;
                }
                match world_stop_begin(&kernel_world_stop,
                                       kernel_online_core_count(),
                                       SCHEDULER_WORLD_STOP_SPINS) {
                    WorldStopResult::Busy => {
                        kernel_process_rollover_backoff();
                    }
                    WorldStopResult::Partial(partial) => {
                        world_stop_partial_release(partial, &kernel_world_stop);
                        kernel_process_rollover_backoff();
                    }
                    WorldStopResult::Complete(stopped) => {
                        if (asid_rollover_stopped(stopped)) {}
                        world_stop_release(stopped, &kernel_world_stop);
                    }
                }
            }
            AddressSpaceActivationPrepareResult::Prepared(prepared) => {
                if (process_image_commit_activation(prepared) == false) {
                    kernel_syscall_fail_stop(
                        scheduled_process_record_of(
                            execution_here().current_handle).saved_sp);
                }
                activating = false;
                if (injected_busy != 0) {
                    kernel_boot_log("asid rollover: activation retried " as *u8);
                    uart_put_udec(injected_busy);
                    kernel_boot_log(" busy world stops, then rolled over\n" as *u8);
                }
            }
        }
    }
}

// About (cpu + 1) x 100 microseconds of the generic counter.
fn kernel_process_rollover_backoff() {
    let ticks: usize = (read_cntfrq() as usize / 10000) * (cpu_id() + 1);
    let start: usize = read_cntpct() as usize;
    while ((read_cntpct() as usize) - start < ticks) {}
}

// GitHub issue #244: distinguishes "no child at all" (wait4 should fail
// with -ECHILD immediately, same as always) from "a child exists but
// hasn't exited yet" (wait4 should block instead).
// Called inside wait4's decision hold, whose guard it borrows (#693 step 3).
fn kernel_process_current_has_live_child(guard: borrow ProcessRunGuard[lock])
        -> bool {
    // GitHub issue #437: LIVE, which a zombie is not. This decides
    // -ECHILD versus blocking in wait4, and counting an exited-but-
    // unreaped child as live would block a parent that has one waiting to
    // be collected.
    if (execution_here().current_live == false) { return false; }
    return kernel_process_has_live_child_of(guard,
        execution_here().current_handle.pool_index);
}

// Is there another process the scheduler could pick right now?
//
// GitHub issue #448: this is what a syscall about to wait for a device has
// to ask before it waits INSIDE the kernel. The UART read path used to ask
// "do I have a live child" instead, and answered "no" for an interactive
// shell sitting at its prompt -- true, and the wrong question, because the
// shell's SIBLINGS were runnable and got nothing while the kernel span at
// EL1 waiting for a keystroke. Kernel mode does not preempt, so that spin
// is the whole machine.
fn kernel_process_other_ready() -> bool {
    if (execution_here().current_live == false) { return false; }
    // GitHub issue #693 step 3: the walk reads other processes' records,
    // so it runs under the run lock. Its answer is a hint; the block path
    // decides again under the lock.
    let ready_guard = process_run_lock();
    let mut other: bool = false;
    match kernel_process_next_ready(ready_guard,
                                    execution_here().current_handle, cpu_id()) {
        ProcessNextReadyResult::Missing => {}
        ProcessNextReadyResult::Next(next) => { other = true; }
    }
    process_run_unlock(ready_guard);
    return other;
}

// Is the current process itself the event that can make a blocked parent
// runnable?
//
// GitHub issue #524: "no other process is Ready" is not sufficient
// permission to wait inside non-preemptible EL1. A parent blocked in wait4()
// is not Ready precisely because it is waiting for this process to exit; if
// this process instead waits for an unrelated device while holding the
// machine, neither side can produce the other's progress condition.
//
// Child exit wakes its direct parent, so this asks about that exact edge
// rather than treating every blocked process as a reason to yield.
fn kernel_process_current_exit_has_waiter() -> bool {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) { { let __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    let slot: usize = execution_here().current_handle.pool_index;
    if (scheduled_process_record_running(running_here).has_parent == false) { { let __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    let mut parent: ProcessHandle = scheduled_process_record_running(running_here).parent;
    { let __running_result: bool = scheduled_process_handle_matches(parent) &&
           scheduled_process_state_of(parent) == ProcessSlotState::Blocked &&
           scheduled_process_wait_reason_of(parent) ==
               ProcessWaitReason::ChildExit; process_running_end(running_here); return __running_result; }
}

fn kernel_process_current_has_relative() -> bool {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) { { let __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    let slot: usize = execution_here().current_handle.pool_index;
    { let __running_result: bool = scheduled_process_record_running(running_here).has_first_child ||
           scheduled_process_record_running(running_here).has_parent; process_running_end(running_here); return __running_result; }
}

// GitHub issue #375: make a kernel stack overflow LOUD.
//
// #373 diagnosed the failure this catches: a one-page kernel stack grows
// down past its own page base and writes into whatever page precedes it.
// When that page is a process's text the process executes kernel frames;
// when it is anything else the corruption is silent. Which page it is
// depends on allocation order, so the tree passes or fails on luck.
//
// The check: the poison at the stack's bottom, and in the witness just
// below it, is no longer intact. Both halves of the run are filled at
// allocation, so nothing disturbs either until a frame reaches that far.
//
// Comparing SP against the stack's own range was tried first and is
// WRONG here: `execution_here().current_live` says a process exists, not that
// the kernel is currently running on that process's stack. Plenty of
// kernel work (the distro exec path, every boot fixture) runs on the boot
// stack entry.S set up, whose SP is nowhere near a pooled stack -- so the
// range test reported a 7-page overflow on a healthy boot. The low-word
// test asks a question about the STACK rather than about who is standing
// on it, and has no such ambiguity.
//
// NetBSD ships the same idea as `options KSTACK_CHECK_MAGIC`. It is a
// poll, not a trap: it answers at the three call sites below rather than
// at the moment of the write, and what bounds the damage in between is
// the quarantine half of the run, not this check.
//
// Called from the places that hold a REAL frame pointer -- the timer IRQ
// handlers and the syscall return path -- rather than from
// kernel_process_timer_schedule/_syscall_return_schedule, which
// scheduled_process_probe_cycle drives with synthetic values (0x1000,
// 0x2000) to exercise scheduling without a frame. A guard that fires on
// those is reporting the test, not the kernel.
// GitHub issue #376: the whole stack is filled with this at allocation,
// so the deepest byte that is no longer it IS the high-water mark. Issue
// #375's bottom-reached guard reads the same fill rather than keeping a
// witness of its own -- one fact, one source.
//
// Linux does this as CONFIG_DEBUG_STACK_USAGE and NetBSD as
// KSTACK_CHECK_MAGIC. The value only has to be something a stack frame is
// unlikely to write by coincidence; 0xA5 is the traditional choice and
// stays recognizable in a hex dump.
const KERNEL_STACK_POISON: u8 = 0xA5;

// How many bytes at the BOTTOM the guard checks. Wider than one word so a
// single large frame cannot step over the whole witness in one push.
const KERNEL_STACK_WITNESS_BYTES: usize = 64;

// The overflow witness sits immediately BELOW the stack, at the top of
// the quarantine half, and gets its own overlay so the scan indexes from
// zero. Expressing it as an offset into KernelStackHalf instead would
// put arithmetic inside an array index for no gain -- and this is code
// that runs on every timer interrupt, so it reads 64 bytes rather than
// the whole 16384-byte region.
struct KernelStackWitness {
    bytes: [u8; KERNEL_STACK_WITNESS_BYTES];
}

private fn kernel_stack_below_witness(bottom: usize)
        -> *KernelStackWitness !{unsafe} {
    return unsafe { (bottom - KERNEL_STACK_WITNESS_BYTES) as *KernelStackWitness };
}

// FAIL-STOPS.
//
// It reported and returned for as long as this kernel tripped the check
// on a NORMAL boot, with no reproducer and no injection: 3968 bytes was
// not enough for its deepest path, so halting would have made every run
// red for a reason already tracked and hidden anything else the suite
// found. Four pages removed that -- the deepest path measures 4368 bytes
// against 16384 -- so reaching the bottom now means something is wrong
// rather than something is Tuesday, and this joins every other
// unrecoverable state in this kernel.
//
// Parking is for the same reason the crash-snapshot path parks: the
// kernel has written outside a bound it maintains, so there is nothing
// left it can honestly do, and continuing would be a guess about which
// of its own invariants still hold.
//
// A bare spin rather than that path's `interrupt_wait()`, because two of
// the three call sites are inside `!{interrupt}` handlers and this
// kernel's effect checker refuses a blocking wfe there -- correctly, and
// it caught this on the first build. The rule is about handlers that
// intend to return; this one does not, so it spins instead of arguing
// with it.
//
// This report still runs on the stack it is reporting about, which the
// quarantine half is what makes survivable -- 16384 bytes of headroom
// against a report that costs a few frames. A handler on a stack of its
// own is the proper answer and belongs with the entry-time check, not
// here.
// GitHub issue #392: which process, by pid, not by slot -- a slot is a
// pool address now, and "the boot stack" used to be spelled as a slot one
// past the end of an array that no longer exists. An explicit bool says
// it instead, because a sentinel that has to be out of range needs a range.
private fn kernel_stack_guard_fail(reason: *u8, slot: usize,
                                   process_stack: bool, base: usize,
                                   sp: usize) !{unsafe} {
    kernel_log_enter_emergency();
    kernel_boot_log("kernel stack: OVERFLOW -- ");
    kernel_boot_log(reason);
    kernel_boot_log(" (issues #373/#377) pid=");
    if (process_stack) {
        uart_put_udec(scheduled_process_pid_of_slot(slot));
    } else {
        kernel_boot_log("none (boot stack)");
    }
    kernel_boot_log(" bottom=");
    uart_put_udec(base);
    kernel_boot_log(" sp=");
    uart_put_udec(sp);
    kernel_boot_log(" size=");
    uart_put_udec(KERNEL_PROCESS_STACK_SIZE);
    // How far past the bottom, when it is already past: the number a
    // guard page would have read off the faulting address.
    let mut over: usize = kernel_boot_stack_overflow_bytes();
    if (process_stack) {
        over = kernel_stack_overflow_bytes(slot);
    }
    if (over != 0) {
        kernel_boot_log(" past-end=");
        uart_put_udec(over);
    }
    kernel_boot_log("\n");
    while (true) { }
}

must_use variant KernelStackGuardResult {
    Intact;
    Failed((*u8, usize, bool, usize));
}

private fn kernel_stack_guard_inspect(current_sp: usize)
        -> KernelStackGuardResult !{unsafe} {
    // The boot stack first, and unconditionally: it is the stack every
    // path that is not a running process stands on, so the test below --
    // which needs a current process to have a stack to ask about -- can
    // never see it.
    if (kernel_boot_stack_witness_disturbed()) {
        return KernelStackGuardResult::Failed(
            ("boot stack wrote past its end" as *u8,
             0, false, boot_stack_bottom));
    }
    if (execution_here().current_live == false) {
        return KernelStackGuardResult::Intact;
    }
    let slot: usize = execution_here().current_handle.pool_index;
    if (scheduled_process_slot_valid(slot) == false) {
        return KernelStackGuardResult::Intact;
    }
    // A slot whose run has not been allocated yet, or a path still on the
    // boot stack from entry.S, has nothing to check here. An unaligned
    // base is rejected by the same test (see kernel_stack_run_usable).
    let bottom: usize = kernel_stack_bottom(slot);
    if (bottom == 0) { return KernelStackGuardResult::Intact; }
    // Two distinct questions, asked in the order of severity, because
    // they mean different things and only one of them is recoverable in
    // principle. The region below the stack is written by nothing that is
    // behaving, so a disturbed byte there is an overflow that has ALREADY
    // happened; the stack's own lowest bytes being disturbed means the
    // next push would be that overflow.
    let below: *KernelStackWitness = kernel_stack_below_witness(bottom);
    let mut overflowed: bool = false;
    for i: usize in 0..<KERNEL_STACK_WITNESS_BYTES {
        if (below.bytes[i] != KERNEL_STACK_POISON) { overflowed = true; }
    }
    if (overflowed) {
        return KernelStackGuardResult::Failed(
            ("stack wrote past its end, into the run below it" as *u8,
             slot, true, bottom));
    }
    let stack: *KernelStackHalf = kernel_stack_span(bottom);
    let mut disturbed: bool = false;
    for i: usize in 0..<KERNEL_STACK_WITNESS_BYTES {
        if (i < KERNEL_PROCESS_STACK_SIZE) {
            let byte: {0..<KERNEL_PROCESS_STACK_SIZE as usize} = i;
            if (stack.bytes[byte] != KERNEL_STACK_POISON) { disturbed = true; }
        }
    }
    if (disturbed) {
        return KernelStackGuardResult::Failed(
            ("stack reached its own bottom" as *u8, slot, true, bottom));
    }
    return KernelStackGuardResult::Intact;
}

fn kernel_stack_guard_check(current_sp: usize) !{unsafe} {
    match kernel_stack_guard_inspect(current_sp) {
        KernelStackGuardResult::Intact => {}
        KernelStackGuardResult::Failed(details) => {
            let (reason, slot, process_stack, base) = details;
            kernel_stack_guard_fail(
                reason, slot, process_stack, base, current_sp);
        }
    }
}

// IRQ entry must not invoke the UART while it may have interrupted another
// writer. The shared inspection remains identical; its fail-stop is silent.
fn kernel_stack_guard_check_interrupt(current_sp: usize) !{unsafe} {
    match kernel_stack_guard_inspect(current_sp) {
        KernelStackGuardResult::Intact => {}
        KernelStackGuardResult::Failed(details) => {
            let (reason, slot, process_stack, base) = details;
            while (true) { }
        }
    }
}

// ---- The boot stack ----
//
// entry.S sets SP to the linker's boot_stack_top before any Takibi code
// runs, and everything that is not standing on a process's stack runs
// there: every fixture, the distro exec path, the whole of main(). The
// guard above says nothing about it, and until it is measured the same
// way there is no basis for choosing its size either -- which is the
// same argument that produced 16384 for the process stacks, applied to
// the stack that was never measured at all.
extern symbol boot_stack_run_bottom;
extern symbol boot_stack_bottom;
extern symbol boot_stack_top;
extern symbol secondary_stack_run_bottom;
extern symbol secondary_stack_bottom;
extern symbol secondary_stack_top;
extern symbol overflow_stack_run_bottom;
extern symbol overflow_stack_bottom;
extern symbol overflow_stack_top;
// GitHub issue #378: the stack an IRQ handler runs on. The frame stays on
// whichever kernel stack was interrupted -- it is the interrupted
// context, and dispatch may hand back a different process's frame -- so
// what moved here is the handler's own depth, which is the half that used
// to add to every process's worst case.
extern symbol irq_stack_run_bottom;
extern symbol irq_stack_bottom;
extern symbol irq_stack_top;

// Do the two linker-provided stacks have the same shape as the ones this
// file allocates -- KERNEL_PROCESS_STACK_SIZE of usable stack occupying
// the upper half of a KERNEL_STACK_RUN_BYTES-aligned run?
//
// It is a linker-script fact, so nothing at compile time can see it, and
// everything a single-bit membership test would assume rests on it. A
// stack of some other size or alignment answers that test wrongly on
// every path that is not standing on a process's stack, which is most of
// them.
fn kernel_linker_stacks_well_shaped() -> bool {
    if (boot_stack_top % KERNEL_STACK_RUN_BYTES != 0 ||
        boot_stack_top - boot_stack_bottom != KERNEL_PROCESS_STACK_SIZE ||
        boot_stack_bottom - boot_stack_run_bottom != KERNEL_PROCESS_STACK_SIZE) {
        return false;
    }
    if (secondary_stack_top % KERNEL_STACK_RUN_BYTES != 0 ||
        secondary_stack_top - secondary_stack_bottom !=
            KERNEL_PROCESS_STACK_SIZE ||
        secondary_stack_bottom - secondary_stack_run_bottom !=
            KERNEL_PROCESS_STACK_SIZE) {
        return false;
    }
    // Including the stack the overflow report itself runs on. It is the
    // one stack that could plausibly be exempted -- nothing is supposed
    // to overflow it -- and exempting it is exactly what would turn a
    // second exception during the report into a loop on the check that
    // brought it there.
    if (overflow_stack_top % KERNEL_STACK_RUN_BYTES != 0 ||
        overflow_stack_top - overflow_stack_bottom !=
            KERNEL_PROCESS_STACK_SIZE ||
        overflow_stack_bottom - overflow_stack_run_bottom !=
            KERNEL_PROCESS_STACK_SIZE) {
        return false;
    }
    // And the IRQ stack, which every interrupt this kernel takes stands
    // on: it is the one an entry-time test is most likely to be asked
    // about, since an interrupt can arrive at any instruction.
    return irq_stack_top % KERNEL_STACK_RUN_BYTES == 0 &&
           irq_stack_top - irq_stack_bottom == KERNEL_PROCESS_STACK_SIZE &&
           irq_stack_bottom - irq_stack_run_bottom == KERNEL_PROCESS_STACK_SIZE;
}

// GitHub issue #377: where the generated exception-entry check lands.
//
// Reached from generated code with SP already switched to a stack of its
// own, which is the whole reason what it prints can be believed: a report
// about a stack written using that stack proves nothing. DAIF is masked
// before it is called.
//
// It never returns. It cannot: the register shuffle that made a
// memory-free SP test possible spent the interrupted x0, so there is no
// context left to resume even if the stack were sound.
fn kernel_stack_overflow_fail_stop(sp: usize) !{unsafe} {
    kernel_log_enter_emergency();
    kernel_boot_log("kernel stack: OVERFLOW at exception entry (issue #377) sp=");
    uart_put_udec(sp);
    kernel_boot_log(" ");
    kernel_boot_log(kernel_stack_owner_name(sp));
    kernel_boot_log("\n");
    while (true) { }
}

// Which stack an address that failed the entry check fell out of. Named
// rather than numbered wherever it is not a process slot, because "boot"
// and "slot 3" answer different questions about what to look at next.
private fn kernel_stack_owner_name(sp: usize) -> *u8 {
    if (sp >= boot_stack_run_bottom && sp < boot_stack_top) {
        return "below the boot stack" as *u8;
    }
    if (sp >= secondary_stack_run_bottom && sp < secondary_stack_top) {
        return "below the secondary-core stack" as *u8;
    }
    if (sp >= overflow_stack_run_bottom && sp < overflow_stack_top) {
        return "below the overflow stack itself" as *u8;
    }
    if (sp >= irq_stack_run_bottom && sp < irq_stack_top) {
        return "below the IRQ stack" as *u8;
    }
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let base: usize =
                    scheduled_process_record_peek(slot).stack_run;
                if (base != 0 && sp >= base &&
                    sp < base + KERNEL_STACK_RUN_BYTES) {
                    return "below a process kernel stack" as *u8;
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    // A run parked by a reaped process is still this kernel's memory, and
    // an SP inside one is still worth naming rather than calling unknown.
    let spare_guard = scheduled_process_spare_lock(
        &scheduled_process_spare.mutex);
    let spare_value: SpareStackRunValue = stable_replace(
        spare_guard, &scheduled_process_spare.mutex,
        scheduled_process_spare.value, SpareStackRunValue::Empty);
    match spare_value {
        SpareStackRunValue::Empty => {}
        SpareStackRunValue::Held(spare_owner) => {
            let spare: usize = page_run_physical_address(spare_owner);
            let displaced: SpareStackRunValue = stable_replace(
                spare_guard, &scheduled_process_spare.mutex,
                scheduled_process_spare.value,
                SpareStackRunValue::Held(spare_owner));
            match displaced {
                SpareStackRunValue::Empty => {}
                SpareStackRunValue::Held(impossible) => {
                    page_run_free(impossible);
                }
            }
            scheduled_process_spare_unlock(
                spare_guard, &scheduled_process_spare.mutex);
            if (sp >= spare && sp < spare + KERNEL_STACK_RUN_BYTES) {
                return "below a reaped process kernel stack" as *u8;
            }
            return page_owner_description_reporter(sp);
        }
    }
    scheduled_process_spare_unlock(
        spare_guard, &scheduled_process_spare.mutex);
    // Not a stack this file knows about. The page allocator may still
    // know what it is, and on this path that answer is worth more than
    // "unknown" -- an SP that landed in a page table or a pool chunk is a
    // different bug from one that landed nowhere (issue #384).
    return page_owner_description_reporter(sp);
}

// Slack left unpoisoned below the reported SP: kernel_boot_stack_arm's
// own frame lives there, and so does anything the compiler placed below
// SP without adjusting it.
const KERNEL_BOOT_STACK_MARGIN_BYTES: usize = 512;

// A byte range of the boot stack, filled with poison. A raw pointer
// because both ends are linker symbols -- there is no array to index,
// and the length is not a compile-time constant. Same boundary as
// kernel/mm/page.tkb's own page_meta_clear.
private fn kernel_boot_stack_fill(from: usize, to: usize) !{unsafe} {
    if (from >= to) { return; }
    let bytes: *u8 = unsafe { from as *u8 };
    let count: isize = (to - from) as isize;
    for i: isize in 0..<count {
        bytes[i] = KERNEL_STACK_POISON;
    }
}

// Poison everything below the caller's frame. Meant to be main()'s first
// statement, where "below the caller's frame" is nearly the whole stack.
// Whatever is left unpoisoned above it reads back as used, so the
// measurement is a lower bound rather than a guess -- which is the
// honest direction for a stack that is already in use by the time
// anything can poison it.
fn kernel_boot_stack_arm() !{unsafe} {
    let sp: usize = kernel_stack_read_sp_el1();
    let bottom: usize = boot_stack_bottom;
    let top: usize = boot_stack_top;
    // A caller that is not standing on the boot stack would poison memory
    // some other stack is using. Nothing calls it that way today; the
    // check is here because the cost of being wrong is silent corruption
    // of whatever is below, which is the bug this whole area exists over.
    if (sp <= bottom || sp > top ||
        sp < bottom + KERNEL_BOOT_STACK_MARGIN_BYTES) { return; }
    // From the bottom of the RUN, so the reserved half below the stack is
    // poisoned in the same pass and an overflow into it is measurable
    // rather than merely harmless.
    kernel_boot_stack_fill(boot_stack_run_bottom,
                           sp - KERNEL_BOOT_STACK_MARGIN_BYTES);
}

// How far the boot stack has ever gone past its own bottom, into the
// reserved half below it. The boot-stack twin of
// kernel_stack_overflow_bytes, and 0 on a kernel that is behaving.
fn kernel_boot_stack_overflow_bytes() -> usize !{unsafe} {
    let run_bottom: usize = boot_stack_run_bottom;
    let bottom: usize = boot_stack_bottom;
    if (bottom <= run_bottom) { return 0; }
    let size: usize = bottom - run_bottom;
    let bytes: *u8 = unsafe { run_bottom as *u8 };
    let count: isize = size as isize;
    for i: isize in 0..<count {
        if (bytes[i] != KERNEL_STACK_POISON) { return size - (i as usize); }
    }
    return 0;
}

// Has the boot stack written below its own bottom? Read on the same
// schedule as a process stack's witness, and the same width, because the
// boot stack is where everything that is not a process runs -- gating
// this on `execution_here().current_live` the way the process check must be
// gated would exempt exactly the paths that used to be unmeasurable.
private fn kernel_boot_stack_witness_disturbed() -> bool !{unsafe} {
    let bottom: usize = boot_stack_bottom;
    if (bottom <= boot_stack_run_bottom) { return false; }
    let witness: *KernelStackWitness =
        unsafe { (bottom - KERNEL_STACK_WITNESS_BYTES) as *KernelStackWitness };
    for i: usize in 0..<KERNEL_STACK_WITNESS_BYTES {
        if (witness.bytes[i] != KERNEL_STACK_POISON) { return true; }
    }
    return false;
}

// How deep a poisoned stack has ever been: the lowest byte that is no
// longer poison, measured from the top. Shared by the boot stack and the
// IRQ stack, which are measured the same way and differ only in which
// pair of linker symbols bound them.
private fn kernel_linker_stack_used_bytes(bottom: usize, top: usize)
        -> usize !{unsafe} {
    if (top <= bottom) { return 0; }
    let size: usize = top - bottom;
    let bytes: *u8 = unsafe { bottom as *u8 };
    let count: isize = size as isize;
    for i: isize in 0..<count {
        if (bytes[i] != KERNEL_STACK_POISON) { return size - (i as usize); }
    }
    return 0;
}

fn kernel_boot_stack_used_bytes() -> usize !{unsafe} {
    return kernel_linker_stack_used_bytes(boot_stack_bottom, boot_stack_top);
}

// GitHub issue #378's own acceptance: the interrupt path's depth, reported
// SEPARATELY from the syscall path's. Before this stack existed the two
// were one number, and the only honest thing to say about it was that a
// kernel stack had to hold the sum of two independent worst cases.
//
// Poisoned outright rather than from below a live frame (see
// kernel_boot_stack_arm): nothing is standing on it when the kernel arms
// it, so there is no frame to preserve and the measurement has no
// unpoisoned margin counted as used.
fn kernel_irq_stack_arm() !{unsafe} {
    kernel_boot_stack_fill(irq_stack_run_bottom, irq_stack_top);
}

fn kernel_irq_stack_used_bytes() -> usize !{unsafe} {
    return kernel_linker_stack_used_bytes(irq_stack_bottom, irq_stack_top);
}

fn kernel_irq_stack_overflow_bytes() -> usize !{unsafe} {
    let used: usize = kernel_linker_stack_used_bytes(irq_stack_run_bottom,
                                                     irq_stack_bottom);
    return used;
}

// GitHub issue #376: how deep this slot's stack has ever been, in bytes.
//
// The stack grows DOWN from base + KERNEL_PROCESS_STACK_SIZE, so the
// deepest point reached is the LOWEST address that no longer holds the
// poison, and the depth is the distance from there to the top. Scanning
// upward from the base stops at the first disturbed byte, which is that
// address.
//
// Returns 0 for a slot with no backing page. A slot that has never run
// reports 0 as well, which is correct rather than a special case.
fn kernel_stack_used_bytes(slot: usize)
        -> usize !{unsafe} {
    let bottom: usize = kernel_stack_bottom(slot);
    if (bottom == 0) { return 0; }
    let stack: *KernelStackHalf = kernel_stack_span(bottom);
    for i: usize in 0..<KERNEL_PROCESS_STACK_SIZE {
        if (stack.bytes[i] != KERNEL_STACK_POISON) {
            return KERNEL_PROCESS_STACK_SIZE - i;
        }
    }
    return 0;
}

// GitHub issue #377: how far past its end this slot's stack has ever
// gone, in bytes, or 0 if it never has.
//
// This is the number a guard page would have reported from the faulting
// address, and it is the reason the region below the stack is poisoned
// too rather than merely reserved: containment alone would make an
// overflow harmless AND invisible, which is how issue #373's corruption
// stayed silent for as long as it did. Scanning DOWN from the top of
// that region finds the deepest byte the stack reached below its bottom.
fn kernel_stack_overflow_bytes(slot: usize)
        -> usize !{unsafe} {
    let bottom: usize = kernel_stack_bottom(slot);
    if (bottom == 0) { return 0; }
    let below: *KernelStackHalf = kernel_stack_quarantine_span(bottom);
    for i: usize in 0..<KERNEL_PROCESS_STACK_SIZE {
        if (below.bytes[i] != KERNEL_STACK_POISON) {
            return KERNEL_PROCESS_STACK_SIZE - i;
        }
    }
    return 0;
}

// The deepest any slot has been, which is the number that decides how big
// a kernel stack has to be (issues #376/#377).
fn kernel_stack_deepest_bytes() -> usize !{unsafe} {
    let mut deepest: usize = scheduled_process_stack_deepest_reaped;
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let used: usize = kernel_stack_used_bytes(slot);
                if (used > deepest) { deepest = used; }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    return deepest;
}

// Reported once, at the end of the boot fixtures, because that is the
// point every scenario this kernel exercises has already run. Per slot as
// well as the maximum: one slot being near the limit while the rest are
// shallow says something different from all of them being near it.
fn kernel_stack_watermark_report() !{unsafe} {
    let deepest: usize = kernel_stack_deepest_bytes();
    kernel_boot_log("kernel stack watermark: size=");
    uart_put_udec(KERNEL_PROCESS_STACK_SIZE);
    kernel_boot_log(" deepest=");
    uart_put_udec(deepest);
    // A watermark equal to the size is SATURATED: the poison ran out, so
    // this is a floor on what the deepest path needs and not the number
    // itself. Learning the real requirement needs a bigger stack to
    // measure in, or a guard page that reports how far past the end the
    // faulting access was (#377).
    if (deepest >= KERNEL_PROCESS_STACK_SIZE) {
        kernel_boot_log(" SATURATED (a floor, not the requirement)");
    }
    // The boot stack, measured the same way and reported beside them: it
    // is the deepest stack this kernel actually has, and the one nothing
    // used to be able to say anything about.
    kernel_boot_log(" boot=");
    uart_put_udec(kernel_boot_stack_used_bytes());
    kernel_boot_log("/");
    uart_put_udec(boot_stack_top - boot_stack_bottom);
    let boot_over: usize = kernel_boot_stack_overflow_bytes();
    if (boot_over != 0) {
        kernel_boot_log("+");
        uart_put_udec(boot_over);
        kernel_boot_log("OVER");
    }
    // The interrupt path, separately -- which is the whole point of it
    // having a stack of its own. A per-slot number that no longer
    // includes this is a per-slot number that means something.
    kernel_boot_log(" irq=");
    uart_put_udec(kernel_irq_stack_used_bytes());
    kernel_boot_log("/");
    uart_put_udec(irq_stack_top - irq_stack_bottom);
    let irq_over: usize = kernel_irq_stack_overflow_bytes();
    if (irq_over != 0) {
        kernel_boot_log("+");
        uart_put_udec(irq_over);
        kernel_boot_log("OVER");
    }
    // Per LIVE process, by pid -- a reaped process's run is recycled now,
    // so there is nothing left to read its poison out of. What those
    // processes reached is in `deepest` above, taken at their reap.
    kernel_boot_log(" reaped-deepest=");
    uart_put_udec(scheduled_process_stack_deepest_reaped);
    kernel_boot_log(" per-process=");
    let mut report_cursor = scheduled_process_first_slot();
    let mut reporting: bool = true;
    while (reporting) {
      match report_cursor {
        ProcessSlotCursor::Done => { reporting = false; }
        ProcessSlotCursor::At(slot) => {
        let used: usize = kernel_stack_used_bytes(slot);
        if (used != 0) {
            uart_put_udec(scheduled_process_pid_of_slot(slot));
            kernel_boot_log(":");
            uart_put_udec(used);
            // Depth PAST the end, which only the region below the stack
            // can answer and which the old one-page stack had no way to
            // report at all. Printed only when nonzero: on a healthy
            // kernel this half of the line never appears.
            let over: usize = kernel_stack_overflow_bytes(slot);
            if (over != 0) {
                kernel_boot_log("+");
                uart_put_udec(over);
                kernel_boot_log("OVER");
            }
            kernel_boot_log(" ");
        }
        report_cursor = scheduled_process_next_slot(slot);
        }
      }
    }
    kernel_boot_log("\n");
}

// What the timer tick decided. `Resume` is the frame to return to, the
// interrupted one when nothing was switched. `ToIdle` is a tick that gave the
// interrupted process back with nothing to run in its place: the platform's
// handler acknowledges the interrupt and then leaves for this CPU's idle loop
// (kernel_timer_tick_leave) instead of returning to EL0.
must_use variant TimerSwitch {
    Resume(exists process: usize. FrameRef[process]);
    ToIdle;
}

fn kernel_process_timer_schedule(current: sink FrameRef[process])
        -> TimerSwitch !{interrupt} {
    if (execution_here().scheduler_enabled == false) {
        return TimerSwitch::Resume(current);
    }
    execution_here().reschedule_pending = false;
    if (kernel_process_current_has_relative()) {
        match kernel_process_schedule(current) {
            FrameSwitch::Stay => {}
            FrameSwitch::Switch(next) => {
                process_test_evidence_record_timer_switch();
                return TimerSwitch::Resume(next);
            }
        }
    }
    if (kernel_process_tick_leave_excluded(current)) {
        return TimerSwitch::ToIdle;
    }
    return TimerSwitch::Resume(current);
}

// GitHub issue #582: the tick's half of the affinity gate. A process whose
// own mask stopped naming this CPU used to keep it until its next syscall,
// because the scheduler returned the current frame whenever nothing else
// was Ready here -- and a compute-bound process may never make one. With no
// successor, give the process back as Ready and let this CPU idle; a CPU
// the mask names takes it from its own idle loop.
//
// No stack question is left to answer here. The lower-EL entry's depart
// hook (kernel_process_stack_interrupt_depart) already moved this CPU onto
// its IRQ stack and released the process's stack before dispatch ran, so
// the Ready published below is immediately takeable, and the frame the
// taker resumes is the one this entry saved.
private fn kernel_process_tick_leave_excluded(
        frame: borrow FrameRef[process]) -> bool !{interrupt} {
    let guard = process_run_lock();
    if (execution_here().current_live == false ||
        execution_here().stack_live) {
        process_run_unlock(guard);
        return false;
    }
    let mut outgoing: ProcessHandle = execution_here().current_handle;
    let slot: usize = outgoing.pool_index;
    if (slot == 0 || kernel_process_cpu_allows_slot(guard, cpu_id(), slot) ||
        kernel_process_frame_belongs_to(outgoing, frame) == false) {
        process_run_unlock(guard);
        return false;
    }
    scheduled_process_record_locked(guard, slot).saved_sp = frame_ref_address(frame);
    // Leave its root before it can run elsewhere, as every idle entry does.
    address_space_activate_root(address_space_boot_root());
    execution_here().current_live = false;
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
    if (kernel_process_yield_handle(guard, outgoing) == false) {
        process_run_unlock(guard);
        kernel_syscall_fail_stop(frame_ref_address(frame));
    }
    process_run_unlock(guard);
    return true;
}

fn kernel_process_syscall_return_schedule(current: borrow FrameRef[process])
        -> FrameSwitch {
    if (execution_here().scheduler_enabled == false) {
        return FrameSwitch::Stay;
    }
    if (execution_here().reschedule_pending == false) {
        return FrameSwitch::Stay;
    }
    execution_here().reschedule_pending = false;
    if (kernel_process_current_has_relative() == false) {
        return FrameSwitch::Stay;
    }
    match kernel_process_schedule(current) {
        FrameSwitch::Stay => { return FrameSwitch::Stay; }
        FrameSwitch::Switch(next) => {
            process_test_evidence_record_deferred_switch();
            return FrameSwitch::Switch(next);
        }
    }
}

// Block the running process and hand the CPU to the next runnable one.
//
// Called with IRQ delivery masked after the UART ring's final empty check.
// Publishing Blocked before returning the next runnable frame closes the
// otherwise-lost wakeup window between checking the ring and sleeping.
//
// The successor is chosen BEFORE the block, because the rotation only
// returns Ready processes and the caller is about to stop being one.
//
// Both blockers used to name their successor structurally -- UART blocking
// switched to the current process's child (or, failing that, its parent) and
// wait4 switched to the child it was waiting on -- and refused to block at
// all when that one relative was not Ready. Refusing is a fail-stop at the
// caller, so "the process I would have handed the CPU to is itself blocked"
// had to be impossible for the kernel to stay up. It is not impossible: a
// shell reading the terminal while its own child waits on a daemon is an
// ordinary shape, and it is exactly the shape a script that starts a
// background daemon produces.
// GitHub issue #479 Group B: the successor walk and target reservation share
// one critical section. The target's linear Running token then survives while
// the lock is dropped for ASID preparation; commit revalidates both processes
// under a fresh section before publishing Blocked and changing TTBR0.
// The last looks before a wait publishes Blocked, taken inside the
// critical section that publishes it. True means the event the wait is for
// has already happened, so blocking would sleep beside it: the caller
// does not block, and the syscall is rerun.
//
// GitHub issue #547, the terminal: the RX interrupt pushes a byte only while
// holding this lock, after finding no Blocked reader. So a byte is either in
// the ring now, or its interrupt finds this process Blocked. That holds
// whichever CPU the reader is on, which a local interrupt mask cannot
// promise.
//
// GitHub issue #583's fourth increment, a signal wait: rt_sigtimedwait took
// nothing under this lock a moment ago and released it; a sender on another
// CPU raises the bit under it and wakes the target only if it is Blocked by
// then. So a bit the wait accepts, or an unmasked SIGTERM, pending now
// means the rerun takes it (or exits at entry), and one raised after this
// publishes Blocked is delivered to a Blocked waiter.
// GitHub issue #550: the last look before a wait publishes Blocked, asked in
// the critical section that publishes it. A process decides to wait in one
// section and becomes Blocked in a later one; an event that arrives between
// the two finds no Blocked waiter. True means the event is already here, and
// the caller runs the syscall again instead of sleeping.
//
// Every wait reason answers here, and the match has no default arm, so a
// reason added later does not compile until someone writes its answer. The
// answer is one of two things: a re-check of the event, made under the lock
// its waker takes, or the name of what delivers the event again later.
private fn kernel_process_block_would_miss(
        guard: borrow ProcessRunGuard[lock], from: ProcessHandle,
        reason: ProcessWaitReason) -> bool {
    match reason {
        // Not a wait: nothing blocks with it.
        ProcessWaitReason::None => { return false; }
        // #547: the RX interrupt pushes a byte only under this lock, after
        // finding no Blocked reader.
        ProcessWaitReason::UartRx => { return kernel_uart_rx_pending(); }
        // The TX interrupt's wake (kernel_process_uart_tx_wake_all) runs
        // under this lock on core 0. Only core 0 blocks on UartTx -- a peer
        // writer waits for its tick (syscall_terminal_write_wait) -- and the
        // lock masks core 0's interrupts, so the room read here cannot move
        // before Blocked is published.
        ProcessWaitReason::UartTx => { return kernel_log_tx_writer_room(); }
        // #550's ChildExit window. kernel_process_child_exit makes the child
        // a zombie under this lock and wakes only a parent already Blocked
        // in ChildExit, so a child that exited after wait4 decided to block
        // is found here or not at all. kernel/models/Wait4Block.tla checks
        // this re-check (RECHECK = TRUE) and the defect without it.
        ProcessWaitReason::ChildExit => {
            let requested: usize = scheduled_process_record_of_locked(guard, from).wait4_pid;
            // An exited child whose CPU has not yet left its stack is not
            // collectable, but it has exited: its exit has already looked
            // for a Blocked parent and found none, so sleeping now would
            // sleep past it (#609).
            if (kernel_process_child_zombie_stack_held(guard, from, requested)) {
                return true;
            }
            if (requested == 0xFFFFFFFFFFFFFFFF) {
                match kernel_process_first_zombie_of(guard, from) {
                    ProcessNextReadyResult::Missing => { return false; }
                    ProcessNextReadyResult::Next(zombie) => { return true; }
                }
            }
            match kernel_process_zombie_of_pid(guard, from, requested) {
                ProcessNextReadyResult::Missing => { return false; }
                ProcessNextReadyResult::Next(zombie) => { return true; }
            }
        }
        // Delivered again: core 0's timer tick (timer_irq_handler) wakes
        // every NetRx waiter on every tick, under this lock. A frame that
        // arrives inside the window costs at most one tick, not the wait.
        ProcessWaitReason::NetRx => { return false; }
        // Delivered again: the same tick's kernel_process_deadline_wake_all
        // wakes a Blocked waiter whose deadline has passed, whenever it
        // passed.
        ProcessWaitReason::Deadline => { return false; }
        // A signal is raised under this lock (#570); one raised inside the
        // window is pending here.
        ProcessWaitReason::Signal => {
            let waiting: *ProcessRecord = scheduled_process_record_of_locked(guard, from);
            let terminating: usize = (1 << 1) | (1 << 2) | (1 << 14);
            let wanted: usize = waiting.sigwait_set |
                                (terminating & ~waiting.signal_mask);
            return (waiting.pending_signals & wanted) != 0;
        }
    }
}

// wait4's requested pid, recorded beside its status pointer when it blocks.
fn kernel_process_current_set_wait4_pid(pid: usize) {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here)
            .wait4_pid = pid;
    }
    process_running_end(running_here);
}

// What a block came to. `Retry` is a wait that was not published (a successor
// was claimed elsewhere, or the block would have missed its wake): the caller
// resumes the frame it has and reruns the syscall. `ToIdle` is a wait
// published Blocked with no successor to switch to: the caller leaves this
// process's stack for the CPU's idle context instead of resuming anything.
// `Switch` is the successor's frame.
//
// Not must_use: kernel_syscall_block_return assigns the one it is given by
// whichever blocker applies, starting from Retry. Every function returns it,
// so it is not dropped.
variant BlockSwitch {
    Retry;
    ToIdle;
    Switch(exists process: usize. FrameRef[process]);
}

// GitHub issue #583: a wait with no Ready successor used to decline to
// block and rerun its syscall, which is all a CPU with nowhere to idle can
// do. Every CPU can idle now -- the secondaries always could, core 0 since
// #592 -- so publish Blocked here and let the caller idle. The process stays
// unselectable until its stack is released: scheduled_process_ready_take
// refuses a Ready process whose stack is still owned, so a wake that lands
// before this CPU leaves the stack cannot start it elsewhere.
//
// wait4's ChildExit included since #550: kernel_process_block_would_miss
// re-checks the awaited child in this critical section, so a child that
// exited after wait4 decided to block reruns wait4 instead of leaving its
// parent Blocked beside a zombie.
private fn kernel_process_block_to_idle(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        from: ProcessHandle, current: borrow FrameRef[process],
        reason: ProcessWaitReason, trace_aux: usize) -> bool {
    if (execution_here().current_live == false ||
        scheduled_process_same_slot(execution_here().current_handle, from)
            == false ||
        execution_here().stack_live == false ||
        execution_here().stack_handle.pool_index != from.pool_index ||
        execution_here().stack_handle.generation != from.generation) {
        return false;
    }
    if (kernel_process_block_would_miss(guard, from, reason)) { return false; }
    scheduled_process_record_of_locked(guard, from).saved_sp = frame_ref_address(current);
    match scheduled_process_running_take(guard, from) {
        ScheduledProcessRunningTakeResult::Missing => { return false; }
        ScheduledProcessRunningTakeResult::Running(from_resources) => {
            let (from_owner, from_running) = from_resources;
            let blocked = scheduled_process_block(
                from_owner, from_running, reason);
            scheduled_process_release(from_owner, blocked);
        }
    }
    kernel_process_trace_handle(ProcessTraceBlock, from, from, trace_aux);
    execution_here().current_live = false;
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
    return true;
}

private fn kernel_process_block_current(current: borrow FrameRef[process],
                                        reason: ProcessWaitReason,
                                        trace_aux: usize) -> BlockSwitch {
    if (execution_here().current_live == false) {
        return BlockSwitch::Retry;
    }
    let mut from: ProcessHandle = execution_here().current_handle;
    let guard = process_run_lock();
    match kernel_process_next_ready(guard, from, cpu_id()) {
        ProcessNextReadyResult::Missing => {
            let idle: bool = kernel_process_block_to_idle(
                guard, from, current, reason, trace_aux);
            process_run_unlock(guard);
            if (idle) { return BlockSwitch::ToIdle; }
            return BlockSwitch::Retry;
        }
        ProcessNextReadyResult::Next(to) => {
            match scheduled_process_ready_take(guard, to) {
                ScheduledProcessReadyTakeResult::Missing => {
                    process_run_unlock(guard);
                    return BlockSwitch::Retry;
                }
                ScheduledProcessReadyTakeResult::Ready(resources) => {
                    let (owner, ready) = resources;
                    let running = scheduled_process_start(owner, ready);
                    process_run_unlock(guard);
                    return kernel_process_block_reserved(
                        from, owner, running, current, reason, trace_aux);
                }
            }
        }
    }
}

private fn kernel_process_block_reserved(
        from: ProcessHandle,
        owner: sink ScheduledProcessOwner[process],
        running: sink ScheduledProcessState[process, ProcessState::Running],
        current: borrow FrameRef[from_process], reason: ProcessWaitReason,
        trace_aux: usize) -> BlockSwitch {
    match process_image_prepare_activation(owner.pool_index) {
        AddressSpaceActivationPrepareResult::Invalid => {
            kernel_process_schedule_cancel_reserved(owner, running);
            return BlockSwitch::Retry;
        }
        AddressSpaceActivationPrepareResult::RolloverNeeded => {
            match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                                   SCHEDULER_WORLD_STOP_SPINS) {
                WorldStopResult::Busy => {
                    kernel_process_schedule_cancel_reserved(owner, running);
                    return BlockSwitch::Retry;
                }
                WorldStopResult::Partial(partial) => {
                    world_stop_partial_release(partial, &kernel_world_stop);
                    kernel_process_schedule_cancel_reserved(owner, running);
                    return BlockSwitch::Retry;
                }
                WorldStopResult::Complete(stopped) => {
                    if (asid_rollover_stopped(stopped)) {}
                    world_stop_release(stopped, &kernel_world_stop);
                    return kernel_process_block_reserved(
                        from, owner, running, current, reason, trace_aux);
                }
            }
        }
        AddressSpaceActivationPrepareResult::Prepared(prepared) => {
            let guard = process_run_lock();
            let mut to: ProcessHandle = {
                owner.pool_index, owner.generation
            };
            let mut current_matches: bool = false;
            if (execution_here().current_live) {
                current_matches = scheduled_process_same_slot(
                    execution_here().current_handle, from);
            }
            if (current_matches == false ||
                scheduled_process_handle_matches(from) == false ||
                scheduled_process_state_of(from) != ProcessSlotState::Running ||
                scheduled_process_handle_matches(to) == false ||
                scheduled_process_state_of(to) != ProcessSlotState::Running) {
                process_image_cancel_activation(prepared);
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return BlockSwitch::Retry;
            }
            // GitHub issue #547: the last look at the terminal ring, in the
            // critical section that publishes Blocked. The RX interrupt
            // pushes a byte only while holding this lock, after finding no
            // Blocked reader. So a byte is either in the ring now, and the
            // read runs again and takes it, or its interrupt finds this
            // process Blocked. That holds whichever CPU the reader is on,
            // which a local interrupt mask cannot promise.
            if (kernel_process_block_would_miss(guard, from, reason)) {
                process_image_cancel_activation(prepared);
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return BlockSwitch::Retry;
            }
            scheduled_process_record_of_locked(guard, from).saved_sp = frame_ref_address(current);
            match scheduled_process_running_take(guard, from) {
                ScheduledProcessRunningTakeResult::Missing => {
                    process_image_cancel_activation(prepared);
                    let ready = scheduled_process_yield(owner, running);
                    scheduled_process_release(owner, ready);
                    process_run_unlock(guard);
                    return BlockSwitch::Retry;
                }
                ScheduledProcessRunningTakeResult::Running(from_resources) => {
                    let (from_owner, from_running) = from_resources;
                    let blocked = scheduled_process_block(
                        from_owner, from_running, reason);
                    scheduled_process_release(from_owner, blocked);
                }
            }
            kernel_process_trace_handle(
                ProcessTraceBlock, from, to, trace_aux);
            if (process_image_commit_activation(prepared) == false) {
                match scheduled_process_blocked_take(guard, from) {
                    ScheduledProcessBlockedTakeResult::Missing => {}
                    ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                        let (from_owner, blocked) = resources;
                        let ready = scheduled_process_wake(from_owner, blocked);
                        match scheduled_process_restart_check(
                                guard, from_owner, ready) {
                            ScheduledProcessStartCheck::Startable(startable) => {
                                let from_running = scheduled_process_start(
                                    from_owner, startable);
                                scheduled_process_release(
                                    from_owner, from_running);
                            }
                            // Another core stands on the stack this CPU
                            // just blocked on: the same stop
                            // scheduled_process_start makes.
                            ScheduledProcessStartCheck::Standing(standing) => {
                                scheduled_process_release(from_owner, standing);
                                kernel_activity_set(
                                    KernelActivity::StartOnOwnedStack);
                                kernel_syscall_fail_stop(0);
                            }
                        }
                    }
                }
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return BlockSwitch::Retry;
            }
            execution_here().current_handle = to;
            // GitHub issue #448/#469: every blocking handoff is accounted,
            // not only the timer scheduler's switches.
            workload_busy_note_selected_locked(
                guard, scheduled_process_pid_of_handle(to));
            kernel_process_trace_handle(ProcessTraceResume, to, from, 0);
            let next = scheduled_process_saved_frame(owner);
            if (scheduled_process_wait_reason_of(to) ==
                    ProcessWaitReason::ChildExit) {
                scheduled_process_wait_settle(scheduled_process_record_of_locked(guard, to));
            }
            scheduled_process_release(owner, running);
            process_run_unlock(guard);
            return BlockSwitch::Switch(next);
        }
    }
}

// GitHub issue #469: block until something arrives on the network, or
// until the tick that wakes every such waiter. The caller has already put
// the receive capability back and parked whatever it had in progress, so
// this process is holding nothing while it waits.
fn kernel_process_block_net(current: borrow FrameRef[process])
        -> BlockSwitch {
    return kernel_process_block_current(
        current, ProcessWaitReason::NetRx, 3);
}

fn kernel_process_current_arm_deadline(deadline_ticks: usize,
                                       result: usize) {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here)
            .deadline_ticks = deadline_ticks;
        scheduled_process_record_running(running_here)
            .deadline_result = result;
        kernel_process_current_set_pending_block(
            ProcessWaitReason::Deadline, 0);
    }
    process_running_end(running_here);
}

fn kernel_process_current_deadline_ticks() -> usize {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        { let mut __running_result: usize = scheduled_process_record_running(running_here)
            .deadline_ticks; process_running_end(running_here); return __running_result; }
    }
    { let mut __running_result: usize = 0; process_running_end(running_here); return __running_result; }
}

fn kernel_process_current_clear_deadline() {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here)
            .deadline_ticks = 0;
        scheduled_process_record_running(running_here)
            .deadline_result = 0;
        scheduled_process_record_running(running_here)
            .pending_block_reason = ProcessWaitReason::None;
    }
    process_running_end(running_here);
}

// GitHub issue #570: pending_signals and signal_mask are read-modify-written
// by a sender on whichever CPU it runs on and by the target on its own, so
// every access outside a record's construction and teardown goes through the
// process-run lock. The guard parameter makes holding it a compile-time
// requirement rather than a comment, and the record is passed rather than a
// handle so kernel/kernel/signal_contention_evidence.tkb can drive these
// exact functions on a record of its own that no scheduler walk reaches.
fn process_signal_pending_raise(guard: borrow ProcessRunGuard[lock],
                                record: borrow *ProcessRecord, bits: usize) {
    process_signal_pending_store(
        guard, record, process_signal_pending_raised(guard, record, bits));
}

// The raise's two halves, the load-and-or and the store, named separately so
// the contention probe can hold one core between them while the other
// raises. That split is what makes the unlocked lost update happen every
// round rather than when two three-instruction windows happen to meet.
fn process_signal_pending_raised(guard: borrow ProcessRunGuard[lock],
                                 record: borrow *ProcessRecord, bits: usize)
        -> usize {
    return record.pending_signals | bits;
}

fn process_signal_pending_store(guard: borrow ProcessRunGuard[lock],
                                record: borrow *ProcessRecord, value: usize) {
    record.pending_signals = value;
}

fn process_signal_pending_clear(guard: borrow ProcessRunGuard[lock],
                                record: borrow *ProcessRecord, bits: usize) {
    record.pending_signals = record.pending_signals & ~bits;
}

fn kernel_process_current_signal_mask() -> usize {
    let guard = process_run_lock();
    let mut mask: usize = 0;
    if (execution_here().current_live) {
        mask = scheduled_process_record_of_locked(guard, execution_here().current_handle)
            .signal_mask;
    }
    process_run_unlock(guard);
    return mask;
}

fn kernel_process_current_set_signal_mask(mask: usize) {
    let guard = process_run_lock();
    if (execution_here().current_live) {
        // SIGKILL (9) and SIGSTOP (19) cannot be blocked.
        let unmaskable: usize = (1 << 8) | (1 << 18);
        scheduled_process_record_of_locked(guard, execution_here().current_handle)
            .signal_mask = mask & ~unmaskable;
    }
    process_run_unlock(guard);
}

fn kernel_process_current_sigchld_ignored() -> bool {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    // The syscall subset probe calls rt_sigaction without a live process.
    // Takibi evaluates both sides of &&, so a combined guard would still
    // read the uninitialised current_handle and count a stale handle.
    if (execution_here().current_live == false) { { let mut __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    { let mut __running_result: bool = scheduled_process_record_running(running_here)
        .sigchld_ignored; process_running_end(running_here); return __running_result; }
}

fn kernel_process_current_set_sigchld_ignored(ignored: bool) {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here)
            .sigchld_ignored = ignored;
    }
    process_running_end(running_here);
}

// GitHub issue #600: a signal taken off `pending_signals` is a value that
// exists nowhere else until it is delivered. The syscall that took it may
// still end by rewinding itself -- an exit that has to wait and rerun, and
// in general any path that retries the call -- and a rerun that finds the
// bit gone lets the process outlive the signal. #592 found exactly that and
// fixed it with a restore call that the one path remembered to make.
//
// Linear, so remembering is no longer the mechanism: every path out of a
// take must either hand the signal to the caller as delivered or put it
// back, and a path that does neither is a compile error. The handle it
// carries is the process it was taken from, so the restore reaches that
// process even if the current one has changed by then.
linear struct TakenSignal[signal: usize] {
    private pool_index: usize;
    private generation: usize;
    private signum: usize @ signal;
}

must_use variant ProcessSignalPendingResult {
    Missing;
    Pending(exists signal: usize. TakenSignal[signal]);
}

private fn taken_signal_new(pool_index: usize, generation: usize,
                            signum: usize @ signal) -> TakenSignal[signal] {
    let mut taken: TakenSignal[signal] = { pool_index, generation, signum };
    return taken;
}

fn taken_signal_number(taken: borrow TakenSignal[signal]) -> usize {
    return taken.signum;
}

// The signal reached its effect: a signal wait returned it, or the process
// is exiting because of it.
fn taken_signal_delivered(taken: sink TakenSignal[signal]) -> usize {
    return taken.signum;
}

// The syscall that took it will be rerun: make it pending again, on the
// process it came from. A process that has gone since has nothing to
// restore to.
fn taken_signal_restore(taken: sink TakenSignal[signal]) {
    let mut handle: ProcessHandle = { taken.pool_index, taken.generation };
    let signum: usize = taken.signum;
    if (signum == 0 || signum > 64) { return; }
    let guard = process_run_lock();
    if (scheduled_process_handle_matches(handle)) {
        let record: *ProcessRecord = scheduled_process_record_of_locked(guard, handle);
        process_signal_pending_raise(guard, record, 1 << (signum - 1));
    }
    process_run_unlock(guard);
}

fn kernel_process_current_signal_take(wait_set: usize)
        -> ProcessSignalPendingResult {
    if (execution_here().current_live == false) {
        return ProcessSignalPendingResult::Missing;
    }
    let guard = process_run_lock();
    let mut handle: ProcessHandle = execution_here().current_handle;
    let record: *ProcessRecord = scheduled_process_record_of_locked(guard, handle);
    let available: usize = record.pending_signals & wait_set;
    for bit: usize in 0..<64 {
        let bit_mask: usize = 1 << bit;
        if ((available & bit_mask) != 0) {
            process_signal_pending_clear(guard, record, bit_mask);
            process_run_unlock(guard);
            return ProcessSignalPendingResult::Pending(
                taken_signal_new(handle.pool_index, handle.generation,
                                 bit + 1));
        }
    }
    process_run_unlock(guard);
    return ProcessSignalPendingResult::Missing;
}

// Take one unblocked signal with a terminating default action. Terminal
// INTR and QUIT use the same resource-release path as SIGTERM.
fn kernel_process_current_termination_signal_take()
        -> ProcessSignalPendingResult {
    if (execution_here().current_live == false) {
        return ProcessSignalPendingResult::Missing;
    }
    let guard = process_run_lock();
    let mut handle: ProcessHandle = execution_here().current_handle;
    let record: *ProcessRecord = scheduled_process_record_of_locked(guard, handle);
    let available: usize = record.pending_signals & ~record.signal_mask;
    for signum: usize in 1..<16 {
        if (signum == 2 || signum == 3 || signum == 15) {
            let bit: usize = 1 << (signum - 1);
            if ((available & bit) != 0) {
                process_signal_pending_clear(guard, record, bit);
                process_run_unlock(guard);
                return ProcessSignalPendingResult::Pending(
                    taken_signal_new(handle.pool_index, handle.generation, signum));
            }
        }
    }
    process_run_unlock(guard);
    return ProcessSignalPendingResult::Missing;
}

fn kernel_process_current_prepare_signal_wait(wait_set: usize) {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here)
            .sigwait_set = wait_set;
        kernel_process_current_set_pending_block(
            ProcessWaitReason::Signal, 0);
    }
    process_running_end(running_here);
}

// GitHub issue #627: rt_sigsuspend's wait. The same Signal block as
// rt_sigtimedwait's, but a wake leaves the signal pending (see
// kernel_process_signal_deliver_to).
fn kernel_process_current_prepare_signal_suspend(wait_set: usize) {
    if (execution_here().current_live) {
        let guard = process_run_lock();
        scheduled_process_record_of_locked(guard, execution_here().current_handle)
            .sigwait_suspend = true;
        process_run_unlock(guard);
        kernel_process_current_prepare_signal_wait(wait_set);
    }
}

fn kernel_process_current_signal_suspending() -> bool {
    if (execution_here().current_live == false) { return false; }
    let guard = process_run_lock();
    let suspending: bool =
        scheduled_process_record_of_locked(guard, execution_here().current_handle)
            .sigwait_suspend;
    process_run_unlock(guard);
    return suspending;
}

fn kernel_process_current_clear_signal_suspend() {
    if (execution_here().current_live) {
        let guard = process_run_lock();
        scheduled_process_record_of_locked(guard, execution_here().current_handle)
            .sigwait_suspend = false;
        process_run_unlock(guard);
    }
}

// rt_sigsuspend's mask swap: install the temporary mask and remember the
// caller's, for the signal frame the same syscall's return builds.
fn kernel_process_current_suspend_mask_install(mask: usize) {
    let guard = process_run_lock();
    if (execution_here().current_live) {
        let record: *ProcessRecord =
            scheduled_process_record_of_locked(guard, execution_here().current_handle);
        let unmaskable: usize = (1 << 8) | (1 << 18);
        record.sigsuspend_saved_mask = record.signal_mask;
        record.sigsuspend_mask_saved = true;
        record.signal_mask = mask & ~unmaskable;
    }
    process_run_unlock(guard);
}

// The mask a signal frame built now must restore: the saved one when an
// rt_sigsuspend installed a temporary mask (which is then dropped), the
// current one otherwise.
fn kernel_process_current_frame_mask_take() -> usize {
    let guard = process_run_lock();
    let mut mask: usize = 0;
    if (execution_here().current_live) {
        let record: *ProcessRecord =
            scheduled_process_record_of_locked(guard, execution_here().current_handle);
        mask = record.signal_mask;
        if (record.sigsuspend_mask_saved) {
            mask = record.sigsuspend_saved_mask;
            record.sigsuspend_mask_saved = false;
        }
    }
    process_run_unlock(guard);
    return mask;
}

// A syscall return that delivers nothing still owes an rt_sigsuspend its
// original mask back.
fn kernel_process_current_suspend_mask_restore() {
    let guard = process_run_lock();
    if (execution_here().current_live) {
        let record: *ProcessRecord =
            scheduled_process_record_of_locked(guard, execution_here().current_handle);
        if (record.sigsuspend_mask_saved) {
            record.signal_mask = record.sigsuspend_saved_mask;
            record.sigsuspend_mask_saved = false;
        }
    }
    process_run_unlock(guard);
}

struct SigchldAction {
    handler: usize;
    flags: usize;
    restorer: usize;
    mask: usize;
}

fn kernel_process_current_sigchld_action() -> SigchldAction {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    let mut action: SigchldAction = { 0, 0, 0, 0 };
    if (execution_here().current_live) {
        let record: *ProcessRecord =
            scheduled_process_record_running(running_here);
        action.handler = record.sigchld_handler;
        action.flags = record.sigchld_flags;
        action.restorer = record.sigchld_restorer;
        action.mask = record.sigchld_action_mask;
    }
    { let mut __running_result: SigchldAction = action; process_running_end(running_here); return __running_result; }
}

fn kernel_process_current_set_sigchld_action(action: SigchldAction) {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        let record: *ProcessRecord =
            scheduled_process_record_running(running_here);
        record.sigchld_handler = action.handler;
        record.sigchld_flags = action.flags;
        record.sigchld_restorer = action.restorer;
        record.sigchld_action_mask = action.mask;
    }
    process_running_end(running_here);
}

// Take a pending SIGCHLD the current process has a handler for and does
// not mask, for a syscall return to run the handler.
fn kernel_process_current_caught_signal_take() -> ProcessSignalPendingResult {
    if (execution_here().current_live == false) {
        return ProcessSignalPendingResult::Missing;
    }
    let guard = process_run_lock();
    let mut handle: ProcessHandle = execution_here().current_handle;
    let record: *ProcessRecord = scheduled_process_record_of_locked(guard, handle);
    let sigchld_bit: usize = 1 << 16;
    if (record.sigchld_handler <= 1 ||
        (record.pending_signals & sigchld_bit) == 0 ||
        (record.signal_mask & sigchld_bit) != 0) {
        process_run_unlock(guard);
        return ProcessSignalPendingResult::Missing;
    }
    process_signal_pending_clear(guard, record, sigchld_bit);
    process_run_unlock(guard);
    return ProcessSignalPendingResult::Pending(
        taken_signal_new(handle.pool_index, handle.generation, 17));
}

fn kernel_process_block_signal(current: borrow FrameRef[process])
        -> BlockSwitch {
    return kernel_process_block_current(
        current, ProcessWaitReason::Signal, 5);
}

must_use variant ProcessSignalSendResult {
    Missing;
    Delivered;
}

private fn kernel_process_signal_deliver_to(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        target: ProcessHandle, signum: usize)
        -> ProcessSignalSendResult !{unsafe} {
    if (signum == 0 || signum > 64 ||
        scheduled_process_handle_matches(target) == false ||
        scheduled_process_state_of(target) == ProcessSlotState::Exited) {
        return ProcessSignalSendResult::Missing;
    }
    let bit: usize = 1 << (signum - 1);
    let record: *ProcessRecord = scheduled_process_record_of_locked(guard, target);
    // An unblocked SIGCHLD with no handler has its Linux default (ignored);
    // a blocked one remains pending for rt_sigtimedwait, which is the
    // BusyBox init path. One with a handler (GitHub issue #627) stays
    // pending, masked or not, until a syscall return can run the handler.
    let caught: bool = signum == 17 && record.sigchld_handler > 1;
    // Every session has one group, so every group is orphaned: no parent
    // can be in the same session but a different group. Unblocked SIGTSTP
    // therefore has the ignored orphan-group default. A blocked SIGTSTP
    // still participates in sigwait, as the generated signal really exists.
    if ((record.signal_mask & bit) == 0 && signum != 2 && signum != 3 &&
        signum != 15 && caught == false) {
        return ProcessSignalSendResult::Delivered;
    }
    process_signal_pending_raise(guard, record, bit);
    // A terminal-generated fatal signal must interrupt a blocked child too,
    // not wait for that child's deadline or an unrelated input byte.
    if ((signum == 2 || signum == 3) && (record.signal_mask & bit) == 0 &&
        scheduled_process_state_of(target) == ProcessSlotState::Blocked) {
        match scheduled_process_blocked_take(guard, target) {
            ScheduledProcessBlockedTakeResult::Missing => {}
            ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                let (owner, blocked) = resources;
                record.deadline_ticks = 0;
                record.deadline_result = 0;
                let ready = scheduled_process_wake(owner, blocked);
                scheduled_process_release(owner, ready);
            }
        }
        return ProcessSignalSendResult::Delivered;
    }
    if (scheduled_process_state_of(target) == ProcessSlotState::Blocked &&
        scheduled_process_wait_reason_of(target) ==
            ProcessWaitReason::Signal &&
        (record.sigwait_set & bit) != 0) {
        match scheduled_process_blocked_take(guard, target) {
            ScheduledProcessBlockedTakeResult::Missing => {}
            ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                let (owner, blocked) = resources;
                if (record.sigwait_suspend) {
                    // rt_sigsuspend: the frame was rewound, and the rerun
                    // finds the signal still pending and delivers it.
                    record.sigwait_suspend = false;
                } else {
                    let parked = scheduled_process_saved_frame(owner);
                    el0_context_set_x0(parked, signum);
                    process_signal_pending_clear(guard, record, bit);
                }
                record.sigwait_set = 0;
                record.deadline_ticks = 0;
                record.deadline_result = 0;
                let ready = scheduled_process_wake(owner, blocked);
                scheduled_process_release(owner, ready);
            }
        }
    }
    return ProcessSignalSendResult::Delivered;
}

fn kernel_process_signal_child_exit(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        parent: ProcessHandle) {
    let result = kernel_process_signal_deliver_to(guard, parent, 17);
    match result {
        ProcessSignalSendResult::Missing => {}
        ProcessSignalSendResult::Delivered => {}
    }
}

private let mut terminal_foreground_session: usize;

fn kernel_process_terminal_reader(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) {
    if (execution_here().current_live) {
        terminal_foreground_session = scheduled_process_record_of_locked(guard, 
            execution_here().current_handle).session_id;
    }
}

// Without controlling terminals or setpgid, the last terminal reader's
// session is the UART foreground group. Group IDs are session IDs, and pids
// are monotonically allocated, so pool-slot reuse cannot retarget a signal.
// A canonical-to-raw change can expose bytes to a reader that is already
// asleep, without a new UART interrupt. Wake Linux retrying readers only;
// the internal scalar waiter must receive a real byte from the RX handler.
fn kernel_process_terminal_settings_wake(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) {
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let next = scheduled_process_next_slot(slot);
                if (scheduled_process_record_state(slot) == ProcessSlotState::Blocked &&
                    scheduled_process_record_wait_reason(slot) == ProcessWaitReason::UartRx &&
                    scheduled_process_uart_block_delivery(guard, slot) ==
                        UartBlockDelivery::Read) {
                    match scheduled_process_blocked_take(guard,
                            scheduled_process_handle_of_slot(slot)) {
                        ScheduledProcessBlockedTakeResult::Missing => { }
                        ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                            let (owner, blocked) = resources;
                            let parked = scheduled_process_saved_frame(owner);
                            match kernel_syscall_uart_deliver(
                                    guard, owner, parked, 0) {
                                KernelUartDeliveryResult::Consumed => { }
                                KernelUartDeliveryResult::RetryRead => { }
                            }
                            let ready = scheduled_process_wake(owner, blocked);
                            scheduled_process_release(owner, ready);
                        }
                    }
                }
                cursor = next;
            }
        }
    }
}

// GitHub issue #635: is this pid asleep in a terminal read? Read from the
// process record under the run lock, which is what a fixture asking "is the
// reader blocked yet" needs instead of a guess from elapsed time.
fn kernel_process_pid_blocked_in_uart_read(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        pid: usize) -> bool {
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                if (scheduled_process_record_locked(guard, slot).pid == pid &&
                    scheduled_process_record_state(slot) ==
                        ProcessSlotState::Blocked &&
                    scheduled_process_record_wait_reason(slot) ==
                        ProcessWaitReason::UartRx &&
                    scheduled_process_uart_block_delivery(guard, slot) ==
                        UartBlockDelivery::Read) {
                    return true;
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
    return false;
}

// What a fixture that gave up on a sleeping pid says about it, so the failure
// line is enough to tell a wake that never came from a wake that came and was
// followed by another sleep. Codes are the DDB `ps` ones: state 0 free, 1 ready,
// 2 running, 3 blocked; wait 1 uart-rx, 2 child-exit. delivery is 1 for a read
// that retries, 0 for a scalar wait.
fn kernel_process_pid_log_wait(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock],
        pid: usize) {
    match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => {
            kernel_boot_log("workload: reader pid is gone\n");
        }
        ProcessSlotForPidResult::Found(slot) => {
            kernel_boot_log("workload: reader pid="); uart_put_udec(pid);
            kernel_boot_log(" state=");
            uart_put_udec(kernel_process_protocol_state(
                scheduled_process_record_state(slot)));
            kernel_boot_log(" wait=");
            uart_put_udec(kernel_process_protocol_reason(
                scheduled_process_record_wait_reason(slot)));
            kernel_boot_log(" delivery=");
            match scheduled_process_uart_block_delivery(guard, slot) {
                UartBlockDelivery::Read => { uart_put_udec(1); }
                UartBlockDelivery::Scalar => { uart_put_udec(0); }
            }
            kernel_boot_log("\n");
        }
    }
}

fn kernel_process_terminal_signal(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock], signum: usize) {
    if (terminal_foreground_session == 0) { return; }
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                if (scheduled_process_record_locked(guard, slot).session_id ==
                        terminal_foreground_session &&
                    scheduled_process_record_locked(guard, slot).pid != 1) {
                    match kernel_process_signal_deliver_to(
                            guard, scheduled_process_handle_of_slot(slot), signum) {
                        ProcessSignalSendResult::Missing => {}
                        ProcessSignalSendResult::Delivered => {}
                    }
                }
                cursor = scheduled_process_next_slot(slot);
            }
        }
    }
}

fn kernel_process_signal_send(pid: usize, signum: usize)
        -> ProcessSignalSendResult {
    let slot: usize = match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => {
            return ProcessSignalSendResult::Missing;
        }
        ProcessSlotForPidResult::Found(found) => { found }
    };
    if (signum == 0) { return ProcessSignalSendResult::Delivered; }
    let guard = process_run_lock();
    let result = kernel_process_signal_deliver_to(
        guard, scheduled_process_handle_of_slot(slot), signum);
    process_run_unlock(guard);
    return result;
}

fn kernel_process_block_deadline(current: borrow FrameRef[process])
        -> BlockSwitch {
    return kernel_process_block_current(
        current, ProcessWaitReason::Deadline, 4);
}

// Complete timed syscalls directly from their saved frame when the generic
// counter reaches the per-process deadline.
// GitHub issue #587: the caller's process-run lock, for the reason the net
// wake above needs it. This one already walked every slot; what it did not
// do is hold the lock a waiter publishes Blocked under.
fn kernel_process_deadline_wake_all(guard: borrow ProcessRunGuard[lock])
        !{interrupt, unsafe} {
    let now: usize = read_cntpct() as usize;
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let next = scheduled_process_next_slot(slot);
                let reason: ProcessWaitReason =
                    scheduled_process_record_wait_reason(slot);
                if (scheduled_process_record_state(slot) ==
                        ProcessSlotState::Blocked &&
                    (reason == ProcessWaitReason::Deadline ||
                     reason == ProcessWaitReason::Signal) &&
                    scheduled_process_record_locked(guard, slot).deadline_ticks != 0 &&
                    now >= scheduled_process_record_locked(guard, slot).deadline_ticks) {
                    match scheduled_process_blocked_take(guard,
                            scheduled_process_handle_of_slot(slot)) {
                        ScheduledProcessBlockedTakeResult::Missing => {}
                        ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                            let (owner, blocked) = resources;
                            let parked = scheduled_process_saved_frame(owner);
                            el0_context_set_x0(
                                parked,
                                scheduled_process_record_locked(guard, owner.pool_index)
                                    .deadline_result);
                            let ready = scheduled_process_wake(owner, blocked);
                            scheduled_process_record_locked(guard, owner.pool_index)
                                .deadline_ticks = 0;
                            scheduled_process_record_locked(guard, owner.pool_index)
                                .deadline_result = 0;
                            scheduled_process_record_locked(guard, owner.pool_index)
                                .sigwait_set = 0;
                            scheduled_process_release(owner, ready);
                        }
                    }
                }
                cursor = next;
            }
        }
    }
}

// Every process waiting for a frame becomes runnable again.
//
// Called from the timer HANDLER, so a waiter is retried once per tick
// whether or not anything arrived. That is deliberately coarse: what it
// has to be is REGULAR, because a handshake that lost its SYN-ACK is
// waiting on the retransmission timer inside its own retry, not on a
// packet. A frame arriving earlier does not need to wake anybody either --
// the next tick finds it still there.
//
// The handler and not kernel_process_timer_schedule, which is the tick's
// EL0 half. A tick taken at EL1 does not reach that function, so a waiter
// whose only company is a process sitting in the syscall retry loop would
// never be woken by it -- every tick would land at EL1 and the two would
// wait for each other. Waking is not a scheduling decision and does not
// belong behind one.
// GitHub issue #587: under the caller's process-run lock, and over every
// slot rather than one process chain.
//
// The process-run lock closes the check-then-block race with a waiter
// publishing Blocked, and the all-slot walk reaches waiters regardless of
// which core or process family was interrupted. #581 must still keep socket
// calls on core 0 until peer NetRx waiting has an end-to-end test.
//
// The lock is the one a waiter publishes Blocked under, so either this
// finds it Blocked or it finds the frame afterwards -- #547's argument for
// the terminal, one subsystem over, and the reason that issue's fix could
// not be a local interrupt mask.
//
// The walk is the one kernel_process_deadline_wake_all already does from
// this same handler, so the cost is established rather than new.
// The timer's normal path calls this while holding the process-run lock.
// Keeping the scan separate also lets the QEMU negative control compile the
// identical scan without that lock, so the test changes only the protection
// around the real production operation.
fn kernel_process_net_wake_scan(guard: borrow ProcessRunGuard[lock])
        !{interrupt, unsafe} {
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let next = scheduled_process_next_slot(slot);
                if (scheduled_process_record_state(slot) ==
                        ProcessSlotState::Blocked &&
                    scheduled_process_record_wait_reason(slot) ==
                        ProcessWaitReason::NetRx) {
                    match scheduled_process_blocked_take(guard,
                            scheduled_process_handle_of_slot(slot)) {
                        ScheduledProcessBlockedTakeResult::Missing => {}
                        ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                            let (owner, blocked) = resources;
                            let ready = scheduled_process_wake(owner, blocked);
                            scheduled_process_release(owner, ready);
                        }
                    }
                }
                cursor = next;
            }
        }
    }
}

fn kernel_process_net_wake_all(guard: borrow ProcessRunGuard[lock])
        !{interrupt, unsafe} {
    kernel_process_net_wake_scan(guard);
}

// GitHub issue #544: a userspace write to the UART found the transmit queue
// above its low-water mark and queued nothing, so it sleeps until the TX
// interrupt has drained the queue back down. The syscall frame was rewound
// before this, so the writer runs the same write again when it wakes.
fn kernel_process_block_uart_tx(current: borrow FrameRef[process])
        -> BlockSwitch {
    return kernel_process_block_current(
        current, ProcessWaitReason::UartTx, 6);
}

// Every process waiting for room in the UART transmit queue becomes runnable.
// Called from the PL011 interrupt once the TX drain has brought the queue to
// its low-water mark, the counterpart of kernel_process_net_wake_all.
// GitHub issue #587: the third instance of one shape. The net wake, this
// one and the deadline wake all read process state and move a process from
// Blocked to Ready out of an interrupt handler; two of the three took no
// lock and walked one chain, and this is the other of those two.
fn kernel_process_uart_tx_wake_all(guard: borrow ProcessRunGuard[lock])
        !{interrupt, unsafe} {
    let mut cursor = scheduled_process_first_slot();
    let mut walking: bool = true;
    while (walking) {
        match cursor {
            ProcessSlotCursor::Done => { walking = false; }
            ProcessSlotCursor::At(slot) => {
                let next = scheduled_process_next_slot(slot);
                if (scheduled_process_record_state(slot) ==
                        ProcessSlotState::Blocked &&
                    scheduled_process_record_wait_reason(slot) ==
                        ProcessWaitReason::UartTx) {
                    match scheduled_process_blocked_take(guard,
                            scheduled_process_handle_of_slot(slot)) {
                        ScheduledProcessBlockedTakeResult::Missing => {}
                        ScheduledProcessBlockedTakeResult::Blocked(resources) => {
                            let (owner, blocked) = resources;
                            let ready = scheduled_process_wake(owner, blocked);
                            scheduled_process_release(owner, ready);
                        }
                    }
                }
                cursor = next;
            }
        }
    }
}

fn kernel_process_block_uart(current: borrow FrameRef[process])
        -> BlockSwitch {
    // GitHub issue #448: the one-shot marker belongs to the fixture that
    // means it, and that is now a distinguishable thing rather than
    // "whoever blocked first".
    //
    // This line reports the kernel's own UART-wait primitive being used by
    // the EL0 payload's child while its parent keeps computing -- the
    // Scalar delivery kind, syscall 451. An ash `read(2)` is the Read
    // kind, and until this release an ash never reached this function at
    // all: it span inside the kernel instead, so "the first block of the
    // boot" and "the payload fixture's block" were the same event by
    // accident. They are not any more -- on RPi5 the interactive shell got
    // here first and printed the payload's marker into the middle of the
    // ash transcript -- so the fixture says which block it means.
    // No caller holds the run lock; kernel_process_block_current takes it.
    let mut fixture_block: bool = true;
    if (execution_here().current_live) {
        let kind_guard = process_run_lock();
        if (scheduled_process_uart_block_delivery(kind_guard,
                execution_here().current_handle.pool_index) ==
            UartBlockDelivery::Read) {
            fixture_block = false;
        }
        process_run_unlock(kind_guard);
    }
    let blocked: BlockSwitch = kernel_process_block_current(
        current, ProcessWaitReason::UartRx, 1);
    // Anything but a retry is a block that was published.
    match blocked {
        BlockSwitch::Retry => { return BlockSwitch::Retry; }
        BlockSwitch::ToIdle => {
            kernel_process_uart_block_published(fixture_block);
            return BlockSwitch::ToIdle;
        }
        BlockSwitch::Switch(next) => {
            kernel_process_uart_block_published(fixture_block);
            return BlockSwitch::Switch(next);
        }
    }
}

private fn kernel_process_uart_block_published(fixture_block: bool) {
    if (process_test_evidence_record_uart_block(fixture_block)) {
        kernel_boot_log("uart rx: scheduler child blocked\n");
    }
}

// GitHub issue #244: the mirror image of kernel_process_block_uart() --
// blocks current (the parent calling wait4()) so its own child can keep
// running toward its exit.
fn kernel_process_block_wait4(current: borrow FrameRef[process])
        -> BlockSwitch {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) {
        { let mut __running_result: BlockSwitch = BlockSwitch::Retry; process_running_end(running_here); return __running_result; }
    }
    if (scheduled_process_record_running(running_here)
            .has_first_child == false) {
        { let mut __running_result: BlockSwitch = BlockSwitch::Retry; process_running_end(running_here); return __running_result; }
    }
    { let mut __running_result: BlockSwitch = kernel_process_block_current(
        current, ProcessWaitReason::ChildExit, 2); process_running_end(running_here); return __running_result; }
}

// The UART IRQ transfers one byte directly into the suspended syscall frame.
// true means the byte was consumed by a waiter and must not enter the ring.
// The waiter is either the current process's blocked child (the original
// root-shell shape) or a blocked ancestor -- the terminal is one device, so
// the process reading it is normally an ancestor of whatever the scheduler
// happens to be running when its byte arrives.
must_use variant ProcessUartWakeResult { Missing; Consumed; RetryRead; }


// GitHub issue #547: the caller holds the process-run lock, and keeps it
// across its push of an undelivered byte into the ring. The reader publishes
// Blocked under the same lock only after finding the ring empty (see
// kernel_process_block_reserved). So on any CPU, either this finds the reader
// Blocked, or the reader finds this byte in the ring.
fn kernel_process_uart_wake(guard: borrow ProcessRunGuard[lock], value: usize)
        -> ProcessUartWakeResult !{interrupt, unsafe} {
    // GitHub issue #592 made this reachable with no current process: core 0
    // idles now, and a reader pinned to a peer blocks on the terminal while
    // it does. The relative walks below start from core 0's current process,
    // so with none this used to answer Missing, the byte went into the ring,
    // and the Blocked reader was never woken -- /bin/peer-tty on RPi5 read
    // nothing in about one run in four once fcntl and dup3 stopped sending
    // ash to core 0. With no current process, walk every slot instead, the
    // walk kernel_process_net_wake_scan already makes from this context.
    let live: bool = execution_here().current_live;
    let mut waiter: ProcessHandle = execution_here().current_handle;
    let mut found: bool = false;
    // The diagnostic traces below name core 0's current process; with none,
    // they name pid 0 rather than peeking a record that may be gone.
    let mut current_pid: usize = 0;
    if (live) {
        current_pid = scheduled_process_pid_of_handle(
            execution_here().current_handle);
    }
    if (live == false) {
        let mut cursor = scheduled_process_first_slot();
        let mut walking: bool = true;
        while (walking && found == false) {
            match cursor {
                ProcessSlotCursor::Done => { walking = false; }
                ProcessSlotCursor::At(slot) => {
                    if (scheduled_process_record_state(slot) ==
                            ProcessSlotState::Blocked &&
                        scheduled_process_record_wait_reason(slot) ==
                            ProcessWaitReason::UartRx) {
                        waiter = scheduled_process_handle_of_slot(slot);
                        found = true;
                    }
                    cursor = scheduled_process_next_slot(slot);
                }
            }
        }
        if (found == false) {
            diagnostic_trace_record(
                DiagnosticEventProcessUartWake, value, 0, 0, 0);
            return ProcessUartWakeResult::Missing;
        }
    }
    // GitHub issue #437: EVERY child, not just the first.
    //
    // This read first_child alone, which was every child there could be.
    // With a fan-out the terminal waiter can be any of them, and dropping
    // the byte because it was not the newest is the same silent-prompt
    // failure the ancestor walk below was added to fix.
    //
    // A walk of the sibling list rather than of the process table: this is
    // `!{interrupt}`, and the table cursor goes through the pool, whose
    // accessors take the pool lock. Reading records is free.
    // Nested, not `live && ...`: both sides of && are evaluated, and the
    // right one reads the current record.
    let mut has_child: bool = false;
    if (live) {
        has_child = scheduled_process_record_of_locked(guard, 
            execution_here().current_handle).has_first_child;
    }
    if (has_child) {
        let mut candidate: ProcessHandle = scheduled_process_record_of_locked(guard, 
            execution_here().current_handle).first_child;
        let mut scanning: usize = scheduled_process_pool_live_count() + 1;
        while (scanning != 0 && found == false) {
            scanning = scanning - 1;
            if (scheduled_process_handle_matches(candidate) == false) {
                scanning = 0;
            } else {
                if (scheduled_process_state_of(candidate) ==
                        ProcessSlotState::Blocked &&
                    scheduled_process_wait_reason_of(candidate) ==
                        ProcessWaitReason::UartRx) {
                    waiter = candidate;
                    found = true;
                } else {
                    if (scheduled_process_record_of_locked(guard, candidate)
                            .has_next_sibling == false) {
                        scanning = 0;
                    } else {
                        candidate = scheduled_process_record_of_locked(guard, 
                            candidate).next_sibling;
                    }
                }
            }
        }
    }
    // A middle process can have both relatives (ash -> listener -> worker).
    // Its child normally is not the UART waiter, so keep looking upward
    // instead of dropping the byte before checking the blocked ash parent.
    //
    // Upward means all the way up, not one hop. A shell script that starts a
    // daemon puts two processes between that daemon and the ash blocked on
    // this byte (ash -> script shell -> daemon), and stopping at the first
    // parent dropped every keystroke from there on -- the prompt went silent
    // while the daemon itself kept serving. The walk is bounded by the number
    // of live processes, so a parent chain that is not in fact a chain runs
    // out rather than spinning inside an interrupt.
    let mut remaining_hops: usize = scheduled_process_pool_live_count() + 1;
    let mut ancestor: ProcessHandle = execution_here().current_handle;
    let mut climbing: bool = live;
    while (climbing && found == false && remaining_hops != 0) {
        remaining_hops = remaining_hops - 1;
        if (scheduled_process_record_of_locked(guard, ancestor).has_parent ==
                false) {
            climbing = false;
        } else {
            let mut candidate: ProcessHandle =
                scheduled_process_record_of_locked(guard, ancestor).parent;
            // A parent link that no longer names the process it was recorded
            // for is the end of the chain, not something to read state from.
            if (scheduled_process_handle_matches(candidate) == false) {
                climbing = false;
            } else {
                if (scheduled_process_state_of(candidate) ==
                        ProcessSlotState::Blocked &&
                    scheduled_process_wait_reason_of(candidate) ==
                        ProcessWaitReason::UartRx) {
                    waiter = candidate;
                    found = true;
                }
                ancestor = candidate;
            }
        }
    }
    // GitHub issue #448: last, the rest of the tree.
    //
    // The two searches above cover a waiter that is below current or above
    // it. A waiter that is neither -- current's SIBLING, or anything under
    // one -- was simply not looked for, because until an inittab started
    // more than one thing there was nothing else for a process to be. The
    // interactive shell is exactly that now: a `respawn` entry beside two
    // busy loops, so every keystroke arrives while a sibling is running.
    //
    // Same pre-order walk the scheduler rotates through, so "reachable by
    // the walk" means the same thing in both places. Kept as a FALLBACK
    // rather than a replacement: with two waiters the child-then-ancestor
    // order above is the behaviour every existing fixture was recorded
    // against, and this only decides cases that used to drop the byte.
    if (found == false && live) {
        let mut root: ProcessHandle =
            kernel_process_chain_root(guard, execution_here().current_handle);
        let mut cursor: ProcessHandle = root;
        let mut steps: usize = scheduled_process_pool_live_count() + 1;
        while (steps != 0 && found == false) {
            steps = steps - 1;
            if (scheduled_process_state_of(cursor) ==
                    ProcessSlotState::Blocked &&
                scheduled_process_wait_reason_of(cursor) ==
                    ProcessWaitReason::UartRx) {
                waiter = cursor;
                found = true;
            } else {
                cursor = kernel_process_next_successor(guard, cursor, root);
            }
        }
    }
    if (found == false) {
        diagnostic_trace_record(
            DiagnosticEventProcessUartWake, value,
            current_pid, 0, 1);
        return ProcessUartWakeResult::Missing;
    }
    let mut retry_read: bool = false;
    match scheduled_process_blocked_take(guard, waiter) {
        ScheduledProcessBlockedTakeResult::Missing => {
            diagnostic_trace_record(
                DiagnosticEventProcessUartWake, value,
                current_pid,
                scheduled_process_pid_of_handle(waiter), 2);
            return ProcessUartWakeResult::Missing;
        }
        ScheduledProcessBlockedTakeResult::Blocked(resources) => {
            let (owner, blocked) = resources;
            let parked = scheduled_process_saved_frame(owner);
            match kernel_syscall_uart_deliver(guard, owner, parked, value) {
                KernelUartDeliveryResult::Consumed => {}
                KernelUartDeliveryResult::RetryRead => { retry_read = true; }
            }
            let ready = scheduled_process_wake(owner, blocked);
            scheduled_process_release(owner, ready);
            let mut waker: ProcessHandle = waiter;
            if (live) { waker = execution_here().current_handle; }
            kernel_process_trace_handle(ProcessTraceWake, waiter, waker, value);
        }
    }
    process_test_evidence_record_uart_wake();
    if (retry_read) {
        diagnostic_trace_record(
            DiagnosticEventProcessUartWake, value,
            current_pid,
            scheduled_process_pid_of_handle(waiter), 4);
        return ProcessUartWakeResult::RetryRead;
    }
    diagnostic_trace_record(
        DiagnosticEventProcessUartWake, value,
        current_pid,
        scheduled_process_pid_of_handle(waiter), 3);
    return ProcessUartWakeResult::Consumed;
}

// This is the measurable #190 interleaving point: the parent reaches it only
// after its compute section, and it is accepted only while the child remains
// suspended on UART RX. "current has a live child" already implies current
// is playing the parent role (only a parent-role slot has one), so that
// replaces the old explicit execution_process != Parent check.
fn kernel_process_uart_record_parent_progress()
        -> ProcessUartProgressResult {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) {
        { let mut __running_result: ProcessUartProgressResult = ProcessUartProgressResult::Invalid; process_running_end(running_here); return __running_result; }
    }
    if (scheduled_process_record_running(running_here)
            .has_first_child == false) {
        { let mut __running_result: ProcessUartProgressResult = ProcessUartProgressResult::Invalid; process_running_end(running_here); return __running_result; }
    }
    let mut parent: ProcessHandle = execution_here().current_handle;
    let mut child: ProcessHandle =
        scheduled_process_record_running(running_here).first_child;
    if (scheduled_process_state_of(parent) !=
            ProcessSlotState::Running ||
        scheduled_process_state_of(child) !=
            ProcessSlotState::Blocked ||
        scheduled_process_wait_reason_of(child) !=
            ProcessWaitReason::UartRx) {
        { let mut __running_result: ProcessUartProgressResult = ProcessUartProgressResult::Invalid; process_running_end(running_here); return __running_result; }
    }
    process_test_evidence_record_uart_parent_progress();
    { let mut __running_result: ProcessUartProgressResult = ProcessUartProgressResult::Recorded; process_running_end(running_here); return __running_result; }
}

fn kernel_process_uart_block_evidence() -> bool {
    return process_test_evidence_uart_blocks() != 0 &&
           process_test_evidence_uart_wakes() ==
               process_test_evidence_uart_blocks() &&
           process_test_evidence_uart_parent_progress() == 1;
}

// #288's directed state-pair regression. It exercises the actual UART block
// and IRQ wake transition, then checks the retained records rather than only
// the final counters: child Blocked/UartRx while parent is runnable, followed
// by that same child Ready after wake.  Suppress the one human-facing UART
// progress line locally; this is a structural probe, not a boot milestone.
// The two probes below stand in frames that are not real ones, so they mint
// FrameRefs from bare addresses; these three helpers are where they do.
private fn kernel_process_probe_installed(
        parent: borrow FrameRef[parent_process],
        child: borrow FrameRef[child_process]) -> bool {
    let installed: bool = match kernel_process_clone_context_install(parent, child) {
        CloneInstall::Failed => { false }
        CloneInstall::Installed => { true }
    };
    return installed;
}

private fn kernel_process_probe_blocks_to(
        child: borrow FrameRef[child_process],
        parent: borrow FrameRef[parent_process]) -> bool {
    let same: bool = match kernel_process_block_uart(child) {
        BlockSwitch::Retry => { false }
        BlockSwitch::ToIdle => { false }
        BlockSwitch::Switch(resumed) => {
            frame_ref_address(resumed) == frame_ref_address(parent)
        }
    };
    return same;
}

// The frame address a tick resumes, 1 when it leaves for idle instead.
private fn kernel_process_probe_tick_address(sp: usize) -> usize
        !{interrupt} {
    let address: usize = match kernel_process_timer_schedule(
            frame_ref_from_entry(sp, kernel_process_entry_generation())) {
        TimerSwitch::Resume(resumed) => { frame_ref_address(resumed) }
        TimerSwitch::ToIdle => { 1 }
    };
    return address;
}

fn kernel_process_trace_block_wake_probe() -> bool !{unsafe} {
    kernel_process_execution_reset();
    kernel_process_trace_enable();
    process_test_evidence_set_uart_block_logged(true);
    let parent_frame = frame_ref_from_entry(
        (kernel_process_trace_probe_parent_frame as *usize) as usize,
        kernel_process_entry_generation());
    let child_frame = frame_ref_from_entry(
        (kernel_process_trace_probe_child_frame as *usize) as usize,
        kernel_process_entry_generation());
    let mut setup_ok: bool = false;
    match kernel_process_clone_begin(0x11, 0) {
        ProcessCloneResult::Invalid => {}
        ProcessCloneResult::ResourceExhausted => {}
        ProcessCloneResult::ChildConstructing(child_pid) => {
            if (child_pid == 2 &&
                kernel_process_probe_installed(parent_frame, child_frame) &&
                kernel_process_scheduler_probe_stack_depart() &&
                kernel_process_scheduler_probe_stack_arrive() &&
                kernel_process_probe_blocks_to(child_frame, parent_frame) &&
                kernel_process_scheduler_probe_stack_depart() &&
                kernel_process_scheduler_probe_stack_arrive()) {
                match kernel_process_uart_record_parent_progress() {
                    ProcessUartProgressResult::Invalid => {}
                    ProcessUartProgressResult::Recorded => {
                        // Under the lock the RX interrupt holds (#547).
                        let guard = process_run_lock();
                        match kernel_process_uart_wake(guard, 0x41) {
                            ProcessUartWakeResult::Missing => {}
                            ProcessUartWakeResult::Consumed => { setup_ok = true; }
                            ProcessUartWakeResult::RetryRead => { setup_ok = true; }
                        }
                        process_run_unlock(guard);
                    }
                }
            }
        }
    }
    let mut trace: [usize; KERNEL_CRASH_TRACE_WORDS];
    let trace_count: usize = kernel_process_crash_trace_copy(trace as *usize);
    let mut saw_block: bool = false;
    let mut saw_wake: bool = false;
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        if (item < trace_count) {
            let base: usize = item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
            let kind: usize =
                trace[base + KERNEL_PROCESS_TRACE_EVENT_WORD];
            if (kind == ProcessTraceBlock &&
                trace[base + KERNEL_PROCESS_TRACE_PID_WORD] == 2 &&
                trace[base + KERNEL_PROCESS_TRACE_PEER_PID_WORD] == 1 &&
                trace[base + KERNEL_PROCESS_TRACE_STATE_WORD] == 3 &&
                trace[base + KERNEL_PROCESS_TRACE_WAIT_REASON_WORD] == 1) {
                saw_block = true;
            }
            if (kind == ProcessTraceWake &&
                trace[base + KERNEL_PROCESS_TRACE_PID_WORD] == 2 &&
                trace[base + KERNEL_PROCESS_TRACE_PEER_PID_WORD] == 1 &&
                trace[base + KERNEL_PROCESS_TRACE_STATE_WORD] == 1 &&
                trace[base + KERNEL_PROCESS_TRACE_WAIT_REASON_WORD] == 0) {
                saw_wake = true;
            }
        }
    }
    kernel_process_execution_reset();
    kernel_process_trace_disable();
    process_test_evidence_set_uart_block_logged(false);
    return setup_ok && saw_block && saw_wake;
}

// GitHub issue #437: three live children at once, each collected by pid.
//
// The fan-out limit is gone, and nothing in this kernel forks twice yet --
// so without this the lifting is untested and the enumeration, the sibling
// list and wait4's pid selection are all claims. It exercises the four
// things that had to move together: a second and third clone_begin that
// used to be -EINVAL, a scheduler rotation that must reach every one of
// them, wait4(pid) selecting the MIDDLE child rather than the newest, and
// each child keeping its own status where the parent used to keep one.
//
// Bookkeeping-only, like scheduled_process_table_probe beside it: the
// children never run user code, they are driven Ready->Running->Exited
// directly, so this needs no images and no address spaces.
// Constructing -> Running -> Exited for a synthetic clone, under the run lock.
//
// GitHub issue #479 Group B: hoisted out of the loop it was written in,
// because the guard is linear and the match arm it lived in returns early
// -- a local acquire around that match does not compile, which is the
// mechanism doing its job rather than an inconvenience.
private fn kernel_process_probe_run_to_exit(handle: ProcessHandle) -> bool {
    let guard = process_run_lock();
    let ok: bool = kernel_process_probe_run_to_exit_locked(guard, handle);
    process_run_unlock(guard);
    return ok;
}

private fn kernel_process_probe_run_to_exit_locked(
        guard: borrow ProcessRunGuard[lock],
        handle: ProcessHandle) -> bool {
    match scheduled_process_constructing_take(guard, handle) {
        ScheduledProcessConstructingTakeResult::Missing => { return false; }
        ScheduledProcessConstructingTakeResult::Constructing(resources) => {
            let (owner, constructing) = resources;
            // This bookkeeping fixture never restores its synthetic frame.
            let synthetic = scheduled_process_saved_frame(owner);
            let running = scheduled_process_finish_clone(
                owner, constructing, synthetic);
            let exited = scheduled_process_exit(owner, running);
            scheduled_process_release(owner, exited);
        }
    }
    return true;
}

fn kernel_process_fanout_probe() -> bool !{unsafe} {
    kernel_process_execution_reset();
    let parent_pid: usize = kernel_process_current_pid();
    let mut pids: [usize; 3] = { 0, 0, 0 };
    let mut parent_handle: ProcessHandle = execution_here().current_handle;
    // Three forks from the SAME parent. clone_begin switches current to
    // the child, so step back before the next one -- that is what makes
    // them siblings rather than a chain, and it is the sequence the old
    // ceiling made impossible to write.
    for i: usize in 0..<3 {
        match kernel_process_clone_begin(0x11, 0) {
            ProcessCloneResult::Invalid => { return false; }
            ProcessCloneResult::ResourceExhausted => { return false; }
            ProcessCloneResult::ChildConstructing(child_pid) => { pids[i] = child_pid; }
        }
        execution_here().current_handle = parent_handle;
        if (kernel_process_current_pid() != parent_pid) { return false; }
    }
    if (pids[0] == pids[1] || pids[1] == pids[2] || pids[0] == pids[2]) {
        return false;
    }
    // Every child reachable from the parent, which the old chain walk
    // could not do past the first.
    let mut seen: usize = 0;
    for i: usize in 0..<3 {
        if (kernel_process_current_has_child_pid(pids[i])) { seen = seen + 1; }
    }
    if (seen != 3) { return false; }
    // A failed fourth fork must remove only its own head link. Keep using
    // the real wait4-by-pid checks below to prove that all older siblings
    // remain reachable and retain their statuses after rollback.
    let live_before_rollback: usize = scheduled_process_pool_live_count();
    let clones_before_rollback: usize = process_test_evidence_clone_calls();
    let mut cancelled_pid: usize = 0;
    match kernel_process_clone_begin(0x11, 0) {
        ProcessCloneResult::Invalid => { return false; }
        ProcessCloneResult::ResourceExhausted => { return false; }
        ProcessCloneResult::ChildConstructing(pid) => { cancelled_pid = pid; }
    }
    match kernel_process_clone_rollback() {
        ProcessCloneRollbackResult::Invalid => { return false; }
        ProcessCloneRollbackResult::Restored => {}
    }
    parent_handle = execution_here().current_handle;
    if (kernel_process_current_pid() != parent_pid ||
        scheduled_process_pool_live_count() != live_before_rollback ||
        process_test_evidence_clone_calls() != clones_before_rollback ||
        kernel_process_current_has_child_pid(cancelled_pid)) {
        return false;
    }
    for i: usize in 0..<3 {
        if (kernel_process_current_has_child_pid(pids[i]) == false) {
            return false;
        }
    }
    // Complete all three synthetic clones and drive them to Exited without
    // restoring their frames. Give each its own status for collection below.
    // seen == 3 above already means the link exists, but say so where the
    // read is: first_child is only readable when has_first_child says it
    // is, and a probe that assumes an invariant it does not state is how
    // the unguarded read in kernel_process_reap_zombie survived.
    // GitHub issue #693 step 6: the links and the status are read and
    // written under the run guard, dropped before each run-to-exit, which
    // takes it itself.
    let head_guard = process_run_lock();
    let has_head: bool =
        scheduled_process_record_of_locked(head_guard, parent_handle)
            .has_first_child;
    let mut cursor: ProcessHandle =
        scheduled_process_record_of_locked(head_guard, parent_handle)
            .first_child;
    process_run_unlock(head_guard);
    if (has_head == false) { return false; }
    for i: usize in 0..<3 {
        let link_guard = process_run_lock();
        let has_following: bool =
            scheduled_process_record_of_locked(link_guard, cursor)
                .has_next_sibling;
        let mut following: ProcessHandle =
            scheduled_process_record_of_locked(link_guard, cursor).next_sibling;
        // Head insertion means the list runs newest-first, so the pid
        // stamped here is pids[2 - i].
        scheduled_process_record_of_locked(link_guard, cursor).exit_status =
            42 - i;
        process_run_unlock(link_guard);
        if (kernel_process_probe_run_to_exit(cursor) == false) {
            return false;
        }
        if (has_following == false && i != 2) { return false; }
        cursor = following;
    }
    if (kernel_process_child_waitable_pid_probe(pids[1]) == false) { return false; }
    if (kernel_process_child_wait_status_pid(pids[1]) != 41) { return false; }
    if (kernel_process_last_reaped_pid() != pids[1]) { return false; }
    // The other two are untouched and still carry their own statuses --
    // the property a single parent-side field could not have.
    if (kernel_process_child_waitable_pid_probe(pids[1])) { return false; }
    if (kernel_process_child_wait_status_pid(pids[0]) != 40) { return false; }
    if (kernel_process_child_wait_status_pid(pids[2]) != 42) { return false; }
    if (kernel_process_child_waitable_probe()) { return false; }
    return true;
}

// Deterministic regression for issue #524's process topology. The current
// process is the child created by scheduler_probe; put its parent in the
// exact Blocked/ChildExit state observed by DDB, assert that the dependency
// is visible, then restore the parent before the scheduler exercise continues.
private fn kernel_process_exit_waiter_probe(parent: ProcessHandle) -> bool {
    let guard = process_run_lock();
    let mut arranged: bool = false;
    match scheduled_process_ready_take(guard, parent) {
        ScheduledProcessReadyTakeResult::Missing => {}
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            let running = scheduled_process_start(owner, ready);
            let blocked = scheduled_process_block(
                owner, running, ProcessWaitReason::ChildExit);
            scheduled_process_release(owner, blocked);
            arranged = true;
        }
    }
    process_run_unlock(guard);
    if (arranged == false ||
        kernel_process_current_exit_has_waiter() == false) {
        return false;
    }
    // The synthetic parent is explicitly pinned to core 0. Exit may wake it
    // there, but its affinity must keep it from becoming a successor on core
    // 1 now that an unset mask means every online CPU.
    let probe_guard = process_run_lock();
    scheduled_process_set_affinity_mask(probe_guard, parent.pool_index, 1);
    let peer_wait_parent_rejected: bool =
        kernel_process_cpu_allows_slot(probe_guard, 1, parent.pool_index) ==
            false;
    process_run_unlock(probe_guard);
    // The exit-strand answers this probe also asserted went with the check
    // itself in #609: an exit with no successor now idles on every CPU.
    let restore_guard = process_run_lock();
    let mut restored: bool = false;
    match scheduled_process_blocked_take(restore_guard, parent) {
        ScheduledProcessBlockedTakeResult::Missing => {}
        ScheduledProcessBlockedTakeResult::Blocked(resources) => {
            let (owner, blocked) = resources;
            let ready = scheduled_process_wake(owner, blocked);
            scheduled_process_release(owner, ready);
            restored = true;
        }
    }
    process_run_unlock(restore_guard);
    return restored && kernel_process_current_exit_has_waiter() == false &&
        peer_wait_parent_rejected;
}

// The scheduler probe calls scheduling functions directly instead of entering
// through generated exception code. Mirror only the physical stack boundary
// that those entry/return sequences provide; all logical selection still uses
// the production scheduler below.
private fn kernel_process_scheduler_probe_stack_depart() -> bool {
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES || execution_here().stack_live == false) {
        return false;
    }
    let guard = process_run_lock();
    let mut physical: ProcessHandle = execution_here().stack_handle;
    let valid: bool = scheduled_process_handle_matches(physical) &&
        scheduled_process_record_of_locked(guard, physical).stack_owner_cpu == core;
    if (valid) {
        scheduled_process_record_of_locked(guard, physical).stack_owner_cpu =
            PROCESS_STACK_UNOWNED;
        execution_here().stack_live = false;
    }
    process_run_unlock(guard);
    return valid;
}

// Negative control for the physical half of publication: clone installation
// has made the parent logically Ready, but generated restore code has not yet
// left its stack. The ordinary Ready take must still refuse it.
private fn kernel_process_owned_ready_unselectable_probe(
        handle: ProcessHandle) -> bool {
    let guard = process_run_lock();
    let mut refused: bool = true;
    match scheduled_process_ready_take(guard, handle) {
        ScheduledProcessReadyTakeResult::Missing => {}
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            scheduled_process_release(owner, ready);
            refused = false;
        }
    }
    process_run_unlock(guard);
    return refused;
}

private fn kernel_process_scheduler_probe_stack_arrive() -> bool {
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES || execution_here().current_live == false) {
        return false;
    }
    let guard = process_run_lock();
    let mut incoming: ProcessHandle = execution_here().current_handle;
    let valid: bool = scheduled_process_handle_matches(incoming) &&
        scheduled_process_state_of(incoming) == ProcessSlotState::Running &&
        scheduled_process_record_of_locked(guard, incoming).stack_owner_cpu ==
            PROCESS_STACK_UNOWNED;
    if (valid) {
        scheduled_process_record_of_locked(guard, incoming).stack_owner_cpu = core;
        execution_here().stack_handle = incoming;
        execution_here().stack_live = true;
    }
    process_run_unlock(guard);
    return valid;
}

fn kernel_process_scheduler_probe() -> bool {
    kernel_process_execution_reset();
    kernel_process_trace_enable();
    if (scheduled_process_peer_dispatch_enabled) { return false; }
    let root_pid: usize = kernel_process_current_pid();
    let mut root_handle: ProcessHandle = execution_here().current_handle;
    // The bootstrap is architectural state, not an ordinary affinity-zero
    // process: its saved frame may be absent while the boot probes run.
    // Prove no peer selector can take slot 0 before exercising normal tasks.
    let probe_guard = process_run_lock();
    let mut bootstrap_peer_refused: bool =
        root_handle.pool_index == 0 &&
        kernel_process_cpu_allows_slot(probe_guard, 0, root_handle.pool_index);
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (kernel_process_cpu_allows_slot(probe_guard, cpu,
                                           root_handle.pool_index)) {
            bootstrap_peer_refused = false;
        }
    }
    process_run_unlock(probe_guard);
    if (bootstrap_peer_refused == false) { return false; }
    match kernel_process_clone_begin(0x11, 0) {
        ProcessCloneResult::Invalid => { return false; }
        ProcessCloneResult::ResourceExhausted => { return false; }
        ProcessCloneResult::ChildConstructing(child_pid) => {
            // This probe later installs synthetic saved stack pointers and
            // drives the scheduler by direct calls. Keep that test-only
            // Ready frame away from the live peer idle loop.
            let child_guard = process_run_lock();
            scheduled_process_set_affinity_mask(child_guard,
                execution_here().current_handle.pool_index, 1);
            let mut synthetic_child_peer_refused: bool = true;
            for cpu: usize in 1..<KERNEL_MAX_CORES {
                if (kernel_process_cpu_allows_slot(child_guard,
                        cpu, execution_here().current_handle.pool_index)) {
                    synthetic_child_peer_refused = false;
                }
            }
            process_run_unlock(child_guard);
            if (kernel_process_clone_unselectable_probe(root_handle) == false ||
                synthetic_child_peer_refused == false ||
                child_pid != root_pid + 1 ||
                kernel_process_probe_installed(
                    frame_ref_from_entry(
                        0x1000, kernel_process_entry_generation()),
                    frame_ref_from_entry(
                        0x2000, kernel_process_entry_generation()))
                    == false) {
                return false;
            }
        }
    }
    // clone_context_install returns through generated context-restore code in
    // production. Complete that parent-stack -> child-stack handoff before
    // this direct-call probe tries to reserve the now-Ready parent.
    if (kernel_process_owned_ready_unselectable_probe(root_handle) == false ||
        kernel_process_scheduler_probe_stack_depart() == false ||
        kernel_process_scheduler_probe_stack_arrive() == false) {
        return false;
    }
    if (kernel_process_exit_waiter_probe(root_handle) == false) {
        return false;
    }
    // Fork is deliberately checked before the later scheduler tail wraps it
    // out. The ring's job is to retain the most recent causal history, not
    // to promise that an older lifecycle event survives arbitrary switches.
    let mut fork_trace: [usize; KERNEL_CRASH_TRACE_WORDS];
    let fork_trace_count: usize =
        kernel_process_crash_trace_copy(fork_trace as *usize);
    let mut saw_fork: bool = false;
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        if (item < fork_trace_count &&
            fork_trace[
                item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT +
                KERNEL_PROCESS_TRACE_EVENT_WORD] == ProcessTraceFork) {
            saw_fork = true;
        }
    }
    kernel_process_scheduler_enable();
    if (kernel_process_scheduler_probe_stack_depart() == false) {
        return false;
    }
    let parent_sp: usize = kernel_process_probe_tick_address(0x2000);
    if (kernel_process_scheduler_probe_stack_arrive() == false ||
        kernel_process_scheduler_probe_stack_depart() == false) {
        return false;
    }
    let child_sp: usize = kernel_process_probe_tick_address(0x1000);
    if (kernel_process_scheduler_probe_stack_arrive() == false) {
        return false;
    }
    kernel_process_request_reschedule();
    let deferred_frame = frame_ref_from_entry(
        0x2000, kernel_process_entry_generation());
    let deferred_parent_sp: usize = match
            kernel_process_syscall_return_schedule(deferred_frame) {
        FrameSwitch::Stay => { frame_ref_address(deferred_frame) }
        FrameSwitch::Switch(resumed) => { frame_ref_address(resumed) }
    };
    if (kernel_process_scheduler_probe_stack_depart() == false ||
        kernel_process_scheduler_probe_stack_arrive() == false) {
        return false;
    }
    let mut trace: [usize; KERNEL_CRASH_TRACE_WORDS];
    let trace_count: usize = kernel_process_crash_trace_copy(trace as *usize);
    let mut saw_schedule: bool = false;
    let mut saw_resume: bool = false;
    let mut saw_activate: bool = false;
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        if (item < trace_count) {
            let kind: usize = trace[
                item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT +
                KERNEL_PROCESS_TRACE_EVENT_WORD];
            if (kind == ProcessTraceSchedule) { saw_schedule = true; }
            if (kind == ProcessTraceResume) { saw_resume = true; }
            if (kind == ProcessTraceAddressSpaceActivate) { saw_activate = true; }
        }
    }
    let ok: bool = parent_sp == 0x1000 && child_sp == 0x2000 &&
        deferred_parent_sp == 0x1000 &&
        process_test_evidence_timer_switches() == 2 &&
        process_test_evidence_deferred_switches() == 1 &&
        kernel_process_current_pid() == root_pid && saw_fork && saw_schedule &&
        saw_resume && saw_activate;
    let continuation_ok: bool =
        kernel_process_exit_continuation_probe(root_handle);
    kernel_process_scheduler_disable();
    scheduled_process_table_clear();
    // scheduled_process_table_clear above destroyed every pooled record
    // and reset the bootstrap's, so there is nothing left to clear here.
    execution_here().current_live = false;
    kernel_process_trace_disable();
    return ok && continuation_ok;
}

// Reserve a parent carrying a rewound wait4 continuation through the exit
// handoff's ordinary-successor path. After it collects the zombie, a later
// Ready take must still succeed. The fixture never restores its synthetic
// frame, just like the timer and block scheduler probes above.
private fn kernel_process_exit_continuation_probe(parent: ProcessHandle) -> bool {
    // GitHub issue #693 step 6: the parent's links are read under the run
    // guard, released before the stack-depart probe, which takes it itself.
    let link_guard = process_run_lock();
    let has_child: bool =
        scheduled_process_record_of_locked(link_guard, parent).has_first_child;
    let mut child: ProcessHandle =
        scheduled_process_record_of_locked(link_guard, parent).first_child;
    process_run_unlock(link_guard);
    if (has_child == false ||
        kernel_process_scheduler_probe_stack_depart() == false) {
        return false;
    }
    let child_pid: usize = scheduled_process_pid_of_handle(child);
    let guard = process_run_lock();
    match scheduled_process_ready_take(guard, child) {
        ScheduledProcessReadyTakeResult::Missing => {
            process_run_unlock(guard);
            return false;
        }
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            let running = scheduled_process_start(owner, ready);
            let exited = scheduled_process_exit(owner, running);
            scheduled_process_release(owner, exited);
        }
    }
    match scheduled_process_running_take(guard, parent) {
        ScheduledProcessRunningTakeResult::Missing => {
            process_run_unlock(guard);
            return false;
        }
        ScheduledProcessRunningTakeResult::Running(resources) => {
            let (owner, running) = resources;
            let ready = scheduled_process_yield(owner, running);
            // A Ready parent that a child's exit woke on a CPU that could not
            // run it: the continuation the probe wants to observe.
            match process_wait_publish(
                    &scheduled_process_record_of_locked(guard, parent).wait,
                    ProcessWaitReason::ChildExit,
                    scheduled_process_record_of_locked(guard, parent).state) {
                ProcessWaitPublish::Published => {}
                ProcessWaitPublish::Refused => {
                    scheduled_process_release(owner, ready);
                    process_run_unlock(guard);
                    return false;
                }
            }
            process_wait_keep_continuation(
                &scheduled_process_record_of_locked(guard, parent).wait, child_pid);
            scheduled_process_release(owner, ready);
        }
    }
    execution_here().current_handle = child;
    let resumed: usize = match scheduled_process_ready_take(guard, parent) {
        ScheduledProcessReadyTakeResult::Missing => {
            process_run_unlock(guard);
            return false;
        }
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            let running = scheduled_process_start(owner, ready);
            process_run_unlock(guard);
            // The frame address the probe's exit resumed, 0 for none.
            let exited: ExitSwitch = kernel_process_exit_reserved(
                child, parent, owner, running, false, false);
            let address: usize = match exited {
                ExitSwitch::Idle => { 0 }
                ExitSwitch::Resume(frame) => { frame_ref_address(frame) }
            };
            address
        }
    };
    if (resumed != 0x1000 || kernel_process_current_pid() !=
            scheduled_process_pid_of_handle(parent)) {
        return false;
    }
    let status: usize = kernel_process_child_wait_status_pid(child_pid);
    if (status != 0 || kernel_process_current_has_child_pid(child_pid)) { return false; }
    let mut resumed_parent: ProcessHandle = execution_here().current_handle;
    let select_guard = process_run_lock();
    let mut selectable: bool = false;
    match scheduled_process_running_take(select_guard, resumed_parent) {
        ScheduledProcessRunningTakeResult::Missing => {}
        ScheduledProcessRunningTakeResult::Running(resources) => {
            let (owner, running) = resources;
            let ready = scheduled_process_yield(owner, running);
            scheduled_process_release(owner, ready);
            match scheduled_process_ready_take(select_guard, resumed_parent) {
                ScheduledProcessReadyTakeResult::Missing => {}
                ScheduledProcessReadyTakeResult::Ready(taken) => {
                    let (next_owner, next_ready) = taken;
                    let next_running = scheduled_process_start(next_owner, next_ready);
                    scheduled_process_release(next_owner, next_running);
                    selectable = true;
                }
            }
        }
    }
    process_run_unlock(select_guard);
    return selectable;
}

// Between allocation and frame installation, neither a Ready claim nor a
// normal successor walk may expose the child to another CPU. This exercises
// the production selection operations, not just the new state's numeric tag.
private fn kernel_process_clone_unselectable_probe(parent: ProcessHandle) -> bool {
    let guard = process_run_lock();
    let protected: bool = kernel_process_clone_unselectable_locked(guard, parent);
    // Negative control: reproduce the old early-Ready publication under the
    // guard, so no peer can actually restore the intentionally invalid frame.
    scheduled_process_record_of_locked(guard, execution_here().current_handle).state =
        ProcessSlotState::Ready;
    let detected: bool =
        kernel_process_clone_unselectable_locked(guard, parent) == false;
    scheduled_process_record_of_locked(guard, execution_here().current_handle).state =
        ProcessSlotState::Constructing;
    process_run_unlock(guard);
    return protected && detected;
}

private fn kernel_process_clone_unselectable_locked(
        guard: borrow ProcessRunGuard[lock], parent: ProcessHandle) -> bool {
    let mut excluded: bool = true;
    match scheduled_process_ready_take(guard, execution_here().current_handle) {
        ScheduledProcessReadyTakeResult::Missing => {}
        ScheduledProcessReadyTakeResult::Ready(resources) => {
            let (owner, ready) = resources;
            scheduled_process_release(owner, ready);
            excluded = false;
        }
    }
    match kernel_process_next_ready(guard, parent, cpu_id()) {
        ProcessNextReadyResult::Missing => {}
        ProcessNextReadyResult::Next(next) => { excluded = false; }
    }
    return excluded;
}

// Regression for the diagnostic ring itself. This runs only in the boot
// self-test, then resets the process model again, so no artificial event can
// appear in a later production fail-stop trace.
fn kernel_process_crash_trace_ring_probe() -> bool {
    kernel_process_execution_reset();
    kernel_process_trace_enable();
    // The optional boot trace may have recorded this reset's initial resume.
    // This probe owns its synthetic ring contents, so start its wrap proof at
    // sequence one regardless of that external diagnostic policy.
    kernel_process_crash_trace_reset();
    for event: usize in 1..<19 {
        kernel_process_trace_record(event, event + 100, event + 1000,
                                    event + 200, event + 2000, 3, 2,
                                    7, event + 300, event + 400);
    }
    let mut copied: [usize; KERNEL_CRASH_TRACE_WORDS];
    let count: usize = kernel_process_crash_trace_copy(copied as *usize);
    let mut ok: bool = count == KERNEL_CRASH_TRACE_EVENTS;
    for item: usize in 0..<KERNEL_CRASH_TRACE_EVENTS {
        let base: usize = item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
        let expected: usize = item + 3;
        if (copied[base] != expected ||
            copied[base + 1] != 0 ||
            copied[base + 2] != expected ||
            copied[base + 3] != expected + 100 ||
            copied[base + 4] != expected + 1000 ||
            copied[base + 5] != expected + 200 ||
            copied[base + 6] != expected + 2000 ||
            copied[base + 7] != 3 || copied[base + 8] != 2 ||
            copied[base + 9] != 7 || copied[base + 10] != expected + 300 ||
            copied[base + 11] != expected + 400) {
            ok = false;
        }
    }
    kernel_process_execution_reset();
    kernel_process_trace_disable();
    return ok;
}

// The pinned Alpine BusyBox HTTPd uses clone(SIGCHLD, NULL, NULL, tls,
// child_tid), i.e. fork semantics. The unused pointers carry no ownership
// without their corresponding clone flags, so this first process-control
// boundary accepts only the observed flag and null child stack.
//
// GitHub issue #245: any live process may clone, not just "the" one
// designated Parent -- the only real precondition is that current does
// not already have a live child of its own (the same single-child-per-
// parent invariant the old model enforced globally, now checked against
// current's own slot). The new child's pid (minted by
// scheduled_process_alloc, not derived from its slot) is
// returned directly instead of the literal 2, so a process running on
// any slot gets a correct child pid back, not just the original root.
fn kernel_process_clone_begin(flags: usize, child_stack: usize)
        -> ProcessCloneResult {
    // GitHub issue #245 bug fix: this used to also check a GLOBAL
    // execution_child_live flag, leftover from the old model where it
    // correctly meant "the one single child is still alive". Once any
    // slot can independently fork, that flag stays true for the entire
    // lifetime of an OUTER ancestor's own child (e.g. ash's fork of
    // /bin/user_payload) regardless of what an INNER descendant does, so it
    // wrongly rejected a real, unrelated clone deeper in the tree (found
    // on real RPi5 hardware: user_payload's own fork always failed with
    // -EINVAL while running as ash's forked+exec'd child). The per-slot
    // ProcessRecord.has_first_child[current] check below is the correct,
    // already-scoped-to-current-only replacement.
    // GitHub issue #437: no child-count refusal at all any more.
    //
    // This refused a second child, then briefly a second LIVE child while
    // zombies arrived. Both were the same ceiling: a parent could not have
    // two things running, which is what `/etc/inittab` with two `respawn`
    // entries asks for and what any multicore workload needs. The page
    // allocator is the only limit now, the same answer #392 gave the
    // process table itself.
    if (flags != 0x11 || child_stack != 0 ||
        execution_here().current_live == false) {
        return ProcessCloneResult::Invalid;
    }
    let mut parent: ProcessHandle = execution_here().current_handle;
    // Not runnable yet: the copied frame, VM and descriptors are installed
    // below, and kernel_syscall_clone_child_return publishes Ready.
    match scheduled_process_alloc_pending(false) {
        ScheduledPooledProcessAllocResult::Full => {
            return ProcessCloneResult::ResourceExhausted;
        }
        ScheduledPooledProcessAllocResult::Allocated(pooled) => {
            let mut child: ProcessHandle =
                scheduled_pooled_process_handle(pooled);
            // GitHub issue #693 steps 2/4: the parent is the process running
            // here, and the child is not visible to anyone else until the
            // publish below, so this path owns it.
            let ProcessRunningHere::Running(parent_running) =
                process_running_here() else {};
            let child_owner =
                scheduled_process_owner_new(child.pool_index, child.generation);
            scheduled_process_copy_command_line(parent_running, child_owner);
            scheduled_process_copy_signal_mask(parent_running, child_owner);
            scheduled_process_copy_affinity_mask(parent_running, child_owner);
            scheduled_process_owner_drop(child_owner);
            process_running_end(parent_running);
            // GitHub issue #437: push at the HEAD of the sibling list.
            // O(1), and with one child it leaves first_child naming that
            // child and no sibling -- the shape every existing view was
            // recorded against, which is why the enumeration change and
            // this one could be verified separately.
            let publish_guard = process_run_lock();
            scheduled_process_record_of_locked(publish_guard, child).session_id =
                scheduled_process_record_of_locked(publish_guard, parent).session_id;
            scheduled_process_record_of_locked(publish_guard, child).next_sibling =
                scheduled_process_record_of_locked(publish_guard, parent).first_child;
            scheduled_process_record_of_locked(publish_guard, child).has_next_sibling =
                scheduled_process_record_of_locked(publish_guard, parent).has_first_child;
            scheduled_process_record_of_locked(publish_guard, parent).first_child = child;
            scheduled_process_record_of_locked(publish_guard, parent).has_first_child = true;
            scheduled_process_record_of_locked(publish_guard, child).parent = parent;
            scheduled_process_record_of_locked(publish_guard, child).has_parent = true;
            // "current" becomes the CHILD right here, before this function
            // returns ChildConstructing -- the assembly clone continuation resumes
            // as the child directly (x0=0), so there is no separate
            // parent-side return path to switch on later. A caller reading
            // kernel_process_current_pid()/kernel_process_current_root() etc.
            // immediately after matching ChildConstructing therefore observes the
            // CHILD's identity, not the parent's; asking "did the parent do
            // this fork" needs kernel_process_parent_is_root() (which asks
            // about *current's own* parent) or the caller's own pre-call
            // snapshot of parent, not a comparison against current's pid
            // taken after this call. This surprised a real caller once
            // (issue #289's fork checkpoint originally gated on
            // `kernel_process_current_pid() != 1`, which is always true here
            // regardless of who forked).
            execution_here().current_handle = child;
            // GitHub issue #611: clones run on any CPU now, so the count
            // moves under the lock that orders them.
            process_test_evidence_record_clone();
            let child_saved_sp: usize =
                scheduled_process_record_of_locked(publish_guard, child).saved_sp;
            process_run_unlock(publish_guard);
            workload_busy_note_selected(
                scheduled_process_pid_of_handle(child));
            workload_clone_note(scheduled_process_pid_of_handle(parent));
            kernel_process_trace_record(
                ProcessTraceFork, scheduled_process_pid_of_handle(child),
                child.generation,
                scheduled_process_pid_of_handle(parent), parent.generation,
                5, 0, child.pool_index, child_saved_sp, flags);
            return ProcessCloneResult::ChildConstructing(
                scheduled_process_pid_of_handle(child));
        }
    }
}

fn kernel_process_clone_child_stack_top() -> usize {
    if (execution_here().current_live) {
        return scheduled_process_stack_top(execution_here().current_handle);
    }
    return 0;
}

// GitHub issue #245: undoes kernel_process_clone_begin() when a later
// step in the same clone() syscall (VM copy, fd-table clone) fails.
// The child never ran: cancellation consumes its Constructing token directly
// into Exited, without ever publishing an executable Ready/Running context.
must_use variant ProcessCloneRollbackResult { Invalid; Restored; }

fn kernel_process_clone_rollback() -> ProcessCloneRollbackResult {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) {
        { let mut __running_result: ProcessCloneRollbackResult = ProcessCloneRollbackResult::Invalid; process_running_end(running_here); return __running_result; }
    }
    if (scheduled_process_record_running(running_here)
            .has_parent == false) {
        { let mut __running_result: ProcessCloneRollbackResult = ProcessCloneRollbackResult::Invalid; process_running_end(running_here); return __running_result; }
    }
    let mut child: ProcessHandle = execution_here().current_handle;
    let mut parent: ProcessHandle =
        scheduled_process_record_running(running_here).parent;
    let guard = process_run_lock();
    // Only this still-Running parent can insert or reap its children during
    // the non-preemptible clone syscall. Validate the head before mutating
    // anything; a stale or invalid rollback must not sever another chain.
    if (scheduled_process_handle_matches(parent) == false ||
        scheduled_process_state_of(parent) != ProcessSlotState::Running ||
        scheduled_process_record_of_locked(guard, parent).has_first_child == false ||
        scheduled_process_same_slot(
            scheduled_process_record_of_locked(guard, parent).first_child, child) == false) {
        process_run_unlock(guard);
        { let mut __running_result: ProcessCloneRollbackResult = ProcessCloneRollbackResult::Invalid; process_running_end(running_here); return __running_result; }
    }
    match scheduled_process_constructing_take(guard, child) {
        ScheduledProcessConstructingTakeResult::Missing => {
            process_run_unlock(guard);
            { let mut __running_result: ProcessCloneRollbackResult = ProcessCloneRollbackResult::Invalid; process_running_end(running_here); return __running_result; }
        }
        ScheduledProcessConstructingTakeResult::Constructing(resources) => {
            let (owner, constructing) = resources;
            // Read the successor before returning the child record to its
            // pool. Clearing has_first_child unconditionally loses every
            // older sibling, including live children and waitable zombies.
            let has_following: bool =
                scheduled_process_record_of_locked(guard, child).has_next_sibling;
            if (has_following) {
                scheduled_process_record_of_locked(guard, parent).first_child =
                    scheduled_process_record_of_locked(guard, child).next_sibling;
            }
            scheduled_process_record_of_locked(guard, parent).has_first_child = has_following;
            scheduled_process_record_of_locked(guard, child).has_parent = false;
            scheduled_process_record_of_locked(guard, child).has_next_sibling = false;
            // We still run on the parent's syscall stack. Restore logical
            // current before releasing any of the failed child's resources.
            execution_here().current_handle = parent;
            let exited = scheduled_process_cancel_clone(owner, constructing);
            scheduled_process_release(owner, exited);
            match scheduled_process_exited_take(guard, child) {
                ScheduledProcessExitedTakeResult::Missing => {}
                ScheduledProcessExitedTakeResult::Exited(done) => {
                    let (exited_owner, exited_state) = done;
                    scheduled_process_reap(guard, exited_owner, exited_state);
                    parent = execution_here().current_handle;
                }
            }
        }
    }
    process_test_evidence_release_clone();
    process_run_unlock(guard);
    workload_busy_note_selected(
        scheduled_process_pid_of_handle(parent));
    let activation: CurrentRootActivationResult =
        kernel_process_activate_current_root();
    match activation {
        CurrentRootActivationResult::Invalid => {
            { let mut __running_result: ProcessCloneRollbackResult = ProcessCloneRollbackResult::Invalid; process_running_end(running_here); return __running_result; }
        }
        CurrentRootActivationResult::Activated => {
            { let mut __running_result: ProcessCloneRollbackResult = ProcessCloneRollbackResult::Restored; process_running_end(running_here); return __running_result; }
        }
    }
}

// GitHub issue #245: execution_here().current_handle already names the child
// (kernel_process_clone_begin() switches to it immediately), so the
// parent is recovered via that child's own parent link rather than a
// separate global execution_parent_handle.
must_use variant CloneInstall { Failed; Installed; }

fn kernel_process_clone_context_install(
        parent: borrow FrameRef[parent_process],
        child: borrow FrameRef[child_process]) -> CloneInstall {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false ||
        frame_ref_address(parent) == 0 || frame_ref_address(child) == 0) {
        { let mut __running_result: CloneInstall = CloneInstall::Failed; process_running_end(running_here); return __running_result; }
    }
    if (scheduled_process_record_running(running_here)
            .has_parent == false) { { let mut __running_result: CloneInstall = CloneInstall::Failed; process_running_end(running_here); return __running_result; } }
    let mut child_handle: ProcessHandle = execution_here().current_handle;
    let mut parent_handle: ProcessHandle =
        scheduled_process_record_running(running_here).parent;
    // The copied child frame becomes Running in the same section that
    // publishes the parent's frame and makes that parent Ready.
    let guard = process_run_lock();
    match scheduled_process_constructing_take(guard, child_handle) {
        ScheduledProcessConstructingTakeResult::Missing => {
            process_run_unlock(guard);
            { let mut __running_result: CloneInstall = CloneInstall::Failed; process_running_end(running_here); return __running_result; }
        }
        ScheduledProcessConstructingTakeResult::Constructing(resources) => {
            let (owner, constructing) = resources;
            // Publish the parent's saved frame before Ready permits a peer
            // to restore it. The child's VM and FD setup already succeeded.
            scheduled_process_record_of_locked(guard, parent_handle).saved_sp =
                frame_ref_address(parent);
            if (kernel_process_yield_handle(guard, parent_handle) == false) {
                scheduled_process_release(owner, constructing);
                process_run_unlock(guard);
                { let mut __running_result: CloneInstall = CloneInstall::Failed; process_running_end(running_here); return __running_result; }
            }
            let running = scheduled_process_finish_clone(
                owner, constructing, child);
            scheduled_process_release(owner, running);
            process_run_unlock(guard);
            { let mut __running_result: CloneInstall = CloneInstall::Installed; process_running_end(running_here); return __running_result; }
        }
    }
}

fn kernel_process_is_child() -> bool {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) { { let mut __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    { let mut __running_result: bool = scheduled_process_record_running(running_here)
        .has_parent; process_running_end(running_here); return __running_result; }
}

// Whether the current process is a direct child of BusyBox init.
fn kernel_process_parent_is_root() -> bool {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) { { let mut __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    if (scheduled_process_record_running(running_here)
            .has_parent == false) { { let mut __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    let mut parent: ProcessHandle =
        scheduled_process_record_running(running_here).parent;
    { let mut __running_result: bool = parent.pool_index == 0; process_running_end(running_here); return __running_result; }
}

// The current process's parent pid, sampled under ProcessRunGuard when the
// caller compares two fixture children. Unlike parent_is_root(), this keeps
// a process created by an interactive shell tied to that exact shell.
fn kernel_process_current_parent_pid(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) -> usize {
    if (execution_here().current_live == false) { return 0; }
    let mut current: ProcessHandle = execution_here().current_handle;
    let record: *ProcessRecord = scheduled_process_record_of_locked(guard, current);
    if (record.has_parent == false) { return 0; }
    let mut parent: ProcessHandle = record.parent;
    if (scheduled_process_handle_matches(parent) == false) { return 0; }
    return scheduled_process_pid_of_handle(parent);
}

fn kernel_process_current_pid() -> usize {
    if (execution_here().current_live) {
        return scheduled_process_pid_of_handle(execution_here().current_handle);
    }
    return 1;
}

must_use variant ProcessSessionResult {
    Id(usize);
    Missing;
    Leader;
}

// Copy or change session membership under the run lock, including lookup:
// another CPU may otherwise reap a target while getsid reads its record.
fn kernel_process_session_get(pid: usize) -> ProcessSessionResult {
    let guard = process_run_lock();
    let mut selected: usize = pid;
    if (selected == 0) { selected = kernel_process_current_pid(); }
    match scheduled_process_slot_for_pid(selected) {
        ProcessSlotForPidResult::Missing => {
            process_run_unlock(guard);
            return ProcessSessionResult::Missing;
        }
        ProcessSlotForPidResult::Found(slot) => {
            let id: usize = scheduled_process_record_locked(guard, slot).session_id;
            process_run_unlock(guard);
            return ProcessSessionResult::Id(id);
        }
    }
}

fn kernel_process_session_create() -> ProcessSessionResult {
    let guard = process_run_lock();
    if (execution_here().current_live == false) {
        process_run_unlock(guard);
        return ProcessSessionResult::Missing;
    }
    let mut current: ProcessHandle = execution_here().current_handle;
    let record: *ProcessRecord = scheduled_process_record_of_locked(guard, current);
    if (record.session_id == record.pid) {
        process_run_unlock(guard);
        return ProcessSessionResult::Leader;
    }
    let id: usize = record.pid;
    record.session_id = id;
    process_run_unlock(guard);
    return ProcessSessionResult::Id(id);
}

// The caller holds ProcessRunGuard when it uses this snapshot to make a
// cross-core placement decision or publish placement evidence.
fn kernel_process_current_affinity_mask(
        guard: borrow ProcessRunGuard[scheduled_process_run_lock]) -> usize {
    if (execution_here().current_live == false) { return 0; }
    return scheduled_process_affinity_mask(guard,
        execution_here().current_handle.pool_index);
}

// DDB attributes an exception to the process whose physical stack holds its
// saved frame. IRQ entry may already have released that stack for migration,
// and logical current may then name the incoming process. The retained
// stack_handle plus the frame range remain the independent authority. An
// architectural idle-stack frame matches no process and reports zero.
fn kernel_process_frame_pid_or_zero(frame: borrow FrameRef[process])
        -> usize {
    let mut physical: ProcessHandle = execution_here().stack_handle;
    if (scheduled_process_handle_matches(physical) &&
        kernel_process_frame_belongs_to(physical, frame)) {
        return scheduled_process_pid_of_handle(physical);
    }
    return 0;
}

// GitHub issue #302: replaces kernel/kernel/syscall.tkb's own
// syscall_block_reason/syscall_wait4_status_ptr module globals, which used
// to relay a syscall handler's block decision across the one-way
// .Lsyscall_block asm tail branch into kernel_syscall_block_return(). That
// relay was a single slot shared by whichever process happened to block
// next, not owned by the process it actually describes -- concretely wrong
// for wait4_status_ptr the moment two different parents are each blocked in
// wait4() at once (a later parent's block would overwrite an earlier
// parent's still-pending status pointer). Writing straight into the
// blocking process's own ProcessRecord keeps the pending decision scoped to
// the process making it, still read back synchronously by
// kernel_syscall_block_return() before any scheduler switch happens.
fn kernel_process_current_set_pending_block(
        reason: ProcessWaitReason, wait4_status_ptr: usize) {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here)
            .pending_block_reason = reason;
        scheduled_process_record_running(running_here)
            .wait4_status_ptr = wait4_status_ptr;
    }
    process_running_end(running_here);
}

fn kernel_process_current_pending_block_reason() -> ProcessWaitReason {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        { let mut __running_result: ProcessWaitReason = scheduled_process_record_running(running_here)
            .pending_block_reason; process_running_end(running_here); return __running_result; }
    }
    { let mut __running_result: ProcessWaitReason = ProcessWaitReason::None; process_running_end(running_here); return __running_result; }
}

// Allocation-free diagnostic view for the terminal exception path.  These
// values are intentionally scalar rather than exposing ProcessRecord itself:
// a crash report observes scheduler state but must not acquire its linear
// owners or locks after a fatal exception.
fn kernel_process_crash_parent_pid() -> usize {
    if (execution_here().current_live == false) { return 0; }
    let slot: usize = execution_here().current_handle.pool_index;
    if (scheduled_process_record_peek(slot).has_parent == false) { return 0; }
    return scheduled_process_pid_of_handle(
        scheduled_process_record_peek(slot).parent);
}

fn kernel_process_crash_state() -> usize !{unsafe} {
    if (execution_here().current_live == false) { return 0; }
    let state: ProcessSlotState = scheduled_process_peek_state(
        execution_here().current_handle.pool_index);
    match state {
        ProcessSlotState::Free => { return 0; }
        ProcessSlotState::Ready => { return 1; }
        ProcessSlotState::Running => { return 2; }
        ProcessSlotState::Blocked => { return 3; }
        ProcessSlotState::Exited => { return 4; }
        ProcessSlotState::Constructing => { return 5; }
    }
}

fn kernel_process_crash_wait_reason() -> usize !{unsafe} {
    if (execution_here().current_live == false) { return 0; }
    let reason: ProcessWaitReason = scheduled_process_peek_wait_reason(
        execution_here().current_handle.pool_index);
    match reason {
        ProcessWaitReason::None => { return 0; }
        ProcessWaitReason::UartRx => { return 1; }
        ProcessWaitReason::ChildExit => { return 2; }
        ProcessWaitReason::NetRx => { return 3; }
        ProcessWaitReason::Deadline => { return 4; }
        ProcessWaitReason::Signal => { return 5; }
        ProcessWaitReason::UartTx => { return 6; }
    }
}

// Issue #294: syscall continuation, alongside wait_reason above -- #302
// moved wait4()'s status pointer into this same ProcessRecord field, so
// a diagnostic snapshot naming the wait reason without this leaves half
// of a blocked wait4()'s continuation state invisible.
fn kernel_process_crash_wait4_status_ptr() -> usize {
    if (execution_here().current_live == false) { return 0; }
    return scheduled_process_record_wait4_status_ptr(
        execution_here().current_handle.pool_index);
}

fn kernel_process_crash_root_slot() -> usize {
    if (execution_here().current_live == false) { return 0; }
    return execution_here().current_handle.pool_index;
}

fn kernel_process_crash_image_kind() -> usize {
    if (execution_here().current_live == false) { return 0; }
    let slot: usize = execution_here().current_handle.pool_index;
    if (scheduled_process_record_peek(slot).exec_image_live) { return 1; }
    return 0;
}

// GitHub issue #245: callers that need to (re)activate the current
// process's own address-space root explicitly -- e.g. right after a fresh
// clone, before process_image_activate_root() replaces the old fixed
// process_image_activate_child() -- read it here rather than reaching
// into execution_here().current_handle directly.
fn kernel_process_current_root() -> AddressSpaceRoot !{unsafe} {
    if (execution_here().current_live) {
        match process_running_here() {
            ProcessRunningHere::Running(running) => {
                let mut root: AddressSpaceRoot =
                    scheduled_process_address_space_root_running(running);
                process_running_end(running);
                return root;
            }
        }
    }
    return address_space_boot_root();
}

// Finish an exit handoff after the successor has been reserved as Running.
// The reservation keeps another CPU from selecting the same process while
// ASID preparation runs without ProcessRunGuard. An exit cannot retry on a
// later tick, so every preparation failure cancels the reservation and
// returns 0 to the existing syscall fail-stop path.
// Keep ChildExit on the Ready parent as its pending wait4 continuation.
// Rewind the saved frame so a CPU that admits the parent runs ordinary
// synchronous wait4 after activating the parent's root; that path can
// validate user memory without making timer IRQ scheduling allocate.
private fn kernel_process_leave_parent_ready(
        parent: ProcessHandle,
        parent_owner: sink ScheduledProcessOwner[process],
        ready: sink ScheduledProcessState[process, ProcessState::Ready]) {
    let parked = scheduled_process_saved_frame(parent_owner);
    el0_context_retry_syscall(parked);
    scheduled_process_release(parent_owner, ready);
}

// What an exit came to: the frame of the process to resume in its place, or
// `Idle` when nothing was admitted and this CPU leaves for its idle loop. At
// the assembly boundary (SyscallAction::CloneParent) this is encoded as a
// frame address, 0 for Idle, by kernel_syscall_clone_parent_action.
must_use variant ExitSwitch {
    Idle;
    Resume(exists process: usize. FrameRef[process]);
}

private fn kernel_process_exit_reserved(
        child: ProcessHandle,
        parent: ProcessHandle,
        owner: sink ScheduledProcessOwner[process],
        running: sink ScheduledProcessState[process, ProcessState::Running],
        deliver_wait4: bool, auto_reap: bool) -> ExitSwitch {
    match process_image_prepare_activation(owner.pool_index) {
        AddressSpaceActivationPrepareResult::Invalid => {
            kernel_process_schedule_cancel_reserved(owner, running);
            return ExitSwitch::Idle;
        }
        AddressSpaceActivationPrepareResult::RolloverNeeded => {
            match world_stop_begin(&kernel_world_stop, kernel_online_core_count(),
                                   SCHEDULER_WORLD_STOP_SPINS) {
                WorldStopResult::Busy => {
                    kernel_process_schedule_cancel_reserved(owner, running);
                    return ExitSwitch::Idle;
                }
                WorldStopResult::Partial(partial) => {
                    world_stop_partial_release(partial, &kernel_world_stop);
                    kernel_process_schedule_cancel_reserved(owner, running);
                    return ExitSwitch::Idle;
                }
                WorldStopResult::Complete(stopped) => {
                    if (asid_rollover_stopped(stopped)) {}
                    world_stop_release(stopped, &kernel_world_stop);
                    return kernel_process_exit_reserved(
                        child, parent, owner, running, deliver_wait4,
                        auto_reap);
                }
            }
        }
        AddressSpaceActivationPrepareResult::Prepared(prepared) => {
            let guard = process_run_lock();
            let mut successor: ProcessHandle = {
                owner.pool_index, owner.generation
            };
            let mut current_matches: bool = false;
            if (execution_here().current_live) {
                current_matches = scheduled_process_same_slot(
                    execution_here().current_handle, child);
            }
            if (current_matches == false ||
                scheduled_process_handle_matches(child) == false ||
                scheduled_process_state_of(child) != ProcessSlotState::Exited ||
                scheduled_process_handle_matches(successor) == false ||
                scheduled_process_state_of(successor) !=
                    ProcessSlotState::Running) {
                process_image_cancel_activation(prepared);
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return ExitSwitch::Idle;
            }
            if (process_image_commit_activation(prepared) == false) {
                let ready = scheduled_process_yield(owner, running);
                scheduled_process_release(owner, ready);
                process_run_unlock(guard);
                return ExitSwitch::Idle;
            }
            execution_here().current_handle = successor;
            // Every incoming wait4 continuation now runs with its parent's
            // root active. Consume the Ready marker even when an unrelated
            // child's exit selected this successor rather than waking it.
            // Otherwise its completed wait4 can reap the named zombie, then
            // a later migration leaves it Ready with no child to satisfy
            // scheduled_process_ready_take's continuation check.
            if (scheduled_process_wait_reason_of(successor) ==
                    ProcessWaitReason::ChildExit) {
                scheduled_process_wait_settle(scheduled_process_record_of_locked(guard, successor));
            }
            let successor_frame = scheduled_process_saved_frame(owner);
            if (deliver_wait4 || auto_reap) {
                if (execution_here().deferred_reap_live) {
                    process_run_unlock(guard);
                    kernel_syscall_fail_stop(frame_ref_address(successor_frame));
                }
                execution_here().deferred_reap_handle = child;
                execution_here().deferred_reap_parent = parent;
                execution_here().deferred_reap_live = true;
            }
            // GitHub issue #633: the pid of THIS exiting child, from its own
            // handle. The parent's last_child_pid was written by every
            // child's exit, outside this lock, from whichever CPU it ran
            // on, so a sibling exiting meanwhile would have had the parent's
            // wait4 report the sibling and the reap collect this child.
            let reaped_pid: usize = scheduled_process_pid_of_handle(child);
            process_run_unlock(guard);
            workload_busy_note_selected(
                scheduled_process_pid_of_handle(successor));
            kernel_process_trace_handle(
                ProcessTraceResume, successor, child, 0);
            // The owner and its Running token are held across the delivery,
            // which is what lets it name the parent whose frame it writes.
            // Releasing them is a drop with no run-time effect, so it moved
            // here from before the unlock.
            if (deliver_wait4) {
                kernel_syscall_wait4_deliver(
                    owner, successor_frame, reaped_pid);
            }
            scheduled_process_release(owner, running);
            return ExitSwitch::Resume(successor_frame);
        }
    }
}

fn kernel_process_child_exit(status: usize) -> ExitSwitch {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    process_test_evidence_record_child_exit(status);
    // GitHub issue #209: a child exit used to close the scheduling gate
    // here (kernel_process_scheduler_disable()), a leftover of the
    // two-process model where "a child exited" really did mean "nothing
    // is left to switch between." Under PID 1 running many children over
    // one boot that is simply false, and because the gate could only ever
    // close, the FIRST child to exit (init.sh's `/bin/cat`) permanently
    // disabled preemption for every process started afterwards. Observed
    // exactly that way: a later fixture's child woke from UART RX (its
    // ISR logged the byte) and was then never selected again, because no
    // timer switch could happen at all, while its parent spun forever.
    //
    // Nothing takes its place: an exiting child is moved out of the
    // selectable states below, which is what actually keeps the scheduler
    // off a dying context. Leaving preemption on is also the prerequisite
    // for genuinely concurrent children (a shell backgrounding a job with
    // `&`), where a child exit must not stop the survivors from running.
    if (execution_here().current_live == false) { { let mut __running_result: ExitSwitch = ExitSwitch::Idle; process_running_end(running_here); return __running_result; } }
    if (scheduled_process_record_running(running_here)
            .has_parent == false) { { let mut __running_result: ExitSwitch = ExitSwitch::Idle; process_running_end(running_here); return __running_result; } }
    let current = current_process_new(
        execution_here().current_handle.generation);
    let mut child: ProcessHandle = current_process_handle(current);
    let mut parent: ProcessHandle =
        scheduled_process_record_running(running_here).parent;
    kernel_process_trace_record(
        ProcessTraceExit, scheduled_process_pid_of_handle(child),
        child.generation,
        scheduled_process_pid_of_handle(parent), parent.generation, 2, 0,
        child.pool_index,
        scheduled_process_record_running(running_here).saved_sp, status);
    // GitHub issue #248: per-slot (indexed by the WAITING PARENT's own
    // pool_index), not a bare global -- see these fields' own header
    // comment for why a global here breaks a multi-level concurrent
    // wait4() chain.
    // GitHub issue #437: the child becomes a ZOMBIE here rather than being
    // reaped here.
    //
    // The status used to be copied onto the PARENT because the child's
    // record was given back in this very function, leaving nowhere else
    // for it to live. That is also why the parent could only remember one:
    // a second exiting child would overwrite the first. Making those
    // fields plural would have meant a per-parent queue with a capacity,
    // in a kernel that has spent #391/#393/#402/#392 removing every
    // hand-picked one.
    //
    // So the record survives instead, holding its own status, and wait4
    // reaps it. The type system already had the shape for this: reap()
    // consumes a linear ScheduledProcessState[Exited], and the only way to
    // obtain one is scheduled_process_exited_take() on a record whose
    // state IS Exited. Moving the take from here to the wait path turns
    // the zombie window from an instant into a state the checker can see
    // -- reaping something still Running has no token to pass, and reaping
    // twice cannot re-mint one.
    // GitHub issue #437: reap this process's OWN zombies before it becomes
    // one. Nobody can wait for them any more -- their only waiter is the
    // process exiting on this line -- so leaving them costs a pool record
    // and a page run each, for good. The end-of-boot accounting is what
    // says so: without this, "pooled per-process records back to the
    // baseline" becomes "POOLED RECORDS LEAKED process=2/0".
    //
    // Linux re-parents to init instead, which is the better answer once
    // there is something to re-parent that is still RUNNING. A zombie has
    // nothing left to run and only a status nobody asked for.
    // A grandchild that exited on another CPU which has not yet left its
    // stack is skipped here (#609: kernel_process_first_zombie_of does not
    // name it), and nobody waits for it afterwards. The window is a peer
    // exit landing within microseconds of its parent's own exit; the
    // bounded suite's teardown sweep would still collect it, but a
    // long-running kernel would keep the record.
    let mut draining: usize = scheduled_process_pool_live_count() + 1;
    while (draining != 0) {
        draining = draining - 1;
        let drain_guard = process_run_lock();
        let next_zombie = kernel_process_first_zombie_of(drain_guard, child);
        process_run_unlock(drain_guard);
        match next_zombie {
            ProcessNextReadyResult::Missing => { draining = 0; }
            ProcessNextReadyResult::Next(grandchild) => {
                let orphan_status: usize =
                    kernel_process_reap_zombie(child, grandchild);
            }
        }
    }
    parent = scheduled_process_record_running(running_here).parent;
    scheduled_process_record_running(running_here).exit_status = status;
    // GitHub issue #653: this CPU's own record of the child it is exiting,
    // for kernel_process_child_exec_reap right after. It used to be written
    // to the PARENT's record, where a sibling's exit on another CPU could
    // overwrite it; the pid a blocked parent's wait4 is given comes from the
    // exiting child's handle below, and a parent left pending names its
    // waker in its own wait cell.
    execution_here().last_exited_child_pid =
        scheduled_process_pid_of_handle(child);
    // GitHub issue #479 Group B: exit, parent wake, and successor reservation
    // are one decision under ProcessRunGuard. The reserved Running owner/state
    // then crosses the unlocked ASID preparation interval. wait4 delivery is
    // deliberately later, after activation commits and the guard is released,
    // because it writes user memory and may fault into the scheduler.
    let exit_guard = process_run_lock();
    // GitHub issue #693 step 3: the parent's disposition is read under the
    // run lock, which is what keeps the parent from being reaped under it.
    let auto_reap: bool =
        scheduled_process_record_of_locked(exit_guard, parent).sigchld_ignored;
    // Signal state and a possible blocked-to-ready transition are part of
    // the same exit scheduling decision. In particular, a peer scheduler
    // must not observe the parent wake before this CPU has stopped exposing
    // the child as Running.
    kernel_process_signal_child_exit(exit_guard, parent);
    match scheduled_process_running_take(exit_guard, child) {
        ScheduledProcessRunningTakeResult::Missing => {
            current_process_exit(current);
            process_run_unlock(exit_guard);
            { let mut __running_result: ExitSwitch = ExitSwitch::Idle; process_running_end(running_here); return __running_result; }
        }
        ScheduledProcessRunningTakeResult::Running(resources) => {
            let (owner, running) = resources;
            current_process_exit(current);
            let exited = scheduled_process_exit(owner, running);
            scheduled_process_release(owner, exited);
            // GitHub issue #244: a parent blocked in wait4 needs both the
            // wake transition and completion of its saved syscall frame.
            if (scheduled_process_state_of(parent) ==
                    ProcessSlotState::Blocked &&
                scheduled_process_wait_reason_of(parent) ==
                    ProcessWaitReason::ChildExit) {
                match scheduled_process_blocked_take(exit_guard, parent) {
                    ScheduledProcessBlockedTakeResult::Missing => {}
                    ScheduledProcessBlockedTakeResult::Blocked(parent_resources) => {
                        let (parent_owner, blocked) = parent_resources;
                        // The wait stays pending, naming this child, unless the
                        // direct start below clears it.
                        let ready = scheduled_process_wake_keeping_wait4(
                            parent_owner, blocked,
                            scheduled_process_pid_of_handle(child));
                        kernel_process_trace_handle(
                            ProcessTraceWake, parent, child, status);
                        // A parent this CPU may not run is left Ready with
                        // its wait4 rewound (below) and reruns it wherever
                        // its mask lets it -- a peer included since #609, so
                        // it is no longer pinned to core 0 for the call.
                        // So is a parent whose own CPU still stands on its
                        // stack: a wait4 that blocked on a peer publishes
                        // Blocked before that peer leaves the stack
                        // (kernel_process_stack_idle_blocked), and starting
                        // it here ran it on a stack two CPUs used at once.
                        if (kernel_process_cpu_allows_slot(exit_guard, 
                                cpu_id(), parent.pool_index)) {
                            match scheduled_process_start_check(
                                    exit_guard, parent_owner, ready) {
                                ScheduledProcessStartCheck::Startable(startable) => {
                                    scheduled_process_wait_settle(
                                        scheduled_process_record_owned(
                                            parent_owner));
                                    let parent_running =
                                        scheduled_process_start(
                                            parent_owner, startable);
                                    process_run_unlock(exit_guard);
                                    { let mut __running_result: ExitSwitch = kernel_process_exit_reserved(
                                        child, parent, parent_owner,
                                        parent_running, true, false); process_running_end(running_here); return __running_result; }
                                }
                                ScheduledProcessStartCheck::Standing(standing) => {
                                    kernel_process_leave_parent_ready(
                                        parent, parent_owner, standing);
                                }
                            }
                        } else {
                            kernel_process_leave_parent_ready(
                                parent, parent_owner, ready);
                        }
                    }
                }
            }
            if (kernel_process_cpu_allows_slot(exit_guard, 
                    cpu_id(), parent.pool_index)) {
            match scheduled_process_ready_take(exit_guard, parent) {
                ScheduledProcessReadyTakeResult::Missing => {}
                ScheduledProcessReadyTakeResult::Ready(parent_resources) => {
                    let (parent_owner, parent_ready) = parent_resources;
                    let parent_running =
                        scheduled_process_start(parent_owner, parent_ready);
                    process_run_unlock(exit_guard);
                    { let mut __running_result: ExitSwitch = kernel_process_exit_reserved(
                        child, parent, parent_owner, parent_running, false,
                        auto_reap); process_running_end(running_here); return __running_result; }
                }
            }
            }
            // GitHub issue #448: a background child's parent may be blocked
            // elsewhere. Reserve the scheduler's next Ready process instead.
            match kernel_process_next_ready(exit_guard, child, cpu_id()) {
                ProcessNextReadyResult::Missing => {}
                ProcessNextReadyResult::Next(successor) => {
                    match scheduled_process_ready_take(exit_guard, successor) {
                        ScheduledProcessReadyTakeResult::Missing => {}
                        ScheduledProcessReadyTakeResult::Ready(successor_resources) => {
                            let (successor_owner, successor_ready) =
                                successor_resources;
                            let successor_running = scheduled_process_start(
                                successor_owner, successor_ready);
                            process_run_unlock(exit_guard);
                            { let mut __running_result: ExitSwitch = kernel_process_exit_reserved(
                                child, parent, successor_owner,
                                successor_running, false, auto_reap); process_running_end(running_here); return __running_result; }
                        }
                    }
                }
            }
        }
    }
    // No admitted successor remains. The CPU publishes itself as having no
    // current EL0 context; the syscall tail switches off this zombie's stack
    // -- to a secondary's architectural stack, or to core 0's idle stack
    // (GitHub issue #592) -- before the idle loop releases it.
    //
    // Core 0 used to wait HERE instead, still on the zombie's stack, for a
    // successor to appear (kernel_process_exit_await_successor). That
    // deadlocked once a parent could be Ready with a pending wait4
    // continuation: scheduled_process_ready_take will not start such a
    // parent while its child's stack is owned, and core 0 owned it while
    // waiting for that parent. The QEMU lane stalled in ash's script tests,
    // exiting child on core 0, ash Ready with wait=ChildExit.
    if (auto_reap) {
        if (execution_here().deferred_reap_live) {
            process_run_unlock(exit_guard);
            kernel_syscall_fail_stop(0);
        }
        execution_here().deferred_reap_handle = child;
        execution_here().deferred_reap_parent = parent;
        execution_here().deferred_reap_live = true;
    }
    execution_here().current_live = false;
    execution_here().scheduler_enabled = false;
    execution_here().reschedule_pending = false;
    process_run_unlock(exit_guard);
    { let mut __running_result: ExitSwitch = ExitSwitch::Idle; process_running_end(running_here); return __running_result; }
}

// GitHub issue #248: per-slot now, indexed by whichever slot is CURRENTLY
// running -- correct for every real caller of these four (the synchronous,
// non-blocking wait4() return path in kernel/kernel/syscall.tkb; kernel/
// init/test_driver.tkb's kernel_process_child_exec_reap(), which already relies
// on execution_here().current_handle being the parent by the time it runs), so
// none of their call sites need to change. The one place that DOES need a
// specific slot (kernel_process_child_exit's wake-a-blocked-parent step
// above) uses the explicit _for(slot) pair further below instead.
// GitHub issue #437: which of this slot's children, if any, has exited
// and not yet been reaped. Walks the sibling list, so a parent with
// several children finds whichever one is waitable rather than the one a
// single field happened to remember.
private fn kernel_process_first_zombie_of(guard: borrow ProcessRunGuard[lock], parent: ProcessHandle)
        -> ProcessNextReadyResult {
    if (scheduled_process_record_of_locked(guard, parent).has_first_child == false) {
        return ProcessNextReadyResult::Missing;
    }
    let mut cursor: ProcessHandle =
        scheduled_process_record_of_locked(guard, parent).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) {
            return ProcessNextReadyResult::Missing;
        }
        if (scheduled_process_state_of(cursor) ==
                ProcessSlotState::Exited &&
            scheduled_process_record_of_locked(guard, cursor).stack_owner_cpu ==
                PROCESS_STACK_UNOWNED) {
            return ProcessNextReadyResult::Next(cursor);
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling
                == false) {
            return ProcessNextReadyResult::Missing;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return ProcessNextReadyResult::Missing;
}

// A parent woken on a CPU that cannot admit it retains ChildExit as a
// continuation marker while Ready. Its wait cell names the exact zombie
// whose exit woke it, and whose wait4 result still has to be delivered after
// that parent's address space is active.
private fn kernel_process_pending_wait4_child(guard: borrow ProcessRunGuard[lock], parent: ProcessHandle)
        -> ProcessNextReadyResult {
    if (scheduled_process_record_of_locked(guard, parent).has_first_child == false) {
        return ProcessNextReadyResult::Missing;
    }
    let wanted: usize =
        process_wait_woken_by(&scheduled_process_record_of_locked(guard, parent).wait);
    let mut cursor: ProcessHandle =
        scheduled_process_record_of_locked(guard, parent).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) {
            return ProcessNextReadyResult::Missing;
        }
        if (scheduled_process_state_of(cursor) == ProcessSlotState::Exited &&
            scheduled_process_pid_of_handle(cursor) == wanted) {
            return ProcessNextReadyResult::Next(cursor);
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling == false) {
            return ProcessNextReadyResult::Missing;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return ProcessNextReadyResult::Missing;
}

// Unlinks a reaped child from its parent's list and gives its record back.
//
// This is where the reap lives now. The linear pair comes from
// scheduled_process_exited_take, which only produces one for a record
// whose state is Exited -- so this cannot reap a running process for want
// of a token, and cannot reap the same one twice because the take will not
// mint a second pair.
// The parent as a HANDLE. GitHub issue #492: every read of the parent's
// record below -- the unlink walk over its child list, and the pid it
// remembers afterwards -- went through a bare slot, so a parent whose slot
// had been recycled would have had a DIFFERENT process's sibling chain
// rewritten. The callers that have no expectation say so by minting a
// handle from the slot with scheduled_process_handle_of_slot, which names
// whoever is there now and is the honest encoding of not knowing.
private fn kernel_process_reap_zombie(parent: ProcessHandle,
                                      child: ProcessHandle)
        -> usize !{unsafe} {
    let parent_slot: usize = parent.pool_index;
    let parent_generation: usize = parent.generation;
    // GitHub issue #437: scheduled_process_reap ends in
    // process_image_exec_teardown, which used to leave the image target at
    // root 0 and now leaves it unset. While the reap ran inside
    // kernel_process_child_exit that was
    // repaired before anyone returned to EL0, because that function's tail
    // re-activates the parent. It runs in the REAPER's syscall context
    // now, and on the fast path (the child already a zombie when wait4 is
    // called) nothing after it re-activates -- so the reaper resumed at
    // EL0 with the COW handler aimed at root 0, PID 1's live image, and
    // its next write to a COW page fail-stopped. Root 0 being a VALID slot
    // made this invisible to the old fallback counter; an unset target is
    // counted now, but still cannot service the reaper's next fault. QEMU never saw
    // it because its parents always block before the child exits; RPi5's
    // children finish first, deterministically.
    //
    // So: capture the root the reaper is running on, reap, restore. The
    // same repair kernel_syscall_wait4_deliver already does for the same
    // reason, one call earlier in the same path.
    // GitHub issue #516: an absent target is carried as absent rather than
    // as root 0. Root 0 IS a valid slot, which is what made the old fallback
    // invisible here -- it activated PID 1's live image and only the next
    // COW fault said so. With no target there is nothing to move away from
    // and nothing to recommit, so both activations below are skipped.
    let mut resume_root: usize = 0;
    let mut has_resume_root: bool = false;
    // A secondary may arrive here from stack_idle_complete after it moved to
    // the IRQ stack and cleared current_live. It has already activated root
    // 0, and has no userspace root to restore after the ignored child is
    // reaped. Every ordinary syscall-context caller still preserves its root.
    if (execution_here().current_live) {
        match process_image_target_root_result() {
            ProcessImageTargetRootResult::Missing => {}
            ProcessImageTargetRootResult::Ready(target) => {
                resume_root = process_image_root_index(target);
                has_resume_root = true;
            }
        }
    }
    // Move away from any root the reap may release before teardown starts.
    // The current process remains Running throughout this kernel-only span.
    if (has_resume_root) {
        kernel_process_activate_stable_root(resume_root);
    }
    // GitHub issue #693 step 3: the child's record is read under the run
    // lock, like every other read of another process's record. Its exit
    // status is settled by now, but its stack owner is cleared by the CPU
    // that leaves its stack, under this lock.
    let read_guard = process_run_lock();
    let status: usize =
        scheduled_process_record_of_locked(read_guard, child).exit_status;
    let stack_unowned: bool =
        scheduled_process_record_of_locked(read_guard, child).stack_owner_cpu ==
            PROCESS_STACK_UNOWNED;
    process_run_unlock(read_guard);
    let pid: usize = scheduled_process_pid_of_handle(child);
    workload_busy_peer_exit_reaped(
        pid, scheduled_process_pid_of_handle(parent), stack_unowned);
    // GitHub issue #589: the unlink and the Exited take under the
    // process-run lock. Peer schedulers walk these same sibling links under
    // it, and the take now requires its guard. The teardown itself
    // (scheduled_process_reap) stays outside: it frees roots and pages, and
    // a world stop reached from there needs every peer free to acknowledge
    // its SGI, which a peer spinning on this IRQ-masking lock is not.
    let unlink_guard = process_run_lock();
    // Unlink first: the record is about to be handed back, and its
    // next_sibling has to be read while it is still ours to read.
    let mut following: ProcessHandle =
        scheduled_process_record_of_locked(unlink_guard, child).next_sibling;
    let has_following: bool =
        scheduled_process_record_of_locked(unlink_guard, child).has_next_sibling;
    // first_child is only ever ASSIGNED when a child is linked, so on a
    // record that never had one it holds whatever the pool slot's memory
    // held -- has_first_child is the only thing that says it is readable.
    // Three of the four callers reach here by walking this very list, so
    // they cannot get here without one. The fourth is the teardown sweep,
    // which finds Exited records by scanning ALL slots and asks
    // kernel_process_owner_slot_of for a parent -- and that returns the
    // slot ITSELF for a record whose has_parent is false. Such a record has
    // no children, so without this guard the walk below would read
    // record_at() at an index no one chose. Nothing to unlink is a
    // perfectly good outcome: the reap below is what actually matters.
    //
    // How often that happens is no longer a guess. The counter below is
    // reported as `process reap: unlinked=` at the end of the boot suite
    // and the shared `process_reap` view asserts it is 0, so on both
    // platforms today the guard never fires. It is kept because the cost of
    // being wrong is asymmetric: a recurrence becomes a number a view
    // notices, instead of a read at an index no one chose.
    if (scheduled_process_record_of_locked(unlink_guard, parent).has_first_child == false) {
        kernel_process_reap_unlinked_count =
            kernel_process_reap_unlinked_count + 1;
    } else {
    let mut head: ProcessHandle =
        scheduled_process_record_of_locked(unlink_guard, parent).first_child;
    if (scheduled_process_same_slot(head, child)) {
        scheduled_process_record_of_locked(unlink_guard, parent).first_child = following;
        scheduled_process_record_of_locked(unlink_guard, parent).has_first_child = has_following;
    } else {
        let mut prev: ProcessHandle = head;
        let mut remaining: usize = scheduled_process_pool_live_count() + 1;
        while (remaining != 0) {
            remaining = remaining - 1;
            if (scheduled_process_record_of_locked(unlink_guard, prev).has_next_sibling
                    == false) { remaining = 0; }
            else {
                let mut next: ProcessHandle =
                    scheduled_process_record_of_locked(unlink_guard, prev).next_sibling;
                if (scheduled_process_same_slot(next, child)) {
                    scheduled_process_record_of_locked(unlink_guard, prev).next_sibling =
                        following;
                    scheduled_process_record_of_locked(unlink_guard, prev)
                        .has_next_sibling = has_following;
                    remaining = 0;
                } else { prev = next; }
            }
        }
    }
    }
    let taken = scheduled_process_exited_take(unlink_guard, child);
    process_run_unlock(unlink_guard);
    match taken {
        ScheduledProcessExitedTakeResult::Missing => {}
        ScheduledProcessExitedTakeResult::Exited(done) => {
            let (exited_owner, exited_state) = done;
            // GitHub issue #693 step 5: through the owner the take handed
            // back, not looked up again.
            scheduled_process_record_owned(exited_owner).has_parent = false;
            scheduled_process_record_owned(exited_owner).has_next_sibling =
                false;
            // The teardown outside the lock, as before; the removal under
            // it (#482, see scheduled_process_reap).
            scheduled_process_reap_teardown(exited_owner);
            let removal_guard = process_run_lock();
            scheduled_process_reap_remove(removal_guard, exited_owner,
                                          exited_state);
            process_run_unlock(removal_guard);
            parent = process_handle_new(parent_slot, parent_generation);
        }
    }
    let reaped_guard = process_run_lock();
    scheduled_process_record_of_locked(reaped_guard, parent).last_reaped_pid =
        pid;
    process_run_unlock(reaped_guard);
    // scheduled_process_reap may clear the per-CPU process-image target while
    // tearing down the child. Recommit the reaper's root so a later COW fault
    // consults the same address space that TTBR0 already names.
    if (has_resume_root) {
        kernel_process_activate_stable_root(resume_root);
    }
    return status;
}

// Does this slot have a child that has not exited? The zombie walk's
// complement, and what "may I fork" asks now that a link can name a
// record whose process is already gone.
private fn kernel_process_has_live_child_of(guard: borrow ProcessRunGuard[lock],
                                         slot: usize) -> bool {
    if (scheduled_process_record_locked(guard, slot).has_first_child == false) {
        return false;
    }
    let mut cursor: ProcessHandle =
        scheduled_process_record_locked(guard, slot).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) { return false; }
        if (scheduled_process_state_of(cursor) !=
                ProcessSlotState::Exited) {
            return true;
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling
                == false) {
            return false;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return false;
}

// GitHub issue #437: does this slot have a child with this pid, live or
// zombie? wait4(pid) used to be checked against first_child's pid alone,
// which was the only child there could be. It is a search now.
// GitHub issue #693 step 3: the children's records are read under the run
// lock. A caller already holding it uses the _locked form.
fn kernel_process_current_has_child_pid(pid: usize) -> bool {
    let child_guard = process_run_lock();
    let found: bool = kernel_process_current_has_child_pid_locked(child_guard, pid);
    process_run_unlock(child_guard);
    return found;
}

fn kernel_process_current_has_child_pid_locked(guard: borrow ProcessRunGuard[lock],
                                               pid: usize) -> bool {
    if (execution_here().current_live == false || pid == 0) { return false; }
    let slot: usize = execution_here().current_handle.pool_index;
    if (scheduled_process_record_locked(guard, slot).has_first_child == false) {
        return false;
    }
    let mut cursor: ProcessHandle =
        scheduled_process_record_locked(guard, slot).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) { return false; }
        if (scheduled_process_pid_of_handle(cursor) == pid) { return true; }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling
                == false) {
            return false;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return false;
}

// The zombie carrying this pid, if this slot has one. wait4(pid) reaps
// through here so that a specific child can be collected while its
// siblings keep running.
private fn kernel_process_zombie_of_pid(guard: borrow ProcessRunGuard[lock], parent: ProcessHandle, pid: usize)
        -> ProcessNextReadyResult {
    if (scheduled_process_record_of_locked(guard, parent).has_first_child == false) {
        return ProcessNextReadyResult::Missing;
    }
    let mut cursor: ProcessHandle =
        scheduled_process_record_of_locked(guard, parent).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) {
            return ProcessNextReadyResult::Missing;
        }
        if (scheduled_process_pid_of_handle(cursor) == pid &&
            scheduled_process_state_of(cursor) ==
                ProcessSlotState::Exited &&
            scheduled_process_record_of_locked(guard, cursor).stack_owner_cpu ==
                PROCESS_STACK_UNOWNED) {
            return ProcessNextReadyResult::Next(cursor);
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling
                == false) {
            return ProcessNextReadyResult::Missing;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return ProcessNextReadyResult::Missing;
}

// GitHub issue #609: a child that has exited but whose CPU still stands on
// its kernel stack. kernel_process_child_exit makes the child Exited under
// the run lock and the exiting CPU leaves the stack later, when it switches
// to a successor or to its idle stack. Until then the zombie is not
// collectable -- the two searches above skip it -- because reaping it would
// free a stack and a record that CPU is still using. #552 put that release
// before a reap, and scheduled_process_ready_take already refused a parent's
// continuation in that window; the fast path of wait4, which finds the
// zombie itself, did not ask. It surfaced once wait4 ran on a peer: both
// CPUs fail-stopped, one with its current record already reset.
//
// `pid` is wait4's pid; all ones means any child.
fn kernel_process_child_zombie_stack_held(guard: borrow ProcessRunGuard[lock], parent: ProcessHandle, pid: usize)
        -> bool {
    if (scheduled_process_record_of_locked(guard, parent).has_first_child == false) {
        return false;
    }
    let mut cursor: ProcessHandle =
        scheduled_process_record_of_locked(guard, parent).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) {
            return false;
        }
        if ((pid == 0xFFFFFFFFFFFFFFFF ||
             scheduled_process_pid_of_handle(cursor) == pid) &&
            scheduled_process_state_of(cursor) == ProcessSlotState::Exited &&
            scheduled_process_record_of_locked(guard, cursor).stack_owner_cpu !=
                PROCESS_STACK_UNOWNED) {
            return true;
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling
                == false) {
            return false;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return false;
}

// The same question about the current process's children, for wait4.
fn kernel_process_current_child_zombie_stack_held(guard: borrow ProcessRunGuard[lock], pid: usize) -> bool {
    if (execution_here().current_live == false) { return false; }
    return kernel_process_child_zombie_stack_held(guard,
        execution_here().current_handle, pid);
}

// wait4(pid): is THAT child collectable, rather than any of them?
fn kernel_process_child_waitable_pid(guard: borrow ProcessRunGuard[lock], pid: usize) -> bool {
    if (execution_here().current_live == false) { return false; }
    match kernel_process_zombie_of_pid(guard,
            execution_here().current_handle, pid) {
        ProcessNextReadyResult::Missing => { return false; }
        ProcessNextReadyResult::Next(zombie) => { return true; }
    }
}

// The two questions above for a probe that holds no run lock.
private fn kernel_process_child_waitable_pid_probe(pid: usize) -> bool {
    let probe_guard = process_run_lock();
    let waitable: bool = kernel_process_child_waitable_pid(probe_guard, pid);
    process_run_unlock(probe_guard);
    return waitable;
}

private fn kernel_process_child_waitable_probe() -> bool {
    let probe_guard = process_run_lock();
    let waitable: bool = kernel_process_child_waitable(probe_guard);
    process_run_unlock(probe_guard);
    return waitable;
}

// wait4(pid)'s reap. Returns the status; the reaped pid is readable
// afterwards through kernel_process_last_reaped_pid, same as wait4(-1).
fn kernel_process_child_wait_status_pid(pid: usize) -> usize !{unsafe} {
    if (execution_here().current_live == false) { return 0; }
    let mut parent: ProcessHandle = execution_here().current_handle;
    // GitHub issue #693 step 3: the search walks other processes' records,
    // so it runs under the run lock; the reap takes that lock itself, so it
    // runs after. Only the parent reaps its own zombies, so the one found is
    // still there.
    let search_guard = process_run_lock();
    let found = kernel_process_zombie_of_pid(search_guard, parent, pid);
    process_run_unlock(search_guard);
    match found {
        ProcessNextReadyResult::Missing => { return 0; }
        ProcessNextReadyResult::Next(zombie) => {
            return kernel_process_reap_zombie(parent, zombie);
        }
    }
}

// GitHub issue #633: the ONE zombie a wait4 collects, named with its pid
// and status together. wait4 used to write a status it peeked from the
// first zombie, reap the first zombie again, and return
// last_child_pid read afterwards. A child exiting on another CPU writes that
// field too, so the pid returned could name a child that was not the one
// reaped, and the shell never heard of the one that was: it waited in
// rt_sigsuspend for a child it had already lost. Only the parent reaps its
// own zombies, so the one named here is still there for
// kernel_process_current_reap_pid.
must_use variant ProcessChildZombieResult { Missing; Found((usize, usize)); }

fn kernel_process_current_zombie_pick(selecting: bool, pid: usize)
        -> ProcessChildZombieResult {
    if (execution_here().current_live == false) {
        return ProcessChildZombieResult::Missing;
    }
    let mut parent: ProcessHandle = execution_here().current_handle;
    // GitHub issue #693 step 3: the children's records are read under the
    // run lock.
    let pick_guard = process_run_lock();
    if (selecting) {
        let by_pid: ProcessChildZombieResult = kernel_process_zombie_named(
            pick_guard, kernel_process_zombie_of_pid(pick_guard, parent, pid));
        process_run_unlock(pick_guard);
        return by_pid;
    }
    let first: ProcessChildZombieResult = kernel_process_zombie_named(
        pick_guard, kernel_process_first_zombie_of(pick_guard, parent));
    process_run_unlock(pick_guard);
    return first;
}

private fn kernel_process_zombie_named(guard: borrow ProcessRunGuard[lock], found: ProcessNextReadyResult)
        -> ProcessChildZombieResult {
    match found {
        ProcessNextReadyResult::Missing => {
            return ProcessChildZombieResult::Missing;
        }
        ProcessNextReadyResult::Next(zombie) => {
            return ProcessChildZombieResult::Found((
                scheduled_process_pid_of_handle(zombie),
                scheduled_process_record_of_locked(guard, zombie).exit_status));
        }
    }
}

fn kernel_process_current_reap_pid(pid: usize) -> usize !{unsafe} {
    return kernel_process_child_wait_status_pid(pid);
}

fn kernel_process_child_waitable(guard: borrow ProcessRunGuard[lock]) -> bool {
    if (execution_here().current_live == false) { return false; }
    match kernel_process_first_zombie_of(guard,
            execution_here().current_handle) {
        ProcessNextReadyResult::Missing => { return false; }
        ProcessNextReadyResult::Next(zombie) => { return true; }
    }
}

// The exit status of the child `pid` of the process in `slot`, whether or
// not a CPU still stands on its stack. For kernel_syscall_wait4_deliver
// only: it resumes a parent that a child's exit started directly, on the
// exiting CPU, which still stands on that child's stack and releases it
// only at the switch -- the deferred reap comes after. The collecting
// searches skip such a zombie (#609), which is right for a reap and wrong
// for this read.
fn kernel_process_child_exit_status_for(slot: usize, pid: usize) -> usize {
    // GitHub issue #693 step 3: the children's records are read under the
    // run lock; kernel_syscall_wait4_deliver holds none.
    let status_guard = process_run_lock();
    let status: usize =
        kernel_process_child_exit_status_for_locked(status_guard, slot, pid);
    process_run_unlock(status_guard);
    return status;
}

private fn kernel_process_child_exit_status_for_locked(
        guard: borrow ProcessRunGuard[lock], slot: usize, pid: usize) -> usize {
    let mut parent: ProcessHandle = scheduled_process_handle_of_slot(slot);
    if (scheduled_process_record_of_locked(guard, parent).has_first_child == false) {
        return 0;
    }
    let mut cursor: ProcessHandle =
        scheduled_process_record_of_locked(guard, parent).first_child;
    let mut remaining: usize = scheduled_process_pool_live_count() + 1;
    while (remaining != 0) {
        remaining = remaining - 1;
        if (scheduled_process_handle_matches(cursor) == false) { return 0; }
        if (scheduled_process_pid_of_handle(cursor) == pid &&
            scheduled_process_state_of(cursor) == ProcessSlotState::Exited) {
            return scheduled_process_record_of_locked(guard, cursor).exit_status;
        }
        if (scheduled_process_record_of_locked(guard, cursor).has_next_sibling == false) {
            return 0;
        }
        cursor = scheduled_process_record_of_locked(guard, cursor).next_sibling;
    }
    return 0;
}

// Called from kernel_process_child_exec_prepare() right after that
// process's own execve() succeeds -- execution_here().current_handle still
// names it directly, no switch has happened yet.
// GitHub issue #693 step 5: the execing process's own record, reached
// through ProcessRunning.
fn kernel_process_child_exec_mark() {
    workload_exec_commit_note();
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live) {
        scheduled_process_record_running(running_here).exec_image_live = true;
        // Linux: execve resets every caught signal to SIG_DFL, because the
        // handler address named the image that has just been replaced. An
        // ignored signal stays ignored (sigchld_ignored is left alone).
        scheduled_process_record_running(running_here).sigchld_handler = 0;
        scheduled_process_record_running(running_here).sigchld_flags = 0;
        scheduled_process_record_running(running_here).sigchld_restorer = 0;
        scheduled_process_record_running(running_here).sigchld_action_mask = 0;
        let mut current: ProcessHandle = execution_here().current_handle;
        kernel_process_trace_record(
            ProcessTraceExecCommit,
            scheduled_process_pid_of_handle(current), current.generation,
            0, 0, kernel_process_crash_state(), kernel_process_crash_wait_reason(),
            current.pool_index,
            scheduled_process_record_running(running_here).saved_sp, 0);
    }
    process_running_end(running_here);
}

// GitHub issue #245 bug fix: this used to be a single no-argument query
// against one global bool, called from two places that need the exec
// status of two DIFFERENT processes -- kernel/kernel/syscall.tkb's own
// EXIT handler asks about the process currently exiting (before
// kernel_process_child_exit() has run), while kernel_process_child_exec_
// reap() (kernel/platform/rpi5/init.tkb) asks about the child that already exited
// (after that same call has switched execution_here().current_handle to the
// parent). Taking an explicit pid removes the ambiguity instead of
// guessing which one "current" means at the call site.
// GitHub issue #693 step 5: the lookup and the read under one run-guard
// hold; neither caller (the exit arm, test_driver's exec reap) holds it.
fn kernel_process_exec_image_live_for_pid(pid: usize) -> bool !{unsafe} {
    let guard = process_run_lock();
    let mut live: bool = false;
    match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => {}
        ProcessSlotForPidResult::Found(slot) => {
            live = scheduled_process_record_locked(guard, slot).exec_image_live;
        }
    }
    process_run_unlock(guard);
    return live;
}

fn kernel_process_exec_clear_for_pid(pid: usize) !{unsafe} {
    let guard = process_run_lock();
    match scheduled_process_slot_for_pid(pid) {
        ProcessSlotForPidResult::Missing => {}
        ProcessSlotForPidResult::Found(slot) => {
            scheduled_process_record_locked(guard, slot).exec_image_live =
                false;
        }
    }
    process_run_unlock(guard);
}

// GitHub issue #245: the old execution_process == Parent conjunct asserted
// "we ended up back in the one designated root role," which no longer has
// a single fixed meaning once any slot can be a parent relative to its
// own child. Dropped rather than mapped onto something new: the other
// conditions already pin down this fixture's own completion precisely.
//
// GitHub issue #209: the fourth conjunct used to read the raw
// execution_here().scheduler_enabled flag, back when a single child exit latched
// that flag off for the rest of the boot. That flag now tracks the live
// process population instead (see kernel_process_child_exit), so the
// assertion is stated directly in terms of the property it always meant:
// every process this fixture created is gone again.
fn kernel_process_scheduler_acceptance_evidence() -> bool {
    return process_test_evidence_timer_switches() >= 2 &&
           process_test_evidence_deferred_requests() != 0 &&
           process_test_evidence_exit_42_seen() &&
           kernel_process_schedulable_count() <= 1;
}

// The pid this process most recently reaped. Only the reaper writes it.
fn kernel_process_last_reaped_pid() -> usize {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) { { let mut __running_result: usize = 0; process_running_end(running_here); return __running_result; } }
    { let mut __running_result: usize = scheduled_process_record_running(running_here)
        .last_reaped_pid; process_running_end(running_here); return __running_result; }
}

// The child whose exit this CPU ran last.
fn kernel_process_last_exited_child_pid() -> usize {
    return execution_here().last_exited_child_pid;
}

// GitHub issue #245: process_test_evidence's clone_calls is a single
// counter shared by every clone() since the last
// kernel_process_execution_reset(), not just
// the one this fixture cares about -- when this process itself was
// reached via a fork+exec chain (ash forking an external command that
// then execve()s), that outer fork already incremented it once, so
// checking for exactly 1 undercounts. >= 1 keeps the real assertion
// (a clone genuinely happened) without assuming how many preceded it.
fn kernel_process_clone_evidence() -> bool {
    let ProcessRunningHere::Running(running_here) = process_running_here() else {};
    if (execution_here().current_live == false) { { let mut __running_result: bool = false; process_running_end(running_here); return __running_result; } }
    { let mut __running_result: bool = process_test_evidence_clone_calls() >= 1 &&
           process_test_evidence_exit_42_seen() &&
           scheduled_process_record_running(running_here)
               .has_first_child ==
               false &&
           scheduled_process_state_of(execution_here().current_handle) ==
               ProcessSlotState::Running &&
           scheduled_process_record_running(running_here)
               .saved_sp !=
               0; process_running_end(running_here); return __running_result; }
}

// GitHub issues #453/#479, re-derived against the current access paths.
// execution_state and the crash-trace writer are per-core. The run lock spans
// each shared process-tree walk and Ready/Running/Blocked transition, including
// slot 0: two cores may inspect the bootstrap record, but only the core whose
// guarded Ready -> Running transition succeeds can install it as current.
// Bootstrap allocation itself has one caller, kernel_process_execution_reset,
// while scheduling is disabled. Issue #415's narrower allocation type keeps a
// pooled caller from acquiring slot 0; duplicating the whole lifecycle by
// bootstrap/pooled type would not add a cross-core guarantee.
//
// What remains is preemption on ONE core. Several lifecycle operations compose
// short guarded transitions with caller-local work outside the run lock. They
// rely on a syscall or lifecycle path running to completion before another
// process on the same core enters one of those spans.
fn process_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "process lifecycle operations contain caller-local spans outside the run lock; kernel preemption could interleave two processes on one core");
}


// GitHub issue #437: collect every child of the current process that has
// exited and not been reaped.
//
// This is what a real init does in its wait loop, one child at a time and
// forever. A caller uses it when it wants the same effect at one moment --
// the bounded boot fixture before its resource accounting, where a record
// still waiting to be collected would otherwise read as a leak.
//
// Bounded by the live count: each reap removes one child from the list, so
// the walk cannot outlast the processes that exist.
//
// It sweeps by STATE, so it would also collect an Exited record with no
// parent link -- the record GitHub issue #464 saw once on RPi5 against an
// intermediate build. Measured since, it does not happen: such a reap is
// counted as `process reap: unlinked=`, and the shared `process_reap` view
// asserts 0 on every QEMU and RPi5 boot. So this sweep is belt and braces,
// not the thing standing between that record and a leak, and a recurrence
// fails a view instead of being collected quietly.
fn kernel_process_reap_own_zombies() !{unsafe} {
    if (execution_here().current_live == false) { return; }
    let activity_before: KernelActivity =
        kernel_activity_enter(KernelActivity::ReapOwnZombies);
    let mut sweeping: usize = scheduled_process_pool_live_count() + 1;
    while (sweeping != 0) {
        sweeping = sweeping - 1;
        let mut found: bool = false;
        let mut cursor = scheduled_process_first_slot();
        let mut walking: bool = true;
        while (walking) {
            match cursor {
                ProcessSlotCursor::Done => { walking = false; }
                ProcessSlotCursor::At(slot) => {
                    // NOT the slot execution_here() calls current, and
                    // this file's own doc above is the reason: this
                    // collects "every child of the current process that has
                    // exited", and a process is not its own child. The
                    // implementation sweeps by STATE rather than by
                    // relationship, which is what let it reap the current
                    // record -- leaving current_handle naming a slot the
                    // pool no longer recognises while current_live stayed
                    // true.
                    //
                    // GitHub issue #488. Every read through
                    // execution_here().current_handle after that point
                    // lands on the counted absent-record fallback; the
                    // boot suite reported `records MISSING uses=11
                    // reason=2` in roughly one QEMU boot in eight. It was
                    // visible at all only because an unrelated probe had
                    // shifted the pool layout so the freed address was NOT
                    // recycled. Without that shift the same stale handle
                    // resolves to whatever record now occupies the
                    // address, and the kernel operates on the wrong
                    // process in silence -- which is the real cost, and why
                    // this is a guard rather than a tolerated counter.
                    //
                    // The other three kernel_process_reap_zombie call
                    // sites are scoped by relationship (a process's own
                    // children) and cannot reach the current record, so
                    // they need nothing.
                    // GitHub issue #693 step 5: the state and the parent
                    // link are read under the run guard, released before
                    // the reap, which takes it itself.
                    let sweep_guard = process_run_lock();
                    let exited: bool = found == false &&
                        execution_here().current_handle.pool_index != slot &&
                        scheduled_process_record_state(slot) ==
                            ProcessSlotState::Exited;
                    let mut owner_slot: usize = slot;
                    if (exited) {
                        owner_slot =
                            kernel_process_owner_slot_of(sweep_guard, slot);
                    }
                    process_run_unlock(sweep_guard);
                    if (exited) {
                        found = true;
                        let mut victim: ProcessHandle =
                            scheduled_process_handle_of_slot(slot);
                        let collected: usize =
                            kernel_process_reap_zombie(
                                scheduled_process_handle_of_slot(owner_slot),
                                victim);
                    }
                    cursor = scheduled_process_next_slot(slot);
                }
            }
        }
        if (found == false) { sweeping = 0; }
    }
    kernel_activity_leave(activity_before);
}

// Whose child list, if any, holds this slot.
//
// Normally its parent. A record can reach Exited with no parent link --
// measured, one does in the bounded boot suite -- and where that comes
// from is a separate question (see issue #437); a teardown sweep must
// collect it either way rather than leave a record nobody can name.
// Answering "itself" makes the unlink in kernel_process_reap_zombie a
// no-op, which is what a record outside every list needs.
private fn kernel_process_owner_slot_of(guard: borrow ProcessRunGuard[lock],
                                       slot: usize) -> usize {
    if (scheduled_process_record_locked(guard, slot).has_parent) {
        let mut parent: ProcessHandle =
            scheduled_process_record_locked(guard, slot).parent;
        if (scheduled_process_handle_matches(parent)) {
            return parent.pool_index;
        }
    }
    return slot;
}

// The handle a slot currently answers to.
private fn scheduled_process_handle_of_slot(slot: usize) -> ProcessHandle {
    if (slot == 0) {
        let mut boot: ProcessHandle = { 0, scheduled_process_boot_generation };
        return boot;
    }
    match intrusive_pool_probe_slot(&scheduled_process_pool, slot) {
        IntrusiveSlotProbe::NoPayload => {
            let mut absent: ProcessHandle = { slot, 0 };
            return absent;
        }
        IntrusiveSlotProbe::Live(slot_view) => {
            let generation: usize = intrusive_view_generation(slot_view);
            intrusive_view_drop(slot_view);
            let mut live: ProcessHandle = { slot, generation };
            return live;
        }
    }
}
