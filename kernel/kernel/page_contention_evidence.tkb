// GitHub issue #479: the page allocator's own lock, exercised.
//
// This exists because of a negative result. After the lock landed, removing
// it again changed nothing the suite could see -- every lane still passed.
// The audit behind it is sound (the lock order is pool-then-page, and the
// effect checker proves the allocator is unreachable from interrupt
// context, transitively and by name), but an audit is not evidence, and a
// lock nothing exercises is indistinguishable from a lock that does not
// work. That is the state the free-list probe next door was written to
// avoid, and it would have been dishonest to leave this one in it.
//
// The detector is the allocator's OWN bookkeeping rather than anything this
// file invents. Both cores allocate and free the same number of pages; a
// lost race shows up as pages that never came back (live_count above the
// baseline) or as a page freed twice (double_free_count). Two cores handed
// the same index both free it, and the second free is what the counter
// sees.
//
// Current limitations:
// - USES THE REAL ALLOCATOR, unlike the pool and free-list probes, which
//   own private instances. There is no private page allocator to own, and
//   a copy of it would be testing a copy. Balanced by construction: every
//   allocation here is freed here, and the verdict checks the count
//   returned to exactly where it started.
// - MEASURES EXCLUSION, NOT ORDERING, like the others.
// - Says nothing about page_alloc_contiguous, whose critical section is
//   longer and whose failure (a run that is not contiguous) this detector
//   cannot see. That wants its own probe and does not have one.

use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/mm/page.tkb";
use "kernel/lib/execution_model.tkb";

const PAGE_CONTENTION_ROUNDS: usize = 2048;
const PAGE_CONTENTION_OUTSIDE_WORK: usize = 64;

private let mut page_probe_armed: AtomicWord;
// Completed cycles and the inside-the-run level, one word per core
// (GitHub issue #756: every online peer, index 0 is core 0's).
private let mut page_probe_tally: PeerTally;
private let mut page_probe_overlap: AtomicWord;

// Take one page and give it straight back. Every online core runs this.
private fn page_probe_cycle() -> bool !{allocates, unsafe} {
    match page_alloc(PageOwnerTag::UserPage) {
        PageAllocResult::OutOfMemory => {
            return false;
        }
        PageAllocResult::Allocated(owner) => {
            page_free(owner);
            for spin: usize in 0..<PAGE_CONTENTION_OUTSIDE_WORK { }
            return true;
        }
    }
}

// Armed for `cpu` only while it still has work (GitHub issue #860).
fn page_contention_is_armed(cpu: usize) -> bool !{unsafe} {
    return atomic_word_load(&page_probe_armed) == 1 &&
           peer_tally_count(&page_probe_tally, cpu) < PAGE_CONTENTION_ROUNDS;
}

// Every online peer runs this from its idle loop while the probe is armed.
fn page_contention_secondary_run(cpu: usize) !{allocates, unsafe} {
    if (peer_tally_is_peer(&page_probe_tally, cpu) == false) { return; }
    peer_tally_enter(&page_probe_tally, cpu);
    // Complete one cycle, then WAIT for the primary to have started.
    // GitHub issue #510: the second half of the start handshake
    // kernel/kernel/fd_table.tkb's probe already had. Without it this core
    // -- driven from the idle loop in
    // kernel/arch/arm64/kernel/secondary.tkb, which re-enters an armed
    // probe after every `wfi` wake -- can run every round and leave before
    // core 0 gets a slice, and the overlap core 0 then asserts is a number
    // from a phase the cores never shared. A cycle that comes back false
    // took no page and is not one, so this retries rather than publishing
    // a round it did not complete.
    while (peer_tally_count(&page_probe_tally, cpu) == 0 &&
           atomic_word_load(&page_probe_armed) == 1) {
        if (page_probe_cycle()) { peer_tally_add(&page_probe_tally, cpu); }
    }
    while (peer_tally_count(&page_probe_tally, 0) == 0 &&
           atomic_word_load(&page_probe_armed) == 1) { }
    while (peer_tally_count(&page_probe_tally, cpu) < PAGE_CONTENTION_ROUNDS &&
           atomic_word_load(&page_probe_armed) == 1) {
        if (page_probe_cycle()) { peer_tally_add(&page_probe_tally, cpu); }
    }
    peer_tally_leave(&page_probe_tally, cpu);
}

private fn page_contention_report(stage: *u8, baseline: usize,
                                  doubles_before: usize) !{unsafe} {
    kernel_boot_log("page contention stage: ");
    kernel_boot_log(stage);
    kernel_boot_log("\n");
    kernel_boot_log("page contention counts:");
    peer_tally_put_counts(&page_probe_tally);
    kernel_boot_log(" leaked=");
    uart_put_udec(page_allocator_live_count() - baseline);
    kernel_boot_log(" doublefree=");
    uart_put_udec(page_allocator_double_free_count() - doubles_before);
    kernel_boot_log(" overlap=");
    uart_put_udec(atomic_word_load(&page_probe_overlap));
    kernel_boot_log("\n");
}

fn page_contention_probe() -> bool !{allocates, unsafe} {
    let baseline: usize = page_allocator_live_count();
    let doubles_before: usize = page_allocator_double_free_count();
    atomic_word_store(&page_probe_overlap, 0);
    peer_tally_reset(&page_probe_tally, kernel_online_core_count());
    atomic_word_store(&page_probe_armed, 1);

    // GitHub issue #479 Group B: wait for every peer to have COMPLETED A
    // ROUND, not merely to have set `active`. `active` is set before the
    // first cycle, so the old gate let the primary start while the
    // secondary had done nothing -- and then GitHub issue #478 decides how
    // much it ever does. This probe holds the page lock longer than any
    // other here, so the starvation bit hardest: on RPi5 the overlap was 61
    // rounds of 2048, passing `overlap > 0` by luck, and an unrelated probe
    // added ahead of it took it to 0. Waiting for a completed round makes
    // `overlap > 0` mean every core was really in the loop together.
    // GitHub issue #510: the gate is the count alone, never the `active`
    // level a fast peer clears on its way out.
    if (peer_tally_peers_reached(&page_probe_tally, 1,
                                 PeerTickPolicy::Entry) == false) {
        atomic_word_store(&page_probe_armed, 0);
        page_contention_report("secondary-never-completed-a-round" as *u8,
                               baseline, doubles_before);
        return false;
    }

    for round: usize in 0..<PAGE_CONTENTION_ROUNDS {
        if (page_probe_cycle()) { peer_tally_add(&page_probe_tally, 0); }
    }

    atomic_word_store(&page_probe_overlap,
                      peer_tally_peers_least(&page_probe_tally));

    let finished: bool = peer_tally_peers_reached(
        &page_probe_tally, PAGE_CONTENTION_ROUNDS, PeerTickPolicy::Finish);
    atomic_word_store(&page_probe_armed, 0);
    if (finished == false) {
        page_contention_report("secondary-never-finished" as *u8, baseline,
                               doubles_before);
        return false;
    }
    // Every peer out before the allocator's counts are read: a cycle still
    // inside would show as a leaked page (GitHub issue #756 made this a
    // wait over every peer rather than none).
    if (peer_tally_peers_left(&page_probe_tally,
                              PeerTickPolicy::Entry) == false) {
        page_contention_report("secondary-never-left" as *u8, baseline,
                               doubles_before);
        return false;
    }

    page_contention_report("complete" as *u8, baseline, doubles_before);
    let overlap: usize = atomic_word_load(&page_probe_overlap);
    // Every page back where it started, nothing freed twice, and every
    // online core was inside the allocator at once.
    return page_allocator_live_count() == baseline &&
           page_allocator_double_free_count() == doubles_before &&
           overlap > 0;
}
