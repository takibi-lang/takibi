// Every-online-core evidence for the production console lock (one peer
// until GitHub issue #756; one is now the degenerate case). Every peer first
// bypasses it to demonstrate that the detector observes entry while core 0
// holds it; then the same rendezvous takes the real lock and every peer's
// entry waits for release, the peers then excluding one another.
// Detector words are independent atomic cells, not console-path counters.
// Current limitations (2026-10-19): init runs this once; the participants are
// the online prefix at the start of each phase. This tests exclusion, not
// physical UART timing or an abandoned lock holder.
use "kernel/lib/peer_tick_window.tkb";
use "kernel/lib/peer_round.tkb";
use "kernel/lib/atomic_word.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/printk/console_lock.tkb";
use "kernel/lib/occupancy.tkb";

private let mut console_probe_armed: AtomicWord;
private let mut console_probe_phase: AtomicWord;
// Bumped by core 0 for every phase; a peer serves each phase once.
private let mut console_probe_sequence: AtomicWord;
private let mut console_probe_go: AtomicWord;
// Per peer: the phase sequence it is ready for, then finished.
private let mut console_probe_ready: PeerTally;
private let mut console_probe_done: PeerTally;
// Per peer: 1 = saw the lock held on arrival, 2 = saw it free.
private let mut console_probe_arrived: PeerTally;
// Per peer: 1 once it passed the entry the phase tests.
private let mut console_probe_entered: PeerTally;

fn console_contention_is_armed() -> bool {
    return atomic_word_load(&console_probe_armed) == 1;
}

// Every online peer runs this from its idle loop while the probe is armed.
fn console_contention_secondary_run(cpu: usize) {
    if (peer_tally_is_peer(&console_probe_done, cpu) == false) { return; }
    let sequence: usize = atomic_word_load(&console_probe_sequence);
    if (peer_tally_count(&console_probe_ready, cpu) == sequence) { return; }
    let phase: usize = atomic_word_load(&console_probe_phase);
    // Rendezvous outside the lock first: the idle peer may otherwise be
    // waiting in an unrelated console write before it reaches this probe.
    peer_tally_set(&console_probe_ready, cpu, sequence);
    if (console_probe_wait(&console_probe_go) == false) {
        atomic_word_store(&console_probe_armed, 0);
        peer_tally_set(&console_probe_done, cpu, sequence);
        return;
    }
    // This observation belongs to the detector, before the tested acquire.
    let held: bool = console_lock_is_held();
    if (held) { peer_tally_set(&console_probe_arrived, cpu, 1); }
    else { peer_tally_set(&console_probe_arrived, cpu, 2); }
    if (phase == 1) {
        peer_tally_set(&console_probe_entered, cpu, 1);
    } else {
        let guard = console_lock();
        peer_tally_set(&console_probe_entered, cpu, 1);
        console_unlock(guard);
    }
    peer_tally_set(&console_probe_done, cpu, sequence);
}

private fn console_probe_wait(cell: *AtomicWord) -> bool {
    let mut window = peer_tick_window_policy(
        peer_tick_window_peer(), PeerTickPolicy::Arrival);
    while (peer_tick_window_open(window)) {
        if (atomic_word_load(cell) != 0) { peer_tick_window_end(window); return true; }
    }
    peer_tick_window_end(window);
    return false;
}

// True when every peer's word in `tally` equals `value`.
private fn console_probe_every_peer(tally: &mut PeerTally, value: usize) -> bool {
    let online: usize = peer_tally_online(tally);
    let mut every: bool = online >= 2;
    for cpu: usize in 1..<KERNEL_MAX_CORES {
        if (cpu < online && peer_tally_count(tally, cpu) != value) {
            every = false;
        }
    }
    return every;
}

private fn console_probe_phase_run(phase: usize) -> bool {
    let online: usize = kernel_online_core_count();
    atomic_word_store(&console_probe_phase, phase);
    atomic_word_store(&console_probe_go, 0);
    peer_tally_reset(&console_probe_arrived, online);
    peer_tally_reset(&console_probe_entered, online);
    let sequence: usize = atomic_word_load(&console_probe_sequence) + 1;
    atomic_word_store(&console_probe_sequence, sequence);
    atomic_word_store(&console_probe_armed, 1);
    if (peer_tally_peers_reached(&console_probe_ready, sequence,
                                 PeerTickPolicy::Arrival) == false) {
        atomic_word_store(&console_probe_armed, 0);
        kernel_boot_log("console contention stage: secondary-never-ready\n");
        return false;
    }
    let guard = console_lock();
    atomic_word_store(&console_probe_go, 1);
    let arrived: bool = peer_tally_peers_reached(&console_probe_arrived, 1,
                                                 PeerTickPolicy::Arrival);
    let mut expected: bool = false;
    if (arrived && console_probe_every_peer(&console_probe_arrived, 1)) {
        if (phase == 1) {
            expected = peer_tally_peers_reached(&console_probe_entered, 1,
                                                PeerTickPolicy::Arrival);
        } else {
            expected = peer_tally_peers_sum(&console_probe_entered) == 0;
        }
    }
    console_unlock(guard);
    let done: bool = peer_tally_peers_reached(&console_probe_done, sequence,
                                              PeerTickPolicy::Arrival);
    atomic_word_store(&console_probe_armed, 0);
    if (arrived == false) {
        kernel_boot_log("console contention stage: secondary-never-arrived\n");
    } else if (done == false) {
        kernel_boot_log("console contention stage: secondary-never-finished\n");
    }
    return arrived && expected && done &&
        console_probe_every_peer(&console_probe_entered, 1);
}

fn console_contention_probe() -> bool {
    let online: usize = kernel_online_core_count();
    peer_tally_reset(&console_probe_ready, online);
    peer_tally_reset(&console_probe_done, online);
    atomic_word_store(&console_probe_sequence, 0);
    if (console_probe_phase_run(1) == false) { return false; }
    return console_probe_phase_run(2);
}

fn console_contention_execution_model_assumption() {
    static_assert(KERNEL_ACTIVE_CORES >= 2,
                  "console contention evidence needs a primary and a peer");
}

// DDB lanes arm this only after their ordinary UART workload is complete.
// The host checks the held phase before injecting the real BREAK. A bounded
// holder is deliberate: world-stop cannot acknowledge a permanently masked
// peer. The deadline is recovery, not a timing verdict.
let mut console_ddb_phase: AtomicWord;
private let mut console_ddb_release_reason: AtomicWord;
private let mut console_ddb_entry_held: AtomicWord;

fn console_ddb_peer_hold() {
    atomic_word_store(&console_ddb_phase, 0);
    atomic_word_store(&console_ddb_release_reason, 0);
    atomic_word_store(&console_ddb_entry_held, 0);
    let guard = console_lock();
    if (console_lock_is_held() == false) {
        console_unlock(guard);
        atomic_word_store(&console_ddb_phase, 3);
        return;
    }
    atomic_word_store(&console_ddb_phase, 1);
    console_ddb_hold_checkpoint();
    // A polling-only fixture marker bypasses the tested lock, as DDB does.
    // It is emitted before the bounded hold waits for the real BREAK.
    let marker = bs"console lock probe: held for UART BREAK\n";
    for byte in marker { uart_debug_putc(byte); }
    let start: i64 = read_cntpct();
    // Deliberate hold: wait for external UART BREAK while IRQs are masked.
    let budget: i64 = read_cntfrq() * 5;
    let mut reason: usize = 0;
    while (reason == 0 && read_cntpct() - start < budget) {
        // The request is observable even while this CPU masks its stop SGI.
        // Releasing the guard restores IRQs and lets the normal pen run.
        if (world_stop_reporter_word(2) != 0) { reason = 1; }
        else if (uart_break_flagged()) { reason = 2; }
    }
    if (reason == 0) { reason = 3; }
    // Publish the release decision before restoring IRQs: the pending stop
    // may park us inside console_unlock, before the next statement runs.
    // A complete world-stop and an unlocked mutex confirm actual release.
    atomic_word_store(&console_ddb_release_reason, reason);
    atomic_word_store(&console_ddb_phase, 2);
    console_unlock(guard);
}

// Read-only observation before requesting world-stop. Never acquire a
// console guard here: the whole purpose is entry with a peer holding it.
fn console_ddb_note_entry() {
    if (cpu_id() == 0 && atomic_word_load(&console_ddb_phase) == 1 &&
        console_lock_is_held()) {
        atomic_word_store(&console_ddb_entry_held, 1);
    }
}

fn console_ddb_probe_phase() -> usize {
    return atomic_word_load(&console_ddb_phase);
}
fn console_ddb_probe_release_reason() -> usize {
    return atomic_word_load(&console_ddb_release_reason);
}
fn console_ddb_probe_entry_held() -> bool {
    return atomic_word_load(&console_ddb_entry_held) == 1;
}

// A real call boundary for GDB's host-held BREAK injection; the check also
// makes restoring a detached observation fail rather than report a hold.
fn console_ddb_hold_checkpoint() {
    if (console_lock_is_held() == false) {
        atomic_word_store(&console_ddb_phase, 3);
    }
}
