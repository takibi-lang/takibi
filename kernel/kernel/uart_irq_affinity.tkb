// GitHub issue #830 (UART slice): the console UART's interrupt may be taken
// by any online core, and a serial BREAK enters DDB on whichever core took it.
//
// The route is GICv2's 1-of-N model: the SPI's ITARGETSR byte names every
// online core, and the distributor hands each interrupt to one of them
// (maintainer decision 2026-10-23, D2). Unlike the NIC's per-interrupt
// rotation, no single core is the target at any moment, so a core spinning
// with interrupts masked does not keep a BREAK from reaching DDB. The route
// is rewritten after each handled interrupt, so cores that came online since
// the last one join it.
//
// SERIAL SERVICE. Unlike the NIC and xHCI handlers, the UART handler moves
// data: it drains the RX FIFO into the receive ring and refills the TX FIFO.
// Two cores draining at once could deliver bytes out of order. On QEMU and
// RPi5, GICv2's active state already prevents that: the SPI is not signalled
// to another core until this core's EOI, and the busy word below is cleared
// before that EOI, so the try-lock is never contended there
// (kernel/models/UartServe.tla, variant gated). It is a defence for delivery
// without that gate (variant fixed): one core at a time runs the service,
// and a core that finds another inside it leaves at once. Nothing is lost by leaving, because every
// PL011 source this kernel enables is level: RX and RX-timeout stay asserted
// while the FIFO holds bytes, TX while it is below its level, BREAK until it
// is cleared. On QEMU the SPI is level-sensitive, so it is delivered again
// after this core's EOI; on RPi5 RP1's MSI-X wrapper sends again at the IACK
// while its level source is still asserted. Whatever the busy core did not
// drain therefore raises the interrupt again once it is gone.
//
// Current limitations (2026-10-23). Keep this list current as call sites
// change; a stale limitation is worse than none.
// - ONLINE CORES ARE 0..online-1 and at most eight (GICv2 ITARGETSR is a
//   byte), as kernel_secondary_boot brings them up today.
// - A BREAK ENDS THE SERVICE. The core that saw it enters DDB after its EOI;
//   the line, still asserted while bytes wait, brings the service back after
//   DDB.
// - A CORE THAT FINDS THE SERVICE BUSY EOIs AND RETURNS, so while the busy
//   core drains, a still-asserted line can be delivered again at once: a
//   short burst of empty interrupts, bounded by one FIFO drain.

use "kernel/lib/atomic_word.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/arch/arm64/kernel/gicv2.tkb";
use "kernel/arch/arm64/kernel/secondary.tkb";
use "kernel/arch/arm64/boot/cpu.tkb";
use "kernel/drivers/serial/pl011.tkb";

// 1 while a core is inside uart_irq_service.
private let mut uart_irq_service_busy: AtomicWord;
// UART interrupts each core handled since boot, for the boot report.
private let mut uart_irq_taken: [AtomicWord; KERNEL_MAX_CORES];

// Every online core, as an ITARGETSR byte.
fn uart_irq_route(intid: u32) !{unsafe} {
    let online: usize = kernel_online_core_count();
    let mut mask: usize = 0;
    for core: usize in 0..<8 {
        if (core < online) { mask = mask | (1 << core); }
    }
    gic_intid_target(intid, mask as u8);
}

// The UART interrupt, on whichever core took it. True when a BREAK arrived
// and this core should enter DDB after its EOI.
fn uart_irq_serve() -> bool !{interrupt, unsafe} {
    let raw: usize = cpu_id();
    if (raw < KERNEL_MAX_CORES) {
        let core: {0..<KERNEL_MAX_CORES as usize} = raw;
        let previous_taken: usize = atomic_word_fetch_add(&uart_irq_taken[core], 1);
    }
    match atomic_word_compare_swap_acq_rel(&uart_irq_service_busy, 0, 1) {
        CasResult::Swapped => { }
        CasResult::Observed(seen) => { return false; }
    }
    let debug_break: bool = uart_irq_service();
    atomic_word_store(&uart_irq_service_busy, 0);
    return debug_break;
}

// Both dispatches' tail after their own EOI: the route names every core
// online now. A BREAK then enters DDB on this core, from the dispatch.
fn uart_irq_after_eoi(intid: u32) !{unsafe} {
    uart_irq_route(intid);
    workload_profile_irq_exit();
}

// At the end of the boot: at least two cores took UART interrupts.
fn uart_irq_evidence_report() !{logs, unsafe} {
    if (kernel_online_core_count() <= 1) { return; }
    let mut cores: usize = 0;
    for core: usize in 0..<KERNEL_MAX_CORES {
        if (atomic_word_load(&uart_irq_taken[core]) > 0) { cores = cores + 1; }
    }
    if (cores >= 2) {
        kernel_boot_log("uart irq: taken on at least two cpus\n");
        return;
    }
    kernel_boot_log("uart irq: FAILED, taken=");
    let mut separator: bool = false;
    for core: usize in 0..<KERNEL_MAX_CORES {
        if (core < kernel_online_core_count()) {
            if (separator) { kernel_boot_log(","); }
            separator = true;
            uart_put_udec(atomic_word_load(&uart_irq_taken[core]));
        }
    }
    kernel_boot_log("\n");
}

// GitHub issue #830 (D2, maintainer 2026-10-23): the DDB lane's hung-core
// scenario. A debugger writes 1 + a core number here; that core, on its next
// interrupt, spins with interrupts masked for UART_IRQ_HANG_SECONDS. A BREAK
// sent meanwhile must still enter DDB on another core, and the lane checks
// what the world stop reaches. Zero (the default) costs one load per
// interrupt. Only the lane's GDB writes it; the kernel only reads it, and
// clears it when the spin ends.
let mut uart_irq_hang_request: AtomicWord;
const UART_IRQ_HANG_SECONDS: i64 = 8;

fn uart_irq_hang_poll() !{interrupt, unsafe} {
    let requested: usize = atomic_word_load(&uart_irq_hang_request);
    if (requested == 0 || requested != cpu_id() + 1) { return; }
    let until: i64 = read_cntpct() + read_cntfrq() * UART_IRQ_HANG_SECONDS;
    while (read_cntpct() < until) { }
    atomic_word_store(&uart_irq_hang_request, 0);
}
