/* EL0 signal-frame and anonymous-memory boundary fixture. Each destructive
 * signal case runs in a child; the parent checks the exact wait4 status.
 * No writable globals: all state belongs to the calling process's stack.
 */
extern fn signal_boundary_run(mode: usize) -> usize;
extern symbol signal_boundary_handler;
extern symbol signal_boundary_restorer;
extern fn signal_interrupt_svc(number: usize, a0: usize, a1: usize, a2: usize,
                               a3: usize, ran: usize) -> usize;
extern symbol signal_interrupt_handler;
extern fn signal_spin_run() -> usize;
extern fn signal_spin_stray(pid: usize, signum: usize) -> usize;
extern symbol signal_spin_handler;
extern fn signal_spin_forever(set: usize, bad_sp: usize) -> usize;
extern symbol signal_exit_handler;
extern symbol signal_terminal_handler;

private fn boundary_fail(line: borrow []const u8) !{unsafe} {
    // Raw ABI input only: these syscalls read the readonly bytes.
    // The bridge exposes no writable slice or checked mutation.
    svc5(64, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
    svc5(93, 1, 0, 0, 0, 0);
}

private fn boundary_line(line: borrow []const u8) !{unsafe} {
    svc5(64, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
}

private fn boundary_memory() !{unsafe} {
    let old_break: usize = svc5(214, 0, 0, 0, 0, 0);
    let first: usize = svc5(222, 0, 4096, 3, 0x22, 0xFFFFFFFFFFFFFFFF);
    if (first >= 0xFFFFFFFFFFFFF000 || first == 0) {
        boundary_fail(bs"boundary: FAIL first mmap\n");
        return;
    }
    // Mint exactly the extent granted by mmap. All later byte accesses are
    // checked against this bounded view; no raw-pointer indexing is used.
    let first_pointer: *u8 = unsafe { first as *u8 };
    let first_bytes: [u8; 4096..] = unsafe { first_pointer[0..<4096] };
    for index: usize in 0..<4096 { first_bytes[index] = 0xA5; }
    if (svc5(215, first, 4096, 0, 0, 0) != 0) {
        boundary_fail(bs"boundary: FAIL munmap\n");
        return;
    }
    let second: usize = svc5(222, 0, 4096, 3, 0x22, 0xFFFFFFFFFFFFFFFF);
    if (second != first) {
        boundary_fail(bs"boundary: FAIL mmap did not reuse address\n");
        return;
    }
    let second_pointer: *u8 = unsafe { second as *u8 };
    let second_bytes: [u8; 4096..] = unsafe { second_pointer[0..<4096] };
    for index: usize in 0..<4096 {
        if (second_bytes[index] != 0) {
            boundary_fail(bs"boundary: FAIL reused mmap not zero\n");
            return;
        }
    }
    boundary_line(bs"boundary: mmap reuse zero-filled\n");
    if (svc5(214, second + 1, 0, 0, 0, 0) != old_break ||
        svc5(214, 0, 0, 0, 0, 0) != old_break) {
        boundary_fail(bs"boundary: FAIL brk crossed mapping\n");
        return;
    }
    boundary_line(bs"boundary: brk mapping collision refused\n");
    if (svc5(215, second, 4096, 0, 0, 0) != 0) {
        boundary_fail(bs"boundary: FAIL final munmap\n");
    }
}

fn signal_boundary_probe() !{unsafe} {
    let mut action: [usize; 4];
    action[0] = signal_boundary_handler as usize;
    action[1] = 0x04000004;
    action[2] = signal_boundary_restorer as usize;
    action[3] = 0;
    if (svc5(134, 10, action as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"boundary: FAIL sigaction\n");
        return;
    }
    for mode: usize in 0..<6 {
        let child: usize = svc5(220, 17, 0, 0, 0, 0);
        if (child == 0) {
            let result: usize = signal_boundary_run(mode);
            svc5(93, result, 0, 0, 0, 0);
            return;
        }
        if (child >= 0xFFFFFFFFFFFFF000) {
            boundary_fail(bs"boundary: FAIL fork\n");
            return;
        }
        let mut status: [u8; 4];
        for index: usize in 0..<4 { status[index] = 0xFF; }
        // A refused frame ends the child by SIGSEGV: Linux's status word
        // has 11 in its low byte (GitHub issue #882), not exit code 139.
        let mut expected: u8 = 11;
        if (mode == 0 || mode == 4) { expected = 0; }
        if (svc5(260, child, status as *u8 as usize, 0, 0, 0) != child ||
            status[0] != expected || status[1] != 0) {
            boundary_fail(bs"boundary: FAIL signal child status\n");
            return;
        }
        match mode {
            0 => { boundary_line(bs"boundary: siginfo, restored mask and FPSIMD exact\n"); }
            1 => { boundary_line(bs"boundary: bad FPSIMD magic refused\n"); }
            2 => { boundary_line(bs"boundary: bad FPSIMD size refused\n"); }
            3 => { boundary_line(bs"boundary: misaligned signal PC refused\n"); }
            4 => { boundary_line(bs"boundary: signal PSTATE limited to NZCV\n"); }
            _ => { boundary_line(bs"boundary: signal frame overflow refused\n"); }
        }
    }
    boundary_memory();
    boundary_interrupts();
    boundary_spin();
    boundary_spin_end();
    svc5(93, 0, 0, 0, 0, 0);
}

const INTERRUPT_EINTR: usize = 0xFFFFFFFFFFFFFFFC;

// A child that sleeps `delay_ms`, sends `signum` to `target`, sleeps
// `linger_ms` more and exits 0. Returns its pid to the parent.
private fn interrupt_sender(target: usize, signum: usize, delay_ms: usize,
                            linger_ms: usize) -> usize !{unsafe} {
    let child: usize = svc5(220, 17, 0, 0, 0, 0);
    if (child != 0) { return child; }
    let mut pause: [usize; 2];
    pause[0] = 0;
    pause[1] = delay_ms * 1000000;
    svc5(101, pause as *usize as usize, 0, 0, 0, 0);
    svc5(129, target, signum, 0, 0, 0);
    if (linger_ms != 0) {
        pause[1] = linger_ms * 1000000;
        svc5(101, pause as *usize as usize, 0, 0, 0, 0);
    }
    svc5(93, 0, 0, 0, 0, 0);
    return 0;
}

private fn interrupt_reap(child: usize) -> bool !{unsafe} {
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0xFF; }
    return svc5(260, child, status as *u8 as usize, 0, 0, 0) == child &&
           status[0] == 0 && status[1] == 0;
}

private fn interrupt_seconds() -> usize !{unsafe} {
    let mut now: [usize; 2];
    svc5(113, 1, now as *usize as usize, 0, 0, 0);
    return now[0];
}

// GitHub issue #726: a caught signal ends a sleeping syscall, as on Linux.
// SIGUSR1's handler has no SA_RESTART, SIGUSR2's has; both count their
// runs in `ran`. Without the wake, each call below sleeps until its own
// end -- a four-second nanosleep returns 0, a wait4 returns the child --
// and the checks fail.
private fn boundary_interrupts() !{unsafe} {
    let mut action: [usize; 4];
    action[0] = signal_interrupt_handler as usize;
    action[1] = 0x04000000;
    action[2] = signal_boundary_restorer as usize;
    action[3] = 0;
    if (svc5(134, 10, action as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"boundary: FAIL interrupt sigaction\n");
        return;
    }
    action[1] = 0x14000000;
    if (svc5(134, 12, action as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"boundary: FAIL restart sigaction\n");
        return;
    }
    let me: usize = svc5(172, 0, 0, 0, 0, 0);
    let mut ran: [usize; 1];

    // nanosleep never restarts: EINTR even under SA_RESTART, with the
    // time that was left written to rem.
    let mut request: [usize; 2];
    request[0] = 4;
    request[1] = 0;
    let mut left: [usize; 2];
    left[0] = 99;
    left[1] = 0;
    let started: usize = interrupt_seconds();
    let sender: usize = interrupt_sender(me, 12, 100, 0);
    let slept: usize = signal_interrupt_svc(101, request as *usize as usize,
        left as *usize as usize, 0, 0, ran as *usize as usize);
    let elapsed: usize = interrupt_seconds() - started;
    if (slept != INTERRUPT_EINTR || ran[0] != 1 || elapsed > 2 ||
        left[0] > 3 || (left[0] == 0 && left[1] == 0) ||
        interrupt_reap(sender) == false) {
        boundary_fail(bs"boundary: FAIL nanosleep not interrupted\n");
        return;
    }
    boundary_line(bs"boundary: nanosleep interrupted: handler ran, EINTR, time left\n");

    // GitHub issue #432: clock_nanosleep(CLOCK_MONOTONIC) takes the same
    // deadline. Relative, a caught signal ends it with EINTR and the time
    // left in rem; with TIMER_ABSTIME it ends with EINTR and writes nothing
    // to rem, as on Linux. Both under SA_RESTART, which never reruns them.
    left[0] = 99;
    left[1] = 0;
    let relative_sender: usize = interrupt_sender(me, 12, 100, 0);
    let relative: usize = signal_interrupt_svc(115, 1, 0,
        request as *usize as usize, left as *usize as usize,
        ran as *usize as usize);
    if (relative != INTERRUPT_EINTR || ran[0] != 1 || left[0] > 3 ||
        (left[0] == 0 && left[1] == 0) ||
        interrupt_reap(relative_sender) == false) {
        boundary_fail(bs"boundary: FAIL clock_nanosleep not interrupted\n");
        return;
    }
    let mut deadline: [usize; 2];
    svc5(113, 1, deadline as *usize as usize, 0, 0, 0);
    deadline[0] = deadline[0] + 4;
    left[0] = 99;
    left[1] = 7;
    let absolute_sender: usize = interrupt_sender(me, 12, 100, 0);
    let absolute: usize = signal_interrupt_svc(115, 1, 1,
        deadline as *usize as usize, left as *usize as usize,
        ran as *usize as usize);
    if (absolute != INTERRUPT_EINTR || ran[0] != 1 || left[0] != 99 ||
        left[1] != 7 || interrupt_reap(absolute_sender) == false) {
        boundary_fail(bs"boundary: FAIL absolute clock_nanosleep not interrupted\n");
        return;
    }
    boundary_line(bs"boundary: clock_nanosleep interrupted: EINTR, time left when relative, rem untouched when absolute\n");

    // wait4 without SA_RESTART: EINTR, and the child is still there.
    let waited: usize = interrupt_sender(me, 10, 100, 300);
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0xFF; }
    let first: usize = signal_interrupt_svc(260, waited, status as *u8 as usize,
        0, 0, ran as *usize as usize);
    if (first != INTERRUPT_EINTR || ran[0] != 1 ||
        interrupt_reap(waited) == false) {
        boundary_fail(bs"boundary: FAIL wait4 not interrupted\n");
        return;
    }
    boundary_line(bs"boundary: wait4 interrupted: handler ran, EINTR\n");

    // wait4 under SA_RESTART: the handler runs, then the wait goes on.
    let restarted: usize = interrupt_sender(me, 12, 100, 300);
    for index: usize in 0..<4 { status[index] = 0xFF; }
    let reaped: usize = signal_interrupt_svc(260, restarted, status as *u8 as usize,
        0, 0, ran as *usize as usize);
    if (reaped != restarted || ran[0] != 1 || status[0] != 0) {
        boundary_fail(bs"boundary: FAIL wait4 not restarted\n");
        return;
    }
    boundary_line(bs"boundary: wait4 restarted under SA_RESTART after handler\n");

    // rt_sigtimedwait never restarts: a caught signal outside its set ends
    // it with EINTR even under SA_RESTART.
    let mut wait_set: [usize; 1];
    wait_set[0] = 1;
    let poker: usize = interrupt_sender(me, 12, 100, 0);
    let waited_signal: usize = signal_interrupt_svc(137, wait_set as *usize as usize,
        0, 0, 8, ran as *usize as usize);
    if (waited_signal != INTERRUPT_EINTR || ran[0] != 1 ||
        interrupt_reap(poker) == false) {
        boundary_fail(bs"boundary: FAIL rt_sigtimedwait not interrupted\n");
        return;
    }
    boundary_line(bs"boundary: rt_sigtimedwait interrupted: EINTR despite SA_RESTART\n");

    // ppoll never restarts. Its sleep here is the timeout alone (no
    // descriptors): a terminal wait could be ended by a byte on a real
    // UART line instead, which this fixture cannot exclude.
    let poll_started: usize = interrupt_seconds();
    let poller: usize = interrupt_sender(me, 12, 100, 0);
    let polled: usize = signal_interrupt_svc(73, 0, 0, request as *usize as usize,
        0, ran as *usize as usize);
    let poll_elapsed: usize = interrupt_seconds() - poll_started;
    if (polled != INTERRUPT_EINTR || ran[0] != 1 || poll_elapsed > 2 ||
        interrupt_reap(poller) == false) {
        boundary_fail(bs"boundary: FAIL ppoll not interrupted\n");
        return;
    }
    boundary_line(bs"boundary: ppoll interrupted: EINTR despite SA_RESTART\n");

    // GitHub issue #901 (c): a sigmask with descriptors is refused, not
    // ignored: the mask is not applied to a descriptor wait yet (#1225).
    let mut pollfd: [u8; 8];
    for index: usize in 0..<8 { pollfd[index] = 0; }
    pollfd[4] = 1;
    let mut poll_mask: [usize; 1];
    poll_mask[0] = 0;
    let mut no_wait: [usize; 2];
    no_wait[0] = 0;
    no_wait[1] = 0;
    if (svc5(73, pollfd as *u8 as usize, 1, no_wait as *usize as usize,
             poll_mask as *usize as usize, 8) != 0xFFFFFFFFFFFFFFEA) {
        boundary_fail(bs"boundary: FAIL ppoll with fds and a sigmask not refused\n");
        return;
    }
    boundary_line(bs"boundary: ppoll with descriptors and a sigmask: EINVAL until the mask is applied\n");
}

// Run on `cpu` alone: sched_setaffinity, then getcpu to see it took.
private fn spin_pin(cpu: {0..<2 as usize}) -> bool !{unsafe} {
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = (1 << cpu) as u8;
    if (svc5(122, 0, 8, mask as *u8 as usize, 0, 0) != 0) { return false; }
    let mut placed: [u8; 4];
    return svc5(168, placed as *u8 as usize, 0, 0, 0, 0) == 0 &&
           placed[0] == cpu as u8;
}

// A child on CPU 0 that sleeps 100 ms, sends `signum` to `target` (none
// for 0), sleeps `linger_ms` more and exits 0. Returns its pid.
private fn spin_sender(target: usize, signum: usize, linger_ms: usize) -> usize !{unsafe} {
    let child: usize = svc5(220, 17, 0, 0, 0, 0);
    if (child != 0) { return child; }
    if (spin_pin(0) == false) { svc5(93, 1, 0, 0, 0, 0); }
    let mut pause: [usize; 2];
    pause[0] = 0;
    pause[1] = 100000000;
    svc5(101, pause as *usize as usize, 0, 0, 0, 0);
    if (signum != 0) { svc5(129, target, signum, 0, 0, 0); }
    if (linger_ms != 0) {
        pause[1] = linger_ms * 1000000;
        svc5(101, pause as *usize as usize, 0, 0, 0, 0);
    }
    svc5(93, 0, 0, 0, 0, 0);
    return 0;
}

// GitHub issue #628: a handler runs at the return from the timer interrupt
// that preempts a process making no syscall, as on Linux, with every
// register of the interrupted context back afterwards. The spinner is on
// CPU 1 and its signal comes from CPU 0: first the SIGCHLD of a child that
// exits, then a kill(2). Without delivery at the interrupt return the spin
// runs out its bound and the check fails.
private fn boundary_spin() !{unsafe} {
    let mut action: [usize; 4];
    action[0] = signal_spin_handler as usize;
    action[1] = 0x14000000;
    action[2] = signal_boundary_restorer as usize;
    action[3] = 0;
    if (svc5(134, 17, action as *usize as usize, 0, 8, 0) != 0 ||
        svc5(134, 10, action as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"boundary: FAIL spin sigaction\n");
        return;
    }
    let mut everywhere: [u8; 8];
    if (svc5(123, 0, 8, everywhere as *u8 as usize, 0, 0) != 8) {
        boundary_fail(bs"boundary: FAIL spin getaffinity\n");
        return;
    }
    let me: usize = svc5(172, 0, 0, 0, 0, 0);
    // GitHub issue #950: the handler, run at a syscall return outside the
    // spin, leaves the caller's x21 alone.
    if (signal_spin_stray(me, 10) != 0) {
        boundary_fail(bs"boundary: FAIL spin handler bumped x21 outside the spin\n");
        return;
    }
    boundary_line(bs"boundary: spin handler outside the spin left x21 alone\n");
    for case: usize in 0..<2 {
        let mut signum: usize = 0;
        let mut linger: usize = 0;
        if (case == 1) { signum = 10; linger = 500; }
        let sender: usize = spin_sender(me, signum, linger);
        if (spin_pin(1) == false) {
            boundary_fail(bs"boundary: FAIL spin pin\n");
            return;
        }
        let spun: usize = signal_spin_run();
        if (spun == 1) {
            boundary_fail(bs"boundary: FAIL spinning process never ran its handler\n");
            return;
        }
        if (spun != 0) {
            boundary_fail(bs"boundary: FAIL spinning process lost its registers\n");
            return;
        }
        if (svc5(122, 0, 8, everywhere as *u8 as usize, 0, 0) != 0) {
            boundary_fail(bs"boundary: FAIL spin unpin\n");
            return;
        }
        if (interrupt_reap(sender) == false) {
            boundary_fail(bs"boundary: FAIL spin sender\n");
            return;
        }
        if (case == 0) {
            boundary_line(bs"boundary: spinning process ran its SIGCHLD handler, registers intact\n");
        } else {
            boundary_line(bs"boundary: kill from CPU 0 ran a handler on spinning CPU 1, registers intact\n");
        }
    }
}

// The wait4 status word of `child` once it has ended, polled every 10 ms
// for up to two seconds; 0xFFFF when it is still alive then.
private fn spin_end_status(child: usize) -> usize !{unsafe} {
    let mut pause: [usize; 2];
    pause[0] = 0;
    pause[1] = 10000000;
    for poll: usize in 0..<200 {
        let mut status: [u8; 4];
        for index: usize in 0..<4 { status[index] = 0xFF; }
        if (svc5(260, child, status as *u8 as usize, 1, 0, 0) == child) {
            return (status[0] as usize) | ((status[1] as usize) << 8);
        }
        svc5(101, pause as *usize as usize, 0, 0, 0, 0);
    }
    return 0xFFFF;
}

// GitHub issue #949: what ends a process at the return to EL0 ends a
// spinning one at its next interrupt return, as on Linux: a signal whose
// default action terminates, and a caught signal whose frame cannot be
// written (SIGSEGV). The spinner is on CPU 1, the sender on CPU 0.
// SIGTERM is blocked from the spinner's birth until the call that unblocks
// it, after which it makes no syscall, so without delivery at the interrupt
// return nothing ever ends it and the two-second wait fails. The bad-SP
// spinner cannot be ordered that way, since that unblock's own return would
// meet the bad stack; a signal that comes before its spin runs a handler
// that exits 3 instead, and the case is tried again.
private fn boundary_spin_end() !{unsafe} {
    let mut everywhere: [u8; 8];
    if (svc5(123, 0, 8, everywhere as *u8 as usize, 0, 0) != 8) {
        boundary_fail(bs"boundary: FAIL spin-end getaffinity\n");
        return;
    }
    let mut term_set: [usize; 1];
    term_set[0] = 1 << 14;
    if (svc5(135, 0, term_set as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"boundary: FAIL spin-end block\n");
        return;
    }
    let spinner: usize = svc5(220, 17, 0, 0, 0, 0);
    if (spinner == 0) {
        if (spin_pin(1) == false) { svc5(93, 1, 0, 0, 0, 0); }
        signal_spin_forever(term_set as *usize as usize, 0);
        svc5(93, 1, 0, 0, 0, 0);
        return;
    }
    if (svc5(135, 1, term_set as *usize as usize, 0, 8, 0) != 0 ||
        spinner >= 0xFFFFFFFFFFFFF000 || spin_pin(0) == false) {
        boundary_fail(bs"boundary: FAIL spin-end setup\n");
        return;
    }
    let mut pause: [usize; 2];
    pause[0] = 0;
    pause[1] = 100000000;
    svc5(101, pause as *usize as usize, 0, 0, 0, 0);
    svc5(129, spinner, 15, 0, 0, 0);
    if (spin_end_status(spinner) != 15) {
        boundary_fail(bs"boundary: FAIL spinning process outlived SIGTERM\n");
        return;
    }
    boundary_line(bs"boundary: SIGTERM from CPU 0 ended spinning CPU 1\n");
    let mut segv: bool = false;
    for attempt: usize in 0..<3 {
        if (segv == false) {
            let child: usize = svc5(220, 17, 0, 0, 0, 0);
            if (child == 0) {
                let mut action: [usize; 4];
                action[0] = signal_exit_handler as usize;
                action[1] = 0x04000000;
                action[2] = signal_boundary_restorer as usize;
                action[3] = 0;
                if (svc5(134, 10, action as *usize as usize, 0, 8, 0) != 0 ||
                    spin_pin(1) == false) {
                    svc5(93, 1, 0, 0, 0, 0);
                }
                signal_spin_forever(0, 1);
                svc5(93, 1, 0, 0, 0, 0);
                return;
            }
            if (child >= 0xFFFFFFFFFFFFF000) {
                boundary_fail(bs"boundary: FAIL spin-end fork\n");
                return;
            }
            svc5(101, pause as *usize as usize, 0, 0, 0, 0);
            svc5(129, child, 10, 0, 0, 0);
            let status: usize = spin_end_status(child);
            if (status == 11) {
                segv = true;
            } else if (status != 0x300) {
                boundary_fail(bs"boundary: FAIL spinning process with a bad stack outlived its signal\n");
                return;
            }
        }
    }
    if (segv == false ||
        svc5(122, 0, 8, everywhere as *u8 as usize, 0, 0) != 0) {
        boundary_fail(bs"boundary: FAIL spin-end bad stack never reached its spin\n");
        return;
    }
    boundary_line(bs"boundary: unwritable handler frame ended spinning CPU 1 by SIGSEGV\n");
}

// GitHub issue #948: a read sleeping on the terminal is ended by a caught
// signal -- EINTR without SA_RESTART, and under SA_RESTART the read goes on
// and returns the byte typed after it. /bin/signal-terminal is this entry;
// the ash lane runs it only on QEMU (the driver's --terminal-read-rows),
// since a stray byte on the board's physical UART line would end the read
// with data instead and take a byte the shell expects. The board runs
// /bin/signal-terminal-skip, which says so.
//
// The SA_RESTART row's handler prints "signal-terminal: handler ran", and
// the driver types the byte only after that line, so the byte cannot come
// before the signal: the read the handler restarted is the one that
// returns it, whether the byte is already queued or arrives later.
fn signal_terminal_probe() !{unsafe} {
    let mut action: [usize; 4];
    action[0] = signal_interrupt_handler as usize;
    action[1] = 0x04000000;
    action[2] = signal_boundary_restorer as usize;
    action[3] = 0;
    if (svc5(134, 10, action as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"signal-terminal: FAIL interrupt sigaction\n");
        return;
    }
    action[0] = signal_terminal_handler as usize;
    action[1] = 0x14000000;
    if (svc5(134, 12, action as *usize as usize, 0, 8, 0) != 0) {
        boundary_fail(bs"signal-terminal: FAIL restart sigaction\n");
        return;
    }
    let me: usize = svc5(172, 0, 0, 0, 0, 0);
    let mut ran: [usize; 1];
    let mut byte: [u8; 1];
    byte[0] = 0;

    // Without SA_RESTART: EINTR, nothing read.
    let interrupter: usize = interrupt_sender(me, 10, 100, 0);
    let first: usize = signal_interrupt_svc(63, 0, byte as *u8 as usize, 1, 0,
        ran as *usize as usize);
    if (first != INTERRUPT_EINTR || ran[0] != 1 ||
        interrupt_reap(interrupter) == false) {
        boundary_fail(bs"signal-terminal: FAIL read not interrupted\n");
        return;
    }
    boundary_line(bs"signal-terminal: read interrupted: handler ran, EINTR\n");

    // Under SA_RESTART: the handler runs, the read blocks again, and it
    // returns the byte the driver types then.
    let restarter: usize = svc5(220, 17, 0, 0, 0, 0);
    if (restarter == 0) {
        let mut pause: [usize; 2];
        pause[0] = 0;
        pause[1] = 100000000;
        svc5(101, pause as *usize as usize, 0, 0, 0, 0);
        svc5(129, me, 12, 0, 0, 0);
        svc5(93, 0, 0, 0, 0, 0);
        return;
    }
    if (restarter >= 0xFFFFFFFFFFFFF000) {
        boundary_fail(bs"signal-terminal: FAIL fork\n");
        return;
    }
    let second: usize = signal_interrupt_svc(63, 0, byte as *u8 as usize, 1, 0,
        ran as *usize as usize);
    if (second != 1 || byte[0] != 0x0A || ran[0] != 1 ||
        interrupt_reap(restarter) == false) {
        boundary_fail(bs"signal-terminal: FAIL read not restarted\n");
        return;
    }
    boundary_line(bs"signal-terminal: read restarted under SA_RESTART, then read the typed byte\n");
    svc5(93, 0, 0, 0, 0, 0);
}

fn signal_terminal_skip() !{unsafe} {
    boundary_line(bs"signal-terminal: rows not run on the board: a stray byte on its UART line would end the read\n");
    svc5(93, 0, 0, 0, 0, 0);
}
