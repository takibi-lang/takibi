/* GitHub issue #246/#248: the closing-bar demonstration -- a real EL0
 * program proving more than 3 concurrently scheduled processes without
 * recompiling with a larger constant (KERNEL_PROCESS_MAX moved from 3 to
 * 16 as part of issue #246; this fixture only needs to exceed 3, not
 * approach that new ceiling).
 *
 * A shell's background-job fan-out (`cmd1 & cmd2 & cmd3 &`) cannot produce
 * this: kernel/kernel/process.tkb's kernel_process_clone_begin() rejects
 * a second clone() from a parent that already has one live child, so no
 * single process can fan out to several concurrent children. The only way
 * to get more than 2 processes simultaneously live is a genuine parent ->
 * child -> grandchild -> ... chain, each level blocked in wait4() for the
 * next -- the same shape kernel/arch/arm64/kernel/user_payload.tkb's own
 * single extra clone() level (issue #241) already established, extended
 * here to CHAIN_DEPTH levels. This specific shape (every intermediate
 * level ALSO calling wait4(), not just the root) needed issue #248's own
 * fix first: wait4() used to be rejected outright for any caller that was
 * itself a child, and the child-exit/wait bookkeeping was global scalar
 * state that a second, simultaneously-blocked waiter deeper in the chain
 * would have silently corrupted.
 *
 * Launched from kernel/init/main.tkb as an ordinary external command via
 * ash, through kernel/tests/ext2/clone_chain.sh (a direct script-line
 * exec, the same proven mechanism kernel/tests/ext2/init.sh already uses
 * for /user_payload) -- NOT `sh -c "/clone_chain; ..."`: that combination
 * (a freshly-built, never-before-loaded custom ELF launched via `sh -c`)
 * hung the kernel on real hardware with zero UART output, root-caused to
 * ash/busybox's own handling of that specific combination, not a kernel
 * bug -- switching to a direct script line fixed it immediately. ash is
 * the root of the chain, and this program's own recursive clone()s are
 * the remaining links, the same division of labor issue #241's 3-level
 * tree already used for its one extra level.
 *
 * Deliberately minimal (no scheduler-preemption probing, no socket/file
 * exercises) -- user_payload.tkb already covers those; this fixture's
 * only job is proving CHAIN_DEPTH + 1 processes are simultaneously live
 * at the deepest point, verified from the kernel side via
 * kernel_process_peak_concurrent_count() (see kernel/kernel/process.tkb),
 * not from anything this program itself reports.
 */

const AARCH64_NR_CLONE: usize = 220;
const AARCH64_NR_WAIT4: usize = 260;
const AARCH64_NR_EXIT: usize = 93;
const CLONE_FLAGS_PLAIN_FORK: usize = 0x11;
// 5 clone()s form a 6-process chain (levels 0..5), all simultaneously
// live at the moment level 5 is created: each of levels 0-4 is blocked in
// its own wait4() for the next level's child, exactly like
// user_payload.tkb's own parent already does for its one child. Plus ash
// itself (the process that forked level 0), that is 7 total -- comfortably
// past the old ceiling of 3 without needing to approach the new one (16).
const CHAIN_DEPTH: usize = 5;

/* GitHub issue #241: the real ELF this file links into carries its own
 * e_entry (set via the linker's -e initial_user_payload), matching
 * user_payload.tkb's own convention -- separate ELF, so no name clash. */
fn initial_user_payload() {
    let mut level: usize = 0;
    while (level < CHAIN_DEPTH) {
        let pid: usize = svc5(AARCH64_NR_CLONE, CLONE_FLAGS_PLAIN_FORK,
                              0, 0, 0, 0);
        if (pid == 0) {
            /* Child: go one level deeper, forking again next iteration. */
            level = level + 1;
        } else {
            /* Parent: block until this one child (and, transitively,
             * every level below it) has fully exited, then exit myself.
             * This is what keeps every level of the chain simultaneously
             * live from the child's creation until its own exit. */
            svc5(AARCH64_NR_WAIT4, pid, 0, 0, 0, 0);
            svc5(AARCH64_NR_EXIT, 0, 0, 0, 0, 0);
            return;
        }
    }
    /* The deepest child (level == CHAIN_DEPTH): nothing more to spawn. */
    svc5(AARCH64_NR_EXIT, 0, 0, 0, 0, 0);
}
