use "kernel/platform/rpi5/intc.tkb";
use "kernel/arch/arm64/kernel/fpsimd_probe_extern.tkb";

// GitHub issue #227 item 1 (prototype slice): the exception frame this
// kernel's resumable Current-EL-SPx and Lower-EL-AArch64 IRQ entries use,
// declared once in .tkb instead of kernel/arch/arm64/kernel/
// exception_context.inc's hand-written EXC_CONTEXT_SAVE/EXC_CONTEXT_RESTORE
// macro pair. Field order matches that .inc file's byte layout exactly
// (x0..x30, sp_el0, elr_el1, spsr_el1, q0..q31, fpsr, fpcr) so this struct's
// own computed layout is byte-identical to the frame every existing
// .Ldata_abort/el0_context_resume/run_initial_user hand-written call site
// (kernel/arch/arm64/kernel/user_entry.S) still reads and writes via that
// macro pair -- field order does not actually have to match for
// exception_entry's own generated code to be correct (offsets come from
// whatever order a struct declares), but keeping it identical here means
// there is still only ONE real frame shape in this kernel, not two
// coincidentally-matching ones.
//
// q0..q31 are [u8; 16]: this language has no 128-bit primitive type, and
// storing 16 raw bytes needs none -- SPEC.md's own array-field support
// already covers it exactly.
struct packed ExceptionFrame {
    x0: usize; x1: usize; x2: usize; x3: usize; x4: usize; x5: usize;
    x6: usize; x7: usize; x8: usize; x9: usize; x10: usize; x11: usize;
    x12: usize; x13: usize; x14: usize; x15: usize; x16: usize; x17: usize;
    x18: usize; x19: usize; x20: usize; x21: usize; x22: usize; x23: usize;
    x24: usize; x25: usize; x26: usize; x27: usize; x28: usize; x29: usize;
    x30: usize;
    sp_el0: usize; elr_el1: usize; spsr_el1: usize;
    q0: [u8; 16]; q1: [u8; 16]; q2: [u8; 16]; q3: [u8; 16]; q4: [u8; 16];
    q5: [u8; 16]; q6: [u8; 16]; q7: [u8; 16]; q8: [u8; 16]; q9: [u8; 16];
    q10: [u8; 16]; q11: [u8; 16]; q12: [u8; 16]; q13: [u8; 16]; q14: [u8; 16];
    q15: [u8; 16]; q16: [u8; 16]; q17: [u8; 16]; q18: [u8; 16]; q19: [u8; 16];
    q20: [u8; 16]; q21: [u8; 16]; q22: [u8; 16]; q23: [u8; 16]; q24: [u8; 16];
    q25: [u8; 16]; q26: [u8; 16]; q27: [u8; 16]; q28: [u8; 16]; q29: [u8; 16];
    q30: [u8; 16]; q31: [u8; 16];
    fpsr: usize; fpcr: usize;
}

// Current-EL-SPx IRQ entry (GitHub issue #187 originally; #223 widened the
// frame to include FP/SIMD; #227 item 1 replaces the hand-written version
// entirely). `before: fpsimd_irq_clobber` runs after the frame save,
// before dispatch, matching entry.S's own former ordering exactly (see
// that hook's own comment in fpsimd_probe_extern.tkb).
exception_entry el1_current_irq_entry {
    frame: ExceptionFrame;
    before: fpsimd_irq_clobber;
    dispatch: rpi5_irq_dispatch;
}

// Lower-EL AArch64 IRQ entry: the same frame, no fixture hook.
exception_entry el0_irq_entry {
    frame: ExceptionFrame;
    dispatch: rpi5_el0_irq_dispatch;
}
