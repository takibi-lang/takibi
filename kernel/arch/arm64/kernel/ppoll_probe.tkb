/* A ppoll on the terminal beside a runnable process. A static-PIE EL0
 * program, kept free of writable globals and compiled with --forbid-trap.
 *
 * /bin/ppoll-probe forks. The child asks ppoll for fd 0 with no timeout and
 * no mask, the BusyBox shape, then reads the byte that made it readable. The
 * parent stays runnable at EL0 until the child is gone, so the child's wait
 * has somewhere to give the CPU. The kernel says when that ppoll blocks, and
 * the lane's driver types the byte only after it does. A kernel that retried
 * the ppoll in EL1 instead never says so, and the probe then waits for a
 * byte nobody sends.
 *
 * GitHub issue #9: a stdin ppoll used to retry in EL1 however many other
 * processes were Ready, the same hog syscall_deadline_wait had.
 *
 * GitHub issue #870: then a second child calls ppoll(0, NULL), musl's
 * pause(). The kernel says when that wait blocked, the driver then types a
 * byte for the parent, and the parent sends SIGTERM, which has to wake the
 * child Blocked in the wait and end it. A kernel that kept the pause Running
 * in an EL1 wait never says it blocked, and the parent waits for a byte
 * nobody sends.
 */

const READ_SYSCALL: usize = 63;
const WRITE_SYSCALL: usize = 64;
const PPOLL_SYSCALL: usize = 73;
const EXIT_SYSCALL: usize = 93;
const CLONE_SYSCALL: usize = 220;
const WAIT4_SYSCALL: usize = 260;
const KILL_SYSCALL: usize = 129;
const SIGTERM: usize = 15;
const CLONE_FORK_SIGCHLD: usize = 0x11;
const WNOHANG: usize = 1;
const POLLIN: u8 = 1;
const PPOLL_PROBE_ERROR_FLOOR: usize = 0xFFFFFFFFFFFFF000;
const PPOLL_PROBE_PAUSE: usize = 65536;

private fn ppoll_probe_say(line: borrow []const u8) !{unsafe} {
    // Raw ABI input only: these syscalls read the readonly bytes.
    // The bridge exposes no writable slice or checked mutation.
    svc5(WRITE_SYSCALL, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
}

private fn ppoll_probe_child() {
    let mut pollfd: [u8; 8];
    for index: usize in 0..<8 { pollfd[index] = 0; }
    pollfd[4] = POLLIN;
    let mut byte: [u8; 1];
    let ready: usize = svc5(PPOLL_SYSCALL, pollfd as *u8 as usize, 1, 0, 0, 0);
    if (ready != 1 || (pollfd[6] & POLLIN) == 0) {
        svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
    }
    if (svc5(READ_SYSCALL, 0, byte as *u8 as usize, 1, 0, 0) != 1) {
        svc5(EXIT_SYSCALL, 2, 0, 0, 0, 0);
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}

// pause(): no fds, no timeout, no mask. Only a signal ends it, and this
// child catches none, so its only way out is the parent's SIGTERM.
private fn ppoll_probe_pause_child() {
    svc5(PPOLL_SYSCALL, 0, 0, 0, 0, 0);
    svc5(EXIT_SYSCALL, 3, 0, 0, 0, 0);
}

private fn ppoll_probe_pause() {
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) { ppoll_probe_pause_child(); }
    if (child >= PPOLL_PROBE_ERROR_FLOOR) {
        ppoll_probe_say(bs"ppoll-probe: pause fork failed\n");
        svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
    }
    // The driver types this byte once the kernel says the pause blocked.
    let mut byte: [u8; 1];
    if (svc5(READ_SYSCALL, 0, byte as *u8 as usize, 1, 0, 0) != 1) {
        ppoll_probe_say(bs"ppoll-probe: pause read failed\n");
    }
    svc5(KILL_SYSCALL, child, SIGTERM, 0, 0, 0);
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0; }
    let reaped: usize = svc5(WAIT4_SYSCALL, child, status as *u8 as usize, 0,
                             0, 0);
    // This kernel reports a signal's end as exit status 128 + signal
    // (kernel/SYSCALLS.md, kill); Linux's own form is accepted too.
    let by_signal: bool = status[0] as usize == SIGTERM && status[1] == 0;
    let by_status: bool = status[0] == 0 && status[1] as usize == 128 + SIGTERM;
    if (reaped == child && (by_signal || by_status)) {
        ppoll_probe_say(
            bs"ppoll-probe: pause() blocked until SIGTERM ended it\n");
        svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
    }
    ppoll_probe_say(bs"ppoll-probe: pause() did not end by SIGTERM\n");
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}

fn ppoll_probe() {
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) { ppoll_probe_child(); }
    if (child >= PPOLL_PROBE_ERROR_FLOOR) {
        ppoll_probe_say(bs"ppoll-probe: fork failed\n");
        svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
    }
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0; }
    // WNOHANG keeps this parent Ready rather than Blocked, which is the
    // condition the child's ppoll is asked under. The pause between polls is
    // arithmetic at EL0, not syscalls, so this parent is runnable nearly all
    // of the time. The sum is tested below so the pause is not optimized away.
    let mut spin: usize = 0x9E3779B97F4A7C15;
    let mut reaped: usize = 0;
    while (reaped == 0) {
        reaped = svc5(WAIT4_SYSCALL, child, status as *u8 as usize, WNOHANG,
                      0, 0);
        if (reaped == 0) {
            for pause: usize in 0..<PPOLL_PROBE_PAUSE {
                spin = spin ^ (spin << 13);
                spin = spin ^ (spin >> 7);
                spin = spin ^ (spin << 17);
            }
        }
    }
    if (spin == 0) { ppoll_probe_say(bs"ppoll-probe: the pause collapsed\n"); }
    if (reaped == child && status[0] == 0 && status[1] == 0) {
        ppoll_probe_say(
            bs"ppoll-probe: fd 0 became readable and the child read its byte\n");
        ppoll_probe_pause();
    }
    ppoll_probe_say(bs"ppoll-probe: the child's ppoll or read failed\n");
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}
