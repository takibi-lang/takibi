/* fork on a peer (GitHub issue #611). A static-PIE EL0 program, kept free
 * of writable globals and compiled with --forbid-trap, run once from
 * init.sh.
 *
 * It forks twice. Each child exits with the number of the CPU it ran on,
 * and the parent reaps it with wait4 and checks that status, so both
 * processes are known to have run. After each reap the parent asks the
 * kernel (workload tag 19) where the fork ran.
 *
 * The first fork is pinned to CPU 0, and its answer must be 2: the negative
 * control, showing the report tells a core-0 fork apart. The second is
 * pinned to CPU 1; its child must report CPU 1 and the answer must be 1,
 * and the kernel prints the peer_fork view's line. It prints nothing
 * itself unless it fails.
 */

const WRITE_SYSCALL: usize = 64;
const EXIT_SYSCALL: usize = 93;
const CLONE_SYSCALL: usize = 220;
const WAIT4_SYSCALL: usize = 260;
const SETAFFINITY_SYSCALL: usize = 122;
const GETCPU_SYSCALL: usize = 168;
const WORKLOAD_PROGRESS_SYSCALL: usize = 453;
const CLONE_FORK_SIGCHLD: usize = 0x11;
const PEER_FORK_TAG: usize = 19;
const PEER_FORK_ON_PEER: usize = 1;
const PEER_FORK_ON_CORE0: usize = 2;
const PEER_FORK_ERROR_FLOOR: usize = 0xFFFFFFFFFFFFF000;
const PEER_FORK_ARRIVAL_POLLS: usize = 1000000;

private fn peer_fork_fail(line: borrow []const u8) !{unsafe} {
    // Raw ABI input only: these syscalls read the readonly bytes.
    // The bridge exposes no writable slice or checked mutation.
    svc5(WRITE_SYSCALL, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}

private fn peer_fork_cpu() -> u8 {
    let mut cpu_bytes: [u8; 4];
    cpu_bytes[0] = 99;
    if (svc5(GETCPU_SYSCALL, cpu_bytes as *u8 as usize, 0, 0, 0, 0) != 0) {
        return 99;
    }
    return cpu_bytes[0];
}

// Pin to one CPU and wait until this process is running there.
private fn peer_fork_move_to(cpu: u8) {
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = (1 << cpu) as u8;
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask as *u8 as usize, 0, 0) != 0) {
        peer_fork_fail(bs"peer-fork: the affinity mask was refused\n");
    }
    let mut here: u8 = peer_fork_cpu();
    for poll: usize in 0..<PEER_FORK_ARRIVAL_POLLS {
        if (here != cpu) { here = peer_fork_cpu(); }
    }
    if (here != cpu) {
        peer_fork_fail(bs"peer-fork: never arrived on the pinned cpu\n");
    }
}

// Fork; the child exits with its CPU number, and the parent reaps it and
// answers the kernel's verdict on where the fork ran.
private fn peer_fork_round(cpu: u8) -> usize {
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        svc5(EXIT_SYSCALL, peer_fork_cpu() as usize, 0, 0, 0, 0);
    }
    if (child >= PEER_FORK_ERROR_FLOOR) {
        peer_fork_fail(bs"peer-fork: fork failed\n");
    }
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0xFF; }
    if (svc5(WAIT4_SYSCALL, child, status as *u8 as usize, 0, 0, 0) != child ||
        status[0] != 0 || status[1] != cpu) {
        peer_fork_fail(bs"peer-fork: wait4 did not reap a child that ran on the pinned cpu\n");
    }
    return svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_FORK_TAG, 0, 0, 0, 0);
}

fn peer_fork() {
    peer_fork_move_to(0);
    if (peer_fork_round(0) != PEER_FORK_ON_CORE0) {
        peer_fork_fail(bs"peer-fork: a fork on cpu 0 was not reported as core 0's\n");
    }
    peer_fork_move_to(1);
    if (peer_fork_round(1) != PEER_FORK_ON_PEER) {
        peer_fork_fail(bs"peer-fork: the fork on cpu 1 did not run there\n");
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}
