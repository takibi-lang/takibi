/* GitHub issue #533: a bounded read-only filesystem workload admitted to
 * the secondary CPU. This is a standalone static-PIE EL0 program, kept free
 * of writable globals and compiled with --forbid-trap.
 *
 * The fixture contains exactly 96 KiB of 'Z'. Each attempt opens it afresh
 * and accepts all 96 chunks only when getcpu() brackets every read on the
 * platform's admitted secondary CPU.
 * A migration invalidates that attempt instead of attributing its bytes to
 * the peer. The kernel validates the final byte count, checksum, placement,
 * and real block-device lock contention before asking this one-shot process
 * to exit.
 */

const OPENAT_SYSCALL: usize = 56;
const CLOSE_SYSCALL: usize = 57;
const READ_SYSCALL: usize = 63;
const EXIT_SYSCALL: usize = 93;
const GETCPU_SYSCALL: usize = 168;
const WORKLOAD_PROGRESS_SYSCALL: usize = 453;
const PEER_READ_TAG: usize = 3;
const PEER_READ_CHUNK: usize = 1024;
const PEER_READ_CHUNKS: usize = 96;
const PEER_READ_ATTEMPTS: usize = 64;
const PEER_READ_CHECKSUM: usize = 8847360;
const WRITE_SYSCALL: usize = 64;
const PEER_CONSOLE_TAG: usize = 4;
const PEER_CONSOLE_POLL_PAUSE: usize = 1048576;
const PEER_TTY_TAG: usize = 5;
const SETAFFINITY_SYSCALL: usize = 122;
const NANOSLEEP_SYSCALL: usize = 101;
const PEER_TTY_LINE_MAX: usize = 64;
const UNAME_SYSCALL: usize = 160;
const SYSINFO_SYSCALL: usize = 179;
// struct utsname is six 65-byte fields; `machine` is the fifth, so it starts
// at 4 * 65. struct sysinfo is 112 bytes on aarch64 and this kernel fills
// only its first word, the uptime.
const PEER_IDENT_UTSNAME_BYTES: usize = 390;
const PEER_IDENT_MACHINE_OFFSET: usize = 260;
const PEER_IDENT_MACHINE_BYTES: usize = 7;
const PEER_IDENT_SYSINFO_BYTES: usize = 112;
const PEER_IDENT_SYSINFO_UPTIME_BYTES: usize = 8;
const GETCWD_SYSCALL: usize = 17;
const SET_TID_ADDRESS_SYSCALL: usize = 96;
const GETPID_SYSCALL: usize = 172;
const PRLIMIT64_SYSCALL: usize = 261;
const PEER_IDENT_CWD_BYTES: usize = 8;
// struct rlimit64 is two 8-byte words: the soft limit then the hard one.
const PEER_IDENT_RLIMIT_BYTES: usize = 16;
const PEER_IDENT_RLIMIT_NOFILE: usize = 7;
const CHDIR_SYSCALL: usize = 49;
const SETITIMER_SYSCALL: usize = 103;
const RT_SIGACTION_SYSCALL: usize = 134;
// struct itimerval is two timevals, and struct sigaction is 32 bytes on
// aarch64. Both come back zero-filled, which is what makes an untouched
// 0xFF buffer a failure rather than a pass.
const PEER_IDENT_ITIMER_BYTES: usize = 32;
const PEER_IDENT_SIGACTION_BYTES: usize = 32;
const PEER_IDENT_SIGACTION_SIGNUM: usize = 15;

private fn peer_read_cpu(cpu_bytes: borrow [u8; 4..]) -> usize {
    if (svc5(GETCPU_SYSCALL, cpu_bytes as *u8 as usize, 0, 0, 0, 0) != 0) {
        return 99;
    }
    return cpu_bytes[0] as usize |
           ((cpu_bytes[1] as usize) << 8) |
           ((cpu_bytes[2] as usize) << 16) |
           ((cpu_bytes[3] as usize) << 24);
}

fn peer_read() {
    let mut cpu_bytes: [u8; 4];
    let mut buffer: [u8; PEER_READ_CHUNK];

    // The busy-pair replacement enters only after peer exit. Registration
    // still happens before open(), so every operation remains constrained.
    let peer_cpu: usize = svc5(
        WORKLOAD_PROGRESS_SYSCALL, PEER_READ_TAG, 0, 0, 0, 0);
    if (peer_cpu == 0) { svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0); }
    // Registration excludes this pid from CPU 0 at the next scheduler
    // selection. Do not spend the bounded read attempts before that handoff.
    while (peer_read_cpu(cpu_bytes as []u8) != peer_cpu) {}

    for attempt: usize in 0..<PEER_READ_ATTEMPTS {
        let mut valid: bool = peer_read_cpu(cpu_bytes as []u8) == peer_cpu;
        let mut bytes: usize = 0;
        let mut checksum: usize = 0;
        if (valid) {
            let fd: usize = svc5(OPENAT_SYSCALL, 0,
                                  "/peer-read.bin" as *u8 as usize,
                                  0, 0, 0);
            for chunk: usize in 0..<PEER_READ_CHUNKS {
                if (valid) {
                    if (peer_read_cpu(cpu_bytes as []u8) != peer_cpu) {
                        valid = false;
                    } else {
                        let got: usize = svc5(READ_SYSCALL, fd,
                                              buffer as *u8 as usize,
                                              PEER_READ_CHUNK, 0, 0);
                        if (got != PEER_READ_CHUNK ||
                            peer_read_cpu(cpu_bytes as []u8) != peer_cpu) {
                            valid = false;
                        } else {
                            for index: usize in 0..<PEER_READ_CHUNK {
                                if (buffer[index] != 90) { valid = false; }
                                checksum = checksum + 90;
                            }
                            bytes = bytes + got;
                        }
                    }
                }
            }
            svc5(CLOSE_SYSCALL, fd, 0, 0, 0, 0);
            if (valid && bytes == PEER_READ_CHUNK * PEER_READ_CHUNKS &&
                checksum == PEER_READ_CHECKSUM) {
                if (svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_READ_TAG,
                         bytes, checksum, 0, 0) == 2) {
                    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
                }
            }
        }
    }
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}

fn core_read() {
    let mut cpu_bytes: [u8; 4];
    let mut buffer: [u8; PEER_READ_CHUNK];
    // The competing reader is the core-0 half of the evidence. It may have
    // been dispatched just before peer registration narrows CPU 1.
    while (peer_read_cpu(cpu_bytes as []u8) != 0) {}
    for attempt: usize in 0..<64 {
        let fd: usize = svc5(OPENAT_SYSCALL, 0,
                              "/peer-read.bin" as *u8 as usize,
                              0, 0, 0);
        for chunk: usize in 0..<PEER_READ_CHUNKS {
            svc5(READ_SYSCALL, fd, buffer as *u8 as usize,
                 PEER_READ_CHUNK, 0, 0);
        }
        svc5(CLOSE_SYSCALL, fd, 0, 0, 0, 0);
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}

// GitHub issue #9: a fixture places itself now. Its progress handler names
// the CPU when its turn comes, and this asks the scheduler to keep it
// there. One bit per CPU, and KERNEL_MAX_CORES is four, so four answers
// cover every mask this can need; a runtime shift would need a bound the
// compiler cannot see under --forbid-trap.
private fn peer_cpu_bit(cpu: usize) -> u8 {
    if (cpu == 0) { return 1; }
    if (cpu == 1) { return 2; }
    if (cpu == 2) { return 4; }
    if (cpu == 3) { return 8; }
    return 0;
}

private fn peer_pin(cpu: usize) -> bool {
    let bit: u8 = peer_cpu_bit(cpu);
    if (bit == 0) { return false; }
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = bit;
    return svc5(SETAFFINITY_SYSCALL, 0, 8, mask as *u8 as usize, 0, 0) == 0;
}

// GitHub issue #534: a real EL0 writer on the admitted peer. Each line is
// exactly one 64-byte publication record. The single first write asks for
// seventeen records, one more than the ring can hold, and must therefore be
// short. Retrying from the returned offset proves the byte count names data
// that has a defined place in the stream rather than data silently dropped.
fn peer_console() {
    let mut cpu_bytes: [u8; 4];
    let output = bs"peer user console: record=01/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=02/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=03/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=04/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=05/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=06/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=07/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=08/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=09/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=10/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=11/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=12/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=13/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=14/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=15/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=16/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\npeer user console: record=17/17 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n";
    // The kernel answers 0 while it is not this writer's turn: init starts
    // it long before the filesystem reader's verdict. Wait by SLEEPING
    // rather than by arithmetic. This wait happens on core 0, beside the
    // busy pair, and a third runnable process there spoils the fairness
    // that pair measures: spinning here took it to 27 slices against 1,
    // skew 8 past its bound of 4. A nap blocks while anything else is
    // Ready, so core 0 goes back to the pair. The poll after the writer's
    // view keeps its arithmetic pause, which #534's late UART BREAK needs
    // to find that CPU in EL0. Then pin to the CPU this answer names
    // (GitHub issue #9).
    let mut nap: [u8; 16];
    for index: usize in 0..<16 { nap[index] = 0; }
    // tv_sec = 0, tv_nsec = 1000000 (0x000F4240), little-endian.
    nap[8] = 0x40;
    nap[9] = 0x42;
    nap[10] = 0x0F;
    let mut spin: usize = 0x9E3779B97F4A7C15;
    let mut peer_cpu: usize = 0;
    while (peer_cpu == 0) {
        peer_cpu = svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_CONSOLE_TAG,
                        0, 0, 0, 0);
        if (peer_cpu == 0) {
            svc5(NANOSLEEP_SYSCALL, nap as *u8 as usize, 0, 0, 0, 0);
        }
    }
    if (peer_pin(peer_cpu) == false) { svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0); }
    while (peer_read_cpu(cpu_bytes as []u8) != peer_cpu) {}

    let first: usize = svc5(WRITE_SYSCALL, 1,
                              output as *u8 as usize, output.len, 0, 0);
    let mut total: usize = first;
    while (total < output.len) {
        let wrote: usize = svc5(
            WRITE_SYSCALL, 1, output as *u8 as usize + total,
            output.len - total, 0, 0);
        total = total + wrote;
    }
    // Only a UART-BREAK DDB lane answers anything but 2 here: it keeps this
    // process for one record held undrained across the debugger, which may
    // wait out a whole hardware integration. The pause between polls is
    // arithmetic at EL0, not syscalls: the late UART-BREAK DDB checks need
    // some CPU to be in EL0 when the BREAK lands, and a pause made of
    // getcpu calls kept this CPU in EL1 most of the time. The sum rides
    // in the poll's unused argument so the loop is not optimized away.
    let ddb_record = bs"peer user console: queued before DDB, delivered after continue \n";
    let mut action: usize = svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_CONSOLE_TAG,
                                 first, total, 0, 0);
    while (action != 2) {
        if (action == 0) { svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0); }
        if (action == 3) {
            let ddb_written: usize = svc5(
                WRITE_SYSCALL, 1, ddb_record as *u8 as usize,
                ddb_record.len, 0, 0);
            action = svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_CONSOLE_TAG,
                          ddb_written, ddb_written, 0, 0);
        } else {
            for pause: usize in 0..<PEER_CONSOLE_POLL_PAUSE {
                spin = spin ^ (spin << 13);
                spin = spin ^ (spin >> 7);
                spin = spin ^ (spin << 17);
            }
            action = svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_CONSOLE_TAG,
                          0, 0, spin, 0);
        }
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}

// GitHub issue #9 phase B entry 6: the calls admitted to a peer so far, run
// on one.
//
// getcpu brackets both calls, so a migration invalidates the report rather
// than letting a core-0 answer be attributed to the secondary. The content
// is checked as well as the placement, because placement alone would pass
// on exactly the defect that would matter: uname answers out of a per-CPU
// scratch buffer, and a buffer that turned out to be shared would show up
// as a `machine` field holding another core's half-written fill. sysinfo's
// tail is checked for the same reason -- it is the zero fill its own
// handler wrote through the user-memory boundary from this CPU.
//
// Returns the position-weighted sum of `machine`, or 0 for any failure, so
// one number carries the whole verdict to the kernel.
private fn peer_identity(cpu_bytes: borrow [u8; 4..], peer_cpu: usize)
        -> usize {
    let mut uts: [u8; PEER_IDENT_UTSNAME_BYTES];
    let mut info: [u8; PEER_IDENT_SYSINFO_BYTES];
    for index: usize in 0..<PEER_IDENT_UTSNAME_BYTES { uts[index] = 0; }
    for index: usize in 0..<PEER_IDENT_SYSINFO_BYTES { info[index] = 0; }
    if (svc5(UNAME_SYSCALL, uts as *u8 as usize, 0, 0, 0, 0) != 0) {
        return 0;
    }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    if (svc5(SYSINFO_SYSCALL, info as *u8 as usize, 0, 0, 0, 0) != 0) {
        return 0;
    }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    let mut tail_clean: bool = true;
    for index: usize in 0..<PEER_IDENT_SYSINFO_BYTES {
        if (index >= PEER_IDENT_SYSINFO_UPTIME_BYTES && info[index] != 0) {
            tail_clean = false;
        }
    }
    if (tail_clean == false) { return 0; }
    // GitHub issue #9 phase B entry 6, second increment: the per-process
    // reads. Each is checked for CONTENT, not only for a return code, and
    // each is followed by getcpu, so an answer that came from core 0 after a
    // migration cannot be reported as the peer's.
    //
    // getcwd returns the byte count including the terminator, so 2 for `/`.
    let mut cwd: [u8; PEER_IDENT_CWD_BYTES];
    for index: usize in 0..<PEER_IDENT_CWD_BYTES { cwd[index] = 0xFF; }
    if (svc5(GETCWD_SYSCALL, cwd as *u8 as usize, PEER_IDENT_CWD_BYTES,
             0, 0, 0) != 2) {
        return 0;
    }
    if (cwd[0] != 0x2F || cwd[1] != 0) { return 0; }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    // set_tid_address answers the current pid, so getpid -- which the table
    // has admitted all along -- is what says whether it answered about this
    // process. A peer reading another CPU's current would show up here.
    let pid: usize = svc5(GETPID_SYSCALL, 0, 0, 0, 0, 0);
    if (pid == 0) { return 0; }
    if (svc5(SET_TID_ADDRESS_SYSCALL, 0, 0, 0, 0, 0) != pid) { return 0; }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    // prlimit64 as a pure read: new_limit null, old_limit written. The soft
    // limit must be a real number and must not exceed the hard one, which is
    // the invariant the fd context carries; a buffer left untouched would
    // still hold 0xFF and fail both halves.
    let mut rlimit: [u8; PEER_IDENT_RLIMIT_BYTES];
    for index: usize in 0..<PEER_IDENT_RLIMIT_BYTES { rlimit[index] = 0xFF; }
    if (svc5(PRLIMIT64_SYSCALL, 0, PEER_IDENT_RLIMIT_NOFILE, 0,
             rlimit as *u8 as usize, 0) != 0) {
        return 0;
    }
    let mut soft: usize = 0;
    let mut hard: usize = 0;
    for index: usize in 0..<PEER_IDENT_RLIMIT_BYTES {
        if (index < 8) {
            soft = soft | ((rlimit[index] as usize) << (index * 8));
        } else {
            hard = hard | ((rlimit[index] as usize) << ((index - 8) * 8));
        }
    }
    if (soft == 0 || soft > hard) { return 0; }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    // The same prlimit64, now as a WRITE: put the soft limit back where it
    // already was. Writing the value it just read keeps the fixture from
    // changing what any later scenario sees, while still taking the store
    // path -- the one thing the previous increment left on core 0.
    let mut set_limit: [u8; PEER_IDENT_RLIMIT_BYTES];
    for index: usize in 0..<PEER_IDENT_RLIMIT_BYTES {
        set_limit[index] = rlimit[index];
    }
    let mut readback: [u8; PEER_IDENT_RLIMIT_BYTES];
    for index: usize in 0..<PEER_IDENT_RLIMIT_BYTES { readback[index] = 0xFF; }
    if (svc5(PRLIMIT64_SYSCALL, 0, PEER_IDENT_RLIMIT_NOFILE,
             set_limit as *u8 as usize, readback as *u8 as usize, 0) != 0) {
        return 0;
    }
    for index: usize in 0..<PEER_IDENT_RLIMIT_BYTES {
        if (readback[index] != rlimit[index]) { return 0; }
    }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    // chdir to the one directory this kernel has. It stores nothing, so the
    // answer is the whole evidence: 0 for `/`, and ENOENT is a negative
    // number, which this returns as a large unsigned value.
    if (svc5(CHDIR_SYSCALL, "/" as *u8 as usize, 0, 0, 0, 0) != 0) {
        return 0;
    }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    // setitimer and rt_sigaction both answer by zero-filling a struct in the
    // caller's own memory. A buffer that comes back still holding 0xFF is a
    // call that answered without writing.
    let mut itimer: [u8; PEER_IDENT_ITIMER_BYTES];
    for index: usize in 0..<PEER_IDENT_ITIMER_BYTES { itimer[index] = 0xFF; }
    if (svc5(SETITIMER_SYSCALL, 0, 0, itimer as *u8 as usize, 0, 0) != 0) {
        return 0;
    }
    let mut itimer_clean: bool = true;
    for index: usize in 0..<PEER_IDENT_ITIMER_BYTES {
        if (itimer[index] != 0) { itimer_clean = false; }
    }
    if (itimer_clean == false) { return 0; }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    let mut sigaction: [u8; PEER_IDENT_SIGACTION_BYTES];
    for index: usize in 0..<PEER_IDENT_SIGACTION_BYTES {
        sigaction[index] = 0xFF;
    }
    if (svc5(RT_SIGACTION_SYSCALL, PEER_IDENT_SIGACTION_SIGNUM, 0,
             sigaction as *u8 as usize, 8, 0) != 0) {
        return 0;
    }
    let mut sigaction_clean: bool = true;
    for index: usize in 0..<PEER_IDENT_SIGACTION_BYTES {
        if (sigaction[index] != 0) { sigaction_clean = false; }
    }
    if (sigaction_clean == false) { return 0; }
    if (peer_read_cpu(cpu_bytes) != peer_cpu) { return 0; }
    // Walk the buffer's own length and filter, rather than index it at
    // offset + i: the bound the compiler can see is the array's.
    let mut digest: usize = 0;
    for index: usize in 0..<PEER_IDENT_UTSNAME_BYTES {
        if (index >= PEER_IDENT_MACHINE_OFFSET &&
                index < PEER_IDENT_MACHINE_OFFSET + PEER_IDENT_MACHINE_BYTES) {
            digest = digest + (uts[index] as usize) *
                (index - PEER_IDENT_MACHINE_OFFSET + 1);
        }
    }
    return digest;
}

// GitHub issue #547: a terminal reader admitted to the secondary CPU. The
// persistent shell starts it in the foreground, so the shell waits in wait4
// and this is the terminal's only reader while it runs. It reads one line a
// byte at a time, and after every read getcpu must still name the peer. The
// count and a position-weighted sum let the kernel tell a lost, repeated or
// reordered byte from the line the driver typed.
fn peer_tty() {
    let mut cpu_bytes: [u8; 4];
    let mut byte: [u8; 1];
    let peer_cpu: usize = svc5(
        WORKLOAD_PROGRESS_SYSCALL, PEER_TTY_TAG, 0, 0, 0, 0);
    if (peer_cpu == 0) { svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0); }
    // The persistent shell starts this one only after the console writer's
    // verdict, so its registration succeeds first try and names the CPU to
    // pin to (GitHub issue #9).
    if (peer_pin(peer_cpu) == false) { svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0); }
    while (peer_read_cpu(cpu_bytes as []u8) != peer_cpu) {}
    // The identity reads go out on the same call that used to announce
    // reading with two zeros: this process is already pinned to the peer and
    // nothing else is measuring here, so the two calls cost no sequencing of
    // their own.
    let identity: usize = peer_identity(cpu_bytes as []u8, peer_cpu);
    if (svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_TTY_TAG, 9, identity, 0, 0) != 1) {
        svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
    }
    let mut count: usize = 0;
    let mut sum: usize = 0;
    let mut reading: bool = true;
    for position: usize in 0..<PEER_TTY_LINE_MAX {
        if (reading) {
            let got: usize = svc5(READ_SYSCALL, 0, byte as *u8 as usize,
                                  1, 0, 0);
            if (got != 1 || peer_read_cpu(cpu_bytes as []u8) != peer_cpu) {
                sum = 0;
                reading = false;
            } else {
                let value: usize = byte[0] as usize;
                count = count + 1;
                sum = sum + value * (position + 1);
                if (value == 10) { reading = false; }
            }
        }
    }
    if (svc5(WORKLOAD_PROGRESS_SYSCALL, PEER_TTY_TAG, count, sum, 0, 0) == 2) {
        svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
    }
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}
