// The GICv2 register blocks (ARM IHI 0048B), shared by QEMU's `virt` GIC
// and the RPi5's GIC-400 (GitHub issue #637 stage 3, step A). Each
// platform's device_map.tkb attaches `gicd` and `gicc` from the windows the
// boot DTB names; everything here reaches the GIC through those handles,
// with no raw address.

io struct GicV2Distributor {
    ctlr: u32 at 0x000;
    typer: u32 at 0x004;
    isenabler: [u32; 32] at 0x100;
    icpendr: [u32; 32] at 0x280;
    ipriorityr: [u8; 1024] at 0x400;
    itargetsr: [u8; 1024] at 0x800;
    icfgr: [u32; 64] at 0xC00;
    sgir: u32 at 0xF00;
}

io struct GicV2CpuInterface {
    ctlr: u32 at 0x00;
    pmr: u32 at 0x04;
    bpr: u32 at 0x08;
    iar: u32 at 0x0C;
    eoir: u32 at 0x10;
}

let mut gicd: IoHandle(GicV2Distributor);
let mut gicc: IoHandle(GicV2CpuInterface);

// The INTIDs a GICv2 can name: 0..1019, with the register arrays indexed by
// INTID / 32 (one bit per INTID) or INTID itself (one byte per INTID). An
// out-of-range INTID changes nothing.
fn gic_intid_enable(intid: u32) {
    let index: usize = (intid / 32) as usize;
    if (index < 32) {
        gicd.isenabler[index] = gicd.isenabler[index] | (1 << (intid % 32));
    }
}

fn gic_intid_clear_pending(intid: u32) {
    let index: usize = (intid / 32) as usize;
    if (index < 32) {
        gicd.icpendr[index] = 1 << (intid % 32);
    }
}

fn gic_intid_target(intid: u32, cpus: u8) {
    let index: usize = intid as usize;
    if (index < 1024) {
        gicd.itargetsr[index] = cpus;
    }
}

fn gic_enable_words() -> usize {
    return (gicd.isenabler[0] as usize) | ((gicd.isenabler[1] as usize) << 32);
}

// The world-stop notification, both platforms: every core in `mask` but the
// initiator. `debug` picks the NMI-priority SGI (#920).
fn platform_world_stop_notify(mask: usize, owner: usize, debug: bool) !{unsafe} {
    let mut targets: u32 = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if ((mask & (1 << cpu)) != 0 && cpu != owner) {
            targets = targets | ((1 << cpu) as u32);
        }
    }
    if (targets == 0) { return; }
    if (debug) {
        platform_gic_sgi_send(targets, GIC_DEBUG_STOP_SGI);
    } else {
        platform_gic_sgi_send(targets, GIC_WORLD_STOP_SGI);
    }
}

// One SGI to the cores in `targets` (GICD_SGIR's CPU target list).
fn platform_gic_sgi_send(targets: u32, sgi: u32) !{unsafe} {
    dsb_ishst();
    gicd.sgir = (targets << 16) | (sgi & 0xF);
}

// GitHub issue #920: the priority-mask pseudo-NMI. Two levels: the debug
// stop SGI at GIC_PRIORITY_NMI, every other source -- the quiescent world
// stop SGI included -- at GIC_PRIORITY_IRQ (maintainer decision: two stop
// kinds). The quiescent stop keeps the old meaning: a core whose IRQs are
// masked, and so may hold a lock, does not take it. Only DDB and the crash
// path escalate to the debug stop, and the compiler holds them to taking no
// lock once they have (`debug_stopped`). The kernel masks ordinary interrupts by raising GICC_PMR
// to GIC_PMR_MASKED, which still admits the stop, so a stop reaches a core
// whose ordinary IRQs are masked -- including one hung inside a handler
// (kernel/arch/arm64/boot/cpu.tkb). A lower number is a higher priority, and
// the GIC signals an interrupt only when its priority is below PMR.
//
// Every source this kernel sends or enables uses these values through the
// two functions below; a source left at its reset priority (0 on QEMU, the
// highest) would pass the mask. On the RPi5, whose firmware puts every
// interrupt in Group 1 behind the GIC-400's security extensions, a
// Non-secure write of v stores (v >> 1) | 0x80, which keeps the order:
// 0x80 -> 0xC0, 0xA0 -> 0xD0, 0xF0 -> 0xF8, all on GIC-400's 32 levels.
// GICC_BPR is written 0 (each implementation clamps it to its minimum) so
// the two levels are distinct preemption groups and the stop preempts a
// running ordinary handler.
const GIC_WORLD_STOP_SGI: u32 = 1;
const GIC_DEBUG_STOP_SGI: u32 = 2;
const GIC_PRIORITY_NMI: u8 = 0x80;
const GIC_PRIORITY_IRQ: u8 = 0xA0;
const GIC_PMR_MASKED: u32 = 0xA0;
const GIC_PMR_UNMASKED: u32 = 0xF0;

// The priority-mask backend of the IRQ mask (kernel/arch/arm64/boot/cpu.tkb).
// GICv2's mask is this banked MMIO register; a GICv3 backend would write
// ICC_PMR_EL1 here instead, and nothing above this function would change.
fn irq_priority_mask_write(masked: bool) {
    if (masked) {
        gicc.pmr = GIC_PMR_MASKED;
    } else {
        gicc.pmr = GIC_PMR_UNMASKED;
    }
}

// The distributor's shared sources, SPIs 32 and up, as many as GICD_TYPER
// says it implements. Core 0, once, from its platform_irq_init.
fn gic_spi_priorities_init() {
    let lines: usize = (((gicd.typer & 0x1F) as usize) + 1) * 32;
    for intid: usize in 32..<1020 {
        if (intid < lines) { gicd.ipriorityr[intid] = GIC_PRIORITY_IRQ; }
    }
}

// GitHub issue #447: the CPU interface is BANKED PER CORE -- GICC_PMR and
// GICC_CTLR -- so every core runs this for itself. So are the priorities of
// SGIs and PPIs (INTIDs 0..31), which is where the stop's own level is set
// (#920). PMR starts unmasked; DAIF.I still masks until enable_irq.
fn platform_irq_cpu_interface_init() {
    for intid: usize in 0..<32 {
        gicd.ipriorityr[intid] = GIC_PRIORITY_IRQ;
    }
    gicd.ipriorityr[GIC_DEBUG_STOP_SGI as usize] = GIC_PRIORITY_NMI;
    gicc.bpr = 0;
    irq_mask_cpu_interface_ready();
    gicc.ctlr = gicc.ctlr | 1;
}

// GitHub issue #500: the distributor's first two enable words, for an
// interval that collected no PMU samples.
fn platform_pmu_irq_debug() -> usize {
    return gic_enable_words();
}
