// A saved exception frame, named by the address it sits at, and the only code
// that reads or writes a word of one (GitHub issue #661, #637 stage 1 group C).
//
// A frame used to be a bare `usize` everywhere, and the signal-frame code read
// and wrote `frame_sp + offset` for an offset it computed itself, so nothing
// bounded the offset by the frame's 0x330 bytes. A `FrameRef` holds the
// address in a private field: explicit construction uses the two mints
// below, and its words are reached only through the accessors
// below, each named for what it reads and bounded by a refined index. The
// generic word access is private to this file, so a caller cannot ask for an
// arbitrary offset.
//
// The struct is one `usize`, which AAPCS64 passes and returns in x0 exactly
// as a bare `usize`, so a FrameRef crosses the assembly boundary unchanged.
//
// What is trusted, and named: frame_ref_from_entry believes the address it is
// given is the ExceptionFrame the CPU saved (an assembly entry hands it over
// in x0, or a process record's saved_sp). Every access after that is bounded
// by ExceptionFrame's own layout, which the static_asserts below tie to the
// contiguity the loops assume.
//
// Current limitations (2026-09-30):
// - A FrameRef is indexed by the process whose generation its mint was given,
//   and resume consumes it. Nothing checks that the address is that process's
//   frame: the entry mint takes the CPU's current generation, the saved mint
//   takes the owner of the record whose saved_sp it reads.
// - The accessors do not check the address: a FrameRef that names memory that
//   is not a live frame reads and writes that memory.
// - Construction in this mint file remains trusted. The compiler rejects
//   external default construction, including tuple/generic laundering; the
//   source gate additionally refuses direct default FrameRef declarations here.
//   Neither boundary validates the address supplied to a mint.

// GitHub issue #992 (#638 stage 3): the level the frame returns to, as a
// static index. It is defined as the mode field (M[3:0]) of the SPSR word the
// frame holds: that word is what el0_context_resume restores before eret, so
// the index names where the frame goes. Only the classifiers below read it to
// choose; every writer of a frame word takes an El0 frame, and the SPSR writer
// keeps M at EL0t, so no write can move a frame between levels. A delivery
// (a register written into a parked process's frame) is therefore a type error
// on an El1 frame -- a preempted kernel context -- not a state argument.
// Spelling is provisional (DECISIONS.md 2026-10-29; #1006 may rename it).
enum ExceptionLevel { El0; El1; }

affine struct FrameRef[process: usize, level: ExceptionLevel] { private sp: usize; }

// A frame whose level was read from its SPSR.
variant LeveledFrame[process: usize] {
    El0(FrameRef[process, ExceptionLevel::El0]);
    El1(FrameRef[process, ExceptionLevel::El1]);
}

// SPSR_EL1.M[3:0]: 0 is EL0t; anything else this kernel produces is EL1t/EL1h.
// The word is read through the frame's own reader, as an El0 view first.
private fn frame_leveled(sp: usize, generation: usize @ process)
        -> LeveledFrame[process] !{unsafe} {
    static_assert(sizeof(FrameRef[process, ExceptionLevel::El0]) == sizeof(usize),
                  "FrameRef assembly ABI requires one machine word");
    let mut low: FrameRef[process, ExceptionLevel::El0] = { sp };
    if ((frame_spsr_el1(low) & 0xF) == 0) {
        return LeveledFrame::El0(low);
    }
    let mut high: FrameRef[process, ExceptionLevel::El1] = { sp };
    return LeveledFrame::El1(high);
}

// The mints. Every FrameRef in the kernel comes from one of them, and
// scripts/check_stack_proof_states.py holds their callers to a declared set.
// Each takes the generation of the process the frame belongs to, which is
// what supplies the process index, as current_process_new and
// scheduled_process_owner_new do for theirs.
//
// An assembly entry passes the frame it just saved, in x0; the generation is
// that of the process this CPU is running. The level is read from the frame.
fn frame_ref_from_entry(sp: usize, generation: usize @ process)
        -> LeveledFrame[process] {
    return frame_leveled(sp, generation);
}

// The syscall entry's frame: an SVC is taken only through the lower-EL
// synchronous vector, so the frame returns to EL0. Trusts that the caller is
// that entry (check_stack_proof_states.py holds the callers).
fn frame_ref_from_el0_entry(sp: usize, generation: usize @ process)
        -> FrameRef[process, ExceptionLevel::El0] {
    let mut frame: FrameRef[process, ExceptionLevel::El0] = { sp };
    return frame;
}

// A frame about to be written whole before anything resumes it: PID 1's
// first frame (frame_initial_user) and a clone child's copy (frame_copy),
// both EL0 by what they write. Trusts the caller writes it whole first.
fn frame_ref_fresh(sp: usize, generation: usize @ process)
        -> FrameRef[process, ExceptionLevel::El0] {
    let mut frame: FrameRef[process, ExceptionLevel::El0] = { sp };
    return frame;
}

// A frame parked in a process record: rebuilt from the saved_sp written when
// that process last left the CPU, for the process whose generation is given.
// Trusts that record's saved_sp; the level is read from the frame, so a
// process preempted at EL1 (#992) comes back as an El1 frame.
fn frame_ref_from_saved(saved_sp: usize, generation: usize @ process)
        -> LeveledFrame[process] {
    return frame_leveled(saved_sp, generation);
}

// Re-read the level of a frame whose level the holder does not know.
fn frame_level(frame: sink FrameRef[process, level]) -> LeveledFrame[process] {
    return frame_leveled_retag(frame);
}

private fn frame_leveled_retag(frame: sink FrameRef[process, level])
        -> LeveledFrame[process] !{unsafe} {
    let sp: usize = frame.sp;
    let mut low: FrameRef[process, ExceptionLevel::El0] = { sp };
    if ((frame_spsr_el1(low) & 0xF) == 0) {
        return LeveledFrame::El0(low);
    }
    let mut high: FrameRef[process, ExceptionLevel::El1] = { sp };
    return LeveledFrame::El1(high);
}

// The address, to park a frame in a record's saved_sp, and for the one place
// that still hands a frame to assembly as a bare integer.
fn frame_ref_address(frame: borrow FrameRef[process, level]) -> usize {
    return frame.sp;
}

// Sometimes there is none: the boot-time probes call the syscall dispatcher
// without a saved frame, and a frame-writing step then has nothing to write.
variant MaybeFrame {
    NoFrame;
    Frame(exists process: usize. FrameRef[process, ExceptionLevel::El0]);
}

// The dispatcher's entry hands over the address, 0 when there is no frame.
fn maybe_frame_from_entry(sp: usize, generation: usize @ process)
        -> MaybeFrame {
    if (sp == 0) { return MaybeFrame::NoFrame; }
    return MaybeFrame::Frame(frame_ref_from_el0_entry(sp, generation));
}

// A frame whose process is not named: what the scheduler hands back when it
// has chosen where the CPU goes next, which is a different process than the
// one that entered. Only the assembly boundary and the resume remain. Its
// level is not named either: a resume restores whichever it is.
variant AnyFrame {
    Frame(exists process: usize. exists level: ExceptionLevel. FrameRef[process, level]);
}

fn frame_any(frame: sink FrameRef[process, level]) -> AnyFrame {
    return AnyFrame::Frame(frame);
}

fn frame_leveled_any(frame: sink LeveledFrame[process]) -> AnyFrame {
    match frame {
        LeveledFrame::El0(low) => { return frame_any(low); }
        LeveledFrame::El1(high) => { return frame_any(high); }
    }
}

// To the assembly's ABI, which names a frame by its address.
fn frame_any_address(any: sink AnyFrame) -> usize {
    match any {
        AnyFrame::Frame(frame) => { return frame_ref_address(frame); }
    }
}

private fn frame_word(frame: borrow FrameRef[process, level], offset: usize) -> usize !{unsafe} {
    let word: *usize = unsafe { (frame.sp + offset) as *usize };
    return *word;
}

// GitHub issue #497: one word of the kernel stack an EL1 frame interrupted,
// for the sampling profiler's frame-pointer walk. The frame lands on the
// interrupted stack (exception_frame.tkb, #378), and every kernel stack is
// the upper half of a 2^(KERNEL_STACK_SHIFT+1)-aligned run (#377), so the
// interrupted stack is [frame + EXC_CONTEXT_SIZE, top of that run). A word
// is read only inside that span, 8-aligned; anything else is Outside. That
// the span is mapped RAM is what the stack guard at entry establishes.
must_use variant FrameStackWord {
    Outside;
    Word(usize);
}

fn frame_interrupted_stack_word(frame: borrow FrameRef[process, level], address: usize)
        -> FrameStackWord !{unsafe} {
    let run_bytes: usize = 1 << (KERNEL_STACK_SHIFT + 1);
    if (((frame.sp >> KERNEL_STACK_SHIFT) & 1) == 0) { return FrameStackWord::Outside; }
    let low: usize = frame.sp + EXC_CONTEXT_SIZE;
    let top: usize = (frame.sp | (run_bytes - 1)) + 1;
    if (address % 8 != 0 || address < low || address > top - 8) {
        return FrameStackWord::Outside;
    }
    // The frame's own word reader, at an offset above the frame: the stack
    // the frame sits on continues there.
    return FrameStackWord::Word(frame_word(frame, address - frame.sp));
}

// GitHub issue #811: one word of the kernel stack the CALLER runs on, for
// the irqsoff tracer's frame-pointer walk. `sp` is the caller's own stack
// pointer (caller_frame.S). Same span rule as above: a kernel process stack
// is the upper half of a 2^(KERNEL_STACK_SHIFT+1)-aligned run, so the live
// part of it is [sp, top of that run). An sp in a lower half (a boot or
// other non-process stack) answers Outside for every address, and so does
// any address outside the span or not 8-aligned; nothing outside it is read.
fn frame_current_stack_word(sp: usize, address: usize) -> FrameStackWord !{unsafe} {
    let run_bytes: usize = 1 << (KERNEL_STACK_SHIFT + 1);
    if (((sp >> KERNEL_STACK_SHIFT) & 1) == 0) { return FrameStackWord::Outside; }
    let top: usize = (sp | (run_bytes - 1)) + 1;
    if (address % 8 != 0 || address < sp || address > top - 8) {
        return FrameStackWord::Outside;
    }
    let word: *usize = unsafe { address as *usize };
    return FrameStackWord::Word(*word);
}

private fn frame_word_set(frame: borrow FrameRef[process, ExceptionLevel::El0], offset: usize, value: usize)
        !{unsafe} {
    let word: *usize = unsafe { (frame.sp + offset) as *usize };
    *word = value;
}

// A whole frame, byte for byte: clone gives the child a copy of its parent's
// saved frame. The two are ABI-owned exception-frame bounds of EXC_CONTEXT_SIZE
// bytes each, which is why this is the one place a frame becomes a byte slice.
fn frame_copy(destination: borrow FrameRef[to, ExceptionLevel::El0], source: borrow FrameRef[from, ExceptionLevel::El0]) !{unsafe} {
    let source_base: *u8 = unsafe { source.sp as *u8 };
    let destination_base: *u8 = unsafe { destination.sp as *u8 };
    let src: []u8 = unsafe { source_base[0..<EXC_CONTEXT_SIZE as isize] };
    let dst: []u8 = unsafe { destination_base[0..<EXC_CONTEXT_SIZE as isize] };
    let copied: usize = slice_copy(dst, src);
}

// GitHub issue #831: the first frame of a process that has never run, which
// is PID 1's. Every register is zero, SPSR 0 is EL0t with interrupts
// enabled, and the image's entry and stack are the only state it carries; a
// new image installs its own TPIDR_EL0. PID 1 is then started from it by the
// same el0_context_resume every other saved frame goes through, so there is
// no separate first-entry eret to keep correct.
fn frame_initial_user(frame: borrow FrameRef[process, ExceptionLevel::El0], entry: usize, stack: usize)
        !{unsafe} {
    let base: *u8 = unsafe { frame.sp as *u8 };
    let bytes: []u8 = unsafe { base[0..<EXC_CONTEXT_SIZE as isize] };
    zero_fill(bytes);
    frame_word_set(frame, offsetof(ExceptionFrame, elr_el1), entry);
    frame_word_set(frame, offsetof(ExceptionFrame, sp_el0), stack);
}

// x0..x30, one word each.
fn frame_general(frame: borrow FrameRef[process, level], index: {0..<31 as usize}) -> usize
        !{unsafe} {
    static_assert(offsetof(ExceptionFrame, x30) ==
                  offsetof(ExceptionFrame, x0) + 30 * 8,
                  "x0..x30 must be contiguous in ExceptionFrame");
    return frame_word(frame, offsetof(ExceptionFrame, x0) + index * 8);
}

fn frame_general_set(frame: borrow FrameRef[process, ExceptionLevel::El0], index: {0..<31 as usize}, value: usize)
        !{unsafe} {
    static_assert(offsetof(ExceptionFrame, x30) ==
                  offsetof(ExceptionFrame, x0) + 30 * 8,
                  "x0..x30 must be contiguous in ExceptionFrame");
    frame_word_set(frame, offsetof(ExceptionFrame, x0) + index * 8, value);
}

// q0..q31 as 64 words of eight bytes.
fn frame_vector_word(frame: borrow FrameRef[process, level], word: {0..<64 as usize}) -> usize
        !{unsafe} {
    static_assert(offsetof(ExceptionFrame, q31) ==
                  offsetof(ExceptionFrame, q0) + 31 * 16,
                  "q0..q31 must be contiguous in ExceptionFrame");
    return frame_word(frame, offsetof(ExceptionFrame, q0) + word * 8);
}

fn frame_vector_word_set(frame: borrow FrameRef[process, ExceptionLevel::El0], word: {0..<64 as usize},
                         value: usize) !{unsafe} {
    static_assert(offsetof(ExceptionFrame, q31) ==
                  offsetof(ExceptionFrame, q0) + 31 * 16,
                  "q0..q31 must be contiguous in ExceptionFrame");
    frame_word_set(frame, offsetof(ExceptionFrame, q0) + word * 8, value);
}

fn frame_sp_el0(frame: borrow FrameRef[process, level]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, sp_el0));
}

fn frame_sp_el0_set(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, sp_el0), value);
}

fn frame_elr_el1(frame: borrow FrameRef[process, level]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, elr_el1));
}

fn frame_elr_el1_set(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, elr_el1), value);
}

fn frame_spsr_el1(frame: borrow FrameRef[process, level]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, spsr_el1));
}

fn frame_spsr_el1_set(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize) !{unsafe} {
    // GitHub issue #992: M[4:0] stays EL0t, so an El0 frame stays one.
    frame_word_set(frame, offsetof(ExceptionFrame, spsr_el1), value & ~(0x1F as usize));
}

fn frame_fpsr(frame: borrow FrameRef[process, level]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, fpsr));
}

fn frame_fpsr_set(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, fpsr), value);
}

// fpcr is the word after fpsr.
fn frame_fpcr(frame: borrow FrameRef[process, level]) -> usize !{unsafe} {
    static_assert(offsetof(ExceptionFrame, fpcr) ==
                  offsetof(ExceptionFrame, fpsr) + 8,
                  "fpsr and fpcr must be adjacent in ExceptionFrame");
    return frame_word(frame, offsetof(ExceptionFrame, fpcr));
}

fn frame_fpcr_set(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, fpcr), value);
}
