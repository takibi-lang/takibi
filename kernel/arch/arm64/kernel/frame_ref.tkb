// A saved exception frame, named by the address it sits at, and the only code
// that reads or writes a word of one (GitHub issue #661, #637 stage 1 group C).
//
// A frame used to be a bare `usize` everywhere, and the signal-frame code read
// and wrote `frame_sp + offset` for an offset it computed itself, so nothing
// bounded the offset by the frame's 0x330 bytes. A `FrameRef` holds the
// address in a private field: a value of that type can only be made by
// frame_ref_from_entry, and its words are reached only through the accessors
// below, each named for what it reads and bounded by a refined index. The
// generic word access is private to this file, so a caller cannot ask for an
// arbitrary offset.
//
// The struct is one `usize`, which AAPCS64 passes and returns in x0 exactly
// as a bare `usize`, so a FrameRef crosses the assembly boundary unchanged.
//
// What is trusted, and named: frame_ref_from_entry believes the address it is
// given is the ExceptionFrame the CPU saved (an assembly entry hands it over
// in x0, or a process record's saved_sp). Every access after that is bounded
// by ExceptionFrame's own layout, which the static_asserts below tie to the
// contiguity the loops assume.
//
// Current limitations (2026-09-30):
// - A FrameRef is indexed by the process whose generation its mint was given,
//   and resume consumes it. Nothing checks that the address is that process's
//   frame: the entry mint takes the CPU's current generation, the saved mint
//   takes the owner of the record whose saved_sp it reads.
// - The accessors do not check the address: a FrameRef that names memory that
//   is not a live frame reads and writes that memory.

affine struct FrameRef[process: usize] { private sp: usize; }

// The two mints. Every FrameRef in the kernel comes from one of them, and
// scripts/check_stack_proof_states.py holds their callers to a declared set.
// Each takes the generation of the process the frame belongs to, which is
// what supplies the index, as current_process_new and
// scheduled_process_owner_new do for theirs.
//
// An assembly entry passes the frame it just saved, in x0; the generation is
// that of the process this CPU is running.
fn frame_ref_from_entry(sp: usize, generation: usize @ process)
        -> FrameRef[process] {
    let mut frame: FrameRef[process] = { sp };
    return frame;
}

// A frame parked in a process record: rebuilt from the saved_sp written when
// that process last left the CPU, for the process whose generation is given.
// Trusts that record's saved_sp.
fn frame_ref_from_saved(saved_sp: usize, generation: usize @ process)
        -> FrameRef[process] {
    let mut frame: FrameRef[process] = { saved_sp };
    return frame;
}

// The address, to park a frame in a record's saved_sp, and for the one place
// that still hands a frame to assembly as a bare integer.
fn frame_ref_address(frame: borrow FrameRef[process]) -> usize {
    return frame.sp;
}

// Sometimes there is none: the boot-time probes call the syscall dispatcher
// without a saved frame, and a frame-writing step then has nothing to write.
variant MaybeFrame {
    NoFrame;
    Frame(exists process: usize. FrameRef[process]);
}

// The dispatcher's entry hands over the address, 0 when there is no frame.
fn maybe_frame_from_entry(sp: usize, generation: usize @ process)
        -> MaybeFrame {
    if (sp == 0) { return MaybeFrame::NoFrame; }
    return MaybeFrame::Frame(frame_ref_from_entry(sp, generation));
}

// A frame whose process is not named: what the scheduler hands back when it
// has chosen where the CPU goes next, which is a different process than the
// one that entered. Only the assembly boundary and the resume remain.
variant AnyFrame {
    Frame(exists process: usize. FrameRef[process]);
}

fn frame_any(frame: sink FrameRef[process]) -> AnyFrame {
    return AnyFrame::Frame(frame);
}

// To the assembly's ABI, which names a frame by its address.
fn frame_any_address(any: sink AnyFrame) -> usize {
    match any {
        AnyFrame::Frame(frame) => { return frame_ref_address(frame); }
    }
}

private fn frame_word(frame: borrow FrameRef[process], offset: usize) -> usize !{unsafe} {
    let word: *usize = unsafe { (frame.sp + offset) as *usize };
    return *word;
}

private fn frame_word_set(frame: borrow FrameRef[process], offset: usize, value: usize)
        !{unsafe} {
    let word: *usize = unsafe { (frame.sp + offset) as *usize };
    *word = value;
}

// A whole frame, byte for byte: clone gives the child a copy of its parent's
// saved frame. The two are ABI-owned exception-frame bounds of EXC_CONTEXT_SIZE
// bytes each, which is why this is the one place a frame becomes a byte slice.
fn frame_copy(destination: borrow FrameRef[to], source: borrow FrameRef[from]) !{unsafe} {
    let source_base: *u8 = unsafe { source.sp as *u8 };
    let destination_base: *u8 = unsafe { destination.sp as *u8 };
    let src: []u8 = unsafe { source_base[0..<EXC_CONTEXT_SIZE as isize] };
    let dst: []u8 = unsafe { destination_base[0..<EXC_CONTEXT_SIZE as isize] };
    let copied: usize = slice_copy(dst, src);
}

// x0..x30, one word each.
fn frame_general(frame: borrow FrameRef[process], index: {0..<31 as usize}) -> usize
        !{unsafe} {
    static_assert(offsetof(ExceptionFrame, x30) ==
                  offsetof(ExceptionFrame, x0) + 30 * 8,
                  "x0..x30 must be contiguous in ExceptionFrame");
    return frame_word(frame, offsetof(ExceptionFrame, x0) + index * 8);
}

fn frame_general_set(frame: borrow FrameRef[process], index: {0..<31 as usize}, value: usize)
        !{unsafe} {
    static_assert(offsetof(ExceptionFrame, x30) ==
                  offsetof(ExceptionFrame, x0) + 30 * 8,
                  "x0..x30 must be contiguous in ExceptionFrame");
    frame_word_set(frame, offsetof(ExceptionFrame, x0) + index * 8, value);
}

// q0..q31 as 64 words of eight bytes.
fn frame_vector_word(frame: borrow FrameRef[process], word: {0..<64 as usize}) -> usize
        !{unsafe} {
    static_assert(offsetof(ExceptionFrame, q31) ==
                  offsetof(ExceptionFrame, q0) + 31 * 16,
                  "q0..q31 must be contiguous in ExceptionFrame");
    return frame_word(frame, offsetof(ExceptionFrame, q0) + word * 8);
}

fn frame_vector_word_set(frame: borrow FrameRef[process], word: {0..<64 as usize},
                         value: usize) !{unsafe} {
    static_assert(offsetof(ExceptionFrame, q31) ==
                  offsetof(ExceptionFrame, q0) + 31 * 16,
                  "q0..q31 must be contiguous in ExceptionFrame");
    frame_word_set(frame, offsetof(ExceptionFrame, q0) + word * 8, value);
}

fn frame_sp_el0(frame: borrow FrameRef[process]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, sp_el0));
}

fn frame_sp_el0_set(frame: borrow FrameRef[process], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, sp_el0), value);
}

fn frame_elr_el1(frame: borrow FrameRef[process]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, elr_el1));
}

fn frame_elr_el1_set(frame: borrow FrameRef[process], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, elr_el1), value);
}

fn frame_spsr_el1(frame: borrow FrameRef[process]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, spsr_el1));
}

fn frame_spsr_el1_set(frame: borrow FrameRef[process], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, spsr_el1), value);
}

fn frame_fpsr(frame: borrow FrameRef[process]) -> usize !{unsafe} {
    return frame_word(frame, offsetof(ExceptionFrame, fpsr));
}

fn frame_fpsr_set(frame: borrow FrameRef[process], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, fpsr), value);
}

// fpcr is the word after fpsr.
fn frame_fpcr(frame: borrow FrameRef[process]) -> usize !{unsafe} {
    static_assert(offsetof(ExceptionFrame, fpcr) ==
                  offsetof(ExceptionFrame, fpsr) + 8,
                  "fpsr and fpcr must be adjacent in ExceptionFrame");
    return frame_word(frame, offsetof(ExceptionFrame, fpcr));
}

fn frame_fpcr_set(frame: borrow FrameRef[process], value: usize) !{unsafe} {
    frame_word_set(frame, offsetof(ExceptionFrame, fpcr), value);
}
