/* The window scripts/validate_protocol_trace.py replays against
 * StackOwnership.tla (GitHub issue #606). A static-PIE EL0 program, kept
 * free of writable globals and compiled with trap sites rejected, run once from
 * init.sh.
 *
 * It opens the kernel's protocol-trace window, then runs the lifecycle the
 * model is about twice: a clone whose child naps and exits while its
 * parent is blocked in wait4, the parent free to run anywhere (so the
 * child's exit may start it at once), and the same with the parent pinned
 * to CPU 1 and the child to CPU 0 (so it may not, and CPU 1 takes it
 * back). Then it closes the window from CPU 0, and the kernel prints what
 * it saw.
 *
 * Between the two it moves itself from CPU 0 to CPU 1 by re-pinning while
 * it runs on CPU 0, which is the one leave no timing can turn into another
 * path (GitHub issue #847): see protocol_trace_leave_core0.
 * It prints nothing itself unless it fails.
 */

const WRITE_SYSCALL: usize = 64;
const EXIT_SYSCALL: usize = 93;
const CLONE_SYSCALL: usize = 220;
const WAIT4_SYSCALL: usize = 260;
const NANOSLEEP_SYSCALL: usize = 101;
const SETAFFINITY_SYSCALL: usize = 122;
const WORKLOAD_PROGRESS_SYSCALL: usize = 453;
const GETCPU_SYSCALL: usize = 168;
const YIELD_SYSCALL: usize = 124;
const PROTOCOL_TRACE_ARRIVAL_POLLS: usize = 1000000;
const CLONE_FORK_SIGCHLD: usize = 0x11;
const PROTOCOL_TRACE_OPEN_TAG: usize = 16;
const PROTOCOL_TRACE_CLOSE_TAG: usize = 17;
const LOG_RING_TRACE_TAG: usize = 22;
const PROTOCOL_TRACE_EL1_PREEMPT_TAG: usize = 25;
const PROTOCOL_TRACE_EL1_REAL_OPEN_TAG: usize = 26;
const PROTOCOL_TRACE_EL1_REAL_CLOSE_TAG: usize = 27;
const PROTOCOL_TRACE_EL1_REAL_CROSS_CLOSE_TAG: usize = 28;
const OPENAT_SYSCALL: usize = 56;
const CLOSE_SYSCALL: usize = 57;
const READ_SYSCALL: usize = 63;
const AT_FDCWD: usize = 0xFFFFFFFFFFFFFF9C;
// Reads per attempt and attempts: enough EL1 time for ticks to land in.
const PROTOCOL_TRACE_REAL_READS: usize = 200;
const PROTOCOL_TRACE_REAL_ATTEMPTS: usize = 20;
const KILL_SYSCALL: usize = 129;
const SIGKILL_NUMBER: usize = 9;
const PROTOCOL_TRACE_ERROR_FLOOR: usize = 0xFFFFFFFFFFFFF000;
// Every CPU the kernel can have, as an affinity mask.
const PROTOCOL_TRACE_ANY_CPU: u8 = 0x0F;

private fn protocol_trace_fail(line: borrow []const u8) !{unsafe} {
    // Raw ABI input only: these syscalls read the readonly bytes.
    // The bridge exposes no writable slice or checked mutation.
    svc5(WRITE_SYSCALL, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}

private fn protocol_trace_pin(cpus: u8) -> usize {
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = cpus;
    return svc5(SETAFFINITY_SYSCALL, 0, 8, mask as *u8 as usize, 0, 0);
}

// A child that naps long enough for its parent to block in wait4 first,
// then exits; the parent reaps it.
private fn protocol_trace_lifecycle(child_cpus: u8) {
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        protocol_trace_pin(child_cpus);
        let mut nap: [usize; 2];
        nap[0] = 0;
        nap[1] = 100000000;
        svc5(NANOSLEEP_SYSCALL, nap as *usize as usize, 0, 0, 0, 0);
        svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
    }
    if (child >= PROTOCOL_TRACE_ERROR_FLOOR) {
        protocol_trace_fail(bs"protocol-trace: fork failed\n");
    }
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0xFF; }
    if (svc5(WAIT4_SYSCALL, child, status as *u8 as usize, 0, 0, 0) != child ||
        status[0] != 0 || status[1] != 0) {
        protocol_trace_fail(bs"protocol-trace: wait4 did not reap the child with status 0\n");
    }
}

// Spin on getcpu until this process runs on `cpu`; false if it never does.
private fn protocol_trace_reach(cpu: u8) -> bool {
    let mut cpu_bytes: [u8; 4];
    cpu_bytes[0] = 99;
    for poll: usize in 0..<PROTOCOL_TRACE_ARRIVAL_POLLS {
        if (cpu_bytes[0] != cpu) {
            if (svc5(GETCPU_SYSCALL, cpu_bytes as *u8 as usize,
                     0, 0, 0, 0) != 0) {
                cpu_bytes[0] = 99;
            }
        }
    }
    return cpu_bytes[0] == cpu;
}

// GitHub issue #847: the window must show a LeaveBegin and a LeaveComplete,
// and only core 0 makes them deterministic. A peer whose process re-pins
// itself away keeps it until the NEXT syscall's gate (a Migrate) or the
// next timer tick, whichever comes first; on a loaded host the tick won
// (InterruptDepart then TickLeave) and the window had no leave at all. Core
// 0 instead hands the process away at the return of the very
// sched_setaffinity that excluded it (kernel_process_core0_leave_excluded),
// with no EL0 instruction in between for a tick to land on. So: reach CPU 0
// by any path, then re-pin to CPU 1 from there.
private fn protocol_trace_leave_core0() {
    if (protocol_trace_pin(1) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpu 0 alone was refused\n");
    }
    if (protocol_trace_reach(0) == false) {
        protocol_trace_fail(bs"protocol-trace: never reached cpu 0\n");
    }
    if (protocol_trace_pin(2) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpu 1 alone was refused\n");
    }
    if (protocol_trace_reach(1) == false) {
        protocol_trace_fail(bs"protocol-trace: never reached cpu 1\n");
    }
}

/* GitHub issue #638 stage 8: real EL1 preemptions. This process and a child
 * that only computes stand on CPU 1; the kernel spins in this process's syscall
 * until a tick switches to the child, the child's own tick switches back through
 * the EL0 interrupt return, and then a second switch leaves this process for
 * CPU 2 to take. The child makes no syscall, so its ticks are EL0 ones whatever
 * the timing. */
private fn protocol_trace_el1_preempt() {
    if (protocol_trace_pin(2) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpu 1 alone was refused\n");
    }
    if (protocol_trace_reach(1) == false) {
        protocol_trace_fail(bs"protocol-trace: never reached cpu 1\n");
    }
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        while (true) { }
    }
    if (child >= PROTOCOL_TRACE_ERROR_FLOOR) {
        protocol_trace_fail(bs"protocol-trace: fork failed\n");
    }
    let result: usize = svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_EL1_PREEMPT_TAG,
                             2, 0, 0, 0);
    if (result == 2) {
        protocol_trace_fail(bs"protocol-trace: el1 preempt: a raised count did not refuse the switch\n");
    } else if (result == 3) {
        protocol_trace_fail(bs"protocol-trace: el1 preempt: no resume through the EL0 interrupt return\n");
    } else if (result == 4) {
        protocol_trace_fail(bs"protocol-trace: el1 preempt: no take on another CPU\n");
    } else if (result != 1) {
        protocol_trace_fail(bs"protocol-trace: el1 preempt: refused\n");
    }
    svc5(KILL_SYSCALL, child, SIGKILL_NUMBER, 0, 0, 0);
    if (svc5(WAIT4_SYSCALL, child, 0, 0, 0, 0) != child) {
        protocol_trace_fail(bs"protocol-trace: el1 preempt: wait4 did not reap the child\n");
    }
}

// The first bytes of one ext2 file into `buffer`; the count read.
private fn protocol_trace_read_file(path: borrow []const u8, buffer: *u8,
                                    size: usize) -> usize !{unsafe} {
    let fd: usize = svc5(OPENAT_SYSCALL, AT_FDCWD, (unsafe { path as *u8 }) as usize, 0, 0, 0);
    if (fd >= PROTOCOL_TRACE_ERROR_FLOOR) { return PROTOCOL_TRACE_ERROR_FLOOR; }
    let got: usize = svc5(READ_SYSCALL, fd, buffer as usize, size, 0, 0);
    svc5(CLOSE_SYSCALL, fd, 0, 0, 0, 0);
    return got;
}

/* GitHub issue #638 stage 9 (c), maintainer option A1: the lasting evidence
 * that a real handler can be preempted. With a child spinning at EL0 on the
 * same CPU, the kernel's real window lets a tick switch this process at any
 * PC of its own syscalls (count zero), here an ext2 openat/read/close loop.
 * Every read must return the bytes the first one did. One CPU only. */
private fn protocol_trace_el1_real() !{unsafe} {
    if (protocol_trace_pin(2) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpu 1 alone was refused\n");
    }
    if (protocol_trace_reach(1) == false) {
        protocol_trace_fail(bs"protocol-trace: never reached cpu 1\n");
    }
    let mut first: [u8; 64];
    let mut again: [u8; 64];
    let path = bs"/etc/init.sh\0";
    let expected: usize = protocol_trace_read_file(path, first as *u8, 64);
    if (expected == 0 || expected >= PROTOCOL_TRACE_ERROR_FLOOR) {
        protocol_trace_fail(bs"protocol-trace: el1 real: /etc/init.sh did not read\n");
    }
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        while (true) { }
    }
    if (child >= PROTOCOL_TRACE_ERROR_FLOOR) {
        protocol_trace_fail(bs"protocol-trace: fork failed\n");
    }
    let mut switches: usize = 0;
    for attempt: usize in 0..<PROTOCOL_TRACE_REAL_ATTEMPTS {
        if (switches == 0) {
            if (svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_EL1_REAL_OPEN_TAG,
                     0, 0, 0, 0) != 1) {
                protocol_trace_fail(bs"protocol-trace: el1 real: the window did not open\n");
            }
            for round: usize in 0..<PROTOCOL_TRACE_REAL_READS {
                for index: usize in 0..<64 { again[index] = 0; }
                let got: usize = protocol_trace_read_file(path, again as *u8, 64);
                if (got != expected) {
                    protocol_trace_fail(bs"protocol-trace: el1 real: a read returned another length\n");
                }
                for index: usize in 0..<64 {
                    if (again[index] != first[index]) {
                        protocol_trace_fail(bs"protocol-trace: el1 real: a read returned other bytes\n");
                    }
                }
            }
            switches = svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_EL1_REAL_CLOSE_TAG,
                            1, 0, 0, 0);
        }
    }
    svc5(KILL_SYSCALL, child, SIGKILL_NUMBER, 0, 0, 0);
    if (svc5(WAIT4_SYSCALL, child, 0, 0, 0, 0) != child) {
        protocol_trace_fail(bs"protocol-trace: el1 real: wait4 did not reap the child\n");
    }
    if (switches == 0) {
        protocol_trace_fail(bs"protocol-trace: el1 real: no tick switched inside a read\n");
    }
}

/* GitHub issue #638 stage 9: the same real window, with this process and two
 * spinning children allowed CPUs 0 and 1, until a read preempted on one CPU
 * has resumed on the other. Every read must still return the first's bytes.
 * The calls are the peer-safe openat/read/close the CPU 1 phase made. */
private fn protocol_trace_el1_real_cross() !{unsafe} {
    if (protocol_trace_pin(3) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpus 0 and 1 were refused\n");
    }
    let mut first: [u8; 64];
    let mut again: [u8; 64];
    let path = bs"/etc/init.sh\0";
    let expected: usize = protocol_trace_read_file(path, first as *u8, 64);
    if (expected == 0 || expected >= PROTOCOL_TRACE_ERROR_FLOOR) {
        protocol_trace_fail(bs"protocol-trace: el1 cross: /etc/init.sh did not read\n");
    }
    let one: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (one == 0) {
        while (true) { }
    }
    let two: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (two == 0) {
        while (true) { }
    }
    if (one >= PROTOCOL_TRACE_ERROR_FLOOR || two >= PROTOCOL_TRACE_ERROR_FLOOR) {
        protocol_trace_fail(bs"protocol-trace: fork failed\n");
    }
    let mut cross: usize = 0;
    for attempt: usize in 0..<PROTOCOL_TRACE_REAL_ATTEMPTS {
        if (cross == 0) {
            if (svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_EL1_REAL_OPEN_TAG,
                     0, 0, 0, 0) != 1) {
                protocol_trace_fail(bs"protocol-trace: el1 cross: the window did not open\n");
            }
            for round: usize in 0..<PROTOCOL_TRACE_REAL_READS {
                for index: usize in 0..<64 { again[index] = 0; }
                let got: usize = protocol_trace_read_file(path, again as *u8, 64);
                if (got != expected) {
                    protocol_trace_fail(bs"protocol-trace: el1 cross: a read returned another length\n");
                }
                for index: usize in 0..<64 {
                    if (again[index] != first[index]) {
                        protocol_trace_fail(bs"protocol-trace: el1 cross: a read returned other bytes\n");
                    }
                }
            }
            cross = svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_EL1_REAL_CROSS_CLOSE_TAG,
                         1, 0, 0, 0);
        }
    }
    svc5(KILL_SYSCALL, one, SIGKILL_NUMBER, 0, 0, 0);
    svc5(KILL_SYSCALL, two, SIGKILL_NUMBER, 0, 0, 0);
    if (svc5(WAIT4_SYSCALL, one, 0, 0, 0, 0) != one ||
        svc5(WAIT4_SYSCALL, two, 0, 0, 0, 0) != two) {
        protocol_trace_fail(bs"protocol-trace: el1 cross: wait4 did not reap a child\n");
    }
    if (cross == 0) {
        protocol_trace_fail(bs"protocol-trace: el1 cross: no read resumed on another cpu\n");
    }
}

fn protocol_trace_probe() {
    let mut opened: bool = false;
    // GitHub issue #665: yield once whether or not the window is deferred.
    // The deferred retry below yields only under load, and an unimplemented
    // sched_yield then hid the peer fixtures behind the harness's gate; this
    // makes every run's unimplemented_syscalls view check that it exists.
    if (svc5(YIELD_SYSCALL, 0, 0, 0, 0, 0) != 0) {
        protocol_trace_fail(bs"protocol-trace: sched_yield did not return 0\n");
    }
    for attempt: usize in 0..<64 {
        if (opened == false) {
            let result: usize = svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_OPEN_TAG,
                                     0, 0, 0, 0);
            if (result == 1) { opened = true; }
            else if (result == 0) { svc5(YIELD_SYSCALL, 0, 0, 0, 0, 0); }
            else { protocol_trace_fail(bs"protocol-trace: invalid opening snapshot\n"); }
        }
    }
    if (opened == false) {
        protocol_trace_fail(bs"protocol-trace: the window did not open\n");
    }
    protocol_trace_lifecycle(PROTOCOL_TRACE_ANY_CPU);
    protocol_trace_leave_core0();
    protocol_trace_lifecycle(1);
    protocol_trace_el1_preempt();
    // Close from CPU 0: the report is thousands of lines, and a peer's log
    // lines go through a bounded ring that would overwrite them.
    if (protocol_trace_pin(1) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpu 0 alone was refused\n");
    }
    if (protocol_trace_reach(0) == false) {
        protocol_trace_fail(bs"protocol-trace: never reached cpu 0\n");
    }
    if (svc5(WORKLOAD_PROGRESS_SYSCALL, PROTOCOL_TRACE_CLOSE_TAG,
             0, 0, 0, 0) != 1) {
        protocol_trace_fail(bs"protocol-trace: the window did not close\n");
    }
    protocol_trace_el1_real();
    protocol_trace_el1_real_cross();
    if (protocol_trace_pin(1) != 0) {
        protocol_trace_fail(bs"protocol-trace: cpu 0 alone was refused\n");
    }
    if (protocol_trace_reach(0) == false) {
        protocol_trace_fail(bs"protocol-trace: never reached cpu 0\n");
    }
    // GitHub issue #656: the log ring's window, also from CPU 0 -- a storm
    // round with a syslog read inside it, which the kernel prints for
    // scripts/validate_log_ring_trace.py.
    if (svc5(WORKLOAD_PROGRESS_SYSCALL, LOG_RING_TRACE_TAG, 0, 0, 0, 0) != 1) {
        protocol_trace_fail(bs"protocol-trace: the log-ring window did not run\n");
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}
