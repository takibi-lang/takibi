// Platform-independent UART interrupt glue. Each platform supplies the
// MMIO-specific uart_rx_ready() and uart_isr_getc() primitives.

let mut uart_rx_handler: fn !{unsafe}(u8) -> void;

// Terminal fail-stop diagnostics run with IRQ delivery masked, so they must
// consume the platform FIFO by polling rather than through uart_rx_handler.
// There is no timeout because the kernel is already terminally stopped.
fn uart_debug_getc() -> u8 !{unsafe} {
    while (uart_rx_ready() == false) { }
    return uart_isr_getc();
}

fn uart_set_rx_handler(handler: fn !{unsafe}(u8) -> void) !{} {
    uart_rx_handler = handler;
}

fn platform_uart_common_execution_model_assumption() {
    static_assert(KERNEL_ACTIVE_CORES == 1,
                  "the stored UART RX handler is one shared callback until multicore dispatch owns its synchronization");
}
