use "kernel/kernel/process.tkb";
use "kernel/lib/execution_model.tkb";
use "kernel/kernel/fd_table.tkb";
use "kernel/arch/arm64/kernel/user_entry_extern.tkb";
use "kernel/lib/occupancy.tkb";

// Both maintained platforms start core 1 before any DDB entry is enabled.
// KERNEL_ACTIVE_CORES remains the scheduler count and is deliberately not
// used here: the idle secondary still executes timer and SGI handlers and
// therefore must acknowledge inspection quiescence.
const DDB_ONLINE_CORES: usize = 2;
const DDB_WORLD_STOP_SPINS: usize = 10000000;

// How many of a process's descriptors an oops report prints. GitHub issue
// #393: this is the width of the REPORT, not of the table -- see
// CrashSnapshot's own fd_kind comment.
const CRASH_FD_SNAPSHOT_SLOTS: usize = 16;

// Stable, fixed-size fail-stop payload.  `valid` is written last, and
// `sequence` changes before every capture, so a debugger cannot mistake an
// all-zero or partial record for a fresh crash.  All fields are machine words
// to keep this ABI straightforward for UART, GDB, and OpenOCD consumers.
//
// GitHub issue #486: `fault_order` is the machine-wide ticket, taken once per
// capture from one atomic counter. `sequence` counts this CORE's captures and
// cannot order two cores against each other -- and two cores faulting is a
// more interesting event than one, so the order between them is the fact most
// worth not destroying.
struct CrashSnapshot {
    valid: usize;
    sequence: usize;
    fault_order: usize;
    cpu: usize;
    vector_slot: usize;
    esr_el1: usize;
    far_el1: usize;
    elr_el1: usize;
    spsr_el1: usize;
    sp_el0: usize;
    tpidr_el0: usize;
    ttbr0_el1: usize;
    process_pid: usize;
    parent_pid: usize;
    process_state: usize;
    wait_reason: usize;
    wait4_status_ptr: usize;
    root_slot: usize;
    root_l1: usize;
    root_asid: usize;
    image_kind: usize;
    saved_frame_available: usize;
    saved_sp_el0: usize;
    saved_elr_el1: usize;
    saved_spsr_el1: usize;
    saved_tpidr_el0: usize;
    trace_count: usize;
    trace: [usize; KERNEL_CRASH_TRACE_WORDS];
    // Issue #294: current process's own descriptor table -- fd_kind[i]
    // (0=Empty/1=Terminal/2=OpenFile/3=Directory/4=Listener/5=Connection)
    // and fd_object[i] (the shared-object slot it holds, meaningless when
    // fd_kind[i] is Empty), so a diagnostic snapshot can identify relevant
    // descriptor/socket ownership, not just process/scheduler/VM state.
    // GitHub issue #393: a REPORT WIDTH, not a table capacity. The
    // descriptor table has no capacity any more -- it grows with the
    // process -- but a crash report is captured in a fixed struct, must
    // not allocate, and must not walk an unbounded chain in exception
    // context. So the snapshot carries the first CRASH_FD_SNAPSHOT_SLOTS
    // descriptors, which is what the whole table used to be, and says so
    // rather than implying the rest do not exist.
    fd_kind: [usize; CRASH_FD_SNAPSHOT_SLOTS];
    fd_object: [usize; CRASH_FD_SNAPSHOT_SLOTS];
}

let mut crash_snapshot: CrashSnapshot;
let mut crash_snapshot_capturing: bool;
private let mut crash_snapshot_per_core: [CrashSnapshot; KERNEL_MAX_CORES];
private let mut crash_snapshot_capturing_per_core: [bool; KERNEL_MAX_CORES];

// Preserve the historical core-0 symbols consumed by GDB/OpenOCD while each
// peer records into storage selected by its hardware affinity.
private fn crash_snapshot_here() -> *CrashSnapshot {
    if (cpu_id() == 0) { return &crash_snapshot; }
    let base: *CrashSnapshot = crash_snapshot_per_core;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

// GitHub issue #486: the machine-wide fault ticket.
//
// Relaxed is the right strength and the reason is worth stating: this number
// only has to be unique and increasing, and what makes a snapshot SAFE to read
// is the release store on `valid` below, not this. A reader that has acquired
// a published record has already acquired everything written before it,
// including this.
private let mut crash_fault_order: usize;

private fn crash_fault_order_address() -> usize {
    return (&crash_fault_order) as usize;
}

// `valid` is the publication word. A reader must not assemble a record from
// a core that is still writing one, so it is stored with release after the
// payload and loaded with acquire before any field is read -- the same
// arrangement kernel/lib/diagnostic_ring.tkb uses, and the same one DDB's own
// snapshot uses through ddb_snapshot_published_sequence.
private fn crash_snapshot_valid_address(core: usize) -> usize {
    if (core == 0) { return (&crash_snapshot.valid) as usize; }
    let base: *CrashSnapshot = crash_snapshot_per_core;
    if (core >= KERNEL_MAX_CORES) { return (&crash_snapshot.valid) as usize; }
    return (&(base + (core as isize)).valid) as usize;
}

private fn crash_snapshot_of(core: usize) -> *CrashSnapshot {
    if (core == 0) { return &crash_snapshot; }
    let base: *CrashSnapshot = crash_snapshot_per_core;
    if (core >= KERNEL_MAX_CORES) { return &crash_snapshot; }
    return base + (core as isize);
}

private fn crash_snapshot_capturing_here() -> *bool {
    if (cpu_id() == 0) { return &crash_snapshot_capturing; }
    let base: *bool = crash_snapshot_capturing_per_core;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

const CRASH_CONSOLE_LINE_BYTES: usize = 32;

// GitHub issue #486: which core reads the crash console's input.
//
// Claimed by one non-blocking swap, never released -- the console is terminal,
// so there is no second visit to arbitrate. A reporter that could BLOCK here
// could not report the deadlock it is in, which is the rule this file already
// states and the reason Linux's bust_spinlocks and FreeBSD's SCHEDULER_STOPPED
// exist.
const CRASH_CONSOLE_FREE: usize = 0;
const CRASH_CONSOLE_CLAIMED: usize = 1;
private let mut crash_console_owner: usize;

private fn crash_console_owner_address() -> usize {
    return (&crash_console_owner) as usize;
}

// GitHub issue #486: the two-core lane's first run shredded both reports into
// each other, byte by byte, because two cores rendered to one UART at once.
// Both records survived in memory and both were legible from the console
// afterwards -- so the acceptance held -- but the lines a person reads first
// were unreadable, which is the moment a crash reporter exists for.
//
// So a reporter takes this before rendering and gives it back after. It is
// NOT a lock, and the difference is the whole design of this file: a loser
// spins for a bounded number of turns and then renders ANYWAY. A garbled
// report is worse than a clean one and far better than none, and the case
// that must not happen is a core wedged mid-render silencing the core that
// still has something to say. Linux answers the same question the same way:
// bust_spinlocks() makes the console path skip its locks rather than wait on
// them.
//
// The bound is turns, not time: there is no clock a fail-stopped core can
// trust. It has to exceed one report's worth of UART writes, which is about
// 2,400 bytes each waiting on the transmit FIFO. The first value tried here
// was 2,000,000 and the two-core lane still shredded its output, which is how
// the number below was chosen: measured against the thing it has to outlast
// rather than guessed, and it is the loop the lane would fail again if it
// stopped being enough.
const CRASH_REPORT_SPIN_TURNS: usize = 50000000;
private let mut crash_report_owner: usize;

private fn crash_report_owner_address() -> usize {
    return (&crash_report_owner) as usize;
}

// How many claims found the word held, and how many gave up waiting. The
// summary line reports both, because "the reports came out clean" and "no two
// cores ever tried to write at once" look identical on a healthy run and are
// completely different claims.
// Counted atomically, and the reason is the assertion rather than the tidiness:
// the lane asserts `abandoned=0`, so an increment lost to two cores racing
// would hide exactly the event the assertion exists to catch. Relaxed is
// enough -- these are read once, after both cores have stopped.
private let mut crash_report_contended: usize;
private let mut crash_report_abandoned: usize;

private fn crash_report_contended_address() -> usize {
    return (&crash_report_contended) as usize;
}

private fn crash_report_abandoned_address() -> usize {
    return (&crash_report_abandoned) as usize;
}

private fn crash_report_claim() !{unsafe} {
    let mut waited: bool = false;
    for turn: usize in 0..<CRASH_REPORT_SPIN_TURNS {
        // Read before swapping: a swap every turn writes the word from every
        // waiting core and keeps the line moving between them, which is the
        // shape kernel/lib/spinlock.tkb's own acquire already avoids.
        if (unsafe { atomic_load_acquire(crash_report_owner_address()) }
                == CRASH_CONSOLE_FREE) {
            if (unsafe { atomic_swap_acquire(crash_report_owner_address(),
                                             CRASH_CONSOLE_CLAIMED) }
                    == CRASH_CONSOLE_FREE) {
                if (waited) {
                    unsafe {
                        atomic_fetch_add_relaxed(
                            crash_report_contended_address(), 1);
                    }
                }
                return;
            }
        }
        waited = true;
    }
    unsafe {
        atomic_fetch_add_relaxed(crash_report_contended_address(), 1);
        atomic_fetch_add_relaxed(crash_report_abandoned_address(), 1);
    }
}

private fn crash_report_release() !{unsafe} {
    unsafe { atomic_store_release(crash_report_owner_address(),
                                  CRASH_CONSOLE_FREE); }
}

// Resumable DDB state is intentionally smaller than CrashSnapshot. It is
// captured and rendered entirely from an IRQ root, so every field is fixed
// size and every reachable operation must pass the interrupt operational-
// effect checker (no allocation, locks, ordinary logs, or interrupt_wait).
struct DdbSnapshot {
    sequence: usize;
    cpu: usize;
    entry_kind: usize;
    entry_source: usize;
    live_daif: usize;
    saved_daif: usize;
    esr_valid: usize;
    esr_el1: usize;
    far_el1: usize;
    scheduler_enabled: usize;
    reschedule_pending: usize;
    frame_sp: usize;
    process_pid: usize;
    parent_pid: usize;
    process_state: usize;
    wait_reason: usize;
    root_slot: usize;
    root_live: usize;
    root_l1: usize;
    root_asid: usize;
    fd_kind: [usize; CRASH_FD_SNAPSHOT_SLOTS];
    fd_object: [usize; CRASH_FD_SNAPSHOT_SLOTS];
    process_count: usize;
    process_truncated: usize;
    processes: [ProcessDdbRecord; DDB_PROCESS_RECORDS];
    process_l2: [usize; DDB_PROCESS_RECORDS];
    trace_count: usize;
    trace: [usize; KERNEL_CRASH_TRACE_WORDS];
}

private let mut ddb_snapshot: DdbSnapshot;
// External debuggers cannot assume that halting the CPU happened after the
// last field above was captured. Zero means unpublished/in progress; the
// completed sequence is stored with release ordering only after every bounded
// sub-snapshot is present. A reader accepts the object only when this equals
// ddb_snapshot.sequence before and after its read.
private let mut ddb_snapshot_published_sequence: usize;
let mut kernel_ddb_breakpoint_test_enabled: bool;
let mut kernel_ddb_memory_fault_test_enabled: bool;
let mut kernel_ddb_backtrace_test_enabled: bool;
let mut kernel_ddb_wait_test_enabled: bool;
// GitHub issue #456: the guarded read's arming, per core.
//
// It used to be three machine-global words, and DDB's world stop was the
// argument for that: only one core inspects at a time. The argument holds for
// the WRITER and not for the READER. The claim is checked in
// kernel_ddb_sync_dispatch on whichever core takes a data abort, so a peer
// faulting for a real reason at the address DDB happened to be reading would
// have had its fault swallowed -- redirected to DDB's own recovery label,
// landing that core in the middle of a read it never made, while DDB reported
// a fault it never took. Two wrong answers from one shared word.
//
// Per core, a core can only ever match its own arming, which is the only
// arming that can be about it. This is the state #456 names; the snapshot
// beside it stays machine-global on purpose, because it has exactly one
// writer and the complete world-stop token is what says so.
struct DdbGuardedRead {
    active: bool;
    faulted: bool;
    address: usize;
}

private let mut kernel_ddb_memory_access: [DdbGuardedRead; KERNEL_MAX_CORES];

// Whether a data abort taken on THIS core is the one its guarded read armed.
//
// Separated from the dispatcher because it is the part that can be wrong and
// the part a single core can exercise: arming, the exception class, and the
// faulting address all have to agree, and each of the three alone has been a
// plausible-looking match. The dispatcher around it reads two system
// registers and rewrites a return address.
fn ddb_guarded_fault_is_ours(active: bool, armed_address: usize,
                             esr: usize, far: usize) -> bool {
    if (active == false) { return false; }
    // 0x25 is a Current-EL data abort. A different class taken while a read
    // is armed is a different event and must fail-stop.
    if (((esr >> 26) & 0x3F) != 0x25) { return false; }
    return far == armed_address;
}

private fn kernel_ddb_memory_access_here() -> *DdbGuardedRead {
    let base: *DdbGuardedRead = kernel_ddb_memory_access;
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return base; }
    return base + (core as isize);
}

fn kernel_ddb_breakpoint_test_checkpoint() {
    if (kernel_ddb_breakpoint_test_enabled) { kernel_ddb_breakpoint(); }
}

private fn ddb_snapshot_published_sequence_address() -> usize {
    return (&ddb_snapshot_published_sequence) as usize;
}

private fn ddb_puts(text: *u8) !{unsafe} {
    while (*text != 0) {
        uart_debug_putc(*text);
        text = text + 1;
    }
}

private fn ddb_put_hex(value: usize) !{unsafe} {
    ddb_puts("0x");
    let mut shift: usize = 60;
    while (true) {
        let digit: usize = (value >> shift) & 0xF;
        if (digit < 10) { uart_debug_putc((digit as u8) + 48); }
        else { uart_debug_putc((digit as u8) + 87); }
        if (shift == 0) { return; }
        shift = shift - 4;
    }
}

private fn ddb_put_udec(value_in: usize) !{unsafe} {
    let mut digits: [u8; 20];
    let mut count: usize = 0;
    let mut value: usize = value_in;
    if (value == 0) { uart_debug_putc(0x30); return; }
    for index: usize in 0..<20 {
        if (value != 0) {
            digits[index] = 0x30 + ((value % 10) as u8);
            count = count + 1;
            value = value / 10;
        }
    }
    while (count != 0) {
        count = count - 1;
        if (count >= 0 && count < 20) { uart_debug_putc(digits[count]); }
    }
}

private fn ddb_command_is(line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..],
                          length: usize, text: []u8) -> bool {
    if (length != text.len) { return false; }
    let mut index: usize = 0;
    while (index < length && index < CRASH_CONSOLE_LINE_BYTES) {
        if (index >= 0 && index < CRASH_CONSOLE_LINE_BYTES &&
                index < text.len) {
            if (line[index] != text[index]) { return false; }
        } else { return false; }
        index = index + 1;
    }
    return true;
}

private fn ddb_command_starts_with(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..],
        length: usize, prefix: []u8) -> bool {
    if (length < prefix.len) { return false; }
    let mut index: usize = 0;
    while (index < prefix.len && index < CRASH_CONSOLE_LINE_BYTES) {
        if (index >= 0 && index < CRASH_CONSOLE_LINE_BYTES &&
                index < prefix.len) {
            if (line[index] != prefix[index]) { return false; }
        } else { return false; }
        index = index + 1;
    }
    return true;
}

private fn ddb_append(line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..],
                      length: usize, byte: u8) -> usize {
    if (length < 32) {
        line[length] = byte;
        return length + 1;
    }
    return length;
}

must_use variant DdbMemoryCommand {
    NotMemory;
    Invalid;
    Kernel((usize, usize));
    Physical((usize, usize));
}

must_use variant DdbUserMemoryCommand {
    NotUserMemory;
    Invalid;
    User((usize, usize, usize));
}

private fn ddb_hex_digit(byte: u8) -> usize {
    if (byte >= 0x30 && byte <= 0x39) { return (byte - 0x30) as usize; }
    if (byte >= 0x61 && byte <= 0x66) {
        return ((byte - 0x61) as usize) + 10;
    }
    if (byte >= 0x41 && byte <= 0x46) {
        return ((byte - 0x41) as usize) + 10;
    }
    return 16;
}

// `xk ADDRESS [COUNT]` or `xp ADDRESS [COUNT]`, with a deliberately small
// report bound. ADDRESS is
// hexadecimal (an optional 0x prefix); COUNT is decimal and defaults to 16.
private fn ddb_parse_memory(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..], length: usize)
        -> DdbMemoryCommand {
    let kernel_command: bool =
        ddb_command_starts_with(line, length, bs"xk ");
    let physical_command: bool =
        ddb_command_starts_with(line, length, bs"xp ");
    if (kernel_command == false && physical_command == false) {
        return DdbMemoryCommand::NotMemory;
    }
    let prefixed: bool = length >= 5 && line[3] == 0x30 && line[4] == 0x78;
    let mut address: usize = 0;
    let mut address_digits: usize = 0;
    let mut parsing_count: bool = false;
    let mut count: usize = 16;
    let mut count_digits: usize = 0;
    for index: usize in 3..<32 {
        if (index < length) {
            let byte: u8 = line[index];
            if (prefixed && (index == 3 || index == 4)) {
                // The prefix was validated above; neither byte is a digit.
            } else if (parsing_count) {
                if (count_digits == 0) { count = 0; }
                if (byte < 0x30 || byte > 0x39 || count > 6) {
                    return DdbMemoryCommand::Invalid;
                }
                count = count * 10 + ((byte - 0x30) as usize);
                count_digits = count_digits + 1;
            } else if (byte == 0x20) {
                if (address_digits == 0) { return DdbMemoryCommand::Invalid; }
                parsing_count = true;
            } else {
                let digit: usize = ddb_hex_digit(byte);
                if (digit >= 16 ||
                        address > (0xFFFFFFFFFFFFFFFF - digit) / 16) {
                    return DdbMemoryCommand::Invalid;
                }
                address = address * 16 + digit;
                address_digits = address_digits + 1;
            }
        }
    }
    if (address_digits == 0 || (parsing_count && count_digits == 0)) {
        return DdbMemoryCommand::Invalid;
    }
    if (count == 0 || count > 64 || address > 0xFFFFFFFFFFFFFFFF - count) {
        return DdbMemoryCommand::Invalid;
    }
    if (physical_command) {
        return DdbMemoryCommand::Physical((address, count));
    }
    return DdbMemoryCommand::Kernel((address, count));
}

// `xu PID HEX_ADDRESS [COUNT]`. PID/count are decimal; the address is hex.
private fn ddb_parse_user_memory(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..], length: usize)
        -> DdbUserMemoryCommand {
    if (ddb_command_starts_with(line, length, bs"xu ") == false) {
        return DdbUserMemoryCommand::NotUserMemory;
    }
    let mut field: usize = 0;
    let mut pid: usize = 0;
    let mut pid_digits: usize = 0;
    let mut address: usize = 0;
    let mut address_digits: usize = 0;
    let mut count: usize = 16;
    let mut count_digits: usize = 0;
    for index: usize in 3..<32 {
        if (index < length) {
            let byte: u8 = line[index];
            if (byte == 0x20) {
                if (field == 0 && pid_digits != 0) { field = 1; }
                else if (field == 1 && address_digits != 0) { field = 2; }
                else { return DdbUserMemoryCommand::Invalid; }
            } else if (field == 0) {
                if (byte < 0x30 || byte > 0x39) {
                    return DdbUserMemoryCommand::Invalid;
                }
                let digit: usize = (byte - 0x30) as usize;
                if (pid > (0xFFFFFFFFFFFFFFFF - digit) / 10) {
                    return DdbUserMemoryCommand::Invalid;
                }
                pid = pid * 10 + digit;
                pid_digits = pid_digits + 1;
            } else if (field == 1) {
                let digit: usize = ddb_hex_digit(byte);
                if (digit >= 16 ||
                        address > (0xFFFFFFFFFFFFFFFF - digit) / 16) {
                    return DdbUserMemoryCommand::Invalid;
                }
                address = address * 16 + digit;
                address_digits = address_digits + 1;
            } else {
                if (count_digits == 0) { count = 0; }
                if (byte < 0x30 || byte > 0x39 || count > 6) {
                    return DdbUserMemoryCommand::Invalid;
                }
                count = count * 10 + ((byte - 0x30) as usize);
                count_digits = count_digits + 1;
            }
        }
    }
    if (pid == 0 || address_digits == 0 ||
            (field == 2 && count_digits == 0) ||
            count == 0 || count > 64 ||
            address > 0xFFFFFFFFFFFFFFFF - count) {
        return DdbUserMemoryCommand::Invalid;
    }
    return DdbUserMemoryCommand::User((pid, address, count));
}

must_use variant DdbBacktraceCommand {
    NotBacktrace;
    Invalid;
    Current;
    Cpu(usize);
    Process(usize);
}

private fn ddb_parse_backtrace(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..], length: usize)
        -> DdbBacktraceCommand {
    if (ddb_command_is(line, length, bs"bt")) {
        return DdbBacktraceCommand::Current;
    }
    // GitHub issue #505: selection is explicit. `bt` is the CPU running the
    // debugger, `bt cpu N` is another stopped CPU, `bt PID` is a saved
    // non-running process -- three different questions that used to be two,
    // one of which answered "capture that cpu" and offered no way to.
    if (ddb_command_starts_with(line, length, bs"bt cpu ")) {
        let mut core: usize = 0;
        let mut core_digits: usize = 0;
        for index: usize in 7..<32 {
            if (index < length) {
                let byte: u8 = line[index];
                if (byte < 0x30 || byte > 0x39) {
                    return DdbBacktraceCommand::Invalid;
                }
                let digit: usize = (byte - 0x30) as usize;
                if (core > (0xFFFFFFFFFFFFFFFF - digit) / 10) {
                    return DdbBacktraceCommand::Invalid;
                }
                core = core * 10 + digit;
                core_digits = core_digits + 1;
            }
        }
        if (core_digits == 0) { return DdbBacktraceCommand::Invalid; }
        return DdbBacktraceCommand::Cpu(core);
    }
    if (ddb_command_starts_with(line, length, bs"bt ") == false) {
        return DdbBacktraceCommand::NotBacktrace;
    }
    let mut pid: usize = 0;
    let mut digits: usize = 0;
    for index: usize in 3..<32 {
        if (index < length) {
            let byte: u8 = line[index];
            if (byte < 0x30 || byte > 0x39) {
                return DdbBacktraceCommand::Invalid;
            }
            let digit: usize = (byte - 0x30) as usize;
            if (pid > (0xFFFFFFFFFFFFFFFF - digit) / 10) {
                return DdbBacktraceCommand::Invalid;
            }
            pid = pid * 10 + digit;
            digits = digits + 1;
        }
    }
    if (digits == 0 || pid == 0) {
        return DdbBacktraceCommand::Invalid;
    }
    return DdbBacktraceCommand::Process(pid);
}

must_use variant DdbByteReadResult { Fault; Read(usize); }
must_use variant DdbWordReadResult { Fault; Read(usize); }
must_use variant DdbUserTranslateResult { Unmapped; Fault; Mapped(usize); }

private fn ddb_read_kernel_byte(address: usize)
        -> DdbByteReadResult !{unsafe} {
    let guard: *DdbGuardedRead = kernel_ddb_memory_access_here();
    guard.address = address;
    guard.faulted = false;
    guard.active = true;
    let value: usize = kernel_ddb_guarded_read_u8(address);
    guard.active = false;
    if (guard.faulted) {
        return DdbByteReadResult::Fault;
    }
    return DdbByteReadResult::Read(value);
}

private fn ddb_read_kernel_word(address: usize)
        -> DdbWordReadResult !{unsafe} {
    if (address > 0xFFFFFFFFFFFFFFFF - 8) {
        return DdbWordReadResult::Fault;
    }
    let mut value: usize = 0;
    for byte: usize in 0..<8 {
        match ddb_read_kernel_byte(address + byte) {
            DdbByteReadResult::Fault => { return DdbWordReadResult::Fault; }
            DdbByteReadResult::Read(part) => {
                value = value | ((part & 0xFF) << (byte * 8));
            }
        }
    }
    return DdbWordReadResult::Read(value);
}

private fn ddb_translate_user(stopped: borrow WorldStopped[id],
                              l2: usize, virtual: usize)
        -> DdbUserTranslateResult !{unsafe} {
    if (virtual < USER_TEXT_VA) { return DdbUserTranslateResult::Unmapped; }
    let offset: usize = virtual - USER_TEXT_VA;
    let index: usize = offset / PAGE_SIZE;
    if (index >= USER_SPACE_PAGE_COUNT) {
        return DdbUserTranslateResult::Unmapped;
    }
    if (page_ddb_kernel_address_readable(stopped, l2, PAGE_SIZE) == false) {
        return DdbUserTranslateResult::Fault;
    }
    let branch: usize = index / USER_L3_PAGE_COUNT;
    match ddb_read_kernel_word(l2 + branch * 8) {
        DdbWordReadResult::Fault => { return DdbUserTranslateResult::Fault; }
        DdbWordReadResult::Read(l2_entry) => {
            if ((l2_entry & 3) != 3) {
                return DdbUserTranslateResult::Unmapped;
            }
            let l3: usize = l2_entry & 0x0000FFFFFFFFF000;
            if (page_ddb_kernel_address_readable(
                    stopped, l3, PAGE_SIZE) == false) {
                return DdbUserTranslateResult::Fault;
            }
            let entry: usize = index % USER_L3_PAGE_COUNT;
            match ddb_read_kernel_word(l3 + entry * 8) {
                DdbWordReadResult::Fault => {
                    return DdbUserTranslateResult::Fault;
                }
                DdbWordReadResult::Read(pte) => {
                    if ((pte & 3) != 3) {
                        return DdbUserTranslateResult::Unmapped;
                    }
                    let page: usize = pte & USER_PAGE_PHYS_MASK;
                    return DdbUserTranslateResult::Mapped(
                        page + (virtual % PAGE_SIZE));
                }
            }
        }
    }
}

private fn ddb_render_kernel_memory(address: usize, count: usize) !{unsafe} {
    ddb_puts("ddb: xk address="); ddb_put_hex(address);
    ddb_puts(" count="); ddb_put_udec(count);
    ddb_puts("\n");
    let mut offset: usize = 0;
    while (offset < count && offset < 64) {
        match ddb_read_kernel_byte(address + offset) {
            DdbByteReadResult::Fault => {
                ddb_puts("ddb: xk fault address=");
                ddb_put_hex(address + offset);
                ddb_puts("\n");
                return;
            }
            DdbByteReadResult::Read(value) => {
                ddb_puts("ddb: xk byte address=");
                ddb_put_hex(address + offset);
                ddb_puts(" value="); ddb_put_hex(value & 0xFF);
                ddb_puts("\n");
            }
        }
        offset = offset + 1;
    }
}

private fn ddb_command_kernel_memory(stopped: borrow WorldStopped[id],
                                     address: usize, count: usize) !{unsafe} {
    if (page_ddb_kernel_address_readable(stopped, address, count) == false) {
        ddb_puts("ddb: xk denied (not ordinary kernel RAM) address=");
        ddb_put_hex(address);
        ddb_puts(" count="); ddb_put_udec(count);
        ddb_puts("\n");
        return;
    }
    ddb_render_kernel_memory(address, count);
}

private fn ddb_command_physical_memory(stopped: borrow WorldStopped[id],
                                       address: usize, count: usize) !{unsafe} {
    if (page_ddb_physical_address_readable(stopped, address, count) == false) {
        ddb_puts("ddb: xp denied (not ordinary physical RAM) address=");
        ddb_put_hex(address);
        ddb_puts(" count="); ddb_put_udec(count);
        ddb_puts("\n");
        return;
    }
    ddb_puts("ddb: xp physical="); ddb_put_hex(address);
    ddb_puts(" count="); ddb_put_udec(count);
    ddb_puts("\n");
    let mut offset: usize = 0;
    while (offset < count && offset < 64) {
        let physical: usize = address + offset;
        match ddb_read_kernel_byte(physical) {
            DdbByteReadResult::Fault => {
                ddb_puts("ddb: xp fault physical="); ddb_put_hex(physical);
                ddb_puts("\n");
                return;
            }
            DdbByteReadResult::Read(value) => {
                ddb_puts("ddb: xp byte physical="); ddb_put_hex(physical);
                ddb_puts(" value="); ddb_put_hex(value & 0xFF);
                ddb_puts("\n");
            }
        }
        offset = offset + 1;
    }
}

private fn ddb_render_user_memory(stopped: borrow WorldStopped[id],
                                  pid: usize, address: usize, count: usize)
        !{unsafe} {
    let mut root: usize = 0;
    let mut l2: usize = 0;
    let mut found: bool = false;
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < ddb_snapshot.process_count &&
                ddb_snapshot.processes[index].pid == pid) {
            root = ddb_snapshot.processes[index].root_slot;
            l2 = ddb_snapshot.process_l2[index];
            found = true;
        }
    }
    if (found == false) {
        ddb_puts("ddb: xu pid not captured");
        if (ddb_snapshot.process_truncated != 0) {
            ddb_puts(" (snapshot truncated)");
        }
        ddb_puts("\n");
        return;
    }
    ddb_puts("ddb: xu pid="); ddb_put_udec(pid);
    ddb_puts(" root="); ddb_put_udec(root);
    ddb_puts(" address="); ddb_put_hex(address);
    ddb_puts(" count="); ddb_put_udec(count);
    ddb_puts("\n");
    let mut offset: usize = 0;
    while (offset < count && offset < 64) {
        let virtual: usize = address + offset;
        let mut physical: usize = 0;
        match ddb_translate_user(stopped, l2, virtual) {
            DdbUserTranslateResult::Unmapped => {
                ddb_puts("ddb: xu unmapped address="); ddb_put_hex(virtual);
                ddb_puts("\n");
                return;
            }
            DdbUserTranslateResult::Fault => {
                ddb_puts("ddb: xu page-table fault address=");
                ddb_put_hex(virtual);
                ddb_puts("\n");
                return;
            }
            DdbUserTranslateResult::Mapped(mapped) => { physical = mapped; }
        }
        if (page_ddb_kernel_address_readable(stopped, physical, 1) == false) {
            ddb_puts("ddb: xu invalid physical="); ddb_put_hex(physical);
            ddb_puts("\n");
            return;
        }
        match ddb_read_kernel_byte(physical) {
            DdbByteReadResult::Fault => {
                ddb_puts("ddb: xu fault address="); ddb_put_hex(virtual);
                ddb_puts(" physical="); ddb_put_hex(physical);
                ddb_puts("\n");
                return;
            }
            DdbByteReadResult::Read(value) => {
                ddb_puts("ddb: xu byte address="); ddb_put_hex(virtual);
                ddb_puts(" physical="); ddb_put_hex(physical);
                ddb_puts(" value="); ddb_put_hex(value & 0xFF);
                ddb_puts("\n");
            }
        }
        offset = offset + 1;
    }
}

private fn ddb_render_regs() !{unsafe} {
    let frame: *ExceptionFrame = unsafe {
        ddb_snapshot.frame_sp as *ExceptionFrame
    };
    ddb_puts("ddb: x0="); ddb_put_hex(frame.x0);
    ddb_puts(" x1="); ddb_put_hex(frame.x1);
    ddb_puts(" x2="); ddb_put_hex(frame.x2);
    ddb_puts(" x3="); ddb_put_hex(frame.x3);
    ddb_puts("\nddb: x4="); ddb_put_hex(frame.x4);
    ddb_puts(" x5="); ddb_put_hex(frame.x5);
    ddb_puts(" x6="); ddb_put_hex(frame.x6);
    ddb_puts(" x7="); ddb_put_hex(frame.x7);
    ddb_puts("\nddb: x8="); ddb_put_hex(frame.x8);
    ddb_puts(" x9="); ddb_put_hex(frame.x9);
    ddb_puts(" x10="); ddb_put_hex(frame.x10);
    ddb_puts(" x11="); ddb_put_hex(frame.x11);
    ddb_puts("\nddb: x12="); ddb_put_hex(frame.x12);
    ddb_puts(" x13="); ddb_put_hex(frame.x13);
    ddb_puts(" x14="); ddb_put_hex(frame.x14);
    ddb_puts(" x15="); ddb_put_hex(frame.x15);
    ddb_puts("\nddb: x16="); ddb_put_hex(frame.x16);
    ddb_puts(" x17="); ddb_put_hex(frame.x17);
    ddb_puts(" x18="); ddb_put_hex(frame.x18);
    ddb_puts(" x19="); ddb_put_hex(frame.x19);
    ddb_puts("\nddb: x20="); ddb_put_hex(frame.x20);
    ddb_puts(" x21="); ddb_put_hex(frame.x21);
    ddb_puts(" x22="); ddb_put_hex(frame.x22);
    ddb_puts(" x23="); ddb_put_hex(frame.x23);
    ddb_puts("\nddb: x24="); ddb_put_hex(frame.x24);
    ddb_puts(" x25="); ddb_put_hex(frame.x25);
    ddb_puts(" x26="); ddb_put_hex(frame.x26);
    ddb_puts(" x27="); ddb_put_hex(frame.x27);
    ddb_puts("\nddb: x28="); ddb_put_hex(frame.x28);
    ddb_puts(" x29="); ddb_put_hex(frame.x29);
    ddb_puts(" x30="); ddb_put_hex(frame.x30);
    ddb_puts("\n");
    ddb_puts("ddb: sp_el0="); ddb_put_hex(frame.sp_el0);
    ddb_puts(" elr="); ddb_put_hex(frame.elr_el1);
    ddb_puts(" spsr="); ddb_put_hex(frame.spsr_el1);
    ddb_puts(" tpidr_el0="); ddb_put_hex(frame.tpidr_el0);
    ddb_puts("\n");
}

const DDB_BACKTRACE_FRAMES: usize = 32;

struct DdbUnwindRoot {
    source: usize;
    cpu: usize;
    pid: usize;
    pc: usize;
    fp: usize;
    stack_floor: usize;
    stack_bottom: usize;
    stack_top: usize;
}

extern symbol kernel_text_start;
extern symbol kernel_text_end;
extern symbol kernel_generated_text_start;
extern symbol kernel_generated_text_end;
extern symbol kernel_ddb_breakpoint_start;
extern symbol kernel_ddb_breakpoint_end;

private fn ddb_bt_stop(reason: *u8, fp: usize) !{unsafe} {
    ddb_puts("ddb: bt stop="); ddb_puts(reason);
    ddb_puts(" fp="); ddb_put_hex(fp);
    ddb_puts("\n");
}

private fn ddb_pc_is_generated(pc: usize) -> bool {
    return pc >= kernel_generated_text_start &&
           pc < kernel_generated_text_end;
}

private fn ddb_pc_is_breakpoint_bridge(pc: usize) -> bool {
    return pc >= kernel_ddb_breakpoint_start &&
           pc < kernel_ddb_breakpoint_end;
}

private fn ddb_saved_context_valid(saved_sp: usize, stack_bottom: usize,
                                   stack_top: usize) -> bool {
    if (saved_sp == 0 || saved_sp % 16 != 0 || stack_bottom == 0 ||
        stack_top <= stack_bottom || saved_sp < stack_bottom ||
        saved_sp >= stack_top) {
        return false;
    }
    return stack_top - saved_sp >= EXC_CONTEXT_SIZE;
}

// The compiler owns the record shape: --frame-pointers makes every Takibi
// function use AArch64's canonical [previous x29, saved x30] pair. This
// walker owns only validation and policy. A future stopped-CPU capture can
// supply another DdbUnwindRoot without changing the frame contract.
private fn ddb_walk_backtrace(root: DdbUnwindRoot, limit: usize) !{unsafe} {
    ddb_puts("ddb: bt source=");
    if (root.source == 1) {
        ddb_puts("cpu cpu="); ddb_put_udec(root.cpu & 0xFF);
    } else {
        ddb_puts("saved");
    }
    ddb_puts(" pid="); ddb_put_udec(root.pid);
    ddb_puts(" stack="); ddb_put_hex(root.stack_bottom);
    ddb_puts(".."); ddb_put_hex(root.stack_top);
    ddb_puts("\n");
    if (root.pc % 4 != 0) {
        ddb_bt_stop("misaligned-pc", root.fp);
        return;
    }
    if (root.pc < kernel_text_start || root.pc >= kernel_text_end) {
        ddb_bt_stop("unsupported-pc", root.fp);
        return;
    }
    ddb_puts("ddb: bt frame=0 pc="); ddb_put_hex(root.pc);
    if (ddb_pc_is_generated(root.pc)) {
        ddb_puts(" boundary=exception\n");
    } else if (ddb_pc_is_breakpoint_bridge(root.pc)) {
        ddb_puts(" boundary=assembly-bridge\n");
    } else {
        ddb_puts(" boundary=assembly\n");
        ddb_bt_stop("assembly-boundary", root.fp);
        return;
    }
    let mut frames: usize = 1;
    let mut fp: usize = root.fp;
    while (fp != 0) {
        if (frames >= limit) {
            ddb_bt_stop("depth-limit", fp);
            return;
        }
        if (fp % 16 != 0) {
            ddb_bt_stop("misaligned-frame", fp);
            return;
        }
        if (root.stack_bottom == 0 || root.stack_top <= root.stack_bottom ||
                fp < root.stack_floor || fp < root.stack_bottom ||
                fp > root.stack_top - 16) {
            ddb_bt_stop("out-of-range", fp);
            return;
        }
        let mut previous: usize = 0;
        match ddb_read_kernel_word(fp) {
            DdbWordReadResult::Fault => {
                ddb_bt_stop("memory-fault", fp);
                return;
            }
            DdbWordReadResult::Read(value) => { previous = value; }
        }
        let mut return_pc: usize = 0;
        match ddb_read_kernel_word(fp + 8) {
            DdbWordReadResult::Fault => {
                ddb_bt_stop("memory-fault", fp);
                return;
            }
            DdbWordReadResult::Read(value) => { return_pc = value; }
        }
        if (return_pc % 4 != 0 || return_pc < kernel_text_start ||
                return_pc >= kernel_text_end) {
            ddb_bt_stop("invalid-return-pc", fp);
            return;
        }
        ddb_puts("ddb: bt frame="); ddb_put_udec(frames);
        ddb_puts(" pc="); ddb_put_hex(return_pc);
        ddb_puts(" fp="); ddb_put_hex(fp);
        if (ddb_pc_is_generated(return_pc)) {
            ddb_puts("\n");
        } else {
            ddb_puts(" boundary=assembly\n");
            ddb_bt_stop("assembly-boundary", fp);
            return;
        }
        frames = frames + 1;
        if (previous == 0) {
            ddb_puts("ddb: bt complete frames="); ddb_put_udec(frames);
            ddb_puts("\n");
            return;
        }
        if (previous <= fp) {
            ddb_bt_stop("nonmonotonic-frame", previous);
            return;
        }
        fp = previous;
    }
    ddb_puts("ddb: bt complete frames="); ddb_put_udec(frames);
    ddb_puts("\n");
}

// GitHub issue #505: where a stopped peer was, published by the peer itself.
//
// DDB already stops the world -- kernel_ddb_enter only inspects on a
// Complete token -- so the protocol this issue asks for exists. What did not
// exist is a ROOT for a CPU that is not the one running the debugger, so
// `bt PID` refused a Running process with "capture that cpu" and there was
// no way to capture it.
//
// The peer publishes as it enters the holding pen and retires as it leaves.
// That is the only moment its own interrupted frame is addressable, and it
// costs the stop nothing: the pen already spins there.
//
// `sequence` is odd while a core is publishing and even when a record is
// settled, so a reader that sees the same EVEN value before and after its
// read has a root that did not change under it -- which is the "reject a
// root whose generation changed during capture" clause, expressed without
// reaching into kernel/lib/occupancy.tkb's private generation.
struct DdbStoppedRoot {
    sequence: usize;
    cpu: usize;
    pid: usize;
    frame_sp: usize;
}

private let mut ddb_stopped_root: [DdbStoppedRoot; KERNEL_MAX_CORES];

private fn ddb_stopped_sequence_address(core: usize) -> usize {
    let base: *DdbStoppedRoot = ddb_stopped_root;
    if (core >= KERNEL_MAX_CORES) { return (&(base).sequence) as usize; }
    return (&(base + (core as isize)).sequence) as usize;
}

// Called from each platform's interrupt dispatcher on the world-stop SGI,
// with the frame that interrupt saved, immediately before the holding pen.
fn kernel_ddb_stopped_root_publish(frame_sp: usize, pid: usize)
        !{interrupt, unsafe} {
    let raw_cpu: usize = cpu_id();
    if (raw_cpu >= KERNEL_MAX_CORES) { return; }
    let core: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    let settled: usize = ddb_stopped_root[core].sequence;
    // Odd first: a reader arriving now sees "being written" rather than the
    // previous stop's frame, which would still look entirely plausible.
    unsafe {
        atomic_store_release(ddb_stopped_sequence_address(raw_cpu),
                             settled + 1);
    }
    ddb_stopped_root[core].cpu = raw_cpu;
    ddb_stopped_root[core].pid = pid;
    ddb_stopped_root[core].frame_sp = frame_sp;
    unsafe {
        atomic_store_release(ddb_stopped_sequence_address(raw_cpu),
                             settled + 2);
    }
}

// What a peer does when the world-stop SGI arrives: say where it is, wait,
// then take the record back.
//
// One body rather than two. The platform dispatchers differ in the SGI id and
// the EOI register and in nothing else here, and
// scripts/check_platform_file_parity.py refused the first version of this for
// exactly that reason -- three added lines took the shared run past its
// threshold, which is the check working rather than the check complaining.
fn kernel_world_stop_serve(frame_sp: usize) !{interrupt, unsafe} {
    kernel_ddb_stopped_root_publish(frame_sp, kernel_process_current_pid());
    world_stop_interrupt_hold();
    kernel_ddb_stopped_root_retire();
}

// Called after the pen releases. The root is retired rather than left
// standing: a stale one reads exactly like a fresh one, which is the failure
// kernel/arch/arm64/kernel/exception_evidence.tkb's own crash snapshot was
// repaired for in issue #486.
fn kernel_ddb_stopped_root_retire() !{interrupt, unsafe} {
    let raw_cpu: usize = cpu_id();
    if (raw_cpu >= KERNEL_MAX_CORES) { return; }
    let core: {0..<KERNEL_MAX_CORES as usize} = raw_cpu;
    ddb_stopped_root[core].frame_sp = 0;
    unsafe {
        atomic_store_release(ddb_stopped_sequence_address(raw_cpu),
                             ddb_stopped_root[core].sequence + 1);
    }
}

must_use variant DdbStoppedRootResult {
    NotStopped;
    Changed;
    Root(DdbUnwindRoot);
}

// The decision, separated from the read so it can be exercised without a
// second core: whether a pair of sequence observations and a frame pointer
// describe a root that may be walked.
//
// A single-threaded test cannot make a value change between two loads, so
// what is testable is this -- and this is the part that can be wrong. The
// read around it is three loads and a struct copy.
must_use variant DdbStoppedCheck {
    Unstopped;
    Moved;
    Usable;
}

private fn ddb_stopped_root_check(before: usize, after: usize,
                                  frame_sp: usize) -> DdbStoppedCheck {
    // Zero: never held here. Odd: a core is mid-publish, so the fields
    // belong to no settled record.
    if (before == 0 || (before % 2) != 0) { return DdbStoppedCheck::Unstopped; }
    if (after != before) { return DdbStoppedCheck::Moved; }
    // Retired: the core left the pen and its frame is no longer addressable.
    if (frame_sp == 0) { return DdbStoppedCheck::Unstopped; }
    return DdbStoppedCheck::Usable;
}

// Read one stopped peer's root, twice, and refuse anything that moved.
private fn ddb_stopped_unwind_root(core: usize) -> DdbStoppedRootResult
        !{unsafe} {
    if (core >= KERNEL_MAX_CORES) { return DdbStoppedRootResult::NotStopped; }
    let bounded: {0..<KERNEL_MAX_CORES as usize} = core;
    let before: usize =
        unsafe { atomic_load_acquire(ddb_stopped_sequence_address(core)) };
    let frame_sp: usize = ddb_stopped_root[bounded].frame_sp;
    let pid: usize = ddb_stopped_root[bounded].pid;
    let after: usize =
        unsafe { atomic_load_acquire(ddb_stopped_sequence_address(core)) };
    match ddb_stopped_root_check(before, after, frame_sp) {
        DdbStoppedCheck::Unstopped => {
            return DdbStoppedRootResult::NotStopped;
        }
        DdbStoppedCheck::Moved => { return DdbStoppedRootResult::Changed; }
        DdbStoppedCheck::Usable => { }
    }
    let frame: *ExceptionFrame = unsafe { frame_sp as *ExceptionFrame };
    let run_bottom: usize =
        (frame_sp / KERNEL_STACK_RUN_BYTES) * KERNEL_STACK_RUN_BYTES;
    let mut root: DdbUnwindRoot = {
        1,
        core,
        pid,
        frame.elr_el1,
        frame.x29,
        frame_sp + EXC_CONTEXT_SIZE,
        run_bottom + KERNEL_PROCESS_STACK_SIZE,
        run_bottom + KERNEL_STACK_RUN_BYTES
    };
    return DdbStoppedRootResult::Root(root);
}

private fn ddb_current_unwind_root() -> DdbUnwindRoot !{unsafe} {
    let frame: *ExceptionFrame = unsafe {
        ddb_snapshot.frame_sp as *ExceptionFrame
    };
    let run_bottom: usize =
        (ddb_snapshot.frame_sp / KERNEL_STACK_RUN_BYTES) *
        KERNEL_STACK_RUN_BYTES;
    let mut root: DdbUnwindRoot = {
        1,
        ddb_snapshot.cpu,
        ddb_snapshot.process_pid,
        frame.elr_el1,
        frame.x29,
        ddb_snapshot.frame_sp + EXC_CONTEXT_SIZE,
        run_bottom + KERNEL_PROCESS_STACK_SIZE,
        run_bottom + KERNEL_STACK_RUN_BYTES
    };
    return root;
}

private fn ddb_render_backtrace_current() !{unsafe} {
    let frame: *ExceptionFrame = unsafe {
        ddb_snapshot.frame_sp as *ExceptionFrame
    };
    if ((frame.spsr_el1 & 0xF) == 0) {
        let mut root: DdbUnwindRoot = ddb_current_unwind_root();
        ddb_puts("ddb: bt source=cpu cpu=");
        ddb_put_udec(ddb_snapshot.cpu & 0xFF);
        ddb_puts(" pid="); ddb_put_udec(ddb_snapshot.process_pid);
        ddb_puts(" stack="); ddb_put_hex(root.stack_bottom);
        ddb_puts(".."); ddb_put_hex(root.stack_top);
        ddb_puts("\n");
        ddb_puts("ddb: bt frame=0 pc="); ddb_put_hex(frame.elr_el1);
        ddb_puts(" boundary=user\n");
        ddb_bt_stop("user-boundary", frame.x29);
        return;
    }
    ddb_walk_backtrace(ddb_current_unwind_root(), DDB_BACKTRACE_FRAMES);
}

// GitHub issue #505: a CPU that is not the one running the debugger.
//
// Every refusal is explicit and says which one it is. "Not stopped" and "the
// root moved" are different findings -- the first is a CPU that never
// acknowledged, the second is one whose record changed under the read -- and
// reading either as a historical trace is exactly what this must not do.
private fn ddb_render_backtrace_cpu(core: usize) !{unsafe} {
    if (core == (ddb_snapshot.cpu & 0xFF)) {
        // The debugger's own CPU has a better root than the holding pen's:
        // the exception frame DDB was entered through.
        ddb_render_backtrace_current();
        return;
    }
    match ddb_stopped_unwind_root(core) {
        DdbStoppedRootResult::NotStopped => {
            ddb_puts("ddb: bt cpu="); ddb_put_udec(core);
            ddb_puts(" not stopped here\n");
        }
        DdbStoppedRootResult::Changed => {
            ddb_puts("ddb: bt cpu="); ddb_put_udec(core);
            ddb_puts(" root changed during capture\n");
        }
        DdbStoppedRootResult::Root(root) => {
            let frame: *ExceptionFrame = unsafe {
                root.stack_floor - EXC_CONTEXT_SIZE as *ExceptionFrame
            };
            if ((frame.spsr_el1 & 0xF) == 0) {
                ddb_puts("ddb: bt source=stopped cpu="); ddb_put_udec(core);
                ddb_puts(" pid="); ddb_put_udec(root.pid);
                ddb_puts(" stack="); ddb_put_hex(root.stack_bottom);
                ddb_puts(".."); ddb_put_hex(root.stack_top);
                ddb_puts("\n");
                ddb_puts("ddb: bt frame=0 pc="); ddb_put_hex(root.pc);
                ddb_puts(" boundary=user\n");
                ddb_bt_stop("user-boundary", root.fp);
                return;
            }
            ddb_puts("ddb: bt source=stopped cpu="); ddb_put_udec(core);
            ddb_puts(" pid="); ddb_put_udec(root.pid);
            ddb_puts(" stack="); ddb_put_hex(root.stack_bottom);
            ddb_puts(".."); ddb_put_hex(root.stack_top);
            ddb_puts("\n");
            ddb_walk_backtrace(root, DDB_BACKTRACE_FRAMES);
        }
    }
}

private fn ddb_render_backtrace_process(pid: usize) !{unsafe} {
    if (pid == ddb_snapshot.process_pid) {
        ddb_render_backtrace_current();
        return;
    }
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < ddb_snapshot.process_count &&
                ddb_snapshot.processes[index].pid == pid) {
            let mut record: ProcessDdbRecord = ddb_snapshot.processes[index];
            if (record.state == 2) {
                // GitHub issue #505: this used to end here. A running
                // process's saved_sp is historical, so the answer is not that
                // record -- it is the CPU the process is running ON, whose
                // root the stop published. Search the stopped cores for it
                // rather than making a person guess which one to ask.
                for core: usize in 0..<KERNEL_MAX_CORES {
                    match ddb_stopped_unwind_root(core) {
                        DdbStoppedRootResult::NotStopped => { }
                        DdbStoppedRootResult::Changed => { }
                        DdbStoppedRootResult::Root(root) => {
                            if (root.pid == pid) {
                                ddb_render_backtrace_cpu(core);
                                return;
                            }
                        }
                    }
                }
                if (pid == ddb_snapshot.process_pid) {
                    ddb_render_backtrace_current();
                    return;
                }
                ddb_puts("ddb: bt pid running on no stopped cpu\n");
                return;
            }
            if (ddb_saved_context_valid(record.saved_sp, record.stack_bottom,
                    record.stack_top) == false) {
                ddb_puts("ddb: bt pid has no valid saved context\n");
                return;
            }
            let frame: *ExceptionFrame = unsafe {
                record.saved_sp as *ExceptionFrame
            };
            if ((frame.spsr_el1 & 0xF) == 0) {
                ddb_puts("ddb: bt source=saved pid="); ddb_put_udec(pid);
                ddb_puts(" stack="); ddb_put_hex(record.stack_bottom);
                ddb_puts(".."); ddb_put_hex(record.stack_top);
                ddb_puts("\n");
                ddb_puts("ddb: bt frame=0 pc=");
                ddb_put_hex(frame.elr_el1);
                ddb_puts(" boundary=user\n");
                ddb_bt_stop("user-boundary", frame.x29);
                return;
            }
            let mut root: DdbUnwindRoot = {
                2,
                ddb_snapshot.cpu,
                pid,
                frame.elr_el1,
                frame.x29,
                record.saved_sp + EXC_CONTEXT_SIZE,
                record.stack_bottom,
                record.stack_top
            };
            ddb_walk_backtrace(root, DDB_BACKTRACE_FRAMES);
            return;
        }
    }
    ddb_puts("ddb: bt pid not captured");
    if (ddb_snapshot.process_truncated != 0) {
        ddb_puts(" (snapshot truncated)");
    }
    ddb_puts("\n");
}

private fn ddb_guarded_fault_verdict(label: *u8, active: bool,
                                     armed_address: usize, esr: usize,
                                     far: usize) !{unsafe} {
    ddb_puts("ddb: xk guarded-fault "); ddb_puts(label);
    ddb_puts(" ours=");
    if (ddb_guarded_fault_is_ours(active, armed_address, esr, far)) {
        ddb_puts("yes\n");
    } else {
        ddb_puts("no\n");
    }
}

private fn ddb_bt_test_stopped_check(label: *u8, before: usize,
                                     after: usize, frame_sp: usize)
        !{unsafe} {
    ddb_puts("ddb: bt test stopped-root "); ddb_puts(label);
    ddb_puts(" verdict=");
    match ddb_stopped_root_check(before, after, frame_sp) {
        DdbStoppedCheck::Unstopped => { ddb_puts("not-stopped\n"); }
        DdbStoppedCheck::Moved => { ddb_puts("changed\n"); }
        DdbStoppedCheck::Usable => { ddb_puts("usable\n"); }
    }
}

private fn ddb_render_backtrace_test() !{unsafe} {
    let mut valid: DdbUnwindRoot = ddb_current_unwind_root();
    let test_pc: usize = kernel_generated_text_start;
    let mut unsupported: DdbUnwindRoot = {
        valid.source, valid.cpu, valid.pid, 0, valid.fp, valid.stack_floor,
        valid.stack_bottom, valid.stack_top
    };
    ddb_walk_backtrace(unsupported, DDB_BACKTRACE_FRAMES);
    let mut bad_pc: DdbUnwindRoot = {
        valid.source, valid.cpu, valid.pid, test_pc + 1, valid.fp,
        valid.stack_floor, valid.stack_bottom, valid.stack_top
    };
    ddb_walk_backtrace(bad_pc, DDB_BACKTRACE_FRAMES);
    let mut corrupt: DdbUnwindRoot = {
        valid.source, valid.cpu, valid.pid, test_pc, 3, valid.stack_floor,
        valid.stack_bottom, valid.stack_top
    };
    ddb_walk_backtrace(corrupt, DDB_BACKTRACE_FRAMES);
    let mut outside: DdbUnwindRoot = {
        valid.source, valid.cpu, valid.pid, test_pc, valid.stack_top,
        valid.stack_floor, valid.stack_bottom, valid.stack_top
    };
    ddb_walk_backtrace(outside, DDB_BACKTRACE_FRAMES);
    let mut truncated: DdbUnwindRoot = {
        valid.source, valid.cpu, valid.pid, test_pc, valid.stack_floor,
        valid.stack_floor, valid.stack_bottom, valid.stack_top
    };
    ddb_walk_backtrace(truncated, 1);
    let saved_sp: usize = valid.stack_floor - EXC_CONTEXT_SIZE;
    if (ddb_saved_context_valid(saved_sp + 8, valid.stack_bottom,
            valid.stack_top) ||
        ddb_saved_context_valid(saved_sp, valid.stack_bottom,
            saved_sp + EXC_CONTEXT_SIZE - 1) ||
        ddb_saved_context_valid(saved_sp, valid.stack_top,
            valid.stack_bottom)) {
        ddb_puts("ddb: bt test invalid saved context accepted\n");
    } else {
        ddb_puts("ddb: bt test invalid saved contexts rejected\n");
    // GitHub issue #505: the stopped-root decision, exercised where a second
    // core cannot be arranged to move a value between two loads. Each line
    // names the observation and the verdict, so the two refusals stay
    // distinguishable -- "never acknowledged" and "moved under the read" are
    // different findings, and reading either as a historical trace is what
    // this refuses to do.
    ddb_bt_test_stopped_check("unheld", 0, 0, 0x1000);
    ddb_bt_test_stopped_check("publishing", 3, 3, 0x1000);
    ddb_bt_test_stopped_check("moved", 4, 6, 0x1000);
    ddb_bt_test_stopped_check("retired", 4, 4, 0);
    ddb_bt_test_stopped_check("settled", 4, 4, 0x1000);
    }
}

private fn ddb_render_trace() !{unsafe} {
    ddb_puts("ddb: trace count="); ddb_put_udec(ddb_snapshot.trace_count);
    ddb_puts("\n");
    for item: usize in 0..<16 {
        if (item < ddb_snapshot.trace_count) {
            let base: usize = item * KERNEL_PROCESS_TRACE_WORDS_PER_EVENT;
            ddb_puts("ddb: trace seq="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_SEQUENCE_WORD]);
            ddb_puts(" cpu="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_CPU_WORD]);
            ddb_puts(" event="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_EVENT_WORD]);
            ddb_puts(" pid="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_PID_WORD]);
            ddb_puts(" gen="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_GENERATION_WORD]);
            ddb_puts(" peer="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_PEER_PID_WORD]);
            ddb_puts(" state="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_STATE_WORD]);
            ddb_puts(" wait="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_WAIT_REASON_WORD]);
            ddb_puts(" root="); ddb_put_udec(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_ROOT_WORD]);
            ddb_puts(" sp="); ddb_put_hex(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_SAVED_SP_WORD]);
            ddb_puts(" aux="); ddb_put_hex(ddb_snapshot.trace[
                base + KERNEL_PROCESS_TRACE_AUX_WORD]);
            ddb_puts("\n");
        }
    }
}

// GitHub issue #299: this used to index a flat word buffer -- records[base
// + 3] was `a`, and the only thing tying that 3 to the writer's own
// `base + 3` was that both were typed by the same person on the same day.
// The records are DiagnosticEvent now and the fields have their names.
private fn ddb_render_events() !{interrupt, unsafe} {
    let mut records: [DiagnosticEvent; DIAGNOSTIC_TRACE_EVENTS];
    for cpu: usize in 0..<DIAGNOSTIC_TRACE_CPUS {
        let mut copied: DiagnosticTraceCopyResult =
            diagnostic_trace_copy_cpu(cpu, records as []DiagnosticEvent);
        ddb_puts("ddb: events cpu="); ddb_put_udec(cpu);
        ddb_puts(" count="); ddb_put_udec(copied.count);
        ddb_puts(" damaged="); ddb_put_udec(copied.damaged);
        ddb_puts(" overwritten="); ddb_put_udec(copied.overwritten);
        ddb_puts("\n");
        for item: usize in 0..<DIAGNOSTIC_TRACE_EVENTS {
            if (item < copied.count) {
                ddb_puts("ddb: event seq="); ddb_put_udec(records[item].seq);
                ddb_puts(" cpu="); ddb_put_udec(records[item].cpu);
                ddb_puts(" id="); ddb_put_hex(records[item].id);
                ddb_puts(" a="); ddb_put_hex(records[item].a);
                ddb_puts(" b="); ddb_put_hex(records[item].b);
                ddb_puts(" c="); ddb_put_hex(records[item].c);
                ddb_puts(" d="); ddb_put_hex(records[item].d);
                ddb_puts("\n");
            }
        }
    }
}

private fn ddb_render_oops() !{unsafe} {
    let frame: *ExceptionFrame = unsafe {
        ddb_snapshot.frame_sp as *ExceptionFrame
    };
    ddb_puts("ddb: break seq="); ddb_put_udec(ddb_snapshot.sequence);
    ddb_puts(" cpu="); ddb_put_udec(ddb_snapshot.cpu & 0xFF);
    ddb_puts(" elr="); ddb_put_hex(frame.elr_el1);
    ddb_puts(" sp_el0="); ddb_put_hex(frame.sp_el0);
    ddb_puts("\n");
}

private fn ddb_render_current() !{unsafe} {
    ddb_puts("ddb: current pid="); ddb_put_udec(ddb_snapshot.process_pid);
    ddb_puts(" parent="); ddb_put_udec(ddb_snapshot.parent_pid);
    ddb_puts(" state="); ddb_put_udec(ddb_snapshot.process_state);
    ddb_puts(" wait="); ddb_put_udec(ddb_snapshot.wait_reason);
    ddb_puts("\n");
}

private fn ddb_render_intr() !{unsafe} {
    ddb_puts("ddb: intr cpu="); ddb_put_udec(ddb_snapshot.cpu & 0xFF);
    ddb_puts(" entry=");
    if (ddb_snapshot.entry_kind == 1) { ddb_puts("irq"); }
    else if (ddb_snapshot.entry_kind == 2) { ddb_puts("brk"); }
    else { ddb_puts("unknown"); }
    ddb_puts(" source="); ddb_put_udec(ddb_snapshot.entry_source);
    ddb_puts(" live_daif="); ddb_put_hex(ddb_snapshot.live_daif);
    ddb_puts(" saved_daif="); ddb_put_hex(ddb_snapshot.saved_daif);
    ddb_puts("\n");
    if (ddb_snapshot.esr_valid != 0) {
        ddb_puts("ddb: intr esr="); ddb_put_hex(ddb_snapshot.esr_el1);
        ddb_puts(" far="); ddb_put_hex(ddb_snapshot.far_el1);
        ddb_puts("\n");
    } else {
        ddb_puts("ddb: intr esr=unavailable far=unavailable\n");
    }
}

private fn ddb_render_sched() !{unsafe} {
    let mut ready: usize = 0;
    let mut running: usize = 0;
    let mut blocked: usize = 0;
    let mut exited: usize = 0;
    let mut constructing: usize = 0;
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < ddb_snapshot.process_count) {
            let state: usize = ddb_snapshot.processes[index].state;
            if (state == 1) { ready = ready + 1; }
            else if (state == 2) { running = running + 1; }
            else if (state == 3) { blocked = blocked + 1; }
            else if (state == 4) { exited = exited + 1; }
            else if (state == 5) { constructing = constructing + 1; }
        }
    }
    ddb_puts("ddb: sched enabled=");
    ddb_put_udec(ddb_snapshot.scheduler_enabled);
    ddb_puts(" pending="); ddb_put_udec(ddb_snapshot.reschedule_pending);
    ddb_puts(" current="); ddb_put_udec(ddb_snapshot.process_pid);
    ddb_puts(" ready="); ddb_put_udec(ready);
    ddb_puts(" running="); ddb_put_udec(running);
    ddb_puts(" blocked="); ddb_put_udec(blocked);
    ddb_puts(" exited="); ddb_put_udec(exited);
    if (constructing != 0) {
        ddb_puts(" constructing="); ddb_put_udec(constructing);
    }
    ddb_puts(" truncated="); ddb_put_udec(ddb_snapshot.process_truncated);
    ddb_puts("\n");
}

private fn ddb_render_vm() !{unsafe} {
    ddb_puts("ddb: vm pid="); ddb_put_udec(ddb_snapshot.process_pid);
    ddb_puts(" root="); ddb_put_udec(ddb_snapshot.root_slot);
    ddb_puts(" live="); ddb_put_udec(ddb_snapshot.root_live);
    ddb_puts(" asid="); ddb_put_udec(ddb_snapshot.root_asid);
    ddb_puts(" l1="); ddb_put_hex(ddb_snapshot.root_l1);
    ddb_puts("\n");
}

private fn ddb_render_fds() !{unsafe} {
    ddb_puts("ddb: fds pid="); ddb_put_udec(ddb_snapshot.process_pid);
    ddb_puts(" slots="); ddb_put_udec(CRASH_FD_SNAPSHOT_SLOTS);
    ddb_puts("\n");
    for fd: usize in 0..<CRASH_FD_SNAPSHOT_SLOTS {
        if (ddb_snapshot.fd_kind[fd] != 0) {
            ddb_puts("ddb: fd="); ddb_put_udec(fd);
            ddb_puts(" kind="); ddb_put_udec(ddb_snapshot.fd_kind[fd]);
            ddb_puts(" object="); ddb_put_udec(ddb_snapshot.fd_object[fd]);
            ddb_puts("\n");
        }
    }
}

private fn ddb_render_process(record: ProcessDdbRecord) !{unsafe} {
    ddb_puts(" pid="); ddb_put_udec(record.pid);
    ddb_puts(" ppid="); ddb_put_udec(record.ppid);
    ddb_puts(" state="); ddb_put_udec(record.state);
    ddb_puts(" wait="); ddb_put_udec(record.wait_reason);
    ddb_puts(" root="); ddb_put_udec(record.root_slot);
    ddb_puts(" sp="); ddb_put_hex(record.saved_sp);
    ddb_puts("\n");
}

private fn ddb_render_ps() !{unsafe} {
    ddb_puts("ddb: ps count="); ddb_put_udec(ddb_snapshot.process_count);
    ddb_puts(" truncated="); ddb_put_udec(ddb_snapshot.process_truncated);
    ddb_puts("\n");
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < ddb_snapshot.process_count) {
            ddb_puts("ddb: ps");
            ddb_render_process(ddb_snapshot.processes[index]);
        }
    }
}

// GitHub issue #529: the causal edge, derived from the snapshot already
// taken.
//
// `ps`, `sched` and `current` between them held every fact needed to explain
// issue #524's stall, and it was still assembled by hand: a parent Blocked on
// ChildExit over a child that was itself the current, non-preemptible process
// waiting in accept for a network event. Every fact was on the screen; the
// relation between them was not. This adds no instrumentation to the failing
// path -- it walks the stopped records once and prints what they already say.
//
// What it must not do is claim an edge the kernel does not know. A process
// waiting for UART, network, a deadline or a signal is waiting for an EVENT,
// not for another process, and guessing which future process will deliver it
// would turn a diagnosis into a suggestion. Only ChildExit names a process,
// because a parent's children name themselves in their own `ppid`.
//
// The names come from the same two integer vocabularies `ps` prints raw, and
// scripts/check_ddb_wait_reason_names.py holds the two namers below to the
// enums kernel/kernel/process.tkb encodes them from: a reason added there
// and not named here would print as a number again, which is the thing this
// view exists to stop.
private fn ddb_state_name(state: usize) -> *u8 {
    match state {
        0 => { return "free"; }
        1 => { return "ready"; }
        2 => { return "running"; }
        3 => { return "blocked"; }
        4 => { return "exited"; }
        5 => { return "constructing"; }
        _ => { return "unknown"; }
    }
}

private fn ddb_wait_reason_name(reason: usize) -> *u8 {
    match reason {
        0 => { return "none"; }
        1 => { return "uart-rx"; }
        2 => { return "child-exit"; }
        3 => { return "net-rx"; }
        4 => { return "deadline"; }
        5 => { return "signal"; }
        6 => { return "uart-tx"; }
        _ => { return "unknown"; }
    }
}

// One edge per process that is waiting for anything, plus a header naming the
// current process and a trailer counting what was rendered.
//
// `awaited` on the header is #524's whole shape in one digit: the current
// process is Running and something is blocked on its exit, so the condition
// that authorises holding the machine is produced by the thing the machine is
// being held for.
//
// A process is asked about when it is Blocked OR when it carries a wait
// reason, not only when it is Blocked. That is deliberate: #524's child was
// the RUNNING process and its reason was the network. A loop over blocked
// records alone would have dropped the one record that explains the stall.
//
// Records are matched by pid within this one snapshot; nothing is
// dereferenced and no live structure is walked. A pid can be recycled, so a
// parent whose child is gone reports `child unknown` rather than attaching
// to whatever now answers to that number, and the trailer counts those
// separately so an unresolved chain cannot read as a resolved one.
private fn ddb_render_wait_from(
        records: borrow [ProcessDdbRecord; DDB_PROCESS_RECORDS..],
        count: usize, truncated: usize, current_pid: usize,
        current_state: usize, current_reason: usize) !{unsafe} {
    let mut awaited: usize = 0;
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < count && records[index].state == 3 &&
                records[index].wait_reason == 2) {
            for child: usize in 0..<DDB_PROCESS_RECORDS {
                if (child < count && records[child].pid == current_pid &&
                        records[child].ppid == records[index].pid) {
                    awaited = 1;
                }
            }
        }
    }
    ddb_puts("ddb: wait current="); ddb_put_udec(current_pid);
    ddb_puts(" state="); ddb_puts(ddb_state_name(current_state));
    ddb_puts(" reason="); ddb_puts(ddb_wait_reason_name(current_reason));
    ddb_puts(" awaited="); ddb_put_udec(awaited);
    ddb_puts("\n");

    let mut edges: usize = 0;
    let mut blocked: usize = 0;
    let mut unknown: usize = 0;
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < count) {
            let pid: usize = records[index].pid;
            let state: usize = records[index].state;
            let reason: usize = records[index].wait_reason;
            if (state == 3) { blocked = blocked + 1; }
            if (state == 3 || reason != 0) {
                if (reason == 2) {
                    let mut children: usize = 0;
                    for child: usize in 0..<DDB_PROCESS_RECORDS {
                        if (child < count && records[child].ppid == pid &&
                                records[child].pid != 0) {
                            ddb_puts("ddb: wait pid="); ddb_put_udec(pid);
                            ddb_puts(" state="); ddb_puts(ddb_state_name(state));
                            ddb_puts(" waits-for child pid=");
                            ddb_put_udec(records[child].pid);
                            ddb_puts(" state=");
                            ddb_puts(ddb_state_name(records[child].state));
                            ddb_puts("\n");
                            children = children + 1;
                            edges = edges + 1;
                        }
                    }
                    if (children == 0) {
                        ddb_puts("ddb: wait pid="); ddb_put_udec(pid);
                        ddb_puts(" state="); ddb_puts(ddb_state_name(state));
                        ddb_puts(" waits-for child unknown\n");
                        unknown = unknown + 1;
                    }
                } else if (reason == 0) {
                    // Blocked with nothing recorded to be blocked on. Said
                    // rather than skipped: a process in that state is a
                    // finding, and leaving it out of the listing would leave
                    // the trailer's `blocked` count unexplained.
                    ddb_puts("ddb: wait pid="); ddb_put_udec(pid);
                    ddb_puts(" state="); ddb_puts(ddb_state_name(state));
                    ddb_puts(" waits-for unknown\n");
                    unknown = unknown + 1;
                } else {
                    ddb_puts("ddb: wait pid="); ddb_put_udec(pid);
                    ddb_puts(" state="); ddb_puts(ddb_state_name(state));
                    ddb_puts(" waits-for event=");
                    ddb_puts(ddb_wait_reason_name(reason));
                    ddb_puts("\n");
                    edges = edges + 1;
                }
            }
        }
    }
    ddb_puts("ddb: wait edges="); ddb_put_udec(edges);
    ddb_puts(" blocked="); ddb_put_udec(blocked);
    ddb_puts(" unknown="); ddb_put_udec(unknown);
    ddb_puts(" truncated="); ddb_put_udec(truncated);
    ddb_puts("\n");
}

private fn ddb_render_wait() !{unsafe} {
    ddb_render_wait_from(ddb_snapshot.processes as []ProcessDdbRecord,
                         ddb_snapshot.process_count,
                         ddb_snapshot.process_truncated,
                         ddb_snapshot.process_pid,
                         ddb_snapshot.process_state,
                         ddb_snapshot.wait_reason);
}

// Issue #524's topology, rendered from records this file wrote rather than
// from a boot that has to reproduce the stall. A view compares it on both
// lanes, so the presentation is asserted rather than trusted to whoever next
// reads a capture.
//
// Held in a static rather than on the stack: DDB runs on the interrupted
// stack, and 32 records is two kilobytes of it.
private let mut ddb_wait_test_records: [ProcessDdbRecord; DDB_PROCESS_RECORDS];

private fn ddb_wait_test_record(index: {0..<DDB_PROCESS_RECORDS as usize},
                                pid: usize, ppid: usize,
                                state: usize, reason: usize) {
    ddb_wait_test_records[index].pid = pid;
    ddb_wait_test_records[index].ppid = ppid;
    ddb_wait_test_records[index].state = state;
    ddb_wait_test_records[index].wait_reason = reason;
    ddb_wait_test_records[index].saved_sp = 0;
    ddb_wait_test_records[index].stack_bottom = 0;
    ddb_wait_test_records[index].stack_top = 0;
    ddb_wait_test_records[index].root_slot = 0;
}

private fn ddb_render_wait_test() !{unsafe} {
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        ddb_wait_test_record(index, 0, 0, 0, 0);
    }
    // #524 itself: grandparent and parent both blocked collecting a child,
    // and the child is the current process, running and waiting for a network
    // event that only an interrupt can deliver.
    ddb_wait_test_record(0, 1, 0, 3, 2);
    ddb_wait_test_record(1, 2, 1, 3, 2);
    ddb_wait_test_record(2, 3, 2, 2, 3);
    // A parent whose child is not in the snapshot -- gone, recycled, or cut
    // off by truncation. Reported as unknown rather than attached to whatever
    // now answers to that number.
    ddb_wait_test_record(3, 9, 0, 3, 2);
    // The remaining event vocabularies, so every name this view can print is
    // printed by something a lane compares.
    // Parented at 0, which no record in this snapshot claims, so they add
    // event nodes without adding children to the chain above.
    ddb_wait_test_record(4, 10, 0, 3, 1);
    ddb_wait_test_record(5, 11, 0, 3, 4);
    ddb_wait_test_record(6, 12, 0, 3, 5);
    // Blocked on nothing recorded.
    ddb_wait_test_record(7, 13, 0, 3, 0);
    ddb_render_wait_from(ddb_wait_test_records as []ProcessDdbRecord,
                         8, 1, 3, 2, 3);
}

private fn ddb_render_proc(pid: usize) !{unsafe} {
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        if (index < ddb_snapshot.process_count &&
                ddb_snapshot.processes[index].pid == pid) {
            ddb_puts("ddb: proc");
            ddb_render_process(ddb_snapshot.processes[index]);
            return;
        }
    }
    ddb_puts("ddb: proc pid not captured");
    if (ddb_snapshot.process_truncated != 0) { ddb_puts(" (snapshot truncated)"); }
    ddb_puts("\n");
}

// The one resumable DDB root. It receives an already-saved IRQ frame after
// the UART source and interrupt controller were acknowledged, but remains an
// interrupt function: no semantic exception is made for debugger code.
private fn kernel_ddb_enter_stopped(
        stopped_world: borrow WorldStopped[id],
        frame_sp: usize, entry_kind: usize, entry_source: usize)
        !{interrupt, unsafe} {
    unsafe {
        atomic_store_release(ddb_snapshot_published_sequence_address(), 0);
    }
    ddb_snapshot.sequence = ddb_snapshot.sequence + 1;
    ddb_snapshot.cpu = crash_snapshot_read_mpidr_el1();
    ddb_snapshot.entry_kind = entry_kind;
    ddb_snapshot.entry_source = entry_source;
    ddb_snapshot.live_daif = mrs_daif();
    let entry_frame: *ExceptionFrame = unsafe { frame_sp as *ExceptionFrame };
    ddb_snapshot.saved_daif = entry_frame.spsr_el1 & 0x3C0;
    ddb_snapshot.esr_valid = 0;
    ddb_snapshot.esr_el1 = 0;
    ddb_snapshot.far_el1 = 0;
    if (entry_kind == 2) {
        ddb_snapshot.esr_valid = 1;
        ddb_snapshot.esr_el1 = mrs_esr_el1();
        ddb_snapshot.far_el1 = mrs_far_el1();
    }
    ddb_snapshot.scheduler_enabled = kernel_process_ddb_scheduler_enabled();
    ddb_snapshot.reschedule_pending = kernel_process_ddb_reschedule_pending();
    ddb_snapshot.frame_sp = frame_sp;
    ddb_snapshot.process_pid = kernel_process_current_pid();
    ddb_snapshot.parent_pid = kernel_process_crash_parent_pid();
    ddb_snapshot.process_state = kernel_process_crash_state();
    ddb_snapshot.wait_reason = kernel_process_crash_wait_reason();
    ddb_snapshot.root_slot = kernel_process_crash_root_slot();
    let mut vm: AddressSpaceDiagnosticSnapshot =
        address_space_diagnostic_snapshot(ddb_snapshot.root_slot);
    ddb_snapshot.root_live = 0;
    if (vm.live) { ddb_snapshot.root_live = 1; }
    ddb_snapshot.root_l1 = vm.l1_physical;
    ddb_snapshot.root_asid = vm.asid;
    for fd: usize in 0..<CRASH_FD_SNAPSHOT_SLOTS {
        ddb_snapshot.fd_kind[fd] =
            kernel_fd_table_crash_kind(ddb_snapshot.root_slot, fd);
        ddb_snapshot.fd_object[fd] =
            kernel_fd_table_crash_object(ddb_snapshot.root_slot, fd);
    }
    let mut process_copy: ProcessDdbCopyResult =
        kernel_process_ddb_copy(ddb_snapshot.processes as []ProcessDdbRecord);
    ddb_snapshot.process_count = process_copy.count;
    ddb_snapshot.process_truncated = 0;
    if (process_copy.truncated) { ddb_snapshot.process_truncated = 1; }
    for index: usize in 0..<DDB_PROCESS_RECORDS {
        ddb_snapshot.process_l2[index] = 0;
        if (index < ddb_snapshot.process_count) {
            let mut process_vm: AddressSpaceDiagnosticSnapshot =
                address_space_diagnostic_snapshot(
                    ddb_snapshot.processes[index].root_slot);
            if (process_vm.live) {
                ddb_snapshot.process_l2[index] = process_vm.l2_physical;
            }
        }
    }
    ddb_snapshot.trace_count = kernel_process_crash_trace_copy(
        ddb_snapshot.trace as *usize);
    unsafe {
        atomic_store_release(
            ddb_snapshot_published_sequence_address(),
            ddb_snapshot.sequence);
    }
    // GitHub issue #454: the debugger is a terminal path, so the console
    // stands down to its pre-queue behaviour here. Everything queued reaches
    // the wire first -- ddb_puts writes through uart_debug_putc, which spins
    // on the FIFO and knows nothing about the queue, so the prompt would
    // otherwise arrive ahead of the output that explains why it is there --
    // and every byte after this one spins, because a debugger entered with
    // interrupts masked has nothing left to drain a queue.
    //
    // GitHub issue #531: the token this returns is what `continue` puts back
    // at the end of this function. It carries the state FOUND, not "on", so a
    // BREAK that lands between platform_irq_init() and kernel_log_tx_activate()
    // resumes into the spinning console it interrupted rather than queueing
    // bytes that nothing would drain.
    let console: KernelLogTxStandDown = kernel_log_tx_stand_down();
    ddb_puts("\nddb: interrupt-safe UART debugger\n");
    ddb_puts("ddb: world-stop complete mask=");
    ddb_put_hex(world_stopped_mask(stopped_world));
    ddb_puts("\n");
    ddb_render_oops();
    let mut line: [u8; CRASH_CONSOLE_LINE_BYTES];
    let mut length: usize = 0;
    let mut stopped: bool = true;
    while (stopped) {
        ddb_puts("ddb> ");
        let mut reading: bool = true;
        while (reading) {
            let byte: u8 = uart_debug_getc();
            if (byte == 0x0A || byte == 0x0D) {
                ddb_puts("\n");
                reading = false;
            } else {
                if (byte != 0x08 && byte != 0x7F) {
                    length = ddb_append(line as []u8, length, byte);
                }
            }
        }
        if (ddb_command_is(line as []u8, length, bs"continue")) {
            ddb_puts("ddb: continuing\n");
            stopped = false;
        } else if (ddb_command_is(line as []u8, length, bs"oops")) {
            ddb_render_oops();
        } else if (ddb_command_is(line as []u8, length, bs"regs")) {
            ddb_render_regs();
        } else if (ddb_command_is(line as []u8, length, bs"current")) {
            ddb_render_current();
        } else if (ddb_command_is(line as []u8, length, bs"intr")) {
            ddb_render_intr();
        } else if (ddb_command_is(line as []u8, length, bs"sched")) {
            ddb_render_sched();
        } else if (ddb_command_is(line as []u8, length, bs"vm")) {
            ddb_render_vm();
        } else if (ddb_command_is(line as []u8, length, bs"fds")) {
            ddb_render_fds();
        } else if (ddb_command_is(line as []u8, length, bs"ps")) {
            ddb_render_ps();
        } else if (ddb_command_is(line as []u8, length, bs"wait")) {
            ddb_render_wait();
        } else if (ddb_command_is(line as []u8, length, bs"events")) {
            ddb_render_events();
        } else {
            match ddb_parse_backtrace(line as []u8, length) {
                DdbBacktraceCommand::Current => {
                    ddb_render_backtrace_current();
                }
                DdbBacktraceCommand::Cpu(core) => {
                    ddb_render_backtrace_cpu(core);
                }
                DdbBacktraceCommand::Process(pid) => {
                    ddb_render_backtrace_process(pid);
                }
                DdbBacktraceCommand::Invalid => {
                    ddb_puts("ddb: usage: bt [PID|cpu N]\n");
                }
                DdbBacktraceCommand::NotBacktrace => {
            match ddb_parse_memory(line as []u8, length) {
                DdbMemoryCommand::Kernel(details) => {
                    let (address, count) = details;
                    ddb_command_kernel_memory(stopped_world, address, count);
                }
                DdbMemoryCommand::Physical(details) => {
                    let (address, count) = details;
                    ddb_command_physical_memory(
                        stopped_world, address, count);
                }
                DdbMemoryCommand::Invalid => {
                    ddb_puts("ddb: usage: xk|xp HEX_ADDRESS [COUNT_1_TO_64]\n");
                }
                DdbMemoryCommand::NotMemory => {
                  match ddb_parse_user_memory(line as []u8, length) {
                    DdbUserMemoryCommand::User(details) => {
                        let (pid, address, count) = details;
                        ddb_render_user_memory(
                            stopped_world, pid, address, count);
                    }
                    DdbUserMemoryCommand::Invalid => {
                        ddb_puts("ddb: usage: xu PID HEX_ADDRESS [COUNT_1_TO_64]\n");
                    }
                    DdbUserMemoryCommand::NotUserMemory => {
                     match crash_console_parse_proc(line as []u8, length) {
                    CrashConsolePidResult::Parsed(pid) => { ddb_render_proc(pid); }
                    CrashConsolePidResult::Invalid => {
                    if (ddb_command_is(line as []u8, length, bs"trace")) {
                        ddb_render_trace();
                    } else if (kernel_ddb_backtrace_test_enabled &&
                            ddb_command_is(line as []u8, length, bs"bttest")) {
                        ddb_render_backtrace_test();
                    } else if (kernel_ddb_memory_fault_test_enabled &&
                            ddb_command_is(line as []u8, length, bs"xkfault")) {
                        // Test-only bypass of the ordinary-RAM classifier:
                        // exercise a real translation fault and prompt return.
                        // L1 index 32 is unmapped on both maintained targets;
                        // index 64 is RPi5 device MMIO despite faulting on QEMU.
                        ddb_render_kernel_memory(0x800000000, 1);
                        // GitHub issue #456: the same command's gate, one
                        // decision over. A peer's real fault used to be
                        // answerable by DDB's arming because the arming was
                        // one machine-global word; these four say what
                        // "answerable" now requires.
                        ddb_guarded_fault_verdict("armed-match", true,
                                                  0x800000000, 0x25 << 26,
                                                  0x800000000);
                        ddb_guarded_fault_verdict("armed-other-address", true,
                                                  0x800000000, 0x25 << 26,
                                                  0x800001000);
                        ddb_guarded_fault_verdict("armed-other-class", true,
                                                  0x800000000, 0x24 << 26,
                                                  0x800000000);
                        ddb_guarded_fault_verdict("unarmed", false,
                                                  0x800000000, 0x25 << 26,
                                                  0x800000000);
                    } else if (kernel_ddb_wait_test_enabled &&
                            ddb_command_is(line as []u8, length, bs"waittest")) {
                        // Test-only: issue #524's topology from records this
                        // file wrote, so the presentation is compared by a
                        // lane instead of waiting for the stall to recur.
                        ddb_render_wait_test();
                    } else if (ddb_command_is(line as []u8, length, bs"help")) {
                        ddb_puts("commands: oops regs intr sched current vm fds ps wait proc PID bt [PID|cpu N] trace events xk ADDRESS [COUNT] xp PHYSICAL [COUNT] xu PID ADDRESS [COUNT] help continue\n");
                    } else { ddb_puts("ddb: unknown command; try help\n"); }
                    }
                        }
                    }
                     }
                    }
                  }
                }
            }
        }
        length = 0;
    }
    kernel_log_tx_resume(console);
    // Said at all because nothing else could see this: both DDB lanes resume
    // into the interactive shell and end there, so neither reaches the
    // end-of-boot `console: tx spin` measurement that would otherwise show a
    // resumed console costing 78.9 us/byte again.
    //
    // Read back rather than restated. A line printed from the same arm that
    // does the restoring would keep saying `queued` after someone deleted the
    // restore, which would make the observer agree with the defect -- the
    // exact shape #531 is about. So it asks the console what it is.
    //
    // Written through the spinning debug path even though the queue may now
    // be live: the stand-down flushed it and nothing has queued since, so
    // this is the last byte order can be affected by, and the next queued
    // byte re-arms the TX interrupt in uart_putc.
    if (kernel_log_tx_is_live()) {
        ddb_puts("ddb: console tx=queued\n");
    } else {
        ddb_puts("ddb: console tx=spinning\n");
    }
}

// Stop every online peer before touching the machine-global snapshot or the
// page allocator's lock-free diagnostic view. A partial token is deliberately
// not passed to kernel_ddb_enter_stopped: report the stopped set, resume it,
// and return without inspecting shared state.
fn kernel_ddb_enter(frame_sp: usize, entry_kind: usize, entry_source: usize)
        !{interrupt, unsafe} {
    match world_stop_begin(
            &kernel_world_stop, DDB_ONLINE_CORES, DDB_WORLD_STOP_SPINS) {
        WorldStopResult::Busy => {
            ddb_puts("\nddb: world-stop busy; inspection refused\n");
        }
        WorldStopResult::Partial(partial) => {
            ddb_puts("\nddb: world-stop partial mask=");
            ddb_put_hex(world_stop_partial_mask(partial));
            ddb_puts("; inspection refused\n");
            world_stop_partial_release(partial, &kernel_world_stop);
        }
        WorldStopResult::Complete(stopped_world) => {
            kernel_ddb_enter_stopped(
                stopped_world, frame_sp, entry_kind, entry_source);
            world_stop_release(stopped_world, &kernel_world_stop);
        }
    }
}

// EC=0x3c is AArch64 BRK. Only Takibi's reserved immediate is resumable;
// every other Current-EL synchronous exception retains fail-stop semantics.
fn kernel_ddb_sync_dispatch(frame_sp: usize) -> usize !{interrupt, unsafe} {
    let esr: usize = mrs_esr_el1();
    // This core's own arming, and no other's: a peer's real data abort must
    // not be answered by whatever DDB is reading somewhere else.
    let guard: *DdbGuardedRead = kernel_ddb_memory_access_here();
    if (ddb_guarded_fault_is_ours(guard.active, guard.address, esr,
                                  mrs_far_el1())) {
        guard.active = false;
        guard.faulted = true;
        let fault_frame: *ExceptionFrame = unsafe {
            frame_sp as *ExceptionFrame
        };
        fault_frame.elr_el1 = kernel_ddb_memory_fault_return;
        return frame_sp;
    }
    if (((esr >> 26) & 0x3F) == 0x3C && (esr & 0xFFFF) == 0x544B) {
        kernel_ddb_enter(frame_sp, 2, 0x544B);
        let frame: *ExceptionFrame = unsafe { frame_sp as *ExceptionFrame };
        frame.elr_el1 = frame.elr_el1 + 4;
        return frame_sp;
    }
    kernel_current_sync_fail_stop(frame_sp);
}


fn crash_snapshot_put_data_abort(esr: usize) {
    let ec: usize = (esr >> 26) & 0x3F;
    if (ec == 0x20 || ec == 0x21) {
        kernel_boot_log("oops: access=instruction-fetch\n");
        return;
    }
    if (ec == 0x24 || ec == 0x25) {
        kernel_boot_log("oops: data-abort dfsc=");
        uart_put_hex(esr & 0x3F);
        kernel_boot_log(" access=");
        if ((esr & (1 << 6)) != 0) { kernel_boot_log("write\n"); }
        else { kernel_boot_log("read\n"); }
    }
}

// GitHub issue #486: every core that faulted, in the order they faulted.
//
// The immediate report at capture time renders the FAULTING core's own record
// and nothing else -- a core reporting its own fail-stop must not depend on
// reading another core's storage, and a single-core boot's output is
// byte-identical to what it was before this existed. This is the reader for
// afterwards: the console's `oops`, asked by a person or a lane that wants
// the whole machine rather than the core that answered.
//
// Ordering is by the machine-wide ticket, so "which fault came first" -- the
// question the single shared snapshot used to destroy by keeping whichever
// wrote last -- is answerable. Selection sort over KERNEL_MAX_CORES, because
// the set is two and a debugger must not allocate.
// The caller holds the report claim: this is reached from the console's own
// dispatch, which claims around every command's output. The claim is not
// reentrant, so taking it here as well would spin this core against itself
// until the bound ran out.
private fn crash_snapshot_render_every_core() !{unsafe} {
    let mut rendered: usize = 0;
    let mut previous: usize = 0;
    for round: usize in 0..<KERNEL_MAX_CORES {
        let mut best_core: usize = KERNEL_MAX_CORES;
        let mut best_order: usize = 0;
        for core: usize in 0..<KERNEL_MAX_CORES {
            // Acquire, so a record this reads is one whose payload the
            // publishing core had finished writing.
            let published: usize =
                unsafe { atomic_load_acquire(crash_snapshot_valid_address(core)) };
            if (published == 0) { continue; }
            let order: usize = crash_snapshot_of(core).fault_order;
            if (order <= previous) { continue; }
            if (best_core == KERNEL_MAX_CORES || order < best_order) {
                best_core = core;
                best_order = order;
            }
        }
        if (best_core == KERNEL_MAX_CORES) { break; }
        previous = best_order;
        rendered = rendered + 1;
        crash_snapshot_render_core(best_core);
    }
    kernel_boot_log("oops: cores reported=");
    uart_put_udec(rendered);
    kernel_boot_log(" faults=");
    uart_put_udec(unsafe { atomic_load_acquire(crash_fault_order_address()) });
    kernel_boot_log(" contended=");
    uart_put_udec(crash_report_contended);
    kernel_boot_log(" abandoned=");
    uart_put_udec(crash_report_abandoned);
    kernel_boot_log("\n");
}

private fn crash_snapshot_render_from(record: *CrashSnapshot,
                                      root_slot: usize) !{unsafe} {
    kernel_boot_log("oops: fail-stop seq=");
    uart_put_udec(record.sequence);
    kernel_boot_log(" cpu=");
    uart_put_udec(record.cpu & 0xFF);
    kernel_boot_log(" slot=");
    uart_put_udec(record.vector_slot);
    kernel_boot_log(" ec=");
    uart_put_hex((record.esr_el1 >> 26) & 0x3F);
    kernel_boot_log(" esr="); uart_put_hex(record.esr_el1);
    kernel_boot_log(" far="); uart_put_hex(record.far_el1);
    kernel_boot_log(" elr="); uart_put_hex(record.elr_el1);
    kernel_boot_log("\n");
    crash_snapshot_put_data_abort(record.esr_el1);
    // GitHub issue #384: WHO owns the pages this fault names. Both
    // addresses are user VAs when the fault came from EL0, so each is
    // translated through the faulting process's own page table first and
    // only then asked about -- printing the owner of the VA itself would
    // answer "not a page from this allocator" for exactly the case worth
    // reporting. Issue #373 was a process's text page that was also a
    // kernel stack; that reads here as one line.
    crash_snapshot_put_page_owner("far", record.far_el1, root_slot);
    crash_snapshot_put_page_owner("elr", record.elr_el1, root_slot);
    kernel_boot_log("oops: live sp_el0="); uart_put_hex(record.sp_el0);
    kernel_boot_log(" tpidr_el0="); uart_put_hex(record.tpidr_el0);
    kernel_boot_log(" ttbr0="); uart_put_hex(record.ttbr0_el1);
    kernel_boot_log("\n");
    kernel_boot_log("oops: process pid="); uart_put_udec(record.process_pid);
    kernel_boot_log(" parent="); uart_put_udec(record.parent_pid);
    kernel_boot_log(" state="); uart_put_udec(record.process_state);
    kernel_boot_log(" wait="); uart_put_udec(record.wait_reason);
    kernel_boot_log(" wait4_status_ptr="); uart_put_hex(record.wait4_status_ptr);
    kernel_boot_log(" root="); uart_put_udec(record.root_slot);
    kernel_boot_log(" asid="); uart_put_udec(record.root_asid);
    kernel_boot_log(" l1="); uart_put_hex(record.root_l1);
    kernel_boot_log(" image=");
    if (record.image_kind == 1) { kernel_boot_log("exec\n"); }
    else { kernel_boot_log("bootstrap\n"); }
    kernel_process_exec_failure_render();
    for fd: usize in 0..<CRASH_FD_SNAPSHOT_SLOTS {
        if (record.fd_kind[fd] != 0) {
            kernel_boot_log("oops: fd="); uart_put_udec(fd);
            kernel_boot_log(" kind="); uart_put_udec(record.fd_kind[fd]);
            kernel_boot_log(" object="); uart_put_udec(record.fd_object[fd]);
            kernel_boot_log("\n");
        }
    }
    if (record.saved_frame_available != 0) {
        kernel_boot_log("oops: saved sp_el0="); uart_put_hex(record.saved_sp_el0);
        kernel_boot_log(" tpidr_el0="); uart_put_hex(record.saved_tpidr_el0);
        kernel_boot_log(" elr="); uart_put_hex(record.saved_elr_el1);
        kernel_boot_log(" spsr="); uart_put_hex(record.saved_spsr_el1);
        kernel_boot_log("\n");
    } else {
        kernel_boot_log("oops: saved-frame=unavailable\n");
    }
    kernel_process_trace_render(
        record.trace as []usize, record.trace_count,
        "oops: trace" as *u8);
}


// The faulting core's own record, rendered as it fail-stops. Unchanged
// output: this is what a single-core boot has always printed.
fn crash_snapshot_render() !{unsafe} {
    crash_snapshot_render_from(crash_snapshot_here(),
                               crash_snapshot_here().root_slot);
}

// One named core's published record, for the reader that walks them all.
private fn crash_snapshot_render_core(core: usize) !{unsafe} {
    crash_snapshot_render_from(crash_snapshot_of(core),
                               crash_snapshot_of(core).root_slot);
}

private fn crash_console_command_is(line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..],
                                    length: usize, text: []u8) -> bool {
    if (length != text.len) { return false; }
    let mut index: usize = 0;
    while (index < length && index < CRASH_CONSOLE_LINE_BYTES) {
        if (index >= 0 && index < CRASH_CONSOLE_LINE_BYTES &&
                index < text.len) {
            if (line[index] != text[index]) { return false; }
        } else { return false; }
        index = index + 1;
    }
    return true;
}

must_use variant CrashConsolePidResult { Invalid; Parsed(usize); }

private fn crash_console_parse_proc(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..], length: usize)
        -> CrashConsolePidResult {
    if (ddb_command_starts_with(line, length, bs"proc ") == false) {
        return CrashConsolePidResult::Invalid;
    }
    let mut pid: usize = 0;
    let mut index: usize = 5;
    while (index < length && index < CRASH_CONSOLE_LINE_BYTES) {
        if (index >= 0 && index < CRASH_CONSOLE_LINE_BYTES) {
            let byte: u8 = line[index];
            if (byte < 0x30 || byte > 0x39) {
                return CrashConsolePidResult::Invalid;
            }
            let digit: usize = (byte - 0x30) as usize;
            if (pid > (0xFFFFFFFFFFFFFFFF - digit) / 10) {
                return CrashConsolePidResult::Invalid;
            }
            pid = pid * 10 + digit;
        }
        index = index + 1;
    }
    if (pid == 0) { return CrashConsolePidResult::Invalid; }
    return CrashConsolePidResult::Parsed(pid);
}

private fn crash_console_dispatch(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..], length: usize)
        !{unsafe} {
    if (crash_console_command_is(line, length, bs"oops")) {
        crash_snapshot_render_every_core();
        return;
    }
    if (crash_console_command_is(line, length, bs"trace")) {
        kernel_process_trace_render(
            crash_snapshot_here().trace as []usize, crash_snapshot_here().trace_count,
            "trace" as *u8);
        return;
    }
    if (crash_console_command_is(line, length, bs"ps")) {
        kernel_process_monitor_ps();
        return;
    }
    match crash_console_parse_proc(line, length) {
        CrashConsolePidResult::Parsed(pid) => {
            kernel_process_monitor_proc(pid);
            return;
        }
        CrashConsolePidResult::Invalid => {}
    }
    if (crash_console_command_is(line, length, bs"help")) {
        kernel_boot_log("commands: oops trace ps proc PID\n");
        return;
    }
    kernel_boot_log("ddb: unknown command; try help\n");
}

private fn crash_console_append(
        line: borrow [u8; CRASH_CONSOLE_LINE_BYTES..], length: usize,
        byte: u8) -> usize {
    if (length < 32) {
        line[length] = byte;
        return length + 1;
    }
    return length;
}

private fn crash_console_run() !{unsafe} {
    // The ordinary UART RX handler belongs to the suspended kernel and may
    // wake a process. Keep it out of a terminal exception monitor and poll
    // the device directly instead.
    disable_irq();
    // GitHub issue #454: same reason as the debugger above, and here it is
    // load-bearing rather than tidy. This loop blocks on input after every
    // `ddb> `, with interrupts masked, so a prompt left in the transmit queue
    // has nothing to drain it and the console would appear hung.
    //
    // GitHub issue #531: terminal on purpose. crash_console_run() never
    // returns, so there is no resume to put the queue back for -- and the
    // token is matched rather than dropped because must_use will not let it
    // be dropped, which is exactly what stops a path that DOES return from
    // forgetting.
    match kernel_log_tx_stand_down() {
        KernelLogTxStandDown::WasLive => { }
        KernelLogTxStandDown::WasSpinning => { }
        KernelLogTxStandDown::NotConsoleOwner => { }
    }
    crash_report_claim();
    kernel_boot_log("ddb: read-only crash console\n");
    crash_report_release();
    let mut line: [u8; CRASH_CONSOLE_LINE_BYTES];
    let mut length: usize = 0;
    while (true) {
        // GitHub issue #486: the prompt is one of this file's writes and
        // takes the claim like the rest. The BLOCKING READ below does not --
        // holding it across uart_debug_getc() is the one thing that would
        // turn this into the lock a crash reporter must not have, and a core
        // still trying to report would wait for a person to type.
        //
        // The first version left the prompt unclaimed. A core that had just
        // lost the console wrote its parking line into the middle of the
        // word `ddb> `, and the lane's driver -- which counts prompts --
        // stopped counting. Two cores' output racing is not only ugly; it
        // silently disables whatever is reading it.
        crash_report_claim();
        kernel_boot_log("ddb> ");
        crash_report_release();
        let mut reading: bool = true;
        while (reading) {
            let byte: u8 = uart_debug_getc();
            if (byte == 0x0A || byte == 0x0D) {
                crash_report_claim();
                kernel_boot_log("\n");
                crash_report_release();
                reading = false;
            } else {
                if (byte == 0x08 || byte == 0x7F) {
                    // Editing is deliberately absent from the first crash
                    // console; ignore erase rather than complicating its
                    // bounded input state.
                } else {
                    length = crash_console_append(line as []u8, length, byte);
                }
            }
        }
        crash_report_claim();
        crash_console_dispatch(line as []u8, length);
        crash_report_release();
        length = 0;
    }
}

// One "oops: <what> page ..." line. Reports the identity-mapped address
// directly when it is one of the allocator's pages, and otherwise tries
// the faulting process's address space, saying which reading it used --
// a report that silently switches between two meanings of an address is
// worse than one that prints nothing.
// GitHub issue #486: the root slot is a parameter now. A user VA is
// translated through the FAULTING process's page table, and when this reader
// is walking every core that is not the reading core's own.
private fn crash_snapshot_put_page_owner(what: *u8, address: usize,
                                         root_slot: usize) {
    kernel_boot_log("oops: ");
    kernel_boot_log(what);
    kernel_boot_log(" page ");
    if (page_owner_tag_at_reporter(address) != PageOwnerTag::Unowned) {
        kernel_boot_log("(physical) is ");
        kernel_boot_log(page_owner_description_reporter(address));
        kernel_boot_log("\n");
        return;
    }
    let physical: usize =
        address_space_user_physical(root_slot, address);
    if (physical == 0) {
        kernel_boot_log("is ");
        kernel_boot_log(page_owner_description_reporter(address));
        kernel_boot_log(", not mapped in root ");
        uart_put_udec(root_slot);
        kernel_boot_log("\n");
        return;
    }
    kernel_boot_log("(via root ");
    uart_put_udec(root_slot);
    kernel_boot_log(" -> ");
    uart_put_hex(physical);
    kernel_boot_log(") is ");
    kernel_boot_log(page_owner_description_reporter(physical));
    kernel_boot_log("\n");
}

fn crash_snapshot_capture(slot: usize, frame_sp: usize) !{unsafe} {
    kernel_log_enter_emergency();
    let snapshot: *CrashSnapshot = crash_snapshot_here();
    if (*crash_snapshot_capturing_here()) {
        kernel_boot_log("oops: recursive exception; parking\n");
        while (true) { interrupt_wait(); }
    }
    *crash_snapshot_capturing_here() = true;
    // Unpublish before writing. A reader that arrives mid-capture must see
    // "this core is writing one" rather than the previous record, which would
    // still look entirely plausible.
    unsafe { atomic_store_release(crash_snapshot_valid_address(cpu_id()), 0); }
    crash_snapshot_here().sequence = crash_snapshot_here().sequence + 1;
    crash_snapshot_here().fault_order =
        unsafe { atomic_fetch_add_relaxed(crash_fault_order_address(), 1) } + 1;
    crash_snapshot_here().cpu = crash_snapshot_read_mpidr_el1();
    crash_snapshot_here().vector_slot = slot;
    crash_snapshot_here().esr_el1 = mrs_esr_el1();
    crash_snapshot_here().far_el1 = mrs_far_el1();
    crash_snapshot_here().elr_el1 = mrs_elr_el1();
    crash_snapshot_here().spsr_el1 = mrs_spsr_el1();
    crash_snapshot_here().sp_el0 = crash_snapshot_read_sp_el0();
    crash_snapshot_here().tpidr_el0 = crash_snapshot_read_tpidr_el0();
    crash_snapshot_here().ttbr0_el1 = crash_snapshot_read_ttbr0_el1();
    crash_snapshot_here().process_pid = kernel_process_current_pid();
    crash_snapshot_here().parent_pid = kernel_process_crash_parent_pid();
    crash_snapshot_here().process_state = kernel_process_crash_state();
    crash_snapshot_here().wait_reason = kernel_process_crash_wait_reason();
    crash_snapshot_here().wait4_status_ptr = kernel_process_crash_wait4_status_ptr();
    crash_snapshot_here().root_slot = kernel_process_crash_root_slot();
    crash_snapshot_here().root_l1 = address_space_l1_physical(crash_snapshot_here().root_slot);
    crash_snapshot_here().root_asid = address_space_asid(crash_snapshot_here().root_slot);
    crash_snapshot_here().image_kind = kernel_process_crash_image_kind();
    for fd: usize in 0..<CRASH_FD_SNAPSHOT_SLOTS {
        crash_snapshot_here().fd_kind[fd] =
            kernel_fd_table_crash_kind(crash_snapshot_here().root_slot, fd);
        crash_snapshot_here().fd_object[fd] =
            kernel_fd_table_crash_object(crash_snapshot_here().root_slot, fd);
    }
    crash_snapshot_here().saved_frame_available = 0;
    if (frame_sp != 0) {
        crash_snapshot_copy_saved_frame(frame_sp, &snapshot.saved_sp_el0);
        crash_snapshot_here().saved_frame_available = 1;
    }
    crash_snapshot_here().trace_count = kernel_process_crash_trace_copy(
        crash_snapshot_here().trace as *usize);
    // Write back the exact structured record before UART output or a debugger
    // observes it.  This is cache maintenance only, never a DMA submission.
    dma_prepare_tx(crash_snapshot_here() as *usize, sizeof(CrashSnapshot));
    // Published last, with release, so the payload above is visible to anyone
    // who acquires this word. The cache maintenance is for the debugger on the
    // other side of the wire; this store is for the other core.
    unsafe { atomic_store_release(crash_snapshot_valid_address(cpu_id()), 1); }
    // Published BEFORE the claim, so a core that never wins the render still
    // has its record readable by the console, by DDB and by a debugger.
    crash_report_claim();
    crash_snapshot_render();
    crash_report_release();
    // GitHub issue #486: exactly one core runs the console.
    //
    // Every core that faults reports -- the lines above are already on the
    // wire, and its record is published for any reader -- but two cores
    // reading `uart_debug_getc()` would steal each other's bytes, so the
    // second one to arrive parks instead. That is not a lock: the claim is
    // one atomic swap that never waits, and a core that loses it is a core
    // that has already said everything it knows.
    if (unsafe { atomic_swap_acquire(crash_console_owner_address(),
                                     CRASH_CONSOLE_CLAIMED) }
            == CRASH_CONSOLE_FREE) {
        crash_console_run();
    }
    // Under the claim like every other line this path writes: it was the
    // last thing left interleaving after the reports stopped.
    crash_report_claim();
    kernel_boot_log("oops: console owned by another core; parking\n");
    crash_report_release();
    while (true) { interrupt_wait(); }
}

// Vector-table targets have no universally valid saved ExceptionFrame.
fn el1_exception_evidence(slot: usize) !{unsafe} { crash_snapshot_capture(slot, 0); }

// EL0 synchronous exceptions have EXC_CONTEXT_SAVE's frame at this SP.
fn el1_exception_evidence_from_frame(slot: usize, frame_sp: usize) !{unsafe} {
    crash_snapshot_capture(slot, frame_sp);
}

// Fail-stop snapshots and recursion flags are per-core, so simultaneous
// faults retain both records without a reporter lock. The historical core-0
// symbols remain the external-debugger ABI. So is the guarded read's arming
// (GitHub issue #456): its writer is the one core inspecting, but its READER
// is whichever core takes a data abort, and a shared word let a peer's real
// fault be answered by DDB's read.
//
// DDB's smaller mutable snapshot stays machine-global by design and is
// protected by its complete world-stop token -- one writer, and the token is
// what says so. The stopped-peer roots beside it are per-core because each
// core publishes its own (issue #505).
fn exception_evidence_execution_model_assumption() {
    static_assert(KERNEL_PREEMPTIBLE == 0,
                  "per-core crash capture cannot survive nested preemption on one core");
}
