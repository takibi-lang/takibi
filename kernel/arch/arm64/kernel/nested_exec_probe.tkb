/* Refused nested execs must leave the child alive and able to exec again.
 * Run on core 0 and a peer after the existing init.sh evidence fixtures.
 */
const NESTED_EXEC: usize = 221;
const NESTED_WRITE: usize = 64;
const NESTED_EXIT: usize = 93;

private fn nested_fail() !{unsafe} {
    let line: []const u8 = bs"nested: FAIL refused exec result\n";
    // Raw ABI input only: these syscalls read the readonly bytes.
    // The bridge exposes no writable slice or checked mutation.
    svc5(NESTED_WRITE, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
    svc5(NESTED_EXIT, 1, 0, 0, 0, 0);
}

fn nested_exec_probe() !{unsafe} {
    let mut args: [usize; 10];
    for index: usize in 0..<10 { args[index] = 0; }
    args[0] = "caller-name-is-replaced" as *u8 as usize;
    let vector: usize = args as *usize as usize;
    if (svc5(NESTED_EXEC, "/nested/5.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFD8) { nested_fail(); }
    if (svc5(NESTED_EXEC, "/nested/cycle.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFD8) { nested_fail(); }
    if (svc5(NESTED_EXEC, "/nested/invalid.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFF8) { nested_fail(); }
    if (svc5(NESTED_EXEC, "/nested/missing.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFFE) { nested_fail(); }
    if (svc5(NESTED_EXEC, "/nested/denied.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFF3) { nested_fail(); }
    // GitHub issue #1040: an executable ELF the validator refuses -- an
    // ET_EXEC image, and a PT_LOAD span over 2 MiB -- is ENOEXEC. Both
    // differ from /etc/interp-other (ELIBBAD) in that one field, so a
    // validator that accepted them would answer ELIBBAD; the old kernel
    // answered by running BusyBox here, and this probe never printed ok.
    if (svc5(NESTED_EXEC, "/nested/et-exec" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFF8) { nested_fail(); }
    if (svc5(NESTED_EXEC, "/nested/wide-span" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFF8) { nested_fail(); }
    for index: usize in 1..<9 {
        args[index] = "extra" as *u8 as usize;
    }
    if (svc5(NESTED_EXEC, "/nested/4.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFF9) { nested_fail(); }
    let mut large: [u8; 241];
    for index: usize in 0..<240 { large[index] = 0x78; }
    large[240] = 0;
    args[1] = large as *u8 as usize;
    args[2] = large as *u8 as usize;
    for index: usize in 3..<10 { args[index] = 0; }
    if (svc5(NESTED_EXEC, "/nested/4.sh" as *u8 as usize,
             vector, 0, 0, 0) != 0xFFFFFFFFFFFFFFF9) { nested_fail(); }
    let line: []const u8 = bs"nested: ELOOP, ENOEXEC, ENOENT, EACCES, E2BIG ok\n";
    svc5(NESTED_WRITE, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
    // GitHub issue #1039: a 448-byte, five-string argv is within execve's
    // limits but left the old 512-byte stack block only 288 bytes for
    // strings, so this exec fail-stopped the kernel after the point of no
    // return. sh ignores the two pads ($0 and $1 of the -c script).
    let mut pad: [u8; 201];
    for index: usize in 0..<200 { pad[index] = 0x70; }
    pad[200] = 0;
    // GitHub issue #1065: argv[0] names /nested/sh, a different ELF (the
    // entry below), while the pathname is /bin/sh. The image is the
    // pathname's: the old kernel picked it from argv[0] and printed FAIL.
    // BusyBox dispatches on argv[0]'s basename, `sh`, so the shell runs.
    args[0] = "/nested/sh" as *u8 as usize;
    args[1] = "-c" as *u8 as usize;
    args[2] = "echo nested: child reexec survived" as *u8 as usize;
    args[3] = pad as *u8 as usize;
    args[4] = pad as *u8 as usize;
    args[5] = 0;
    svc5(NESTED_EXEC, "/bin/sh" as *u8 as usize, vector, 0, 0, 0);
    nested_fail();
}

// /nested/sh: the image an argv[0]-chosen exec would run (#1065).
fn nested_exec_wrong_image() !{unsafe} {
    let line: []const u8 = bs"nested: FAIL image chosen by argv[0]\n";
    svc5(NESTED_WRITE, 1, (unsafe { line as *u8 }) as usize, line.len, 0, 0);
    svc5(NESTED_EXIT, 1, 0, 0, 0, 0);
}
