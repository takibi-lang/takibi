/* sched_setaffinity and sched_getaffinity, the affinity ABI (GitHub issue
 * #9). A static-PIE EL0 program, kept free of writable globals and compiled
 * with --forbid-trap. The lines it prints are compared by the ash
 * transcript, so they say only what holds on every platform: the online
 * set differs between two-vCPU QEMU and four-core RPi5.
 *
 * A mask is an admission request. This process pins itself to CPU 1 and
 * calls newfstatat, which is not in the kernel's peer-safety table, so the
 * migration gate reruns it on core 0. Whether that happened on core 0 is
 * not visible from EL0; the affinity gdb lane watches for it.
 */

const WRITE_SYSCALL: usize = 64;
const EXIT_SYSCALL: usize = 93;
const SETAFFINITY_SYSCALL: usize = 122;
const GETAFFINITY_SYSCALL: usize = 123;
const KILL_SYSCALL: usize = 129;
const EXECVE_SYSCALL: usize = 221;
const DUP3_SYSCALL: usize = 24;
const FCNTL_SYSCALL: usize = 25;
const FACCESSAT_SYSCALL: usize = 48;
const CLOSE_SYSCALL: usize = 57;
const LINUX_F_DUPFD: usize = 0;
const LINUX_AT_FDCWD: usize = 0xFFFFFFFFFFFFFF9C;
const LINUX_R_OK: usize = 4;
const AFFINITY_DUP_FLOOR: usize = 20;
const BRK_SYSCALL: usize = 214;
const MMAP_SYSCALL: usize = 222;
const LINUX_PROT_READ_WRITE: usize = 3;
const LINUX_MAP_PRIVATE_ANONYMOUS: usize = 0x22;
const LINUX_NO_FD: usize = 0xFFFFFFFFFFFFFFFF;
const LINUX_ENOENT: usize = 0xFFFFFFFFFFFFFFFE;
// The probe's example of a syscall the peer-safety table does NOT admit.
// It has to be one that STAYS outside, and phase B entry 6 is a sequence of
// widenings of exactly that table: this was uname until entry 6's first
// increment admitted it, getcwd until its second, and newfstatat until
// GitHub issue #581 admitted the filesystem read path.
//
// rt_sigprocmask is the one with a REASON to stay, rather than the next in
// line: `kernel_process_signal_deliver_to` reads the target's signal_mask
// and read-modify-writes its pending_signals from whichever CPU the sender
// is on, under no lock, so admitting a peer's own mask write would make it
// a third party to two words already touched from two CPUs. That is #570,
// and until it closes this syscall does not move.
//
// scripts/check_affinity_probe_migrates.py holds this number against
// `syscall_peer_safe`, so a widening that reaches it fails in langcheck
// rather than in a QEMU lane reporting a gate that stopped firing. It has
// now earned itself three times.
const RT_SIGPROCMASK_SYSCALL: usize = 135;
// rt_sigprocmask(how, set, oldset, sigsetsize): a null `set` changes
// nothing and fills `oldset` with the current mask, so the probe reads
// without disturbing a process whose SIGTERM handling it goes on to test.
const SIGSET_BYTES: usize = 8;
const SIG_BLOCK: usize = 0;
const GETCPU_SYSCALL: usize = 168;
const NANOSLEEP_SYSCALL: usize = 101;
const CLONE_SYSCALL: usize = 220;
const WAIT4_SYSCALL: usize = 260;
const CLONE_FORK_SIGCHLD: usize = 0x11;
const SIGTERM: usize = 15;
const LINUX_EINVAL: usize = 0xFFFFFFFFFFFFFFEA;
const LINUX_ESRCH: usize = 0xFFFFFFFFFFFFFFFD;
const LINUX_ECHILD: usize = 0xFFFFFFFFFFFFFFF6;
const AFFINITY_ERROR_FLOOR: usize = 0xFFFFFFFFFFFFF000;
const AFFINITY_ABSENT_PID: usize = 999999;
const AFFINITY_PIN_ATTEMPTS: usize = 200000;
// Naps of a millisecond each: enough to cover the parent's remaining work
// many times over, and finite so nothing depends on the child being killed.
const AFFINITY_SPINNER_NAPS: usize = 20000;
// 128 + SIGTERM, the status kernel_syscall_exit_current_process gives a
// process the termination signal ends (GitHub issue #563).
const AFFINITY_SIGTERM_STATUS: u8 = 143;
const AFFINITY_PEER_SPINNER_NAPS: usize = 2000;
// A millisecond each, so the whole wait is bounded at a quarter second.
const AFFINITY_PEER_PIN_POLLS: usize = 256;

private fn affinity_say(line: borrow []u8) {
    svc5(WRITE_SYSCALL, 1, line as *u8 as usize, line.len, 0, 0);
}

private fn affinity_fail(line: borrow []u8) {
    affinity_say(line);
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}

// Byte 0 holds CPUs 0-7 and byte 7 holds CPUs 56-63.
private fn affinity_mask_fill(mask: borrow [u8; 8..], low: u8, high: u8) {
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = low;
    mask[7] = high;
}

private fn affinity_mask_is(mask: borrow [u8; 8..], low: u8) -> bool {
    if (mask[0] != low) { return false; }
    for index: usize in 1..<8 {
        if (mask[index] != 0) { return false; }
    }
    return true;
}

private fn affinity_cpu(cpu_bytes: borrow [u8; 4..]) -> usize {
    if (svc5(GETCPU_SYSCALL, cpu_bytes as *u8 as usize, 0, 0, 0, 0) != 0) {
        return 99;
    }
    return cpu_bytes[0] as usize |
           ((cpu_bytes[1] as usize) << 8) |
           ((cpu_bytes[2] as usize) << 16) |
           ((cpu_bytes[3] as usize) << 24);
}

// Written when core 0 had no idle loop (it has one since GitHub issue #592),
// so a process leaving it needed something else there to switch to. This child inherits the CPU-0-only mask and naps a
// millisecond at a time. A nap blocks while another process is Ready, so
// core 0 hands itself over without depending on preemption, which the
// ash session this runs in does not have.
//
// BOUNDED, and that is load-bearing rather than tidiness. This used to nap
// forever and rely on its parent's SIGTERM to end it, which asks two things
// of the kernel that a fixture should not have to: that a pending signal
// reaches a process which is asleep, and that an interrupt arrives to wake
// a nap that found nobody else Ready. A CI run on 2026-09-16 got neither --
// the parent sat in wait4 while this child stayed in its deadline retry, and
// the whole ash session stopped one command after /bin/affinity's output.
// The count is generous: at a millisecond a nap it outlives the parent's
// remaining work by orders of magnitude, and it ends on its own whatever the
// kernel does, so this fixture can no longer hang a lane.
// GitHub issue #563: the same nap loop, on the peer. It pins ITSELF, so the
// parent can wait on sched_getaffinity rather than on a guess, and its nap
// count is a tenth of the core-0 spinner's -- a lost signal here costs the
// lane two seconds rather than twenty, and the count is not what this is
// measuring.
private fn affinity_peer_spinner() {
    let mut mask: [u8; 8];
    affinity_mask_fill(mask as []u8, 2, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask as *u8 as usize, 0, 0) != 0) {
        svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
    }
    let mut probe_mask: [u8; 8];
    for round: usize in 0..<AFFINITY_PEER_SPINNER_NAPS {
        svc5(GETAFFINITY_SYSCALL, 0, 8, probe_mask as *u8 as usize, 0, 0);
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}

private fn affinity_spinner() {
    let mut probe_mask: [u8; 8];
    for round: usize in 0..<AFFINITY_SPINNER_NAPS {
        svc5(GETAFFINITY_SYSCALL, 0, 8, probe_mask as *u8 as usize, 0, 0);
    }
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}

fn affinity_probe() {
    let mut mask: [u8; 8];
    let mask_address: usize = mask as *u8 as usize;

    affinity_mask_fill(mask as []u8, 0, 0);
    if (svc5(GETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != 8 ||
        (mask[0] & 1) == 0) {
        affinity_fail(bs"affinity: the default mask did not cover cpu 0\n");
    }
    // GitHub issue #579: the online set, read once before anything narrows
    // it. A process that has set no mask reads back every online CPU, and
    // that is the only thing in this fixture that differs between
    // two-vCPU QEMU and the four-core board. Every assertion below is
    // written against this value rather than against a literal, so the one
    // ash transcript both platforms compare says the same true thing on
    // each -- which is what the header of this file promises and what
    // naming cpu 2 as "offline" stopped being able to keep.
    let online: usize = mask[0] as usize;
    let mut offline_cpu: usize = 8;
    for cpu: usize in 0..<8 {
        if (offline_cpu == 8 && (online & (1 << cpu)) == 0) {
            offline_cpu = cpu;
        }
    }
    if (offline_cpu == 8) {
        affinity_fail(
            bs"affinity: all eight cpus of the low byte are online, so this fixture has no offline cpu to refuse\n");
    }

    affinity_mask_fill(mask as []u8, 1, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != 0) {
        affinity_fail(bs"affinity: cpu 0 alone was refused\n");
    }
    affinity_mask_fill(mask as []u8, 0, 0);
    if (svc5(GETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != 8 ||
        affinity_mask_is(mask as []u8, 1) == false) {
        affinity_fail(bs"affinity: cpu 0 alone did not read back\n");
    }

    affinity_mask_fill(mask as []u8, 0, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != LINUX_EINVAL) {
        affinity_fail(bs"affinity: an empty mask was accepted\n");
    }
    affinity_mask_fill(mask as []u8, 0, 0x80);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != LINUX_EINVAL) {
        affinity_fail(bs"affinity: a mask naming no online cpu was accepted\n");
    }
    // The lowest cpu this kernel did NOT bring up. Two vCPUs make that cpu 2
    // and four cores make it cpu 4, so the literal 4 that used to be here
    // said "offline" on one platform and "online and now schedulable" on the
    // other once #579 widened the set.
    affinity_mask_fill(mask as []u8, (1 << offline_cpu) as u8, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != LINUX_EINVAL) {
        affinity_fail(
            bs"affinity: a mask naming only an offline cpu was accepted\n");
    }
    affinity_mask_fill(mask as []u8, 1, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 4, mask_address, 0, 0) != LINUX_EINVAL) {
        affinity_fail(bs"affinity: a 4-byte mask was accepted\n");
    }
    if (svc5(GETAFFINITY_SYSCALL, 0, 12, mask_address, 0, 0) != LINUX_EINVAL) {
        affinity_fail(bs"affinity: a 12-byte read was accepted\n");
    }
    if (svc5(GETAFFINITY_SYSCALL, AFFINITY_ABSENT_PID, 8, mask_address,
             0, 0) != LINUX_ESRCH) {
        affinity_fail(bs"affinity: an absent pid was not ESRCH\n");
    }

    // A child inherits the mask its parent set.
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0; }
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        affinity_mask_fill(mask as []u8, 0, 0);
        if (svc5(GETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) == 8 &&
            affinity_mask_is(mask as []u8, 1)) {
            svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
        }
        svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
    }
    if (child >= AFFINITY_ERROR_FLOOR) {
        affinity_fail(bs"affinity: fork failed\n");
    }
    if (svc5(WAIT4_SYSCALL, child, status as *u8 as usize, 0, 0, 0) != child ||
        status[0] != 0 || status[1] != 0) {
        affinity_fail(bs"affinity: the child did not inherit cpu 0 alone\n");
    }
    affinity_say(bs"affinity: default covers cpu 0; cpu 0 alone reads back and is inherited; empty and offline-only masks, short and odd sizes refused; absent pid ESRCH\n");

    // Pin to CPU 1, with the spinner keeping core 0 busy behind.
    let spinner: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (spinner == 0) { affinity_spinner(); }
    if (spinner >= AFFINITY_ERROR_FLOOR) {
        affinity_fail(bs"affinity: fork failed\n");
    }
    affinity_mask_fill(mask as []u8, 2, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != 0) {
        affinity_fail(bs"affinity: cpu 1 alone was refused\n");
    }
    let mut cpu_bytes: [u8; 4];
    let mut on_peer: bool = false;
    let mut attempts: usize = 0;
    while (on_peer == false && attempts < AFFINITY_PIN_ATTEMPTS) {
        attempts = attempts + 1;
        if (affinity_cpu(cpu_bytes as []u8) == 1) { on_peer = true; }
    }
    if (on_peer == false) {
        affinity_fail(bs"affinity: never ran on cpu 1\n");
    }
    // rt_sigprocmask is admitted on a peer since GitHub issue #570 put the
    // signal words under the process-run lock. The buffer starts as 0xFF,
    // so this is a real content check rather than a return code a zeroed
    // struct would also satisfy: the kernel wrote the mask, and no signal
    // this kernel accepts lives in the top byte.
    let mut sigset_buffer: [u8; SIGSET_BYTES];
    for index: usize in 0..<SIGSET_BYTES { sigset_buffer[index] = 0xFF; }
    if (svc5(RT_SIGPROCMASK_SYSCALL, SIG_BLOCK, 0,
             sigset_buffer as *u8 as usize, SIGSET_BYTES, 0) != 0 ||
        sigset_buffer[SIGSET_BYTES - 1] != 0) {
        affinity_fail(
            bs"affinity: rt_sigprocmask asked from cpu 1 did not answer\n");
    }
    // kill is admitted on a peer since GitHub issue #583's first increment;
    // signal 0 to an absent pid is ESRCH, an answer only a lookup produces.
    if (svc5(KILL_SYSCALL, AFFINITY_ABSENT_PID, 0, 0, 0, 0) != LINUX_ESRCH) {
        affinity_fail(bs"affinity: kill asked from cpu 1 did not answer\n");
    }
    // GitHub issue #583's second increment: the descriptor table and a
    // path's mode, from CPU 1. Each answer is one only a working call gives:
    // faccessat of a file the image has is 0, F_DUPFD returns a descriptor
    // at or above the floor it was asked for, and dup3 returns the target.
    if (svc5(FACCESSAT_SYSCALL, LINUX_AT_FDCWD, bs"/hello.txt\0" as *u8 as usize,
             LINUX_R_OK, 0, 0) != 0) {
        affinity_fail(bs"affinity: faccessat asked from cpu 1 did not answer\n");
    }
    let duplicate: usize = svc5(FCNTL_SYSCALL, 1, LINUX_F_DUPFD,
                                AFFINITY_DUP_FLOOR, 0, 0);
    if (duplicate < AFFINITY_DUP_FLOOR || duplicate >= AFFINITY_ERROR_FLOOR) {
        affinity_fail(bs"affinity: fcntl F_DUPFD asked from cpu 1 did not answer\n");
    }
    if (svc5(DUP3_SYSCALL, duplicate, duplicate + 1, 0, 0, 0) != duplicate + 1) {
        affinity_fail(bs"affinity: dup3 asked from cpu 1 did not answer\n");
    }
    svc5(CLOSE_SYSCALL, duplicate + 1, 0, 0, 0, 0);
    svc5(CLOSE_SYSCALL, duplicate, 0, 0, 0, 0);
    // The third increment: this process's own memory, from CPU 1. An
    // anonymous page comes from the heap break, so the address mmap returns
    // is the break brk reported.
    let heap_break: usize = svc5(BRK_SYSCALL, 0, 0, 0, 0, 0);
    let page: usize = svc5(MMAP_SYSCALL, 0, 4096, LINUX_PROT_READ_WRITE,
                           LINUX_MAP_PRIVATE_ANONYMOUS, LINUX_NO_FD);
    if (heap_break == 0 || page != heap_break) {
        affinity_fail(bs"affinity: brk and mmap asked from cpu 1 did not answer\n");
    }
    // execve is outside the peer-safety table -- the process lifecycle is
    // the last thing it will admit -- so asked from CPU 1 it is rerun on
    // core 0 and must still answer. A pathname that names nothing is
    // ENOENT, decided by an ext2 lookup before any image is chosen, so a
    // call that went nowhere cannot pass for one that ran.
    let mut exec_argv: [usize; 1];
    exec_argv[0] = 0;
    if (svc5(EXECVE_SYSCALL, bs"/affinity-absent\0" as *u8 as usize,
             exec_argv as *usize as usize, 0, 0, 0) != LINUX_ENOENT) {
        affinity_fail(bs"affinity: execve asked from cpu 1 did not answer\n");
    }
    // Say it BEFORE the spinner goes. This line is written from CPU 1, so it
    // is published into this CPU's console ring, and the only thing that
    // empties that ring is core 0's drain at the top of a syscall
    // (kernel_log_peer_drain, kernel/kernel/syscall.tkb). Core 0 has no idle
    // loop: with the spinner reaped and the shell blocked on its read, core 0
    // has no syscall to take and the line can sit in the ring for the rest of
    // the boot. The spinner's millisecond naps are what keep the drain
    // running, which is the reason it exists -- so it has to outlive the
    // output, not just the migration.
    affinity_say(bs"affinity: pinned to cpu 1, where execve, outside the peer-safe table, still answered\n");
    // GitHub issue #579: every OTHER online cpu, while the same spinner is
    // still keeping core 0 occupied. Cpu 1 is proved above; this walks the
    // rest of the reported online set, which is empty on two-vCPU QEMU and
    // is cpus 2 and 3 on the four-core board.
    //
    // Nothing is printed from inside this loop. A line written here would be
    // published into THAT cpu's console ring, and the only thing that empties
    // a peer ring is core 0's drain at the top of a syscall -- the reason the
    // line above had to be written before the spinner was reaped. The verdict
    // is carried back to core 0 in a variable and said there.
    //
    // Leaving a peer needs no successor the way leaving core 0 does: a
    // secondary has an architectural idle loop to fall back to, which is
    // why one spinner covers the whole walk.
    // Cpu 0 and cpu 1 are already proved when this starts: cpu 0 by the
    // return poll below that this fixture has always done, cpu 1 by the
    // block above. The loop adds the rest, and the count is compared against
    // the online set rather than against a floor -- a floor of two passes on
    // QEMU whatever happens to cpus 2 and 3, which is the assertion this
    // needs NOT to make.
    let mut walked: usize = 2;
    for cpu: usize in 2..<8 {
        if ((online & (1 << cpu)) != 0) {
            affinity_mask_fill(mask as []u8, (1 << cpu) as u8, 0);
            if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != 0) {
                affinity_fail(
                    bs"affinity: an online cpu was refused its own mask\n");
            }
            let mut arrived: bool = false;
            let mut attempts: usize = 0;
            while (arrived == false && attempts < AFFINITY_PIN_ATTEMPTS) {
                attempts = attempts + 1;
                if (affinity_cpu(cpu_bytes as []u8) == cpu) { arrived = true; }
            }
            if (arrived == false) {
                affinity_fail(
                    bs"affinity: an online cpu never ran this process\n");
            }
            walked = walked + 1;
        }
    }
    // Ask it to stop, then reap it. The ask is best-effort on purpose: the
    // child ends on its own nap count, so a SIGTERM that does not reach a
    // sleeping process costs this fixture nothing but the wait. wait4 blocks
    // until it is gone either way, which is also what keeps core 0 busy
    // until the line above has been drained.
    for index: usize in 0..<4 { status[index] = 0; }
    svc5(KILL_SYSCALL, spinner, SIGTERM, 0, 0, 0);
    if (svc5(WAIT4_SYSCALL, spinner, status as *u8 as usize, 0, 0, 0) !=
            spinner) {
        affinity_fail(bs"affinity: the spinner was not reaped\n");
    }
    // Back to core 0 before saying anything. This process is pinned to CPU
    // 1, whose console ring is drained only by core 0 taking a syscall --
    // and the spinner whose naps kept that drain running has just been
    // reaped, so a line written here would sit in the ring for the rest of
    // the boot. The comment above the pinned line says the same thing from
    // the other side.
    affinity_mask_fill(mask as []u8, 1, 0);
    if (svc5(SETAFFINITY_SYSCALL, 0, 8, mask_address, 0, 0) != 0) {
        affinity_fail(bs"affinity: cpu 0 alone was refused\n");
    }
    let mut back: bool = false;
    let mut back_attempts: usize = 0;
    while (back == false && back_attempts < AFFINITY_PIN_ATTEMPTS) {
        back_attempts = back_attempts + 1;
        if (affinity_cpu(cpu_bytes as []u8) == 0) { back = true; }
    }
    if (back == false) {
        affinity_fail(bs"affinity: never came back to cpu 0\n");
    }
    // GitHub issue #563: WHY it was reaped. The spinner exits 0 on its own
    // nap count and the kernel exits it with 128 + SIGTERM when the signal
    // is taken, so this one byte separates "the SIGTERM reached a napping
    // process" from "it ran out the clock" -- which is the question that
    // issue's stall could not answer. Measured before it is asserted.
    if (status[1] == 0) {
        // The shape GitHub issue #563 recorded: the child ran its whole nap
        // count out with a SIGTERM its parent had already sent. Failing here
        // turns that into a bounded, named lane failure instead of the
        // 202-second stall the issue was filed from.
        affinity_fail(
            bs"affinity: the napping spinner OUTLIVED the SIGTERM\n");
    }
    if (status[1] != AFFINITY_SIGTERM_STATUS) {
        affinity_fail(
            bs"affinity: the napping spinner exited for a third reason\n");
    }
    affinity_say(bs"affinity: the napping spinner took the SIGTERM\n");
    // GitHub issue #579, said from core 0 for the console-ring reason above.
    // Deliberately free of a count: the number differs per platform and this
    // transcript is compared against both. What the number was is in the
    // kernel's own `smp bringup: an EL0 process ran on cpus=` line, which
    // each platform's view compares separately.
    let mut online_count: usize = 0;
    for cpu: usize in 0..<8 {
        if ((online & (1 << cpu)) != 0) { online_count = online_count + 1; }
    }
    if (walked != online_count) {
        affinity_fail(
            bs"affinity: some cpu the kernel reports online never ran this process\n");
    }
    affinity_say(
        bs"affinity: every cpu the kernel reports online ran this process, each confirmed by getcpu\n");

    // GitHub issue #563's remaining branch: the SENDER on core 0 and the
    // TARGET napping on a peer. The pair above shares a core, so the bit is
    // set and taken on the same CPU and the cross-core question is never
    // asked. `pending_signals` is read-modify-written by
    // kernel_process_signal_deliver_to on the sender's CPU and by
    // kernel_process_current_termination_signal_take on the target's, under
    // no lock and with no release/acquire ordering, so whether a peer sees a
    // bit core 0 wrote is exactly what this arranges.
    //
    // This parent is back on core 0 by now, which is what makes it the
    // sender side.
    let peer_spinner: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD,
                                   0, 0, 0, 0);
    if (peer_spinner == 0) { affinity_peer_spinner(); }
    if (peer_spinner >= AFFINITY_ERROR_FLOOR) {
        affinity_fail(bs"affinity: fork failed\n");
    }
    // Wait for the child to have PINNED itself, not for a guess at how long
    // that takes: sched_getaffinity by pid reads the mask it set, so this
    // is the child telling the parent it is committed to CPU 1. Whenever it
    // next runs it runs there, which is the property the kill needs.
    //
    // NAP between polls rather than spinning. The child starts on core 0 --
    // it inherits this process's mask -- so it needs core 0 to run its own
    // setaffinity, and a parent busy-polling here is the one thing standing
    // in its way. Spinning cost a concurrent QEMU lane its 80-second budget,
    // measured; sleeping makes the handoff immediate.
    let mut pin_nap: [u8; 16];
    for index: usize in 0..<16 { pin_nap[index] = 0; }
    // tv_sec = 0, tv_nsec = 1000000 (0x000F4240), little-endian.
    pin_nap[8] = 0x40;
    pin_nap[9] = 0x42;
    pin_nap[10] = 0x0F;
    let mut pinned: bool = false;
    let mut pin_polls: usize = 0;
    while (pinned == false && pin_polls < AFFINITY_PEER_PIN_POLLS) {
        pin_polls = pin_polls + 1;
        affinity_mask_fill(mask as []u8, 0, 0);
        if (svc5(GETAFFINITY_SYSCALL, peer_spinner, 8, mask_address, 0, 0)
                == 8 && affinity_mask_is(mask as []u8, 2)) {
            pinned = true;
        } else {
            svc5(NANOSLEEP_SYSCALL, pin_nap as *u8 as usize, 0, 0, 0, 0);
        }
    }
    if (pinned == false) {
        affinity_fail(bs"affinity: the peer spinner never pinned to cpu 1\n");
    }
    for index: usize in 0..<4 { status[index] = 0; }
    svc5(KILL_SYSCALL, peer_spinner, SIGTERM, 0, 0, 0);
    // GitHub issue #571: WHICH answer, not merely that it was wrong. The
    // first wait4 for a child that exited on a peer answers something other
    // than its pid about 3 times in 40, and the three possible answers lead
    // to different repairs -- 0 is a reap that found no zombie, ECHILD is a
    // parent told it has no children at all, and another pid is the wrong
    // child collected. Retrying until the answer agreed hid that, so the
    // first answer is classified here instead.
    let reaped: usize = svc5(WAIT4_SYSCALL, peer_spinner,
                             status as *u8 as usize, 0, 0, 0);
    if (reaped == 0) {
        affinity_fail(
            bs"affinity: the peer spinner was not reaped: answered 0\n");
    }
    if (reaped == LINUX_ECHILD) {
        affinity_fail(
            bs"affinity: the peer spinner was not reaped: answered ECHILD\n");
    }
    if (reaped >= AFFINITY_ERROR_FLOOR) {
        affinity_fail(
            bs"affinity: the peer spinner was not reaped: answered another error\n");
    }
    if (reaped != peer_spinner) {
        affinity_fail(
            bs"affinity: the peer spinner was not reaped: answered another pid\n");
    }
    if (status[1] == 0) {
        affinity_fail(
            bs"affinity: the peer spinner OUTLIVED a SIGTERM sent from core 0\n");
    }
    if (status[1] != AFFINITY_SIGTERM_STATUS) {
        affinity_fail(
            bs"affinity: the peer spinner exited for a third reason\n");
    }
    affinity_say(
        bs"affinity: a spinner napping on cpu 1 took a SIGTERM sent from core 0\n");
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}
