/* Two compute-bound processes with no affinity mask end up on different
 * CPUs (GitHub issue #582). A static-PIE EL0 program, kept free of writable
 * globals and compiled with --forbid-trap. Its one line is compared by the
 * ash transcript, so it says only what holds on every platform with a
 * second online CPU.
 *
 * Neither process calls sched_setaffinity. The parent forks, and both spin
 * on arithmetic with a getcpu between chunks; nothing either does blocks.
 * The child's spin is half the parent's, so its last getcpu is taken while
 * the parent is still spinning, and the parent's last getcpu is taken after
 * the child exited -- when nothing Ready is left to move it. If the two
 * shared one CPU for the whole run, those two answers are equal. They
 * differ only if some CPU took one of them off the other's CPU while both
 * were runnable.
 *
 * The second scenario is the tick's leave. A child is started on CPU 0 and
 * spins with no syscall at all; while it does, its parent moves the child's
 * mask to CPU 1 and waits. Nothing but the timer can then take the child
 * off CPU 0, and it has no successor there, so it ends on CPU 1 only if the
 * tick gives a Running process back with nothing in its place.
 *
 * Before it moves the child, the parent asks the kernel's stack-owner probe
 * about it. Both are pinned to CPU 1 and the parent is the one running
 * there, so the child is Ready and off every CPU: the probe names another
 * CPU as its stack's owner and the real ready take must refuse it, then
 * clears the owner and the take must accept it.
 *
 * The parent must not call wait4 while the child spins. wait4 is on the
 * peer refusal list, so it reruns on core 0, and a parent Ready there lets
 * core 0's ordinary tick switch the child out -- which moves it without
 * the path under test. The parent naps past the child's spin first.
 */

const WRITE_SYSCALL: usize = 64;
const NANOSLEEP_SYSCALL: usize = 101;
const SETAFFINITY_SYSCALL: usize = 122;
const EXIT_SYSCALL: usize = 93;
const GETCPU_SYSCALL: usize = 168;
const CLONE_SYSCALL: usize = 220;
const WORKLOAD_PROGRESS_SYSCALL: usize = 453;
const STACK_OWNER_PROBE_TAG: usize = 12;
const WAIT4_SYSCALL: usize = 260;
const CLONE_FORK_SIGCHLD: usize = 0x11;
const SPREAD_ERROR_FLOOR: usize = 0xFFFFFFFFFFFFF000;
// Iterations between two getcpu calls, and how many such chunks each
// process runs. The child's count is what matters: it has to span many
// timer ticks on the faster platform (RPi5), since an idle CPU looks for
// work when its tick wakes it.
const SPREAD_CHUNK: usize = 1048576;
const SPREAD_CHILD_CHUNKS: usize = 256;
const SPREAD_PARENT_CHUNKS: usize = 512;
// The leave scenario's child spins this many chunks with no syscall; long
// enough that its parent's first nap and mask change land inside it, short
// enough that it ends inside the parent's second nap.
const SPREAD_LEAVE_CHUNKS: usize = 512;
// Naps of 100 ms: one before the parent moves the child, then enough to
// outlast the child's spin before the parent's wait4.
const SPREAD_LEAVE_NAP_NS: usize = 100000000;
const SPREAD_LEAVE_TAIL_NAPS: usize = 40;
// getcpu polls the child makes, waiting to be on CPU 0 before it spins.
const SPREAD_LEAVE_ARRIVAL_POLLS: usize = 1000000;
// An exit status no CPU number reaches, for a getcpu that failed.
const SPREAD_NO_CPU: usize = 250;

private fn spread_say(line: borrow []u8) {
    svc5(WRITE_SYSCALL, 1, line as *u8 as usize, line.len, 0, 0);
}

private fn spread_fail(line: borrow []u8) {
    spread_say(line);
    svc5(EXIT_SYSCALL, 1, 0, 0, 0, 0);
}

private fn spread_cpu(cpu_bytes: borrow [u8; 4..]) -> usize {
    if (svc5(GETCPU_SYSCALL, cpu_bytes as *u8 as usize, 0, 0, 0, 0) != 0) {
        return SPREAD_NO_CPU;
    }
    return cpu_bytes[0] as usize |
           ((cpu_bytes[1] as usize) << 8) |
           ((cpu_bytes[2] as usize) << 16) |
           ((cpu_bytes[3] as usize) << 24);
}

// Spin `chunks` chunks and return the CPU the last getcpu named. The
// accumulator is folded into the answer so the arithmetic cannot be
// discarded; it never reaches SPREAD_NO_CPU's bit.
private fn spread_spin(chunks: usize) -> usize {
    let mut cpu_bytes: [u8; 4];
    let mut cpu: usize = SPREAD_NO_CPU;
    let mut acc: usize = 1;
    for round: usize in 0..<chunks {
        for step: usize in 0..<SPREAD_CHUNK {
            acc = acc * 6364136223846793005 + 1442695040888963407;
        }
        cpu = spread_cpu(cpu_bytes as []u8);
    }
    if (acc == 0) { return SPREAD_NO_CPU; }
    return cpu;
}

private fn spread_set_mask(pid: usize, low: u8) -> bool {
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = low;
    return svc5(SETAFFINITY_SYSCALL, pid, 8, mask as *u8 as usize, 0, 0) == 0;
}

// The child's exit status: the CPU it started on in the high nibble, the
// one it ended on in the low nibble.
private fn spread_leave_child() {
    let mut cpu_bytes: [u8; 4];
    // Born where fork ran, and possibly started on CPU 1 before its parent
    // narrowed its mask; each getcpu is a syscall boundary where the gate
    // sends it on.
    let mut first: usize = spread_cpu(cpu_bytes as []u8);
    for poll: usize in 0..<SPREAD_LEAVE_ARRIVAL_POLLS {
        if (first != 0) { first = spread_cpu(cpu_bytes as []u8); }
    }
    let mut acc: usize = 1;
    for round: usize in 0..<SPREAD_LEAVE_CHUNKS {
        for step: usize in 0..<SPREAD_CHUNK {
            acc = acc * 6364136223846793005 + 1442695040888963407;
        }
    }
    let last: usize = spread_cpu(cpu_bytes as []u8);
    if (acc == 0 || first > 15 || last > 15) {
        svc5(EXIT_SYSCALL, SPREAD_NO_CPU, 0, 0, 0, 0);
    }
    svc5(EXIT_SYSCALL, (first << 4) | last, 0, 0, 0, 0);
}

private fn spread_leave() {
    // Pinned to CPU 1 first, so the child inherits CPU 1 and nothing can
    // take it while this process runs there; the next mask is what decides
    // where it starts.
    if (spread_set_mask(0, 2) == false) {
        spread_fail(bs"spread: cpu 1 alone was refused\n");
    }
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) { spread_leave_child(); }
    if (child >= SPREAD_ERROR_FLOOR) {
        spread_fail(bs"spread: fork failed\n");
    }
    // fork ran on core 0; wait to be back on CPU 1, where the child can
    // only be Ready while this process runs.
    let mut cpu_bytes: [u8; 4];
    let mut here: usize = spread_cpu(cpu_bytes as []u8);
    for poll: usize in 0..<SPREAD_LEAVE_ARRIVAL_POLLS {
        if (here != 1) { here = spread_cpu(cpu_bytes as []u8); }
    }
    if (here != 1) {
        spread_fail(bs"spread: the parent never returned to cpu 1\n");
    }
    let probe: usize = svc5(WORKLOAD_PROGRESS_SYSCALL, STACK_OWNER_PROBE_TAG,
                            child, 0, 0, 0);
    if (probe == 0) {
        spread_fail(bs"spread: the child was not Ready with an unowned stack\n");
    }
    if (probe == 2) {
        spread_fail(bs"spread: a Ready process was taken while another cpu owned its stack\n");
    }
    if (probe != 1) {
        spread_fail(bs"spread: a Ready process with an unowned stack was refused\n");
    }
    spread_say(bs"spread: a Ready process was refused while another cpu owned its stack, and taken once it was released\n");
    if (spread_set_mask(child, 1) == false) {
        spread_fail(bs"spread: the child could not be moved to cpu 0\n");
    }
    let mut nap: [usize; 2];
    nap[0] = 0;
    nap[1] = SPREAD_LEAVE_NAP_NS;
    svc5(NANOSLEEP_SYSCALL, nap as *usize as usize, 0, 0, 0, 0);
    if (spread_set_mask(child, 2) == false) {
        spread_fail(bs"spread: the child could not be moved to cpu 1\n");
    }
    for round: usize in 0..<SPREAD_LEAVE_TAIL_NAPS {
        svc5(NANOSLEEP_SYSCALL, nap as *usize as usize, 0, 0, 0, 0);
    }
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0; }
    if (svc5(WAIT4_SYSCALL, child, status as *u8 as usize, 0, 0, 0) != child ||
        status[0] != 0) {
        spread_fail(bs"spread: the spinning child was not reaped as an exit\n");
    }
    if ((status[1] >> 4) != 0) {
        spread_fail(bs"spread: the spinning child did not start on cpu 0\n");
    }
    if ((status[1] & 15) != 1) {
        spread_fail(bs"spread: a child spinning without a syscall kept the cpu its mask stopped naming\n");
    }
    spread_say(bs"spread: a child spinning without a syscall left the cpu its mask stopped naming\n");
}

fn spread_probe() {
    let child: usize = svc5(CLONE_SYSCALL, CLONE_FORK_SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        let child_cpu: usize = spread_spin(SPREAD_CHILD_CHUNKS);
        svc5(EXIT_SYSCALL, child_cpu, 0, 0, 0, 0);
    }
    if (child >= SPREAD_ERROR_FLOOR) {
        spread_fail(bs"spread: fork failed\n");
    }
    let parent_cpu: usize = spread_spin(SPREAD_PARENT_CHUNKS);
    let mut status: [u8; 4];
    for index: usize in 0..<4 { status[index] = 0; }
    if (svc5(WAIT4_SYSCALL, child, status as *u8 as usize, 0, 0, 0) != child ||
        status[0] != 0) {
        spread_fail(bs"spread: the child was not reaped as an exit\n");
    }
    let child_cpu: usize = status[1] as usize;
    if (child_cpu == SPREAD_NO_CPU || parent_cpu == SPREAD_NO_CPU) {
        spread_fail(bs"spread: getcpu failed\n");
    }
    if (child_cpu == parent_cpu) {
        spread_fail(bs"spread: two unpinned compute-bound processes ended on the same cpu\n");
    }
    spread_say(bs"spread: two unpinned compute-bound processes ended on different cpus\n");
    spread_leave();
    svc5(EXIT_SYSCALL, 0, 0, 0, 0, 0);
}
