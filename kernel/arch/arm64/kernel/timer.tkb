// GitHub issue #226: kernel/arch/arm64/kernel/timer.S used to exist only
// because .tkb could not emit `mrs`/`msr` directly -- five functions, each
// a single system-register access plus `ret`. Now ordinary .tkb built on
// the closed mrs_cntfrq_el0/mrs_cntpct_el0/msr_cntp_tval_el0/
// msr_cntp_ctl_el0 intrinsics (lib/type_inf.ml / lib/llvm_gen.ml). Same
// names and signatures as the retired timer.S, so every existing caller
// (kernel/platform/rpi5/pcie.tkb's delay_us/timed_out,
// kernel/platform/rpi5/timer_irq.tkb's tick setup, kernel/platform/rpi5/init.tkb's
// secondary-boot deadline loop, and every kernel/net/*.tkb timeout loop)
// needed no change beyond switching its `extern fn` declaration to a
// `use` of this file. timer.S's own `task_exit_stub` had zero callers
// anywhere in kernel/ (a vestige of the examples/common_rpi3/timer_asm.S
// lineage its header comment named) and is not ported.

fn read_cntfrq() -> i64 {
    return mrs_cntfrq_el0() as i64;
}

fn read_cntpct() -> i64 {
    return mrs_cntpct_el0() as i64;
}

// The ARM Generic Timer physical comparator, CNTP_TVAL_EL0, is
// architecturally a 32-bit down-counter (writes ignore the upper bits of
// the GPR), so the sign/zero-extension `as usize` picks for a negative
// `i32` does not matter here -- unlike a register where the upper bits are
// meaningful.
fn set_cntp_tval(n: i32) {
    msr_cntp_tval_el0(n as usize);
}

fn enable_cntp() {
    msr_cntp_ctl_el0(1);
    isb();
}

// The scheduler tick is architectural rather than a GIC implementation
// detail. Each platform supplies only gic_timer_ppi_enable().
fn timer_tick_rearm() {
    set_cntp_tval((read_cntfrq() >> 6) as i32);
}

fn timer_irq_setup() {
    gic_timer_ppi_enable();
    timer_tick_rearm();
    enable_cntp();
}

fn timer_irq_handler() !{interrupt, unsafe} {
    timer_tick_rearm();
    kernel_core0_tick_note();
    // GitHub issue #829: this core's own tick-wake list -- the deadline and
    // NetRx waiters that blocked here -- on every tick, regardless of which
    // EL it interrupted: waking is not a scheduling decision and does not
    // belong behind the EL0-only half. Every secondary does the same from
    // kernel_secondary_timer_schedule, so a sleeper on a peer no longer
    // waits for this core's tick.
    //
    // GitHub issue #587: under the lock a waiter publishes Blocked (and
    // queues itself) under. The lock masks interrupts, so this core cannot
    // interrupt its own holder.
    let guard = process_run_lock();
    kernel_process_tick_wake(guard);
    // GitHub issue #572: a tick on a CPU where a busy worker waits. Core 0
    // only: a secondary's tick takes kernel_secondary_timer_schedule.
    workload_busy_note_tick_locked(guard);
    process_run_unlock(guard);
    // GitHub issue #497: arm or disarm this core's profile counter.
    profile_session_sync();
    interrupt_notify();
}
