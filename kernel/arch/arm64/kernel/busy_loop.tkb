/* The two CPU-bound EL0 programs /etc/inittab starts as `respawn` entries,
 * built from this one source and linked twice with different ELF entry
 * points (-e busy_loop_a, -e busy_loop_b; see the Makefile's
 * KERNEL_BUSY_LOOP_A_ELF/_B_ELF rules) so that /bin/busy-a and /bin/busy-b
 * are two independent images with no argv parsing between them and the tag
 * they report under.
 *
 * Why a busy loop and not a realistic service: everything else this kernel
 * runs is I/O-bound and spends its time blocked, so a second core would sit
 * idle behind it and the fixture would pass without saying anything about
 * concurrency. Two loops that only compute make the scheduler the only
 * variable, and the fairness between them is directly measurable.
 *
 * The work is a xorshift chain rather than an empty countdown for two
 * reasons: it cannot be folded away (each step depends on the last, and the
 * result leaves the process through the syscall below), and it uses only
 * shifts and xors, so no step can overflow.
 *
 * Like kernel/arch/arm64/kernel/user_payload.tkb, this links into a real
 * static-PIE ELF with no writable globals -- scripts/
 * check_user_payload_no_rw_globals.py enforces that, and every value here
 * lives in a local for that reason.
 */

const WORKLOAD_PROGRESS_SYSCALL: usize = 453;
const WORKLOAD_EXIT_SYSCALL: usize = 93;
const WORKLOAD_ANSWER_EXIT: usize = 2;
const WORKLOAD_ANSWER_SIGTERM: usize = 3;
const WORKLOAD_ANSWER_PEER_READ: usize = 4;
const WORKLOAD_ANSWER_CORE_READ: usize = 5;
const EXECVE_SYSCALL: usize = 221;
const GETPID_SYSCALL: usize = 172;
const KILL_SYSCALL: usize = 129;
const LINUX_SIGTERM: usize = 15;
const SETAFFINITY_SYSCALL: usize = 122;
const WRITE_SYSCALL: usize = 64;
const BUSY_LOOP_TAG_A: usize = 1;
const BUSY_LOOP_TAG_B: usize = 2;
const PEER_NET_WAKE_TAG: usize = 6;
const GETCPU_SYSCALL: usize = 168;

/* One round of work. Sized so a round spans several scheduler timer slices
 * (the tick is cntfrq/64, about a millisecond on both maintained targets),
 * which is what keeps the two processes within about one round of each
 * other under a rotating scheduler -- a round much shorter than a slice
 * would let whichever process holds the CPU finish many of them at once and
 * make the skew a property of the slice length rather than of fairness. */
const BUSY_LOOP_ROUND_STEPS: usize = 16000000;

/* xorshift64 seeded per tag, so the two processes do the same amount of
 * work along different value sequences. */
fn busy_loop_a() { busy_loop_run(BUSY_LOOP_TAG_A); }

fn busy_loop_b() { busy_loop_run(BUSY_LOOP_TAG_B); }

/* /bin/spin: one round of the same work, then exit. It reports nothing and
 * prints nothing.
 *
 * This exists so an interactive shell can background two jobs that are
 * demonstrably alive at the same time. `/bin/true &` twice was tried first
 * and is a race: it holds under QEMU and loses on RPi5, where the first job
 * has exited before the shell forks the second, and a fixture that depends
 * on which board it runs on is worse than none. One round outlasts a fork
 * and an exec by a wide margin on either target. Silent because its output
 * would interleave with the prompt in an order nothing can pin. */
fn busy_loop_spin() {
    let mut state: usize = 0x9E3779B97F4A7C15;
    for step: usize in 0..<BUSY_LOOP_ROUND_STEPS {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
    }
    svc5(WORKLOAD_EXIT_SYSCALL, state & 1, 0, 0, 0, 0);
}

/* The peer UART-wake lane needs a second runnable process on CPU 1 while
 * /bin/peer-tty reads there. Neither a sleeping HTTPd nor an unpinned shell
 * job guarantees that placement. This fixture is started only by that lane. */
fn busy_loop_peer_spin() {
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = 2;
    if (svc5(SETAFFINITY_SYSCALL, 0, 8,
             mask as *u8 as usize, 0, 0) != 0) {
        svc5(WORKLOAD_EXIT_SYSCALL, 1, 0, 0, 0, 0);
        return;
    }
    let ready: []u8 = bs"peer spin: pinned to cpu 1\n";
    svc5(WRITE_SYSCALL, 1, ready as *u8 as usize, ready.len, 0, 0);
    while (true) {
        svc5(GETPID_SYSCALL, 0, 0, 0, 0, 0);
    }
}

/* /bin/peer-net-wake exercises the real process Blocked/NetRx transition
 * and timer wake on CPU 1. Tag 6 is a test-only syscall action: its first
 * call names CPU 1, then this process pins itself there before asking to
 * block. */
fn busy_loop_peer_net_wake() {
    let peer_cpu: usize = svc5(
        WORKLOAD_PROGRESS_SYSCALL, PEER_NET_WAKE_TAG, 0, 0, 0, 0);
    if (peer_cpu == 0 || peer_cpu >= 8) {
        svc5(WORKLOAD_EXIT_SYSCALL, 1, 0, 0, 0, 0);
        return;
    }
    let mut mask: [u8; 8];
    for index: usize in 0..<8 { mask[index] = 0; }
    mask[0] = (1 << peer_cpu) as u8;
    if (svc5(SETAFFINITY_SYSCALL, 0, 8,
             mask as *u8 as usize, 0, 0) != 0) {
        svc5(WORKLOAD_EXIT_SYSCALL, 1, 0, 0, 0, 0);
        return;
    }
    let mut cpu_bytes: [u8; 4];
    while (svc5(GETCPU_SYSCALL, cpu_bytes as *u8 as usize,
                0, 0, 0, 0) != 0 ||
           (cpu_bytes[0] as usize |
            ((cpu_bytes[1] as usize) << 8) |
            ((cpu_bytes[2] as usize) << 16) |
            ((cpu_bytes[3] as usize) << 24)) != peer_cpu) {}

    let waiting: []u8 = bs"peer NetRx fixture: pinned to cpu 1\n";
    if (svc5(WRITE_SYSCALL, 1, waiting as *u8 as usize,
             waiting.len, 0, 0) != waiting.len) {
        svc5(WORKLOAD_EXIT_SYSCALL, 1, 0, 0, 0, 0);
        return;
    }

    let resumed: usize = svc5(
        WORKLOAD_PROGRESS_SYSCALL, PEER_NET_WAKE_TAG, 1, 0, 0, 0);
    if (resumed != 1) {
        svc5(WORKLOAD_EXIT_SYSCALL, 1, 0, 0, 0, 0);
        return;
    }
    let line: []u8 = bs"workload: peer NetRx waiter resumed on cpu 1\n";
    if (svc5(WRITE_SYSCALL, 1, line as *u8 as usize,
             line.len, 0, 0) != line.len) {
        svc5(WORKLOAD_EXIT_SYSCALL, 1, 0, 0, 0, 0);
        return;
    }
    svc5(WORKLOAD_EXIT_SYSCALL, 0, 0, 0, 0, 0);
}

fn busy_loop_run(tag: usize) {
    let mut state: usize = 0x9E3779B97F4A7C15 ^ tag;
    let mut done: usize = 0;
    /* Runs until the kernel says there is nothing left to report, then
     * keeps running anyway. A CPU-bound workload that stopped being
     * CPU-bound would stop being the thing a second core is measured
     * against; what is bounded here is the REPORTING, which is what keeps
     * the boot's UART capture finite. */
    while (true) {
        for step: usize in 0..<BUSY_LOOP_ROUND_STEPS {
            state = state ^ (state << 13);
            state = state ^ (state >> 7);
            state = state ^ (state << 17);
        }
        if (done == 0 || done == 1) {
            let answer: usize = svc5(
                WORKLOAD_PROGRESS_SYSCALL, tag, state,
                BUSY_LOOP_ROUND_STEPS, 0, 0);
            /* 2 is the kernel asking this entry to die, so that init has to
             * bring it back and the fixture can check that it brought back
             * only this one. Nothing else here decides to exit: a workload
             * that stopped on its own would prove nothing about init. */
            if (answer == WORKLOAD_ANSWER_EXIT) {
                svc5(WORKLOAD_EXIT_SYSCALL, 0, 0, 0, 0, 0);
            }
            if (answer == WORKLOAD_ANSWER_SIGTERM) {
                let pid: usize = svc5(GETPID_SYSCALL, 0, 0, 0, 0, 0);
                svc5(KILL_SYSCALL, pid, LINUX_SIGTERM, 0, 0, 0);
            }
            if (answer == WORKLOAD_ANSWER_PEER_READ ||
                answer == WORKLOAD_ANSWER_CORE_READ) {
                let mut path: *u8 = "/bin/peer-read" as *u8;
                if (answer == WORKLOAD_ANSWER_CORE_READ) {
                    path = "/bin/core-read" as *u8;
                }
                let mut argv: [usize; 2];
                argv[0] = path as usize;
                argv[1] = 0;
                svc5(EXECVE_SYSCALL, path as usize,
                    argv as *usize as usize, 0, 0, 0);
                // An allocation failure is transient while another exec is
                // committing. A successful exec never returns here.
                done = 0;
            } else {
                done = answer;
            }
        }
    }
}
