use "kernel/arch/arm64/kernel/frame_ref.tkb";
use "kernel/arch/arm64/kernel/cpu_stop_extern.tkb";

extern fn user_code_sync(address: usize, length: usize);
extern fn el0_context_set_x0(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize);
extern fn el0_context_set_elr_el1(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize);
extern fn el0_context_set_sp_el0(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize);
extern fn el0_context_set_tpidr_el0(frame: borrow FrameRef[process, ExceptionLevel::El0], value: usize);
extern fn el0_context_retry_syscall(frame: borrow FrameRef[process, ExceptionLevel::El0]);
extern fn el0_context_resume(frame: sink FrameRef[process, level]) !{noreturn};

// Resume a frame whose process the caller does not name.
fn frame_any_resume(any: sink AnyFrame) {
    match any {
        AnyFrame::Frame(frame) => { el0_context_resume(frame); }
    }
}

extern fn kernel_idle_exit_enter() !{noreturn};
extern fn kernel_idle_yield_enter() !{noreturn};
extern fn kernel_idle_block_enter() !{noreturn};
// GitHub issue #1095: dc civac; dsb ish on the line holding `address`
// (user_entry.S). DDB-only: its one caller is fixed by
// scripts/buildcheck_allowed_callers.py.
extern fn kernel_ddb_dcache_clean_invalidate(address: usize);
extern fn kernel_idle_tick_enter() !{noreturn};
extern fn kernel_idle_boot_enter() !{noreturn};
// Both entries report an explicit invariant stop. A borrowed frame is
// optional diagnostic context, not proof of a synchronous exception.
// Assembly captures the incoming LR before making any call.
// GitHub issue #638 stage 2: TPIDR_EL1, this core's index times the
// per-core stack group stride. Called only by cpu_authority.tkb's
// preempt_slot() (scripts/buildcheck_allowed_callers.py).
extern fn kernel_invariant_stop_with_frame(frame: borrow FrameRef[process, level]) !{noreturn};

extern fn kernel_ddb_breakpoint();
extern fn kernel_ddb_guarded_read_u8(address: usize) -> usize !{unsafe};
extern symbol kernel_ddb_memory_fault_return;
extern fn kernel_ddb_restore_fault_state(esr_el1: usize, far_el1: usize);
extern fn kernel_current_sync_fail_stop(frame: sink FrameRef[process, level]) !{noreturn};

// The fail-stop snapshot deliberately keeps these architectural reads in the
// kernel's existing AArch64 assembly boundary.  They are not general language
// intrinsics: the only caller is exception_evidence.tkb while interrupts are
// masked on the terminal path.
extern fn crash_snapshot_read_sp_el0() -> usize;
// The EL1 stack pointer. Same boundary and the same reason as the reads
// above -- SP is not a system register, so this cannot be an `mrs` at a
// call site even if one wanted it to be.
extern fn kernel_stack_read_sp_el1() -> usize;
extern fn crash_snapshot_read_tpidr_el0() -> usize;
extern fn crash_snapshot_read_ttbr0_el1() -> usize;
extern fn crash_snapshot_copy_saved_frame(frame: borrow FrameRef[process, level], output: *usize);

// GitHub issue #992: the same two for a frame whose level was read at entry.
fn crash_snapshot_copy_leveled_frame(frame: sink LeveledFrame[process], output: *usize) {
    match frame {
        LeveledFrame::El0(user_frame) => { crash_snapshot_copy_saved_frame(user_frame, output); }
        LeveledFrame::El1(kernel_frame) => { crash_snapshot_copy_saved_frame(kernel_frame, output); }
    }
}

fn kernel_current_sync_fail_stop_leveled(frame: sink LeveledFrame[process]) {
    match frame {
        LeveledFrame::El0(user_frame) => { kernel_current_sync_fail_stop(user_frame); }
        LeveledFrame::El1(kernel_frame) => { kernel_current_sync_fail_stop(kernel_frame); }
    }
}

// Must match kernel/arch/arm64/kernel/exception_context.inc's EXC_CONTEXT_SIZE
// exactly; that .inc file remains the single source of truth for the actual
// byte layout (EXC_CONTEXT_SAVE/EXC_CONTEXT_RESTORE), this is a mirror for
// the .tkb code that copies a whole frame rather than one named field.
const EXC_CONTEXT_SIZE: usize = 0x330;
