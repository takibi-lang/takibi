/* GitHub issue #228: the EL0 syscall-ABI test payload that used to be
 * hand-written AArch64 assembly in user_entry.S. Only the two register-level
 * scheduler-preemption probes remain in raw asm (user_payload_asm.S), since
 * they deliberately pin physical registers (x19-x23, q8) that an ordinary
 * .tkb-compiled loop has no way to guarantee live across the busy-wait --
 * the whole point of the probe is to confirm the kernel's context-switch
 * save/restore path, not whatever registers the compiler happens to pick.
 * Everything else here is ordinary syscall policy, so it lives in Takibi.
 *
 * This file is compiled standalone (with user_payload_asm.S) into a real
 * static-PIE ELF (GitHub issue #241; previously a flat position-independent
 * blob via a dedicated linker script, objcopied to raw bytes and embedded
 * into the kernel image directly), placed in the ext2 fixture image as
 * /bin/user_payload, and launched from kernel/tests/ext2/init.sh like any
 * other external command -- see the Makefile's KERNEL_RPI5_USER_PAYLOAD_ELF
 * rule and KERNEL_EXT2_IMAGE's e2cp step.
 */

extern fn scheduler_probe_run(asid_va: usize, asid_marker: usize,
                               simd_pattern: usize, busy_count: usize)
    -> usize;
extern fn busy_spin(count: usize);
extern fn sigchld_probe_arm(record: usize);
extern fn sigchld_probe_handler_address() -> usize;
extern fn sigchld_probe_restorer_address() -> usize;
extern fn altstack_probe_handler_address() -> usize;
extern fn shared_probe_mmap(length: usize, prot: usize, flags: usize) -> usize;

const EBADF_RC: usize = 0xFFFFFFFFFFFFFFF7;
const EFAULT_RC: usize = 0xFFFFFFFFFFFFFFF2;
const ENOSPC_RC: usize = 0xFFFFFFFFFFFFFFE4;
const ENOENT_RC: usize = 0xFFFFFFFFFFFFFFFE;
const EEXIST_RC: usize = 0xFFFFFFFFFFFFFFEF;
const EISDIR_RC: usize = 0xFFFFFFFFFFFFFFEB;
// openat flags (GitHub issue #967): O_CREAT is 0x40, O_EXCL 0x80.
const O_CREAT_RDONLY: usize = 0x40;
const O_CREAT_WRONLY: usize = 0x41;
const O_CREAT_EXCL_RDWR: usize = 0xC2;
// GitHub issue #1016: O_TRUNC is 0x200.
const O_TRUNC_RDWR: usize = 0x202;
const O_TRUNC_RDONLY: usize = 0x200;
const EINVAL_RC: usize = 0xFFFFFFFFFFFFFFEA;
const EACCES_RC: usize = 0xFFFFFFFFFFFFFFF3;
const EAGAIN_RC: usize = 0xFFFFFFFFFFFFFFF5;
const ESRCH_RC: usize = 0xFFFFFFFFFFFFFFFD;
const GETAFFINITY_SYSCALL: usize = 123;
const SETAFFINITY_SYSCALL: usize = 122;
const LARGE_LEN: usize = 1461;
// GitHub issue #761: the long and the short segment the peer sends on
// connection A (scripts/kernel_net_test.py, scripts/eth_tcp_echo_test.py).
const RX_STALE_LONG_LEN: usize = 1000;
const RX_STALE_SHORT_LEN: usize = 10;
const SCHEDULER_CHILD_BUSY: usize = 0x0BEBC200;
const SCHEDULER_PARENT_BUSY: usize = 0x17D78400;
// GitHub issue #209: one polling slice of the parent's reap loop. Short
// enough that the loop reacts promptly once the child exits, long enough
// that the parent is genuinely busy (and therefore preemptible) between
// polls rather than hammering the syscall boundary.
const SCHEDULER_PARENT_POLL_BUSY: usize = 0x00989680;
const WAIT_POLL_MAX: usize = 10000;
const WNOHANG: usize = 1;
const EINTR_RC: usize = 0xFFFFFFFFFFFFFFFC;
const EPIPE_RC: usize = 0xFFFFFFFFFFFFFFE0;
const ENOTCONN_RC: usize = 0xFFFFFFFFFFFFFF95;
const ECONNRESET_RC: usize = 0xFFFFFFFFFFFFFF98;
const SIGCHLD: usize = 17;
const SIGTERM: usize = 15;
const SA_SIGINFO: usize = 4;
const SA_RESTORER: usize = 0x04000000;
const CLD_EXITED: usize = 1;
const CLD_KILLED: usize = 2;
const SI_USER: usize = 0;

/* GitHub issue #241: the real ELF this file links into carries its own
 * e_entry (set via the linker's -e initial_user_payload), so unlike the
 * old flat-blob mechanism, nothing depends on this being the first
 * function in the file's .text section anymore. Named for `-e
 * initial_user_payload` on the link line regardless. */
fn initial_user_payload() !{unsafe} {
    /* GitHub issue #241: this payload used to always be the very first
     * (pid 1) process the kernel created, so its own clone()'d child was
     * always exactly pid 2 -- now launched as an ordinary external command
     * from init.sh's ash, it runs at whatever pid its own fork under ash
     * received, so the child-pid check below is relative to that instead
     * of the literal 2 it used to be. */
    let my_pid: usize = svc5(172, 0, 0, 0, 0, 0);

    /* getcpu(2): both outputs are optional. The process may run on any online
     * CPU now, so compare the reported CPU with its allowed affinity mask
     * instead of assuming core 0. This non-NUMA kernel reports node 0. */
    let mut cpu_node: [u8; 8];
    let cpu_node_base: *u8 = cpu_node as *u8;
    fail_if(svc5(168, ptr_of(cpu_node_base, 0), ptr_of(cpu_node_base, 4),
                 0, 0, 0) != 0);
    let cpu_and_node: usize = payload_read_u64(cpu_node_base, 0);
    let reported_cpu: usize = cpu_and_node & 0xFFFFFFFF;
    fail_if((cpu_and_node >> 32) != 0);
    let mut allowed_cpus: [u8; 8];
    fail_if(svc5(GETAFFINITY_SYSCALL, 0, 8,
                 allowed_cpus as *u8 as usize, 0, 0) != 8);
    let mut reported_cpu_is_allowed: bool = false;
    for byte_index: usize in 0..<8 {
        for bit_index: usize in 0..<8 {
            let bit: u8 = (1 << bit_index) as u8;
            if (reported_cpu == byte_index * 8 + bit_index &&
                (allowed_cpus[byte_index] & bit) != 0) {
                reported_cpu_is_allowed = true;
            }
        }
    }
    fail_if(reported_cpu_is_allowed == false);
    fail_if(svc5(168, 0, 0, 0, 0, 0) != 0);

    /* The scheduler-preemption probe below needs this process and its child
     * time-sliced on ONE CPU: it asserts at least two timer switches between
     * them. With ordinary placement they can land on different CPUs, where
     * no tick ever switches one for the other -- which became likely once
     * GitHub issue #583's refusal list stopped sending every unimplemented
     * syscall to core 0 and so stopped gathering the pair there. Pin to core
     * 0 here, after the getcpu check above has run under the inherited
     * mask; the child inherits this mask across clone. */
    let mut core0_only: [u8; 8];
    for byte_index: usize in 0..<8 { core0_only[byte_index] = 0; }
    core0_only[0] = 1;
    fail_if(svc5(SETAFFINITY_SYSCALL, 0, 8,
                 core0_only as *u8 as usize, 0, 0) != 0);
    fail_if(svc5(168, 1, 0, 0, 0, 0) != EFAULT_RC);

    /* write(9, ..., 1) must return -EBADF. The length `1` is deliberately
     * NOT the literal's real length (22 bytes) -- fd 9 is invalid, so the
     * write never reaches a length check at all; this is not a candidate
     * for the []u8/.len migration GitHub issue #318 did elsewhere in this
     * file. */
    let user_message: *u8 = "hello from userspace\n" as *u8;
    fail_if(svc5(64, 9, user_message as usize, 1, 0, 0) != EBADF_RC);

    /* write(1, null, 1) must return -EFAULT. */
    fail_if(svc5(64, 1, 0, 1, 0, 0) != EFAULT_RC);

    /* GitHub issue #542: keep the truncate/extend regression on the real
     * openat/write/read ABI. The first open truncates (O_TRUNC|O_WRONLY:
     * since #1019 a write only overwrites, as on Linux) and shrinks it,
     * the second grows it, and readback proves no old suffix survived. */
    let mutable_path: *u8 = "/mutable.txt" as *u8;
    let short_content: []const u8 = bs"tiny\n";
    let fd3: usize = svc5(56, 0, mutable_path as usize, 0x201, 0, 0);
    fail_if(fd3 != 3);
    // Raw ABI input only: these syscalls read the readonly bytes.
    // The bridge exposes no writable slice or checked mutation.
    fail_if(svc5(64, fd3, ((unsafe { short_content as *u8 })) as usize,
                 short_content.len, 0, 0) != short_content.len);
    fail_if(svc5(57, 3, 0, 0, 0, 0) != 0);
    let fd4: usize = svc5(56, 0, mutable_path as usize, 0, 0, 0);
    fail_if(fd4 != 3);
    let mut short_readback: [u8; 5];
    fail_if(svc5(63, fd4, short_readback as *u8 as usize,
                 short_content.len, 0, 0) != short_content.len);
    for i: usize in 0..<5 {
        fail_if(short_readback[i] != short_content[i]);
    }
    fail_if(svc5(63, fd4, short_readback as *u8 as usize, 1, 0, 0) != 0);
    fail_if(svc5(57, fd4, 0, 0, 0, 0) != 0);

    /* access and faccessat must inspect inode mode. /hello.txt is 0644,
     * /etc is a searchable directory, /etc/not-a-program is an executable
     * non-program, and /etc/interp-absent is an execute-only fixture. */
    let hello_path: usize = "/hello.txt" as *u8 as usize;
    let etc_path: usize = "/etc" as *u8 as usize;
    let nonprogram_path: usize = "/etc/not-a-program" as *u8 as usize;
    let execute_only_path: usize = "/etc/interp-absent" as *u8 as usize;
    fail_if(svc5(21, hello_path, 0, 0, 0, 0) != 0);
    fail_if(svc5(21, hello_path, 1, 0, 0, 0) != EACCES_RC);
    fail_if(svc5(21, hello_path, 2, 0, 0, 0) != 0);
    fail_if(svc5(21, hello_path, 4, 0, 0, 0) != 0);
    fail_if(svc5(21, etc_path, 1, 0, 0, 0) != 0);
    fail_if(svc5(21, nonprogram_path, 1, 0, 0, 0) != 0);
    fail_if(svc5(21, execute_only_path, 0, 0, 0, 0) != 0);
    fail_if(svc5(21, execute_only_path, 1, 0, 0, 0) != 0);
    fail_if(svc5(21, execute_only_path, 2, 0, 0, 0) != EACCES_RC);
    fail_if(svc5(21, execute_only_path, 4, 0, 0, 0) != EACCES_RC);
    fail_if(svc5(21, execute_only_path, 5, 0, 0, 0) != EACCES_RC);
    fail_if(svc5(21, "hello.txt" as *u8 as usize, 4, 0, 0, 0) != 0);
    fail_if(svc5(21, hello_path, 8, 0, 0, 0) != EINVAL_RC);
    fail_if(svc5(48, 0xFFFFFFFFFFFFFF9C, hello_path, 1, 0, 0) != EACCES_RC);
    fail_if(svc5(439, 0xFFFFFFFFFFFFFF9C, hello_path, 1, 0x200, 0) != EACCES_RC);
    fail_if(svc5(439, 0xFFFFFFFFFFFFFF9C, hello_path, 0, 0x100, 0) != EINVAL_RC);
    let etc_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C, etc_path, 0, 0, 0);
    fail_if(svc5(48, etc_fd, "not-a-program" as *u8 as usize, 1, 0, 0) != 0);
    fail_if(svc5(57, etc_fd, 0, 0, 0, 0) != 0);

    let long_content: []const u8 = bs"extended ext2\n";
    let fd5: usize = svc5(56, 0, mutable_path as usize, 1, 0, 0);
    fail_if(fd5 != 3);
    fail_if(svc5(64, fd5, ((unsafe { long_content as *u8 })) as usize,
                 long_content.len, 0, 0) != long_content.len);
    fail_if(svc5(57, fd5, 0, 0, 0, 0) != 0);
    let fd6: usize = svc5(56, 0, mutable_path as usize, 0, 0, 0);
    fail_if(fd6 != 3);
    let mut long_readback: [u8; 14];
    fail_if(svc5(63, fd6, long_readback as *u8 as usize,
                 long_content.len, 0, 0) != long_content.len);
    for i: usize in 0..<14 {
        fail_if(long_readback[i] != long_content[i]);
    }
    fail_if(svc5(63, fd6, long_readback as *u8 as usize, 1, 0, 0) != 0);
    fail_if(svc5(57, fd6, 0, 0, 0, 0) != 0);
    /* GitHub issue #1019: a write at offset zero without O_TRUNC overwrites
     * the bytes it covers and keeps the rest, size included. */
    let fd7: usize = svc5(56, 0, mutable_path as usize, 1, 0, 0);
    fail_if(fd7 != 3);
    /* GitHub issue #1092: a zero-length write returns 0 (not EINVAL), even
     * with a null buffer, and moves neither the offset nor the content:
     * the "EX" write below still lands at offset 0. */
    fail_if(svc5(64, fd7, 0, 0, 0, 0) != 0);
    fail_if(svc5(64, fd7, "EX" as *u8 as usize, 2, 0, 0) != 2);
    fail_if(svc5(57, fd7, 0, 0, 0, 0) != 0);
    let fd8: usize = svc5(56, 0, mutable_path as usize, 0, 0, 0);
    fail_if(fd8 != 3);
    let overwritten: []const u8 = bs"EXtended ext2\n";
    fail_if(svc5(63, fd8, long_readback as *u8 as usize, 14, 0, 0) != 14);
    for i: usize in 0..<14 {
        fail_if(long_readback[i] != overwritten[i]);
    }
    fail_if(svc5(63, fd8, long_readback as *u8 as usize, 1, 0, 0) != 0);
    fail_if(svc5(57, fd8, 0, 0, 0, 0) != 0);
    let write_success: []const u8 = bs"userspace file syscalls: open/write/read/close and truncate+extend ok\n";
    fail_if(svc5(64, 1, ((unsafe { write_success as *u8 })) as usize,
                 write_success.len, 0, 0) != write_success.len);

    /* GitHub issue #393: RLIMIT_NOFILE is a per-process pair this process
     * can read and change, so prlimit64(2) is exercised for real here --
     * read it, lower the soft limit, read it back and see the new value,
     * then put it back. A stack buffer, not a global: this is a flat RX
     * blob and a writable global would fault (issue #228).
     *
     * The two u64s are read a byte at a time for the same reason the
     * kernel side writes them that way: a *usize cast onto a u8 array
     * assumes an alignment the array does not promise. */
    let mut rlimit_buf: [u8; 16];
    let rlimit_base: *u8 = rlimit_buf as *u8;
    fail_if(svc5(261, 0, 7, 0, ptr_of(rlimit_base, 0), 0) != 0);
    fail_if(payload_read_u64(rlimit_base, 0) != 1024);
    fail_if(payload_read_u64(rlimit_base, 8) != 4096);
    payload_write_u64(rlimit_base, 0, 64);
    payload_write_u64(rlimit_base, 8, 4096);
    fail_if(svc5(261, 0, 7, ptr_of(rlimit_base, 0), 0, 0) != 0);
    payload_write_u64(rlimit_base, 0, 0);
    payload_write_u64(rlimit_base, 8, 0);
    fail_if(svc5(261, 0, 7, 0, ptr_of(rlimit_base, 0), 0) != 0);
    fail_if(payload_read_u64(rlimit_base, 0) != 64);
    payload_write_u64(rlimit_base, 0, 1024);
    payload_write_u64(rlimit_base, 8, 4096);
    fail_if(svc5(261, 0, 7, ptr_of(rlimit_base, 0), 0, 0) != 0);

    /* The two refusals, which the happy path above cannot show. A resource
     * number Linux does not have (RLIM_NLIMITS is 16) is EINVAL rather
     * than a reported limit for a resource that does not exist... */
    fail_if(svc5(261, 0, 999, 0, ptr_of(rlimit_base, 0), 0) != EINVAL_RC);

    /* ...and RLIMIT_NOFILE cannot be raised past what the machine could
     * back. A descriptor NUMBER sizes this kernel's fd block chain, so
     * without that refusal a process could raise its own limit and then
     * dup2() into it until the page allocator was empty. The bound is
     * derived (pages x FD_BLOCK_SLOTS); 1 << 32 is above it on any
     * configuration this kernel runs on, and the limits it already has are
     * unchanged afterwards. */
    payload_write_u64(rlimit_base, 0, 4294967296);
    payload_write_u64(rlimit_base, 8, 4294967296);
    fail_if(svc5(261, 0, 7, ptr_of(rlimit_base, 0), 0, 0) != EINVAL_RC);
    payload_write_u64(rlimit_base, 0, 0);
    payload_write_u64(rlimit_base, 8, 0);
    fail_if(svc5(261, 0, 7, 0, ptr_of(rlimit_base, 0), 0) != 0);
    fail_if(payload_read_u64(rlimit_base, 0) != 1024);
    fail_if(payload_read_u64(rlimit_base, 8) != 4096);

    /* Timed blocking uses the real CLOCK_MONOTONIC counter. One eighth of
     * a second is several 1/64-second scheduler ticks: returning immediately
     * or selecting this process while it is still asleep both fail here. */
    let mut time_buf: [u8; 16];
    let time_base: *u8 = time_buf as *u8;
    payload_write_u64(time_base, 0, 0);
    payload_write_u64(time_base, 8, 125000000);
    let mut before_buf: [u8; 16];
    let before_base: *u8 = before_buf as *u8;
    fail_if(svc5(113, 1, ptr_of(before_base, 0), 0, 0, 0) != 0);
    fail_if(svc5(101, ptr_of(time_base, 0), 0, 0, 0, 0) != 0);
    fail_if(svc5(113, 1, ptr_of(time_base, 0), 0, 0, 0) != 0);
    let before_ns: usize = payload_read_u64(before_base, 0) * 1000000000 +
                           payload_read_u64(before_base, 8);
    let after_ns: usize = payload_read_u64(time_base, 0) * 1000000000 +
                          payload_read_u64(time_base, 8);
    fail_if(after_ns - before_ns < 125000000);

    /* TIMER_ABSTIME uses the CLOCK_MONOTONIC timestamp itself as the
     * deadline. Build one 125 ms ahead, including nanosecond carry, and
     * reject an implementation that treats it as another relative delay. */
    fail_if(svc5(113, 1, ptr_of(before_base, 0), 0, 0, 0) != 0);
    let mut absolute_seconds: usize = payload_read_u64(before_base, 0);
    let mut absolute_nanos: usize =
        payload_read_u64(before_base, 8) + 125000000;
    if (absolute_nanos >= 1000000000) {
        absolute_seconds = absolute_seconds + 1;
        absolute_nanos = absolute_nanos - 1000000000;
    }
    payload_write_u64(time_base, 0, absolute_seconds);
    payload_write_u64(time_base, 8, absolute_nanos);
    fail_if(svc5(115, 1, 1, ptr_of(time_base, 0), 0, 0) != 0);
    fail_if(svc5(113, 1, ptr_of(time_base, 0), 0, 0, 0) != 0);
    let absolute_after_ns: usize =
        payload_read_u64(time_base, 0) * 1000000000 +
        payload_read_u64(time_base, 8);
    let absolute_target_ns: usize =
        absolute_seconds * 1000000000 + absolute_nanos;
    fail_if(absolute_after_ns < absolute_target_ns);

    /* nfds=0 isolates ppoll's timeout result from fd readiness. */
    payload_write_u64(time_base, 0, 0);
    payload_write_u64(time_base, 8, 62500000);
    fail_if(svc5(73, 0, 0, ptr_of(time_base, 0), 0, 0) != 0);

    /* Signal masks are real per-process state. Queue SIGCHLD through kill,
     * consume it through rt_sigtimedwait, then prove both poll and finite
     * timeout return EAGAIN once no signal remains pending. */
    let mut signal_set: [u8; 8];
    let signal_base: *u8 = signal_set as *u8;
    payload_write_u64(signal_base, 0, 1 << 16);
    fail_if(svc5(135, 2, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    fail_if(svc5(129, my_pid, 0, 0, 0, 0) != 0);
    fail_if(svc5(129, my_pid, 17, 0, 0, 0) != 0);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0, 0, 8, 0) != 17);
    payload_write_u64(time_base, 0, 0);
    payload_write_u64(time_base, 8, 0);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0,
                 ptr_of(time_base, 0), 8, 0) != EAGAIN_RC);
    payload_write_u64(time_base, 8, 62500000);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0,
                 ptr_of(time_base, 0), 8, 0) != EAGAIN_RC);
    payload_write_u64(signal_base, 0, 0);
    fail_if(svc5(135, 2, ptr_of(signal_base, 0), 0, 8, 0) != 0);

    // Reboot validation cannot stop the machine: every destructive command
    // below has an invalid magic or unsupported command. CAD is a no-op.
    fail_if(svc5(142, 0, 672274793, 0x4321FEDC, 0, 0) != EINVAL_RC);
    fail_if(svc5(142, 0xFEE1DEAD, 0, 0xCDEF0123, 0, 0) != EINVAL_RC);
    fail_if(svc5(142, 0xFEE1DEAD, 672274793, 0xA1B2C3D4, 0, 0) != EINVAL_RC);
    let mut reboot_magic2: [usize; 4] = { 672274793, 85072278, 369367448, 537993216 };
    for magic_index: usize in 0..<4 {
        fail_if(svc5(142, 0xFEE1DEAD, reboot_magic2[magic_index], 0, 0, 0) != 0);
        fail_if(svc5(142, 0xFEE1DEAD, reboot_magic2[magic_index], 0x89ABCDEF, 0, 0) != 0);
    }
    fail_if(svc5(142, 0xFFFFFFFFFEE1DEAD, 0x100000000 + 672274793,
                 0x100000000, 0, 0) != 0);
    fail_if(svc5(142, 0xFFFFFFFFFEE1DEAD, 672274793,
                 0xFFFFFFFF89ABCDEF, 0, 0) != 0);
    let reboot_abi: []const u8 = bs"reboot ABI: magic+command validation, cad no-ops ok\n";
    fail_if(svc5(64, 1, (unsafe { reboot_abi as *u8 }) as usize, reboot_abi.len, 0, 0) != reboot_abi.len);

    /* socket/bind/listen/close one IPv4 stream endpoint. */
    let mut socket_address: [u8; 16] = {
        0x02, 0x00, 0x1f, 0x90,
        0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00
    };
    let fd4: usize = svc5(198, 2, 1, 0, 0, 0);
    fail_if(fd4 != 4);
    fail_if(svc5(200, 4, (socket_address as *u8) as usize, 16, 0, 0) != 0);
    fail_if(svc5(201, 4, 1, 0, 0, 0) != 0);

    let fd5: usize = svc5(242, 4, 0, 0, 0, 0);
    fail_if(fd5 != 5);
    /* Issue #189: accept a second stream while fd 5 remains live. The
     * bounded fd/connection pools must allocate an independent fd 6/slot. */
    let fd6: usize = svc5(242, 4, 0, 0, 0, 0);
    fail_if(fd6 != 6);

    let connection_b_response: []const u8 = bs"conn-B\n!";
    let socket_response: []const u8 = bs"HTTP/1.0 200 OK\r\n\r\n";
    // GitHub issue #228 (found on real hardware), reconfirmed under the
    // real static-PIE ELF (issue #241): this buffer MUST be a local
    // (stack) variable, not a global. scripts/check_user_payload_no_rw_globals.py
    // enforces zero writable globals in this ELF at build time, so a
    // regression here is caught at compile time instead of as a runtime
    // hang; stack locals are always safe since they live in this process's
    // private, writable stack mapping.
    let mut user_payload_rx_buf: [u8; 16];
    let rx_base: *u8 = user_payload_rx_buf as *u8;

    // Three iovecs include an empty entry between two real segments.
    let mut io_vectors: [u8; 48];
    let vectors_base: *u8 = io_vectors as *u8;
    payload_write_u64(vectors_base, 0, ptr_of(rx_base, 0));
    payload_write_u64(vectors_base, 8, 3);
    payload_write_u64(vectors_base, 16, 0);
    payload_write_u64(vectors_base, 24, 0);
    payload_write_u64(vectors_base, 32, ptr_of(rx_base, 3));
    payload_write_u64(vectors_base, 40, 5);
    fail_if(svc5(65, 5, ptr_of(vectors_base, 0), 3, 0, 0) != 8);
    // A short first segment must return without touching the invalid next
    // segment or waiting for another packet on this connection.
    payload_write_u64(vectors_base, 8, 16);
    payload_write_u64(vectors_base, 16, 0);
    payload_write_u64(vectors_base, 24, 1);
    fail_if(svc5(65, 6, ptr_of(vectors_base, 0), 2, 0, 0) != 8);
    // The physical peer fixture expects connection B's reply in one packet.
    // Empty neighbors still exercise writev without changing that wire shape.
    payload_write_u64(vectors_base, 0, 0);
    payload_write_u64(vectors_base, 8, 0);
    payload_write_u64(vectors_base, 16, (unsafe { connection_b_response as *u8 }) as usize);
    payload_write_u64(vectors_base, 24, connection_b_response.len);
    payload_write_u64(vectors_base, 32, 0);
    payload_write_u64(vectors_base, 40, 0);
    fail_if(svc5(66, 6, ptr_of(vectors_base, 0), 3, 0, 0) != 8);
    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 8, 0, 0) != 8);
    // Connection A's peer collects a byte stream, so split its header into
    // two real TCP writev segments and retain the exact response content.
    payload_write_u64(vectors_base, 0, (unsafe { socket_response as *u8 }) as usize);
    payload_write_u64(vectors_base, 8, 9);
    payload_write_u64(vectors_base, 16, ptr_of((unsafe { socket_response as *u8 }), 9));
    payload_write_u64(vectors_base, 24, 10);
    fail_if(svc5(66, 5, ptr_of(vectors_base, 0), 2, 0, 0) != 19);

    // Same reasoning as user_payload_rx_buf above: must be a stack local.
    let mut user_payload_large_buf: [u8; LARGE_LEN];
    for i in 0..<LARGE_LEN {
        user_payload_large_buf[i] = 0x5a;
    }
    let large_base: *u8 = user_payload_large_buf as *u8;
    // A partial TCP segment ends writev before the following sentinel.
    payload_write_u64(vectors_base, 0, ptr_of(large_base, 0));
    payload_write_u64(vectors_base, 8, LARGE_LEN);
    payload_write_u64(vectors_base, 16, (unsafe { connection_b_response as *u8 }) as usize);
    payload_write_u64(vectors_base, 24, 1);
    fail_if(svc5(66, 5, ptr_of(vectors_base, 0), 2, 0, 0) != 1460);
    fail_if(svc5(64, 5, ptr_of(large_base, 1460), 1, 0, 0) != 1);
    // GitHub issue #1112: a zero-length write on a connected TCP socket
    // returns 0 and sends nothing, as on Linux; it was EINVAL.
    fail_if(svc5(64, 5, ptr_of(large_base, 0), 0, 0, 0) != 0);
    // GitHub issue #1113: fd 4 is listening, Linux's LISTEN state, where a
    // write is EPIPE with SIGPIPE for any length (it was EBADF). Blocked,
    // the SIGPIPE stays pending for rt_sigtimedwait; sendto's MSG_NOSIGNAL
    // keeps the EPIPE and raises none, so the last wait finds nothing.
    payload_write_u64(signal_base, 0, 1 << 12);
    fail_if(svc5(135, 2, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    fail_if(svc5(64, 4, ptr_of(large_base, 0), 1, 0, 0) != EPIPE_RC);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0, 0, 8, 0) != 13);
    fail_if(svc5(64, 4, ptr_of(large_base, 0), 0, 0, 0) != EPIPE_RC);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0, 0, 8, 0) != 13);
    fail_if(svc5(206, 4, ptr_of(large_base, 0), 1, 0x4000, 0) != EPIPE_RC);
    payload_write_u64(time_base, 0, 0);
    payload_write_u64(time_base, 8, 0);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0,
                 ptr_of(time_base, 0), 8, 0) != EAGAIN_RC);
    payload_write_u64(signal_base, 0, 0);
    fail_if(svc5(135, 2, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    // GitHub issue #1116: a read or readv on the listening fd 4 is Linux's
    // ENOTCONN (it was EBADF), and a zero-length read on the connected fd 5
    // returns 0 without waiting (it was EBADF).
    fail_if(svc5(63, 4, ptr_of(rx_base, 0), 8, 0, 0) != ENOTCONN_RC);
    fail_if(svc5(63, 4, ptr_of(rx_base, 0), 0, 0, 0) != ENOTCONN_RC);
    payload_write_u64(vectors_base, 0, ptr_of(rx_base, 0));
    payload_write_u64(vectors_base, 8, 8);
    fail_if(svc5(65, 4, ptr_of(vectors_base, 0), 1, 0, 0) != ENOTCONN_RC);
    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 0, 0, 0) != 0);
    let socket_write_success: []const u8 =
        bs"userspace socket partial write: 1460+1, empty ok\nuserspace socket write on a listener: EPIPE, SIGPIPE, MSG_NOSIGNAL ok\nuserspace socket read on a listener: ENOTCONN, empty read ok\nuserspace socket vectored io: split, empty, short ok\n";
    fail_if(svc5(64, 1, ((unsafe { socket_write_success as *u8 })) as usize,
                 socket_write_success.len, 0, 0) !=
            socket_write_success.len);
    // GitHub issue #842: the first segment of that response was dropped
    // once, and the peer answers only after it has the whole response. A
    // read blocked on this same connection must retransmit it: before the
    // fix only close() and write() did, and this read hung until its own
    // 30-second timeout.
    user_payload_rx_buf[0] = 0;
    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 1, 0, 0) != 1);
    fail_if(user_payload_rx_buf[0] != 0x72);
    let blocked_read_success: []const u8 =
        bs"userspace socket read: a blocked read retransmits its own dropped segment ok\n";
    fail_if(svc5(64, 1, (unsafe { blocked_read_success as *u8 }) as usize,
                 blocked_read_success.len, 0, 0) != blocked_read_success.len);

    // GitHub issue #761: a long segment, then a short one, land in the same
    // connection's receive frame (connection B, fd 6). The second read asks
    // for more than the
    // short segment holds; it must return only that segment's bytes and
    // leave the rest of the buffer untouched, never the long segment's
    // tail. The peer sends the short segment only after this fixture has
    // read the long one and answered with one byte.
    let rx_stale_ready: []const u8 = bs"k";
    for i in 0..<LARGE_LEN {
        user_payload_large_buf[i] = 0x5a;
    }
    fail_if(svc5(63, 6, ptr_of(large_base, 0), 1460, 0, 0) != RX_STALE_LONG_LEN);
    for i in 0..<RX_STALE_LONG_LEN {
        fail_if(user_payload_large_buf[i] != 0x4c);
    }
    fail_if(svc5(64, 6, (unsafe { rx_stale_ready as *u8 }) as usize, 1, 0, 0) != 1);
    for i in 0..<LARGE_LEN {
        user_payload_large_buf[i] = 0x5a;
    }
    fail_if(svc5(63, 6, ptr_of(large_base, 0), 1460, 0, 0) != RX_STALE_SHORT_LEN);
    for i in 0..<LARGE_LEN {
        if (i < RX_STALE_SHORT_LEN) {
            fail_if(user_payload_large_buf[i] != 0x73);
        } else {
            fail_if(user_payload_large_buf[i] != 0x5a);
        }
    }
    let rx_stale_success: []const u8 =
        bs"userspace socket read: a short segment after a long one returns only its own bytes ok\n";
    fail_if(svc5(64, 1, (unsafe { rx_stale_success as *u8 }) as usize,
                 rx_stale_success.len, 0, 0) != rx_stale_success.len);

    // GitHub issue #846: one byte on connection A whose first transmit the
    // kernel drops, then a read blocked on connection B. The peer answers
    // on B only once it has A's byte. Nothing here reads, writes or closes
    // A, and B's read services only B's own deadlines (#257), so A's byte
    // is resent only by the stack-wide pass from the EL0 return or an idle
    // CPU. Without that pass this read ends at its 30-second timeout.
    let unread_byte: []const u8 = bs"p";
    fail_if(svc5(64, 5, (unsafe { unread_byte as *u8 }) as usize, 1, 0, 0) != 1);
    user_payload_rx_buf[0] = 0;
    fail_if(svc5(63, 6, ptr_of(rx_base, 0), 1, 0, 0) != 1);
    fail_if(user_payload_rx_buf[0] != 0x71);
    let unread_success: []const u8 =
        bs"userspace socket retransmit: a connection nobody reads resends its dropped segment ok\n";
    fail_if(svc5(64, 1, (unsafe { unread_success as *u8 }) as usize,
                 unread_success.len, 0, 0) != unread_success.len);

    // GitHub issue #1121: the peer answers B's "y" with a FIN, and A's
    // "z" with an RST. A read after the FIN is EOF every time, for read
    // and readv; after the reset, the first read is ECONNRESET, the next
    // is EOF, and a write is then EPIPE with SIGPIPE (the read took the
    // pending error). Each used to wait out the 30-second timeout.
    // The trigger bytes go out of the stack buffer, so they need no
    // unsafe slice-to-pointer conversion.
    user_payload_rx_buf[0] = 0x79;
    fail_if(svc5(64, 6, ptr_of(rx_base, 0), 1, 0, 0) != 1);
    fail_if(svc5(63, 6, ptr_of(rx_base, 0), 8, 0, 0) != 0);
    fail_if(svc5(63, 6, ptr_of(rx_base, 0), 8, 0, 0) != 0);
    payload_write_u64(vectors_base, 0, ptr_of(rx_base, 0));
    payload_write_u64(vectors_base, 8, 8);
    fail_if(svc5(65, 6, ptr_of(vectors_base, 0), 1, 0, 0) != 0);
    user_payload_rx_buf[0] = 0x7a;
    fail_if(svc5(64, 5, ptr_of(rx_base, 0), 1, 0, 0) != 1);
    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 8, 0, 0) != ECONNRESET_RC);
    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 8, 0, 0) != 0);
    payload_write_u64(signal_base, 0, 1 << 12);
    fail_if(svc5(135, 2, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    fail_if(svc5(64, 5, ptr_of(rx_base, 0), 1, 0, 0) != EPIPE_RC);
    fail_if(svc5(137, ptr_of(signal_base, 0), 0, 0, 8, 0) != 13);
    payload_write_u64(signal_base, 0, 0);
    fail_if(svc5(135, 2, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    let peer_close_success: []const u8 =
        bs"userspace socket read: EOF after FIN, ECONNRESET then EOF after reset ok\n";
    fail_if(svc5(64, 1, (unsafe { peer_close_success as *u8 }) as usize,
                 peer_close_success.len, 0, 0) != peer_close_success.len);

    fail_if(svc5(57, 6, 0, 0, 0, 0) != 0);
    fail_if(svc5(57, 5, 0, 0, 0, 0) != 0);
    fail_if(svc5(57, 4, 0, 0, 0, 0) != 0);


    /* GitHub issue #241 hardware finding: SCHEDULER_PROBE_VA used to be
     * 0x40001000 (USER_DATA_VA), a page the old flat-blob mechanism's own
     * dedicated map_user_data() always reserved as rw+xn. Nothing pins
     * that specific address under the general ELF loader's own layout
     * (this real PIE ELF's PT_LOAD segments do not put anything writable
     * there), so a stack local taken here -- before the fork below --
     * takes its place: 0x11 requests plain fork semantics (no CLONE_VM),
     * so parent and child each get their own COW-copied page at this
     * same VA, exactly what the "private same-VA data" probe needs.
     */
    let mut scheduler_probe_slot: [u8; 8];
    let scheduler_probe_va: usize =
        (scheduler_probe_slot as *u8) as usize;

    /* Syscall 451 delivers one raw byte directly when the child is Blocked,
     * and reads the UART ring when it is runnable. Canonical input would
     * hide an earlier queued byte until newline, letting a later interrupt
     * deliver its byte first. Choose raw input explicitly for this fixture,
     * then restore the inherited settings once the child is reaped. */
    let mut saved_terminal: [u8; 36];
    let mut scalar_terminal: [u8; 36];
    fail_if(svc5(29, 0, 0x5401, saved_terminal as *u8 as usize, 0, 0) != 0);
    for index: usize in 0..<36 { scalar_terminal[index] = saved_terminal[index]; }
    // c_lflag's low byte: clear ICANON (2) and ECHO (8).
    scalar_terminal[12] = scalar_terminal[12] & 0xF5;
    fail_if(svc5(29, 0, 0x5402, scalar_terminal as *u8 as usize, 0, 0) != 0);

    /* The focused context fixture clones only after its independent socket
     * lifecycle is complete; the real HTTPd daemon covers fd inheritance. */
    let pid: usize = svc5(220, 0x11, 0, 0, 0, 0);
    if (pid == 0) {
        /* The first byte must take the scheduler-aware Blocked -> Ready
         * path. Later bytes may already be in the bounded RX ring when
         * selected. */
        let uart_fixture: []const u8 = bs"irqtest\n";
        for want_byte in uart_fixture {
            let c: usize = svc5(451, 0, 0, 0, 0, 0);
            fail_if(c != (want_byte as usize));
        }
        /* Scheduler acceptance: private same-VA data plus GPR and SIMD
         * signatures must survive involuntary timer preemption. */
        fail_if(scheduler_probe_run(scheduler_probe_va, 0x22, 0x5a,
                                     SCHEDULER_CHILD_BUSY) == 0);
        svc5(93, 42, 0, 0, 0, 0);
    } else {
        fail_if(pid != my_pid + 1);
        fail_if(scheduler_probe_run(scheduler_probe_va, 0x11, 0xa5,
                                     SCHEDULER_PARENT_BUSY) == 0);

        /* Accepted only if this parent reached the end of its compute
         * section while the child is still Blocked on UART RX. */
        fail_if(svc5(452, 0, 0, 0, 0, 0) != 0);

        /* GitHub issue #209: poll for the child with WNOHANG instead of
         * either spinning for a fixed count and hoping (the original) or
         * blocking outright in wait4.
         *
         * A fixed spin only PROBABLY outlasted the host's UART delivery,
         * so whether the child got to exit before this parent did depended
         * on how much unrelated work ran earlier in the boot -- and a
         * parent exit disables the scheduler (kernel/kernel/process.tkb's
         * kernel_process_child_exit), which leaves a still-blocked child
         * permanently unrunnable. Adding anything ahead of this fixture in
         * init.sh flipped that coin.
         *
         * A plain blocking wait4 fixes the ordering but destroys what this
         * fixture measures: with the parent Blocked, the child is the only
         * runnable process, so the timer never has two runnable processes
         * to alternate between and the preemption evidence disappears.
         *
         * Polling keeps this parent genuinely RUNNABLE and busy while the
         * child is runnable too -- which is exactly the alternating-timer
         * condition under test -- while still refusing to proceed until
         * the child has actually been reaped. */
        let mut reaped: usize = 0;
        let mut attempts: usize = 0;
        while (reaped != pid && attempts < WAIT_POLL_MAX) {
            busy_spin(SCHEDULER_PARENT_POLL_BUSY);
            reaped = svc5(260, 0xFFFFFFFFFFFFFFFF, 0, WNOHANG, 0, 0);
            attempts = attempts + 1;
        }
        fail_if(reaped != pid);
        fail_if(svc5(129, pid, 0, 0, 0, 0) != ESRCH_RC);
        fail_if(svc5(29, 0, 0x5402, saved_terminal as *u8 as usize, 0, 0) != 0);

        /* Deliberately sends 21 of this literal's 22 real bytes, trimming
         * the trailing newline -- the length `21` intentionally does NOT
         * match the literal's real length, so this is not a candidate for
         * the []u8/.len migration GitHub issue #318 did elsewhere in this
         * file. */
        let user_message2: *u8 = "hello from userspace\n" as *u8;
        fail_if(svc5(64, 1, user_message2 as usize, 21, 0, 0) != 21);

        /* The final process-image scenario: sequential write(2) calls cross
         * all direct ext2 pointers and the first indirect entry. Reopening
         * uses the ordinary read(2) offset path to compare every byte. */
        let mut write_block: [u8; 1024];
        let mut read_block: [u8; 1024];
        // The boot fixture leaves thirteen free blocks in ordinary files.
        // GitHub issue #1086: a write(2) claims only the blocks it changes,
        // as on Linux, so a six-block spare file is made first and given
        // back after the ENOSPC; the checks below then start, as before,
        // with six blocks free. Appends of one block each then go on until
        // one finds the volume full (seven fit on QEMU's image; the count
        // is what the volume held, so it is measured, not assumed). This
        // is the real write(2) path, with a nonzero fd offset.
        let spare_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                   "/enospc-spare" as *u8 as usize,
                                   O_CREAT_WRONLY, 0x1A4, 0);
        fail_if(spare_fd >= 64);
        for block: usize in 0..<6 {
            fail_if(svc5(64, spare_fd, write_block as *u8 as usize,
                         1024, 0, 0) != 1024);
        }
        fail_if(svc5(57, spare_fd, 0, 0, 0, 0) != 0);
        let exhaustion_fd: usize = svc5(56, 0, mutable_path as usize, 1, 0, 0);
        fail_if(exhaustion_fd >= 64);
        let mut committed: usize = 0;
        let mut full: bool = false;
        for block: usize in 0..<12 {
            if (full == false) {
                for byte: usize in 0..<1024 {
                    write_block[byte] =
                        (((block * 1024 + byte) * 37 + 11) % 251) as u8;
                }
                let answer: usize = svc5(64, exhaustion_fd,
                                          write_block as *u8 as usize, 1024, 0, 0);
                if (answer == 1024) { committed = committed + 1; }
                else {
                    fail_if(answer != ENOSPC_RC);
                    full = true;
                }
            }
        }
        fail_if(full == false || committed < 2);
        fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, "/enospc-spare" as *u8 as usize,
                     0, 0, 0) != 0);
        // Reopening sees only the committed prefix, byte for byte.
        let exhaustion_read: usize = svc5(56, 0, mutable_path as usize, 0, 0, 0);
        fail_if(exhaustion_read >= 64);
        for block: usize in 0..<12 {
            if (block < committed) {
                fail_if(svc5(63, exhaustion_read, read_block as *u8 as usize,
                             1024, 0, 0) != 1024);
                for byte: usize in 0..<1024 {
                    fail_if(read_block[byte] !=
                        (((block * 1024 + byte) * 37 + 11) % 251) as u8);
                }
            }
        }
        fail_if(svc5(63, exhaustion_read, read_block as *u8 as usize,
                     1, 0, 0) != 0);
        fail_if(svc5(57, exhaustion_read, 0, 0, 0, 0) != 0);
        // GitHub issue #698: the spare file's six blocks are free again.
        // mkdirat
        // takes one block and one inode each: make directories until the
        // bitmap is empty, and the one that finds it empty must say ENOSPC
        // (it said EIO) and leave no entry. All of them go again below.
        let mut dir_path: [u8; 12];
        let dir_stem: []const u8 = bs"/enospc-d";
        for byte: usize in 0..<9 { dir_path[byte] = dir_stem[byte]; }
        dir_path[10] = 0;
        dir_path[11] = 0;
        let mut made: usize = 0;
        let mut refused: bool = false;
        for attempt: usize in 0..<32 {
            if (refused == false) {
                dir_path[9] = (0x41 + attempt) as u8;
                let answer: usize = svc5(34, 0xFFFFFFFFFFFFFF9C,
                                         dir_path as *u8 as usize, 0x1ED, 0, 0);
                if (answer == 0) { made = made + 1; }
                else {
                    fail_if(answer != ENOSPC_RC);
                    refused = true;
                }
            }
        }
        fail_if(refused == false || made == 0);
        fail_if(svc5(56, 0, dir_path as *u8 as usize, 0, 0, 0) < 64);
        // GitHub issue #967: openat(O_CREAT) on the same full volume. An
        // empty file takes an inode and no block, so creation goes on until
        // the root directory's last block has no room for one more entry
        // and it cannot grow: that call must say ENOSPC and leave no name.
        let mut file_path: [u8; 12];
        let file_stem: []const u8 = bs"/enospc-f";
        for byte: usize in 0..<9 { file_path[byte] = file_stem[byte]; }
        file_path[11] = 0;
        let mut created: usize = 0;
        let mut create_refused: bool = false;
        for attempt: usize in 0..<104 {
            if (create_refused == false) {
                file_path[9] = (0x41 + attempt / 26) as u8;
                file_path[10] = (0x41 + attempt % 26) as u8;
                let answer: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                         file_path as *u8 as usize,
                                         O_CREAT_WRONLY, 0x1A4, 0);
                if (answer < 64) {
                    fail_if(svc5(57, answer, 0, 0, 0, 0) != 0);
                    created = created + 1;
                } else {
                    fail_if(answer != ENOSPC_RC);
                    create_refused = true;
                }
            }
        }
        fail_if(create_refused == false);
        fail_if(svc5(56, 0xFFFFFFFFFFFFFF9C, file_path as *u8 as usize,
                     0, 0, 0) != ENOENT_RC);
        for attempt: usize in 0..<104 {
            if (attempt < created) {
                file_path[9] = (0x41 + attempt / 26) as u8;
                file_path[10] = (0x41 + attempt % 26) as u8;
                fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, file_path as *u8 as usize,
                             0, 0, 0) != 0);
            }
        }
        // GitHub issue #1016: O_TRUNC frees a file's blocks, counted on
        // the full volume. Every directory above goes, so their blocks are
        // the only free ones; a three-block file takes some; mkdirat counts
        // the rest until ENOSPC. After O_TRUNC it must count exactly three
        // more. fstat and read say size 0. The directories are made again
        // for the cleanup below.
        for attempt: usize in 0..<32 {
            if (attempt < made) {
                dir_path[9] = (0x41 + attempt) as u8;
                fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, dir_path as *u8 as usize,
                             0x200, 0, 0) != 0);
            }
        }
        let mut trunc_content: [u8; 3072];
        for byte: usize in 0..<3072 {
            trunc_content[byte] = (byte / 1024 + 0x61) as u8;
        }
        let trunc_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                   "/trunc-file" as *u8 as usize,
                                   O_CREAT_EXCL_RDWR, 0x1A4, 0);
        fail_if(trunc_fd >= 64);
        // GitHub issue #1036: one write(2) of three blocks transfers all
        // of them, though the kernel stages one block at a time; one read
        // gives every byte back.
        fail_if(svc5(64, trunc_fd, trunc_content as *u8 as usize,
                     3072, 0, 0) != 3072);
        fail_if(svc5(57, trunc_fd, 0, 0, 0, 0) != 0);
        for byte: usize in 0..<3072 { trunc_content[byte] = 0; }
        let back_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                  "/trunc-file" as *u8 as usize, 0, 0, 0);
        fail_if(back_fd >= 64);
        fail_if(svc5(63, back_fd, trunc_content as *u8 as usize,
                     3072, 0, 0) != 3072);
        fail_if(svc5(57, back_fd, 0, 0, 0, 0) != 0);
        for byte: usize in 0..<3072 {
            fail_if(trunc_content[byte] != (byte / 1024 + 0x61) as u8);
        }
        let mut trunc_stat: [u8; 128];
        let trunc_stat_base: *u8 = trunc_stat as *u8;
        fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, "/trunc-file" as *u8 as usize,
                     ptr_of(trunc_stat_base, 0), 0, 0) != 0);
        fail_if(payload_read_u64(trunc_stat_base, 48) != 3072);
        let free_before: usize = free_blocks_by_mkdir();
        let truncated_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                       "/trunc-file" as *u8 as usize,
                                       O_TRUNC_RDWR, 0, 0);
        fail_if(truncated_fd >= 64);
        fail_if(svc5(63, truncated_fd, read_block as *u8 as usize,
                     1, 0, 0) != 0);
        fail_if(svc5(57, truncated_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, "/trunc-file" as *u8 as usize,
                     ptr_of(trunc_stat_base, 0), 0, 0) != 0);
        fail_if(payload_read_u64(trunc_stat_base, 48) != 0);
        fail_if(free_blocks_by_mkdir() != free_before + 3);
        // An empty file truncates again; a missing name without O_CREAT is
        // ENOENT and creates nothing; a directory is EISDIR.
        let again_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                   "/trunc-file" as *u8 as usize,
                                   O_TRUNC_RDONLY, 0, 0);
        fail_if(again_fd >= 64);
        fail_if(svc5(57, again_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(56, 0xFFFFFFFFFFFFFF9C, "/trunc-none" as *u8 as usize,
                     O_TRUNC_RDWR, 0, 0) != ENOENT_RC);
        fail_if(svc5(56, 0xFFFFFFFFFFFFFF9C, "/trunc-none" as *u8 as usize,
                     0, 0, 0) != ENOENT_RC);
        fail_if(svc5(56, 0xFFFFFFFFFFFFFF9C, "/" as *u8 as usize,
                     O_TRUNC_RDONLY, 0, 0) != EISDIR_RC);
        // GitHub issue #1022: ftruncate(fd, 0) and truncate(path, 0) take
        // the same walk. ftruncate gives the three blocks back, counted as
        // above; any other length is EINVAL, a read-only descriptor EINVAL,
        // no descriptor EBADF. truncate empties a one-block file by name,
        // and refuses a directory and a missing name.
        let ft_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                "/trunc-file" as *u8 as usize, 2, 0, 0);
        fail_if(ft_fd >= 64);
        for block: usize in 0..<3 {
            fail_if(svc5(64, ft_fd, ptr_of(trunc_content as *u8,
                         block * 1024), 1024, 0, 0) != 1024);
        }
        fail_if(svc5(46, ft_fd, 1, 0, 0, 0) != EINVAL_RC);
        let ft_free_before: usize = free_blocks_by_mkdir();
        fail_if(svc5(46, ft_fd, 0, 0, 0, 0) != 0);
        fail_if(free_blocks_by_mkdir() != ft_free_before + 3);
        fail_if(svc5(57, ft_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, "/trunc-file" as *u8 as usize,
                     ptr_of(trunc_stat_base, 0), 0, 0) != 0);
        fail_if(payload_read_u64(trunc_stat_base, 48) != 0);
        let ft_read_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                     "/trunc-file" as *u8 as usize, 0, 0, 0);
        fail_if(ft_read_fd >= 64);
        fail_if(svc5(46, ft_read_fd, 0, 0, 0, 0) != EINVAL_RC);
        fail_if(svc5(57, ft_read_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(46, 63, 0, 0, 0, 0) != EBADF_RC);
        let tr_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                "/trunc-file" as *u8 as usize, 2, 0, 0);
        fail_if(tr_fd >= 64);
        fail_if(svc5(64, tr_fd, trunc_content as *u8 as usize, 1024,
                     0, 0) != 1024);
        fail_if(svc5(57, tr_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(45, "/trunc-file" as *u8 as usize, 0, 0, 0, 0) != 0);
        fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, "/trunc-file" as *u8 as usize,
                     ptr_of(trunc_stat_base, 0), 0, 0) != 0);
        fail_if(payload_read_u64(trunc_stat_base, 48) != 0);
        fail_if(svc5(45, "/" as *u8 as usize, 0, 0, 0, 0) != EISDIR_RC);
        fail_if(svc5(45, "/trunc-none" as *u8 as usize, 0, 0, 0, 0) !=
                ENOENT_RC);
        fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C,
                     "/trunc-file" as *u8 as usize, 0, 0, 0) != 0);
        for attempt: usize in 0..<32 {
            if (attempt < made) {
                dir_path[9] = (0x41 + attempt) as u8;
                fail_if(svc5(34, 0xFFFFFFFFFFFFFF9C, dir_path as *u8 as usize,
                             0x1ED, 0, 0) != 0);
            }
        }
        for attempt: usize in 0..<32 {
            if (attempt < made) {
                dir_path[9] = (0x41 + attempt) as u8;
                fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, dir_path as *u8 as usize,
                             0x200, 0, 0) != 0);
            }
        }
        // Last-link unlink supports direct files today (#1020). Shrink both
        // fillers first: O_TRUNC releases their indirect blocks, the one-byte
        // write takes one block, and unlinkat releases it and the inode.
        write_block[0] = 0x78;
        let filler_a: usize = svc5(56, 0, "/enospc-a" as *u8 as usize, 0x201, 0, 0);
        fail_if(filler_a >= 64);
        fail_if(svc5(64, filler_a, write_block as *u8 as usize, 1, 0, 0) != 1);
        fail_if(svc5(57, filler_a, 0, 0, 0, 0) != 0);
        let filler_b: usize = svc5(56, 0, "/enospc-b" as *u8 as usize, 0x201, 0, 0);
        fail_if(filler_b >= 64);
        fail_if(svc5(64, filler_b, write_block as *u8 as usize, 1, 0, 0) != 1);
        fail_if(svc5(57, filler_b, 0, 0, 0, 0) != 0);
        fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C,
                     "/enospc-a" as *u8 as usize, 0, 0, 0) != 0);
        fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C,
                     "/enospc-b" as *u8 as usize, 0, 0, 0) != 0);
        fail_if(svc5(34, 0xFFFFFFFFFFFFFF9C, "/enospc-dir" as *u8 as usize,
                     0x1ED, 0, 0) != 0);
        fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C,
                     "/enospc-dir" as *u8 as usize, 0x200, 0, 0) != 0);
        // GitHub issue #967: with room again, O_CREAT|O_EXCL makes an empty
        // file; a second O_EXCL says EEXIST; plain O_CREAT opens the file as
        // it is; and O_CREAT naming a directory says EISDIR.
        let created_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                     "/creat-file" as *u8 as usize,
                                     O_CREAT_EXCL_RDWR, 0x1A4, 0);
        fail_if(created_fd >= 64);
        fail_if(svc5(63, created_fd, read_block as *u8 as usize, 1, 0, 0) != 0);
        write_block[0] = 0x43;
        fail_if(svc5(64, created_fd, write_block as *u8 as usize, 1, 0, 0) != 1);
        fail_if(svc5(57, created_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(56, 0xFFFFFFFFFFFFFF9C, "/creat-file" as *u8 as usize,
                     O_CREAT_EXCL_RDWR, 0x1A4, 0) != EEXIST_RC);
        let reopened_fd: usize = svc5(56, 0xFFFFFFFFFFFFFF9C,
                                      "/creat-file" as *u8 as usize,
                                      O_CREAT_RDONLY, 0x1A4, 0);
        fail_if(reopened_fd >= 64);
        fail_if(svc5(63, reopened_fd, read_block as *u8 as usize, 2, 0, 0) != 1);
        fail_if(read_block[0] != 0x43);
        fail_if(svc5(57, reopened_fd, 0, 0, 0, 0) != 0);
        fail_if(svc5(56, 0xFFFFFFFFFFFFFF9C, "/" as *u8 as usize,
                     O_CREAT_WRONLY, 0x1A4, 0) != EISDIR_RC);
        fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C,
                     "/creat-file" as *u8 as usize, 0, 0, 0) != 0);
        // Retrying on the SAME fd appends just past the committed blocks. A
        // failure that moved its offset would create a zero-filled gap,
        // caught by the read and EOF.
        write_block[0] = 0x21;
        fail_if(svc5(64, exhaustion_fd, write_block as *u8 as usize,
                     1, 0, 0) != 1);
        fail_if(svc5(57, exhaustion_fd, 0, 0, 0, 0) != 0);
        let retry_read: usize = svc5(56, 0, mutable_path as usize, 0, 0, 0);
        fail_if(retry_read >= 64);
        for block: usize in 0..<12 {
            if (block < committed) {
                fail_if(svc5(63, retry_read, read_block as *u8 as usize,
                             1024, 0, 0) != 1024);
                for byte: usize in 0..<1024 {
                    fail_if(read_block[byte] !=
                        (((block * 1024 + byte) * 37 + 11) % 251) as u8);
                }
            }
        }
        fail_if(svc5(63, retry_read, read_block as *u8 as usize, 1, 0, 0) != 1);
        fail_if(read_block[0] != 0x21);
        fail_if(svc5(63, retry_read, read_block as *u8 as usize, 1, 0, 0) != 0);
        fail_if(svc5(57, retry_read, 0, 0, 0, 0) != 0);
        let exhaustion_message: []const u8 =
            bs"userspace ext2 exhaustion: write+mkdir+creat ENOSPC, data+offset unchanged, unlink+retry ok, creat excl+reopen ok, trunc frees direct blocks\n";
        fail_if(svc5(64, 1, (unsafe { exhaustion_message as *u8 }) as usize,
                     exhaustion_message.len, 0, 0) != exhaustion_message.len);
        let write_fd: usize = svc5(56, 0, mutable_path as usize, 1, 0, 0);
        fail_if(write_fd >= 64);
        for block: usize in 0..<13 {
            for byte: usize in 0..<1024 {
                write_block[byte] =
                    (((block * 1024 + byte) * 37 + 11) % 251) as u8;
            }
            let answer: usize = svc5(64, write_fd, write_block as *u8 as usize,
                                      1024, 0, 0);
            if (answer == ENOSPC_RC) {
                let message: []const u8 = bs"userspace ext2 write: ENOSPC\n";
                svc5(64, 2, (unsafe { message as *u8 }) as usize, message.len, 0, 0);
            }
            fail_if(answer != 1024);
        }
        fail_if(svc5(57, write_fd, 0, 0, 0, 0) != 0);
        let read_fd: usize = svc5(56, 0, mutable_path as usize, 0, 0, 0);
        fail_if(read_fd >= 64);
        for block: usize in 0..<13 {
            fail_if(svc5(63, read_fd, read_block as *u8 as usize,
                         1024, 0, 0) != 1024);
            for byte: usize in 0..<1024 {
                fail_if(read_block[byte] !=
                    (((block * 1024 + byte) * 37 + 11) % 251) as u8);
            }
        }
        fail_if(svc5(63, read_fd, read_block as *u8 as usize,
                     1, 0, 0) != 0);
        fail_if(svc5(57, read_fd, 0, 0, 0, 0) != 0);
        // GitHub issue #1016: thirteen blocks reach the singly-indirect
        // block, which O_TRUNC releases with the data. Counting the free
        // blocks here would cost hundreds of mkdirat calls (the volume has
        // room again), so the count is the host's e2fsck -fn after the
        // lane: a block left marked or freed twice fails its pass 5.
        let indirect_fd: usize = svc5(56, 0, mutable_path as usize,
                                      O_TRUNC_RDONLY, 0, 0);
        fail_if(indirect_fd >= 64);
        fail_if(svc5(63, indirect_fd, read_block as *u8 as usize,
                     1, 0, 0) != 0);
        fail_if(svc5(57, indirect_fd, 0, 0, 0, 0) != 0);
        let mut indirect_stat: [u8; 128];
        let indirect_stat_base: *u8 = indirect_stat as *u8;
        fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, mutable_path as usize,
                     ptr_of(indirect_stat_base, 0), 0, 0) != 0);
        fail_if(payload_read_u64(indirect_stat_base, 48) != 0);
        let restore_fd: usize = svc5(56, 0, mutable_path as usize, 1, 0, 0);
        fail_if(restore_fd >= 64);
        let restore_content: []const u8 = bs"before\n";
        fail_if(svc5(64, restore_fd, (unsafe { restore_content as *u8 }) as usize,
                     restore_content.len, 0, 0) != restore_content.len);
        fail_if(svc5(57, restore_fd, 0, 0, 0, 0) != 0);
        sigchld_siginfo_probe();
        sigaltstack_probe();
        sigaltstack_autodisarm_probe();
        shared_mapping_probe();
        statfs_umask_kernel_probe();
        mmap_region_probe();
        mmap_region_kernel_probe();
        realtime_clock_probe();
        itimer_probe();
        credentials_probe();
        signal_conformance_probe();
        svc5(93, 0, 0, 0, 0, 0);
    }
}

/* GitHub issue #892: run the kernel's SIGCHLD siginfo path itself -- exit
 * notify -> ProcessRecord.sigchld_pid/status -> TakenSignal -> signal frame
 * (GitHub issue #885). An SA_SIGINFO handler (user_payload_asm.S) copies
 * si_signo, si_code, si_pid and si_status into `record`; each case checks
 * what the frame carried. Runs last, after every earlier fixture took its
 * evidence, since its children take pids. */
// GitHub issue #1016: the free block count as userspace can see it, with no
// statfs. mkdirat takes one block (and one inode) per directory, so the
// number made before ENOSPC is the free block count while inodes outnumber
// blocks; every one is removed again. Called only on the nearly full volume
// (a few blocks free): it is a few dozen syscalls there, and hundreds on a
// volume with room, which the debug lane's budget cannot afford. More than
// 32 fails the probe.
fn free_blocks_by_mkdir() -> usize !{unsafe} {
    let mut probe_path: [u8; 11];
    let probe_stem: []const u8 = bs"/trunc-pA";
    for byte: usize in 0..<9 { probe_path[byte] = probe_stem[byte]; }
    probe_path[9] = 0;
    probe_path[10] = 0;
    let mut made: usize = 0;
    let mut refused: bool = false;
    for attempt: usize in 0..<32 {
        if (refused == false) {
            probe_path[8] = (0x41 + attempt) as u8;
            let answer: usize = svc5(34, 0xFFFFFFFFFFFFFF9C,
                                     probe_path as *u8 as usize, 0x1ED, 0, 0);
            if (answer == 0) { made = made + 1; }
            else {
                fail_if(answer != ENOSPC_RC);
                refused = true;
            }
        }
    }
    fail_if(refused == false);
    for attempt: usize in 0..<32 {
        if (attempt < made) {
            probe_path[8] = (0x41 + attempt) as u8;
            fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, probe_path as *u8 as usize,
                         0x200, 0, 0) != 0);
        }
    }
    return made;
}

fn sigchld_siginfo_probe() !{unsafe} {
    let mut record: [u8; 40];
    let record_base: *u8 = record as *u8;
    for index: usize in 0..<40 { record[index] = 0; }
    sigchld_probe_arm(ptr_of(record_base, 0));
    let mut action: [u8; 32];
    let action_base: *u8 = action as *u8;
    payload_write_u64(action_base, 0, sigchld_probe_handler_address());
    payload_write_u64(action_base, 8, SA_SIGINFO | SA_RESTORER);
    payload_write_u64(action_base, 16, sigchld_probe_restorer_address());
    payload_write_u64(action_base, 24, 0);
    fail_if(svc5(134, SIGCHLD, ptr_of(action_base, 0), 0, 8, 0) != 0);
    let mut signal_set: [u8; 8];
    let signal_base: *u8 = signal_set as *u8;
    payload_write_u64(signal_base, 0, 1 << 16);

    // A child killed by SIGTERM: CLD_KILLED, si_status the signal.
    let killed: usize = sigchld_probe_child(0);
    sigchld_probe_reap(killed);
    sigchld_probe_expect(record_base, 1, CLD_KILLED, killed, SIGTERM);

    // A child that exits 3: CLD_EXITED, si_status the exit code.
    let exited: usize = sigchld_probe_child(3);
    sigchld_probe_reap(exited);
    sigchld_probe_expect(record_base, 2, CLD_EXITED, exited, 3);

    // Standard signals do not queue: a second exit while SIGCHLD is
    // pending keeps the first child's siginfo, and the handler runs once.
    fail_if(svc5(135, 0, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    let first: usize = sigchld_probe_child(5);
    sigchld_probe_reap(first);
    let second: usize = sigchld_probe_child(6);
    sigchld_probe_reap(second);
    fail_if(payload_read_u64(record_base, 0) != 2);
    fail_if(svc5(135, 1, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    sigchld_probe_expect(record_base, 3, CLD_EXITED, first, 5);

    // A SIGCHLD sent by kill names no child: SI_USER with si_pid the
    // sender (GitHub issue #894), and a child exiting while it is pending
    // does not rename it.
    let my_pid: usize = svc5(172, 0, 0, 0, 0, 0);
    fail_if(svc5(135, 0, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    fail_if(svc5(129, my_pid, SIGCHLD, 0, 0, 0) != 0);
    let late: usize = sigchld_probe_child(7);
    sigchld_probe_reap(late);
    fail_if(svc5(135, 1, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    sigchld_probe_expect(record_base, 4, SI_USER, my_pid, 0);
    // And unmasked, the kill's own return delivers it.
    fail_if(svc5(129, my_pid, SIGCHLD, 0, 0, 0) != 0);
    sigchld_probe_expect(record_base, 5, SI_USER, my_pid, 0);
    // GitHub issue #894: another process's kill names that process, and
    // a later kill while it is pending keeps the first sender.
    fail_if(svc5(135, 0, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    let sender: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (sender == 0) {
        svc5(129, my_pid, SIGCHLD, 0, 0, 0);
        svc5(93, 0, 0, 0, 0, 0);
    }
    fail_if(sender >= 0x8000000000000000);
    sigchld_probe_reap(sender);
    fail_if(svc5(129, my_pid, SIGCHLD, 0, 0, 0) != 0);
    fail_if(svc5(135, 1, ptr_of(signal_base, 0), 0, 8, 0) != 0);
    sigchld_probe_expect(record_base, 6, SI_USER, sender, 0);

    payload_write_u64(action_base, 0, 0);
    payload_write_u64(action_base, 8, 0);
    payload_write_u64(action_base, 16, 0);
    fail_if(svc5(134, SIGCHLD, ptr_of(action_base, 0), 0, 8, 0) != 0);
    let message: []const u8 =
        bs"userspace SIGCHLD siginfo: CLD_KILLED, CLD_EXITED, pending keeps first, kill SI_USER names first sender ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

/* GitHub issue #1138: sigaltstack(2) and SA_ONSTACK delivery. Every
 * answer is Linux's: `sigaltstack_probe_alone` is the same code as its own
 * static-PIE entry, which `make linuxcheck` runs under qemu-aarch64 and
 * compares with this line of the linux_file view. The alternate stack is
 * this function's own 16 KiB array, zeroed so every page is there. */
const SIGALTSTACK_SYSCALL: usize = 132;
const SIGUSR1: usize = 10;
const SA_ONSTACK: usize = 0x08000000;
const SS_ONSTACK: usize = 1;
const SS_DISABLE: usize = 2;
const SS_AUTODISARM: usize = 0x80000000;
const ALTSTACK_PROBE_SIZE: usize = 16384;
const EPERM_RC: usize = 0xFFFFFFFFFFFFFFFF;
const ENOMEM_RC: usize = 0xFFFFFFFFFFFFFFF4;

fn sigaltstack_probe_alone() !{unsafe} {
    sigaltstack_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

fn sigaltstack_probe() !{unsafe} {
    let mut alt: [u8; ALTSTACK_PROBE_SIZE];
    for index: usize in 0..<ALTSTACK_PROBE_SIZE { alt[index] = 0; }
    let alt_base: usize = alt as *u8 as usize;
    let mut record: [u8; 104];
    let record_base: *u8 = record as *u8;
    for index: usize in 0..<104 { record[index] = 0; }
    sigchld_probe_arm(ptr_of(record_base, 0));
    let mut stack: [u8; 24];
    let stack_base: *u8 = stack as *u8;
    // The change the handler tries: the stack as installed below, so it is
    // refused on that stack (EPERM) and a no-op off it.
    altstack_probe_set(record_base, 80, alt_base, 0, ALTSTACK_PROBE_SIZE);

    // None yet: SS_DISABLE, no stack. Bad mode, small size, bad pointer.
    altstack_probe_expect_query(stack_base, 0, SS_DISABLE, 0);
    altstack_probe_set(stack_base, 0, alt_base, 4, ALTSTACK_PROBE_SIZE);
    fail_if(svc5(SIGALTSTACK_SYSCALL, ptr_of(stack_base, 0), 0, 0, 0, 0) != EINVAL_RC);
    // 1024: below arm64's MINSIGSTKSZ (5120) and qemu-user's own (2048).
    altstack_probe_set(stack_base, 0, alt_base, 0, 1024);
    fail_if(svc5(SIGALTSTACK_SYSCALL, ptr_of(stack_base, 0), 0, 0, 0, 0) != ENOMEM_RC);
    fail_if(svc5(SIGALTSTACK_SYSCALL, 1, 0, 0, 0, 0) != EFAULT_RC);
    fail_if(svc5(SIGALTSTACK_SYSCALL, 0, 1, 0, 0, 0) != EFAULT_RC);
    altstack_probe_expect_query(stack_base, 0, SS_DISABLE, 0);

    // Installed: the query reports it, off it.
    altstack_probe_set(stack_base, 0, alt_base, 0, ALTSTACK_PROBE_SIZE);
    fail_if(svc5(SIGALTSTACK_SYSCALL, ptr_of(stack_base, 0), 0, 0, 0, 0) != 0);
    altstack_probe_expect_query(stack_base, alt_base, 0, ALTSTACK_PROBE_SIZE);

    // SA_ONSTACK: the handler runs on it, sees SS_ONSTACK, cannot change
    // it, and its frame's uc_stack is the stack as set.
    altstack_probe_raise(SA_ONSTACK);
    altstack_probe_expect_run(record_base, 1, alt_base, true, 0,
                              SS_ONSTACK, alt_base, ALTSTACK_PROBE_SIZE, EPERM_RC);
    fail_if(payload_read_u64(record_base, 32) != alt_base);
    fail_if(payload_read_u64(record_base, 40) != 0);
    fail_if(payload_read_u64(record_base, 48) != ALTSTACK_PROBE_SIZE);

    // Without SA_ONSTACK the handler stays on the process stack.
    altstack_probe_raise(0);
    altstack_probe_expect_run(record_base, 2, alt_base, false, 0,
                              0, alt_base, ALTSTACK_PROBE_SIZE, 0);

    // A fork child inherits it.
    let child: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        let mut child_stack: [u8; 24];
        let child_base: *u8 = child_stack as *u8;
        let mut code: usize = 1;
        if (svc5(SIGALTSTACK_SYSCALL, 0, ptr_of(child_base, 0), 0, 0, 0) == 0 &&
            payload_read_u64(child_base, 0) == alt_base &&
            payload_read_u64(child_base, 16) == ALTSTACK_PROBE_SIZE) {
            code = 0;
        }
        svc5(93, code, 0, 0, 0, 0);
    }
    fail_if(child >= 0x8000000000000000);
    let mut status: [u8; 8];
    let status_base: *u8 = status as *u8;
    payload_write_u64(status_base, 0, 0xFF);
    fail_if(svc5(260, child, ptr_of(status_base, 0), 0, 0, 0) != child);
    fail_if((payload_read_u64(status_base, 0) & 0xFFFFFFFF) != 0);

    // SS_DISABLE removes it: an SA_ONSTACK handler runs on the process
    // stack, and uc_stack says SS_DISABLE.
    altstack_probe_set(stack_base, 0, 0, SS_DISABLE, 0);
    fail_if(svc5(SIGALTSTACK_SYSCALL, ptr_of(stack_base, 0), 0, 0, 0, 0) != 0);
    altstack_probe_expect_query(stack_base, 0, SS_DISABLE, 0);
    altstack_probe_raise(SA_ONSTACK);
    fail_if(payload_read_u64(record_base, 0) != 3);
    fail_if(altstack_probe_on(payload_read_u64(record_base, 8), alt_base));
    fail_if(payload_read_u64(record_base, 32) != 0);
    fail_if(payload_read_u64(record_base, 40) != SS_DISABLE);
    fail_if(payload_read_u64(record_base, 48) != 0);
    // The handler's own change installed a stack, and rt_sigreturn put
    // back the disabled one its frame recorded.
    fail_if(payload_read_u64(record_base, 24) != 0);
    altstack_probe_expect_query(stack_base, 0, SS_DISABLE, 0);

    altstack_probe_reset();
    let message: []const u8 =
        bs"userspace sigaltstack: EINVAL, ENOMEM, EFAULT, SA_ONSTACK runs on it with SS_ONSTACK and EPERM, fork keeps it, SS_DISABLE ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

// SS_AUTODISARM, which qemu-aarch64 8.2 refuses with EINVAL, so this half
// runs only in the kernel's payload and its expectations are read from
// Linux's do_sigaltstack, on_sig_stack and signal_setup_done: delivery
// disarms the stack, so the handler sees none and may set one, and
// rt_sigreturn puts back the stack its frame recorded.
fn sigaltstack_autodisarm_probe() !{unsafe} {
    let mut alt: [u8; ALTSTACK_PROBE_SIZE];
    for index: usize in 0..<ALTSTACK_PROBE_SIZE { alt[index] = 0; }
    let alt_base: usize = alt as *u8 as usize;
    let mut record: [u8; 104];
    let record_base: *u8 = record as *u8;
    for index: usize in 0..<104 { record[index] = 0; }
    sigchld_probe_arm(ptr_of(record_base, 0));
    let mut stack: [u8; 24];
    let stack_base: *u8 = stack as *u8;
    altstack_probe_set(record_base, 80, alt_base, 0, ALTSTACK_PROBE_SIZE);
    altstack_probe_set(stack_base, 0, alt_base, SS_AUTODISARM, ALTSTACK_PROBE_SIZE);
    fail_if(svc5(SIGALTSTACK_SYSCALL, ptr_of(stack_base, 0), 0, 0, 0, 0) != 0);
    altstack_probe_expect_query(stack_base, alt_base, SS_AUTODISARM, ALTSTACK_PROBE_SIZE);
    altstack_probe_raise(SA_ONSTACK);
    altstack_probe_expect_run(record_base, 1, alt_base, true, 0,
                              SS_DISABLE, 0, 0, 0);
    fail_if(payload_read_u64(record_base, 40) != SS_AUTODISARM);
    altstack_probe_expect_query(stack_base, alt_base, SS_AUTODISARM, ALTSTACK_PROBE_SIZE);
    altstack_probe_reset();
    let message: []const u8 =
        bs"userspace sigaltstack SS_AUTODISARM: disarmed in the handler, restored by rt_sigreturn ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

// No alternate stack, and SIGUSR1 back to SIG_DFL.
fn altstack_probe_reset() !{unsafe} {
    let mut stack: [u8; 24];
    let stack_base: *u8 = stack as *u8;
    altstack_probe_set(stack_base, 0, 0, SS_DISABLE, 0);
    fail_if(svc5(SIGALTSTACK_SYSCALL, ptr_of(stack_base, 0), 0, 0, 0, 0) != 0);
    let mut action: [u8; 32];
    for index: usize in 0..<32 { action[index] = 0; }
    fail_if(svc5(134, SIGUSR1, action as *u8 as usize, 0, 8, 0) != 0);
}

// A stack_t at `offset`: ss_sp, ss_flags (int), ss_size.
fn altstack_probe_set(base: *u8, offset: usize, sp: usize, flags: usize,
                      size: usize) {
    payload_write_u64(base, offset, sp);
    payload_write_u64(base, offset + 8, flags);
    payload_write_u64(base, offset + 16, size);
}

fn altstack_probe_expect_query(base: *u8, sp: usize, flags: usize,
                               size: usize) !{unsafe} {
    altstack_probe_set(base, 0, 0xAA, 0xAAAA, 0xAA);
    fail_if(svc5(SIGALTSTACK_SYSCALL, 0, ptr_of(base, 0), 0, 0, 0) != 0);
    fail_if(payload_read_u64(base, 0) != sp);
    // ss_flags is an int; the padding after it is not the kernel's.
    fail_if((payload_read_u64(base, 8) & 0xFFFFFFFF) != flags);
    fail_if(payload_read_u64(base, 16) != size);
}

// `sp` lies in the probe's alternate stack.
fn altstack_probe_on(sp: usize, alt_base: usize) -> bool {
    return sp > alt_base && sp - alt_base <= ALTSTACK_PROBE_SIZE;
}

// SIGUSR1's handler, with SA_SIGINFO, SA_RESTORER and `flags`, sent to
// this process; it runs at the kill's return.
fn altstack_probe_raise(flags: usize) !{unsafe} {
    let mut action: [u8; 32];
    let action_base: *u8 = action as *u8;
    payload_write_u64(action_base, 0, altstack_probe_handler_address());
    payload_write_u64(action_base, 8, SA_SIGINFO | SA_RESTORER | flags);
    payload_write_u64(action_base, 16, sigchld_probe_restorer_address());
    payload_write_u64(action_base, 24, 0);
    fail_if(svc5(134, SIGUSR1, ptr_of(action_base, 0), 0, 8, 0) != 0);
    fail_if(svc5(129, svc5(172, 0, 0, 0, 0, 0), SIGUSR1, 0, 0, 0) != 0);
}

// The handler ran `runs` times in all, the last on (`on`) or off the
// alternate stack; its query answered `query` with { sp, flags, size },
// and its change `change`.
fn altstack_probe_expect_run(record_base: *u8, runs: usize, alt_base: usize,
                             on: bool, query: usize, flags: usize,
                             sp: usize, size: usize, change: usize) {
    fail_if(payload_read_u64(record_base, 0) != runs);
    fail_if(altstack_probe_on(payload_read_u64(record_base, 8), alt_base) != on);
    fail_if(payload_read_u64(record_base, 16) != query);
    fail_if(payload_read_u64(record_base, 56) != sp);
    fail_if((payload_read_u64(record_base, 64) & 0xFFFFFFFF) != flags);
    fail_if(payload_read_u64(record_base, 72) != size);
    fail_if(payload_read_u64(record_base, 24) != change);
}

/* GitHub issue #1147: MAP_SHARED|MAP_ANONYMOUS stays shared across fork
 * while MAP_PRIVATE is copied, munmap; umask(2) set and read back;
 * getrusage(2) and statfs(2) checks and faults. Every answer is Linux's:
 * `shared_mapping_probe_alone` is the same code as its own static-PIE
 * entry, which `make linuxcheck` runs under qemu-aarch64 and compares with
 * this line of the linux_file view. The kernel-only half, which needs the
 * ext2 root, is statfs_umask_kernel_probe. */
const MMAP_SYSCALL: usize = 222;
const MUNMAP_SYSCALL: usize = 215;
const STATFS_SYSCALL: usize = 43;
const GETRUSAGE_SYSCALL: usize = 165;
const UMASK_SYSCALL: usize = 166;
const PROT_READ_WRITE: usize = 3;
const MAP_SHARED_ANONYMOUS: usize = 0x21;
const MAP_PRIVATE_ANONYMOUS: usize = 0x22;
const SHARED_PROBE_LENGTH: usize = 8192;

fn shared_mapping_probe_alone() !{unsafe} {
    shared_mapping_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

fn shared_mapping_probe() !{unsafe} {
    // Neither shared nor private is EINVAL.
    fail_if(shared_probe_mmap(SHARED_PROBE_LENGTH, PROT_READ_WRITE, 0x20) != EINVAL_RC);
    let shared: usize = shared_probe_mmap(SHARED_PROBE_LENGTH, PROT_READ_WRITE,
                                          MAP_SHARED_ANONYMOUS);
    fail_if(shared >= 0xFFFFFFFFFFFFF000 || shared % 4096 != 0);
    let own: usize = shared_probe_mmap(4096, PROT_READ_WRITE,
                                           MAP_PRIVATE_ANONYMOUS);
    fail_if(own >= 0xFFFFFFFFFFFFF000 || own % 4096 != 0);
    let shared_base: *u8 = unsafe { shared as *u8 };
    let own_base: *u8 = unsafe { own as *u8 };
    // Anonymous memory reads as zero.
    fail_if(payload_read_u64(shared_base, 0) != 0);
    fail_if(payload_read_u64(shared_base, 4096) != 0);
    payload_write_u64(shared_base, 0, 0x1147A);
    payload_write_u64(own_base, 0, 0x1147B);
    let child: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        let mut code: usize = 1;
        if (payload_read_u64(shared_base, 0) == 0x1147A &&
            payload_read_u64(own_base, 0) == 0x1147B) {
            code = 0;
        }
        payload_write_u64(shared_base, 0, 0x1147C);
        payload_write_u64(shared_base, 4096, 0x1147D);
        payload_write_u64(own_base, 0, 0x1147E);
        svc5(93, code, 0, 0, 0, 0);
    }
    fail_if(child >= 0x8000000000000000);
    let mut status: [u8; 8];
    let status_base: *u8 = status as *u8;
    payload_write_u64(status_base, 0, 0xFF);
    fail_if(svc5(260, child, ptr_of(status_base, 0), 0, 0, 0) != child);
    fail_if((payload_read_u64(status_base, 0) & 0xFFFFFFFF) != 0);
    // The child's stores reached the shared pages and not the private one.
    fail_if(payload_read_u64(shared_base, 0) != 0x1147C);
    fail_if(payload_read_u64(shared_base, 4096) != 0x1147D);
    fail_if(payload_read_u64(own_base, 0) != 0x1147B);
    fail_if(svc5(MUNMAP_SYSCALL, shared, SHARED_PROBE_LENGTH, 0, 0, 0) != 0);
    fail_if(svc5(MUNMAP_SYSCALL, own, 4096, 0, 0, 0) != 0);
    // A new shared mapping reads as zero again, whatever it reuses.
    let again: usize = shared_probe_mmap(4096, PROT_READ_WRITE, MAP_SHARED_ANONYMOUS);
    fail_if(again >= 0xFFFFFFFFFFFFF000);
    fail_if(payload_read_u64(unsafe { again as *u8 }, 0) != 0);
    fail_if(svc5(MUNMAP_SYSCALL, again, 4096, 0, 0, 0) != 0);

    // umask returns the old mask and keeps only the permission bits.
    svc5(UMASK_SYSCALL, 0x17, 0, 0, 0, 0);
    fail_if(svc5(UMASK_SYSCALL, 0xFFF, 0, 0, 0, 0) != 0x17);
    fail_if(svc5(UMASK_SYSCALL, 0x12, 0, 0, 0, 0) != 0x1FF);
    // A fork child inherits it.
    let umask_child: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (umask_child == 0) {
        let mut code: usize = 1;
        if (svc5(UMASK_SYSCALL, 0x12, 0, 0, 0, 0) == 0x12) { code = 0; }
        svc5(93, code, 0, 0, 0, 0);
    }
    fail_if(umask_child >= 0x8000000000000000);
    payload_write_u64(status_base, 0, 0xFF);
    fail_if(svc5(260, umask_child, ptr_of(status_base, 0), 0, 0, 0) != umask_child);
    fail_if((payload_read_u64(status_base, 0) & 0xFFFFFFFF) != 0);

    let mut usage: [u8; 144];
    let usage_base: *u8 = usage as *u8;
    fail_if(svc5(GETRUSAGE_SYSCALL, 0, ptr_of(usage_base, 0), 0, 0, 0) != 0);
    fail_if(svc5(GETRUSAGE_SYSCALL, 0xFFFFFFFFFFFFFFFF, ptr_of(usage_base, 0), 0, 0, 0) != 0);
    fail_if(svc5(GETRUSAGE_SYSCALL, 5, ptr_of(usage_base, 0), 0, 0, 0) != EINVAL_RC);
    fail_if(svc5(GETRUSAGE_SYSCALL, 0, 1, 0, 0, 0) != EFAULT_RC);

    let mut fs: [u8; 120];
    let fs_base: *u8 = fs as *u8;
    for index: usize in 0..<120 { fs[index] = 0; }
    fail_if(svc5(STATFS_SYSCALL, "/" as *u8 as usize, ptr_of(fs_base, 0), 0, 0, 0) != 0);
    fail_if(payload_read_u64(fs_base, 8) == 0);
    fail_if(payload_read_u64(fs_base, 24) > payload_read_u64(fs_base, 16));
    fail_if(payload_read_u64(fs_base, 32) > payload_read_u64(fs_base, 24));
    fail_if(svc5(STATFS_SYSCALL, "/takibi-1147-absent" as *u8 as usize,
                 ptr_of(fs_base, 0), 0, 0, 0) != ENOENT_RC);
    fail_if(svc5(STATFS_SYSCALL, 1, ptr_of(fs_base, 0), 0, 0, 0) != EFAULT_RC);
    fail_if(svc5(STATFS_SYSCALL, "/" as *u8 as usize, 1, 0, 0, 0) != EFAULT_RC);
    let message: []const u8 =
        bs"userspace shared mmap: fork shares MAP_SHARED and copies MAP_PRIVATE, munmap ok; umask keeps 0777 and forks; getrusage and statfs EINVAL, ENOENT, EFAULT ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

/* GitHub issue #1151: the mmap region. stress-ng's shared cache buffer
 * (2 MiB, core-shared-cache.c's MEM_CACHE_SIZE with one NUMA node) is
 * mapped and stays shared across fork; an 8 MiB private mapping, beyond
 * the 128-page arena mmap used to share with brk, reads as zero on first
 * touch, also when a syscall's user range reaches an untouched page first;
 * MADV_DONTNEED zeroes a private page and keeps a shared one; and the
 * region's pages come back on munmap. Every answer is Linux's:
 * `mmap_region_probe_alone` is the same code as its own static-PIE entry,
 * which `make linuxcheck` runs under qemu-aarch64 and compares with this
 * line of the linux_file view. mmap_region_kernel_probe is the half
 * qemu-user does not answer as Linux does. */
const MADVISE_SYSCALL: usize = 233;
const MADV_RANDOM: usize = 1;
const MADV_WILLNEED: usize = 3;
const MADV_DONTNEED: usize = 4;
const MADV_REMOVE: usize = 9;
const MADV_NOHUGEPAGE: usize = 15;
const REGION_SHARED_LENGTH: usize = 0x200000;
const REGION_PRIVATE_LENGTH: usize = 0x800000;

fn mmap_region_probe_alone() !{unsafe} {
    mmap_region_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

fn mmap_region_probe() !{unsafe} {
    let shared: usize = shared_probe_mmap(REGION_SHARED_LENGTH, PROT_READ_WRITE,
                                          MAP_SHARED_ANONYMOUS);
    fail_if(shared >= 0xFFFFFFFFFFFFF000 || shared % 4096 != 0);
    let own: usize = shared_probe_mmap(REGION_PRIVATE_LENGTH, PROT_READ_WRITE,
                                       MAP_PRIVATE_ANONYMOUS);
    fail_if(own >= 0xFFFFFFFFFFFFF000 || own % 4096 != 0);
    let shared_base: *u8 = unsafe { shared as *u8 };
    let own_base: *u8 = unsafe { own as *u8 };
    let shared_last: usize = REGION_SHARED_LENGTH - 8;
    let own_last: usize = REGION_PRIVATE_LENGTH - 8;
    fail_if(payload_read_u64(shared_base, shared_last) != 0);
    fail_if(payload_read_u64(own_base, own_last) != 0);
    payload_write_u64(shared_base, 0, 0x1151A);
    payload_write_u64(own_base, 0, 0x1151B);
    // A syscall writes an untouched private page first: getrusage's 144
    // bytes land in the middle of the mapping.
    let middle: usize = REGION_PRIVATE_LENGTH / 2;
    fail_if(svc5(GETRUSAGE_SYSCALL, 0, own + middle, 0, 0, 0) != 0);
    fail_if(payload_read_u64(own_base, middle) != 0);
    let child: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        let mut code: usize = 1;
        if (payload_read_u64(shared_base, 0) == 0x1151A &&
            payload_read_u64(own_base, 0) == 0x1151B &&
            payload_read_u64(own_base, own_last) == 0) {
            code = 0;
        }
        payload_write_u64(shared_base, shared_last, 0x1151C);
        payload_write_u64(own_base, 0, 0x1151D);
        payload_write_u64(own_base, own_last, 0x1151E);
        svc5(93, code, 0, 0, 0, 0);
    }
    fail_if(child >= 0x8000000000000000);
    let mut status: [u8; 8];
    let status_base: *u8 = status as *u8;
    payload_write_u64(status_base, 0, 0xFF);
    fail_if(svc5(260, child, ptr_of(status_base, 0), 0, 0, 0) != child);
    fail_if((payload_read_u64(status_base, 0) & 0xFFFFFFFF) != 0);
    fail_if(payload_read_u64(shared_base, shared_last) != 0x1151C);
    fail_if(payload_read_u64(own_base, 0) != 0x1151B);
    fail_if(payload_read_u64(own_base, own_last) != 0);

    // madvise: an unaligned start is EINVAL, a zero length is 0, a hint
    // changes nothing, DONTNEED zeroes the private page and keeps the
    // shared one.
    fail_if(svc5(MADVISE_SYSCALL, own + 1, 4096, MADV_DONTNEED, 0, 0) != EINVAL_RC);
    fail_if(svc5(MADVISE_SYSCALL, own, 0, MADV_DONTNEED, 0, 0) != 0);
    fail_if(svc5(MADVISE_SYSCALL, own, REGION_PRIVATE_LENGTH, MADV_RANDOM, 0, 0) != 0);
    fail_if(svc5(MADVISE_SYSCALL, own, 4096, MADV_WILLNEED, 0, 0) != 0);
    fail_if(svc5(MADVISE_SYSCALL, own, 4096, MADV_NOHUGEPAGE, 0, 0) != 0);
    fail_if(payload_read_u64(own_base, 0) != 0x1151B);
    fail_if(svc5(MADVISE_SYSCALL, own, 4096, MADV_DONTNEED, 0, 0) != 0);
    fail_if(payload_read_u64(own_base, 0) != 0);
    payload_write_u64(own_base, 0, 0x1151F);
    fail_if(payload_read_u64(own_base, 0) != 0x1151F);
    fail_if(svc5(MADVISE_SYSCALL, shared, 4096, MADV_DONTNEED, 0, 0) != 0);
    fail_if(payload_read_u64(shared_base, 0) != 0x1151A);

    fail_if(svc5(MUNMAP_SYSCALL, shared, REGION_SHARED_LENGTH, 0, 0, 0) != 0);
    fail_if(svc5(MUNMAP_SYSCALL, own, REGION_PRIVATE_LENGTH, 0, 0, 0) != 0);
    // What munmap gave back holds a larger mapping, which reads as zero.
    let larger: usize = shared_probe_mmap(REGION_PRIVATE_LENGTH + REGION_SHARED_LENGTH,
                                          PROT_READ_WRITE, MAP_PRIVATE_ANONYMOUS);
    fail_if(larger >= 0xFFFFFFFFFFFFF000);
    fail_if(payload_read_u64(unsafe { larger as *u8 }, 0) != 0);
    fail_if(svc5(MUNMAP_SYSCALL, larger, REGION_PRIVATE_LENGTH + REGION_SHARED_LENGTH,
                 0, 0, 0) != 0);
    let message: []const u8 =
        bs"userspace mmap region: 2 MiB MAP_SHARED shared across fork, 8 MiB MAP_PRIVATE zero on first touch and by syscall, madvise EINVAL, hints, DONTNEED zeroes private and keeps shared, munmap reuse ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

// The half qemu-user answers differently from Linux (it takes any advice
// and does not look for an unmapped page): an unknown advice and
// MADV_REMOVE on a private mapping are EINVAL (madvise_behavior_valid,
// madvise_remove), a range with an unmapped page is ENOMEM; and this
// kernel's own limit, a mapping larger than the 16 MiB region is ENOMEM.
fn mmap_region_kernel_probe() !{unsafe} {
    let own: usize = shared_probe_mmap(8192, PROT_READ_WRITE, MAP_PRIVATE_ANONYMOUS);
    fail_if(own >= 0xFFFFFFFFFFFFF000);
    fail_if(svc5(MADVISE_SYSCALL, own, 4096, 1000, 0, 0) != EINVAL_RC);
    fail_if(svc5(MADVISE_SYSCALL, own, 4096, MADV_REMOVE, 0, 0) != EINVAL_RC);
    fail_if(svc5(MUNMAP_SYSCALL, own + 4096, 4096, 0, 0, 0) != 0);
    fail_if(svc5(MADVISE_SYSCALL, own, 8192, MADV_DONTNEED, 0, 0) != ENOMEM_RC);
    fail_if(svc5(MUNMAP_SYSCALL, own, 4096, 0, 0, 0) != 0);
    fail_if(shared_probe_mmap(0x1001000, PROT_READ_WRITE, MAP_PRIVATE_ANONYMOUS)
            != ENOMEM_RC);
    let message: []const u8 =
        bs"userspace mmap region limits: madvise unknown and MADV_REMOVE EINVAL, unmapped ENOMEM, over 16 MiB ENOMEM ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

/* GitHub issue #1166: CLOCK_REALTIME advances. It was a fixed timestamp,
 * and stress-ng's stress_yield_sleep_ms -- usleep(1000) until the realtime
 * clock has moved 1 ms -- never returned. Both clocks are read around a
 * 20 ms nanosleep and must have moved at least 10 ms; realtime must also be
 * past 2001 (10^9 s). `realtime_clock_probe_alone` runs under qemu-aarch64
 * in `make linuxcheck` against this line of the linux_file view. */
const CLOCK_GETTIME_SYSCALL: usize = 113;
const NANOSLEEP_SYSCALL: usize = 101;
const REALTIME_PROBE_SLEEP_NS: usize = 20000000;
const REALTIME_PROBE_MIN_NS: usize = 10000000;

fn realtime_clock_probe_alone() !{unsafe} {
    realtime_clock_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

// One clock as nanoseconds; fails the probe on an error or a bad timespec.
fn realtime_probe_read_ns(clock: usize) -> usize !{unsafe} {
    let mut ts: [u8; 16];
    let ts_base: *u8 = ts as *u8;
    fail_if(svc5(CLOCK_GETTIME_SYSCALL, clock, ptr_of(ts_base, 0), 0, 0, 0) != 0);
    let seconds: usize = payload_read_u64(ts_base, 0);
    let nanos: usize = payload_read_u64(ts_base, 8);
    fail_if(nanos >= 1000000000 || seconds >= 10000000000);
    return seconds * 1000000000 + nanos;
}

fn realtime_clock_probe() !{unsafe} {
    let real_before: usize = realtime_probe_read_ns(0);
    let mono_before: usize = realtime_probe_read_ns(1);
    fail_if(real_before < 1000000000 * 1000000000);
    let mut request: [u8; 16];
    let request_base: *u8 = request as *u8;
    payload_write_u64(request_base, 0, 0);
    payload_write_u64(request_base, 8, REALTIME_PROBE_SLEEP_NS);
    fail_if(svc5(NANOSLEEP_SYSCALL, ptr_of(request_base, 0), 0, 0, 0, 0) != 0);
    let real_after: usize = realtime_probe_read_ns(0);
    let mono_after: usize = realtime_probe_read_ns(1);
    fail_if(real_after < real_before + REALTIME_PROBE_MIN_NS);
    fail_if(mono_after < mono_before + REALTIME_PROBE_MIN_NS);
    // An unknown clock is EINVAL.
    let mut ts: [u8; 16];
    fail_if(svc5(CLOCK_GETTIME_SYSCALL, 0x7FFF, ptr_of(ts as *u8, 0), 0, 0, 0) != EINVAL_RC);
    let message: []const u8 =
        bs"userspace clocks: CLOCK_REALTIME and CLOCK_MONOTONIC advance across a 20 ms nanosleep, unknown clock EINVAL ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

/* GitHub issue #1172: setitimer's ITIMER_REAL. It armed nothing, so
 * alarm() never sent SIGALRM and stress-ng's --timeout never ended a
 * stressor. getitimer and setitimer's old value, a one-shot timer that
 * fires once, an interval timer that fires again, invalid `which` and
 * tv_usec EINVAL, a fork child without its parent's timer, and a default
 * SIGALRM ending a sleeper. SIGALRM is blocked and taken by
 * rt_sigtimedwait, so no handler (and no writable global) is needed.
 * `itimer_probe_alone` runs under qemu-aarch64 in `make linuxcheck`
 * against this line of the linux_file view. */
const GETITIMER_SYSCALL: usize = 102;
const ITIMER_SET_SYSCALL: usize = 103;
const SIGALRM: usize = 14;
const ITIMER_WHICH_REAL: usize = 0;

fn itimer_probe_alone() !{unsafe} {
    itimer_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

// A struct itimerval from two microsecond counts.
fn itimer_probe_store(base: *u8, interval_us: usize, value_us: usize) {
    payload_write_u64(base, 0, interval_us / 1000000);
    payload_write_u64(base, 8, interval_us % 1000000);
    payload_write_u64(base, 16, value_us / 1000000);
    payload_write_u64(base, 24, value_us % 1000000);
}

fn itimer_probe_us(base: *u8, offset: usize) -> usize {
    let micros: usize = payload_read_u64(base, offset + 8);
    fail_if(micros >= 1000000);
    return payload_read_u64(base, offset) * 1000000 + micros;
}

// The caller's ITIMER_REAL as (interval, remaining) microseconds.
fn itimer_probe_get(base: *u8) -> (usize, usize) !{unsafe} {
    for word: usize in 0..<4 { payload_write_u64(base, word * 8, 0xFFFFFFFFFFFFFFFF); }
    fail_if(svc5(GETITIMER_SYSCALL, ITIMER_WHICH_REAL, ptr_of(base, 0), 0, 0, 0) != 0);
    return (itimer_probe_us(base, 0), itimer_probe_us(base, 16));
}

// rt_sigtimedwait for SIGALRM alone, at most `seconds`.
fn itimer_probe_wait(seconds: usize) -> usize !{unsafe} {
    let mut set: [u8; 8];
    let set_base: *u8 = set as *u8;
    payload_write_u64(set_base, 0, 1 << (SIGALRM - 1));
    let mut timeout: [u8; 16];
    let timeout_base: *u8 = timeout as *u8;
    payload_write_u64(timeout_base, 0, seconds);
    payload_write_u64(timeout_base, 8, 0);
    return svc5(137, ptr_of(set_base, 0), 0, ptr_of(timeout_base, 0), 8, 0);
}

fn itimer_probe() !{unsafe} {
    let mut value: [u8; 32];
    let value_base: *u8 = value as *u8;
    let mut old: [u8; 32];
    let old_base: *u8 = old as *u8;
    // Nothing armed.
    let (idle_interval, idle_left) = itimer_probe_get(old_base);
    fail_if(idle_interval != 0 || idle_left != 0);
    // A one-shot 500 ms timer: the old value is zero, and getitimer reports
    // no interval and at most 500 ms left.
    itimer_probe_store(value_base, 0, 500000);
    for index: usize in 0..<32 { old[index] = 0xFF; }
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0),
                 ptr_of(old_base, 0), 0, 0) != 0);
    fail_if(itimer_probe_us(old_base, 0) != 0 || itimer_probe_us(old_base, 16) != 0);
    let (armed_interval, armed_left) = itimer_probe_get(old_base);
    fail_if(armed_interval != 0 || armed_left == 0 || armed_left > 500000);
    // Disarming answers the time that was left.
    itimer_probe_store(value_base, 0, 0);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0),
                 ptr_of(old_base, 0), 0, 0) != 0);
    let left: usize = itimer_probe_us(old_base, 16);
    fail_if(left == 0 || left > 500000);
    let (off_interval, off_left) = itimer_probe_get(old_base);
    fail_if(off_interval != 0 || off_left != 0);
    // An unknown `which` and a tv_usec of a whole second are EINVAL.
    fail_if(svc5(ITIMER_SET_SYSCALL, 3, ptr_of(value_base, 0), 0, 0, 0) != EINVAL_RC);
    fail_if(svc5(GETITIMER_SYSCALL, 3, ptr_of(old_base, 0), 0, 0, 0) != EINVAL_RC);
    itimer_probe_store(value_base, 0, 0);
    payload_write_u64(value_base, 24, 1000000);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0), 0, 0, 0) != EINVAL_RC);

    // With SIGALRM blocked, a 20 ms one-shot timer fires once and disarms.
    let mut mask: [u8; 8];
    let mask_base: *u8 = mask as *u8;
    payload_write_u64(mask_base, 0, 1 << (SIGALRM - 1));
    fail_if(svc5(135, 0, ptr_of(mask_base, 0), 0, 8, 0) != 0);
    itimer_probe_store(value_base, 0, 20000);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0), 0, 0, 0) != 0);
    fail_if(itimer_probe_wait(2) != SIGALRM);
    let (fired_interval, fired_left) = itimer_probe_get(old_base);
    fail_if(fired_interval != 0 || fired_left != 0);
    // A 10 ms interval timer fires again and again, and keeps its interval.
    itimer_probe_store(value_base, 10000, 10000);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0), 0, 0, 0) != 0);
    for round: usize in 0..<3 { fail_if(itimer_probe_wait(2) != SIGALRM); }
    itimer_probe_store(value_base, 0, 0);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0),
                 ptr_of(old_base, 0), 0, 0) != 0);
    fail_if(itimer_probe_us(old_base, 0) != 10000);
    // An expiry before the disarm may still be pending; take it.
    let drained: usize = itimer_probe_wait(0);
    fail_if(drained != SIGALRM && drained != EAGAIN_RC);
    fail_if(svc5(135, 1, ptr_of(mask_base, 0), 0, 8, 0) != 0);

    // A fork child does not inherit the parent's timer, and a default
    // SIGALRM ends it in its sleep.
    itimer_probe_store(value_base, 0, 5000000);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0), 0, 0, 0) != 0);
    let child: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        let mut child_value: [u8; 32];
        let child_base: *u8 = child_value as *u8;
        let (child_interval, child_left) = itimer_probe_get(child_base);
        if (child_interval != 0 || child_left != 0) { svc5(93, 2, 0, 0, 0, 0); }
        itimer_probe_store(child_base, 0, 20000);
        svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(child_base, 0), 0, 0, 0);
        let mut sleep: [u8; 16];
        let sleep_base: *u8 = sleep as *u8;
        payload_write_u64(sleep_base, 0, 2);
        payload_write_u64(sleep_base, 8, 0);
        svc5(NANOSLEEP_SYSCALL, ptr_of(sleep_base, 0), 0, 0, 0, 0);
        svc5(93, 1, 0, 0, 0, 0);
    }
    fail_if(child >= 0x8000000000000000);
    let mut status: [u8; 8];
    let status_base: *u8 = status as *u8;
    payload_write_u64(status_base, 0, 0xFF);
    fail_if(svc5(260, child, ptr_of(status_base, 0), 0, 0, 0) != child);
    fail_if((payload_read_u64(status_base, 0) & 0xFFFFFFFF) != SIGALRM);
    // The parent's own timer survived the fork; disarm it.
    itimer_probe_store(value_base, 0, 0);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0),
                 ptr_of(old_base, 0), 0, 0) != 0);
    fail_if(itimer_probe_us(old_base, 16) == 0);
    let message: []const u8 =
        bs"userspace itimer: ITIMER_REAL one-shot and interval SIGALRM, getitimer and old value, bad which and usec EINVAL, fork child unarmed, default SIGALRM ends a sleeper ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

// The half that needs this kernel's ext2 root and /proc: statfs reports
// ext2 (0xEF53, 1 KiB blocks, counts within each other) and procfs
// (0x9FA0), and openat and mkdirat apply the umask to the new inode's mode,
// as Linux's vfs_create and vfs_mkdir do.
fn statfs_umask_kernel_probe() !{unsafe} {
    let mut fs: [u8; 120];
    let fs_base: *u8 = fs as *u8;
    for index: usize in 0..<120 { fs[index] = 0; }
    fail_if(svc5(STATFS_SYSCALL, "/" as *u8 as usize, ptr_of(fs_base, 0), 0, 0, 0) != 0);
    fail_if(payload_read_u64(fs_base, 0) != 0xEF53);
    fail_if(payload_read_u64(fs_base, 8) != 1024);
    fail_if(payload_read_u64(fs_base, 16) == 0);
    fail_if(payload_read_u64(fs_base, 24) > payload_read_u64(fs_base, 16));
    fail_if(payload_read_u64(fs_base, 48) > payload_read_u64(fs_base, 40));
    fail_if(payload_read_u64(fs_base, 64) != 255);
    fail_if(payload_read_u64(fs_base, 72) != 1024);
    fail_if(svc5(STATFS_SYSCALL, "/proc" as *u8 as usize, ptr_of(fs_base, 0), 0, 0, 0) != 0);
    fail_if(payload_read_u64(fs_base, 0) != 0x9FA0);

    fail_if(svc5(UMASK_SYSCALL, 0x3F, 0, 0, 0, 0) != 0x12);
    let file: usize = svc5(56, 0xFFFFFFFFFFFFFF9C, "/umask-file" as *u8 as usize,
                           O_CREAT_EXCL_RDWR, 0x1B6, 0);
    fail_if(file >= 64);
    fail_if(svc5(57, file, 0, 0, 0, 0) != 0);
    fail_if(svc5(34, 0xFFFFFFFFFFFFFF9C, "/umask-dir" as *u8 as usize, 0x1FF, 0, 0) != 0);
    let mut stat: [u8; 128];
    let stat_base: *u8 = stat as *u8;
    fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, "/umask-file" as *u8 as usize,
                 ptr_of(stat_base, 0), 0, 0) != 0);
    fail_if((payload_read_u64(stat_base, 16) & 0xFFFFFFFF) != 0x8180);
    fail_if(svc5(79, 0xFFFFFFFFFFFFFF9C, "/umask-dir" as *u8 as usize,
                 ptr_of(stat_base, 0), 0, 0) != 0);
    fail_if((payload_read_u64(stat_base, 16) & 0xFFFFFFFF) != 0x41C0);
    fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, "/umask-file" as *u8 as usize, 0, 0, 0) != 0);
    fail_if(svc5(35, 0xFFFFFFFFFFFFFF9C, "/umask-dir" as *u8 as usize, 0x200, 0, 0) != 0);
    fail_if(svc5(UMASK_SYSCALL, 0x12, 0, 0, 0, 0) != 0x3F);
    let message: []const u8 =
        bs"userspace statfs and umask: ext2 0xEF53 and procfs 0x9FA0, umask 077 gives 0600 and 0700 ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

// Fork a child that exits with `code`, or kills itself with SIGTERM when
// `code` is 0. Returns the child's pid in the parent.
fn sigchld_probe_child(code: usize) -> usize !{unsafe} {
    let pid: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (pid == 0) {
        if (code == 0) {
            svc5(129, svc5(172, 0, 0, 0, 0, 0), SIGTERM, 0, 0, 0);
            svc5(93, 99, 0, 0, 0, 0);
        }
        svc5(93, code, 0, 0, 0, 0);
    }
    fail_if(pid >= 0x8000000000000000);
    return pid;
}

// Block until `pid` is reaped. A handler run may interrupt the wait.
fn sigchld_probe_reap(pid: usize) !{unsafe} {
    let mut reaped: usize = EINTR_RC;
    while (reaped == EINTR_RC) {
        reaped = svc5(260, pid, 0, 0, 0, 0);
    }
    fail_if(reaped != pid);
}

// The handler has run `runs` times in all, the last time with this siginfo.
// The getpid makes one more syscall return, where a pending handler runs.
fn sigchld_probe_expect(record_base: *u8, runs: usize, code: usize,
                        pid: usize, status: usize) !{unsafe} {
    svc5(172, 0, 0, 0, 0, 0);
    fail_if(payload_read_u64(record_base, 0) != runs);
    fail_if(payload_read_u64(record_base, 8) != SIGCHLD);
    fail_if(payload_read_u64(record_base, 16) != code);
    fail_if(payload_read_u64(record_base, 24) != pid);
    fail_if(payload_read_u64(record_base, 32) != status);
}

fn fail_halt() !{unsafe} {
    let message: []const u8 = bs"userspace syscall fixture: failed\n";
    svc5(64, 2, (unsafe { message as *u8 }) as usize, message.len, 0, 0);
    svc5(93, 1, 0, 0, 0, 0);
    // The exit syscall cannot return; retain a visible fail-stop if it does.
    while (true) {
    }
}

/* GitHub issue #1176: per-process credentials. Every process was uid 0,
 * and stress-ng's exec stressor refuses root. A fork child drops to a
 * non-root uid and gid (1000 when it starts as root, as on Takibi; its own
 * ids when it does not, as under qemu-aarch64 on an unprivileged host), then
 * checks what Linux lets a non-root process do: getresuid/getresgid agree
 * with getuid/geteuid/getgid/getegid, -1 keeps an id, its own ids are
 * allowed and others EPERM, setuid(-1) EINVAL, setgroups EPERM, a bad
 * pointer EFAULT, a fork grandchild inherits the ids, and an unknown
 * socket family is EAFNOSUPPORT (what su's /etc lookups need). Root may change
 * freely: the drop itself is that case. The child exits with the number of
 * the first check that fails. `credentials_probe_alone` runs under
 * qemu-aarch64 in `make linuxcheck` against this line of the linux_file
 * view. */
const SETGID_SYSCALL: usize = 144;
const SETUID_SYSCALL: usize = 146;
const SETRESUID_SYSCALL: usize = 147;
const GETRESUID_SYSCALL: usize = 148;
const SETRESGID_SYSCALL: usize = 149;
const GETRESGID_SYSCALL: usize = 150;
const SETGROUPS_SYSCALL: usize = 159;
const ID_KEEP: usize = 0xFFFFFFFF;
const CREDENTIALS_DROP_ID: usize = 1000;
const EAFNOSUPPORT_RC: usize = 0xFFFFFFFFFFFFFF9F;

fn credentials_probe_alone() !{unsafe} {
    credentials_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

// getresgid (group) or getresuid into three 8-byte cells; true when the call
// returned 0 and all three equal `want`.
fn credentials_probe_res(group: bool, base: *u8, want: usize) -> bool !{unsafe} {
    for cell: usize in 0..<3 { payload_write_u64(base, cell * 8, 0xFFFFFFFFFFFFFFFF); }
    let mut answer: usize = 0;
    if (group) {
        answer = svc5(GETRESGID_SYSCALL, ptr_of(base, 0), ptr_of(base, 8), ptr_of(base, 16), 0, 0);
    } else {
        answer = svc5(GETRESUID_SYSCALL, ptr_of(base, 0), ptr_of(base, 8), ptr_of(base, 16), 0, 0);
    }
    if (answer != 0) { return false; }
    for cell: usize in 0..<3 {
        if ((payload_read_u64(base, cell * 8) & 0xFFFFFFFF) != want) { return false; }
    }
    return true;
}

fn credentials_probe_child() -> usize !{unsafe} {
    let mut ids: [u8; 24];
    let ids_base: *u8 = ids as *u8;
    let mut uid: usize = svc5(174, 0, 0, 0, 0, 0);
    let mut gid: usize = svc5(176, 0, 0, 0, 0, 0);
    if (svc5(175, 0, 0, 0, 0, 0) == 0) {
        // Root may change freely: the group first, as a dropping program must.
        if (svc5(SETRESGID_SYSCALL, CREDENTIALS_DROP_ID, CREDENTIALS_DROP_ID,
                 CREDENTIALS_DROP_ID, 0, 0) != 0) { return 1; }
        if (svc5(SETRESUID_SYSCALL, CREDENTIALS_DROP_ID, CREDENTIALS_DROP_ID,
                 CREDENTIALS_DROP_ID, 0, 0) != 0) { return 2; }
        uid = CREDENTIALS_DROP_ID;
        gid = CREDENTIALS_DROP_ID;
    }
    if (uid == 0) { return 3; }
    if (credentials_probe_res(false, ids_base, uid) == false) { return 4; }
    if (credentials_probe_res(true, ids_base, gid) == false) { return 5; }
    if (svc5(174, 0, 0, 0, 0, 0) != uid || svc5(175, 0, 0, 0, 0, 0) != uid) { return 6; }
    if (svc5(176, 0, 0, 0, 0, 0) != gid || svc5(177, 0, 0, 0, 0, 0) != gid) { return 7; }
    if (svc5(SETRESUID_SYSCALL, ID_KEEP, ID_KEEP, ID_KEEP, 0, 0) != 0) { return 8; }
    if (svc5(SETRESUID_SYSCALL, uid, uid, uid, 0, 0) != 0) { return 9; }
    if (svc5(SETRESUID_SYSCALL, 0, ID_KEEP, ID_KEEP, 0, 0) != EPERM_RC) { return 10; }
    if (svc5(SETRESUID_SYSCALL, ID_KEEP, uid + 1, ID_KEEP, 0, 0) != EPERM_RC) { return 11; }
    if (svc5(SETRESGID_SYSCALL, ID_KEEP, gid, ID_KEEP, 0, 0) != 0) { return 12; }
    if (svc5(SETRESGID_SYSCALL, ID_KEEP, ID_KEEP, 0, 0, 0) != EPERM_RC) { return 13; }
    if (svc5(SETUID_SYSCALL, uid, 0, 0, 0, 0) != 0) { return 14; }
    if (svc5(SETUID_SYSCALL, 0, 0, 0, 0, 0) != EPERM_RC) { return 15; }
    if (svc5(SETUID_SYSCALL, ID_KEEP, 0, 0, 0, 0) != EINVAL_RC) { return 16; }
    if (svc5(SETGID_SYSCALL, gid, 0, 0, 0, 0) != 0) { return 17; }
    if (svc5(SETGID_SYSCALL, 0, 0, 0, 0, 0) != EPERM_RC) { return 18; }
    if (svc5(SETGROUPS_SYSCALL, 0, 0, 0, 0, 0) != EPERM_RC) { return 19; }
    if (svc5(GETRESUID_SYSCALL, 1, ptr_of(ids_base, 8), ptr_of(ids_base, 16), 0, 0)
            != EFAULT_RC) { return 20; }
    // The refusals changed nothing.
    if (credentials_probe_res(false, ids_base, uid) == false) { return 21; }
    // A fork grandchild inherits the ids.
    let grandchild: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (grandchild == 0) {
        let mut code: usize = 1;
        if (svc5(175, 0, 0, 0, 0, 0) == uid && svc5(177, 0, 0, 0, 0, 0) == gid) { code = 0; }
        svc5(93, code, 0, 0, 0, 0);
    }
    if (grandchild >= 0x8000000000000000) { return 22; }
    payload_write_u64(ids_base, 0, 0xFF);
    if (svc5(260, grandchild, ptr_of(ids_base, 0), 0, 0, 0) != grandchild) { return 23; }
    if ((payload_read_u64(ids_base, 0) & 0xFFFFFFFF) != 0) { return 24; }
    // An unknown socket family is EAFNOSUPPORT: musl's getpwnam and
    // initgroups read /etc only after that answer from their nscd socket,
    // and BusyBox su failed on EINVAL. (AF_UNIX itself exists on Linux.)
    if (svc5(198, 255, 1, 0, 0, 0) != EAFNOSUPPORT_RC) { return 25; }
    return 0;
}

fn credentials_probe() !{unsafe} {
    let child: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (child == 0) {
        svc5(93, credentials_probe_child(), 0, 0, 0, 0);
    }
    fail_if(child >= 0x8000000000000000);
    let mut status: [u8; 8];
    let status_base: *u8 = status as *u8;
    payload_write_u64(status_base, 0, 0xFF);
    fail_if(svc5(260, child, ptr_of(status_base, 0), 0, 0, 0) != child);
    // The parent keeps its own ids.
    let mut ids: [u8; 24];
    let ids_base: *u8 = ids as *u8;
    fail_if(credentials_probe_res(false, ids_base,
                                  svc5(174, 0, 0, 0, 0, 0)) == false);
    let mut message: []const u8 =
        bs"userspace credentials: a non-root child gets EPERM for other ids, EINVAL for setuid(-1), EFAULT, and its ids across fork, unknown socket family EAFNOSUPPORT ok\n";
    if ((payload_read_u64(status_base, 0) & 0xFFFF) != 0) {
        message = bs"userspace credentials: FAILED, the child's exit status names the check\n";
    }
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

/* GitHub issue #999: signal conformance rows whose expected values are
 * Linux's. `signal_conformance_probe_alone` is the same code as its own
 * static-PIE entry, which `make linuxcheck` runs under qemu-aarch64 on the
 * host and compares with this line of the linux_file view, so an
 * expectation written by hand from the kernel's behaviour fails there.
 * Rows: the wait4 status word of a signal-killed child (#882); a
 * terminating signal ends a child spinning without syscalls (#949);
 * ppoll(nfds 0, no timeout) sleeps until a handler runs, then EINTR (#870);
 * a pipe read interrupted by a handler is EINTR without SA_RESTART and
 * restarts with it (#726). The SIGCHLD siginfo rows (#885, #894) stay in
 * sigchld_siginfo_probe: under qemu-aarch64 its kill-sent case fails, a
 * word the Linux kernel zeroes (siginfo offset 24 for SI_USER, checked on
 * the x86-64 host) apparently not zeroed by qemu's siginfo translation, so
 * qemu user mode is not a faithful oracle for that row. */
const SA_RESTART: usize = 0x10000000;
const PPOLL_SYSCALL: usize = 73;

fn signal_conformance_probe_alone() !{unsafe} {
    signal_conformance_probe();
    svc5(93, 0, 0, 0, 0, 0);
}

// SIGALRM to the counting handler, with or without SA_RESTART.
fn signal_conformance_alarm_action(flags: usize) !{unsafe} {
    let mut action: [u8; 32];
    let action_base: *u8 = action as *u8;
    payload_write_u64(action_base, 0, sigchld_probe_handler_address());
    payload_write_u64(action_base, 8, SA_SIGINFO | SA_RESTORER | flags);
    payload_write_u64(action_base, 16, sigchld_probe_restorer_address());
    payload_write_u64(action_base, 24, 0);
    fail_if(svc5(134, SIGALRM, ptr_of(action_base, 0), 0, 8, 0) != 0);
}

// A one-shot ITIMER_REAL of `us` microseconds.
fn signal_conformance_alarm(us: usize) !{unsafe} {
    let mut value: [u8; 32];
    let value_base: *u8 = value as *u8;
    itimer_probe_store(value_base, 0, us);
    fail_if(svc5(ITIMER_SET_SYSCALL, ITIMER_WHICH_REAL, ptr_of(value_base, 0),
                 0, 0, 0) != 0);
}

// wait4 for `pid`, retried across handler runs; returns the status word.
fn signal_conformance_status(pid: usize) -> usize !{unsafe} {
    let mut status: [u8; 8];
    let status_base: *u8 = status as *u8;
    payload_write_u64(status_base, 0, 0);
    let mut reaped: usize = EINTR_RC;
    while (reaped == EINTR_RC) {
        reaped = svc5(260, pid, ptr_of(status_base, 0), 0, 0, 0);
    }
    fail_if(reaped != pid);
    return payload_read_u64(status_base, 0) & 0xFFFFFFFF;
}

fn signal_conformance_probe() !{unsafe} {
    let mut record: [u8; 40];
    let record_base: *u8 = record as *u8;
    for index: usize in 0..<40 { record[index] = 0; }
    sigchld_probe_arm(ptr_of(record_base, 0));

    // #882: a child killed by SIGTERM has status SIGTERM, no 128 offset and
    // no core bit.
    let killed: usize = sigchld_probe_child(0);
    fail_if(signal_conformance_status(killed) != SIGTERM);

    // #949: a child spinning in user mode, never entering the kernel, is
    // ended by a terminating signal at its next return to user.
    let spinner: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (spinner == 0) {
        let spinning: bool = true;
        while (spinning) { busy_spin(1000000); }
        svc5(93, 98, 0, 0, 0, 0);
    }
    fail_if(spinner >= 0x8000000000000000);
    fail_if(svc5(129, spinner, SIGTERM, 0, 0, 0) != 0);
    fail_if(signal_conformance_status(spinner) != SIGTERM);

    // #870: ppoll with no descriptors and no timeout sleeps as pause()
    // does; the alarm's handler runs, then it answers EINTR.
    signal_conformance_alarm_action(0);
    signal_conformance_alarm(20000);
    fail_if(svc5(PPOLL_SYSCALL, 0, 0, 0, 0, 8) != EINTR_RC);
    fail_if(payload_read_u64(record_base, 0) != 1);
    fail_if(payload_read_u64(record_base, 8) != SIGALRM);

    // #726: a read of an empty pipe is EINTR after a handler without
    // SA_RESTART, and restarts (and reads what a child writes later) with it.
    let mut fds: [u8; 8];
    let fds_base: *u8 = fds as *u8;
    fail_if(svc5(59, ptr_of(fds_base, 0), 0, 0, 0, 0) != 0);
    let read_fd: usize = payload_read_u64(fds_base, 0) & 0xFFFFFFFF;
    let write_fd: usize = payload_read_u64(fds_base, 0) >> 32;
    let mut byte: [u8; 1];
    signal_conformance_alarm(20000);
    fail_if(svc5(63, read_fd, byte as *u8 as usize, 1, 0, 0) != EINTR_RC);
    fail_if(payload_read_u64(record_base, 0) != 2);
    signal_conformance_alarm_action(SA_RESTART);
    let writer: usize = svc5(220, SIGCHLD, 0, 0, 0, 0);
    if (writer == 0) {
        let mut pause: [u8; 16];
        let pause_base: *u8 = pause as *u8;
        payload_write_u64(pause_base, 0, 0);
        payload_write_u64(pause_base, 8, 200000000);
        svc5(101, ptr_of(pause_base, 0), 0, 0, 0, 0);
        let one: []const u8 = bs"r";
        svc5(64, write_fd, (unsafe { one as *u8 }) as usize, 1, 0, 0);
        svc5(93, 0, 0, 0, 0, 0);
    }
    fail_if(writer >= 0x8000000000000000);
    signal_conformance_alarm(20000);
    fail_if(svc5(63, read_fd, byte as *u8 as usize, 1, 0, 0) != 1);
    fail_if(byte[0] != 0x72);
    fail_if(payload_read_u64(record_base, 0) != 3);
    fail_if(signal_conformance_status(writer) != 0);
    fail_if(svc5(57, read_fd, 0, 0, 0, 0) != 0);
    fail_if(svc5(57, write_fd, 0, 0, 0, 0) != 0);

    let mut action: [u8; 32];
    let action_base: *u8 = action as *u8;
    for index: usize in 0..<32 { action[index] = 0; }
    fail_if(svc5(134, SIGALRM, ptr_of(action_base, 0), 0, 8, 0) != 0);
    let message: []const u8 =
        bs"userspace signal conformance: wait4 killed status, spinning child killed, ppoll pause EINTR, pipe read EINTR and SA_RESTART ok\n";
    fail_if(svc5(64, 1, (unsafe { message as *u8 }) as usize,
                 message.len, 0, 0) != message.len);
}

fn fail_if(bad: bool) {
    if (bad) {
        fail_halt();
    }
}

fn ptr_of(base: *u8, offset: usize) -> usize {
    return (base + (offset as isize)) as usize;
}

/* struct rlimit64's little-endian u64s, byte at a time. See the
 * prlimit64 block above for why not a pointer cast. */
fn payload_read_u64(base: *u8, offset: usize) -> usize {
    let mut value: usize = 0;
    for i: usize in 0..<8 {
        value = value | ((base[(offset + i) as isize] as usize) << (i * 8));
    }
    return value;
}

fn payload_write_u64(base: *u8, offset: usize, value: usize) {
    for i: usize in 0..<8 {
        base[(offset + i) as isize] = ((value >> (i * 8)) & 0xFF) as u8;
    }
}
