/* GitHub issue #228: the EL0 syscall-ABI test payload that used to be
 * hand-written AArch64 assembly in user_entry.S. Only the two register-level
 * scheduler-preemption probes remain in raw asm (user_payload_asm.S), since
 * they deliberately pin physical registers (x19-x23, q8) that an ordinary
 * .tkb-compiled loop has no way to guarantee live across the busy-wait --
 * the whole point of the probe is to confirm the kernel's context-switch
 * save/restore path, not whatever registers the compiler happens to pick.
 * Everything else here is ordinary syscall policy, so it lives in Takibi.
 *
 * This file is compiled standalone (with user_payload_asm.S) into a real
 * static-PIE ELF (GitHub issue #241; previously a flat position-independent
 * blob via a dedicated linker script, objcopied to raw bytes and embedded
 * into the kernel image directly), placed in the ext2 fixture image as
 * /bin/user_payload, and launched from kernel/tests/ext2/init.sh like any
 * other external command -- see the Makefile's KERNEL_RPI5_USER_PAYLOAD_ELF
 * rule and KERNEL_EXT2_IMAGE's e2cp step.
 */

extern fn scheduler_probe_run(asid_va: usize, asid_marker: usize,
                               simd_pattern: usize, busy_count: usize)
    -> usize;
extern fn busy_spin(count: usize);

const EBADF_RC: usize = 0xFFFFFFFFFFFFFFF7;
const EFAULT_RC: usize = 0xFFFFFFFFFFFFFFF2;
const LARGE_LEN: usize = 1461;
const SCHEDULER_CHILD_BUSY: usize = 0x0BEBC200;
const SCHEDULER_PARENT_BUSY: usize = 0x17D78400;
// GitHub issue #209: one polling slice of the parent's reap loop. Short
// enough that the loop reacts promptly once the child exits, long enough
// that the parent is genuinely busy (and therefore preemptible) between
// polls rather than hammering the syscall boundary.
const SCHEDULER_PARENT_POLL_BUSY: usize = 0x00989680;
const WAIT_POLL_MAX: usize = 10000;
const WNOHANG: usize = 1;

/* GitHub issue #241: the real ELF this file links into carries its own
 * e_entry (set via the linker's -e initial_user_payload), so unlike the
 * old flat-blob mechanism, nothing depends on this being the first
 * function in the file's .text section anymore. Named for `-e
 * initial_user_payload` on the link line regardless. */
fn initial_user_payload() {
    /* GitHub issue #241: this payload used to always be the very first
     * (pid 1) process the kernel created, so its own clone()'d child was
     * always exactly pid 2 -- now launched as an ordinary external command
     * from init.sh's ash, it runs at whatever pid its own fork under ash
     * received, so the child-pid check below is relative to that instead
     * of the literal 2 it used to be. */
    let my_pid: usize = svc5(172, 0, 0, 0, 0, 0);

    /* write(9, ..., 1) must return -EBADF. The length `1` is deliberately
     * NOT the literal's real length (22 bytes) -- fd 9 is invalid, so the
     * write never reaches a length check at all; this is not a candidate
     * for the []u8/.len migration GitHub issue #318 did elsewhere in this
     * file. */
    let user_message: *u8 = "hello from userspace\n" as *u8;
    fail_if(svc5(64, 9, user_message as usize, 1, 0, 0) != EBADF_RC);

    /* write(1, null, 1) must return -EFAULT. */
    fail_if(svc5(64, 1, 0, 1, 0, 0) != EFAULT_RC);

    /* openat/write/close /mutable.txt through the Linux file ABI. */
    let mutable_path: *u8 = "/mutable.txt" as *u8;
    let mutable_content: []u8 = "el0-ok\n" as []u8;
    let fd3: usize = svc5(56, 0, mutable_path as usize, 1, 0, 0);
    fail_if(fd3 != 3);
    fail_if(svc5(64, 3, (mutable_content as *u8) as usize, mutable_content.len, 0, 0) != 7);
    fail_if(svc5(57, 3, 0, 0, 0, 0) != 0);

    /* socket/bind/listen/close one IPv4 stream endpoint. */
    let mut socket_address: [u8; 16] = {
        0x02, 0x00, 0x1f, 0x90,
        0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00
    };
    let fd4: usize = svc5(198, 2, 1, 0, 0, 0);
    fail_if(fd4 != 4);
    fail_if(svc5(200, 4, (socket_address as *u8) as usize, 16, 0, 0) != 0);
    fail_if(svc5(201, 4, 1, 0, 0, 0) != 0);

    let fd5: usize = svc5(242, 4, 0, 0, 0, 0);
    fail_if(fd5 != 5);
    /* Issue #189: accept a second stream while fd 5 remains live. The
     * bounded fd/connection pools must allocate an independent fd 6/slot. */
    let fd6: usize = svc5(242, 4, 0, 0, 0, 0);
    fail_if(fd6 != 6);

    let connection_b_response: []u8 = "conn-B\n!" as []u8;
    let socket_response: []u8 = "HTTP/1.0 200 OK\r\n\r\n" as []u8;
    // GitHub issue #228 (found on real hardware), reconfirmed under the
    // real static-PIE ELF (issue #241): this buffer MUST be a local
    // (stack) variable, not a global. scripts/check_user_payload_no_rw_globals.py
    // enforces zero writable globals in this ELF at build time, so a
    // regression here is caught at compile time instead of as a runtime
    // hang; stack locals are always safe since they live in this process's
    // private, writable stack mapping.
    let mut user_payload_rx_buf: [u8; 8];
    let rx_base: *u8 = user_payload_rx_buf as *u8;

    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 8, 0, 0) != 8);
    fail_if(svc5(63, 6, ptr_of(rx_base, 0), 8, 0, 0) != 8);
    fail_if(svc5(64, 6, (connection_b_response as *u8) as usize, connection_b_response.len, 0, 0) != 8);
    fail_if(svc5(63, 5, ptr_of(rx_base, 0), 8, 0, 0) != 8);
    fail_if(svc5(64, 5, (socket_response as *u8) as usize, socket_response.len, 0, 0) != 19);

    // Same reasoning as user_payload_rx_buf above: must be a stack local.
    let mut user_payload_large_buf: [u8; LARGE_LEN];
    for i in 0..<LARGE_LEN {
        user_payload_large_buf[i] = 0x5a;
    }
    let large_base: *u8 = user_payload_large_buf as *u8;
    fail_if(svc5(64, 5, ptr_of(large_base, 0), LARGE_LEN, 0, 0) != 1460);
    fail_if(svc5(64, 5, ptr_of(large_base, 1460), 1, 0, 0) != 1);

    fail_if(svc5(57, 6, 0, 0, 0, 0) != 0);
    fail_if(svc5(57, 5, 0, 0, 0, 0) != 0);
    fail_if(svc5(57, 4, 0, 0, 0, 0) != 0);


    /* GitHub issue #241 hardware finding: SCHEDULER_PROBE_VA used to be
     * 0x40001000 (USER_DATA_VA), a page the old flat-blob mechanism's own
     * dedicated map_user_data() always reserved as rw+xn. Nothing pins
     * that specific address under the general ELF loader's own layout
     * (this real PIE ELF's PT_LOAD segments do not put anything writable
     * there), so a stack local taken here -- before the fork below --
     * takes its place: 0x11 requests plain fork semantics (no CLONE_VM),
     * so parent and child each get their own COW-copied page at this
     * same VA, exactly what the "private same-VA data" probe needs.
     */
    let mut scheduler_probe_slot: [u8; 8];
    let scheduler_probe_va: usize =
        (scheduler_probe_slot as *u8) as usize;

    /* The focused context fixture clones only after its independent socket
     * lifecycle is complete; the real HTTPd daemon covers fd inheritance. */
    let pid: usize = svc5(220, 0x11, 0, 0, 0, 0);
    if (pid == 0) {
        /* The first byte must take the scheduler-aware Blocked -> Ready
         * path. Later bytes may already be in the bounded RX ring when
         * selected. */
        let uart_fixture: []u8 = "irqtest\n" as []u8;
        for want_byte in uart_fixture {
            let c: usize = svc5(451, 0, 0, 0, 0, 0);
            fail_if(c != (want_byte as usize));
        }
        /* Scheduler acceptance: private same-VA data plus GPR and SIMD
         * signatures must survive involuntary timer preemption. */
        fail_if(scheduler_probe_run(scheduler_probe_va, 0x22, 0x5a,
                                     SCHEDULER_CHILD_BUSY) == 0);
        svc5(93, 42, 0, 0, 0, 0);
    } else {
        fail_if(pid != my_pid + 1);
        fail_if(scheduler_probe_run(scheduler_probe_va, 0x11, 0xa5,
                                     SCHEDULER_PARENT_BUSY) == 0);

        /* Accepted only if this parent reached the end of its compute
         * section while the child is still Blocked on UART RX. */
        fail_if(svc5(452, 0, 0, 0, 0, 0) != 0);

        /* GitHub issue #209: poll for the child with WNOHANG instead of
         * either spinning for a fixed count and hoping (the original) or
         * blocking outright in wait4.
         *
         * A fixed spin only PROBABLY outlasted the host's UART delivery,
         * so whether the child got to exit before this parent did depended
         * on how much unrelated work ran earlier in the boot -- and a
         * parent exit disables the scheduler (kernel/kernel/process.tkb's
         * kernel_process_child_exit), which leaves a still-blocked child
         * permanently unrunnable. Adding anything ahead of this fixture in
         * init.sh flipped that coin.
         *
         * A plain blocking wait4 fixes the ordering but destroys what this
         * fixture measures: with the parent Blocked, the child is the only
         * runnable process, so the timer never has two runnable processes
         * to alternate between and the preemption evidence disappears.
         *
         * Polling keeps this parent genuinely RUNNABLE and busy while the
         * child is runnable too -- which is exactly the alternating-timer
         * condition under test -- while still refusing to proceed until
         * the child has actually been reaped. */
        let mut reaped: usize = 0;
        let mut attempts: usize = 0;
        while (reaped != pid && attempts < WAIT_POLL_MAX) {
            busy_spin(SCHEDULER_PARENT_POLL_BUSY);
            reaped = svc5(260, 0xFFFFFFFFFFFFFFFF, 0, WNOHANG, 0, 0);
            attempts = attempts + 1;
        }
        fail_if(reaped != pid);

        /* Deliberately sends 21 of this literal's 22 real bytes, trimming
         * the trailing newline -- the length `21` intentionally does NOT
         * match the literal's real length, so this is not a candidate for
         * the []u8/.len migration GitHub issue #318 did elsewhere in this
         * file. */
        let user_message2: *u8 = "hello from userspace\n" as *u8;
        fail_if(svc5(64, 1, user_message2 as usize, 21, 0, 0) != 21);
        svc5(93, 0, 0, 0, 0, 0);
    }
}

fn fail_halt() {
    while (true) {
    }
}

fn fail_if(bad: bool) {
    if (bad) {
        fail_halt();
    }
}

fn ptr_of(base: *u8, offset: usize) -> usize {
    return (base + (offset as isize)) as usize;
}
