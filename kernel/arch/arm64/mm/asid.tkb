// GitHub issue #254 design conclusion (2026-08-09): ASID assignment must be
// independent of a page-table storage slot. A heap-owned page table has no
// slot from which to derive an ASID; this allocator gives it a matching
// lifetime.
//
// GitHub issue #402 removed the last fixed ceiling on process creation from
// this file, in the two halves that issue named.
//
// **The width is asked for, not assumed.** ID_AA64MMFR0_EL1.ASIDBits says
// whether the implementation has 8-bit or 16-bit ASIDs; both QEMU virt
// (Cortex-A53) and RPi5 (Cortex-A76) report 16, which is 65535 assignable
// numbers rather than the 255 the architectural floor guarantees.
// TCR_EL1.AS is set to match in kernel/arch/arm64/mm/mmu.tkb's
// kernel_mmu_activate, because the two have to agree or the hardware reads
// a different number of bits than the software writes.
//
// **A number is reclaimed by rolling over, not by being freed.** That is
// what makes exhaustion stop being a refusal: assignment is a counter, and
// when the counter passes the last number it advances a GENERATION,
// invalidates every TLB entry, and starts again at 1. An address space
// whose recorded generation is not the current one no longer owns its
// number -- it is given a fresh one the next time it is activated
// (kernel/mm/address_space.tkb's address_space_activate), which is the one
// place a root reaches TTBR0_EL1. So asid_assign() cannot fail, and no
// process is ever refused for want of an ASID.
//
// Why there is no free list any more, and no linear AsidOwner: a freed
// ASID used to be returned to a SlotMap so it could be handed out again.
// With a generation there is nothing to return -- an abandoned number is
// reclaimed in bulk at the next rollover -- so the obligation a linear
// owner existed to enforce does not exist. What replaced "give it back" is
// "outlive the generation", and what checks it is the generation stamp
// stored beside the number.
//
// Current limitations:
// - NOT SYNCHRONIZED. asid_next/asid_generation are plain globals and two
//   cores assigning at once could hand out the same number or miss a
//   rollover; what protects them today is that one core runs kernel code
//   (kernel/lib/execution_model.tkb's KERNEL_ACTIVE_CORES).
// - The ROLLOVER's reach is no longer part of that. GitHub issue #446
//   made mmu_tlb_invalidate_all() `tlbi vmalle1is`, so a rollover
//   invalidates every core in the shareability domain rather than only the
//   one that noticed the counter wrapped. A second core executing user
//   code with an ASID about to be reassigned therefore does NOT keep stale
//   entries -- the remaining single-core assumption is about the counter,
//   not about the TLB.
// - A number is not reused until the next rollover even if the address
//   space holding it dies immediately. Linux keeps a bitmap and reuses
//   freed numbers within a generation; here 65535 process creations
//   between two whole-TLB invalidations is cheap enough that the bitmap is
//   not worth its own state. What this costs is measured by
//   asid_rollover_count(), which the boot suite prints.
// - Nothing here ever invalidates by ASID on its own behalf. A rollover
//   invalidates everything; a page-table change invalidates through
//   kernel/mm/address_space.tkb, which still knows the number it recorded.

// The architectural floor: every AArch64 implementation has at least an
// 8-bit ASID field, so this is what the width query falls back to when it
// reports anything this file does not recognise.
use "kernel/lib/execution_model.tkb";

const ASID_BITS_FLOOR: usize = 8;

private let mut asid_bits: usize = ASID_BITS_FLOOR;
// The highest assignable number. ASID 0 is never assigned -- it is the
// value TTBR0_EL1 holds before any address space exists, and treating it
// as "no ASID" is what lets address_space.tkb test `asid != 0`.
private let mut asid_last: usize = 255;
private let mut asid_generation: usize = 1;
private let mut asid_next: usize = 1;
private let mut asid_rollover_count: usize = 0;
private let mut asid_assign_count: usize = 0;
private let mut asid_ready: bool = false;

// Called from kernel_mmu_init with the MMU OFF: an mrs and some
// arithmetic, no allocation, nothing that touches a page that is not
// mapped yet (see kernel/MEMORY_MAP.md's note on that window).
fn asid_init() {
    if (asid_ready) { return; }
    asid_ready = true;
    asid_bits = mmu_asid_bits();
    // 1 << 16 is 65536 numbers, of which 65535 are assignable.
    asid_last = (1 << asid_bits) - 1;
    asid_generation = 1;
    asid_next = 1;
}

fn asid_width_bits() -> usize {
    return asid_bits;
}

fn asid_highest_value() -> usize {
    return asid_last;
}

fn asid_current_generation() -> usize {
    return asid_generation;
}

fn asid_rollover_count_value() -> usize {
    return asid_rollover_count;
}

fn asid_assign_count_value() -> usize {
    return asid_assign_count;
}

// Does this recorded stamp still name the generation the hardware's TLB is
// tagged for? A stamp of 0 is "never assigned" and is never current.
fn asid_generation_is_current(generation: usize) -> bool {
    if (generation == 0) { return false; }
    return generation == asid_generation;
}

// The whole cost of the scheme, in one place. Every number is about to be
// handed out again, so every entry tagged with one has to go.
private fn asid_rollover() {
    asid_generation = asid_generation + 1;
    asid_next = 1;
    asid_rollover_count = asid_rollover_count + 1;
    mmu_tlb_invalidate_all();
}

// (asid, generation). Cannot fail: the caller that used to have to handle
// AsidAllocResult::Full has nothing left to handle, which is the point of
// issue #402.
//
// **Call this only when switching to the address space that will hold the
// result.** A rollover hands the numbers of every live address space to
// somebody else, which is safe exactly because none of them is executing:
// the one that was is the one being switched away from, and the one that
// will be is the one taking the number this returns. Assigning at
// CREATION time instead would roll over underneath a running address
// space and alias its TLB entries with the new one's -- which is why a
// new root is created with no ASID at all and gets one at its first
// activation, the same lifetime Linux gives an mm.
fn asid_assign() -> (usize, usize) {
    if (asid_next > asid_last) { asid_rollover(); }
    let value: usize = asid_next;
    asid_next = asid_next + 1;
    asid_assign_count = asid_assign_count + 1;
    return (value, asid_generation);
}

// GitHub issue #453. The rollover invalidates the LOCAL TLB (`tlbi
// vmalle1`), so a second core executing user code with an ASID about to be
// reassigned keeps stale entries -- this file's header states exactly
// that. GitHub issue #446 makes the invalidation a broadcast; until it
// lands, this is the assertion that notices.
fn asid_execution_model_assumption() {
    static_assert(KERNEL_ACTIVE_CORES == 1,
                  "the rollover invalidates the LOCAL TLB, so another core keeps stale entries -- see issue #446");
}
