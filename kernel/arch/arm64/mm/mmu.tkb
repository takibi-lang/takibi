// The architecture layer operates only on resolved physical addresses and
// hardware ASIDs. Address-space lifetime, including the temporary slot-keyed
// backing table, belongs to kernel/mm/address_space.tkb above this layer.

const MMU_TABLE_ENTRY_COUNT: usize = 512;

// GitHub issue #231: AP[2:1]=00 on a block/page descriptor denies EL0 data
// access but says nothing about EL0 instruction fetch. UXN/PXN remain
// independent permission bits for the kernel identity and device mappings.
const UXN_BIT: usize = 0x40000000000000;
const PXN_BIT: usize = 0x20000000000000;

private fn mmu_table_entry_write(base: usize, index: usize, value: usize) !{unsafe} {
    // `base` is a resolved physical page-table address.  The architecture
    // boundary, rather than ordinary memory, establishes that it is mapped.
    let entry: *usize = unsafe { (base + index * 8) as *usize };
    *entry = value;
}

private fn mmu_table_entry_read(base: usize, index: usize) -> usize !{unsafe} {
    // See mmu_table_entry_write: this is a physical page-table trust root.
    let entry: *usize = unsafe { (base + index * 8) as *usize };
    return *entry;
}

// Platform mmu_layout.tkb files use this name to populate their selected
// device L1 entries. Its first argument is the resolved L1 physical address,
// never an address-space slot.
fn init_root_entry(base: usize, index: usize, value: usize) {
    mmu_table_entry_write(base, index, value);
}

private fn mmu_table_clear(base: usize) {
    for i: usize in 0..<MMU_TABLE_ENTRY_COUNT {
        mmu_table_entry_write(base, i, 0);
    }
}

fn mmu_pte_read(l3_physical: usize, index: usize) -> usize {
    return mmu_table_entry_read(l3_physical, index);
}

fn mmu_tlb_invalidate(asid: usize, va: usize) {
    dsb_ishst();
    tlbi_vae1is((asid << 48) | (va >> 12));
    dsb_ish();
    isb();
}

// Replace one last-level descriptor using Arm's break-before-make sequence.
// A live descriptor is first made invalid and made globally unobservable
// before a replacement is installed. The same completed break is also the
// lifetime boundary for an unmap: its physical page may be released only
// after this function returns.
//
// ASID 0 names a root which has never been activated, so no PE can have a
// cached translation for it. Such a root still takes the break store and
// barriers, but has no translation to invalidate.
fn mmu_pte_update(l3_physical: usize, index: usize, value: usize,
                  asid: usize, va: usize) {
    let old: usize = mmu_table_entry_read(l3_physical, index);
    if (old == value) { return; }
    if (old != 0) {
        mmu_table_entry_write(l3_physical, index, 0);
        if (asid != 0) {
            mmu_tlb_invalidate(asid, va);
        } else {
            dsb_ishst();
        }
    }
    if (value != 0) {
        mmu_table_entry_write(l3_physical, index, value);
        dsb_ishst();
    }
}

fn mmu_clear_user_table(l3_physical: usize) {
    mmu_table_clear(l3_physical);
}

fn mmu_user_l3_physical(l2_physical: usize, l2_index: usize) -> usize {
    let entry: usize = mmu_table_entry_read(l2_physical, l2_index);
    if ((entry & 3) != 3) { return 0; }
    return entry & 0x0000FFFFFFFFF000;
}

// All allocation and lifetime decisions stay above this architecture layer.
// These operations only construct and dismantle resolved physical links.
fn mmu_user_l3_install(l2_physical: usize, l2_index: usize,
                       l3_physical: usize) {
    mmu_table_clear(l3_physical);
    mmu_table_entry_write(l2_physical, l2_index, l3_physical | 3);
    dsb_ishst();
}

fn mmu_user_l3_remove(l2_physical: usize, l2_index: usize) {
    mmu_table_entry_write(l2_physical, l2_index, 0);
    dsb_ishst();
}

fn mmu_tlb_invalidate_asid(asid: usize) {
    tlbi_aside1is(asid << 48);
    dsb_ish();
    isb();
}

// GitHub issue #402: every entry, whatever it is tagged with. This is what
// an ASID rollover costs, and the reason a rollover is rare rather than
// forbidden.
//
// GitHub issue #446: the Inner Shareable form, so it reaches every core in
// the domain and not just this one. A rollover hands every live number to
// somebody else; a core that kept entries tagged with the old ones would
// read another address space's memory with no fault to show for it. The
// per-page and per-ASID maintenance above was already broadcast -- this was
// the one operation still local, and it is the one with the widest blast
// radius when it is wrong.
//
// This is the only whole-TLB invalidate that is maintenance on somebody
// else's behalf. kernel_mmu_activate's is not, and stays local; see there.
fn mmu_tlb_invalidate_all() {
    dsb_ishst();
    tlbi_vmalle1is();
    dsb_ish();
    isb();
}

// GitHub issue #402: ID_AA64MMFR0_EL1.ASIDBits, field [7:4]. 0b0000 says
// the implementation has 8-bit ASIDs and 0b0010 says 16-bit; the field has
// no other defined value, and anything else is read as the architectural
// floor rather than believed. Both targets this kernel runs on report 16
// (Cortex-A53 and Cortex-A76), which is why the number that replaced
// ASID_MAX = 255 is 65535.
fn mmu_asid_bits() -> usize {
    let field: usize = (mrs_id_aa64mmfr0_el1() >> 4) & 0xF;
    if (field == 2) { return 16; }
    return 8;
}

// GitHub issue #237: the layout constants and device blocks are supplied by
// the selected platform mmu_layout.tkb. This function is deliberately a
// pure construction operation over its two fixed resolved backing pages.
// User L3 pages are installed by address_space.tkb when a branch first
// receives a mapping.
fn init_root(l1_physical: usize, l2_physical: usize) {
    mmu_table_entry_write(
        l1_physical, KERNEL_IDENTITY_L1_INDEX,
        kernel_identity_l2_table | 3);
    mmu_table_entry_write(l1_physical, USER_TEXT_VA >> 30,
                          l2_physical | 3);
    platform_mmu_init_device_blocks(l1_physical);
}

// GitHub issue #1032: the kernel identity GiB is no longer one W+X block.
// SCTLR_EL1.WXN (kernel_mmu_activate) makes every writable page
// execute-never, so the kernel text must be mapped read-only to stay
// executable, and everything else in the GiB is writable and therefore
// execute-never at both ELs -- PXN is set explicitly rather than left to WXN,
// so the mapping says what it is even with WXN clear.
//
// One shared L2 page splits the GiB into 2 MiB blocks; the block holding the
// text is split again by one shared L3 page. Both pages are linker-reserved
// in .bss (link.ld, link_qemu.ld), which also asserts that the text starts
// 2 MiB-aligned and fits in one 2 MiB block, so one L3 page covers all of
// it. Every root's L1 points at the same L2 (init_root): the identity is a
// kernel fact, not a per-process one. Built once, MMU off, before the first
// root (address_space_allocate_boot_root).
//
// Descriptor low bits: 0x705 is a 2 MiB block, 0x707 a 4 KiB page, both
// Normal WB (AttrIndx 1), inner shareable, AF set, AP[2:1]=00 (EL1 RW, no
// EL0 access). 0x787 sets AP[2] (EL1 read-only). Bit 54 is UXN, bit 53
// PXN (UXN_BIT, PXN_BIT).
extern symbol kernel_identity_l2_table;
extern symbol kernel_identity_l3_table;
// kernel_text_start and kernel_text_end are declared in
// kernel/arch/arm64/kernel/exception_evidence.tkb.

const KERNEL_BLOCK_RW_XN: usize = 0x0060000000000705;
const KERNEL_PAGE_RW_XN: usize = 0x0060000000000707;
const KERNEL_PAGE_TEXT_RX: usize = 0x0040000000000787;

// GitHub issue #1032 point 5 (maintainer D1 (a), D2 (i)): the static
// stacks' guard pages. Every stack in the linker's .stack block is one
// KERNEL_STACK_RUN_BYTES-aligned run whose lower half is reserved and
// poisoned; the lowest page of that half is left unmapped, so a write that
// runs 12 KiB past a stack's bottom without taking an exception faults
// instead of reaching the run below. An exception taken there finds SP's
// bit KERNEL_STACK_SHIFT clear and the generated entry moves to
// overflow_stack_top and names the stack (#377). Process stacks (page-pool
// runs) are not guarded here (#1226). The linker scripts assert that the
// block is whole runs and under 2 MiB, so at most two 2 MiB blocks hold
// it; each gets an L3 page from kernel_identity_stack_l3_tables unless it
// is the text block, whose L3 page already exists.
extern symbol kernel_identity_stack_l3_tables;
extern symbol percpu_stack_end;
const KERNEL_STATIC_STACK_RUN_BYTES: usize = 0x8000;
const KERNEL_STACK_GUARD_BYTES: usize = 4096;

// Whether a physical page of the identity is a static stack's guard.
fn mmu_identity_page_is_stack_guard(pa: usize) -> bool {
    let low: usize = boot_stack_run_bottom;
    let high: usize = percpu_stack_end;
    return pa >= low && pa < high
        && (pa - low) % KERNEL_STATIC_STACK_RUN_BYTES == 0;
}

// One L3 page for the 2 MiB block at block_base: text pages read-only and
// executable, guard pages invalid, everything else RW execute-never.
fn mmu_init_identity_l3(l3: usize, block_base: usize) {
    for i: usize in 0..<MMU_TABLE_ENTRY_COUNT {
        let pa: usize = block_base + (i << 12);
        // [kernel_text_start, kernel_text_end) rounded out to whole pages;
        // .rodata starts on the next page boundary (ALIGN(4096)), so the
        // last text page holds no data.
        if (pa >= kernel_text_start && pa < kernel_text_end) {
            mmu_table_entry_write(l3, i, pa | KERNEL_PAGE_TEXT_RX);
        } else if (mmu_identity_page_is_stack_guard(pa)) {
            mmu_table_entry_write(l3, i, 0);
        } else {
            mmu_table_entry_write(l3, i, pa | KERNEL_PAGE_RW_XN);
        }
    }
}

fn mmu_init_kernel_identity_tables() {
    let gib_base: usize = KERNEL_IDENTITY_L1_INDEX << 30;
    let text_block: usize = (kernel_text_start - gib_base) >> 21;
    let stack_first: usize = (boot_stack_run_bottom - gib_base) >> 21;
    let stack_last: usize = (percpu_stack_end - 1 - gib_base) >> 21;
    let mut stack_tables: usize = 0;
    for i: usize in 0..<MMU_TABLE_ENTRY_COUNT {
        let block_base: usize = gib_base + (i << 21);
        if (i == text_block) {
            mmu_init_identity_l3(kernel_identity_l3_table, block_base);
            mmu_table_entry_write(kernel_identity_l2_table, i,
                                  kernel_identity_l3_table | 3);
        } else if (i >= stack_first && i <= stack_last && stack_tables < 2) {
            let l3: usize = kernel_identity_stack_l3_tables + (stack_tables << 12);
            stack_tables = stack_tables + 1;
            mmu_init_identity_l3(l3, block_base);
            mmu_table_entry_write(kernel_identity_l2_table, i, l3 | 3);
        } else {
            mmu_table_entry_write(kernel_identity_l2_table, i,
                                  block_base | KERNEL_BLOCK_RW_XN);
        }
    }
    dsb_ishst();
}

// A reused physical page contains arbitrary old page-table contents, unlike
// the old growable pools' zero-on-grow pages. Clear the fixed L1/L2 backing
// before publishing the root; lazily allocated L3 pages are cleared by
// mmu_user_l3_install before their L2 descriptor becomes visible.
fn mmu_init_root(l1_physical: usize, l2_physical: usize) {
    mmu_table_clear(l1_physical);
    mmu_table_clear(l2_physical);
    init_root(l1_physical, l2_physical);
    dsb_ishst();
}

// A normal process switch only changes TTBR0_EL1. The full MAIR/TCR/SCTLR
// enable sequence below is reserved for the primary and secondary boot
// paths, which both pass their already-resolved bootstrap root explicitly.
fn mmu_activate_root(l1_physical: usize, asid: usize) {
    let ttbr: usize = l1_physical | (asid << 48);
    dsb_ish();
    msr_ttbr0_el1(ttbr);
    isb();
}

fn kernel_mmu_activate(l1_physical: usize, asid: usize) {
    // Attr0 Device-nGnRnE; Attr1 Normal WB RA/WA.
    msr_mair_el1(0xff00);

    // 37-bit VA, 40-bit PA, 4KB granule, WB inner-shareable walks, TTBR1
    // disabled.
    let mut tcr: usize = 0x351b | (1 << 23) | (2 << 32);
    // GitHub issue #402: TCR_EL1.AS (bit 36) selects how many of
    // TTBR0_EL1[63:48] the hardware reads as the ASID. It has to agree with
    // what kernel/arch/arm64/mm/asid.tkb hands out, or the software counts
    // in 16 bits while the hardware compares 8 and two address spaces
    // silently share a tag.
    if (mmu_asid_bits() == 16) { tcr = tcr | (1 << 36); }
    msr_tcr_el1(tcr);

    mmu_activate_root(l1_physical, asid);
    // GitHub issue #446: LOCAL, deliberately, and the one place in this
    // file that stays that way. A core turning its own MMU on is discarding
    // whatever its own TLB holds from before there was a translation
    // regime; it is not maintenance any other core needs to see, and each
    // core runs this once from its own entry path. Broadcasting it would
    // make every core pay for one core's boot. mmu_tlb_invalidate_all is
    // the opposite case and is `tlbi vmalle1is`.
    tlbi_vmalle1();
    dsb_ish();
    isb();

    let sctlr: usize = mrs_sctlr_el1();
    // The compiler guarantees each scalar access's natural alignment, but
    // LLVM may combine adjacent accesses into a pair/vector instruction at
    // an address aligned only for the scalar elements. Normal memory permits
    // that when SCTLR_EL1.A (bit 1) is clear, so clearing A is the kernel's
    // explicit post-MMU contract and is checked in the linked disassembly.
    // Before M becomes active all data is Device memory, whose stricter
    // alignment applies regardless of A; pre-MMU aggregate storage therefore
    // keeps exact final-ELF alignment guards such as boot_page_pool's.
    // GitHub issue #1032: WXN (bit 19) makes every writable mapping
    // execute-never at EL1 and EL0, so "write code, then jump to it" faults
    // whatever a descriptor says. The kernel identity is split so its text
    // is read-only (mmu_init_kernel_identity_tables).
    //
    // The A mask is spelled with a usize operand: `~(1 << 1)` alone was
    // lowered as a 32-bit complement and zero-extended, which cleared
    // SCTLR_EL1[63:32] on every boot (found with #1032).
    // GitHub issue #1032: SPAN (bit 23) clear makes every exception taken
    // to EL1 set PSTATE.PAN, so a syscall or interrupt starts with user
    // memory closed whatever the interrupted context had; the reset value
    // has it set. PAN itself is set per core by kernel_pan_require.
    let sctlr_enabled: usize =
        (sctlr | 1 | (1 << 2) | (1 << 12) | (1 << 19))
        & ~(((1 as usize) << 1) | ((1 as usize) << 23));
    msr_sctlr_el1(sctlr_enabled);
    isb();
}
