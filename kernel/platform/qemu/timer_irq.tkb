// ARM Generic Timer (CNTP_EL0) interrupt for QEMU's `virt` machine, PPI #30
// -- the same architectural PPI kernel/platform/rpi5/timer_irq.tkb and
// examples/common_qemu/gic.tkb's gic_enable_timer_ppi() both use. PPIs are
// banked per-CPU by the GIC itself, so this needs no GICD_ITARGETSR write,
// same as RPi5's version.

const QEMU_TIMER_GIC_INTID: u32 = 30;
let mut qemu_timer_gic_intid: u32 = QEMU_TIMER_GIC_INTID;

fn gic_timer_ppi_enable() !{unsafe} {
    let gicd_isenabler0: *io u32 = unsafe {
        (qemu_gicd_base + 0x100) as *io u32
    };
    *gicd_isenabler0 = *gicd_isenabler0 |
        (1 << qemu_timer_gic_intid);
}
