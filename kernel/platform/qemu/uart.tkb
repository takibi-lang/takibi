// QEMU/AArch64 `virt` machine UART HAL (PL011 at 0x09000000, GICv2 SPI #1
// per examples/common_qemu/AGENTS.md, already hardware-proven by that
// tree's own bare-metal examples). Structured to match kernel/platform/
// rpi5/uart.tkb's function set exactly (stored-handler RX interrupt
// interface, uart_put_udec, platform_init/platform_shutdown) so
// kernel/platform/qemu/init.tkb needs no different calling convention than
// kernel/platform/rpi5/init.tkb -- only this file (and kernel/platform/qemu/intc.tkb,
// which routes the interrupt here) differs, not any caller.
//
// Unlike RPi5's RP1 UART0, QEMU's PL011 needs no PCIe link and no baud-rate
// programming (QEMU pre-configures the model) -- see examples/common_qemu/
// AGENTS.md's own "PL011 UART register" note. uart_init() still disables,
// reconfigures, and re-enables the controller for a known state, matching
// RPi5's structure, even though every QEMU boot already starts cold.

use "kernel/platform/qemu/intc.tkb";

let mut uart_rx_handler: fn !{unsafe}(u8) -> void;
let mut uart_base: usize = 0x09000000;

fn uart_putc(c: u8) !{logs, unsafe} {
    kernel_log_capture_uart_byte(c);
    let fr: *io u32 = unsafe { (uart_base + 0x18) as *io u32 }; // PL011 FR
    while ((*fr & (1 << 5)) != 0) { } // wait while TXFF (TX FIFO full)
    let dr: *io u8 = unsafe { uart_base as *io u8 }; // PL011 DR
    *dr = c;
}

fn uart_rx_discard(discarded: u8) !{unsafe} {
}

fn uart_isr_getc() -> u8 !{unsafe} {
    let dr: *io u8 = unsafe { uart_base as *io u8 };
    return *dr;
}

// Terminal fail-stop diagnostics run with IRQ delivery masked, so they must
// consume the same PL011 FIFO by polling rather than through uart_rx_handler.
// This deliberately has no timeout: the kernel is already terminally stopped.
fn uart_debug_getc() -> u8 !{unsafe} {
    while (uart_rx_ready() == false) { }
    return uart_isr_getc();
}

// DDB's emergency TX path is deliberately distinct from uart_putc: it does
// not carry the ordinary `logs` effect and touches no driver-owned state.
// The interrupt checker therefore sees the real MMIO-only operation rather
// than granting the debugger a general logging escape hatch.
fn uart_debug_putc(c: u8) !{unsafe} {
    let fr: *io u32 = unsafe { (uart_base + 0x18) as *io u32 };
    while ((*fr & (1 << 5)) != 0) { }
    let dr: *io u8 = unsafe { uart_base as *io u8 };
    *dr = c;
}

fn uart_rx_ready() -> bool !{unsafe} {
    let fr: *io u32 = unsafe { (uart_base + 0x18) as *io u32 };
    return (*fr & (1 << 4)) == 0; // RXFE clear = data available
}

fn uart_set_rx_handler(handler: fn !{unsafe}(u8) -> void) !{} {
    uart_rx_handler = handler;
}

fn uart_tx_isr() {
}

// Called by platform_irq_dispatch (kernel/platform/qemu/intc.tkb) after
// GICC_IAR identifies the UART SPI. No RP1-style per-vector IACK write
// here -- QEMU's GICv2 needs only the ordinary GICC_EOIR this file's
// caller already issues.
fn uart_irq_handler() -> bool !{interrupt, unsafe} {
    let uart_mis: *io u32 = unsafe { (uart_base + 0x40) as *io u32 };
    let uart_icr: *io u32 = unsafe { (uart_base + 0x44) as *io u32 };
    if (uart_rx_ready()) {
        let dr: *io u32 = unsafe { uart_base as *io u32 };
        let received: u32 = *dr;
        // QEMU represents CHR_EVENT_BREAK as a FIFO word carrying DR.BE.
        // Real PL011 also exposes BE through MIS when BEIM is enabled.
        if ((received & (1 << 10)) != 0 || (*uart_mis & (1 << 9)) != 0) {
            diagnostic_trace_record_uart_break(received as usize);
            *uart_icr = 1 << 9; // BEIC
            return true;
        }
        uart_rx_handler(received as u8);
    } else if ((*uart_mis & (1 << 9)) != 0) {
        diagnostic_trace_record_uart_break(1 << 10);
        *uart_icr = 1 << 9; // BEIC
        return true;
    }
    *uart_icr = 1 << 6; // RTIC (receive-timeout, latched separately from FIFO level)
    return false;
}

fn uart_init() !{unsafe} {
    let uart_cr: *io u32 = unsafe { (uart_base + 0x30) as *io u32 };
    let uart_ibrd: *io u32 = unsafe { (uart_base + 0x24) as *io u32 };
    let uart_fbrd: *io u32 = unsafe { (uart_base + 0x28) as *io u32 };
    let uart_lcrh: *io u32 = unsafe { (uart_base + 0x2C) as *io u32 };
    let uart_imsc: *io u32 = unsafe { (uart_base + 0x38) as *io u32 };
    let uart_icr: *io u32 = unsafe { (uart_base + 0x44) as *io u32 };
    let uart_ifls: *io u32 = unsafe { (uart_base + 0x34) as *io u32 };

    uart_rx_handler = uart_rx_discard;
    *uart_cr = 0; // disable UART before reconfiguring it

    // QEMU's PL011 model is pre-clocked; IBRD/FBRD values are irrelevant to
    // the host-side pipe it's backed by, but set to a plausible 115200-at-
    // 24MHz divisor (matching real PL011 reference clocks) rather than left
    // at whatever reset state, for parity with the real-hardware driver.
    *uart_ibrd = 13;
    *uart_fbrd = 1;

    *uart_lcrh = (3 << 5) | (1 << 4); // 8 bits, no parity, FIFOs enabled, 1 stop bit
    *uart_ifls = 0; // finest-grained FIFO trigger level
    *uart_imsc = 0; // keep RX masked until irq_uart_rx_unmask()
    *uart_icr = 0x7FF; // clear any latched interrupt state

    *uart_cr = (1 << 0) | (1 << 8) | (1 << 9); // UARTEN | TXE | RXE
}

must_use variant QemuUartDtbResult {
    Invalid;
    Missing;
    Applied;
}

fn qemu_uart_apply_boot_dtb() -> QemuUartDtbResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    match fdt_find_compatible_reg(dtb, bs"arm,pl011") {
        FdtDeviceRegionResult::Invalid => {
            return QemuUartDtbResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            return QemuUartDtbResult::Missing;
        }
        FdtDeviceRegionResult::Found(region) => {
            if (region.size < 0x48 ||
                region.base > 0xFFFFFFFFFFFFFFFF - 0x44) {
                return QemuUartDtbResult::Invalid;
            }
            uart_base = region.base;
            uart_init();
            return QemuUartDtbResult::Applied;
        }
    }
}

fn platform_init() {
    // The fixed platform address is the bootstrap console used until the
    // common memory reader has validated the whole boot blob. init.tkb then
    // replaces it with the compatible/reg result before IRQs and workloads.
    uart_init();
}

fn platform_shutdown() {
}
