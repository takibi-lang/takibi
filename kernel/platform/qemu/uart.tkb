// QEMU/AArch64 `virt` machine UART HAL (PL011 at 0x09000000, GICv2 SPI #1
// per examples/common_qemu/AGENTS.md, already hardware-proven by that
// tree's own bare-metal examples). Structured to match kernel/platform/
// rpi5/uart.tkb's function set exactly (stored-handler RX interrupt
// interface, uart_put_udec, platform_init/platform_shutdown) so
// kernel/platform/qemu/init.tkb needs no different calling convention than
// kernel/platform/rpi5/init.tkb -- only this file (and kernel/platform/qemu/intc.tkb,
// which routes the interrupt here) differs, not any caller.
//
// Unlike RPi5's RP1 UART0, QEMU's PL011 needs no PCIe link and no baud-rate
// programming (QEMU pre-configures the model) -- see examples/common_qemu/
// AGENTS.md's own "PL011 UART register" note. uart_init() still disables,
// reconfigures, and re-enables the controller for a known state, matching
// RPi5's structure, even though every QEMU boot already starts cold.

use "kernel/platform/qemu/intc.tkb";
use "kernel/arch/arm64/kernel/platform_uart_common.tkb";
use "kernel/drivers/serial/pl011.tkb";
use "kernel/platform/qemu/device_map.tkb";
// The address the console is attached at, for the boot report; the
// registers themselves are reached only through `uart`.
let mut uart_base: usize = 0x09000000;
// Attached by kernel/platform/qemu/device_map.tkb: first the fixed platform
// window, then the one the DTB names.
let mut uart: IoHandle(Pl011Regs);

// The FIFO, reached without the logging path's bookkeeping: the drain below
// and the emergency debug writer both need exactly these two operations and
// neither may carry the `logs` effect (GitHub issue #454).
fn uart_tx_fifo_full() -> bool {
    return (uart.fr & (1 << 5)) != 0; // TXFF
}

fn uart_tx_store(c: u8) {
    uart.dr = c as u32;
}

fn uart_tx_irq_enable() {
    uart.imsc = uart.imsc | (1 << 5); // TXIM
}

fn uart_tx_irq_disable() {
    uart.imsc = uart.imsc & ~(1 << 5);
}

// GitHub issue #619: a crash console polls the FIFO itself, and no other
// core's interrupt handler may take a byte from it. RXIM, RTIM and BEIM.
fn uart_rx_irq_disable() {
    uart.imsc = uart.imsc & ~((1 << 4) | (1 << 6) | (1 << 9));
}

fn uart_rx_discard(discarded: u8) !{unsafe} {
}

fn uart_isr_getc() -> u8 {
    return (uart.dr & 0xFF) as u8;
}

// DDB's emergency TX path is deliberately distinct from uart_putc: it does
// not carry the ordinary `logs` effect and touches no driver-owned state.
// The interrupt checker therefore sees the real MMIO-only operation rather
// than granting the debugger a general logging escape hatch.
fn uart_debug_putc(c: u8) {
    while ((uart.fr & (1 << 5)) != 0) { }
    uart.dr = c as u32;
}

fn uart_rx_ready() -> bool {
    return (uart.fr & (1 << 4)) == 0; // RXFE clear = data available
}

fn uart_tx_busy() -> bool {
    return (uart.fr & (1 << 3)) != 0;
}

// GitHub issue #517: one register access each, and nothing else. The
// sequence they serve lives in kernel/drivers/serial/pl011.tkb.
fn uart_tx_irq_flagged() -> bool !{interrupt} {
    return (uart.mis & (1 << 5)) != 0; // TXMIS
}

fn uart_break_flagged() -> bool !{interrupt} {
    return (uart.mis & (1 << 9)) != 0; // BEMIS
}

fn uart_break_clear() !{interrupt} {
    uart.icr = 1 << 9; // BEIC
}

fn uart_rx_timeout_clear() !{interrupt} {
    uart.icr = 1 << 6; // RTIC
}

fn uart_rx_word() -> u32 !{interrupt} {
    return uart.dr;
}

fn uart_init() {
    uart_rx_handler = uart_rx_discard;
    uart.cr = 0; // disable UART before reconfiguring it

    // QEMU's PL011 model is pre-clocked; IBRD/FBRD values are irrelevant to
    // the host-side pipe it's backed by, but set to a plausible 115200-at-
    // 24MHz divisor (matching real PL011 reference clocks) rather than left
    // at whatever reset state, for parity with the real-hardware driver.
    uart.ibrd = 13;
    uart.fbrd = 1;

    uart.lcrh = (3 << 5) | (1 << 4); // 8 bits, no parity, FIFOs enabled, 1 stop bit
    uart.ifls = 0; // finest-grained FIFO trigger level
    uart.imsc = 0; // keep RX masked until irq_uart_rx_unmask()
    uart.icr = 0x7FF; // clear any latched interrupt state

    uart.cr = (1 << 0) | (1 << 8) | (1 << 9); // UARTEN | TXE | RXE
}

fn platform_init() {
    // The fixed platform address is the bootstrap console used until the
    // common memory reader has validated the whole boot blob. init.tkb then
    // replaces it with the compatible/reg result before IRQs and workloads.
    qemu_uart_attach_bootstrap();
    uart_init();
}

fn platform_shutdown() {
}
