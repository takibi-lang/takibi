use "kernel/init/test_driver.tkb";
use "kernel/arch/arm64/kernel/secondary.tkb";
use "kernel/init/boot_memory.tkb";
use "kernel/init/boot_prologue.tkb";
use "kernel/init/ext2_fixture.tkb";
use "kernel/init/secondary_boot.tkb";
use "kernel/init/contention_probes.tkb";

// GitHub issue #237: QEMU `virt`'s own guest-visible PSCI conduit is HVC,
// not RPi5's real-firmware SMC -- confirmed by dumping this machine's
// generated DTB (`psci { method = "hvc"; ... }`), and independently by a
// real first-boot attempt under this port: kernel/arch/arm64/boot/cpu.tkb's
// psci_cpu_on (SMC) took an Undefined Instruction trap at EL1, since this
// boot configuration has no EL3 for SMC to reach, only EL2 (HVC's target).
// Not shared with cpu.tkb's psci_cpu_on: same PSCI_CPU_ON function ID and
// SMCCC argument convention, only the trapping instruction differs
// (hvc4 vs smc4, both in lib/llvm_gen.ml/type_inf.ml).
fn qemu_psci_cpu_on(target_affinity: usize, entry: usize, context: usize)
        -> usize {
    if (qemu_psci_use_hvc) {
        return hvc4(0xc4000003, target_affinity, entry, context);
    }
    return smc4(0xc4000003, target_affinity, entry, context);
}

// GitHub issue #445: which core is asking, as a callable function.
//
// QEMU `virt` numbers its cores in MPIDR_EL1.Aff0 (bits [7:0]) -- confirmed
// by dumping this machine's own generated DTB (cpu@0 reg=0, cpu@1 reg=1),
// and confirmed the hard way during the issue #237 port, where
// kernel/arch/arm64/boot/entry_qemu.S carried entry.S's Aff1 line unchanged
// and smp_bringup silently failed with PSCI reporting SUCCESS.
//
// This differs from kernel/platform/rpi5/init.tkb's copy by exactly that
// field choice, which is why it is per-platform rather than in
// kernel/arch/arm64/boot/cpu.tkb beside the other MPIDR-free CPU
// operations.
fn cpu_id() -> usize {
    return mrs_mpidr_el1() & 0xff;
}

// QEMU uses Aff0 target numbering and HVC for PSCI, unlike RPi5's Aff1/SMC path.
fn kernel_secondary_boot_probe() -> SecondaryBootResult {
    kernel_secondary_boot_state_clear();
    signal_fence();
    return kernel_secondary_boot_await(
        qemu_psci_cpu_on(
            0x1, kernel_secondary_entry, 0x191));
}

fn kernel_test_platform_network() {
    match net_init() {
        NetInitResult::Failed => {
            kernel_boot_log("virtio net: link failed\n");
        }
        NetInitResult::Ready(link_ready) => {
            kernel_boot_log("virtio net: link ready mac=02:00:20:00:00:02\n");
            match kernel_arp_reply_once(link_ready) {
                KernelArpResult::TimedOut(arp_ready) => {
                    kernel_boot_log("virtio net: arp timeout\n");
                    // The ARP/ICMP/TCP exchange above is a bounded boot
                    // diagnostic, not a prerequisite for serving later
                    // socket traffic. QEMU's interactive user-mode network
                    // has no raw fixture peer at this point, but it will
                    // deliver ARP and TCP once a user starts httpd from ash.
                    // Keep the one RX capability for that real workload.
                    match network_capability_install(arp_ready) {
                        NetworkCapabilityInstallResult::Installed => {
                            kernel_boot_log("virtio net: rx capability stored after arp timeout\n");
                        }
                        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
                            net_shutdown(incoming);
                        }
                    }
                }
                KernelArpResult::Replied(arp_ready) => {
                    kernel_boot_log("virtio net: arp reply ok ip=192.168.20.2\n");
                    match kernel_icmp_reply_once(arp_ready) {
                        KernelIcmpResult::TimedOut(icmp_ready) => {
                            kernel_boot_log("virtio net: icmp timeout\n");
                            match network_capability_install(icmp_ready) {
                                NetworkCapabilityInstallResult::Installed => {
                                    kernel_boot_log("virtio net: rx capability stored after icmp timeout\n");
                                }
                                NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
                                    net_shutdown(incoming);
                                }
                            }
                        }
                        KernelIcmpResult::Replied(icmp_ready) => {
                            kernel_boot_log("virtio net: icmp echo reply ok ip=192.168.20.2\n");
                            match kernel_tcp_echo_check(icmp_ready) {
                                KernelTcpResult::TimedOut(tcp_ready) => {
                                    kernel_boot_log("virtio net: tcp timeout\n");
                                    match network_capability_install(tcp_ready) {
                                        NetworkCapabilityInstallResult::Installed => {
                                            kernel_boot_log("virtio net: rx capability stored after tcp timeout\n");
                                        }
                                        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
                                            net_shutdown(incoming);
                                        }
                                    }
                                }
                                KernelTcpResult::Verified(tcp_ready) => {
                                    kernel_boot_log("virtio net: tcp handshake echo close reconnect ok\n");
                                    match network_capability_install(tcp_ready) {
                                        NetworkCapabilityInstallResult::Installed => {
                                            kernel_boot_log("virtio net: rx capability stored for sockets\n");
                                        }
                                        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
                                            net_shutdown(incoming);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

}

// QEMU's root filesystem is the virtio disk every lane attaches. Without one
// there is no root: the kernel used to mount an embedded copy of the image
// instead, and print a line no view compared.
fn kernel_test_platform_storage() {
    match virtio_block_device_ext2() {
        KernelBlockDeviceResult::Invalid => {
            kernel_boot_log("virtio blk: unavailable, no root filesystem\n");
        }
        KernelBlockDeviceResult::Ready(device) => {
            kernel_boot_log("virtio blk: ext2 backend ready\n");
            kernel_ext2_mount_and_run(device);
        }
    }
}

fn main() !{unsafe} {
    kernel_boot_prologue();

    kernel_boot_memory_apply();
    match page_discontiguous_extent_probe() {
        PageDiscontiguousProbeResult::Invalid => {
            kernel_boot_log(
                "memory: discontiguous extent probe failed; halting\n");
            while (true) { }
        }
        PageDiscontiguousProbeResult::NotDiscontiguous => { }
        PageDiscontiguousProbeResult::Verified => {
            kernel_boot_log(
                "memory: physical hole excluded and both extent boundaries round-trip\n");
        }
    }

    match qemu_boot_devices_apply_dtb() {
        QemuBootDevicesResult::Invalid => {
            kernel_boot_log("devices: invalid UART/GIC/timer/PSCI/virtio description in boot DTB; halting\n");
            while (true) { }
        }
        QemuBootDevicesResult::Missing => {
            kernel_boot_log("devices: boot DTB lacks enabled UART/GIC/timer/PSCI; halting\n");
            while (true) { }
        }
        QemuBootDevicesResult::Applied => {
            kernel_boot_log("uart: source=dtb base_bytes=");
            uart_put_udec(uart_base);
            kernel_boot_log(" intid=");
            uart_put_udec(qemu_uart_gic_intid as usize);
            kernel_boot_log(" gicd_bytes=");
            uart_put_udec(qemu_gicd_base);
            kernel_boot_log(" gicc_bytes=");
            uart_put_udec(qemu_gicc_base);
            kernel_boot_log(" timer_intid=");
            uart_put_udec(qemu_timer_gic_intid as usize);
            kernel_boot_log("\n");
            kernel_boot_log("psci: source=dtb method=hvc applied_to_cpu_on=yes\n");
            kernel_boot_log("virtio: source=dtb net_base_bytes=");
            uart_put_udec(virtio_base as usize);
            kernel_boot_log(" net_intid=");
            uart_put_udec(virtio_net_gic_intid as usize);
            kernel_boot_log(" block_base_bytes=");
            uart_put_udec(virtio_blk_base as usize);
            kernel_boot_log("\n");
        }
    }

    platform_irq_init();
    // GitHub issue #454: from here a logged byte is queued rather than spun
    // on. Not before: a byte queued while the TX interrupt is masked would
    // never be drained, which is why this is an explicit switch and not
    // something the console infers.
    kernel_log_tx_activate();

    if (fpsimd_irq_probe() == 0) {
        kernel_boot_log("fp/simd irq: q0-q31+fpsr preserved across current-el irq\n");
    } else {
        kernel_boot_log("fp/simd irq: failed\n");
    }

    kernel_secondary_boot_report();

    kernel_test_rpi5_extended = false;
    kernel_test_httpd_daemon = true;
    kernel_test_init_script = true;
    kernel_test_driver_run();
    // GitHub issue #454: the last flush point the issue names. Nothing after
    // this line runs, so a byte still in the transmit queue would never leave
    // -- the park is exactly the case where "must be on the wire before it
    // proceeds" means "before it stops proceeding at all".
    uart_tx_flush();
    platform_shutdown();
    while (true) { }
}
