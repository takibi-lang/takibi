// kernel/ GICv2 interrupt path for QEMU's `virt` machine -- a single-level
// GIC SPI dispatch, unlike kernel/platform/rpi5/intc.tkb's three-level
// GIC->MIP0->RP1-MSI-X routing (QEMU's virtio-mmio/PL011 devices are
// ordinary GIC SPIs with no companion-chip indirection to model). Register
// previously working addresses match examples/common_qemu/gic.tkb and gic_regs.tkb
// exactly (hardware-proven by that tree's own bare-metal examples): GICD at
// 0x08000000 and GICC at 0x08010000. The PL011 route is decoded from the boot
// DTB after comparison with the previously working SPI #1 (INTID 33).
//
// Unlike RPi5, this kernel runs its own code at EL1 (not EL2) with EL0 user
// processes above it -- see kernel/platform/rpi5/intc.tkb's header comment
// for why both the Current-EL-SPx and Lower-EL-AArch64 IRQ vector slots
// call the same dispatch pair here, and why only the Lower-EL path may
// replace its returned frame SP to switch processes.
//
// Function names (platform_irq_dispatch/platform_el0_irq_dispatch) are the
// platform-neutral seam kernel/arch/arm64/kernel/exception_frame.tkb's
// vector-table declarations call by name -- kernel/platform/rpi5/intc.tkb
// defines the identical two names for its own GIC/MIP0/RP1 path, so
// exception_frame.tkb itself needs no per-platform variant, only the
// Makefile's per-target file list needs to supply the right intc.tkb.

use "kernel/platform/qemu/timer_irq.tkb";
use "kernel/arch/arm64/kernel/secondary.tkb";
use "kernel/arch/arm64/boot/cpu.tkb";
use "kernel/kernel/irq_counts.tkb";

let mut qemu_uart_gic_intid: u32 = 33; // bootstrap route until DTB comparison
// The PMU overflow PPI. QEMU's `virt` machine wires each CPU's
// "pmu-interrupt" output to PPI 7 (hw/arm/virt.c's VIRTUAL_PMU_IRQ), which
// is architectural INTID 16 + 7. Like the timer PPI above it is banked
// per-CPU by the GIC, so it needs no GICD_ITARGETSR write.
const QEMU_PMU_GIC_INTID: u32 = 23;
let mut qemu_pmu_gic_intid: u32 = QEMU_PMU_GIC_INTID;
let mut qemu_gicd_base: usize = 0;
let mut qemu_gicc_base: usize = 0;
const QEMU_WORLD_STOP_SGI: u32 = 1;

// Send the world-stop SGI to every active CPU except the initiator. GICv2's
// target-list field uses the same CPU-interface bits as ITARGETSR.
fn platform_world_stop_notify(mask: usize, owner: usize) !{unsafe} {
    let mut targets: u32 = 0;
    for cpu: usize in 0..<KERNEL_MAX_CORES {
        if ((mask & (1 << cpu)) != 0 && cpu != owner) {
            targets = targets | ((1 << cpu) as u32);
        }
    }
    if (targets == 0) { return; }
    platform_gic_sgi_send(targets, QEMU_WORLD_STOP_SGI);
}

// One SGI to the cores in `targets` (GICD_SGIR's CPU target list).
fn platform_gic_sgi_send(targets: u32, sgi: u32) !{unsafe} {
    dsb_ishst();
    let gicd_sgir: *io u32 = unsafe {
        (qemu_gicd_base + 0xF00) as *io u32
    };
    *gicd_sgir = (targets << 16) | (sgi & 0xF);
}

fn gic_uart_spi_setup() !{unsafe} {
    let enable_index: u32 = qemu_uart_gic_intid / 32;
    let enable_bit: u32 = qemu_uart_gic_intid % 32;
    let gicd_isenabler: *io u32 = unsafe {
        (qemu_gicd_base + 0x100 + (enable_index as usize) * 4) as *io u32
    };
    let gicd_itargetsr: *io u8 = unsafe {
        (qemu_gicd_base + 0x800 + (qemu_uart_gic_intid as usize)) as *io u8
    };
    let gicd_ctlr: *io u32 = unsafe { qemu_gicd_base as *io u32 };

    *gicd_itargetsr = 1; // route the discovered UART SPI to CPU0
    *gicd_isenabler = *gicd_isenabler | (1 << enable_bit);

    *gicd_ctlr = *gicd_ctlr | 1;
}

// GitHub issue #447: the GICv2 CPU INTERFACE half, split from the
// distributor half above because the two have different scopes. GICD_CTLR
// and the SPI routing are global and core 0 does them once; GICC_PMR and
// GICC_CTLR are BANKED PER CORE, so a core that never runs this has its
// interrupts disabled at its own interface regardless of the distributor.
// That is why core 1 could take no interrupt before this existed, not
// anything about the distributor being unconfigured.
fn platform_irq_cpu_interface_init() !{unsafe} {
    let gicc_ctlr: *io u32 = unsafe { qemu_gicc_base as *io u32 };
    let gicc_pmr: *io u32 = unsafe { (qemu_gicc_base + 4) as *io u32 };
    *gicc_pmr = 0xFF;
    *gicc_ctlr = *gicc_ctlr | 1;
}

// GIC/timer routing for every source this build currently handles, plus
// the one global DAIF.I unmask. Matches kernel/platform/rpi5/intc.tkb's
// platform_irq_init() in structure and calling convention: UART's own
// PL011 source stays masked (IMSC=0) until kernel/platform/qemu/init.tkb's
// own irq_uart_rx_unmask() call, even though GIC-level routing is armed
// here.
fn platform_irq_init() {
    gic_uart_spi_setup();
    platform_irq_cpu_interface_init();
    gic_pmu_ppi_enable();
    timer_irq_setup();
    enable_irq();
}

// GitHub issue #500: routing only. The PMU counter itself stays disarmed
// until a measured workload interval starts, so an armed route with no
// counter behind it delivers nothing.

// GitHub issue #500: diagnosis only. The whole of the distributor's
// banked-interrupt enable and group words, printed only by an interval
// that collected no samples:
//
//   bits 31:0   GICD_ISENABLER0 -- which of INTIDs 0..31 are enabled
//   bits 63:32  GICD_ISENABLER1 -- which of INTIDs 32..63 are enabled
//
// Whole words rather than the PMU interrupt's own bit, because the timer
// PPI and the RP1 vectors in the same words are known-working controls: a
// GIC-400 ignores an enable write to an INTID it does not implement, so a
// bit that reads back clear beside neighbors that read back set says the
// interrupt number itself is wrong.
fn platform_pmu_irq_debug() -> usize !{unsafe} {
    let gicd_isenabler0: *io u32 = unsafe { (qemu_gicd_base + 0x100) as *io u32 };
    let gicd_isenabler1: *io u32 = unsafe { (qemu_gicd_base + 0x104) as *io u32 };
    let banked: usize = (*gicd_isenabler0) as usize;
    let shared: usize = (*gicd_isenabler1) as usize;
    return banked | (shared << 32);
}

fn gic_pmu_ppi_enable() !{unsafe} {
    let gicd_isenabler0: *io u32 = unsafe {
        (qemu_gicd_base + 0x100) as *io u32
    };
    *gicd_isenabler0 = *gicd_isenabler0 | (1 << qemu_pmu_gic_intid);
}

fn platform_irq_dispatch_inner(frame: sink FrameRef[process], lower_el: bool)
        -> AnyFrame !{interrupt, unsafe} {
    let gicc_iar: *io u32 = unsafe { (qemu_gicc_base + 0x0C) as *io u32 };
    let gicc_eoir: *io u32 = unsafe { (qemu_gicc_base + 0x10) as *io u32 };
    // GitHub issue #632: GICC_IAR is not the interrupt number alone. For an
    // SGI, bits [12:10] name the CPU that sent it, so the world-stop SGI from
    // core 3 reads 0xC01, not 1, and comparing the raw word recognised only
    // stops that core 0 had started. A stop begun on a peer -- an ASID
    // rollover under a four-core workload -- was acknowledged by nobody.
    // Decide on the INTID; EOI with the whole word, which is what the GIC
    // requires to deactivate that sender's SGI.
    let iar: u32 = *gicc_iar;
    let id: u32 = iar & 0x3FF;
    // GitHub issue #715: counted before any branch, so the world stop and
    // every acknowledged INTID are in DDB's `intr` view. Only this CPU's
    // own row is written.
    irq_count_record(id);

    // Stop before touching profiling, scheduler, driver, or reporter state:
    // those are consumers of the proof the initiator is waiting to receive.
    if (id == QEMU_WORLD_STOP_SGI) {
        // GitHub issue #505: the pen, and the root this core publishes on
        // the way into it -- one shared body, because the two platforms
        // differ here only in the SGI id and the EOI register.
        kernel_world_stop_serve(frame);
        *gicc_eoir = iar;
        return frame_any(frame);
    }
    workload_profile_irq_enter();

    // GitHub issue #447: the secondary core takes its own timer tick and
    // goes back to sleep. It must not fall into anything below -- every
    // branch there reaches kernel state (the net wake list, the scheduler,
    // DDB), and this core reaching none of it is what keeps
    // KERNEL_ACTIVE_CORES at 1 while a second core runs kernel code.
    // GICC_IAR is read before the branch, not after: acknowledging is the
    // interrupted core's own job on its own banked interface.
    if (cpu_id() != 0) {
        let switch: TimerSwitch = kernel_secondary_tick(
            frame, lower_el, id == qemu_timer_gic_intid);
        *gicc_eoir = iar;
        workload_profile_irq_exit();
        return kernel_timer_tick_leave(switch);
    }

    let mut debug_break: bool = false;

    if (id == qemu_uart_gic_intid) {
        debug_break = uart_irq_service();
    } else if (id == (virtio_net_gic_intid as u32) && virtio_net_gic_intid >= 0) {
        // GitHub issue #237 M4: virtio_net_gic_intid (kernel/drivers/net/
        // virtio_net.tkb) is discovered at runtime, not a compile-time
        // Unlike the DTB-discovered UART INTID above, it starts at -1 (no
        // device found / net_init() not called yet), so the >= 0 guard
        // keeps that sentinel from ever matching a real GICC_IAR value.
        virtio_net_irq_handler();
    } else if (id == qemu_pmu_gic_intid) {
        // GitHub issue #500: the flat PC sample. Takes the interrupted PC
        // out of the frame this entry already saved, and acknowledges the
        // PMU overflow before the EOI below -- the overflow status is what
        // holds the interrupt line asserted.
        profile_sample_irq(frame);
    } else if (id == qemu_timer_gic_intid) {
        timer_irq_handler();
        // GitHub issue #453: this branch is why most of kernel/ can share
        // mutable state with no lock. Interrupted EL0 -> switch now.
        // Interrupted EL1 -- inside a syscall -- fall through and only
        // REQUEST a reschedule, so the switch happens on the way out of
        // the syscall and a handler always runs to completion. That is
        // KERNEL_PREEMPTIBLE == 0 in kernel/lib/execution_model.tkb, and
        // nine files assert it. Changing this line means changing that
        // constant, which will tell you which nine.
        if (lower_el) {
            kernel_stack_guard_check_interrupt(frame_ref_address(frame));  // issue #375
            let switch: TimerSwitch = kernel_process_timer_schedule(frame);
            *gicc_eoir = iar;
            workload_profile_irq_exit();
            return kernel_timer_tick_leave(switch);
        }
        kernel_process_request_reschedule();
    }

    *gicc_eoir = iar;
    workload_profile_irq_exit();
    if (debug_break) {
        kernel_ddb_enter(frame_ref_address(frame), 1, id as usize);
    }
    return frame_any(frame);
}

fn platform_irq_dispatch(frame_sp: usize) -> usize !{interrupt} {
    return frame_any_address(platform_irq_dispatch_inner(
        frame_ref_from_entry(frame_sp, kernel_process_entry_generation()),
        false));
}

fn platform_el0_irq_dispatch(frame_sp: usize) -> usize !{interrupt} {
    return frame_any_address(platform_irq_dispatch_inner(
        frame_ref_from_entry(frame_sp, kernel_process_entry_generation()),
        true));
}
