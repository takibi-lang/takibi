// platform_memory_detect() for QEMU's `virt` machine -- the same
// platform-neutral seam name kernel/platform/rpi5/mailbox.tkb's own header
// comment already anticipated a future QEMU port would fill in "without
// main.tkb changing at all" (kernel/platform/qemu/init.tkb calls this name
// unmodified). There is no VideoCore-mailbox equivalent under QEMU and no
// usable DTB pointer captured by kernel/arch/arm64/boot/entry.S at boot
// (see that file -- `_start` never reads x0), so this returns a fixed
// value matching this platform's own Makefile/QEMU-invocation `-m` choice
// (kernel/README.md's QEMU section documents the exact figure) rather than
// detecting anything live. Diagnostic only, exactly as it is on RPi5 --
// kernel/mm/page.tkb's allocator still uses its own fixed BOOT_PAGE_COUNT
// regardless of this value on both platforms.
must_use variant PlatformMemoryResult {
    Failed;
    Detected((u32, u32));
}

fn platform_memory_detect() -> PlatformMemoryResult {
    // QEMU `virt` RAM base (examples/common_qemu/AGENTS.md) and this
    // platform's own -m 1024 harness invocation -- see kernel/README.md.
    return PlatformMemoryResult::Detected((0x40000000, 1024 * 1024 * 1024));
}
