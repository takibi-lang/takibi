// platform_memory_detect() for QEMU's `virt` machine. QEMU's built-in
// direct-kernel loader supplies its generated FDT in x0; entry_qemu.S
// preserves that physical address before reusing the argument registers.
// A usable DTB is part of this platform's boot contract, exactly as it is on
// RPi5. Diagnostic only --
// kernel/mm/page.tkb's allocator still uses its own fixed BOOT_PAGE_COUNT
// regardless of this value on both platforms.
must_use variant PlatformMemoryResult {
    InvalidDtb;
    MissingMemory;
    Detected(FdtMemoryMap);
}

fn platform_memory_detect() -> PlatformMemoryResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    let detected: FdtMemoryResult = fdt_detect_memory(dtb);
    match detected {
        FdtMemoryResult::Invalid => {
            return PlatformMemoryResult::InvalidDtb;
        }
        FdtMemoryResult::NotFound => {
            return PlatformMemoryResult::MissingMemory;
        }
        FdtMemoryResult::Found(memory) => {
            if (fdt_memory_map_verify(memory) == false) {
                return PlatformMemoryResult::InvalidDtb;
            }
            return PlatformMemoryResult::Detected(memory);
        }
    }
}
