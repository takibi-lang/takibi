// platform_memory_detect() for QEMU's `virt` machine -- the same
// platform-neutral seam name kernel/platform/rpi5/mailbox.tkb's own header
// comment already anticipated a future QEMU port would fill in "without
// main.tkb changing at all" (kernel/platform/qemu/init.tkb calls this name
// unmodified). There is no VideoCore-mailbox equivalent under QEMU and no
// VideoCore-mailbox equivalent under QEMU. QEMU's built-in direct-kernel
// loader supplies its generated FDT in x0; entry_qemu.S preserves that
// physical address before reusing the argument registers. Diagnostic only,
// exactly as it is on RPi5 --
// kernel/mm/page.tkb's allocator still uses its own fixed BOOT_PAGE_COUNT
// regardless of this value on both platforms.
must_use variant PlatformMemoryResult {
    Failed;
    Detected((usize, usize));
}

fn platform_memory_detect() -> PlatformMemoryResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    let detected: FdtMemoryResult = fdt_detect_memory(dtb);
    match detected {
        FdtMemoryResult::Invalid => {
            return PlatformMemoryResult::Failed;
        }
        FdtMemoryResult::NotFound => {
            return PlatformMemoryResult::Failed;
        }
        FdtMemoryResult::Found(memory) => {
            return PlatformMemoryResult::Detected(memory);
        }
    }
}
