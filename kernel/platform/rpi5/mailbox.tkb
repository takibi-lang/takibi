// VideoCore mailbox property-tag interface for RPi5/BCM2712 (GitHub issue
// #247, step 1: read and boot-log the real detected RAM size instead of
// silently trusting kernel/mm/page.tkb's fixed 1024-page reservation).
//
// Deliberately NOT device-tree-based: a real-hardware check found x0 does
// not carry a usable DTB pointer under this project's SWD-injection dev
// workflow (examples/common_rpi5/jtag_stub.S's own header comment and
// HISTORY.md's 2026-08-08 issue #247 entry have the full investigation).
// The mailbox is a live VideoCore firmware service reachable by ordinary
// MMIO regardless of how the kernel image was loaded, sidestepping that
// problem entirely.
//
// Ported from examples/common_rpi3/mailbox.tkb (BCM2837) -- the property-tag
// wire protocol (message layout, doorbell/channel encoding, request/response
// codes) is identical across every "brcm,bcm2835-mbox"-compatible SoC;
// Raspberry Pi's own upstream device tree (raspberrypi/linux's
// arch/arm64/boot/dts/broadcom/bcm2712.dtsi, `mailbox@7c013880`) confirms
// BCM2712 still carries this exact IP block. Only two things differ from
// the RPi3 file: the MMIO base address, and where that address sits inside
// this project's existing RPi5 identity-mapped device-MMIO L1 blocks.
//
// MMIO base 0x107c013880: RPi5's own platform files (kernel/platform/rpi5/
// pcie.tkb, timer_irq.tkb) already establish the convention that a BCM2712
// peripheral's real physical address is `0x10_` followed by its devicetree
// node's own local `reg` offset -- 0x7c013880 here, per bcm2712.dtsi's
// `mailbox@7c013880` (`reg = <0x7c013880 0x40>`). This falls inside L1
// index 65's identity-mapped 1GB device block (kernel/arch/arm64/mm/
// mmu.tkb's init_root, indices 64-65 cover 0x1000000000-0x1080000000), so
// no new MMU mapping is needed here.
//
// Bus-address translation (0xC0000000 alias, unchanged from RPi3): a
// Raspberry Pi Forums thread on RPi5 memory addressing confirms BCM2712's
// VideoCore firmware still maps the first 1GiB of RAM into the 0xC0000000
// alias specifically so the mailbox can find request/response buffers
// there, even though the ARM cores, DMA controller, and HVS otherwise all
// share one flat address space on this SoC (unlike BCM2837's separate
// VC L2-cached/uncached aliasing rationale) -- see that file's own
// bus_address() comment for the full L2-alias background, which no longer
// applies to WHY the alias exists here, only that it still must be used.
// This requires the message buffer's real physical address to land inside
// the first 1GiB of RAM, true for every RPi5 kernel image and boot-time
// buffer here (link.ld loads at a fixed low physical address).

let mbox_read:   *io u32 = unsafe { 0x107c013880 as *io u32 };
let mbox_status: *io u32 = unsafe { 0x107c013898 as *io u32 };
let mbox_write:  *io u32 = unsafe { 0x107c0138A0 as *io u32 };

const MBOX_STATUS_FULL:  u32 = 0x80000000;
const MBOX_STATUS_EMPTY: u32 = 0x40000000;
const MBOX_RESPONSE_OK:  u32 = 0x80000000;

const MBOX_CH_PROP: u32 = 8;

fn bus_address(addr: usize) -> u32 {
    return ((addr & 0x3FFFFFFF) as u32) | 0xC0000000;
}

// mbox_call: same cache-maintenance pairing and response-matching loop as
// examples/common_rpi3/mailbox.tkb's own function of the same name -- see
// that file's header for the full explanation. One real difference:
// dma_prepare_tx/dma_finish_rx require *align(64) here (Cortex-A76's own
// 64-byte cache line, confirmed by this compile rejecting the RPi3 file's
// *align(32) verbatim), not RPi3's Cortex-A53 *align(32).
fn mbox_call(buf: *align(64) u32, len_bytes: usize, channel: u32) -> bool {
    let addr: usize = buf as usize;
    dma_prepare_tx(buf, len_bytes);

    let msg: u32 = bus_address(addr) | (channel & 0xF);

    while ((*mbox_status & MBOX_STATUS_FULL) != 0) {}
    *mbox_write = msg;

    while (true) {
        while ((*mbox_status & MBOX_STATUS_EMPTY) != 0) {}
        let resp: u32 = *mbox_read;
        if (resp == msg) {
            dma_finish_rx(buf, len_bytes);
            return buf[1] == MBOX_RESPONSE_OK;
        }
    }
}

// Property message buffer for a single "get ARM memory" call (tag
// 0x00010005, per the official firmware wiki's "Mailbox property
// interface" -- request value buffer is empty, response value buffer is
// two u32 words: base address then size, both in bytes):
// [0] total size in bytes, [1] request/response code, [2] tag id,
// [3] tag value buffer size, [4] tag request/response code,
// [5] base (response), [6] size (response), [7] end tag (0).
let mut mem_msg: [u32; 8] align(4096);

must_use variant PlatformMemoryResult {
    Failed;
    Detected((u32, u32));
}

// platform_memory_detect: the generic name this file's own platform_init()/
// platform_irq_init() (kernel/platform/rpi5/uart.tkb/intc.tkb) already use
// for a platform-specific implementation behind a platform-neutral call
// site -- kernel/platform/rpi5/init.tkb calls this name, not mbox_get_arm_memory,
// so a future QEMU/RISC-V port's own kernel/platform/<target>/memory.tkb
// can define the same function name against a completely different
// mechanism (device tree, most likely -- see this file's own header on
// why DTB was rejected specifically for THIS platform's SWD boot path,
// not in general) without main.tkb changing at all.
//
// Queries the VideoCore firmware for the ARM-visible physical RAM base
// and size, exactly as Linux's raspberrypi-firmware driver does before
// the kernel proper ever runs. Read-only diagnostic today (GitHub issue
// #247 step 1) -- kernel/mm/page.tkb's allocator still uses its own fixed
// BOOT_PAGE_COUNT reservation regardless of what this reports; resizing
// the allocator to match is deliberately deferred to a follow-up issue.
fn platform_memory_detect() -> PlatformMemoryResult {
    mem_msg[0] = 8 * 4;
    mem_msg[1] = 0;
    mem_msg[2] = 0x00010005;
    mem_msg[3] = 8;
    mem_msg[4] = 0;
    mem_msg[5] = 0;
    mem_msg[6] = 0;
    mem_msg[7] = 0;
    if (mbox_call(mem_msg, 8 * 4, MBOX_CH_PROP) == false) {
        return PlatformMemoryResult::Failed;
    }
    return PlatformMemoryResult::Detected((mem_msg[5], mem_msg[6]));
}
