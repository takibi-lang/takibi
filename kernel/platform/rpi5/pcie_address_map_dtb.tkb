must_use variant Rpi5PcieAddressMapDtbResult {
    Invalid;
    Missing;
    Applied((usize, usize));
}

fn rpi5_pcie_address_map_apply_boot_dtb(phase: borrow BootPhase[boot])
        -> Rpi5PcieAddressMapDtbResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    match fdt_find_pcie_address_map(
            dtb, bs"brcm,bcm2712-pcie", RPI5_PCIE2_BASE) {
        FdtPcieAddressMapResult::Invalid => {
            boot_once_set(&rpi5_pcie_address_map_dtb_status, phase, 1);
            return Rpi5PcieAddressMapDtbResult::Invalid;
        }
        FdtPcieAddressMapResult::NotFound => {
            boot_once_set(&rpi5_pcie_address_map_dtb_status, phase, 2);
            return Rpi5PcieAddressMapDtbResult::Missing;
        }
        FdtPcieAddressMapResult::Found(address_map) => {
            if (address_map.outbound_cpu_base !=
                    RPI5_PCIE_OUTBOUND_CPU_BASE ||
                address_map.outbound_range_size !=
                    RPI5_PCIE_OUTBOUND_RANGE_SIZE ||
                address_map.dma_pci_offset != RP1_DMA_PCI_OFFSET) {
                boot_once_set(&rpi5_pcie_address_map_dtb_status, phase, 1);
                return Rpi5PcieAddressMapDtbResult::Invalid;
            }
            boot_once_set(&rpi5_pcie_outbound_cpu_base, phase, address_map.outbound_cpu_base);
            boot_once_set(&rp1_dma_pci_offset, phase, address_map.dma_pci_offset);
            boot_once_set(&rpi5_pcie_address_map_dtb_status, phase, 3);
            return Rpi5PcieAddressMapDtbResult::Applied((
                boot_once_get(&rpi5_pcie_outbound_cpu_base), boot_once_get(&rp1_dma_pci_offset)));
        }
    }
}

fn rpi5_pcie_address_map_boot_dtb_status()
        -> Rpi5PcieAddressMapDtbResult {
    if (boot_once_get(&rpi5_pcie_address_map_dtb_status) == 3) {
        return Rpi5PcieAddressMapDtbResult::Applied((
            boot_once_get(&rpi5_pcie_outbound_cpu_base), boot_once_get(&rp1_dma_pci_offset)));
    }
    if (boot_once_get(&rpi5_pcie_address_map_dtb_status) == 2) {
        return Rpi5PcieAddressMapDtbResult::Missing;
    }
    return Rpi5PcieAddressMapDtbResult::Invalid;
}
