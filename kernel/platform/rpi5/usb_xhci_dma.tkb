// GitHub issues #716 and #717: the mint file of the xHCI DMA allocations,
// three the device writes and two it reads (the CBW and the bulk-out
// data). dma_finish_owned_rx and dma_finish_owned_tx are accepted only in
// the file that declares the record, so this file is the whole trusted
// claim that device ownership of a range may return to the CPU. Each
// transfer function below submits one transfer and returns ownership on
// exactly two observations:
//   - a nonzero completion code from usb_ctrl_in, usb_bulk_in or
//     usb_bulk_out, which
//     usb_await_event returns only for the transfer's final Transfer Event,
//     a completed error included (xHCI 1.2, 4.11.3.1);
//   - MscTimeoutResult::RestartRequired from msc_abort_unobserved_transfer,
//     whose xhci_halt_and_reset confirmed HCHalted, after which no pipelined
//     transaction remains (xHCI 1.2, 5.4.1.1).
// Those two functions in usb_xhci.tkb are the observations this file
// trusts. A failed halt/reset keeps the device token in the owner slot, so
// the range is never reused in this boot. Every other function here only
// moves the tokens between the owner slots and their callers. Keep
// anything else out of this file.

use "kernel/lib/mutex.tkb";

struct dma_fixed XhciControlReceive { private bytes: [u8; 256]; }
private let mut xhci_control_receive: XhciControlReceive align(64);

struct dma_fixed MscDataReceive { private bytes: [u8; 65536]; }
private let mut msc_data_receive: MscDataReceive align(64);

struct dma_fixed MscCswReceive { private bytes: [u8; 64]; }
private let mut msc_csw_receive: MscCswReceive align(64);

// The device reads these two: the 31-byte CBW in a whole cache line, and
// the bulk-out payload of at most one maximal transfer.
struct dma_fixed MscCbwTransmit { private bytes: [u8; 64]; }
private let mut msc_cbw_transmit: MscCbwTransmit align(64);
struct dma_fixed MscDataTransmit { private bytes: [u8; 65536]; }
private let mut msc_data_transmit: MscDataTransmit align(64);

private linear struct MscDmaGuard[lock: addr] { private flags: usize; }

private fn msc_dma_lock(lock: *Mutex @ address) -> MscDmaGuard[address]
        !{acquires_lock_40_msc_dma, lock_guard_40_msc_dma} {
    let mut guard: MscDmaGuard[address] = { mutex_acquire(lock) };
    return guard;
}

private fn msc_dma_unlock(guard: sink MscDmaGuard[address],
                          lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

fn msc_csw_take() -> MscCswReceiveAuthority {
    let guard = msc_dma_lock(&dma_owner_MscCswReceive.mutex);
    let previous: Place(MscCswReceiveAuthority) = place_take(
        guard, &dma_owner_MscCswReceive.mutex, dma_owner_MscCswReceive.value);
    msc_dma_unlock(guard, &dma_owner_MscCswReceive.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_syscall_fail_stop(0);
            return msc_csw_take();
        }
    };
    return authority;
}

private fn msc_csw_fail_cpu(stale: sink *MscCswReceiveCpu) {
    kernel_syscall_fail_stop(0);
}

fn msc_csw_fail_device(stale: sink *MscCswReceiveDevice) {
    kernel_syscall_fail_stop(0);
}

fn msc_csw_put(value: sink MscCswReceiveAuthority) {
    let guard = msc_dma_lock(&dma_owner_MscCswReceive.mutex);
    let previous: Place(MscCswReceiveAuthority) = place_put(
        guard, &dma_owner_MscCswReceive.mutex, dma_owner_MscCswReceive.value, value);
    msc_dma_unlock(guard, &dma_owner_MscCswReceive.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        MscCswReceiveAuthority::Cpu(stale) => { msc_csw_fail_cpu(stale); }
        MscCswReceiveAuthority::Device(stale) => {
            msc_csw_fail_device(stale);
        }
    }
}

fn xhci_control_take() -> XhciControlReceiveAuthority {
    let guard = msc_dma_lock(&dma_owner_XhciControlReceive.mutex);
    let previous: Place(XhciControlReceiveAuthority) = place_take(
        guard, &dma_owner_XhciControlReceive.mutex, dma_owner_XhciControlReceive.value);
    msc_dma_unlock(guard, &dma_owner_XhciControlReceive.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_syscall_fail_stop(0);
            return xhci_control_take();
        }
    };
    return authority;
}

private fn xhci_control_fail_cpu(stale: sink *XhciControlReceiveCpu) {
    kernel_syscall_fail_stop(0);
}

fn xhci_control_fail_device(stale: sink *XhciControlReceiveDevice) {
    kernel_syscall_fail_stop(0);
}

fn xhci_control_put(value: sink XhciControlReceiveAuthority) {
    let guard = msc_dma_lock(&dma_owner_XhciControlReceive.mutex);
    let previous: Place(XhciControlReceiveAuthority) = place_put(
        guard, &dma_owner_XhciControlReceive.mutex, dma_owner_XhciControlReceive.value, value);
    msc_dma_unlock(guard, &dma_owner_XhciControlReceive.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        XhciControlReceiveAuthority::Cpu(stale) => {
            xhci_control_fail_cpu(stale);
        }
        XhciControlReceiveAuthority::Device(stale) => {
            xhci_control_fail_device(stale);
        }
    }
}

fn msc_data_take() -> MscDataReceiveAuthority {
    let guard = msc_dma_lock(&dma_owner_MscDataReceive.mutex);
    let previous: Place(MscDataReceiveAuthority) = place_take(
        guard, &dma_owner_MscDataReceive.mutex, dma_owner_MscDataReceive.value);
    msc_dma_unlock(guard, &dma_owner_MscDataReceive.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_syscall_fail_stop(0);
            return msc_data_take();
        }
    };
    return authority;
}

private fn msc_data_fail_cpu(stale: sink *MscDataReceiveCpu) {
    kernel_syscall_fail_stop(0);
}

fn msc_data_fail_device(stale: sink *MscDataReceiveDevice) {
    kernel_syscall_fail_stop(0);
}

fn msc_data_put(value: sink MscDataReceiveAuthority) {
    let guard = msc_dma_lock(&dma_owner_MscDataReceive.mutex);
    let previous: Place(MscDataReceiveAuthority) = place_put(
        guard, &dma_owner_MscDataReceive.mutex, dma_owner_MscDataReceive.value, value);
    msc_dma_unlock(guard, &dma_owner_MscDataReceive.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        MscDataReceiveAuthority::Cpu(stale) => { msc_data_fail_cpu(stale); }
        MscDataReceiveAuthority::Device(stale) => {
            msc_data_fail_device(stale);
        }
    }
}

// A control DATA IN TD has one final Transfer Event. On a missing event,
// halt and reset the controller before restoring CPU ownership.
fn xhci_receive_configuration(length: {1..<257 as u32}) -> u32 !{unsafe} {
    static_assert(sizeof(XhciControlReceive) == 256,
                  "the protected control receive extent covers the descriptor");
    match xhci_control_take() {
        XhciControlReceiveAuthority::Cpu(cpu) => {
            let device = dma_begin_rx(cpu, XhciControlReceive);
            let span_length: {1..<257 as usize} = length as usize;
            let mut span = dma_device_span(device, XhciControlReceive,
                                           0, span_length);
            let completion: u32 = usb_ctrl_in(0x80, 6, 0x0200, 0, span);
            if (completion == 0) {
                match msc_abort_unobserved_transfer() {
                    MscTimeoutResult::RestartRequired => {
                        let restored = dma_finish_owned_rx(device, XhciControlReceive);
                        xhci_control_put(XhciControlReceiveAuthority::Cpu(restored));
                        return 0;
                    }
                    MscTimeoutResult::ControllerUnusable => {
                        xhci_control_put(XhciControlReceiveAuthority::Device(device));
                        return 0;
                    }
                }
            }
            let restored = dma_finish_owned_rx(device, XhciControlReceive);
            xhci_control_put(XhciControlReceiveAuthority::Cpu(restored));
            return completion;
        }
        XhciControlReceiveAuthority::Device(stale) => {
            xhci_control_fail_device(stale);
            return 0;
        }
    }
}

fn msc_data_receive_once(length: {1..<65537 as u32})
        -> MscDataReceiveResult !{unsafe} {
    static_assert(sizeof(MscDataReceive) ==
                  MSC_MAX_TRANSFER_SECTORS * MSC_SECTOR_SIZE,
                  "the protected receive extent covers one maximal USB transfer");
    match msc_data_take() {
        MscDataReceiveAuthority::Cpu(cpu) => {
            let device = dma_begin_rx(cpu, MscDataReceive);
            let span_length: {1..<65537 as usize} = length as usize;
            let mut span = dma_device_span(device, MscDataReceive,
                                           0, span_length);
            let completion: u32 = usb_bulk_in(span);
            if (completion == 0) {
                match msc_abort_unobserved_transfer() {
                    MscTimeoutResult::RestartRequired => {
                        let restored = dma_finish_owned_rx(device, MscDataReceive);
                        msc_data_put(MscDataReceiveAuthority::Cpu(restored));
                        return MscDataReceiveResult::RestartRequired;
                    }
                    MscTimeoutResult::ControllerUnusable => {
                        msc_data_put(MscDataReceiveAuthority::Device(device));
                        return MscDataReceiveResult::ControllerUnusable;
                    }
                }
            }
            let restored = dma_finish_owned_rx(device, MscDataReceive);
            msc_data_put(MscDataReceiveAuthority::Cpu(restored));
            return MscDataReceiveResult::Completed(completion);
        }
        MscDataReceiveAuthority::Device(stale) => {
            msc_data_fail_device(stale);
            return MscDataReceiveResult::ControllerUnusable;
        }
    }
}

// The CSW is always 13 bytes (USB MSC BOT 1.0, 5.2).
fn msc_csw_receive_once() -> MscDataReceiveResult !{unsafe} {
    static_assert(sizeof(MscCswReceive) >= 13,
                  "the protected CSW extent covers its transfer");
    match msc_csw_take() {
        MscCswReceiveAuthority::Cpu(cpu) => {
            let device = dma_begin_rx(cpu, MscCswReceive);
            let mut span = dma_device_span(device, MscCswReceive, 0, 13);
            let completion: u32 = usb_bulk_in(span);
            if (completion == 0) {
                match msc_abort_unobserved_transfer() {
                    MscTimeoutResult::RestartRequired => {
                        let restored = dma_finish_owned_rx(device, MscCswReceive);
                        msc_csw_put(MscCswReceiveAuthority::Cpu(restored));
                        return MscDataReceiveResult::RestartRequired;
                    }
                    MscTimeoutResult::ControllerUnusable => {
                        msc_csw_put(MscCswReceiveAuthority::Device(device));
                        return MscDataReceiveResult::ControllerUnusable;
                    }
                }
            }
            let restored = dma_finish_owned_rx(device, MscCswReceive);
            msc_csw_put(MscCswReceiveAuthority::Cpu(restored));
            return MscDataReceiveResult::Completed(completion);
        }
        MscCswReceiveAuthority::Device(stale) => {
            msc_csw_fail_device(stale);
            return MscDataReceiveResult::ControllerUnusable;
        }
    }
}

fn msc_cbw_take() -> MscCbwTransmitAuthority {
    let guard = msc_dma_lock(&dma_owner_MscCbwTransmit.mutex);
    let previous: Place(MscCbwTransmitAuthority) = place_take(
        guard, &dma_owner_MscCbwTransmit.mutex, dma_owner_MscCbwTransmit.value);
    msc_dma_unlock(guard, &dma_owner_MscCbwTransmit.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_syscall_fail_stop(0);
            return msc_cbw_take();
        }
    };
    return authority;
}

private fn msc_cbw_fail_cpu(stale: sink *MscCbwTransmitCpu) {
    kernel_syscall_fail_stop(0);
}

fn msc_cbw_fail_device(stale: sink *MscCbwTransmitDevice) {
    kernel_syscall_fail_stop(0);
}

fn msc_cbw_put(value: sink MscCbwTransmitAuthority) {
    let guard = msc_dma_lock(&dma_owner_MscCbwTransmit.mutex);
    let previous: Place(MscCbwTransmitAuthority) = place_put(
        guard, &dma_owner_MscCbwTransmit.mutex, dma_owner_MscCbwTransmit.value, value);
    msc_dma_unlock(guard, &dma_owner_MscCbwTransmit.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        MscCbwTransmitAuthority::Cpu(stale) => { msc_cbw_fail_cpu(stale); }
        MscCbwTransmitAuthority::Device(stale) => { msc_cbw_fail_device(stale); }
    }
}

fn msc_data_out_take() -> MscDataTransmitAuthority {
    let guard = msc_dma_lock(&dma_owner_MscDataTransmit.mutex);
    let previous: Place(MscDataTransmitAuthority) = place_take(
        guard, &dma_owner_MscDataTransmit.mutex, dma_owner_MscDataTransmit.value);
    msc_dma_unlock(guard, &dma_owner_MscDataTransmit.mutex);
    let Place::Full(authority) = previous else {
        Place::Empty => {
            kernel_syscall_fail_stop(0);
            return msc_data_out_take();
        }
    };
    return authority;
}

private fn msc_data_out_fail_cpu(stale: sink *MscDataTransmitCpu) {
    kernel_syscall_fail_stop(0);
}

fn msc_data_out_fail_device(stale: sink *MscDataTransmitDevice) {
    kernel_syscall_fail_stop(0);
}

fn msc_data_out_put(value: sink MscDataTransmitAuthority) {
    let guard = msc_dma_lock(&dma_owner_MscDataTransmit.mutex);
    let previous: Place(MscDataTransmitAuthority) = place_put(
        guard, &dma_owner_MscDataTransmit.mutex, dma_owner_MscDataTransmit.value, value);
    msc_dma_unlock(guard, &dma_owner_MscDataTransmit.mutex);
    let Place::Full(held) = previous else {
        Place::Empty => { return; }
    };
    match held {
        MscDataTransmitAuthority::Cpu(stale) => { msc_data_out_fail_cpu(stale); }
        MscDataTransmitAuthority::Device(stale) => { msc_data_out_fail_device(stale); }
    }
}

// The CBW is always 31 bytes (USB MSC BOT 1.0, 5.1).
fn msc_cbw_send_once() -> MscDataReceiveResult !{unsafe} {
    match msc_cbw_take() {
        MscCbwTransmitAuthority::Cpu(cpu) => {
            let device = dma_begin_tx(cpu, MscCbwTransmit);
            let mut span = dma_device_span(device, MscCbwTransmit, 0, 31);
            let completion: u32 = usb_bulk_out(span);
            if (completion == 0) {
                match msc_abort_unobserved_transfer() {
                    MscTimeoutResult::RestartRequired => {
                        let restored = dma_finish_owned_tx(device, MscCbwTransmit);
                        msc_cbw_put(MscCbwTransmitAuthority::Cpu(restored));
                        return MscDataReceiveResult::RestartRequired;
                    }
                    MscTimeoutResult::ControllerUnusable => {
                        msc_cbw_put(MscCbwTransmitAuthority::Device(device));
                        return MscDataReceiveResult::ControllerUnusable;
                    }
                }
            }
            let restored = dma_finish_owned_tx(device, MscCbwTransmit);
            msc_cbw_put(MscCbwTransmitAuthority::Cpu(restored));
            return MscDataReceiveResult::Completed(completion);
        }
        MscCbwTransmitAuthority::Device(stale) => {
            msc_cbw_fail_device(stale);
            return MscDataReceiveResult::ControllerUnusable;
        }
    }
}

// One bulk-out data stage of `length` bytes from the start of the payload.
fn msc_data_send_once(length: {1..<65537 as u32}) -> MscDataReceiveResult !{unsafe} {
    match msc_data_out_take() {
        MscDataTransmitAuthority::Cpu(cpu) => {
            let device = dma_begin_tx(cpu, MscDataTransmit);
            let span_length: {1..<65537 as usize} = length as usize;
            let mut span = dma_device_span(device, MscDataTransmit,
                                           0, span_length);
            let completion: u32 = usb_bulk_out(span);
            if (completion == 0) {
                match msc_abort_unobserved_transfer() {
                    MscTimeoutResult::RestartRequired => {
                        let restored = dma_finish_owned_tx(device, MscDataTransmit);
                        msc_data_out_put(MscDataTransmitAuthority::Cpu(restored));
                        return MscDataReceiveResult::RestartRequired;
                    }
                    MscTimeoutResult::ControllerUnusable => {
                        msc_data_out_put(MscDataTransmitAuthority::Device(device));
                        return MscDataReceiveResult::ControllerUnusable;
                    }
                }
            }
            let restored = dma_finish_owned_tx(device, MscDataTransmit);
            msc_data_out_put(MscDataTransmitAuthority::Cpu(restored));
            return MscDataReceiveResult::Completed(completion);
        }
        MscDataTransmitAuthority::Device(stale) => {
            msc_data_out_fail_device(stale);
            return MscDataReceiveResult::ControllerUnusable;
        }
    }
}
