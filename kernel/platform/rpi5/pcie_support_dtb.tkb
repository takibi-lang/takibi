must_use variant Rpi5PcieSupportDtbResult {
    Invalid;
    Missing;
    Applied((usize, usize));
}

fn rpi5_pcie_support_apply_boot_dtb(phase: borrow BootPhase[boot])
        -> Rpi5PcieSupportDtbResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    let mut rescal_base: usize = 0;
    match fdt_find_compatible_reg(
            dtb, bs"brcm,bcm7216-pcie-sata-rescal") {
        FdtDeviceRegionResult::Invalid => {
            boot_once_set(&rpi5_pcie_support_dtb_status, phase, 1);
            return Rpi5PcieSupportDtbResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            boot_once_set(&rpi5_pcie_support_dtb_status, phase, 2);
            return Rpi5PcieSupportDtbResult::Missing;
        }
        FdtDeviceRegionResult::Found(region) => {
            if (region.base != RPI5_PCIE_RESCAL_BASE ||
                region.size < 0x10) {
                boot_once_set(&rpi5_pcie_support_dtb_status, phase, 1);
                return Rpi5PcieSupportDtbResult::Invalid;
            }
            rescal_base = region.base;
        }
    }

    match fdt_find_compatible_reg(dtb, bs"brcm,brcmstb-reset") {
        FdtDeviceRegionResult::Invalid => {
            boot_once_set(&rpi5_pcie_support_dtb_status, phase, 1);
            return Rpi5PcieSupportDtbResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            boot_once_set(&rpi5_pcie_support_dtb_status, phase, 2);
            return Rpi5PcieSupportDtbResult::Missing;
        }
        FdtDeviceRegionResult::Found(region) => {
            if (region.base != RPI5_BCM_RESET_BASE || region.size < 0x30) {
                boot_once_set(&rpi5_pcie_support_dtb_status, phase, 1);
                return Rpi5PcieSupportDtbResult::Invalid;
            }
            boot_once_set(&rpi5_pcie_rescal_base, phase, rescal_base);
            boot_once_set(&rpi5_bcm_reset_base, phase, region.base);
            boot_once_set(&rpi5_pcie_support_dtb_status, phase, 3);
            return Rpi5PcieSupportDtbResult::Applied((
                boot_once_get(&rpi5_pcie_rescal_base), boot_once_get(&rpi5_bcm_reset_base)));
        }
    }
}

fn rpi5_pcie_support_boot_dtb_status() -> Rpi5PcieSupportDtbResult {
    if (boot_once_get(&rpi5_pcie_support_dtb_status) == 3) {
        return Rpi5PcieSupportDtbResult::Applied((
            boot_once_get(&rpi5_pcie_rescal_base), boot_once_get(&rpi5_bcm_reset_base)));
    }
    if (boot_once_get(&rpi5_pcie_support_dtb_status) == 2) {
        return Rpi5PcieSupportDtbResult::Missing;
    }
    return Rpi5PcieSupportDtbResult::Invalid;
}
