// kernel/ GIC-400 + RP1 MSI-X interrupt path (GitHub issue #187, follow-up to
// #181's "Interrupt-driven device conversion ... follows this completed
// process milestone" note). UART0's route was ported from
// examples/common_rpi5/intc.tkb (hardware-proven, issue #164):
//
//   RP1 PL011 UART0 (level) -> RP1 local interrupt 25
//   -> RP1 MSI-X table entry 25 -> PCIe posted write
//   -> BCM2712 pcie2 RC_BAR1 -> MIP0 input 25
//   -> GIC SPI 153 / architectural INTID 185 -> CPU0 EL1 IRQ
//
// USB xHCI's route (RP1_USBHOST0_0, local interrupt 31, GIC INTID 191) has
// no examples/ precedent -- both the RP1 local interrupt number and the
// edge-vs-level distinction below were confirmed directly against
// raspberrypi/linux (arch/arm64/boot/dts/broadcom/rp1.dtsi's rp1_usb0 node,
// include/dt-bindings/mfd/rp1.h's RP1_INT_USBHOST0_0, and drivers/mfd/rp1.c's
// generic per-hwirq MSIX_CFG(x) = 0x808 + 4*x SET/CLR register formula and
// its rp1_irq_set_type -- IRQ_TYPE_EDGE_RISING clears MSIX_CFG_IACK_EN,
// unlike UART0's IRQ_TYPE_LEVEL_HIGH which sets it), not by copying an
// existing bare-metal example.
//
// Unlike examples/common_rpi5, this standalone kernel runs its own code at
// EL1 (not EL2) with EL0 user processes above it, so the taken exception is
// EL1's own IRQ vector slots, not EL2's. kernel/arch/arm64/boot/entry.S
// routes the Current-EL-SPx IRQ slot (an interrupt while this kernel's own
// EL1 code is running, e.g. servicing a syscall) to a lightweight
// non-scheduling frame, and the Lower-EL-AArch64 IRQ slot (an interrupt
// while an EL0 process is actually executing) to issue #188's complete
// resumable EL0 context frame. Both call rpi5_irq_dispatch; only the
// Lower-EL path may replace its returned frame SP to switch processes.
//
// The RP1 interrupt number and level-triggered IACK protocol come from
// raspberrypi/linux's dt-bindings/mfd/rp1.h and drivers/mfd/rp1.c. MIP0's
// SPI base (128), 64-vector range, and MSI target address come from
// bcm2712.dtsi plus irq-bcm2712-mip.c.
//
// RP1 GEM Ethernet (RP1_INT_ETH, local interrupt 6, GIC INTID 166) and the
// ARM generic timer (PPI 30, kernel/platform/rpi5/timer_irq.tkb) are wired
// below too: GEM's net_rx_wait() callers' deadline-based retry loops
// (ARP/ICMP/TCP silent-negative checks, and the SYN-ACK-drop-recovery
// test) need a companion periodic wake source to stay race-free once
// net_rx_wait() itself blocks in interrupt_wait() instead of polling --
// the timer PPI is that source. RP1_INT_ETH is IRQ_TYPE_LEVEL_HIGH per
// rp1.dtsi, so it needs the same per-vector RP1-level IACK write as
// UART0, unlike USB0's edge-triggered source.

use "kernel/platform/rpi5/timer_irq.tkb";
use "kernel/arch/arm64/kernel/secondary.tkb";
use "kernel/arch/arm64/boot/cpu.tkb";
use "kernel/kernel/irq_counts.tkb";
use "kernel/kernel/nic_irq_affinity.tkb";
use "kernel/kernel/uart_irq_affinity.tkb";
use "kernel/platform/rpi5/xhci_irq_affinity.tkb";
use "kernel/arch/arm64/kernel/gicv2.tkb";

const RP1_UART0_VECTOR: u32 = 25;
const RPI5_UART0_GIC_INTID: u32 = 185; // 32 + (MIP0 SPI base 128 + vector 25)
const RP1_USB0_VECTOR: u32 = 31;
const RPI5_USB0_GIC_INTID: u32 = 191; // 32 + (MIP0 SPI base 128 + vector 31)
const RP1_GEM_VECTOR: u32 = 6;
const RPI5_GEM_GIC_INTID: u32 = 166; // 32 + (MIP0 SPI base 128 + vector 6)
// GitHub issue #500: the Cortex-A76 PMU overflow output. This is NOT the
// architectural PPI 7 that QEMU's `virt` uses. BCM2712's `arm-pmu` node
// (raspberrypi/linux, arch/arm64/boot/dts/broadcom/bcm2712.dtsi,
// compatible "arm,cortex-a76-pmu") declares four SPIs instead --
// GIC_SPI 16..19, IRQ_TYPE_LEVEL_HIGH, with interrupt-affinity cpu0..cpu3
// -- so each core's overflow line arrives as its own shared interrupt
// rather than as one per-CPU banked one. Core 0's is SPI 16, INTID
// 32 + 16 = 48.
//
// Getting this wrong is silent rather than loud: a GIC-400 ignores writes
// to the enable bit of an INTID it does not implement, so PPI 7 left
// GICD_ISENABLER0 reading 0x4000ffff -- the SGIs and the timer PPI, and
// nothing at bit 23 -- while the counter overflowed 60-odd times with
// PMOVSSET_EL0 set and no interrupt behind it.
//
// Being an SPI and not a PPI, this one needs the same GICD_ITARGETSR and
// GICD_ICFGR programming as UART0's and USB0's vectors, which the PPI it
// replaced did not.
const RPI5_PMU_GIC_INTID: u32 = 48;
// BCM2712's MIP0, which turns RP1's MSI writes into GIC SPIs: the three
// low-bank registers this kernel programs (irq-bcm2712-mip.c).
io struct Rp1Mip {
    cfg_low_host: u32 at 0x20;
    mask_low_host: u32 at 0x40;
    mask_low_vpu: u32 at 0x60;
}

// RP1's MSI-X table (61 16-byte entries as words) and its MSIX_CFG SET
// alias (one word per vector).
io struct Rp1MsixTable {
    words: [u32; 244] at 0x0;
}

io struct Rp1MsixCfgSet {
    cfg: [u32; 64] at 0x0;
}

let mut mip0: IoHandle(Rp1Mip);
let mut rp1_msix: IoHandle(Rp1MsixTable);
let mut rp1_msix_cfg_set: IoHandle(Rp1MsixCfgSet);

// GitHub issue #447: the GICv2 CPU INTERFACE. GICC_PMR and GICC_CTLR are
// BANKED PER CORE, so core 0's write does not reach core 1, and a core that
// never runs this has interrupts disabled at its own interface however the
// distributor is configured.

// GICD_ICFGR: two bits per INTID, the upper one selecting edge (1) or
// level (0) triggering.
fn gic_intid_edge(intid: u32, edge: bool) {
    let index: usize = (intid / 16) as usize;
    let bit: u32 = (intid % 16) * 2 + 1;
    if (index < 64) {
        if (edge) {
            gicd.icfgr[index] = gicd.icfgr[index] | (1 << bit);
        } else {
            gicd.icfgr[index] = gicd.icfgr[index] & ~(1 << bit);
        }
    }
}

// One RP1 vector, end to end: the GIC SPI it arrives on (edge-triggered,
// routed to CPU interface 0 until a rotating route retargets it (GitHub
// issue #830), pending cleared, enabled), MIP0's input bit
// (edge at the GIC-facing output, routed to the host and masked away from
// the VPU, as irq-bcm2712-mip.c initializes it), and RP1's MSI-X table
// entry and MSIX_CFG. A level-high source also sets IACK_EN, and the
// dispatch below acknowledges it after service (rp1.c's rp1_irq_set_type).
fn rp1_vector_route(intid: u32, vector: u32, level_high: bool) {
    gic_intid_target(intid, 1);
    gic_intid_edge(intid, true);
    gic_intid_clear_pending(intid);
    gic_intid_enable(intid);
    gicd.ctlr = gicd.ctlr | 1;

    mip0.cfg_low_host = mip0.cfg_low_host | (1 << vector);
    mip0.mask_low_host = mip0.mask_low_host & ~(1 << vector);
    mip0.mask_low_vpu = mip0.mask_low_vpu | (1 << vector);

    // RP1's MSI-X capability is at config offset 0xb0. Its table is BAR0
    // offset 0, with 61 16-byte entries: address low/high, data, control.
    let entry: usize = (vector as usize) * 4;
    if (entry < 241) {
        rp1_msix.words[entry + 3] = 1; // mask while rewriting the entry
        rp1_msix.words[entry] = rpi5_mip0_target as u32;
        rp1_msix.words[entry + 1] = (rpi5_mip0_target >> 32) as u32;
        rp1_msix.words[entry + 2] = vector;
        rp1_msix.words[entry + 3] = 0;
    }
    // Function-wide MSI-X enable (Message Control bit 15, i.e. bit 31 in
    // this 32-bit capability word); leave Function Mask clear. Shared by
    // every vector, so repeating it is idempotent.
    let msix_cap: u32 = pcie2_config_read32(1, 0, 0xB0);
    pcie2_config_write32(1, 0, 0xB0, (msix_cap | 0x80000000) & ~0x40000000);
    // RP1 PCIE_APBS MSIX_CFG: ENABLE, plus IACK_EN for a level-high source.
    // The SET alias avoids changing TEST/IACK bits.
    let cfg: usize = vector as usize;
    if (cfg < 64) {
        if (level_high) {
            rp1_msix_cfg_set.cfg[cfg] = (1 << 0) | (1 << 3);
        } else {
            rp1_msix_cfg_set.cfg[cfg] = 1 << 0;
        }
    }
}

// After a level-high vector is serviced: MSIX_CFG_IACK.
fn rp1_vector_iack(vector: u32) {
    let cfg: usize = vector as usize;
    if (cfg < 64) {
        rp1_msix_cfg_set.cfg[cfg] = 1 << 2;
    }
}

// GIC/MIP0/MSI-X routing for every source this kernel currently handles,
// followed by the one global DAIF.I unmask. Callers must not invoke this
// until they are ready for ANY of these interrupts to preempt them at any
// later point, including while an EL0 process is executing -- see this
// file's header comment on why the Lower-EL-AArch64 IRQ slot needed to be
// wired first. kernel/platform/rpi5/init.tkb calls this once, early (before
// disk_initialize()), so USB xHCI's real disk I/O path runs
// interrupt-driven for the rest of the boot. UART0's PL011-level source
// stays masked (IMSC=0) until kernel/platform/rpi5/init.tkb's own
// irq_uart_rx_unmask() call much later -- GIC-level routing being armed
// early is harmless as long as the peripheral itself never asserts.
fn platform_irq_init() {
    gic_spi_priorities_init();
    platform_irq_cpu_interface_init();
    pcie2_mip0_inbound_setup();
    // UART0 and ETH are level-high in rp1.dtsi; USBHOST0_0 is edge-rising.
    rp1_vector_route(RPI5_UART0_GIC_INTID, RP1_UART0_VECTOR, true);
    // GitHub issue #830 (UART slice): every core online now; widened by
    // uart_irq_handled as secondaries come up.
    uart_irq_route(RPI5_UART0_GIC_INTID);
    rp1_vector_route(RPI5_USB0_GIC_INTID, RP1_USB0_VECTOR, false);
    // The GEM handle is attached before its vector can be dispatched.
    rpi5_gem_attach_bootstrap();
    rpi5_xhci_attach_bootstrap();
    rp1_vector_route(RPI5_GEM_GIC_INTID, RP1_GEM_VECTOR, true);
    // GitHub issue #830: from here the GEM SPI follows the rotating route.
    nic_irq_route(RPI5_GEM_GIC_INTID);
    // GitHub issue #830 (xHCI slice): the USB SPI rotates the same way.
    xhci_irq_route(RPI5_USB0_GIC_INTID);

    timer_irq_setup();

    // GitHub issue #775: core 0 enables its own PMU line through the same
    // per-core helper every secondary calls from kernel_secondary_main.
    gic_pmu_core_enable();

    enable_irq();
}

// GitHub issue #500: routing only. The PMU counter itself stays disarmed
// until a measured workload interval starts, so an armed route with no
// counter behind it delivers nothing.

// GitHub issue #500: diagnosis only. The whole of the distributor's
// banked-interrupt enable and group words, printed only by an interval
// that collected no samples:
//
//   bits 31:0   GICD_ISENABLER0 -- which of INTIDs 0..31 are enabled
//   bits 63:32  GICD_ISENABLER1 -- which of INTIDs 32..63 are enabled
//
// Whole words rather than the PMU interrupt's own bit, because the timer
// PPI and the RP1 vectors in the same words are known-working controls: a
// GIC-400 ignores an enable write to an INTID it does not implement, so a
// bit that reads back clear beside neighbors that read back set says the
// interrupt number itself is wrong.

// GitHub issue #497: this core's own PMU overflow line, for the sampling
// profiler on every core. Core N's is SPI 16 + N (see the constant's
// note); it is routed to core N alone. The SPI is level-sensitive: ICFGR
// cleared, not set. Core 0 calls this too (GitHub issue #775); it once had
// a twin that wrote the same four registers for INTID 48 and target 1.
fn gic_pmu_core_enable() {
    let core: usize = cpu_id();
    if (core >= KERNEL_MAX_CORES) { return; }
    let intid: u32 = RPI5_PMU_GIC_INTID + (core as u32);
    gic_intid_target(intid, (1 << core) as u8);
    gic_intid_edge(intid, false);
    gic_intid_clear_pending(intid);
    gic_intid_enable(intid);
}

// GitHub issue #920: an ordinary source, with ordinary IRQs masked at the GIC
// and DAIF.I clear (see the caller). A path that leaves for the idle loop
// does not come back to the caller's restore; the idle loop's enable_irq
// puts the mask back instead.
fn platform_irq_dispatch_ordinary(frame: sink FrameRef[process], lower_el: bool,
        iar: u32, id: u32) -> AnyFrame !{interrupt, unsafe} {
    workload_profile_irq_enter();

    // GitHub issue #497: a PMU overflow, on any core, before the tick path
    // below, which handles nothing else and would leave this
    // level-triggered line asserted -- a storm of millions per second, seen
    // on the first four-core RPi5 session. Sampling takes the interrupted PC
    // out of the frame this entry already saved and acknowledges the
    // overflow before the EOI (GitHub issue #500). Core 0 once had its own
    // copy of this branch further down (GitHub issue #775).
    if (id >= RPI5_PMU_GIC_INTID &&
            id < RPI5_PMU_GIC_INTID + (KERNEL_MAX_CORES as u32)) {
        profile_sample_irq(frame);
        gicc.eoir = iar;
        workload_profile_irq_exit();
        return frame_any(frame);
    }
    // GitHub issue #830: the GEM SPI rotates through the online cores, so
    // any core takes it. The handler acknowledges GEM's ISR and sends SEV;
    // RP1's level-triggered MSI-X wrapper needs its IACK after that, and the
    // retarget names the next core before this EOI.
    if (id == RPI5_GEM_GIC_INTID) {
        gem_irq_handler();
        rp1_vector_iack(RP1_GEM_VECTOR);
        nic_irq_handled(id);
        gicc.eoir = iar;
        workload_profile_irq_exit();
        return frame_any(frame);
    }
    // GitHub issue #830 (xHCI slice): the USB SPI rotates too. The handler
    // clears IMAN.IP and USBSTS.EINT (both write-1-to-clear) and sends SEV;
    // it does not write ERDP, whose only writer is the event consumer. The
    // source is edge-triggered (see rp1_vector_route's caller), so there is
    // no RP1-level IACK, matching rp1_chained_handle_irq's own
    // rp1_level_triggered_irq[hwirq] check.
    if (id == RPI5_USB0_GIC_INTID) {
        xhci_irq_handler();
        xhci_irq_handled(id);
        gicc.eoir = iar;
        workload_profile_irq_exit();
        return frame_any(frame);
    }
    // GitHub issue #830 (UART slice): the UART SPI goes to every online core
    // (GICv2 1-of-N), so any core takes it. One core at a time serves it
    // (uart_irq_serve). RP1's level-triggered MSI-X wrapper needs an IACK
    // after the device source has been serviced, matching
    // rp1_chained_handle_irq; the route is rewritten after the EOI, and a
    // BREAK enters DDB on this core after it.
    if (id == RPI5_UART0_GIC_INTID) {
        let debug_break: bool = uart_irq_serve();
        rp1_vector_iack(RP1_UART0_VECTOR);
        gicc.eoir = iar;
        uart_irq_after_eoi(id);
        if (debug_break) { kernel_ddb_enter(frame_ref_address(frame), 1, id as usize); }
        return frame_any(frame);
    }
    // GitHub issue #830: the DDB lane's hung-core scenario (a no-op unless
    // a debugger armed it for this core).
    uart_irq_hang_poll();
    // GitHub issue #932: one timer-tick entry for every core. GICC_IAR was
    // read above: acknowledging is the interrupted core's own job on its
    // own banked interface.
    if (id == rpi5_timer_gic_intid) {
        let switch: TimerSwitch = kernel_tick(frame, lower_el);
        gicc.eoir = iar;
        workload_profile_irq_exit();
        return kernel_timer_tick_leave(switch);
    }

    gicc.eoir = iar;
    workload_profile_irq_exit();
    return frame_any(frame);
}
