// kernel/ GIC-400 + RP1 MSI-X interrupt path (GitHub issue #187, follow-up to
// #181's "Interrupt-driven device conversion ... follows this completed
// process milestone" note). UART0's route was ported from
// examples/common_rpi5/intc.tkb (hardware-proven, issue #164):
//
//   RP1 PL011 UART0 (level) -> RP1 local interrupt 25
//   -> RP1 MSI-X table entry 25 -> PCIe posted write
//   -> BCM2712 pcie2 RC_BAR1 -> MIP0 input 25
//   -> GIC SPI 153 / architectural INTID 185 -> CPU0 EL1 IRQ
//
// USB xHCI's route (RP1_USBHOST0_0, local interrupt 31, GIC INTID 191) has
// no examples/ precedent -- both the RP1 local interrupt number and the
// edge-vs-level distinction below were confirmed directly against
// raspberrypi/linux (arch/arm64/boot/dts/broadcom/rp1.dtsi's rp1_usb0 node,
// include/dt-bindings/mfd/rp1.h's RP1_INT_USBHOST0_0, and drivers/mfd/rp1.c's
// generic per-hwirq MSIX_CFG(x) = 0x808 + 4*x SET/CLR register formula and
// its rp1_irq_set_type -- IRQ_TYPE_EDGE_RISING clears MSIX_CFG_IACK_EN,
// unlike UART0's IRQ_TYPE_LEVEL_HIGH which sets it), not by copying an
// existing bare-metal example.
//
// Unlike examples/common_rpi5, this standalone kernel runs its own code at
// EL1 (not EL2) with EL0 user processes above it, so the taken exception is
// EL1's own IRQ vector slots, not EL2's. kernel/arch/arm64/boot/entry.S
// routes the Current-EL-SPx IRQ slot (an interrupt while this kernel's own
// EL1 code is running, e.g. servicing a syscall) to a lightweight
// non-scheduling frame, and the Lower-EL-AArch64 IRQ slot (an interrupt
// while an EL0 process is actually executing) to issue #188's complete
// resumable EL0 context frame. Both call rpi5_irq_dispatch; only the
// Lower-EL path may replace its returned frame SP to switch processes.
//
// The RP1 interrupt number and level-triggered IACK protocol come from
// raspberrypi/linux's dt-bindings/mfd/rp1.h and drivers/mfd/rp1.c. MIP0's
// SPI base (128), 64-vector range, and MSI target address come from
// bcm2712.dtsi plus irq-bcm2712-mip.c.
//
// RP1 GEM Ethernet (RP1_INT_ETH, local interrupt 6, GIC INTID 166) and the
// ARM generic timer (PPI 30, kernel/platform/rpi5/timer_irq.tkb) are wired
// below too: GEM's net_rx_wait() callers' deadline-based retry loops
// (ARP/ICMP/TCP silent-negative checks, and the SYN-ACK-drop-recovery
// test) need a companion periodic wake source to stay race-free once
// net_rx_wait() itself blocks in interrupt_wait() instead of polling --
// the timer PPI is that source. RP1_INT_ETH is IRQ_TYPE_LEVEL_HIGH per
// rp1.dtsi, so it needs the same per-vector RP1-level IACK write as
// UART0, unlike USB0's edge-triggered source.

use "kernel/platform/rpi5/timer_irq.tkb";
use "kernel/arch/arm64/boot/cpu.tkb";

const RP1_UART0_VECTOR: u32 = 25;
const RPI5_UART0_GIC_INTID: u32 = 185; // 32 + (MIP0 SPI base 128 + vector 25)
const RP1_USB0_VECTOR: u32 = 31;
const RPI5_USB0_GIC_INTID: u32 = 191; // 32 + (MIP0 SPI base 128 + vector 31)
const RP1_GEM_VECTOR: u32 = 6;
const RPI5_GEM_GIC_INTID: u32 = 166; // 32 + (MIP0 SPI base 128 + vector 6)

fn gic_uart0_msi_setup() !{unsafe} {
    let gicd_ctlr: *io u32 = unsafe { 0x107FFF9000 as *io u32 };
    let gicd_isenabler5: *io u32 = unsafe { 0x107FFF9114 as *io u32 }; // INTIDs 160..191
    let gicd_icpendr5: *io u32 = unsafe { 0x107FFF9294 as *io u32 };
    let gicd_itargetsr46: *io u32 = unsafe { 0x107FFF98B8 as *io u32 }; // INTIDs 184..187
    let gicd_icfgr11: *io u32 = unsafe { 0x107FFF9C2C as *io u32 }; // INTIDs 176..191
    let gicc_ctlr: *io u32 = unsafe { 0x107FFFA000 as *io u32 };
    let gicc_pmr: *io u32 = unsafe { 0x107FFFA004 as *io u32 };

    // INTID 185 occupies byte 1 of ITARGETSR46. Route it to CPU interface
    // 0 without disturbing the neighboring interrupt targets.
    let targets: u32 = *gicd_itargetsr46;
    *gicd_itargetsr46 = (targets & ~(0xFF << 8)) | (1 << 8);

    // MSI is edge-triggered. ICFGR uses two bits per INTID; the upper bit
    // of INTID 185's pair is bit 19 in ICFGR11.
    *gicd_icfgr11 = *gicd_icfgr11 | (1 << 19);
    *gicd_icpendr5 = 1 << 25;
    *gicd_isenabler5 = 1 << 25;

    *gicd_ctlr = *gicd_ctlr | 1;
    *gicc_pmr = 0xFF;
    *gicc_ctlr = *gicc_ctlr | 1;
}

fn mip0_uart0_setup() !{unsafe} {
    let mip_cfg_low_host: *io u32 = unsafe { 0x1000130020 as *io u32 };
    let mip_mask_low_host: *io u32 = unsafe { 0x1000130040 as *io u32 };
    let mip_mask_low_vpu: *io u32 = unsafe { 0x1000130060 as *io u32 };

    // Match irq-bcm2712-mip.c's host initialization for this one input:
    // edge-triggered at the GIC-facing MIP output, routed to the host and
    // masked away from the VPU.
    *mip_cfg_low_host = *mip_cfg_low_host | (1 << 25);
    *mip_mask_low_host = *mip_mask_low_host & ~(1 << 25);
    *mip_mask_low_vpu = *mip_mask_low_vpu | (1 << 25);
}

fn rp1_uart0_msix_setup() !{unsafe} {
    // RP1's MSI-X capability is at config offset 0xb0. Its table is BAR0
    // offset 0, with 61 16-byte entries; BAR0 is fixed at PCI 0x00410000
    // by pcie2_rp1_endpoint_setup and CPU-mapped at 0x1F00410000.
    let msix_cap: u32 = pcie2_config_read32(1, 0, 0xB0);
    let entry_base: usize = 0x1F00410000 + ((RP1_UART0_VECTOR as usize) * 16);
    let msg_addr_lo: *io u32 = unsafe { entry_base as *io u32 };
    let msg_addr_hi: *io u32 = unsafe { (entry_base + 4) as *io u32 };
    let msg_data: *io u32 = unsafe { (entry_base + 8) as *io u32 };
    let vector_ctrl: *io u32 = unsafe { (entry_base + 12) as *io u32 };

    *vector_ctrl = 1; // mask while rewriting the entry
    *msg_addr_lo = 0xFFFFF000;
    *msg_addr_hi = 0xFF;
    *msg_data = RP1_UART0_VECTOR;
    *vector_ctrl = 0;

    // Function-wide MSI-X enable (Message Control bit 15, i.e. bit 31 in
    // this 32-bit capability word); leave Function Mask clear.
    pcie2_config_write32(1, 0, 0xB0, (msix_cap | 0x80000000) & ~0x40000000);

    // RP1 PCIE_APBS MSIX_CFG[25]: ENABLE plus IACK_EN because UART0's
    // source is level-high. The SET alias avoids changing TEST/IACK bits.
    let rp1_msix_cfg25_set: *io u32 = unsafe { 0x1F0010886C as *io u32 };
    *rp1_msix_cfg25_set = (1 << 0) | (1 << 3);
}

fn gic_usb0_msi_setup() !{unsafe} {
    let gicd_isenabler5: *io u32 = unsafe { 0x107FFF9114 as *io u32 }; // INTIDs 160..191 (shared with UART0)
    let gicd_icpendr5: *io u32 = unsafe { 0x107FFF9294 as *io u32 };
    let gicd_itargetsr47: *io u32 = unsafe { 0x107FFF98BC as *io u32 }; // INTIDs 188..191
    let gicd_icfgr11: *io u32 = unsafe { 0x107FFF9C2C as *io u32 }; // INTIDs 176..191 (shared with UART0)

    // INTID 191 occupies byte 3 of ITARGETSR47.
    let targets: u32 = *gicd_itargetsr47;
    *gicd_itargetsr47 = (targets & ~(0xFF << 24)) | (1 << 24);

    // Upper bit of INTID 191's pair is bit 31 in ICFGR11 -- the same
    // register UART0 sets bit 19 of, so this only ORs in its own bit.
    *gicd_icfgr11 = *gicd_icfgr11 | (1 << 31);
    *gicd_icpendr5 = 1 << 31;
    *gicd_isenabler5 = 1 << 31;

    // GICD_CTLR/GICC_PMR/GICC_CTLR are already enabled by
    // gic_uart0_msi_setup(); this vector only needs its own bits set.
}

fn mip0_usb0_setup() !{unsafe} {
    let mip_cfg_low_host: *io u32 = unsafe { 0x1000130020 as *io u32 };
    let mip_mask_low_host: *io u32 = unsafe { 0x1000130040 as *io u32 };
    let mip_mask_low_vpu: *io u32 = unsafe { 0x1000130060 as *io u32 };

    *mip_cfg_low_host = *mip_cfg_low_host | (1 << 31);
    *mip_mask_low_host = *mip_mask_low_host & ~(1 << 31);
    *mip_mask_low_vpu = *mip_mask_low_vpu | (1 << 31);
}

fn rp1_usbhost0_msix_setup() !{unsafe} {
    let msix_cap: u32 = pcie2_config_read32(1, 0, 0xB0);
    let entry_base: usize = 0x1F00410000 + ((RP1_USB0_VECTOR as usize) * 16);
    let msg_addr_lo: *io u32 = unsafe { entry_base as *io u32 };
    let msg_addr_hi: *io u32 = unsafe { (entry_base + 4) as *io u32 };
    let msg_data: *io u32 = unsafe { (entry_base + 8) as *io u32 };
    let vector_ctrl: *io u32 = unsafe { (entry_base + 12) as *io u32 };

    *vector_ctrl = 1;
    *msg_addr_lo = 0xFFFFF000;
    *msg_addr_hi = 0xFF;
    *msg_data = RP1_USB0_VECTOR;
    *vector_ctrl = 0;

    // Idempotent with rp1_uart0_msix_setup()'s identical write: function-wide
    // MSI-X enable is a single capability-word bit shared by every vector.
    pcie2_config_write32(1, 0, 0xB0, (msix_cap | 0x80000000) & ~0x40000000);

    // RP1_INT_USBHOST0_0 is IRQ_TYPE_EDGE_RISING in rp1.dtsi, so
    // MSIX_CFG_IACK_EN stays clear -- rp1.c's rp1_irq_set_type only sets it
    // for IRQ_TYPE_LEVEL_HIGH, and rp1_chained_handle_irq only issues the
    // post-service IACK write when that flag is set. ENABLE only.
    let rp1_msix_cfg31_set: *io u32 = unsafe { 0x1F00108884 as *io u32 }; // 0x1F00108808 + 31*4
    *rp1_msix_cfg31_set = 1 << 0;
}

fn gic_gem_msi_setup() !{unsafe} {
    let gicd_isenabler5: *io u32 = unsafe { 0x107FFF9114 as *io u32 }; // INTIDs 160..191 (shared with UART0/USB0)
    let gicd_icpendr5: *io u32 = unsafe { 0x107FFF9294 as *io u32 };
    let gicd_itargetsr41: *io u32 = unsafe { 0x107FFF98A4 as *io u32 }; // INTIDs 164..167
    let gicd_icfgr10: *io u32 = unsafe { 0x107FFF9C28 as *io u32 }; // INTIDs 160..175

    // INTID 166 occupies byte 2 of ITARGETSR41.
    let targets: u32 = *gicd_itargetsr41;
    *gicd_itargetsr41 = (targets & ~(0xFF << 16)) | (1 << 16);

    // Upper bit of INTID 166's pair is bit 13 in ICFGR10.
    *gicd_icfgr10 = *gicd_icfgr10 | (1 << 13);
    *gicd_icpendr5 = 1 << 6;
    *gicd_isenabler5 = 1 << 6;
}

fn mip0_gem_setup() !{unsafe} {
    let mip_cfg_low_host: *io u32 = unsafe { 0x1000130020 as *io u32 };
    let mip_mask_low_host: *io u32 = unsafe { 0x1000130040 as *io u32 };
    let mip_mask_low_vpu: *io u32 = unsafe { 0x1000130060 as *io u32 };

    *mip_cfg_low_host = *mip_cfg_low_host | (1 << 6);
    *mip_mask_low_host = *mip_mask_low_host & ~(1 << 6);
    *mip_mask_low_vpu = *mip_mask_low_vpu | (1 << 6);
}

fn rp1_gem_msix_setup() !{unsafe} {
    let msix_cap: u32 = pcie2_config_read32(1, 0, 0xB0);
    let entry_base: usize = 0x1F00410000 + ((RP1_GEM_VECTOR as usize) * 16);
    let msg_addr_lo: *io u32 = unsafe { entry_base as *io u32 };
    let msg_addr_hi: *io u32 = unsafe { (entry_base + 4) as *io u32 };
    let msg_data: *io u32 = unsafe { (entry_base + 8) as *io u32 };
    let vector_ctrl: *io u32 = unsafe { (entry_base + 12) as *io u32 };

    *vector_ctrl = 1;
    *msg_addr_lo = 0xFFFFF000;
    *msg_addr_hi = 0xFF;
    *msg_data = RP1_GEM_VECTOR;
    *vector_ctrl = 0;

    pcie2_config_write32(1, 0, 0xB0, (msix_cap | 0x80000000) & ~0x40000000);

    // RP1_INT_ETH is IRQ_TYPE_LEVEL_HIGH in rp1.dtsi, matching UART0: ENABLE
    // plus IACK_EN, and rpi5_irq_dispatch below issues the post-service IACK.
    let rp1_msix_cfg6_set: *io u32 = unsafe { 0x1F00108820 as *io u32 }; // 0x1F00108808 + 6*4
    *rp1_msix_cfg6_set = (1 << 0) | (1 << 3);
}

// GIC/MIP0/MSI-X routing for every source this kernel currently handles,
// followed by the one global DAIF.I unmask. Callers must not invoke this
// until they are ready for ANY of these interrupts to preempt them at any
// later point, including while an EL0 process is executing -- see this
// file's header comment on why the Lower-EL-AArch64 IRQ slot needed to be
// wired first. kernel/platform/rpi5/init.tkb calls this once, early (before
// disk_initialize()), so USB xHCI's real disk I/O path runs
// interrupt-driven for the rest of the boot. UART0's PL011-level source
// stays masked (IMSC=0) until kernel/platform/rpi5/init.tkb's own
// irq_uart_rx_unmask() call much later -- GIC-level routing being armed
// early is harmless as long as the peripheral itself never asserts.
fn platform_irq_init() {
    gic_uart0_msi_setup();
    mip0_uart0_setup();
    pcie2_mip0_inbound_setup();
    rp1_uart0_msix_setup();

    gic_usb0_msi_setup();
    mip0_usb0_setup();
    rp1_usbhost0_msix_setup();

    gic_gem_msi_setup();
    mip0_gem_setup();
    rp1_gem_msix_setup();

    timer_irq_setup();

    enable_irq();
}

fn irq_uart_rx_unmask() !{unsafe} {
    let uart0_imsc: *io u32 = unsafe { 0x1F00030038 as *io u32 };
    *uart0_imsc = (1 << 4) | (1 << 6); // RXIM | RTIM
}

fn rpi5_irq_dispatch_inner(frame_sp: usize, lower_el: bool)
        -> usize !{interrupt, unsafe} {
    let gicc_iar: *io u32 = unsafe { 0x107FFFA00C as *io u32 };
    let gicc_eoir: *io u32 = unsafe { 0x107FFFA010 as *io u32 };
    let id: u32 = *gicc_iar;

    if (id == RPI5_UART0_GIC_INTID) {
        uart_irq_handler();

        // RP1's level-triggered MSI-X wrapper needs an IACK after the
        // device source has been serviced, matching rp1_chained_handle_irq.
        let rp1_msix_cfg25_set: *io u32 = unsafe { 0x1F0010886C as *io u32 };
        *rp1_msix_cfg25_set = 1 << 2; // MSIX_CFG_IACK
    } else if (id == RPI5_USB0_GIC_INTID) {
        xhci_irq_handler();
        // Edge-triggered source (see rp1_usbhost0_msix_setup): no RP1-level
        // IACK write here, matching rp1_chained_handle_irq's own
        // rp1_level_triggered_irq[hwirq] check.
    } else if (id == RPI5_GEM_GIC_INTID) {
        gem_irq_handler();

        let rp1_msix_cfg6_set: *io u32 = unsafe { 0x1F00108820 as *io u32 };
        *rp1_msix_cfg6_set = 1 << 2; // MSIX_CFG_IACK
    } else if (id == RPI5_TIMER_GIC_INTID) {
        timer_irq_handler();
        if (lower_el) {
            kernel_stack_guard_check(frame_sp);  // issue #375
            let next_sp: usize = kernel_process_timer_schedule(frame_sp);
            *gicc_eoir = id;
            return next_sp;
        }
        kernel_process_request_reschedule();
    }

    *gicc_eoir = id;
    return frame_sp;
}

// GitHub issue #237 (QEMU port): renamed from rpi5_irq_dispatch/
// rpi5_el0_irq_dispatch to the platform-neutral seam name
// kernel/arch/arm64/kernel/exception_frame.tkb's `dispatch:` targets now
// use -- kernel/platform/qemu/intc.tkb defines the identical two names for
// its own GICv2 routing, so exception_frame.tkb needs no per-platform
// variant. Pure rename, no behavior change.
fn platform_irq_dispatch(frame_sp: usize) -> usize !{interrupt} {
    return rpi5_irq_dispatch_inner(frame_sp, false);
}

fn platform_el0_irq_dispatch(frame_sp: usize) -> usize !{interrupt} {
    return rpi5_irq_dispatch_inner(frame_sp, true);
}
