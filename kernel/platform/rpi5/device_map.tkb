// The RPi5 device map: the one file that turns an address into a device
// window (GitHub issue #637 stage 3, step A). The UART0 and GEM windows
// use the RP1 BAR assignment made by this kernel's own PCIe setup and
// checked against the boot DTB. Drivers receive IoHandles and reach their
// registers through them.

use "kernel/drivers/serial/pl011.tkb";
use "kernel/drivers/net/rp1_gem.tkb";
use "kernel/arch/arm64/kernel/gicv2.tkb";

// RP1's UART0 behind the outbound window pcie2_rp1_endpoint_setup programs.
// Reachable only after that setup; nothing uses it earlier.
const RPI5_RP1_UART0_BASE: usize = 0x1F00030000;
const RPI5_RP1_UART0_WINDOW_BYTES: usize = 0x1000;

must_use variant Rpi5Attach {
    Attached;
    Refused;
}

// GitHub issue #1012: the board's known addresses, written before anything
// reads them. A DTB reader that refuses leaves these in place: the windows
// below still attach at them, which is the emergency path that lets main()
// say why it is halting. Each reader overwrites its cell with the equal value
// the DTB reported, so these cells take two writes (kernel/lib/boot_once.tkb).
fn rpi5_boot_config_seed(phase: borrow BootPhase[boot]) {
    boot_once_set(&rpi5_timer_gic_intid, phase, RPI5_TIMER_GIC_INTID);
    boot_once_set(&rpi5_pcie2_base, phase, RPI5_PCIE2_BASE);
    boot_once_set(&rpi5_pcie_rescal_base, phase, RPI5_PCIE_RESCAL_BASE);
    boot_once_set(&rpi5_bcm_reset_base, phase, RPI5_BCM_RESET_BASE);
    boot_once_set(&rpi5_mip0_target, phase, RPI5_MIP0_TARGET);
    boot_once_set(&rpi5_pcie_outbound_cpu_base, phase, RPI5_PCIE_OUTBOUND_CPU_BASE);
    boot_once_set(&rp1_dma_pci_offset, phase, RP1_DMA_PCI_OFFSET);
}

// The console's window before the DTB has been checked.
fn rpi5_uart_attach_bootstrap(phase: borrow BootPhase[boot]) !{unsafe} {
    match rpi5_uart_attach_window(phase, RPI5_RP1_UART0_BASE, RPI5_RP1_UART0_WINDOW_BYTES) {
        Rpi5Attach::Attached => {}
        Rpi5Attach::Refused => { kernel_invariant_stop(); }
    }
}

// The one mint of the UART's registers: the constant above or a DTB reg
// entry its reader has already compared with it.
fn rpi5_uart_attach_window(phase: borrow BootPhase[boot], base: usize, bytes: usize) -> Rpi5Attach !{unsafe} {
    let RegionBytes::Assumed(window) = region_bytes_assume(base, bytes) else {};
    match io_handle_attach(&uart, window) {
        IoAttach::TooSmall => { return Rpi5Attach::Refused; }
        IoAttach::Attached => {
            boot_once_set(&rpi5_uart_base, phase, base);
            return Rpi5Attach::Attached;
        }
    }
}

// The fixed RP1 BAR assignment is checked against the boot DTB before
// networking starts. Attach before the GIC can dispatch a retained GEM IRQ;
// net_init is too late for initializing an interrupt handler's handle.
fn rpi5_gem_attach_bootstrap() !{unsafe} {
    let RegionBytes::Assumed(window) = region_bytes_assume(RP1_GEM_BASE, 0x4000) else {};
    match io_handle_attach(&gem, window) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    // RP1's clock and GPIO blocks for the PHY reset and the Ethernet TX
    // clock (#1163), each only as large as the registers named.
    let RegionBytes::Assumed(clocks) =
        region_bytes_assume(RP1_CLOCKS_BASE, sizeof(Rp1ClocksEthRegs)) else {};
    match io_handle_attach(&rp1_clocks, clocks) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    let RegionBytes::Assumed(ctrl) =
        region_bytes_assume(RP1_GPIO_CTRL_BASE, sizeof(Rp1GpioCtrlRegs)) else {};
    match io_handle_attach(&rp1_gpio_ctrl, ctrl) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    let RegionBytes::Assumed(rio) =
        region_bytes_assume(RP1_GPIO_RIO_BASE, sizeof(Rp1GpioRioRegs)) else {};
    match io_handle_attach(&rp1_gpio_rio, rio) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    let RegionBytes::Assumed(pads) =
        region_bytes_assume(RP1_GPIO_PADS_BASE, sizeof(Rp1GpioPadsRegs)) else {};
    match io_handle_attach(&rp1_gpio_pads, pads) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
}

// pcie2, its SERDES calibration reset and bcm_reset, at the bases the
// boot DTB readers left (the board's addresses, or DTB reg entries already
// compared with them and checked for these sizes). Before pcie2_init.
fn rpi5_pcie_windows_attach() !{unsafe} {
    let RegionBytes::Assumed(bridge) =
        region_bytes_assume(boot_once_get(&rpi5_pcie2_base), 0x9310) else {};
    match io_handle_attach(&pcie2, bridge) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    let RegionBytes::Assumed(rescal) =
        region_bytes_assume(boot_once_get(&rpi5_pcie_rescal_base), 0x10) else {};
    match io_handle_attach(&pcie_rescal, rescal) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    let RegionBytes::Assumed(reset) =
        region_bytes_assume(boot_once_get(&rpi5_bcm_reset_base), 0x30) else {};
    match io_handle_attach(&bcm_reset, reset) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
}

// The BCM2712 system timer, at a DTB reg entry its reader has already
// compared with the board's known address.
fn rpi5_system_timer_attach(base: usize, bytes: usize) -> Rpi5Attach !{unsafe} {
    let RegionBytes::Assumed(window) = region_bytes_assume(base, bytes) else {};
    match io_handle_attach(&rpi5_system_timer, window) {
        IoAttach::TooSmall => { return Rpi5Attach::Refused; }
        IoAttach::Attached => { return Rpi5Attach::Attached; }
    }
}

// RP1 usbhost0's xHCI registers at the BAR1 address. The boot DTB check
// accepts only this base, so nothing re-attaches. Attached with the other
// interrupt-path windows, before its IRQ can be dispatched.
//
// GitHub issues #804 and #806: the trusted reader of the controller's own
// layout, the xHCI counterpart of a DTB reg entry. It attaches the
// capability block, reads CAPLENGTH, RTSOFF, DBOFF, HCSPARAMS1 and
// HCCPARAMS1, checks that each other block lies inside the device window
// and is aligned (xhci_place_blocks), and only then makes a window for each
// block at the base the controller reported. A block outside the window is
// the only refusal; it is named, with the offset read, before the stop.
fn rpi5_xhci_attach_bootstrap(phase: borrow BootPhase[boot]) !{unsafe} {
    let RegionBytes::Assumed(cap_window) = region_bytes_assume(
        RP1_USBHOST0_BASE, sizeof(XhciCapabilityRegs)) else {};
    match io_handle_attach(&rp1_xhci_cap, cap_window) {
        IoAttach::Attached => {}
        IoAttach::TooSmall => { kernel_invariant_stop(); }
    }
    let mut caps: XhciCapabilities = xhci_capabilities_of(
        rp1_xhci_cap.caplength_hciversion, rp1_xhci_cap.hcsparams1,
        rp1_xhci_cap.hccparams1, rp1_xhci_cap.dboff, rp1_xhci_cap.rtsoff);
    match xhci_place_blocks(caps, RP1_USBHOST0_WINDOW_BYTES,
                            sizeof(XhciCapabilityRegs),
                            sizeof(XhciOperationalRegs),
                            sizeof(XhciRuntimeRegs),
                            sizeof(XhciDoorbellRegs)) {
        XhciBlockPlacement::Operational(offset) => {
            rpi5_xhci_refuse("caplength", offset);
        }
        XhciBlockPlacement::Runtime(offset) => {
            rpi5_xhci_refuse("rtsoff", offset);
        }
        XhciBlockPlacement::Doorbell(offset) => {
            rpi5_xhci_refuse("dboff", offset);
        }
        XhciBlockPlacement::Placed(placed) => {
            boot_once_set(&rp1_xhci_caps, phase, placed);
            let RegionBytes::Assumed(op) = region_bytes_assume(
                RP1_USBHOST0_BASE + (placed.caplength as usize),
                sizeof(XhciOperationalRegs)) else {};
            match io_handle_attach(&rp1_xhci_op, op) {
                IoAttach::Attached => {}
                IoAttach::TooSmall => { kernel_invariant_stop(); }
            }
            let RegionBytes::Assumed(rt) = region_bytes_assume(
                RP1_USBHOST0_BASE + (placed.rtsoff as usize),
                sizeof(XhciRuntimeRegs)) else {};
            match io_handle_attach(&rp1_xhci_rt, rt) {
                IoAttach::Attached => {}
                IoAttach::TooSmall => { kernel_invariant_stop(); }
            }
            let RegionBytes::Assumed(db) = region_bytes_assume(
                RP1_USBHOST0_BASE + (placed.dboff as usize),
                sizeof(XhciDoorbellRegs)) else {};
            match io_handle_attach(&rp1_xhci_db, db) {
                IoAttach::Attached => {}
                IoAttach::TooSmall => { kernel_invariant_stop(); }
            }
        }
    }
}

fn rpi5_xhci_refuse(register: *u8, offset: u32) {
    kernel_boot_log("usb xhci: block outside the device window ");
    uart_puts(register);
    kernel_boot_log("=");
    uart_put_hex(offset as usize);
    kernel_boot_log("\n");
    kernel_invariant_stop();
}

// The GIC-400's two windows and MIP0: the board's known addresses until the
// DTB has been compared with them (gic_dtb.tkb, mip_dtb.tkb), then the DTB's.
fn rpi5_gic_attach(phase: borrow BootPhase[boot], dist_base: usize, dist_bytes: usize,
                   cpu_base: usize, cpu_bytes: usize) -> Rpi5Attach !{unsafe} {
    let RegionBytes::Assumed(dist) = region_bytes_assume(dist_base, dist_bytes) else {};
    match io_handle_attach(&gicd, dist) {
        IoAttach::TooSmall => { return Rpi5Attach::Refused; }
        IoAttach::Attached => {}
    }
    let RegionBytes::Assumed(cpu) = region_bytes_assume(cpu_base, cpu_bytes) else {};
    match io_handle_attach(&gicc, cpu) {
        IoAttach::TooSmall => { return Rpi5Attach::Refused; }
        IoAttach::Attached => {}
    }
    boot_once_set(&rpi5_gicd_base, phase, dist_base);
    boot_once_set(&rpi5_gicc_base, phase, cpu_base);
    return Rpi5Attach::Attached;
}

fn rpi5_mip0_attach(phase: borrow BootPhase[boot], base: usize, bytes: usize) -> Rpi5Attach !{unsafe} {
    let RegionBytes::Assumed(window) = region_bytes_assume(base, bytes) else {};
    match io_handle_attach(&mip0, window) {
        IoAttach::TooSmall => { return Rpi5Attach::Refused; }
        IoAttach::Attached => {
            boot_once_set(&rpi5_mip0_base, phase, base);
            return Rpi5Attach::Attached;
        }
    }
}

// Not DT device resources: the MSI-X table is the BAR0 assignment made by
// pcie2_rp1_endpoint_setup(), and MSIX_CFG_SET is an RP1 internal register
// offset within the fixed endpoint peripheral aperture.
const RP1_MSIX_TABLE_BASE: usize = 0x1F00410000;
const RP1_MSIX_TABLE_BYTES: usize = 61 * 16;
const RP1_MSIX_CFG_SET_BASE: usize = 0x1F00108808;
const RP1_MSIX_CFG_SET_BYTES: usize = 64 * 4;

// Every RPi5 interrupt-path window at the board's known addresses, before
// any DTB has been read. Halts if one cannot be attached: no interrupt
// could be routed.
fn rpi5_irq_windows_attach_bootstrap(phase: borrow BootPhase[boot]) !{unsafe} {
    match rpi5_gic_attach(phase, RPI5_GICD_BASE, 0x1000, RPI5_GICC_BASE, 0x2000) {
        Rpi5Attach::Attached => {}
        Rpi5Attach::Refused => { kernel_invariant_stop(); }
    }
    match rpi5_mip0_attach(phase, RPI5_MIP0_BASE, 0xC0) {
        Rpi5Attach::Attached => {}
        Rpi5Attach::Refused => { kernel_invariant_stop(); }
    }
    let RegionBytes::Assumed(table) =
        region_bytes_assume(RP1_MSIX_TABLE_BASE, RP1_MSIX_TABLE_BYTES) else {};
    match io_handle_attach(&rp1_msix, table) {
        IoAttach::TooSmall => { kernel_invariant_stop(); }
        IoAttach::Attached => {}
    }
    let RegionBytes::Assumed(cfg) =
        region_bytes_assume(RP1_MSIX_CFG_SET_BASE, RP1_MSIX_CFG_SET_BYTES) else {};
    match io_handle_attach(&rp1_msix_cfg_set, cfg) {
        IoAttach::TooSmall => { kernel_invariant_stop(); }
        IoAttach::Attached => {}
    }
}
