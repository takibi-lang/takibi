must_use variant Rpi5GemDtbResult {
    Invalid;
    Missing;
    Applied((usize, usize, usize, usize, usize));
}

fn rpi5_gem_apply_boot_dtb(phase: borrow BootPhase[boot]) -> Rpi5GemDtbResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    let mut gem_base: usize = 0;
    let mut clocks_base: usize = 0;

    match fdt_find_compatible_pcie_reg(dtb, bs"raspberrypi,rp1-gem") {
        FdtDeviceRegionResult::Invalid => {
            boot_once_set(&rp1_gem_dtb_status, phase, 1);
            return Rpi5GemDtbResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            boot_once_set(&rp1_gem_dtb_status, phase, 2);
            return Rpi5GemDtbResult::Missing;
        }
        FdtDeviceRegionResult::Found(region) => {
            if (region.base != RP1_GEM_BASE || region.size < 0x4000) {
                boot_once_set(&rp1_gem_dtb_status, phase, 1);
                return Rpi5GemDtbResult::Invalid;
            }
            gem_base = region.base;
        }
    }

    match fdt_find_compatible_pcie_reg(
            dtb, bs"raspberrypi,rp1-clocks") {
        FdtDeviceRegionResult::Invalid => {
            boot_once_set(&rp1_gem_dtb_status, phase, 1);
            return Rpi5GemDtbResult::Invalid;
        }
        FdtDeviceRegionResult::NotFound => {
            boot_once_set(&rp1_gem_dtb_status, phase, 2);
            return Rpi5GemDtbResult::Missing;
        }
        FdtDeviceRegionResult::Found(region) => {
            if (region.base != RP1_CLOCKS_BASE || region.size < 0x10038) {
                boot_once_set(&rp1_gem_dtb_status, phase, 1);
                return Rpi5GemDtbResult::Invalid;
            }
            clocks_base = region.base;
        }
    }

    match fdt_find_compatible_rp1_gpio_regions(
            dtb, bs"raspberrypi,rp1-gpio") {
        FdtRp1GpioRegionsResult::Invalid => {
            boot_once_set(&rp1_gem_dtb_status, phase, 1);
            return Rpi5GemDtbResult::Invalid;
        }
        FdtRp1GpioRegionsResult::NotFound => {
            boot_once_set(&rp1_gem_dtb_status, phase, 2);
            return Rpi5GemDtbResult::Missing;
        }
        FdtRp1GpioRegionsResult::Found(gpio) => {
            if (gpio.ctrl.base != RP1_GPIO_CTRL_BASE ||
                gpio.rio.base != RP1_GPIO_RIO_BASE ||
                gpio.pads.base != RP1_GPIO_PADS_BASE ||
                gpio.ctrl.size < 0xC000 || gpio.rio.size < 0xC000 ||
                gpio.pads.size < 0xC000) {
                boot_once_set(&rp1_gem_dtb_status, phase, 1);
                return Rpi5GemDtbResult::Invalid;
            }
            boot_once_set(&rp1_gem_base, phase, gem_base);
            boot_once_set(&rp1_clocks_base, phase, clocks_base);
            boot_once_set(&rp1_gpio_ctrl_base, phase, gpio.ctrl.base);
            boot_once_set(&rp1_gpio_rio_base, phase, gpio.rio.base);
            boot_once_set(&rp1_gpio_pads_base, phase, gpio.pads.base);
            boot_once_set(&rp1_gem_dtb_status, phase, 3);
            return Rpi5GemDtbResult::Applied((
                boot_once_get(&rp1_gem_base), boot_once_get(&rp1_clocks_base), boot_once_get(&rp1_gpio_ctrl_base),
                boot_once_get(&rp1_gpio_rio_base), boot_once_get(&rp1_gpio_pads_base)));
        }
    }
}

fn rpi5_gem_boot_dtb_status() -> Rpi5GemDtbResult {
    if (boot_once_get(&rp1_gem_dtb_status) == 3) {
        return Rpi5GemDtbResult::Applied((
            boot_once_get(&rp1_gem_base), boot_once_get(&rp1_clocks_base), boot_once_get(&rp1_gpio_ctrl_base),
            boot_once_get(&rp1_gpio_rio_base), boot_once_get(&rp1_gpio_pads_base)));
    }
    if (boot_once_get(&rp1_gem_dtb_status) == 2) { return Rpi5GemDtbResult::Missing; }
    return Rpi5GemDtbResult::Invalid;
}
