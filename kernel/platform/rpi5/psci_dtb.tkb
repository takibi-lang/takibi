must_use variant Rpi5PsciDtbResult {
    Invalid;
    Missing;
    Applied;
}

// KERNEL_ACTIVE_CORES = 4. The boot core writes this before CPU_ON; secondary
// cores never enter this parser or mutate the selected firmware conduit.
let mut rpi5_psci_use_hvc: BootOnce(bool);

fn rpi5_psci_apply_boot_dtb(phase: borrow BootPhase[boot]) -> Rpi5PsciDtbResult !{unsafe} {
    match fdt_find_psci_method(boot_dtb_address_read()) {
        FdtPsciMethodResult::Invalid => {
            return Rpi5PsciDtbResult::Invalid;
        }
        FdtPsciMethodResult::NotFound => {
            return Rpi5PsciDtbResult::Missing;
        }
        FdtPsciMethodResult::Hvc => {
            return Rpi5PsciDtbResult::Invalid;
        }
        FdtPsciMethodResult::Smc => {
            boot_once_set(&rpi5_psci_use_hvc, phase, false);
            return Rpi5PsciDtbResult::Applied;
        }
    }
}
