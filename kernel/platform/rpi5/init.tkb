use "kernel/init/test_driver.tkb";
use "kernel/platform/rpi5/usb_xhci.tkb";
use "kernel/platform/rpi5/memory.tkb";
use "kernel/arch/arm64/kernel/secondary.tkb";
use "kernel/kernel/pool_contention_evidence.tkb";
use "kernel/kernel/freelist_contention_evidence.tkb";
use "kernel/kernel/page_contention_evidence.tkb";
use "kernel/kernel/asid_contention_evidence.tkb";
use "kernel/kernel/pid_contention_evidence.tkb";

must_use variant SecondaryBootResult {
    Started;
    UnexpectedStatus(usize);
    NotStarted(usize);
}

// GitHub issue #445: which core is asking, as a callable function.
//
// BCM2712 numbers its cores in MPIDR_EL1.Aff1 (bits [9:8]), not Aff0 --
// which is why kernel/platform/rpi5/init.tkb's own psci_cpu_on target
// affinity for core 1 is 0x100 rather than 0x1, and why
// kernel/arch/arm64/boot/entry.S reads `ubfx x1, x1, #8, #2` where the
// QEMU port reads Aff0. Two bits, matching that ubfx width and this part's
// four cores.
//
// The field choice is the whole reason this is per-platform; see
// kernel/platform/qemu/init.tkb's copy.
fn cpu_id() -> usize {
    return (mrs_mpidr_el1() >> 8) & 3;
}

// Reached only by core 1 after PSCI has installed the secondary entry point,
// that entry has selected its private stack, and the shared EL1 page table is
// active. The context value prevents a coincidental stale write from passing.
fn kernel_secondary_boot_probe() -> SecondaryBootResult {
    kernel_secondary_boot_state_clear();
    signal_fence();
    let status: usize = psci_cpu_on(
        0x100, kernel_secondary_entry, 0x191);
    let start: i64 = read_cntpct();
    let deadline_ticks: i64 = read_cntfrq();
    while ((read_cntpct() - start) < deadline_ticks) {
        signal_fence();
        if (kernel_secondary_boot_state_value() == 0x101) {
            if (status == 0) {
                return SecondaryBootResult::Started;
            }
            return SecondaryBootResult::UnexpectedStatus(status);
        }
    }
    return SecondaryBootResult::NotStarted(status);
}

must_use variant UsbExt2WriteCheckResult { Invalid; Verified; }
must_use variant UsbExt2ResizeCheckResult { Invalid; Verified; }
must_use variant UsbExt2CreateCheckResult { Invalid; Verified; }
fn usb_ext2_equal_size_write_check(mount: Ext2Mount)
        -> UsbExt2WriteCheckResult {
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => {
            return UsbExt2WriteCheckResult::Invalid;
        }
        Ext2LookupResult::NotFound => {
            return UsbExt2WriteCheckResult::Invalid;
        }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_write_small_file(
                    mount, inode_number, bs"usb-ok\n") {
                Ext2WriteResult::Invalid => {
                    return UsbExt2WriteCheckResult::Invalid;
                }
                Ext2WriteResult::Written => {
                    match ext2_read_small_file(
                            mount, inode_number,
                            ext2_read_fixture as []u8) {
                        Ext2ReadResult::Invalid => {
                            return UsbExt2WriteCheckResult::Invalid;
                        }
                        Ext2ReadResult::Read(length) => {
                            if (length == 7 &&
                                slice_eq(ext2_read_fixture[0..<7],
                                         bs"usb-ok\n")) {
                                return UsbExt2WriteCheckResult::Verified;
                            }
                        }
                    }
                }
            }
        }
    }
    return UsbExt2WriteCheckResult::Invalid;
}

fn usb_ext2_resize_check(mount: Ext2Mount) -> UsbExt2ResizeCheckResult {
    match ext2_lookup_root(mount, bs"mutable.txt") {
        Ext2LookupResult::Invalid => {
            return UsbExt2ResizeCheckResult::Invalid;
        }
        Ext2LookupResult::NotFound => {
            return UsbExt2ResizeCheckResult::Invalid;
        }
        Ext2LookupResult::Found(inode_number) => {
            match ext2_resize_small_file(
                    mount, inode_number, bs"tiny\n") {
                Ext2ResizeResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ResizeResult::Resized => { }
            }
            match ext2_read_small_file(
                    mount, inode_number, ext2_read_fixture as []u8) {
                Ext2ReadResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ReadResult::Read(short_length) => {
                    if (short_length != 5 ||
                        slice_eq(ext2_read_fixture[0..<5],
                                 bs"tiny\n") == false) {
                        return UsbExt2ResizeCheckResult::Invalid;
                    }
                }
            }
            match ext2_resize_small_file(
                    mount, inode_number, bs"extended ext2\n") {
                Ext2ResizeResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ResizeResult::Resized => { }
            }
            match ext2_read_small_file(
                    mount, inode_number, ext2_read_fixture as []u8) {
                Ext2ReadResult::Invalid => {
                    return UsbExt2ResizeCheckResult::Invalid;
                }
                Ext2ReadResult::Read(long_length) => {
                    if (long_length == 14 &&
                        slice_eq(ext2_read_fixture[0..<14],
                                 bs"extended ext2\n")) {
                        return UsbExt2ResizeCheckResult::Verified;
                    }
                }
            }
        }
    }
    return UsbExt2ResizeCheckResult::Invalid;
}

fn usb_ext2_create_check(mount: Ext2Mount) -> UsbExt2CreateCheckResult {
    match ext2_create_root_file(
            mount, bs"created.txt", bs"created on ext2\n") {
        Ext2CreateResult::Invalid => {
            return UsbExt2CreateCheckResult::Invalid;
        }
        Ext2CreateResult::Created(linked) => {
            let mut content_ok: bool = false;
            match ext2_lookup_root(mount, bs"created.txt") {
                Ext2LookupResult::Invalid => { }
                Ext2LookupResult::NotFound => { }
                Ext2LookupResult::Found(inode_number) => {
                    match ext2_read_small_file(
                            mount, inode_number,
                            ext2_read_fixture as []u8) {
                        Ext2ReadResult::Invalid => { }
                        Ext2ReadResult::Read(length) => {
                            if (length == 16 &&
                                slice_eq(ext2_read_fixture[0..<16],
                                         bs"created on ext2\n")) {
                                content_ok = true;
                            }
                        }
                    }
                }
            }
            match ext2_unlink_root_file(
                    mount, linked, bs"created.txt") {
                Ext2UnlinkResult::Invalid => {
                    return UsbExt2CreateCheckResult::Invalid;
                }
                Ext2UnlinkResult::Unlinked => {
                    if (content_ok) {
                        match ext2_lookup_root(
                                mount, bs"created.txt") {
                            Ext2LookupResult::Invalid => { }
                            Ext2LookupResult::Found(existing) => { }
                            Ext2LookupResult::NotFound => {
                                return UsbExt2CreateCheckResult::Verified;
                            }
                        }
                    }
                }
            }
        }
    }
    return UsbExt2CreateCheckResult::Invalid;
}

fn kernel_test_platform_network() {
    match net_init() {
        NetInitResult::Failed => {
            kernel_boot_log("rp1 gem: link failed\n");
        }
        NetInitResult::Ready(link_ready) => {
            kernel_boot_log("rp1 gem: link ready mac=02:00:20:00:00:02\n");
            match kernel_arp_reply_once(link_ready) {
                KernelArpResult::TimedOut(arp_ready) => {
                    kernel_boot_log("rp1 gem: arp timeout\n");
                    net_shutdown(arp_ready);
                }
                KernelArpResult::Replied(arp_ready) => {
                    kernel_boot_log("rp1 gem: arp reply ok ip=192.168.20.2\n");
                    match kernel_icmp_reply_once(arp_ready) {
                        KernelIcmpResult::TimedOut(icmp_ready) => {
                            kernel_boot_log("rp1 gem: icmp timeout\n");
                            net_shutdown(icmp_ready);
                        }
                        KernelIcmpResult::Replied(icmp_ready) => {
                            kernel_boot_log("rp1 gem: icmp echo reply ok ip=192.168.20.2\n");
                            match kernel_tcp_echo_check(icmp_ready) {
                                KernelTcpResult::TimedOut(tcp_ready) => {
                                    kernel_boot_log("rp1 gem: tcp timeout\n");
                                    net_shutdown(tcp_ready);
                                }
                                KernelTcpResult::Verified(tcp_ready) => {
                                    kernel_boot_log("rp1 gem: tcp handshake echo close reconnect ok\n");
                                    match network_capability_install(tcp_ready) {
                                        NetworkCapabilityInstallResult::Installed => {
                                            kernel_boot_log("rp1 gem: rx capability stored for sockets\n");
                                        }
                                        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
                                            net_shutdown(incoming);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn kernel_test_platform_storage() {
    match disk_initialize() {
        DiskIoResult::Err(error) => {
            kernel_boot_log("usb msc: initialization failed\n");
        }
        DiskIoResult::Ok => {
            kernel_boot_log("usb msc: ready sector=512\n");
            match memory_block_device_ext2() {
                KernelBlockDeviceResult::Invalid => {
                    kernel_boot_log("usb ext2: source invalid\n");
                }
                KernelBlockDeviceResult::Ready(source_device) => {
                    match usb_mass_storage_block_device() {
                        KernelBlockDeviceResult::Invalid => {
                            kernel_boot_log("usb ext2: device invalid\n");
                        }
                        KernelBlockDeviceResult::Ready(usb_device) => {
                            disk_reset_write10_command_count();
                            let provision_start: i64 = read_cntpct();
                            match block_copy(source_device, usb_device, 2560) {
                                BlockCopyResult::Invalid => {
                                    kernel_boot_log("usb ext2: provision failed\n");
                                }
                                BlockCopyResult::Copied => {
                                    kernel_boot_log("usb ext2: provisioned blocks=2560\n");
                                    let provision_ticks: i64 =
                                        read_cntpct() - provision_start;
                                    let provision_frequency: i64 = read_cntfrq();
                                    if (provision_frequency <= 0) {
                                        kernel_boot_log("usb provision metrics: invalid counter frequency\n");
                                        return;
                                    }
                                    kernel_boot_log(
                                        "usb provision metrics: write10_commands=");
                                    uart_put_udec(disk_write10_command_count());
                                    kernel_boot_log(" elapsed_ms=");
                                    uart_put_udec(
                                        (provision_ticks * 1000 /
                                         provision_frequency) as usize);
                                    kernel_boot_log("\n");
                                    match block_compare_usb(source_device,
                                                             usb_device, 2560) {
                                        BlockCompareResult::Invalid => {
                                            kernel_boot_log("usb ext2: provision verify failed\n");
                                            return;
                                        }
                                        BlockCompareResult::Different => {
                                            kernel_boot_log("usb ext2: provision verify mismatch\n");
                                            return;
                                        }
                                        BlockCompareResult::Equal => {
                                            kernel_boot_log("usb ext2: provision verify byte-equal\n");
                                        }
                                    }
                                    match ext2_mount(usb_device) {
                                        Ext2MountResult::Invalid => {
                                            kernel_boot_log("usb ext2: mount failed\n");
                                        }
                                        Ext2MountResult::Mounted(usb_mount) => {
                                            kernel_syscall_ext2_configure(usb_mount);
                                            match usb_ext2_equal_size_write_check(
                                                    usb_mount) {
                                                UsbExt2WriteCheckResult::Invalid => {
                                                    kernel_boot_log("usb ext2: file write failed\n");
                                                }
                                                UsbExt2WriteCheckResult::Verified => {
                                                    kernel_boot_log("usb ext2: write /mutable.txt ok\n");
                                                }
                                            }
                                            match usb_ext2_resize_check(usb_mount) {
                                                UsbExt2ResizeCheckResult::Invalid => {
                                                    kernel_boot_log("usb ext2: resize failed\n");
                                                }
                                                UsbExt2ResizeCheckResult::Verified => {
                                                    kernel_boot_log("usb ext2: resize truncate+extend ok\n");
                                                }
                                            }
                                            match ext2_bitmap_roundtrip_check(usb_mount) {
                                                Ext2BitmapProbeResult::Invalid => {
                                                    kernel_boot_log("usb ext2: bitmap update failed\n");
                                                }
                                                Ext2BitmapProbeResult::Verified => {
                                                    kernel_boot_log("usb ext2: block+inode bitmap counts ok\n");
                                                }
                                            }
                                            match ext2_owner_roundtrip_check(usb_mount) {
                                                Ext2BitmapProbeResult::Invalid => {
                                                    kernel_boot_log("usb ext2: owner allocation failed\n");
                                                }
                                                Ext2BitmapProbeResult::Verified => {
                                                    kernel_boot_log("usb ext2: block+inode owners ok\n");
                                                }
                                            }
                                            match usb_ext2_create_check(usb_mount) {
                                                UsbExt2CreateCheckResult::Invalid => {
                                                    kernel_boot_log("usb ext2: create failed\n");
                                                }
                                                UsbExt2CreateCheckResult::Verified => {
                                                    kernel_boot_log("usb ext2: create+lookup+unlink ok\n");
                                                }
                                            }
                                            match ext2_lookup_root(
                                                    usb_mount,
                                                    bs"hello.txt") {
                                                Ext2LookupResult::Invalid => {
                                                    kernel_boot_log("usb ext2: lookup failed\n");
                                                }
                                                Ext2LookupResult::NotFound => {
                                                    kernel_boot_log("usb ext2: hello not found\n");
                                                }
                                                Ext2LookupResult::Found(usb_inode) => {
                                                    match ext2_read_small_file(
                                                            usb_mount, usb_inode,
                                                            ext2_read_fixture as []u8) {
                                                        Ext2ReadResult::Invalid => {
                                                            kernel_boot_log("usb ext2: read failed\n");
                                                        }
                                                        Ext2ReadResult::Read(usb_length) => {
                                                            if (usb_length == 16 &&
                                                                slice_eq(ext2_read_fixture[0..<16],
                                                                         bs"hello from ext2\n")) {
                                                                kernel_boot_log("usb ext2: mounted /hello.txt ok\n");
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    match memory_block_device_ext2() {
        KernelBlockDeviceResult::Invalid => {
            kernel_boot_log("ext2 image: invalid\n");
        }
        KernelBlockDeviceResult::Ready(device) => {
            match ext2_mount(device) {
                Ext2MountResult::Invalid => {
                    kernel_boot_log("ext2 mount: invalid\n");
                }
                Ext2MountResult::Mounted(mount) => {
                    // GitHub issue #249: save the mount for
                    // kernel_exec_resolve_argv0(), which runs later, from
                    // a syscall-return path outside fn main()'s own scope.
                    saved_ext2_mount = mount;
                    ext2_mount_ready = true;
                    // The memory-backed fixture is the root filesystem used
                    // by the init process below.  Configure the syscall
                    // path from this mount even when USB MSC provisioning
                    // was unavailable (and also replace the temporary USB
                    // mount when it was available); otherwise openat(2)
                    // observes syscall_ext2_ready == false and reports
                    // EBADF for /etc/init.sh.
                    kernel_syscall_ext2_configure(mount);
                    if (ext2_fixture_geometry_is_expected(mount)) {
                        kernel_boot_log("ext2 mount: block=1024 inodes=1024 blocks=2560\n");
                    }
                    match ext2_lookup_root(mount, bs"hello.txt") {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 lookup: invalid\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 lookup: not found\n");
                        }
                        Ext2LookupResult::Found(inode_number) => {
                            match ext2_read_small_file(
                                    mount, inode_number,
                                    ext2_read_fixture as []u8) {
                                Ext2ReadResult::Invalid => {
                                    kernel_boot_log("ext2 read: invalid\n");
                                }
                                Ext2ReadResult::Read(length) => {
                                    if (length == 16 &&
                                        slice_eq(ext2_read_fixture[0..<16],
                                                 bs"hello from ext2\n")) {
                                        kernel_boot_log("ext2 read: /hello.txt ok\n");
                                    }
                                }
                            }
                        }
                    }
                    match ext2_lookup_root(mount, bs"mutable.txt") {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 write: invalid lookup\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 write: not found\n");
                        }
                        Ext2LookupResult::Found(mutable_inode) => {
                            match ext2_write_small_file(
                                    mount, mutable_inode, bs"after!\n") {
                                Ext2WriteResult::Invalid => {
                                    kernel_boot_log("ext2 write: invalid\n");
                                }
                                Ext2WriteResult::Written => {
                                    match ext2_read_small_file(
                                            mount, mutable_inode,
                                            ext2_read_fixture as []u8) {
                                        Ext2ReadResult::Invalid => {
                                            kernel_boot_log("ext2 write: reread failed\n");
                                        }
                                        Ext2ReadResult::Read(written_length) => {
                                            if (written_length == 7 &&
                                                slice_eq(ext2_read_fixture[0..<7],
                                                         bs"after!\n")) {
                                                kernel_boot_log("ext2 write: /mutable.txt ok\n");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    match ext2_lookup_root(mount, bs"latest") {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 symlink: invalid lookup\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 symlink: not found\n");
                        }
                        Ext2LookupResult::Found(link_inode) => {
                            match ext2_read_fast_symlink(
                                    mount, link_inode,
                                    ext2_symlink_fixture as []u8) {
                                Ext2SymlinkResult::Invalid => {
                                    kernel_boot_log("ext2 symlink: invalid\n");
                                }
                                Ext2SymlinkResult::Read(target_length) => {
                                    if (target_length == 9 &&
                                        slice_eq(ext2_symlink_fixture[0..<9],
                                                 bs"hello.txt")) {
                                        match ext2_lookup_root(
                                                mount,
                                                ext2_symlink_fixture[0..<9]) {
                                            Ext2LookupResult::Invalid => { }
                                            Ext2LookupResult::NotFound => { }
                                            Ext2LookupResult::Found(target_inode) => {
                                                match ext2_read_small_file(
                                                        mount, target_inode,
                                                        ext2_read_fixture as []u8) {
                                                    Ext2ReadResult::Invalid => { }
                                                    Ext2ReadResult::Read(linked_length) => {
                                                        if (linked_length == 16 &&
                                                            slice_eq(ext2_read_fixture[0..<16],
                                                                     bs"hello from ext2\n")) {
                                                            kernel_boot_log("ext2 symlink: /latest -> hello.txt ok\n");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // GitHub issue #243: /large.txt is 3200 bytes, spanning
                    // 4 direct blocks (i_block[0..3]) -- the first fixture
                    // read past the single-block cap ext2_read_small_file
                    // used to enforce. Content is 3200 repetitions of 'A'
                    // (0x41); checking the first byte, the last byte, and
                    // the byte straddling the block-3/block-4 boundary
                    // (offset 3071, the last byte of the 3rd full block)
                    // catches an off-by-one in the per-block chunk/copy
                    // arithmetic that checking only the first byte would
                    // miss.
                    match ext2_lookup_root(mount, bs"large.txt") {
                        Ext2LookupResult::Invalid => {
                            kernel_boot_log("ext2 multi-block: invalid lookup\n");
                        }
                        Ext2LookupResult::NotFound => {
                            kernel_boot_log("ext2 multi-block: not found\n");
                        }
                        Ext2LookupResult::Found(large_inode) => {
                            match ext2_read_small_file(
                                    mount, large_inode,
                                    ext2_large_fixture as []u8) {
                                Ext2ReadResult::Invalid => {
                                    kernel_boot_log("ext2 multi-block: read invalid\n");
                                }
                                Ext2ReadResult::Read(large_length) => {
                                    if (large_length == 3200 &&
                                        ext2_large_fixture[0] == 0x41 &&
                                        ext2_large_fixture[3071] == 0x41 &&
                                        ext2_large_fixture[3199] == 0x41) {
                                        kernel_boot_log("ext2 multi-block: /large.txt 3200 bytes ok\n");
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn main() !{unsafe} {
    // First, before anything has had a chance to go deep: fill the unused
    // part of the boot stack with poison so its high-water mark can be
    // measured at the end of the run, exactly as a process stack's is.
    kernel_boot_stack_arm();
    // Nothing is standing on the IRQ stack yet, so the whole run can be
    // poisoned outright (issue #378).
    kernel_irq_stack_arm();
    platform_init();
    kernel_log_init();
    let log_bounds_ok: bool = kernel_log_bounds_probe();
    kernel_log_init();
    kernel_boot_log("takibi kernel: EL1\n");
    if (log_bounds_ok) {
        kernel_boot_log("kernel log: overwrite+line truncation reported\n");
    } else {
        kernel_boot_log("kernel log: bounds probe failed\n");
    }

    // The firmware-resolved DTB is part of the arm64 boot contract on this
    // platform. Memory discovery failing means that contract is broken; do
    // not hide a parser or handoff regression behind a second data source.
    match platform_memory_detect() {
        PlatformMemoryResult::Detected(detected) => {
            match page_allocator_apply_memory(detected) {
                PageAllocatorMemoryResult::Invalid => {
                    kernel_boot_log("memory: usable regions exclude bootstrap page tables; halting\n");
                    while (true) { }
                }
                PageAllocatorMemoryResult::Applied => {}
            }
            let mem_base: usize = fdt_memory_first_base(detected);
            let mem_size: usize = fdt_memory_total_size(detected);
            kernel_boot_log("memory: source=dtb base_bytes=");
            uart_put_udec(mem_base as usize);
            kernel_boot_log(" detected_mib=");
            uart_put_udec((mem_size as usize) / (1024 * 1024));
            kernel_boot_log(" regions=");
            uart_put_udec(fdt_memory_region_count(detected));
            kernel_boot_log(" reservations=");
            uart_put_udec(fdt_memory_reservation_count(detected));
            kernel_boot_log(" allocator_pages=");
            uart_put_udec(page_allocator_total_count());
            kernel_boot_log("\n");
        }
        PlatformMemoryResult::InvalidDtb => {
            kernel_boot_log("memory: invalid boot DTB; halting\n");
            while (true) { }
        }
        PlatformMemoryResult::MissingMemory => {
            kernel_boot_log("memory: boot DTB has no usable /memory; halting\n");
            while (true) { }
        }
    }

    // GitHub issue #187: arms GIC/MIP0/MSI-X routing for UART0 and USB
    // xHCI and unmasks DAIF.I globally. UART0's own PL011 source stays
    // masked until this function's much later irq_uart_rx_unmask() call;
    // USB xHCI's interrupter is already enabled by the time
    // disk_initialize() runs below, so every disk_read/disk_write for the
    // rest of this boot -- including USB xHCI calls interleaved with EL0
    // BusyBox/HTTPd execution -- waits via interrupt_wait() instead of
    // polling. See kernel/platform/rpi5/intc.tkb's header comment for why
    // this is safe now that both the Current-EL-SPx and Lower-EL-AArch64
    // IRQ vector slots are wired.
    platform_irq_init();

    // GitHub issue #223: the Current-EL-SPx IRQ entry used to save general
    // registers only, so an interrupt taken while EL1 kernel code held live
    // q registers would have destroyed them the moment anything on the
    // dispatch path used SIMD. It now saves the same full exception frame
    // as the EL0 entries; this fixture holds a pattern in q0-q31 and FPSR
    // across a real interrupt whose entry path deliberately scrambles both
    // (kernel/arch/arm64/kernel/fpsimd_probe.S), so the frame is the only
    // thing that can restore them. Runs here, right after the interrupt
    // path comes up, since the timer PPI it waits on is armed by
    // platform_irq_init() above and nothing later depends on it.
    if (fpsimd_irq_probe() == 0) {
        kernel_boot_log("fp/simd irq: q0-q31+fpsr preserved across current-el irq\n");
    } else {
        kernel_boot_log("fp/simd irq: failed\n");
    }

    // GitHub issue #246: page_allocator_init() no longer runs here.
    // kernel/mm/address_space.tkb's kernel_mmu_init() -- called from
    // entry.S's `_start`, before main() -- now calls page_alloc() itself
    // (to back root 0's page tables), so it calls page_allocator_init()
    // as its own first statement instead; see that function's own comment
    // for why calling it a second time here would corrupt root 0 (it
    // would free root 0's three already-in-use pages back into the pool
    // while they are still this kernel's own active page tables).

    match kernel_secondary_boot_probe() {
        SecondaryBootResult::Started => {
            // GitHub issue #447: "and then it parked" is what this
            // line used to mean. The core runs an idle loop with its own
            // GIC CPU interface and its own timer now, so the assertion
            // that replaces it is the one that could not be made before.
            if (secondary_ticks_independent()) {
                kernel_boot_log(
                    "smp bringup: core1 psci+el1+takibi+own-timer ok\n");
            } else {
                kernel_boot_log("smp bringup: core1 idle but no ticks\n");
            }
            // GitHub issue #445: the first evidence that this kernel's
            // spinlock EXCLUDES. Everything before it was single-threaded
            // exercise and an instruction-level check.
            // GitHub issue #479 Group A. This one currently reports a
            // DEFECT, not a test failure, and says so: freelist.tkb's free
            // chain has no lock and two cores are handed the same index.
            // The line is in the boot every time on purpose -- an open
            // race that only shows up when someone remembers to look is
            // the state this was written to leave behind.
            // GitHub issue #479: the page allocator's own lock. Added
            // after removing that lock changed nothing any lane could
            // see -- an audit is not evidence.
            if (pid_contention_probe()) {
                kernel_boot_log("pid contention: two cores minting, every pid advanced the counter once ok\n");
            } else {
                kernel_boot_log("pid contention: failed\n");
            }
            if (fd_refcount_contention_probe()) {
                kernel_boot_log("fd refcount contention: two cores retaining and releasing one object, count back to baseline ok\n");
            } else {
                kernel_boot_log("fd refcount contention: failed\n");
            }
            if (asid_contention_probe()) {
                kernel_boot_log("asid contention: two cores assigning, every number advanced the counter once ok\n");
            } else {
                kernel_boot_log("asid contention: failed\n");
            }
            if (page_contention_probe()) {
                kernel_boot_log("page contention: two cores allocating and freeing, every page back, none freed twice ok\n");
            } else {
                kernel_boot_log("page contention: failed\n");
            }
            if (freelist_contention_probe()) {
                kernel_boot_log("freelist contention: unlocked hands one index to both cores, a caller's lock stops it ok\n");
            } else {
                kernel_boot_log("freelist contention: failed\n");
            }
            if (pool_contention_probe()) {
                kernel_boot_log("pool contention: two cores cycling one pool, every allocation given back, no handle refused ok\n");
            } else {
                kernel_boot_log("pool contention: failed\n");
            }
        }
        SecondaryBootResult::UnexpectedStatus(status) => {
            kernel_boot_log("smp bringup: core1 unexpected psci status\n");
        }
        SecondaryBootResult::NotStarted(status) => {
            kernel_boot_log("smp bringup: core1 failed\n");
        }
    }

    kernel_test_rpi5_extended = true;
    kernel_test_httpd_daemon = true;
    kernel_test_init_script = true;
    kernel_test_driver_run();

    platform_shutdown();
    while (true) { }
}
