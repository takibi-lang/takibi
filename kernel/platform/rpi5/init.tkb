// GitHub issue #445: which core is asking, as a callable function.
//
// BCM2712 numbers its cores in MPIDR_EL1.Aff1 (bits [9:8]), not Aff0 --
// which is why kernel/platform/rpi5/init.tkb's own CPU_ON target
// affinity for core 1 is 0x100 rather than 0x1, and why
// kernel/arch/arm64/boot/entry.S reads `ubfx x1, x1, #8, #2` where the
// QEMU port reads Aff0. Two bits, matching that ubfx width and this part's
// four cores.
//
// The field choice is the whole reason this is per-platform; see
// kernel/platform/qemu/init.tkb's copy.
fn cpu_id() -> usize {
    return (mrs_mpidr_el1() >> 8) & 3;
}

fn rpi5_psci_cpu_on(target_affinity: usize, entry: usize, context: usize)
        -> usize {
    if (rpi5_psci_use_hvc) {
        return hvc4(0xc4000003, target_affinity, entry, context);
    }
    return smc4(0xc4000003, target_affinity, entry, context);
}

// RPi5 numbers its cores in MPIDR_EL1.Aff1, so core N is target N << 8. The
// context value, 0x190 + N, is what the core checks before it publishes, so
// a coincidental stale write cannot pass for a start.
fn kernel_secondary_boot_cpu_on(core: {0..<KERNEL_MAX_CORES as usize})
        -> usize {
    return rpi5_psci_cpu_on(core << 8, kernel_secondary_entry, 0x190 + core);
}

fn kernel_test_platform_network() {
    match net_init() {
        NetInitResult::Failed => {
            kernel_boot_log("rp1 gem: link failed\n");
        }
        NetInitResult::Ready(link_ready) => {
            kernel_boot_log("rp1 gem: link ready mac=02:00:20:00:00:02\n");
            match kernel_arp_reply_once(link_ready) {
                KernelArpResult::TimedOut(arp_ready) => {
                    kernel_boot_log("rp1 gem: arp timeout\n");
                    net_shutdown(arp_ready);
                }
                KernelArpResult::Replied(arp_ready) => {
                    kernel_boot_log("rp1 gem: arp reply ok ip=192.168.20.2\n");
                    match kernel_icmp_reply_once(arp_ready) {
                        KernelIcmpResult::TimedOut(icmp_ready) => {
                            kernel_boot_log("rp1 gem: icmp timeout\n");
                            net_shutdown(icmp_ready);
                        }
                        KernelIcmpResult::Replied(icmp_ready) => {
                            kernel_boot_log("rp1 gem: icmp echo reply ok ip=192.168.20.2\n");
                            match kernel_tcp_echo_check(icmp_ready) {
                                KernelTcpResult::TimedOut(tcp_ready) => {
                                    kernel_boot_log("rp1 gem: tcp timeout\n");
                                    net_shutdown(tcp_ready);
                                }
                                KernelTcpResult::Verified(tcp_ready) => {
                                    kernel_boot_log("rp1 gem: tcp handshake echo close reconnect ok\n");
                                    match network_capability_install(tcp_ready) {
                                        NetworkCapabilityInstallResult::Installed => {
                                            kernel_boot_log("rp1 gem: rx capability stored for sockets\n");
                                        }
                                        NetworkCapabilityInstallResult::AlreadyInstalled(incoming) => {
                                            net_shutdown(incoming);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// GitHub issue #339: say which stage failed, not just that one did.
//
// The driver answers in values and this is where they become a line, which
// is the whole point of the split: kernel/platform/rpi5/usb_xhci.tkb keeps
// no UART dependency, and a hardware test reading this log learns whether
// to look at the controller, the port, the descriptor, or the drive.
fn kernel_boot_log_usb_init_failure() {
    match usb_disk_init_last_report() {
        UsbInitReportResult::NotRun => {
            kernel_boot_log("usb msc: initialization failed stage=not-run\n");
        }
        UsbInitReportResult::Report(description) => {
            kernel_boot_log("usb msc: initialization failed stage=");
            uart_puts(usb_init_stage_name(description.stage));
            if (description.has_code) {
                kernel_boot_log(" code=");
                uart_put_hex(description.code as usize);
            }
            // Only a retried stage has these, and for one the code above is
            // the FIRST failing status rather than the only one.
            if (description.attempts > 0) {
                kernel_boot_log(" attempts=");
                uart_put_udec(description.attempts);
                kernel_boot_log(" last=");
                uart_put_hex(description.last_code as usize);
            }
            kernel_boot_log("\n");
        }
    }
}

// The board's root filesystem is the USB medium, by the maintainer's decision
// on 2026-09-11: the image is written to the stick and compared back, and the
// stick is what ext2_fixture checks and every process runs from. A failure on
// the way leaves the board with no root filesystem, and says so; there is no
// other copy to fall back to (usb_provision.tkb).
fn kernel_test_platform_storage() {
    match disk_initialize() {
        DiskIoResult::Err(error) => {
            kernel_boot_log_usb_init_failure();
            kernel_boot_log("usb ext2: no root filesystem\n");
            return;
        }
        DiskIoResult::Ok => { }
    }
    kernel_boot_log("usb msc: ready sector=512\n");
    match usb_mass_storage_block_device() {
        KernelBlockDeviceResult::Invalid => {
            kernel_boot_log("usb ext2: device invalid, no root filesystem\n");
        }
        KernelBlockDeviceResult::Ready(usb_device) => {
            disk_reset_write10_command_count();
            let provision_start: i64 = read_cntpct();
            match usb_provision_rootfs(usb_device) {
                UsbProvisionResult::Invalid => {
                    kernel_boot_log("usb ext2: provision failed, no root filesystem\n");
                    return;
                }
                UsbProvisionResult::Copied => { }
            }
            kernel_boot_log("usb ext2: provisioned blocks=2560\n");
            let provision_ticks: i64 = read_cntpct() - provision_start;
            let provision_frequency: i64 = read_cntfrq();
            if (provision_frequency > 0) {
                kernel_boot_log("usb provision metrics: write10_commands=");
                uart_put_udec(disk_write10_command_count());
                kernel_boot_log(" elapsed_ms=");
                uart_put_udec(
                    (provision_ticks * 1000 / provision_frequency) as usize);
                kernel_boot_log("\n");
            } else {
                kernel_boot_log("usb provision metrics: invalid counter frequency\n");
            }
            match usb_provision_rootfs_verify(usb_device) {
                UsbProvisionVerifyResult::Invalid => {
                    kernel_boot_log("usb ext2: provision verify failed, no root filesystem\n");
                    return;
                }
                UsbProvisionVerifyResult::Different => {
                    kernel_boot_log("usb ext2: provision verify mismatch, no root filesystem\n");
                    return;
                }
                UsbProvisionVerifyResult::Equal => {
                    kernel_boot_log("usb ext2: provision verify byte-equal\n");
                }
            }
            kernel_ext2_mount_and_run(usb_device);
        }
    }
}

fn main() !{unsafe} {
    kernel_boot_prologue();

    // The firmware-resolved DTB is part of the arm64 boot contract on this
    // platform. Memory discovery failing means that contract is broken; do
    // not hide a parser or handoff regression behind a second data source.
    kernel_boot_memory_apply();

    match rpi5_system_timer_verify_boot_dtb() {
        Rpi5SystemTimerDtbResult::Invalid => {
            kernel_boot_log("system timer: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5SystemTimerDtbResult::Missing => {
            kernel_boot_log("system timer: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5SystemTimerDtbResult::Verified(base) => {
            kernel_boot_log("system timer: source=dtb base_bytes=");
            uart_put_udec(base);
            kernel_boot_log(" counter_agrees_with_arch=yes\n");
        }
    }

    match rpi5_psci_apply_boot_dtb() {
        Rpi5PsciDtbResult::Invalid => {
            kernel_boot_log("psci: invalid boot DTB method; halting\n");
            while (true) { }
        }
        Rpi5PsciDtbResult::Missing => {
            kernel_boot_log("psci: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5PsciDtbResult::Applied => {
            kernel_boot_log(
                "psci: source=dtb method=smc applied_to_cpu_on=yes\n");
        }
    }

    match rpi5_rp1_uart_boot_dtb_status() {
        Rpi5Rp1UartDtbResult::Invalid => {
            kernel_boot_log("rp1 uart: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5Rp1UartDtbResult::Missing => {
            kernel_boot_log("rp1 uart: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5Rp1UartDtbResult::Verified(base) => {
            kernel_boot_log("rp1 uart: source=dtb base_bytes=");
            uart_put_udec(base);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_pcie2_boot_dtb_status() {
        Rpi5PcieDtbResult::Invalid => {
            kernel_boot_log("pcie2: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5PcieDtbResult::Missing => {
            kernel_boot_log("pcie2: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5PcieDtbResult::Applied(base) => {
            kernel_boot_log("pcie2: source=dtb base_bytes=");
            uart_put_udec(base);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_pcie_support_boot_dtb_status() {
        Rpi5PcieSupportDtbResult::Invalid => {
            kernel_boot_log("pcie support: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5PcieSupportDtbResult::Missing => {
            kernel_boot_log("pcie support: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5PcieSupportDtbResult::Applied(regions) => {
            let (rescal, reset) = regions;
            kernel_boot_log("pcie support: source=dtb rescal_bytes=");
            uart_put_udec(rescal);
            kernel_boot_log(" reset_bytes=");
            uart_put_udec(reset);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_pcie_address_map_boot_dtb_status() {
        Rpi5PcieAddressMapDtbResult::Invalid => {
            kernel_boot_log("pcie map: invalid boot DTB ranges; halting\n");
            while (true) { }
        }
        Rpi5PcieAddressMapDtbResult::Missing => {
            kernel_boot_log("pcie map: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5PcieAddressMapDtbResult::Applied(addresses) => {
            let (outbound_cpu, dma_offset) = addresses;
            kernel_boot_log("pcie map: source=dtb outbound_cpu_bytes=");
            uart_put_udec(outbound_cpu);
            kernel_boot_log(" dma_pci_offset_bytes=");
            uart_put_udec(dma_offset);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_gic_boot_dtb_status() {
        Rpi5GicDtbResult::Invalid => {
            kernel_boot_log("gic: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5GicDtbResult::Missing => {
            kernel_boot_log("gic: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5GicDtbResult::Applied(regions) => {
            let (distributor, cpu_interface) = regions;
            kernel_boot_log("gic: source=dtb distributor_bytes=");
            uart_put_udec(distributor);
            kernel_boot_log(" cpu_interface_bytes=");
            uart_put_udec(cpu_interface);
            kernel_boot_log(" timer_intid=");
            uart_put_udec(rpi5_timer_gic_intid as usize);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_gem_boot_dtb_status() {
        Rpi5GemDtbResult::Invalid => {
            kernel_boot_log("rp1 gem dtb: invalid device; halting\n");
            while (true) { }
        }
        Rpi5GemDtbResult::Missing => {
            kernel_boot_log("rp1 gem dtb: missing device; halting\n");
            while (true) { }
        }
        Rpi5GemDtbResult::Applied(regions) => {
            let (gem, clocks, gpio_ctrl, gpio_rio, gpio_pads) = regions;
            kernel_boot_log("rp1 gem dtb: gem_bytes=");
            uart_put_udec(gem);
            kernel_boot_log(" clocks_bytes=");
            uart_put_udec(clocks);
            kernel_boot_log(" gpio_ctrl_bytes=");
            uart_put_udec(gpio_ctrl);
            kernel_boot_log(" gpio_rio_bytes=");
            uart_put_udec(gpio_rio);
            kernel_boot_log(" gpio_pads_bytes=");
            uart_put_udec(gpio_pads);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_usb_xhci_boot_dtb_status() {
        Rpi5UsbXhciDtbResult::Invalid => {
            kernel_boot_log("rp1 usb0: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5UsbXhciDtbResult::Missing => {
            kernel_boot_log("rp1 usb0: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5UsbXhciDtbResult::Applied(base) => {
            kernel_boot_log("rp1 usb0: source=dtb base_bytes=");
            uart_put_udec(base);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    match rpi5_mip0_boot_dtb_status() {
        Rpi5MipDtbResult::Invalid => {
            kernel_boot_log("mip0: invalid boot DTB device; halting\n");
            while (true) { }
        }
        Rpi5MipDtbResult::Missing => {
            kernel_boot_log("mip0: missing from boot DTB; halting\n");
            while (true) { }
        }
        Rpi5MipDtbResult::Applied(regions) => {
            let (controller, target) = regions;
            kernel_boot_log("mip0: source=dtb controller_bytes=");
            uart_put_udec(controller);
            kernel_boot_log(" target_bytes=");
            uart_put_udec(target);
            kernel_boot_log(" applied_to_driver=yes\n");
        }
    }

    // GitHub issue #187: arms GIC/MIP0/MSI-X routing for UART0 and USB
    // xHCI and unmasks DAIF.I globally. UART0's own PL011 source stays
    // masked until this function's much later irq_uart_rx_unmask() call;
    // USB xHCI's interrupter is already enabled by the time
    // disk_initialize() runs below, so every disk_read/disk_write for the
    // rest of this boot -- including USB xHCI calls interleaved with EL0
    // BusyBox/HTTPd execution -- waits via interrupt_wait() instead of
    // polling. See kernel/platform/rpi5/intc.tkb's header comment for why
    // this is safe now that both the Current-EL-SPx and Lower-EL-AArch64
    // IRQ vector slots are wired.
    platform_irq_init();
    // GitHub issue #454: from here a logged byte is queued rather than spun
    // on. Not before: a byte queued while the TX interrupt is masked would
    // never be drained, which is why this is an explicit switch and not
    // something the console infers.
    kernel_log_tx_activate();

    // GitHub issue #223: the Current-EL-SPx IRQ entry used to save general
    // registers only, so an interrupt taken while EL1 kernel code held live
    // q registers would have destroyed them the moment anything on the
    // dispatch path used SIMD. It now saves the same full exception frame
    // as the EL0 entries; this fixture holds a pattern in q0-q31 and FPSR
    // across a real interrupt whose entry path deliberately scrambles both
    // (kernel/arch/arm64/kernel/fpsimd_probe.S), so the frame is the only
    // thing that can restore them. Runs here, right after the interrupt
    // path comes up, since the timer PPI it waits on is armed by
    // platform_irq_init() above and nothing later depends on it.
    if (fpsimd_irq_probe() == 0) {
        kernel_boot_log("fp/simd irq: q0-q31+fpsr preserved across current-el irq\n");
    } else {
        kernel_boot_log("fp/simd irq: failed\n");
    }

    // GitHub issue #246: page_allocator_init() no longer runs here.
    // kernel/mm/address_space.tkb's kernel_mmu_init() -- called from
    // entry.S's `_start`, before main() -- now calls page_alloc() itself
    // (to back root 0's page tables), so it calls page_allocator_init()
    // as its own first statement instead; see that function's own comment
    // for why calling it a second time here would corrupt root 0 (it
    // would free root 0's three already-in-use pages back into the pool
    // while they are still this kernel's own active page tables).

    kernel_secondary_boot_report();

    kernel_test_rpi5_extended = true;
    kernel_test_httpd_daemon = true;
    kernel_test_init_script = true;
    kernel_test_driver_run();

    // GitHub issue #454: the last flush point the issue names. Nothing after
    // this line runs, so a byte still in the transmit queue would never leave
    // -- the park is exactly the case where "must be on the wire before it
    // proceeds" means "before it stops proceeding at all".
    uart_tx_flush();
    platform_shutdown();
    while (true) { }
}
