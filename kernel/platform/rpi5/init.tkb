use "kernel/platform/rpi5/rp1_gem_dtb.tkb";
use "kernel/platform/rpi5/usb_xhci_dtb.tkb";
use "kernel/platform/rpi5/mip_dtb.tkb";
use "kernel/platform/rpi5/gic_dtb.tkb";
use "kernel/platform/rpi5/psci_dtb.tkb";
