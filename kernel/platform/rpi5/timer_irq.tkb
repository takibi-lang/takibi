// ARM Generic Timer (CNTP_EL0, non-secure EL1 physical timer) interrupt,
// GitHub issue #187 follow-up. This is the architectural PPI #30, the same
// INTID examples/common_qemu/gic.tkb's gic_enable_timer_ppi() and
// examples/common_rpi3/timer.tkb's scheduler group both use -- PPIs are
// banked per-CPU by the GIC itself, so unlike UART0/USB0's SPIs this needs
// no RP1/MIP0 routing and no GICD_ITARGETSR write.
//
// kernel/arch/arm64/kernel/timer.tkb's set_cntp_tval/enable_cntp/disable_cntp
// (GitHub issue #226; originally hand-written timer.S stubs, staged ahead
// of this work -- their own header comment already named "the RPi5
// scheduler port" as the reason they exist) were never called from any
// .tkb file until now.
//
// This tick first existed as RP1 GEM Ethernet's periodic wake source:
// net_rx_wait() needs it so it can use
// interrupt_wait() without losing the bounded-timeout behavior its
// callers' own CNTPCT-based deadline loops (kernel/net/{arp,icmp,tcp}.tkb,
// unchanged) depend on -- including the silent-negative ARP/ICMP checks
// and the SYN-ACK-drop-recovery test. A real GEM RX interrupt (once wired)
// wakes net_rx_wait() immediately when a packet actually arrives; this
// timer guarantees a wake roughly every tick even when nothing does, so
// the caller's own deadline check still runs regularly instead of net_rx_
// wait() blocking indefinitely. Issue #188 subsequently made the same PPI
// the EL0 preemption tick; Current-EL ticks request a deferred switch at the
// syscall-return boundary, while Lower-EL ticks may select another runnable
// context immediately.

const RPI5_GICD_BASE: usize = 0x107FFF9000;
const RPI5_GICC_BASE: usize = 0x107FFFA000;
let mut rpi5_gicd_base: usize = RPI5_GICD_BASE;
let mut rpi5_gicc_base: usize = RPI5_GICC_BASE;
let mut rpi5_gic_dtb_status: usize;

const RPI5_TIMER_GIC_INTID: u32 = 30;
let mut rpi5_timer_gic_intid: u32 = RPI5_TIMER_GIC_INTID;

fn gic_timer_ppi_enable() !{unsafe} {
    let gicd_isenabler0: *io u32 = unsafe {
        (rpi5_gicd_base + 0x100) as *io u32
    };
    *gicd_isenabler0 = *gicd_isenabler0 |
        (1 << rpi5_timer_gic_intid);
}
