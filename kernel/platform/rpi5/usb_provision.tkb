use "kernel/drivers/block/memory.tkb";
use "kernel/lib/lz4_image.tkb";

// The board's root filesystem is the USB medium, and this file is the only
// place the embedded image exists: it is copied to the stick at boot and
// compared back, and nothing else can reach it. There is no memory backend in
// KernelBlockDevice, so ext2_mount cannot be handed the image -- the board
// used to mount the stick for a few checks and then run every process from
// this image, and nobody noticed for as long as the two started identical.
//
// The QEMU kernel does not `use` this file, so it carries no image at all:
// its root is the virtio disk, or nothing.
//
// GitHub issue #1218: the image is embedded compressed
// (kernel/build/user/ext2.tkz, scripts/lz4_image.py: zero blocks elided,
// the rest LZ4 in 64-block chunks), because the board loads the kernel over
// SWD at about 187 KiB/s and the raw 6 MiB image was most of that load. Each
// chunk is expanded into usb_provision_expanded, the size of one USB batch,
// so the image never exists whole in memory. The container's own length is
// whatever the build produced; the chunk count is checked against the
// extent below.
private let usb_provision_container = embed_file("kernel/build/user/ext2.tkz");

const USB_PROVISION_BLOCKS: usize = KERNEL_EXT2_IMAGE_LEN / KERNEL_BLOCK_SIZE;
const USB_PROVISION_CHUNKS: usize = USB_PROVISION_BLOCKS / KERNEL_BLOCK_BATCH;

must_use variant UsbProvisionResult { Invalid; Copied; }
must_use variant UsbProvisionVerifyResult { Invalid; Different; Equal; }

// Exclusive bound for the 64 * 1024-byte batch. A literal const is usable
// in the refined type that proves the dynamic prefix below.
const USB_PROVISION_BATCH_BOUND: usize = 65537;
private let mut usb_provision_batch:
    [u8; USB_PROVISION_BATCH_BOUND - 1];
// One expanded chunk: what usb_provision_rootfs writes, and what
// usb_provision_rootfs_verify compares the read-back batch with.
private let mut usb_provision_expanded: [u8; LZ4_IMAGE_CHUNK_BYTES];

// The provisioning batch and the container's chunk are one geometry, and
// the extent is whole chunks, so every batch is a full chunk.
private fn usb_provision_geometry_holds() {
    static_assert(KERNEL_BLOCK_BATCH == LZ4_IMAGE_CHUNK_BLOCKS);
    static_assert(KERNEL_BLOCK_SIZE == LZ4_IMAGE_BLOCK_SIZE);
    static_assert(LZ4_IMAGE_CHUNK_BYTES == USB_PROVISION_BATCH_BOUND - 1);
    static_assert(USB_PROVISION_CHUNKS * KERNEL_BLOCK_BATCH ==
                  USB_PROVISION_BLOCKS);
}

must_use variant UsbProvisionChunkResult {
    Invalid;
    // The cursor of the next chunk.
    Next(usize);
}

private fn usb_provision_expand(cursor: usize) -> UsbProvisionChunkResult {
    match lz4_image_expand_chunk(usb_provision_container as []const u8,
                                 cursor, usb_provision_expanded as []u8) {
        Lz4ImageChunkResult::Invalid => { return UsbProvisionChunkResult::Invalid; }
        Lz4ImageChunkResult::Expanded(next) => {
            return UsbProvisionChunkResult::Next(next);
        }
    }
}

private fn usb_provision_container_holds_extent() -> bool {
    match lz4_image_header(usb_provision_container as []const u8) {
        Lz4ImageHeaderResult::Invalid => { return false; }
        Lz4ImageHeaderResult::Chunks(count) => {
            return count == USB_PROVISION_CHUNKS;
        }
    }
}

// Write the image to the stick in bounded multi-sector WRITE(10) batches.
// A batch the device refuses is retried in progressively smaller runs, so a
// device with a lower practical maximum keeps most of the batching benefit;
// replaying a range is content-idempotent, and the one-block case uses the
// single-sector path.
fn usb_provision_rootfs(destination: KernelBlockDevice) -> UsbProvisionResult {
    if (block_device_is_usb(destination) == false ||
        USB_PROVISION_BLOCKS > block_count(destination)) {
        return UsbProvisionResult::Invalid;
    }
    // These writes go around block_write, so every cached copy is retired
    // before and after them (GitHub issue #208).
    if (usb_provision_container_holds_extent() == false) {
        return UsbProvisionResult::Invalid;
    }
    block_forget_all();
    let mut cursor: usize = LZ4_IMAGE_HEADER_BYTES;
    let mut first_block: usize = 0;
    while (first_block < USB_PROVISION_BLOCKS) {
        let batch: usize = KERNEL_BLOCK_BATCH;
        match usb_provision_expand(cursor) {
            UsbProvisionChunkResult::Invalid => { return UsbProvisionResult::Invalid; }
            UsbProvisionChunkResult::Next(next) => { cursor = next; }
        }
        slice_copy(usb_provision_batch as []u8,
                   usb_provision_expanded as []const u8);
        let bytes = usb_provision_batch as []u8;
        let transfer_length: usize = batch * KERNEL_BLOCK_SIZE;
        if (transfer_length > bytes.len) {
            return UsbProvisionResult::Invalid;
        }
        let mut transfer: []u8;
        if (transfer_length >= 0 && transfer_length <
            USB_PROVISION_BATCH_BOUND) {
            let bounded_length:
                {0..<USB_PROVISION_BATCH_BOUND as usize} = transfer_length;
            transfer = bytes[0..<bounded_length];
        } else {
            return UsbProvisionResult::Invalid;
        }
        match disk_write_sectors((first_block * 2) as u32, transfer) {
            DiskIoResult::Err(error) => {
                let mut fallback_offset: usize = 0;
                let mut fallback_blocks: usize = batch / 2;
                if (fallback_blocks == 0) {
                    fallback_blocks = 1;
                }
                while (fallback_offset < batch) {
                    let mut transfer_blocks: usize = fallback_blocks;
                    if (transfer_blocks > batch - fallback_offset) {
                        transfer_blocks = batch - fallback_offset;
                    }
                    let block_offset: usize =
                        fallback_offset * KERNEL_BLOCK_SIZE;
                    let transfer_length: usize =
                        transfer_blocks * KERNEL_BLOCK_SIZE;
                    if (block_offset > bytes.len) {
                        return UsbProvisionResult::Invalid;
                    }
                    let remaining = bytes[block_offset..<bytes.len];
                    if (transfer_length > remaining.len) {
                        return UsbProvisionResult::Invalid;
                    }
                    let block_bytes = remaining[0..<transfer_length];
                    if (transfer_blocks == 1) {
                        if (block_bytes.len < KERNEL_BLOCK_SIZE) {
                            return UsbProvisionResult::Invalid;
                        }
                        match disk_write(
                                ((first_block + fallback_offset) * 2) as u32,
                                block_bytes[0..<512]) {
                            DiskIoResult::Err(single_error) => {
                                return UsbProvisionResult::Invalid;
                            }
                            DiskIoResult::Ok => { }
                        }
                        match disk_write(
                                ((first_block + fallback_offset) * 2 + 1) as u32,
                                block_bytes[512..<KERNEL_BLOCK_SIZE]) {
                            DiskIoResult::Err(single_error) => {
                                return UsbProvisionResult::Invalid;
                            }
                            DiskIoResult::Ok => { }
                        }
                        fallback_offset = fallback_offset + 1;
                    } else {
                        match disk_write_sectors(
                                ((first_block + fallback_offset) * 2) as u32,
                                block_bytes) {
                            DiskIoResult::Err(smaller_error) => {
                                fallback_blocks = transfer_blocks / 2;
                                if (fallback_blocks == 0) {
                                    fallback_blocks = 1;
                                }
                            }
                            DiskIoResult::Ok => {
                                fallback_offset = fallback_offset +
                                                   transfer_blocks;
                            }
                        }
                    }
                }
            }
            DiskIoResult::Ok => { }
        }
        first_block = first_block + batch;
    }
    block_forget_all();
    return UsbProvisionResult::Copied;
}

// Read the stick back in the same 64 KiB ranges and compare it with the
// image byte for byte, without issuing 5120 single-sector reads. The image
// side is a second expansion of the container, so this checks the USB path,
// not the codec; the build checks the container against ext2.img
// (scripts/lz4_image.py pack) and linux_user/lz4 checks the decoder.
fn usb_provision_rootfs_verify(destination: KernelBlockDevice)
        -> UsbProvisionVerifyResult {
    if (block_device_is_usb(destination) == false ||
        USB_PROVISION_BLOCKS > block_count(destination)) {
        return UsbProvisionVerifyResult::Invalid;
    }
    if (usb_provision_container_holds_extent() == false) {
        return UsbProvisionVerifyResult::Invalid;
    }
    let mut cursor: usize = LZ4_IMAGE_HEADER_BYTES;
    let mut first_block: usize = 0;
    while (first_block < USB_PROVISION_BLOCKS) {
        let batch: usize = KERNEL_BLOCK_BATCH;
        let bytes = usb_provision_batch as []u8;
        let transfer_length: usize = batch * KERNEL_BLOCK_SIZE;
        if (transfer_length > bytes.len) {
            return UsbProvisionVerifyResult::Invalid;
        }
        let mut transfer: []u8;
        if (transfer_length >= 0 && transfer_length <
            USB_PROVISION_BATCH_BOUND) {
            let bounded_length:
                {0..<USB_PROVISION_BATCH_BOUND as usize} = transfer_length;
            transfer = bytes[0..<bounded_length];
        } else {
            return UsbProvisionVerifyResult::Invalid;
        }
        match disk_read_sectors((first_block * 2) as u32, transfer) {
            DiskIoResult::Err(error) => {
                return UsbProvisionVerifyResult::Invalid;
            }
            DiskIoResult::Ok => { }
        }
        match usb_provision_expand(cursor) {
            UsbProvisionChunkResult::Invalid => {
                return UsbProvisionVerifyResult::Invalid;
            }
            UsbProvisionChunkResult::Next(next) => { cursor = next; }
        }
        if (slice_eq(usb_provision_batch as []const u8,
                     usb_provision_expanded as []const u8) == false) {
            return UsbProvisionVerifyResult::Different;
        }
        first_block = first_block + batch;
    }
    return UsbProvisionVerifyResult::Equal;
}
