must_use variant Rpi5MipDtbResult {
    Invalid;
    Missing;
    Applied((usize, usize));
}

fn rpi5_mip0_apply_boot_dtb(phase: borrow BootPhase[boot]) -> Rpi5MipDtbResult !{unsafe} {
    let dtb: usize = boot_dtb_address_read();
    match fdt_find_compatible_mip_regions(
            dtb, bs"brcm,bcm2712-mip", 0x1000130000) {
        FdtMipRegionsResult::Invalid => {
            boot_once_set(&rpi5_mip0_dtb_status, phase, 1);
            return Rpi5MipDtbResult::Invalid;
        }
        FdtMipRegionsResult::NotFound => {
            boot_once_set(&rpi5_mip0_dtb_status, phase, 2);
            return Rpi5MipDtbResult::Missing;
        }
        FdtMipRegionsResult::Found(regions) => {
            if (regions.controller.base != RPI5_MIP0_BASE ||
                regions.controller.size < 0xC0 ||
                regions.target.base != RPI5_MIP0_TARGET ||
                regions.target.size < 0x1000) {
                boot_once_set(&rpi5_mip0_dtb_status, phase, 1);
                return Rpi5MipDtbResult::Invalid;
            }
            match rpi5_mip0_attach(phase, regions.controller.base, regions.controller.size) {
                Rpi5Attach::Attached => {}
                Rpi5Attach::Refused => {
                    boot_once_set(&rpi5_mip0_dtb_status, phase, 1);
                    return Rpi5MipDtbResult::Invalid;
                }
            }
            boot_once_set(&rpi5_mip0_target, phase, regions.target.base);
            boot_once_set(&rpi5_mip0_dtb_status, phase, 3);
            return Rpi5MipDtbResult::Applied((
                boot_once_get(&rpi5_mip0_base), boot_once_get(&rpi5_mip0_target)));
        }
    }
}

fn rpi5_mip0_boot_dtb_status() -> Rpi5MipDtbResult {
    if (boot_once_get(&rpi5_mip0_dtb_status) == 3) {
        return Rpi5MipDtbResult::Applied((
            boot_once_get(&rpi5_mip0_base), boot_once_get(&rpi5_mip0_target)));
    }
    if (boot_once_get(&rpi5_mip0_dtb_status) == 2) { return Rpi5MipDtbResult::Missing; }
    return Rpi5MipDtbResult::Invalid;
}
