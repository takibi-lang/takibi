// GitHub issue #720 option (a), slice 2: the xHCI producer rings (Command,
// EP0, bulk IN, bulk OUT) as owners of one tx device protocol. This file is
// a device-semantics file (kernel/DEVICE_SEMANTICS_FILES): its two
// observations are the trusted claims that end the controller's access to
// a ring --
//   - xhci_ring_event: usb_await_event returned a nonzero completion code
//     from an event that matches the ring's request exactly -- its TRB
//     Pointer inside the request's TRBs, and for a transfer its slot and
//     endpoint (kernel/drivers/usb/xhci_event_match.tkb). The driver is synchronous: one TD or command
//     is outstanding per ring, and its event (a completed error such as a
//     STALL included, xHCI 1.2 4.11.3.1) means the controller has stopped
//     at a TRB whose Cycle bit it does not own;
//   - xhci_ring_reset_seen: xhci_halt_and_reset confirmed HCHalted and
//     HCRST since the ring was published (xhci_rings_quiesced), after which
//     no ring is fetched (xHCI 1.2, 5.4.1.1).
// The Ready state is `addressed`: a ring's own address goes into its Link
// TRB and into CRCR or an endpoint context while the CPU still writes the
// ring. That is safe on the trusted fact that the controller fetches a
// ring only after its doorbell, and the only doorbell for a ring is rung
// by xhci_ring_publish below, after the generated clean.
//
// Each ring's owner lives in one slot of xhci_ring_slots between calls;
// a ring whose request was not observed stays InFlight there until a
// confirmed reset. The four backing arrays are region backing globals, so
// no other code can reach their storage.

use "kernel/lib/mutex.tkb";

const XHCI_RING_TRBS: usize = 16;
const XHCI_RING_CMD: usize = 0;
const XHCI_RING_EP0: usize = 1;
const XHCI_RING_BULK_IN: usize = 2;
const XHCI_RING_BULK_OUT: usize = 3;

protocol XhciRing[inst: usize] retains region(Trb)[b, XHCI_RING_TRBS] tx {
    state Ready access write addressed;
    state InFlight[req] device;
    init Ready;
    transition xhci_ring_publish(Ready) -> InFlight[fresh req];
    observe xhci_ring_event(InFlight[req]) -> Completed[req] completes | Silent;
    transition xhci_ring_complete(InFlight[req], Completed[req]) -> Ready;
    observe xhci_ring_reset_seen(InFlight[req]) -> Quiet[req] quiesces | Live;
    transition xhci_ring_reclaim(InFlight[req], Quiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

private region let mut xhci_cmd_ring: [Trb; 16] align(64);
private region let mut xhci_ep0_ring: [Trb; 16] align(64);
private region let mut xhci_bulk_in_ring: [Trb; 16] align(64);
private region let mut xhci_bulk_out_ring: [Trb; 16] align(64);

// What the next publication rings and waits for (set by xhci_ring_run).
private let mut xhci_doorbell_target: usize = 0;
private let mut xhci_doorbell_value: u32 = 0;
private let mut xhci_await_want: XhciEventWant = { 0, 0, 0, 0, 0 };
private let mut xhci_await_timeout: usize = 0;
private let mut xhci_await_cc: u32 = 0;
// Command Completion Events observed on the Command ring (xhci_input_used).
private let mut xhci_cmd_completions: usize = 0;
private let mut xhci_rings_claimed: bool = false;
// Set by xhci_halt_and_reset when HCHalted and HCRST are confirmed, and
// cleared when the controller runs again.
let mut xhci_rings_quiesced: bool = false;

// The doorbell: runs after the clean and the state change.
fn xhci_ring_publish(s: borrow XhciRing_InFlight[b, o, 16, r]) {
    xhci_ring_doorbell(xhci_doorbell_target, xhci_doorbell_value);
}
fn xhci_ring_event(s: borrow XhciRing_InFlight[b, o, 16, r])
        -> XhciRing_xhci_ring_event_Raw !{unsafe} {
    xhci_await_cc = usb_await_event(xhci_await_want, xhci_await_timeout);
    if (xhci_await_cc == 0) { return XhciRing_xhci_ring_event_Raw::Silent; }
    return XhciRing_xhci_ring_event_Raw::Completed;
}
fn xhci_ring_complete(s: borrow XhciRing_InFlight[b, o, 16, r]) {}
fn xhci_ring_reset_seen(s: borrow XhciRing_InFlight[b, o, 16, r])
        -> XhciRing_xhci_ring_reset_seen_Raw {
    if (xhci_rings_quiesced) { return XhciRing_xhci_ring_reset_seen_Raw::Quiet; }
    return XhciRing_xhci_ring_reset_seen_Raw::Live;
}
fn xhci_ring_reclaim(s: borrow XhciRing_InFlight[b, o, 16, r]) {}

variant XhciRingHeld {
    Ready(exists b: addr. exists o: usize. XhciRing_Ready[b, o, 16]);
    InFlight(exists b: addr. exists o: usize. exists r: usize.
             XhciRing_InFlight[b, o, 16, r]);
}

struct XhciRingSlot {
    private mutex: Mutex;
    private value: Place(XhciRingHeld);
}
private let mut xhci_ring_slots: [XhciRingSlot; 4];

private linear struct XhciRingGuard[lock: addr] { private flags: usize; }

private fn xhci_ring_lock(lock: *Mutex @ address) -> XhciRingGuard[address]
        !{acquires_lock_40_xhci_ring, lock_guard_40_xhci_ring} {
    let mut guard: XhciRingGuard[address] = { mutex_acquire(lock) };
    return guard;
}

private fn xhci_ring_unlock(guard: sink XhciRingGuard[address],
                            lock: *Mutex @ address) {
    mutex_release(lock, guard.flags);
}

// A slot never holds two owners; a displaced one is an invariant breach.
private fn xhci_ring_lost(held: sink XhciRingHeld) {
    kernel_invariant_stop();
}

private fn xhci_ring_take(i: usize) -> Place(XhciRingHeld) {
    if (i >= 4) { return Place::Empty; }
    let guard = xhci_ring_lock(&xhci_ring_slots[i].mutex);
    let taken: Place(XhciRingHeld) = place_take(
        guard, &xhci_ring_slots[i].mutex, xhci_ring_slots[i].value);
    xhci_ring_unlock(guard, &xhci_ring_slots[i].mutex);
    return taken;
}

private fn xhci_ring_park(i: usize, held: XhciRingHeld) {
    if (i >= 4) {
        xhci_ring_lost(held);
        return;
    }
    let guard = xhci_ring_lock(&xhci_ring_slots[i].mutex);
    let previous: Place(XhciRingHeld) = place_put(
        guard, &xhci_ring_slots[i].mutex, xhci_ring_slots[i].value, held);
    xhci_ring_unlock(guard, &xhci_ring_slots[i].mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_ring_lost(other); }
    }
}

// The ring's bus address, from its own span.
private fn xhci_ring_base_dma(r: borrow XhciRing_Ready[b, o, 16]) -> usize !{unsafe} {
    let mut span: DmaDeviceSpan = XhciRing_Ready_span(r);
    return xhci_span_bus_address(span);
}

// Every TRB zeroed (no stale Cycle bit survives a reset) and the Link TRB
// pointing back at index 0 with Cycle=1 and Toggle Cycle.
private fn xhci_ring_format(r: borrow XhciRing_Ready[b, o, 16]) !{unsafe} {
    for k: usize in 0..<15 {
        let mut zero: Trb = { 0, 0, 0, 0 };
        XhciRing_Ready_write(r, k, zero);
    }
    let dma: usize = xhci_ring_base_dma(r);
    let mut link: Trb = {
        (dma & 0xFFFFFFFF) as u32, ((dma >> 32) & 0xFFFFFFFF) as u32, 0, 0x00001803
    };
    XhciRing_Ready_write(r, 15, link);
}

private fn xhci_ring_claim(i: usize, memory: region(Trb)[b, 16]) {
    let ready = XhciRing_init(memory);
    xhci_ring_park(i, XhciRingHeld::Ready(ready));
}

// The four rings, claimed once per boot.
private fn xhci_rings_claim() -> bool {
    if (xhci_rings_claimed) { return true; }
    xhci_rings_claimed = true;
    let RegionOf(Trb)::Taken(cmd) = region_of(xhci_cmd_ring) else {
        RegionOf(Trb)::Gone => { return false; }
    };
    xhci_ring_claim(XHCI_RING_CMD, cmd);
    let RegionOf(Trb)::Taken(ep0) = region_of(xhci_ep0_ring) else {
        RegionOf(Trb)::Gone => { return false; }
    };
    xhci_ring_claim(XHCI_RING_EP0, ep0);
    let RegionOf(Trb)::Taken(bulk_in) = region_of(xhci_bulk_in_ring) else {
        RegionOf(Trb)::Gone => { return false; }
    };
    xhci_ring_claim(XHCI_RING_BULK_IN, bulk_in);
    let RegionOf(Trb)::Taken(bulk_out) = region_of(xhci_bulk_out_ring) else {
        RegionOf(Trb)::Gone => { return false; }
    };
    xhci_ring_claim(XHCI_RING_BULK_OUT, bulk_out);
    return true;
}

// One ring back to Ready and formatted for a new controller session. An
// InFlight ring comes back only on a confirmed reset; otherwise it stays
// with the device and the session cannot start.
private fn xhci_ring_restart(i: usize) -> bool !{unsafe} {
    match xhci_ring_take(i) {
        Place::Empty => { return false; }
        Place::Full(held) => {
            match held {
                XhciRingHeld::Ready(ready) => {
                    xhci_ring_format(ready);
                    xhci_ring_park(i, XhciRingHeld::Ready(ready));
                    return true;
                }
                XhciRingHeld::InFlight(flight) => {
                    match XhciRing_xhci_ring_reset_seen(flight) {
                        XhciRing_xhci_ring_reset_seen_Outcome::Quiet(quiet) => {
                            let ready = XhciRing_xhci_ring_reclaim(flight, quiet);
                            xhci_ring_format(ready);
                            xhci_ring_park(i, XhciRingHeld::Ready(ready));
                            return true;
                        }
                        XhciRing_xhci_ring_reset_seen_Outcome::Live => {
                            xhci_ring_park(i, XhciRingHeld::InFlight(flight));
                            return false;
                        }
                    }
                }
            }
        }
    }
}

// All four rings, after a confirmed halt and reset (or at first claim).
fn xhci_rings_restart() -> bool !{unsafe} {
    if (xhci_rings_claim() == false) { return false; }
    let cmd_ok: bool = xhci_ring_restart(XHCI_RING_CMD);
    let ep0_ok: bool = xhci_ring_restart(XHCI_RING_EP0);
    let in_ok: bool = xhci_ring_restart(XHCI_RING_BULK_IN);
    let out_ok: bool = xhci_ring_restart(XHCI_RING_BULK_OUT);
    return cmd_ok && ep0_ok && in_ok && out_ok;
}

variant XhciRingAddress {
    Known(usize);
    Busy;
}

// A Ready ring's bus address (for CRCR, an endpoint context or a Set TR
// Dequeue Pointer command); Busy while the controller may own it.
fn xhci_ring_dma(i: usize) -> XhciRingAddress !{unsafe} {
    match xhci_ring_take(i) {
        Place::Empty => { return XhciRingAddress::Busy; }
        Place::Full(held) => {
            match held {
                XhciRingHeld::Ready(ready) => {
                    let dma: usize = xhci_ring_base_dma(ready);
                    xhci_ring_park(i, XhciRingHeld::Ready(ready));
                    return XhciRingAddress::Known(dma);
                }
                XhciRingHeld::InFlight(flight) => {
                    xhci_ring_park(i, XhciRingHeld::InFlight(flight));
                    return XhciRingAddress::Busy;
                }
            }
        }
    }
}

// Write one TRB of a Ready ring. False when the index is past the ring or
// the controller may own the ring.
fn xhci_ring_put(i: usize, index: usize, trb: Trb) -> bool {
    match xhci_ring_take(i) {
        Place::Empty => { return false; }
        Place::Full(held) => {
            match held {
                XhciRingHeld::Ready(ready) => {
                    let mut ok: bool = false;
                    if (index < 16) {
                        XhciRing_Ready_write(ready, index, trb);
                        ok = true;
                    }
                    xhci_ring_park(i, XhciRingHeld::Ready(ready));
                    return ok;
                }
                XhciRingHeld::InFlight(flight) => {
                    xhci_ring_park(i, XhciRingHeld::InFlight(flight));
                    return false;
                }
            }
        }
    }
}

// Close out a ring segment (see xhci_ring_close_segment's comment in
// usb_xhci.tkb): No-Op TRBs with the current cycle from `from` up to the
// Link TRB, then the Link TRB republished with the current cycle.
fn xhci_ring_close(i: usize, from: usize, cycle: u32,
                   noop_type: u32) -> bool !{unsafe} {
    match xhci_ring_take(i) {
        Place::Empty => { return false; }
        Place::Full(held) => {
            match held {
                XhciRingHeld::Ready(ready) => {
                    for k: usize in 0..<15 {
                        if (k >= from) {
                            let mut noop: Trb = { 0, 0, 0, cycle | (noop_type << 10) };
                            XhciRing_Ready_write(ready, k, noop);
                        }
                    }
                    let dma: usize = xhci_ring_base_dma(ready);
                    let mut link: Trb = {
                        (dma & 0xFFFFFFFF) as u32, ((dma >> 32) & 0xFFFFFFFF) as u32,
                        0, cycle | (1 << 1) | (6 << 10)
                    };
                    XhciRing_Ready_write(ready, 15, link);
                    xhci_ring_park(i, XhciRingHeld::Ready(ready));
                    return true;
                }
                XhciRingHeld::InFlight(flight) => {
                    xhci_ring_park(i, XhciRingHeld::InFlight(flight));
                    return false;
                }
            }
        }
    }
}

// Publish a ring (clean, then the doorbell) and wait for the event of the
// request in TRBs first..last of it: a Command Completion Event on the
// Command ring, else a Transfer Event for slot `target`, endpoint `value`
// (the doorbell's own target and DCI). Returns the completion code; 0
// means no matching event, and the ring then stays with the controller
// until a confirmed reset.
fn xhci_ring_run(i: usize, target: usize, value: u32, first: usize,
                 last: usize, timeout: usize) -> u32 !{unsafe} {
    match xhci_ring_take(i) {
        Place::Empty => { return 0; }
        Place::Full(held) => {
            match held {
                XhciRingHeld::InFlight(stale) => {
                    xhci_ring_park(i, XhciRingHeld::InFlight(stale));
                    return 0;
                }
                XhciRingHeld::Ready(ready) => {
                    xhci_doorbell_target = target;
                    xhci_doorbell_value = value;
                    let base: usize = xhci_ring_base_dma(ready);
                    if (i == XHCI_RING_CMD) {
                        xhci_await_want = xhci_event_want_command(base + first * 16);
                    } else {
                        xhci_await_want = xhci_event_want_transfer(
                            base + first * 16, base + last * 16,
                            target as u32, value);
                    }
                    xhci_await_timeout = timeout;
                    match XhciRing_xhci_ring_publish(ready) {
                        XhciRing_xhci_ring_publish_Result::InFlight(flight) => {
                            match XhciRing_xhci_ring_event(flight) {
                                XhciRing_xhci_ring_event_Outcome::Completed(done) => {
                                    if (i == XHCI_RING_CMD) {
                                        xhci_cmd_completions = xhci_cmd_completions + 1;
                                    }
                                    let back = XhciRing_xhci_ring_complete(flight, done);
                                    xhci_ring_park(i, XhciRingHeld::Ready(back));
                                    return xhci_await_cc;
                                }
                                XhciRing_xhci_ring_event_Outcome::Silent => {
                                    xhci_ring_park(i, XhciRingHeld::InFlight(flight));
                                    return 0;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// -- Session tables and the input context (GitHub issue #720, slice 3a) --
//
// The scratchpad buffers and their array, and the Event Ring Segment
// Table, are given to the controller for a whole session: each is written
// while Ready, published once at start (generated clean, or prepare for
// the device-written scratchpad buffers), and comes back only on the
// confirmed halt and reset (xhci_rings_quiesced), like a producer ring
// with no event. The input context is published before each Address
// Device or Configure Endpoint command and comes back on that command's
// completion: xhci_input_used trusts that the first Command Completion
// Event after publication (xhci_cmd_completions advanced) belongs to the
// command that read it, which holds because every caller publishes it
// immediately before issuing that one command.
//
// Not here, and still legacy in usb_xhci.tkb: the DCBAA (its slot entry
// is written while the controller holds the table, which a whole-region
// owner cannot express), the output device context and the event ring
// (both rewritten by the controller throughout a session).

const XHCI_SCRATCH_ENTRIES: usize = 8;
const XHCI_ERST_ENTRIES: usize = 4;
const XHCI_SCRATCH_BYTES: usize = 4096;
const XHCI_INPUT_WORDS: usize = 528;

// A 64-bit bus pointer as the controller reads it (scratchpad array).
struct XhciPtr { lo: u32; hi: u32; }
// One Event Ring Segment Table entry.
struct ErstEntry { base_lo: u32; base_hi: u32; size: u32; reserved: u32; }
// One 32-bit word of the input context.
struct CtxWord { v: u32; }

protocol XhciErst[inst: usize] retains region(ErstEntry)[b, XHCI_ERST_ENTRIES] tx {
    state Ready access write addressed;
    state Live[req] device;
    init Ready;
    transition xhci_erst_publish(Ready) -> Live[fresh req];
    observe xhci_erst_reset(Live[req]) -> ErstQuiet[req] quiesces | ErstLive;
    transition xhci_erst_reclaim(Live[req], ErstQuiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

protocol XhciScratchArray[inst: usize] retains region(XhciPtr)[b, XHCI_SCRATCH_ENTRIES] tx {
    state Ready access write addressed;
    state Live[req] device;
    init Ready;
    transition xhci_scratch_array_publish(Ready) -> Live[fresh req];
    observe xhci_scratch_array_reset(Live[req]) -> ArrayQuiet[req] quiesces | ArrayLive;
    transition xhci_scratch_array_reclaim(Live[req], ArrayQuiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

protocol XhciScratchBuf[inst: usize] retains region(u8)[b, XHCI_SCRATCH_BYTES] rx {
    state Ready access write addressed;
    state Live[req] device;
    init Ready;
    transition xhci_scratch_buf_publish(Ready) -> Live[fresh req];
    observe xhci_scratch_buf_reset(Live[req]) -> BufQuiet[req] quiesces | BufLive;
    transition xhci_scratch_buf_reclaim(Live[req], BufQuiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

protocol XhciInput[inst: usize] retains region(CtxWord)[b, XHCI_INPUT_WORDS] tx {
    state Ready access write addressed;
    state Read[req] device;
    init Ready;
    transition xhci_input_publish(Ready) -> Read[fresh req];
    observe xhci_input_used(Read[req]) -> InputDone[req] completes | InputPending;
    transition xhci_input_done(Read[req], InputDone[req]) -> Ready;
    observe xhci_input_reset(Read[req]) -> InputQuiet[req] quiesces | InputLive;
    transition xhci_input_reclaim(Read[req], InputQuiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

private region let mut xhci_erst: [ErstEntry; 4] align(64);
private region let mut xhci_scratchpad_array: [XhciPtr; 8] align(64);
private region let mut xhci_scratchpad_buf0: [u8; 4096] align(4096);
private region let mut xhci_scratchpad_buf1: [u8; 4096] align(4096);
private region let mut xhci_input_ctx: [CtxWord; 528] align(64);

private let mut xhci_input_published_at: usize = 0;

// Lowerings. Publishing a session table rings nothing: the register
// writes that follow point the controller at it, before Run.
fn xhci_erst_publish(s: borrow XhciErst_Live[b, o, 4, r]) {}
fn xhci_erst_reset(s: borrow XhciErst_Live[b, o, 4, r]) -> XhciErst_xhci_erst_reset_Raw {
    if (xhci_rings_quiesced) { return XhciErst_xhci_erst_reset_Raw::ErstQuiet; }
    return XhciErst_xhci_erst_reset_Raw::ErstLive;
}
fn xhci_erst_reclaim(s: borrow XhciErst_Live[b, o, 4, r]) {}
fn xhci_scratch_array_publish(s: borrow XhciScratchArray_Live[b, o, 8, r]) {}
fn xhci_scratch_array_reset(s: borrow XhciScratchArray_Live[b, o, 8, r])
        -> XhciScratchArray_xhci_scratch_array_reset_Raw {
    if (xhci_rings_quiesced) {
        return XhciScratchArray_xhci_scratch_array_reset_Raw::ArrayQuiet;
    }
    return XhciScratchArray_xhci_scratch_array_reset_Raw::ArrayLive;
}
fn xhci_scratch_array_reclaim(s: borrow XhciScratchArray_Live[b, o, 8, r]) {}
fn xhci_scratch_buf_publish(s: borrow XhciScratchBuf_Live[b, o, 4096, r]) {}
fn xhci_scratch_buf_reset(s: borrow XhciScratchBuf_Live[b, o, 4096, r])
        -> XhciScratchBuf_xhci_scratch_buf_reset_Raw {
    if (xhci_rings_quiesced) { return XhciScratchBuf_xhci_scratch_buf_reset_Raw::BufQuiet; }
    return XhciScratchBuf_xhci_scratch_buf_reset_Raw::BufLive;
}
fn xhci_scratch_buf_reclaim(s: borrow XhciScratchBuf_Live[b, o, 4096, r]) {}
fn xhci_input_publish(s: borrow XhciInput_Read[b, o, 528, r]) {
    xhci_input_published_at = xhci_cmd_completions;
}
fn xhci_input_used(s: borrow XhciInput_Read[b, o, 528, r]) -> XhciInput_xhci_input_used_Raw {
    if (xhci_cmd_completions != xhci_input_published_at) {
        return XhciInput_xhci_input_used_Raw::InputDone;
    }
    return XhciInput_xhci_input_used_Raw::InputPending;
}
fn xhci_input_done(s: borrow XhciInput_Read[b, o, 528, r]) {}
fn xhci_input_reset(s: borrow XhciInput_Read[b, o, 528, r]) -> XhciInput_xhci_input_reset_Raw {
    if (xhci_rings_quiesced) { return XhciInput_xhci_input_reset_Raw::InputQuiet; }
    return XhciInput_xhci_input_reset_Raw::InputLive;
}
fn xhci_input_reclaim(s: borrow XhciInput_Read[b, o, 528, r]) {}

// One slot per session table (only its Live owner is ever stored), and one
// for the input context (Ready or Read).
struct XhciErstSlot {
    private mutex: Mutex;
    private value: Place(exists b: addr. exists o: usize. exists r: usize. XhciErst_Live[b, o, 4, r]);
}
struct XhciScratchArraySlot {
    private mutex: Mutex;
    private value: Place(exists b: addr. exists o: usize. exists r: usize.
                         XhciScratchArray_Live[b, o, 8, r]);
}
struct XhciScratchBufSlot {
    private mutex: Mutex;
    private value: Place(exists b: addr. exists o: usize. exists r: usize.
                         XhciScratchBuf_Live[b, o, 4096, r]);
}
variant XhciInputHeld {
    Ready(exists b: addr. exists o: usize. XhciInput_Ready[b, o, 528]);
    Read(exists b: addr. exists o: usize. exists r: usize. XhciInput_Read[b, o, 528, r]);
}
struct XhciInputSlot {
    private mutex: Mutex;
    private value: Place(XhciInputHeld);
}
private let mut xhci_erst_slot: XhciErstSlot;
private let mut xhci_scratch_array_slot: XhciScratchArraySlot;
private let mut xhci_scratch_buf_slots: [XhciScratchBufSlot; 2];
private let mut xhci_input_slot: XhciInputSlot;
private let mut xhci_tables_claimed: bool = false;

private fn xhci_input_lost(x: sink XhciInputHeld) { kernel_invariant_stop(); }
// A displaced session-table owner: an invariant breach, as for a ring.
variant XhciLostTable {
    Erst(exists b: addr. exists o: usize. exists r: usize. XhciErst_Live[b, o, 4, r]);
    Array(exists b: addr. exists o: usize. exists r: usize. XhciScratchArray_Live[b, o, 8, r]);
    Buf(exists b: addr. exists o: usize. exists r: usize. XhciScratchBuf_Live[b, o, 4096, r]);
}
private fn xhci_table_lost(x: sink XhciLostTable) { kernel_invariant_stop(); }

private fn xhci_erst_park(live: XhciErst_Live[b, o, 4, r]) {
    let guard = xhci_ring_lock(&xhci_erst_slot.mutex);
    let previous = place_put(guard, &xhci_erst_slot.mutex, xhci_erst_slot.value, live);
    xhci_ring_unlock(guard, &xhci_erst_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_table_lost(XhciLostTable::Erst(other)); }
    }
}
private fn xhci_scratch_array_park(live: XhciScratchArray_Live[b, o, 8, r]) {
    let guard = xhci_ring_lock(&xhci_scratch_array_slot.mutex);
    let previous = place_put(guard, &xhci_scratch_array_slot.mutex,
                             xhci_scratch_array_slot.value, live);
    xhci_ring_unlock(guard, &xhci_scratch_array_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_table_lost(XhciLostTable::Array(other)); }
    }
}
private fn xhci_scratch_buf_park(i: usize, live: XhciScratchBuf_Live[b, o, 4096, r]) {
    if (i >= 2) {
        xhci_table_lost(XhciLostTable::Buf(live));
        return;
    }
    let guard = xhci_ring_lock(&xhci_scratch_buf_slots[i].mutex);
    let previous = place_put(guard, &xhci_scratch_buf_slots[i].mutex,
                             xhci_scratch_buf_slots[i].value, live);
    xhci_ring_unlock(guard, &xhci_scratch_buf_slots[i].mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_table_lost(XhciLostTable::Buf(other)); }
    }
}
private fn xhci_input_park(held: XhciInputHeld) {
    let guard = xhci_ring_lock(&xhci_input_slot.mutex);
    let previous = place_put(guard, &xhci_input_slot.mutex, xhci_input_slot.value, held);
    xhci_ring_unlock(guard, &xhci_input_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_input_lost(other); }
    }
}

// Publish a Ready table and keep its Live owner; answers its bus address.
private fn xhci_erst_go(r: XhciErst_Ready[b, o, 4]) -> usize !{unsafe} {
    match XhciErst_xhci_erst_publish(r) {
        XhciErst_xhci_erst_publish_Result::Live(live) => {
            let mut span: DmaDeviceSpan = XhciErst_Live_span(live);
            let dma: usize = xhci_span_bus_address(span);
            xhci_erst_park(live);
            return dma;
        }
    }
}
private fn xhci_scratch_array_go(r: XhciScratchArray_Ready[b, o, 8]) -> usize !{unsafe} {
    match XhciScratchArray_xhci_scratch_array_publish(r) {
        XhciScratchArray_xhci_scratch_array_publish_Result::Live(live) => {
            let mut span: DmaDeviceSpan = XhciScratchArray_Live_span(live);
            let dma: usize = xhci_span_bus_address(span);
            xhci_scratch_array_park(live);
            return dma;
        }
    }
}
private fn xhci_scratch_buf_go(i: usize, r: XhciScratchBuf_Ready[b, o, 4096]) -> usize !{unsafe} {
    match XhciScratchBuf_xhci_scratch_buf_publish(r) {
        XhciScratchBuf_xhci_scratch_buf_publish_Result::Live(live) => {
            let mut span: DmaDeviceSpan = XhciScratchBuf_Live_span(live);
            let dma: usize = xhci_span_bus_address(span);
            xhci_scratch_buf_park(i, live);
            return dma;
        }
    }
}

private fn xhci_erst_fill(r: XhciErst_Ready[b, o, 4], evt_ring_dma: usize) -> usize !{unsafe} {
    let mut entry: ErstEntry = {
        (evt_ring_dma & 0xFFFFFFFF) as u32, ((evt_ring_dma >> 32) & 0xFFFFFFFF) as u32,
        16, 0
    };
    XhciErst_Ready_write(r, 0, entry);
    return xhci_erst_go(r);
}
private fn xhci_scratch_array_fill(r: XhciScratchArray_Ready[b, o, 8], buf0: usize,
                                   buf1: usize) -> usize !{unsafe} {
    let mut first: XhciPtr = { (buf0 & 0xFFFFFFFF) as u32, ((buf0 >> 32) & 0xFFFFFFFF) as u32 };
    let mut second: XhciPtr = { (buf1 & 0xFFFFFFFF) as u32, ((buf1 >> 32) & 0xFFFFFFFF) as u32 };
    XhciScratchArray_Ready_write(r, 0, first);
    XhciScratchArray_Ready_write(r, 1, second);
    return xhci_scratch_array_go(r);
}

// A Live table back to Ready on a confirmed reset, then filled and
// republished. Answers 0 when the controller may still use it.
private fn xhci_erst_restart(evt_ring_dma: usize) -> usize !{unsafe} {
    let guard = xhci_ring_lock(&xhci_erst_slot.mutex);
    let taken = place_take(guard, &xhci_erst_slot.mutex, xhci_erst_slot.value);
    xhci_ring_unlock(guard, &xhci_erst_slot.mutex);
    match taken {
        Place::Empty => { return 0; }
        Place::Full(live) => {
            match XhciErst_xhci_erst_reset(live) {
                XhciErst_xhci_erst_reset_Outcome::ErstQuiet(q) => {
                    let ready = XhciErst_xhci_erst_reclaim(live, q);
                    return xhci_erst_fill(ready, evt_ring_dma);
                }
                XhciErst_xhci_erst_reset_Outcome::ErstLive => {
                    xhci_erst_park(live);
                    return 0;
                }
            }
        }
    }
}
private fn xhci_scratch_array_restart(buf0: usize, buf1: usize) -> usize !{unsafe} {
    let guard = xhci_ring_lock(&xhci_scratch_array_slot.mutex);
    let taken = place_take(guard, &xhci_scratch_array_slot.mutex,
                           xhci_scratch_array_slot.value);
    xhci_ring_unlock(guard, &xhci_scratch_array_slot.mutex);
    match taken {
        Place::Empty => { return 0; }
        Place::Full(live) => {
            match XhciScratchArray_xhci_scratch_array_reset(live) {
                XhciScratchArray_xhci_scratch_array_reset_Outcome::ArrayQuiet(q) => {
                    let ready = XhciScratchArray_xhci_scratch_array_reclaim(live, q);
                    return xhci_scratch_array_fill(ready, buf0, buf1);
                }
                XhciScratchArray_xhci_scratch_array_reset_Outcome::ArrayLive => {
                    xhci_scratch_array_park(live);
                    return 0;
                }
            }
        }
    }
}
private fn xhci_scratch_buf_restart(i: usize) -> usize !{unsafe} {
    if (i >= 2) { return 0; }
    let guard = xhci_ring_lock(&xhci_scratch_buf_slots[i].mutex);
    let taken = place_take(guard, &xhci_scratch_buf_slots[i].mutex,
                           xhci_scratch_buf_slots[i].value);
    xhci_ring_unlock(guard, &xhci_scratch_buf_slots[i].mutex);
    match taken {
        Place::Empty => { return 0; }
        Place::Full(live) => {
            match XhciScratchBuf_xhci_scratch_buf_reset(live) {
                XhciScratchBuf_xhci_scratch_buf_reset_Outcome::BufQuiet(q) => {
                    let ready = XhciScratchBuf_xhci_scratch_buf_reclaim(live, q);
                    return xhci_scratch_buf_go(i, ready);
                }
                XhciScratchBuf_xhci_scratch_buf_reset_Outcome::BufLive => {
                    xhci_scratch_buf_park(i, live);
                    return 0;
                }
            }
        }
    }
}

// The input context back to Ready: on its command's completion, or on the
// confirmed reset. False while the controller may still read it.
private fn xhci_input_recover() -> bool {
    let guard = xhci_ring_lock(&xhci_input_slot.mutex);
    let taken = place_take(guard, &xhci_input_slot.mutex, xhci_input_slot.value);
    xhci_ring_unlock(guard, &xhci_input_slot.mutex);
    match taken {
        Place::Empty => { return false; }
        Place::Full(held) => {
            match held {
                XhciInputHeld::Ready(ready) => {
                    xhci_input_park(XhciInputHeld::Ready(ready));
                    return true;
                }
                XhciInputHeld::Read(read) => {
                    match XhciInput_xhci_input_used(read) {
                        XhciInput_xhci_input_used_Outcome::InputDone(done) => {
                            let ready = XhciInput_xhci_input_done(read, done);
                            xhci_input_park(XhciInputHeld::Ready(ready));
                            return true;
                        }
                        XhciInput_xhci_input_used_Outcome::InputPending => {
                            match XhciInput_xhci_input_reset(read) {
                                XhciInput_xhci_input_reset_Outcome::InputQuiet(q) => {
                                    let ready = XhciInput_xhci_input_reclaim(read, q);
                                    xhci_input_park(XhciInputHeld::Ready(ready));
                                    return true;
                                }
                                XhciInput_xhci_input_reset_Outcome::InputLive => {
                                    xhci_input_park(XhciInputHeld::Read(read));
                                    return false;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

struct XhciTableAddresses {
    ok: bool;
    scratch_array: usize;
    erst: usize;
}

private fn xhci_tables_fail() -> XhciTableAddresses {
    let mut failed: XhciTableAddresses = { false, 0, 0 };
    return failed;
}

// The session tables for a new controller session: claimed at the first
// one, otherwise reclaimed on the confirmed reset; written and published.
fn xhci_tables_start(evt_ring_dma: usize) -> XhciTableAddresses !{unsafe} {
    if (xhci_tables_claimed == false) {
        xhci_tables_claimed = true;
        let RegionOf(u8)::Taken(b0) = region_of(xhci_scratchpad_buf0) else {
            RegionOf(u8)::Gone => { return xhci_tables_fail(); }
        };
        let buf0: usize = xhci_scratch_buf_go(0, XhciScratchBuf_init(b0));
        let RegionOf(u8)::Taken(b1) = region_of(xhci_scratchpad_buf1) else {
            RegionOf(u8)::Gone => { return xhci_tables_fail(); }
        };
        let buf1: usize = xhci_scratch_buf_go(1, XhciScratchBuf_init(b1));
        let RegionOf(XhciPtr)::Taken(arr) = region_of(xhci_scratchpad_array) else {
            RegionOf(XhciPtr)::Gone => { return xhci_tables_fail(); }
        };
        let array: usize = xhci_scratch_array_fill(XhciScratchArray_init(arr), buf0, buf1);
        let RegionOf(ErstEntry)::Taken(er) = region_of(xhci_erst) else {
            RegionOf(ErstEntry)::Gone => { return xhci_tables_fail(); }
        };
        let erst: usize = xhci_erst_fill(XhciErst_init(er), evt_ring_dma);
        let RegionOf(CtxWord)::Taken(inp) = region_of(xhci_input_ctx) else {
            RegionOf(CtxWord)::Gone => { return xhci_tables_fail(); }
        };
        xhci_input_park(XhciInputHeld::Ready(XhciInput_init(inp)));
        let mut started: XhciTableAddresses = { true, array, erst };
        return started;
    }
    let buf0: usize = xhci_scratch_buf_restart(0);
    let buf1: usize = xhci_scratch_buf_restart(1);
    let array: usize = xhci_scratch_array_restart(buf0, buf1);
    let erst: usize = xhci_erst_restart(evt_ring_dma);
    let input_ok: bool = xhci_input_recover();
    if (buf0 == 0 || buf1 == 0 || array == 0 || erst == 0 || input_ok == false) {
        return xhci_tables_fail();
    }
    let mut restarted: XhciTableAddresses = { true, array, erst };
    return restarted;
}

variant XhciInputTake {
    Ready(exists b: addr. exists o: usize. XhciInput_Ready[b, o, 528]);
    Unavailable;
}

// The input context's Ready owner for the next command.
fn xhci_input_take() -> XhciInputTake {
    if (xhci_input_recover() == false) { return XhciInputTake::Unavailable; }
    let guard = xhci_ring_lock(&xhci_input_slot.mutex);
    let taken = place_take(guard, &xhci_input_slot.mutex, xhci_input_slot.value);
    xhci_ring_unlock(guard, &xhci_input_slot.mutex);
    match taken {
        Place::Empty => { return XhciInputTake::Unavailable; }
        Place::Full(held) => {
            match held {
                XhciInputHeld::Ready(ready) => { return XhciInputTake::Ready(ready); }
                XhciInputHeld::Read(read) => {
                    xhci_input_park(XhciInputHeld::Read(read));
                    return XhciInputTake::Unavailable;
                }
            }
        }
    }
}

fn xhci_input_set(r: borrow XhciInput_Ready[b, o, 528], i: usize @ k, value: u32)
        where k < 528 {
    let mut word: CtxWord = { value };
    XhciInput_Ready_write(r, i, word);
}

fn xhci_input_get(r: borrow XhciInput_Ready[b, o, 528], i: usize @ k) -> u32
        where k < 528 {
    let mut word: CtxWord = XhciInput_Ready_read(r, i);
    return word.v;
}

// Publish the input context for the command about to be issued and keep
// it in its slot; answers its bus address.
fn xhci_input_submit(r: XhciInput_Ready[b, o, 528]) -> usize !{unsafe} {
    match XhciInput_xhci_input_publish(r) {
        XhciInput_xhci_input_publish_Result::Read(read) => {
            let mut span: DmaDeviceSpan = XhciInput_Read_span(read);
            let dma: usize = xhci_span_bus_address(span);
            xhci_input_park(XhciInputHeld::Read(read));
            return dma;
        }
    }
}

// -- The event ring and the output device context (GitHub issue #720, E1) --
//
// Both are written by the controller for a whole session, so neither comes
// back to the CPU before a confirmed reset. The CPU reads them one element
// at a time through snapshot observations: the generated read invalidates
// that element's lines and copies it, and the lowerings below decide from
// the copy alone.
//   - xhci_evt_poll trusts the Cycle bit: an event TRB whose Cycle bit
//     equals the consumer cycle state was completely written by the
//     controller (xHCI 1.2, 4.9.4). Its release advances the dequeue index
//     and ERDP past exactly the entry that was copied.
//   - xhci_out_read trusts nothing about validity: the driver reads the
//     slot and EP0 contexts after Address Device completes, when the
//     controller has written them (xHCI 1.2, 4.6.5); the release tells the
//     controller nothing.

const XHCI_OUTPUT_WORDS: usize = 512;

protocol XhciEvents[inst: usize] retains region(Trb)[b, XHCI_RING_TRBS] rx {
    state Ready access write addressed;
    state Live[req] device;
    init Ready;
    transition xhci_evt_publish(Ready) -> Live[fresh req];
    observe xhci_evt_poll(Live[req]) -> Event snapshot | NoEvent;
    observe xhci_evt_reset(Live[req]) -> EvtQuiet[req] quiesces | EvtLive;
    transition xhci_evt_reclaim(Live[req], EvtQuiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

protocol XhciOutput[inst: usize] retains region(CtxWord)[b, XHCI_OUTPUT_WORDS] rx {
    state Ready access write addressed;
    state Live[req] device;
    init Ready;
    transition xhci_out_publish(Ready) -> Live[fresh req];
    observe xhci_out_read(Live[req]) -> OutWord snapshot;
    observe xhci_out_reset(Live[req]) -> OutQuiet[req] quiesces | OutLive;
    transition xhci_out_reclaim(Live[req], OutQuiet[req]) -> Ready;
    property disjoint;
    model cells 2;
}

private region let mut xhci_evt_ring: [Trb; 16] align(64);
private region let mut xhci_device_ctx: [CtxWord; 512] align(64);

fn xhci_evt_publish(s: borrow XhciEvents_Live[b, o, 16, r]) {}
fn xhci_evt_poll(s: borrow XhciEvents_Live[b, o, 16, r], value: Trb)
        -> XhciEvents_xhci_evt_poll_Raw {
    if ((value.dw3 & 1) == xhci_evt_cycle) {
        return XhciEvents_xhci_evt_poll_Raw::Event;
    }
    return XhciEvents_xhci_evt_poll_Raw::NoEvent;
}
// Past the entry just copied: the next index (with the cycle toggled at the
// wrap), and ERDP with EHB written 1 to clear it (GitHub issue #187).
fn xhci_evt_poll_release(s: borrow XhciEvents_Live[b, o, 16, r]) !{unsafe} {
    xhci_evt_idx = xhci_evt_idx + 1;
    if (xhci_evt_idx >= XHCI_RING_TRBS) {
        xhci_evt_idx = 0;
        xhci_evt_cycle = 1 - xhci_evt_cycle;
    }
    let mut span: DmaDeviceSpan = XhciEvents_Live_span(s);
    xhci_event_dequeue_release(xhci_span_bus_address(span) + xhci_evt_idx * 16);
}
fn xhci_evt_reset(s: borrow XhciEvents_Live[b, o, 16, r]) -> XhciEvents_xhci_evt_reset_Raw {
    if (xhci_rings_quiesced) { return XhciEvents_xhci_evt_reset_Raw::EvtQuiet; }
    return XhciEvents_xhci_evt_reset_Raw::EvtLive;
}
fn xhci_evt_reclaim(s: borrow XhciEvents_Live[b, o, 16, r]) {}
fn xhci_out_publish(s: borrow XhciOutput_Live[b, o, 512, r]) {}
fn xhci_out_read(s: borrow XhciOutput_Live[b, o, 512, r], value: CtxWord)
        -> XhciOutput_xhci_out_read_Raw {
    return XhciOutput_xhci_out_read_Raw::OutWord;
}
fn xhci_out_read_release(s: borrow XhciOutput_Live[b, o, 512, r]) {}
fn xhci_out_reset(s: borrow XhciOutput_Live[b, o, 512, r]) -> XhciOutput_xhci_out_reset_Raw {
    if (xhci_rings_quiesced) { return XhciOutput_xhci_out_reset_Raw::OutQuiet; }
    return XhciOutput_xhci_out_reset_Raw::OutLive;
}
fn xhci_out_reclaim(s: borrow XhciOutput_Live[b, o, 512, r]) {}

struct XhciEventsSlot {
    private mutex: Mutex;
    private value: Place(exists b: addr. exists o: usize. exists r: usize.
                         XhciEvents_Live[b, o, 16, r]);
}
struct XhciOutputSlot {
    private mutex: Mutex;
    private value: Place(exists b: addr. exists o: usize. exists r: usize.
                         XhciOutput_Live[b, o, 512, r]);
}
private let mut xhci_events_slot: XhciEventsSlot;
private let mut xhci_output_slot: XhciOutputSlot;
private let mut xhci_events_claimed: bool = false;
private let mut xhci_output_claimed: bool = false;

variant XhciLostLive {
    Events(exists b: addr. exists o: usize. exists r: usize. XhciEvents_Live[b, o, 16, r]);
    Output(exists b: addr. exists o: usize. exists r: usize. XhciOutput_Live[b, o, 512, r]);
}
private fn xhci_live_lost(x: sink XhciLostLive) { kernel_invariant_stop(); }

private fn xhci_events_park(live: XhciEvents_Live[b, o, 16, r]) {
    let guard = xhci_ring_lock(&xhci_events_slot.mutex);
    let previous = place_put(guard, &xhci_events_slot.mutex, xhci_events_slot.value, live);
    xhci_ring_unlock(guard, &xhci_events_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_live_lost(XhciLostLive::Events(other)); }
    }
}
private fn xhci_output_park(live: XhciOutput_Live[b, o, 512, r]) {
    let guard = xhci_ring_lock(&xhci_output_slot.mutex);
    let previous = place_put(guard, &xhci_output_slot.mutex, xhci_output_slot.value, live);
    xhci_ring_unlock(guard, &xhci_output_slot.mutex);
    match previous {
        Place::Empty => {}
        Place::Full(other) => { xhci_live_lost(XhciLostLive::Output(other)); }
    }
}

// Zero every TRB (no stale Cycle bit survives a reset), publish the ring to
// the controller, keep the Live owner; answers its bus address.
private fn xhci_events_go(r: XhciEvents_Ready[b, o, 16]) -> usize !{unsafe} {
    for k: usize in 0..<16 {
        let mut zero: Trb = { 0, 0, 0, 0 };
        XhciEvents_Ready_write(r, k, zero);
    }
    match XhciEvents_xhci_evt_publish(r) {
        XhciEvents_xhci_evt_publish_Result::Live(live) => {
            let mut span: DmaDeviceSpan = XhciEvents_Live_span(live);
            let dma: usize = xhci_span_bus_address(span);
            xhci_events_park(live);
            return dma;
        }
    }
}

// The event ring for a new controller session: claimed at the first one,
// otherwise reclaimed on the confirmed reset. 0 while the controller may
// still write it.
fn xhci_events_start() -> usize !{unsafe} {
    if (xhci_events_claimed == false) {
        xhci_events_claimed = true;
        let RegionOf(Trb)::Taken(memory) = region_of(xhci_evt_ring) else {
            RegionOf(Trb)::Gone => { return 0; }
        };
        return xhci_events_go(XhciEvents_init(memory));
    }
    let guard = xhci_ring_lock(&xhci_events_slot.mutex);
    let taken = place_take(guard, &xhci_events_slot.mutex, xhci_events_slot.value);
    xhci_ring_unlock(guard, &xhci_events_slot.mutex);
    match taken {
        Place::Empty => { return 0; }
        Place::Full(live) => {
            match XhciEvents_xhci_evt_reset(live) {
                XhciEvents_xhci_evt_reset_Outcome::EvtQuiet(q) => {
                    return xhci_events_go(XhciEvents_xhci_evt_reclaim(live, q));
                }
                XhciEvents_xhci_evt_reset_Outcome::EvtLive => {
                    xhci_events_park(live);
                    return 0;
                }
            }
        }
    }
}

variant XhciEventPoll {
    Event(Trb);
    NoEvent;
}

// The entry at the dequeue index if the controller has written it, copied
// and consumed (ERDP advanced past it); NoEvent otherwise.
fn xhci_event_next() -> XhciEventPoll {
    let guard = xhci_ring_lock(&xhci_events_slot.mutex);
    let taken = place_take(guard, &xhci_events_slot.mutex, xhci_events_slot.value);
    xhci_ring_unlock(guard, &xhci_events_slot.mutex);
    match taken {
        Place::Empty => { return XhciEventPoll::NoEvent; }
        Place::Full(live) => {
            let index: usize = xhci_evt_idx;
            if (index >= 16) {
                xhci_events_park(live);
                return XhciEventPoll::NoEvent;
            }
            match XhciEvents_xhci_evt_poll(live, index) {
                XhciEvents_xhci_evt_poll_Outcome::Event(snap) => {
                    let mut trb: Trb = XhciEvents_Event_value(snap);
                    XhciEvents_Event_release(live, snap);
                    xhci_events_park(live);
                    return XhciEventPoll::Event(trb);
                }
                XhciEvents_xhci_evt_poll_Outcome::NoEvent => {
                    xhci_events_park(live);
                    return XhciEventPoll::NoEvent;
                }
            }
        }
    }
}

private fn xhci_output_go(r: XhciOutput_Ready[b, o, 512]) -> usize !{unsafe} {
    match XhciOutput_xhci_out_publish(r) {
        XhciOutput_xhci_out_publish_Result::Live(live) => {
            let mut span: DmaDeviceSpan = XhciOutput_Live_span(live);
            let dma: usize = xhci_span_bus_address(span);
            xhci_output_park(live);
            return dma;
        }
    }
}

// The output device context for a new Address Device: published once per
// controller session; 0 while the controller may still write it.
fn xhci_output_start() -> usize !{unsafe} {
    if (xhci_output_claimed == false) {
        xhci_output_claimed = true;
        let RegionOf(CtxWord)::Taken(memory) = region_of(xhci_device_ctx) else {
            RegionOf(CtxWord)::Gone => { return 0; }
        };
        return xhci_output_go(XhciOutput_init(memory));
    }
    let guard = xhci_ring_lock(&xhci_output_slot.mutex);
    let taken = place_take(guard, &xhci_output_slot.mutex, xhci_output_slot.value);
    xhci_ring_unlock(guard, &xhci_output_slot.mutex);
    match taken {
        Place::Empty => { return 0; }
        Place::Full(live) => {
            match XhciOutput_xhci_out_reset(live) {
                XhciOutput_xhci_out_reset_Outcome::OutQuiet(q) => {
                    return xhci_output_go(XhciOutput_xhci_out_reclaim(live, q));
                }
                XhciOutput_xhci_out_reset_Outcome::OutLive => {
                    // Still the controller's: the same context serves the
                    // same slot again.
                    let mut span: DmaDeviceSpan = XhciOutput_Live_span(live);
                    let dma: usize = xhci_span_bus_address(span);
                    xhci_output_park(live);
                    return dma;
                }
            }
        }
    }
}

// One word of the output device context, read fresh; 0 when there is none.
fn xhci_output_word(i: usize) -> u32 {
    let guard = xhci_ring_lock(&xhci_output_slot.mutex);
    let taken = place_take(guard, &xhci_output_slot.mutex, xhci_output_slot.value);
    xhci_ring_unlock(guard, &xhci_output_slot.mutex);
    match taken {
        Place::Empty => { return 0; }
        Place::Full(live) => {
            let mut word: u32 = 0;
            if (i < 512) {
                match XhciOutput_xhci_out_read(live, i) {
                    XhciOutput_xhci_out_read_Outcome::OutWord(snap) => {
                        let mut copy: CtxWord = XhciOutput_OutWord_value(snap);
                        word = copy.v;
                        XhciOutput_OutWord_release(live, snap);
                    }
                }
            }
            xhci_output_park(live);
            return word;
        }
    }
}
