// Standalone-kernel RP1 XHCI host controller + USB Mass Storage Bulk-Only
// Transport. Initially forked byte-for-byte from the real-hardware-proven
// examples/common_rpi5 driver; this copy is owned entirely by kernel/ and
// has no build or source dependency on examples/.
//
// The original reusable module was extracted from rp1_usb_smoke once
// once that diagnostic proved the whole path end to end on real hardware
// (GitHub issue #67 Stage 2 follow-up: el0_shell needs a real
// disk_initialize/disk_read/disk_write triple to mount FAT12, the same
// way examples/common_rpi3/usb_msc.tkb serves el0_shell on RPi3).
//
// Exposes the exact same disk_initialize/disk_status/disk_read/disk_write
// Media Access Interface examples/common_stm32/sdmmc.tkb and
// examples/common_rpi3/usb_msc.tkb already expose (DiskIoResult, 512-byte
// blocks), so examples/common_rpi5/fat12_usbmsc.tkb (mirroring
// examples/common_rpi3/fat12_usbmsc.tkb) can `use` it with no
// target-specific fork above this layer. Unlike RPi3's dwc2-based driver,
// disk_read/disk_write here take plain `*u8` (not `*align(32) u8`): the
// DMA address handed to the controller is `cpu_phys + rp1_dma_pci_offset`,
// whose value is validated and applied from the boot DTB's dma-ranges,
// regardless of the buffer's own alignment, and every cache-maintenance
// call below operates on whole-buffer ranges, not sub-cache-line slices --
// no alignment constraint this driver's own correctness depends on.
//
// rp1_usb_smoke.tkb is kept exactly as it was verified (its own extensive
// header comment documents the full bring-up investigation and root-cause
// history) rather than being rewritten to `use` this file -- same "don't
// destabilize proven bring-up code" reasoning this project applies
// elsewhere (e.g. el0_elf_load.tkb vs el0_shell.tkb kept as separate
// files). This file is a faithful port of that same proven logic into
// library form: identical register offsets, masks, timing and DMA
// addressing, with the diagnostic-only isolation-test code and per-step
// uart narration removed. Outbound payloads use the caller-selected TX
// bounce buffer; inbound payloads use one protected fixed receive buffer.
//
// See HISTORY.md's RPi5 USB bring-up entries and the rpi5_usb_bringup
// memory file for the full derivation of every
// hardware values below (the 0xCE00FFE9 PORTSC neutral mask,
// the Address Device port-reset requirement, U-Boot's endpoint-index/DCI
// formulas) -- not re-derived here.

// RP1_USBHOST0_BASE is the CAPABILITY register base. The operational and
// runtime blocks and the doorbell array are wherever the capability block
// says (CAPLENGTH, RTSOFF, DBOFF): device_map.tkb reads them at attach time,
// checks each block inside the device window, and attaches one handle per
// block (kernel/drivers/usb/xhci_regs.tkb, GitHub issues #804 and #806).
use "kernel/platform/rpi5/usb_xhci_dma.tkb";
use "kernel/platform/rpi5/usb_xhci_rings.tkb";
use "kernel/platform/rpi5/usb_xhci_bus.tkb";
use "kernel/drivers/dma_address.tkb";
use "kernel/drivers/usb/config_descriptor.tkb";
use "kernel/drivers/usb/init_report.tkb";
use "kernel/drivers/usb/xhci_event_match.tkb";
use "kernel/drivers/usb/xhci_regs.tkb";
use "kernel/lib/mutex.tkb";

const RP1_USBHOST0_BASE: usize = 0x1F00200000;
let mut rp1_usbhost0_base: BootOnce(usize);
let mut rp1_usbhost0_dtb_status: BootOnce(usize);

// The device window the boot DTB check requires of usbhost0 (at least this
// many bytes); every discovered block must lie inside it.
const RP1_USBHOST0_WINDOW_BYTES: usize = 0x100000;

// One handle per xHCI register block, attached by device_map.tkb at the
// bases the capability block reported.
let mut rp1_xhci_cap: IoHandle(XhciCapabilityRegs);
let mut rp1_xhci_op: IoHandle(XhciOperationalRegs);
let mut rp1_xhci_rt: IoHandle(XhciRuntimeRegs);
let mut rp1_xhci_db: IoHandle(XhciDoorbellRegs);
// What the capability block said, written once by that attach.
let mut rp1_xhci_caps: BootOnce(XhciCapabilities);

// The only port this driver drives (the board's USB 3 socket), and its
// PORTSC word in the operational block's port register sets.
const XHCI_MSC_PORT: u32 = 3;
const XHCI_MSC_PORTSC_WORD: usize = 8; // 4 * (XHCI_MSC_PORT - 1)

fn usb_xhci_capabilities() -> XhciCapabilities {
    return boot_once_get(&rp1_xhci_caps);
}

const CMD_RING_TRBS: usize = XHCI_RING_TRBS;
const EVT_RING_TRBS: usize = 16;
const EP0_RING_TRBS: usize = XHCI_RING_TRBS;
const BULK_RING_TRBS: usize = XHCI_RING_TRBS;
// Context buffers are sized for 64-byte contexts, the larger of the two
// HCCPARAMS1.CSZ allows; the stride actually used is read at attach time
// (xhci_context_words).
const INPUT_CTX_SIZE: usize = 2112;  // 33 * 64
const DEVICE_CTX_SIZE: usize = 2048; // 32 * 64

// A TRB (Transfer Request Block) is always 4 dwords/16 bytes regardless of
// its type field (dw3 bits 15:10) -- every ring below (Command, Event, EP0
// control, bulk IN/OUT) is a fixed-stride array of these, so one struct
// covers all of them. GitHub issue #218/#316 follow-up: replaces manual
// `(ring_base + idx*16 + k*4) as *u32` pointer arithmetic with checked
// array-of-struct indexing (ring[idx].dwK) wherever the index is a
// compile-time-refined loop counter, and with `*Trb` pointer indexing
// (same trust level the raw pointer arithmetic already had, no new
// trap-site obligation) wherever the index is runtime producer/
// consumer state (xhci_cmd_enq, xhci_evt_idx, xhci_ep0_enq, ...).
struct Trb {
    dw0: u32;
    dw1: u32;
    dw2: u32;
    dw3: u32;
}

let mut xhci_dcbaa: [u32; 65 * 2] align(64);
// The four producer rings (Command, EP0, bulk IN/OUT) are owners of the
// XhciRing device protocol in usb_xhci_rings.tkb (GitHub issue #720).

let mut xhci_slot_id: usize = 0;
let mut xhci_ep0_enq: usize = 0;
let mut xhci_ep0_cycle: u32 = 1;
let mut xhci_evt_idx: usize = 0;
let mut xhci_evt_cycle: u32 = 1;
let mut xhci_last_evt_dw3: u32 = 0;

let mut xhci_msc_config_value: u32 = 0;
let mut xhci_msc_interface_num: u32 = 0;
let mut xhci_msc_bulk_in_ep: u32 = 0;
let mut xhci_msc_bulk_in_mps: u32 = 0;
let mut xhci_msc_bulk_in_burst: u32 = 0;
let mut xhci_msc_bulk_out_ep: u32 = 0;
let mut xhci_msc_bulk_out_mps: u32 = 0;
let mut xhci_msc_bulk_out_burst: u32 = 0;

let mut xhci_bulk_in_enq: usize = 0;
let mut xhci_bulk_in_cycle: u32 = 1;
let mut xhci_bulk_in_dci: usize = 0;
let mut xhci_bulk_out_enq: usize = 0;
let mut xhci_bulk_out_cycle: u32 = 1;
let mut xhci_bulk_out_dci: usize = 0;

// Command Ring producer state. Bring-up (xhci_enable_slot/
// xhci_address_device/xhci_configure_endpoint) uses fixed TRB[0]/[1]/[2]
// offsets directly since those three commands run exactly once each in a
// known order; this tracked index takes over from TRB[3] onward for
// later, repeated commands (Reset Endpoint / Set TR Dequeue Pointer,
// issued by xhci_reset_endpoint on every bulk-endpoint stall recovery).
let mut xhci_cmd_enq: usize = 3;
let mut xhci_cmd_cycle: u32 = 1;

// Close out a ring segment so the controller can actually WALK from
// `from_idx` to the Link TRB and follow it back to index 0.
//
// This is the single most important correctness detail of a TRB ring's
// producer side, and getting it wrong is silent: the controller simply
// stops, with no error and no event. A TD must not straddle the Link
// TRB, so when one will not fit, the producer has to skip the remaining
// slots -- but it may NOT simply jump to index 0 and toggle its own
// cycle, because the controller is still sitting at its own dequeue
// pointer several TRBs back. It walks forward one TRB at a time and
// stops the moment it finds a Cycle bit that does not match its Consumer
// Cycle State, so an untouched (BSS-zero, Cycle=0) gap left behind is a
// permanent wall: the controller never reaches the Link TRB, never
// toggles, and the ring is dead forever.
//
// So: fill every skipped slot with a real No-Op TRB carrying the CURRENT
// cycle (the controller consumes and ignores these -- no IOC, so they
// raise no events), then re-publish the Link TRB with the current cycle
// too. Only then may the caller wrap to 0 and toggle its own cycle; the
// controller toggles its own when it follows the Link TRB's Toggle Cycle
// bit, and the two stay in sync.
//
// noop_type is 8 (No-Op Transfer TRB) for Transfer Rings and 23 (No-Op
// Command TRB) for the Command Ring -- different TRB types with the same
// "consume and ignore" role.
//
// Found on real hardware: EP0 went permanently silent (control transfers
// returning no Transfer Event at all) after exactly 13 TRBs, the point
// at which a 3-TRB control TD first failed to fit before the Link TRB.
// examples/rp1_usb_smoke/rp1_usb_smoke.tkb never hit this only because
// it happened to issue one fewer control transfer and stopped at 14.

fn xhci_cmd_advance() !{unsafe} {
    xhci_cmd_enq = xhci_cmd_enq + 1;
    let link_idx: usize = CMD_RING_TRBS - 1;
    if (xhci_cmd_enq + 1 > link_idx) {
        xhci_ring_close(XHCI_RING_CMD, xhci_cmd_enq, xhci_cmd_cycle, 23);
        xhci_cmd_enq = 0;
        xhci_cmd_cycle = 1 - xhci_cmd_cycle;
    }
}

// TX uses the ordinary bounce buffer; RX uses a separate protected fixed
// allocation. Both are isolated and cache-line aligned, so callers may use
// ordinary byte slices regardless of their own alignment.
//
// Found on real hardware, and it presented as silent data corruption
// rather than an error: examples/common/fat12.tkb's buffers are
// `align(32)`, so reading LBA 200 into one returned the first 16 bytes
// of the PREVIOUSLY read sector (LBA 3's root directory) with the rest
// of the sector correct. Reads "worked" for a while purely because the
// very first read into a never-touched buffer has no dirty lines to
// write back.
//
// Bouncing through isolated whole cache lines removes the caller-alignment
// requirement, which is why disk_read/disk_write accept ordinary slices.
// Empirical RPi5 limit for this driver: 128 sectors (64 KiB) succeeds
// through rootfs provisioning and the complete kernelcheck-rpi5 suite.
// 192 and 256 sectors stalled during the first rootfs WRITE(10), before
// the userspace readiness marker. Keep the bounded command below that
// observed XHCI/device boundary; the provisioning caller still falls back
// to smaller commands when a completed multi-sector command reports an
// ordinary transport/device error.
const MSC_MAX_TRANSFER_SECTORS: usize = 128;
const MSC_SECTOR_SIZE: usize = 512;
let mut msc_tag: u32 = 0;
private let mut msc_write10_command_count: usize = 0;

let mut xhci_ready: bool = false;
private let mut xhci_controller_unusable: bool = false;

// -- Media Access Interface (matches examples/common_stm32/sdmmc.tkb and
// examples/common_rpi3/usb_msc.tkb) -----------------------------------
must_use variant DiskIoResult {
    Ok;
    Err(i32);
}

// GitHub issue #339: what a single bring-up stage did, for the two stages
// that have more than one way to give up. They stay in this file because
// every case names a controller event -- kernel/drivers/usb/init_report.tkb
// holds the part a host can run.
//
// Each is mapped into UsbInitOutcome at its one call site rather than
// returned onwards: a must_use variant is handled by being matched, and a
// matched result cannot be forwarded, so the mapping is where the outcome
// is read.
must_use variant XhciAddressOutcome {
    Ok;
    SlotIdOutOfRange(u32);
    PortReset;
    Completion(u32);
}

// Transfer(code) carries the completion code of whichever control transfer
// or command failed. Malformed and NoBulkEndpoints are the two ways the
// transfers all succeed and the answer is still no: bytes the parser
// refuses, and a configuration that describes no mass-storage bulk pair --
// a stick that is not a disk, which is a different repair from a controller
// that is not working.
must_use variant XhciConfigureOutcome {
    Ok;
    Transfer(u32);
    Malformed;
    NoBulkEndpoints;
}

fn disk_io_ok(r: DiskIoResult) -> bool {
    match r {
        DiskIoResult::Ok => { return true; }
        DiskIoResult::Err(err) => { return false; }
    }
}

// GitHub issue #187: called from kernel/platform/rpi5/intc.tkb's
// rpi5_irq_dispatch on GIC INTID 191 (RP1_USBHOST0_0), on whichever core the
// rotating route delivered it to (GitHub issue #830). IMAN.IP (bit 0) and
// USBSTS.EINT (bit 3) are both write-1-to-clear per the xHCI spec; clearing
// both here is what lets the controller assert the interrupt again.
//
// ERDP is NOT written here (GitHub issue #830, maintainer decision
// 2026-10-20, option A; Linux likewise writes ERDP only where it consumes
// events). The handler used to rewrite the current ERDP with EHB (bit 3,
// RW1C) set, a read-modify-write that would race the consumer's own ERDP
// advance once the handler runs on another core. The consumer,
// xhci_evt_poll_release (usb_xhci_rings.tkb), writes ERDP with EHB set
// after every event it takes, and rewrites its own dequeue pointer with EHB
// set whenever a poll finds the ring empty (xhci_event_next), before it
// waits. Without that second write, an event consumed before the controller
// set EHB, or one nobody awaited yet (the Port Status Change of #187), left
// EHB set and the next event silent: the RPi5 boot hung at the first child
// exec after BusyBox od on 2026-10-20.
fn xhci_irq_handler() !{interrupt, unsafe} {
    rp1_xhci_rt.iman = rp1_xhci_rt.iman | 1; // IMAN.IP write-1-to-clear
    rp1_xhci_op.usbsts = 1 << 3; // USBSTS.EINT write-1-to-clear
    interrupt_notify();
}

// Doorbell notification: a ring's TRBs are published (dma_prepare_tx)
// before this write, and nothing else rings a doorbell. Target 0 is the
// command ring; a slot id names that device's doorbell.
fn xhci_ring_doorbell(target: usize, value: u32) {
    if (target >= 256) { return; }
    rp1_xhci_db.doorbell[target] = value;
}

// Event-ring consumer release: advance ERDP past what usb_await_event has
// consumed, clearing EHB (RW1C) with it. The only ERDP writer after
// initialization (GitHub issue #830).
fn xhci_event_dequeue_release(dequeue_dma: usize) {
    rp1_xhci_rt.erdp_lo = ((dequeue_dma & 0xFFFFFFFF) as u32) | (1 << 3);
    rp1_xhci_rt.erdp_hi = ((dequeue_dma >> 32) & 0xFFFFFFFF) as u32;
}

// Consume Event Ring entries until one matches `want` exactly (TRB Type,
// TRB Pointer inside the request's TRBs, and for a transfer its slot and
// endpoint: kernel/drivers/usb/xhci_event_match.tkb), skipping any other
// event -- port status changes in particular are asynchronous and
// interleave freely, and an event for another request must not end this
// one (GitHub issue #720). Skipped events of the wanted type are counted
// in xhci_foreign_events. Advances ERDP past everything consumed, which
// the controller requires to keep delivering events. Returns the
// completion code (DWORD2 bits 31:24), or 0 if no matching event turned up.
let mut xhci_foreign_events: usize = 0;
fn usb_await_event(want: XhciEventWant, timeout_ms: usize) -> u32 !{unsafe} {
    for scan: usize in 0..<8 {
        let mut seen: bool = false;
        let mut dw0: u32 = 0;
        let mut dw1: u32 = 0;
        let mut dw3: u32 = 0;
        // GitHub issue #187: waits via interrupt_wait() (race-free wfe/sev,
        // woken by xhci_irq_handler's interrupt_notify()) instead of
        // polling with delay_us(). The generic timer now wakes this loop
        // periodically, so timeout_ms remains a bounded iteration count
        // rather than literal milliseconds but a permanently wedged device
        // eventually returns 0 instead of sleeping forever.
        // The event ring is an XhciEvents owner (usb_xhci_rings.tkb): each
        // poll copies the entry at the dequeue index after invalidating its
        // lines, and a consumed entry advances the index and ERDP -- with
        // EHB written 1 to clear it (GitHub issue #187: otherwise the xHC
        // never asserts another interrupt after the first one).
        let mut dw2: u32 = 0;
        for i: usize in 0..<timeout_ms {
            match xhci_event_next() {
                XhciEventPoll::Event(trb) => {
                    seen = true;
                    dw0 = trb.dw0;
                    dw1 = trb.dw1;
                    dw3 = trb.dw3;
                    dw2 = trb.dw2;
                    break;
                }
                XhciEventPoll::NoEvent => {}
            }
            workload_profile_interrupt_wait();
        }
        if (seen == false) {
            return 0;
        }

        if (xhci_event_matches(want, dw0, dw1, dw3)) {
            xhci_last_evt_dw3 = dw3;
            return (dw2 >> 24) & 0xFF;
        }
        if (((dw3 >> 10) & 0x3F) == want.trb_type) {
            xhci_foreign_events = xhci_foreign_events + 1;
        }
    }
    return 0;
}

// One USB control transfer over EP0: Setup Stage + optional Data Stage +
// Status Stage, one doorbell ring, one Transfer Event. Shape follows
// U-Boot's xhci_ctrl_tx(). Pass w_length=0 for a no-data request, in
// which case buf_dma is ignored. Returns the Transfer Event's completion
// code (1 = Success, 0 = no event).
// Private: a device-written buffer reaches it only through usb_ctrl_in,
// whose address and length come from one device span (GitHub issue #623).
private fn usb_ctrl_xfer(bm_request_type: u32, b_request: u32, w_value: u32,
                         w_index: u32, w_length: u32, buf_dma: usize,
                         dir_in: bool) -> u32 !{unsafe} {
    let has_data: bool = w_length > 0;

    // A control TD is at most 3 TRBs (Setup + Data + Status); reserve
    // that conservatively even for the 2-TRB no-data case. See
    // xhci_ring_close_segment for why the skipped slots and the Link TRB
    // must be published rather than simply jumped over.
    let need: usize = 3;
    let ep0_link_idx: usize = EP0_RING_TRBS - 1;
    if (xhci_ep0_enq + need > ep0_link_idx) {
        xhci_ring_close(XHCI_RING_EP0, xhci_ep0_enq, xhci_ep0_cycle, 8);
        xhci_ep0_enq = 0;
        xhci_ep0_cycle = 1 - xhci_ep0_cycle;
    }
    let first_idx: usize = xhci_ep0_enq;
    let cyc: u32 = xhci_ep0_cycle;

    let mut trt: u32 = 0;
    if (has_data) {
        if (dir_in) { trt = 3; } else { trt = 2; }
    }
    let mut setup: Trb = {
        bm_request_type | (b_request << 8) | (w_value << 16),
        w_index | (w_length << 16), 8, cyc | (1 << 6) | (2 << 10) | (trt << 16)
    };
    let mut idx: usize = first_idx + 1;
    let mut data: Trb = { 0, 0, 0, 0 };

    if (has_data) {
        let mut dir_bit: u32 = 0;
        if (dir_in) { dir_bit = 1; }
        let mut data_trb: Trb = {
            (buf_dma & 0xFFFFFFFF) as u32, ((buf_dma >> 32) & 0xFFFFFFFF) as u32,
            w_length, cyc | (3 << 10) | (dir_bit << 16)
        };
        data = data_trb;
        idx = idx + 1;
    }

    let mut st_dir: u32 = 1;
    if (has_data) {
        if (dir_in) { st_dir = 0; }
    }
    let mut status: Trb = { 0, 0, 0, cyc | (1 << 5) | (4 << 10) | (st_dir << 16) };
    xhci_ep0_enq = idx + 1;
    let mut td: [Trb; 3];
    td[0] = setup;
    let mut count: usize = 2;
    if (has_data) {
        td[1] = data;
        td[2] = status;
        count = 3;
    } else {
        td[1] = status;
        td[2] = status;
    }
    return xhci_ring_submit(XHCI_RING_EP0, xhci_slot_id, 1, first_idx, idx,
                            1000, count, td as [Trb; 3..]);
}

// One bulk transfer: a single Normal TRB (Type 1) on the endpoint's own
// ring, then that endpoint's doorbell, then one Transfer Event. ISP
// (Interrupt on Short Packet) is set so a device that returns fewer
// bytes than asked still raises the event rather than leaving the
// transfer outstanding. Returns the completion code -- 1 is Success and
// 13 is Short Packet, both of which mean the data arrived.
// Private for the same reason as usb_ctrl_xfer: an IN transfer is submitted
// through usb_bulk_in, an OUT one through usb_bulk_out.
private fn usb_bulk_xfer(dir_in: bool, buf_dma: usize, length: u32) -> u32 !{unsafe} {
    let mut ring: usize = XHCI_RING_BULK_OUT;
    let mut enq: usize = xhci_bulk_out_enq;
    let mut cyc: u32 = xhci_bulk_out_cycle;
    let mut dci: usize = xhci_bulk_out_dci;
    if (dir_in) {
        ring = XHCI_RING_BULK_IN;
        enq = xhci_bulk_in_enq;
        cyc = xhci_bulk_in_cycle;
        dci = xhci_bulk_in_dci;
    }

    // Same Link-TRB discipline as the EP0 ring -- see
    // xhci_ring_close_segment. A bulk TD is a single TRB here, so this
    // only ever triggers exactly at the Link TRB slot, but the Link TRB
    // still has to be re-published with the current cycle or the SECOND
    // wrap (when the cycle is 0, not the 1 it was initialized with)
    // silently kills the ring.
    let bulk_link_idx: usize = BULK_RING_TRBS - 1;
    if (enq + 1 > bulk_link_idx) {
        xhci_ring_close(ring, enq, cyc, 8);
        enq = 0;
        cyc = 1 - cyc;
    }

    // ISP (Interrupt on Short Packet, bit2) only has defined meaning for
    // IN transfers (a device sending fewer bytes than offered); left
    // off for OUT, where the host always controls the exact byte count.
    let mut isp_bit: u32 = 0;
    if (dir_in) { isp_bit = 1 << 2; }
    let mut normal: Trb = {
        (buf_dma & 0xFFFFFFFF) as u32, ((buf_dma >> 32) & 0xFFFFFFFF) as u32,
        length, cyc | isp_bit | (1 << 5) | (1 << 10)
    };
    let trb_idx: usize = enq;

    enq = enq + 1;
    if (dir_in) {
        xhci_bulk_in_enq = enq;
        xhci_bulk_in_cycle = cyc;
    } else {
        xhci_bulk_out_enq = enq;
        xhci_bulk_out_cycle = cyc;
    }
    let mut td: [Trb; 3];
    td[0] = normal;
    td[1] = normal;
    td[2] = normal;
    return xhci_ring_submit(ring, xhci_slot_id, dci as u32, trb_idx, trb_idx,
                            5000, 1, td as [Trb; 3..]);
}

// Recover a STALLed bulk endpoint. Unlike RPi3's DWC2 driver (which only
// needs to clear the device-side STALL via CLEAR_FEATURE(ENDPOINT_HALT)
// -- as the historical RPi3 driver's msc_recover_transport did),
// xHCI ALSO halts the endpoint's Endpoint Context internally on a
// Transfer Event with a non-success completion code (STALL Error = 6,
// among others): no further TRB on that ring is processed until
// software issues a Reset Endpoint Command (TRB Type 14) targeting the
// endpoint's own DCI. A Set TR Dequeue Pointer Command (Type 16)
// afterward repoints the controller's own dequeue pointer at the ring's
// NEXT producer slot (this driver's own `enq`/`cycle` state, which
// already advanced past the failed TRB when it was enqueued) so the
// controller does not attempt to re-fetch the TRB that just stalled.
// Found the hard way: the first-ever bulk OUT transfer this driver
// attempted (WRITE(10)'s data phase) succeeded, but the CSW's own
// bulk-IN read afterward came back with completion_code=0x06 (STALL)
// every time, until this recovery was added.
// Issues an xHCI Reset Endpoint Command (TRB Type 14) for the given DCI
// Issue one Command Ring command and wait for its Command Completion
// Event. EVERY DWORD is written explicitly, including the ones that are
// zero: the Command Ring is reused, so a slot revisited after a wrap
// still holds the previous command's DWORDs. Leaving DWORD2 untouched
// on a Set TR Dequeue Pointer command (whose DWORD2 carries the Stream
// ID) is exactly how that command came back with completion_code=0x05
// (TRB Error) on real hardware here.
fn xhci_run_command(dw0: u32, dw1: u32, dw2: u32, trb_type: u32,
                    dci: usize) -> u32 !{unsafe} {
    let dci_u32: u32 = dci as u32;
    let slot_u32: u32 = xhci_slot_id as u32;
    let mut command: Trb = {
        dw0, dw1, dw2,
        xhci_cmd_cycle | (trb_type << 10) | (dci_u32 << 16) | (slot_u32 << 24)
    };
    let cmd_idx: usize = xhci_cmd_enq;
    xhci_cmd_advance();
    let mut td: [Trb; 3];
    td[0] = command;
    td[1] = command;
    td[2] = command;
    return xhci_ring_submit(XHCI_RING_CMD, 0, 0, cmd_idx, cmd_idx, 1000, 1,
                            td as [Trb; 3..]);
}

// Reset Endpoint (TRB Type 14) clears the CONTROLLER-side Halted state
// an Endpoint Context enters on any non-success Transfer Event.
// CLEAR_FEATURE(ENDPOINT_HALT) alone only clears the DEVICE side; xHCI
// requires both, and per the spec a Set TR Dequeue Pointer (Type 16)
// must follow before the endpoint's doorbell is rung again, to tell the
// controller where to resume -- the ring's next free producer slot,
// since this driver has already advanced past the TRB that failed.
fn xhci_reset_endpoint(dci: usize, ring_dma: usize, next_off: usize,
                       next_cycle: u32) !{unsafe} {
    xhci_run_command(0, 0, 0, 14, dci);
    let deq: usize = (ring_dma + next_off) | (next_cycle as usize);
    xhci_run_command((deq & 0xFFFFFFFF) as u32,
                     ((deq >> 32) & 0xFFFFFFFF) as u32,
                     0, 16, dci);
}

// Recover a STALLed bulk endpoint. Clear the xHC's Halted Endpoint Context
// first (Reset Endpoint + Set TR Dequeue Pointer), then clear the device's
// endpoint halt via CLEAR_FEATURE(ENDPOINT_HALT). This matches Linux xHCI's
// split recovery: its Transfer Event handler resets the host endpoint as
// soon as the STALL arrives; the class driver clears the device-side halt
// afterward before retrying the transfer.
fn xhci_recover_bulk_stall(dir_in: bool, ep_addr: u32, dci: usize) !{unsafe} {
    if (dir_in) {
        match xhci_ring_dma(XHCI_RING_BULK_IN) {
            XhciRingAddress::Known(ring_dma) => {
                xhci_reset_endpoint(dci, ring_dma, xhci_bulk_in_enq * 16,
                                    xhci_bulk_in_cycle);
            }
            XhciRingAddress::Busy => {}
        }
    } else {
        match xhci_ring_dma(XHCI_RING_BULK_OUT) {
            XhciRingAddress::Known(ring_dma) => {
                xhci_reset_endpoint(dci, ring_dma, xhci_bulk_out_enq * 16,
                                    xhci_bulk_out_cycle);
            }
            XhciRingAddress::Busy => {}
        }
    }
    usb_ctrl_no_data(0x02, 1, 0, ep_addr);
}

// Bulk-Only Mass Storage Reset (class request, interface recipient, no
// data stage) -- best-effort override of any inherited device state,
// same reasoning as RPi3's own msc_bulk_only_reset.
fn msc_bulk_only_reset() -> bool {
    return usb_ctrl_no_data(0x21, 0xFF, 0, xhci_msc_interface_num) == 1;
}

// Full USB Mass Storage BOT reset recovery, in the order the BOT spec
// requires: class-specific Mass Storage Reset, then clear the STALL
// condition on BOTH bulk endpoints (not just whichever one happened to
// stall) -- see RPi3's own msc_recover_transport for the same sequence.
// A single-endpoint xhci_recover_bulk_stall() was tried first here and
// was NOT sufficient on real hardware: it cleared the immediate STALL
// but the following CSW read then failed with completion_code=0x04 (USB
// Transaction Error), consistent with the BOT spec's own reasoning that
// a stalled CSW stage is a genuine "Phase Error" the device signals by
// discarding its whole notion of the in-flight command -- only a full
// reset, not a single endpoint recovery, puts both sides back in sync.
// Full BOT reset recovery, in the order the spec (5.3.4) requires: class-
// specific Mass Storage Reset, then Clear Feature HALT on BOTH bulk
// endpoints. Found necessary on real hardware after a persistent CSW
// stall: clearing just the IN endpoint's halt was not enough to make the
// device answer again -- a retried CSW read timed out completely rather
// than re-stalling (the device had nothing left to send at all, having
// apparently discarded that CSW), and worse, a fresh CBW sent afterward
// on the OUT endpoint (never itself touched) stalled immediately too.
// Only Mass Storage Reset actually resets the device's own BOT state
// machine back to "ready for a new CBW" -- device-side CLEAR_FEATURE
// alone clears an endpoint's halt bit but does not do that. No xHCI
// Reset Endpoint Command here (see xhci_recover_bulk_stall's own
// comment: it was tried and made an isolated stall into a total
// transport breakdown).
fn msc_recover_transport() -> bool {
    msc_bulk_only_reset();
    usb_ctrl_no_data(0x02, 1, 0, xhci_msc_bulk_in_ep);
    usb_ctrl_no_data(0x02, 1, 0, xhci_msc_bulk_out_ep);
    return true;
}

// Fills the fixed 15-byte CBW header and zeroes the 16-byte CDB region;
// callers fill in the CDB's own opcode/fields with msc_cbw_set(15.., ...)
// afterward. bCBWLUN is always 0 -- single-drive scope, same as the RPi3
// side.
fn msc_cbw_header(data_len: u32, dir_in: bool, cb_len: u32) {
    msc_tag = msc_tag + 1;
    let tag: u32 = msc_tag;
    match msc_cbw_take() {
        MscCbwTransmitAuthority::Cpu(cpu) => {
            let cbw = dma_cpu_slice(cpu, MscCbwTransmit);
            for i: usize in 0..<31 {
                cbw[i] = 0;
            }
            let sig: u32 = 0x43425355;
            for i: usize in 0..<4 {
                let sh: u32 = (i * 8) as u32;
                cbw[i] = ((sig >> sh) & 0xFF) as u8;
                cbw[4 + i] = ((tag >> sh) & 0xFF) as u8;
                cbw[8 + i] = ((data_len >> sh) & 0xFF) as u8;
            }
            if (dir_in) {
                cbw[12] = 0x80;
            } else {
                cbw[12] = 0x00;
            }
            cbw[14] = cb_len as u8;
            msc_cbw_put(MscCbwTransmitAuthority::Cpu(cpu));
        }
        MscCbwTransmitAuthority::Device(stale) => {
            msc_cbw_fail_device(stale);
        }
    }
}

// One CDB byte; the CDB occupies bytes 15..<31 of the CBW.
fn msc_cbw_set(index: {15..<31 as usize}, value: u8) {
    match msc_cbw_take() {
        MscCbwTransmitAuthority::Cpu(cpu) => {
            let cbw = dma_cpu_slice(cpu, MscCbwTransmit);
            cbw[index] = value;
            msc_cbw_put(MscCbwTransmitAuthority::Cpu(cpu));
        }
        MscCbwTransmitAuthority::Device(stale) => {
            msc_cbw_fail_device(stale);
        }
    }
}

// Run one complete Bulk-Only Transport command: CBW out, optional data
// phase through the TX bounce buffer or protected RX allocation, then CSW in.
// The CBW must already be built by
// msc_cbw_header() plus the caller's CDB bytes. A timeout has no matching
// transfer event, so it cannot enter the completed-error recovery path.
must_use variant MscCommandResult {
    Ok;
    CompletedError(u32);
    RestartRequired;
    ControllerUnusable;
}
must_use variant MscTimeoutResult {
    RestartRequired;
    ControllerUnusable;
}

// A missing event leaves the transfer outstanding. xHCI HCHalted means the
// pending pipelined transactions have finished (xHCI 1.2 section 5.4.1.1).
// Reset the host controller before another command can reuse a DMA range.
// A failed halt/reset is conservatively treated as unproven quiescence, so
// this boot must never reinitialize the controller.
fn msc_abort_unobserved_transfer() -> MscTimeoutResult {
    xhci_ready = false;
    if (xhci_halt_and_reset()) {
        return MscTimeoutResult::RestartRequired;
    }
    xhci_controller_unusable = true;
    return MscTimeoutResult::ControllerUnusable;
}

must_use variant MscDataReceiveResult {
    Completed(u32);
    RestartRequired;
    ControllerUnusable;
}

private fn msc_csw_receive_attempt(remaining_stall_retries: usize)
        -> MscCommandResult !{unsafe} {
    let mut completion: u32 = 0;
    match msc_csw_receive_once() {
        MscDataReceiveResult::Completed(code) => { completion = code; }
        MscDataReceiveResult::RestartRequired => {
            return MscCommandResult::RestartRequired;
        }
        MscDataReceiveResult::ControllerUnusable => {
            return MscCommandResult::ControllerUnusable;
        }
    }
    // Any nonzero code came from a final transfer event, even a STALL.
    if (completion == 6 && remaining_stall_retries > 0) {
        // Retry this CSW, not a fresh CBW: the device still owes the CSW
        // for the command it accepted. Real hardware needs up to eight
        // bounded STALL recoveries after a WRITE(10).
        xhci_recover_bulk_stall(true, xhci_msc_bulk_in_ep, xhci_bulk_in_dci);
        delay_us(50000);
        return msc_csw_receive_attempt(remaining_stall_retries - 1);
    }
    if (completion != 1 && completion != 13) {
        return MscCommandResult::CompletedError(3);
    }
    match msc_csw_take() {
        MscCswReceiveAuthority::Cpu(restored) => {
            let bytes = dma_cpu_slice(restored, MscCswReceive);
            let mut csw_sig: u32 = 0;
            let mut csw_tag: u32 = 0;
            for i: usize in 0..<4 {
                let sh: u32 = (i * 8) as u32;
                csw_sig = csw_sig | ((bytes[i] as u32) << sh);
                csw_tag = csw_tag | ((bytes[4 + i] as u32) << sh);
            }
            let signature_ok: bool = csw_sig == 0x53425355;
            let tag_ok: bool = csw_tag == msc_tag;
            let status_ok: bool = bytes[12] == 0;
            msc_csw_put(MscCswReceiveAuthority::Cpu(restored));
            if (signature_ok == false) { return MscCommandResult::CompletedError(4); }
            if (tag_ok == false) { return MscCommandResult::CompletedError(5); }
            if (status_ok == false) { return MscCommandResult::CompletedError(6); }
            return MscCommandResult::Ok;
        }
        MscCswReceiveAuthority::Device(stale) => {
            msc_csw_fail_device(stale);
            return MscCommandResult::ControllerUnusable;
        }
    }
}

private fn msc_read_csw() -> MscCommandResult !{unsafe} {
    return msc_csw_receive_attempt(8);
}

fn msc_run_command(data_len: {0..<65537 as u32}, dir_in: bool)
        -> MscCommandResult {
    // An outbound payload is already in the protected transmit allocation;
    // an inbound one lands in the protected receive allocation.
    match msc_cbw_send_once() {
        MscDataReceiveResult::Completed(code) => {
            if (code != 1) {
                return MscCommandResult::CompletedError(1);
            }
        }
        MscDataReceiveResult::RestartRequired => {
            return MscCommandResult::RestartRequired;
        }
        MscDataReceiveResult::ControllerUnusable => {
            return MscCommandResult::ControllerUnusable;
        }
    }

    if (data_len > 0) {
        if (dir_in) {
            match msc_data_receive_once(data_len) {
                MscDataReceiveResult::Completed(code) => {
                    if (code != 1 && code != 13) {
                        return MscCommandResult::CompletedError(2);
                    }
                }
                MscDataReceiveResult::RestartRequired => {
                    return MscCommandResult::RestartRequired;
                }
                MscDataReceiveResult::ControllerUnusable => {
                    return MscCommandResult::ControllerUnusable;
                }
            }
        } else {
            match msc_data_send_once(data_len) {
                MscDataReceiveResult::Completed(code) => {
                    if (code != 1 && code != 13) {
                        return MscCommandResult::CompletedError(2);
                    }
                }
                MscDataReceiveResult::RestartRequired => {
                    return MscCommandResult::RestartRequired;
                }
                MscDataReceiveResult::ControllerUnusable => {
                    return MscCommandResult::ControllerUnusable;
                }
            }
        }
    }

    return msc_read_csw();
}

// -- Bring-up sequence, split into stages matching rp1_usb_smoke.tkb's
// own proven Steps 5-10 (see that file's header comment for the full
// investigation history behind every constant/mask below). ------------

fn xhci_halt_and_reset() -> bool !{unsafe} {
    let usbcmd_before: u32 = rp1_xhci_op.usbcmd;
    rp1_xhci_op.usbcmd = usbcmd_before & 0xFFFFFFFE;

    let mut halt_confirmed: bool = false;
    for i: usize in 0..<100 {
        let usbsts: u32 = rp1_xhci_op.usbsts;
        if ((usbsts & 1) == 1) {
            halt_confirmed = true;
            break;
        }
        delay_us(1000);
    }
    if (halt_confirmed == false) {
        return false;
    }

    // Real Host Controller Reset (USBCMD.HCRST, bit1) -- required
    // because firmware leaves this controller running with a device
    // already fully addressed on port 3; a soft RS-cycle alone does not
    // discard that internal state.
    let usbcmd_before_hcrst: u32 = rp1_xhci_op.usbcmd;
    rp1_xhci_op.usbcmd = usbcmd_before_hcrst | 2;

    let mut hcrst_confirmed: bool = false;
    for i: usize in 0..<1000 {
        let usbcmd_poll: u32 = rp1_xhci_op.usbcmd;
        let usbsts_poll: u32 = rp1_xhci_op.usbsts;
        if (((usbcmd_poll >> 1) & 1) == 0 && ((usbsts_poll >> 11) & 1) == 0) {
            hcrst_confirmed = true;
            break;
        }
        delay_us(1000);
    }
    // A confirmed halt and HCRST is the quiescence the producer rings'
    // reset observation trusts (usb_xhci_rings.tkb).
    if (hcrst_confirmed) { xhci_rings_quiesced = true; }
    return hcrst_confirmed;
}

fn xhci_setup_rings_and_start() -> bool !{unsafe} {
    // RP1 bus masters reach system RAM only at PCI 0x10_00000000 +
    // cpu_phys (BCM2712's own device tree), not raw cpu_phys.
    pcie2_dma_inbound_setup();

    // HCRST resets the CONTROLLER's own ring positions (its Event Ring
    // producer restarts at index 0 with Cycle=1, and CRCR/ERDP are
    // reprogrammed below), so this driver's matching CONSUMER/producer
    // state has to be reset too or the two disagree from the first
    // event onward. Found the hard way: calling disk_initialize() a
    // SECOND time (to rebuild a wedged transport) left xhci_evt_idx
    // wherever the previous session had advanced it, so the very next
    // Address Device command's completion event was looked for in the
    // wrong slot and timed out. Every buffer is re-zeroed as well --
    // stale Cycle bits in a No-Op-padded or wrapped ring would be read
    // as live TRBs by a freshly reset controller.
    xhci_ready = false;
    xhci_evt_idx = 0;
    xhci_evt_cycle = 1;
    // 3, not 0: bring-up writes Enable Slot / Address Device / Configure
    // Endpoint into the fixed slots TRB[0..2] below, so the tracked
    // producer index for every LATER command starts after them.
    xhci_cmd_enq = 3;
    xhci_cmd_cycle = 1;
    xhci_ep0_enq = 0;
    xhci_ep0_cycle = 1;
    xhci_bulk_in_enq = 0;
    xhci_bulk_in_cycle = 1;
    xhci_bulk_out_enq = 0;
    xhci_bulk_out_cycle = 1;

    // The event ring: back from the controller only on a confirmed reset,
    // zeroed and published again.
    let evt_ring_dma: usize = xhci_events_start();
    if (evt_ring_dma == 0) {
        return false;
    }
    // The producer rings: back from the controller only on a confirmed
    // reset, zeroed, each Link TRB pointing at its ring's start.
    if (xhci_rings_restart() == false) {
        return false;
    }

    // The scratchpad buffers and array, the ERST and the input context:
    // device-protocol owners in usb_xhci_rings.tkb (GitHub issue #720).
    let mut tables: XhciTableAddresses = xhci_tables_start(evt_ring_dma);
    if (tables.ok == false) {
        return false;
    }
    let scratchpad_array_dma: usize = tables.scratch_array;
    let erst_dma: usize = tables.erst;

    let dcbaa_base: usize = (xhci_dcbaa as *u8) as usize;
    let dcbaa_dma: usize = dcbaa_base + boot_once_get(&rp1_dma_pci_offset);
    xhci_dcbaa[0] = (scratchpad_array_dma & 0xFFFFFFFF) as u32;
    xhci_dcbaa[1] = ((scratchpad_array_dma >> 32) & 0xFFFFFFFF) as u32;
    xhci_dcbaa_clean();

    let mut cmd_ring_dma: usize = 0;
    match xhci_ring_dma(XHCI_RING_CMD) {
        XhciRingAddress::Known(dma) => { cmd_ring_dma = dma; }
        XhciRingAddress::Busy => { return false; }
    }


    // Programming order (ERSTSZ, then ERSTBA, then ERDP last) matches
    // Linux's own xhci_add_interrupter() exactly -- a different order
    // was tried first and silently never produced a Command Completion
    // Event.
    // GitHub issue #754: ERSTSZ (interrupter +0x08) holds the one segment
    // xhci_erst_fill writes. This write used to land on IMAN (+0x00), which
    // left ERSTSZ at its reset value; IMAN.IP is cleared by the IE write
    // below, which writes IP back as 1 (RW1C).
    rp1_xhci_rt.erstsz = 1;
    rp1_xhci_rt.erstba_lo = (erst_dma & 0xFFFFFFFF) as u32;
    rp1_xhci_rt.erstba_hi = ((erst_dma >> 32) & 0xFFFFFFFF) as u32;
    rp1_xhci_rt.erdp_lo = (evt_ring_dma & 0xFFFFFFFF) as u32;
    rp1_xhci_rt.erdp_hi = ((evt_ring_dma >> 32) & 0xFFFFFFFF) as u32;

    // GitHub issue #187: enable this primary interrupter (IMAN.IE, bit 1) so
    // usb_await_event() can wait via interrupt_wait() instead of polling.
    // USBCMD.INTE (bit 2, set alongside Run/Stop below) is the matching
    // controller-wide enable. IMOD (Interrupt Moderation, at IR0+0x04) is
    // zeroed explicitly rather than trusting its post-HCRST reset value --
    // a nonzero moderation interval would add real per-interrupt latency
    // across the many bulk transfers usb_provision_rootfs's USB-ext2
    // provisioning issues, which is unnecessary now that every wait is a
    // real interrupt rather than a 1ms polling step.
    rp1_xhci_rt.imod = 0;
    rp1_xhci_rt.iman = rp1_xhci_rt.iman | (1 << 1);
    rp1_xhci_op.dcbaap_lo = (dcbaa_dma & 0xFFFFFFFF) as u32;
    rp1_xhci_op.dcbaap_hi = ((dcbaa_dma >> 32) & 0xFFFFFFFF) as u32;
    rp1_xhci_op.crcr_lo = ((cmd_ring_dma & 0xFFFFFFC0) | 1) as u32;
    rp1_xhci_op.crcr_hi = ((cmd_ring_dma >> 32) & 0xFFFFFFFF) as u32;
    rp1_xhci_op.config = 1; // MaxSlotsEn=1
    xhci_rings_quiesced = false;
    let usbcmd_fresh: u32 = rp1_xhci_op.usbcmd;
    rp1_xhci_op.usbcmd = usbcmd_fresh | 1 | (1 << 2); // Run/Stop | INTE

    let mut run_confirmed: bool = false;
    for i: usize in 0..<100 {
        let usbsts_run: u32 = rp1_xhci_op.usbsts;
        if ((usbsts_run & 1) == 0) {
            run_confirmed = true;
            break;
        }
        delay_us(1000);
    }
    return run_confirmed;
}

fn xhci_enable_slot() -> bool !{unsafe} {
    // Enable Slot, Cycle=1, at the Command Ring's first TRB. Written here
    // with its doorbell (GitHub issue #783), not at controller start: the
    // controller reads a command TRB only after the doorbell.
    let mut enable_slot: Trb = { 0, 0, 0, 0x00002401 };
    let mut td: [Trb; 3];
    td[0] = enable_slot;
    td[1] = enable_slot;
    td[2] = enable_slot;
    let enable_cc: u32 = xhci_ring_submit(XHCI_RING_CMD, 0, 0, 0, 0, 1000, 1,
                                          td as [Trb; 3..]);
    if (enable_cc == 0) {
        return false;
    }
    xhci_slot_id = ((xhci_last_evt_dw3 >> 24) & 0xFF) as usize;
    return true;
}

// Address Device: build the Input Context (Slot + EP0 Context), point
// DCBAA[slot_id] at a fresh Device Context, and issue the Address Device
// command -- but first, a real USB Port Reset. USBCMD.HCRST resets the
// controller, not the device, and firmware already enumerated this drive
// before handoff, so Address Device's implicit SET_ADDRESS needs the
// device back in the Default state a port reset produces.
fn xhci_address_device() -> XhciAddressOutcome !{unsafe} {
    let dcbaa_base: usize = (xhci_dcbaa as *u8) as usize;
    if (xhci_slot_id >= 65) {
        return XhciAddressOutcome::SlotIdOutOfRange(xhci_slot_id as u32);
    }
    let slot: {0..<65 as usize} = xhci_slot_id;
    // The output device context: the controller's for the session
    // (XhciOutput in usb_xhci_rings.tkb).
    let device_ctx_dma: usize = xhci_output_start();
    if (device_ctx_dma == 0) {
        return XhciAddressOutcome::Completion(0);
    }
    xhci_dcbaa[slot * 2] = (device_ctx_dma & 0xFFFFFFFF) as u32;
    xhci_dcbaa[slot * 2 + 1] =
        ((device_ctx_dma >> 32) & 0xFFFFFFFF) as u32;
    xhci_dcbaa_clean();

    let mut ep0_ring_dma: usize = 0;
    match xhci_ring_dma(XHCI_RING_EP0) {
        XhciRingAddress::Known(dma) => { ep0_ring_dma = dma; }
        XhciRingAddress::Busy => { return XhciAddressOutcome::Completion(0); }
    }
    xhci_ep0_enq = 0;
    xhci_ep0_cycle = 1;


    // Slot Context: Route String=0 (root-port-attached), Speed = the
    // value PORTSC3 itself reports (bits 13:10), Context Entries=1,
    // Root Hub Port Number=3 (usbhost0 port 3, this project's only ever
    // populated port).
    //
    // rp1_usb_smoke.tkb's own proven version read this from a snapshot
    // taken at the very start of its own run, well before HCRST -- a
    // choice that (by luck of ordering, not by design) avoided a real
    // race this library version hit directly: reading PORTSC3 for Speed
    // immediately after HCRST + restart can catch the SuperSpeed link
    // mid-retrain (Speed=0/Undefined), which Address Device then rejects
    // with completion_code=0x11 (Parameter Error) -- confirmed on real
    // hardware. Poll until Speed is nonzero before trusting it.
    let mut slot_speed: u32 = 0;
    for i: usize in 0..<500 {
        let portsc3_speed_read: u32 = rp1_xhci_op.ports[XHCI_MSC_PORTSC_WORD];
        slot_speed = (portsc3_speed_read >> 10) & 0xF;
        if (slot_speed != 0) {
            break;
        }
        delay_us(1000);
    }

    // EP0 Context: EP Type=4 (Control Bidirectional), Error Count=3, Max
    // Packet Size=512 (SuperSpeed's own fixed control-endpoint value).

    // USB Port Reset. 0xCE00FFE9 is Linux's own
    // xhci_port_state_to_neutral() mask (drivers/usb/host/xhci.h) --
    // keep ONLY the read-only and read-write-shared PORTSC fields, write
    // zero everywhere else. Getting this wrong is not cosmetic: bit1
    // (PED) is RW1CS, so writing back a read-modify-write that preserves
    // PED=1 actually DISABLES the port.
    let portsc3_before_reset: u32 = rp1_xhci_op.ports[XHCI_MSC_PORTSC_WORD];
    rp1_xhci_op.ports[XHCI_MSC_PORTSC_WORD] = (portsc3_before_reset & 0xCE00FFE9) | (1 << 4);

    let mut reset_confirmed: bool = false;
    for i: usize in 0..<500 {
        let portsc3_poll: u32 = rp1_xhci_op.ports[XHCI_MSC_PORTSC_WORD];
        if (((portsc3_poll >> 21) & 1) == 1) {
            reset_confirmed = true;
            break;
        }
        delay_us(1000);
    }
    if (reset_confirmed == false) {
        return XhciAddressOutcome::PortReset;
    }

    // Clear the change bits the reset raised (RW1C), same neutral mask.
    let portsc3_before_clear: u32 = rp1_xhci_op.ports[XHCI_MSC_PORTSC_WORD];
    rp1_xhci_op.ports[XHCI_MSC_PORTSC_WORD] = (portsc3_before_clear & 0xCE00FFE9)
        | (1 << 21) | (1 << 17) | (1 << 19);

    // USB reset recovery time (TRSTRCY, USB2 spec 7.1.7.3): the device
    // needs >=10ms after reset before it reliably answers SET_ADDRESS.
    // Linux's hub_port_reset() waits 10ms + 40ms margin.
    delay_us(50000);

    // The input context is built here, right before the command that reads
    // it, so it is never held across a loop or an early return.
    let XhciInputTake::Ready(input) = xhci_input_take() else {
        XhciInputTake::Unavailable => { return XhciAddressOutcome::Completion(0); }
    };
    xhci_input_set(input, 0, 0);
    xhci_input_set(input, 1, 3); // A0 (Slot) | A1 (EP0)
    // Slot Context at context 1, EP0 at context 2, each `ctx` words long
    // (HCCPARAMS1.CSZ, read at attach time).
    let ctx: {8..<17 as usize} = xhci_context_words(boot_once_get(&rp1_xhci_caps));
    xhci_input_set(input, ctx, (slot_speed << 20) | (1 << 27));
    xhci_input_set(input, ctx + 1, XHCI_MSC_PORT << 16); // ROOT_HUB_PORT
    xhci_input_set(input, 2 * ctx + 1, (4 << 3) | (3 << 1) | (512 << 16));
    xhci_input_set(input, 2 * ctx + 2, ((ep0_ring_dma & 0xFFFFFFFF) | 1) as u32);
    xhci_input_set(input, 2 * ctx + 3, ((ep0_ring_dma >> 32) & 0xFFFFFFFF) as u32);
    xhci_input_set(input, 2 * ctx + 4, 8);
    let input_ctx_dma: usize = xhci_input_submit(input);
    let mut address_device: Trb = {
        (input_ctx_dma & 0xFFFFFFFF) as u32, ((input_ctx_dma >> 32) & 0xFFFFFFFF) as u32,
        0, (1 | (11 << 10) | (xhci_slot_id << 24)) as u32
    };

    // The port reset above queues its own async Port Status Change
    // Event (Type 34), which lands before Address Device's real Command
    // Completion Event (Type 33) -- usb_await_event() scans past it.
    let mut td: [Trb; 3];
    td[0] = address_device;
    td[1] = address_device;
    td[2] = address_device;
    let addr_cc: u32 = xhci_ring_submit(XHCI_RING_CMD, 0, 0, 1, 1, 1000, 1,
                                        td as [Trb; 3..]);
    if (addr_cc != 1) {
        // usb_await_event() answers 0 when nothing arrived at all, and 0 is
        // not an xHCI completion code, so the caller can tell a command
        // that completed badly from one that never completed.
        return XhciAddressOutcome::Completion(addr_cc);
    }
    return XhciAddressOutcome::Ok;
}

// Configuration Descriptor -> parse Mass Storage interface + bulk
// endpoints -> Configure Endpoint -> SET_CONFIGURATION.
fn xhci_configure() -> XhciConfigureOutcome {
    let cfg9_cc: u32 = xhci_receive_configuration(9);
    if (cfg9_cc != 1) {
        return XhciConfigureOutcome::Transfer(cfg9_cc);
    }
    let total_len: usize = match xhci_control_take() {
        XhciControlReceiveAuthority::Cpu(cpu) => {
            let bytes = dma_cpu_slice(cpu, XhciControlReceive);
            let length: usize = (bytes[2] as usize) |
                                  ((bytes[3] as usize) << 8);
            xhci_control_put(XhciControlReceiveAuthority::Cpu(cpu));
            length
        }
        XhciControlReceiveAuthority::Device(stale) => {
            xhci_control_fail_device(stale);
            return XhciConfigureOutcome::Transfer(0);
        }
    };
    // A configuration descriptor is indivisible input. Silently truncating
    // wTotalLength to the DMA buffer used to make the parser accept a prefix
    // while raw pointers hid whether each child descriptor still fitted.
    if (total_len > 256 || total_len < 9) {
        return XhciConfigureOutcome::Malformed;
    }

    let cfg_cc: u32 = xhci_receive_configuration(total_len as u32);
    if (cfg_cc != 1) {
        return XhciConfigureOutcome::Transfer(cfg_cc);
    }
    // GitHub issue #338: the walk itself is byte work and now lives in
    // kernel/drivers/usb/config_descriptor.tkb, where linux_user can run it
    // without a board. What stays here is the transport: two control
    // transfers, a DMA wait, and publishing what came back.
    let parsed = match xhci_control_take() {
        XhciControlReceiveAuthority::Cpu(cpu) => {
            let bytes = dma_cpu_slice(cpu, XhciControlReceive);
            let result = usb_config_descriptor_parse(bytes[0..<total_len]);
            xhci_control_put(XhciControlReceiveAuthority::Cpu(cpu));
            result
        }
        XhciControlReceiveAuthority::Device(stale) => {
            xhci_control_fail_device(stale);
            return XhciConfigureOutcome::Transfer(0);
        }
    };
    match parsed {
        UsbConfigParseResult::Malformed => {
            return XhciConfigureOutcome::Malformed;
        }
        UsbConfigParseResult::Parsed(found) => {
            xhci_msc_config_value = found.config_value;
            xhci_msc_interface_num = found.interface_num;
            xhci_msc_bulk_in_ep = found.bulk_in_ep;
            xhci_msc_bulk_in_mps = found.bulk_in_mps;
            xhci_msc_bulk_in_burst = found.bulk_in_burst;
            xhci_msc_bulk_out_ep = found.bulk_out_ep;
            xhci_msc_bulk_out_mps = found.bulk_out_mps;
            xhci_msc_bulk_out_burst = found.bulk_out_burst;
        }
    }

    let in_num: usize = (xhci_msc_bulk_in_ep & 0x0F) as usize;
    let out_num: usize = (xhci_msc_bulk_out_ep & 0x0F) as usize;
    if (in_num > 0 && out_num > 0) {
        return xhci_configure_endpoint(in_num, out_num);
    }
    return XhciConfigureOutcome::NoBulkEndpoints;
}

// Split out of xhci_configure() above so in_num/out_num > 0 is a real
// narrowing guard on this function's own parameters (matching
// rp1_usb_smoke.tkb's own proven pattern) -- the trap-site rejection otherwise
// rejects out_num*2-1 as a possible underflow.
fn xhci_configure_endpoint(in_num: {1..<16 as usize},
                           out_num: {1..<16 as usize})
        -> XhciConfigureOutcome !{unsafe} {
    let in_idx: usize = in_num * 2;
    let out_idx: usize = out_num * 2 - 1;
    let mut max_idx: usize = in_idx;
    if (out_idx > max_idx) {
        max_idx = out_idx;
    }

    let mut bulk_in_ring_dma: usize = 0;
    match xhci_ring_dma(XHCI_RING_BULK_IN) {
        XhciRingAddress::Known(dma) => { bulk_in_ring_dma = dma; }
        XhciRingAddress::Busy => { return XhciConfigureOutcome::Transfer(0); }
    }
    let mut bulk_out_ring_dma: usize = 0;
    match xhci_ring_dma(XHCI_RING_BULK_OUT) {
        XhciRingAddress::Known(dma) => { bulk_out_ring_dma = dma; }
        XhciRingAddress::Busy => { return XhciConfigureOutcome::Transfer(0); }
    }

    // Endpoint contexts sit at context (index + 1) of the Input Context,
    // each `ctx` words long (HCCPARAMS1.CSZ, read at attach time). The
    // checker multiplies the two ranges (#807): (index + 2) is in
    // {4..<33} and ctx in {8..<17}, so each word offset is in {32..<513}
    // and every `+ 3` below stays inside the 528-word Input Context.
    let ctx: {8..<17 as usize} = xhci_context_words(boot_once_get(&rp1_xhci_caps));
    let in_ctx_word: usize = (in_idx + 2) * ctx;
    let out_ctx_word: usize = (out_idx + 2) * ctx;

    let XhciInputTake::Ready(input) = xhci_input_take() else {
        XhciInputTake::Unavailable => { return XhciConfigureOutcome::Transfer(0); }
    };

    // Seed the Input Context from the controller's OUTPUT Device
    // Context (U-Boot's xhci_slot_copy/xhci_endpoint_copy) -- the Slot
    // Context already holds the USB address Address Device assigned.
    for i: usize in 0..<8 {
        xhci_input_set(input, ctx + i, xhci_output_word(i));
    }
    for i: usize in 0..<8 {
        xhci_input_set(input, 2 * ctx + i, xhci_output_word(ctx + i));
    }

    let slot_dw0: u32 = xhci_input_get(input, ctx);
    xhci_input_set(input, ctx, (slot_dw0 & 0x07FFFFFF) | (((max_idx + 1) as u32) << 27));

    xhci_input_set(input, in_ctx_word + 1, (6 << 3) | (3 << 1) | ((xhci_msc_bulk_in_burst & 0xFF) << 8) | ((xhci_msc_bulk_in_mps & 0xFFFF) << 16));
    xhci_input_set(input, in_ctx_word + 2, ((bulk_in_ring_dma & 0xFFFFFFFF) | 1) as u32);
    xhci_input_set(input, in_ctx_word + 3, ((bulk_in_ring_dma >> 32) & 0xFFFFFFFF) as u32);

    xhci_input_set(input, out_ctx_word + 1, (2 << 3) | (3 << 1) | ((xhci_msc_bulk_out_burst & 0xFF) << 8) | ((xhci_msc_bulk_out_mps & 0xFFFF) << 16));
    xhci_input_set(input, out_ctx_word + 2, ((bulk_out_ring_dma & 0xFFFFFFFF) | 1) as u32);
    xhci_input_set(input, out_ctx_word + 3, ((bulk_out_ring_dma >> 32) & 0xFFFFFFFF) as u32);

    // Input Control Context: add the Slot Context (A0) plus one bit per
    // endpoint at (index + 1). EP0's A1 is deliberately not set --
    // Configure Endpoint must not touch the control endpoint.
    xhci_input_set(input, 0, 0);
    let in_add_bit: u32 = (1 << (in_idx + 1)) as u32;
    let out_add_bit: u32 = (1 << (out_idx + 1)) as u32;
    xhci_input_set(input, 1, 1 | in_add_bit | out_add_bit);

    let input_ctx_dma: usize = xhci_input_submit(input);
    let mut configure: Trb = {
        (input_ctx_dma & 0xFFFFFFFF) as u32, ((input_ctx_dma >> 32) & 0xFFFFFFFF) as u32,
        0, (1 | (12 << 10) | (xhci_slot_id << 24)) as u32
    };
    let mut td: [Trb; 3];
    td[0] = configure;
    td[1] = configure;
    td[2] = configure;
    let ce_cc: u32 = xhci_ring_submit(XHCI_RING_CMD, 0, 0, 2, 2, 1000, 1,
                                      td as [Trb; 3..]);
    if (ce_cc != 1) {
        return XhciConfigureOutcome::Transfer(ce_cc);
    }

    let setcfg_cc: u32 = usb_ctrl_no_data(0x00, 9, xhci_msc_config_value, 0);
    if (setcfg_cc != 1) {
        return XhciConfigureOutcome::Transfer(setcfg_cc);
    }

    xhci_bulk_in_dci = in_idx + 1;
    xhci_bulk_out_dci = out_idx + 1;
    return XhciConfigureOutcome::Ok;
}

// The bring-up itself: halt -> HCRST -> DMA window + rings -> Enable Slot ->
// Address Device -> Configuration Descriptor + Configure Endpoint +
// SET_CONFIGURATION -> Bulk-Only Transport bring-up -> confirm the unit
// is ready and reports 512-byte blocks.
//
// GitHub issue #339: every one of these steps used to answer
// DiskIoResult::Err(-1), so the six repairs they stand for arrived as one
// sentence. Each now names itself, and the ones that received a controller
// completion code, a transport status or a block size carry it.
fn usb_disk_initialize_stages() -> UsbInitOutcome {
    if (xhci_controller_unusable) {
        return UsbInitOutcome::Reset;
    }
    let max_ports: u32 = xhci_max_ports(boot_once_get(&rp1_xhci_caps));
    if (max_ports < XHCI_MSC_PORT) {
        return UsbInitOutcome::PortAbsent(max_ports);
    }
    if (xhci_halt_and_reset() == false) {
        return UsbInitOutcome::Reset;
    }
    if (xhci_setup_rings_and_start() == false) {
        return UsbInitOutcome::RingSetup;
    }
    if (xhci_enable_slot() == false) {
        return UsbInitOutcome::EnableSlot;
    }
    match xhci_address_device() {
        XhciAddressOutcome::SlotIdOutOfRange(slot) => {
            return UsbInitOutcome::SlotIdOutOfRange(slot);
        }
        XhciAddressOutcome::PortReset => {
            return UsbInitOutcome::PortReset;
        }
        XhciAddressOutcome::Completion(completion) => {
            return UsbInitOutcome::AddressDevice(completion);
        }
        XhciAddressOutcome::Ok => { }
    }
    match xhci_configure() {
        XhciConfigureOutcome::Transfer(completion) => {
            return UsbInitOutcome::Configure(completion);
        }
        XhciConfigureOutcome::Malformed => {
            return UsbInitOutcome::ConfigureMalformed;
        }
        XhciConfigureOutcome::NoBulkEndpoints => {
            return UsbInitOutcome::ConfigureNoBulkEndpoints;
        }
        XhciConfigureOutcome::Ok => { }
    }

    // This driver always addresses LUN 0 in its CBW. Get Max LUN only
    // reports how many other LUNs exist, so no control-IN transfer or
    // ignored DMA result is needed before the first command.

    // Do NOT send a gratuitous Bulk-Only Mass Storage Reset here. The
    // port reset + SET_CONFIGURATION above already established a fresh
    // transport, and the BOT specification defines its reset request as
    // only the first step of Reset Recovery, followed by Clear Feature
    // HALT on Bulk-In and then Bulk-Out (msc_recover_transport performs
    // that complete sequence when an actual transport failure needs it).
    // Sending only the reset request here left this SanDisk drive in a
    // state where reads happened to work but WRITE(10) always STALLed its
    // CSW; Linux usbfs reproduced the same persistent failure.

    // TEST UNIT READY, retried: a flash drive routinely reports Not
    // Ready for the first moment after configuration while it spins up
    // its own translation layer.
    //
    // The record keeps the FIRST failing status as well as the last. A
    // drive that answers Not Ready fifty times and one that fails once for
    // a real reason and then goes silent end at the same last status, and
    // recording only that last one is what hid the original failure during
    // the regression #339 was filed from.
    let mut readiness: UsbRetryRecord = usb_retry_record_start();
    for i: usize in 0..<50 {
        msc_cbw_header(0, false, 6);
        msc_cbw_set(15, 0x00);
        match msc_run_command(0, false) {
            MscCommandResult::Ok => {
                readiness = usb_retry_record_attempt(readiness, 0);
            }
            MscCommandResult::CompletedError(status) => {
                readiness = usb_retry_record_attempt(readiness, status);
            }
            MscCommandResult::RestartRequired => {
                readiness = usb_retry_record_attempt(readiness, 7);
                return UsbInitOutcome::TestUnitReady(readiness);
            }
            MscCommandResult::ControllerUnusable => {
                readiness = usb_retry_record_attempt(readiness, 8);
                return UsbInitOutcome::TestUnitReady(readiness);
            }
        }
        if (readiness.succeeded) {
            break;
        }
        delay_us(100000);
    }
    if (readiness.succeeded == false) {
        return UsbInitOutcome::TestUnitReady(readiness);
    }

    // READ CAPACITY(10): confirm 512-byte blocks, this project's whole
    // storage stack's own fixed assumption.
    msc_cbw_header(8, true, 10);
    msc_cbw_set(15, 0x25);
    match msc_run_command(8, true) {
        MscCommandResult::Ok => { }
        MscCommandResult::CompletedError(status) => {
            return UsbInitOutcome::ReadCapacity(status);
        }
        MscCommandResult::RestartRequired => {
            return UsbInitOutcome::ReadCapacity(7);
        }
        MscCommandResult::ControllerUnusable => {
            return UsbInitOutcome::ReadCapacity(8);
        }
    }
    let mut block_size: u32 = 0;
    match msc_data_take() {
        MscDataReceiveAuthority::Cpu(cpu) => {
            let bytes = dma_cpu_slice(cpu, MscDataReceive);
            for i: usize in 4..<8 {
                block_size = (block_size << 8) | (bytes[i] as u32);
            }
            msc_data_put(MscDataReceiveAuthority::Cpu(cpu));
        }
        MscDataReceiveAuthority::Device(stale) => {
            msc_data_fail_device(stale);
        }
    }
    if (block_size != 512) {
        return UsbInitOutcome::UnsupportedBlockSize(block_size);
    }

    xhci_ready = true;
    return UsbInitOutcome::Ok;
}

// The last bring-up, kept so that the answer to "why" outlives the answer to
// "did it work". disk_initialize() is asked its DiskIoResult question by
// callers that have nothing to do with USB, and matching a must_use outcome
// consumes it, so the detail is written down at the one place that holds it
// rather than recomputed by whoever wants to print it.
private let mut xhci_init_description: UsbInitDescription;
private let mut xhci_init_attempted: bool = false;

// NotRun is not a formality: xhci_init_description is BSS until the first
// bring-up writes it, and its stage is a pointer. A caller that asks before
// disk_initialize() has ever run gets a case to handle instead of a null to
// walk.
must_use variant UsbInitReportResult {
    NotRun;
    Report(UsbInitDescription);
}

fn usb_disk_init_last_report() -> UsbInitReportResult {
    if (xhci_init_attempted == false) {
        return UsbInitReportResult::NotRun;
    }
    return UsbInitReportResult::Report(xhci_init_description);
}

// The Media Access Interface entry point, unchanged for its callers: the
// same name, the same DiskIoResult, and still no UART dependency. What
// changed is that the stage it failed at survives the call.
fn disk_initialize() -> DiskIoResult {
    let mut description: UsbInitDescription =
        usb_init_outcome_describe(usb_disk_initialize_stages());
    xhci_init_description = description;
    xhci_init_attempted = true;
    if (description.failed) {
        return DiskIoResult::Err(-1);
    }
    return DiskIoResult::Ok;
}

fn disk_status() -> DiskIoResult {
    if (xhci_ready) {
        return DiskIoResult::Ok;
    }
    return DiskIoResult::Err(-1);
}

fn disk_reset_write10_command_count() {
    msc_write10_command_count = 0;
}

fn disk_write10_command_count() -> usize {
    return msc_write10_command_count;
}

// READ(10)/WRITE(10) share the same CDB shape: opcode | flags(0) |
// LBA(4, big-endian) | group number(0) | transfer length(2, big-endian,
// bounded by MSC_MAX_TRANSFER_SECTORS) | control(0). msc_cbw_header() must already have
// been called to build the CBW header and zero this CDB region.
fn msc_scsi_lba_cdb(op: u8, sector: u32, sectors: usize) {
    msc_cbw_set(15, op);
    msc_cbw_set(17, ((sector >> 24) & 0xFF) as u8);
    msc_cbw_set(18, ((sector >> 16) & 0xFF) as u8);
    msc_cbw_set(19, ((sector >> 8) & 0xFF) as u8);
    msc_cbw_set(20, (sector & 0xFF) as u8);
    msc_cbw_set(22, ((sectors >> 8) & 0xFF) as u8);
    msc_cbw_set(23, (sectors & 0xFF) as u8);
}

// Same retry policy as RPi3's own disk_read/disk_write for completed errors:
// one attempt, and then a full msc_recover_transport() (Bulk-Only Mass Storage
// Reset + clear-halt on both bulk endpoints) followed by exactly one
// retry of the same, side-effect-free-to-repeat command. An unobserved
// transfer aborts instead; a BOT reset does not quiesce the host controller.
fn disk_read_sectors(sector: u32, buf: []u8) -> DiskIoResult {
    if (disk_io_ok(disk_status()) == false) {
        return DiskIoResult::Err(-1);
    }
    if (buf.len == 0 || buf.len % MSC_SECTOR_SIZE != 0) {
        return DiskIoResult::Err(-1);
    }
    let sectors: usize = buf.len / MSC_SECTOR_SIZE;
    if (sectors > MSC_MAX_TRANSFER_SECTORS) {
        return DiskIoResult::Err(-1);
    }
    let length: usize = buf.len;
    if (length > 65536) { return DiskIoResult::Err(-1); }
    let length_u32: u32 = length as u32;
    if (length_u32 >= 65537) { return DiskIoResult::Err(-1); }
    let transfer_len: {0..<65537 as u32} = length_u32;
    msc_cbw_header(transfer_len, true, 10);
    msc_scsi_lba_cdb(0x28, sector, sectors);
    let mut retry: bool = false;
    match msc_run_command(transfer_len, true) {
        MscCommandResult::Ok => { }
        MscCommandResult::CompletedError(_) => { retry = true; }
        MscCommandResult::RestartRequired => { return DiskIoResult::Err(-1); }
        MscCommandResult::ControllerUnusable => { return DiskIoResult::Err(-1); }
    }
    if (retry) {
        msc_recover_transport();
        msc_cbw_header(transfer_len, true, 10);
        msc_scsi_lba_cdb(0x28, sector, sectors);
        match msc_run_command(transfer_len, true) {
            MscCommandResult::Ok => { }
            MscCommandResult::CompletedError(_) => {
                return DiskIoResult::Err(-1);
            }
            MscCommandResult::RestartRequired => {
                return DiskIoResult::Err(-1);
            }
            MscCommandResult::ControllerUnusable => {
                return DiskIoResult::Err(-1);
            }
        }
    }
    match msc_data_take() {
        MscDataReceiveAuthority::Cpu(cpu) => {
            let bytes = dma_cpu_slice(cpu, MscDataReceive);
            for i: usize in 0..<MSC_MAX_TRANSFER_SECTORS * MSC_SECTOR_SIZE {
                if (i < buf.len) {
                    buf[i] = bytes[i];
                }
            }
            msc_data_put(MscDataReceiveAuthority::Cpu(cpu));
        }
        MscDataReceiveAuthority::Device(stale) => {
            msc_data_fail_device(stale);
        }
    }
    return DiskIoResult::Ok;
}

fn disk_read(sector: u32, buf: [u8; MSC_SECTOR_SIZE..]) -> DiskIoResult {
    return disk_read_sectors(sector, buf[0..<MSC_SECTOR_SIZE]);
}

fn disk_write(sector: u32, buf: [u8; MSC_SECTOR_SIZE..]) -> DiskIoResult {
    return disk_write_sectors(sector, buf[0..<MSC_SECTOR_SIZE]);
}

// Write a bounded contiguous run with one WRITE(10). The bounce buffer is
// cache-line aligned and sized for the complete DMA range, so callers may
// provide ordinary, unaligned byte storage. A failed write is replayed once
// with the same bytes and LBA range after a completed error. A transfer
// without a matching event aborts before any replay.
fn disk_write_sectors(sector: u32, buf: []u8) -> DiskIoResult {
    if (disk_io_ok(disk_status()) == false) {
        return DiskIoResult::Err(-1);
    }
    if (buf.len == 0 || buf.len % MSC_SECTOR_SIZE != 0) {
        return DiskIoResult::Err(-1);
    }
    let sectors: usize = buf.len / MSC_SECTOR_SIZE;
    if (sectors > MSC_MAX_TRANSFER_SECTORS) {
        return DiskIoResult::Err(-1);
    }
    let length: usize = buf.len;
    if (length > 65536) { return DiskIoResult::Err(-1); }
    let length_u32: u32 = length as u32;
    if (length_u32 >= 65537) { return DiskIoResult::Err(-1); }
    let transfer_len: {0..<65537 as u32} = length_u32;
    match msc_data_out_take() {
        MscDataTransmitAuthority::Cpu(cpu) => {
            let bytes = dma_cpu_slice(cpu, MscDataTransmit);
            for i: usize in 0..<MSC_MAX_TRANSFER_SECTORS * MSC_SECTOR_SIZE {
                if (i < buf.len) {
                    bytes[i] = buf[i];
                }
            }
            msc_data_out_put(MscDataTransmitAuthority::Cpu(cpu));
        }
        MscDataTransmitAuthority::Device(stale) => {
            msc_data_out_fail_device(stale);
        }
    }
    msc_cbw_header(transfer_len, false, 10);
    msc_scsi_lba_cdb(0x2A, sector, sectors);
    msc_write10_command_count = msc_write10_command_count + 1;
    match msc_run_command(transfer_len, false) {
        MscCommandResult::Ok => { return DiskIoResult::Ok; }
        MscCommandResult::CompletedError(_) => { }
        MscCommandResult::RestartRequired => { return DiskIoResult::Err(-1); }
        MscCommandResult::ControllerUnusable => { return DiskIoResult::Err(-1); }
    }
    msc_recover_transport();
    // This is deliberately limited to one replay of the exact same
    // WRITE(10) range. If the first command reached media before
    // its CSW was lost, repeating identical bytes to the identical LBA
    // is content-idempotent; no general write-command retry policy is
    // implied.
    msc_cbw_header(transfer_len, false, 10);
    msc_scsi_lba_cdb(0x2A, sector, sectors);
    msc_write10_command_count = msc_write10_command_count + 1;
    match msc_run_command(transfer_len, false) {
        MscCommandResult::Ok => { return DiskIoResult::Ok; }
        MscCommandResult::CompletedError(_) => {
            return DiskIoResult::Err(-1);
        }
        MscCommandResult::RestartRequired => {
            return DiskIoResult::Err(-1);
        }
        MscCommandResult::ControllerUnusable => {
            return DiskIoResult::Err(-1);
        }
    }
}

// GitHub issue #623: the submission entry points. A device-written buffer's
// address and length both come from one span that dma_device_span proved
// inside its allocation; RP1's bus translation is applied here, once.
fn usb_ctrl_in(bm_request_type: u32, b_request: u32, w_value: u32,
               w_index: u32, span: borrow DmaDeviceSpan) -> u32 !{unsafe} {
    let bus: usize = rp1_span_bus_address(span);
    return usb_ctrl_xfer(bm_request_type, b_request, w_value, w_index,
                         dma_span_length(span) as u32, bus, true);
}

fn usb_ctrl_no_data(bm_request_type: u32, b_request: u32, w_value: u32,
                    w_index: u32) -> u32 !{unsafe} {
    return usb_ctrl_xfer(bm_request_type, b_request, w_value, w_index,
                         0, 0, false);
}

fn usb_bulk_in(span: borrow DmaDeviceSpan) -> u32 !{unsafe} {
    let bus: usize = rp1_span_bus_address(span);
    return usb_bulk_xfer(true, bus, dma_span_length(span) as u32);
}

fn usb_bulk_out(span: borrow DmaDeviceSpan) -> u32 !{unsafe} {
    let bus: usize = rp1_span_bus_address(span);
    return usb_bulk_xfer(false, bus, dma_span_length(span) as u32);
}
