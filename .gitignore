# Generated files (GitHub issue #286): offset constants only, `.include`d by
# the ordinary, git-tracked kernel/arch/arm64/kernel/exception_context.inc,
# which holds the hand-written SAVE/RESTORE macro bodies and is NOT gitignored.
kernel/arch/arm64/kernel/exception_context_offsets.inc
# GitHub issue #306: --emit-depfile sibling of the generated file above --
# it lands next to it (outside _build/ and kernel/build/, both already
# ignored below) since exception_context_offsets.inc itself is generated
# in-tree rather than under a build directory.
kernel/arch/arm64/kernel/exception_context_offsets.inc.d

# Downloaded at build time (Makefile's COMMON_AARCH64_BUSYBOX_APK rule,
# GitHub issue #156) -- a real, GPL-2.0, third-party binary fetched
# fresh, deliberately never vendored/committed.
examples/common_aarch64/busybox-static
# A pre-move cached artifact may still exist in an existing worktree.
examples/common_rpi3/busybox-static

# ocamlbuild working directory
_build/

# ocamlbuild targets
*.byte
*.native

# oasis generated files
setup.data
setup.log

# Merlin configuring file for Vim and Emacs
.merlin

# Dune generated files
*.install
takibi.opam

# Local OPAM switch
_opam/

# Claude
.claude/settings.local.json
.claude/worktrees/

# Python
__pycache__

# Slides
.watch_list
slides.html
slides.pdf
docs/talks/*/dist/

# Generated device-tree fixture for linux_user/fdt (GitHub issue #470),
# built by scripts/make_fdt_fixture.py. The script is the source; the blob
# is an output, and committing it would give the same values two homes.
linux_user/build/fdt_fixture.dtb
linux_user/build/fdt_invalid_reservation_fixture.dtb
linux_user/build/fdt_invalid_tree_reservation_fixture.dtb
